                ],
                "senses": [
                    {
                        "sense_id": "7b59c272-30fd-3f8e-862d-1231441167eb",
                        "entry_id": "830278c3-d2af-3428-b529-3e497387e748",
                        "glosses": [
                            "duidelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f163579-dd08-4359-8e23-5d79fbe3270b",
                                "sense_id": "7b59c272-30fd-3f8e-862d-1231441167eb",
                                "text": "Dat was toch wel een blijkbare vergissing."
                            },
                            {
                                "example_id": "cedbeb9d-27ec-4eff-aebe-943d9f608aa6",
                                "sense_id": "7b59c272-30fd-3f8e-862d-1231441167eb",
                                "text": "Halverwege kwam ons een Park Ranger tegemoet. Ik voelde een immense opluchting aangezien ik dacht dat we nu veilig waren. Maar dit gevoel duurde niet lang want na een kort praatje schreef hij opeens een officiële boete uit voor de hele groep omdat het blijkbaar verboden was om boven op Mount Whitney te overnachten."
                            },
                            {
                                "example_id": "03f22ac3-5925-4869-911b-ff12e1986347",
                                "sense_id": "7b59c272-30fd-3f8e-862d-1231441167eb",
                                "text": "„De mensen hebben blijkbaar weer zin in een feestje...”, weet woordvoerder Rik van de Merwe. Zijn feest - Bevrijdingsdag Enschede op de Universiteit Twente - is deze donderdag met 15.000 bezoekers stijf uitverkocht. De wachtlijst loopt zelfs al flink op. Een alternatief is te vinden in Het Volkspark."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5658d9-8957-4b49-b2ae-693263345f60",
                        "source_entry_id": "830278c3-d2af-3428-b529-3e497387e748",
                        "source_sense_id": "7b59c272-30fd-3f8e-862d-1231441167eb",
                        "source_sense_description": "duidelijk",
                        "target_lang_word": "offensichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "dem Anschein nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e60d1e-ad13-4f2c-81fe-edec92866d25",
                                                "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                                "text": "Den Wolken nach zu urteilen, wird es offensichtlich regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "für jeden erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab0e9c-a524-4a5e-bf78-47a736cd6f2a",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "Es war offensichtlich, dass er gelogen hatte."
                                            },
                                            {
                                                "example_id": "f3761dd4-c271-4717-a207-45ed4e44513b",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Die offensichtlichen Mängel der Expertisen, so die Behörde heute, wären ganz sicher schon damals »in einem ‚Obergutachten‘ und/oder anderem Klageverfahren festgestellt worden«.“"
                                            },
                                            {
                                                "example_id": "36473f8d-c9a5-48b5-80d0-e0d958f80517",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "a6529f20-b446-4a31-82cd-7b7758b7593c",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
