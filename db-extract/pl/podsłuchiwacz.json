                                        "examples": [
                                            {
                                                "example_id": "cdc5411e-b677-4430-8636-d3d1fcfecea6",
                                                "sense_id": "459fff3a-2e0b-360c-bc2b-669e841e11e2",
                                                "text": "„Den Lauscher hatte er nicht bemerkt, wohl gar nicht für möglich gehalten, daß ein solcher in der Nähe sein könnte.“"
                                            }
