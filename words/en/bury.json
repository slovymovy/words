{
    "word_family": [
        "burial",
        "burier",
        "unbury",
        "rebury"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bfc2eb8-e2e8-3fb6-89cc-424884b63790",
                    "sense_definition": "To put a dead body into a grave, tomb, or the ground, usually with a ceremony.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "death_interment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>bury</w> him in the old churchyard near his home.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>похоронить</w> его на старом кладбище возле его дома.",
                                "zh": "他们决定把他<w>埋葬</w>在靠近他家的一座古老教堂墓地里。"
                            }
                        },
                        {
                            "text": "Many cultures <w>bury</w> the dead with specific rituals and traditions.",
                            "target_lang_translations": {
                                "ru": "Многие культуры <w>хоронят</w> мертвых с особыми ритуалами и традициями.",
                                "zh": "许多文化中，人们会通过特定的仪式和传统来<w>埋葬</w>死者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inter",
                        "entomb",
                        "lay to rest"
                    ],
                    "antonyms": [
                        "exhume",
                        "disinter"
                    ],
                    "common_phrases": [
                        "bury the dead",
                        "buried alive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать мертвое тело в могилу, гробницу или землю, обычно с соблюдением церемонии.",
                        "zh": "将死者的遗体放入坟墓、陵墓或地下，通常伴有仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хорони́ть",
                                "target_lang_sense_clarification": "imperfective, general term"
                            },
                            {
                                "target_lang_word": "похорони́ть",
                                "target_lang_sense_clarification": "perfective, general term"
                            },
                            {
                                "target_lang_word": "погреба́ть",
                                "target_lang_sense_clarification": "formal or literary"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埋葬",
                                "target_lang_sense_clarification": "正式用语，指安葬死者"
                            },
                            {
                                "target_lang_word": "下葬",
                                "target_lang_sense_clarification": "指将灵柩或遗体埋入土中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d74e537-0462-3b0e-811c-62eeb0312b0e",
                    "sense_definition": "To put something under the ground or cover it completely with earth, leaves, or another substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_hiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog ran to the garden to <w>bury</w> its bone.",
                            "target_lang_translations": {
                                "ru": "Собака побежала в сад, чтобы <w>зарыть</w> свою кость.",
                                "zh": "那只狗跑进花园去<w>埋</w>它的骨头。"
                            }
                        },
                        {
                            "text": "Pirates in stories often <w>bury</w> their treasure on deserted islands.",
                            "target_lang_translations": {
                                "ru": "Пираты в историях часто <w>зарывают</w> свои сокровища на необитаемых островах.",
                                "zh": "故事里的海盗经常把财宝<w>埋</w>在荒岛上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "cover"
                    ],
                    "antonyms": [
                        "unearth",
                        "dig up"
                    ],
                    "common_phrases": [
                        "bury treasure",
                        "bury a bone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать что-либо под землю или полностью покрывать землей, листьями или другим веществом.",
                        "zh": "将某物放入地下，或用泥土、树叶等将其完全覆盖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарыва́ть",
                                "target_lang_sense_clarification": "to dig something in"
                            },
                            {
                                "target_lang_word": "зака́пывать",
                                "target_lang_sense_clarification": "to cover with earth"
                            },
                            {
                                "target_lang_word": "пря́тать",
                                "target_lang_sense_clarification": "to hide"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埋",
                                "target_lang_sense_clarification": "通用词，指将东西放入土中"
                            },
                            {
                                "target_lang_word": "掩埋",
                                "target_lang_sense_clarification": "指用土或其它物质覆盖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                    "sense_definition": "To cover or hide someone or something completely so they cannot be seen or found.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_hiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so tired that she <w>buried</w> her face in the pillow and fell asleep.",
                            "target_lang_translations": {
                                "ru": "Она так устала, что <w>зарыла</w> лицо в подушку и уснула.",
                                "zh": "她太累了，把脸<w>埋</w>进枕头里就睡着了。"
                            }
                        },
                        {
                            "text": "The important information was <w>buried</w> deep within the long report.",
                            "target_lang_translations": {
                                "ru": "Важная информация была <w>спрятана</w> глубоко в длинном отчете.",
                                "zh": "重要的信息被<w>埋藏</w>在那份长篇报告的深处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conceal",
                        "hide",
                        "cover up"
                    ],
                    "antonyms": [
                        "reveal",
                        "expose",
                        "uncover"
                    ],
                    "common_phrases": [
                        "bury one's face",
                        "buried in the sand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью укрывать или прятать кого-либо или что-либо, чтобы их нельзя было увидеть или найти.",
                        "zh": "将某人或某物完全遮盖或隐藏起来，使其无法被看见或找到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спря́тать",
                                "target_lang_sense_clarification": "to hide completely"
                            },
                            {
                                "target_lang_word": "зары́ть",
                                "target_lang_sense_clarification": "often used with 'face'"
                            },
                            {
                                "target_lang_word": "скры́ть",
                                "target_lang_sense_clarification": "to conceal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埋",
                                "target_lang_sense_clarification": "指将某物深藏或遮盖"
                            },
                            {
                                "target_lang_word": "隐藏",
                                "target_lang_sense_clarification": "指遮掩或藏匿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a470f26f-7752-3b45-b4df-30c4758cc522",
                    "sense_definition": "To give someone a very large amount of work or information to deal with.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_overwhelm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am currently <w>buried</w> in paperwork and cannot leave the office early.",
                            "target_lang_translations": {
                                "ru": "Я сейчас <w>завален</w> бумажной работой и не могу уйти из офиса рано.",
                                "zh": "我目前被文书工作<w>淹没</w>了，没法早点离开办公室。"
                            }
                        },
                        {
                            "text": "The manager was <w>buried</w> under a mountain of complaints from customers.",
                            "target_lang_translations": {
                                "ru": "Менеджер был <w>погребен</w> под горой жалоб от клиентов.",
                                "zh": "经理被堆积如山的客户投诉<w>淹没</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm",
                        "swamp",
                        "inundate"
                    ],
                    "common_phrases": [
                        "buried in work",
                        "buried in paperwork"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо очень большой объем работы или информации для выполнения.",
                        "zh": "给某人分配过多的工作或信息，使其难以应付。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завали́ть",
                                "target_lang_sense_clarification": "colloquial, e.g., with work"
                            },
                            {
                                "target_lang_word": "погря́знуть",
                                "target_lang_sense_clarification": "to be bogged down in"
                            },
                            {
                                "target_lang_word": "погрести́",
                                "target_lang_sense_clarification": "metaphorical, under a pile"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埋头",
                                "target_lang_sense_clarification": "指专心于某事，常用于埋头工作"
                            },
                            {
                                "target_lang_word": "淹没",
                                "target_lang_sense_clarification": "比喻被大量事物覆盖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7031d32f-b332-3b64-940c-83ba6ebee529",
                    "sense_definition": "To try to forget or ignore an unpleasant feeling, memory, or secret.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_suppress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>bury</w> his grief by working harder than ever before.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>заглушить</w> свое горе, работая усерднее, чем когда-либо прежде.",
                                "zh": "他试图通过比以往更努力地工作来<w>埋藏</w>自己的悲伤。"
                            }
                        },
                        {
                            "text": "They kept the family secret <w>buried</w> for many years.",
                            "target_lang_translations": {
                                "ru": "Они хранили семейную тайну <w>скрытой</w> много лет.",
                                "zh": "他们把这个家庭秘密<w>埋藏</w>了许多年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suppress",
                        "repress",
                        "stifle"
                    ],
                    "antonyms": [
                        "express",
                        "vent"
                    ],
                    "common_phrases": [
                        "bury one's feelings",
                        "bury the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться забыть или игнорировать неприятное чувство, воспоминание или секрет.",
                        "zh": "试图忘记或忽视不愉快的情绪、记忆或秘密。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похорони́ть",
                                "target_lang_sense_clarification": "metaphorical, to put to rest"
                            },
                            {
                                "target_lang_word": "заглуши́ть",
                                "target_lang_sense_clarification": "to stifle or suppress"
                            },
                            {
                                "target_lang_word": "скры́ть",
                                "target_lang_sense_clarification": "to hide or keep secret"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埋藏",
                                "target_lang_sense_clarification": "指将情感或秘密深藏在心底"
                            },
                            {
                                "target_lang_word": "压抑",
                                "target_lang_sense_clarification": "指克制或隐藏情感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e512a05e-3a56-34a4-8ace-877c36dc52fe",
                    "sense_definition": "To put an end to a disagreement or conflict.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of fighting, they finally decided to <w>bury</w> the hatchet.",
                            "target_lang_translations": {
                                "ru": "После многих лет вражды они наконец решили <w>зарыть</w> топор войны.",
                                "zh": "经过多年的争斗，他们终于决定<w>化解</w>前嫌。"
                            }
                        },
                        {
                            "text": "We should <w>bury</w> our differences and work together for the common good.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>забыть</w> наши разногласия и работать вместе ради общего блага.",
                                "zh": "我们应该<w>抛弃</w>分歧，为了共同的利益而合作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resolve",
                        "settle"
                    ],
                    "common_phrases": [
                        "bury the hatchet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'bury the hatchet'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить конец разногласиям или конфликту.",
                        "zh": "结束分歧或冲突。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поко́нчить с",
                                "target_lang_sense_clarification": "to put an end to"
                            },
                            {
                                "target_lang_word": "забы́ть",
                                "target_lang_sense_clarification": "to forget (differences)"
                            },
                            {
                                "target_lang_word": "зары́ть",
                                "target_lang_sense_clarification": "used in idiom 'bury the hatchet'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化解",
                                "target_lang_sense_clarification": "指消除矛盾"
                            },
                            {
                                "target_lang_word": "抛弃",
                                "target_lang_sense_clarification": "指放弃前嫌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "900fef81-6a9c-3947-a7f8-5b083e941376",
                    "sense_definition": "To live longer than someone else; to survive one's relatives or peers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "outlive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather is so healthy that he will probably <w>bury</w> us all.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка настолько здоров, что, вероятно, <w>похоронит</w> нас всех.",
                                "zh": "我祖父身体非常健康，很可能会把我们都<w>送走</w>。"
                            }
                        },
                        {
                            "text": "It is a tragedy for a parent to have to <w>bury</w> their child.",
                            "target_lang_translations": {
                                "ru": "Это трагедия для родителя — <w>хоронить</w> своего ребенка.",
                                "zh": "对于父母来说，不得不<w>埋葬</w>自己的孩子是一场悲剧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outlive",
                        "survive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить дольше кого-то другого; пережить своих родственников или сверстников.",
                        "zh": "比别人活得更久；在亲人或同辈去世后依然存活。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережи́ть",
                                "target_lang_sense_clarification": "to outlive"
                            },
                            {
                                "target_lang_word": "хорони́ть",
                                "target_lang_sense_clarification": "to attend the funeral of someone"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "送走",
                                "target_lang_sense_clarification": "指亲历亲人离世"
                            },
                            {
                                "target_lang_word": "熬过",
                                "target_lang_sense_clarification": "指比某人活得长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99238a76-598d-365e-b02c-caf37f48c3de",
                    "sense_definition": "To score a goal, usually with force or precision.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker received the pass and <w>buried</w> the ball in the back of the net.",
                            "target_lang_translations": {
                                "ru": "Нападающий получил пас и <w>вколотил</w> мяч в сетку ворот.",
                                "zh": "前锋接到传球，将球<w>射入</w>了球门网中。"
                            }
                        },
                        {
                            "text": "He had a perfect chance to <w>bury</w> the shot but missed wide.",
                            "target_lang_translations": {
                                "ru": "У него был идеальный шанс <w>забить</w> гол, но он промахнулся.",
                                "zh": "他有一个绝佳的<w>打进</w>机会，但射偏了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "score"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in sports contexts like football or hockey"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Забить гол, обычно с силой или точностью.",
                        "zh": "进球，通常指动作有力或精准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заби́ть",
                                "target_lang_sense_clarification": "to score"
                            },
                            {
                                "target_lang_word": "вколоти́ть",
                                "target_lang_sense_clarification": "slang, to strike forcefully into the net"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "射入",
                                "target_lang_sense_clarification": "指将球射入球门"
                            },
                            {
                                "target_lang_word": "打进",
                                "target_lang_sense_clarification": "指成功进球"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f4378a13-5c58-3af1-beb0-eaf5bcfc7974",
                    "sense_definition": "A town and metropolitan borough in Greater Manchester, England.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited the market in <w>Bury</w> last weekend.",
                            "target_lang_translations": {
                                "ru": "Мы посетили рынок в <w>Бери</w> в прошлые выходные.",
                                "zh": "上周末我们参观了<w>伯里</w>的市场。"
                            }
                        },
                        {
                            "text": "He was born and raised in <w>Bury</w>.",
                            "target_lang_translations": {
                                "ru": "Он родился и вырос в <w>Бери</w>.",
                                "zh": "他在<w>伯里</w>出生并长大。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город и метрополитенский район в Большом Манчестере, Англия.",
                        "zh": "英国大曼彻斯特郡的一个城镇和都市自治市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бе́ри",
                                "target_lang_sense_clarification": "city name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伯里",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "249a05be-f53b-3a89-87a7-a3d58ca7d07f",
                    "sense_definition": "A surname of English origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bury</w> will see you now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бери</w> сейчас вас примет.",
                                "zh": "<w>伯里</w>先生现在见你。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Bury</w>.",
                            "target_lang_translations": {
                                "ru": "Я ходил в школу с девочкой по имени Сара <w>Бери</w>.",
                                "zh": "我和一个叫莎拉·<w>伯里</w>的女孩一起上过学。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского происхождения.",
                        "zh": "源自英语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бе́ри",
                                "target_lang_sense_clarification": "surname"
                            }
                        ],
