                                        "entry_id": "2d78b1ea-a184-38e2-bd5d-167d2f391dfe",
                                        "glosses": [
                                            "The amount or value listed on a bill, card, note, stamp, etc.; the stated value or amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bca14071-9af1-37ec-8f08-cd9167694aa8",
                                        "entry_id": "2d78b1ea-a184-38e2-bd5d-167d2f391dfe",
                                        "glosses": [
                                            "No more or less than what is stated; a literal or direct meaning or interpretation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ceaadfe-c00b-41c5-a722-8a1d07e99f1f",
                                                "sense_id": "bca14071-9af1-37ec-8f08-cd9167694aa8",
                                                "text": "Please take this comment at face value and don't try to read anything into it."
                                            },
                                            {
                                                "example_id": "107bd17f-1f15-4456-8ae7-5b2416502d03",
                                                "sense_id": "bca14071-9af1-37ec-8f08-cd9167694aa8",
                                                "text": "Few museums have such a coherent collection that covers so many different areas of interest as the London Transport Museum. At face value, it is a collection of urban transport in London. In reality, it is so much more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8af24f7-bae0-4e1a-a06d-ac393d5d62cb",
                        "source_entry_id": "8ba61cbb-3907-379f-be71-09897a20a8e2",
