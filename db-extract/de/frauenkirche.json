                        "sense_id": "83da2b3f-1663-377a-a8ad-c7e20106a739",
                        "entry_id": "8af3d8d7-50ca-3b3d-b29e-7c71fb52b934",
                        "glosses": [
                            "eine Kirche, die „unser(er) lieben Frau(en) (Jungfrau) (Maria)“ geweiht ist; unsere liebe Frau"
                        ],
                        "tags": [
                            "Siehe auch"
                        ],
                        "examples": [
                            {
                                "example_id": "ef627044-f2d9-4cf9-a35e-adad5c99a23e",
                                "sense_id": "83da2b3f-1663-377a-a8ad-c7e20106a739",
                                "text": "Am 30. Oktober 2005 wurde die wiederaufgebaute Frauenkirche in Dresden geweiht."
                            },
                            {
                                "example_id": "a2dd797f-7546-44b2-8014-17c895b32dc2",
                                "sense_id": "83da2b3f-1663-377a-a8ad-c7e20106a739",
                                "text": "„Und hätte ich in der Wendezeit nicht die ergreifende Ruine der Frauenkirche mit eigenen Augen gesehen, würde ich heute sicher keine Minute daran zweifeln, dass diese Kirche schon immer da stand.“"
                            }
                        ],
