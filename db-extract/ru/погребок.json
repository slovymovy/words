                                        "entry_id": "be3fcb2d-2be5-3901-8185-33b075a5e540",
                                        "glosses": [
                                            "Cabaret qui présente des spectacles de flamencos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8a8516-e068-4d4e-8334-599076214e62",
                                                "sense_id": "fb08a471-bddf-36de-bed2-2e9ae1c79890",
                                                "text": "La cueva où elles allaient assister au spectacle de flamenco était située à flanc de colline, dans un bâtiment grossièrement blanchi à la chaux."
                                            }
