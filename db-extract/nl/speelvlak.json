                "senses": [
                    {
                        "sense_id": "a9f85c3f-2371-3d2f-8d64-83cd118a13d2",
                        "entry_id": "8e76f206-448c-366f-b42f-175490e38304",
                        "glosses": [
                            "het hele speelterrein (voor een voorstelling) of een van de delen waarin een speelveld is ingedeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa42ec71-8d05-4913-8de2-eaf60decf1c8",
                                "sense_id": "a9f85c3f-2371-3d2f-8d64-83cd118a13d2",
                                "text": "De nieuwe theaterzaal krijgt acht bewegende tribunes die door de zaal rijden en ieder hun eigen parcours volgen. De tribunes met elk tweehonderd zitplaatsen zullen tijdens de voorstelling naast of tegenover elkaar staan, in een cirkel, op een rij op met de ruggen tegen elkaar. De acteurs krijgen alle ruimte, want het speelvlak wordt 70 bij 70 meter."
                            },
                            {
                                "example_id": "c7627842-105c-4cc9-9663-b8d960453932",
                                "sense_id": "a9f85c3f-2371-3d2f-8d64-83cd118a13d2",
                                "text": "Het zeil van het speelvlak raakte los en omwikkelde haar als een snoepje. Het geschrokken publiek schoot onmiddellijk te hulp."
                            },
                            {
                                "example_id": "ff825cf2-a77f-4383-818d-5ed3206bdc92",
                                "sense_id": "a9f85c3f-2371-3d2f-8d64-83cd118a13d2",
                                "text": "\"Vooral het mechaniek heeft hoofdbrekens gekost\", aldus Beeftink, in het dagelijkse leven architect. Het mechaniek, dat het mogelijk maakt om de gekleurde speelvlakken over het bord te verplaatsen, geeft het spel ook zijn naam. Vortex betekent draaikolk of maalstroom."
                            }
                        ]
                    }
