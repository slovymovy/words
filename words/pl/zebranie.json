            "senses": [
                {
                    "sense_id": "24ce2eed-8915-39fb-a035-ed3aa2dc3347",
                    "sense_definition": "zgromadzenie grupy ludzi w celu przedyskutowania określonych spraw lub podjęcia decyzji",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jutro po południu odbędzie się ważne <w>zebranie</w> rodziców w szkole.",
                            "target_lang_translations": {
                                "en": "An important parents' <w>meeting</w> will take place at the school tomorrow afternoon."
                            }
                        },
                        {
                            "text": "Wszyscy pracownicy działu marketingu muszą przyjść na to <w>zebranie</w>.",
                            "target_lang_translations": {
                                "en": "All marketing department employees must come to this <w>meeting</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zebranie rodziców",
                        "ważne zebranie"
                    ],
                    "target_lang_definitions": {
                        "en": "a gathering of people to discuss matters or make decisions"
                    },
                    "translations": {
                        "en": [
