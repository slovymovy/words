                                                "example_id": "3eb89913-04f7-4fb3-98c3-fe6590633201",
                                                "sense_id": "7d6e06cb-43d8-3461-8aa2-4d2ef875dc02",
                                                "text": "His grand battery was as badly provided with cannon as his little battery, for not a single gun was mounted on either."
                                            },
                                            {
                                                "example_id": "bb7a1775-23d6-4338-87cd-c95dd4f8cab2",
                                                "sense_id": "7d6e06cb-43d8-3461-8aa2-4d2ef875dc02",
                                                "text": "On this wharf [Tower Bridge wharf] there is a long and beautiful platform, on which are planted 61 pieces of cannon [...] Devil's Battery, where is also a platform, on which are mounted seven pieces of cannon, although on the battery itself there are only five."
                                            }
                                        ]
