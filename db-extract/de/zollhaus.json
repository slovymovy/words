                ],
                "senses": [
                    {
                        "sense_id": "ee730f43-04b7-36cb-9c6f-f42e43ec7ed5",
                        "entry_id": "ac242d4c-8d1c-3f65-8439-43af04b3ee24",
                        "glosses": [
                            "Gebäude in dem das Zollamt untergebracht ist und in dem oft eine Gaststube für die Wartezeit war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8dfb9c-9415-4db0-863d-325e20d2fd43",
                                "sense_id": "ee730f43-04b7-36cb-9c6f-f42e43ec7ed5",
                                "text": "„Auf dem Platz in der Nähe des alten Zollhauses entdeckten sie es.“"
                            },
                            {
                                "example_id": "2ee0876c-f3de-4baa-bb84-b419460d07fb",
                                "sense_id": "ee730f43-04b7-36cb-9c6f-f42e43ec7ed5",
                                "text": "„Wie bereits geschildert, wird das Zollhaus im ehemaligen Zollamt des Europahafens – der heutigen Überseestadt in Bremen entstehen.“"
                            },
                            {
                                "example_id": "c025f391-4944-4ee2-8cbf-da4bb4810100",
                                "sense_id": "ee730f43-04b7-36cb-9c6f-f42e43ec7ed5",
                                "text": "Schon das Inventar belegt, dass das Zollhaus auch als Herberge oder Gaststätte benützt wurde."
                            },
                            {
                                "example_id": "33894f34-f408-4ecd-b350-b94b1763870a",
                                "sense_id": "ee730f43-04b7-36cb-9c6f-f42e43ec7ed5",
                                "text": "Das Zollhaus diente seit Anfang des 17. Jahrhunderts als Dienst- und Wohngebäude für den Wentorfer Zöllner."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
