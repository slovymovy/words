                        "examples": [
                            {
                                "example_id": "9be6a774-f940-492f-a321-45120c7904a7",
                                "sense_id": "1a201e42-32ca-33a2-9a5f-33a7aaafa244",
                                "text": "1906, F. de Sinclair (pseudonym of August Herman van der Feen), Meneer Focus, Van Holkema & Warendorf (publ.), page 225.\nIneens laat Six de knalpot werken. Roets! daar stoven ze achteruit en voor zij bekomen waren van de schrik, vlogen wij weg.",
                                "translation": "Suddenly Six got the muzzler to function. Whoosh! there they rushed backwards and before they had recovered from their fright, we raced away.",
                                "english": "Suddenly Six got the muzzler to function. Whoosh! there they rushed backwards and before they had recovered from their fright, we raced away."
                            },
                            {
                                "example_id": "fbbbdfc2-13d2-45d7-bc68-03586cab55e7",
                                "sense_id": "1a201e42-32ca-33a2-9a5f-33a7aaafa244",
                                "text": "1909 January 28, advertisement, Zierikzeesche Nieuwsbode, vol. 65, no. 8726, page 4.\nVerloren: Knalpot Motorrijwiel, tusschen Duivendijke en Kerkwerve. Terugbezorging tegen belooning bij I. DE BROEKERT, Zierikzee.\nLost: Silencer of motorcycle, between Duivendijke and Kerkwerve. Return for reward at I. DE BROEKERT, Zierikzee."
                            }
                        ]
                    }
