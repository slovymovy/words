                                                "example_id": "497f7ec7-a6d2-4c72-8cbd-91d0e4cff6af",
                                                "sense_id": "62c94ca7-e0a5-364d-a64a-702b4e818495",
                                                "text": "Cape Verdeans waiting with perfect, timeless patience for a boat that may or may not come."
                                            },
                                            {
                                                "example_id": "264ce94d-b7ff-47b5-9f05-9af2b0a3eb63",
                                                "sense_id": "62c94ca7-e0a5-364d-a64a-702b4e818495",
                                                "text": "For Helio Batalha, a 27-year-old hip-hop artist who performed at the music expo, that blending of cultures and history has led to a form of identity crisis for young Cape Verdeans."
                                            }
                                        ]
