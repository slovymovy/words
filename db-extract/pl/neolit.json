                    {
                        "translation_id": "d9298879-8750-466b-b26e-6cdc601fe662",
                        "source_entry_id": "0f7322cb-c543-3ca3-a33c-6ed5d7214eb2",
                        "source_sense_id": "7636cc22-f6a6-3e50-b095-238f0b77e7bd",
                        "target_lang_word": "Néolithique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Néolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                        "entry_id": "2293458b-94f4-3995-bbbf-de72830c43b5",
                                        "glosses": [
                                            "Dernière période de l’âge de pierre."
                                        ],
                                        "tags": [
                                            "Préhistoire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cde875-5f28-4e2a-a54e-cbcc1144f925",
                                                "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                                "text": "Au Néolithique se développe un culte des crânes, pour créer et maintenir un lien avec les entités de l'autre monde."
                                            },
                                            {
                                                "example_id": "8ec38a4a-2299-4d86-8bde-23a76580ad2c",
                                                "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                                "text": "Les multicoques furent inventés dès le Néolithique, probablement par les peuples du Pacifique qui migraient, d'île en île, sur ces embarcations rapides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Néolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "009fc161-c10e-3400-8ed6-1a74fecd9616",
                                        "entry_id": "acb43678-16a8-3e1c-baaf-c2facf037e60",
                                        "glosses": [
                                            "Personne ayant vécu au Néolithique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ed0736-0cb3-457f-b9b7-6022cd5f7332",
                                                "sense_id": "009fc161-c10e-3400-8ed6-1a74fecd9616",
                                                "text": "Il faut dire que le « couloir périphérique » (…) fut soigneusement rebouché par les Néolithiques lorsqu’ils eurent fini d’utiliser l’allée couverte (…)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac484a40-155e-4340-a3dc-bbe2ca6eba94",
                        "source_entry_id": "0f7322cb-c543-3ca3-a33c-6ed5d7214eb2",
                        "source_sense_id": "7636cc22-f6a6-3e50-b095-238f0b77e7bd",
                        "target_lang_word": "Neolítico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "be2b0998-8d14-4290-b62f-5d542a5f48e6",
                        "source_entry_id": "0f7322cb-c543-3ca3-a33c-6ed5d7214eb2",
                        "source_sense_id": "7636cc22-f6a6-3e50-b095-238f0b77e7bd",
                        "target_lang_word": "Jungsteinzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jungsteinzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                        "entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                                        "glosses": [
                                            "Epoche der Menschheitsgeschichte, die als letzter Abschnitt der Steinzeit angesehen wird und durch die Entwicklung von frühen Siedlungen, Landwirtschaft, Domestikation von Wildtieren und Religion gekennzeichnet ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adfbf65b-c5a0-4b1e-8f6b-50f247325a3c",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Doch dann, mit Beginn der Jungsteinzeit vor 10.000 Jahren, explodierte die Menschenzahl – um das 1000-Fache in nur 500 Generationen.“"
                                            },
                                            {
                                                "example_id": "2dda3c56-fb5e-40cc-9f59-9d3cb0136da1",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Bereits in der Jungsteinzeit entdeckte man die hervorragende Eignung des hiesigen Basalts für das Mahlen von Getreide.“"
                                            },
                                            {
                                                "example_id": "1040a4d2-c36d-4518-9400-e338290301fa",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Die ersten Exemplare entstanden in der Jungsteinzeit, dabei handelt es sich um mächtige Erd- oder Steinpackungen über Großsteingräbern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5017ac8-3288-4af4-95af-747ceafa1906",
                        "source_entry_id": "0f7322cb-c543-3ca3-a33c-6ed5d7214eb2",
                        "source_sense_id": "7636cc22-f6a6-3e50-b095-238f0b77e7bd",
                        "target_lang_word": "Neolithikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neolithikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                        "entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
                                        "glosses": [
                                            "Epoche zwischen Mittelsteinzeit und Kupferzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c23f24-2b83-4b0c-834a-bcb5fde0f088",
                                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                                "text": "„Erste, grob-tonige, einfarbige und bei niederen Temperaturen (<650 °C) gebrannte Töpferwaren tauchen zu Beginn des Neolithikums auf.“"
                                            },
                                            {
                                                "example_id": "28e75e82-a652-4793-bd98-8f20f2100a96",
                                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                                "text": "„Man versucht, diese Sprachen mit den dort während des Neolithikums und der frühen Bronzezeit lebenden Völkern zu identifizieren, die man nach ihrer charakteristischen Bestattungsweise in Grabhügeln (Kurgan) als Kurgankultur bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c46357d-fc2d-4f15-9f10-fb9257ab1065",
                        "source_entry_id": "0f7322cb-c543-3ca3-a33c-6ed5d7214eb2",
                        "source_sense_id": "7636cc22-f6a6-3e50-b095-238f0b77e7bd",
                        "target_lang_word": "неолит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неолит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "419e8348-8c42-353c-9634-74dad027b094",
                                        "entry_id": "466d80a2-9eee-303b-ae86-4e2853dd2121",
                                        "glosses": [
                                            "археол. эпоха нового, позднего каменного века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0f4694-0785-4e3a-af12-b6bb69e0d939",
                                                "sense_id": "419e8348-8c42-353c-9634-74dad027b094",
                                                "text": "Все столпились возле ниши; в глубине её оказалось несколько головешек, угли, зола, обгорелые кости. Осмотрев внимательно площадку, нашли несколько очень грубо обделанных кремневых орудий и осколки кремня. — Люди каменного века! — заявил Ордин. ― И даже не неолита, а палеолита, судя по примитивности обделки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
