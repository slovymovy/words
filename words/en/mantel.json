{
    "word_family": [
        "mantelpiece"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e50c66-e72f-3d65-bdda-cba8935a9fb3",
                    "sense_definition": "The shelf above a fireplace which may be also a structural support for the masonry of the chimney.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fireplace_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed a framed photograph on the <w>mantel</w> above the fireplace.",
                            "target_lang_translations": {
                                "cs": "Na <w>krbovou římsu</w> nad krbem položila zarámovanou fotografii."
                            }
                        },
                        {
                            "text": "The old clock sat proudly on the <w>mantel</w> in the living room.",
                            "target_lang_translations": {
                                "cs": "Staré hodiny hrdě stály na <w>krbové římse</w> v obývacím pokoji."
                            }
                        }
                    ],
                    "synonyms": [
                        "mantelshelf"
                    ],
                    "common_phrases": [
                        "above the mantel",
                        "on the mantel"
                    ],
                    "target_lang_definitions": {
                        "cs": "Police nad krbem, která může sloužit i jako konstrukční prvek komína."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krbová římsa",
                                "target_lang_sense_clarification": "standardní označení pro polici nad krbem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd2c1ff6-fb4f-3b5c-9ffc-2ccc9b0d97ae",
                    "sense_definition": "A maneuver to surmount a ledge, involving pushing down on the ledge to bring up the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "climbing_maneuver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber performed a difficult <w>mantel</w> to reach the top of the rock.",
                            "target_lang_translations": {
                                "cs": "Lezec provedl obtížný <w>mantl</w>, aby dosáhl vrcholu skály."
                            }
                        },
                        {
                            "text": "He struggled to complete the <w>mantel</w> because the ledge was very slippery.",
                            "target_lang_translations": {
                                "cs": "Měl problém dokončit <w>mantl</w>, protože římsa byla velmi kluzká."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Lezecký manévr pro překonání hrany, při kterém se lezec vytlačuje rukama nahoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mantl",
                                "target_lang_sense_clarification": "horolezecký slangový výraz pro tento pohyb"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da618b44-93f5-37d6-8665-d75358a648af",
                    "sense_definition": "To surmount a ledge by pushing down on the ledge to bring up the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "climbing_maneuver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>mantel</w> carefully to avoid slipping off the edge.",
                            "target_lang_translations": {
                                "cs": "Musíš <w>mantlovat</w> opatrně, abys nesklouzl z hrany."
                            }
                        },
                        {
                            "text": "She managed to <w>mantel</w> onto the platform after several attempts.",
                            "target_lang_translations": {
                                "cs": "Po několika pokusech se jí podařilo <w>mantlovat</w> na plošinu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Překonat hranu skály nebo římsu pomocí vytlačení se rukama."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mantlovat",
                                "target_lang_sense_clarification": "sloveso odvozené z horolezeckého slangu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "45c19d9d-39f3-3639-b6de-5bf79a5cb220",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by Dr. <w>Mantel</w> last year.",
                            "target_lang_translations": {
                                "cs": "Výzkumnou práci napsal loni Dr. <w>Mantel</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Mantel</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal muže jménem pan <w>Mantel</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Mantel",
                                "target_lang_sense_clarification": "příjmení se v češtině nepřechyluje, pokud jde o cizí jméno"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}