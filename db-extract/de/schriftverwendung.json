                        "examples": [
                            {
                                "example_id": "71ece57a-e8b8-48fc-967b-c6631426b406",
                                "sense_id": "59f77858-5613-338f-a4a3-91ede5264952",
                                "text": "„Die Anfänge der Schriftverwendung in Alteuropa gehen auf das Ende des 6. Jahrhunderts vor Christus zurück.“"
                            },
                            {
                                "example_id": "3fa4afec-d058-4a86-ab01-f4cc34a04ef3",
                                "sense_id": "59f77858-5613-338f-a4a3-91ede5264952",
                                "text": "„Im globalen Vergleich hat Osteuropa somit die längste Tradition in der Schriftverwendung.“"
                            },
                            {
                                "example_id": "51eff4ef-eedc-4bdd-b687-e59c70cb53f1",
                                "sense_id": "59f77858-5613-338f-a4a3-91ede5264952",
                                "text": "„Im Postmodul werden insbesondere Schriftverwendung und Textgebrauch aus der didaktischen Landkarte angesprochen.“"
                            },
                            {
                                "example_id": "56a34782-5fe9-42b6-bc93-2c6724886b03",
                                "sense_id": "59f77858-5613-338f-a4a3-91ede5264952",
                                "text": "„Der Fund gibt Hoffnung, weitere Beweise für die Schriftverwendung in dieser Zeit zu entdecken. “"
                            }
                        ],
