                                        "sense_id": "cfabf995-3710-38cc-b8f3-9221e26467f8",
                                        "entry_id": "6e3c53ba-99de-3722-8e0d-0a7f891c3ecd",
                                        "glosses": [
                                            "Alternative spelling of radiotelephone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e15a8c6-9c86-457c-9b25-c62b5aaa1c5d",
                                                "sense_id": "cfabf995-3710-38cc-b8f3-9221e26467f8",
                                                "text": "Another interesting feature of the Falaise is that she is provided with a Denny Brown stabiliser to minimise rolling, and amenities for the passenger include the provision of a radio telephone service, which is available on passage."
                                            },
                                            {
                                                "example_id": "8ee3ea93-3c09-48b6-8f9a-38a97d7e1e2b",
                                                "sense_id": "cfabf995-3710-38cc-b8f3-9221e26467f8",
                                                "text": "Recently the L.M.R., in conjunction with Pye Telecommunications and the G.P.O., has been conducting trials between Crewe, Lancaster, Birkenhead, Liverpool and Manchester with a brakevan fitted up with radio-telephone equipment and beamed on G.P.O. radio-telephone stations in the Manchester and Liverpool area."
                                            },
                                            {
                                                "example_id": "bf12d680-1b1a-4551-a54c-a91922e92f47",
                                                "sense_id": "cfabf995-3710-38cc-b8f3-9221e26467f8",
                                                "text": "In accordance with Southampton Docks practice for shunting engines during the past four years, a radio-telephone in the cab allows two-way conversation with the Dock Traffic Control Office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
