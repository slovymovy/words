                        "air insolent",
                        "regard insolent"
                    ]
                },
                {
                    "sense_id": "90670f0d-b68b-3345-8533-7dc6bfdbc989",
                    "sense_definition": "Qui est remarquable et exceptionnel au point de paraître excessif ou provocant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune joueur de tennis affiche une réussite <w>insolente</w> depuis le début du tournoi."
                        },
                        {
                            "text": "Elle a une chance <w>insolente</w> à chaque fois qu'elle participe à cette loterie."
                        }
                    ],
                    "synonyms": [
