                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2ee79a1-fb96-38e7-b3c0-6f525c1e8654",
                        "entry_id": "47873617-39d3-36ec-87c7-5aecef027293",
                        "glosses": [
                            "An underground layer of water-bearing porous stone, earth, or gravel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd651f7-5c6a-4f9c-9615-008943824f5f",
                                "sense_id": "f2ee79a1-fb96-38e7-b3c0-6f525c1e8654",
                                "text": "The water in the well came from an aquifer."
                            },
                            {
                                "example_id": "1043173c-48e7-4ed8-9502-6dcdcf34e69c",
                                "sense_id": "f2ee79a1-fb96-38e7-b3c0-6f525c1e8654",
                                "text": "An aquifer is rock or sediment that holds groundwater – rain that is held below the surface of the soil and collected in empty spaces underground. Aquifers feed rivers to keep their flows at a healthy level, and are also important sources of water when reservoirs or other sources run low."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68508cd-232d-4fc9-9e04-18680899cfe0",
                        "source_entry_id": "47873617-39d3-36ec-87c7-5aecef027293",
                        "source_sense_id": "f2ee79a1-fb96-38e7-b3c0-6f525c1e8654",
                        "source_sense_description": "an underground layer of water-bearing porous stone, earth, or gravel",
                        "target_lang_word": "aquifer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquifer",
