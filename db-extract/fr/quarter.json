                ],
                "senses": [
                    {
                        "sense_id": "30464e04-f3da-389b-9139-9c8a000fd71d",
                        "entry_id": "0eb27e2b-4b9b-3f2b-8c34-8a76d25f09c6",
                        "glosses": [
                            "Pièce d'un quart de dollar américain, soit 25 cents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "207d51c8-fa9e-45f0-bd9e-9d8314bf691f",
                                "sense_id": "30464e04-f3da-389b-9139-9c8a000fd71d",
                                "text": "Dans les cabarets de Harlem, il y a encore des consommateurs qui ont gardé la vieille coutume de jeter des pièces de monnaie, en pourboire, aux musiciens qui leur ont plu. Un noir est venu déposer un quarter (le quart d’un dollar) sur le coin du piano."
                            },
                            {
                                "example_id": "2cd4445e-3421-4a7c-94c3-28d18e7edcb4",
                                "sense_id": "30464e04-f3da-389b-9139-9c8a000fd71d",
                                "text": "Il n'y eut plus de vélos jonchant le trottoir devant le magasin général de la famille Hendorf où l'on pouvait acheter une poignée de bonbons avec un quarter."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
