                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первобытный",
                                "target_lang_sense_clarification": "доисторический, древнейший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5a9a3e-513d-3506-8c4f-d78af4d71911",
                    "sense_definition": "zachowany w naturalnym, niezmienionym stanie przez człowieka",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "natura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W głębi puszczy zachował się <w>pierwotny</w> las, który nigdy nie został wycięty przez człowieka.",
                            "target_lang_translations": {
                                "ru": "В глубине пущи сохранился <w>девственный</w> лес, который никогда не вырубался человеком."
                            }
                        },
                        {
                            "text": "Park narodowy chroni krajobraz w jego niemal <w>pierwotnym</w> stanie przed zniszczeniem.",
                            "target_lang_translations": {
                                "ru": "Национальный парк защищает ландшафт в его почти <w>первозданном</w> состоянии от разрушения."
                            }
                        }
