                                "target_senses": [
                                    {
                                        "sense_id": "b23fdef4-b7c6-319b-9180-3a9cc16283ab",
                                        "entry_id": "3dc29945-bcd1-3727-ac42-025d017c1603",
                                        "glosses": [
                                            "huis om de zomer en de vakanties door te brengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513526cb-9cfa-4ec4-8658-cb8f3002b653",
                                                "sense_id": "b23fdef4-b7c6-319b-9180-3a9cc16283ab",
                                                "text": "Zij denken erover een zomerhuisje te kopen in het zuiden."
                                            }
                                        ]
