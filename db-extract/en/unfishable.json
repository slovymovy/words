                                "target_senses": [
                                    {
                                        "sense_id": "41d51cdc-92ad-3bfa-b186-fb59af3acdd0",
                                        "entry_id": "e6e2b73f-a321-3ed6-9796-b60c213e6a9f",
                                        "glosses": [
                                            "Qualifie un cours d’eau ou un plan d’eau où la pêche est impossible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c922663e-6070-40ac-a128-dbc630ba772a",
                                                "sense_id": "41d51cdc-92ad-3bfa-b186-fb59af3acdd0",
                                                "text": "« C’est impêchable. Je pêche ici depuis quarante ans et je n’ai jamais vu l’étang aussi mal entretenu », débobinait, mardi 29 septembre, au bord de l’étang-Gaillard, Jean-Pierre Suzanne."
                                            },
                                            {
                                                "example_id": "667111fa-10ef-49ad-97fb-f198ce182733",
                                                "sense_id": "41d51cdc-92ad-3bfa-b186-fb59af3acdd0",
                                                "text": "La partie amont était pleine suite à des embâcles au niveau du gué, elle s’est révélée impêchable vu le niveau d’eau et le résultat très faible de prises ne correspond pas à la potentialité de la rivière."
                                            },
                                            {
                                                "example_id": "f1ef7065-0485-45c6-bbe5-a6ca6a2ca651",
                                                "sense_id": "41d51cdc-92ad-3bfa-b186-fb59af3acdd0",
                                                "text": "Michel Perdriau l’explique très clairement : « En amont, le Thouet est plein d’herbes, c’est impêchable ; en aval, c’est pareil. Ici, le site est remarquable. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d213ef-4e07-30e2-8c33-cebe824d12b6",
                                        "entry_id": "e6e2b73f-a321-3ed6-9796-b60c213e6a9f",
                                        "glosses": [
                                            "Qualifie un poisson ou un autre animal que l’on ne peut pas pêcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7343a0f5-2a71-4c2d-89bb-f56a69b02484",
                                                "sense_id": "b6d213ef-4e07-30e2-8c33-cebe824d12b6",
                                                "text": "Si certaines espèces aiment les eaux froides (les morues fraient à 5°), en revanche la plupart des poissons carnassiers détestent les eaux froides, le bar cesse de manger lorsque l’eau est à 10°, à 7° il devient cataleptique, il est impêchable ; …."
                                            },
                                            {
                                                "example_id": "98e66b60-d682-41fa-8167-ef24be9e35cc",
                                                "sense_id": "b6d213ef-4e07-30e2-8c33-cebe824d12b6",
                                                "text": "Durant l’été, elle vit à la profondeur maximale de sa répartition bathymétrique, ce qui la rend impêchable."
                                            }
                                        ]
                                    }
