                            "superlative"
                        ],
                        "form": "most grammatically"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de229c71-5de1-3cf0-b232-4fbfed3535e9",
                        "entry_id": "1ac4242f-f8f9-32b3-aafd-39a27f864080",
                        "glosses": [
                            "In a grammatical manner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4ceb4c7d-d732-3ff3-9e2d-61b6128a7848",
                        "entry_id": "1ac4242f-f8f9-32b3-aafd-39a27f864080",
                        "glosses": [
                            "Concerning grammar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c548d6cd-b4da-45c4-ae51-e9be48be93a8",
                                "sense_id": "4ceb4c7d-d732-3ff3-9e2d-61b6128a7848",
                                "text": "For example, once the child is able to parse (i.e. grammatically analyse) an adult utterance such as Help Daddy and knows that it contains a verb phrase comprising the head verb help and its complement Daddy, then (on the assumption that the language faculty specifies that all heads of a given type behave uniformly with regard to whether they are positioned before or after their complements), the child will automatically know that all verbs in English are canonically (i.e. normally) positioned before their complements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e7a3dab-110d-4d86-8e59-d4e10dced52f",
                        "source_entry_id": "1ac4242f-f8f9-32b3-aafd-39a27f864080",
                        "source_sense_description": "in a grammatical manner",
                        "target_lang_word": "grammaticalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammaticalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "042339ee-40d9-3e03-929d-cb506bf8b916",
                                        "entry_id": "a809dfd1-aee9-3fdd-ad2f-94044c82c7ce",
                                        "glosses": [
                                            "Selon les règles de la grammaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2221ac18-af17-4620-a58c-11883547681c",
                                                "sense_id": "042339ee-40d9-3e03-929d-cb506bf8b916",
                                                "text": "Les déterminations qui affectent une substance individuelle n'existent pas par elles-mêmes, mais par inhérence à cette substance : grammaticalement, elles sont toujours prédicats, jamais sujets."
                                            },
                                            {
                                                "example_id": "f06428e5-92d2-4696-bc2b-a5abbb574bdd",
                                                "sense_id": "042339ee-40d9-3e03-929d-cb506bf8b916",
                                                "text": "Le questionnaire doit être rédigé dans une langue grammaticalement correcte et compréhensible pour tous les participants indépendamment de l’âge et du niveau d’enseignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20001673-ef04-38ea-ad88-d1eda8e19cd2",
                                        "entry_id": "a809dfd1-aee9-3fdd-ad2f-94044c82c7ce",
                                        "glosses": [
                                            "Du point de vue de la grammaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95802a8-8d5f-4a2c-94d6-7631d743a1db",
                                                "sense_id": "20001673-ef04-38ea-ad88-d1eda8e19cd2",
                                                "text": "Bien sûr, si grec et hébreu étaient des langues grammaticalement voisines, ces traductions auraient, en plus de cette littéralité, obtenu une certaine grâce, un semblant de beauté littéraire — une certaine lisibilité ; mais ce n’est nullement le cas : l’hébreu et le grec étant par nature grammaticalement dissemblables, le résultat de chaque traduction ne fut et ne put être, en raison de l’intention littérale, qu’un brouet, une suite hébraïque de mots grecs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc630f4c-5ae9-4e7d-bf9b-bf753d2e3769",
                        "source_entry_id": "1ac4242f-f8f9-32b3-aafd-39a27f864080",
                        "source_sense_description": "in a grammatical manner",
                        "target_lang_word": "grammatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                        "entry_id": "5e06cf61-ae76-3a1d-8f81-4941419040d5",
                                        "glosses": [
                                            "die Grammatik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54379b2-db94-44d9-988c-13b07622468e",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "Man sollte versuchen, grammatische Fehler zu vermeiden."
                                            },
                                            {
                                                "example_id": "16e14e46-5eee-447f-bc33-dbd403586fe2",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Auf der morphologischen, grammatischen und orthographischen Ebene ist die Einheitlichkeit der deutschen Standardsprache stets voll gewahrt geblieben…“"
                                            },
                                            {
                                                "example_id": "021b410e-cb81-4567-93e9-1c2df85292e8",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Das zeigt sich sowohl auf der grammatischen als auch auf der lexikalischen Ebene.“"
                                            },
                                            {
                                                "example_id": "7ead5004-e400-4365-8b12-56a6e62766c7",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Es handelt sich vielmehr um ein lexikalisches Merkmal prosodischer Art mit grammatischer Funktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebe9f819-c718-3870-9929-08437cd6c605",
                                        "entry_id": "5e06cf61-ae76-3a1d-8f81-4941419040d5",
                                        "glosses": [
                                            "die Regeln der Grammatik befolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c07407-e39c-4e95-8ca5-9baf1652be29",
                                                "sense_id": "ebe9f819-c718-3870-9929-08437cd6c605",
                                                "text": "Der Satz „Hans ist groß.“ ist grammatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
