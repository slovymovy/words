                ],
                "translations": [
                    {
                        "translation_id": "789f1264-89ee-40bf-bccc-87eacced90e2",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
                        "target_lang_word": "ceramist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceramist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                        "entry_id": "efe2947b-5ee7-3dee-a1cc-4839f637f9b9",
                                        "glosses": [
                                            "A person who makes ceramics objects; a potter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b1e68c-5436-4c29-a0b4-0abb53e31918",
                                                "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                                "text": "Wilson is part of a group of female ceramists from all over the globe who are meditating on the beauty of imperfection, age and artlessness, borrowing ideas from the past, including the Zen Buddhist philosophy of wabi-sabi."
                                            },
                                            {
                                                "example_id": "d37c4575-14a6-4b46-97ce-7444816ff521",
                                                "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                                "text": "The Corfu, Greece-born, London-based ceramist Agalis Manessi, 69, creates her animals — recumbent hounds, alert hares — from lumps of terra-cotta clay that she squeezes and manipulates “until a figure emerges.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "071f20f6-ddd3-4832-805c-a81e9e339037",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
                        "target_lang_word": "ceramicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceramicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                        "entry_id": "48de37d1-bdac-31c8-adf7-3a96e8aba978",
                                        "glosses": [
                                            "A person who makes ceramics, such as pottery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0266fe-3eb1-4497-9734-4432e25eddff",
                                                "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                                "text": "Otto Natzler, a ceramicist best known for inventing glazes resembling geologic textures and colors that he applied to forms created by his wife Gertrud in a famous collaboration of more than three decades, died on April 7 in Los Angeles."
                                            },
                                            {
                                                "example_id": "f8696d8e-d1b2-4966-83f2-0e3b83714454",
                                                "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                                "text": "While the work of the contemporary artists in the show is avant-garde, it does not overwhelm the colorful faience made by the Faucon family, seven generations of ceramicists who operated a factory in Apt, a town in the Luberon Valley, from 1890 until 2002."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af80a2a2-0ea7-44cf-a0ed-380ce9098d24",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
