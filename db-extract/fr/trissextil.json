                "senses": [
                    {
                        "sense_id": "606fa078-ffef-37a5-9476-0cd0e056ccb7",
                        "entry_id": "a6fdb40f-ad7f-38ec-824f-edcf334796da",
                        "glosses": [
                            "Se dit d’une année qui contient plus de 366 jours, principalement 30 jours un février."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1d7cfa8-e169-46b6-82ad-b54c74d06745",
                                "sense_id": "606fa078-ffef-37a5-9476-0cd0e056ccb7",
                                "text": "Vu à Liège ! Pourtant, on n'est pas dans une année trissextile ! #belgium"
                            },
                            {
                                "example_id": "82986b4e-ca29-4361-b66c-a392dc4a1c9c",
                                "sense_id": "606fa078-ffef-37a5-9476-0cd0e056ccb7",
                                "text": "Le 31 février tombe une année trissextile un fait rarissime, vous devriez faire gagner des abonnements pour un tel événement !"
                            },
                            {
                                "example_id": "bffb26dc-1e2b-479a-9d18-a179ade3fad8",
                                "sense_id": "606fa078-ffef-37a5-9476-0cd0e056ccb7",
                                "text": "Et oui, 2020 n’est pas une année bissextile mais une année trissextile. 🤓"
                            },
                            {
                                "example_id": "52a4088b-e554-4ddf-83e1-c762fb5fcfef",
                                "sense_id": "606fa078-ffef-37a5-9476-0cd0e056ccb7",
                                "text": "Le 30 février est un jour absent des calendriers actuellement en usage, le mois de février des calendriers grégorien et julien possédant en effet 28 jours les années les plus fréquentes et 29 jours les années bissextiles. Ce jour « trissextile » a été utilisé une fois dans l'Histoire, en Suède en 1712 (infra)."
                            }
                        ]
                    }
