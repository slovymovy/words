                                        "sense_id": "f8684067-f840-39b8-b270-6b71a7d7ec97",
                                        "entry_id": "9c1c39d2-dac2-36a0-8b90-88629b24e64b",
                                        "glosses": [
                                            "miasto portowe w Rosji nad Morzem Japońskim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02bb0d12-9e55-4d81-a77f-c5e48bf1539f",
                                                "sense_id": "f8684067-f840-39b8-b270-6b71a7d7ec97",
                                                "text": "Kolej transsyberyjska prowadzi z Moskwy przez Irkuck do Władywostoku i liczy ponad dziewięć tysięcy kilometrów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37ba6639-c9b2-45f2-8185-94df25b38f4e",
                        "source_entry_id": "a3c74409-7fe0-3886-bad0-452752378371",
                        "source_sense_id": "fd00ac1d-85b2-3a0f-9946-10667712b1db",
                        "source_sense_description": "seaport in Russia",
