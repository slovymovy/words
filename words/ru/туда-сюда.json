{
    "word_family": [
        "туда",
        "сюда"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a907cfce-806b-339b-9bfd-06b13429bb61",
                    "sense_definition": "В одном направлении и обратно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он весь день ходил <w>туда-сюда</w> по комнате.",
                            "target_lang_translations": {
                                "en": "He spent the whole day walking <w>back and forth</w> in the room."
                            }
                        },
                        {
                            "text": "Машина ездила <w>туда-сюда</w> по узкой дороге.",
                            "target_lang_translations": {
                                "en": "The car was driving <w>back and forth</w> along the narrow road."
                            }
                        }
                    ],
                    "synonyms": [
                        "взад и вперёд"
                    ],
                    "common_phrases": [
                        "ходить туда-сюда",
                        "бегать туда-сюда"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving from one place to another and back again."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "back and forth",
                                "target_lang_sense_clarification": "Used to describe physical movement between two points."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d68e804-16d8-3a3b-9567-501a15f42c38",
                    "sense_definition": "В разные места, без определенной цели.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы просто гуляли <w>туда-сюда</w> по всему городу.",
                            "target_lang_translations": {
                                "en": "We were just walking <w>here and there</w> all over the city."
                            }
                        },
                        {
                            "text": "Пришлось побегать <w>туда-сюда</w> по разным кабинетам.",
                            "target_lang_translations": {
                                "en": "I had to run <w>here and there</w> between different offices."
                            }
                        }
                    ],
                    "synonyms": [
                        "туды-сюды",
                        "взад-вперёд"
                    ],
                    "common_phrases": [
                        "бегать туда-сюда"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Часто используется в разговорной речи."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Moving between various places without a specific goal or purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here and there",
                                "target_lang_sense_clarification": "Used to describe aimless movement or being in various locations."
                            },
                            {
                                "target_lang_word": "all over the place",
                                "target_lang_sense_clarification": "Used to describe moving around many different locations."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "419be99e-9679-34f1-ab6d-dab565168e08",
                    "sense_definition": "Вполне приемлемо, удовлетворительно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильм, в принципе, <w>туда-сюда</w>, можно посмотреть.",
                            "target_lang_translations": {
                                "en": "The movie is <w>not bad</w>, in principle; it's worth watching."
                            }
                        },
                        {
                            "text": "Работа у него <w>туда-сюда</w>, жить можно.",
                            "target_lang_translations": {
                                "en": "His job is <w>passable</w>; you can make a living."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Разговорный стиль оценки."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Quite acceptable or satisfactory; passable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "not bad",
                                "target_lang_sense_clarification": "Colloquial way to say something is acceptable."
                            },
                            {
                                "target_lang_word": "passable",
                                "target_lang_sense_clarification": "Used to describe something that is just good enough."
                            },
                            {
                                "target_lang_word": "so-so",
                                "target_lang_sense_clarification": "Used to indicate something is average or mediocre."
                            }
                        ]
                    },
                    "synonyms": [
                        "так себе",
                        "сносно"
                    ]
                }
            ]
        }
    ]
}