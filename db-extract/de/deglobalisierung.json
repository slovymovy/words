                                    {
                                        "sense_id": "698e82e8-d8a5-3d94-b8af-0cf44f2b7d8b",
                                        "entry_id": "be6bc25c-8cc4-3c16-8e64-b14b080c018b",
                                        "glosses": [
                                            "The process of diminishing interdependence and integration between the economies of nations."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2eab00c-f691-4008-a8a9-9bf88a3e02bb",
                                                "sense_id": "698e82e8-d8a5-3d94-b8af-0cf44f2b7d8b",
                                                "text": "“We have entered the age of deglobalisation, where global supply chains are replaced by regional ones,” said Liu Meng-chun, an expert on the Chinese economy and cross-Strait economic relations at the Chung-Hua Institution for Economic Research, a government think-tank in Tapei."
                                            }
                                        ]
                                    }
                                ]
