                {
                    "sense_id": "227083f4-90d2-39e3-be45-13f6a5e2d77e",
                    "sense_definition": "A short pleasure trip or excursion, typically taken for leisure or as a social activity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "excursion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family planned a weekend <w>outing</w> to the seaside to enjoy the sunny weather.",
                            "target_lang_translations": {
                                "ru": "Семья запланировала <w>поездку</w> на выходные к морю, чтобы насладиться солнечной погодой."
                            }
                        },
                        {
                            "text": "After being stuck in the office all week, a family <w>outing</w> was exactly what they needed.",
                            "target_lang_translations": {
                                "ru": "После того как они всю неделю просидели в офисе, семейная <w>прогулка</w> была именно тем, что им нужно."
