                        "sense_id": "7f851143-23aa-3fe9-b28f-7ebd01945aab",
                        "entry_id": "403aba98-1f4f-30eb-aab8-43ecdc1db87b",
                        "glosses": [
                            "(notwendige/krankhafte/erzwungene) positive Erwartungshaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d100c5bb-f8bf-4fda-b05a-de49b2bc70bb",
                                "sense_id": "7f851143-23aa-3fe9-b28f-7ebd01945aab",
                                "text": "Die Vorstellung in der Prüfung bestehen zu können, ist eine Art Zwangsoptimismus."
                            },
                            {
                                "example_id": "15e844d9-e88d-4f89-b713-772fa7fc36a4",
                                "sense_id": "7f851143-23aa-3fe9-b28f-7ebd01945aab",
                                "text": "„Wenn wir eine stichhaltige Begründung für Phänomene wie Glücksboom, Positive Psychologie und Zwangsoptimismus suchen, hier finden wir sie.“"
                            },
                            {
                                "example_id": "cf6437df-52f1-41e9-ba65-4edae2b37673",
                                "sense_id": "7f851143-23aa-3fe9-b28f-7ebd01945aab",
                                "text": "„Eine pragmatische Ergebnisorientierung ist wesentlich nutzbringender als die oft beschworene „positive Einstellung“, hinter der sich oft genug nur ein selbstverordneter Zwangsoptimismus verbirgt.“"
                            }
                        ],
