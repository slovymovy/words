                                    {
                                        "sense_id": "4b62e9da-1ae6-34e4-83c6-cd6ccd47e16b",
                                        "entry_id": "8effc2de-c23e-309f-b8ee-ff1aecea2980",
                                        "glosses": [
                                            "Persona que se encarga de controlar las apuestas en las mesas de los casinos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25417672-2434-40e5-be1a-8874214446f1",
                                                "sense_id": "4b62e9da-1ae6-34e4-83c6-cd6ccd47e16b",
                                                "text": "el objetivo en todas ellas es exactamente el mismo: derrotar al crupier consiguiendo una mano de cartas que sumen un total de 21 puntos o se acerquen lo máximo posible sin superar dicha cifra"
                                            }
