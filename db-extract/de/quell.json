                    {
                        "sense_id": "563ba504-5fc1-399d-b5a7-07bd3498236a",
                        "entry_id": "2738efa1-90ad-3b9f-b76a-77ac9283d3a7",
                        "glosses": [
                            "Stelle, an der Wasser oder Luft austritt"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "3611c9e3-af51-4424-8040-035703e97dc3",
                                "sense_id": "563ba504-5fc1-399d-b5a7-07bd3498236a",
                                "text": "Während unserer Wanderung erquickten wir uns an einem kleinen Quell."
                            },
                            {
                                "example_id": "e06598a7-8a23-44a3-a636-ead2d7ae4321",
                                "sense_id": "563ba504-5fc1-399d-b5a7-07bd3498236a",
                                "text": "„Sie fanden auch den Quell und neben ihm eine Menge von dürren Ästen, von denen freilich schon ein großer Teil halb verfault war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0ee01d1a-c92e-3c0d-9de2-52108fa62b72",
                        "entry_id": "2738efa1-90ad-3b9f-b76a-77ac9283d3a7",
                        "glosses": [
                            "Ursprungsort, Ausgangspunkt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "03fb4544-905d-4d2e-8a96-81924aaa9df0",
                                "sense_id": "0ee01d1a-c92e-3c0d-9de2-52108fa62b72",
                                "text": "Der Quell des Lebens ist Gegenstand heißer Debatten."
                            }
                        ],
                        "sense_index_json": "\"2\""
