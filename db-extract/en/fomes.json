                        "glosses": [
                            "The morbid matter created by a disease."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bd5234c2-c032-425c-b941-8a869d5d2c3c",
                                "sense_id": "5250d91f-5435-38f4-8034-aa65c3bb1dd8",
                                "text": "If this putrid ferment could be more immediately corrected, a stop would probably be put to the flux, and the fomes of the disease likewise removed."
                            }
                        ]
