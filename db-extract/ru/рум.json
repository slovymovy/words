                "senses": [
                    {
                        "sense_id": "35187387-df47-315f-aa89-b75e0d1b7f96",
                        "entry_id": "315eae5f-2dd1-3fc1-b763-de07540a6eaa",
                        "glosses": [
                            "карт. то же, что покер-рум"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed193f55-2df2-44fc-b297-4dd6e8172a63",
                                "sense_id": "35187387-df47-315f-aa89-b75e0d1b7f96",
                                "text": "4 года Дюамель состоял в команде профессионалов рума PokerStars, покинув её в прошлом году."
                            },
                            {
                                "example_id": "937bf833-722b-4827-8a00-d1304cb688d1",
                                "sense_id": "35187387-df47-315f-aa89-b75e0d1b7f96",
                                "text": "Трафик некогда одной из популярнейших сетей покера (Cereus) на прошлой неделе сократился ещё на 29 процентов, после чёрной пятницы рум потерял уже 83 процента клиентов."
                            }
                        ]
                    }
