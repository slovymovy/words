                ],
                "translations": [
                    {
                        "translation_id": "52fee1ce-97a8-42c7-9396-98b809fbcfbc",
                        "source_entry_id": "0bd510d5-b5d6-3c99-8d6a-0c73ba46ca3f",
                        "source_sense_id": "e2523674-fe38-31e8-8e7f-48204fcab8f8",
                        "target_lang_word": "purchaser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purchaser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e3201f3-891e-30a3-9da2-7938253d763b",
                                        "entry_id": "e82a81aa-fba5-3ef3-a999-8cf01aec4451",
                                        "glosses": [
                                            "One who purchases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bc9368-4039-46c9-b213-5bd590f90159",
                                                "sense_id": "5e3201f3-891e-30a3-9da2-7938253d763b",
                                                "text": "If this was unrestricted freehold, the land is available for sale or lease, although often it is not readily marketable, by reason of its shape and access; neighbouring landowners are possible purchasers. In some cases, reversionary rights were reserved to neighbouring landowners when the land was acquired."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "054def86-6e66-43d9-8e7b-d14ea7ae0aaf",
                        "source_entry_id": "0bd510d5-b5d6-3c99-8d6a-0c73ba46ca3f",
                        "source_sense_id": "e2523674-fe38-31e8-8e7f-48204fcab8f8",
                        "target_lang_word": "buyer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buyer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "665ceffa-9bc5-3764-a29a-37eed8897e18",
                                        "entry_id": "9629b47c-de10-37e5-97ca-388389e4e18b",
                                        "glosses": [
                                            "A person who makes one or more purchases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbd3334-c018-4666-9a97-d4d4206b58c5",
                                                "sense_id": "665ceffa-9bc5-3764-a29a-37eed8897e18",
                                                "text": "Every person who steps through the door is a potential buyer, so acknowledge their presence."
                                            },
                                            {
                                                "example_id": "75d160d2-8f1a-4c06-9178-1af941362813",
                                                "sense_id": "665ceffa-9bc5-3764-a29a-37eed8897e18",
                                                "text": "There is the ultrasystematic buyer and his twin, the careless buyer. The ultrasystematic buyer goes and checks and counts and touches every copy in the store before buying a new one."
                                            },
                                            {
                                                "example_id": "3153a4ac-4047-48c2-b735-92bb4640cc31",
                                                "sense_id": "665ceffa-9bc5-3764-a29a-37eed8897e18",
                                                "text": "As we covered in the last chapter, breaches of confidentiality can stop a sale dead in its tracks. To avoid this, our firm plays good cop–bad cop with buyers about confidentiality. The good cop nicely explains that breaching confidentiality is bad, because it will ruin the business they're buying before they’ve even bought it. The bad cop puts the fear of God into them, telling them that if they breach confidentiality, the seller could file a lawsuit against them, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6142fdda-f2a0-3d3e-8264-c5fe7052fccf",
                                        "entry_id": "9629b47c-de10-37e5-97ca-388389e4e18b",
                                        "glosses": [
                                            "A person who purchases items for resale in a retail establishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af984b4-159a-48cd-b2a3-dee94b22192e",
                                                "sense_id": "6142fdda-f2a0-3d3e-8264-c5fe7052fccf",
                                                "text": "The supermarket's new buyer decided to stock a larger range of vegetarian foods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d4ea41-181b-32ed-b0e4-bcbd9bfd81ea",
                                        "entry_id": "9629b47c-de10-37e5-97ca-388389e4e18b",
                                        "glosses": [
                                            "A person who purchases items consumed or used as components in the manufacture of products."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1a5f07-151f-40c6-a6e0-95a369b7ece7",
                        "source_entry_id": "0bd510d5-b5d6-3c99-8d6a-0c73ba46ca3f",
                        "source_sense_id": "e2523674-fe38-31e8-8e7f-48204fcab8f8",
                        "target_lang_word": "acquéreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquéreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69edb460-c91d-309a-aedb-29ba0680876b",
                                        "entry_id": "1e15bada-f369-3941-971d-2aba0edd9f72",
                                        "glosses": [
                                            "Celui qui acquiert. Se dit surtout de celui qui acquiert des biens immobiliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229473ed-1ce1-4958-aeb3-0e1dd5060681",
                                                "sense_id": "69edb460-c91d-309a-aedb-29ba0680876b",
                                                "text": "On craignait que les émigrés enhardis n’exerçassent tous des violences sur les acquéreurs de leurs biens, pour en préparer la restitution en protestant ainsi contre un injuste dépouillement."
                                            },
                                            {
                                                "example_id": "27ecf777-4b33-41a2-b4b3-e67479c29a15",
                                                "sense_id": "69edb460-c91d-309a-aedb-29ba0680876b",
                                                "text": "Les restrictions convenues entre les parties dans le cadre de la cession d'une entreprise peuvent être en faveur de l'acquéreur ou du vendeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9efbfc2-8d2e-47e3-ba37-2fdf069816ca",
                        "source_entry_id": "0bd510d5-b5d6-3c99-8d6a-0c73ba46ca3f",
