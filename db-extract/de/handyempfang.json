                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17034cd2-04a8-40cc-9f11-aed3edc3ff11",
                                "sense_id": "36234125-02e7-3e18-817f-45ab19214799",
                                "text": "„Zu allem Überfluss hatten wir in dem Sturm keinen Handyempfang, um einen Abschleppdienst zu rufen.“"
                            },
                            {
                                "example_id": "b1df4ccf-fe71-4d01-8338-296b980763e5",
                                "sense_id": "36234125-02e7-3e18-817f-45ab19214799",
                                "text": "„Draußen auf den Inseln gibt es nicht einmal Internet oder Handyempfang.“"
                            },
                            {
                                "example_id": "522246fc-a7a8-4669-a6aa-4a136f7b101e",
                                "sense_id": "36234125-02e7-3e18-817f-45ab19214799",
                                "text": "„Handyempfang könnt ihr in der Hölle vergessen, und bildet euch bloß nicht ein, dass ihr beim Sterben in weiser Voraussicht euer Ladegerät bei euch haben werdet oder dass in den schimmligen Gefängniszellen hier kompatible Steckdosen zu finden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
