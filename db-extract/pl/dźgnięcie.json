                ],
                "senses": [
                    {
                        "sense_id": "b75635b3-1ae1-3cbf-9b03-d92ccbc755dd",
                        "entry_id": "95f302bb-6e0c-333e-8594-970ba6c2fb26",
                        "glosses": [
                            "ugodzenie ostrym przedmiotem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f34bf19-8bdf-4271-95f9-86fe50c6a92c",
                                "sense_id": "b75635b3-1ae1-3cbf-9b03-d92ccbc755dd",
                                "text": "Zanim się przeto oparło stopę na podłodze, można było dostać dziesięć kul, albo dźgnięć nożem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4c59139-80c9-4b0e-8ec0-f046ecca8a14",
                        "source_entry_id": "95f302bb-6e0c-333e-8594-970ba6c2fb26",
                        "source_sense_id": "b75635b3-1ae1-3cbf-9b03-d92ccbc755dd",
                        "target_lang_word": "stab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f4b5d3-59c6-330b-a321-0eaa2df9640f",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "An act of stabbing or thrusting with an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54707cce-1089-4b01-9150-9a74ba13028e",
                                                "sense_id": "c4f4b5d3-59c6-330b-a321-0eaa2df9640f",
                                                "text": "A knife was flashing in his hand, and just as he was about to take a stab at me, the smith grabbed his arm from behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7966fae1-7bfa-37b6-9071-52cb0100b397",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "A wound made by stabbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22be6b22-07f4-4b47-8808-95fd7ac388d5",
                                                "sense_id": "7966fae1-7bfa-37b6-9071-52cb0100b397",
                                                "text": "I opened the man's linen robe, and there over his heart was a dagger-wound, and beneath the woman's fair breast was a like cruel stab, through which her life had ebbed away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b74369-4f86-34e8-94b9-b907c3cce143",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "Pain inflicted on a person's feelings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f7fe1b-b04f-4053-b7f2-35334445a907",
                                                "sense_id": "86b74369-4f86-34e8-94b9-b907c3cce143",
                                                "text": "“I bet you two have really big plans. And might I say, that is just fab,” he said of Lynn's dress. “I'm glad someone noticed,” she replied, seeming to take a stab at me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7431c180-126c-3373-8151-91b7fb388588",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "An attempt."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5619129c-be8e-4573-b2e6-b1ca5818c0b0",
                                                "sense_id": "7431c180-126c-3373-8151-91b7fb388588",
                                                "text": "I'll give this thankless task a stab."
                                            },
                                            {
                                                "example_id": "850a8b2b-bb72-4c1b-8c4b-cb93fad882c8",
                                                "sense_id": "7431c180-126c-3373-8151-91b7fb388588",
                                                "text": "As yet, we don't know what the comparable figures will be like for the current financial year which ends in March 2022, but we can have a good stab at approximating them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f067393d-c69e-339e-938f-5fedf7dedb68",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "Criticism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "930d3606-14b6-39c2-8b24-ba59714a036f",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "A single staccato chord that adds dramatic impact to a composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "595708f3-0c93-4841-8ec5-ed6c81b6679e",
                                                "sense_id": "930d3606-14b6-39c2-8b24-ba59714a036f",
                                                "text": "a horn stab"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f762f66-a5ef-39e1-9da1-41cf743977e3",
                                        "entry_id": "34fbb3e9-9c62-3a60-857e-2c84a11d4ae0",
                                        "glosses": [
                                            "A bacterial culture made by inoculating a solid medium, such as gelatin, with the puncture of a needle or wire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faf11c67-0c8c-3ff0-bca1-525645f91c49",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To pierce or to wound (somebody) with a (usually pointed) tool or weapon, especially a knife or dagger."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b2dcaac-a9e3-49ab-8e9b-32e0e2c248f2",
                                                "sense_id": "faf11c67-0c8c-3ff0-bca1-525645f91c49",
                                                "text": "If you stab him in the heart he won't live long enough to retaliate."
                                            },
                                            {
                                                "example_id": "ee805232-7653-4e6e-a0f4-99d90f5d8a15",
                                                "sense_id": "faf11c67-0c8c-3ff0-bca1-525645f91c49",
                                                "text": "\"There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]\""
                                            },
                                            {
                                                "example_id": "6fa96186-6abe-46e4-be81-b8e085c09b62",
                                                "sense_id": "faf11c67-0c8c-3ff0-bca1-525645f91c49",
                                                "text": "Hornet blazed away as best she could, but, having to split her attention between high and low attackers, as well as having the aft 5-inch battery temporarily disabled by a young officer who'd accidentally run the guns into their stops, freezing them in position until the issue could be sorted, meant that two 550-pound semi-armor-piercing bombs, and one fractionally-lighter high-explosive bomb, soon crashed down, the first two stabbing deep into the ship and the other one blowing a hole in the flight deck, accompanied by a dive bomber that had been shot down but elected to go out by slamming into the Hornet as opposed to the sea. In some small comfort, that aircraft's bomb didn't go off as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44329658-cf22-375b-a5c2-bcba812236c6",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To thrust in a stabbing motion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f209a18-a5c0-4876-b768-50ba2c4e720b",
                                                "sense_id": "44329658-cf22-375b-a5c2-bcba812236c6",
                                                "text": "to stab a dagger into a person"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810e354c-d360-3f33-a2e5-a2b39ee76ad7",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To recklessly hit with the tip of a (usually pointed) object, such as a weapon or finger (often used with at)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7051825-cd0e-43fc-b70a-f408ef2a57b9",
                                                "sense_id": "810e354c-d360-3f33-a2e5-a2b39ee76ad7",
                                                "text": "He stabbed at my face with the twig but luckily kept missing my eyes."
                                            },
                                            {
                                                "example_id": "48707b4e-ba11-4274-9328-ce2b4e79442e",
                                                "sense_id": "810e354c-d360-3f33-a2e5-a2b39ee76ad7",
                                                "text": "None shall dare / With shortened sword to stab in closer war."
                                            },
                                            {
                                                "example_id": "14779be5-6246-4333-b3a3-e102be96a2e2",
                                                "sense_id": "810e354c-d360-3f33-a2e5-a2b39ee76ad7",
                                                "text": "Towards thee I roll, thou all-destroying but unconquering whale; to the last I grapple with thee; from hell's heart I stab at thee; for hate's sake I spit my last breath at thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28624b26-cb76-3838-8916-6f48392f7ac5",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To cause a sharp, painful sensation (often used with at)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ffef1f0-f1a7-438e-90a5-e3e2f21a7a19",
                                                "sense_id": "28624b26-cb76-3838-8916-6f48392f7ac5",
                                                "text": "The snow from the blizzard was stabbing at my face as I skied down the mountain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a693e00d-b403-3288-a400-faf1b2c383fb",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To injure secretly or by malicious falsehood or slander."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c68b29-15ec-4160-90b3-4dccde79caf0",
                                                "sense_id": "a693e00d-b403-3288-a400-faf1b2c383fb",
                                                "text": "to stab a person's reputation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9beec94-78c5-3918-8cad-eba51087a973",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To roughen a brick wall with a pick so as to hold plaster."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3759687-920e-342e-9219-61e6e941f57a",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To pierce folded sheets, near their back edges, for the passage of thread or wire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d70255d0-84b4-3ab6-81cc-4bc6cb851829",
                                        "entry_id": "8213c6c5-fe36-38a6-994a-8e64e2aeb544",
                                        "glosses": [
                                            "To guide the end of a pipe into a coupling when making up a connection."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7afe0fa8-6d12-4119-a8cc-e7a9bcbd86c6",
                                                "sense_id": "d70255d0-84b4-3ab6-81cc-4bc6cb851829",
                                                "text": "[O]ne of the derrickman's jobs is to \"stab\" the pipe."
                                            }
