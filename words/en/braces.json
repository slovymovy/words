                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used two <w>braces</w> to support the wooden shelf.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал две <w>скобы</w>, чтобы укрепить деревянную полку."
                            }
                        },
                        {
                            "text": "He needed several <w>braces</w> to fix the broken frame.",
                            "target_lang_translations": {
                                "ru": "Ему понадобилось несколько <w>опор</w>, чтобы починить сломанную раму."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Plural form of the noun brace."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова brace (опора, скоба, поддержка)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скобы",
                                "target_lang_sense_clarification": "крепежные элементы"
                            },
                            {
                                "target_lang_word": "опоры",
                                "target_lang_sense_clarification": "конструктивные элементы для поддержки"
                            }
                        ]
                    }
                }
            ]
        },
