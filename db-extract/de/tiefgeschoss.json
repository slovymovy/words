                "senses": [
                    {
                        "sense_id": "9b9d1b3b-7d88-306d-a03a-aed94c14a6ec",
                        "entry_id": "1ebcb313-f8b5-3822-8d28-409aa69bd575",
                        "glosses": [
                            "unter der Erde befindlicher Teil eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd9864c-fb33-436d-a86e-2c4300992661",
                                "sense_id": "9b9d1b3b-7d88-306d-a03a-aed94c14a6ec",
                                "text": "„Dort im Tiefgeschoss, zwischen Spinnweben und tausend Litern Alkohol, verborgen vor aller Welt, drehte ich (lebte ich!) meine erste Hollywoodszene: Ich betrat wieder diesen angstfreien Raum, in dem mich blitzartig jede Erinnerung an meine Vergangenheit verließ und ich das tat, was ich in diesem Augnblick für das einzig Richtige hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0cd9e0e-918f-4617-b5b6-856599f08608",
                        "source_entry_id": "1ebcb313-f8b5-3822-8d28-409aa69bd575",
                        "source_sense_id": "9b9d1b3b-7d88-306d-a03a-aed94c14a6ec",
                        "source_sense_description": "unter der Erde befindlicher Teil eines Gebäudes",
                        "target_lang_word": "sous-sol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-sol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8abae9-7917-3609-ad87-0a954cfb6373",
                                        "entry_id": "c21f37b0-1c1a-349d-969c-f1502600e1e2",
                                        "glosses": [
                                            "Partie d’un bâtiment qui est en dessous du rez-de-chaussée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f167c1a3-290d-431a-9c37-4819e6baf01b",
                                                "sense_id": "7c8abae9-7917-3609-ad87-0a954cfb6373",
                                                "text": "Deux escaliers, sous un maigre lumignon, plongent aussitôt vers un sous-sol."
                                            },
                                            {
                                                "example_id": "e9252bf0-0a92-4bb4-80b5-65ec5cea87ac",
                                                "sense_id": "7c8abae9-7917-3609-ad87-0a954cfb6373",
                                                "text": "Comme si l’opinion d’un Québécois dans son sous-sol allait avoir quelque incidence sur le résultat de l’élection américaine."
                                            },
                                            {
                                                "example_id": "100e3ad7-22e2-47a2-8424-f67d3b6d54df",
                                                "sense_id": "7c8abae9-7917-3609-ad87-0a954cfb6373",
                                                "text": "Le taxi nous recrache un à un sur le trottoir, nous nous précipitons l'un derrière l'autre sur trois marches menant à un club en sous-sol. La première boîte venue, boule à facettes, velours miteux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fded6c44-5354-3a69-9b66-2ff7f94f795e",
                                        "entry_id": "c21f37b0-1c1a-349d-969c-f1502600e1e2",
                                        "glosses": [
                                            "Couche du sol qui est en dessous de la terre végétale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccb180b-9488-4b6a-9ff6-27a703253d8b",
                                                "sense_id": "fded6c44-5354-3a69-9b66-2ff7f94f795e",
                                                "text": "L'esprit imaginatif qui envisage le temps nécessaire à la formation de la terre qui constitue le sol au-dessus du sous-sol' éprouve une sorte de vertige comme l'explorateur qui se penche au-dessus d'un gouffre insondable. La terre d'un sol, en effet, dérive généralement de la roche, de la pierre du sous-sol"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34818b68-402a-3c69-b655-dac545ef7c7a",
                                        "entry_id": "c21f37b0-1c1a-349d-969c-f1502600e1e2",
                                        "glosses": [
                                            "Ensemble des formations minérales qui gisent sous le sol arable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5cee0c-76f5-454c-8ef2-eafba2b54d88",
                                                "sense_id": "34818b68-402a-3c69-b655-dac545ef7c7a",
                                                "text": "Et pourquoi tant d’attention et de désir pour le joli village de Lassay-sur-Croisne, aurait-on détecté du gaz de schiste dans son sous-sol ?"
                                            },
                                            {
                                                "example_id": "02fb8f41-538b-45c2-b65e-f86e88cc98f0",
                                                "sense_id": "34818b68-402a-3c69-b655-dac545ef7c7a",
                                                "text": "Saisissons cette opportunité pour accélérer à Saint-Cloud l’implantation de panneaux photovoltaïques sur les toits de nos bâtiments, installons des ombrières et lançons un projet de géothermie afin de se chauffer grâce à nos sous-sols !"
                                            },
                                            {
                                                "example_id": "3da00a19-7070-47f7-8c34-3c30bd9c56f2",
                                                "sense_id": "34818b68-402a-3c69-b655-dac545ef7c7a",
                                                "text": "Une approche plus scientifique soulignerait la nature karstique du sous-sol, constamment changeante et propice à l’irruption de sources où il n’y en avait pas...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
