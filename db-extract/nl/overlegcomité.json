                    {
                        "sense_id": "f47079f8-c770-3a02-941f-d25e6e783a8c",
                        "entry_id": "44282735-b124-3358-ba63-24f19e1f6f20",
                        "glosses": [
                            "een orgaan waarin vertegenwoordigers zetelen van de verschillende Belgische regeringen om overleg te plegen en conflicten te voorkomen of beslechten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1ebceb-7b42-4548-913c-bd12838a787b",
                                "sense_id": "f47079f8-c770-3a02-941f-d25e6e783a8c",
                                "text": "Belgische huisartsen willen dat het Overlegcomité van de verschillende regeringen nog voor vrijdag bijeenkomt om te spreken over extra coronamaatregelen, melden Belgische media. Ze sluiten zich daarmee aan bij verschillende virologen en epidemiologen, die eerder al aan de bel trokken."
                            },
                            {
                                "example_id": "75dc988b-82f5-484d-adb3-c5572c913b48",
                                "sense_id": "f47079f8-c770-3a02-941f-d25e6e783a8c",
                                "text": "Praktisch betekent de uitspraak dat in beginsel onder meer theaters in België dinsdagavond weer open kunnen gaan. De Belgische gezondheidsautoriteit die de coronamaatregelen tot stand brengt, het Overlegcomité, heeft 22 december bepaald dat de cultuursector op slot moet om de volksgezondheid voor gevaren te behoeden, maar de Raad van State ziet daar geen gegronde onderbouwing voor, aldus Belgische media. De sluiting van andere binnenactiviteiten blijft wel van kracht."
                            }
                        ]
                    }
