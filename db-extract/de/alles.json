                    },
                    {
                        "sense_id": "ba5801d6-e786-3ba2-8ef8-99844749661d",
                        "entry_id": "8e6b9185-f99e-3196-96f1-d7e5a29e4ed0",
                        "glosses": [
                            "all (as in \\\"we all\\\" etc.)"
                        ],
                        "tags": [
                            "colloquial",
                            "indefinite",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "b3a3d0dc-1db6-4d1b-b4d8-6dffd63541a8",
                                "sense_id": "ba5801d6-e786-3ba2-8ef8-99844749661d",
                                "text": "Ihr seid alles Idioten.",
                                "translation": "You're all idiots.",
                                "english": "You're all idiots."
                            },
                            {
                                "example_id": "6edc2d6e-0052-4a7d-99d3-e8fb1a5e9de3",
                                "sense_id": "ba5801d6-e786-3ba2-8ef8-99844749661d",
                                "text": "Die Politiker haben alles keine Ahnung.",
                                "translation": "The politicians all don’t have a clue.",
                                "english": "The politicians all don’t have a clue."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb92b0d2-e220-3ec8-b2bb-522bd6447258",
                        "entry_id": "8e6b9185-f99e-3196-96f1-d7e5a29e4ed0",
                        "glosses": [
                            "Used with an interrogative to express that the answer probably covers more than one item, like dialectal English all."
                        ],
                        "tags": [
                            "colloquial",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "bb0eaea5-8199-498e-bbc9-5a64fe7279a7",
                                "sense_id": "cb92b0d2-e220-3ec8-b2bb-522bd6447258",
                                "text": "Wer war alles schon mal in Spanien?",
                                "translation": "Who all has ever been to Spain?",
                                "english": "Who all has ever been to Spain?"
                            },
                            {
                                "example_id": "a4edfbdb-837d-4c16-99ef-4614ceee69a0",
                                "sense_id": "cb92b0d2-e220-3ec8-b2bb-522bd6447258",
                                "text": "Wo seid ihr alles gewesen?",
                                "translation": "Where all did you go?",
                                "english": "Where all did you go?"
                            }
                        ]
                    }
                ],
