                ],
                "senses": [
                    {
                        "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                        "entry_id": "3c4e18b5-64a2-3a4e-849f-95a97351b676",
                        "glosses": [
                            "Produkt, das aus ökologischer und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73dbad7f-a157-41e2-a293-2a4e0bb85515",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Denn frisch geerntetes Obst und Gemüse vom konventionellen Bauern um die Ecke ist immer noch besser als Bioware aus Südamerika oder Biofertiggerichte.“"
                            },
                            {
                                "example_id": "f17a4562-08d2-490b-a971-4490d4e92f0f",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Die Produkte sind zu 90 Prozent Bioware, das Angebot ist in großen Teilen saisonal.“"
                            },
                            {
                                "example_id": "43a9ac03-6616-4ab3-bb96-18e9826634fc",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Die Zugereisten kaufen Bioware bei den Kleinbauern und haben eine Sozialwährung eingeführt.“"
                            },
                            {
                                "example_id": "08e70a44-315a-43a7-8941-8aa467f34764",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Bei höherer Ökoproduktion würde wegen der Skalenerträge der Preis von Bioware sinken, aber natürlich nie auf das Niveau der heutigen Handelspreise fallen.“"
                            },
                            {
                                "example_id": "f317785f-02db-4bfc-9ba7-c41920374c12",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Lediglich bei den Obstbäumen und dem Weinberg werde ein drittes Umstellungsjahr vorgeschrieben, bis die Ernte als Bioware deklariert werden dürfe.“"
                            },
                            {
                                "example_id": "89384f08-9067-475d-b92f-beaee7021d5c",
                                "sense_id": "8db7b98e-4d6e-33cf-8161-b4ccda05e034",
                                "text": "„Doch die Umstellung ist aufwendig, und der Bauer muss in Vorleistung treten, weil er in den ersten Jahren der Umstellung die sinkenden Ernten noch nicht als Bioware verkaufen darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
