                    }
                ],
                "senses": [
                    {
                        "sense_id": "73c09380-0b61-3d44-b50f-a8d52df1b3f6",
                        "entry_id": "6c6cb0b6-a2be-3780-9483-4153914809bb",
                        "glosses": [
                            "mała, niewielka ilość"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "be1105bd-976f-4a97-b388-f04cfa76b7ee",
                                "sense_id": "73c09380-0b61-3d44-b50f-a8d52df1b3f6",
                                "text": "Dodaj do sosu krztę soli."
                            },
                            {
                                "example_id": "3ba73640-3f6e-4d88-9e64-f20515568b2a",
                                "sense_id": "73c09380-0b61-3d44-b50f-a8d52df1b3f6",
                                "text": "Materializm, gruby, chamski materializm, karierowiczostwo, obłuda lub oportunizm obitych kundli… Ani krzty myśli, ani krzty ideałów, ani krzty serca…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13daf6ac-fa2c-44ce-9dfb-ed534373c876",
                        "source_entry_id": "6c6cb0b6-a2be-3780-9483-4153914809bb",
                        "source_sense_id": "73c09380-0b61-3d44-b50f-a8d52df1b3f6",
                        "target_lang_word": "hint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc38938-9f31-3185-811a-3a549fe417d2",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "A clue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b54b2398-d2fa-46e9-84b2-1e95cee6f7ee",
                                                "sense_id": "6dc38938-9f31-3185-811a-3a549fe417d2",
                                                "text": "I needed a hint to complete the crossword."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6825c80-83be-3fc9-b3bd-502800485356",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An implicit suggestion that avoids a direct statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17661c8-37d7-43cc-a28d-931c1b338b40",
                                                "sense_id": "e6825c80-83be-3fc9-b3bd-502800485356",
                                                "text": "He gave me a hint that my breath smelt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "A small, barely detectable amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c663b0d-e6ad-4e15-b864-0e0497083427",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "There was a hint of irony in his voice."
                                            },
                                            {
                                                "example_id": "97ac672c-88d8-4abb-ae0d-39b596fe82f6",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "I could taste a hint of lemon in my iced water."
                                            },
                                            {
                                                "example_id": "5b15a3c3-96b5-4ddf-b7be-90dfe6e27317",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "And I perceived no touch of change,\n⁠No hint of death in all his frame,\n⁠But found him all in all the same, […]"
                                            },
                                            {
                                                "example_id": "baed4055-6df7-4b71-bb8c-ff2b64514aab",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "Mother very rightly resented the slightest hint of condescension. She considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45756485-3365-3668-9345-294ff2695301",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "Information in a computer-based font that suggests how the outlines of the font's glyphs should be distorted in order to produce, at specific sizes, a visually appealing pixel-based rendering; an instance of hinting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c7a934-58a2-45f2-bdbb-7b4bbc98af8b",
                                                "sense_id": "45756485-3365-3668-9345-294ff2695301",
                                                "text": "This font does not scale well to small sizes; the hints for the 10-point letter 'g' still need work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119eb8cb-35e2-30ac-8181-f45407aa9434",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An instruction to the database engine as to how a query should be executed, for example whether to use an index or not."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2470a45f-35ef-33c3-b3b6-c49161b9d5ef",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An opportunity; occasion; fit time."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39af65d7-9996-4d42-a182-f72b52d1f27d",
                                                "sense_id": "2470a45f-35ef-33c3-b3b6-c49161b9d5ef",
                                                "text": "I, not remembering how I cried out then, / Will cry it o'er again: it is a hint / That wrings mine eyes to't."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To imply without a direct statement; to provide a clue."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23a634f-0382-4258-907d-213b62e1b70c",
                                                "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                                "text": "I have tried, as I hinted, to enlist the co-operation of other capitalists, but experience has taught me that any appeal is futile that does not impinge directly upon cupidity."
                                            },
                                            {
                                                "example_id": "3419be90-6760-4fe6-8ea6-18cf160a03fd",
                                                "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                                "text": "She hinted at the possibility of a recount of the votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To bring to mind by a slight mention or remote allusion; to suggest in an indirect manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca90c359-e591-4bef-a006-1191b4f18bf0",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "to hint a suspicion"
                                            },
                                            {
                                                "example_id": "44e961c4-1279-48e4-ae44-f99833f20fe0",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "VVilling to vvound, and yet afraid to ſtrike, / Juſt hint a fault and heſitate diſlike; […]"
                                            },
                                            {
                                                "example_id": "8c3617fa-a4eb-468b-a398-88d55a2b17fa",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "We shall not describe this tragical scene too fully; but we thought ourselves obliged, by that historic integrity which we profess, shortly to hint a matter which we would otherwise have been glad to have spared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98e3326-b234-3147-ad84-9c900deaa4a0",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To develop and add hints to a font."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89150376-227f-4f69-9493-8691e400a841",
                                                "sense_id": "a98e3326-b234-3147-ad84-9c900deaa4a0",
                                                "text": "The typographer worked all day on hinting her new font so it would look good on computer screens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9dab46-324f-3d15-a1de-48a12d0a2e5f",
                                        "entry_id": "1cb6ca61-915a-3896-80bc-84a64c9a4fa2",
                                        "glosses": [
                                            "Signifies that something previously said should be taken as a hint or heeded closely."
                                        ],
                                        "tags": [
                                            "often",
                                            "reduplication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10859fb9-d532-4836-a0a0-e41a5f2e3e31",
                                                "sense_id": "7b9dab46-324f-3d15-a1de-48a12d0a2e5f",
                                                "text": "And yes, as long as you are being a good coder and engaging in safe practices, nothing should go wrong. (Hint, hint.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
