                                        "examples": [
                                            {
                                                "example_id": "cde007e4-c10a-4c6f-b311-8dc626e6113a",
                                                "sense_id": "0753f558-aff8-37c6-b517-558926de1d32",
                                                "text": "En réalité, cette patiente avait été victime d’une grave hémorragie méningée survenue brutalement dix ans auparavant. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 391)"
                                            },
                                            {
                                                "example_id": "21380bd1-0a25-4192-8609-ce3c7e467c98",
                                                "sense_id": "0753f558-aff8-37c6-b517-558926de1d32",
                                                "text": "Le syndrome méningé est dû à une inflammation de la dure-mère ou de l’arachnoïde."
                                            },
                                            {
                                                "example_id": "96ad003f-7d63-4bf4-8130-a6da9c2c4cb6",
                                                "sense_id": "0753f558-aff8-37c6-b517-558926de1d32",
                                                "text": "Le sac méningé contient le liquide céphalo-rachidien, une partie de la moelle épinière, et la racine des nerfs lombo-sacrés."
                                            },
                                            {
                                                "example_id": "bacbe621-8997-471a-ba97-45f74935ef0d",
                                                "sense_id": "0753f558-aff8-37c6-b517-558926de1d32",
                                                "text": "Les cellules du revêtement méningé de l’encéphale et de la moelle épinière."
                                            }
                                        ]
                                    }
