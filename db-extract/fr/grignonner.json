                                "example_id": "19ab059f-4497-4643-bc9e-faff5e58af8b",
                                "sense_id": "9590e23a-cc97-31ad-ac21-9ebe14ae7317",
                                "text": "Pendant qu’on me coupe la tête Mes mains griffonnent des anions Vous savez ces petites bêtes Qui grignonnent les hommicrons"
                            },
                            {
                                "example_id": "7158c3b9-0afe-45ab-92d9-cd916ea8e5d7",
                                "sense_id": "9590e23a-cc97-31ad-ac21-9ebe14ae7317",
                                "text": "Elle se réveilla au petit matin en sursaut, un rat lui grignonnait son doigt."
                            }
                        ]
                    }
