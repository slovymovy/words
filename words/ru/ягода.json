                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В сорок пять баба — снова <w>ягода</w> опять.",
