    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b814e1c0-1028-39e2-b842-f48d3074a173",
                    "sense_definition": "van zeer goede kwaliteit; uitstekend",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is een <w>prima</w> wijntje voor deze prijs.",
                            "target_lang_translations": {
