                ],
                "senses": [
                    {
                        "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                        "entry_id": "a836daf4-0c8f-362f-98e8-40f8ec265cb2",
                        "glosses": [
                            "Eigenschaft/Grad, in welchem Maße Verteilung/Zerlegung (Dispersion) vorliegt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "fe2f548e-b821-4221-9442-46af65d0c005",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Die Dispersität ist ein Maß für die Zerteilung disperser Teilchen in einem Trägermedium.“"
                            },
                            {
                                "example_id": "06f9fe61-d21c-4598-b8f1-0cb199115e65",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Ein Kolloid kann daher durch Erhöhung der „Dispersität“ zur molekularen Lösung werden oder anderseits durch Verminderung des Dispersitätsgrades zum grobdispersen Körper.“"
                            },
                            {
                                "example_id": "b6a8480b-77d5-4de5-85c4-a2eaeecee9bf",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Die Anwesenheit von Elektrolyten (Salzen) verändert die Dispersität der Farbstoffe. Neben Verkleinerung der Teilchengröße durch geringe Zusätze tritt von einer bestimmten Elektrolytkonzentration ab eine Vergrößerung derselben ein.“"
                            },
                            {
                                "example_id": "ed4073bc-78a2-47ab-ac9e-9190aff59e47",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Das Adsorptionsvermögen eines Kolloids ist außer von anderen Faktoren besonders von dem Grad der Dispersität abhängig.“"
                            },
                            {
                                "example_id": "3a06384d-71c0-4c68-9dc3-22dc27f0f82b",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Die Dispersität ist das Größenspektrum aller Primärpartikel, das der Minerale ebenso wie das organischer Partikel. Sie kann als Gefügezustand bei völliger Zerteilung angesehen werden und vereinigt in sich die Körnung (auch Textur genannt) der einzelnen Mineral- und Humusgruppen.“"
                            },
                            {
                                "example_id": "2e5b11c5-3b8d-433e-9e70-551573ae8e3b",
                                "sense_id": "640e6849-ae44-30ca-87ed-b50aff49d64f",
                                "text": "„Abhilfe dagegen schafft nur die Verringerung der Dispersität des Bodens durch Kalkung und Zuführung organischer Substanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
