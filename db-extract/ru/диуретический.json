                "senses": [
                    {
                        "sense_id": "60f6546f-2504-34ac-ad17-521c9db53f8d",
                        "entry_id": "e4268002-5275-3ae8-8aa1-c794798cf1d8",
                        "glosses": [
                            "мед. мочегонный; усиливающий выделение мочи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d0bb50c-53fa-43ea-a326-4479fc976492",
                                "sense_id": "60f6546f-2504-34ac-ad17-521c9db53f8d",
                                "text": "В связи с наличием маннита реоглюман обладает высокой осмотической активностью, снижает вязкость крови, дезагрегирует форменные элементы крови, дает гемодинамический, дезинтоксикационный и диуретический эффекты."
                            }
                        ]
                    }
                ],
