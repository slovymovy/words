                "senses": [
                    {
                        "sense_id": "ab60a25b-7574-3746-b0c1-00229ec6ca30",
                        "entry_id": "4f35d4e0-e268-302c-ae88-3d495ee09c64",
                        "glosses": [
                            "Personne qui murmure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b1043a-c392-49ee-bf7d-0147e95a8982",
                                "sense_id": "ab60a25b-7574-3746-b0c1-00229ec6ca30",
                                "text": "Déjà les statuts de Jean de Bourbon prévoyaient que dans l'ordre de Cluny, « tout conspirateur, sussureur, murmureur » doit être excommunié."
                            },
                            {
                                "example_id": "99948801-5b49-4ddb-a42d-69733274bdaf",
                                "sense_id": "ab60a25b-7574-3746-b0c1-00229ec6ca30",
                                "text": "Après les vedettes hurlantes, les vieux ados marmonneurs, les aphones bafouilleurs, les gueulards cacophoniques, les chuinteurs engagés, les cover-girls et les putains de la République recyclées en susurreuses, v'là que se pointe une nouvelle espèce encensée illico par les gogos et les médias : le murmureur nauséeux qui accouche ses texticules comme s'il allait dégueuler après chaque mot."
                            }
                        ]
                    }
                ],
