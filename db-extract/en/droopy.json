                                    }
                                ]
                            },
                            {
                                "target_word": "tombant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "059ee929-34f5-3173-81ed-d6d9f2770297",
                                        "entry_id": "56d8295c-865c-3558-9636-35ccbed19911",
                                        "glosses": [
                                            "Participe présent de tomber."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe432b3a-b8fb-44e7-aaad-a549d3753377",
                                                "sense_id": "059ee929-34f5-3173-81ed-d6d9f2770297",
                                                "text": "Il s’engouffra dans le véhicule, tombant sur le siège, et par la vitre entre-baissée il criait, trépignant : \"Je veux les têtes, messieurs, les têtes !\"."
                                            },
                                            {
                                                "example_id": "86bf22f7-40de-427c-94fb-8405a4875d3b",
                                                "sense_id": "059ee929-34f5-3173-81ed-d6d9f2770297",
                                                "text": "Un mois plus tard, les amis de Ouin-Ouin retournent au cimetière et trouvent sur la tombe de sa femme : « Elle est montée au ciel en tombant dans l’escalier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
