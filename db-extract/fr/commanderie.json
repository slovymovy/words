        "fr-extract.jsonl": [
            {
                "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                "word": "commanderie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8483afc3-c1d0-4eaf-abe1-581e089ad234",
                        "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                        "tags": [
                            "plural"
                        ],
                        "form": "commanderies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "147a02d2-5df8-35d2-8844-82e1887d0382",
                        "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                        "glosses": [
                            "Bénéfice affecté à l’ordre de Malte ou à un autre ordre militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b05700-4ae1-47c7-abe1-ee39e8ce4d2b",
                                "sense_id": "147a02d2-5df8-35d2-8844-82e1887d0382",
                                "text": "Située sur la commune de Saint-Martin-sur-Oreuse, la commanderie de Launay, la plus ancienne fondation de l’Ordre de l’Hôpital dans l’Yonne, administre, à partir du xvᵉ siècle et jusqu’en 1789, la plupart des maisons hospitalières du Sénonais et du Jovignien."
                            },
                            {
                                "example_id": "4d92a5f9-7f8d-4224-8a36-a563e3928bae",
                                "sense_id": "147a02d2-5df8-35d2-8844-82e1887d0382",
                                "text": "C’est dès ce moment que cette commanderie devint une chambre prieurale, c’est-à-dire qu’elle fut attachée à la dignité de Grand-Prieur de France."
                            },
                            {
                                "example_id": "516cc474-eb88-405d-a0a7-4c41129f50ca",
                                "sense_id": "147a02d2-5df8-35d2-8844-82e1887d0382",
                                "text": "Dans les ordres du S. Esprit & de S. Louis, les grands officiers appellés commandeurs ne le sont que de nom, n’y ayant aucune commanderie attachée à leur dignité, mais seulement des pensions."
                            }
                        ]
                    },
                    {
                        "sense_id": "18f6e4c6-e5c4-3ea5-8590-3b9b488e66d3",
                        "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                        "glosses": [
                            "Édifice où résidait un commandeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8327cf6a-b3e3-47ea-bb0f-2c0356eb631b",
                                "sense_id": "18f6e4c6-e5c4-3ea5-8590-3b9b488e66d3",
                                "text": "Que le prieur Aymer garde mon gage et celui d’un vagabond inconnu, en assurance que, si le chevalier Ivanhoé revient sur le sol qu’enferment les quatre mers de la Bretagne, il ait à relever le défi de Brian de Bois-Guilbert, et que, s’il n’y répond pas, je le proclamerai lâche sur les murailles de toutes les commanderies des templiers de l’Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab2abfe1-ef90-3f16-86c7-5b2d35eb0fd5",
                        "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                        "glosses": [
                            "Grade, qualité de commandeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8c3a0a-16e5-4023-9a3c-3bdbfaadca58",
                                "sense_id": "ab2abfe1-ef90-3f16-86c7-5b2d35eb0fd5",
                                "text": "« Mon hôtel sur les Champs-Élysées, mon fauteuil à l’Académie, ma commanderie de la Légion d’honneur, tout cela ne me procure aucun plaisir : j’ai fait exactement tout ce qu’il fallait pour l’avoir. »"
                            },
                            {
                                "example_id": "c934e86b-6997-42ad-bf67-eea76c61d169",
                                "sense_id": "ab2abfe1-ef90-3f16-86c7-5b2d35eb0fd5",
                                "text": "Je serai très heureux de vous remettre cette commanderie de la Légion d’Honneur et de vous dire en cette circonstance les mots d’admiration et d’amitié […]"
                            },
                            {
                                "example_id": "61aed50a-c905-4c70-8269-6da9f00d5397",
                                "sense_id": "ab2abfe1-ef90-3f16-86c7-5b2d35eb0fd5",
                                "text": "Très vite la France s’attacha les services de cet artiste de valeur en lui accordant la charge d’Architecte en Chef du Gouvernement et des Palais nationaux, charge dont l’accomplissement devait le mener sous la coupole de l’Institut avec une Commanderie de la Légion d’honneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "3074ac7e-a2f7-3198-99db-555aed12f996",
                        "entry_id": "7878f522-32ba-379a-a771-67fe974d3c17",
                        "glosses": [
                            "Insigne du grade de commandeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90cc3fb-0922-4af8-98aa-38e3ac7b0090",
                                "sense_id": "3074ac7e-a2f7-3198-99db-555aed12f996",
                                "text": "Les Français titulaires de la commanderie de la Légion d’honneur ne doivent pas porter en même temps une autre commanderie au cou."
                            }
                        ]
                    }
                ],
