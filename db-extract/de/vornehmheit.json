                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39118020-af15-4f54-a579-32db6149294d",
                                "sense_id": "1edad1c1-6598-3172-8d6b-0ab61f89457a",
                                "text": "„Auch die Cousine äußerte kein Widerwort, und so ging der Vater sehr befriedigt, daß er mir einen neuen Beweis seiner Vornehmheit gegeben hatte, hinauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63b3e5ff-c54a-3995-9d53-bdebdaad7cb8",
                        "entry_id": "4b4bdaa2-7fef-3c96-8bc0-06f89be303e8",
                        "glosses": [
                            "Eigenschaft, von hoher Kultiviertheit zu zeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72788e5-8881-44ec-a105-b652637cf4d3",
                                "sense_id": "63b3e5ff-c54a-3995-9d53-bdebdaad7cb8",
                                "text": "„Der Raum war, deutlich zu sehen, längere Zeit weder renoviert noch bewohnt worden, hatte aber trotzdem die Vornehmheit alter Hotelzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
