                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042c5465-78be-4cd2-a490-475463df83c7",
                                "sense_id": "778a5ccb-8a5b-3dd7-8d72-1adbb8445b72",
                                "text": "Bereits am Montagmittag lagen zwanzig Zentimeter Schnee, was sich bis zum Abend nochmals verdoppelte."
                            },
                            {
                                "example_id": "ac4a65c2-704a-405d-b3eb-290545043b7a",
                                "sense_id": "778a5ccb-8a5b-3dd7-8d72-1adbb8445b72",
                                "text": "Wir haben uns für Montagmittag in der Kantine verabredet."
                            },
                            {
                                "example_id": "af7cb195-2043-4194-a753-da10bae09592",
                                "sense_id": "778a5ccb-8a5b-3dd7-8d72-1adbb8445b72",
                                "text": "Die Montagmittage verbringt Eulalie vorwiegend mit ihrem Freund in der Stadt."
                            }
                        ],
