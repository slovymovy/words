                ],
                "senses": [
                    {
                        "sense_id": "7b9ae80e-57fa-3ac0-a3d2-5ed019b41ce4",
                        "entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "glosses": [
                            "Qui a beaucoup de duvet, en parlant des oiseaux et des fruits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90658151-3830-4ec6-a27b-7d297210fadc",
                                "sense_id": "7b9ae80e-57fa-3ac0-a3d2-5ed019b41ce4",
                                "text": "— Le castor fournit un pelage duveteux, très fin avec de longs poils brillants. C'est une matière textile de luxe qui vient de Sibérie ou du centre de l'Amérique."
                            },
                            {
                                "example_id": "3741d217-35d3-4a88-a79f-e130ced915c7",
                                "sense_id": "7b9ae80e-57fa-3ac0-a3d2-5ed019b41ce4",
                                "text": "Venez vite! Les oeufs se fendillent! Ohoah! Nous allons avoir vingt p’tits poussins duveteux!"
                            },
                            {
                                "example_id": "75a88951-f286-4016-8869-6774afa7334a",
                                "sense_id": "7b9ae80e-57fa-3ac0-a3d2-5ed019b41ce4",
                                "text": "Le kiwi est un fruit à la peau duveteuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "63a0b333-6beb-3fb8-a2fa-f3761c031aaa",
                        "entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "glosses": [
                            "Qui a les qualités du duvet."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c9256e29-c7f3-4a0d-8274-a68a43fa0838",
                                "sense_id": "63a0b333-6beb-3fb8-a2fa-f3761c031aaa",
                                "text": "Nuages blancs et duveteux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ab35fa7-ec45-4517-b4dc-c5e841c324ed",
                        "source_entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "target_lang_word": "flaumig",
