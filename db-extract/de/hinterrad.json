                "senses": [
                    {
                        "sense_id": "290e7c7d-5783-3ca9-9cf7-ebdd1e65a3ef",
                        "entry_id": "9c121c93-22fc-3d45-99c5-6f6f2e757eef",
                        "glosses": [
                            "Rad an der/einer Hinterachse eines Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576a0656-da0c-4e0c-b282-d7c04f5ac89d",
                                "sense_id": "290e7c7d-5783-3ca9-9cf7-ebdd1e65a3ef",
                                "text": "„Nur manchmal war tiefer, weicher Sand über die Straße geweht, der mein Hinterrad ins Schlingern brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f8d294b-c7bf-49bd-b252-d6d162e48637",
                        "source_entry_id": "9c121c93-22fc-3d45-99c5-6f6f2e757eef",
                        "source_sense_id": "290e7c7d-5783-3ca9-9cf7-ebdd1e65a3ef",
                        "source_sense_description": "Technik: Rad an der/einer Hinterachse eines Fahrzeugs",
                        "target_lang_word": "roue arrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roue arrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "025a0185-bbb2-3e23-81f4-7a98181a8bd2",
                                        "entry_id": "d9b48294-7f24-31b8-b091-c17c311b9971",
                                        "glosses": [
                                            "Roue placée à l'arrière d'un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b35359c-b941-3928-8c6f-2f2a35f7c87c",
                                        "entry_id": "d9b48294-7f24-31b8-b091-c17c311b9971",
                                        "glosses": [
                                            "Position d’un véhicule dans laquelle seule la ou les roues arrières sont en contact avec le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aecdffd-c552-4688-99d8-bd3489cc0205",
                                                "sense_id": "1b35359c-b941-3928-8c6f-2f2a35f7c87c",
                                                "text": "D’après les premiers éléments de l’enquête, il n’y aurait pas de témoin direct de cet effroyable accident mais certaines personnes, interrogées à proximité du lieu du drame, rapportent qu’elles ont vu une moto rouler à grande vitesse quelques minutes avant l’accident, faisant même des roues arrière."
                                            },
                                            {
                                                "example_id": "5e07a403-e01c-4d9e-bf07-dc41ad22ac68",
                                                "sense_id": "1b35359c-b941-3928-8c6f-2f2a35f7c87c",
                                                "text": "L’élu a par ailleurs expliqué qu’il ne fallait «pas parler de rodéo urbain». «Ce n’est pas le cas. Vous avez un individu qui a un comportement criminel, qui roule beaucoup trop vite et qui fait une roue arrière sur une route très fréquentée», a-t-il précisé. En juin, l’édile avait constaté ce phénomène de «rodéos urbains», avec des véhicules sur les trottoirs, lors d’un mariage, qu’il avait fini par annuler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a1bff5-1b77-340b-a5dc-1efe8c2e492d",
                                        "entry_id": "d9b48294-7f24-31b8-b091-c17c311b9971",
                                        "glosses": [
                                            "Figure acrobatique consistant à conduire un véhicule à deux-roues, en équilibre sur la roue arrière."
                                        ],
                                        "tags": [
                                            "Sports mécaniques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b088e6fd-90c3-4745-bf2d-9113d9bbaa8f",
                                                "sense_id": "d9a1bff5-1b77-340b-a5dc-1efe8c2e492d",
                                                "text": "Là, sur la route, face au petit immeuble de quatre étages, un garçon fait le beau, en roue arrière sur son scooter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
