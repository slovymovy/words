                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "206a526b-4447-43f3-8b56-8d4005db88a8",
                        "entry_id": "3daabb9a-ffba-3fa2-b13f-bde11787867b",
                        "tags": [
                            "plural"
                        ],
                        "form": "anachoreten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e727434f-9634-33dc-bbc6-3ea82bcf8909",
                        "entry_id": "3daabb9a-ffba-3fa2-b13f-bde11787867b",
                        "glosses": [
                            "iemand die alleen en in afzondering leeft"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f99de5a-5d4b-4b07-8883-d10a8b7055ef",
                        "source_entry_id": "3daabb9a-ffba-3fa2-b13f-bde11787867b",
                        "source_sense_id": "e727434f-9634-33dc-bbc6-3ea82bcf8909",
                        "target_lang_word": "Einsiedler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsiedler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                        "entry_id": "5cdeadc1-6661-3193-ae25-dfd048df697c",
                                        "glosses": [
                                            "in Zurückgezogenheit lebender Mann (zum Beispiel aus religiöser Überzeugung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eddb9ebb-0b1a-4b74-a27f-1acacf159e6f",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "Der Einsiedler sagte, sie hätte ja noch ihre königlichen Kleider an, damit könne sie nicht reisen."
                                            },
                                            {
                                                "example_id": "50ab3c5e-6ba6-4017-af04-ccaad5734d27",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Er wird Einsiedler, erst im Schwarzwald, schließlich, am Ende einer seltsamen Weltreise, auf einer einsamen Insel.“"
                                            },
                                            {
                                                "example_id": "7c6e5a8c-dc2a-4ee6-9504-6e9fd39662c0",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Ich wurde von dem Einsiedler geweckt, der sehr zufrieden schien, mich gesund und heil zu sehen.“"
                                            },
                                            {
                                                "example_id": "8cf2526d-3be6-4ac0-b7f5-6db43f229915",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Preben Kauffmann fand hinter dem Strand eine Höhle und richtete sie gemütlich her, um die nächsten vierzig Jahre seines Lebens als Einsiedler zu verbringen.“"
                                            },
                                            {
                                                "example_id": "ed251bcc-b467-4a8a-952c-6880de5cd9a0",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Der Besucher verrichtete artig einen vierfachen Stirnaufschlag, erst vor dem Buddhabildnis, dann vor dem alten Einsiedler, dann nahm er schweigend und abwartend zu Seiten der Andachtsmatte Aufstellung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d9f0bbe-ea97-405f-b923-4d115c69e034",
                        "source_entry_id": "3daabb9a-ffba-3fa2-b13f-bde11787867b",
                        "source_sense_id": "e727434f-9634-33dc-bbc6-3ea82bcf8909",
                        "target_lang_word": "anchorite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anchorite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                        "entry_id": "d8f0752a-7368-3ca3-b831-01016e7e7f0c",
                                        "glosses": [
                                            "One who lives in isolation or seclusion, especially for religious reasons; hermit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8045cc9a-fd1a-4ee3-a4c3-ee88b813d3ab",
                                                "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                                "text": "Oh, hang him? He's a very Anchorite—a young Hermit!"
                                            },
                                            {
                                                "example_id": "45ac655f-82a3-48d9-92ef-d42890b5c6d5",
                                                "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                                "text": "The household was diminished, and its expenses curtailed. There was a very blank anchorite repast when Pen dined from home: and he himself headed the remonstrance from the kitchen regarding the deteriorated quality of the Fairoaks beer."
                                            },
                                            {
                                                "example_id": "e58f41b2-3aff-42fe-8128-f616327b7c02",
                                                "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            },
                                            {
                                                "example_id": "2785f34b-7613-44d2-9636-04995c40a214",
                                                "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                                "text": "“Haven't you been in love since you came to Paris?”\n“I haven't got time for that sort of nonsense. Life isn't long enough for love and art.”\n“Your appearance doesn't suggest the anchorite.”"
                                            },
                                            {
                                                "example_id": "f203fa22-df64-4603-ace3-5c1fd89d8289",
                                                "sense_id": "3e94b54a-15a4-3d36-826c-828228cfac7f",
                                                "text": "About 1150 some Palestinian anchorites adopted the eremitical rule of St. Basil, and spread throughout Palestine; when the Moslems captured the Holy Land these \"Carmelites\" migrated to Cyprus, Sicily, France, and England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "120dbbcb-f2c8-43e3-839d-1fc64bfc72d0",
                        "source_entry_id": "3daabb9a-ffba-3fa2-b13f-bde11787867b",
                        "source_sense_id": "e727434f-9634-33dc-bbc6-3ea82bcf8909",
                        "target_lang_word": "anachorète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachorète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                        "entry_id": "a28aad0b-8c1f-304e-b01d-160ad0fe372b",
                                        "glosses": [
                                            "Religieux qui se retire dans la solitude pour mener une vie de contemplation et de pénitence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd69684-5350-4a80-97b0-ad3e8763853a",
                                                "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                                "text": "Ces pauvres gens, anachorètes au sein de Paris, ont toutes les jouissances des anachorètes, et peuvent parfois succomber à leurs tentations ; mais plus souvent trompés, trahis, mésentendus, il leur est rarement permis de recueillir les doux fruits de cet amour qui, pour eux, est toujours comme une fleur tombée du ciel."
                                            },
                                            {
                                                "example_id": "87895a46-34c3-4800-a083-74e022240b98",
                                                "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                                "text": "Si Dieu m’accordait le calme céleste, aérien, la prière — comme les anciens saints. — les saints ! des forts ! les anachorètes, des artistes comme il n’en faut plus !"
                                            },
                                            {
                                                "example_id": "aa36923a-7259-4376-9fb3-a1c78e6d745d",
                                                "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                                "text": "C’est une montagne très vénérée […]. Elle est habitée, paraît-il, par de saints anachorètes, qui y vivent dans des cavernes, à peine vêtus, priant, se mortifiant et laissant aux pieux pèlerins le soin de pourvoir à leurs besoins matériels."
                                            },
                                            {
                                                "example_id": "a653250f-ed32-4d88-8cb8-ebe633884735",
                                                "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                                "text": "Une petite cellule d'anachorète, meublée d'un lit de fer, d'une table en rotin et d'une armoire bon marché, servait de chambre et de bureau au professeur Mivvins."
                                            },
                                            {
                                                "example_id": "03514556-7559-4908-ad22-a2413eba739e",
                                                "sense_id": "43f4154b-d58b-34ec-a09a-a5e400948da5",
                                                "text": "S’il pleut, il lui raconte des histoires. Une seule m’est parvenue, celle de l’anachorète mérovingienne, sainte Rolende, gloire du folklore local."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a03dde-55fb-3679-ba7b-bbc93c7d9f87",
                                        "entry_id": "a28aad0b-8c1f-304e-b01d-160ad0fe372b",
                                        "glosses": [
                                            "Personne qui mène, loin du monde et de son agitation, une vie austère et vertueuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c669122c-a8a3-424f-af39-9f8e0ba21690",
                                                "sense_id": "36a03dde-55fb-3679-ba7b-bbc93c7d9f87",
                                                "text": "Ce savant est un anachorète."
                                            },
                                            {
                                                "example_id": "be1560ad-1452-4c26-8885-5224b9907d75",
                                                "sense_id": "36a03dde-55fb-3679-ba7b-bbc93c7d9f87",
                                                "text": "Quarante anachorètes triés sur le volet ! Et voilà ce qu’ils deviennent dès qu’on leur confie une femme ? Ah ! Que la chair est faible ! Que la chair est donc faible !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
