    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58b2cdd7-e3c8-3ba4-b4b5-202858443b83",
                    "sense_definition": "Sauvegarder des données ou des fichiers sur un support de mémoire informatique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pensez à <w>enregistrer</w> votre travail régulièrement pour ne perdre aucune modification importante."
                        },
                        {
                            "text": "Elle <w>enregistre</w> le document sous un nouveau nom avant de fermer l'ordinateur."
                        }
                    ],
                    "synonyms": [
                        "sauvegarder"
                    ],
                    "antonyms": [
                        "effacer",
                        "supprimer"
                    ],
                    "common_phrases": [
                        "enregistrer un fichier",
                        "enregistrer les modifications",
                        "enregistrer sous"
                    ]
                },
                {
                    "sense_id": "0811b16e-736d-3aa8-b41c-e55a23eb180c",
                    "sense_definition": "Fixer des sons ou des images sur un support afin de pouvoir les reproduire plus tard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "audiovisuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le groupe va <w>enregistrer</w> son nouvel album dans un studio renommé de la capitale."
                        },
                        {
                            "text": "J'<w>enregistre</w> cette émission de radio pour pouvoir la réécouter tranquillement ce soir."
                        }
                    ],
                    "antonyms": [
                        "effacer"
                    ],
                    "common_phrases": [
                        "enregistrer un album",
                        "enregistrer une vidéo",
                        "enregistrer une émission"
                    ]
                },
                {
                    "sense_id": "77a3d367-0814-3758-a9ee-0a6cfbb3b408",
                    "sense_definition": "Déclarer sa présence ou confier ses bagages au départ d'un voyage.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>enregistrer</w> nos bagages au moins deux heures avant le décollage du vol."
                        },
                        {
                            "text": "Vous devez vous <w>enregistrer</w> à la réception dès votre arrivée à l'hôtel."
                        }
                    ],
                    "common_phrases": [
                        "enregistrer ses bagages",
                        "s'enregistrer en ligne"
                    ]
                },
                {
                    "sense_id": "2c5ddb8f-3c0e-3888-8182-85b7b7567f76",
                    "sense_definition": "Inscrire officiellement des informations ou un acte juridique dans un registre public ou administratif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé de mairie vient d'<w>enregistrer</w> la déclaration de naissance avec toutes les pièces demandées."
                        },
                        {
                            "text": "La police a pu <w>enregistrer</w> sa plainte dès son arrivée au commissariat."
                        }
                    ],
                    "common_phrases": [
                        "enregistrer une plainte",
                        "enregistrer une marque",
                        "enregistrer un acte"
                    ]
                },
                {
                    "sense_id": "22021ebf-96d9-3ab1-aec0-1d1a99d62723",
                    "sense_definition": "Constater, relever ou observer une valeur, un événement ou une évolution statistique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise vient d'<w>enregistrer</w> une forte hausse de son chiffre d'affaires ce trimestre."
                        },
                        {
                            "text": "Les stations météorologiques ont <w>enregistré</w> des températures particulièrement élevées cet été."
                        }
                    ],
                    "common_phrases": [
                        "enregistrer une hausse",
                        "enregistrer une baisse",
                        "enregistrer un record"
                    ]
                }
            ]
        }
    ]
}