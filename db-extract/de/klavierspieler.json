                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                        "entry_id": "5f18e136-692c-3a2d-9b77-ffdeeea84188",
                        "glosses": [
                            "jemand, der Klavier spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c77e1e4-f344-41ac-ad14-78f87c678af8",
                                "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                                "text": "Der Klavierspieler wurde vom Publikum bejubelt."
                            },
                            {
                                "example_id": "37a401f4-1ce8-40e0-953a-f632c753bec1",
                                "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                                "text": "„Es wird viel getrunken, die Zigaretten mit dem bläulichen Rauch sind selbstgedreht, man tanzt und singt bis zum Tagesanbruch, und nicht selten löst ein Klavierspieler den Phonographen ab.“"
                            },
                            {
                                "example_id": "0809bf43-97a3-4434-af45-003ae4e286cc",
                                "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                                "text": "„Der Klavierspieler hackte seine Fingerübungen im Tangotempo.“"
                            },
                            {
                                "example_id": "605c0a01-f2e7-410f-b708-01061868ac5c",
                                "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                                "text": "„Der neue Kommandant hörte, daß er nicht nur Klavierspieler war, sondern auch malte.“"
                            },
                            {
                                "example_id": "e82496a5-4d4a-42c8-bdb6-165002a09f46",
                                "sense_id": "4a2f45a2-3de6-3866-94ec-318ba0f39a7b",
                                "text": "„Geld verdient er sich als Klavierspieler in einem Kinotheater, er spielt mit dem Gedanken, Zuhälter zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
