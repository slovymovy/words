                                "target_senses": [
                                    {
                                        "sense_id": "c67d5904-c812-3452-95cc-9f68847bbcd4",
                                        "entry_id": "4cf211e3-f606-37ad-b148-76d224ecc12e",
                                        "glosses": [
                                            "simple past and past participle of gut-shoot"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gut-shot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01969de7-414e-397f-afd7-5ab9058f0aa2",
                                        "entry_id": "beb8f097-3333-31e5-b302-0ae5be355538",
                                        "glosses": [
                                            "Having been shot in the gut."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d308d87-0659-4062-99ce-5917f3e37a9c",
                                                "sense_id": "01969de7-414e-397f-afd7-5ab9058f0aa2",
                                                "text": "For instance, one writer who discussed tracking gut-shot deer talked about a kidney hit and compared it to the liver and stomach wound."
                                            },
                                            {
                                                "example_id": "9747e3bb-101c-40b3-b50c-6a1dc6910a0b",
                                                "sense_id": "01969de7-414e-397f-afd7-5ab9058f0aa2",
                                                "text": "The terrible screams of this gut-shot kid made you do a lot of thinking of things besides hunting for the road."
                                            },
                                            {
                                                "example_id": "533d6476-56c7-4d01-8516-e6bad66e80cd",
                                                "sense_id": "01969de7-414e-397f-afd7-5ab9058f0aa2",
                                                "text": "Alone and gut-shot, Eddie staggers to a church, seeking sanctuary and salvation, but collapses on the steps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e101100-cb08-3569-9edb-a6f5c3cf847c",
                                        "entry_id": "beb8f097-3333-31e5-b302-0ae5be355538",
                                        "glosses": [
                                            "Extremely dismayed or distressed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e7a4f78-fd52-4455-ae67-0066f92c57b1",
                                                "sense_id": "5e101100-cb08-3569-9edb-a6f5c3cf847c",
                                                "text": "What he liked, his mother absolutely wouldn't like, and since it had been his bright idea for Conchita to come over so that she might finally meet his mother, an idea that, as soon as it was broached, developed an alarming weight of regret, regret so heavy he found himself unable to put the phone back in the cradle and instead dropped it on the floor, where it twirled and twirled on its coily black cord, and now that she was standing in his mother's kitchen looking not at all like a ten-dollar hooker but more like a two-dollar one, Sonny felt gut-shot, or maybe run over by a bus."
                                            },
                                            {
                                                "example_id": "a8445fa3-aa7d-4edc-947c-7a4ffddb60bb",
                                                "sense_id": "5e101100-cb08-3569-9edb-a6f5c3cf847c",
                                                "text": "She still felt gut-shot with guilt."
                                            },
                                            {
                                                "example_id": "d7b2bee1-460c-44a5-8f57-b281b852ccf8",
                                                "sense_id": "5e101100-cb08-3569-9edb-a6f5c3cf847c",
                                                "text": "Jude felt gut-shot in a way he couldn't explain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gut-shot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6517ae1-ebe2-3f0a-839c-71cc8840dd95",
                                        "entry_id": "33e4e4d0-77f6-33c1-b8f0-773bab900e6b",
                                        "glosses": [
                                            "Alternative form of gut shot."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c61d36-a8f1-41fd-8644-462b2c1bbaf8",
                                                "sense_id": "b6517ae1-ebe2-3f0a-839c-71cc8840dd95",
                                                "text": "The stocky Apache released his burden and sank to his knees, his head bending forward and thrusting into the sand as the pain from the gut-shots began to course through his body."
                                            },
                                            {
                                                "example_id": "7cedda27-6200-4e96-913c-6f6c55798b2d",
                                                "sense_id": "b6517ae1-ebe2-3f0a-839c-71cc8840dd95",
                                                "text": "When he ran dry, he switched to a high-velocity handgun. Gut-shots, chest-shots."
                                            },
                                            {
                                                "example_id": "4f65d168-f02c-49c2-b075-38fd36ce7f09",
                                                "sense_id": "b6517ae1-ebe2-3f0a-839c-71cc8840dd95",
                                                "text": "He showed her how to throw punches: hooks, jabs, head-shots, gut-shots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
