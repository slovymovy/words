                {
                    "sense_id": "f3ebaf0f-31fe-3aea-94ff-0a34f2e8f33d",
                    "sense_definition": "The specific time when a ship departs from a port.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voyage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sailing</w> is scheduled for noon, so please arrive early.",
                            "target_lang_translations": {
                                "ru": "<w>Отплытие</w> запланировано на полдень, поэтому, пожалуйста, приезжайте пораньше.",
                                "tr": "<w>Kalkış</w> öğle vakti için planlandı, bu yüzden lütfen erken gelin.",
                                "zh": "<w>启航</w>时间定在中午，所以请早点到达。"
                            }
                        },
                        {
                            "text": "Bad weather delayed the <w>sailing</w> by several hours.",
                            "target_lang_translations": {
                                "ru": "Плохая погода задержала <w>отплытие</w> на несколько часов.",
                                "tr": "Kötü hava koşulları <w>kalkışı</w> birkaç saat geciktirdi.",
                                "zh": "恶劣的天气使<w>启航</w>推迟了几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "departure"
                    ],
                    "antonyms": [
                        "arrival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное время отправления корабля из порта.",
                        "tr": "Bir geminin limandan ayrıldığı belirli zaman.",
                        "zh": "船只离开港口的具体时间。"
                    },
                    "translations": {
                        "ru": [
