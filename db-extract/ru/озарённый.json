                    {
                        "sense_id": "22aa13f8-2585-30f6-a9f7-7b3370a59caf",
                        "entry_id": "157c22c6-853e-3611-a273-6c5d15552005",
                        "glosses": [
                            "past passive perfective participle of озари́ть (ozarítʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "participle",
