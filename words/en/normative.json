{
    "word_family": [
        "norm",
        "normal",
        "normativity",
        "normatively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0341536-8be8-3787-8b1c-a37ed3cfe1a9",
                    "sense_definition": "Relating to or based on an established norm, standard, or value judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee presented a <w>normative</w> framework to guide ethical decision-making in the company.",
                            "target_lang_translations": {
                                "zh": "委员会提出了一套<w>规范性</w>框架，以指导公司内部合乎道德的决策。"
                            }
                        },
                        {
                            "text": "Philosophers distinguish between descriptive statements of fact and <w>normative</w> statements of value.",
                            "target_lang_translations": {
                                "zh": "哲学家区分了对事实的描述性陈述与关于价值的<w>规范性</w>陈述。"
                            }
                        }
                    ],
                    "synonyms": [
                        "standard"
                    ],
                    "antonyms": [
                        "descriptive"
                    ],
                    "common_phrases": [
                        "normative framework",
                        "normative ethics",
                        "normative judgment"
                    ],
                    "target_lang_definitions": {
                        "zh": "与既定准则、标准或价值判断相关的；评价性的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "规范性的",
                                "target_lang_sense_clarification": "涉及标准或价值判断的"
                            },
                            {
                                "target_lang_word": "标准的",
                                "target_lang_sense_clarification": "符合或作为基准的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87232318-f85f-3b78-90ca-55180dc65480",
                    "sense_definition": "Prescribing how things ought to be done; establishing rules or standards.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prescriptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional <w>normative</w> grammar tells speakers which structures are considered correct.",
                            "target_lang_translations": {
                                "zh": "传统的<w>规范</w>语法会告诉说话者哪些结构被认为是正确的。"
                            }
                        },
                        {
                            "text": "The author took a strongly <w>normative</w> approach, prescribing strict policies for the government.",
                            "target_lang_translations": {
                                "zh": "作者采取了极具<w>规定性</w>的方法，为政府开出了严格的政策药方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prescriptive"
                    ],
                    "antonyms": [
                        "descriptive"
                    ],
                    "common_phrases": [
                        "normative grammar",
                        "normative approach"
                    ],
                    "target_lang_definitions": {
                        "zh": "规定性的；确立行为规则或操作标准的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "规范性的",
                                "target_lang_sense_clarification": "规定应该怎么做的"
                            },
                            {
                                "target_lang_word": "规定性的",
                                "target_lang_sense_clarification": "确立强制规则或标准的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b7a3c1-2c97-3e6c-b4a9-bfe51c774232",
                    "sense_definition": "Conforming to socially accepted standards or expected norms.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conforming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children learn <w>normative</w> behavior primarily through observation and social interaction.",
                            "target_lang_translations": {
                                "zh": "儿童主要通过观察与社交互动来学习<w>合乎规范的</w>行为。"
                            }
                        },
                        {
                            "text": "His actions deviated significantly from what society viewed as <w>normative</w> conduct.",
                            "target_lang_translations": {
                                "zh": "他的行为极大地偏离了社会所认同的<w>常态</w>操行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conventional"
                    ],
                    "antonyms": [
                        "abnormal",
                        "deviant"
                    ],
                    "common_phrases": [
                        "normative behavior"
                    ],
                    "target_lang_definitions": {
                        "zh": "符合社会普遍接受的标准或常规的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合乎规范的",
                                "target_lang_sense_clarification": "符合常规或期望的"
                            },
                            {
                                "target_lang_word": "常态的",
                                "target_lang_sense_clarification": "符合普遍社会习惯的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81f184a6-411e-3912-add5-3ab1e8242e05",
                    "sense_definition": "A standard, quota, or regulation imposed to enforce or maintain a norm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ministry introduced a new economic <w>normative</w> to control enterprise spending.",
                            "target_lang_translations": {
                                "zh": "该部门出台了一项新的经济<w>规范</w>以控制企业支出。"
                            }
                        },
                        {
                            "text": "Each factory struggled to comply with the strict production <w>normatives</w> set by the state.",
                            "target_lang_translations": {
                                "zh": "每家工厂都难以达到国家规定的严格生产<w>定额</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regulation",
                        "standard"
                    ],
                    "common_phrases": [
                        "economic normative"
                    ],
                    "target_lang_definitions": {
                        "zh": "为贯彻或维持准则而设立的定额、标准或规章"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "定额",
                                "target_lang_sense_clarification": "生产或经济方面的指标标准"
                            },
                            {
                                "target_lang_word": "规范",
                                "target_lang_sense_clarification": "制度或规章标准"
                            },
                            {
                                "target_lang_word": "基准",
                                "target_lang_sense_clarification": "设定的参考指标"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}