    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "13906b8a-feb2-3506-800a-bdef505d7a60",
                    "sense_definition": "In a way that is clearly true and cannot be doubted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His performance <w>undeniably</w> showed that he was the most talented player on the team.",
                            "target_lang_translations": {
                                "fr": "Sa performance a <w>indéniablement</w> montré qu'il était le joueur le plus talentueux de l'équipe."
                            }
                        },
                        {
                            "text": "The new policy <w>undeniably</w> improved the efficiency of the entire office.",
                            "target_lang_translations": {
                                "fr": "La nouvelle politique a <w>incontestablement</w> amélioré l'efficacité de tout le bureau."
                            }
                        }
                    ],
                    "synonyms": [
                        "indisputably",
                        "unquestionably"
                    ],
                    "common_phrases": [
                        "undeniably true",
                        "undeniably clear"
                    ],
                    "target_lang_definitions": {
                        "fr": "D'une manière manifestement vraie et qui ne fait aucun doute."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "indéniablement",
                                "target_lang_sense_clarification": "d'une manière indéniable, évidente"
                            },
                            {
                                "target_lang_word": "incontestablement",
                                "target_lang_sense_clarification": "qui ne peut être remis en doute"
                            },
                            {
                                "target_lang_word": "indiscutablement",
                                "target_lang_sense_clarification": "sans controverse possible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "465750b6-3e34-3a27-bbbe-57b8b989ec7e",
                    "sense_definition": "Used to emphasize that a statement is a fact that cannot be argued against.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was <w>undeniably</w> the most difficult challenge we have ever faced together.",
                            "target_lang_translations": {
                                "fr": "C'était <w>sans conteste</w> le défi le plus difficile que nous ayons jamais relevé ensemble."
                            }
                        },
                        {
                            "text": "She is <w>undeniably</w> the best candidate for this position.",
                            "target_lang_translations": {
                                "fr": "Elle est <w>indéniablement</w> la meilleure candidate pour ce poste."
                            }
                        }
                    ],
                    "synonyms": [
                        "indisputably",
                        "unquestionably"
                    ],
                    "common_phrases": [
                        "undeniably the best"
                    ],
                    "target_lang_definitions": {
                        "fr": "Utilisé pour souligner avec insistance qu'un fait est incontestable."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "incontestablement",
                                "target_lang_sense_clarification": "sans conteste, de toute évidence"
                            },
                            {
                                "target_lang_word": "indéniablement",
                                "target_lang_sense_clarification": "pour marquer une évidence frappante"
                            },
                            {
                                "target_lang_word": "sans conteste",
                                "target_lang_sense_clarification": "locution exprimant une certitude absolue"
                            }
                        ]
                    }
                }
            ]
        }
    ]
