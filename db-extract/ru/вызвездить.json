                "senses": [
                    {
                        "sense_id": "b0a06ca8-b0bd-393d-ac3c-bb973f47722d",
                        "entry_id": "1fab93f5-c299-3c18-b75d-1227b247e072",
                        "glosses": [
                            "о ясном вечернем небе — покрыться звёздами"
                        ],
                        "tags": [
                            "также безл."
                        ],
                        "examples": [
                            {
                                "example_id": "ed9bc760-795c-450b-aaac-b9a321cd31cf",
                                "sense_id": "b0a06ca8-b0bd-393d-ac3c-bb973f47722d",
                                "text": "Поздним вечером, когда смерклось и вызвездило, над селом пронёсся низкий удар большого колокола."
                            },
                            {
                                "example_id": "c3e8825c-870c-4e1a-9d92-5fd12e74c217",
                                "sense_id": "b0a06ca8-b0bd-393d-ac3c-bb973f47722d",
                                "text": "По тёмной равнине, над которой вызвездило небо, — мчались конные упряжки."
                            }
                        ]
                    }
                ],
