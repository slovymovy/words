                        "entry_id": "5013299a-a9be-317f-9bd5-ae7c1ce88600",
                        "glosses": [
                            "wysyłanie wrogich, obraźliwych lub kontrowersyjnych wiadomości na jedno z publicznych miejsc w Internecie w celu wzniecenia kłótni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce368c3-f0a5-41c2-8718-188ede6eb51d",
                                "sense_id": "f9ec5323-7c79-33f0-8240-f91f496809d2",
                                "text": "Trolling jest złamaniem jednej z podstawowych zasad netykiety."
                            },
                            {
                                "example_id": "9ae08f72-140c-4678-956c-ef718764286b",
                                "sense_id": "f9ec5323-7c79-33f0-8240-f91f496809d2",
                                "text": "„Mały trolling przed snem – to nawet lepsze niż lektura!” — pomyślała babcia Dusia i odłożyła notebooka na nocną szafkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3cebbd79-fa83-3dbc-a029-48c609e11e76",
                        "entry_id": "5013299a-a9be-317f-9bd5-ae7c1ce88600",
                        "glosses": [
                            "kontrowersyjna metoda łowienia drapieżnych ryb polegająca na ciągnięciu przynęty przyczepionej do żyłki lub linki za łódką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd80802-b3d3-420d-a0ee-0ee0916edec3",
                                "sense_id": "3cebbd79-fa83-3dbc-a029-48c609e11e76",
                                "text": "Ty, patrz, ten lamus robi trolling, myśli, że ma łódkę to jest profesjonalistą!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
