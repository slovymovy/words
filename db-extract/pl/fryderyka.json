                                "target_senses": [
                                    {
                                        "sense_id": "7adde1f2-2f35-342d-a249-703281f1362c",
                                        "entry_id": "99b653e9-4bb1-3ea6-bb8b-7f5329a7bcbb",
                                        "glosses": [
                                            "A female given name from the Germanic languages, of quite rare usage, masculine equivalent Frederick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3feb66bf-3706-47b5-b378-3239dbd608d1",
                                                "sense_id": "7adde1f2-2f35-342d-a249-703281f1362c",
                                                "text": "And there was the basic yet awful matter of my name, Frederica Hatch, due to the unfortunate coincidence of a maternal grandmother named Frieda, who died six weeks before I was born, and a favorite paternal great-uncle Frederic, who'd been a Freedom Rider at eighty. - - - When I asked if an accidental boy would have been Frederic, they said no. It was Frederica they loved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a17d4a-09e5-3c37-b9e6-b932483754c4",
                                        "entry_id": "99b653e9-4bb1-3ea6-bb8b-7f5329a7bcbb",
                                        "glosses": [
                                            "A town in Delaware."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
