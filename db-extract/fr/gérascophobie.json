                                "target_senses": [
                                    {
                                        "sense_id": "a89a67a3-b7eb-3c75-8ecd-90938c7d81f2",
                                        "entry_id": "95acac16-fed1-3dbe-8c23-ff35ba8c3da8",
                                        "glosses": [
                                            "The abnormal and persistent fear of aging or growing old."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17db095a-7cbf-4054-9594-035a31cb9e1b",
                                                "sense_id": "a89a67a3-b7eb-3c75-8ecd-90938c7d81f2",
                                                "text": "Thus, from gerascophobia to ageism, Euro-American society today has an overall negative view of aging."
                                            },
                                            {
                                                "example_id": "df9a1b0b-0b7e-4bc4-b261-4a2df60f5870",
                                                "sense_id": "a89a67a3-b7eb-3c75-8ecd-90938c7d81f2",
                                                "text": "[…] and Aprella, a freckled girl with straight strawberry blonde hair who had been diagnosed with gerascophobia."
                                            },
                                            {
                                                "example_id": "a42c781e-6e38-46a0-88e3-8cfe2e6ef06b",
                                                "sense_id": "a89a67a3-b7eb-3c75-8ecd-90938c7d81f2",
                                                "text": "Few cases of gerascophobia have been reported."
                                            }
                                        ]
                                    }
