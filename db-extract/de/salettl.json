                "senses": [
                    {
                        "sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                        "entry_id": "0874b1c4-b46c-3977-93eb-a0cf3c7dfb21",
                        "glosses": [
                            "offenes Gartenhäuschen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "1fdedca9-e2dc-40b6-9658-3fefd7c1ee50",
                                "sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                                "text": "„Der Beschwerdeführer wurde aufgefordert, das »Salettl« zu entfernen, widrigenfalls ein Verfahren zur Wiederherstellung des rechtmäßigen Zustandes eingeleitet werden müsste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084546f5-cc1b-4a79-af5e-c16cc386bb58",
                        "source_entry_id": "0874b1c4-b46c-3977-93eb-a0cf3c7dfb21",
                        "source_sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                        "target_lang_word": "gazebo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazebo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76a0c38f-38ea-3caa-bd97-7ecabe03089b",
                                        "entry_id": "ae010796-f20b-330c-bd0f-8062c1489372",
                                        "glosses": [
                                            "A belvedere, either a type of summer-house or a roofed, detached porch-like structure, usually in a yard, park or lawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65af39de-ac5b-4fde-98a1-626da13a5ea3",
                                                "sense_id": "76a0c38f-38ea-3caa-bd97-7ecabe03089b",
                                                "text": "Ann dye Ned inn a gaze ay beau a pun a past Eye maid off any Sun (\"and dined in a gazebo upon a pasty made of venison\")"
                                            },
                                            {
                                                "example_id": "85b99441-4d95-4bfd-a0e1-0462d60fcd99",
                                                "sense_id": "76a0c38f-38ea-3caa-bd97-7ecabe03089b",
                                                "text": "over which is a gazebo room 10 feet square"
                                            },
                                            {
                                                "example_id": "375c115e-883c-4dff-8b2a-908a8e45f5a2",
                                                "sense_id": "76a0c38f-38ea-3caa-bd97-7ecabe03089b",
                                                "text": "She led them around the back of the yard, where a gray, tired-looking gazebo perched at the edge of the oak trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2075b257-11bd-398e-8d6d-3fdf1c42b930",
                                        "entry_id": "ae010796-f20b-330c-bd0f-8062c1489372",
                                        "glosses": [
                                            "A dismountable shelter comprising a roof or awning supported by poles, and often having removable sides; a canopy tent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0283f6a3-831b-4e71-a1e8-0bcc6539733d",
                                                "sense_id": "2075b257-11bd-398e-8d6d-3fdf1c42b930",
                                                "text": "They started screwing aluminium rods together, like they were going to assemble a gazebo."
                                            },
                                            {
                                                "example_id": "3e1b1d13-4c0e-4d54-becf-cea8c1dec748",
                                                "sense_id": "2075b257-11bd-398e-8d6d-3fdf1c42b930",
                                                "text": "Canopy tents go by a lot of names: screen houses, outdoor canopies, camping shelters, day tents, camping gazebos, patio shelters, portable shelters, and (our favorite) portable gazebos."
                                            },
                                            {
                                                "example_id": "815b6a3c-4d81-4432-b4bd-53cb7693ec76",
                                                "sense_id": "2075b257-11bd-398e-8d6d-3fdf1c42b930",
                                                "text": "It has been a tough year in hospitality, but brave souls continue to dream big and set out their stalls delivering tasty specialty food at keen prices from horseboxes, trucks and gazebos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                        "entry_id": "ae010796-f20b-330c-bd0f-8062c1489372",
                                        "glosses": [
                                            "a gaudy, incongruous, or flimsy structure or object"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ba7d82-7b27-49b1-951d-8e59537876ce",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "'I'll thank ye tell me what they mean by that old gazabo on the top of the market-place,' said she, in a burst of ridicule fit to have brought the old tower down."
                                            },
                                            {
                                                "example_id": "d3195e10-67c2-4989-a12f-06a2bfb03f94",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "There was no garden attached to this tenement, nor was there even a good yard. People looked at it in passing by and called it a gazebo, a rattle-trap, a castle rack-rent."
                                            },
                                            {
                                                "example_id": "3039c630-6c4b-44c3-a861-d281bb2b5ad1",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "Sometimes a few middle-aged women came to see her, elderly spinsters whom she regarded as little girls. \"Poor Cathy, she’s a great guy. She’s always making a show of herself\"—and she might disconcertingly rap out at them, \"What’s that gazebo you have on your head? What in reason prevailed on you to choose that color?\""
                                            },
                                            {
                                                "example_id": "72a23299-5631-4ed4-ac4a-8e01854497a5",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "The critics, those lurking socialists in the Central Bank and the ESRI, those dangerous subversives, have dared not to believe and to criticise the figures on which the Minister rests the entire shaky gazebo of the direction of the economy for next year."
                                            },
                                            {
                                                "example_id": "e8dd80e5-1526-491a-ae7a-c5ba4eae3f92",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "When they were living in a house farther out from the city, and still very hard-up, the mother pledged a sideboard to tide them over the father's illness. When the money was not available to redeem it, she consoled herself by saying: \"It was only a bloody gazebo anyhow\"."
                                            },
                                            {
                                                "example_id": "184aa014-bf6e-444b-a699-558c23185b9b",
                                                "sense_id": "5ca2f762-15c3-3b73-80d6-84bdd7949b1a",
                                                "text": "I am not arguing against the previous amendment but it is clear that the gentleman who objected to the spike could not show that his interests would be economically damaged by this lunatic proposal to put this gazebo in O'Connell St."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdf14b82-0843-40f0-8ea2-2ca1aa70c5c1",
                        "source_entry_id": "0874b1c4-b46c-3977-93eb-a0cf3c7dfb21",
                        "source_sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                        "target_lang_word": "gazébo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazébo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa6f62c-b3cf-3a33-ac19-d7aa3eb763f1",
                                        "entry_id": "22c4ccaa-867b-352b-91b3-7ae90fef9717",
                                        "glosses": [
                                            "Pavillon d’extérieur ouvert."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf388517-d1c5-4e9c-a773-5cda0a6d8645",
                                                "sense_id": "5fa6f62c-b3cf-3a33-ac19-d7aa3eb763f1",
                                                "text": "L’aménagement du futur parc canin clôturé de Saint-Georges, sur l’avenue de la Chaudière, près de l’usine d’épuration, a connu un pas supplémentaire la semaine dernière avec la pose du gazébo extérieur sur une dalle de béton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "298091fe-658f-40dd-b0cd-7c78fb857ddf",
                        "source_entry_id": "0874b1c4-b46c-3977-93eb-a0cf3c7dfb21",
                        "source_sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                        "target_lang_word": "gloriette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gloriette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63f6c7c0-42f8-37b6-ad27-18d69d669c49",
                                        "entry_id": "2249c3a5-f02b-3a93-b04d-695e25f35557",
                                        "glosses": [
                                            "Pavillon en pierre situé dans un parc, pouvant être ouvert ou cloisonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee12973-bd45-411e-ac76-0c2a13daacd7",
                                                "sense_id": "63f6c7c0-42f8-37b6-ad27-18d69d669c49",
                                                "text": "Au centre d’un grand parc qui descendait en pente douce vers une plage de sable fin, une construction ancienne, de style local, assez petite, sans étages, s’était développée d’année en année, était devenue le soleil d’une constellation de pavillons de toutes grandeurs et de tous styles, gloriettes, marabouts, bungalows, entourés de vérandas, disséminés à travers le parc et reliés entre eux par des galeries à claire-voie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb24bed-d414-3dce-a524-cd862f568980",
                                        "entry_id": "2249c3a5-f02b-3a93-b04d-695e25f35557",
                                        "glosses": [
                                            "Berceau de treillage en fer ou en bois le long duquel peuvent grimper des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f844a8-57c4-4608-814b-d00cf7b2c025",
                                                "sense_id": "edb24bed-d414-3dce-a524-cd862f568980",
                                                "text": "Elle revit la cour d’auberge, plantée d’arbres mal venus, ceinte, de gloriettes où, toutes en sueur, les fillettes buvaient des sirops entre les quadrilles."
                                            },
                                            {
                                                "example_id": "8f3eb651-16c6-42b8-b9b6-fc3010ba2c12",
                                                "sense_id": "edb24bed-d414-3dce-a524-cd862f568980",
                                                "text": "Ce jardin est petit, mais des allées sinueuses, des plis de terrain en allongent la promenade. Des saules trempent le bout de leurs branches dans un bassin où nagent des canards. À l’angle de la rue, sur un tertre, s’élève une gloriette légère et une pelouse fraîche s’étend devant la maison."
                                            },
                                            {
                                                "example_id": "a41c1ead-84df-42e6-b827-2ce1d6399770",
                                                "sense_id": "edb24bed-d414-3dce-a524-cd862f568980",
                                                "text": "Ils entrèrent dans la petite gloriette en treillis, toute couverte de chèvrefeuille et de pampres, et, s’étant assis, ils se mirent à causer des changements survenus dans le pays depuis cinq ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a7eeec6-f32c-3757-b3e4-6afa6b5bd39b",
                                        "entry_id": "2249c3a5-f02b-3a93-b04d-695e25f35557",
                                        "glosses": [
                                            "Petit retranchement derrière le four d’une boulangerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9d1cae-10a4-416a-a774-2d8c3d0e7da1",
                                                "sense_id": "1a7eeec6-f32c-3757-b3e4-6afa6b5bd39b",
                                                "text": "C’est la boulangerie du quartier. Marius et quelques autres y conduisent celle qui voulait mourir. Ils descendent par l'échelle de bois jusqu'à la gloriette, et là, devant la gueule béante du four, dans la pièce chaude, déposent l’inanimée ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd1075f-c3c6-35b3-b78c-259b1bb50cd6",
                                        "entry_id": "2249c3a5-f02b-3a93-b04d-695e25f35557",
                                        "glosses": [
                                            "Cage à oiseau en forme de maison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1032b0e2-566c-4125-bfae-255fc4b937fb",
                        "source_entry_id": "0874b1c4-b46c-3977-93eb-a0cf3c7dfb21",
                        "source_sense_id": "9b725755-8af1-3ece-90a7-b4b047a19a0d",
                        "target_lang_word": "kiosque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiosque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb35c8d5-7b44-3b37-921d-a796f5349289",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Dans l’aménagement des parcs et jardins, pavillon pour l’agrément ou la musique, d’inspiration orientale, de structure légère et ouverte et de plan circulaire ou polygonal."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de0ef36-1afb-428d-b3f0-069c42a29385",
                                                "sense_id": "fb35c8d5-7b44-3b37-921d-a796f5349289",
                                                "text": "Au milieu d’un jardin planté jadis par le roi Stanislas, beau-père de Louis XV, et représentant, suivant le goût du temps, un labyrinthe de charmilles, s’élevait un kiosque fort élégant, mais très négligé depuis la mort de l’ami de Charles XII."
                                            },
                                            {
                                                "example_id": "605575a6-e71b-4f23-aeda-4c5d589c8ac7",
                                                "sense_id": "fb35c8d5-7b44-3b37-921d-a796f5349289",
                                                "text": "C’est, dans un département lointain, une petite propriété que ne décore aucune boule en verre, et où l’œil le mieux exercé ne saurait rencontrer le moindre kiosque japonais, ni le prétentieux bassin de rocailles avec son amour nu en plâtre et son impudique jet d’eau qui retombe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67db0a7f-8980-34b5-a968-e9ddf8600cff",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Construction similaire située dans un espace public ou à usage collectif (square, place, parc public, etc.), principalement à usage festif (musique, chant, …), éventuellement tournante, fermée de nuit ou démontable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f0ce28-6840-4d9d-9004-0594e0b75e94",
                                                "sense_id": "67db0a7f-8980-34b5-a968-e9ddf8600cff",
                                                "text": "Il y avait chaque jour des troubles dans la rue. On brisait les kiosques et les sergents de ville chargeaient la foule."
                                            },
                                            {
                                                "example_id": "07eef134-d294-4fec-a1e9-191fde5595b9",
                                                "sense_id": "67db0a7f-8980-34b5-a968-e9ddf8600cff",
                                                "text": "Il y avait des kiosques à musique et des kiosques de foire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6628b29c-d3b9-30b0-a7ca-299964f6fd26",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Kiosque à journaux ; édicule de rue, à l’origine en forme de petit kiosque, servant de présentoir pour le commerce de la presse, fermé la nuit par des volets en bois ou en métal."
                                        ],
                                        "tags": [
                                            "Mobilier urbain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d69141-d0cb-4e7f-817d-494d879d0704",
                                                "sense_id": "6628b29c-d3b9-30b0-a7ca-299964f6fd26",
                                                "text": "Mais il y a aussi le flot ininterrompu des brochures et opuscules sur l’islam qui encombrent les kiosques et les étalages de livres sur les trottoirs des grandes villes d’Égypte."
                                            },
                                            {
                                                "example_id": "0a69ccce-1c96-4e09-a70f-b22a362f9a70",
                                                "sense_id": "6628b29c-d3b9-30b0-a7ca-299964f6fd26",
                                                "text": "En arrivant sur la place, avec la ville dans le dos, il y a une dernière rangée de constructions, un peu disparates, des kiosques, des parkings, des manèges, des échoppes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99151024-14d7-37ed-9f25-a682b17b03ff",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Présentoir en forme de petit kiosque, souvent circulaire, destiné à la vente d’objets multiples : restauration en libre-service, cartes postales…"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b09efde8-e9dc-386c-8ea6-54316c8aa939",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Structure supérieure d’un sous-marin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b440fd7-903b-3b76-ba3a-16a9af421271",
                                        "entry_id": "a019df68-ff55-32ef-8caa-8a8dcbe94854",
                                        "glosses": [
                                            "Service de kiosque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
