                "senses": [
                    {
                        "sense_id": "aff791d7-253f-3e30-b903-fd5e7d640549",
                        "entry_id": "2d8b0fdf-3461-31d2-9dbd-c144780c5676",
                        "glosses": [
                            "Person, die im Kino/Theater die Eintrittskarten kontrolliert und die Besucher zu ihrem Sitzplatz führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce2fc3ff-f5fc-48d1-b265-b9fd21eacc43",
                                "sense_id": "aff791d7-253f-3e30-b903-fd5e7d640549",
                                "text": "„Früher war er mal Platzanweiser in einem Pornokino, was man sich heute kaum vorstellen kann, denn nichts käme Quentin Tarantino schwerer über die Lippen als ein dezent in die Stille geflüstertes »Reihe zwei, Platz vier, und bitte wischen Sie hinterher auf«.“"
                            },
                            {
                                "example_id": "34131a55-0f50-4f9b-bebe-4824aad66868",
                                "sense_id": "aff791d7-253f-3e30-b903-fd5e7d640549",
                                "text": "„Die Freikarten erhielt er dank seines Postens als Platzanweiser – vier die Woche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ea89609-6487-4b4e-9047-050c206785f6",
                        "source_entry_id": "2d8b0fdf-3461-31d2-9dbd-c144780c5676",
                        "source_sense_id": "aff791d7-253f-3e30-b903-fd5e7d640549",
                        "source_sense_description": "Person, die im Kino/Theater die Eintrittskarten kontrolliert und die Besucher zu ihrem Sitzplatz führt",
                        "target_lang_word": "usher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11dc4009-ab1d-3754-8ce2-bfcf8b3bc999",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "A person, in a church, cinema etc., who escorts people to their seats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9feefde-0267-3bd8-afe5-2b0f9a20691e",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "A male escort at a wedding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "318ce42b-4726-3504-af3f-e479bb917cf4",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "A doorkeeper in a courtroom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b8da5e9-48b4-3c99-9dce-ef11a4c98615",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "An assistant to a head teacher or schoolteacher; an assistant teacher."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2b7175-edbc-4378-b84d-2a1045e2b803",
                                                "sense_id": "0b8da5e9-48b4-3c99-9dce-ef11a4c98615",
                                                "text": "[H]e defrayed the expence of his entrance, and left him in the particular care and inspection of the usher, who […] though obliged by the scandalous administration of fortune to act in the character of an inferior teacher, had by his sole capacity and application, brought the school to that degree of reputation which it never could have obtained from the talents of his superior."
                                            },
                                            {
                                                "example_id": "c8bf9c22-816d-4ad0-9b90-4658ea99742c",
                                                "sense_id": "0b8da5e9-48b4-3c99-9dce-ef11a4c98615",
                                                "text": "He began to learn Latin with Mr. Hawkins, usher, or under-master of Lichfield school, ‘a man (said he) very skilful in his little way.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74cf1aa0-893b-3c7a-9ca4-96896a4e703e",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "Any schoolteacher."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "usher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d740bb3f-290b-3c91-a8b3-f1a0c837479e",
                                        "entry_id": "cf4f501b-cc5a-323a-9ee3-b9f424bc60f6",
                                        "glosses": [
                                            "To guide people to their seats."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2434840-1818-4db2-99ca-d880d2d25017",
                                                "sense_id": "d740bb3f-290b-3c91-a8b3-f1a0c837479e",
                                                "text": "Her entrance into church on Sunday is always the signal for a little bustle in the side aisle, occasioned by a general rise among the poor people, who bow and curtsey until the pew-opener has ushered the old lady into her accustomed seat, dropped a respectful curtsey, and shut the door;"
                                            },
                                            {
                                                "example_id": "cac2c41a-a4d1-4a84-b306-60565dad0892",
                                                "sense_id": "d740bb3f-290b-3c91-a8b3-f1a0c837479e",
                                                "text": "Needless to say, one's seat must be booked in advance and a platoon of urbane officials, one to each door of the train, awaits passengers to usher them to their seats and relieve them of their bulkier baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3430c5-aa47-3bb5-a97a-32e38aafd6c5",
                                        "entry_id": "cf4f501b-cc5a-323a-9ee3-b9f424bc60f6",
                                        "glosses": [
                                            "To accompany or escort (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035b51d2-d245-4e5a-b5ea-2191d55cf25a",
                                                "sense_id": "7a3430c5-aa47-3bb5-a97a-32e38aafd6c5",
                                                "text": "[N]ay he can ſing / A meane moſt meanely, and in huſhering, / Mende him vvho can, the Ladies call him ſvveete."
                                            },
                                            {
                                                "example_id": "c8c259b8-c8e4-4b00-8e17-1b9636adc207",
                                                "sense_id": "7a3430c5-aa47-3bb5-a97a-32e38aafd6c5",
                                                "text": "Hee brought-in likevvise the ancient cuſtome againe, that in vvhat moneth hee had not the Knitches of rods vvith Axes borne before him, a publique Officer called Accensvs ſhould huiſher him before, and the Serjeants or Lictours follovv after behinde."
                                            },
                                            {
                                                "example_id": "d1c3bf6a-8651-4ce6-a5a4-5178d9d854ab",
                                                "sense_id": "7a3430c5-aa47-3bb5-a97a-32e38aafd6c5",
                                                "text": "Margaret was astonished at the magnificence of the apartments into which she was ushered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd3032a-a3a4-369b-85da-93609b8df635",
                                        "entry_id": "cf4f501b-cc5a-323a-9ee3-b9f424bc60f6",
                                        "glosses": [
                                            "To precede; to act as a forerunner or herald."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb581342-3a86-4d15-9389-68c557f6f594",
                                                "sense_id": "2bd3032a-a3a4-369b-85da-93609b8df635",
                                                "text": "Thus the Harvard poets and wits ushered The New England Courant out of existence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad4c4fb-7fac-30f6-af53-52e4557bcb2d",
                                        "entry_id": "cf4f501b-cc5a-323a-9ee3-b9f424bc60f6",
                                        "glosses": [
                                            "To lead or guide somewhere."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7bf850-071a-42c8-9d4b-4ba1aea243cc",
                                                "sense_id": "6ad4c4fb-7fac-30f6-af53-52e4557bcb2d",
                                                "text": "McCoist unexpectedly ushered back a defender of his own with Kirk Broadfoot taking over from Steven Whittaker. There was, of course, another change, Kyle Bartley stepping in at centre-half to replace suspended Dorin Goian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
