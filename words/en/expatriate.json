                    "sense_definition": "Living or residing outside of one's own country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_living_abroad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She maintains an <w>expatriate</w> lifestyle while working in Tokyo."
