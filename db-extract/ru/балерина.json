                "senses": [
                    {
                        "sense_id": "497a0011-1a8e-3a9c-8c57-c1d3dee269ae",
                        "entry_id": "616b0721-3cba-38a0-b33f-2fa480bcd9d2",
                        "glosses": [
                            "профессиональная танцовщица, артистка балета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dbc15eb-7c30-42f7-9cbc-45f45c2fe08a",
                                "sense_id": "497a0011-1a8e-3a9c-8c57-c1d3dee269ae",
                                "text": "Она постояла немного и грациозно, как балерина, прыгнула в другую сторону, опять стала и глядела всё в одну точку."
                            },
                            {
                                "example_id": "d35274c2-d6b8-4904-ada5-56afb34160b5",
                                "sense_id": "497a0011-1a8e-3a9c-8c57-c1d3dee269ae",
                                "text": "Она идёт плавно, слегка покачивается на ходу, как балерина."
                            }
                        ]
                    }
                ],
