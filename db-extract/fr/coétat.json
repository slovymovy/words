                        "glosses": [
                            "État associé à un autre dans une confédération, un empire, une république, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1704863e-d6ba-43bf-91e2-83537ad23e01",
                                "sense_id": "d7e19a7b-8622-3345-8414-cb66f96fb0a3",
                                "text": "Celui d’exprimer un vœu national ; de porter aux états-généraux l’universalité de nos intérêts par un seul suffrage ; de nous [la nation provençale] réunir à la nation française, non par districts, puisque nous ne sommes pas des districts dans cette nation, mais en coétat, mais en seul corps, parce que nous sommes un seul corps, et qu’il faut être ce que nous sommes, avant de savoir ce que nous devons être."
                            }
