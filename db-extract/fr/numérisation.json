                        "entry_id": "5123613d-4ae6-392e-8306-a1171a8128ae",
                        "glosses": [
                            "Action de numériser, transformation de données analogiques en données numériques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c74af8-abc5-4ea3-bae5-fa9b5d9c0015",
                                "sense_id": "c300e40e-cb2f-3859-90ca-9a59117fb60a",
                                "text": "Je fais la numérisation des 4 pages avec mon scanner."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe85c00c-0c3f-3f4f-bf16-a26e0608a508",
                        "entry_id": "5123613d-4ae6-392e-8306-a1171a8128ae",
                        "glosses": [
                            "Rendre accessible un service en ligne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b5436a-a3dc-48e4-b4be-418b90d025a6",
                                "sense_id": "fe85c00c-0c3f-3f4f-bf16-a26e0608a508",
                                "text": "Travailler (ceux, du moins, qui le peuvent), étudier, se divertir, consommer, communiquer, se cultiver, se soigner, mais aussi se faire contrôler sur écran : la numérisation des rapports sociaux serait nécessaire puisque techniquement réalisable."
                            }
                        ]
                    }
                ],
