                ],
                "senses": [
                    {
                        "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                        "entry_id": "bd8a5571-8819-3b47-9994-3af5b152b0b4",
                        "glosses": [
                            "Handlung mit dem Ziel, etwas (meist ein Bauwerk) grundlegend zu reparieren"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "523a779b-544d-40e9-87c0-9015aa4e2eef",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Für insgesamt elf Monate soll die Bahnstrecke zwischen Hamburg und Berlin in den kommenden zwei Jahren für Sanierungsarbeiten gesperrt werden.“"
                            },
                            {
                                "example_id": "873fb6a0-7bc1-48e7-bdf4-10e51809bc1c",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "[Schlagzeile:] „Sanierungsarbeiten der Willy-Brandt-Straße haben begonnen“"
                            },
                            {
                                "example_id": "b750b36c-78a4-4fd2-a235-96bafda0a20a",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Autofahrer, die im Kreis Dithmarschen auf die B5 angewiesen sind, müssen sich von heute an auf weite Umwege einstellen. Grund dafür sind Sanierungsarbeiten in Hemmingstedt.“"
                            },
                            {
                                "example_id": "6eeac670-b60e-49ea-abb7-7e5c2934be8c",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Die Kontroll- und Sanierungsarbeiten an der Seeschleuse im Außenhafen von Hooksiel sind abgeschlossen.“"
                            },
                            {
                                "example_id": "83185e6a-8f7a-4f0c-9d75-5fc2d1227318",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Vom berühmten Löwendenkmal in Luzern ist seit März nichts zu sehen. Es laufen aufwändige Sanierungsarbeiten und diese dauern nun zwei Monate länger als geplant.“"
                            },
                            {
                                "example_id": "b54c3278-7506-449a-aff5-f4171078fecc",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Mit dem so genannten Energiepass muss die Wirksamkeit der Sanierungsarbeiten genau nachgewiesen werden.“"
                            },
                            {
                                "example_id": "14dd8252-d1e8-49d0-a2fa-cd3c8ad93fb4",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Das Unglück wurde nach Angaben der Staatsanwaltschaft durch Fehler bei Sanierungsarbeiten verursacht.“"
                            },
                            {
                                "example_id": "dd7d0dae-f52b-4451-bb61-6ec009cdb41c",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Wenn in einem Gebäude aus dem 19. bzw. frühen 20. Jahrhunderts Sanierungsarbeiten an Dielen- oder Holzböden anstehen, sind in vielen Fällen die Auflagen des Denkmalschutzes zu befolgen.“"
                            },
                            {
                                "example_id": "7dc53979-f363-4491-a0ed-7f7804b03efa",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Bei Sanierungsarbeiten an alten Dielen- oder Holzböden ist es indes wichtig, möglichst wenig Material abzutragen.“"
                            },
                            {
                                "example_id": "74ea26e5-33ba-4d99-be15-81273dfee8de",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Obwohl die Sanierungsarbeiten drei Monate länger dauerten als geplant, soll der bewilligte Kostenrahmen eingehalten werden.“"
                            },
                            {
                                "example_id": "6cacc5eb-c609-4171-94f9-3fd11e4f4f3f",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "[Flughafen Zürich:] „Die Sanierungsarbeiten werden in der Nacht ausgeführt, damit die Flugzeuge während des Tages normal starten und landen können.“"
                            },
                            {
                                "example_id": "8c1beebf-4235-44e6-8b3d-8458cd878a0e",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "„Der gesamte Gebäudekomplex war vor den 2008 begonnenen Sanierungsarbeiten in einem außerordentlich schlechten baulichen Zustand,“ […]."
                            },
                            {
                                "example_id": "9fdc9915-52c9-45c2-8415-81eb953d2a12",
                                "sense_id": "f6d06354-ba98-308e-b5c1-4c65faea9704",
                                "text": "[Schiefer Turm von Pisa:] „Die Schieflage des Turms beträgt nach dem Ende der Sanierungsarbeiten rund vier Grad,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                        "entry_id": "bd8a5571-8819-3b47-9994-3af5b152b0b4",
                        "glosses": [
                            "Versuch, ein angeschlagenes/marodes Unternehmen wieder rentabel zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771d29ca-b9f1-4ae7-b9a1-8021fd262111",
                                "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                                "text": "„Als Matthias Gründler (54) im Mai 2018 Volkswagens Truck-Sparte verließ, war das ein heftiger Rückschlag für das Unternehmen.“ […] „Jetzt soll Pkw-Produktionschef Tostmann die Sanierungsarbeit fortsetzen.“"
                            },
                            {
                                "example_id": "798e8fb8-1ef4-4d1b-b49b-4331877d88cf",
                                "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                                "text": "„John Cryan: Der extern engagierte CEO der Deutschen Bank musste nach der Sanierungsarbeit gehen.“"
                            },
                            {
                                "example_id": "64b3ada4-941d-4277-a385-259f56356d92",
                                "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                                "text": "„Er hat, noch bevor die Sanierungsarbeit bei Chrysler richtig begonnen hat, dem Konzern mit Mitsubishi einen zweiten Krisenfall hinzugefügt.“"
                            },
                            {
                                "example_id": "99c97ff8-9e82-4eac-bd27-4fb110b7189d",
                                "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                                "text": "„Beim Krisenflieger Air Berlin hingegen war handfeste Sanierungsarbeit gefragt - und Mehdorn vom ersten Tag an überfordert.“"
                            },
                            {
                                "example_id": "1756dbc2-de42-4a2b-a187-b27e84ac9b0c",
                                "sense_id": "98941c66-ec9e-3a4c-a437-3840e9a3e734",
                                "text": "„All diese geerbten Probleme muss Loubier lösen. Sein Nachteil bei der Sanierungsarbeit ist: Er kann zwar ein bisschen Deutsch, spricht es aber nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
