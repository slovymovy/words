                "senses": [
                    {
                        "sense_id": "bd3a44c7-39a1-3cb4-94d3-2b07ab403601",
                        "entry_id": "9ed4ebe4-c0c0-3376-9f2f-579abbd246b8",
                        "glosses": [
                            "Doter d’un entresol (quand la hauteur de plafond le permet)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14534cfd-5753-4bba-9817-aa3c933212d9",
                                "sense_id": "bd3a44c7-39a1-3cb4-94d3-2b07ab403601",
                                "text": "Pour décupler les logements, il fallut entresoler presque toutes les grandes salles, les couper de deux ou trois cloisons, ouvrir dans l’épaisseur des murs des cages d’escaliers, des gaines de cheminée."
                            },
                            {
                                "example_id": "32119c2c-8771-4451-85bf-f35582208d1e",
                                "sense_id": "bd3a44c7-39a1-3cb4-94d3-2b07ab403601",
                                "text": "Le rez-de-chaussée est occupé par la boutique d’un commerçant ; les appartements sont souvent bas de plafond car les propriétaires n’hésitent pas à entresoler les étages intermédiaires pour augmenter leurs revenus."
                            },
                            {
                                "example_id": "d232ddca-0dc5-438a-bcff-bb725e08f3c0",
                                "sense_id": "bd3a44c7-39a1-3cb4-94d3-2b07ab403601",
                                "text": "En venant de chez la Reine, la duchesse de Bourgogne, allant faire sa cour à “sa tante”, y pénétrait par deux basses chambres entresolées, mesquines au point de surprendre."
                            }
                        ]
                    }
                ],
