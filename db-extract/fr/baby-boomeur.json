                "senses": [
                    {
                        "sense_id": "843a4f96-07ff-3fea-814a-da9fe46019c8",
                        "entry_id": "0f6d0b8a-dc10-3e3d-91f4-953b1ea17c21",
                        "glosses": [
                            "Personne née pendant un baby-boom."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1c8b5b1f-93cd-4713-a091-d3edcdec686e",
                                "sense_id": "843a4f96-07ff-3fea-814a-da9fe46019c8",
                                "text": "Faut-il faire venir plus de jeunes travailleurs pour payer les retraites des baby-boomeurs ?"
                            },
                            {
                                "example_id": "14d9c802-7a3a-4239-8a53-fb89352a2a5e",
                                "sense_id": "843a4f96-07ff-3fea-814a-da9fe46019c8",
                                "text": "Cette chasseuse de têtes, qui se définit elle-même comme une « baby-boomeuse », a l’habitude de faire affaires avec les jeunes."
                            },
                            {
                                "example_id": "e3d97a0f-7cf4-444a-b19e-69705ae2d86d",
                                "sense_id": "843a4f96-07ff-3fea-814a-da9fe46019c8",
                                "text": "Nos enfants nous haïront et ils auront raison. Car nous, les baby-boomeurs, leur avons laissé une société molle, mitée, usée."
                            },
                            {
                                "example_id": "364155bc-1ebc-4c72-94d2-0b99ca3a603f",
                                "sense_id": "843a4f96-07ff-3fea-814a-da9fe46019c8",
                                "text": "Comme historienne, comme universitaire, comme baby-boomeuse et mère active appartenant à la première génération usagère de ces nouveaux droits, c’est cette évolution-là que j’ai voulu ici retracer."
                            }
                        ]
                    }
