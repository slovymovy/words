                        "glosses": [
                            "Canapé au dossier droit, en bois apparent mis à la mode à la fin du XVIIIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eeb7de4-441b-4e28-8c12-836cfb869cff",
                                "sense_id": "6f2c0b8e-13f6-3125-9ff1-084bebb18a15",
                                "text": "La paphos est une sorte d'ottomane à bois apparent. Ce canapé est porté par quatre pieds plus ou moins sculptés, au haut desquels court une frise de bois sculpté formant ceinture."
                            }
                        ]
