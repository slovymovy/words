                    {
                        "form_id": "f734b441-08e4-4e22-875e-2c203c08efe9",
                        "entry_id": "762dfea2-c2fa-338a-9974-b84f18a0beb7",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Lexikografie"
                    },
                    {
                        "form_id": "b983017d-6a8d-48ae-af3e-c39d8620c321",
                        "entry_id": "762dfea2-c2fa-338a-9974-b84f18a0beb7",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Lexikografie"
                    },
                    {
                        "form_id": "dbe80ab3-ff2f-46e3-af02-139e34cd70a9",
                        "entry_id": "762dfea2-c2fa-338a-9974-b84f18a0beb7",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Lexikografie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                        "entry_id": "762dfea2-c2fa-338a-9974-b84f18a0beb7",
                        "glosses": [
                            "Teilgebiet der Linguistik, das sich mit der Theorie und Praxis der Erstellung von Wörterbüchern beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c432a1-43a1-494a-984b-f2e6a05cbe68",
                                "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                                "text": "Die Lexikografie ist eine eigene Disziplin der Linguistik."
                            },
                            {
                                "example_id": "6c4daaee-df46-4414-a5f1-71ec1fa1dc7b",
                                "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                                "text": "„Dieses Buch behandelt die Geschichte der deutschsprachigen Lexikografie vom Mittelalter bis in die Gegenwart aus sprach- und kulturwissenschaftlicher Sicht.“"
                            },
                            {
                                "example_id": "4527d690-2089-4963-9788-a8be56a591cf",
                                "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                                "text": "„In Grundsatz- und Überblicksvorträgen wurden neuere Entwicklungen der Lexikografie in Europa vorgestellt und diskutiert.“"
                            },
                            {
                                "example_id": "5d5c3231-fd7b-47ac-bf1d-436f08b2e32a",
                                "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                                "text": "„Es versucht auf diese Weise, metalexikografische Forderungen nach einer stärker kognitiv ausgerichteten Lexikografie einzulösen (…).“"
                            },
                            {
                                "example_id": "6f7525ae-5223-4ddc-859d-298289432489",
                                "sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                                "text": "„Daher hat das Neuhochdeutsche in der englischen Lexikografie einen anderen Stellenwert als die früheren Sprachstufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "740d6047-51ea-42a5-bba4-a602816e3723",
                        "source_entry_id": "762dfea2-c2fa-338a-9974-b84f18a0beb7",
                        "source_sense_id": "b45af9bc-4a0f-3b97-955f-f39339f745e3",
                        "source_sense_description": "Teilgebiet der Linguistik",
                        "target_lang_word": "lexicography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                        "entry_id": "745b73b4-46db-3e35-ac8f-d57affe8b60a",
                                        "glosses": [
                                            "The art or craft of compiling, writing, and editing dictionaries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71268d87-845a-4298-a0ed-ec251af5e2fb",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "[T]here are ſeveral Species of Writing, in which a proper Degree of Hebetude is abſolutely neceſſary, as well as in other profeſſions; such as Lexicography, Index-making, and the like; [...]"
                                            },
                                            {
                                                "example_id": "3d202fec-f2c4-4bed-9958-256ff3089f56",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "And ſuch is the fate of hapleſs lexicography, that not only darkneſs, but light, impedes and diſtreſſes it; things may be not only too little, but too much known, to be happily illuſtrated."
                                            },
                                            {
                                                "example_id": "8aa8ea76-2f79-4b2c-ab10-59c7b534a354",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "Let me warn you, therefore, against that fallacious lexicography which forms new words, that undergoing the examination of political slander or intemperate zeal, are considered as having a known acception.—What is the word?—A word that should be discarded, when it is sought to affix to it another meaning than that which it bears in the cases where it is used."
                                            },
                                            {
                                                "example_id": "27a8edcb-c98d-464e-9973-0f6795add1a2",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "[...] I have not only availed myſelf of all the Aſſiſtance which more ancient Sources of Spaniſh Lexicography could afford, but alſo had particular Recourſe to the Dictionary published at Madrid in 1797 and 1798, [...]"
                                            },
                                            {
                                                "example_id": "d3a60f54-d758-423d-9e1b-918bbc72f2f0",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "There exist different forms of this character, but I think we should not presume to make an etymology of a Chinese character without being authorized by the Shwǒ wǎn, the oldest and most genuine source of Chinese lexicography."
                                            },
                                            {
                                                "example_id": "2c522b5c-568b-4eaa-860e-ce9e0d38149e",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "Without doubt, the most important single development in learner lexicography from the mid-1970s onwards has been the steadily increasing involvement of the computer at all stages of the dictionary-making process, from data gathering and analysis at one end, to compilation, production, and revision at the other."
                                            },
                                            {
                                                "example_id": "33c15798-bbe8-418d-81d0-f4f467656866",
                                                "sense_id": "bc2b82a3-50c7-357e-8d0b-ef44f86a5dd7",
                                                "text": "A dictionary, as an art and craft of lexicography, has always been closely associated with the notion of pedagogy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                        "entry_id": "745b73b4-46db-3e35-ac8f-d57affe8b60a",
                                        "glosses": [
                                            "The scholarly discipline of analysing and describing the semantic, syntagmatic and paradigmatic relationships within the lexicon (vocabulary) of a language and developing theories of dictionary components and structures linking the data in dictionaries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c3e1eb0-7d3d-40cc-880e-39b728054ec4",
                                                "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                                "text": "But changes of this nature belong to lexicography, as they do not affect the grammatical forms of words."
                                            },
                                            {
                                                "example_id": "7bfcbab3-f5c1-4d3e-9707-8bc416f58488",
                                                "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                                "text": "What the history of language in general teaches, that in course of time, there is less change in form than signification, in grammar than lexicography, is true of the Greek."
                                            },
                                            {
                                                "example_id": "459f7014-4530-4a45-9804-2474ba4d7128",
                                                "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                                "text": "If Lexicography in general is that science whose task it is to set forth the nature of every single word of a language through all the periods of its existence, it is the task of Latin lexicography in particular to set forth the nature of every single word of the Latin language, as it makes itself known in all the periods of the existence of that language; or more succinctly expressed, it is the object of Latin lexicography to give the history of every single word of the Latin language."
                                            },
                                            {
                                                "example_id": "143bab44-7143-46d2-a521-1deb5678e83a",
                                                "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                                "text": "[T]he philologist may well refuse to accept a body of triliteral roots, developed on a highly artificial and uniform plan, as the ultimate fact in Semitic lexicography."
                                            },
                                            {
                                                "example_id": "100742c7-e66c-4005-9b40-da8f5600ce9c",
                                                "sense_id": "c6f8239c-9cef-3b18-adb8-a594ed93e7b8",
                                                "text": "Academic lexicography, or 'metalexicography', as pursued in university departments of English or Linguistics, is concerned not primarily with the compiling of dictionaries – though academics may be involved in this, as consultants, for example – but with researching and teaching about the whole business of making dictionaries: their history, their typology, their structures, their users, and so on [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d17eadb-f627-3d2c-ab3b-58a36e9cc0c3",
                                        "entry_id": "745b73b4-46db-3e35-ac8f-d57affe8b60a",
                                        "glosses": [
                                            "A dictionary, a lexicon, a wordbook."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6504272d-fc3e-4ccb-87c5-e3d4f4be204f",
                                                "sense_id": "6d17eadb-f627-3d2c-ab3b-58a36e9cc0c3",
                                                "text": "There can be no doubt, that in a general sense a boat is a vessel, for it is \"a vehicle in which men or goods are carried on the water,\" which is one of the definitions of a vessel given in our lexicographies; [...]"
                                            },
                                            {
                                                "example_id": "f7b85f99-476e-439b-bbf9-24c46950e9a7",
                                                "sense_id": "6d17eadb-f627-3d2c-ab3b-58a36e9cc0c3",
                                                "text": "\"Air put in motion\" is the brief description of the wind in lexicographies; but what a contrast in quality according to its direction; [...]"
                                            },
                                            {
                                                "example_id": "91135a94-355f-453b-9e4a-0238978dd4a0",
                                                "sense_id": "6d17eadb-f627-3d2c-ab3b-58a36e9cc0c3",
                                                "text": "The earliest examples of dictionaries or lexicographies in nearly any culture serve more to regularize and standardize the lexicon than to list or inventory it, and as such would tend to take as their object textual rather than spoken language."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
