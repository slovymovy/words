                        "entry_id": "1a35d64d-2d92-3323-9363-f91e172d9d5a",
                        "glosses": [
                            "zugzwang",
                            "synonym of Zugpflicht (“the rule that a player cannot forgo a move”)"
                        ],
                        "tags": [
                            "especially",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a0434063-e743-42a6-acef-e80266260a5d",
                                "sense_id": "ffd76a7f-23bb-3992-830f-ebf875d1c976",
                                "text": "Kühe können entlang den Linien um ein Feld gezogen werden. Sie können nicht springen und nicht schlagen. Für beide Parteien gilt Zugzwang. Für den Leoparden gilt kein Schlagzwang.",
                                "translation": "Cows can be moved along the lines by one square. They cannot jump nor capture any piece. Both players are forced to make a move. The leopard is not forced to capture a piece if possible.",
                                "english": "Cows can be moved along the lines by one square. They cannot jump nor capture any piece. Both players are forced to make a move. The leopard is not forced to capture a piece if possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "a94bf044-1423-37db-9222-2ff455099b46",
                        "entry_id": "1a35d64d-2d92-3323-9363-f91e172d9d5a",
                        "glosses": [
                            "zugzwang",
                            "a situation where this rule forces a player to make a disadvantageous move"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "65fd02b5-257f-34f5-a9aa-28b467e0b9d3",
                        "entry_id": "1a35d64d-2d92-3323-9363-f91e172d9d5a",
                        "glosses": [
                            "zugzwang",
                            "a situation where someone is under pressure to take action, though not necessarily with disadvantageous consequences."
                        ],
                        "tags": [
                            "broadly",
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    }
