{
    "word_family": [
        "perennially",
        "perenniality",
        "perennialism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                    "sense_definition": "Appearing or recurring again and again; recurrent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recurring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traffic congestion remains a <w>perennial</w> problem in the city center.",
                            "target_lang_translations": {
                                "de": "Verkehrsstaus bleiben ein <w>ständiges</w> Problem im Stadtzentrum."
                            }
                        },
                        {
                            "text": "He is a <w>perennial</w> candidate who runs in every local election but never wins.",
                            "target_lang_translations": {
                                "de": "Er ist ein <w>ewiger</w> Kandidat, der bei jeder Kommunalwahl antritt, aber nie gewinnt."
                            }
                        }
                    ],
                    "synonyms": [
                        "recurrent",
                        "recurring",
                        "repetitive"
                    ],
                    "antonyms": [
                        "one-off",
                        "occasional"
                    ],
                    "common_phrases": [
                        "perennial favorite",
                        "perennial problem",
                        "perennial theme"
                    ],
                    "target_lang_definitions": {
                        "de": "Immer wieder auftretend oder wiederkehrend; wiederholt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wiederkehrend",
                                "target_lang_sense_clarification": "regelmäßig wieder auftretend"
                            },
                            {
                                "target_lang_word": "ständig",
                                "target_lang_sense_clarification": "dauernd, andauernd"
                            },
                            {
                                "target_lang_word": "alljährlich",
                                "target_lang_sense_clarification": "jedes Jahr wiederkehrend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b8d1e4-d120-3869-9325-a7f75d45cd07",
                    "sense_definition": "Of a plant: active throughout the year, or having a life cycle of more than two growing seasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lavender is a <w>perennial</w> herb that will grow back every spring.",
                            "target_lang_translations": {
                                "de": "Lavendel ist ein <w>mehrjähriges</w> Kraut, das jedes Frühjahr wieder nachwächst."
                            }
                        },
                        {
                            "text": "The gardener recommended planting <w>perennial</w> shrubs for year-round greenery.",
                            "target_lang_translations": {
                                "de": "Der Gärtner empfahl, <w>mehrjährige</w> Sträucher für ganzjähriges Grün zu pflanzen."
                            }
                        }
                    ],
                    "synonyms": [
                        "evergreen"
                    ],
                    "antonyms": [
                        "annual",
                        "biennial"
                    ],
                    "common_phrases": [
                        "perennial plant",
                        "perennial herb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Von Pflanzen: Mehrere Vegetationsperioden überdauernd; mehrjährig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mehrjährig",
                                "target_lang_sense_clarification": "botanisch: mehrere Jahre lebend"
                            },
                            {
                                "target_lang_word": "ausdauernd",
                                "target_lang_sense_clarification": "botanisch: krautige Pflanzen, die mehrere Jahre leben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                    "sense_definition": "Continuing without cessation or intermission; neverending, perpetual, or everlasting.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "eternal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel explores the <w>perennial</w> quest for love and acceptance.",
                            "target_lang_translations": {
                                "de": "Der Roman untersucht die <w>immerwährende</w> Suche nach Liebe und Akzeptanz."
                            }
                        },
                        {
                            "text": "Her artwork possesses a <w>perennial</w> beauty that transcends changing fashion trends.",
                            "target_lang_translations": {
                                "de": "Ihr Kunstwerk besitzt eine <w>zeitlose</w> Schönheit, die wechselnde Modetrends übersteigt."
                            }
                        }
                    ],
                    "synonyms": [
                        "eternal",
                        "perpetual",
                        "everlasting",
                        "undying",
                        "timeless"
                    ],
                    "antonyms": [
                        "temporary",
                        "ephemeral",
                        "transient"
                    ],
                    "common_phrases": [
                        "perennial youth",
                        "perennial beauty"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Unterlass andauernd; unaufhörlich, ewig oder zeitlos."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dauerhaft",
                                "target_lang_sense_clarification": "lange anhaltend, beständig"
                            },
                            {
                                "target_lang_word": "ewig",
                                "target_lang_sense_clarification": "zeitlos, unvergänglich"
                            },
                            {
                                "target_lang_word": "immerwährend",
                                "target_lang_sense_clarification": "nie aufhörend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                    "sense_definition": "Lasting or remaining active throughout the entire year, or all the time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "eternal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village relies on a <w>perennial</w> spring for its drinking water.",
                            "target_lang_translations": {
                                "de": "Das Dorf ist für sein Trinkwasser auf eine <w>ganzjährige</w> Quelle angewiesen."
                            }
                        },
                        {
                            "text": "Unlike seasonal creeks, this is a <w>perennial</w> stream that never dries up.",
                            "target_lang_translations": {
                                "de": "Im Gegensatz zu saisonalen Bächen ist dies ein <w>beständiger</w> Fluss, der niemals austrocknet."
                            }
                        }
                    ],
                    "synonyms": [
                        "permanent",
                        "continual"
                    ],
                    "antonyms": [
                        "seasonal",
                        "ephemeral"
                    ],
                    "common_phrases": [
                        "perennial stream",
                        "perennial spring"
                    ],
                    "target_lang_definitions": {
                        "de": "Das ganze Jahr über oder die ganze Zeit aktiv bleibend oder fließend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ganzjährig",
                                "target_lang_sense_clarification": "das ganze Jahr über fließend oder aktiv"
                            },
                            {
                                "target_lang_word": "beständig",
                                "target_lang_sense_clarification": "kontinuierlich fließend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9563aec-e7b0-3a5c-a5f8-340cc18dae27",
                    "sense_definition": "A plant that lives for more than two years.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to plant <w>perennials</w> in the garden so we wouldn't have to replant every year.",
                            "target_lang_translations": {
                                "de": "Wir haben uns entschieden, <w>Stauden</w> in den Garten zu pflanzen, damit wir nicht jedes Jahr neu pflanzen müssen."
                            }
                        },
                        {
                            "text": "Hostas are popular shade-loving <w>perennials</w> that require very little maintenance.",
                            "target_lang_translations": {
                                "de": "Funkien sind beliebte, schattenliebende <w>Stauden</w>, die nur sehr wenig Pflege benötigen."
                            }
                        }
                    ],
                    "antonyms": [
                        "annual",
                        "biennial"
                    ],
                    "common_phrases": [
                        "hardy perennials",
                        "herbaceous perennials"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Pflanze, die länger als zwei Jahre lebt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Staude",
                                "target_lang_sense_clarification": "mehrjährige, krautige Pflanze"
                            },
                            {
                                "target_lang_word": "mehrjährige Pflanze",
                                "target_lang_sense_clarification": "Pflanze mit mehrjährigem Lebenszyklus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19687702-1e2a-3231-ad63-b45747770824",
                    "sense_definition": "A person or thing (such as a problem or event) that appears or returns regularly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recurring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Budget deficits are one of the political <w>perennials</w> that every administration must face.",
                            "target_lang_translations": {
                                "de": "Haushaltsdefizite gehören zu den politischen <w>Dauerbrennern</w>, mit denen sich jede Regierung auseinandersetzen muss."
                            }
                        },
                        {
                            "text": "The veteran singer is one of the <w>perennials</w> of the summer music festival circuit.",
                            "target_lang_translations": {
                                "de": "Der erfahrene Sänger gehört zu den <w>Dauergästen</w> der Sommer-Musikfestivals."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Sache (z. B. ein Problem), die regelmäßig wiederkehrt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dauerbrenner",
                                "target_lang_sense_clarification": "ein ständig wiederkehrendes Thema oder Problem"
                            },
                            {
                                "target_lang_word": "Dauergast",
                                "target_lang_sense_clarification": "eine Person, die regelmäßig wiederkehrt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a7ddf06-f9a5-3458-906a-8f0b2431218a",
                    "sense_definition": "A thing that lasts forever.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eternal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the realm of philosophy, truths are often treated as absolute <w>perennials</w>.",
                            "target_lang_translations": {
                                "de": "Im Bereich der Philosophie werden Wahrheiten oft als absolute <w>Konstanten</w> behandelt."
                            }
                        },
                        {
                            "text": "He sought to capture the fleeting moments of life and turn them into artistic <w>perennials</w>.",
                            "target_lang_translations": {
                                "de": "Er versuchte, die flüchtigen Momente des Lebens einzufangen und sie in künstlerische <w>Dauerbrenner</w> zu verwandeln."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das ewig Bestand hat oder unvergänglich ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dauerbrenner",
                                "target_lang_sense_clarification": "etwas, das nie an Aktualität verliert"
                            },
                            {
                                "target_lang_word": "Konstante",
                                "target_lang_sense_clarification": "etwas, das immer unverändert bleibt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}