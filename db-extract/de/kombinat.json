                ],
                "senses": [
                    {
                        "sense_id": "e703c150-3ec4-30cb-b007-e01670baf8be",
                        "entry_id": "e8a83575-4096-3cc2-bdd6-4c2d77367991",
                        "glosses": [
                            "Industrieverbund in der ehemaligen DDR und anderen sozialistischen Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb3666cd-f577-4397-b8de-6b9436daab79",
                                "sense_id": "e703c150-3ec4-30cb-b007-e01670baf8be",
                                "text": "Seit 1979 war das Stahl- und Walzwerk Brandenburg Stammbetrieb des Kombinats Qualitäts- und Edelstahl."
                            },
                            {
                                "example_id": "98879c8c-5d0d-495c-a4c0-c5ce2e8e2ccd",
                                "sense_id": "e703c150-3ec4-30cb-b007-e01670baf8be",
                                "text": "Der Direktor des Kombinats war Mitglied der Parteinomenklatur."
                            },
                            {
                                "example_id": "9e9ab4a6-a43b-4e5e-877a-0429288ff036",
                                "sense_id": "e703c150-3ec4-30cb-b007-e01670baf8be",
                                "text": "„Seit der Zentralisierung Tausender von Kleinproduzenten in Kombinaten kein zischendes Ratatam der Glasdrückereien, keine nervtötende Schleifmaschine in der Nachbarschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37762ab0-ac78-453b-abae-5c4aff1048a1",
                        "source_entry_id": "e8a83575-4096-3cc2-bdd6-4c2d77367991",
                        "source_sense_id": "e703c150-3ec4-30cb-b007-e01670baf8be",
                        "source_sense_description": "Industrieverbund in der ehemaligen DDR und anderen sozialistischen Staaten",
                        "target_lang_word": "комбинат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "комбинат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "030c8467-6ca4-3f7f-83f4-54e87cfd5d0f",
                                        "entry_id": "8189e30a-fd23-3a8d-aad3-78eeb5eb9ea6",
                                        "glosses": [
                                            "объединение промышленных предприятий смежных отраслей, в котором продукция одного предприятия служит сырьём, полуфабрикатом или технологическим материалом для другого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb8d000-8678-4256-8bd8-7ea0b9f0b582",
                                                "sense_id": "030c8467-6ca4-3f7f-83f4-54e87cfd5d0f",
                                                "text": "Вектор развития нашего мебельного комбината, как и раньше, направлен на то, чтобы сделать процесс производства мебели максимально рациональным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd56267-b8e6-3ae4-969d-53ebfee3bc59",
                                        "entry_id": "8189e30a-fd23-3a8d-aad3-78eeb5eb9ea6",
                                        "glosses": [
                                            "объединение мелких производств, направленных на комплексное обслуживание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fdfa25-4dd9-4f30-ad00-c41b4547616a",
                                                "sense_id": "edd56267-b8e6-3ae4-969d-53ebfee3bc59",
                                                "text": "Комбинат бытового обслуживания имеет сеть приёмных пунктов и цех для выполнения заказанных работ, а также централизованное управление."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d9fe05-d995-3a56-8bf6-7baabc40e83c",
                                        "entry_id": "8189e30a-fd23-3a8d-aad3-78eeb5eb9ea6",
                                        "glosses": [
                                            "объединение учебных или воспитательных заведений разных ступеней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1cd40b-f6b8-423a-81fd-e2033bcf708f",
                                                "sense_id": "d8d9fe05-d995-3a56-8bf6-7baabc40e83c",
                                                "text": "6 сотрудников Калининградского детского комбината заболели кишечной инфекцией."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
