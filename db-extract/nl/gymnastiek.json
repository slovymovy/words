                                        ]
                                    },
                                    {
                                        "sense_id": "532eaa66-79af-3f61-bcad-41b3bb5f2394",
                                        "entry_id": "3ddb4e7f-0048-3c2b-8e91-c207fae10e9f",
                                        "glosses": [
                                            "Qualifie un pas de course cadencé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8665a96-3e31-420b-832b-cbbf4facbef4",
                                                "sense_id": "532eaa66-79af-3f61-bcad-41b3bb5f2394",
                                                "text": "Ce fut au pas gymnastique que je gravis la petite côte qui menait à la villa de Conan, cette villa célèbre dans tout le corps d’armée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gymnastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b5a002d-6a3b-31a6-8781-c56f99fca64c",
                                        "entry_id": "d36a99e0-f007-3157-a58d-15fe6cd543cd",
                                        "glosses": [
                                            "Art, l’action d’exercer le corps pour le fortifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04db32aa-f2ea-479d-9d16-dbe852dcc671",
                                                "sense_id": "0b5a002d-6a3b-31a6-8781-c56f99fca64c",
                                                "text": "Aujourd’hui, quand les Français font du sport en dehors de leur domicile […] ils choisissent majoritairement de jouer au tennis […], ou bien ils participent à des séances de gymnastique, d’assouplissement, de musculation ou d’aérobic (9 % en 1985), ou bien encore ils nagent (8,6 % des interviewés joggent ou marathonent)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdce737e-b55a-3e32-89aa-2f48cfd19586",
                                        "entry_id": "d36a99e0-f007-3157-a58d-15fe6cd543cd",
                                        "glosses": [
                                            "Activité corporelle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acd1f21d-36fa-44e3-9555-95a892aabc3b",
                                                "sense_id": "bdce737e-b55a-3e32-89aa-2f48cfd19586",
                                                "text": "Les mousses, en raison de leur gymnastique particulière, ont aussi les bras et les muscles pectoraux très-gros."
                                            },
                                            {
                                                "example_id": "a9d49a26-d470-4603-913c-00be7751b771",
                                                "sense_id": "bdce737e-b55a-3e32-89aa-2f48cfd19586",
                                                "text": "Elle […] n'affirme sa supériorité que dans la gymnastique amoureuse. Elle excelle aux tortillements, tour à tour fougueuse et alanguie, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a4bb59-2deb-3de3-a1af-e433d872bbe7",
                                        "entry_id": "d36a99e0-f007-3157-a58d-15fe6cd543cd",
                                        "glosses": [
                                            "Exercice."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86639c51-809b-4a65-97fb-32db690b29ca",
                                                "sense_id": "22a4bb59-2deb-3de3-a1af-e433d872bbe7",
                                                "text": "La gymnastique de l’esprit."
                                            },
                                            {
                                                "example_id": "f3753fc8-78fb-4f69-80f2-6177ad21908c",
                                                "sense_id": "22a4bb59-2deb-3de3-a1af-e433d872bbe7",
                                                "text": "Ces exercices sont une bonne gymnastique pour l’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7c9c03-cd75-3447-a430-9456f3b08fd5",
                                        "entry_id": "d36a99e0-f007-3157-a58d-15fe6cd543cd",
                                        "glosses": [
                                            "Opération difficile et complexe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deece6d5-7699-4715-bf81-22773ca5e997",
                                                "sense_id": "3f7c9c03-cd75-3447-a430-9456f3b08fd5",
                                                "text": "Le grand public qui lit un communiqué de presse, un catalogue ou un manuel ne peut pas se douter de la gymnastique linguistique de haut niveau qui se cache derrière le produit fini qu’il a entre les mains, comment des traducteurs et des réviseurs se sont cassé la tête à essayer de découdre soigneusement la fibre étrangère sans ne rien en perdre pour la retricoter selon une tout autre logique afin de permettre au lecteur d’appréhender le texte comme s’il avait été taillé sur mesure pour lui."
                                            }
                                        ]
                                    }
                                ]
                            },
