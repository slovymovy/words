                        "cross_references": [
                            {
                                "target_word": "chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b23b015-21be-37f8-abd9-f16f291084b5",
                                        "entry_id": "91ddc41e-df1d-3799-9b8e-cdf2c301fa22",
                                        "glosses": [
                                            "A louse (small, parasitic insect)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "World-War-I",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a779640-8d57-4811-84b3-eb7dfa2e5fbf",
                                                "sense_id": "2b23b015-21be-37f8-abd9-f16f291084b5",
                                                "text": "'Do officers have chats, then, the same as us?'\n'Not the same, no. The chats they got is bigger and better, with pips on their shoulders and Sam Browne belts.'"
                                            },
                                            {
                                                "example_id": "1ce408b0-2aad-4fff-80bd-ffd69a72ffcc",
                                                "sense_id": "2b23b015-21be-37f8-abd9-f16f291084b5",
                                                "text": "May a thousand chats from Belgium crawl under their fingers as they write."
                                            },
                                            {
                                                "example_id": "3cdb0301-0ee5-4581-a298-b3bc97af12d0",
                                                "sense_id": "2b23b015-21be-37f8-abd9-f16f291084b5",
                                                "text": "Trench foot was a nasty and potentially fatal foot disease commonly caused by these conditions, in which chats or body lice were the bane of all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e70dd15-2e99-33e6-89b6-a3169c6e3f8b",
                                        "entry_id": "0dc53740-1c06-359e-8218-8743eb62c73b",
                                        "glosses": [
                                            "Alternative form of chaat."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To be engaged in informal conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688838c0-7475-4c7c-8a5c-5e3fa0a5f8be",
                                                "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                                "text": "She chatted with her friend in the cafe."
                                            },
                                            {
                                                "example_id": "b06d67ef-1d26-4c07-986f-4de2ebe45cf9",
                                                "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                                "text": "I like to chat over a coffee with a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a406dd6-5f9c-3ad8-8914-c0efe371b7e5",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To talk more than a few words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2624dbdd-7bab-49cd-a9cb-05d15dae378f",
                                                "sense_id": "1a406dd6-5f9c-3ad8-8914-c0efe371b7e5",
                                                "text": "I met my old friend in the street, so we chatted for a while."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To talk of; to discuss."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd840527-296d-4e45-9c98-0488046916c3",
                                                "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                                "text": "They chatted politics for a while."
                                            },
                                            {
                                                "example_id": "846a5b8f-99cb-4284-bac7-302c69003c97",
                                                "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                                "text": "We would get totally stoned and usually drunk too and chat a load of nonsense into the small hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e626f93-3105-381d-9087-632580267236",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To chat shit (to speak nonsense, to lie)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b8f5fd-f8b0-46f1-aa6a-7c6c3946a39b",
                                                "sense_id": "8e626f93-3105-381d-9087-632580267236",
                                                "text": "Don't listen to me, I'm chatting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a040c1-51fd-3955-bbd3-6f632de5a900",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To exchange text or voice messages in real time through a computer network such as a social media chat room or messaging application (as if having a face-to-face conversation instead of SMS or writing emails or letters)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e564255-2465-494e-9119-ad9b174ee2ab",
                                                "sense_id": "86a040c1-51fd-3955-bbd3-6f632de5a900",
                                                "text": "Do you want to chat online later?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                                        "entry_id": "480364fc-459b-3ff7-8a46-9309be9b77a2",
                                        "glosses": [
                                            "Informal conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ebaac18-26a6-4937-8e1c-001223f187b0",
                                                "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                                                "text": "It'd be cool to meet up again soon and have a quick chat."
                                            },
                                            {
                                                "example_id": "8221fd30-6a19-4b61-8668-fc93aad4bf56",
                                                "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                                                "text": "Reg liked a chat about old times and we used to go and have a chinwag in the pub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe86062-2845-3b27-bee7-d4df0bb52a5f",
                                        "entry_id": "480364fc-459b-3ff7-8a46-9309be9b77a2",
                                        "glosses": [
                                            "An exchange of text or voice messages in real time through a computer network, resembling a face-to-face conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033b707c-956d-467e-8a4b-968ba18904f0",
                                                "sense_id": "afe86062-2845-3b27-bee7-d4df0bb52a5f",
                                                "text": "Internet Relay Chat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0581a586-a9d3-3883-b3f7-6147ee6d9f44",
                                        "entry_id": "480364fc-459b-3ff7-8a46-9309be9b77a2",
                                        "glosses": [
                                            "A chat room, especially (in later use) one accompanying a videoconference or live stream."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f77a206-3eaa-4082-a9ec-eabd20d2f1c3",
                                                "sense_id": "0581a586-a9d3-3883-b3f7-6147ee6d9f44",
                                                "text": "\"Type yes in (the) chat if you can hear me.\""
                                            },
                                            {
                                                "example_id": "7db83a9d-c9af-45ac-a102-310eee82c5b8",
                                                "sense_id": "0581a586-a9d3-3883-b3f7-6147ee6d9f44",
                                                "text": "While there are chats for various interest groups (games, Internet, sports), you can also […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f6c8f8-cd70-3866-b4dc-312c1c1dc50f",
                                        "entry_id": "480364fc-459b-3ff7-8a46-9309be9b77a2",
                                        "glosses": [
                                            "A chat room, especially (in later use) one accompanying a videoconference or live stream.",
                                            "The entirety of users, viewed collectively, in a chat room, especially the chat room accompanying a live stream."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f9ffce6-e9f2-4927-87f5-a026f2c93bc6",
                                                "sense_id": "14f6c8f8-cd70-3866-b4dc-312c1c1dc50f",
                                                "text": "The chat just made a joke about my poor skillz."
                                            },
                                            {
                                                "example_id": "9c1b7a50-b7f7-43a9-b437-6d7c52b16889",
                                                "sense_id": "14f6c8f8-cd70-3866-b4dc-312c1c1dc50f",
                                                "text": "\"Chat, should I pick up this sword before heading out?\""
