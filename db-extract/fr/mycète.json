                "senses": [
                    {
                        "sense_id": "f05ae9df-d137-3d43-b634-ef834a730060",
                        "entry_id": "cdf68113-b64d-348f-ba43-42bd78ebb5bd",
                        "glosses": [
                            "Champignon qui appartient au groupe des eumycètes (ou mycota, ou Fungi)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12c371e5-6dd4-47df-9e49-541f9c583ccc",
                                "sense_id": "f05ae9df-d137-3d43-b634-ef834a730060",
                                "text": "C’est le mycète (90 % du lichen) qui permet de caractériser chaque espèce de lichen (20 000 espèces répertoriées)."
                            },
                            {
                                "example_id": "e7bee80e-e65e-476f-ad02-20d8cddc42d7",
                                "sense_id": "f05ae9df-d137-3d43-b634-ef834a730060",
                                "text": "Ainsi, elle ne ramassait jamais les agarics ; les champignons qu’elle cueillait étaient tous des espèces appartenant à la section comestible du genre Boletus (l’edulis fauve, le brun scaber, le rouge aurantiacus, et quelques proches parents), que certains nomment “champignons tubéreux” et que les mycologues définissent froidement comme étant “des mycètes terrestres, charnus, putrescents, stipités centralement”."
                            }
                        ]
                    }
