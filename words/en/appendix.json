{
    "word_family": [
        "append",
        "appendage",
        "appendicular",
        "appendectomy",
        "appendicitis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eaf4104f-09d0-3033-87c6-3b62169c04cc",
                    "sense_definition": "A section of additional information or data provided at the end of a book, document, or article.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "document_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can find the full list of references in the <w>appendix</w> at the back of the report.",
                            "target_lang_translations": {
                                "ru": "Полный список литературы вы можете найти в <w>приложении</w> в конце отчета."
                            }
                        },
                        {
                            "text": "The author decided to include an <w>appendix</w> with detailed maps of the region.",
                            "target_lang_translations": {
                                "ru": "Автор решил включить <w>приложение</w> с подробными картами региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "addendum",
                        "supplement",
                        "annex"
                    ],
                    "common_phrases": [
                        "include an appendix",
                        "see the appendix",
                        "appendix at the end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел с дополнительной информацией или данными, приводимый в конце книги, документа или статьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приложение",
                                "target_lang_sense_clarification": "дополнительный текст в конце документа"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "добавленный объект или раздел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "902c2fca-1d0a-3ad5-89cc-da75ba2f9763",
                    "sense_definition": "A small, tube-shaped pouch attached to the large intestine in humans and some mammals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon had to remove his <w>appendix</w> because it was severely inflamed.",
                            "target_lang_translations": {
                                "ru": "Хирургу пришлось удалить ему <w>аппендикс</w>, так как он был сильно воспален."
                            }
                        },
                        {
                            "text": "He suffered from a burst <w>appendix</w> and needed emergency medical attention immediately.",
                            "target_lang_translations": {
                                "ru": "У него лопнул <w>аппендикс</w>, и ему потребовалась немедленная медицинская помощь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burst appendix",
                        "inflamed appendix",
                        "remove the appendix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой трубчатый отросток слепой кишки у человека и некоторых млекопитающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппендикс",
                                "target_lang_sense_clarification": "анатомический орган"
                            },
                            {
                                "target_lang_word": "аппендицит",
                                "target_lang_sense_clarification": "часто используется в разговорной речи для обозначения самого органа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc95c5c1-2d83-3da7-8590-eb0113779dff",
                    "sense_definition": "Something that is attached or added to something else as a secondary part or accompaniment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some historical contexts, idleness was seen as a natural <w>appendix</w> to nobility.",
                            "target_lang_translations": {
                                "ru": "В некоторых исторических контекстах праздность рассматривалась как естественный <w>придаток</w> к благородству."
                            }
                        },
                        {
                            "text": "The small building served as a functional <w>appendix</w> to the main estate.",
                            "target_lang_translations": {
                                "ru": "Небольшое здание служило функциональным <w>дополнением</w> к главному имению."
                            }
                        }
                    ],
                    "synonyms": [
                        "attachment",
                        "adjunct",
                        "appendage"
                    ],
                    "common_phrases": [
                        "natural appendix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что прикреплено или добавлено к чему-то другому в качестве второстепенной части или сопровождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придаток",
                                "target_lang_sense_clarification": "второстепенное дополнение"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "сопутствующая часть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be988551-a23b-38fa-8591-ae706a7628f7",
                    "sense_definition": "A small projection or outgrowth from a larger structure, especially in biological contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist examined the small <w>appendix</w> protruding from the specimen's main body.",
                            "target_lang_translations": {
                                "ru": "Ученый исследовал небольшой <w>отросток</w>, выступающий из основного тела образца."
                            }
                        },
                        {
                            "text": "Each <w>appendix</w> on the cell surface plays a role in sensing the environment.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>отросток</w> на поверхности клетки играет роль в восприятии окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "appendage"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical biological usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой выступ или вырост на более крупной структуре, особенно в биологическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отросток",
                                "target_lang_sense_clarification": "биологический выступ"
                            },
                            {
                                "target_lang_word": "придаток",
                                "target_lang_sense_clarification": "выступающая часть структуры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}