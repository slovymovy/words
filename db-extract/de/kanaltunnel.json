                        "entry_id": "bd1ca00d-3397-37be-96eb-a91b58f5249f",
                        "glosses": [
                            "50 km langer Eisenbahntunnel unter der Straße von Dover zwischen Folkestone (Vereinigtes Königreich) und Coquelles (Frankreich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33aaf7b1-e1dc-49f4-a5b2-f94bf47f4393",
                                "sense_id": "e113f72d-1117-3fbc-92c8-ffa95cf3bffe",
                                "text": "„Die französische Polizei hat einen Massenansturm von mehreren hundert Flüchtlingen gestoppt, die durch den Kanaltunnel zu Fuß nach England gelangen wollten.“"
                            },
                            {
                                "example_id": "5a24d370-bf72-4235-a6cb-b90f70a6b5a1",
                                "sense_id": "e113f72d-1117-3fbc-92c8-ffa95cf3bffe",
                                "text": "„Das Winterwetter hat zum wiederholten Mal den Zugverkehr im Kanaltunnel behindert.“"
                            }
