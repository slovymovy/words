                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7bc8cd21-2f8f-34fc-ac31-c6e6316872c3",
                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                        "glosses": [
