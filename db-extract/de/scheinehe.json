                "senses": [
                    {
                        "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                        "entry_id": "a5f6c9db-82a9-37e0-9bc1-5e99375fd6c4",
                        "glosses": [
                            "eine Ehe, die zum Schein geführt wird, um irgendwelche Begünstigen zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c574e6c-1d8d-48f2-941a-46f973175fba",
                                "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                                "text": "Die Scheinehe zwischen Einheimischen und Zugereisten ist nicht immer gern gesehen."
                            },
                            {
                                "example_id": "18850b05-f915-4a99-99bb-8ee45879ed77",
                                "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                                "text": "„Ich überlegte kurz, ob ich mit ihm eine Scheinehe eingehe, damit sich mein Handicap durch einen neuen Namen auf dem ohnehin schon angespannten Wohnungsmarkt wie ein Schweizer Kräuterbonbon auflöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b0f5f0c-5844-4ef8-8ff7-93391fe2b8a2",
                        "source_entry_id": "a5f6c9db-82a9-37e0-9bc1-5e99375fd6c4",
                        "source_sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                        "source_sense_description": "eine Ehe, die zum Schein geführt wird, um irgendwelche Begünstigen zu erhalten",
                        "target_lang_word": "marriage of convenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marriage of convenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A marriage motivated by some reason other than love; for example, one conducted to obtain residence rights in a country, for financial gain, or for political purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ef5504-b246-4bc1-8fd4-50f14eb87290",
                                                "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                                "text": "Widely published author and business consultant would like a marriage of convenience with a woman who is an Irish or Austrian citizen. You get legal resident status in U.S. (and eligibility for student aid), and I get eligibility for prison furloughs plus the citizenship of a neutral country in a few years so I can start a new life elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A big tent alliance of disparate factions (such as political factions)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0254549f-c0bd-4df6-8cb8-8ae63a73d00a",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Libertarians and the Religious Right make odd bedfellows, but that marriage of convenience in the Republican Party has stuck around since the 1980s."
                                            },
                                            {
                                                "example_id": "fd51dc2a-a62f-4405-aaac-2d8156507edc",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Kofi Annan’s marriage of convenience is likely to last only as long as it takes the political players to build up war chests ahead of another electoral bout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c2be7b7-2d4d-4adf-bcdb-6e4aaa0506bc",
                        "source_entry_id": "a5f6c9db-82a9-37e0-9bc1-5e99375fd6c4",
                        "source_sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                        "source_sense_description": "eine Ehe, die zum Schein geführt wird, um irgendwelche Begünstigen zu erhalten",
                        "target_lang_word": "mariage blanc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mariage blanc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa2c1aad-2a7c-38a8-be48-15476e43b267",
                                        "entry_id": "55ef227c-51ea-34d5-99fe-99cd56016945",
                                        "glosses": [
                                            "Mariage non consommé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6329e73-5877-4334-9339-93b9d09bc04c",
                                                "sense_id": "aa2c1aad-2a7c-38a8-be48-15476e43b267",
                                                "text": "Toutefois la compassion de M. de Sénange envers Adèle qu’il sauve du couvent grâce à un mariage blanc, la fidélité à la fille d’un ami décédé […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1df7f6-aac0-32e7-b82b-d1a1f88135c1",
                                        "entry_id": "55ef227c-51ea-34d5-99fe-99cd56016945",
                                        "glosses": [
                                            "Mariage de complaisance contracté dans d’autres buts que la vie commune, généralement pour en tirer un avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98e704d3-7e62-4004-be2d-e5dae5dfd4b2",
                                                "sense_id": "9a1df7f6-aac0-32e7-b82b-d1a1f88135c1",
                                                "text": "En revanche, lorsqu’il il y a soupçon de mariage blanc, il a la possibilité de saisir le procureur de la République, lequel peut surseoir à la célébration du mariage pour enquêter pendant au plus deux mois avant de statuer."
                                            },
                                            {
                                                "example_id": "6e2c0a6b-966f-4e16-8f12-ca9fcf69c3d1",
                                                "sense_id": "9a1df7f6-aac0-32e7-b82b-d1a1f88135c1",
                                                "text": "Eric, qui lui gardait son affection et la soutenait matériellement, trouva un Bulgare qui accepta, moyennant finances, de conclure un mariage blanc accompagné d’une conversion à la religion orthodoxe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
