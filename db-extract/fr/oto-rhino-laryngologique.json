                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee4e2e90-8f55-41da-a32c-1447009fc466",
                                                "sense_id": "581cb87a-330d-3a0f-9ea4-ff375b3df186",
                                                "text": "1998, Peter M. Lauven, Peter Kulka, 1: Anesthesia for Surgical Procedures on the Neck, Hans Heinz Naumann, Jan Helms (editors), Head and Neck Surgery, Volume 3: Neck, page 1,\nThe premedication of otorhinolaryngological patients does not differ from that in other surgical disciplines."
                                            },
                                            {
                                                "example_id": "ba93cc73-5b59-4b3a-8c99-53354530594b",
                                                "sense_id": "581cb87a-330d-3a0f-9ea4-ff375b3df186",
                                                "text": "This has led to considering the phenomenon as of psychogenic origin and can explain why the condition is sometimes missed on a single otorhinolaryngological examination."
                                            },
                                            {
                                                "example_id": "a5421d6e-79cf-4319-87c1-981c2d1ca10e",
                                                "sense_id": "581cb87a-330d-3a0f-9ea4-ff375b3df186",
                                                "text": "There is a need for studies evaluating the effect of early interventions for otorhinolaryngological conditions on social interaction, communication, behaviour and quality of life for people with ID."
                                            }
                                        ]
                                    }
