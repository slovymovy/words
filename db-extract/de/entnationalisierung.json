                "senses": [
                    {
                        "sense_id": "9e327c19-45fe-36d0-a78e-eb0a2b365177",
                        "entry_id": "e62d3ac3-3e62-3023-bb82-97aa72573f21",
                        "glosses": [
                            "Entzug der Staatsbürgerschaft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f197152c-47d9-351e-bc18-123a633b14e7",
                        "entry_id": "e62d3ac3-3e62-3023-bb82-97aa72573f21",
                        "glosses": [
                            "Zerstörung der kulturellen Identität einer Volksgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b67dd2-dda3-435d-aaa5-b801eeee1956",
                                "sense_id": "f197152c-47d9-351e-bc18-123a633b14e7",
                                "text": "„Die Angst der Slowenen vor einer Entnationalisierung ergab sich vor allem aus ihren Zweifeln an der Überlebensfähigkeit der slowenischen Sprache.\""
                            },
                            {
                                "example_id": "baffa75a-a71e-44e1-b03a-0c68a8b44310",
                                "sense_id": "f197152c-47d9-351e-bc18-123a633b14e7",
                                "text": "„Die preußische Politik (Droht den Polen die Entnationalisierung?)\""
                            },
                            {
                                "example_id": "44ae1d21-73dd-425f-8b72-681e53b6fcc2",
                                "sense_id": "f197152c-47d9-351e-bc18-123a633b14e7",
                                "text": "„Während Tolomei sofortige Zwangsmaßnahmen vor allem in der Sprachpolitik verlangte, sprach sich Giraldi gegen eine solch aggressive Entnationalisierung aus und vertrat damit den Weg einer friedlichen Durchdringung Deutschsüdtirols.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                        "entry_id": "e62d3ac3-3e62-3023-bb82-97aa72573f21",
                        "glosses": [
                            "Verringerung des staatlichen Einflusses (auf Organisationen, Unternehmen oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf79039f-2819-440d-b3ba-531559907a31",
                                "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                                "text": "„Das was wir ..Staatstheorie, Rechts- und Ökonomielehre nennen, ist ..eine Lehre von der ...Zersetzung, Auflösung ... des Staates ... vermittels dreier ... Begriffe: 3. vermittelst des ... Begriffes von einer Privatisierung und Entnationalisierung aller Empfindungen des Lebens.\""
                            },
                            {
                                "example_id": "7b860c53-7037-490b-ba7e-9b3eb2b22b72",
                                "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                                "text": "„Auch bei der Entnationalisierung und Privatisierung war die Wiederherstellung der Rechtslage vor der sowjetischen Besatzung das vorgegebene Ziel.\""
                            },
                            {
                                "example_id": "bc2aa806-b011-4fff-b038-df7378e7d432",
                                "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                                "text": "„Beides, Wettbewerb und Liberalisierung, beseitigt Monopolgewinne und öffentliche Subventionen, verringert jedoch Staatseinnahmen aus der Entnationalisierung zum Vorteil der Leistungsfähigkeit der Wirtschaft.\""
                            },
                            {
                                "example_id": "4121d997-6361-48d1-8fdf-f5dac251ea6e",
                                "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                                "text": "„Im Zentrum des Beitrags der Entnationalisierung des Geldes steht die Idee des wettbewerblichen Geldangebots privatautonomer Institutionen\""
                            },
                            {
                                "example_id": "5e5445e3-b2ad-4e91-ad03-25ddc7290e1b",
                                "sense_id": "8bea3809-b6f4-373f-b324-fd40ce006854",
                                "text": "„Es geht um die Entnationalisierung der Warenproduktion.. Und es geht um die Entnationalisierung der letzten Entscheidung - die nationalen Regierungen haben dabei nicht mehr viel mitzureden; ihre Gestaltungsmacht ist ihnen aus den Händen geglitten.\""
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
