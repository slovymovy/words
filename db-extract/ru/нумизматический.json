                "senses": [
                    {
                        "sense_id": "808c2d53-4a28-3526-8565-7f322cb05bea",
                        "entry_id": "828b1370-c519-3483-96a9-15d4672d2f12",
                        "glosses": [
                            "спец. относящийся к нумизматике"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1feab898-a9a7-38fc-9837-5227e841c142",
                        "entry_id": "828b1370-c519-3483-96a9-15d4672d2f12",
                        "glosses": [
                            "относящийся к собиранию, коллекционированию старинных монет и медалей"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de6928bb-265f-41ad-a42c-96c737d9cb01",
                        "source_entry_id": "828b1370-c519-3483-96a9-15d4672d2f12",
                        "target_lang_word": "numismatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "numismatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "588b0429-aac1-3220-a89e-19b719735972",
                                        "entry_id": "3312df32-f633-33ee-adb0-6b14b3c872ab",
                                        "glosses": [
                                            "Of or pertaining to currency, especially to coins."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54cad8ed-1aa4-4858-a04a-341bfa8552be",
                                                "sense_id": "588b0429-aac1-3220-a89e-19b719735972",
                                                "text": "After the deperdition of Indagator, having an appetency still further to pervstigate the frithy occident; being still an agamist, and not wishing to be any longer a pedaneous viator, nor to be solivagant, I brought about the emption of a yaud, partly by numismatic mutuation, and partly by a hypothecation of my fusee and argental horologe."
                                            },
                                            {
                                                "example_id": "ebf302b7-a8d0-4f83-aadf-5bdb26d4dd35",
                                                "sense_id": "588b0429-aac1-3220-a89e-19b719735972",
                                                "text": "The most prevalent use of the acronym for the phrase is not in texts — which allowed for expansive writing — but upon numismatic evidence (i.e. coinage) where space was limited and thus often had familiar abbreviations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b775f76-e737-373b-a214-e0735d679635",
                                        "entry_id": "3312df32-f633-33ee-adb0-6b14b3c872ab",
                                        "glosses": [
                                            "Of or pertaining to numismatics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19858b05-6e78-4566-8e9b-bf9dabcb4ae3",
                                                "sense_id": "0b775f76-e737-373b-a214-e0735d679635",
                                                "text": "Numismatic associations had argued before a State Department advisory committee that import restrictions on ancient coins could not fairly be enforced."
                                            }
                                        ]
                                    }
                                ]
                            }
