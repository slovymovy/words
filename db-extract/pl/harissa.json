                "senses": [
                    {
                        "sense_id": "79913084-3cbd-3254-993c-e0c40755759c",
                        "entry_id": "76f734d0-f652-3503-a7fb-6eae3adc02fb",
                        "glosses": [
                            "ostra pasta używana jako przyprawa w kuchni Maghrebu, wytwarzana z papryki chili i czosnku, często z innymi przyprawami i z dodatkiem oliwy, czasem także pomidorów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f3296d-b968-4e3c-a4af-e711e8746025",
                                "sense_id": "79913084-3cbd-3254-993c-e0c40755759c",
                                "text": "Na koniec można dodać utarty żółty ser, tabasco lub harissę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc332b87-acff-4f1e-8448-67ab484197e4",
                        "source_entry_id": "76f734d0-f652-3503-a7fb-6eae3adc02fb",
                        "source_sense_id": "79913084-3cbd-3254-993c-e0c40755759c",
