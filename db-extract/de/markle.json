                ],
                "senses": [
                    {
                        "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                        "entry_id": "9d741aeb-b769-3e8b-b961-e6147c2bedcb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "378faf7a-2e2d-4e77-80b1-2cae220e3516",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Frau Markle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fa89d35a-6ec1-4e14-b91a-8e50b05aa12c",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Herr Markle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b46068e4-76a2-409f-8ea0-6335a51aab58",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Die Markles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "66298b9a-90a5-4e89-93b1-e41f242f2829",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Der Markle trägt nie die Schals, die die Markle ihm strickt."
                            },
                            {
                                "example_id": "f4dce196-2188-47e6-bf33-794de1ce3e6a",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Markle kommt, geht der Herr Markle.“"
                            },
                            {
                                "example_id": "86e1c553-2da3-42ea-bf1c-be29ced6f324",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Markle kommt und geht."
                            },
                            {
                                "example_id": "33f82ddc-ccdb-43db-b375-45adc3d48968",
                                "sense_id": "93b4de18-9844-35c6-aa0d-fb26d9ca0998",
                                "text": "Markles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
