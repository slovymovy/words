                        "glosses": [
                            "Devenir plus clair."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "978f80e1-17ea-4667-88ac-1e563bdc4fd1",
                                "sense_id": "5812d299-2b0a-351c-b9c0-cbe8ee53b80c",
                                "text": "Le lendemain matin, la brume ayant un peu clairci, nous reprîmes prudemment notre route au milieu des glaces encore très dispersées."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c55bbce-ab4d-3344-aa62-7bef4045a506",
                        "entry_id": "1d08863b-8732-3438-be22-617d1febfbe6",
                        "glosses": [
                            "Rendre plus clair."
                        ],
                        "tags": [
