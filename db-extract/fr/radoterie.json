                "senses": [
                    {
                        "sense_id": "721ab061-9d91-377b-bd16-0f48b3c0d2f1",
                        "entry_id": "1f4b4a09-e5b9-3b56-99e3-d322048a5511",
                        "glosses": [
                            "Habitude de radoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7863c4f8-4172-4759-9342-536d01ee09a4",
                                "sense_id": "721ab061-9d91-377b-bd16-0f48b3c0d2f1",
                                "text": "Ne me consent mie, sire Dieux, tant vive que par redouterie entrobli le tien service."
                            },
                            {
                                "example_id": "6118e2db-bc58-4c2a-bf3b-442165e8b50a",
                                "sense_id": "721ab061-9d91-377b-bd16-0f48b3c0d2f1",
                                "text": "Me voilà insensiblement tombée dans la radoterie."
                            },
                            {
                                "example_id": "63a462fb-9adc-49fb-85d5-6b54a3482ff2",
                                "sense_id": "721ab061-9d91-377b-bd16-0f48b3c0d2f1",
                                "text": "Vous savez combien je suis loin de cette radoterie qui fait vitement passer l’amour maternelle aux petits-enfants ; la mienne est demeurée tout court au premier étage."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ba50c01-a2d3-3f12-903e-637b9c6d3b81",
                        "entry_id": "1f4b4a09-e5b9-3b56-99e3-d322048a5511",
                        "glosses": [
                            "Discours, paroles de celui qui radote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c78718-c17f-4d9f-82c1-b451388f6e9b",
                                "sense_id": "2ba50c01-a2d3-3f12-903e-637b9c6d3b81",
                                "text": "Ma fille, il faut que je vous conte ; c’est une radoterie que je ne puis éviter."
                            },
                            {
                                "example_id": "73649228-6ed8-49b8-92f4-1d5c8a4b5e30",
                                "sense_id": "2ba50c01-a2d3-3f12-903e-637b9c6d3b81",
                                "text": "Il m’a grondé de ne pas avoir été à Bourbon, mais c’est une radoterie, car il avoue que, pour boire, Vichy est aussi bon."
                            },
                            {
                                "example_id": "14e9d61b-5b48-4076-ae93-8b42ef3bd1b7",
                                "sense_id": "2ba50c01-a2d3-3f12-903e-637b9c6d3b81",
                                "text": "Je suppose que vos occupations vous permettent de lire une mauvaise pièce [les Lois de Minos] ; que vous daignerez vous amuser un peu des radoteries de la Crète et des miennes."
                            }
                        ]
                    }
