                                ]
                            },
                            {
                                "target_word": "provoking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "846100a1-f969-351a-9b5c-99fee90c0392",
                                        "entry_id": "84542cdb-4787-3c53-a156-9fdc7d59a039",
                                        "glosses": [
                                            "annoying; irritating"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d05d696-035f-4ce5-975f-c475425762e2",
                                                "sense_id": "846100a1-f969-351a-9b5c-99fee90c0392",
                                                "text": "Would you stop interrupting me, dear? It's a most provoking habit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e9c00a6-c6fa-4fbe-a2d1-397e0fb9928d",
                        "source_entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "source_sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                        "source_sense_description": "de bedoeling hebbend om iemand te activeren",
                        "target_lang_word": "provocative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provocative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22a49219-efb0-39d7-baea-370da933ddc1",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Serving or tending to elicit a strong, often negative sentiment in another person; exasperating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bae42c6-3dda-354d-b1cf-410772d1a920",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Serving or tending to excite, stimulate or arouse sexual interest; sexy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                        "entry_id": "3e9be939-c436-34a7-99f8-04ff9b80bf5c",
                                        "glosses": [
                                            "Provoking or triggering any response."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b171e42d-b7f2-4a58-aaeb-8c92daf59b24",
                                                "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                                "text": "[I]t is a terrible long and slippery descent, and a shocking bad road. At the bottom, however, there is a pleasant public; whereat we must really take a modest quencher, for the down air is provocative of thirst."
                                            },
                                            {
                                                "example_id": "8099ef3e-73a1-4d62-a1e0-58f66be4d3e2",
                                                "sense_id": "6c5eea8a-1721-34ce-af25-76ef859db627",
                                                "text": "And the ‘wailing noise,’ which had induced the prosaic, indurated London cabman to get twice off his box to see what was the matter, what anguish had been provocative of that?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provocative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                        "entry_id": "b5218580-09ab-3b4f-8e25-0105f2a318d1",
                                        "glosses": [
                                            "Something that provokes an appetite, especially a sexual appetite; an aphrodisiac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ee46ba-730f-4253-898a-ddad71c5800d",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "She used by way of Provocative, to read the wanton Verses of her Paramour in the day time [...]."
                                            },
                                            {
                                                "example_id": "5442ac11-ad0e-418f-bd07-5a8a1360e519",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "[A]nd that one great and all-important occasion and provocative of these beliefs was actually the rise of self-consciousness — that is, the coming of the mind to a more or less distinct awareness of itself and of its own operation, and the consequent development and growth of Individualism, and of the Self-centred attitude in human thought and action."
                                            },
                                            {
                                                "example_id": "c4bbf79e-0544-430e-a871-8b8095a122a1",
                                                "sense_id": "61748ef0-40d6-3ea7-a7e2-c73c49d46270",
                                                "text": "In Turkey, Iran, and Syria salep is popular as a restorative and also as a provocative to amatory activity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
