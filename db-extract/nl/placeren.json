                ],
                "senses": [
                    {
                        "sense_id": "85749f13-4f87-31fe-bd4e-0ba62fa78933",
                        "entry_id": "c4ba8e42-8f22-3d47-a99b-923b4914c582",
                        "glosses": [
                            "een geschikte plaats geven"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f30181ab-acb3-4bbb-866a-3577f5d22586",
                                "sense_id": "85749f13-4f87-31fe-bd4e-0ba62fa78933",
                                "text": "Volgens hoteltycoon Steve Wynn (…) is het een kwestie van placeren. „De werken moeten zo worden opgehangen dat iedereen ze kan zien, maar niemand erbij kan.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f56934ae-9e0d-3cc7-b189-e44cf093c762",
                        "entry_id": "c4ba8e42-8f22-3d47-a99b-923b4914c582",
                        "glosses": [
                            "bieten zo op een rij planten of uitdunnen dat ze elkaars groei niet belemmeren"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0d0d6a38-4d6f-4a60-896d-0c856de2a50a",
                                "sense_id": "f56934ae-9e0d-3cc7-b189-e44cf093c762",
                                "text": "„Bij het gezin Degezelle werden we goed opgevangen. We hielpen de boer zijn jonge bieten te ‘placeren’ - zo heette het werk van uitdunnen opdat er één biet groot en sterk kon uitgroeien”, zegt J. Van der Meeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f688a6-a148-3e11-80ad-0395822414f0",
                        "entry_id": "c4ba8e42-8f22-3d47-a99b-923b4914c582",
                        "glosses": [
                            "aanleggen van installaties in een bouwwerk, zoals voor water, elektriciteit of verwarming"
                        ],
                        "tags": [
                            "transitive"
                        ],
