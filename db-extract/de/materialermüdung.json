                ],
                "senses": [
                    {
                        "sense_id": "e02c7f1b-c20d-3c01-93c1-34d0ecba7f5e",
                        "entry_id": "35543f95-e5a9-3948-b471-5d84be618846",
                        "glosses": [
                            "Verlust von Stabilität eines Werkstoffs mit steigendem Alter und Beanspruchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f6db2b-279c-4b55-88e8-bb1e23026f56",
                                "sense_id": "e02c7f1b-c20d-3c01-93c1-34d0ecba7f5e",
                                "text": "Materialermüdung ist meist ein langwieriger Prozess oder das Ergebnis von Überbeanspruchung."
                            },
                            {
                                "example_id": "e44943a8-768d-48c8-8b4d-8334724fd2f6",
                                "sense_id": "e02c7f1b-c20d-3c01-93c1-34d0ecba7f5e",
                                "text": "„Wenn Risse oder Schwachstellen im Inneren eines Materials auftreten, dann sind diese von außen kaum feststellbar. In solchen Fällen ist es sehr schwierig, Materialermüdung rechtzeitig zu erkennen und darauf zu reagieren.“"
                            },
                            {
                                "example_id": "2e3c559d-8d7f-4d9f-acab-2aa8d9aad323",
                                "sense_id": "e02c7f1b-c20d-3c01-93c1-34d0ecba7f5e",
                                "text": "„Und diese Materialermüdung des Himmels färbt offensichtlich auch auf Lampe ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
