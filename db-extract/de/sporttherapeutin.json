                        "sense_id": "b707f3f5-d796-31fb-befc-cfb08d1b37c2",
                        "entry_id": "347dbc55-8ef4-3b63-ba54-e0c1b859b9ee",
                        "glosses": [
                            "Dame, die sich beruflich mit Sporttherapie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672ef65b-58f2-44e5-a815-86d5f2670498",
                                "sense_id": "b707f3f5-d796-31fb-befc-cfb08d1b37c2",
                                "text": "„Der Kurs ist auch für ungeübte Schwimmer geeignet und wird von einer Sporttherapeutin durchgeführt.“"
                            },
                            {
                                "example_id": "4fde7d17-dc56-44d6-9d3b-b6562f187fbf",
                                "sense_id": "b707f3f5-d796-31fb-befc-cfb08d1b37c2",
                                "text": "„Dabei stehe den Patienten ein Team mit Ärztin, Psychologin, Sozialarbeiterin, Ergotherapeutin, Sporttherapeutin, Gesundheits- und Krankenpflegerinnen sowie Arzthelferinnen zur Seite.“"
                            }
                        ],
