                "senses": [
                    {
                        "sense_id": "dde202ba-eb24-3f4c-93ca-4a5164fd39d3",
                        "entry_id": "c8df8564-7fee-3a96-b226-387987f50eb8",
                        "glosses": [
                            "Wissenschaft rund um das Serum/Blutserum in Diagnostik und Therapie"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a483dd86-b52e-47ee-b589-935b481d2cd5",
                                "sense_id": "dde202ba-eb24-3f4c-93ca-4a5164fd39d3",
                                "text": "„Die Serologie befasst sich unter anderem mit der Entwicklung von spezifischen Nachweisen von Antigenen und Antikörpern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67e2b10c-ce84-37e5-b365-80aeafdfd0b0",
                        "entry_id": "c8df8564-7fee-3a96-b226-387987f50eb8",
                        "glosses": [
                            "Ergebnis einer Blutuntersuchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293cdf2e-3589-40c0-bcfb-85f4a1cd26df",
                                "sense_id": "67e2b10c-ce84-37e5-b365-80aeafdfd0b0",
                                "text": "„Drei Probanden zeigten sowohl am Anfang der Studie als auch am Ende eine positive HSV-1-Serologie und bei den anderen Probanden war die Serologie sowohl am Anfang als auch am Ende der Untersuchung negativ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
