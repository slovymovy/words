                "senses": [
                    {
                        "sense_id": "6174b1bf-f954-31c7-b5ef-bc9f046ac403",
                        "entry_id": "13568f72-86c8-3faa-bf27-18d3057ee39c",
                        "glosses": [
                            "mehrere Teile zu einem zusammengefasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7d6030-f441-4b44-b54c-ae83593d3f0d",
                                "sense_id": "6174b1bf-f954-31c7-b5ef-bc9f046ac403",
                                "text": "„Zusammengenommen brachten es Q3, Q5 und Q7 im Jahr 2013 auf über 400 000 Exemplare, kein Wunder also, dass Audi weiter auf die SUV-Familie setzt.“"
                            },
                            {
                                "example_id": "906b2920-4d20-422c-8f79-b4aa80ca8426",
                                "sense_id": "6174b1bf-f954-31c7-b5ef-bc9f046ac403",
                                "text": "[…] die Bundesregierung [habe] allein im Jahr 2012 Waffenlieferungen an Saudi-Arabien im Wert von 1,24 Milliarden Euro genehmigt. Das sei mehr als in den letzten 13 Jahren zusammengenommen."
