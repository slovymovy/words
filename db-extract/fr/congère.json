                        "cross_references": []
                    },
                    {
                        "translation_id": "aea9c4ae-779d-416e-9d4a-1ff5ccc57174",
                        "source_entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                        "source_sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                        "target_lang_word": "snowdrift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowdrift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                                        "entry_id": "b10e2593-7a7e-3f92-9021-c123a8b39716",
                                        "glosses": [
                                            "A bank of snow accumulated by the wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f332fe38-5c37-42a7-8754-e50ed52d6198",
                                                "sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                                                "text": "In winter the line between Barnard Castle and Kirkby Stephen was regularly blocked by snowdrifts; in 1947, for instance, it was closed for eight weeks and only three weeks before it was finally closed no trains were able to use it for three days because of thick snow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3a97d8a-5317-421f-89cb-6f1f7060024c",
                        "source_entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                        "source_sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                        "target_lang_word": "snow bank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "54316c82-405d-412f-843e-5f6e4fd3f401",
                        "source_entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                        "source_sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                        "target_lang_word": "sneeuwhoop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneeuwhoop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9a549f-3a8e-30dd-96cf-5c18e6152353",
                                        "entry_id": "3bca8bdd-4f32-307d-8104-c75306e84edd",
                                        "glosses": [
                                            "een grote opeenhoping van sneeuw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba5a9ba-ff37-4c04-b9f3-3297356f7195",
                                                "sense_id": "7b9a549f-3a8e-30dd-96cf-5c18e6152353",
                                                "text": "\"Het heeft sinds donderdag alleen maar gesneeuwd. Het is niet voor te stellen hoe hoog zo'n sneeuwhoop wordt. Je kunt nergens heen, je zit vast in het hotel.\""
                                            },
                                            {
                                                "example_id": "76a59e27-16f0-49df-9555-aee69f864425",
                                                "sense_id": "7b9a549f-3a8e-30dd-96cf-5c18e6152353",
                                                "text": "Drie zware tractoren moesten er in de buurtschap Nutter aan te pas komen om een melktankwagen los te trekken. Op het platteland zitten de zware wagens om de haverklap vast in de opgewaaide sneeuwhopen. „Ophalen van de melk gaat heel moeizaam met dit extreme weer.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ba768e5-c849-40f6-9212-bf9aa6f025f0",
                        "source_entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                        "source_sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                        "target_lang_word": "sneeuwopstuiving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3f6ce3ed-aeac-4776-9885-015b994ab47c",
                        "source_entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                        "source_sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                        "target_lang_word": "сугроб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сугроб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "312e0824-6472-3825-83b6-bff2c1221453",
                                        "entry_id": "3633d87f-c223-38bd-8a66-8e38b2c070f2",
                                        "glosses": [
                                            "наметённая ветром куча снега"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d96f0c3-18d8-4506-a2b6-478159f385fa",
                                                "sense_id": "312e0824-6472-3825-83b6-bff2c1221453",
                                                "text": "Изба Игната, его сарай, хлев и колодец были окружены высокими сугробами."
                                            },
                                            {
                                                "example_id": "2cfbd346-e883-4507-b1ba-b64b059d246d",
                                                "sense_id": "312e0824-6472-3825-83b6-bff2c1221453",
                                                "text": "Только белый кружок света из карманного фонарика Деминой шагах в пяти перед ними скакал с сугроба на сугроб и больше сбивал с толку, чем освещал идущим дорогу."
                                            },
                                            {
                                                "example_id": "400a6932-2de7-42cc-8e5c-d7a2d3938e48",
                                                "sense_id": "312e0824-6472-3825-83b6-bff2c1221453",
                                                "text": "Григорий следом за ним тронул коня, тот прыгнул через огромный подтаявший сугроб, лежавший у ворот, провалился передними ногами в снег и, всхрапнув, выправился, перелез через сугроб, заваливший ворота и плетень по самую макушку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb75000d-71b2-3299-89ed-349d18d4e933",
                                        "entry_id": "3633d87f-c223-38bd-8a66-8e38b2c070f2",
                                        "glosses": [
                                            "перен. о большой куче чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f48d246-b70a-4d40-9f12-7c6cf551ad7a",
                                                "sense_id": "cb75000d-71b2-3299-89ed-349d18d4e933",
                                                "text": "Мягко подламывались уличные фонари, растворялись в воздухе киоски и рекламные тумбы — все вокруг потрескивало, тихонько шипело, шелестело, делалось пористым, прозрачным, превращалось в сугробы грязи и пропадало."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
