                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason officiel de la ville représente un <w>éléphant</w> d'argent sur un champ d'azur."
                        },
                        {
                            "text": "L'historien examine avec attention l'<w>éléphant</w> sculpté sur les anciennes armoiries du château."
