{
    "word_family": [
        "broadcaster",
        "broadcasting",
        "rebroadcast"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c09e97a-31bf-3ded-93f5-c1dfbce865d2",
                    "sense_definition": "To transmit a message or signal through radio waves or electronic means.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local radio station will <w>broadcast</w> the interview at noon.",
                            "target_lang_translations": {
                                "ru": "Местная радиостанция <w>передаст</w> интервью в полдень.",
                                "zh": "当地电台将在中午<w>广播</w>这次采访。"
                            }
                        },
                        {
                            "text": "They plan to <w>broadcast</w> the concert live to millions of viewers.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>транслировать</w> концерт в прямом эфире для миллионов зрителей.",
                                "zh": "他们计划向数百万观众<w>转播</w>这场音乐会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "air",
                        "transmit",
                        "send",
                        "televise",
                        "relay"
                    ],
                    "antonyms": [
                        "narrowcast"
                    ],
                    "common_phrases": [
                        "broadcast live",
                        "broadcast news",
                        "broadcast a signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать сообщение или сигнал посредством радиоволн или электронных средств.",
                        "zh": "通过无线电波或电子手段传输信息或信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещать",
                                "target_lang_sense_clarification": "о радио или телевидении"
                            },
                            {
                                "target_lang_word": "транслировать",
                                "target_lang_sense_clarification": "передавать в эфир программу или событие"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "отправлять сигнал или сообщение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广播",
                                "target_lang_sense_clarification": "通过无线电或电视进行传播"
                            },
                            {
                                "target_lang_word": "转播",
                                "target_lang_sense_clarification": "将节目信号传输出去"
                            },
                            {
                                "target_lang_word": "播放",
                                "target_lang_sense_clarification": "通过电子设备发送信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46a511d7-98df-3bc9-81e7-85e394cd5df7",
                    "sense_definition": "To make information known to many people; to spread widely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_spreading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>broadcast</w> my secrets to the entire office.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>разглашай</w> мои секреты всему офису.",
                                "zh": "请不要把我的秘密<w>散布</w>给整个办公室的人。"
                            }
                        },
                        {
                            "text": "He decided to <w>broadcast</w> his complaints on social media.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>распространить</w> свои жалобы в социальных сетях.",
                                "zh": "他决定在社交媒体上<w>宣扬</w>他的不满。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "broadcast intentions",
                        "broadcast emotions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать информацию известной многим людям; широко распространять.",
                        "zh": "使信息广为人知；广泛传播。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространять",
                                "target_lang_sense_clarification": "делать известным широкому кругу"
                            },
                            {
                                "target_lang_word": "разглашать",
                                "target_lang_sense_clarification": "раскрывать тайну или секрет"
                            },
                            {
                                "target_lang_word": "раструбить",
                                "target_lang_sense_clarification": "разг. всем рассказать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "使消息或信息传开"
                            },
                            {
                                "target_lang_word": "宣扬",
                                "target_lang_sense_clarification": "公开地传播信息"
                            },
                            {
                                "target_lang_word": "泄露",
                                "target_lang_sense_clarification": "将秘密公开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7af0751-8522-37d4-8386-99fe9ea9a851",
                    "sense_definition": "To sow seeds by scattering them over a wide area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_sowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers used to <w>broadcast</w> seeds by hand before machines were invented.",
                            "target_lang_translations": {
                                "ru": "Раньше фермеры <w>сеяли</w> семена <w>вразброс</w> вручную, до изобретения машин.",
                                "zh": "在机器发明之前，农民过去常手工<w>撒播</w>种子。"
                            }
                        },
                        {
                            "text": "We <w>broadcast</w> the wildflower mix across the garden border.",
                            "target_lang_translations": {
                                "ru": "Мы <w>разбросали</w> смесь семян полевых цветов вдоль границы сада.",
                                "zh": "我们将野花种子混合物<w>撒播</w>在花园边缘。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "broadcast seeds"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеять семена, разбрасывая их по большой площади.",
                        "zh": "通过在大面积范围内撒播来播种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять вразброс",
                                "target_lang_sense_clarification": "сельхоз. метод посева"
                            },
                            {
                                "target_lang_word": "разбрасывать",
                                "target_lang_sense_clarification": "раскидывать семена вручную"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒播",
                                "target_lang_sense_clarification": "农业上的一种播种方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7e1a378-6c30-38cc-9827-202dac6b956a",
                    "sense_definition": "A radio or television programme or transmission.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We interrupt this <w>broadcast</w> to bring you breaking news.",
                            "target_lang_translations": {
                                "ru": "Мы прерываем эту <w>передачу</w>, чтобы сообщить срочные новости.",
                                "zh": "我们中断本次<w>广播</w>以插播突发新闻。"
                            }
