                                "target_senses": [
                                    {
                                        "sense_id": "714a4d88-6643-3251-b35f-af01115a5f35",
                                        "entry_id": "e74fd6be-52b1-3625-b206-3f5ca708e681",
                                        "glosses": [
                                            "Feeding on excrement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "073bfbc9-5c69-4774-bf82-c6d26ecb884d",
                                                "sense_id": "714a4d88-6643-3251-b35f-af01115a5f35",
                                                "text": "In both civilized society as well as primitive communities coprophagous aphrodisiacs were in common use, urine, faeces of human beings and animals, fluids, intestinal organs."
                                            },
                                            {
                                                "example_id": "d476a51a-412c-487f-bf93-91788cd7bf0f",
                                                "sense_id": "714a4d88-6643-3251-b35f-af01115a5f35",
                                                "text": "Hail the coprophagous and cannibalistic\nLong for the flesh, compelled to eat shit"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
