                "senses": [
                    {
                        "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                        "entry_id": "7edb4834-ef4d-3376-9046-270453ab97ac",
                        "glosses": [
                            "Pertaining to only one direction, e.g.: where all component parts are aligned in the same direction in space."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e41b070d-1d6b-4dd7-9024-f915bad4cb7e",
                                "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                                "text": "[...] a reversible booster was fitted to the trailing bogie; all previous applications on the L.N.E.R. for use in main line traffic had been of unidirectional boosters, […]"
                            },
                            {
                                "example_id": "090e8cf5-d29c-4ffc-a849-b369dd6e6dd0",
                                "sense_id": "d4515b1e-3558-3a0a-aba6-9c09a741093f",
                                "text": "Equally important is the class mailing list, which facilitates two-way communication at a distance. (By contrast, the web page is basically a unidirectional teacher-to-student communication.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "2c61dd6e-54d3-3e0c-b15e-588426543d58",
                        "entry_id": "7edb4834-ef4d-3376-9046-270453ab97ac",
                        "glosses": [
                            "Not subject to change or reversal of direction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
