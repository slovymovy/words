                "senses": [
                    {
                        "sense_id": "44a1fc1f-57dd-3153-b13c-d5425fb11faf",
                        "entry_id": "f5813164-1596-3514-b828-22ce199082a9",
                        "glosses": [
                            "Qualité intrinsèque de ce qui est minuscule."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "6ea57973-3907-4b6c-8e78-b0d4ad3f0999",
                                "sense_id": "44a1fc1f-57dd-3153-b13c-d5425fb11faf",
                                "text": "Quelle magie dans tout ce vivant panorama, décroissant, arrivant pour les personnes et les choses à une minusculité qui semble insaisissable au dessin de la main humaine, à un défilé, au plus loin de la grande plaine, de petits carrosses et de petits canons, si petits qu'ils vous font venir l'idée de ces petits chars auxquels l'antiquité attelait une puce!"
                            },
                            {
                                "example_id": "134ae5c0-1c01-47bb-ad02-23232ea4f66f",
                                "sense_id": "44a1fc1f-57dd-3153-b13c-d5425fb11faf",
                                "text": "Le gnard s'allonge en verdissant, trépignant et tu connais la lyre, les séquelles d'un parpaing dans les burnes malgré la minusculité des tiennes, mon pauvre lapin ?"
                            },
                            {
                                "example_id": "b50e966a-5c39-4502-a570-f02d355c1a4e",
                                "sense_id": "44a1fc1f-57dd-3153-b13c-d5425fb11faf",
                                "text": "S'intéressant à des vies infimes, rurales, Bergounioux et Michon mettent l'obscurité et la « minusculité » de ces vies en tension avec la grande lumière venue de la ville, avec sa civilisation, sa culture."
                            }
                        ]
                    }
