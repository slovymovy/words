                        "zh": [
                            {
                                "target_lang_word": "戴",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "208ccbed-5199-3365-9f03-34716fdd9e63",
                    "sense_definition": "An unincorporated community in Platte County, Missouri, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Dye</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через небольшое поселение <w>Дай</w>.",
                                "zh": "他们在公路旅行中开车穿过了<w>戴</w>这个小社区。"
                            }
                        },
                        {
                            "text": "The history of <w>Dye</w>, Missouri, dates back to the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "История поселения <w>Дай</w>, штат Миссури, восходит к девятнадцатому веку.",
                                "zh": "密苏里州<w>戴</w>的历史可以追溯到十九世纪。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неинкорпорированная община в округе Платт, штат Миссури, США.",
                        "zh": "美国密苏里州普拉特县的一个非建制社区。"
                    },
                    "translations": {
                        "ru": [
                            {
