                        "source_entry_id": "2490fd9b-294e-3ac1-9100-801a82f977dc",
                        "source_sense_id": "258496af-9fd6-3e83-932d-9d04ef4b845e",
                        "source_sense_description": "veraltend, Wirtschaft, Projektmanagement: Anzahl der Tage, an denen eine Person im Monat arbeitet",
                        "target_lang_word": "man-month",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "man-month",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5170cd6f-a46f-32c0-a549-ce2372dd4df7",
                                        "entry_id": "ebfbf944-1e30-3664-b3ac-f3691138cbf6",
                                        "glosses": [
                                            "One person's working time for a month, or the equivalent, used as a measure of how much work or labor is required or consumed to perform some task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "035af04b-6ccb-4338-9298-2482c0d60d8b",
                                                "sense_id": "5170cd6f-a46f-32c0-a549-ce2372dd4df7",
                                                "text": "Holonyms: man-year, person-year"
                                            },
                                            {
                                                "example_id": "f25496f7-eb61-43b1-8bea-f6970fc3be80",
                                                "sense_id": "5170cd6f-a46f-32c0-a549-ce2372dd4df7",
                                                "text": "Meronyms: man-hour, person-hour < man day, person-day"
                                            },
                                            {
                                                "example_id": "a95d3196-afce-4c6a-b6ae-c1e8c6f11daf",
                                                "sense_id": "5170cd6f-a46f-32c0-a549-ce2372dd4df7",
                                                "text": "In project management, there is always another dimbulb who will ask whether the relationship of man-months to calendar months is such that the schedule can be cut in half by doubling the headcount. The standard joke for disabusing this nonsense involves an expedited pregnancy lasting four and a half months instead of nine."
                                            },
                                            {
                                                "example_id": "fb70f238-e5d8-4b3d-8ac9-29a797f9634f",
                                                "sense_id": "5170cd6f-a46f-32c0-a549-ce2372dd4df7",
                                                "text": "Experience seems to indicate that developing such a TeX interface for a new output device takes on the order of one man-month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
