        "nl-extract.jsonl": [
            {
                "entry_id": "160c74f8-eab6-3ba1-b2b8-0e038e813c2b",
                "word": "grienen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cec1c1ac-ae2a-3625-934b-f4c11595507a",
                        "entry_id": "160c74f8-eab6-3ba1-b2b8-0e038e813c2b",
                        "glosses": [
                            "huilen (familiair of minachtend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d440519-3140-45f6-a5f8-5b9fd9db90ee",
                                "sense_id": "cec1c1ac-ae2a-3625-934b-f4c11595507a",
                                "text": "Nathanael Cole zat aan tafel te grienen, een beangstigend gezicht voor de jongste kinderen die het overlijden van hun moeder nog niet half hadden begrepen. Bovendien hadden ze hun vader nooit eerder zien huilen, wat maakte dat ze met bleke gezichtjes bij elkaar groepten en in gespannen afwachting naar hem keken."
                            },
                            {
                                "example_id": "32baaf80-f38c-4fc8-bd10-4e4817912172",
                                "sense_id": "cec1c1ac-ae2a-3625-934b-f4c11595507a",
                                "text": "Om iemand een vriend te noemen, moet je met hem kunnen lachen. En grienen, sinds Toon Hermans. Zelfs is er nog een derde activiteit als criterium, vind ik: zwijgen. Is dat met een ander te verdragen, zonder dat je meteen verlegen of verwoed naar een gespreksonderwerp op zoek gaat, dan zou je er weleens een gevonden kunnen hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15143111-0646-468b-a9e5-26fde1907338",
                        "source_entry_id": "160c74f8-eab6-3ba1-b2b8-0e038e813c2b",
                        "source_sense_id": "cec1c1ac-ae2a-3625-934b-f4c11595507a",
                        "source_sense_description": "grienen",
                        "target_lang_word": "whine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A long-drawn, high-pitched complaining cry or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75ad3b5-ffb4-4676-840a-3e234e3302c2",
                                                "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                                "text": "The 18-year-old [Justin] Bieber can’t quite pull off the “adult” thing just yet: His voice may have dropped a bit since the days of “Baby,” but it still mostly registers as “angelic,” and veers toward a pubescent whine at times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A complaint or criticism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32d766a-2251-4ac2-ac07-9aa9c8e1edf0",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "I need to have a quick whine about my boss before we start talking about the holiday."
                                            },
                                            {
                                                "example_id": "4b6960d0-12dc-4652-8f20-425b4bc8d10c",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "Eighner, in particular, is infamous for his \"what publishers and editors did to poor me\" whines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "815902ea-0e26-3a67-9bd9-c2a3416615a1",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter a high-pitched cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To make a sound resembling such a cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456e12bb-c172-4823-9746-7704041054ff",
                                                "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                                "text": "The jet engines whined at take off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To complain or protest with a whine (compare whinge) or as if with a whine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910dc3d0-88ee-4e29-a544-b03a1f560d3c",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "[S]he was one of your ſoft ſpoken, canting, whining hypocrites, who with a truly jeſuitical art, could wreſt evil out of the moſt inoffenſive thought, word, look or action; […]"
                                            },
                                            {
                                                "example_id": "5eff3abf-3242-46a0-9922-268aebd72fc3",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "Feel awfully about Scott... I always knew he couldn't think—he never could—but he had a marvelous talent and the thing is to use it—not whine in public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To move with a whining sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d12854-613a-49f9-8c07-0e4a69f3d815",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The jet whined into the air."
                                            },
                                            {
                                                "example_id": "e60faf57-7955-49d9-8b3f-a27d6f8f2d47",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The wind whined and moaned through the trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter with the sound of a whine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93e0b4f-ae59-4770-b746-8e00a7adbefc",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "The child whined all his complaints."
                                            },
                                            {
                                                "example_id": "69724124-6bba-4a22-a3fc-cd7c92d4f4de",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "Kelly Queen was whining that the boss made him put on his tie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07841207-824f-4842-988e-764c494efa20",
                        "source_entry_id": "160c74f8-eab6-3ba1-b2b8-0e038e813c2b",
                        "source_sense_id": "cec1c1ac-ae2a-3625-934b-f4c11595507a",
                        "source_sense_description": "grienen",
                        "target_lang_word": "pleurnicher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleurnicher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                        "entry_id": "32add363-1c19-3aa2-a2cd-dde5f97111ba",
                                        "glosses": [
                                            "Affecter de pleurer, avoir un ton larmoyant, essayer de pleurer, comme les enfants qui veulent que l’on s’attendrisse et que l’on leur cède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd775f0-c0bc-4e53-8eff-fbb474db8879",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Un nouveau silence se fit. Mme Sidonie ne pleurnichait plus."
                                            },
                                            {
                                                "example_id": "59343719-df11-43fc-9b80-7147e9bb7e66",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Ça ne sert à rien de pleurnicher comme tu le fais et du moment qu’on va arranger la chose…"
                                            },
                                            {
                                                "example_id": "16c1132e-d513-4768-b91d-2bd52b31f138",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "« Ils viendront solliciter en pleurnichant des dégrèvements d’impôts », me dit un fonctionnaire […] « et ils risquent au baccara, au chemin de fer, des fortunes tous les soirs. »"
                                            },
                                            {
                                                "example_id": "36a711c1-472d-430e-b37b-aa0e80616272",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "La mère, Rita, sosie de Greta Garbo, se gavait de chips et de massepains, se saoulait de Marie Brizard et procrastinait dans son lit. Elle pleurnichait, ruminait sa mauvaise fortune et celle de son mari, […]."
                                            },
                                            {
                                                "example_id": "046b72c7-3f0b-4138-9d66-5a166dafb657",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Enfin un joueur qui ne pleurniche pas et sait qu'il est cher payé pour se faire plaisir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
