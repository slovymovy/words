                "senses": [
                    {
                        "sense_id": "d2b3d9a3-1c11-3db1-af69-af7f8bb734c9",
                        "entry_id": "2a44ffa7-0c65-3a00-8370-74a3cfc6e189",
                        "glosses": [
                            "een reden om iets niet te doen, omdat de handeling niet past bij je gevoelens over wat goed en wat kwaad is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0f2af8-dfd1-425b-b557-fbed7d70f30c",
                                "sense_id": "d2b3d9a3-1c11-3db1-af69-af7f8bb734c9",
                                "text": "De helft van alle internetgebruikers in het VK vindt dat zij eraan verslaafd zijn, blijkt uit onderzoek. Zelf zou ik die vraag ook met ‘ja’ beantwoorden, denk ik. Op de website van BBC III staat een interview met Max Stossel, initiator van Time Well Spent, een beweging voor mensvriendelijke technologie. „Aan de andere kant van jouw computerscherm zitten duizenden professionals die maar één ding doen: je zo verslaafd mogelijk maken”, zegt Stossel, die zelf jarenlang in de industrie werkte, maar last kreeg van gewetensbezwaren."
                            },
                            {
                                "example_id": "56200fee-ea59-462c-9bf4-e7c679c93d17",
                                "sense_id": "d2b3d9a3-1c11-3db1-af69-af7f8bb734c9",
                                "text": "Je moet het verkopen als experiment; zegt Morten. 'De Drion-pil wordt een vrije kwestie. Jouw fractie mag uiteraard tegenstemmen, mocht men dat willen. Voor gewetensbezwaren heb ik begrip."
                            }
                        ]
                    }
