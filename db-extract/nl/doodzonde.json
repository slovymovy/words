                "senses": [
                    {
                        "sense_id": "cde5c92d-8591-3f21-a1b0-5e6156b56297",
                        "entry_id": "5e3bb2cc-7ad4-3f88-a35d-fc471ce6ca7a",
                        "glosses": [
                            "bewuste overtreding van de voornaamste door God gestelde regels"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "c016564f-ceae-41d5-8103-5d4696ad7fb0",
                                "sense_id": "cde5c92d-8591-3f21-a1b0-5e6156b56297",
                                "text": "Door het doen van een doodzonde verliest de mens de heiligmakende genade, de gemeenschap met God, en kan derhalve niet de hemel binnengaan."
                            },
                            {
                                "example_id": "cb8d8ab3-e045-4068-b25c-a1c77ac79b49",
                                "sense_id": "cde5c92d-8591-3f21-a1b0-5e6156b56297",
                                "text": "Eind december stond op deze plaats een stukje over de geschiedenis van het woord godverdomme. Tot grofweg 1900 dacht men dat het uitspreken van die vloek een doodzonde was, want daarmee verdoemde je God."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e369b63-d2a6-32bd-90c2-6cbf47277d88",
                        "entry_id": "5e3bb2cc-7ad4-3f88-a35d-fc471ce6ca7a",
                        "glosses": [
                            "zeer ernstige, onvergeeflijke fout"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dfe35042-f930-4b14-a15d-7bb9b3387169",
                                "sense_id": "4e369b63-d2a6-32bd-90c2-6cbf47277d88",
                                "text": "Liegen in de volksvertegenwoordiging is een politieke doodzonde voor een minister."
                            },
                            {
                                "example_id": "5f0f68a2-e3e7-4315-a2f1-136e3b55cedd",
                                "sense_id": "4e369b63-d2a6-32bd-90c2-6cbf47277d88",
                                "text": "Liegen tegen de rechter is voor een officier van justitie een rechtsstatelijke doodzonde waarop altijd een gepaste reactie nodig is."
                            }
                        ]
                    }
                ],
