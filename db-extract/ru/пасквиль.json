                    },
                    {
                        "translation_id": "8e663d5f-fb5d-4120-aebe-97c9ae3e87af",
                        "source_entry_id": "74d3b6f4-4168-3fc3-ac10-f4f27f37641b",
                        "source_sense_id": "aad613b2-0c86-3ce9-bf51-7fbbbe9718c1",
                        "target_lang_word": "Schmähschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmähschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                        "entry_id": "497b6827-3580-3d15-ab04-39619329e8c9",
                                        "glosses": [
                                            "leidenschaftlich, verächtlich machend gegen eine Sache oder Person verfasstes Schriftstück, bei dem Sachlichkeit in den Hintergrund tritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b99bb1-43bd-470b-bfcf-cf206acd5724",
                                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                                "text": "„Seine Schmähschrift gegen die Menschenrechtlerin Beck macht jedoch eine wichtige Gemeinsamkeit zwischen der alten revolutionären Linken und dem neulinken Milieu deutlich.“"
                                            },
                                            {
                                                "example_id": "c006023f-f78a-474d-8dde-d5045a9957fe",
                                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                                "text": "„Im lateinischen Schrifttum fragt man, wer wohl die Schmähschrift »Invectiva in Ciceronem« geschrieben haben mag.“"
                                            },
                                            {
                                                "example_id": "65acd78d-2b8c-4c37-9b8c-252ea8c6eb59",
                                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                                "text": "„Der Abate Pizzi, Hüter des heiligen Lorbeers der ›Arcadia‹ und Hauptanstifter zur Apotheose der Dichterin, wurde von allen Seiten mit Schmähschriften und bissigen Artikeln überschwemmt und wagte einige Monate nicht auszugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1caf8e1a-beed-4385-b629-b86cabe5e03f",
                        "source_entry_id": "74d3b6f4-4168-3fc3-ac10-f4f27f37641b",
                        "source_sense_id": "aad613b2-0c86-3ce9-bf51-7fbbbe9718c1",
                        "target_lang_word": "libelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c41c8b2b-8d84-3a81-ae28-053bfbf50100",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Placet, petit écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f5c233-17b6-4da3-8e32-5a55a832f410",
                                                "sense_id": "c41c8b2b-8d84-3a81-ae28-053bfbf50100",
                                                "text": "Faiseur de libelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Acte signifié par écrit."
                                        ],
                                        "tags": [
                                            "Droit romain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f6aed5b-8462-492c-b419-a28b5d893727",
                                                "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                                "text": "Libelle de divorce, acte par lequel un époux annonçait à l'autre qu'il divorçait."
                                            },
                                            {
                                                "example_id": "b070a1a2-320b-44b0-9770-e8685bc5bf64",
                                                "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                                "text": "Libelle de proclamation, action intentée en justice pour obtenir la réparation d'un dommage quelconque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Écrit, ordinairement court, injurieux, diffamatoire ou calomnieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc644cb4-f5b1-4b9e-b68b-7f5298f8a08b",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Si je me présente ici, c'est pour ne pas manquer une occasion solennelle d'éclaircir des faits, que mon profond mépris pour les libelles, et mon insouciance trop grande pour les bruits calomnieux, ne m'ont jamais permis d'attaquer hors de cette Assemblée."
                                            },
                                            {
                                                "example_id": "86f6da99-7fce-40ba-8ece-ecb066f92dda",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Que l'on veuille bien ne pas considérer ce livre comme un libelle à l'adresse du Maroc. Personnellement, j'aime ce pays tel que je l'ai connu et je lui suis reconnaissant de la vie nomade et libre que j'y ai menée pendant bien des mois."
                                            },
                                            {
                                                "example_id": "8326f5be-dd01-4ce5-a1b8-3fff7e30ac16",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Les chrétiens s’efforcèrent d’agir sur l’opinion publique en diffusant une série de libelles, […], où les juifs étaient dépeints sous les traits les plus odieux."
                                            }
                                        ]
                                    }
                                ]
                            },
