                "senses": [
                    {
                        "sense_id": "d522f243-6d38-311f-8187-2d7485061abb",
                        "entry_id": "5174288d-8c6c-3999-8b01-2fb33c5f883f",
                        "glosses": [
                            "Sprachgruppe von Dialekten des Inuit (auch Inuktitut), die im nördlichen Alaska gesprochen wird, in lateinischer Schrift geschrieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b5fc84-f8db-4b03-ad0e-d50478ac8560",
                                "sense_id": "d522f243-6d38-311f-8187-2d7485061abb",
                                "text": "Das Inupiak ist Teil des Inuit-Dialektkontinuums."
                            },
                            {
                                "example_id": "ea70fe77-3fcd-490b-9738-bb2e821be37c",
                                "sense_id": "d522f243-6d38-311f-8187-2d7485061abb",
                                "text": "„Es kommt ja auch nicht selten vor, daß die Sprachwissenschaft eines tages zu dem Befund kommt, daß zwei oder drei Idiome, die man bisher als Mundarten einer einzigen Sprache betrachtet hatte, eigentlich \"selbständige Sprachen\" seien; ein bekanntes Beispiel bildet die Aufteilung des bis vor kurzem als eine Sprache betrachteten Eskimo in die zwei Sprachen Inupiak und Jupik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
