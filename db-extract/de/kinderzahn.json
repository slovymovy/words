                "senses": [
                    {
                        "sense_id": "20f2aff8-ca86-3b2a-8137-8f693de3e0c6",
                        "entry_id": "d867e464-fc0b-339b-be4b-40d7d6cd0027",
                        "glosses": [
                            "Zahn eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6beb93f4-b106-4a95-91aa-3284e997d461",
                                "sense_id": "20f2aff8-ca86-3b2a-8137-8f693de3e0c6",
                                "text": "„In einem Fach lagen ein paar Münzen, in dem anderen ein weißer Kinderzahn, den Fióla ihr geschenkt hatte, und der Ring, den ihr Vater ihr 1839 als Konfirmationsgeschenk geschickt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f323d98-a6fb-4bac-8211-244ee0c80b00",
                        "source_entry_id": "d867e464-fc0b-339b-be4b-40d7d6cd0027",
                        "source_sense_id": "20f2aff8-ca86-3b2a-8137-8f693de3e0c6",
                        "source_sense_description": "Zahn eines Kindes",
                        "target_lang_word": "dent d'enfant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3f04313a-d5a5-48cb-a513-836698467410",
                        "source_entry_id": "d867e464-fc0b-339b-be4b-40d7d6cd0027",
                        "source_sense_id": "20f2aff8-ca86-3b2a-8137-8f693de3e0c6",
                        "source_sense_description": "Zahn eines Kindes",
                        "target_lang_word": "quenotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quenotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7107af5e-4614-3cc5-a14e-e8f74b07f507",
                                        "entry_id": "167ab814-5906-3172-9773-cf4095b188bb",
                                        "glosses": [
                                            "Dent d’un enfant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b9689d-f657-439d-8532-757cbd25d9b4",
                                                "sense_id": "7107af5e-4614-3cc5-a14e-e8f74b07f507",
                                                "text": "Voyons, sois donc gentil, ne t’ébrèche pas comme ça tes quenottes en les grinçant."
                                            },
                                            {
                                                "example_id": "ffe4ae6c-ab55-4724-93aa-0db634d73a5e",
                                                "sense_id": "7107af5e-4614-3cc5-a14e-e8f74b07f507",
                                                "text": "Avec ses dix-huit mois il faisait mentir le dicton : « vingt mois, vingt dents », car sa vingtième quenotte venait de percer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                        "entry_id": "167ab814-5906-3172-9773-cf4095b188bb",
                                        "glosses": [
                                            "Dent d’un adolescent, d’un adulte, ou (plus rarement) d’un animal."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f785060a-e32f-4ba0-ad43-5b71edf87b22",
                                                "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                                "text": "Il vous reste encore quelques bribes de l’héritage paternel : malgré leurs diaboliques quenottes, ni vos maîtresses ni vos amis n’ont pu dévorer tout."
                                            },
                                            {
                                                "example_id": "125032a0-fad9-4ee8-9d37-ee144d4ee345",
                                                "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                                "text": "Elle avait seize ans. Des yeux d’écureuil ! des quenottes de souris ! des cheveux, aile de corbeau !"
                                            },
                                            {
                                                "example_id": "ee246137-2edd-490f-8d21-211a0355542d",
                                                "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                                "text": "C’est un fier imbécile, lui dit Titine, bête et riche ; aiguise tes quenottes, ma fille, et mords à belles dents."
                                            },
                                            {
                                                "example_id": "70e651f8-ba0a-4732-808e-37037cd7b101",
                                                "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                                "text": "De vrai, vous êtes fraîche à l'égal d’une rose blanche : vos quenottes ont la luisance des perles de la mer profonde, et vos yeux sont gris-bleu comme les pennes des tourterelles."
                                            },
                                            {
                                                "example_id": "3aed2af7-04cc-420a-b016-1dcbc46a865e",
                                                "sense_id": "9eaba346-aac9-39ab-b12a-3bab0027d587",
                                                "text": "Du bout de ses jolies quenottes rieuses, elle détaille les chansons populaires du temps jadis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97756fc6-1cb7-428a-b110-be4c45e3162d",
                        "source_entry_id": "d867e464-fc0b-339b-be4b-40d7d6cd0027",
                        "source_sense_id": "20f2aff8-ca86-3b2a-8137-8f693de3e0c6",
                        "source_sense_description": "Zahn eines Kindes",
                        "target_lang_word": "dent de lait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dent de lait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c625268-83e7-394e-b7d4-23b6ae91ecec",
                                        "entry_id": "d28ba2ac-647c-3aca-9fab-04ed56fc7aff",
                                        "glosses": [
                                            "Une des premières dents, provisoires, du jeune animal ou de l’enfant qui, dans le cas de l’enfant, tombe vers l’âge de sept ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c42954-c62d-4260-9fd0-5f77795a8bd0",
                                                "sense_id": "6c625268-83e7-394e-b7d4-23b6ae91ecec",
                                                "text": "Les jeunes animaux portent des dents de lait qui tombent au cours de leurs premières années, et qui sont remplacées par les dents définitives."
                                            },
                                            {
                                                "example_id": "8aafa43c-b391-4ef9-bc39-d941fb57e782",
                                                "sense_id": "6c625268-83e7-394e-b7d4-23b6ae91ecec",
                                                "text": "Les photos, les lettres, les dessins, les dents de lait, les cadeaux de fête des mères, les livres, les vêtements, les babioles, les gadgets, les papiers, les journaux, les cahiers, les textes dactylographiés, Lucile avait tout gardé."
                                            },
                                            {
                                                "example_id": "12312f31-46e5-4c52-8f08-c9ddb3d1a670",
                                                "sense_id": "6c625268-83e7-394e-b7d4-23b6ae91ecec",
                                                "text": "Le trou - sa bouche -, à l’intérieur duquel il manque une prémolaire inférieure, probablement une dent de lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
