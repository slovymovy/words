                    {
                        "sense_id": "3c936107-06bf-3bd0-ad0c-35e260e577bf",
                        "entry_id": "03bf93ec-cf25-365e-ba16-360f4df060db",
                        "glosses": [
                            "The union of different ingredients in one mass; mixture; combination; synthesis."
                        ],
                        "tags": [
                            "countable",
