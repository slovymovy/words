                                        "sense_id": "724a1983-851b-3dd4-8e73-8d0c073d7ba6",
                                        "entry_id": "39216d16-b467-342e-94ac-44e0393a5d82",
                                        "glosses": [
                                            "masseloses Elementarteilchen ohne elektrische Ladung"
                                        ],
                                        "tags": [
                                            "Kernphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "331ad9b5-2d4c-478e-9784-796d2081de75",
                                                "sense_id": "724a1983-851b-3dd4-8e73-8d0c073d7ba6",
                                                "text": "Das Neutrino hat einen Spin von hbar /2."
                                            }
