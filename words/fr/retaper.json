            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d902ad7a-5e82-35e5-8c79-4a33603fe96a",
                    "sense_definition": "Remettre en état, réparer ou rénover quelque chose de vieux ou d'abîmé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reparer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont acheté une vieille grange pour la <w>retaper</w> entièrement pendant leurs vacances."
                        },
                        {
                            "text": "Mon frère adore <w>retaper</w> des meubles anciens trouvés dans les brocantes."
                        }
                    ],
                    "synonyms": [
                        "rénover",
                        "restaurer",
                        "rafistoler"
                    ],
                    "antonyms": [
                        "détériorer",
                        "abîmer"
                    ],
                    "common_phrases": [
                        "retaper une maison",
                        "retaper des meubles"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "55dec372-ad07-31e2-9091-32a4cb363d58",
                    "sense_definition": "Frapper de nouveau, donner un nouveau coup.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "frapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne répondait, alors il a décidé de <w>retaper</w> vigoureusement à la porte."
                        },
                        {
                            "text": "Tu dois <w>retaper</w> sur ce clou pour qu'il s'enfonce complètement dans le bois."
                        }
                    ],
                    "synonyms": [
                        "refrapper"
                    ],
                    "common_phrases": [
                        "retaper à la porte"
                    ]
                },
                {
                    "sense_id": "4c485ea5-e169-3258-8739-70b304d38507",
                    "sense_definition": "Rétablir la santé, les forces ou le moral de quelqu'un ; se remettre en forme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guerir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue grippe, il a pris une semaine de repos pour se <w>retaper</w>."
                        },
                        {
                            "text": "Un bon bol de soupe chaude va te <w>retaper</w> immédiatement après cette marche dans le froid."
                        }
                    ],
                    "synonyms": [
                        "requinquer",
                        "revigorer"
                    ],
                    "antonyms": [
                        "épuiser",
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "bien se retaper",
                        "se retaper une santé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "3d55876e-c4d9-3689-984b-31e6c2aed6ae",
                    "sense_definition": "Redoubler une année scolaire ou une classe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "scolaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses résultats étaient insuffisants, il a donc dû <w>retaper</w> son année de terminale."
                        },
                        {
                            "text": "Si tu ne travailles pas plus sérieusement au second trimestre, tu risques de <w>retaper</w>."
                        }
                    ],
                    "synonyms": [
                        "redoubler"
                    ],
                    "common_phrases": [
                        "retaper son année",
                        "retaper une classe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "e9bd3078-2493-31a0-88a1-7ecf49685b50",
                    "sense_definition": "Taper de nouveau un texte à la machine ou à l'ordinateur ; ressaisir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dactylographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le document a été perdu, la secrétaire doit tout <w>retaper</w> depuis le début."
                        },
                        {
                            "text": "J'ai dû <w>retaper</w> ces notes manuscrites pour pouvoir les envoyer par courriel."
                        }
                    ],
                    "synonyms": [
                        "ressaisir"
                    ],
                    "common_phrases": [
                        "retaper un texte",
                        "retaper un document"
                    ]
                }
            ]
        }
