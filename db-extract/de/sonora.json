                                "example_id": "ced7d3f0-f6b3-493f-b966-ce885722ba21",
                                "sense_id": "5f1fa9cf-3fc6-3248-96be-d70d91bf9c53",
                                "text": "„Im Bundesstaat Sonora leben inzwischen ungefähr vierzehntausend französische Kolonisten.“"
                            },
                            {
                                "example_id": "30700535-7875-438b-8b31-6d45df5268c5",
                                "sense_id": "5f1fa9cf-3fc6-3248-96be-d70d91bf9c53",
                                "text": "„Sie schleudern das Kokain aus der Wüste von Sonora über die Absperrungen in die Wüste von Arizona, mit Katapulten, die den Maschinen Leonardo da Vincis nachempfunden sind.“"
                            }
