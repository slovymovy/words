                    "frequency": "Middle",
                    "semantic_group_id": "bestimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie hat in der Pflege ihre wahre <w>Berufung</w> gefunden und arbeitet dort sehr gern."
                        },
                        {
                            "text": "Für viele Künstler ist das Malen keine bloße Arbeit, sondern eine echte <w>Berufung</w>."
                        }
                    ],
                    "synonyms": [
                        "Bestimmung"
                    ],
                    "antonyms": [],
                    "common_phrases": [
