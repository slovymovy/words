                ],
                "senses": [
                    {
                        "sense_id": "8b3936d4-ee63-390b-a433-7ac9ac8c6822",
                        "entry_id": "adad6b59-5bff-39c6-8c7e-455d87fff931",
                        "glosses": [
                            "Qui subit des bouleversements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731264de-6070-4c85-a63c-60f54179930f",
                                "sense_id": "8b3936d4-ee63-390b-a433-7ac9ac8c6822",
                                "text": "À travers un monde bouleversé et chaotique, à travers une civilisation secouée par les derniers tressauts de l’agonie, notre faubourien de Londres retrouva son Edna."
                            }
                        ]
                    },
                    {
                        "sense_id": "386bf047-1a0c-3401-8cc2-897ce01302e3",
                        "entry_id": "adad6b59-5bff-39c6-8c7e-455d87fff931",
                        "glosses": [
                            "Qui est sujet à des bouleversements de l'âme, à l'émotion."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3d37346f-dd6f-47d2-b8aa-bdf82bf6a2a1",
                                "sense_id": "386bf047-1a0c-3401-8cc2-897ce01302e3",
                                "text": "« Singulière affaire, assurément », se disait-elle. Elle en fut si bouleversée qu'elle ne devait même pas s’apercevoir que le coq avait déjà annoncé l'aube et que l'Orient peu à peu s'éclairait."
                            },
                            {
                                "example_id": "c5f5b00b-10d6-4f23-bc0d-61def67c9593",
                                "sense_id": "386bf047-1a0c-3401-8cc2-897ce01302e3",
                                "text": "La résilience est envisagée comme un processus multifactoriel engageant tous les sujets qui vont être en relation avec la personne bouleversée. Chacun joue un rôle non substituable et il est important de travailler ensemble et de penser l’accompagnement des personnes psychotraumatisées de façon individuelle et collective. Dans cette idée, l’attention portée aux blessés psychiques devrait dépendre de la responsabilité de chacun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c45b55d3-71e3-49f0-9967-f5686d17fc59",
                        "source_entry_id": "adad6b59-5bff-39c6-8c7e-455d87fff931",
                        "target_lang_word": "upset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
