                "senses": [
                    {
                        "sense_id": "376ef447-1258-3a0a-8f6e-788f38a809a9",
                        "entry_id": "7b9a1cd5-a663-33d4-bc09-d2088ce979b3",
                        "glosses": [
                            "религиозно-мистическое учение, выделившееся из теософии, основанное в 1912 Рудольфом Штейнером с целью открыть широкому кругу методы саморазвития и духовного познания с помощью мышления человека"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93d11fb3-1414-4877-ad43-5b5e83eda9d5",
                        "source_entry_id": "7b9a1cd5-a663-33d4-bc09-d2088ce979b3",
                        "source_sense_id": "376ef447-1258-3a0a-8f6e-788f38a809a9",
                        "target_lang_word": "anthroposophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthroposophy",
