                        "examples": [
                            {
                                "example_id": "85485aa4-948f-4314-8eac-affe1b6c1f74",
                                "sense_id": "bcf13acb-12cd-3916-b5f8-32f80a4cdf63",
                                "text": "Blijkbaar was de herkomst van de tiara - die behoorde tot de koninklijke collectie - onvoldoende duidelijk. De wens van Meghan stootte dan ook op een ‘njet’ van de vorstin."
                            },
                            {
                                "example_id": "d6eb5da5-ad4e-4b95-9f0c-077a35e6d02b",
                                "sense_id": "bcf13acb-12cd-3916-b5f8-32f80a4cdf63",
                                "text": "Hij kreeg in een gesprek met de burgemeester en een wethouder een keihard ‘njet’ te horen. ,,Er mag niets. Er wordt niet meegedacht met ons.’'"
                            }
                        ]
                    }
