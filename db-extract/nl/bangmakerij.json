                                        "entry_id": "7ec0f7dd-b984-3c75-9eed-1c40df9cb87a",
                                        "glosses": [
                                            "The act of making timid or fearful or of deterring by threats; the state of being intimidated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c93b88e-3e55-4133-a00d-cf49d79bbbb3",
                                                "sense_id": "449f5091-a1f6-355e-adc8-4e3539af6432",
                                                "text": "It broadly includes all the people with specific recognition for none, and the highest consecration we can make today is a committal of the Republican party to that saving constitutionalism which contemplates all America as one people and holds just government free from influence on the one hand, and unmoved by intimidation on the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d418ac-9859-42a0-92e4-9396c8364957",
                        "source_entry_id": "e2e538cb-7a36-3319-86e0-d354f2414346",
                        "source_sense_id": "c36edb9a-4cd0-3173-81a3-64e18c5e17bb",
                        "target_lang_word": "intimidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intimidation",
