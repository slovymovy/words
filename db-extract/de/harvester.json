                "senses": [
                    {
                        "sense_id": "53fd4984-c5b1-3325-b03e-e540d77d9c8d",
                        "entry_id": "589327c0-7ac5-3fa1-b9f4-b9b0cb154c3e",
                        "glosses": [
                            "Maschine zum automatisierten Fällen und Zerkleinern von Bäumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a710d11-4224-410f-a7a6-6cafdb2d09c8",
                                "sense_id": "53fd4984-c5b1-3325-b03e-e540d77d9c8d",
                                "text": "Mithilfe von Harvestern konnten Hunderte Bäume in kurzer Zeit gefällt, entastet, zersägt und abtransportiert werden."
                            },
                            {
                                "example_id": "a41699e1-8e57-404c-ae2b-78797e31bef7",
                                "sense_id": "53fd4984-c5b1-3325-b03e-e540d77d9c8d",
                                "text": "„Im Wald der Gemeinde Gründau hat der Harvester, eine Erntemaschine für Holz, in den vergangenen zwei Wochen ganze Arbeit geleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cb77ece-cd37-400e-9f8f-1e4823367de9",
                        "source_entry_id": "589327c0-7ac5-3fa1-b9f4-b9b0cb154c3e",
                        "source_sense_id": "53fd4984-c5b1-3325-b03e-e540d77d9c8d",
                        "source_sense_description": "Maschine zum automatisierten Fällen und Zerkleinern von Bäumen",
                        "target_lang_word": "abatteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abatteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "704f1e9c-a18f-38f6-a815-57778ff93d80",
                                        "entry_id": "d80faa6d-3759-3965-a3ad-373ad3e0b503",
                                        "glosses": [
                                            "Celle qui abat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13433f4e-df2d-457e-8cc6-99e817c75d85",
                                                "sense_id": "704f1e9c-a18f-38f6-a815-57778ff93d80",
                                                "text": "Dans cette région montagneuse pullulent des abatteuses. Elles travaillent aussi laborieusement que les hommes à l'édification socialiste de la patrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6994d250-f5f6-394d-a6fd-817f47f218db",
                                        "entry_id": "d80faa6d-3759-3965-a3ad-373ad3e0b503",
                                        "glosses": [
                                            "Celle qui travaille beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ee419e-f5f7-4f4c-83db-b6f77cdf926f",
                                                "sense_id": "6994d250-f5f6-394d-a6fd-817f47f218db",
                                                "text": "La grand'servante louée ce jour-là même était une robuste et fraîche paysanne de Prétieux assez jolie et rude abatteuse d'ouvrage aussi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0beca21f-3f10-3027-a884-59f3824e301f",
                                        "entry_id": "d80faa6d-3759-3965-a3ad-373ad3e0b503",
                                        "glosses": [
                                            "Prostituée qui enchaîne les passes."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb0e6253-bff8-3a33-972b-7be87eaa51b6",
                                        "entry_id": "d80faa6d-3759-3965-a3ad-373ad3e0b503",
                                        "glosses": [
                                            "Machine forestière pour abattre des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1731d27-2153-4449-9bb0-ce405d1d9ba6",
                                                "sense_id": "cb0e6253-bff8-3a33-972b-7be87eaa51b6",
                                                "text": "Le parallèle entre l'évolution de la forêt et le développement des hommes en France met en évidence que l'existence de la tronçonneuse datant de près de soixante ans et l'apparition de l'abatteuse depuis une vingtaine d'années sont très récentes à l'échelle des évolutions forestières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
