                ],
                "senses": [
                    {
                        "sense_id": "456f95f9-d54a-3044-8e69-d43144227f59",
                        "entry_id": "8d5a33b6-6a04-38cf-8237-cf5441763fd2",
                        "glosses": [
                            "keine Lippen habend, ohne Lippen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8510fc80-1488-4f01-a1b0-8ad37b7c87b6",
                                "sense_id": "456f95f9-d54a-3044-8e69-d43144227f59",
                                "text": "„Die Atmosphäre der Gruft konnte einen schwermütig machen, ja, zur Verzweiflung bringen – die enorme Menge sterblicher Überreste, die Einsamkeit, die jeden Gedanken in eine unerfreuliche Richtung lenkte, und das idiotische Grinsen lippenloser Münder und das Starren leerer Augenhöhlen und der Klauengriff dünner weißer Finger, all das zerrte an seinen Nerven.“"
                            },
                            {
                                "example_id": "29b22b9a-e2a9-4d40-b5a7-d34cf022f77b",
                                "sense_id": "456f95f9-d54a-3044-8e69-d43144227f59",
                                "text": "„Der alte Mann trat mit großen Schritten weiter auf mich zu, keuchend und schnaufend, den Mund zu einer lippenlosen Grimasse verzerrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
