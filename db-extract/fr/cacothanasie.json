                        "glosses": [
                            "Mort dans la souffrance, l'angoisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b968079-d40a-4fd2-bfd4-ef53b9d870bf",
                                "sense_id": "73f3ea75-79e9-39e5-be94-a770d280f38c",
                                "text": "La cacothanasie est l'inverse de l'euthanasie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea16b9f5-128e-3b82-b6a4-22b53cb6cb06",
                        "entry_id": "ba4ced92-75a6-3606-b471-70f1fb7094f1",
                        "glosses": [
                            "Acharnement thérapeutique, fait d'essayer tous les traitements même s'il n'y a aucune chance de guérison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54255eba-0ac0-4bc8-b2fa-345f05d1f56a",
                                "sense_id": "ea16b9f5-128e-3b82-b6a4-22b53cb6cb06",
                                "text": "Le terme ainsi défini est celui de « cacothanasie », dont la disparition n’est pas à regretter."
                            },
                            {
                                "example_id": "4cc72a74-f244-4981-96ed-bab1d22ae9ba",
                                "sense_id": "ea16b9f5-128e-3b82-b6a4-22b53cb6cb06",
                                "text": "Le débat est souvent biaisé ; l’alternative n’est pas entre une dysthanasie, mort douloureuse & une euthanasie, mort adoucie, mais entre une cacothanasie, mort rendue pénible par l’acharnement thérapeutique & non par la maladie même & une mort, au risque de choquer, je dirais bio, à la maison entouré des siens."
                            }
                        ]
                    }
