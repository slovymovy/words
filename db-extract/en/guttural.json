                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe8b44db-1006-3be0-8df9-5e2a9247d977",
                        "entry_id": "8241f57a-b8e7-3c73-89c1-8ca6d2c6d1a5",
                        "glosses": [
                            "Sounding harsh and throaty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af4bebff-1fc7-44bd-87db-a15867f81a63",
                                "sense_id": "fe8b44db-1006-3be0-8df9-5e2a9247d977",
                                "text": "Arabic is considered a very guttural language, with many harsh consonants."
                            },
                            {
                                "example_id": "a9c26339-03de-40f2-9e43-e8625dff39e3",
                                "sense_id": "fe8b44db-1006-3be0-8df9-5e2a9247d977",
                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a64f435-4de3-3075-a8ae-9c6e2080bda6",
                        "entry_id": "8241f57a-b8e7-3c73-89c1-8ca6d2c6d1a5",
                        "glosses": [
                            "having a place of articulation towards the back of the mouth; in modern use, uvular, pharyngeal, or glottal; in earlier or non-technical use, also including velar."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "91a12214-8bda-3536-9edb-8d3f8c56a606",
                        "entry_id": "8241f57a-b8e7-3c73-89c1-8ca6d2c6d1a5",
                        "glosses": [
                            "Of, relating to, or connected to the throat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fbfc454-7a98-48b8-95fa-6cac46dd392f",
                                "sense_id": "91a12214-8bda-3536-9edb-8d3f8c56a606",
                                "text": "guttural duct of the ear; guttural pouch infection"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de2171e5-f6a7-4441-a60a-ba00cd06f7c4",
                        "source_entry_id": "8241f57a-b8e7-3c73-89c1-8ca6d2c6d1a5",
                        "source_sense_description": "sounding harsh and throaty",
                        "target_lang_word": "guttural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guttural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d32078a2-91c2-3fa9-85ab-f39fa4bb64c0",
                                        "entry_id": "fb0da5cb-8955-3593-9236-a5fcd5a8d13a",
                                        "glosses": [
                                            "Qui appartient au gosier."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13538ff1-87a8-48b9-adb3-bc252a90dca6",
                                                "sense_id": "d32078a2-91c2-3fa9-85ab-f39fa4bb64c0",
                                                "text": "Cet os pair, insymétrique, aplati d’un côté à l’autre, et recourbé en arc d’avant en arrière, occupe la partie postérieure des fosses nasales, en circonscrit l’ouverture postérieure ou gutturale, et termine la voute osseuse du palais."
                                            },
                                            {
                                                "example_id": "adcdcb2e-79c6-45ac-aa13-1ef5bbcf9b25",
                                                "sense_id": "d32078a2-91c2-3fa9-85ab-f39fa4bb64c0",
                                                "text": "L’empyème des poches gutturales signifie la présence de pus dans les poches gutturales. Cela est dû à la présence de bactéries dans les poches gutturales et c’est d’ailleurs souvent la conséquence d’une gourme (infection due à streptococcus equi var equi)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                        "entry_id": "fb0da5cb-8955-3593-9236-a5fcd5a8d13a",
                                        "glosses": [
                                            "Qui vient du gosier ; qui se prononce du fond du gosier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65fb280-105e-4c1a-b5f0-cbc6f787203c",
                                                "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                                "text": "L’aubergiste, familiarisé sans doute avec les interrogations gutturales de ces bateliers, sortit précipitamment, et revint bientôt."
                                            },
                                            {
                                                "example_id": "3d64d4ab-d2df-4d83-bebb-9972e80c318e",
                                                "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                                "text": "Monsieur, dit-il d’une voix douce qui n’eut plus de convulsions gutturales comme précédemment mais qui néanmoins accusait encore un tremblement intérieur, je vais vous paraître bizarre."
                                            },
                                            {
                                                "example_id": "17fed449-44bf-4578-be5e-f677810f40d1",
                                                "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            },
                                            {
                                                "example_id": "221bb81d-075f-491d-b52c-8f9913057b6d",
                                                "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                                "text": "Foirauaran : quatre syllabes gutturales indissociées roulant au fond du gosier normand."
                                            },
                                            {
                                                "example_id": "0e72fb5d-d321-4914-9717-bd45a85a23ad",
                                                "sense_id": "5739e585-f5e7-3e2b-8c02-8b7d708336ec",
                                                "text": "Quelques ordres fusèrent […]. Aboyés avec la rudesse gutturale d’un gosier poméranien, ils eurent pour effet immédiat de déloger un groupe de feldgraus agglutinés devant la flamme dansante d’un brasero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
