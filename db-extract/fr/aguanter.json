                "senses": [
                    {
                        "sense_id": "c644f46e-4c4a-3710-bd10-84ea8d56e603",
                        "entry_id": "a48d682c-62bd-3e9a-8aec-9dddaf667904",
                        "glosses": [
                            "Se positionner pour attendre la charge du taureau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f20f39-239c-43c4-8cdd-91be554331b5",
                                "sense_id": "c644f46e-4c4a-3710-bd10-84ea8d56e603",
                                "text": "Bien sûr, on dit qu’il faut alors « aguanter » deux ou trois de ces charges dolentes, et qu’après, cela va mieux."
                            },
                            {
                                "example_id": "aa581327-017b-47b2-983d-a9c21b4abd01",
                                "sense_id": "c644f46e-4c4a-3710-bd10-84ea8d56e603",
                                "text": "Au dernier tiers, Paco Ureña dut aguanter les derrotes de son adversaire pour composer une faena sérieuse, toute de volonté et de courage."
                            },
                            {
                                "example_id": "03b5f202-de19-4988-9abb-d896b7d2734b",
                                "sense_id": "c644f46e-4c4a-3710-bd10-84ea8d56e603",
                                "text": "Quelques minutes de retard à cause d’antis proférant des insultes aux aficionados qui aujourd’hui savent aguanter ce genre d'énergumènes !"
                            },
                            {
                                "example_id": "b6eecccd-18a8-45ff-a80d-400db530604e",
                                "sense_id": "c644f46e-4c4a-3710-bd10-84ea8d56e603",
                                "text": "Le proc aussi est dans le coup. Ils seront deux pour aguanter."
                            }
                        ]
                    }
                ],
