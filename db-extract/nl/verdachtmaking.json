                "senses": [
                    {
                        "sense_id": "a15643e7-1002-3f89-8a66-ace1a4c16d45",
                        "entry_id": "234e12ce-117f-3c78-9369-782064c8742b",
                        "glosses": [
                            "suggereren dat iemand iets verkeerd gedaan heeft zonder er bewijzen of een rechterlijke veroordeling is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35bb3dea-8c85-43ba-b7e2-16ac4d9f790d",
                                "sense_id": "a15643e7-1002-3f89-8a66-ace1a4c16d45",
                                "text": "Robert Mueller (73) is opgejaagd wild. Elke dag zijn er verdachtmakingen. Over zijn verleden, zijn onderzoek, zijn medewerkers. Elk uur wordt die ene vraag gesteld: wanneer hij het veld moet ruimen. Zijn tegenstanders creëren daarmee het beeld dat Mueller er een potje van maakt en Trump maar één besluit kan nemen: hem ontslaan."
                            },
                            {
                                "example_id": "f103ee7f-0369-4d5c-82fd-8df8bdc6cfc1",
                                "sense_id": "a15643e7-1002-3f89-8a66-ace1a4c16d45",
                                "text": "Sky is het middelpunt van een parlementair onderzoek naar dopinggebruik in het Britse wielrennen. De verdachtmakingen liegen er niet om. 'Hoe weten we dat je te vertrouwen bent, Dave?', is de prangende vraag aan teambaas Brailsford in Düsseldorf. De kalende Brit steekt zijn borst vooruit. 'We doen alles op de juiste manier', verzekert hij. 'Zo hebben we dat altijd gedaan en zo zullen we dat blijven doen.'"
                            }
                        ]
                    }
                ],
