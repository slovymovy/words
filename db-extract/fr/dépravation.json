                                "target_senses": [
                                    {
                                        "sense_id": "10eadace-9608-3920-a0de-52e0911b087f",
                                        "entry_id": "c5de5260-ed54-3c31-98b8-9873de3c2359",
                                        "glosses": [
                                            "Wertminderung"
                                        ],
                                        "tags": [
                                            "Münzwesen",
                                            "Numismatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e553617b-e7ea-4aed-b28f-027b66977a25",
                                                "sense_id": "10eadace-9608-3920-a0de-52e0911b087f",
                                                "text": "„Bei dem Uebergange zu einer ganz neuen Münzrechnung etwa von Gold zu Silber musste natürlich Umrechnung der Ziffern eintreten. Ebenso aber konnte die Umrechnung angemessen erscheinen bei starker Depravation einer Münze und bei Konkurrenz vollwichtiger und depravierter Münzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85478866-495e-37b6-8caf-96c4f30976f3",
                                        "entry_id": "c5de5260-ed54-3c31-98b8-9873de3c2359",
                                        "glosses": [
                                            "Entartung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "625b7880-e222-48de-8bba-265437e7f390",
                                                "sense_id": "85478866-495e-37b6-8caf-96c4f30976f3",
                                                "text": "„Schrappe charakterisiert die Depravation als Persönlichkeitsveränderung, die durch Egozentrismus, Verwahrlosung, Haltlosigkeit und Unzuverlässigkeit, Lügenhaftigkeit, Bindungsverluste mit Zerbrechen familiärer und persönlicher Bande und sozialen Abstieg bis zur Kriminalität gekennzeichnet ist.“"
                                            },
                                            {
                                                "example_id": "aeda68f8-8c33-4e26-a397-1d076c110f46",
                                                "sense_id": "85478866-495e-37b6-8caf-96c4f30976f3",
                                                "text": "„Was Sade gibt, ist eine Naturgeschichte der Depravation, der angeborenen und der erworbenen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "af309696-cb1a-3d85-9f46-ada5d1f0c1d4",
                                        "entry_id": "c5de5260-ed54-3c31-98b8-9873de3c2359",
                                        "glosses": [
                                            "die Verschlechterung des gesundheitlichen Zustandes eines Patienten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25098043-e7f8-4cb6-8fd4-db76e387fbe0",
                                                "sense_id": "af309696-cb1a-3d85-9f46-ada5d1f0c1d4",
                                                "text": "„Am Anfang des Freiheitsentzugs steht eine besondere Form der Anomie, der Desozialisation und Depravation, die der Gesunde wie psychisch Kranke, Gestörte und Vulnerable bewältigen muß, und hierfür braucht er Hilfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "218affcd-8958-4d29-944e-28c3109e78cf",
                        "source_entry_id": "207f9d4c-4b3a-3efc-9d0c-51b41455404e",
                        "target_lang_word": "Verdorbenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdorbenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c765dfdc-dd4b-32f0-b397-a3108217b28d",
                                        "entry_id": "b4ccc295-afd8-360c-8f21-5a6a54e0a1b2",
                                        "glosses": [
                                            "Eigenschaft, verdorben, moralisch verkommen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f38d71-0dfd-42f3-876b-379942e4c381",
                                                "sense_id": "c765dfdc-dd4b-32f0-b397-a3108217b28d",
                                                "text": "„Da erst so wenig Zeit vergangen war, entging Anklägern, Richtern, Zeugen, Zuschauern, Politikern und Scharfrichtern die tiefgreifende Verdorbenheit Eichmanns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
