                "senses": [
                    {
                        "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                        "entry_id": "bdcf12bb-77a0-30dd-bbf5-b532c6addf80",
                        "glosses": [
                            "(meist besondere, größere) Veranstaltung, zum Beispiel im Kultur-, Sport- oder Freizeitbereich, die sich durch Inszenierung, Atmosphäre oder eine besonders hohe Teilnehmerzahl deutlich von gewöhnlichen Veranstaltungen abhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc14778d-d7e6-4a0f-b9da-f01acf4ce2e4",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "Ahrensburg hat für den Herbst mehrere Events auf dem Marktplatz geplant."
                            },
                            {
                                "example_id": "36750a95-870e-4145-b382-db8c49c003a0",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "Dieser Abend mit der Filmvorführung von Rocky war schon ein Event, das man nicht so schnell vergisst."
                            },
                            {
                                "example_id": "45b86b3e-58e8-4e57-8cbf-d12c70a91fac",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "Und für Freitag haben wir ein Kundenevent vorgesehen."
                            },
                            {
                                "example_id": "9aa20bb0-b335-47de-b4e6-1d7e3a4b1645",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "Natürlich freuen wir uns auf dieses gigantische Event im Olympiastadion."
                            },
                            {
                                "example_id": "907f7e18-aec9-45d0-bf31-f5f9b2fa6901",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "„Die Energie des Events war spürbar und ansteckend; es war aufregend, dabei zu sein.“"
                            },
                            {
                                "example_id": "321674df-e42b-4e74-b123-02f1b04a5c56",
                                "sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
                                "text": "„Es machte natürlich mehr her als ein einfacher Artikel, und irgendetwas musste die PR-Frau bekommen, wo sie sich solche Mühe gegeben hatte, um uns zu diesem Event einladen zu dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ccb57ae-b45c-46b9-a722-95e8dcab6fef",
                        "source_entry_id": "bdcf12bb-77a0-30dd-bbf5-b532c6addf80",
                        "source_sense_id": "279e3f6d-0f62-346e-b2c6-7cd9f1e82780",
