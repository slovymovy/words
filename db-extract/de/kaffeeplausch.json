                "senses": [
                    {
                        "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                        "entry_id": "ff86a2a3-2ead-3c4e-904e-61f3a199c2bd",
                        "glosses": [
                            "gemütliche Gesprächsrunde, bei der meist Kaffee getrunken und Kuchen gegessen wird"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "25728c48-a8b0-499f-aba6-893c8eacc0b0",
                                "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                                "text": "„Nach dem morgendlichen Kaffeeplausch begaben sich Naumann und ich auf den Weg zu Herrn Zhang.“"
                            },
                            {
                                "example_id": "178d5d77-660b-47a3-9a17-bab569bf7a82",
                                "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                                "text": "„Bei nächsten Kaffeeplausch mit Freunden brauchen Sie nicht extra zu backen oder zum Konditor zu gehen.“"
                            },
                            {
                                "example_id": "1a902af5-b8e8-45fe-b248-28e1b5fd0347",
                                "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                                "text": "„Aus einem eigentlich recht lockeren Kaffeeplausch mit einer Freundin entwickelte sich überraschend eine Diskussion über das Thema Pünktlichkeit.“"
                            },
                            {
                                "example_id": "cd8a85f2-1f86-4836-b76e-9073bb8b4b6f",
                                "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                                "text": "„Während ihre Töchter friedlich spielten, genossen die beiden Frauen ihren Kaffeeplausch.“"
                            },
                            {
                                "example_id": "a996d935-dd4d-468e-8699-0139148d5720",
                                "sense_id": "facf77a2-5b79-37df-acf5-87a1a8415a33",
                                "text": "„Ich erinnere mich an die vielen Kaffeepläusche mit ihm, während eine Misserfolgsgeschichte die nächste jagte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
