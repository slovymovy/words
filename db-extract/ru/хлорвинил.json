                "senses": [
                    {
                        "sense_id": "b7360f6c-bec6-32a4-8862-c2d878f00bc0",
                        "entry_id": "9005935e-dd32-3f9d-a0b4-906f3915f366",
                        "glosses": [
                            "хим. органическое вещество; бесцветный газ со слабым сладковатым запахом, простейшее хлорпроизводное этилена (C₂H₃Cl)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5573f675-d1a3-444d-9532-c7f014ef63f9",
                                "sense_id": "b7360f6c-bec6-32a4-8862-c2d878f00bc0",
                                "text": "Сополимер хлорвинила и винилацетата ― лучший материал для замены шеллака в граммофонных пластинках."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a4025cb-05d0-36cd-bfd4-1eff6acf81ab",
                        "entry_id": "9005935e-dd32-3f9d-a0b4-906f3915f366",
                        "glosses": [
                            "разг. то же, что полихлорвинил"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0780f0-8b6b-462d-b780-53e2460e8519",
                                "sense_id": "8a4025cb-05d0-36cd-bfd4-1eff6acf81ab",
                                "text": "Друзья заняли столик под вечнозелёным растением из хлорвинила."
                            }
                        ]
                    }
                ],
