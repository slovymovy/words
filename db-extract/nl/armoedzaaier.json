                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "9940e988-d889-456a-8d41-cf1543a058dd",
                                "sense_id": "5d768a65-5e12-3bd2-91e5-5e221fd35233",
                                "text": "Schaamt zoo'n ongelukkige armoedzaaier zich niet een oppassend huisvader van zeven nog zeer jeugdige kinderen zoo plotseling broodeloos op straat te zetten?",
                                "translation": "Isn't such a deplorable troublemaker ashamed about suddenly kicking a cautious father with a family of seven very young children onto the street without employment?",
                                "english": "Isn't such a deplorable troublemaker ashamed about suddenly kicking a cautious father with a family of seven very young children onto the street without employment?"
                            }
                        ]
                    }
