                    {
                        "translation_id": "57e5a8ca-edd5-4d08-9449-15e00d553e68",
                        "source_entry_id": "b5a0b556-8547-39f3-bd60-cb040c03eb5c",
                        "source_sense_description": "Curve or bend",
                        "target_lang_word": "bocht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bocht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9efa568b-0f95-3fdf-89aa-eab2b21f42bc",
                                        "entry_id": "e83be5cc-1955-3d9c-9955-26acdcbe02fe",
                                        "glosses": [
                                            "van richting veranderende, gebogen weg of pad, kromming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e88222c-8dd9-47d3-9dc1-a9e17b850cb5",
                                                "sense_id": "9efa568b-0f95-3fdf-89aa-eab2b21f42bc",
                                                "text": "Hij ging veel te snel door de bocht."
                                            },
                                            {
                                                "example_id": "06dd4713-abb2-47fa-b868-86909a034fd9",
                                                "sense_id": "9efa568b-0f95-3fdf-89aa-eab2b21f42bc",
                                                "text": "Zijn er dan toch grenzen aan het sadisme? Wie het haalt tot de laatste bocht naar links, weet het antwoord."
                                            },
                                            {
                                                "example_id": "85827c25-f122-4be0-a9a9-0fa27fb73c8e",
                                                "sense_id": "9efa568b-0f95-3fdf-89aa-eab2b21f42bc",
                                                "text": "In mijn fantasie zat er achter elke boom een beer, klaar om mij te verslinden. Dagen achter elkaar was er niemand te bekennen, waardoor ik me nog kwetsbaarder voelde, en ik begon bij elke bocht hard te zingen om eventuele beren te waarschuwen dat ik eraan kwam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b802fe-5ea6-363a-bce6-b74de408e94f",
                                        "entry_id": "e83be5cc-1955-3d9c-9955-26acdcbe02fe",
                                        "glosses": [
                                            "brede baai aan de kustlijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b7514e-70d3-4161-a21a-0d1c00c79447",
                                                "sense_id": "98b802fe-5ea6-363a-bce6-b74de408e94f",
                                                "text": "De Australische Bocht."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bocht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8f43b3-98e3-36c5-b154-1e52be081401",
                                        "entry_id": "69526130-e7ae-3c7b-a419-21ed01c41a18",
                                        "glosses": [
                                            "drank of andere substantie van slechte kwaliteit"
                                        ],
                                        "tags": [
                                            "informal",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3706603-725b-499f-8095-9b513362327b",
                                                "sense_id": "0c8f43b3-98e3-36c5-b154-1e52be081401",
                                                "text": "Dat brouwsel is echt bocht."
                                            },
                                            {
                                                "example_id": "90ee2012-b692-45ee-b762-7dae510239f8",
                                                "sense_id": "0c8f43b3-98e3-36c5-b154-1e52be081401",
                                                "text": "Neen 'k drink, al werd het mij gegeven,\nGeen droppel meer van 't geestrijk vocht;\nDe sterke drank verkort het leven,\nEn is toch wel bezien maar bocht."
                                            },
                                            {
                                                "example_id": "45c1f419-b44a-4ee4-bfb8-cb173c120593",
                                                "sense_id": "0c8f43b3-98e3-36c5-b154-1e52be081401",
                                                "text": "Als de huiswijn bocht is, vraag dan om een betere."
                                            },
                                            {
                                                "example_id": "6cf769d3-ab99-4cf4-963d-57fc0eeef53e",
                                                "sense_id": "0c8f43b3-98e3-36c5-b154-1e52be081401",
                                                "text": "Ze werd onderbroken door het kokhalzende gesmak van Ilja. 'Godallemachtig, wat is dit voor bocht?'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
