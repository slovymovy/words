                "senses": [
                    {
                        "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                        "entry_id": "1c9297d5-8f54-3da9-9f21-4857cdc5f52e",
                        "glosses": [
                            "Écrivain médiocre."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d10f3af7-5043-4e24-aa11-439686abe5c7",
                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                "text": "Nini et Tangol, qui avaient connu la Fleur d’Herbes de Madagascar du temps de sa splendeur à la Réunion, n’en revenaient pas de la savoir acoquinée et mêlée aux bafouilles d’un écrivailleur."
                            },
                            {
                                "example_id": "95c9c364-89d6-4f25-8c14-d09f38433607",
                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                "text": "Processif, écrivailleur, il minutait des lettres douces et polies à ses locataires ; mais au fond de son style comme sous sa mine fade et prévenante se cachait l’âme de Shylock."
                            },
                            {
                                "example_id": "eab7eca6-7518-4963-b492-10163d3fe919",
                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                "text": "Et tout cela, il le savait, la presse et les langues de dix milliards de personnes et les plumes ou les machines de cent millions d’écrivailleurs professionnels le diraient, l’écriraient, le chuchoteraient ou le clameraient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baa16a02-cf0c-4eab-9637-c183b6a6447e",
                        "source_entry_id": "1c9297d5-8f54-3da9-9f21-4857cdc5f52e",
                        "source_sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
