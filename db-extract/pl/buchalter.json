                "senses": [
                    {
                        "sense_id": "db832af6-5634-3182-9c3c-56e407f528cd",
                        "entry_id": "69f7bb8d-98e9-38f9-80fa-d1299a8e0ee9",
                        "glosses": [
                            "księgowy"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a9aba519-0370-444f-ac2e-6e48dc0bbdf5",
                                "sense_id": "db832af6-5634-3182-9c3c-56e407f528cd",
                                "text": "Wakuje wprawdzie posada buchaltera, jest miejsce technika, ale to wszystko nie dla pana: pensje małe i specjalności, które trzeba znać"
                            },
                            {
                                "example_id": "0c1d8450-92d8-4d31-8c4a-391a7ec92042",
                                "sense_id": "db832af6-5634-3182-9c3c-56e407f528cd",
                                "text": "Buchalter firmy „Mojżesz Katz” był gburem. Pan Katz wyrzucił go i przyjął nowego buchaltera. Był to anioł i wersalczyk w jednej osobie: cichy, spokojny, grzeczny, układny, słowa głośnego nie umiał powiedzieć"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
