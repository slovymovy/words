                "translations": [
                    {
                        "translation_id": "852565e5-690b-4a57-95f6-f5d1c5f10853",
                        "source_entry_id": "bf7dc567-04a3-3825-bcad-2494cd484166",
                        "source_sense_id": "6332cc46-773c-3921-9af1-8c8ded7140ad",
                        "target_lang_word": "autodidact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodidact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                        "entry_id": "8cac2d64-0285-3b79-b3a9-8fbac9e5a21e",
                                        "glosses": [
                                            "A self-taught person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f618d195-6ca0-4696-8999-0895475c0cc5",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "Leonardo Da Vinci is one of the greatest autodidacts."
                                            },
                                            {
                                                "example_id": "f12b5784-ec6a-487f-972c-0595ecbbdc6c",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "For an autodidact, for somebody who plays by ear like me, the ukulele is ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b9b863b-f1d3-447a-aff5-5ec0e1b094b6",
                        "source_entry_id": "bf7dc567-04a3-3825-bcad-2494cd484166",
                        "source_sense_id": "6332cc46-773c-3921-9af1-8c8ded7140ad",
                        "target_lang_word": "self-taught",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-taught",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424180b8-c47f-3f39-ba94-dfb2a1426d62",
                                        "entry_id": "272068e7-6c49-39f0-92a6-e75696641fa6",
                                        "glosses": [
                                            "Educated or trained by oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a162cd-021b-47e2-9512-208d0c8959fc",
                                                "sense_id": "424180b8-c47f-3f39-ba94-dfb2a1426d62",
                                                "text": "It's this understanding of Quality as revealed by stuckness which so often makes self-taught mechanics so superior to institute-trained men who have learned how to handle everything except a new situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a13457-d453-4bd3-8819-972c3c51d894",
                        "source_entry_id": "bf7dc567-04a3-3825-bcad-2494cd484166",
                        "source_sense_id": "6332cc46-773c-3921-9af1-8c8ded7140ad",
                        "target_lang_word": "samouk",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samouk",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7ec1b9-16b9-35eb-9773-c4d6cfa5b7d7",
                                        "entry_id": "bd8e25f0-1044-35ca-a3f9-68bf666e06e9",
                                        "glosses": [
                                            "ten, kdo se učí sám"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3290d10b-14e9-4219-932c-393888f10b6c",
                                                "sense_id": "ae7ec1b9-16b9-35eb-9773-c4d6cfa5b7d7",
                                                "text": "Tato učebnice je vhodná nejen pro samouky, ale také pro studenty středních škol a návštěvníky jazykových kurzů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d02e3eb9-dace-49e2-acd2-a78cf222349e",
                        "source_entry_id": "bf7dc567-04a3-3825-bcad-2494cd484166",
                        "source_sense_id": "6332cc46-773c-3921-9af1-8c8ded7140ad",
                        "target_lang_word": "autodidacta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodidacta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9747e7b1-6263-3f42-aaba-669d3259c044",
                                        "entry_id": "6d61963b-4a0a-33fe-9977-a9d4aee80d1f",
                                        "glosses": [
                                            "Que se enseña a sí mismo, o aprende un arte, disciplina o materia sin seguir un método preestablecido ni tener supervisión de ningún maestro."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bcd0493-65db-4ffd-a65b-81d6b84b6c96",
                        "source_entry_id": "bf7dc567-04a3-3825-bcad-2494cd484166",
                        "source_sense_id": "6332cc46-773c-3921-9af1-8c8ded7140ad",
                        "target_lang_word": "Autodidakt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autodidakt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                        "entry_id": "1c04a35f-185d-3e9d-92de-12ad95cfa6e1",
                                        "glosses": [
                                            "eine Person, die selbstständig, ohne Lehrer lernt, sich etwas beibringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc09579-c620-426d-bb1b-c30ed16f21a5",
                                                "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                                "text": "Viele Wissenschaftler waren Autodidakten."
                                            },
                                            {
                                                "example_id": "6e7e4e99-0dc5-4ee8-804b-d9a548f71f48",
                                                "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                                "text": "„Kari Korhonen ist mit seinen Arbeiten sicher einer der erfolgreichsten Comic-Künstler Finnlands, dabei ist er in seinem Fach ein absoluter Autodidakt.“"
                                            },
                                            {
                                                "example_id": "e9bb82c2-30ec-4cb3-ae46-7bcb68859251",
                                                "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                                "text": "„Ich hatte nur als Kind ein paar Klavierstunden bekommen, und bevor ich mir vor fünf Jahren eine Lehrerin suchte, war ich im Grunde ein Autodidakt.“"
                                            },
                                            {
                                                "example_id": "e20f6130-1633-4493-8172-02e09a33694a",
                                                "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                                "text": "„Einige von ihnen begannen die Geschichte der jiddischen Sprache und ihre Literatur und Kultur systematisch zu erforschen, dies nicht selten als wissenschaftliche Autodidakten und Einzelkämpfer.“"
                                            },
                                            {
                                                "example_id": "ce69a319-e04a-4393-98f1-9b14edc3a769",
                                                "sense_id": "c4f29ce0-241b-3835-96ec-978c4381268c",
                                                "text": "„Der Unterricht konnte den lernbegierigen Schüler nur wenig fesseln, und so begann er, kaum achtjährig, als Autodidakt mit der Lektüre lateinischer Texte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "265357c7-b60a-4d4f-81ea-148d5b99621b",
