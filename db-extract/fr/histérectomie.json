                        "entry_id": "20de2157-8d87-3d64-973d-253c07810212",
                        "glosses": [
                            "Variante orthographique ancienne de hystérectomie (ablation chirurgicale de l’utérus)."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
