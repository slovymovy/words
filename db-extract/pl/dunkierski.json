                        "examples": [
                            {
                                "example_id": "9e2f1d19-5f45-4ee4-903c-150ebd472771",
                                "sense_id": "a1d5aca6-732b-32ff-b944-50db300f072a",
                                "text": "Królewskie Siły Powietrzne (RAF) spotkało w czasie kampanii dunkierskiej i po niej wiele nieuzasadnionych zarzutów"
                            }
                        ],
