                ],
                "senses": [
                    {
                        "sense_id": "1ca5f852-759c-39ec-ba69-c3bbd852a26f",
                        "entry_id": "1a4a59db-4f33-362b-9704-95e0aea3f1eb",
                        "glosses": [
                            "Relatif aux excréments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3fcdf7-ecb7-40d7-9ca0-20fe47aff39f",
                                "sense_id": "1ca5f852-759c-39ec-ba69-c3bbd852a26f",
                                "text": "Les massues montaient et descendaient avec une force irrésistible et désormais une seule voix articulée se faisait entendre à travers les cris de rage et le fracas des meubles brisés — la voix affreusement rauque de Gueule-de-Bois, broyant toujours du Prussien et répétant cet unique mot : « Cochons ! cochons ! » qui avait l’air de sortir de lui comme les bouillons excrémentiels sortent d’un égout."
                            },
                            {
                                "example_id": "febdf6b1-8794-45b2-b4f9-718928eef1c2",
                                "sense_id": "1ca5f852-759c-39ec-ba69-c3bbd852a26f",
                                "text": "Dans ce « roman », tout, absolument tout est réduit à des fonctions sexuelles sur fond de besoins vitaux irrépressibles, telles la faim et les fonctions excrémentielles sans parler de la bestialité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd929804-e7ab-42f5-a8f4-9f20b7826f33",
                        "source_entry_id": "1a4a59db-4f33-362b-9704-95e0aea3f1eb",
                        "source_sense_id": "1ca5f852-759c-39ec-ba69-c3bbd852a26f",
                        "target_lang_word": "shitty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shitty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Very bad; unpleasant; miserable; insignificant."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67275724-7f3d-4285-a6ee-b1c1e113809e",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "The television I bought there was so shitty that I will never shop there again."
                                            },
                                            {
                                                "example_id": "39b4e5a8-a6a8-49bc-9062-4a81da85a6ee",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "I'm feeling shitty today; I don't want to go out."
                                            },
                                            {
                                                "example_id": "02c4f782-f58f-4c1d-a7a8-c6b943bf83e4",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "It's a well-known fact that reading is about the shittiest thing you can do for your eyes."
                                            },
                                            {
                                                "example_id": "f7127d7c-9c58-4c80-8ac1-ecbbaea191f9",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "Except for Rasheena, the rest of the baby mamas was at least struggling to live halfway right. They used to clown and act shitty whenever they came by Noojie's and saw Carmiesha there. But every last one of them ended up being grateful to her for the things she did for their kids."
                                            },
                                            {
                                                "example_id": "8295ab29-12f2-4e66-bb8d-7714ca78e02f",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "The difference is they usually have a shittier singer, and no originality."
                                            },
                                            {
                                                "example_id": "9e762d1d-035e-474f-9e20-f86dfc1812e5",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "Halfway there we turned off the highway onto possibly the shittiest gravel road I have ever driven. In Canada, we would call it washboard; in Australia they call it corrugated, but you get the point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0d5652-300c-34b6-8446-7a61c66eea4c",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Under the influence of illicit drugs or alcohol; drunk; high."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41b27ac1-60d7-30a3-afd3-9a04ec897338",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Annoyed."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b1cb3c-8e5a-4d8e-9c03-33d0e2d8fc8f",
                                                "sense_id": "41b27ac1-60d7-30a3-afd3-9a04ec897338",
                                                "text": "Don't get shitty with me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc7d26b-4343-3bde-874c-5adc8e7313a6",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Covered in faeces/feces; feculent."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45a0f2b-1d1f-3c0e-9f62-adc8152f2fc6",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Of low quality or standard; inferior; not up to par, or failing one's expectations"
                                        ],
                                        "tags": [
                                            "informal",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4f0591-c866-4b28-b861-6aaa45e6b342",
                                                "sense_id": "c45a0f2b-1d1f-3c0e-9f62-adc8152f2fc6",
                                                "text": "“She's a shitty teacher, but Ault was in a bind.” But she hadn't been a shitty teacher when she'd been hired. She'd never taught before. And who was Aspeth to decide she was shitty now? She was still inexperienced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8c86d30-0946-482f-95e7-9d8cdaae9017",
                        "source_entry_id": "1a4a59db-4f33-362b-9704-95e0aea3f1eb",
                        "source_sense_id": "1ca5f852-759c-39ec-ba69-c3bbd852a26f",
                        "target_lang_word": "crappy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crappy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                        "entry_id": "d6e8166d-ef9a-388c-8784-107425c4c4f0",
                                        "glosses": [
                                            "Of very poor quality; unpleasant; distasteful."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86bdc2b-9b4c-4e84-bd48-1cb438a5c6eb",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "That is such a crappy car."
                                            },
                                            {
                                                "example_id": "d016c899-399f-489c-9d1c-c98df1109a0f",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "The referee just made a really crappy call."
                                            },
                                            {
                                                "example_id": "b21eadbb-78b7-4f93-8267-cfd618a7b448",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "The food there used to be good but now it's crappy."
                                            },
                                            {
                                                "example_id": "54efff41-58b7-40ef-9fb7-74f628575791",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "Think of the content mill as a modern-day literary sweatshop—writers hunkering down at hot keyboards, plowing away at 3,000 word articles for, literally, pennies. Content mills were born because someone figured out that by targeting popular search result terms, they could commission an army of crappy posts catering to these terms and dominate Google's results."
                                            },
                                            {
                                                "example_id": "2498b4d1-ec5a-4d86-9544-82324d4ea098",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "She took a leap in 2019 and bought an investment property, a duplex in Missoula, Mont., intending to live in one unit and rent the other. “It was the crappiest house on the block,” she said."
                                            },
                                            {
                                                "example_id": "934850d9-1c4a-478b-a24f-d514094e7ff2",
                                                "sense_id": "1934d1b2-7bcb-3aaa-b920-9ab5d0028584",
                                                "text": "“Many scientists and historians think we’re entering into a new epoch — one where things are simply … well, crappier,” declares the opening voice-over in a thick northern English accent (regularly used in Britain to indicate no-nonsense, tongue-in-cheek pragmatism)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bbaf85-e0e7-3c07-8281-ccecaeea1b65",
                                        "entry_id": "d6e8166d-ef9a-388c-8784-107425c4c4f0",
                                        "glosses": [
                                            "Bad, sick, or depressed."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial",
                                            "especially",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19cb1301-d270-4ea6-8392-a6956d1c6121",
                                                "sense_id": "95bbaf85-e0e7-3c07-8281-ccecaeea1b65",
                                                "text": "I'm feeling really crappy - I think I need some fresh air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd7bfea-5c97-3db5-bfc9-198e429df39c",
                                        "entry_id": "d6e8166d-ef9a-388c-8784-107425c4c4f0",
                                        "glosses": [
                                            "Covered in crap (faeces/feces)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
