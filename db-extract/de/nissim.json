                ],
                "senses": [
                    {
                        "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                        "entry_id": "d41fdf3e-62d2-3066-bc77-a733ff0af9c3",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a71526-7a15-4511-9d61-cbb232ed2fcf",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Frau Nissim ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2cd67c6b-76d6-4c41-ac1c-677699efab16",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Herr Nissim wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7d2d4d31-073f-47d4-a8d1-bf940d1606b1",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Die Nissims fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "be7b54b1-d9bb-45cc-a28f-63c70a5b9fc3",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Der Nissim trägt nie die Schals, die die Nissim ihm strickt."
                            },
                            {
                                "example_id": "d1b58c87-e49c-4823-9bf4-f5520f4b5403",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nissim kommt, geht der Herr Nissim.“"
                            },
                            {
                                "example_id": "9c9caaeb-1001-4b5e-844c-0511def52b8e",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Nissim kommt und geht."
                            },
                            {
                                "example_id": "ee3869f1-0628-4fd7-9376-54dccf01e51e",
                                "sense_id": "33fb46e9-5452-387c-948e-6a7c6817360c",
                                "text": "Nissims kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
