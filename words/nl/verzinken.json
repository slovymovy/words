{
    "word_family": [
        "zinken",
        "verzinking",
        "zink",
        "verzonkenheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bdcf220-3144-3e11-b466-0a605663742b",
                    "sense_definition": "verdwijnen door in een vloeistof of zachte massa weg te zakken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gekapseisde schip <w>verzonk</w> langzaam in de woedende zee.",
                            "target_lang_translations": {
                                "en": "The capsized ship slowly <w>sank</w> into the raging sea."
                            }
                        },
                        {
                            "text": "De zware steen <w>verzonk</w> in de modder van de rivierbodem.",
                            "target_lang_translations": {
                                "en": "The heavy stone <w>sank</w> into the mud of the riverbed."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegzinken",
                        "ondergaan"
                    ],
                    "antonyms": [
                        "bovendrijven"
                    ],
                    "common_phrases": [
                        "in de zee verzinken",
                        "in de modder verzinken"
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear by sinking into a liquid or soft mass."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sink",
                                "target_lang_sense_clarification": "to go down below the surface of water or mud"
                            },
                            {
                                "target_lang_word": "submerge",
                                "target_lang_sense_clarification": "to go completely under water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aa972ac-09e7-3a7d-abe1-029abafdd017",
                    "sense_definition": "geestelijk volledig in beslag genomen worden door iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was diep in gepeins <w>verzonken</w> en hoorde de deurbel niet.",
                            "target_lang_translations": {
                                "en": "He was deeply <w>lost</w> in thought and did not hear the doorbell."
                            }
                        },
                        {
                            "text": "Tijdens de wandeling was zij volledig <w>verzonken</w> in haar eigen gedachten.",
                            "target_lang_translations": {
                                "en": "During the walk, she was completely <w>absorbed</w> in her own thoughts."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgaan"
                    ],
                    "common_phrases": [
                        "in gedachten verzonken",
                        "in gepeins verzonken"
                    ],
                    "target_lang_definitions": {
                        "en": "To be completely mentally absorbed by something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sunk",
                                "target_lang_sense_clarification": "deeply involved or lost in a mental state"
                            },
                            {
                                "target_lang_word": "absorbed",
                                "target_lang_sense_clarification": "having one's attention fully taken up"
                            },
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "fully occupied with thoughts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f685d942-0ba8-3c0a-b6c6-c38414d850b3",
                    "sense_definition": "een voorwerp of onderdeel dieper in een oppervlak aanbrengen zodat het niet uitsteekt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt deze schroef het beste <w>verzinken</w> in het hout voor een glad resultaat.",
                            "target_lang_translations": {
                                "en": "It is best to <w>countersink</w> this screw into the wood for a smooth result."
                            }
                        },
                        {
                            "text": "De timmerman besloot de scharnieren te <w>verzinken</w> in de deurpost.",
                            "target_lang_translations": {
                                "en": "The carpenter decided to <w>recess</w> the hinges into the doorframe."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkasten",
                        "inlaten"
                    ],
                    "common_phrases": [
                        "een schroef verzinken",
                        "in het hout verzinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische handeling"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To set an object or part deeper into a surface so that it does not protrude."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "countersink",
                                "target_lang_sense_clarification": "to drive a screw or bolt so the head is flush with the surface"
                            },
                            {
                                "target_lang_word": "recess",
                                "target_lang_sense_clarification": "to set something back into a space"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3432c6c-0ffc-3f05-9fc9-2aca6aba5ba2",
                    "sense_definition": "een metalen voorwerp bedekken met een laagje zink om roest te voorkomen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oppervlaktebehandeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men kan een voorwerp <w>verzinken</w> door het in een bad met gesmolten zink te dompelen.",
                            "target_lang_translations": {
                                "en": "One can <w>galvanize</w> an object by dipping it into a bath of molten zinc."
                            }
                        },
                        {
                            "text": "Om corrosie tegen te gaan laat de fabriek alle stalen frames <w>verzinken</w>.",
                            "target_lang_translations": {
                                "en": "To prevent corrosion, the factory has all steel frames <w>galvanized</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "galvaniseren"
                    ],
                    "common_phrases": [
                        "staal laten verzinken",
                        "elektrolytisch verzinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "industrieel proces"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To coat a metal object with a layer of zinc to prevent rust."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "galvanize",
                                "target_lang_sense_clarification": "to coat iron or steel with a protective layer of zinc"
                            },
                            {
                                "target_lang_word": "zinc-coat",
                                "target_lang_sense_clarification": "to apply a zinc finish to metal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}