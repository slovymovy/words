                    ]
                },
                {
                    "sense_id": "06092d9d-6f85-38ed-b428-e9bda0faf38b",
                    "sense_definition": "Consistance encore liquide des confitures en cours de cuisson avant leur gélification complète.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cuisson n'est pas encore terminée car le <w>sirop</w> des abricots reste trop fluide."
