                "senses": [
                    {
                        "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                        "entry_id": "5f0897d7-b427-3420-b0f0-61ea4c33537e",
                        "glosses": [
                            "anerkannte männliche Person, die auf dem Fachgebiet von Polymeren sehr bewandert ist und seine Expertenmeinung abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c290750-eaf0-4fba-be59-a3bd391abfe3",
                                "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                                "text": "„Als Sachverständige oder öffentlich bestellte und vereidigte Sachverständige werden die Kunststoffexperten regelmäßig auch zur Erstellung von gerichtsfesten Gutachten herangezogen.“"
                            },
                            {
                                "example_id": "f79bfd7b-6478-4ffc-aa8a-c3cab1b7b1fa",
                                "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                                "text": "„Als „Kunststoffexperte“ besucht er den vom Verein Deutscher Ingenieure (VDI) veranstalteten internationalen Kongress „Kunststoffe im Automobilbau“, mit mehr als 1.400 Teilnehmer und 100 Aussteller aus 12 Nationen vom 18. bis 19. März 2015 in Mannheim.“"
                            },
                            {
                                "example_id": "8ef0f6fe-378b-4999-8dd2-77b551500205",
                                "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                                "text": "„Kunststoffe erobern als Konstruktionswerkstoffe aufgrund ihrer vielfältigen Eigenschaften immer neue Anwendungsfelder. Grund genug, um mit dem Kunststoffexperten Georg Petzinger, technischer Leiter bei Handtmann Elteka, über aktuelle Entwicklungen in diesem Bereich zu sprechen.“"
                            },
                            {
                                "example_id": "2c1baf85-61d3-474f-a3d7-730a226ea150",
                                "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                                "text": "„Kunststoffexperte Dipl-Ing. F.-Peter Plaschke hat die Broschüre von Dipl-Ing. Fritz Hartz aktualisiert.“"
                            },
                            {
                                "example_id": "15510f9c-aa79-4ef5-ac5a-e33d53860586",
                                "sense_id": "d280b877-c66c-3850-a88a-018e9db11db2",
                                "text": "„Es geschah vor etwa drei Jahren: Gemeinsam mit einem Kunden seiner Firma Moventa GmbH tüftelte der Neuburger Unternehmer und Kunststoffexperte Dr. Michael Bauer an verbesserten Verpackungssystemen aus Kunststoff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                        "entry_id": "5f0897d7-b427-3420-b0f0-61ea4c33537e",
                        "glosses": [
                            "spezialisierte Fachfirma der Kunststoffindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c700593-cc29-4da4-ad31-6124a19f6d08",
                                "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                                "text": "„Es geschah vor etwa drei Jahren: Gemeinsam mit einem Kunden seiner Firma Moventa GmbH tüftelte der Neuburger Unternehmer und Kunststoffexperte Dr. Michael Bauer an verbesserten Verpackungssystemen aus Kunststoff.“"
                            },
                            {
                                "example_id": "e1d30c6e-3d4a-49bf-a1f5-b873316d89ef",
                                "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                                "text": "„\"Energieführen leicht gemacht\" – dieses Motto verspricht Igus seinen Kunden nicht nur, der Kunststoffexperte setzt es auch um.“"
                            },
                            {
                                "example_id": "8d24f689-926c-4114-b32e-975259871f61",
                                "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                                "text": "„Der Kunststoffexperte GRAFE bietet seinen Kunden Masterbatches für Kunststoffe an, die mit Laser markiert werden können.“"
                            },
                            {
                                "example_id": "0c0b265c-2fea-48ef-aaba-1f9c53a93456",
                                "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                                "text": "„Der Kunststoffexperte plant, eine eigene Produktionsstätte für 18 Millionen Euro zu bauen.“"
                            },
                            {
                                "example_id": "a45883d7-2363-46ca-9f1c-0540f5a191e8",
                                "sense_id": "229fe38f-29bc-3618-8166-e125c657bd83",
                                "text": "„Mit dieser Investition baut der Kunststoffexperte das weltweit größte und modernste LFI-Produktionszentrum auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
