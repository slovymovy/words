            "senses": [
                {
                    "sense_id": "1404df9f-f3fb-38cb-b7a8-39b0dd08d46e",
                    "sense_definition": "Вызывающий беспокойство, волнение или страх; полный тревоги.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "беспокойство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>тревожный</w> взгляд заставил меня сразу заподозрить неладное.",
                            "target_lang_translations": {
                                "en": "His <w>anxious</w> look made me immediately suspect that something was wrong."
                            }
                        },
                        {
                            "text": "В последнее время меня постоянно преследуют <w>тревожные</w> мысли о будущем.",
                            "target_lang_translations": {
                                "en": "Lately, I have been constantly haunted by <w>anxious</w> thoughts about the future."
                            }
                        }
                    ],
                    "synonyms": [
                        "беспокойный",
                        "взволнованный"
                    ],
                    "antonyms": [
                        "спокойный",
                        "безмятежный"
                    ],
                    "common_phrases": [
                        "тревожные мысли",
                        "тревожный взгляд",
                        "тревожные новости"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing anxiety, worry, or fear; full of apprehension."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "of things, like a look or thoughts, causing or showing worry"
                            },
                            {
                                "target_lang_word": "troubled",
                                "target_lang_sense_clarification": "worried or full of concern"
                            },
                            {
                                "target_lang_word": "uneasy",
                                "target_lang_sense_clarification": "causing discomfort or apprehension"
                            },
                            {
                                "target_lang_word": "disturbing",
                                "target_lang_sense_clarification": "causing anxiety or worry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0517cf44-9248-3da8-b0b5-914e6b8f7f78",
                    "sense_definition": "Испытывающий волнение, беспокойство или склонный к ним (о человеке или его состоянии).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "беспокойство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она была очень <w>тревожным</w> человеком и всегда переживала по пустякам.",
                            "target_lang_translations": {
                                "en": "She was a very <w>anxious</w> person and always worried about trifles."
                            }
                        },
                        {
                            "text": "После тяжелого разговора у него осталось крайне <w>тревожное</w> состояние.",
                            "target_lang_translations": {
                                "en": "After a difficult conversation, he was left in an extremely <w>uneasy</w> state."
                            }
                        }
                    ],
                    "synonyms": [
                        "беспокойный",
                        "озабоченный"
                    ],
                    "antonyms": [
                        "спокойный"
                    ],
                    "common_phrases": [
                        "тревожное состояние",
                        "тревожный человек"
                    ],
                    "target_lang_definitions": {
                        "en": "Experiencing worry, anxiety, or prone to them (referring to a person or their state)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "feeling nervous, worried, or apprehensive"
                            },
                            {
                                "target_lang_word": "uneasy",
                                "target_lang_sense_clarification": "restless or disturbed by anxiety"
                            },
                            {
                                "target_lang_word": "troubled",
                                "target_lang_sense_clarification": "having a state of mind filled with worry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "358f332f-cab8-3980-99db-e1b8458b0b43",
                    "sense_definition": "Служащий сигналом об опасности, предупреждающий о ней.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сигнализация",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вдруг раздался громкий <w>тревожный</w> звонок, и все побежали к выходу.",
                            "target_lang_translations": {
                                "en": "Suddenly a loud <w>alarm</w> bell rang, and everyone ran to the exit."
                            }
                        },
                        {
                            "text": "Этот инцидент стал первым <w>тревожным</w> сигналом для руководства компании.",
                            "target_lang_translations": {
                                "en": "This incident became the first <w>warning</w> sign for the company's management."
                            }
                        }
                    ],
                    "synonyms": [
                        "предупреждающий"
                    ],
                    "common_phrases": [
                        "тревожный звонок",
                        "тревожный сигнал",
                        "тревожная кнопка"
                    ],
                    "target_lang_definitions": {
                        "en": "Serving as a signal of danger; warning of danger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alarm",
                                "target_lang_sense_clarification": "used as a modifier, e.g., alarm bell, alarm button"
                            },
                            {
                                "target_lang_word": "warning",
                                "target_lang_sense_clarification": "serving to warn of danger or trouble"
                            },
                            {
                                "target_lang_word": "disturbing",
                                "target_lang_sense_clarification": "concerning or worrisome, as in a signal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf4fa45-6a5a-3365-a081-c52cc3391dbd",
                    "sense_definition": "Предназначенный для действий по сигналу тревоги или находящийся в постоянной готовности к ним.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "сигнализация",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Военные быстро собрали свой <w>тревожный</w> чемоданчик и выдвинулись на позиции.",
                            "target_lang_translations": {
                                "en": "The military quickly packed their <w>emergency</w> bags and moved to their positions."
                            }
                        },
                        {
                            "text": "Начальник зачитал приказ, и вся <w>тревожная</w> группа немедленно выехала на объект.",
                            "target_lang_translations": {
                                "en": "The commander read the order, and the entire <w>alert</w> group immediately left for the site."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тревожная группа",
                        "тревожный чемоданчик"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "специальное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Intended for actions upon an alarm signal, or being in constant readiness for them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emergency",
                                "target_lang_sense_clarification": "for use in an emergency or alarm situation"
                            },
                            {
                                "target_lang_word": "alert",
                                "target_lang_sense_clarification": "ready for immediate action or response"
                            }
                        ]
                    }
                }
            ]
        }
