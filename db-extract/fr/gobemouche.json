                    {
                        "sense_id": "d7c59f77-8e51-3320-943a-35eea477ff20",
                        "entry_id": "1f2a097a-87e0-3137-8f53-e66461d02e97",
                        "glosses": [
                            "Espèce de petit oiseau passereau, à bec fin et largement fendu, à longues ailes et à pattes courtes qui se nourrit de mouches et d’autres insectes volants qu'il attrape en vol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564de844-04f2-47e5-93a7-24734a1ab760",
                                "sense_id": "d7c59f77-8e51-3320-943a-35eea477ff20",
                                "text": "Le passage des passereaux au col de Cou débute en général fin juillet avec des migrateurs nocturnes (fauvette, pouillot, gobemouche, rouge-gorge, traque, bruant ortolan, torcol, échassier)."
                            }
                        ]
                    }
                ],
