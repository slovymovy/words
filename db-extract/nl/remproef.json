                                        "sense_id": "0e709d61-58c1-329d-bc0f-005fdb22b693",
                                        "entry_id": "1869bec3-9c25-3145-9190-5cb796060dc7",
                                        "glosses": [
                                            "A test to ensure that the brakes of a vehicle are working correctly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5451e7-57e2-4c92-be8d-fe4b5115150b",
                                                "sense_id": "0e709d61-58c1-329d-bc0f-005fdb22b693",
                                                "text": "We left Paris to time and after the brake test at St. Denis it was my pleasure to drive No. U.1 for the rest of the day."
                                            },
                                            {
                                                "example_id": "2a8fbc4e-3063-4eb5-adf8-e80a06f98c3d",
                                                "sense_id": "0e709d61-58c1-329d-bc0f-005fdb22b693",
                                                "text": "We remain motionless in the platform while the ex-Edinburgh draws forward, the points are set, and it is propelled back for attachment. The Edinburgh locomotive uncoupled, a brake test is performed and we're away."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brake test",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f5b35f2-eced-3061-b2ad-3e74f81dab8c",
                                        "entry_id": "24ff0c97-3cb5-39f2-a4fd-650f85a62551",
                                        "glosses": [
                                            "To deliberately brake in unusual places to hinder or startle the person behind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7fdbc7d-df09-4d79-aec9-ffda2aa80376",
                                                "sense_id": "3f5b35f2-eced-3061-b2ad-3e74f81dab8c",
                                                "text": "\"Max was brake testing me into the first two corners. I was very upset with the fact Max held me up and didn't move and made me run into Daniel.\""
