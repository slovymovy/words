    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca405acc-c68a-32b5-9cd4-68c9dc49a05e",
                    "sense_definition": "Morceau de caoutchouc ou de matière plastique servant à effacer des traits de crayon ou d'encre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fourniture_scolaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève utilise une <w>gomme</w> pour corriger les fautes écrites au crayon."
                        },
                        {
                            "text": "N'oublie pas de mettre une <w>gomme</w> et un taille-crayon dans ta trousse."
                        }
                    ],
                    "synonyms": [
                        "efface"
                    ],
                    "common_phrases": [
                        "gomme à effacer",
                        "coup de gomme"
                    ]
                },
                {
                    "sense_id": "44a54691-3c9a-3ccf-bf2e-a7413d9791ec",
                    "sense_definition": "Confiserie élastique aromatisée que l'on mâche longuement sans l'avaler.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "confiserie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore mâcher de la <w>gomme</w> à la menthe pendant les longs trajets en voiture."
                        },
                        {
                            "text": "Les enfants ont acheté des paquets de <w>gommes</w> colorées à l'épicerie du quartier."
                        }
                    ],
                    "synonyms": [
                        "chewing-gum",
                        "chiclette",
                        "gomme à mâcher"
                    ],
                    "common_phrases": [
                        "gomme à mâcher",
                        "mâcher de la gomme"
                    ]
                },
                {
                    "sense_id": "050a25e5-032f-3cb2-866b-3f2db80d3cf1",
                    "sense_definition": "Matière élastique et résistante, naturelle ou synthétique, utilisée notamment pour fabriquer des pneus ou des semelles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pneus de cette voiture possèdent une <w>gomme</w> très tendre pour mieux adhérer à la piste."
                        },
                        {
                            "text": "La semelle de ces chaussures de randonnée est faite d'une <w>gomme</w> particulièrement robuste."
                        }
                    ],
                    "common_phrases": [
                        "gomme tendre"
                    ]
                },
                {
                    "sense_id": "464b61f2-5da1-3acd-96dc-abbd024bda9b",
                    "sense_definition": "Substance visqueuse sécrétée par certains arbres, durcissant à l'air et employée comme liant ou épaississant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'industrie alimentaire emploie souvent la <w>gomme</w> arabique pour stabiliser les sauces et les boissons."
                        },
                        {
                            "text": "Un liquide doré semblable à de la <w>gomme</w> s'échappait de l'écorce blessée de l'arbre."
                        }
                    ],
                    "common_phrases": [
                        "gomme arabique"
                    ]
                },
                {
                    "sense_id": "14b25527-48d8-31bb-ab1b-aacc16b444f2",
                    "sense_definition": "Substance adhésive appliquée au dos d'un timbre ou d'une enveloppe et réactivée par humidification.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adhesif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut humidifier la <w>gomme</w> du timbre avant de le coller sur la lettre."
                        },
                        {
                            "text": "La <w>gomme</w> de cette vieille enveloppe a séché et ne colle plus du tout."
                        }
                    ]
                }
            ]
        },
