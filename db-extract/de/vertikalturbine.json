                ],
                "senses": [
                    {
                        "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                        "entry_id": "1dfd22cd-b0de-378a-9a10-5a64e21ea91e",
                        "glosses": [
                            "Strömungsmaschine mit achsparalleler Rotation, welche die kinetische Energie des Windes in elektrischen Strom umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6671b92-9158-4688-aa6f-e8ae3f95190f",
                                "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                                "text": "„Meist handelt es sich dabei um Vertikalturbinen, die sehr leise sind und bereits bei geringen Windgeschwindigkeiten anspringen.“"
                            },
                            {
                                "example_id": "ead93693-f0e3-400b-8b21-c4c527f197df",
                                "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                                "text": "„Je nachdem die Welle einer Turbine wagrecht oder senkrecht angeordnet ist, erhält man eine ‚Horizontalturbine’, oder eine ‚Vertikalturbine’ […].“"
                            },
                            {
                                "example_id": "ba97774a-e562-4d28-9592-ad02575895f7",
                                "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                                "text": "„Sobald die Gefällehöhe den Einbau horizontaler Turbinen erlaubt, treten diese mit den Vertikalturbinen in Wettbewerb.“"
                            },
                            {
                                "example_id": "98acfb6a-1552-4b39-ac43-6ec78b70879b",
                                "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                                "text": "„Kürzlich sind abermals vier Vertikalturbinen von je 120 Pferdekräften aufgestellt und die beiden alten 30-pferdigen durch 2 von je 100 Pferdekräften ersetzt, so dass nunmehr im Ganzen 880 Pferdekräfte vorhanden sind.“"
                            },
                            {
                                "example_id": "92a00785-d102-4db3-8bc8-cf49dcc343eb",
                                "sense_id": "78d02766-3f5e-3714-9146-bd1912378c9c",
                                "text": "„Die Turbinenanlage Derendingen ist mit einer Vertikalturbine nit Blechsaugrohr und Betonspiralgehäuse (Fig. 2) ausgestattet, welche für 8 m Gefälle, 7 m/s und 187,5 Umdr. entworfen ist und 600 PS leistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
