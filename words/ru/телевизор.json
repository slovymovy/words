                {
                    "sense_id": "fc379bea-cb2d-3b1d-b39e-e9160a858547",
                    "sense_definition": "Плоская рыболовная сеть небольшого размера, используемая как ловушка для рыбы.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fishing_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рыбаки незаконно ставили <w>телевизоры</w> в тихой заводи реки.",
                            "target_lang_translations": {
                                "en": "Fishermen illegally set <w>screen nets</w> in the quiet backwater of the river.",
                                "nl": "Vissers plaatsten illegaal <w>visnetten</w> in de stille inham van de rivier."
                            }
                        },
                        {
                            "text": "Для ловли живца он использовал самодельный <w>телевизор</w>.",
                            "target_lang_translations": {
                                "en": "He used a homemade <w>fishing screen</w> to catch bait.",
                                "nl": "Voor het vangen van aasvisjes gebruikte hij een zelfgemaakt <w>visnet</w>."
                            }
                        }
