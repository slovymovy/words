                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al <w>opbouwend</w> leerden de technici hoe het nieuwe apparaat precies werkte.",
                            "target_lang_translations": {
                                "ru": "<w>В процессе сборки</w> техники поняли, как именно работает новое устройство."
