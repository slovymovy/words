    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                "word": "Spiritism",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a29c5ca-e65f-3623-8b34-a3dea5d0a559",
                        "entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                        "glosses": [
                            "A philosophical doctrine, established in France in the mid nineteenth century, postulating that humans are essentially immortal spirits that temporarily inhabit physical bodies, and may have influence on the physical world."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8357d5e4-882d-4b51-aec8-13ec3e678a09",
                        "source_entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                        "source_sense_id": "9a29c5ca-e65f-3623-8b34-a3dea5d0a559",
                        "source_sense_description": "philosophical doctrine",
                        "target_lang_word": "spiritismus",
                        "target_lang_code": "cs",
