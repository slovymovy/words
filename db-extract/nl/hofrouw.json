                        "glosses": [
                            "rouw door de koninklijke familie bij het overlijden van een lid van het koninklijk huis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a8d4d6-6d4a-4d55-99c6-a33d2b40b0bc",
                                "sense_id": "0050ec85-2075-31a4-ba8a-5d893c0c1f60",
                                "text": "Na het overlijden van prins Claus in 2002 koos de koninklijke familie voor hofrouw. Wel gingen er stemmen op om een dag van nationale rouw in te stellen, een dag waarop het openbare leven in Nederland volledig stilligt."
                            },
                            {
                                "example_id": "353e288b-c724-4cf4-87d2-c14ec9d2414b",
                                "sense_id": "0050ec85-2075-31a4-ba8a-5d893c0c1f60",
                                "text": "Het Koninklijk Huis heeft hofrouw aangenomen tot en met de dag van bijzetting in de koninklijke grafkelder in Delft. Tot Kerstmis is er familierouw."
                            }
                        ]
                    }
