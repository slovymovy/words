    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                    "sense_definition": "Gevoel van bewondering en eerbied voor iemands kwaliteiten of prestaties; respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trainer is sterk gestegen in mijn <w>achting</w> na de overwinning.",
                            "target_lang_translations": {
                                "en": "The coach has risen greatly in my <w>esteem</w> after the victory."
                            }
                        },
                        {
                            "text": "De held werd met veel <w>achting</w> behandeld door de dorpsbewoners.",
                            "target_lang_translations": {
                                "en": "The hero was treated with great <w>respect</w> by the villagers."
                            }
                        }
                    ],
                    "synonyms": [
                        "waardering"
                    ],
                    "common_phrases": [
                        "in achting stijgen",
                        "met veel achting"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of admiration and reverence for someone's qualities or achievements; respect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "esteem",
                                "target_lang_sense_clarification": "favourable regard or respect"
                            },
                            {
                                "target_lang_word": "respect",
                                "target_lang_sense_clarification": "admiration for someone's qualities"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "esteem or respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc07b01-cadb-31f7-9590-897985fb7f0a",
                    "sense_definition": "De mening of het oordeel dat men over iets of iemand heeft; waardering of inschatting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oordeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn lage <w>achting</w> voor de moderne kunst is betreurenswaardig.",
                            "target_lang_translations": {
                                "en": "His low <w>regard</w> for modern art is regrettable."
                            }
                        },
                        {
                            "text": "Zij heeft een hoge <w>achting</w> van haar eigen capaciteiten.",
                            "target_lang_translations": {
                                "en": "She has a high <w>estimation</w> of her own abilities."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lage achting",
                        "hoge achting"
                    ],
                    "target_lang_definitions": {
                        "en": "The opinion or judgment that one has about something or someone; appreciation or estimation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "esteem",
                                "target_lang_sense_clarification": "estimation or opinion of value"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "opinion or estimation"
                            },
                            {
                                "target_lang_word": "estimation",
                                "target_lang_sense_clarification": "judgment or opinion of worth"
                            }
                        ]
                    }
                }
            ]
