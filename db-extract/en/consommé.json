    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1c96d3cc-2fac-3823-8425-3dd6cf6774bb",
                "word": "consommé",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8b9d2d5-fe90-41f2-8ce1-07ab00db4e54",
                        "entry_id": "1c96d3cc-2fac-3823-8425-3dd6cf6774bb",
                        "tags": [
                            "plural"
                        ],
                        "form": "consommés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9165a5a4-4b73-3381-9363-6cf2e2bf1452",
                        "entry_id": "1c96d3cc-2fac-3823-8425-3dd6cf6774bb",
                        "glosses": [
                            "a clear broth made from reduced meat or vegetable stock, served either hot as a soup or chilled as a jelly"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1d0a32e-ba26-43c3-9444-a026fddfa7ec",
                                "sense_id": "9165a5a4-4b73-3381-9363-6cf2e2bf1452",
                                "text": "For after washing at the hotel at Patras, Jacob had followed the tram lines a mile or so out; and followed them a mile or so back; he had met several droves of turkeys; several strings of donkeys; had got lost in back streets; had read advertisements of corsets and Maggi's consommé; children had trodden on his toes; the place smelt of bad cheese; and he was glad to find himself suddenly come out opposite his hotel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce8963c6-4421-4d37-94c5-4ca2dd912606",
                        "source_entry_id": "1c96d3cc-2fac-3823-8425-3dd6cf6774bb",
                        "source_sense_id": "9165a5a4-4b73-3381-9363-6cf2e2bf1452",
                        "source_sense_description": "a clear broth made from reduced meat or vegetable stock",
                        "target_lang_word": "consommé",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consommé",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0bb495-ffe0-340f-8ba1-49540a36087c",
                                        "entry_id": "48f8fb7a-ec95-3a59-ad2f-97af2c5628cd",
                                        "glosses": [
                                            "een geheel ontvette bouillon die helder is gemaakt (en waaraan een bepaalde garnituur is toegevoegd)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8c6a73-45f4-4d70-b0d6-2971743ff37e",
                                                "sense_id": "9f0bb495-ffe0-340f-8ba1-49540a36087c",
                                                "text": "Een consommé van ossenstaart."
                                            },
                                            {
                                                "example_id": "17c0baaf-535a-45f3-af05-e8fb0a226510",
                                                "sense_id": "9f0bb495-ffe0-340f-8ba1-49540a36087c",
                                                "text": "Een consommé van duif (12 euro per liter) bevestigt dat Dhooge veel intensiteit in het bord kan brengen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2332147d-7e12-4ec8-aa1a-10b1e978f56b",
                        "source_entry_id": "1c96d3cc-2fac-3823-8425-3dd6cf6774bb",
                        "source_sense_id": "9165a5a4-4b73-3381-9363-6cf2e2bf1452",
                        "source_sense_description": "a clear broth made from reduced meat or vegetable stock",
                        "target_lang_word": "consommé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consommé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                        "entry_id": "7849f331-2ab4-3443-b93f-f6b4e0aac337",
                                        "glosses": [
                                            "Bouillon de viande (bœuf, volaille, gibier, poisson) réduit et parfois lié au jaune d’œuf ; les consommés se servent froid ou chaud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ce0622-24a5-4dcf-97d3-1e40ab5dcab5",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "Dans sa chambre, comme en-cas pour la nuit, on lui tenait préparée une tasse de consommé froid."
                                            },
                                            {
                                                "example_id": "ae78b80e-0ff9-4d01-b7a2-c1dfe7c068b1",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "S’il dort, je pose là une tasse de consommé et m’en vais, sans prendre la peine d’ouater mon pas."
                                            },
                                            {
                                                "example_id": "a635b458-3381-467c-b806-c04f4facd21b",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "Faire un consommé."
                                            },
                                            {
                                                "example_id": "be47f539-2c16-4961-a258-b5fe4d90ac64",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "Prendre un consommé."
                                            },
                                            {
                                                "example_id": "4d4d66a3-daeb-4c47-8f84-4858397ce8ab",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "Il ne vit que de consommés."
                                            },
                                            {
                                                "example_id": "dcc5cb57-7563-481d-9ad7-24a4d2a0f4e2",
                                                "sense_id": "aae10e7f-a6b3-3ea7-a941-207cd6bb948c",
                                                "text": "On obtient ainsi par ébullition prolongée de 3 à 4 heures un consommé, c’est-à-dire un bouillon qui contient bon nombre des principes de la viande."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consommé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9599b996-c25b-3209-becc-27a1b50dfe77",
                                        "entry_id": "e3b71652-aab8-3180-934a-4cd3d90c1a8f",
                                        "glosses": [
                                            "Presque parfait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4251cf8b-ed6e-48fd-bf35-a03e6e81df51",
                                                "sense_id": "9599b996-c25b-3209-becc-27a1b50dfe77",
                                                "text": "Hélène guidait en effet ses deux complices vers le tramway d’Enghien et, avec une habileté consommée, s’arrangeait pour que leur présence ne pût être remarquée de personne."
                                            },
                                            {
                                                "example_id": "8a405299-393e-4900-8dde-1166f404332d",
                                                "sense_id": "9599b996-c25b-3209-becc-27a1b50dfe77",
                                                "text": "Sagesse, prudence consommée."
                                            },
                                            {
                                                "example_id": "b1c14de6-48b3-4149-869e-d1dc3ba518e3",
                                                "sense_id": "9599b996-c25b-3209-becc-27a1b50dfe77",
                                                "text": "Vertu, science consommée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                        "entry_id": "e3b71652-aab8-3180-934a-4cd3d90c1a8f",
                                        "glosses": [
                                            "Très expérimenté dans un art, dans une science."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0ffb447-f5f4-4670-a60b-bd601ca46a43",
                                                "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                                "text": "Chaque cirque possède, en outre, un maître de manège, appelé chef de piste ou chef d'équitation, qui a la responsabilité de la cavalerie. Écuyer consommé, le dressage en liberté ou en haute école ne doit avoir pour lui aucun secret."
                                            },
                                            {
                                                "example_id": "2f68cc7a-fce5-47a4-aea6-6ce15216f32d",
                                                "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                                "text": "Il était évident que j’avais devant moi des juristes consommés, en même temps que des hommes d’expérience, et auxquels on ne raconte pas d’histoires."
                                            },
                                            {
                                                "example_id": "70a5f580-8733-4d3a-a222-bfce670c019c",
                                                "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                                "text": "Le vieil accordeur de Villegrande, aveugle comme de juste, et qui jouit d’une réputation de musicien consommé, est parvenu à lui rendre peu à peu la plupart de ses notes."
                                            },
                                            {
                                                "example_id": "070e727f-447c-4e05-8af8-2a20b9f28d0c",
                                                "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                                "text": "[…]: Stendhal a montré, dans Lucien Leuwen, qu'en 1835, la monarchie parlementaire et bourgeoise de Louis-Philippe, pratiquait avec un art consommé toutes les turpitudes imaginables : on achetait l'élection d'un député avec cent mille francs, quelques nominations, quelques bureaux de tabac, […]."
                                            },
                                            {
                                                "example_id": "03bdd948-0ec5-4c0c-8022-92ed063daf52",
                                                "sense_id": "0bea2b8f-bc63-3dd1-9696-582269f50494",
                                                "text": "Tacite le sait, il ne dit d’ailleurs pas vraiment le contraire, mais fidèle à son habitude générale il manie le sous-entendu avec un art consommé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consommé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ae6c15-fa72-39cd-9487-d134fd337e96",
                                        "entry_id": "3bd6de13-b140-38b9-a2c9-c24a514ce282",
                                        "glosses": [
                                            "Participe passé masculin singulier de consommer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bf7436-bf2d-4ece-a8dc-dfa8856ff7d4",
                                                "sense_id": "d2ae6c15-fa72-39cd-9487-d134fd337e96",
                                                "text": "Le ferrochrome est principalement consommé par les producteurs d’aciers fins et spéciaux."
                                            },
                                            {
                                                "example_id": "83929bda-30de-4a41-b42a-9043989d61e8",
                                                "sense_id": "d2ae6c15-fa72-39cd-9487-d134fd337e96",
                                                "text": "Le mariage y fut, dit-on, consommé, et il continua à la greluchonner pendant quelque temps ; souvent même il était réduit à se cacher ou à se dérober par une fausse porte lorsque le président, qui en savait bien quelque chose et qui était assez fou pour lutter contre lui, arrivait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
