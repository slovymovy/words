                {
                    "sense_id": "1c5fe07a-5f06-380d-9a8c-a14ed658cd3d",
                    "sense_definition": "Stan dobrych relacji między ludźmi, brak kłótni i konfliktów.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej kłótni wreszcie zapanowała między nimi <zgoda>.",
                            "target_lang_translations": {
                                "ru": "После долгой ссоры между ними наконец воцарилось <согласие>.",
                                "en": "After a long argument, <harmony> finally prevailed between them.",
                                "nl": "Na een lange ruzie heerste er eindelijk weer <eendracht> tussen hen.",
                                "de": "Nach einem langen Streit herrschte endlich wieder <w>Eintracht</w> zwischen ihnen.",
                                "fr": "Après une longue dispute, la <concorde> a enfin régné entre eux.",
                                "it": "Dopo un lungo litigio, tra loro è finalmente tornata l'<armonia>.",
                                "cs": "Po dlouhé hádce mezi nimi konečně zavládl <w>smír</w>.",
                                "tr": "Uzun bir kavgadan sonra nihayet aralarında <barış> sağlandı.",
                                "es": "Después de una larga pelea, finalmente reinó la <w>armonía</w> entre ellos."
                            }
                        },
                        {
                            "text": "Sąsiedzi podali sobie ręce na <zgodę> i zakończyli spór.",
                            "target_lang_translations": {
                                "ru": "Соседи пожали друг другу руки в знак <примирения> и закончили спор.",
                                "en": "The neighbors shook hands in <reconciliation> and ended the dispute.",
                                "nl": "De buren schudden elkaar de hand als teken van <verzoening> en beëindigden het geschil.",
                                "de": "Die Nachbarn gaben sich zur <w>Versöhnung</w> die Hände und beendeten den Streit.",
                                "fr": "Les voisins se sont serré la main en signe de <réconciliation> et ont mis fin au conflit.",
                                "it": "I vicini si sono stretti la mano in segno di <pace> e hanno posto fine alla disputa.",
                                "cs": "Sousedé si podali ruce na <w>usmířenou</w> a ukončili spor.",
                                "tr": "Komşular <anlaşmak> üzere el sıkıştılar ve tartışmayı bitirdiler.",
                                "es": "Los vecinos se dieron la mano en señal de <w>reconciliación</w> y terminaron la disputa."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmonia"
                    ],
                    "antonyms": [
                        "kłótnia",
                        "konflikt"
                    ],
                    "common_phrases": [
