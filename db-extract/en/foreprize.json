                "senses": [
                    {
                        "sense_id": "69209b24-c1ba-3830-b13d-1efc8e67830c",
                        "entry_id": "968e824c-f87f-3c41-a89b-ccf3e3b8e727",
                        "glosses": [
                            "To assume, take for granted; to provide for beforehand; to anticipate."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1d946293-7b44-4b22-a054-c7edce43f2f4",
                                "sense_id": "69209b24-c1ba-3830-b13d-1efc8e67830c",
                                "text": "[…] God hath foreprized things of the greatest weight, and hath therein precisely defined, as well that which euery man must performe, as that which no man may attempt […]"
                            },
                            {
                                "example_id": "ee06e1fa-7032-4e71-81cc-eb9f426b0134",
                                "sense_id": "69209b24-c1ba-3830-b13d-1efc8e67830c",
                                "text": "I denied that Bishops had authority to prescraibe Conditions to Kings, when they Crowned them; but I never denyed that the People might preserve the foundation, freedome, and forme of their Common-wealth, which they foreprized when they first consented to have a King."
                            },
                            {
                                "example_id": "e87226e6-8118-4eeb-925c-de14cabc2b40",
                                "sense_id": "69209b24-c1ba-3830-b13d-1efc8e67830c",
                                "text": "Excepted, and always Foreprized out of this Our Pardon, all Treasons committed or done in the Parts beyond the Seas, or in any other Place out of this Our Realm […]"
                            }
                        ]
                    }
                ],
