                    },
                    {
                        "translation_id": "1c033218-2d61-48ac-8e53-741f77d66ea9",
                        "source_entry_id": "844497f8-e130-3582-9ee1-f4f3c0fb92b8",
                        "source_sense_description": "museum which displays images of space",
                        "target_lang_word": "Planetarium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Planetarium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e568e59-23a3-3996-9e39-db96689ea958",
                                        "entry_id": "bfeb53d8-af86-3aef-b4c8-b0256880256f",
                                        "glosses": [
                                            "ein Gebäude mit halbkugelförmiger Kuppel, auf deren Innenfläche verschiedene Projektionen über die Erde und das Universum simulierend veranschaulicht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739209ee-384b-4301-a74e-50ad740368c8",
                                                "sense_id": "7e568e59-23a3-3996-9e39-db96689ea958",
                                                "text": "„Ein Planetarium gehört zum Komplex dazu. Es ermöglicht vom nächsten Jahr an den Blick auf den Himmel, wie ihn die Menschen in der frühen Bronzezeit gesehen haben.“"
                                            },
                                            {
                                                "example_id": "3ada69bc-c8ba-40ce-a254-039eef87c5fa",
                                                "sense_id": "7e568e59-23a3-3996-9e39-db96689ea958",
                                                "text": "„In vielen Städten gibt es öffentliche Planetarien mit Präsentationen für alle Altersgruppen.“"
                                            },
                                            {
                                                "example_id": "14e3e51e-c745-4fd6-94bc-f8967957d1e4",
                                                "sense_id": "7e568e59-23a3-3996-9e39-db96689ea958",
                                                "text": "„Das Planetarium war schön und groß, angenehm kühl im Sommer, beheizt im Winter, und das Jahresabo kostete weniger als die Jahreskarte für die Straßenbahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
