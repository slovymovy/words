                                            {
                                                "example_id": "8311ea2a-c7a0-4c91-9e56-87f686845613",
                                                "sense_id": "3f5bb95e-62c8-3b50-b9ef-c7c488259c03",
                                                "text": "„Sie warf einen Blick auf den blitzenden Regulator an der Wand und fragte: »Wirst du's noch bis zu deiner Schicht schaffen?«.“"
                                            },
