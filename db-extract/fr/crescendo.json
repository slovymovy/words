                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a94afad4-b907-3bfd-92e6-e3c2b249edbb",
                                        "entry_id": "74f7fc81-f7b5-3fce-b4f9-e7e57dbfbe5e",
                                        "glosses": [
                                            "To increase in intensity; to reach or head for a crescendo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
