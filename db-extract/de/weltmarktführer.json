                    {
                        "sense_id": "1e08b70c-a3fc-3b86-b965-dea965aebe73",
                        "entry_id": "40bc188f-9104-3878-8623-79bbc6f96c14",
                        "glosses": [
                            "Unternehmen oder Unternehmer, die im weltweiten internationalen Handel deutlich stärker vertreten sind als ihre Konkurrenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e25f65f-9df8-45ad-af5c-df161f836954",
                                "sense_id": "1e08b70c-a3fc-3b86-b965-dea965aebe73",
                                "text": "„Mit seinen Tankern gehörte er lange zu den Weltmarktführern und seine Familie in die Liga der Reichsten.“"
                            },
                            {
                                "example_id": "c2b2d95b-f357-4fe2-9477-9cae2db0e176",
                                "sense_id": "1e08b70c-a3fc-3b86-b965-dea965aebe73",
                                "text": "„Dann wurde Nokia Weltmarktführer im Bereich Mobiltelefone, der Ursprungswert der Aktien von 10000 Euro vervielfachte sich explosionsartig.“"
                            },
                            {
                                "example_id": "f3911444-3f0b-47fe-9cf4-2818a5a5ae1a",
                                "sense_id": "1e08b70c-a3fc-3b86-b965-dea965aebe73",
                                "text": "„Der Weltmarktführer in der Prothetik, bei Orthesen und Rollstühlen engagiert sich im Behindertensport und ist seit mehr als 30 Jahren der Topsponsor bei paralympischen Sommer- und Winterspielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
