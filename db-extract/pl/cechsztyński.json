                "senses": [
                    {
                        "sense_id": "137b3afb-ad97-3b78-ada7-3d6d5edb57a7",
                        "entry_id": "26a952a2-5375-3328-b390-5eb291004017",
                        "glosses": [
                            "od cechsztyn"
                        ],
                        "tags": [
                            "adjective"
                        ],
                        "examples": [
                            {
                                "example_id": "eecd9c90-3ba0-48d7-a5a5-9139625a3691",
                                "sense_id": "137b3afb-ad97-3b78-ada7-3d6d5edb57a7",
                                "text": "Groźne dla środowiska mogą być wypływy solanek ze złóż cechsztyńskich, położonych stosunkowo płytko pod dnem"
                            },
                            {
                                "example_id": "d35ef897-11b3-4beb-a7f5-a4caa00d1f09",
                                "sense_id": "137b3afb-ad97-3b78-ada7-3d6d5edb57a7",
                                "text": "Natomiast w rejonie Międzychodu, w permskich utworach dolomitu głównego i wapienia cechsztyńskiego, zostały odkryte złoża ropy, a odwierty przeprowadzone zostały w Grotowie, Sowiej Górze i Sierakowie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
