    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                    "sense_definition": "A lengthy, aggressive, and critical speech or rant, whether delivered orally or in writing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech_criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager subjected the entire team to a furious <w>harangue</w> after the project missed its deadline."
                        },
                        {
                            "text": "She gave her son a long <w>harangue</w> about the dangers of playing near the busy street."
                        }
                    ],
                    "synonyms": [
                        "diatribe",
                        "polemic",
                        "rant",
                        "screed",
                        "tirade"
                    ],
                    "common_phrases": [
