                "senses": [
                    {
                        "sense_id": "a1265740-431a-3eea-9af3-2bca91cd8fb4",
                        "entry_id": "a2f9a82a-d09a-3689-b5fb-103e45bc10f9",
                        "glosses": [
                            "złota moneta w Rosji carskiej, wartości 10-15 rubli srebrnych, będąca w obiegu w latach 1755–1917"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e89e00-f0b6-4a65-8052-fbd56a0319b5",
                                "sense_id": "a1265740-431a-3eea-9af3-2bca91cd8fb4",
                                "text": "Niosła ze sobą złote i srebrne przedmioty, złote imperiały i srebrne ruble"
                            },
                            {
                                "example_id": "ee88c2e8-4122-471a-a89e-d42ff590176d",
                                "sense_id": "a1265740-431a-3eea-9af3-2bca91cd8fb4",
                                "text": "Staranny egzamin portmonetki nie wykazał więcej nad jednego rubla, jednego imperiała i kilku sztuk drobnej monety"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1809189f-4bd7-3f2b-90ed-9e4c17b2ecb6",
                        "entry_id": "a2f9a82a-d09a-3689-b5fb-103e45bc10f9",
                        "glosses": [
                            "wierzch dyliżansu pocztowego lub omnibusu konnego z miejscami pasażerskimi"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a99d465d-103f-4bb6-8382-d17f8d9e0616",
                                "sense_id": "1809189f-4bd7-3f2b-90ed-9e4c17b2ecb6",
                                "text": "Nie znajdując dla siebie dogodniejszego miejsca, zmuszony był podróżować na imperiale."
                            }
                        ],
