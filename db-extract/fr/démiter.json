                ],
                "senses": [
                    {
                        "sense_id": "1c33d1b9-bc56-35c1-946f-c8322c579f28",
                        "entry_id": "d2910fb6-cc5a-34d4-85dd-817bb62c475e",
                        "glosses": [
                            "Débarrasser des mites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38e96e8-846e-4c81-843e-417da3cd3481",
                                "sense_id": "1c33d1b9-bc56-35c1-946f-c8322c579f28",
                                "text": "On entend parfois les protestations de ceux qui écrivent ou lisent, et qui ne comprennent pas pourquoi il faut précisément capturer des coléoptères sur leur lettre ou leur livre, ou pourquoi ils doivent tout à coup rester immobiles pour se laisser « démiter »."
                            },
                            {
                                "example_id": "e0afb0bb-4a52-482a-9b73-40b39dbdfe7e",
                                "sense_id": "1c33d1b9-bc56-35c1-946f-c8322c579f28",
                                "text": "Je fais partie du service qui s'occupe de démiter les maisons."
                            },
                            {
                                "example_id": "74493e7f-f04c-4d4b-8ee2-3bf198fb9434",
                                "sense_id": "1c33d1b9-bc56-35c1-946f-c8322c579f28",
                                "text": "Donc vous avez là, la bonne stratégie pour démiter vos placards, tiroirs, boîtes, etc."
                            },
                            {
                                "example_id": "d2b74b48-0de6-4536-a49c-348f7d9cf23a",
                                "sense_id": "1c33d1b9-bc56-35c1-946f-c8322c579f28",
                                "text": "Moi qui ne savait^([sic]) pas quoi faire pendant mes vacances, je pense que je pourrai passer une petite semaine à \"démiter\" tous mes terras."
                            }
                        ]
                    }
                ],
