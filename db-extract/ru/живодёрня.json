                "senses": [
                    {
                        "sense_id": "de1c6ef8-cb67-3a39-9921-0e9dbad6bfc3",
                        "entry_id": "dac85281-c767-3686-a373-8b37e7ee8490",
                        "glosses": [
                            "разг. место, где убивают животных"
