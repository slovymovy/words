                "senses": [
                    {
                        "sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                        "entry_id": "dc8b83d6-d0e8-3864-8f63-c444b61a4e19",
                        "glosses": [
                            "In a swift manner; quickly; with quick motion or velocity; fleetly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb5817a2-f362-44b7-8f49-7a2167716e2f",
                                "sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                                "text": "Mrs. Piper cut short these piracies by swiftly removing his spoon."
                            },
                            {
                                "example_id": "247de129-c98b-4894-a25f-5edf22f0dc6e",
                                "sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                                "text": "The head of the North Tyne is reached at Deadwater, 36 miles from Hexham. The river has its source just on the English side of the Border, at the foot of Peel Fell, the most westerly spur of the Cheviots. At first it is a sluggish stream (hence the name Deadwater) but begins to flow more swiftly before it reaches Kielder."
                            },
                            {
                                "example_id": "f46e5a28-b7e7-4b15-b189-b9274110164c",
                                "sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                                "text": "Strategic sites in even the remotest regions of the kingdom were swiftly fortified using forced labour."
                            },
                            {
                                "example_id": "b837054c-6da4-4011-a0a1-436547ee4421",
                                "sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                                "text": "[T]he early hostility of the Bulgarian supporters was swiftly subdued."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43d07ed7-3f81-4c18-9932-697b1d965ad6",
                        "source_entry_id": "dc8b83d6-d0e8-3864-8f63-c444b61a4e19",
                        "source_sense_id": "60e252bd-25a4-3133-a5ce-c58ce1d12d1b",
                        "source_sense_description": "quickly",
                        "target_lang_word": "schnell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schnell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                        "entry_id": "114ed30e-91d5-374e-994e-395936280b87",
                                        "glosses": [
                                            "eine hohe Geschwindigkeit habend, das Gegenteil von langsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045fc326-28cc-42d7-a12d-b99b14e97120",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "Heute nehme ich den schnelleren Zug."
                                            },
                                            {
                                                "example_id": "e0575021-cc49-4f37-b4aa-228ea1e5f57f",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "„Beim Bodyflying werden Sie durch einen 180 km/h schnellen Luftstrom aufwärts getrieben.“"
                                            },
                                            {
                                                "example_id": "efd9f32e-066d-4d26-9c29-a1b2973ab67c",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "Lass uns das schnellste Motorboot von allen hier mieten, wenn schon, denn schon, sag ich mal!"
                                            },
                                            {
                                                "example_id": "bbac28da-010d-46ab-8edc-e804c784489c",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "Sie wird mir viel zu schnell, gib ihr durch, dass sie langsamer werden soll!"
                                            },
                                            {
                                                "example_id": "1040ba25-66f9-4ef5-a782-1915bc53a3db",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "Sie ist wirklich schnell, kein anderer schafft soviel an einem Tag."
                                            },
                                            {
                                                "example_id": "11faa14e-89c8-44a2-b760-6085e69c8fad",
                                                "sense_id": "7833f2c0-39dd-3849-9da7-ca1941e27bd4",
                                                "text": "„UV-Strahlung lässt die Haut schneller altern und, noch wichtiger, erhöht maßgeblich das Hautkrebsrisiko.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4294a4e9-5c77-3123-baa7-0a105d55fe2e",
                                        "entry_id": "114ed30e-91d5-374e-994e-395936280b87",
                                        "glosses": [
                                            "nur vergleichsweise wenig Zeit beanspruchend, das Gegenteil von langwierig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ac50ebe-d571-482c-b1a1-f75487fb27c4",
                                                "sense_id": "4294a4e9-5c77-3123-baa7-0a105d55fe2e",
                                                "text": "Um überzeugen zu können, brauchen wir jetzt schnelle Erfolge!"
                                            },
                                            {
                                                "example_id": "0dd35d7e-096b-485e-8c8a-4d2b01adee0b",
                                                "sense_id": "4294a4e9-5c77-3123-baa7-0a105d55fe2e",
                                                "text": "Wir könnten uns zu einem schnellen Mittag in der Stadt treffen."
                                            },
                                            {
                                                "example_id": "05b40ff8-4268-4a45-b0c5-fedc1dcbb6ad",
                                                "sense_id": "4294a4e9-5c77-3123-baa7-0a105d55fe2e",
                                                "text": "Hallo Süßer, wie wäre es mit einer schnellen Nummer?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                        "entry_id": "114ed30e-91d5-374e-994e-395936280b87",
                                        "glosses": [
                                            "wenig Zeit benötigend"
                                        ],
                                        "tags": [
                                            "adverbielle Verwendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f75220-2eca-44a2-a614-cb6974a85021",
                                                "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                                "text": "Ich will nur noch schnell einen Happen essen."
                                            },
                                            {
                                                "example_id": "1bbe222f-ac0f-4b79-9ffb-ff096ce82d49",
                                                "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                                "text": "Kannst du mir schnell mal helfen?"
                                            },
                                            {
                                                "example_id": "ed844ae4-50ff-4190-8776-f265aa9480da",
                                                "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "412ad6fd-cce5-4467-ba6d-a994d3c9d50e",
                                                "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                                "text": "Die Arbeit ging schneller voran als erwartet."
                                            },
                                            {
                                                "example_id": "1c4fa800-fc85-479c-85a1-f3901c9c72d5",
                                                "sense_id": "bccc3a5e-cf95-3c78-9a59-9789ac49b533",
                                                "text": "„Beim Kunstfliegen geht es nicht darum, schnell an ein Ziel zu kommen, sondern Flugmanöver so spektakulär wie möglich auszuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "schnell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e81efa66-831c-3825-a3cc-8648068c7c46",
