{
    "word_family": [
        "wanding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df2ac24d-04f9-3d83-9c57-9ac3ab6e3078",
                    "sense_definition": "A thin, hand-held rod used by a magician to perform magic or by a conductor to direct an orchestra.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician waved his <w>wand</w> over the empty hat and a rabbit appeared.",
                            "target_lang_translations": {
                                "ru": "Фокусник взмахнул своей <w>палочкой</w> над пустой шляпой, и появился кролик."
                            }
                        },
                        {
                            "text": "She bought a new <w>magic</w> <w>wand</w> for her wizard costume.",
                            "target_lang_translations": {
                                "ru": "Она купила новую <w>волшебную</w> <w>палочку</w> для своего костюма волшебника."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod",
                        "staff"
                    ],
                    "common_phrases": [
                        "magic wand",
                        "wave a wand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий стержень, используемый фокусником для совершения магии или дирижером для управления оркестром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "волшебная или дирижерская"
                            },
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "символ власти или магический атрибут"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff544cbb-6c01-3114-88c2-ac555a986c58",
                    "sense_definition": "A hand-held tool or attachment shaped like a rod, used for tasks like cleaning or styling hair.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>curling</w> <w>wand</w> to create soft waves in her hair.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>плойку</w> для завивки, чтобы создать мягкие волны на волосах."
                            }
                        },
                        {
                            "text": "The vacuum cleaner comes with a long <w>wand</w> to reach high corners.",
                            "target_lang_translations": {
                                "ru": "Пылесос поставляется с длинной <w>трубкой-насадкой</w>, чтобы дотягиваться до высоких углов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curling wand",
                        "vacuum wand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент или насадка в форме стержня, используемые для таких задач, как уборка или укладка волос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насадка",
                                "target_lang_sense_clarification": "трубка пылесоса"
                            },
                            {
                                "target_lang_word": "плойка",
                                "target_lang_sense_clarification": "для завивки волос"
                            },
                            {
                                "target_lang_word": "стержень",
                                "target_lang_sense_clarification": "основание прибора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3df09df6-911c-39cb-824f-bcf408deb04f",
                    "sense_definition": "A small, flexible branch or twig, especially from a willow tree.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basket was woven from thin <w>wands</w> of willow.",
                            "target_lang_translations": {
                                "ru": "Корзина была сплетена из тонких ивовых <w>прутьев</w>."
                            }
                        },
                        {
                            "text": "He cut a <w>willow</w> <w>wand</w> from the tree to use as a switch.",
                            "target_lang_translations": {
                                "ru": "Он срезал ивовый <w>прут</w> с дерева, чтобы использовать его как розгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod"
                    ],
                    "common_phrases": [
                        "willow wand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая гибкая ветка или прут, особенно ивовый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прут",
                                "target_lang_sense_clarification": "гибкая ветка"
                            },
                            {
                                "target_lang_word": "розга",
                                "target_lang_sense_clarification": "тонкий прут для порки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20fc106b-7163-3f1f-a02d-749c62d53790",
                    "sense_definition": "A player's foot that is used with exceptional skill or precision, particularly in football.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The midfielder has a <w>wand</w> of a left foot and can pass the ball anywhere.",
                            "target_lang_translations": {
                                "ru": "У полузащитника <w>волшебная</w> левая нога, и он может отдать пас в любую точку поля."
                            }
                        },
                        {
                            "text": "He scored a brilliant goal using his <w>wand</w> of a right foot.",
                            "target_lang_translations": {
                                "ru": "Он забил блестящий гол своей <w>невероятной</w> правой ногой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wand of a foot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in sports journalism and fan commentary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нога игрока, обладающая исключительным мастерством или точностью, особенно в футболе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волшебная нога",
                                "target_lang_sense_clarification": "о мастерстве футболиста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47a8853a-7d3a-3a57-b719-caa608ac5738",
                    "sense_definition": "One of the four suits of the minor arcana in a tarot deck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tarot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Ace of <w>Wands</w> often represents new beginnings and creative energy.",
                            "target_lang_translations": {
                                "ru": "Туз <w>Жезлов</w> часто олицетворяет новые начинания и творческую энергию."
                            }
                        },
                        {
                            "text": "She drew a card from the suit of <w>wands</w> during the reading.",
                            "target_lang_translations": {
                                "ru": "Во время гадания она вытянула карту из масти <w>жезлов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suit of wands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из четырех мастей младших арканов в колоде Таро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жезлы",
                                "target_lang_sense_clarification": "масть Таро"
                            },
                            {
                                "target_lang_word": "скипетры",
                                "target_lang_sense_clarification": "альтернативное название масти"
                            },
                            {
                                "target_lang_word": "посохи",
                                "target_lang_sense_clarification": "в контексте Таро"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23989aee-046e-370c-8b7b-a79b49db8e6e",
                    "sense_definition": "To check someone for hidden metal objects using a hand-held electronic scanner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard had to <w>wand</w> the passengers before they entered the gate.",
                            "target_lang_translations": {
                                "ru": "Охраннику пришлось <w>проверить</w> пассажиров металлоискателем перед тем, как они прошли к выходу на посадку."
                            }
                        },
                        {
                            "text": "I was <w>wanded</w> at the airport because my belt set off the alarm.",
                            "target_lang_translations": {
                                "ru": "Меня <w>просканировали</w> в аэропорту, потому что мой ремень вызвал сигнал тревоги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проверять кого-либо на наличие скрытых металлических предметов с помощью ручного электронного сканера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сканировать",
                                "target_lang_sense_clarification": "ручным металлоискателем"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "детектором"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f01ca3f-43e6-3c9b-a614-84808a1a6d94",
                    "sense_definition": "To use a hand-held vibrator on a person or a specific part of the body.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist explained how to <w>wand</w> the sore muscles for relief.",
                            "target_lang_translations": {
                                "ru": "Терапевт объяснил, как <w>массировать</w> больные мышцы для облегчения."
                            }
                        },
                        {
                            "text": "She decided to <w>wand</w> her neck to ease the tension.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пройтись</w> массажером по шее, чтобы снять напряжение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in a sexual context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать ручной вибратор на человеке или определенной части тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "массировать",
                                "target_lang_sense_clarification": "вибромассажером"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4dcef5f2-c601-30e5-9f7d-3885df736448",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wand</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уонд</w> живет в этом районе уже более двадцати лет."
                            }
                        },
                        {
                            "text": "The local library was named after the <w>Wand</w> family.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Уонд</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уонд",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}