            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8982cbe0-fc38-3f6c-827b-8db128f6f4e3",
                    "sense_definition": "Op vaste momenten of vaak terugkerend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij gaan <w>regelmatig</w> naar de bioscoop om een film te kijken.",
                            "target_lang_translations": {
                                "en": "We <w>regularly</w> go to the cinema to watch a movie.",
                                "ru": "Мы <w>регулярно</w> ходим в кино, чтобы посмотреть фильм.",
                                "pl": "Chodzimy <w>regularnie</w> do kina, żeby obejrzeć film.",
                                "de": "Wir gehen <w>regelmäßig</w> ins Kino, um einen Film zu schauen.",
                                "fr": "Nous allons <w>régulièrement</w> au cinéma pour regarder un film.",
                                "it": "Andiamo <w>regolarmente</w> al cinema a guardare un film.",
                                "cs": "Chodíme <w>pravidelně</w> do kina na film.",
                                "tr": "Film izlemek için <w>düzenli olarak</w> sinemaya gideriz.",
                                "es": "Vamos <w>regularmente</w> al cine a ver una película.",
                                "zh": "我们<w>经常</w>去电影院看电影。"
                            }
                        },
                        {
                            "text": "Er wordt in dit gebouw <w>regelmatig</w> schoongemaakt.",
                            "target_lang_translations": {
                                "en": "This building is cleaned <w>regularly</w>.",
                                "ru": "В этом здании <w>регулярно</w> убирают.",
                                "pl": "W tym budynku <w>regularnie</w> sprząta się.",
                                "de": "In diesem Gebäude wird <w>regelmäßig</w> geputzt.",
                                "fr": "Ce bâtiment est nettoyé <w>régulièrement</w>.",
                                "it": "Questo edificio viene pulito <w>regolarmente</w>.",
                                "cs": "V této budově se <w>pravidelně</w> uklízí.",
                                "tr": "Bu bina <w>düzenli olarak</w> temizlenir.",
                                "es": "Este edificio se limpia <w>regularmente</w>.",
                                "zh": "这栋大楼会<w>定期</w>进行清洁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "geregeld",
                        "vaak"
                    ],
                    "antonyms": [
                        "onregelmatig"
                    ],
                    "common_phrases": [
                        "komt regelmatig voor",
                        "doe regelmatig"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening at fixed moments or recurring often.",
                        "ru": "Происходящий в установленные моменты или часто повторяющийся.",
                        "pl": "Dziejący się w ustalonych odstępach czasu lub często powtarzający się.",
                        "de": "In festen zeitlichen Abständen oder häufig wiederkehrend.",
                        "fr": "Qui se produit à des moments fixes ou qui revient souvent.",
                        "it": "Che accade a intervalli fissi o che si ripete spesso.",
                        "cs": "Dějící se v pevných intervalech nebo často se opakující.",
                        "tr": "Belirli zamanlarda veya sıkça tekrarlanan bir şekilde.",
                        "es": "Que ocurre en momentos fijos o con frecuencia.",
                        "zh": "在固定的时间或经常发生。"
                    },
