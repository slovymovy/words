                "senses": [
                    {
                        "sense_id": "ee80bd57-39ab-343e-b9ea-d451da91a64e",
                        "entry_id": "735c2003-f219-3209-935b-2bdd310d04bd",
                        "glosses": [
                            "Couvrir de gravillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bbf854f-270e-407e-a65b-70fab357e59f",
                                "sense_id": "ee80bd57-39ab-343e-b9ea-d451da91a64e",
                                "text": "« Nous avons dû engravillonner nous-mêmes les parcelles de concassé de notre emplacement, spécifie Nathan, afin de ne pas marcher dans la bouillasse avec la pluie et la neige fondue... »"
                            },
                            {
                                "example_id": "7fe13531-3002-4627-bc13-9d02459feed7",
                                "sense_id": "ee80bd57-39ab-343e-b9ea-d451da91a64e",
                                "text": "Pas moins de 35 camions benne ont été nécessaires pour ‘dégravillonner’ et ‘engravillonner’ l’espace."
                            },
                            {
                                "example_id": "5523dcb1-b4d7-4a22-8b27-865644b3652e",
                                "sense_id": "ee80bd57-39ab-343e-b9ea-d451da91a64e",
                                "text": "Soucieux de ne pas dénaturer le sol en le minéralisant, et conseillés par Sébastien, Laure et Damien choisissent d’engravillonner avec des granulats de Seine (silex) leur allée."
                            }
                        ]
                    }
