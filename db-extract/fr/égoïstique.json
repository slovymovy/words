                "senses": [
                    {
                        "sense_id": "0eb88158-81bc-3275-af51-a14f4f8b7ef4",
                        "entry_id": "095947dc-5992-3d0a-84e1-bcb8394bd6e0",
                        "glosses": [
                            "Qui appartient à l’égoïsme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad37570-9e8c-45a4-9b0d-69df8fc4f40d",
                                "sense_id": "0eb88158-81bc-3275-af51-a14f4f8b7ef4",
                                "text": "Il trouvait, à la vérité, une difficulté inconciliable entre la morale égoïstique des épicuriens et les principes des autres écoles […]"
                            },
                            {
                                "example_id": "3e7a4be0-8fee-4dcf-9779-17491483226a",
                                "sense_id": "0eb88158-81bc-3275-af51-a14f4f8b7ef4",
                                "text": "Jetons un regard en arrière, afin de faire connaître à nos lecteurs les causes de la haine que les Pazzi avaient vouée aux Médicis ; ils verront ainsi, après le soin que nous avons eu de leur faire connaître l’état politique de Florence, ce qu’il y avait d’égoïstique ou de désintéressé dans cette grande machination."
                            }
                        ]
                    }
                ],
