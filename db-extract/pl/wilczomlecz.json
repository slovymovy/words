                "senses": [
                    {
                        "sense_id": "3465de1e-f85a-3676-8246-ed52d5c9cdfb",
                        "entry_id": "9cc486f5-479b-3d3f-86a7-ec720b4f2169",
                        "glosses": [
                            "Euphorbia L., rodzaj roślin jednorocznych z rodziny Euphorbiaceae Juss."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b977da-c61e-49f0-9bbd-6d761c7d8bfa",
                                "sense_id": "3465de1e-f85a-3676-8246-ed52d5c9cdfb",
                                "text": "Na podstawie budowy kwiatów poinsecję zalicza się do wilczomleczy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "93b8e1ed-893a-3ab1-b2ac-7ee051b180f0",
                        "entry_id": "9cc486f5-479b-3d3f-86a7-ec720b4f2169",
