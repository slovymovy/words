    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e06d128-7164-3aa8-845f-0739c0da0339",
                    "sense_definition": "pojąć kogoś za żonę; zawrzeć związek małżeński (o mężczyźnie, w konstrukcji z się)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "matrimony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek wreszcie zdecydował, że w przyszłym roku <w>ożeni</w> się ze swoją wieloletnią partnerką.",
                            "target_lang_translations": {
                                "ru": "Марек наконец решил, что в следующем году <w>женится</w> на своей давней партнерше."
                            }
                        },
                        {
                            "text": "Jego rodzice nie byli zadowoleni, gdy <w>ożenił</w> się ze swoją daleką kuzynką.",
                            "target_lang_translations": {
                                "ru": "Его родители были недовольны, когда он <w>женился</w> на своей дальней кузине."
                            }
                        }
                    ],
                    "synonyms": [
                        "chajtnąć się"
                    ],
                    "common_phrases": [
                        "ożenić się z miłości",
                        "ożenić się z rozsądku"
                    ],
                    "target_lang_definitions": {
                        "ru": "вступить в брак (о мужчине, в сочетании с się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жениться",
                                "target_lang_sense_clarification": "о мужчине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eb2d45e-8e99-3560-9aa5-17a76891b53b",
                    "sense_definition": "doprowadzić do zawarcia małżeństwa przez syna lub innego podopiecznego mężczyznę",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matrimony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rodzina postanowiła jak najszybciej <w>ożenić</w> młodego dziedzica z posażną panną.",
                            "target_lang_translations": {
                                "ru": "Семья решила как можно быстрее <w>женить</w> молодого наследника на богатой невесте."
                            }
                        },
                        {
                            "text": "Ojciec z trudem <w>ożenił</w> wszystkich swoich niesfornych synów przed śmiercią.",
                            "target_lang_translations": {
                                "ru": "Отец с трудом <w>женил</w> всех своих непослушных сыновей перед смертью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ożenić syna"
                    ],
                    "target_lang_definitions": {
                        "ru": "женить сына или другого подопечного мужского пола"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женить",
                                "target_lang_sense_clarification": "сына, подопечного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce9f3a8c-e640-370e-90d7-f6226e453d6a",
                    "sense_definition": "sprzedać coś, zwłaszcza pozbyć się niepotrzebnych lub nielegalnych rzeczy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodzieje próbowali szybko <w>ożenić</w> skradziony towar na pobliskim bazarze.",
                            "target_lang_translations": {
                                "ru": "Воры пытались быстро <w>спихнуть</w> краденый товар на соседнем рынке."
                            }
                        },
                        {
                            "text": "Muszę jak najszybciej <w>ożenić</w> ten stary samochód, bo tylko stoi i rdzewieje.",
                            "target_lang_translations": {
                                "ru": "Мне нужно как можно скорее <w>сплавить</w> эту старую машину, а то она только стоит и ржавеет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ożenić towar"
                    ],
                    "traits": [
                        {
