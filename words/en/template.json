{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfc131d1-95bb-3184-84db-98b397f4868a",
                    "sense_definition": "A file or document with a preset format serving as a starting point for creating others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "model_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I downloaded a resume <w>template</w> to help me apply for the job.",
                            "target_lang_translations": {
                                "ru": "Я скачал <w>шаблон</w> резюме, чтобы он помог мне подать заявку на работу.",
                                "zh": "我下载了一份简历<w>模板</w>来帮助我申请这份工作。"
                            }
                        },
                        {
                            "text": "The software provides a standard <w>template</w> for monthly reports.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение предоставляет стандартный <w>шаблон</w> для ежемесячных отчетов.",
                                "zh": "该软件为月度报告提供了标准<w>模板</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "email template",
                        "document template",
                        "design template",
                        "blank template"
                    ],
                    "target_lang_definitions": {
                        "ru": "Файл или документ с заданным форматом, служащий отправной точкой для создания других.",
                        "zh": "具有预设格式的文件或文档，作为创建其他内容的起点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "пример оформления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模板",
                                "target_lang_sense_clarification": "文档或文件格式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b2d85b5-8ca1-3120-967c-197881528a86",
                    "sense_definition": "A generic model or pattern from which other things are based or derived.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "model_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The successful project served as a <w>template</w> for future developments in the city.",
                            "target_lang_translations": {
                                "ru": "Успешный проект послужил <w>образцом</w> для будущих застроек в городе.",
                                "zh": "这个成功的项目成为了该市未来发展的<w>蓝本</w>。"
                            }
                        },
                        {
                            "text": "Her training routine became the <w>template</w> for the entire team.",
                            "target_lang_translations": {
                                "ru": "Ее режим тренировок стал <w>моделью</w> для всей команды.",
                                "zh": "她的训练计划成为了整个团队的<w>模范</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "template for success",
                        "template for change",
                        "basic template"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая модель или паттерн, на основе которых создаются или разрабатываются другие вещи.",
                        "zh": "作为其他事物基础或衍生来源的通用模型或模式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "пример для подражания"
                            },
                            {
                                "target_lang_word": "модель",
                                "target_lang_sense_clarification": "основа"
                            },
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "паттерн"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模范",
                                "target_lang_sense_clarification": "榜样或参考标准"
                            },
                            {
                                "target_lang_word": "蓝本",
                                "target_lang_sense_clarification": "作为参考的范本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3268f754-3569-3da8-b9e6-b39420184b07",
                    "sense_definition": "A physical object whose shape is used as a guide to cut or shape material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "model_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a wooden <w>template</w> to cut the curve of the table.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал деревянное <w>лекало</w>, чтобы вырезать изгиб стола.",
                                "zh": "木匠用一个木制<w>样板</w>来切割桌子的弧度。"
                            }
                        },
                        {
                            "text": "Place the <w>template</w> over the fabric and trace the outline with chalk.",
                            "target_lang_translations": {
                                "ru": "Положите <w>шаблон</w> на ткань и обведите контур мелом.",
                                "zh": "把<w>样板</w>放在布料上，用粉笔描出轮廓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut a template",
                        "paper template",
                        "metal template"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический объект, форма которого используется в качестве руководства для резки или придания формы материалу.",
                        "zh": "一种物理物体，其形状被用作切割或塑造材料的指南。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "лекало",
                                "target_lang_sense_clarification": "для кривых линий"
                            },
                            {
                                "target_lang_word": "трафарет",
                                "target_lang_sense_clarification": "для нанесения рисунка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "样板",
                                "target_lang_sense_clarification": "用于切割或制造的工具"
                            },
                            {
                                "target_lang_word": "模板",
                                "target_lang_sense_clarification": "用于形状参考的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e71bb042-1d85-384e-aaa3-baa456c7f369",
                    "sense_definition": "A macromolecule, such as DNA, that provides a pattern for the synthesis of another molecule.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DNA strand acts as a <w>template</w> for the production of RNA.",
                            "target_lang_translations": {
                                "ru": "Цепь ДНК действует как <w>матрица</w> для производства РНК.",
                                "zh": "DNA链作为生产RNA的<w>模板</w>。"
                            }
                        },
                        {
                            "text": "Enzymes read the molecular <w>template</w> to build the protein chain.",
                            "target_lang_translations": {
                                "ru": "Ферменты считывают молекулярную <w>матрицу</w> для построения белковой цепи.",
                                "zh": "酶读取分子<w>模板</w>以构建蛋白质链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "DNA template",
                        "template strand"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Макромолекула, такая как ДНК, которая служит образцом для синтеза другой молекулы.",
                        "zh": "一种大分子（如DNA），为另一种分子的合成提供模式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "биология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模板",
                                "target_lang_sense_clarification": "生物学中的分子合成基础"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69722fc8-0a73-33d8-9daf-e5ba30b9bd7a",
                    "sense_definition": "A partially defined class or function in programming that can be adapted to different data types.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using a <w>template</w> allows the code to handle integers and floating-point numbers equally well.",
                            "target_lang_translations": {
                                "ru": "Использование <w>шаблона</w> позволяет коду одинаково хорошо обрабатывать целые числа и числа с плавающей запятой.",
                                "zh": "使用<w>模板</w>可以让代码同样出色地处理整数和浮点数。"
                            }
                        },
                        {
                            "text": "The programmer defined a class <w>template</w> to improve code reusability.",
                            "target_lang_translations": {
                                "ru": "Программист определил <w>шаблон</w> класса, чтобы улучшить возможность повторного использования кода.",
                                "zh": "程序员定义了一个类<w>模板</w>以提高代码的可重用性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "class template",
                        "function template"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частично определенный класс или функция в программировании, которые могут быть адаптированы к различным типам данных.",
                        "zh": "编程中一种部分定义的类或函数，可适配不同的数据类型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "программирование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模板",
                                "target_lang_sense_clarification": "计算机编程术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e67b6f56-f823-3c8d-bfd4-9543e844d423",
                    "sense_definition": "To set up, mark off, or shape using a template.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders <w>templated</w> the kitchen area before ordering the granite countertops.",
                            "target_lang_translations": {
                                "ru": "Строители <w>сделали шаблон</w> кухонной зоны перед заказом гранитных столешниц.",
                                "zh": "建筑工人在订购花岗岩台面之前，先对厨房区域进行了<w>测量制模</w>。"
                            }
                        },
                        {
                            "text": "We need to <w>template</w> the design onto the metal sheet before cutting.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>разметить по шаблону</w> рисунок на металлическом листе перед резкой.",
                                "zh": "在切割之前，我们需要根据<w>样板</w>在金属板上进行标记。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать, размечать или придавать форму с помощью шаблона.",
                        "zh": "使用模板进行设置、标记或塑形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать по шаблону",
                                "target_lang_sense_clarification": "изготавливать"
                            },
                            {
                                "target_lang_word": "размечать",
                                "target_lang_sense_clarification": "наносить метки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制作模板",
                                "target_lang_sense_clarification": "制作参考模型"
                            },
                            {
                                "target_lang_word": "按样板标记",
                                "target_lang_sense_clarification": "根据模板进行划线或定位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}