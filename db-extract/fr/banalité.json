        "fr-extract.jsonl": [
            {
                "entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                "word": "banalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2908d4f1-a210-4a66-9242-5bfc4bcf3ba2",
                        "entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "tags": [
                            "plural"
                        ],
                        "form": "banalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3b11426-e3d8-3d13-afb7-d91ec230db38",
                        "entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "glosses": [
                            "Fiscalité médiévale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc75bb59-772a-4d1e-80d9-7e2dc892897e",
                                "sense_id": "c3b11426-e3d8-3d13-afb7-d91ec230db38",
                                "text": "L'impôt se percevait sous toutes les formes. Il y avait […] le droit de banalité, contraignant les roturiers à recourir au pressoir, au four, au moulin seigneurial, et empêchant ceux-ci de construire des moulins, des fours et des pressoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "98de43f4-ba48-35df-a5c4-aa7f291b1d3e",
                        "entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "glosses": [
                            "Caractère banal d’une pensée, d’un écrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a8cf09-5ad4-40ed-98e5-736cc93489cb",
                                "sense_id": "98de43f4-ba48-35df-a5c4-aa7f291b1d3e",
                                "text": "Le grand nombre, et même composé des éléments les meilleurs, n'applaudit jamais à ce qu'il y a de neuf, de virtuel, de déconcerté et de déconcertant, dans une œuvre; mais seulement à ce qu'il y peut déjà reconnaître, c'est-à-dire la banalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "d70b01b4-81cc-3403-8815-e28f8489d314",
                        "entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "glosses": [
                            "Pensée ou écrit qui a ce caractère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a04ae1-d25e-4d09-8949-f6ded1976e5e",
                                "sense_id": "d70b01b4-81cc-3403-8815-e28f8489d314",
                                "text": "Tout comme il y avait des banalités bourgeoises, il y a des banalités révolutionnaires; il importe de s'en convaincre."
                            },
                            {
                                "example_id": "b0307256-b19b-475a-91cf-111170e3aea2",
                                "sense_id": "d70b01b4-81cc-3403-8815-e28f8489d314",
                                "text": "Les hors-d’œuvre disparaissaient avec les banalités d'une conversation qui attend le dessert pour se dessiner."
                            },
                            {
                                "example_id": "122727fe-741e-4cf1-99e0-231282f48cff",
                                "sense_id": "d70b01b4-81cc-3403-8815-e28f8489d314",
                                "text": "Il dit tout avec un sourire, ce qui lui permet de faire entendre ses erreurs pour volontaires et ses banalités pour fines."
                            },
                            {
                                "example_id": "eb0c62b6-39ff-4f10-844b-9314bb7734e1",
                                "sense_id": "d70b01b4-81cc-3403-8815-e28f8489d314",
                                "text": "On ne supporte plus l'attente, il faut répondre immédiatement aux textos, au risque de les entendre biper, rebiper, jusqu'au moment où l'on réplique à une banalité par une autre banalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93c798ce-730d-48ae-9477-5963af707425",
                        "source_entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "source_sense_id": "c3b11426-e3d8-3d13-afb7-d91ec230db38",
                        "source_sense_description": "(Féodalité) Fiscalité médiévale.",
                        "target_lang_word": "bannalità",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "26348d7f-01a9-4f6e-ae2d-d5d76fc83abf",
                        "source_entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "source_sense_id": "98de43f4-ba48-35df-a5c4-aa7f291b1d3e",
                        "source_sense_description": "Pensée ou écrit à caractère banal",
                        "target_lang_word": "Banalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed9f0b4c-c5db-3e71-91fb-a0d621f06589",
                                        "entry_id": "d8482874-e498-3475-8ebc-b42a9ed87bca",
                                        "glosses": [
                                            "die Alltäglichkeit, die Selbstverständlichkeit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf4bed9f-2c6e-4581-b149-02104b017955",
                                                "sense_id": "ed9f0b4c-c5db-3e71-91fb-a0d621f06589",
                                                "text": "„Auch aus der Perspektive späterer Jahre paßt Heines Erinnerung genau zu der scheinbaren Banalität der Harzreise, zu Makkaroni und Lord Byron.“"
                                            },
                                            {
                                                "example_id": "e18c16aa-9a20-4285-a066-b44e6ae8ba5d",
                                                "sense_id": "ed9f0b4c-c5db-3e71-91fb-a0d621f06589",
                                                "text": "„Poesie ist eine Lebenshaltung, die sich der Aufgabe verschrieben hat, die Phantasie vor der Banalität und der bleiernen Schwere der faktischen Verhältnisse zu bewahren.“"
                                            },
                                            {
                                                "example_id": "167b7e51-14ab-4bfc-9319-6352ab1b0c4c",
                                                "sense_id": "ed9f0b4c-c5db-3e71-91fb-a0d621f06589",
                                                "text": "„Die Tragödie der Banalität, erzeugt durch gewöhnliche Umstände und dadurch nur noch unentrinnbarer gemacht, muss noch geschrieben werden.“"
                                            },
                                            {
                                                "example_id": "03f484b9-4c6e-48fc-9d48-21f164119b9a",
                                                "sense_id": "ed9f0b4c-c5db-3e71-91fb-a0d621f06589",
                                                "text": "Unter Banalität versteht man einen Sachverhalt oder einen Vorgang, der von einem bestimmten Teil der Menschen mit einem bestimmten Bildungsgrad als allgemein bekannt eingestuft und daher als der vertieften Betrachtung nicht wert betrachtet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "242280e4-5dbd-363b-a81a-ebd5d45f6454",
                                        "entry_id": "d8482874-e498-3475-8ebc-b42a9ed87bca",
                                        "glosses": [
                                            "das leere, inhaltslose Gerede, die oberflächliche Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328be8b7-1e2a-413e-b101-93f3588450c5",
                                                "sense_id": "242280e4-5dbd-363b-a81a-ebd5d45f6454",
                                                "text": "Unter Banalität versteht man einen Sachverhalt oder einen Vorgang, der von einem bestimmten Teil der Menschen mit einem bestimmten Bildungsgrad als allgemein bekannt eingestuft und daher als der vertieften Betrachtung nicht wert betrachtet wird."
                                            },
                                            {
                                                "example_id": "bef53d46-7354-4211-ad70-f257b4ec016b",
                                                "sense_id": "242280e4-5dbd-363b-a81a-ebd5d45f6454",
                                                "text": "Alles, was er sagt, ist eine pure Banalität."
                                            },
                                            {
                                                "example_id": "d4c11a58-5132-4957-a03c-ebbb0504eb2c",
                                                "sense_id": "242280e4-5dbd-363b-a81a-ebd5d45f6454",
                                                "text": "Nun hör doch mal mit diesen Banalitäten auf! Das interessiert doch jetzt keinen!"
                                            },
                                            {
                                                "example_id": "9d730082-cd0c-4520-bbff-aeaba0124542",
                                                "sense_id": "242280e4-5dbd-363b-a81a-ebd5d45f6454",
                                                "text": "„So wie diese Bude ihr Abbild des Lebens ist, so hat jede Banalität für sie den Reiz, die sie hatte, als sie das erste Mal ausgesprochen wurde und noch voll Geist war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c6aade8-07b6-4941-a8d6-2790b0942a94",
                        "source_entry_id": "5d671cf6-c0c2-3835-890d-26fdd32c6d07",
                        "source_sense_id": "98de43f4-ba48-35df-a5c4-aa7f291b1d3e",
                        "source_sense_description": "Pensée ou écrit à caractère banal",
                        "target_lang_word": "banality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "104a5c53-0a68-32f8-b692-f245ac064708",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "The quality of being banal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76fca270-c682-4ee0-9b78-34c0a681548a",
                                                "sense_id": "104a5c53-0a68-32f8-b692-f245ac064708",
                                                "text": "The concept of the banality of evil came into prominence following the publication of Hannah Arendt's 1963 book Eichmann in Jerusalem: A Report on the Banality of Evil, which was based on the trial of Adolph Eichmann in Jerusalem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200ae23b-e4b6-316d-b0ea-6ddcda6b712d",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "Something which is banal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "A feudal right or obligation, especially the obligation for a peasant to grind grain at the lord's mill, or the profits accruing from such rights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50a350f-656f-40d9-9cd4-1f4478d69b90",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "The law of banality, one of the most oppressive products of feudalism, was revived for the advantage of the nobility."
                                            },
                                            {
                                                "example_id": "b563f39b-c914-4ef8-b9ef-17ec43b56de9",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "Other banalities included the lord's exclusive right to hunt over the land, his monopoly over fishing, and his right to keep the dove-cote whose feathery occupants ate a peasant's standing crops."
                                            },
                                            {
                                                "example_id": "dfc31caa-5d95-4678-acd4-8f90b7fe0821",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "In fact corvées, champarts, and rights of banality not only continued but had been increased in the course of the seventeenth century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
