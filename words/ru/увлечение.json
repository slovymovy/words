    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c624c714-97dc-33a4-9454-61bca465f096",
                    "sense_definition": "Сильный интерес к чему-либо, любимое занятие, которому посвящают досуг.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interest_hobby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фотография — это моё главное <w>увлечение</w> в свободное время.",
                            "target_lang_translations": {
                                "en": "Photography is my main <w>hobby</w> in my free time.",
                                "pl": "Fotografia to moje główne <w>hobby</w> w czasie wolnym."
                            }
                        },
                        {
                            "text": "У него появилось новое <w>увлечение</w>, которому он отдаёт все силы.",
                            "target_lang_translations": {
                                "en": "He has a new <w>passion</w> that he devotes all his energy to.",
                                "pl": "Pojawiła się u niego nowa <w>pasja</w>, której poświęca wszystkie siły."
                            }
                        }
                    ],
                    "synonyms": [
                        "хобби",
                        "страсть",
                        "интерес"
                    ],
                    "common_phrases": [
                        "сильное увлечение",
                        "детское увлечение",
                        "модное увлечение"
                    ],
                    "target_lang_definitions": {
                        "en": "A strong interest in something, a favorite activity to which leisure time is devoted.",
                        "pl": "Silne zainteresowanie czymś, ulubione zajęcie, któremu poświęca się czas wolny."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hobby",
                                "target_lang_sense_clarification": "leisure activity"
                            },
                            {
                                "target_lang_word": "passion",
                                "target_lang_sense_clarification": "strong interest"
                            },
                            {
                                "target_lang_word": "pastime",
                                "target_lang_sense_clarification": "activity for free time"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "hobby",
                                "target_lang_sense_clarification": "zajęcie wykonywane w czasie wolnym"
                            },
                            {
                                "target_lang_word": "pasja",
                                "target_lang_sense_clarification": "silne zainteresowanie czymś"
                            },
                            {
                                "target_lang_word": "zainteresowanie",
                                "target_lang_sense_clarification": "ogólne skupienie uwagi na jakiejś dziedzinie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7fa2bb8-3ae8-39bd-881e-c802d936c7dd",
                    "sense_definition": "Состояние душевного подъёма, воодушевления, полной поглощённости каким-либо делом.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interest_hobby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты слушали лекцию профессора с большим <w>увлечением</w>.",
                            "target_lang_translations": {
                                "en": "The students listened to the professor's lecture with great <w>enthusiasm</w>.",
                                "pl": "Studenci słuchali wykładu profesora z wielkim <w>zapałem</w>."
                            }
                        },
                        {
                            "text": "Она работала с таким <w>увлечением</w>, что совсем забыла об обеде.",
                            "target_lang_translations": {
                                "en": "She worked with such <w>zeal</w> that she completely forgot about lunch.",
                                "pl": "Pracowała z takim <w>zaangażowaniem</w>, że zupełnie zapomniała o obiedzie."
                            }
                        }
                    ],
                    "synonyms": [
                        "воодушевление",
                        "азарт",
                        "увлечённость"
                    ],
                    "common_phrases": [
                        "с увлечением",
                        "слушать с увлечением",
                        "работать с увлечением"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of spiritual uplift, enthusiasm, or complete absorption in a task.",
                        "pl": "Stan ożywienia, entuzjazmu lub pełnego zaangażowania w wykonywaną czynność."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enthusiasm",
                                "target_lang_sense_clarification": "intense enjoyment or interest"
                            },
                            {
                                "target_lang_word": "zeal",
                                "target_lang_sense_clarification": "great energy or enthusiasm"
                            },
                            {
                                "target_lang_word": "fascination",
                                "target_lang_sense_clarification": "state of being very interested"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "entuzjazm",
                                "target_lang_sense_clarification": "stan wielkiego zapału"
                            },
                            {
                                "target_lang_word": "zapał",
                                "target_lang_sense_clarification": "duża energia w działaniu"
                            },
                            {
                                "target_lang_word": "zaangażowanie",
                                "target_lang_sense_clarification": "pełne skupienie na pracy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40aa9ac0-f141-3755-b8a4-d2880b772512",
                    "sense_definition": "Чувство сердечной привязанности, влюблённость (обычно неглубокая или временная), а также человек, вызывающий это чувство.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это было лишь мимолётное <w>увлечение</w>, которое быстро прошло.",
                            "target_lang_translations": {
                                "en": "It was just a fleeting <w>infatuation</w> that passed quickly.",
                                "pl": "To było tylko przelotne <w>zauroczenie</w>, które szybko minęło."
                            }
                        },
                        {
                            "text": "На вечеринке он познакомил друзей со своим новым <w>увлечением</w>.",
                            "target_lang_translations": {
                                "en": "At the party, he introduced his friends to his new <w>crush</w>.",
                                "pl": "Na imprezie przedstawił przyjaciołom swoją nową <w>sympatię</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "пассия",
                        "краш",
                        "влюблённость"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "мимолётное увлечение",
                        "сердечное увлечение",
                        "предмет увлечения"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of romantic attachment, infatuation (usually shallow or temporary), or the person causing this feeling.",
                        "pl": "Uczucie romantycznego przywiązania, zauroczenie (zazwyczaj płytkie lub tymczasowe), a także osoba wywołująca to uczucie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infatuation",
                                "target_lang_sense_clarification": "short-lived passion"
                            },
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "informal, referring to the person or feeling"
                            },
                            {
                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "brief romantic relationship"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zauroczenie",
                                "target_lang_sense_clarification": "krótkotrwałe uczucie"
                            },
                            {
                                "target_lang_word": "flirt",
                                "target_lang_sense_clarification": "przelotna relacja romantyczna"
                            },
                            {
                                "target_lang_word": "sympatia",
                                "target_lang_sense_clarification": "osoba, do której czuje się miętę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c61313a1-ad9d-3fae-a22d-9a271bacd6c4",
                    "sense_definition": "Действие по глаголу «увлекать»; перемещение кого-либо или чего-либо силой движения.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Быстрое течение реки грозило <w>увлечением</w> лодки в открытое море.",
                            "target_lang_translations": {
                                "en": "The river's rapid current threatened the <w>carrying away</w> of the boat into the open sea.",
                                "pl": "Szybki nurt rzeki groził <w>porwaniem</w> łodzi na otwarte morze."
                            }
                        },
                        {
                            "text": "В физике изучается процесс <w>увлечения</w> частиц потоком воздуха.",
                            "target_lang_translations": {
                                "en": "Physics studies the process of particle <w>entrainment</w> by air flow.",
                                "pl": "W fizyce bada się proces <w>unoszenia</w> cząsteczek przez strumień powietrza."
                            }
                        }
                    ],
                    "synonyms": [
                        "утягивание",
                        "увод"
                    ],
                    "target_lang_definitions": {
                        "en": "The action of moving someone or something by the force of motion; dragging or carrying along.",
                        "pl": "Działanie polegające na przemieszczaniu kogoś lub czegoś siłą ruchu; pociągnięcie za sobą."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entrainment",
                                "target_lang_sense_clarification": "physics/technical term"
                            },
                            {
                                "target_lang_word": "carrying away",
                                "target_lang_sense_clarification": "literal action of moving something"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "porywanie",
                                "target_lang_sense_clarification": "np. przez prąd wody"
                            },
                            {
                                "target_lang_word": "unoszenie",
                                "target_lang_sense_clarification": "przemieszczanie przez strumień powietrza lub wody"
                            }
                        ]
                    }
                }
            ]
        }
    ]
