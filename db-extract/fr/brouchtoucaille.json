                    {
                        "sense_id": "8cca8304-8f10-3fe0-be78-7194eebad23e",
                        "entry_id": "65c44bdf-1b9e-3d4c-b50f-e77eaa6f11e6",
                        "glosses": [
                            "Sorte de ragoût improbable que, dans ce roman, les familles préparent pour la Saint-Glinglin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd302a64-9cb1-4aee-9450-82e35977f098",
                                "sense_id": "8cca8304-8f10-3fe0-be78-7194eebad23e",
                                "text": "La brouchtoucaille se prépare ainsi : prenez choux, artichauts, épinards, aubergines, laitues, champignons, potirons, cornichons, betteraves, raves, choux-raves, tomates, patates, dattes, céleris, radis, salsifis, fèves, oignons, lentilles, épis de maïs et noix de coco ; épluchez, pelez, nettoyez, lavez, coupez, hachez, concassez, triturez, tamisez, étuvez, passez, balayez, ramassez, délayez, sublimez, concrétisez, arrangez, disposez et cuisez partie à l’eau, partie à l’huile d’olive, partie à l’huile de noix, partie à la graisse de bœuf, partie à la graisse d’oie."
                            },
                            {
                                "example_id": "a4f500fa-510e-4000-a8c5-39fcb15a9bc1",
                                "sense_id": "8cca8304-8f10-3fe0-be78-7194eebad23e",
                                "text": "Célèbre est surtout la recette de la « brouchtoucaille » du Saint Glinglin, dont la précision dépasse toutes les recettes de cuisine habituelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2e532f8-c23f-3c9e-b110-284722e01fb1",
                        "entry_id": "65c44bdf-1b9e-3d4c-b50f-e77eaa6f11e6",
                        "glosses": [
                            "Repris par Jacques Jouet comme équivalent de boustifaille."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2164b700-cd9c-426d-b12f-ea748f39a063",
                                "sense_id": "b2e532f8-c23f-3c9e-b110-284722e01fb1",
                                "text": "Ainsi ces mouettes qui s’agacent l’une l’autre, passant du gynécée à la boustifaille puis de la brouchtoucaille au gynécée, et ainsi de suite, sempiternellement …."
                            }
                        ]
                    }
