                "senses": [
                    {
                        "sense_id": "e1d9296d-a65c-3563-be19-268a467f021f",
                        "entry_id": "f9012527-5776-3439-8c3d-7f133e59c651",
                        "glosses": [
                            "A drunkard."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b29e0493-afc8-495e-b181-9bcb4a2f96d7",
                                "sense_id": "e1d9296d-a65c-3563-be19-268a467f021f",
                                "text": "Offence? As I'm a Perſon, I'm aſhamed of you—Fogh! how you ſtink of Wine! Dee think my Niece will ever endure ſuch a Borachio! you'r an abſolute Borachio."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c3b0d21-220b-32b8-a255-ccfda63cef49",
                        "entry_id": "f9012527-5776-3439-8c3d-7f133e59c651",
                        "glosses": [
                            "A bottle for wine made of pigskin."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1332bd07-71ab-41c1-91a7-46543e3abda5",
                                "sense_id": "0c3b0d21-220b-32b8-a255-ccfda63cef49",
                                "text": "Meer. Yes, / But by my way of dressing, you must know, sir, / And med'cining the leather to a height / Of improved ware, like your borachio / Of Spain, sir, I can fetch nine thousand for't"
                            }
                        ]
                    }
