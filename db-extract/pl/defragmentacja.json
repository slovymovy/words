                                        "sense_id": "ac4526eb-998a-3293-bcec-7ca8e4bd4e0b",
                                        "entry_id": "4fe9a0ce-db53-37af-9073-fd01328636a9",
                                        "glosses": [
                                            "logische Reorganisation von digitalen Daten auf einem Speichermedium mit dem Ziel der Zugriffsbeschleunigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c3f767-f59c-4285-a7c6-87cb28b3c135",
                                                "sense_id": "ac4526eb-998a-3293-bcec-7ca8e4bd4e0b",
                                                "text": "Im Klartext: Eine konsequent und periodisch durchgeführte Defragmentierung bringt im Massenspeicher \"wieder zusammen, was zusammengehört\"."
                                            },
                                            {
                                                "example_id": "2dee6848-c7d6-4c57-92ac-7699d637d875",
                                                "sense_id": "ac4526eb-998a-3293-bcec-7ca8e4bd4e0b",
                                                "text": "Auf einem recht frischen XP-Computer mit einer Festplattenbelegung von ca. 10 % brauchte das Programm für die Defragmentierung deutlich länger als eine halbe Stunde, für die Systemoptimierung nur unwesentlich weniger."
                                            },
                                            {
                                                "example_id": "fa617db7-01e4-4891-98b2-df2d7271799f",
                                                "sense_id": "ac4526eb-998a-3293-bcec-7ca8e4bd4e0b",
                                                "text": "Zur Defragmentierung werden drei Methoden angeboten. „Smartplacement“ defragmentiert alle Dateien und ordnet ihre Speicherorte auf der Festplatte nach dem Zeitpunkt der letzten Änderung neu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
