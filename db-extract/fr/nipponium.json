                                        "entry_id": "ee999418-3921-3190-b394-f3d50effc3e8",
                                        "glosses": [
                                            "A chemical element, supposed to be the then-undiscovered technetium, but later identified as rhenium."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d6c69df-d469-44e5-80f1-02a6d7fac8f0",
                                                "sense_id": "ba3f8d23-9e5c-34dd-a84d-eac3ab0133bf",
                                                "text": "Element between molybdenum and ruthenium (perhaps Ogawa's nipponium)"
                                            },
                                            {
                                                "example_id": "f6c216f1-7f82-421d-bad6-33cc0b6fa162",
                                                "sense_id": "ba3f8d23-9e5c-34dd-a84d-eac3ab0133bf",
                                                "text": "Tiede at Berlin University told Toshiyuki Majima that nipponium might be rhenium when the latter visited him in 1938."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
