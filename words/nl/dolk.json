    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                    "sense_definition": "Een kort, dubbelsnijdend mes dat gebruikt wordt als steekwapen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ridder trok zijn <w>dolk</w> om zich te verdedigen in het gevecht.",
                            "target_lang_translations": {
                                "pl": "Rycerz wyciągnął swój <w>sztylet</w>, aby bronić się w walce."
                            }
                        },
                        {
                            "text": "Hij droeg een scherpe <w>dolk</w> aan zijn riem voor de veiligheid.",
                            "target_lang_translations": {
                                "pl": "Nosił ostry <w>sztylet</w> przy pasie dla bezpieczeństwa."
                            }
                        }
                    ],
                    "synonyms": [
                        "dolkmes",
                        "ponjaard"
                    ],
                    "common_phrases": [
                        "scherpe dolk",
                        "met een dolk"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótka, obosieczna broń biała służąca głównie do kłucia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sztylet",
                                "target_lang_sense_clarification": "broń biała"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98583485-80c9-376f-8eef-9f86b6a92b0b",
                    "sense_definition": "Eerste persoon enkelvoud van de tegenwoordige tijd van het werkwoord <w>dolken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dolk</w> de vijand om het koninkrijk te beschermen.",
                            "target_lang_translations": {
                                "pl": "<w>Dźgam sztyletem</w> wroga, aby chronić królestwo."
                            }
                        },
                        {
                            "text": "Wanneer ik iemand <w>dolk</w>, doe ik dat alleen uit verdediging.",
                            "target_lang_translations": {
                                "pl": "Kiedy kogoś <w>dźgam sztyletem</w>, robię to wyłącznie w obronie własnej."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma pierwszej osoby liczby pojedynczej czasu teraźniejszego czasownika dolken (dźgać sztyletem)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dźgam sztyletem",
                                "target_lang_sense_clarification": "1 os. lp"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4dcf163-2cde-3034-a14a-7a8ebc97a67b",
                    "sense_definition": "Tweede persoon enkelvoud van de tegenwoordige tijd van het werkwoord <w>dolken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dolk</w> jij de schurk of laat je hem ontsnappen?",
                            "target_lang_translations": {
                                "pl": "<w>Dźgniesz sztyletem</w> łotra, czy pozwolisz mu uciec?"
                            }
                        },
                        {
                            "text": "Waarom <w>dolk</w> je die schurk zonder waarschuwing?",
                            "target_lang_translations": {
                                "pl": "Dlaczego <w>dźgasz sztyletem</w> tego łotra bez ostrzeżenia?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma drugiej osoby liczby pojedynczej czasu teraźniejszego (w inwersji) czasownika dolken."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dźgasz sztyletem",
                                "target_lang_sense_clarification": "2 os. lp"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9065716a-8227-3eb5-8b4a-2f2aee9e3d59",
                    "sense_definition": "Gebiedende wijs van het werkwoord <w>dolken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dolk</w> de vijand voor hij ons aanvalt!",
                            "target_lang_translations": {
                                "pl": "<w>Zadźgaj</w> wroga, zanim nas zaatakuje!"
                            }
                        },
                        {
                            "text": "<w>Dolk</w> hem meteen en ren zo snel mogelijk weg!",
                            "target_lang_translations": {
                                "pl": "<w>Dźgnij</w> go od razu i uciekaj tak szybko, jak to możliwe!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tryb rozkazujący czasownika dolken (zadźgaj sztyletem)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zadźgaj sztyletem",
                                "target_lang_sense_clarification": "tryb rozkazujący"
                            },
                            {
                                "target_lang_word": "dźgnij sztyletem",
                                "target_lang_sense_clarification": "tryb rozkazujący"
                            }
                        ]
                    }
                }
            ]
        }
    ]
