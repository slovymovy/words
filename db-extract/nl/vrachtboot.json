                "translations": [
                    {
                        "translation_id": "939e6f1e-624e-44f3-b568-a13f32e79dfc",
                        "source_entry_id": "1d07af1c-a54d-38fe-aecf-fe18daf33264",
                        "source_sense_id": "5c950d34-de35-3194-91e8-889108d7b0ff",
                        "source_sense_description": "een boot die gebouwd is om vracht te vervoeren",
                        "target_lang_word": "Frachter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                        "entry_id": "5c516105-9d3f-39a9-8ace-c13795723d02",
                                        "glosses": [
                                            "auf den Gütertransport ausgelegtes Schiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688c0fe2-4f44-4e9e-aa6e-d11082e77490",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "Auf dem Rhein verkehren viele Frachter."
                                            },
                                            {
                                                "example_id": "a0593854-464e-4062-880c-19ece8329c40",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Auf dem Weg dorthin sahen sie Frachter und Ausflugsdampfer auf der linken Dammseite vorbeifahren und Züge und Autos auf der rechten.“"
                                            },
                                            {
                                                "example_id": "d970edf7-6fc9-490a-9f4e-d8d9914c0d57",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Heute sind es riesige, hochmoderne Frachter.“"
                                            },
                                            {
                                                "example_id": "a53b8fa0-8f42-4fed-960b-2ce6182b03cc",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Zwei Frachter kommen uns entgegen, in weitem Abstand voneinander.“"
                                            },
                                            {
                                                "example_id": "ba3b18ef-0a2c-4a5e-8b87-3fb334f8f8c7",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Dort fand er einen Frachter, der ihn mitnahm nach New York, wo er 1941 eintraf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "389d4e7f-cbb6-4998-a8b1-5437c0545c61",
                        "source_entry_id": "1d07af1c-a54d-38fe-aecf-fe18daf33264",
                        "source_sense_id": "5c950d34-de35-3194-91e8-889108d7b0ff",
                        "source_sense_description": "een boot die gebouwd is om vracht te vervoeren",
                        "target_lang_word": "cargo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cargo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                        "entry_id": "2d34d85e-be40-3ef0-9f70-1880ae6a2f4c",
                                        "glosses": [
                                            "Freight carried by a ship, aircraft, or motor vehicle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99519dfc-7a51-4ce7-a252-47ac748d8811",
                                                "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                                "text": "The plane was overloaded with cargo. It was a cargo of live animals."
                                            },
                                            {
                                                "example_id": "888a45a2-bd68-4ef7-8314-3697a0930dca",
                                                "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                                "text": "\"[…]her whole and entire cargo; and, also, all such other cargoes and property as may have been landed in the island of Teneriffe,[…]\""
                                            },
                                            {
                                                "example_id": "ff86a28b-5937-4eef-b27b-6f5c9450fe67",
                                                "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                                "text": "\"[…]but human life is worth more than ships or cargos.\""
                                            },
                                            {
                                                "example_id": "eafc5bb1-ee1b-452d-9db3-a16b11a118c1",
                                                "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                                "text": "How will heaven be filled if the earth ceases to send its cargoes?"
                                            },
                                            {
                                                "example_id": "50f4f70d-b813-45ba-b103-2059c32822d4",
                                                "sense_id": "1f12977b-34a2-30e0-8ef3-41f6a7d7287e",
                                                "text": "A battery of several microcannons can be used to fire the drug cargoes at different times and different depths.\n“We have been working on nanomachines over the past decade,” Joseph Wang, chairman of nanoengineering at UCSD, said. “One of the challenges we considered is to deliver therapeutic cargo deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                        "entry_id": "2d34d85e-be40-3ef0-9f70-1880ae6a2f4c",
                                        "glosses": [
                                            "Western material goods."
                                        ],
                                        "tags": [
                                            "Papua-New-Guinea",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3eae7eb-9d21-4b73-a470-d66221cec8bc",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "The principal change was that two of the 'satans', Kilibob and Manup, were now identified by different groups as God and Jesus Christ, as cargo deities. This expressed the return to hostility towards Europeans and a reassessment of native rights to the cargo."
                                            },
                                            {
                                                "example_id": "3b70fe5c-00d1-4ebc-b603-71309fa83621",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "In this study of colonial and postcolonial Fiji, Martha Kaplan examines the effects of narratives made real and traces a complex history that began neither as a search for cargo, nor as a cult."
                                            },
                                            {
                                                "example_id": "4a0dd9e3-0cf5-4381-b0ee-361120cd42a9",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "Why is it that Europeans, despite their likely genetic disadvantage and (in modern times) their undoubted developmental disadvantage, ended up with much more of the cargo?·"
                                            },
                                            {
                                                "example_id": "000625f5-b94e-4b73-a956-8db5e230013f",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "He was the only one to tell me that he thought it was possible that cargo was made by the ancestors. One or two others were noncommittal, but most clearly denied it."
                                            },
                                            {
                                                "example_id": "fe047a0e-5194-4386-ab63-16506b45709b",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "People turned to traditional or innovative religious ritual to obtain \"cargo.\""
                                            },
                                            {
                                                "example_id": "101d6ec9-0482-4da0-aff7-7382327e6054",
                                                "sense_id": "a99347c5-e5a7-3105-9d03-85db6a93ff50",
                                                "text": "And beyond anthropologists and Islanders, others have been enchanted by cargo as well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cargo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a8f2cf-1ea2-3722-b834-229b0524e7d2",
                                        "entry_id": "0b5c8be0-138f-38f5-af16-cae5f403e8f9",
                                        "glosses": [
                                            "To load with freight."
                                        ],
