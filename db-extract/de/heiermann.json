                        ],
                        "form": "den Heiermann"
                    },
                    {
                        "form_id": "f4af04ae-8e93-4c83-a10c-9ec6bdedfa83",
                        "entry_id": "39fb4888-ebf0-3ad1-91c5-2f8f948eb20b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Heiermänner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                        "entry_id": "39fb4888-ebf0-3ad1-91c5-2f8f948eb20b",
                        "glosses": [
                            "früher Bezeichnung für ein Fünfmarkstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c530a5-9d65-47b3-b311-bbed15af0d0a",
                                "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                                "text": "Das kostet dich einen Heiermann."
                            },
                            {
                                "example_id": "02d9f02c-ed2d-48e1-9399-952f3db9e639",
                                "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                                "text": "„Nach Auskunft der Sprecher hat erst die letzte Generation der Wandermusiker heiermann integriert, ältere Musiker kennen das Wort, weisen es aber der Sprache des Jahrmarktes zu.“"
                            },
                            {
                                "example_id": "16cce6b3-4d72-4233-9dfb-99a4ca4f9644",
                                "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                                "text": "Wenn der Kunde wichsen will, wird von den Frauen ein Heiermann (fünf Mark) extra kassiert."
                            },
                            {
                                "example_id": "ecc3804e-543e-4842-87c0-571cb36ae67b",
                                "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                                "text": "Ein >Heiermann< ist das Handgeld für den angeheuerten Matrosen, es hat mit dem >Heier< (oder >Harder<, >Herder<, dem >Hirten<) nichts zu tun."
                            },
                            {
                                "example_id": "da48032f-31fa-4629-bc34-5fd841900a47",
                                "sense_id": "9f1635ba-0926-3110-a5a2-a9566edd0841",
                                "text": "Bei Robert Lembkes \"Was bin ich\" plumpste mit einem Pling immer ein Heiermann ins \"Welches-hätten's-denn-gern-Schweinderl\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
