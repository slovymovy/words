                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellenophil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                        "entry_id": "2d2016ce-aaf7-3368-ad09-50932dd224ac",
                                        "glosses": [
                                            "die hellenistische Kultur liebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f3842f-641a-45f6-bea5-3dec9ddd4a9e",
                                                "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                                "text": "„Da Hadrian sehr hellenophil eingestellt war, versuchte er anlässlich seines Besuchs der östlichen Provinzen, alle halbautonomen früheren Stadtstaaten in Griechenland und Kleinasien zu vereinen.“"
                                            },
                                            {
                                                "example_id": "b2e24bd5-d998-4abc-95ac-719eafb91421",
                                                "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                                "text": "„Um an ihrer Befreiung mitzuwirken, ging er eines schönen Tages nach Triest, wo er sich der deutschen hellenophilen Freischaar als Feldarzt anschließen wollte.“"
                                            },
                                            {
                                                "example_id": "cb83d099-7c68-48f2-ba33-57cf6150ffc1",
                                                "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                                "text": "„Die hochkultivierte, kunstliebende und aufgeschlossene, aber selbst nicht schöpferische persische Herrenschicht war ausgesprochen hellenophil.“"
                                            },
                                            {
                                                "example_id": "0fb71879-8de8-4e94-9217-88800aee6aa3",
                                                "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                                "text": "„[…] (der erst seit dem Anfang des 19. Jahrhunderts konsequent mit ay geschrieben wird, seit der hellenophile König Ludwig I. verfügte, dass der Name seines Landes das griechische y enthalten solle).“"
                                            },
                                            {
                                                "example_id": "3cac703b-e267-4987-95e1-2d98cda30cf8",
                                                "sense_id": "9c703f11-b2b1-394f-9cd1-5af3b884bc50",
                                                "text": "„Marshall war ausgesprochen hellenophil und suchte daher auch in seiner neuen Ausgrabung nach griechischen Strukturen, Monumenten und Funden, von denen die Schriftquellen zu den Griechen in der Gegend verifiziert würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
