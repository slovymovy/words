                        "source_sense_id": "b09ca379-82f6-3a31-a415-162dd8ad15c9",
                        "source_sense_description": "Kenngröße, die die Veränderung der Liquidität eines Unternehmens in einer Periode angibt",
                        "target_lang_word": "cash flow",
