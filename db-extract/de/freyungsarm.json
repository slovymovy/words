                ],
                "senses": [
                    {
                        "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                        "entry_id": "d1fb77af-f2fc-30e0-89f1-fae61d8b1500",
                        "glosses": [
                            "an einem Pranger, Marktsäule oder am Rathaus angebrachter Schwertarm der das Marktrecht symbolisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b291344c-7299-4603-ae9e-38c2c096f20e",
                                "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                                "text": "„In verschiedenen Formen - Säulenpranger, Schandbühne, Käfigpranger, aber auch einfache Mauernischen; Attribute: Bagstein (Lasterstein), Prangermandeln, Rolandstatue, Freyungsarme, Hals-, Hand- und Fußfesseln/eisen.“"
                            },
                            {
                                "example_id": "6b51504e-a03a-42c4-98bb-7ca9c93dbc8f",
                                "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                                "text": "„Die Freyung, der Freyungsarm oder auch die Marktfreitn ist ein Schwertarm, der den Marktfrieden symbolisiert und zur Marktzeit oder auch zu anderen Anlässen (in Asparn an der Zaya am Faschingsmontag und zur Kirchweih) vornehmlich am Pranger befestigt wurde.“"
                            },
                            {
                                "example_id": "0d4acc4e-d4b0-43f2-88bb-3351ed38ddf7",
                                "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                                "text": "„Der Pranger wurde 1913 neu errichtet, seit 1968 bildet die Figur den Abschluss (zuvor eine Kugel mit Freyungsarm).“"
                            },
                            {
                                "example_id": "9b182269-9c40-4419-9c60-27fe4c9dac6f",
                                "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                                "text": "„Der Freyungsarm, ein Schwertarm, wurde an Markttagen und wichtigen Zeiten (z.B. Kirchweih) an der Säule angebracht.“"
                            },
                            {
                                "example_id": "14625852-07ac-4251-b076-24a4769690c5",
                                "sense_id": "52beb92b-5258-3bdf-a756-2c7c902ed550",
                                "text": "„Der Freyungsschwertarm (Freyungsarm) ist ein altes Zeichen der Marktgerechtigkeit, welches zur Anzeige der besonderen Rechtslage (Marktfrieden) während der Markt- oder Kirchweihtage, meist vor dem Rathaus, ausgesteckt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
