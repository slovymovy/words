                                        "glosses": [
                                            "Celui qui travaille à la monnaie de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aaae1fb-9052-4f9a-b1be-e85411eec84a",
                                                "sense_id": "d81eba43-912b-3029-9c5e-6d096a7442d9",
                                                "text": "C’est effectivement le monnayeur, qui lui, a pignon sur rue, et non le billonneur qui possède la maîtrise technique et commerciale du billon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161b1d18-a63c-3a83-8cfd-4593e5ccfca4",
                                        "entry_id": "b4491e1b-c60d-3479-9f21-09a55c19b899",
                                        "glosses": [
                                            "Appareil permettant d’échanger la monnaie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24dc2820-a09c-3965-aa5c-b064d8eb4ab7",
                                        "entry_id": "b4491e1b-c60d-3479-9f21-09a55c19b899",
                                        "glosses": [
                                            "Partie d’un distributeur automatique qui accepte les pièces, les compte, les vérifie et déclenche le service demandé une fois la somme exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea10883-afe6-4df0-9bbf-d3d356889963",
                                                "sense_id": "24dc2820-a09c-3965-aa5c-b064d8eb4ab7",
                                                "text": "Je glissai trente centimes d'euro dans le monnayeur du distributeur."
                                            }
                                        ]
                                    }
                                ]
                            }
