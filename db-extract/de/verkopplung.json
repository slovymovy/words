                "senses": [
                    {
                        "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                        "entry_id": "aea0af36-b3f9-3328-8a6e-565c83d317a1",
                        "glosses": [
                            "das Verbinden, Zusammenführen von verschiedenen Dingen; das Herstellen, Bestehen eines Zusammenhanges, einer Abhängigkeit voneinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7425c075-b173-4320-9eb3-9d6fd756ae44",
                                "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                                "text": "„Wesentlich komplexer werden die Verhältnisse, wenn zusätzlich eine magnetische Verkopplung vorliegt.“"
                            },
                            {
                                "example_id": "691ff14d-9acf-4fbc-8509-daf754ccc302",
                                "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                                "text": "„Diese Verkopplung der einzelnen Funktionen untereinander ist über die folgenden Differentialgleichungen weiter zu verfolgen.“"
                            },
                            {
                                "example_id": "4a44a0b0-6d3f-4813-b310-f1849e867141",
                                "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                                "text": "„Diese Verkopplung von Quer- und Längskomponente kann auch als Störgröße aufgefaßt werden.“"
                            },
                            {
                                "example_id": "c673aadb-2b9e-4d54-9491-5047ce4af821",
                                "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                                "text": "„Zwar nennt die Bertelsmann-Stiftung ihre Analyse schulstatistischer Daten immer noch ‚Chancenspiegel‘, die Befunde diagnostizieren aber vor allem die fatale Verkopplung von sozialer Herkunft und mangelnden Bildungs- oder Berufschancen.“"
                            },
                            {
                                "example_id": "17196513-a526-4785-b7d7-91944849d8c8",
                                "sense_id": "9295d14c-ebfc-3587-adae-50e83c4893dc",
                                "text": "„Aber die Verkopplung von Essen und Gesellschaft haben wir noch nicht verstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
