                                        "sense_id": "6a760ec3-5fe5-3bdf-9eb6-b91050c27b4c",
                                        "entry_id": "dae9d15e-77a1-346a-9021-862cc11de4da",
                                        "glosses": [
                                            "удлинённая повозка без кузова, передняя и задняя части которой соединены продольными брусьями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a072e3ae-9609-46d6-8e3f-fbabd4265f37",
                                                "sense_id": "6a760ec3-5fe5-3bdf-9eb6-b91050c27b4c",
                                                "text": "Маша со скрипом отворила нам ворота, мы сели на дроги и выехали со двора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e154fa-8235-3483-a238-16b76903f721",
                                        "entry_id": "dae9d15e-77a1-346a-9021-862cc11de4da",
                                        "glosses": [
                                            "погребальная повозка, колесница для перевозки умерших"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046b0325-d38a-44dc-92cf-403fcb070e80",
                                                "sense_id": "b5e154fa-8235-3483-a238-16b76903f721",
                                                "text": "Перед соседним домом дожидались похоронные дроги. Вынесли гроб, выкрашенный масляной краской, под дуб. Дроги тронулись в свой обычный страшный путь."
                                            }
                                        ]
                                    }
