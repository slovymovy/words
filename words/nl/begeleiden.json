{
    "word_family": [
        "begeleider",
        "begeleiding",
        "begeleidster"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8519344-39fb-35ae-ad25-05ea088e3b30",
                    "sense_definition": "iemand op zijn weg vergezellen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vergezellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vader en moeder <w>begeleidden</w> Ivo samen toen hij voor het eerst naar zwemles ging.",
                            "target_lang_translations": {
                                "en": "Father and mother <w>accompanied</w> Ivo together when he went to swimming lessons for the first time."
                            }
                        },
                        {
                            "text": "Zal ik je naar het station <w>begeleiden</w> zodat je niet alleen hoeft te lopen?",
                            "target_lang_translations": {
                                "en": "Shall I <w>walk</w> you to the station so you don't have to go alone?"
                            }
                        }
                    ],
                    "synonyms": [
                        "escorteren"
                    ],
                    "common_phrases": [
                        "naar de uitgang begeleiden",
                        "iemand naar huis begeleiden"
                    ],
                    "target_lang_definitions": {
                        "en": "to go with someone on their way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accompany",
                                "target_lang_sense_clarification": "to go with as a companion"
                            },
                            {
                                "target_lang_word": "escort",
                                "target_lang_sense_clarification": "to go with for protection or ceremony"
                            },
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "to go with someone on foot to a destination"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e610b77e-177b-3b14-b0a2-faadf34f648a",
                    "sense_definition": "een partij spelen die de harmonische aanvulling is van een solopartij",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zanger werd <w>begeleid</w> op een spinet en een vedel.",
                            "target_lang_translations": {
                                "en": "The singer was <w>accompanied</w> on a spinet and a fiddle."
                            }
                        },
                        {
                            "text": "Zij kan de pianist op de gitaar <w>begeleiden</w> tijdens het concert.",
                            "target_lang_translations": {
                                "en": "She can <w>accompany</w> the pianist on the guitar during the concert."
                            }
                        }
                    ],
                    "synonyms": [
                        "accompagneren"
                    ],
                    "common_phrases": [
                        "op de piano begeleiden",
                        "een zanger begeleiden"
                    ],
                    "target_lang_definitions": {
                        "en": "to play a part that harmoniously complements a solo part"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accompany",
                                "target_lang_sense_clarification": "to play music with a soloist"
                            },
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "to provide musical support for a singer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f1414b7-37c5-34d4-92db-2ca33d1768d9",
                    "sense_definition": "iemand helpen of steunen bij een proces of ontwikkeling",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ondersteuning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar <w>begeleidt</w> zijn leerlingen naar het examen.",
                            "target_lang_translations": {
                                "en": "The teacher <w>guides</w> his students toward the exam."
                            }
                        },
                        {
                            "text": "Het is belangrijk om stagiairs goed te <w>begeleiden</w> tijdens hun eerste werkweek.",
                            "target_lang_translations": {
                                "en": "It is important to <w>supervise</w> interns well during their first week of work."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leerlingen begeleiden",
                        "een project begeleiden"
                    ],
                    "target_lang_definitions": {
                        "en": "to help or support someone during a process or development"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guide",
                                "target_lang_sense_clarification": "to help through a process"
                            },
                            {
                                "target_lang_word": "mentor",
                                "target_lang_sense_clarification": "to support someone's development"
                            },
                            {
                                "target_lang_word": "supervise",
                                "target_lang_sense_clarification": "to oversee and help a student or trainee"
                            },
                            {
                                "target_lang_word": "coach",
                                "target_lang_sense_clarification": "to give instruction and support"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}