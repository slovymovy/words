                ],
                "senses": [
                    {
                        "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                        "entry_id": "35d58ba4-46ca-3ce0-9b77-1831aa574d80",
                        "glosses": [
                            "Bruch (= schwerwiegende Verletzung eines Knochens) eines oder mehrerer Zehen (= die den Fingern entsprechenden Teile der Füße)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0596cd7f-c9f7-41b6-9269-30847dff58a7",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "Er lief gegen das Tischbein und zog sich einen Zehenbruch zu."
                            },
                            {
                                "example_id": "8e2942cb-259b-4374-a829-bf854ec45808",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "Er kann erst wieder Fußball spielen, wenn der Zehenbruch geheilt ist."
                            },
                            {
                                "example_id": "6ffb7054-6997-4780-9b06-8b8537d13196",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "Nach ihrem Zehenbruch musste sie auf den Marathon verzichten."
                            },
                            {
                                "example_id": "c9005673-eb21-463a-bbc1-73818a17733b",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Der häufigste Zehenbruch ist tatsächlich der Bruch der kleinen Zehe.“"
                            },
                            {
                                "example_id": "7ec58197-e400-4dc7-8fee-5902c2897b61",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Ein Zehenbruch (Fraktur) bereitet bei Belastung und Druck Schmerzen.“"
                            },
                            {
                                "example_id": "683b3856-b1f2-41f1-9b35-feec7200baa9",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Bei einem Zehenbruch können Sie den betroffenen Zeh durch Tapen ruhigstellen und so die Schmerzen lindern.“"
                            },
                            {
                                "example_id": "c4cd69bc-d327-482e-a4ab-81e3b6e0842e",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "[…] „er verpasste nur zwei Bundesliga-Spiele aufgrund eines Zehenbruchs“ […]."
                            },
                            {
                                "example_id": "063b851a-9237-4851-8c73-d988c88e07c6",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Der Mittelfeldspieler von Bayern München sagte Bundestrainer Joachim Löw aufgrund eines Zehenbruchs ab.“"
                            },
                            {
                                "example_id": "2c2da43e-f608-4746-b90e-0b0fa4b1c235",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Den Großteil der Saison fiel er allerdings wegen eines Zehenbruchs und eines Muskelfaserrisses aus.“"
                            },
                            {
                                "example_id": "a7f8a0a7-1241-499d-9da1-9209f398b638",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Spielmacherin Marozsan hat nach ihrem Zehenbruch zwar das Abschlusstraining absolviert, steht aber nicht in der Startelf.“"
                            },
                            {
                                "example_id": "12fd1a68-368e-4d62-8736-70c4fe126b1c",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Ein Zehenbruch, der operiert werden musste, zwang sie zu einer viermonatigen Wettkampfpause.“"
                            },
                            {
                                "example_id": "c2c86a84-ef57-4183-9ed8-965c57829784",
                                "sense_id": "0dfb6711-27fb-39e3-9ef5-52e973badc07",
                                "text": "„Bei einem Finger- oder Zehenbruch fixieren Sie das Glied, indem Sie es an ein Nebenglied binden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
