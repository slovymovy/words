                "senses": [
                    {
                        "sense_id": "ad9f703b-417c-3b48-a194-600093441ccd",
                        "entry_id": "2c594fdf-64dd-3a02-9ba0-304ffbcf7da0",
                        "glosses": [
                            "Geschwindigkeit der Luftbewegung (= des Windes), gemessen in einer beliebigen Einheit, beispielsweise km/h"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64670546-ca2c-4167-9353-f5fa3a647ea5",
                                "sense_id": "ad9f703b-417c-3b48-a194-600093441ccd",
                                "text": "Die Windstärke kann man mit einem Anemometer messen. Oder man beobachtet die Wellenhöhe und schließt daraus auf die Windstärke in Beaufort zurück."
                            },
                            {
                                "example_id": "ac8ea884-46a4-41f6-80e5-da3babdda7f1",
                                "sense_id": "ad9f703b-417c-3b48-a194-600093441ccd",
                                "text": "Das Umweltschutzministerium führte den aktuellen Anstieg der Luftverschmutzung auf eine ungünstige Wetterlage mit geringer Windstärke zurück."
                            },
                            {
                                "example_id": "c75a56c5-87ce-4d4f-9467-2824c2adcfff",
                                "sense_id": "ad9f703b-417c-3b48-a194-600093441ccd",
                                "text": "Forscher des Leibniz-Zentrums für Agrarlandschaftsforschung wollen herausfinden, welche Flächen Brandenburgs anfällig sind für Winderosion, welche Arten von Boden, und ab welcher Windstärke."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f29b1f8e-c2ff-3617-9e6f-14f539894282",
                        "entry_id": "2c594fdf-64dd-3a02-9ba0-304ffbcf7da0",
                        "glosses": [
                            "Messung von [1] mit Hilfe der Beaufortskala: Windstärke eins, Windstärke zwei, …, Windstärke zwölf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd511172-de2a-4479-b3d8-1016ef1f3aa9",
                                "sense_id": "f29b1f8e-c2ff-3617-9e6f-14f539894282",
                                "text": "Die Windstärke kann man mit einem Anemometer messen. Oder man beobachtet die Wellenhöhe und schließt daraus auf die Windstärke in Beaufort zurück."
                            },
                            {
                                "example_id": "f112dd63-8c33-45fd-89e0-53b5e91a3bad",
                                "sense_id": "f29b1f8e-c2ff-3617-9e6f-14f539894282",
                                "text": "Nachdem der Deutsche Wetterdienst Böen von einer Windstärke zehn vorhergesagt habe, sei das Risiko zu hoch gewesen [, den Mainzer Rosenmontagszug stattfinden zu lassen], sagte ein Sprecher des MCV."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86807441-b821-48e3-9dac-025dfbce742c",
                        "source_entry_id": "2c594fdf-64dd-3a02-9ba0-304ffbcf7da0",
                        "source_sense_id": "ad9f703b-417c-3b48-a194-600093441ccd",
                        "target_lang_word": "wind speed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind speed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                        "entry_id": "3cba1e51-7229-38da-8551-58814d6ced57",
                                        "glosses": [
                                            "The local speed of the wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b2654-0bc5-4cfa-af9f-9021bdf1e3d2",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "Wind speed is measured by the conventional arrangement of three hemispherical cups, mounted at 120 deg. on a shaft which is geared to a cam."
                                            },
                                            {
                                                "example_id": "6c40e1f5-b171-4977-88a9-458e70db612f",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "a49a54c6-095b-4220-9b1e-772e077c29d1",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "The climate testing ranged through temperatures of -15°C to 40°C, extreme warming from sunlight, ice, and wind speeds of up to 100kph (62mph) to check the train could still operate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
