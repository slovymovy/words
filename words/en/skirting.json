{
    "word_family": [
        "skirt",
        "outskirt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d989caa2-35fb-375c-940c-dde8948fcd35",
                    "sense_definition": "present participle and gerund of <w>skirt</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers spent the afternoon <w>skirting</w> the edge of the deep forest to avoid getting lost.",
                            "target_lang_translations": {
                                "ru": "Туристы провели вторую половину дня, <w>обходя</w> опушку густого леса, чтобы не заблудиться."
                            }
                        },
                        {
                            "text": "He was <w>skirting</w> the issue during the meeting because he did not want to admit his mistake.",
                            "target_lang_translations": {
                                "ru": "На собрании он <w>уклонялся</w> от обсуждения вопроса, так как не хотел признавать свою ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "bypassing",
                        "evading",
                        "bordering"
                    ],
                    "antonyms": [
                        "confronting",
                        "entering"
                    ],
                    "common_phrases": [
                        "skirting the issue",
                        "skirting the edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «skirt» (обходить, огибать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обходя",
                                "target_lang_sense_clarification": "двигаясь вдоль края"
                            },
                            {
                                "target_lang_word": "уклоняясь",
                                "target_lang_sense_clarification": "избегая обсуждения темы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c1c2278-a1e9-344e-9cd5-4a4a40ac8053",
                    "sense_definition": "A wooden board or molding covering the lowest part of an interior wall.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter installed new <w>skirting</w> along the base of the walls to hide the gap near the floor.",
                            "target_lang_translations": {
                                "ru": "Плотник установил новый <w>плинтус</w> вдоль основания стен, чтобы скрыть щель у пола."
                            }
                        },
                        {
                            "text": "We need to paint the <w>skirting</w> board white to match the rest of the room's trim.",
                            "target_lang_translations": {
                                "ru": "Нам нужно покрасить <w>плинтус</w> в белый цвет, чтобы он сочетался с остальной отделкой комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "baseboard",
                        "mopboard",
                        "skirting board"
                    ],
                    "common_phrases": [
                        "skirting board",
                        "timber skirting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянная доска или молдинг, закрывающий нижнюю часть внутренней стены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плинтус",
                                "target_lang_sense_clarification": "декоративная планка вдоль пола"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0a69412-b35c-3131-8f66-04eb21fb02e2",
                    "sense_definition": "The act of moving around the edge of something or avoiding a difficult topic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their constant <w>skirting</w> around the laws of defamation made the article very difficult to publish.",
                            "target_lang_translations": {
                                "ru": "Их постоянное <w>балансирование на грани</w> законов о клевете сильно затруднило публикацию статьи."
                            }
                        },
                        {
                            "text": "The pilot's careful <w>skirting</w> of the storm clouds ensured a smooth flight for the passengers.",
                            "target_lang_translations": {
                                "ru": "Осторожный <w>обход</w> грозовых туч пилотом обеспечил пассажирам спокойный полет."
                            }
                        }
                    ],
                    "synonyms": [
                        "avoidance",
                        "circumvention",
                        "evasion"
                    ],
                    "antonyms": [
                        "confrontation"
                    ],
                    "common_phrases": [
                        "skirting around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению вдоль края чего-либо или избегание сложной темы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "движение по периметру"
                            },
                            {
                                "target_lang_word": "уклонение",
                                "target_lang_sense_clarification": "избегание ответственности или темы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "257fba96-fb23-3231-b613-d15f3a9db22c",
                    "sense_definition": "Material used for making skirts, or a collection of skirts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textile factory specialized in high-quality wool <w>skirting</w> for the autumn fashion line.",
                            "target_lang_translations": {
                                "ru": "Текстильная фабрика специализировалась на высококачественной шерстяной <w>ткани для юбок</w> для осенней коллекции моды."
                            }
                        },
                        {
                            "text": "She bought several yards of silk <w>skirting</w> to create a custom dress for the gala.",
                            "target_lang_translations": {
                                "ru": "Она купила несколько ярдов шелкового <w>материала</w> для юбки, чтобы сшить платье на заказ для торжественного вечера."
                            }
                        }
                    ],
                    "synonyms": [
                        "fabric",
                        "material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, используемый для пошива юбок, или набор юбок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материал для юбок",
                                "target_lang_sense_clarification": "ткань"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}