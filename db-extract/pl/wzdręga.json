                        "target_lang_word": "rudd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff972c1-c98b-3ebb-bf7d-a3fe6acb4603",
                                        "entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                                        "glosses": [
                                            "Any species of the freshwater game fishes of genus Scardinius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed8d8ae-fd44-4026-8832-6049e5298f45",
                                                "sense_id": "8ff972c1-c98b-3ebb-bf7d-a3fe6acb4603",
                                                "text": "Within minutes of starting I had my first fish a rudd about a pound, this was followed by a tench about five pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a7a370-7b4a-3841-a293-e3d0b1db2327",
                                        "entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                                        "glosses": [
                                            "Any species of the freshwater game fishes of genus Scardinius.",
                                            "common rudd (Scardinius erythrophthalmus)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9cea03-897e-4686-8760-949ca75ffb70",
                        "source_entry_id": "9f4e0000-a3ff-3b78-9efe-0fda62cd631a",
                        "source_sense_id": "89dfb149-d2a0-3afc-88c7-15834f768efe",
                        "target_lang_word": "rotengle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotengle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                        "entry_id": "b4dbcdaf-919f-37e9-9e64-4197b8071fee",
                                        "glosses": [
                                            "Espèce de poisson osseux d’eau douce, des eaux calmes d’Europe et d’Asie, proche du gardon, dont les nageoires anale et ventrales ainsi que la queue et l’iris de l'œil sont de couleur rouge vif, de la famille des cyprinidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2f8487-c209-48e4-936f-0a16ab4fe601",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Présent dans toute l’Europe, à l’exception de l’Espagne et de l’Écosse, le rotengle se rencontre surtout dans la calme zone à brème, en lacs et en étangs."
                                            },
                                            {
                                                "example_id": "7a61d291-1ce6-44df-9f5a-b94fe386fc36",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Le rotengle est toujours prompt à saisir les esches près de la surface."
                                            },
                                            {
                                                "example_id": "26f3cd7b-c8c2-4879-a9f8-db8a9243383c",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Il pêchait parfois dans le canal situé au-dessus du moulin, alimenté par la rivière, dans les grands calmes où les rotengles, les poissons-chats et les carpes venaient se nourrir de grains concassés en balançant leurs flancs dans la lumière."
                                            },
                                            {
                                                "example_id": "8d2f6630-10a5-4d2d-b65d-f6ceba4dca0e",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "À l’automne, il nage dans les boucles du Tadouchou un grand nombre de rotengles, de saumons sibériens, d’ombles chevaliers, de saumons roses à bosse et de saumons kéta du Pacifique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
