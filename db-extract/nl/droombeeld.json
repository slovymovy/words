                "senses": [
                    {
                        "sense_id": "0b59544f-991a-3cd3-ae9c-4708cb70eb4e",
                        "entry_id": "b3957170-a8cb-3a3c-8c80-79116fab458b",
                        "glosses": [
                            "an image from a dream"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "bf989123-28db-43cb-a703-fa8a8b586b9f",
                                "sense_id": "0b59544f-991a-3cd3-ae9c-4708cb70eb4e",
                                "text": "Ze kon zich het droombeeld van haar nachtmerrie nog levendig herinneren.",
                                "translation": "She could vividly remember the dream image of her nightmare.",
                                "english": "She could vividly remember the dream image of her nightmare."
                            },
                            {
                                "example_id": "6383c7fc-bf05-49ae-a662-7a1d974f2aa4",
                                "sense_id": "0b59544f-991a-3cd3-ae9c-4708cb70eb4e",
                                "text": "Het droombeeldje van een eenhoorn bleef in haar hoofd hangen na het wakker worden.",
                                "translation": "The dream image of a unicorn lingered in her mind after waking up.",
                                "english": "The dream image of a unicorn lingered in her mind after waking up."
                            }
                        ]
                    },
                    {
                        "sense_id": "9affc987-a61b-3714-9da1-e1abb4ace86b",
                        "entry_id": "b3957170-a8cb-3a3c-8c80-79116fab458b",
                        "glosses": [
                            "a mirage, illusion, impossible wish or aspiration"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "f7bcfff6-ab16-4eeb-932b-0c3800f6df28",
                                "sense_id": "9affc987-a61b-3714-9da1-e1abb4ace86b",
                                "text": "Het idee van wereldvrede is vaak niet meer dan een mooi droombeeld.",
                                "translation": "The idea of world peace is often nothing more than a beautiful illusion.",
                                "english": "The idea of world peace is often nothing more than a beautiful illusion."
                            },
                            {
                                "example_id": "128d94c6-c083-461d-a199-bbdba8679099",
                                "sense_id": "9affc987-a61b-3714-9da1-e1abb4ace86b",
                                "text": "Het realiseren van een utopische samenleving blijft voor velen een onbereikbaar droombeeld.",
                                "translation": "Achieving a utopian society remains an unattainable dream for many.",
                                "english": "Achieving a utopian society remains an unattainable dream for many."
                            }
                        ]
                    }
                ],
