                ],
                "senses": [
                    {
                        "sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                        "entry_id": "003211ad-5637-369a-97f4-33bf1b4ec166",
                        "glosses": [
                            "Person, die einen entscheidenden Anteil am Entstehen von etwas (zum Beispiel Organisation, Staat, Forschungsrichtung) hat"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "f0eda6d1-2557-4464-8908-0ee4d91271f3",
                                "sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                                "text": "„Nach einer römischen Überlieferung wurde der Grundstein für den Jupitertempel, in dem Cicero am 8. November 63 v. Chr. seine Schmährede gegen Catilina hielt, siebenhundert Jahre zuvor von Romulus, dem Gründungsvater der Stadt, gelegt.“"
                            },
                            {
                                "example_id": "9734fa46-46df-4c56-9a56-2f411264e1ed",
                                "sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                                "text": "„Die Bundeswehr ist, wie ihre Gründungsväter sie mit Recht nannten, ein ‚Parlamentsheer‘. Sie steht unter dem Primat der Politik.“"
                            },
                            {
                                "example_id": "ca42524b-44a2-44e9-9a44-52bc2b7d096f",
                                "sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                                "text": "„Die drei Gründungsväter hatten verschieden Motive, die sie zusammenführten.“"
                            },
                            {
                                "example_id": "fb86c5de-2b60-41db-ad55-1519b797d1d8",
                                "sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                                "text": "„In der offiziellen Symbolik Pakistans - von den Geldscheinen bis hin zur Bezeichnung staatlicher Einrichtungen - nimmt Jinnah als Gründungsvater eine herausragende Rolle ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78b23d78-a180-4017-8f5e-5c47d0cd7438",
                        "source_entry_id": "003211ad-5637-369a-97f4-33bf1b4ec166",
                        "source_sense_id": "bb806f79-97ed-3c09-a527-4dcbcf028025",
                        "target_lang_word": "père fondateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "père fondateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac27d23d-f0d5-3f6f-b382-8fb65a926698",
                                        "entry_id": "c99bb1b8-bd71-36b9-a4e1-8de22a1e88e7",
                                        "glosses": [
                                            "Celui qui est à l’origine, qui a créé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9de89d22-005c-4c7f-b734-0dadf27dcf48",
                                                "sense_id": "ac27d23d-f0d5-3f6f-b382-8fb65a926698",
                                                "text": "Si l’on insiste ici sur les mérites d’un homme politique honteusement méconnu dans son propre pays — mais non pas à l’étranger —, c’est qu’il fut le véritable père fondateur d’une Europe devenue entre-temps la tarte à la crème de tous les discours."
                                            },
                                            {
                                                "example_id": "76b60515-9f42-48e5-9e87-c88d605a536b",
                                                "sense_id": "ac27d23d-f0d5-3f6f-b382-8fb65a926698",
                                                "text": "Ce qui entraîne – dans un chapitre parfois ardu pour le novice – jusqu’à la toute récente « théorie de la gravitation quantique à boucles », dont Rovelli est l’un des pères fondateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03863171-efe0-3430-939e-59f66dc88b9c",
                                        "entry_id": "c99bb1b8-bd71-36b9-a4e1-8de22a1e88e7",
                                        "glosses": [
                                            "Aux États-Unis, personne ayant contribué à la création de l’État, signataires des textes les plus importants pour l’indépendance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de2d03b7-6838-49c7-b0d5-7e3f68ab25f8",
                                                "sense_id": "03863171-efe0-3430-939e-59f66dc88b9c",
                                                "text": "Le système d’équilibre des pouvoirs, qui fait du Congrès le partenaire égal de la Maison Blanche, ne fonctionne plus tel que les Pères fondateurs l’avaient espéré. Pendant quatre ans, Trump et ceux qui ont travaillé pour lui se sont moqués des assignations émises par le Congrès et de son rôle de surveillance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
