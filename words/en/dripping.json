                        "cs": "Tuk, který se vypekl z masa při pečení, po zchladnutí tuhne a používá se při vaření."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жир",
                                "target_lang_sense_clarification": "кулинарный"
                            },
                            {
                                "target_lang_word": "топлёный жир",
                                "target_lang_sense_clarification": "вытопленный из мяса"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vypečený tuk",
                                "target_lang_sense_clarification": "kulinářský"
                            },
                            {
                                "target_lang_word": "sádlo",
                                "target_lang_sense_clarification": "vypečený masový tuk"
                            }
                        ]
