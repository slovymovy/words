                ],
                "senses": [
                    {
                        "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                        "entry_id": "27e9779e-6baf-380f-85ba-f90c00041672",
                        "glosses": [
                            "utopische Vorstellung einer technisch fortgeschrittenen Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48cf4ae6-07c9-4cd2-9c15-16d001cb6479",
                                "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                                "text": "„Am Ziel jeder Fortschrittsutopie stand stets der Mensch, der mit den Benutzeroberflächen so natürlich verschmolzen ist, dass die Schnittstellen ihn nicht mehr plagen.“"
                            },
                            {
                                "example_id": "97af1dd3-9339-4c5a-95fa-7feba7bde7e0",
                                "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                                "text": "„Während Caryl 1979 die Epochenschwelle ausmacht, in der die Fortschrittsutopie des Nachkriegs in Gegenreaktion und Pragmatismus kippte, verzichtet Bösch auf eine solche Bewertung.“"
                            },
                            {
                                "example_id": "ef0f52b2-a10f-4faf-b5e7-29098a16924b",
                                "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                                "text": "„Dostojewskijs ‚Aufzeichnungen aus dem Kellerloch‘ sind gleichsam als eine totale Negation der Fortschrittsutopie Tschernyschewskijs konzipiert.“"
                            },
                            {
                                "example_id": "f91c8efe-4f42-48ab-b7ea-55c059e12942",
                                "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                                "text": "„Ein anderer russischer Diskurs ist mit Dostojewskijs ‚Aufzeichnungen aus dem Kellerloch‘ angesprochen: der Antagonismus zwischen revolutionärer Fortschrittsutopie und konservativer Fortschrittskritik.“"
                            },
                            {
                                "example_id": "e3560a54-8163-4767-890d-bf9944022f83",
                                "sense_id": "590a35d9-1c19-3488-bc4e-1866ae55c0dd",
                                "text": "„Die Energiewende ist damit nicht Ausdruck von Zukunftsvertrauen und einer deutschen Fortschrittsutopie, als die sie gehandelt wird, sondern der Sehnsucht nach Planbarkeit und eines linearen Blicks auf Geschichte und Technik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
