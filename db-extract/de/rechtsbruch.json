                                                "sense_id": "9da2c354-796b-3d09-93e6-8d7858ccc977",
                                                "text": "Poser une pierre en délit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ebac3f-b54e-3dc3-8980-22a47d8e5447",
                                        "entry_id": "f60a995b-635a-3483-b6dc-7512df7f279e",
