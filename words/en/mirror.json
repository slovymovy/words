{
    "word_family": [
        "mirroring",
        "mirrored",
        "unmirrored"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2e608a2-3949-3e5d-8ebb-352478bca2d9",
                    "sense_definition": "A smooth surface, usually made of glass, that reflects light to show an image of what is in front of it.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reflective_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a look in the <w>mirror</w> to see if the blood had come off my face.",
                            "target_lang_translations": {
                                "ru": "Я посмотрел в <w>зеркало</w>, чтобы проверить, отмылась ли кровь с лица."
                            }
                        },
                        {
                            "text": "She checked her hair in the bathroom <w>mirror</w> before leaving for the party.",
                            "target_lang_translations": {
                                "ru": "Она поправила прическу перед <w>зеркалом</w> в ванной, прежде чем отправиться на вечеринку."
                            }
                        }
                    ],
                    "synonyms": [
                        "glass",
                        "looking-glass"
                    ],
                    "common_phrases": [
                        "bathroom mirror",
                        "rear-view mirror",
                        "look in the mirror"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладкая поверхность, обычно из стекла, которая отражает свет и показывает изображение того, что находится перед ней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зеркало",
                                "target_lang_sense_clarification": "предмет мебели или интерьера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92420862-2b7d-33f3-93f9-26daa574081d",
                    "sense_definition": "Something that reflects or gives a clear picture of something else, such as a situation or a person's character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His story is a <w>mirror</w> into the life of orphans growing up in the city.",
                            "target_lang_translations": {
                                "ru": "Его история — это <w>зеркало</w> жизни сирот, растущих в городе."
                            }
                        },
                        {
                            "text": "The art of a period is often a <w>mirror</w> of the society that produced it.",
                            "target_lang_translations": {
                                "ru": "Искусство определенного периода часто является <w>отражением</w> общества, которое его породило."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mirror of society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что отражает или дает четкое представление о чем-то другом, например, о ситуации или характере человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зеркало",
                                "target_lang_sense_clarification": "переносное значение, отражение реальности"
                            },
                            {
                                "target_lang_word": "отражение",
                                "target_lang_sense_clarification": "показатель ситуации или состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b0ce12-7dde-37cb-b9de-2b20d344de9d",
                    "sense_definition": "A website or server that contains an exact copy of the data from another site to reduce traffic or provide a backup.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although the content had been deleted from his blog, it was still found on some <w>mirrors</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя контент был удален из его блога, его все еще можно было найти на некоторых <w>зеркалах</w>."
                            }
                        },
                        {
                            "text": "You can download the software from the main site or use a local <w>mirror</w> site.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать программное обеспечение с основного сайта или использовать локальный <w>зеркальный</w> сайт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mirror site",
                        "server mirror"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Веб-сайт или сервер, содержащий точную копию данных с другого сайта для снижения трафика или обеспечения резервного копирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зеркало",
                                "target_lang_sense_clarification": "копия сайта или сервера"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "точный дубликат данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f95ea0c1-eacd-3c55-94e8-2ee43a38f4e5",
                    "sense_definition": "To reflect an image of something on a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reflection_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The still water of the lake <w>mirrored</w> the surrounding mountains perfectly.",
                            "target_lang_translations": {
                                "ru": "Спокойная вода озера идеально <w>отражала</w> окружающие горы."
                            }
                        },
                        {
                            "text": "The silver surface of the building <w>mirrors</w> the sky above.",
                            "target_lang_translations": {
                                "ru": "Серебристая поверхность здания <w>отражает</w> небо над ним."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отражать изображение чего-либо на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "показывать отражение"
                            },
                            {
                                "target_lang_word": "зеркалить",
                                "target_lang_sense_clarification": "разговорное, давать зеркальный эффект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4248ab66-3560-37ce-9b06-97f6b5e6435e",
                    "sense_definition": "To be very similar to something else or to copy someone's behavior or actions closely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>mirror</w> his mentor's success by following the same business strategy.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>повторить</w> успех своего наставника, следуя той же бизнес-стратегии."
                            }
                        },
                        {
                            "text": "The child began to <w>mirror</w> the behavior of his older brother.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>копировать</w> поведение своего старшего брата."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mirror behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень похожим на что-то другое или в точности копировать чье-то поведение или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "повторять чье-то поведение"
                            },
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "быть схожим по сути"
                            },
                            {
                                "target_lang_word": "повторять",
                                "target_lang_sense_clarification": "воспроизводить действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2027bd00-9a3b-39d6-b108-93201f4a5e22",
                    "sense_definition": "To correspond to or match something in position or structure, often as a symmetrical counterpart.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The placement of the paintings <w>mirrored</w> the positions of the windows on the opposite wall.",
                            "target_lang_translations": {
                                "ru": "Расположение картин <w>зеркально отражало</w> положение окон на противоположной стене."
                            }
                        },
                        {
                            "text": "The design of the left wing <w>mirrors</w> the right wing of the palace.",
                            "target_lang_translations": {
                                "ru": "Дизайн левого крыла <w>дублирует</w> правое крыло дворца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствовать чему-либо по положению или структуре, часто являясь симметричным дополнением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зеркально отражать",
                                "target_lang_sense_clarification": "соответствовать симметрично"
                            },
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "повторять структуру"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}