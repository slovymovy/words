                "entry_id": "b4b6bda3-e242-3475-bbbd-802ff8a2c481",
                "word": "cockney",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "451ea688-5f6a-339a-982e-572f07b12586",
                        "entry_id": "b4b6bda3-e242-3475-bbbd-802ff8a2c481",
                        "glosses": [
                            "Relatif aux personnes originaires des quartiers et des classes populaires de Londres ou à leur parler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f864c3b5-4395-411d-afd1-fbf26ad065ec",
                                "sense_id": "451ea688-5f6a-339a-982e-572f07b12586",
                                "text": "[…] un fin haïk blanc, majestueusement drapé sur la personne de quelque fonctionnaire maure, détonne presque autant que les fraîches toilettes des dames de la colonie européenne ou l’équipement des touristes cockneys qui envahissent la ville à l’arrivée du steamer de Londres : topis de liège, knicker-bockers, pipes courtes et kodaks braqués impitoyablement sur tous les chameaux qui passent, […]."
                            },
                            {
                                "example_id": "cc99b8fe-9913-43bd-83c2-ff088b12293f",
                                "sense_id": "451ea688-5f6a-339a-982e-572f07b12586",
                                "text": "Son anglais, presque toujours correct, compense çà et là certains restes d’intonation cockney par une pointe d’exotisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "272322fd-05a2-433c-ba07-75f17df59e6c",
                        "source_entry_id": "b4b6bda3-e242-3475-bbbd-802ff8a2c481",
                        "source_sense_id": "451ea688-5f6a-339a-982e-572f07b12586",
                        "target_lang_word": "cockney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cockney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b971c5c1-6f60-3fd6-89dd-6b34ff5db2bb",
                                        "entry_id": "2a33ca7e-654d-36e6-84cb-30858cb31cac",
                                        "glosses": [
                                            "A native or inhabitant of parts of the East End of London."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc64975-69b0-4d1e-b452-966bdf9b4c05",
                                                "sense_id": "b971c5c1-6f60-3fd6-89dd-6b34ff5db2bb",
                                                "text": "A cockney in a rural village was stared at as much as if he had entered a kraal of Hottentots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45e246f-bd46-392a-80ed-cca18d8693ba",
                                        "entry_id": "2a33ca7e-654d-36e6-84cb-30858cb31cac",
                                        "glosses": [
                                            "An effeminate person; a spoilt child."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cc321f-6269-47f3-8fd0-778771ed7cb0",
                                                "sense_id": "a45e246f-bd46-392a-80ed-cca18d8693ba",
                                                "text": "A young heir, or cockney, that is his mother's darling[…]"
                                            },
                                            {
                                                "example_id": "a127cba4-bd06-4756-8719-fda48176f506",
                                                "sense_id": "a45e246f-bd46-392a-80ed-cca18d8693ba",
                                                "text": "This great lubber, the world, will prove a cockney."
                                            }
                                        ]
                                    }
                                ]
                            },
