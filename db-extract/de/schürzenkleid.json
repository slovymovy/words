                                        "glosses": [
                                            "A sleeveless dress, often similar to an apron, generally worn over other clothes, and most often worn by young girls as an overdress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5441e4fc-bf6d-45df-b889-c4c36a67cf0b",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "“He looks just like an angel,” said the Charity Children as they came out of the cathedral in their bright scarlet cloaks, and their clean white pinafores."
                                            },
                                            {
                                                "example_id": "25e867a5-b38a-4a6b-827a-2d5ceedb6c6a",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "She was a strangely thin girl in a dark pinafore, with a pink handkerchief tied over her hair."
                                            },
                                            {
                                                "example_id": "c2e8e16d-170a-4cab-8d54-6862ad886033",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "The starched pinafore with the wide frills on each shoulder, which she always wore over her grey frock, was removed, and the frock itself changed for her best navy blue serge."
                                            },
                                            {
                                                "example_id": "8157718a-9d61-4af1-a8e0-6f278f75ae9b",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "The old man heaved himself from the chair, seized Jessamy by her pinafore frill and marched her to the house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinafore",
                                "target_lang_code": "en",
