                                "example_id": "0b42fc13-8194-41ef-a771-c5a8869db05d",
                                "sense_id": "e41e7e65-00c7-33ec-8bbc-44ae8f930a69",
                                "text": "Cette église était située au midi des bâtiments claustraux et avait sa façade occidentale sur le placis Saint-François qui fait partie maintenant de la place du Palais."
                            },
                            {
                                "example_id": "862ef71d-d7b7-4947-ad57-1df38107eb7d",
                                "sense_id": "e41e7e65-00c7-33ec-8bbc-44ae8f930a69",
                                "text": "Un décret du 8 mai 1896, donna ce nom au petit placis qui forme la tête du boulevard Saint-Aignan, derrière l’église Sainte-Anne."
                            },
                            {
                                "example_id": "c6573fa7-782b-4da8-89c9-1fe310396477",
                                "sense_id": "e41e7e65-00c7-33ec-8bbc-44ae8f930a69",
                                "text": "Mais il se demandait déjà s’il aurait la hardiesse de tourner à la croix du placis, de suivre le chemin qui passait devant les cours."
                            }
                        ]
