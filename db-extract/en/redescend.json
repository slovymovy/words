                "senses": [
                    {
                        "sense_id": "a730db9a-4313-30cb-9c81-f132b5c4fed2",
                        "entry_id": "94018f12-97c2-300f-b11e-1d0f524ecee1",
                        "glosses": [
                            "To descend again (often following an ascent)"
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc2f70a-67e2-4ce6-bee1-532c5d6c7270",
                                "sense_id": "a730db9a-4313-30cb-9c81-f132b5c4fed2",
                                "text": "I redescended the stairs, umbrella in hand, and slammed the door for the third time."
                            },
                            {
                                "example_id": "6d643fb0-60fe-4d0c-9196-c7e521b0cd5a",
                                "sense_id": "a730db9a-4313-30cb-9c81-f132b5c4fed2",
                                "text": "1650, James Howell, Epistolæ Ho-Elianæ, London: Humphrey Mosely, Letter 53, “A Hymne to the Blessed Trinity,” p. 67,\nTo thee sweet Spirit I return\nThat love wherwith my heart doth burn,\nAnd these bless’d notions of my brain\nI now breath up to thee again,\nO let them redescend, and still\nMy soul with holy raptures fill."
                            },
                            {
                                "example_id": "fd2bf27e-3670-4bcb-84d4-edf77f3369a5",
                                "sense_id": "a730db9a-4313-30cb-9c81-f132b5c4fed2",
                                "text": "[…] these vapours rise […] [and] are expanded in the rarefied air before they redescend in the form of clouds and drizzling rain;"
                            },
                            {
                                "example_id": "20290a84-6613-4fbf-9d41-d07bc3f4cc0e",
                                "sense_id": "a730db9a-4313-30cb-9c81-f132b5c4fed2",
                                "text": "[…] the whole troop of marsh-birds rose again, darkening heaven, with a simultaneous whirr; and long after that death yell was still ringing in my brain, silence had re-established its empire, and only the rustle of the redescending birds and the boom of the distant surges disturbed the languor of the afternoon."
                            }
                        ]
                    }
                ],
