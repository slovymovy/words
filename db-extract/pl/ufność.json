                    {
                        "sense_id": "8bbd326a-42f9-3f8e-a287-c204a5c41f6f",
                        "entry_id": "38c01f18-ce40-38ac-b28b-a2963e42f238",
                        "glosses": [
                            "skłonność do obdarzania zaufaniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7793870a-ac1a-4157-8d52-ebe1b65ec724",
                                "sense_id": "8bbd326a-42f9-3f8e-a287-c204a5c41f6f",
                                "text": "Pokładałem ufność w mojej ciotce, ale ostatecznie zawiodłem się na niej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae924b0d-396b-454d-8aae-b6d175d33781",
                        "source_entry_id": "38c01f18-ce40-38ac-b28b-a2963e42f238",
                        "source_sense_id": "8bbd326a-42f9-3f8e-a287-c204a5c41f6f",
                        "target_lang_word": "trustfulness",
