{
    "word_family": [
        "battering",
        "battered",
        "batterer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc119551-517a-3f1b-a153-3274ec0e2c94",
                    "sense_definition": "To hit or strike something or someone violently and repeatedly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy waves continued to <w>batter</w> the small boat against the rocks.",
                            "target_lang_translations": {
                                "ru": "Тяжелые волны продолжали <w>бить</w> маленькую лодку о скалы."
                            }
                        },
                        {
                            "text": "The firemen had to <w>batter</w> down the door to reach the people trapped inside.",
                            "target_lang_translations": {
                                "ru": "Пожарным пришлось <w>выломать</w> дверь, чтобы добраться до людей, оказавшихся в ловушке внутри."
                            }
                        }
                    ],
                    "common_phrases": [
                        "batter down the door",
                        "batter the coastline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно и многократно ударять или бить по чему-либо или кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колотить",
                                "target_lang_sense_clarification": "сильно бить по чему-либо"
                            },
                            {
                                "target_lang_word": "избивать",
                                "target_lang_sense_clarification": "наносить побои человеку"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "о волнах или ветре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fdd8ebe-1515-3a3d-b7c5-ecb6253683cc",
                    "sense_definition": "To defeat an opponent soundly or decisively in a game or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The home team managed to <w>batter</w> their rivals with a final score of six to zero.",
                            "target_lang_translations": {
                                "ru": "Хозяевам поля удалось <w>разгромить</w> своих соперников с финальным счетом шесть-ноль."
                            }
                        },
                        {
                            "text": "It was a one-sided match where they would <w>batter</w> the opposition from the very start.",
                            "target_lang_translations": {
                                "ru": "Это был односторонний матч, в котором они <w>громили</w> противника с самого начала."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash"
                    ],
                    "common_phrases": [
                        "batter the opposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убедительно или решительно победить противника в игре или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести сокрушительное поражение"
                            },
                            {
                                "target_lang_word": "поколотить",
                                "target_lang_sense_clarification": "разбить противника (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79090b7-ef87-3f10-bd24-81891c3cd556",
                    "sense_definition": "To coat food in a liquid mixture of flour and milk or eggs before cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef will <w>batter</w> the fish before dropping it into the hot oil.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар <w>обмакнет в кляр</w> рыбу, прежде чем опустить ее в горячее масло."
                            }
                        },
                        {
                            "text": "You should <w>batter</w> the chicken pieces evenly to ensure a crispy crust.",
                            "target_lang_translations": {
                                "ru": "Кусочки курицы следует равномерно <w>покрыть тестом</w>, чтобы получилась хрустящая корочка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "batter the fish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать еду жидкой смесью из муки и молока или яиц перед приготовлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обмакивать в кляр",
                                "target_lang_sense_clarification": "покрывать жидким тестом"
                            },
                            {
                                "target_lang_word": "жарить в кляре",
                                "target_lang_sense_clarification": "готовить в жидком тесте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076c12fd-dfc6-38fd-be8a-00de20134317",
                    "sense_definition": "To cause someone to become heavily intoxicated or drunk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful with those strong cocktails because they will <w>batter</w> you quickly.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен с этими крепкими коктейлями, потому что они быстро тебя <w>свалят</w>."
                            }
                        },
                        {
                            "text": "He knew that drinking so much ale would <w>batter</w> him before the night was over.",
                            "target_lang_translations": {
                                "ru": "Он знал, что такое количество эля <w>вырубит</w> его еще до конца вечера."
                            }
                        }
                    ],
                    "synonyms": [
                        "intoxicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить кого-либо в состояние сильного алкогольного опьянения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырубить",
                                "target_lang_sense_clarification": "о сильном опьянении (сленг)"
                            },
                            {
                                "target_lang_word": "свалить с ног",
                                "target_lang_sense_clarification": "о действии алкоголя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e66677be-e1c5-3767-83ea-d3b4fc76ccf1",
                    "sense_definition": "A liquid mixture of flour, eggs, and milk used in cooking for making pancakes or coating fried food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She whisked the ingredients together until the pancake <w>batter</w> was smooth.",
                            "target_lang_translations": {
                                "ru": "Она взбивала ингредиенты до тех пор, пока <w>тесто</w> для блинов не стало однородным."
                            }
                        },
                        {
                            "text": "Dip the onion rings into the <w>batter</w> before you fry them.",
                            "target_lang_translations": {
                                "ru": "Окуните луковые кольца в <w>кляр</w>, прежде чем жарить их."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pancake batter",
                        "cake batter",
                        "fish batter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкая смесь из муки, яиц и молока, используемая в кулинарии для приготовления блинов или панировки обжариваемых продуктов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кляр",
                                "target_lang_sense_clarification": "жидкое тесто для обжарки"
                            },
                            {
                                "target_lang_word": "жидкое тесто",
                                "target_lang_sense_clarification": "основа для блинов или оладий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f0bd98-78fd-3d40-a360-3a7bd7074e65",
                    "sense_definition": "The player in sports like baseball or cricket who is currently trying to hit the ball with a bat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_player",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>batter</w> stepped up to the plate and waited for the first pitch.",
                            "target_lang_translations": {
                                "ru": "<w>Бэттер</w> вышел на позицию и стал ждать первой подачи."
                            }
                        },
                        {
                            "text": "The next <w>batter</w> hit the ball deep into the outfield for a home run.",
                            "target_lang_translations": {
                                "ru": "Следующий <w>бьющий</w> отправил мяч далеко в аутфилд, совершив хоум-ран."
                            }
                        }
                    ],
                    "synonyms": [
                        "hitter",
                        "batsman"
                    ],
                    "common_phrases": [
                        "next batter",
                        "batter up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок в таких видах спорта, как бейсбол или крикет, который в данный момент пытается отбить мяч битой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бэттер",
                                "target_lang_sense_clarification": "спортивный термин"
                            },
                            {
                                "target_lang_word": "бьющий",
                                "target_lang_sense_clarification": "игрок с битой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ab04371-e0de-3fee-8e6c-644eee6da38d",
                    "sense_definition": "A period of excessive drinking or a heavy drinking session.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went on a <w>batter</w> that lasted the entire weekend after he lost his job.",
                            "target_lang_translations": {
                                "ru": "После потери работы он ушел в <w>запой</w>, который продлился все выходные."
                            }
                        },
                        {
                            "text": "The group of friends decided to go on a <w>batter</w> to celebrate the end of exams.",
                            "target_lang_translations": {
                                "ru": "Группа друзей решила устроить <w>попойку</w>, чтобы отпраздновать окончание экзаменов."
                            }
                        }
                    ],
                    "synonyms": [
                        "bender",
                        "binge"
                    ],
                    "common_phrases": [
                        "on a batter"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "chiefly British and Irish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период чрезмерного употребления алкоголя или затяжная пьянка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запой",
                                "target_lang_sense_clarification": "длительное пьянство"
                            },
                            {
                                "target_lang_word": "кутеж",
                                "target_lang_sense_clarification": "шумная пьянка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}