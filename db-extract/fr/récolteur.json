                    }
                ],
                "senses": [
                    {
                        "sense_id": "a40660f0-e2b4-3167-ad98-56d02202559d",
                        "entry_id": "15ede5c8-f663-3743-ae82-cf822aa37f80",
                        "glosses": [
                            "Machine, logiciel qui récolte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2363c3e-d2bf-4ca6-98f9-89b71c9ce78f",
                                "sense_id": "a40660f0-e2b4-3167-ad98-56d02202559d",
                                "text": "Le récolteur d'écran permet de prendre des captures d'écran."
                            },
                            {
                                "example_id": "79c5ff43-8dae-4e9a-8493-7ad2a2143160",
                                "sense_id": "a40660f0-e2b4-3167-ad98-56d02202559d",
                                "text": "Les outils traditionnels pour la récolte du ginseng étaient en os, car la racine a peur du métal. Les cueilleurs de ginseng sauvage passaient au moins TROIS HEURES à extraire une racine. Mais les producteurs du Wisconsin utilisaient un RÉCOLTEUR tiré par un tracteur.\nUn engin bruyant en métal, fait de bric et de broc, qui arrachait la couche supérieure du sol en un rien de temps et tamisait les racines avec un tapis roulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "37d94abc-8c2b-34d3-9640-c6d53938a601",
                        "entry_id": "15ede5c8-f663-3743-ae82-cf822aa37f80",
                        "glosses": [
                            "Botaniste trouveur d'une plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30069c9c-6eed-4ec1-97d8-4103bbb05e84",
                                "sense_id": "37d94abc-8c2b-34d3-9640-c6d53938a601",
                                "text": "L’étiquette porte généralement le nom de la plante sous forme d’un binôme latin (genre, espèce), le nom du récolteur et ses observations sur la plante vivante."
                            },
                            {
                                "example_id": "2973e3c5-4374-4885-907f-759b0b643cef",
                                "sense_id": "37d94abc-8c2b-34d3-9640-c6d53938a601",
                                "text": "L’érable trident doit son nom latin au hollandais Heinrich Buerger (1804-1858), récolteur au Japon pour le gouvernement hollandais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d2934fb-7a17-4723-932b-2f3ee6f2976f",
                        "source_entry_id": "15ede5c8-f663-3743-ae82-cf822aa37f80",
                        "source_sense_description": "Machine agricole",
                        "target_lang_word": "reaper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reaper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "279aa8ac-87b3-3ec3-aa99-3418adea458f",
                                        "entry_id": "bdf1e0f7-3ea2-3c8e-8c69-219b086fc319",
                                        "glosses": [
                                            "One who reaps; a person employed to harvest crops from the fields by reaping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a78ba795-ff0f-4302-9814-7b273c8a0b68",
                                                "sense_id": "279aa8ac-87b3-3ec3-aa99-3418adea458f",
                                                "text": "Even as we looked some rumour seemed to have spread, for we saw the reapers hurrying from the fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087c5f6a-544e-3546-bc93-3e98d6bf7cea",
                                        "entry_id": "bdf1e0f7-3ea2-3c8e-8c69-219b086fc319",
                                        "glosses": [
                                            "A machine used to harvest crops."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                        "entry_id": "bdf1e0f7-3ea2-3c8e-8c69-219b086fc319",
                                        "glosses": [
                                            "Ellipsis of Grim Reaper."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "capitalized",
                                            "ellipsis",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded91f44-a435-40b8-94a7-276829636023",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Thereafter when their cups were brimmed anew with foaming wine the Red Foliot spake among them and said, “O ye lords of Witchland, will you that I speak a dirge in honour of Gorice the King that the dark reaper hath this day gathered?”"
                                            },
                                            {
                                                "example_id": "b1fea9ab-f47c-49ab-9226-bfc4538c2bc7",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Don't fear the Reaper / We'll be able to fly"
                                            },
                                            {
                                                "example_id": "8dbeb545-a7e0-4fce-bbfe-eb29b9dca99b",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Why is the Grim Reaper a man? True, the noun ending would theoretically allow us to visualize the reaper as a woman as well, but we don't."
                                            },
                                            {
                                                "example_id": "07eeca31-26d5-4006-8157-abb4e0acb419",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "She told me she wanted to meet the reaper\nI had only done her a favor\nShe didn't deserve to die\nBut I deserved to kill her"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e491bddf-88fb-3530-a746-4c1aa4409261",
                                        "entry_id": "bdf1e0f7-3ea2-3c8e-8c69-219b086fc319",
                                        "glosses": [
                                            "A recluse spider (Loxosceles and Sicarius spp.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
