                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by a professor named <w>Gutter</w>.",
                            "target_lang_translations": {
                                "ru": "Научная статья была написана профессором по фамилии <w>Гаттер</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Gutter</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я познакомился с человеком по фамилии мистер <w>Гаттер</w>."
                            }
                        }
                    ],
