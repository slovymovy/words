                        "glosses": [
                            "Not subject to customs duties; uncustomable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1cbb9deb-aa4e-3872-b7e4-b273f801ed0e",
                        "entry_id": "eb2f48b4-05c1-3ebd-a7e6-7fea4cbe5422",
                        "glosses": [
                            "On which no customs duties have been paid."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf172d5-9066-40b7-a10a-83d8c5b92016",
                                "sense_id": "1cbb9deb-aa4e-3872-b7e4-b273f801ed0e",
                                "text": "[…] with them came a great numbre of rascal & pedlers, & Iuellers, and brought ouer hattes and cappes, and diuerse merchaundise vncustomed, all vnder the coloure of the trussery of the Ambassadours."
                            },
                            {
                                "example_id": "5d1c07fb-bca0-4c96-9f92-8cdc69848a68",
                                "sense_id": "1cbb9deb-aa4e-3872-b7e4-b273f801ed0e",
                                "text": "In the Duchie of Millan, the Governour is very politike and severe, in searching after bookes and uncustomed wares, though it tend but to a paire of stockings […]"
                            },
                            {
                                "example_id": "69363971-22c2-4463-ac0e-e7253df573ea",
                                "sense_id": "1cbb9deb-aa4e-3872-b7e4-b273f801ed0e",
                                "text": "1760, Tobias Smollett, Continuation of the Complete History of England, London: Richard Baldwin, Volume 3, p. 331,\n[…] a bill was prepared […] importing a continuation of several laws, namely, the several clauses mentioned of the acts in the fifth and eighth of king George I. against the clandestine running of uncustomed goods […]"
                            },
                            {
                                "example_id": "c0e716a9-f9bc-42a5-acf5-0a3ae85b3bc9",
                                "sense_id": "1cbb9deb-aa4e-3872-b7e4-b273f801ed0e",
                                "text": "Every uncustomed spirit, every prohibited ware, physical and intellectual, there finds its mart; and the chief art that is practised is to cheat as cleverly as may be—the chief science learned, is how to defraud without being detected."
                            }
                        ]
                    }
