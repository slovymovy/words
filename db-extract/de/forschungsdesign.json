                "senses": [
                    {
                        "sense_id": "5dc2013e-482e-3362-acea-b80bd542893f",
                        "entry_id": "e71dbe0a-48e8-3df2-8a56-cdb6b2240569",
                        "glosses": [
                            "Grundlage einer wissenschaftlichen Untersuchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0023d30-9b0d-4fc5-8c8b-b8a1ffbe7c8a",
                                "sense_id": "5dc2013e-482e-3362-acea-b80bd542893f",
                                "text": "„Diese zentrale Fragestellung wird anhand eines analytischen Forschungsdesigns überprüft.“"
                            },
                            {
                                "example_id": "3f962ff3-34c6-4c3d-b9b6-f45683a1e340",
                                "sense_id": "5dc2013e-482e-3362-acea-b80bd542893f",
                                "text": "„Da sie ein quantitatives Forschungsdesign gewählt haben, kann ihre Arbeit jedoch nicht beleuchten, welche Dynamiken im Detail bei einer Mobilisierung entlang indigener Identitäten entstehen.“"
                            },
                            {
                                "example_id": "4bc02e89-3bdb-4c06-b834-63a0643a4a3b",
                                "sense_id": "5dc2013e-482e-3362-acea-b80bd542893f",
                                "text": "„Martina Braasch betrachtet den Einfluss sozialer Online-Netzwerke für die Bewältigung von Stress und den Erhalt von Social Support empirisch in einem qualitativ-explorativen Forschungsdesign.“"
                            }
                        ],
