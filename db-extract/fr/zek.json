                    }
                ],
                "senses": [
                    {
                        "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                        "entry_id": "ad621fd5-08ba-3738-8c81-1cae543414e2",
                        "glosses": [
                            "Prisonnier·e du goulag en URSS."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b2f0e8-3025-4a48-8921-1f6d50346891",
                                "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                                "text": "Un autre soldat, au poste de garde, voit s’approcher un zek tenant sa feuille de contrôle […]."
                            },
                            {
                                "example_id": "377dfe15-9c6b-4609-8ace-bbc60c04dac7",
                                "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                                "text": "Les zeks, dans le Goulag, se faisaient tatouer sur le front : « esclave du Parti communiste de l’Union soviétique »."
                            },
                            {
                                "example_id": "38a7fc78-e6db-40f5-a4b9-80ad0aa85b0d",
                                "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                                "text": "Puis, pendant dix ans et trois mois, il fut le « zek » Khodorkovski, un prisonnier très particulier."
                            },
                            {
                                "example_id": "aa9889b6-c864-4567-b1a8-7175ef9802c1",
                                "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                                "text": "Le but était l’extraction des matières premières des territoires hostiles de l’Extrême-Orient russe. Les zeks étaient exploités comme le « bois de chauffe » de cette conquête avec un cynisme sans limite."
                            },
                            {
                                "example_id": "cca1597f-b7ad-49bd-a538-062012ed10e4",
                                "sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                                "text": "Du Lac força comme un zek dans la profonde, ne voulant pas entendre parler du demi-tour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbb8753b-bd6d-4c90-a816-df7d7dba07ec",
                        "source_entry_id": "ad621fd5-08ba-3738-8c81-1cae543414e2",
                        "source_sense_id": "8afa6b3d-4349-3e6a-81f0-5097d72151f9",
                        "target_lang_word": "zek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a710f333-296f-3b20-a3e3-900be40d05fb",
                                        "entry_id": "d6085a7b-2f97-3cd2-814d-2afdcd942442",
                                        "glosses": [
                                            "A prisoner at a Russian prison, especially (historical) at a Soviet labour camp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd3c065-14c3-4df9-9971-58757d346d0a",
                                                "sense_id": "a710f333-296f-3b20-a3e3-900be40d05fb",
                                                "text": "Every prisoner who recants is a potential influence on other zeks to do likewise."
                                            },
                                            {
                                                "example_id": "b196a1e7-9748-4126-9757-7bda5a294623",
                                                "sense_id": "a710f333-296f-3b20-a3e3-900be40d05fb",
                                                "text": "There are the zeks, the survivors of the gulags, some honest about their experiences, others still deluded or traumatised decades later."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
