                "senses": [
                    {
                        "sense_id": "c4ee24dc-c475-3cb6-ba6a-e4e083d13e03",
                        "entry_id": "37897cde-9628-3f38-94c8-76511bee2691",
                        "glosses": [
                            "theirs (singular); a third person singular possessive pronoun referring to a nonbinary person or person of unspecified gender"
                        ],
                        "tags": [
                            "neologism",
                            "nonstandard",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "02cc5ce1-1ff3-4c2b-b63e-930cddca2191",
                                "sense_id": "c4ee24dc-c475-3cb6-ba6a-e4e083d13e03",
                                "text": "mein Vater und sierer",
                                "translation": "my father and theirs",
                                "english": "my father and theirs"
                            },
                            {
                                "example_id": "70adaa3c-9db8-421a-b995-f384548807ad",
                                "sense_id": "c4ee24dc-c475-3cb6-ba6a-e4e083d13e03",
                                "text": "mein Kind und sier(e)s",
                                "translation": "my child and theirs",
                                "english": "my child and theirs"
                            },
                            {
                                "example_id": "769be9ed-d7b9-4ae7-8761-448040b4ee5b",
                                "sense_id": "c4ee24dc-c475-3cb6-ba6a-e4e083d13e03",
                                "text": "Gestern habe ich meinen Reisepass bekommen. Hat sier sieren bekommen?",
                                "translation": "Yesterday I got my passport. Have they gotten theirs?",
                                "english": "Yesterday I got my passport. Have they gotten theirs?"
                            },
                            {
                                "example_id": "30d7c5d9-7374-4f6f-94c5-5a24a67001ed",
                                "sense_id": "c4ee24dc-c475-3cb6-ba6a-e4e083d13e03",
                                "text": "Greer sieht zu meinen Haaren und zeigt dann auf siere.",
                                "translation": "Greer looks at my hair and then points to theirs.",
                                "english": "Greer looks at my hair and then points to theirs."
                            }
                        ]
                    }
