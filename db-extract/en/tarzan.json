                                        "glosses": [
                                            "postać literacka, bohater książek, filmów i komiksów; człowiek wychowany przez małpy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e331ed-61e3-40ef-ab80-737581f9c234",
                                                "sense_id": "8a014daf-fa31-39e1-8406-5ebe26b5be8e",
                                                "text": "Wtedy zauważył Tarzana, gdy chłopiec wyszedł spod drapiącego, potrącającego się tłumu małp, z tym owłosionym przedramieniem, trzymanym mocno przy jego ciele."
                                            }
                                        ],
