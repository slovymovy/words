                    {
                        "sense_id": "ab55119e-3799-3c0d-9657-43bc5e725d40",
                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                        "glosses": [
                            "Espèce de grand poisson osseux marin carnivore, carangidé au corps aplati."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e300e7-e981-49bd-9aa6-470a72a9cb2d",
                                "sense_id": "ab55119e-3799-3c0d-9657-43bc5e725d40",
                                "text": "Les carangues, les pompaneaux, les trachinotes et les liches font tous partie de la famille des carangidés qui compte 140 espèces dans le monde, principalement dans les mers tropicales. Très recherchés pour la qualité de leur chair, ces poissons sont très importants sur le plan commercial."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ab50fa0-1134-3c73-ae55-c4f1258ec2ef",
                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                        "glosses": [
                            "Synonyme de sériole couronnée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98c23445-350f-3cc8-85db-def9450020b0",
                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                        "glosses": [
                            "Un des noms vernaculaires du Scymnus lichia, nommé aussi gatta."
                        ],
                        "tags": [],
