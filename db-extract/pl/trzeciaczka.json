                                "target_senses": [
                                    {
                                        "sense_id": "ee0548d8-f6fa-3faf-8742-6b993369806f",
                                        "entry_id": "81acbc1e-a8a1-3dc5-9102-ec94ba4aae33",
                                        "glosses": [
                                            "A tertian fever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c729df5c-5d18-4a91-96ed-c04357004d06",
                                                "sense_id": "ee0548d8-f6fa-3faf-8742-6b993369806f",
                                                "text": "And although we feele it not, it is not to bee doubted, if a continuall ague may in the end suppresse our mind, a tertian will also (according to her measure and proportion) breed some alteration in it."
                                            },
                                            {
                                                "example_id": "5d500d59-df7a-43b2-a443-20009be9379d",
                                                "sense_id": "ee0548d8-f6fa-3faf-8742-6b993369806f",
                                                "text": "He died of the slow fever call'd the tertian, / And left his widow to her own aversion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d93e9a-b49d-3453-bbfb-b03fa1f2c221",
                                        "entry_id": "81acbc1e-a8a1-3dc5-9102-ec94ba4aae33",
                                        "glosses": [
                                            "A cask of a certain size; its volume used as a measure of capacity (one-third of a tun's)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e78bf18-f51d-3a3b-83c5-bcb4da607d1e",
                                        "entry_id": "81acbc1e-a8a1-3dc5-9102-ec94ba4aae33",
                                        "glosses": [
                                            "A Jesuit going through tertianship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
