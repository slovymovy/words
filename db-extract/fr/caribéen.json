                                        "sense_id": "45b14941-234a-3cfd-ada2-1516d502d582",
                                        "entry_id": "ae6fed44-6dd0-3e69-bf12-fc7d4ba7c72b",
                                        "glosses": [
                                            "auf die Karibik oder das Karibische Meer bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0002e751-ca1f-41c8-89f3-33b530ce59f2",
                                                "sense_id": "45b14941-234a-3cfd-ada2-1516d502d582",
                                                "text": "Die karibischen Inselbewohner ärgern sich über die Steuererhöhungen."
                                            },
                                            {
                                                "example_id": "2c23ac86-c158-4f43-889e-1c5eec935e30",
                                                "sense_id": "45b14941-234a-3cfd-ada2-1516d502d582",
                                                "text": "„Doch hielten sich die Gewinnspannen in Grenzen, weil der karibische Tabak nicht annähernd die Qualität der Erzeugnisse aus Virginia erreichte und zudem die Preise stark schwankten.“"
                                            },
                                            {
                                                "example_id": "35c6d700-91c3-445d-bde9-024db291c330",
                                                "sense_id": "45b14941-234a-3cfd-ada2-1516d502d582",
                                                "text": "„Er muss die karibischen Kaufleute ziemlich beeindruckt haben, denn sie schickten ihn zum Studium aufs Festland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
