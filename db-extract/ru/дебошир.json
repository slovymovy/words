                                                "example_id": "95139f36-e7d0-42db-bca5-63efcf304b2a",
                                                "sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                                                "text": "Mehrere Randalierer wurden festgenommen."
                                            },
                                            {
                                                "example_id": "f1d761f0-df51-469c-a1cf-fc3a8ea6b04d",
                                                "sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                                                "text": "„Hooligan stammt aus dem Englischen und bedeutet übersetzt Randalierer.“"
                                            }
                                        ],
