                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Я иду в кино со своей подругой <Любой>.",
                            "target_lang_translations": {
                                "en": "I am going to the cinema with my friend <w>Lyuba</w>.",
                                "zh": "我正要和我的朋友<w>柳芭</w>去看电影。"
                            }
                        },
                        {
                            "text": "Мы долго разговаривали с <Любой> о планах на лето.",
                            "target_lang_translations": {
                                "en": "We talked for a long time with <w>Lyuba</w> about summer plans.",
                                "zh": "我们和<w>柳芭</w>聊了很久关于暑假的计划。"
                            }
                        }
                    ],
