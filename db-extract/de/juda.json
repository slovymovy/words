                        "entry_id": "9584a3f8-f70e-3dfc-bd1c-377936f7da2f",
                        "glosses": [
                            "antikes Königreich im Süden von Palästina"
                        ],
                        "tags": [
                            "biblisch"
                        ],
                        "examples": [
                            {
                                "example_id": "098c7228-105b-4d7c-b497-b50c3235d667",
                                "sense_id": "6a9dec55-3ff6-38a0-81b5-7b8dd8312ac4",
                                "text": "In der Zeit vor der Bildung Judas war Palästina einesteils von halbnomadischen segmentären Gesellschaften im Gebirge geprägt, zum anderen durch kleine Stadtstaaten in den Ebenen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39abc18f-b9ff-4a4f-88d0-661b1612caa1",
                        "source_entry_id": "9584a3f8-f70e-3dfc-bd1c-377936f7da2f",
                        "source_sense_id": "6a9dec55-3ff6-38a0-81b5-7b8dd8312ac4",
                        "source_sense_description": "biblisch: antikes Königreich im Süden von Palästina",
                        "target_lang_word": "Judah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
