                "senses": [
                    {
                        "sense_id": "8108bd41-a5dc-36d9-ac1a-a61c2b0c15ef",
                        "entry_id": "91571bca-71f6-3dcf-bc51-dcf1a4384694",
                        "glosses": [
                            "met ochtend mist bedekken en bevochtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad4d8df-d366-4f8d-a3e4-71fc9467eaeb",
                                "sense_id": "8108bd41-a5dc-36d9-ac1a-a61c2b0c15ef",
                                "text": "\"Tranen zonder tal\nen waar een dal om te bedauwen-mist.\nAlleen nog vleugels op te vouwen\n Leren vallen als een steen.\" Daar moet je het maar mee doen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "41419a3a-3d32-3222-9687-2b19eda7fa07",
                        "entry_id": "91571bca-71f6-3dcf-bc51-dcf1a4384694",
                        "glosses": [
                            "ondersteunen, vooruithelpen, begunstigen, zegenen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "754c1e0c-6c0e-4fa2-a9f3-a9a64482a15c",
                                "sense_id": "41419a3a-3d32-3222-9687-2b19eda7fa07",
                                "text": "De Heere heeft het ambtelijke werk met Zijn zegen willen bedauwen. Dat had ik niet verdiend, dat was enkel genade. En de Heere doet dat ook niet omdat een dienstknecht dat zo aangenaam vindt, maar omwille van Zijn grote Naam, Die te prijzen is tot in eeuwigheid.”"
                            }
                        ]
                    }
                ],
