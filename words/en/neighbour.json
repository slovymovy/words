{
    "word_family": [
        "neighborhood",
        "neighborly",
        "neighborliness",
        "neighboring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                    "sense_definition": "A person living on adjacent or nearby land or in a nearby house.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>neighbour</w> has two noisy cats that keep me awake at night.",
                            "target_lang_translations": {
                                "ru": "У моего <w>соседа</w> две шумные кошки, которые не дают мне спать по ночам."
                            }
                        },
                        {
                            "text": "They are our <w>neighbours</w> across the street and we often have dinner together.",
                            "target_lang_translations": {
                                "ru": "Они наши <w>соседи</w> через дорогу, и мы часто ужинаем вместе."
                            }
                        }
                    ],
                    "synonyms": [
                        "bydweller"
                    ],
                    "common_phrases": [
                        "next-door neighbour",
                        "friendly neighbour",
                        "noisy neighbour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий на соседнем или близлежащем участке земли или в доме неподалеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосед",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "соседка",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35629e4c-4004-32c0-a96c-6166b98b5b9e",
                    "sense_definition": "Anything located directly adjacent to something else of the same type.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm fills an area with colour by starting at one pixel and visiting its <w>neighbours</w>.",
                            "target_lang_translations": {
                                "ru": "Алгоритм закрашивает область цветом, начиная с одного пикселя и переходя к его <w>соседям</w>."
                            }
                        },
                        {
                            "text": "Each <w>neighbour</w> of an already occupied cluster site must be checked for data.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>соседний элемент</w> уже занятого узла кластера должен быть проверен на наличие данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nearest neighbour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой объект, расположенный непосредственно рядом с другим объектом того же типа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосед",
                                "target_lang_sense_clarification": "о неодушевленных предметах"
                            },
                            {
                                "target_lang_word": "соседний элемент",
                                "target_lang_sense_clarification": "в техническом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3288e0a3-60b0-32fd-b515-cc363eae7164",
                    "sense_definition": "A fellow human being, especially in a moral or religious context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text teaches that you shall love your <w>neighbour</w> as yourself.",
                            "target_lang_translations": {
                                "ru": "Древний текст учит, что возлюби <w>ближнего</w> своего, как самого себя."
                            }
                        },
                        {
                            "text": "We have a moral duty to help our <w>neighbour</w> in times of great distress.",
                            "target_lang_translations": {
                                "ru": "Наш моральный долг — помогать <w>ближнему</w> в трудные времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "fellow human being",
                        "fellow man"
                    ],
                    "antonyms": [
                        "stranger",
                        "foreigner"
                    ],
                    "common_phrases": [
                        "love your neighbour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ближний, другой человек, особенно в моральном или религиозном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ближний",
                                "target_lang_sense_clarification": "в библейском или этическом смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c058bea-2537-320b-829d-e1e86a7e3576",
                    "sense_definition": "One who is near in sympathy, confidence, or shared secrets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided that no more shall the man be the <w>neighbour</w> to his counsel.",
                            "target_lang_translations": {
                                "ru": "Он решил, что этот человек больше не будет <w>близок</w> к его советам."
                            }
                        },
                        {
                            "text": "In his darkest hour, he found a <w>neighbour</w> in the most unexpected person.",
                            "target_lang_translations": {
                                "ru": "В свой самый трудный час он нашел <w>близкого человека</w> в самом неожиданном лице."
                            }
                        }
                    ],
                    "synonyms": [
                        "fellow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто близок по духу, доверию или общим тайнам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близкий человек",
                                "target_lang_sense_clarification": "доверенное лицо"
                            },
                            {
                                "target_lang_word": "соратник",
                                "target_lang_sense_clarification": "единомышленник"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab327c7f-780f-3ec4-a129-f98546b7d476",
                    "sense_definition": "To be adjacent to or located next to something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adjacency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Though France <w>neighbours</w> Germany, its culture is significantly different.",
                            "target_lang_translations": {
                                "ru": "Хотя Франция <w>граничит</w> с Германией, её культура существенно отличается."
                            }
                        },
                        {
                            "text": "The hills that <w>neighbour</w> the shore are covered in lush green grass.",
                            "target_lang_translations": {
                                "ru": "Холмы, <w>прилегающие</w> к берегу, покрыты сочной зеленой травой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилегать, граничить или располагаться рядом с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соседствовать",
                                "target_lang_sense_clarification": "находиться рядом"
                            },
                            {
                                "target_lang_word": "граничить",
                                "target_lang_sense_clarification": "иметь общую границу"
                            },
                            {
                                "target_lang_word": "прилегать",
                                "target_lang_sense_clarification": "располагаться вплотную"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024b2372-ee07-3583-9459-a2f4726b4794",
                    "sense_definition": "To be similar to or to be almost the same as something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That sort of talk is <w>neighbouring</w> on treason and could be dangerous.",
                            "target_lang_translations": {
                                "ru": "Подобные разговоры <w>граничат</w> с изменой и могут быть опасны."
                            }
                        },
                        {
                            "text": "His behavior was <w>neighbouring</w> on madness after the long isolation.",
                            "target_lang_translations": {
                                "ru": "Его поведение <w>граничило</w> с безумием после долгой изоляции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neighbouring on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть похожим или почти идентичным чему-либо другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граничить",
                                "target_lang_sense_clarification": "быть близким к какому-либо состоянию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54418cd-08e3-30b5-8033-fe90dc977fa7",
                    "sense_definition": "To associate intimately with or to be close to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king declared that the stranger shall be as well <w>neighboured</w> as his own family.",
                            "target_lang_translations": {
                                "ru": "Король объявил, что к чужестранцу будут относиться так же <w>близко</w>, как к его собственной семье."
                            }
                        },
                        {
                            "text": "She sought to <w>neighbour</w> with those who shared her artistic vision.",
                            "target_lang_translations": {
                                "ru": "Она стремилась <w>сблизиться</w> с теми, кто разделял её художественное видение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесно общаться или находиться в близких отношениях с кем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сближаться",
                                "target_lang_sense_clarification": "вступать в тесную связь"
                            },
                            {
                                "target_lang_word": "соседствовать",
                                "target_lang_sense_clarification": "устар. поддерживать близость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}