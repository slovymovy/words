                                "target_senses": [
                                    {
                                        "sense_id": "0bb01560-cebf-3d03-885c-fb67a6e1aef6",
                                        "entry_id": "25e03f38-37be-3b86-a087-f805d133d9ea",
                                        "glosses": [
                                            "Sammlung historisch oder aus anderen Gründen bedeutsamer Dokumente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1fc4816-f8b5-4249-8300-5bc0290bcc74",
                                                "sense_id": "0bb01560-cebf-3d03-885c-fb67a6e1aef6",
                                                "text": "Unser Archiv ist leider für einige Zeitabschnitte sehr unvollständig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f23caeb3-9136-3f60-90c5-e2c164ae0a1d",
                                        "entry_id": "25e03f38-37be-3b86-a087-f805d133d9ea",
                                        "glosses": [
                                            "Einrichtung, Institution zur Aufbewahrung und Pflege historisch oder aus anderen Gründen bedeutsamer Dokumente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294b8ffe-889a-4663-b9fb-a923aec3c855",
                                                "sense_id": "f23caeb3-9136-3f60-90c5-e2c164ae0a1d",
                                                "text": "Viele Firmen, politische Organisationen, Hochschulen etc. betreiben ein eigenes Archiv."
                                            },
                                            {
                                                "example_id": "3db1c7a0-8d85-42f8-9762-0f6d1950f883",
                                                "sense_id": "f23caeb3-9136-3f60-90c5-e2c164ae0a1d",
                                                "text": "„Fachbibliotheken sind in der Regel Teile einer anderen Einrichtung, beispielsweise eines Forschungsinstitutes, eines privaten Unternehmens, eines Museums, Archives oder einer größeren Bibliothek.“"
                                            },
                                            {
                                                "example_id": "c4b87899-c137-4283-916c-59f082a83826",
                                                "sense_id": "f23caeb3-9136-3f60-90c5-e2c164ae0a1d",
                                                "text": "„Es galt, sich mit den Diensträumen des Archivs im Alttor vertraut zu machen, sich in unbekannte Materien einzuarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab7f0f05-b316-34b5-b853-686382fb4155",
                                        "entry_id": "25e03f38-37be-3b86-a087-f805d133d9ea",
                                        "glosses": [
                                            "Gebäude oder Gebäudeteil, der eine Institution zur Aufbewahrung von Dokumenten enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f4aba6-e0ac-46fd-bcf9-bc593f814a4a",
                                                "sense_id": "ab7f0f05-b316-34b5-b853-686382fb4155",
                                                "text": "In der Karlsstraße liegt das Archiv der Stadt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
