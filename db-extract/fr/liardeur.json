                        "sense_id": "0c3ecf26-ccae-332a-98a5-069cad7f1522",
                        "entry_id": "5559ad5d-80d4-3304-94bd-a9a4946389a6",
                        "glosses": [
                            "Personne avare, qui fait de petites dépenses, avec répugnance."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f3df7bb0-9b74-40e3-be62-c015e457f448",
                                "sense_id": "0c3ecf26-ccae-332a-98a5-069cad7f1522",
                                "text": "Est-ce que, l’autre semaine, sa sœur ne l’avait pas traité de liardeur, comme pour tourner en ridicule son jeu prudent, parce qu’il lui conseillait amicalement de vendre ?"
                            },
                            {
                                "example_id": "dc7a8d73-491d-437b-9915-eae7b711a18a",
                                "sense_id": "0c3ecf26-ccae-332a-98a5-069cad7f1522",
                                "text": "Mémé ? Une liardeuse. À tel point qu’elle en devenait riche. À force de ne rien dépenser, ça finissait par s’accumuler sous son matelas."
                            }
                        ]
                    }
