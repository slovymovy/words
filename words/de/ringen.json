                    "frequency": "Middle",
                    "semantic_group_id": "kampf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er trainiert jeden Tag und möchte morgen gegen einen starken Gegner <w>ringen</w>."
                        },
                        {
                            "text": "Die beiden Brüder fielen in den Sand und <w>rangen</w> lachend um den Ball."
                        }
                    ],
                    "synonyms": [
                        "kämpfen",
                        "balgen"
                    ],
                    "common_phrases": [
                        "miteinander ringen",
                        "auf der Matte ringen"
                    ]
                },
                {
                    "sense_id": "6d6561d6-0cbb-34da-b399-f33e09193a0f",
                    "sense_definition": "sich mit großer Mühe und Anstrengung um das Erreichen oder Bewahren von etwas bemühen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "streben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Lauf blieb der Sportler stehen und <w>rang</w> nach Luft."
                        },
