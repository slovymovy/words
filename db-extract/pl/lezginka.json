                ],
                "senses": [
                    {
                        "sense_id": "2d022d92-141d-3204-961c-30fd2b4f8239",
                        "entry_id": "ac10441e-9618-3f09-a387-597ae21340dc",
                        "glosses": [
                            "członkini ludu Lezginów"
                        ],
                        "tags": [],
