                "senses": [
                    {
                        "sense_id": "49b0e8a7-788d-3945-9467-373a75b717f4",
                        "entry_id": "37a4c6d9-d504-37c7-9534-e5d62beff136",
                        "glosses": [
                            "Fähigkeit zu hören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0b8481-57d2-4c49-81aa-04c49b608570",
                                "sense_id": "49b0e8a7-788d-3945-9467-373a75b717f4",
                                "text": "„Noch vor Tausenden Jahren war es überlebenswichtig, einen guten Gehörsinn zu haben.“"
                            },
                            {
                                "example_id": "9b9bcf18-86e1-418a-9cec-6c5c28a33d73",
                                "sense_id": "49b0e8a7-788d-3945-9467-373a75b717f4",
                                "text": "„Gehörsinn, Stimme und Sehkraft wurden im Fluge erledigt; dann aber ließ sich Bouvard lang und breit über die Frage der Fortpflanzung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
