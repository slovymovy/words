                    },
                    {
                        "translation_id": "f385b569-b2f5-45fd-8343-a7f4dd4b64ba",
                        "source_entry_id": "ac46ff83-309c-3aa3-823f-e81a6b905c87",
                        "target_lang_word": "essencialismo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essencialismo",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "a4302ee0-ff85-36a5-a07b-0aa56a3d6b6f",
                                        "entry_id": "81b6aa69-1c70-3495-8f40-cb94e003b019",
                                        "glosses": [
                                            "doutrina segundo a qual os seres ou objetos possuem uma essência fixa e imutável que define a sua identidade"
                                        ],
                                        "tags": [
                                            "filosofia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdfd8e5-ef0e-4ed4-95a0-5195f6e7017b",
                                                "sense_id": "a4302ee0-ff85-36a5-a07b-0aa56a3d6b6f",
                                                "text": "O essencialismo de Platão defendia que cada coisa tinha uma essência eterna e imutável"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9457a3ba-1b26-3ca1-b6fc-88adc475461f",
                                        "entry_id": "81b6aa69-1c70-3495-8f40-cb94e003b019",
                                        "glosses": [
                                            "corrente pedagógica que valoriza o ensino dos conteúdos fundamentais e universais, priorizando a transmissão de conhecimentos essenciais"
                                        ],
                                        "tags": [
                                            "educação"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b1c98e-86bf-4bcb-8dac-d09c150e9187",
                                                "sense_id": "9457a3ba-1b26-3ca1-b6fc-88adc475461f",
                                                "text": "O essencialismo educacional enfatiza a importância das disciplinas clássicas no currículo escolar"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026d5386-6ab1-3111-b03f-6bcda608115c",
                                        "entry_id": "81b6aa69-1c70-3495-8f40-cb94e003b019",
                                        "glosses": [
                                            "concepção segundo a qual grupos sociais (como gênero, raça, etnia) possuem características intrínsecas e invariáveis"
                                        ],
                                        "tags": [
                                            "sociologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f29e2d6-1228-439b-9918-2c4737320d56",
                                                "sense_id": "026d5386-6ab1-3111-b03f-6bcda608115c",
                                                "text": "O essencialismo de gênero sustenta que homens e mulheres têm naturezas distintas e fixas"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87e1b2f1-4794-445e-a38c-c1d72dd2f0df",
                        "source_entry_id": "ac46ff83-309c-3aa3-823f-e81a6b905c87",
