                                        "examples": [
                                            {
                                                "example_id": "aa188c4a-1090-4eeb-b3ba-141c8a8c20c8",
                                                "sense_id": "ed3cca4a-9ca0-3f6b-9b9d-8bbf104f6769",
                                                "text": "Er zog einen Pfeil aus dem Köcher."
                                            },
                                            {
                                                "example_id": "5ee9f178-8742-4f0c-b5a4-6557379341dd",
                                                "sense_id": "ed3cca4a-9ca0-3f6b-9b9d-8bbf104f6769",
                                                "text": "„Ich weiß wirklich nicht, welche Pfeile wir noch in unserem Köcher haben, die etwas taugen und tatsächlich etwas ausrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dade93b-6a9f-3d32-94db-3e87d8e7f57f",
