                                                "sense_id": "e2240e3d-0d3f-3be4-9da5-320f057b3f78",
                                                "text": "Sie hat Schmerzen in der linken Leiste."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4969a01e-4af3-33f3-8845-faf8ea55bf6b",
                                        "entry_id": "745918ed-946b-311e-b01f-5ccb18b443b8",
                                        "glosses": [
                                            "Teil der Benutzeroberfläche von Computerprogrammen"
                                        ],
                                        "tags": [],
