                    "target_lang_definitions": {
                        "ru": "Верхняя часть свиной лопатки, используемая как мясной отруб.",
                        "es": "La parte superior de la paleta de cerdo utilizada como corte de carne.",
                        "zh": "猪肩肉的上部，常用于烹饪。"
                    },
