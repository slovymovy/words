{
    "word_family": [
        "attach",
        "attached",
        "detachment",
        "reattachment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66dbc14f-39d7-3be2-ba5b-2bc105e8b1bd",
                    "sense_definition": "A computer file sent along with an email message.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please find the invoice in the email <w>attachment</w> I sent this morning.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, найдите счет во <w>вложении</w> к письму, которое я отправил сегодня утром."
                            }
                        },
                        {
                            "text": "Do not open any suspicious <w>attachment</w> from people you do not know.",
                            "target_lang_translations": {
                                "ru": "Не открывайте подозрительные <w>вложения</w> от незнакомых людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosure"
                    ],
                    "common_phrases": [
                        "email attachment",
                        "open an attachment",
                        "send an attachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерный файл, отправляемый вместе с электронным письмом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложение",
                                "target_lang_sense_clarification": "файл в электронном письме"
                            },
                            {
                                "target_lang_word": "приложение",
                                "target_lang_sense_clarification": "дополнительный документ к письму"
                            },
                            {
                                "target_lang_word": "аттачмент",
                                "target_lang_sense_clarification": "сленг, файл в письме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ac17d26-c5d9-3e5b-8d58-afc3198d9eaf",
                    "sense_definition": "A feeling of strong affection or loyalty to a person, animal, or object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child has a very strong emotional <w>attachment</w> to his favorite teddy bear.",
                            "target_lang_translations": {
                                "ru": "У ребенка очень сильная эмоциональная <w>привязанность</w> к своему любимому плюшевому мишке."
                            }
                        },
                        {
                            "text": "She felt a deep emotional <w>attachment</w> to the house where she grew up.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала глубокую эмоциональную <w>привязанность</w> к дому, в котором выросла."
                            }
                        }
                    ],
                    "synonyms": [
                        "bond",
                        "affection",
                        "fondness",
                        "devotion"
                    ],
                    "antonyms": [
                        "detachment",
                        "indifference",
                        "estrangement"
                    ],
                    "common_phrases": [
                        "emotional attachment",
                        "strong attachment",
                        "sentimental attachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильной симпатии или преданности человеку, животному или объекту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привязанность",
                                "target_lang_sense_clarification": "чувство близости"
                            },
                            {
                                "target_lang_word": "преданность",
                                "target_lang_sense_clarification": "верность кому-либо"
                            },
                            {
                                "target_lang_word": "верность",
                                "target_lang_sense_clarification": "постоянство в чувствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f65ba3a1-67dd-310c-b5d2-df9891828e4d",
                    "sense_definition": "An extra part or tool that can be joined to a machine to make it do a particular job.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vacuum cleaner comes with a special brush <w>attachment</w> for cleaning pet hair.",
                            "target_lang_translations": {
                                "ru": "Этот пылесос поставляется со специальной <w>насадкой</w>-щеткой для уборки шерсти домашних животных."
                            }
                        },
                        {
                            "text": "You can buy a mixer <w>attachment</w> to turn your food processor into a blender.",
                            "target_lang_translations": {
                                "ru": "Вы можете купить <w>насадку</w>-миксер, чтобы превратить кухонный комбайн в блендер."
                            }
                        }
                    ],
                    "synonyms": [
                        "accessory",
                        "extension",
                        "add-on"
                    ],
                    "common_phrases": [
                        "vacuum cleaner attachment",
                        "drill attachment",
                        "mixer attachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительная деталь или инструмент, который можно присоединить к машине для выполнения определенной работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насадка",
                                "target_lang_sense_clarification": "сменная деталь инструмента"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "устройство для выполнения работы"
                            },
                            {
                                "target_lang_word": "приставка",
                                "target_lang_sense_clarification": "вспомогательное устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaaaed72-5f1c-3649-9764-7e4bf94bb696",
                    "sense_definition": "The act or process of joining or fastening one thing to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secure <w>attachment</w> of the safety harness is vital before you start climbing.",
                            "target_lang_translations": {
                                "ru": "Надежное <w>крепление</w> страховочной привязи жизненно важно перед началом восхождения."
                            }
                        },
                        {
                            "text": "The <w>attachment</w> of the labels to the bottles is done by a high-speed machine.",
                            "target_lang_translations": {
                                "ru": "<w>Прикрепление</w> этикеток к бутылкам выполняется высокоскоростным станком."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastening",
                        "connection",
                        "joining"
                    ],
                    "antonyms": [
                        "detachment",
                        "separation"
                    ],
                    "common_phrases": [
                        "secure attachment",
                        "point of attachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс соединения или закрепления одной вещи на другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикрепление",
                                "target_lang_sense_clarification": "процесс фиксации"
                            },
                            {
                                "target_lang_word": "крепление",
                                "target_lang_sense_clarification": "способ или процесс соединения"
                            },
                            {
                                "target_lang_word": "присоединение",
                                "target_lang_sense_clarification": "акт добавления к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "110a5e6f-db2e-32be-bcef-b06666384ca5",
                    "sense_definition": "The legal process of seizing a person's property or wages to pay a debt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court issued an <w>attachment</w> of earnings order to ensure the debt was repaid.",
                            "target_lang_translations": {
                                "ru": "Суд вынес постановление об <w>аресте</w> доходов, чтобы гарантировать выплату долга."
                            }
                        },
                        {
                            "text": "Failure to pay the fine may result in the <w>attachment</w> of your personal assets.",
                            "target_lang_translations": {
                                "ru": "Неуплата штрафа может привести к <w>аресту</w> ваших личных активов."
                            }
                        }
                    ],
                    "synonyms": [
                        "seizure",
                        "confiscation",
                        "garnishment"
                    ],
                    "common_phrases": [
                        "attachment of earnings",
                        "writ of attachment"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический процесс изъятия имущества или заработной платы лица для выплаты долга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арест",
                                "target_lang_sense_clarification": "имущества или счетов"
                            },
                            {
                                "target_lang_word": "наложение ареста",
                                "target_lang_sense_clarification": "юридическая процедура"
                            },
                            {
                                "target_lang_word": "изъятие",
                                "target_lang_sense_clarification": "в счет долга"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}