                    },
                    {
                        "translation_id": "569fd3f0-d41b-4af8-a221-a529e2b450f9",
                        "source_entry_id": "e77ca190-42a6-3a5a-8650-4c0dbe616cee",
                        "source_sense_description": "a tall tower, often on a church",
                        "target_lang_word": "clocher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                        "entry_id": "70418bd0-b8c9-3bf4-8428-0f1901e6e1e8",
                                        "glosses": [
                                            "Bâtiment de maçonnerie ou de charpente dans lequel sont suspendues les cloches et qui est ordinairement élevé au-dessus d’une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ff8d86-f6d4-49f8-80a7-08f252dbe5b5",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Ah ! c'est Tours. Mais voyez le bel effet que produisent dans le lointain les clochers de la cathédrale."
                                            },
                                            {
                                                "example_id": "8a1b4d81-7cf7-4dfc-834c-8db50ebce1df",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "L'Angélus sonne, dans un village où notre armée n'est pas encore, car notre premier soin, dans chaque clocher, est de couper les cordes"
                                            },
                                            {
                                                "example_id": "0d7069c7-77c4-404f-b9cb-5112cd31a623",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Celles-ci, nouvelles amazones, placèrent des sentinelles sur le clocher et se barricadèrent dans le chœur de l'église."
                                            },
                                            {
                                                "example_id": "458e074f-d2cc-4c63-8c55-79459dfe31ff",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Et puis voici un populeux village, un village compact, ramassé, aux ruelles étroites et tortueuses, sans jardins, sans courtils, un village serré autour de son antique clocher."
                                            },
                                            {
                                                "example_id": "9c855864-80b9-414c-b5db-0b275088604e",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Lorsque, par moments, près du clocher de Sainte-Gudule, les croassements des corneilles s'élevaient, vous eussiez juré que c'était juste au dessus de votre tête."
                                            },
                                            {
                                                "example_id": "67854487-96fa-4754-89b0-a606358129a2",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "À la veille de Noël, tous les clochers d’église de Québec résonneront au même moment pour rendre hommage à tous les travailleurs qui ne comptent pas les heures travaillées pour lutter contre la pandémie. À ce tintamarre se joindront les sirènes des pompiers et des policiers de la capitale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4acc130-e5da-3391-9678-e6ef59efeff9",
                                        "entry_id": "70418bd0-b8c9-3bf4-8428-0f1901e6e1e8",
                                        "glosses": [
                                            "Paroisse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a3c310-ca11-42f1-b823-be0d501bde92",
                                                "sense_id": "f4acc130-e5da-3391-9678-e6ef59efeff9",
                                                "text": "Querelles de clochers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c82fdab-d2ba-315f-bd11-45ced9a75ea2",
                                        "entry_id": "93f1448e-1aaa-3b6e-be42-dea419671681",
                                        "glosses": [
                                            "Sonner à la cloche."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccd7745-cc97-4d14-bac8-8181ac546163",
                                                "sense_id": "7c82fdab-d2ba-315f-bd11-45ced9a75ea2",
                                                "text": "Minuit clochant, minuit sonnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df79961-77b7-3af9-a61b-042361c39d0f",
                                        "entry_id": "93f1448e-1aaa-3b6e-be42-dea419671681",
                                        "glosses": [
                                            "Annoncer un événement à coups de cloche."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62478552-dd2f-4362-8ada-308911025ce6",
                                                "sense_id": "0df79961-77b7-3af9-a61b-042361c39d0f",
                                                "text": "[…] comme ces grands bourdons de cent quintaux qui clochent les réjouissances de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bc0a7a0-31ec-346b-a301-0d479dcaaeae",
                                        "entry_id": "93f1448e-1aaa-3b6e-be42-dea419671681",
                                        "glosses": [
                                            "Mettre sous cloche."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c83a4c-d5d1-45f4-8574-a799c56b7418",
                                                "sense_id": "4bc0a7a0-31ec-346b-a301-0d479dcaaeae",
                                                "text": "Je cloche tout ce qui est clochable au moment du semis et de la plantation, c’est vraiment un système efficace contre les limaces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Boiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "623d9294-25e8-4d20-8059-33fb3731bcc3",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "L’un d’eux suivit assez longtemps M. Bergeret en clochant du pied, et toutefois d’un pas agile."
                                            },
                                            {
                                                "example_id": "77062e06-549b-4264-a1a4-8b17f13a39dc",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "Assez belle fille à cela près qu’elle louchait d’un œil et clochait d’un pied."
                                            },
                                            {
                                                "example_id": "a9d2f92b-c73b-44a7-a8a5-4be9613c33d1",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "L’enfant ne souffrait plus, clochait seulement un peu à gauche."
                                            },
                                            {
                                                "example_id": "3868d925-e7e7-4114-9558-bfa2d0149ad1",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "Il ne faut pas clocher devant les boiteux, il ne faut pas rappeler aux gens quelque souvenir pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3cbbb05-8366-39a4-ab39-d31d753b7ddf",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Être bancal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ee6965-c890-4d57-aa9f-58b6a3dd95c8",
                                                "sense_id": "f3cbbb05-8366-39a4-ab39-d31d753b7ddf",
                                                "text": "Ce meuble cloche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Ne pas aller bien, avoir un défaut, en parlant de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2963ae22-a4e0-492d-ac36-0807d94a04f1",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Cependant elle me paraît soucieuse depuis quelque temps, y aurait-il quelque chose qui clocherait chez elle ?"
                                            },
                                            {
                                                "example_id": "f81b9c89-5c87-4646-8256-aba060cb63a1",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Nous étions allées porter à cette dame une robe de soirée, et il fallait qu’elle s’habillât devant nous afin de voir si rien ne clochait."
                                            },
                                            {
                                                "example_id": "9399fa3b-8b98-4829-891e-236eb704949f",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Il ne pouvait croire qu’il eût raison contre des magistrats dont il n’avait pas compris les raisons ; il lui était impossible de concevoir que quelque chose clochât dans une si belle cérémonie."
                                            },
                                            {
                                                "example_id": "91d22a7a-3275-4ec4-b6aa-b5e1b99ab764",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Est-ce que rien ne clochait dans ce plan ?"
                                            },
                                            {
                                                "example_id": "38a054f8-4f1d-47f3-b047-75508a88bf7e",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "On aurait pu se douter que quelque chose clochait en voyant le tracé retenu par la Caisse et qui débordait largement le mandat initial qui était une desserte de l’aéroport et d’assurer le service sur le nouveau pont Samuel-De Champlain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d84660f6-2b69-4516-86a4-a9dfccb70033",
                        "source_entry_id": "e77ca190-42a6-3a5a-8650-4c0dbe616cee",
                        "source_sense_description": "a tall tower, often on a church",
                        "target_lang_word": "Kirchturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                        "entry_id": "81e35b3e-3bdd-3881-8a86-16779d259af5",
                                        "glosses": [
                                            "der Turm einer Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620fcf72-5d1d-4e82-81fb-9d6060f74923",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "Die beiden Kirchtürme lassen sich schon aus der Ferne erkennen."
                                            },
                                            {
                                                "example_id": "47206407-7879-4dc5-aecb-cdc71a100f61",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "Aus diesem Kirchturm werden so schnell keine Glocken mehr erschallen."
                                            },
                                            {
                                                "example_id": "f07eaea2-6a37-4248-8a04-2fc1257cfd84",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Die größte Ruhe fand sein Gemüt am Sonntagmorgen auf dem Kirchturm, dort konnte er sich weit fortträumen, ohne dass irgendjemand sich einmischte.“"
                                            },
                                            {
                                                "example_id": "e32ec675-b301-42a3-aa5e-1581ae0fe8d9",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Er erblickte nur weites Land, hier eine Rauchsäule, dort einen Kirchturm.“"
                                            },
                                            {
                                                "example_id": "92d79311-efc8-4ba0-8c30-a32ab76dba90",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Er ritt in der Richtung, die der Offizier ihm gewiesen hatte, auf einen Kirchturm zu, der sich in der Ferne vor ihm aufreckte.“"
                                            },
                                            {
                                                "example_id": "d0d851e5-b0a2-4624-939c-dff90600bb58",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Der Glöckner behauptete, man könne vom Kirchturm aus die Staubwolke erkennen, die sich zusammenballte, wo die Ebene an die ferne Hügelkette stieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
