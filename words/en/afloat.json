                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Conditions are often much tougher for personnel serving <w>afloat</w> than ashore.",
                            "target_lang_translations": {
                                "zh": "对于<w>在海上</w>服役的人员来说，条件通常比在岸上艰苦得多。"
                            }
                        },
                        {
                            "text": "He spent most of his military career serving <w>afloat</w> in foreign waters.",
                            "target_lang_translations": {
                                "zh": "他的大部分军旅生涯都是<w>在海上</w>的外国海域度过的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "at sea"
                    ],
                    "antonyms": [
                        "ashore"
                    ],
                    "target_lang_definitions": {
                        "zh": "在船上或海上服役。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "在海上",
                                "target_lang_sense_clarification": "指在海上执行任务或工作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3461e77f-2e0c-38cd-a16a-40285dfafc7d",
                    "sense_definition": "Into public knowledge, gossip, or circulation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "circulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A false report about the company's closure quickly got <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "关于公司倒闭的虚假报道很快就<w>散布</w>开了。"
                            }
                        },
                        {
                            "text": "He set a dangerous rumor <w>afloat</w> before anyone could stop him.",
                            "target_lang_translations": {
                                "zh": "在任何人阻止他之前，他<w>散布</w>了一条危险的谣言。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "set afloat",
                        "get afloat"
                    ],
                    "target_lang_definitions": {
                        "zh": "使进入公众视野或开始流传。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "指传播谣言或消息。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "e8a1d31c-7ae9-39f9-9ac0-0fd9a3b69538",
                    "sense_definition": "Floating upon or resting on the surface of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden raft drifted slowly <w>afloat</w> the calm waters of the bay.",
                            "target_lang_translations": {
                                "zh": "木筏缓慢地<w>漂浮在</w>海湾平静的水面上。"
                            }
