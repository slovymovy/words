                            {
                                "example_id": "32949a61-d6d8-40e9-93cd-c17c2e9576df",
                                "sense_id": "301c88ba-5c93-399a-8871-0cdf66c15bd9",
                                "text": "ювенильный диабет : diabète juvénile."
                            },
                            {
                                "example_id": "8875be19-50a3-47d6-993e-61b0c3254d4f",
                                "sense_id": "301c88ba-5c93-399a-8871-0cdf66c15bd9",
                                "text": "ювенильная миопатия : myopathie atrophique progressive."
                            },
