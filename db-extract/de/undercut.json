                "senses": [
                    {
                        "sense_id": "b15888b7-3432-3310-a64d-d170462306fc",
                        "entry_id": "d3cdad32-7875-3c72-b20a-e0d0747dfc5a",
                        "glosses": [
                            "Frisur, bei der nur die Haare der unteren Kopfhälfte gekürzt werden und das Deckhaar somit länger ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2d07a0e-51da-3d97-b509-3998cce9688f",
                        "entry_id": "d3cdad32-7875-3c72-b20a-e0d0747dfc5a",
                        "glosses": [
                            "Manöver, bei dem der zurückliegende Fahrer seinen Boxenstopp vor seinem vor ihm liegenden Konkurrenten macht, um ihn zu überholen"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2cdf3eb0-a09e-4cff-95d2-6e56431bca94",
                                "sense_id": "c2d07a0e-51da-3d97-b509-3998cce9688f",
                                "text": "„Weil ein früher Undercut des Briten gegen Vettel nicht funktioniert hatte, musste er seine Taktik ändern und konnte Rosberg nicht mehr attackieren.“"
                            },
                            {
                                "example_id": "fc48f504-2d2e-4744-bad9-d912c6b8090e",
                                "sense_id": "c2d07a0e-51da-3d97-b509-3998cce9688f",
                                "text": "„Ferrari reagierte nach Räikkönens Überholmanöver gegen Hamilton blitzschnell und holte ihn zum Reifenwechsel rein. So verhinderte die Scuderia einen Undercut der Mercedes-Truppe.“"
                            },
                            {
                                "example_id": "9ebc1073-1629-4b00-bfb5-124b1ea5ac94",
                                "sense_id": "c2d07a0e-51da-3d97-b509-3998cce9688f",
                                "text": "„Red Bull probierte beim zweiten Stopp einen aggressiven Undercut, der aber zum Scheitern verurteilt war.“"
                            },
                            {
                                "example_id": "0b0bd0fe-ec98-43d5-883d-2145689837f1",
                                "sense_id": "c2d07a0e-51da-3d97-b509-3998cce9688f",
                                "text": "„Bremste Hamilton absichtlich, damit Ricciardo mit einem Undercut beim zweiten Stopp an Rosberg vorbeikommt?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
