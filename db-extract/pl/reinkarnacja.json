                    {
                        "translation_id": "33cd3ca6-b740-43ff-9987-3d7926db453c",
                        "source_entry_id": "756ec7e0-3d05-31a5-84b6-678f74e5ac3f",
                        "source_sense_id": "d092d866-0022-39ba-8bfb-cca20024b0fd",
                        "target_lang_word": "réincarnation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réincarnation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                                        "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                                        "glosses": [
                                            "Action de se réincarner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a2f970-6406-4a1b-a76a-0c668b66472e",
                                                "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                                                "text": "Au Québec, depuis les années cinquante, la croyance en la réincarnation est passée d’un petit 5 % à plus de 30 %."
                                            },
                                            {
                                                "example_id": "6493761c-7a89-4cd3-9e19-74b9d8a56ef8",
                                                "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                                                "text": "Le but de la vie est de se libérer du lien karmique. L'âme doit se détacher de la matière et mourir en état de liberté pour sortir du cycle des réincarnations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                        "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5b0e12-ae09-4282-af14-d7aa02f5435b",
                                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                                "text": "Le Jebtsundamba Khutuktu est le chef spirituel de l’église bouddhiste en Mongolie. Il serait la réincarnation du lama Zanabazar, lama fondateur de la ville d’Oulan-Bator."
                                            },
                                            {
                                                "example_id": "20409376-cac1-4a62-9a60-3c7d7b55456a",
                                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                                "text": "— Alors je me borne à l’écouter, me félicitant de l’heureux hasard qui me fait rencontrer cette réincarnation d’un savant d'un autre âge."
                                            },
                                            {
                                                "example_id": "098efd55-15f7-4192-8704-41730684afbc",
                                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                                "text": "— Au Bouillon Pigalle, nouveau spot apprécié du boulevard de Clichy, la star s’appelle bourguignon aux coquillettes (notre strogonoff à nous). Le lieu est d’ailleurs une moderne réincarnation des bouillons, ces restos populaires de la Belle Époque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
