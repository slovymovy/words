                "senses": [
                    {
                        "sense_id": "ad03d8d0-845c-3b03-9bbe-d2546795901d",
                        "entry_id": "592017a0-0b81-33e6-ac3b-0199b4502f30",
                        "glosses": [
                            "Donner un caractère sous-marin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09cdeac-cf1f-4040-99dc-e8eb2b12b1f3",
                                "sense_id": "ad03d8d0-845c-3b03-9bbe-d2546795901d",
                                "text": "On a vu poindre les missile filoguidé polyvalent, les canons de mat, les \"petit drones avion\" sous-marinisé, et maintenant la torpille \"semi submersible\" radioguidée."
                            },
                            {
                                "example_id": "4861be3a-9866-4932-923e-452d7a8b7852",
                                "sense_id": "ad03d8d0-845c-3b03-9bbe-d2546795901d",
                                "text": "ps:S300pmu sont des systèmes de missile sol-air mobiles très complexes efficaces contre les avions de combat ou missiles de croisière; nécessitant des radars très puissants, techniquement impossible de les \"sous-mariniser\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ec94414-88ad-3efa-bc77-212d1ec8aa11",
                        "entry_id": "592017a0-0b81-33e6-ac3b-0199b4502f30",
                        "glosses": [
                            "Cacher (comme un sous-marin se cache sous l’eau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3432c2c8-8de9-4ec3-9be6-14b03a3e0379",
                                "sense_id": "1ec94414-88ad-3efa-bc77-212d1ec8aa11",
                                "text": "C'est une \"faune\" qui peut aussi avoir sa place sur le forum, mais pas en position sous-marinisée."
                            },
                            {
                                "example_id": "cdedcedd-8f77-4564-94d6-a63a2013f8fa",
                                "sense_id": "1ec94414-88ad-3efa-bc77-212d1ec8aa11",
                                "text": "D'ailleurs plusieurs ici ont reconnu celui-ci (genefou) sous-marinisé sous un nouveau pseudo (Alain L)."
                            }
                        ]
                    }
