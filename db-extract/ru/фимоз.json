                "senses": [
                    {
                        "sense_id": "2fbab097-8575-3215-ac66-990d11f8e636",
                        "entry_id": "2cb9f877-6fa0-3c93-b5fc-58b0865b8b3b",
                        "glosses": [
                            "мед. врождённое или приобретенное сужение крайней плоти, затрудняющее или не позволяющее обнажить головку полового члена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e36bfa-b486-4cd1-bb00-d392b4c0e006",
                                "sense_id": "2fbab097-8575-3215-ac66-990d11f8e636",
                                "text": "— Фимоз, — продолжаю, — Караим Антинохьевич, нарушает нормальную половую жизнь и даже делает порою её невозможной."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
