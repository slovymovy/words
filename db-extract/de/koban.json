                ],
                "senses": [
                    {
                        "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                        "entry_id": "6332a397-b4ed-3975-99bc-ae7f72bea512",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a52d7426-7c75-42be-b320-3bbc1d26c450",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Frau Koban ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35440f80-3b07-44d7-a2a4-ca22dc751d7f",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Herr Koban wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "494392ce-7716-49e9-b9c6-159035293bb3",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Die Kobans kommen heute aus der Niederlausitz."
                            },
                            {
                                "example_id": "fd928988-116e-421f-8b32-5a68447c49d6",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Der Koban trägt nie die Schals, die die Koban ihm strickt."
                            },
                            {
                                "example_id": "a4f0e827-e0d6-4a31-b95e-7d4e5419cbec",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Koban kommt, geht der Herr Koban.“"
                            },
                            {
                                "example_id": "f7e60052-1781-4ec2-a8bf-ad3ffc736ab0",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Koban kommt und geht."
                            },
                            {
                                "example_id": "2a3a9261-0444-4ca6-b98f-a7c1a1fa62cf",
                                "sense_id": "9b0eb0bf-91de-32e8-bb86-2743d62250ae",
                                "text": "Kobans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
