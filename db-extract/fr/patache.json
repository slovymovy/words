                    {
                        "sense_id": "85bf2a05-8c71-3961-a1a7-61e494f70a8d",
                        "entry_id": "68bfc75e-0689-3f46-9550-0767e1b3a1f6",
                        "glosses": [
                            "patache (boat)"
                        ],
