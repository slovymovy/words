                ],
                "senses": [
                    {
                        "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                        "entry_id": "aebf8bb4-36d7-37e5-a3e1-1989758e30c9",
                        "glosses": [
                            "Nassrasierer für den einmaligen Gebrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd51be2a-79a8-48fb-9758-6a61240e6429",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "Der produzierte Plastikmüll wird durch Wegwerfrasierer nicht kleiner."
                            },
                            {
                                "example_id": "43637e05-b193-4adc-abd2-193284e362bd",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "Elektrorasierer sind für empfindliche Haut besser, da sie die Haut normalerweise weniger reizen, als bei der Nassrasur mit einem Wegwerfrasierer."
                            },
                            {
                                "example_id": "11b8c3be-0e3a-465c-9a94-3a04ef170c58",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "Marie rasiert sich ihre Beine regelmäßig mit einem Wegwerfrasierer."
                            },
                            {
                                "example_id": "b1c965a6-fdab-4af7-baa6-4ad0fb86e4df",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "„George hielt einen Wegwerfrasierer in der Hand, mit dem er sich offenbar eben den Schädel rasiert hatte.“"
                            },
                            {
                                "example_id": "85cee06b-efdf-492f-b5ae-ff69fda54ce5",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "„«Wegwerfrasierer sind für eine schnelle Rasur gemacht, aber nicht für eine effiziente oder hautschonende» […].“"
                            },
                            {
                                "example_id": "9f47cba3-34ea-4331-9793-983af836e84f",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "„Einwegrasierer, auch als Wegwerfrasierer bekannt, haben vor allem einen wirtschaftlichen Vorteil gegenüber Mehrwegrasierer – sie sind günstiger.“"
                            },
                            {
                                "example_id": "3eae8ed4-258c-4004-be46-ac24651d1984",
                                "sense_id": "dd7da8a4-c3a5-3943-8745-5e3a9b866109",
                                "text": "„Beim Verkauf von wiederverwendbaren Rasur- und Klingensystemen stellte sich ein Rückgang um vier Prozent ein. Dagegen zogen die billigeren Wegwerfrasierer um 2,7 Prozent an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
