                "senses": [
                    {
                        "sense_id": "b6072def-8384-3f53-839b-65488a034275",
                        "entry_id": "0c41df67-6682-3015-9387-230a5e899859",
                        "glosses": [
                            "Clouer ou agrafer un tissu mural en en repliant les bords sur des bandes de cartons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5a4145-9c66-4d56-b413-e343d40e4cda",
                                "sense_id": "b6072def-8384-3f53-839b-65488a034275",
                                "text": "Sur un tissu extérieur de dossier ou d’accotoir, il est possible de fixer nettement et sans couture l’un des côtés passepoilés grâce à du carton à angléser."
                            },
                            {
                                "example_id": "3c125b18-454d-42bc-9929-88529eb01f88",
                                "sense_id": "b6072def-8384-3f53-839b-65488a034275",
                                "text": "Le tissu est ensuite anglésé (fixé) dans le profilé (Fig. 2)."
                            }
                        ]
                    }
