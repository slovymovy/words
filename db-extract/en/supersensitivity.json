                        "examples": [
                            {
                                "example_id": "68e305b8-9cee-47ac-81e3-a23f1c38f6db",
                                "sense_id": "13da0ec1-2c76-315a-a36c-1836be6d2d02",
                                "text": "Because D 1 dopamine receptors are known to act through stimulatory heterotrimeric guanosine triphosphate-binding (G s ) proteins and activation of the cAMP pathway, up-regulation of this pathway in the nucleus accumbens could account for the functional supersensitivity of D 1 receptors observed in these neurons--which occurs in the absence of detectable changes in the receptors themselves--after chronic cocaine (or other stimulant) exposure (18 )."
                            },
                            {
                                "example_id": "06b75be7-bcfe-4576-b559-a947957578cd",
                                "sense_id": "13da0ec1-2c76-315a-a36c-1836be6d2d02",
                                "text": "In the next generation seeds were screened for ABA supersensitivity (era1/era1)."
                            },
                            {
                                "example_id": "c799c155-e0c2-4523-a587-9dd9eb98a502",
                                "sense_id": "13da0ec1-2c76-315a-a36c-1836be6d2d02",
                                "text": "The effects of inactivity on new receptor synthesis and denervation supersensitivity are mediated by Ca 2 influx (24 )."
