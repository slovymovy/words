                        "source_entry_id": "1414b60b-bb6b-3fea-bd41-72e77b032ba7",
                        "source_sense_id": "27fd3275-558f-37e8-86b5-7b70c1d9666c",
                        "target_lang_word": "ignominiously",
                        "target_lang_code": "en",
