        "fr-extract.jsonl": [
            {
                "entry_id": "716daaad-215b-33f6-bf15-02ee2f8ac1ab",
                "word": "Berthe",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                        "entry_id": "716daaad-215b-33f6-bf15-02ee2f8ac1ab",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a97e73-50b0-4c24-8c60-7c1619cc63a1",
                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                "text": "Au-dessus de chez la pauvre vieille grand’mère qui chantait la Marseillaise, au second étage, dans la partie de notre maison qui donnait sur des cours et des jardins, habitait ma grand’tante Berthe."
                            },
                            {
                                "example_id": "ee04bf02-8eac-4d56-85aa-50bc50eab446",
                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                "text": "Ce n’est pas que mademoiselle Berthe de Manicamp soit plus mal qu’une autre… Au contraire, elle est jolie, spirituelle, riche… oui, mais elle a un défaut, elle est petite… oh ! mais petite !… tandis que ma cousine Aloïse !… une cousine de cinq pieds quatre pouces !…"
                            },
                            {
                                "example_id": "b7c220cc-5c88-451f-9f0b-c7ad193e8ad7",
                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                "text": "Pour comble de malheur, le hasard voulut que Suzanne et Berthe, qui se promenaient ensemble, rencontrassent l’abbé Madeline, juste devant la porte ; et ils s’étaient arrêtés tous les trois, ils attendaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b78c0fe-2a01-4a10-b36b-b3d47c0a4602",
                        "source_entry_id": "716daaad-215b-33f6-bf15-02ee2f8ac1ab",
                        "source_sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                        "target_lang_word": "Bertha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4f2a7baf-2349-4d08-b199-9eb3d61c5744",
                        "source_entry_id": "716daaad-215b-33f6-bf15-02ee2f8ac1ab",
                        "source_sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                        "target_lang_word": "Bertha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bertha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                        "entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28d9f9c-6ec2-4628-a727-a9856d584797",
                                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                                "text": "You are the beautiful Bertha, the spinner, the queen of Helvetia; / She whose story I read at a stall in the streets of Southampton"
                                            },
                                            {
                                                "example_id": "5ce6af66-73f7-460b-8968-01e555701252",
                                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                                "text": "Why couldn't they have called her by her first name, Bertha, which was beautiful and dignified, instead of that silly \"Rilla\"?"
                                            },
                                            {
                                                "example_id": "406ec2b5-c8ba-4968-b076-827312f8d079",
                                                "sense_id": "1fa4d411-acce-3e2b-97fc-16ef2d7ce80d",
                                                "text": "\"No wonder she never gets anywhere with a name like Bertha,\" Sally said, while having coffee afterwards with two of the other night-coursers. \"It goes with her outfits, though.\" ( Bertha sports the macrame look, with health-food sandals and hand-weave skirts that don't do a thing for her square figure, [...])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21da75e2-bec6-3847-80e8-a4d03e647c71",
                                        "entry_id": "480ffa6d-0df7-3168-9db4-9ff2cd1ea6ea",
                                        "glosses": [
                                            "Alternative form of Perchta (“goddess in Alpine paganism”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
