                "senses": [
                    {
                        "sense_id": "fd65240c-4842-3901-8850-0f6fc308b17d",
                        "entry_id": "759e64dc-a1b2-30cf-8a9b-34f8d1397c15",
                        "glosses": [
                            "Zahnarzt"
                        ],
                        "tags": [
                            "derogatory",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f9ef98-d756-4903-9db0-1c33d3ac7ec7",
                                "sense_id": "fd65240c-4842-3901-8850-0f6fc308b17d",
                                "text": "„Zum Zahnklempner müssen war schlimmer als zum Glatzenschneider müssen, weil man nie wußte, was auf einen zukam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15a42947-0bf7-48e7-aea0-e3b6943baf19",
                        "source_entry_id": "759e64dc-a1b2-30cf-8a9b-34f8d1397c15",
                        "source_sense_id": "fd65240c-4842-3901-8850-0f6fc308b17d",
                        "source_sense_description": "scherzhaft, auch abwertend: Zahnarzt",
                        "target_lang_word": "dentiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                        "entry_id": "730b2b99-6a98-3395-85f1-6c7b6df497c2",
                                        "glosses": [
                                            "Spécialiste du soin des dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a310e3-a096-4457-87f2-70be644e98d0",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "D’un air héroïque, presque farouche, comme s’il se trouvait devant un dentiste, qui propose de lui arracher une molaire, M. Hyacinthe s’écrie :\n— Finissons-en tout de suite…"
                                            },
                                            {
                                                "example_id": "9eba5786-c2c2-41bc-be0f-685db25b542c",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "Lorsqu’il passe devant le bâtiment quelques minutes plus tard, il lit les plaques qui encadrent la porte vitrée. Il y en a cinq : deux dentistes, un kiné, un médecin, un orthophoniste — il n’a jamais entendu parler de ce métier."
                                            },
                                            {
                                                "example_id": "d01bc05d-409d-457c-8df2-bc01e725b0f1",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "Le dentiste peut profiter du temps de l’examen et du diagnostic pour renseigner son patient et s’entretenir avec lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
