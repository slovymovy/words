                "senses": [
                    {
                        "sense_id": "676e54bc-e6d2-386b-92f4-9a8b24cf93eb",
                        "entry_id": "a4e9f784-56df-3eec-be4b-a79a1f4194f2",
                        "glosses": [
                            "Tuch aus Baumwolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be37eac9-7305-4b77-8bd2-633e6a6d965b",
                                "sense_id": "676e54bc-e6d2-386b-92f4-9a8b24cf93eb",
                                "text": "Unsere Großmütter kannten als Windeln nur quadratische, weiche Baumwolltücher."
                            },
                            {
                                "example_id": "51fc7a1f-68d7-4787-a95e-8d64a5f86de1",
                                "sense_id": "676e54bc-e6d2-386b-92f4-9a8b24cf93eb",
                                "text": "„Aehnlich verhält es sich mit dem Pistolenschuss (Fig. 203 und 204). Bei 1– 4 cm Distanz hat der erkennbare Schmauch auf der Haut etwa die Hälfte des Durchmessers, den wir in der entsprechenden Distanz auf dem Baumwolltuche fanden.“"
                            },
                            {
                                "example_id": "c90d572d-a010-4caf-8400-f548e8f45233",
                                "sense_id": "676e54bc-e6d2-386b-92f4-9a8b24cf93eb",
                                "text": "„Sie waren nun auf den Import weißer Baumwolltuche aus Indien angewiesen, die als Halbfertigfabrikate in ihre Produktion eingingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
