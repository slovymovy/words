                                        "glosses": [
                                            "auf Adolf Hitler beziehungsweise sein Regime bezogen, die Gesinnung Hitlers betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d64d1f-fb49-4b3c-9060-01fe21374c90",
                                                "sense_id": "adff9ee7-5ea4-3d63-afbb-814e1c7d6670",
                                                "text": "„Seine Gesinnung und Haltung gegenüber der politischen Entwicklung seit 1918 war hitlerisch.“"
                                            },
                                            {
                                                "example_id": "289e1736-5f7f-4872-b841-398e90bf2b51",
                                                "sense_id": "adff9ee7-5ea4-3d63-afbb-814e1c7d6670",
                                                "text": "„Er ist durchaus nicht hitlerisch gesinnt und sieht ein, dass Deutschland und der »Simpl.« kaputt gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
