                "senses": [
                    {
                        "sense_id": "37236621-4027-380c-971b-30b20f0af71f",
                        "entry_id": "82934584-26a9-3452-b5bd-ad8140b2a938",
                        "glosses": [
                            "Variante orthographique de T-shirt."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c9de5af5-304b-49d8-9a6f-447434186aa5",
                                "sense_id": "37236621-4027-380c-971b-30b20f0af71f",
                                "text": "En tête du cortège, qui a parcouru les rues de Saint-Céré, un bourg du Lot situé non loin du village de Tauriac, où vivait la famille Vayrac, ses amies de l’école d’aides-soignantes de Brive arboraient un tee-shirt demandant « Justice pour Justine »."
                            },
                            {
                                "example_id": "2e0effe5-1c9f-4bed-8cca-c9dfa6fbfbf6",
                                "sense_id": "37236621-4027-380c-971b-30b20f0af71f",
                                "text": "En général, le jeune coq habite une achélème, circule en moto (en 4x4 dans Urgence), porte tee-shirt, santiags et perfecto."
                            },
                            {
                                "example_id": "0e23e4b2-f0a1-47c0-a42c-d602b835c7c5",
                                "sense_id": "37236621-4027-380c-971b-30b20f0af71f",
                                "text": "Sur les 80 m² de surface, les Phryges, les mascottes officielles de l’événement (lire aussi page 7), côtoient mugs, tee-shirts et autres produits dérivés qui raviront petits et grands."
                            }
                        ]
                    }
