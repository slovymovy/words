                        "glosses": [
                            "Partisan jusqu’au-boutiste d’un nationalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49492d45-d5d1-4cb7-8859-4e88206171c8",
                                "sense_id": "2254a750-1ad1-3b97-9c56-29406cdc5468",
                                "text": "Ce type, c’est un nocif, un ancien tortionnaire et plus que ça sans doute. Un ultranational."
                            },
                            {
                                "example_id": "a73574a5-a3c7-4a57-950d-d671a4a7d752",
                                "sense_id": "2254a750-1ad1-3b97-9c56-29406cdc5468",
                                "text": "À droite, les ultranationaux ou les monarchistes, les pré—maurrassiens, les barressiens de la première heure, les héritiers de Bonald, Renan et Proudhon, les supporters de Déroulède, les militants de la Patrie française, et les boulangistes des rues de Paris, tous croient en l’inégalité des races."
                            },
                            {
                                "example_id": "e7ca5fd2-2422-4ee4-b0e4-15b6e44fb2dc",
                                "sense_id": "2254a750-1ad1-3b97-9c56-29406cdc5468",
                                "text": "Journaliste, fille d’un ultranational…"
                            }
                        ]
