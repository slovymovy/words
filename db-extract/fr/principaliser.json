                "senses": [
                    {
                        "sense_id": "4c910862-ed92-33a7-8732-f18ff5aa53c6",
                        "entry_id": "c4256997-f3cd-3b11-8114-10a21240cbcf",
                        "glosses": [
                            "Rendre principal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d808e8-6a77-4e86-92ae-c9f7a7f4e863",
                                "sense_id": "4c910862-ed92-33a7-8732-f18ff5aa53c6",
                                "text": "Le mouvement, le déplacement, la position modifiable, la dissymétrie gauche/droite, avant/arrière, haut/bas constituent des propriétés d’espace du corps humain que l’on peut soit principaliser, soit secondariser."
                            },
                            {
                                "example_id": "f33236ad-4068-4181-97b8-a65e39c8cf72",
                                "sense_id": "4c910862-ed92-33a7-8732-f18ff5aa53c6",
                                "text": "Nous avons gardé les jeux harmoniques d’origine ; la montre a été principalisée ; le hautbois moins bassonnant."
                            }
                        ]
                    }
