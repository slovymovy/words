{
    "word_family": [
        "credulity",
        "credulously",
        "credulousness",
        "incredulous",
        "incredulity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3af6086-5cfe-3f07-aa1b-8e21c58ec1b3",
                    "sense_definition": "Excessively ready to believe things, often without proper evidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gullibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman targeted <w>credulous</w> customers who were likely to believe his exaggerated claims about the product.",
                            "target_lang_translations": {
                                "ru": "Продавец ориентировался на <w>легковерных</w> покупателей, которые, скорее всего, поверили бы его преувеличенным заявлениям о товаре."
                            }
                        },
                        {
                            "text": "She had <w>credulous</w> eyes that seemed to accept every word of the ghost story as absolute truth.",
                            "target_lang_translations": {
                                "ru": "У неё были <w>доверчивые</w> глаза, которые, казалось, принимали каждое слово истории о привидениях за чистую правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "gullible",
                        "naive",
                        "unworldly",
                        "wide-eyed",
                        "born yesterday"
                    ],
                    "antonyms": [
                        "skeptical",
                        "incredulous",
                        "suspicious",
                        "cynical"
                    ],
                    "common_phrases": [
                        "credulous eyes",
                        "credulous nature",
                        "credulous public"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно готовый верить всему на слово, часто без надлежащих доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легковерный",
                                "target_lang_sense_clarification": "склонный слишком быстро верить на слово"
                            },
                            {
                                "target_lang_word": "доверчивый",
                                "target_lang_sense_clarification": "излишне открытый и верящий людям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b232cae0-f569-30ed-aaa9-7976b37dff89",
                    "sense_definition": "Accepted or believed too easily without critical investigation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gullibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper was criticized for publishing <w>credulous</w> stories about the miracle cure without any scientific backing.",
                            "target_lang_translations": {
                                "ru": "Газету критиковали за публикацию <w>легковерных</w> историй о чудодейственном лекарстве без какого-либо научного обоснования."
                            }
                        },
                        {
                            "text": "The report was full of <w>credulous</w> claims that had clearly not been verified by the investigators.",
                            "target_lang_translations": {
                                "ru": "Отчет был полон <w>некритичных</w> утверждений, которые явно не были проверены следователями."
                            }
                        }
                    ],
                    "synonyms": [
                        "unworldly",
                        "naive"
                    ],
                    "antonyms": [
                        "verified",
                        "scrutinized"
                    ],
                    "common_phrases": [
                        "credulous stories",
                        "credulous reports",
                        "credulous claims"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принятый на веру или признанный истинным слишком легко, без критического исследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легковерный",
                                "target_lang_sense_clarification": "основанный на слепой вере, а не на фактах"
                            },
                            {
                                "target_lang_word": "некритичный",
                                "target_lang_sense_clarification": "принимаемый без проверки и анализа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}