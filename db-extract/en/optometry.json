                                        "glosses": [
                                            "Lehre der Messungen und Bewertungen von Sehfunktionen sowie der Korrektur von Fehlsichtigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6862729c-bb52-46fc-9599-4f5fa6f90f33",
                                                "sense_id": "a7a3d1ec-687d-3774-aa34-795e793a8756",
                                                "text": "„Optometrie ist eine Teildisziplin der Augenoptik, die Fehlsichtigkeiten korrigiert.“"
                                            },
                                            {
                                                "example_id": "b8d84892-8106-40a4-af9f-454b381ec3a3",
                                                "sense_id": "a7a3d1ec-687d-3774-aa34-795e793a8756",
                                                "text": "„Er interessierte sich wenig für die Wissenschaft der Optometrie, obwohl die Wissensaneignung auf diesem Gebiet ja der Grund seines Aufenthaltes hier war.“"
                                            },
                                            {
                                                "example_id": "95975ff9-6cba-4b21-94e9-abb380a68e7f",
                                                "sense_id": "a7a3d1ec-687d-3774-aa34-795e793a8756",
                                                "text": "„Mir fiel damals ein kleiner Zeitschriftenartikel auf, in dem von einem Institut für Optometrie in den USA berichtet wurde und von der Möglichkeit der Anerkennung optometrischer Dienste als Versicherungsleistung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
