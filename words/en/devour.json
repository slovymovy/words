                {
                    "sense_id": "cf663b21-a3c4-3f99-9e6f-cd21700bb530",
                    "sense_definition": "To eat quickly, greedily, hungrily, or ravenously.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog <w>devoured</w> the food in seconds.",
                            "target_lang_translations": {
                                "de": "Der hungrige Hund <w>verschlang</w> das Futter in Sekunden.",
                                "cs": "Hladový pes <w>zhltl</w> jídlo během několika sekund.",
                                "tr": "Aç köpek mamayı saniyeler içinde <w>silip süpürdü</w>."
                            }
                        },
                        {
                            "text": "He <w>devoured</w> his meal after a long day of hiking.",
                            "target_lang_translations": {
                                "de": "Er <w>verschlang</w> seine Mahlzeit nach einem langen Wandertag.",
                                "cs": "Po dlouhém dni túry svou porci <w>zhltl</w>.",
                                "tr": "Uzun bir doğa yürüyüşü gününün ardından yemeğini <w>oburca yedi</w>."
                            }
