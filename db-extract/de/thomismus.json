                "senses": [
                    {
                        "sense_id": "9ee173ee-5b83-3f0f-b1b7-d9bd1d4cf8f2",
                        "entry_id": "f8d553c4-6dea-3de9-9169-84b20e8860d3",
                        "glosses": [
                            "die philosophisch-theologische Lehre von Thomas von Aquin oder eine Lehre, die an dessen Lehrgebäude anschloss"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "221170c0-c225-4119-9f5e-4b8223ecc246",
                                "sense_id": "9ee173ee-5b83-3f0f-b1b7-d9bd1d4cf8f2",
                                "text": "Im Gegensatz zum Molinismus lehrt der Thomismus im engeren Sinne, dass der freie Wille durch ein dem Handeln vorausgehendes Bewegtwerden von Seiten Gottes zu seiner Tat bestimmt ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
