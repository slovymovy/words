                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142e4554-0cfa-4b42-bf94-829a3cda6675",
                                "sense_id": "7f6d2507-d1a5-363b-b226-de34df6e7ee5",
                                "text": "Zdaniem Trybunału Konstytucyjnego konstytucyjna ochrona prywatności stanowi jeden z podstawowych elementów aksjologii demokratycznego państwa prawnego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6c31fca-dd3e-4661-8e6b-7c447234cfae",
                        "source_entry_id": "d8444f9a-2edd-3ccc-be42-4e3181771f95",
                        "source_sense_id": "e8e4b071-db0a-38a5-a2de-118433bbd0f6",
                        "target_lang_word": "axiology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axiology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdfa945-6edc-3057-b83f-ea9ab714f735",
                                        "entry_id": "0df8c8b4-4e21-3446-849b-2cb4aa83525d",
                                        "glosses": [
                                            "The study of value(s), as regards origin, nature, functions, types, and interrelations; value theory."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47961371-a81d-343d-a859-09d9e69761e2",
                                        "entry_id": "0df8c8b4-4e21-3446-849b-2cb4aa83525d",
                                        "glosses": [
                                            "The particular value-theory of a philosopher, school of thought, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30456380-e43f-4887-a3b2-4a5092bd17f0",
                                                "sense_id": "47961371-a81d-343d-a859-09d9e69761e2",
                                                "text": "In his axiology, G. E. Moore maintains that \"good\" is the name of a simple, indefinable quality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b00d1ff-3c6b-440d-a81a-2bae515c5d35",
                        "source_entry_id": "d8444f9a-2edd-3ccc-be42-4e3181771f95",
                        "source_sense_id": "e8e4b071-db0a-38a5-a2de-118433bbd0f6",
                        "target_lang_word": "axiologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axiologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dac00fa-e495-3f69-902a-c49a5dc98e22",
                                        "entry_id": "958a15b7-c49f-356b-92d2-5adf6787bacd",
                                        "glosses": [
                                            "Branche de la philosophie qui étudie la nature, les fondements et la hiérarchie des valeurs (morales, esthétiques, politiques, spirituelles, etc.)."
                                        ],
                                        "tags": [
                                            "Philosophie morale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb70cd35-4a4f-42e8-a33a-825519f50b9f",
                                                "sense_id": "5dac00fa-e495-3f69-902a-c49a5dc98e22",
                                                "text": "C’est surtout dans l’Allemagne de la fin du XIXᵉ siècle que sont apparus des philosophes se revendiquant de l’axiologie, tels que Heinrich Rickert ou Wilhelm Windelband."
                                            },
                                            {
                                                "example_id": "a36d0117-1aeb-418a-96b3-bbddb04dd683",
                                                "sense_id": "5dac00fa-e495-3f69-902a-c49a5dc98e22",
                                                "text": "Il y a là un rapport d’implication et d’intersection, qui diffère du rapport d’emboîtement que comporterait l’assimilation de l’axiologie à la philosophie, en vertu de la généralité de celle-ci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c471add-cc7e-4a11-ae58-cf578ab18486",
                        "source_entry_id": "d8444f9a-2edd-3ccc-be42-4e3181771f95",
                        "source_sense_id": "e8e4b071-db0a-38a5-a2de-118433bbd0f6",
                        "target_lang_word": "axiología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axiología",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b9aac75e-cd52-3602-b013-e467b1e149ee",
                                        "entry_id": "a3fc36ae-f392-3377-924a-8ec64864d097",
                                        "glosses": [
                                            "Rama de la Filosofía que estudia la naturaleza de los valores y juicios valorativos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f14ae5-f2e0-498b-8bb9-df6204295610",
                                                "sense_id": "b9aac75e-cd52-3602-b013-e467b1e149ee",
                                                "text": "los grandes metafísicos han igualado la axiología y la ontología."
                                            },
                                            {
                                                "example_id": "5a42c33a-8b2f-4431-a858-67454fcfedc9",
                                                "sense_id": "b9aac75e-cd52-3602-b013-e467b1e149ee",
                                                "text": "La Axiología jurídica trata el problema de los valores jurídicos."
                                            },
                                            {
                                                "example_id": "3a7d3f3f-c80f-4e25-aac4-d81b5102ab63",
                                                "sense_id": "b9aac75e-cd52-3602-b013-e467b1e149ee",
                                                "text": "Existía toda una axiología gaucha caracterizada por los siguientes valores: valentía, lealtad, hospitalidad —de allí que en Argentina y Uruguay la frase \"hacer una gauchada\", totalmente opuesta a \"hacer una guachada\"— significa tener un gesto de hidalguía o una buena actitud."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d1b533-7d07-4d96-bc01-a4f928ae9e24",
                        "source_entry_id": "d8444f9a-2edd-3ccc-be42-4e3181771f95",
                        "source_sense_id": "e8e4b071-db0a-38a5-a2de-118433bbd0f6",
                        "target_lang_word": "аксиология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аксиология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a35b2adf-3268-37b3-a7fd-0346851e5b97",
                                        "entry_id": "0f773749-dfea-3e02-9785-171ecab706ba",
                                        "glosses": [
                                            "филос. философская дисциплина, исследующая категорию «ценность», характеристики, структуры и иерархии ценностного мира, способы его познания и его онтологический статус, а также природу и специфику ценностных суждений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d1e8a0-89fe-4700-b159-167a7ec7fc7f",
                                                "sense_id": "a35b2adf-3268-37b3-a7fd-0346851e5b97",
                                                "text": "Аксиология ― это учение о ценностях (от др. ― гр. ахios ― ценный). Термин «ценность» упрочился в гуманитарных науках благодаря трактату Ф. Г. Лотце (1870). В отечественной философии аксиология ярко представлена работой Н. О. Лосского «Ценность и бытие» (1931)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
