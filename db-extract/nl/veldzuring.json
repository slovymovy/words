                    {
                        "translation_id": "8aa2c980-3342-4595-a45f-1a4467873c1d",
                        "source_entry_id": "7e5c8e0f-6b3f-312e-9c36-e77e46e906ad",
                        "source_sense_id": "05fc1d39-bcb8-3df2-b283-33a10d34266b",
                        "source_sense_description": "en 2. (bladeren van) de plant Rumex acetosa",
                        "target_lang_word": "Sauerampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauerampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                        "entry_id": "216fd0c5-4b4c-3a5b-8703-812efb65a64e",
                                        "glosses": [
                                            "meist auf Wiesen wachsende Pflanze mit kleinen, roten Blüten, deren Blätter einen sauren Geschmack haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b759c24-e737-4ee1-8874-ae46c13b5790",
                                                "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                                "text": "Er pflückte Sauerampfer und aß ihn."
                                            },
                                            {
                                                "example_id": "d02a12b3-ec61-47f4-a194-86125679f753",
                                                "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                                "text": "„Ich ging vielmehr um die Ecke des Hauses, um Sauerampfer zu kauen, der im Kohlgartenzaun wuchs.“"
                                            },
                                            {
                                                "example_id": "c2a3a1e7-a647-4838-8283-7b2b72a6fe86",
                                                "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                                "text": "In der Volksmedizin wird der Sauerampfer bei der Frühjahrskur zur »Entschlackung« und zur Stärkung der Abwehrkräfte eingesetzt."
                                            },
                                            {
                                                "example_id": "9bc866a8-525d-4335-be9b-87a5a6d15369",
                                                "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                                "text": "„Erde lag nur auf den pelzigen Hausdächern, dort wuchsen Gras und Sauerampfer und an einigen Stellen auch Wiesenschaumkraut, und an Nebeltagen war alles eingehüllt in diesen ärmlichen Petroleumgeruch.“"
                                            },
                                            {
                                                "example_id": "3c7a798a-1419-4b45-b0a7-96db3182c339",
                                                "sense_id": "3b2d8dd5-ef33-3ae9-a8ff-14d2a0dff92e",
                                                "text": "„Darin wurde vor allem Sauerampfer angebaut, der früher als Salat, Gemüse und Heilpflanze von großer Bedeutung war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17b29074-e9ea-3c86-99ca-f14c5ada1373",
                                        "entry_id": "216fd0c5-4b4c-3a5b-8703-812efb65a64e",
                                        "glosses": [
                                            "besonders saurer (minderwertiger) Wein oder Most"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial",
                                            "derogatory",
                                            "figurative",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1038444c-1533-43f4-bca2-6c2947994e61",
                                                "sense_id": "17b29074-e9ea-3c86-99ca-f14c5ada1373",
                                                "text": "„Vom Wein versteh ich zwar net viel, aber ob es ein Sauerampfer oder ein guter Tropfen ist, das werd ich wohl merken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
