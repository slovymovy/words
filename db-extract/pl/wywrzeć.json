                        "glosses": [
                            "произвести, обернуться, вызвать, подействовать, оказать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daa3828-0d2f-4c16-ae31-ac6aaa5706ea",
                                "sense_id": "1f5be92a-bac7-3005-940c-383e380b923f",
                                "text": "Widok króla i tu wywarł ten sam co na tłumach skutek; spostrzegłszy go pierzchało wszystko, co żyło, rzucały się na ziemię niewiasty, krzyki boleści podwoiły.",
                                "translation": "И здесь появление короля произвело то же впечатление, как на народ, все разбежалось и рассыпалось; женщины бросались на землю, удвоился крик и стоны."
                            },
                            {
                                "example_id": "5f28fe57-525b-4b80-b287-1c841eb26880",
                                "sense_id": "1f5be92a-bac7-3005-940c-383e380b923f",
                                "text": "Okrzyk wywarł skutek, choć nie całkiem zamierzony.",
                                "translation": "Восклицание подействовало, хоть и не совсем так, как он ожидал."
                            }
                        ]
                    }
