                                    },
                                    {
                                        "sense_id": "1f55997c-9d22-37c4-badf-3bb629b537b9",
                                        "entry_id": "ab6cb0d9-2a67-3234-8998-0cdb95ebe464",
                                        "glosses": [
                                            "Derecho a recibir una pensión o renta después de que el beneficiario original ha fallecido."
                                        ],
