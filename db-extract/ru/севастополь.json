                                                "example_id": "709c1c71-6845-4b35-8dc6-b3bd27d0df69",
                                                "sense_id": "b7d0152f-3fc9-3628-aea5-d600b98b06fb",
                                                "text": "Jamais ils ne revirent le corps d’Antoine, probablement enfoui à la hâte dans une fosse sordide, du côté de Sébastopol."
                                            }
