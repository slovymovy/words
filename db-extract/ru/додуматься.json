                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774ee3ee-652d-447c-8b36-83db42d29187",
                                "sense_id": "907f0346-5af9-3368-9946-0ef809439502",
                                "text": "наконе́ц кто́-то доду́мался пое́хать по друго́й доро́ге",
                                "translation": "at last someone hit upon taking another road",
                                "english": "at last someone hit upon taking another road"
