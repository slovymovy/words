                    "sense_id": "d48b5962-6bd8-3c3d-b05c-89bce918e619",
                    "sense_definition": "A person who lives near or next to another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>neighbor</w> helped me carry the groceries inside.",
                            "target_lang_translations": {
                                "ru": "Мой <w>сосед</w> помог мне занести продукты в дом.",
                                "zh": "我的<w>邻居</w>帮我把杂货搬进了屋里。",
                                "nl": "Mijn <w>buurman</w> hielp me de boodschappen naar binnen te dragen.",
                                "pl": "Mój <w>sąsiad</w> pomógł mi wnieść zakupy do środka.",
                                "de": "Mein <w>Nachbar</w> hat mir geholfen, die Einkäufe hineinzutragen.",
                                "fr": "Mon <w>voisin</w> m'a aidé à porter les courses à l'intérieur.",
                                "it": "Il mio <w>vicino</w> mi ha aiutato a portare dentro la spesa.",
                                "cs": "Můj <w>soused</w> mi pomohl odnést nákup dovnitř.",
                                "tr": "<w>Komşum</w> market alışverişini içeri taşımama yardım etti.",
                                "es": "Mi <w>vecino</w> me ayudó a meter la compra en casa."
                            }
                        },
                        {
                            "text": "We have a very quiet <w>neighbor</w> living next door.",
                            "target_lang_translations": {
                                "ru": "У нас очень тихий <w>сосед</w>, живущий по соседству.",
                                "zh": "我们隔壁住着一位非常安静的<w>邻居</w>。",
                                "nl": "We hebben een erg rustige <w>buur</w> die naast ons woont.",
                                "pl": "Mamy bardzo cichego <w>sąsiada</w> mieszkającego za ścianą.",
                                "de": "Wir haben einen sehr ruhigen <w>Nachbarn</w>, der nebenan wohnt.",
                                "fr": "Nous avons un <w>voisin</w> très calme qui habite à côté.",
                                "it": "Abbiamo un <w>vicino</w> molto tranquillo che abita accanto.",
                                "cs": "Máme velmi tichého <w>souseda</w>, který bydlí vedle.",
                                "tr": "Yan tarafta oturan çok sessiz bir <w>komşumuz</w> var.",
                                "es": "Tenemos un <w>vecino</w> muy tranquilo que vive al lado."
                            }
                        }
                    ],
                    "common_phrases": [
                        "next-door neighbor",
                        "good neighbor",
                        "close neighbor"
