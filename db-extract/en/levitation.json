                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcc6f01d-a322-36a8-94d7-345bf358854a",
                        "entry_id": "8bc41575-f987-3f9f-ac63-77984440c686",
                        "glosses": [
                            "The raising of something, such as a body, without apparent physical cause, allegedly using the power of the mind"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b08c0a8e-1e6d-3a50-b385-aef5b7bdd333",
                        "entry_id": "8bc41575-f987-3f9f-ac63-77984440c686",
                        "glosses": [
                            "The suspension of something via technical means without any mechanical support, such as by magnetism"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f069120-2250-4799-a6c0-b59b72c278fc",
                                "sense_id": "b08c0a8e-1e6d-3a50-b385-aef5b7bdd333",
                                "text": "It was erected by the application of those universal laws and forces of nature which cause iron to float. By the same laws, gravity may be overcome or neutralized, and stone made to float in air. The Pyramid was thus built by levitation, abetted by song and chanting, much in the same manner in which the Druids of England set up their huge stones at a later period."
                            }
                        ]
                    }
                ],
