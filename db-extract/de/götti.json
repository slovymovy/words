                        "target_lang_word": "godfather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godfather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6848c7-2d71-3abc-b10d-a40c90ac1a9c",
                                        "entry_id": "87cd8dad-81ee-31ed-84a8-e0dd56673bf9",
                                        "glosses": [
                                            "A man present at the christening of a baby who promises to help raise the child in a Christian manner; a male godparent who sponsors the baptism of a child."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c9285e9-8f7e-3cc4-8c29-6325db74fdf2",
                                        "entry_id": "87cd8dad-81ee-31ed-84a8-e0dd56673bf9",
                                        "glosses": [
                                            "Someone who plays a key role in fostering the development of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7ffa4d-db01-4678-9247-4403ad0369a7",
                                                "sense_id": "5c9285e9-8f7e-3cc4-8c29-6325db74fdf2",
                                                "text": "The man often touted as the godfather of AI has quit Google, citing concerns over the flood of misinformation, the possibility for AI to upend the job market, and the “existential risk” posed by the creation of a true digital intelligence."
                                            },
                                            {
                                                "example_id": "f384cb58-6d9c-4042-b5f2-04dcc7fa462d",
                                                "sense_id": "5c9285e9-8f7e-3cc4-8c29-6325db74fdf2",
                                                "text": "“They are trying to kill the messenger with the bad news, it’s crazy,” said Dr James Hansen, known as the godfather of climate science and previously director of Giss for more than 30 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e93f5385-9701-3eca-b282-8a309fe77e7c",
                                        "entry_id": "87cd8dad-81ee-31ed-84a8-e0dd56673bf9",
                                        "glosses": [
                                            "A mafia leader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d343ec7-fc20-36df-82ad-0474fea3be07",
                                        "entry_id": "87cd8dad-81ee-31ed-84a8-e0dd56673bf9",
                                        "glosses": [
                                            "A small post which is used in repairing a fence. For instance attached to and supporting an existing broken fence post."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "godfather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbb478c-fa4f-32e0-9d33-ee325600b627",
                                        "entry_id": "a901ce29-b21d-3b39-b30f-a07f440bbe81",
                                        "glosses": [
                                            "To act as godfather or guardian to."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f255ed-69c8-4f29-864d-012095a8960f",
                                                "sense_id": "2fbb478c-fa4f-32e0-9d33-ee325600b627",
                                                "text": "Hull objected violently that aid had not been used to extract commitments on postwar economic policy; the joint chiefs had wanted bases; others in the military still wanted Britain to play only a minor, if any, role in the Pacific; and they were all apparently angry at the Treasury for godfathering the Quebec Agreement."
                                            },
                                            {
                                                "example_id": "ad802327-42f3-4d5a-bdad-fcdab2f243db",
                                                "sense_id": "2fbb478c-fa4f-32e0-9d33-ee325600b627",
                                                "text": "But months before, he'd agreed to godfather the premiere of The Godfather."
                                            },
                                            {
                                                "example_id": "8131edb5-b079-43a8-96ce-151acb080025",
                                                "sense_id": "2fbb478c-fa4f-32e0-9d33-ee325600b627",
                                                "text": "The grave site, humble as it is, reflects something more than a hometown’s determination to honor a fallen son, something that seems irreducible in the politics of Iraq: the refusal of the Sunni minority, who ruled Iraq for centuries until Mr. Hussein’s overthrow, to reconcile themselves to the assumption of power by the Shiite majority who won elections godfathered by the American occupation authority."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4195dc43-b9be-4d2e-a610-c504cf8292ef",
                        "source_entry_id": "02bc723c-013f-3e55-a726-6cec065ed9af",
                        "source_sense_id": "b658024a-ffdd-33e3-bc0b-e77e7c198058",
                        "source_sense_description": "Inhaber eines Ehrenamts zur Unterstützung der Eltern bei der Erziehung",
                        "target_lang_word": "parrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c94b31d-39c6-3392-91f9-74f1b63756da",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Celui qui, avec la marraine, présente un enfant (le filleul) aux fonts baptismaux (père spirituel d’un enfant) ou assiste l’enfant de manière analogue dans une cérémonie civile ou d’une autre religion ou conviction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563ec978-339d-4667-83e4-1fa2c5ac3666",
                                                "sense_id": "5c94b31d-39c6-3392-91f9-74f1b63756da",
                                                "text": "Il est le parrain de mon fils."
                                            },
                                            {
                                                "example_id": "172eef95-d634-4d97-8a90-b60d0fdf4013",
                                                "sense_id": "5c94b31d-39c6-3392-91f9-74f1b63756da",
                                                "text": "Le parrain et la marraine s’engagent à soutenir l’enfant en toute circonstance et à respecter sa liberté individuelle dans ses choix futurs."
                                            },
                                            {
                                                "example_id": "361bedf6-4ae1-4772-bfb1-cb14b3326596",
                                                "sense_id": "5c94b31d-39c6-3392-91f9-74f1b63756da",
                                                "text": "On affirme volontiers que l’enfant qui se retrouve orphelin sera confié à son parrain ou à sa marraine : ce serait l'intérêt du baptême religieux et, invention plus récente, du laïc baptême civil, ou républicain. C’est une légende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c2c932-5dea-3a88-8dc8-113e3a53a3d4",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Fils de la marraine."
                                        ],
                                        "tags": [
                                            "Centre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b14b762-5108-45cc-ad20-83a21dbd69de",
                                                "sense_id": "11c2c932-5dea-3a88-8dc8-113e3a53a3d4",
                                                "text": "Les jeunes filles de mon pays ont assez l’habitude de donner au fils de leur marraine le titre de parrain, et réciproquement celui de marraine à la mère du parrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d7e70e-ec5d-3a40-a013-4c1cfe2917a9",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Toute personne qui présente quelqu’un, qui se porte garant de quelqu’un dans un cercle, dans une société savante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f58a7fa-9410-416c-bcd8-e2bf3ce53dc9",
                                                "sense_id": "c3d7e70e-ec5d-3a40-a013-4c1cfe2917a9",
                                                "text": "À l’Académie française, les parrains sont les deux académiciens qui accompagnent le récipiendaire le jour de sa réception en séance publique."
                                            },
                                            {
                                                "example_id": "35d8e2ad-6f99-4a25-828d-dc5b311eaf96",
                                                "sense_id": "c3d7e70e-ec5d-3a40-a013-4c1cfe2917a9",
                                                "text": "Dans l’ordre de la Légion d’honneur, le parrain est celui qui remet les insignes au nouveau légionnaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f6954e-0f0e-363f-a67e-d63a9f6b1715",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Celui qui est choisi pour assister à la cérémonie de la bénédiction d’une cloche, d’un navire, et pour lui donner un nom."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f5a8f9-3c3a-408d-bbbd-ca92cc68ef74",
                                                "sense_id": "34f6954e-0f0e-363f-a67e-d63a9f6b1715",
                                                "text": "Un mois après, le village de Prosny était en grande fête ; on allait bénir la nouvelle cloche. Le choix du parrain et de la marraine avait quelque temps agité les esprits. Comme il est d’usage de les choisir parmi les plus hautes notabilités de la paroisse, on avait d’abord pensé à M. le maire et à madame son épouse […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfbd858-35f6-3960-86fb-77bae81077ca",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Autrefois, dans les combats singuliers, celui que chaque combattant choisissait pour l’accompagner, pour empêcher la surprise et pour lui servir de témoin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d5c543-9e36-4af6-9d58-ddf7fc373d88",
                                                "sense_id": "0cfbd858-35f6-3960-86fb-77bae81077ca",
                                                "text": "Les deux combattants se trouvèrent au lieu du combat, chacun avec son parrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d62b0c-5c55-3994-85e4-fa6a70ab6fb1",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Celui qui est le promoteur d’une idée, d’une théorie, d’une entreprise."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e92f3a5b-0d5d-32a7-bc65-f68aa07f8ecc",
                                        "entry_id": "729e7086-fbbe-3a4f-acfa-22ba2e2b8eaf",
                                        "glosses": [
                                            "Chef d’une organisation mafieuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
