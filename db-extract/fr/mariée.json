        "fr-extract.jsonl": [
            {
                "entry_id": "f0260bf3-d225-33e0-875d-e9cc2c2248c9",
                "word": "mariée",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c18b463-fedc-3cfa-8f2d-8601def6f1ee",
                        "entry_id": "f0260bf3-d225-33e0-875d-e9cc2c2248c9",
                        "glosses": [
                            "Féminin singulier de l’adjectif marié."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1b71e284-3ed3-46fc-b765-a3842e6cedd3",
                                "sense_id": "8c18b463-fedc-3cfa-8f2d-8601def6f1ee",
                                "text": "Moi, à quarante-cinq ans, ça en fait déjà vingt-sept que je suis mariée avec un insupportable qui m’a volé ma jeunesse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                "word": "mariée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "12c5861c-e5be-4f56-a979-27dd6071292a",
                        "entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                        "tags": [
                            "plural"
                        ],
                        "form": "mariées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2587caff-6ec8-334a-b5af-adde126da5a1",
                        "entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                        "glosses": [
                            "Femme qui se marie ou qui s’est mariée le jour même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a73b59fd-32be-472c-a1a1-e745d5b1ce9d",
                                "sense_id": "2587caff-6ec8-334a-b5af-adde126da5a1",
                                "text": "Celui que je soupçonnerais le plus, Tonsard, a passé la nuit à godailler ; mais votre adjoint était de la noce, votre meunier, il ne les a pas quittés ; ils étaient gris à ne pas se tenir ; ils ont reconduit la mariée à une heure et demie, et l’arrivée du cheval annonce que Michaud a été assassiné entre onze heures et minuit."
                            },
                            {
                                "example_id": "affc4fcc-ba95-4e57-8545-b9f9d2a81a10",
                                "sense_id": "2587caff-6ec8-334a-b5af-adde126da5a1",
                                "text": "Il était convenu que, par convenance, Françoise et Fanny s’occuperaient du service, pour que la mariée ne se levât pas ; mais celle-ci ne pouvait se tenir, quittait sa chaise à chaque minute, se retroussait les manches, très attentionnée à vider une sauce ou à débrocher un rôti."
                            },
                            {
                                "example_id": "6e9c1bbc-64d5-4f80-8db0-548bdb10a9c5",
                                "sense_id": "2587caff-6ec8-334a-b5af-adde126da5a1",
                                "text": "Sur le sommet de la barricade, au haut d’un timon qui se dressait, tout droit, comme une hampe de drapeau, un petit chasseur arbora un bouquet de mariée trouvé dans le butin."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d6d1b2d-89b8-36ca-bca1-82e82187d1b6",
                        "entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                        "glosses": [
                            "Épouse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2154d59a-60b0-3628-aae2-b841756d7587",
                        "entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                        "glosses": [
                            "Synonyme de lichénée mariée (papillon)."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5483b10d-658b-44ae-99b8-3331688c409a",
                                "sense_id": "2154d59a-60b0-3628-aae2-b841756d7587",
                                "text": "Faune : rougequeue noir, accenteur mouchet, merle noir, huppe fasciée, pinson des arbres, rougequeue à front blanc, pic épeiche, bergeronnette des ruisseaux, chardonneret élégant, tourterelle turque, aeschne bleue, sympétrum fascié, leste vert, dolomède des marais, chrysolina fastuosa, pisaure admirable, héliophanus auratus, thomise à trois taches, helcystogramma triannulella, écaille cramoisie, pyroderces argyrogrammos, crambus des chaumes, crambus des pâturages, pyrale de l’armoise, pleuroptya ruralis, botys ferrugineux, râtissée, elachista biatomella, elachista monosemiella, ethmia quadrilellia, lithosie de Godart, mariée, boarmie des lichens, alternée, fausse eupithécie, vieillie, pyrale du houblon, acidalie blanchâtre, boarmie rhomboïdale, phalène sacrée, timandre aimée, phalonidia contractana, pandemis heparana, bactra venosana, sphynx du peuplier, trimaculée, nonagrie bétique, eustrotie claire, lupérine testacée, noctuelle de Duméril, troënière, pyramide, noctuelle des moissons, Sylvine, parectopa ononidis, drille joyeux, criquet noir-ébène, hylurgops palliatus, parethelcus collinarius, charançon des iris, anthrène des tapis, oxythyrea alaris, syrphe ceinturé, mouche pourceau, volucelle zonée, abeille domestique, abeille charpentière, bourdon terrestre, philanthus triangulum, coccinelle à 7 points, zygina lunaris, couleuvre verte et jaune, couleuvre vipérine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fc13fef-3176-4b7a-92b3-3524d09d9132",
                        "source_entry_id": "7b86d517-2acb-3aaa-9379-785360a29dbe",
                        "target_lang_word": "bride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0773d61-598e-3285-923c-e7dacd71940a",
                                        "entry_id": "b0a0777e-270a-3f6e-acbd-6c435e61c476",
                                        "glosses": [
                                            "A woman in the context of her own wedding; one who is going to marry or has just been married."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5e9f6d-b3da-4193-b6c9-fd1c917c7056",
                                                "sense_id": "f0773d61-598e-3285-923c-e7dacd71940a",
                                                "text": "I will show thee the bride, the Lamb's wife."
                                            },
                                            {
                                                "example_id": "4b0bc272-6f71-4992-9b74-a2d73056818d",
                                                "sense_id": "f0773d61-598e-3285-923c-e7dacd71940a",
                                                "text": "Has by his own experience tried\n How much the wife is dearer than the bride."
                                            },
                                            {
                                                "example_id": "6aed598b-6ecb-42af-8c1c-4bad7d8ae286",
                                                "sense_id": "f0773d61-598e-3285-923c-e7dacd71940a",
                                                "text": "Sophia broke down here. Even at this moment she was subconsciously comparing her rendering of the part of the forlorn bride with Miss Marie Lohr's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc242b1-804d-306d-ace3-9030029afd9e",
                                        "entry_id": "b0a0777e-270a-3f6e-acbd-6c435e61c476",
                                        "glosses": [
                                            "An object ardently loved."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
