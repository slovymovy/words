                "senses": [
                    {
                        "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                        "entry_id": "34a1ae18-b48f-3e29-8fce-8abea0b7588b",
                        "glosses": [
                            "Leichtathletin, die beim Kugelstoßen die Drehstoßtechnik anwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d29a9f4-069d-4bb3-8d16-f0baca3c0086",
                                "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                                "text": "„Drehstoßerin Katharina Maisch vom TUS Metzingen in Württemberg zeigte mit 16,39 Metern die beste Wurfleistung bei den Frauen.“"
                            },
                            {
                                "example_id": "b7ce92fc-72f2-4bc9-87ee-a220f8f0b9b1",
                                "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                                "text": "[Katharina Maisch (TuS Metzingen):] „Die Drehstoßerin […] schraubte ihre Bestmarke auf 17,77 Meter.“"
                            },
                            {
                                "example_id": "bb9398cd-d81e-4909-a4d1-b427d2aa0054",
                                "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                                "text": "„Katharina Maisch (LV 90 Erzgebirge, früher TUS Metzingen) holte Bronze, die Drehstoßerin kam auf 17,65 Meter.“"
                            },
                            {
                                "example_id": "446371e4-a0dd-4323-b109-abcf281e572e",
                                "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                                "text": "[Jolina Lange:] „Ein weiterer Versuch der jungen Drehstoßerin flog auf 16,46 Meter […].“"
                            },
                            {
                                "example_id": "87a1ee67-ea51-4543-85d2-c423fe16c9b3",
                                "sense_id": "bd1621b6-144c-372f-9d57-0a509bad6476",
                                "text": "„Petra Engel kam schwer in Tritt und erst im dritten Versuch mit einem Stoß auf 9,71 m konnte sich die Drehstoßerin für die Runde der besten Acht qualifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
