                "senses": [
                    {
                        "sense_id": "42b90707-1838-33cc-b344-8b662b2e9d6c",
                        "entry_id": "c612ca45-4eaa-3a36-8273-ef09d4eafa3d",
                        "glosses": [
                            "im indischen Bundesstaat Bihar gesprochene Gruppe von Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8272c758-247e-4fe2-bf8d-f025af1cc286",
                                "sense_id": "42b90707-1838-33cc-b344-8b662b2e9d6c",
                                "text": "Bihari wird in der Schrift Devanagari geschrieben."
                            },
                            {
                                "example_id": "50982e04-cc35-4f50-a281-cdb68e9f46d9",
                                "sense_id": "42b90707-1838-33cc-b344-8b662b2e9d6c",
                                "text": "„Im Westen Indiens zählt man das Rajasthani dazu, das ein Oberbegriff für die in Rajasthan gesprochenen Dialekte ist, im Osten das Bihari, Oberbegriff für dort übliche Dialekte.“"
                            },
                            {
                                "example_id": "d022d815-683b-40fb-825a-5e1e04d7b01d",
                                "sense_id": "42b90707-1838-33cc-b344-8b662b2e9d6c",
                                "text": "„Das Bihari ist keine einheitliche Sprache, es besteht aus Bhojpuri, Maithili, Magahi und einigen kleineren Mundarten, die vielfach vom Hindi verdrängt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
