                        "glosses": [
                            "Qui peut se voir attribuer un millésime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06dbfb24-e618-4132-a31d-be8e41a6ad48",
                                "sense_id": "5ea317f4-812c-3320-9b66-e032bd3e700d",
                                "text": "Cette année, dame Nature s’est montrée particulièrement généreuse puisque aux volumes importants correspond une qualité tout aussi remarquable qui rend la récolte « millésimable » grâce notamment au fort degré en alcool contenu dans le raisin."
                            },
                            {
                                "example_id": "758c6c4d-85cf-4b75-85ef-2ff21f84dae1",
                                "sense_id": "5ea317f4-812c-3320-9b66-e032bd3e700d",
                                "text": "Au chai, seuls 35 fûts vieillissent. Tous ont une bonde cachetée de cire, attestant du caractère millésimable des nectars."
                            },
                            {
                                "example_id": "5d45cf1c-e08e-423d-9a92-b06d4a7d44b6",
                                "sense_id": "5ea317f4-812c-3320-9b66-e032bd3e700d",
                                "text": "En effet, un millésime est un vin qui a pour objectif de vieillir. Résultat, toutes les années ne sont pas millésimables."
                            }
                        ]
                    }
