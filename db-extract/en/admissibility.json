                                            {
                                                "example_id": "ed439146-b9a7-44c4-a96a-56cfd3f5b03f",
                                                "sense_id": "f3d14e9e-8704-38ea-ac58-c8fc0b5dec01",
                                                "text": "L’admissibilité de tous les citoyens aux emplois publics."
                                            },
                                            {
                                                "example_id": "d863c69a-beaf-4dd7-ad84-d2305c91630d",
                                                "sense_id": "f3d14e9e-8704-38ea-ac58-c8fc0b5dec01",
                                                "text": "La décision d'admissibilité entraîne des effets essentiels sur les droits des créanciers et ceux du débiteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6244ed0-9d79-3d6f-af75-2b4120868bfb",
                                        "entry_id": "c3908efd-f3b6-3508-8098-a5420a93f38d",
                                        "glosses": [
                                            "Résultat de la première épreuve d’un examen ou d’un concours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
