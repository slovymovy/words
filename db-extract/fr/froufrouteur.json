                    {
                        "sense_id": "eae9f411-964a-3268-9290-fd1e50032c41",
                        "entry_id": "62c0f387-87b2-3298-b688-49d20759ade2",
                        "glosses": [
                            "Correspondant libertin de la rubrique «Le petit courrier des lecteurs» de l’hebdomadaire le Frou-frou (1900-1923)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2764780e-cff4-4aaf-a3c1-9392461f76b8",
                                "sense_id": "eae9f411-964a-3268-9290-fd1e50032c41",
                                "text": "Nous rappelons aux Froufrouteurs que, désormais, LES DEMANDES SONT PAYANTES, en raison de l’abondance du PETIT COURRIER."
                            },
                            {
                                "example_id": "6904960b-e208-4e57-925c-4c3591e15eda",
                                "sense_id": "eae9f411-964a-3268-9290-fd1e50032c41",
                                "text": "Loute, pour charmer ses loisirs, désire correspondre avec un froufrouteur lyonnais."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ceae0a85-9f9e-3dda-86b0-f52e7cee0a0b",
                "word": "froufrouteur",
