                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bbd4ba3-e654-4806-9a18-47242a7217dd",
                                "sense_id": "ea7a85d8-7a15-37e3-8971-b25df9397321",
                                "text": "Już od kilku lat w Stanach Zjednoczonych i Kanadzie prowadzi się badania alfabetyzmu świata dorosłych (…) oraz jego społecznych przyczyn i konsekwencji"
                            },
                            {
                                "example_id": "1e517ec6-5661-47e6-a3f9-a3400e2cb97f",
                                "sense_id": "ea7a85d8-7a15-37e3-8971-b25df9397321",
                                "text": "Pod względem poziomu alfabetyzmu, oświaty, wydajności gospodarczej, konkurencyjności i postępu technicznego Finlandia należy do pięciu, sześciu najbardziej rozwiniętych krajów świata"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f466fe0-2530-420b-b68a-3e589e581415",
                        "source_entry_id": "c118a460-c5ab-3083-92ce-ff1a5e82f52b",
                        "source_sense_id": "ea7a85d8-7a15-37e3-8971-b25df9397321",
