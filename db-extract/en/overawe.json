                "senses": [
                    {
                        "sense_id": "93144092-f939-3a7c-9f02-7f550704fc55",
                        "entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "glosses": [
                            "einschüchtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4288bd-8b92-4e39-a055-5125daf58f6c",
                                "sense_id": "93144092-f939-3a7c-9f02-7f550704fc55",
                                "text": "He would frequently overawe and browbeat others, but he was never imperious in dealing with Lincoln.",
                                "translation": "Er würde andere einschüchtern und unter Druck setzen, aber er war niemals herrisch im Umgang mit Lincoln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "561bed97-afec-3dd7-ab91-661989083476",
                        "entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "glosses": [
