                        "source_sense_id": "57af521b-333d-395c-b9a9-70bdf9d80099",
                        "source_sense_description": "een verboden, onwettige, criminele handeling",
                        "target_lang_word": "misdeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                        "entry_id": "cb81d770-210a-38f3-97a7-abc61ccdb480",
                                        "glosses": [
                                            "That which was done that should not have been, ranging from any sin or moral offense to various degrees of crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d345cc99-bdae-4a40-b3ad-d09ab30d3750",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "The petty misdeeds of his youth came back to haunt him when he ran for political office and his character was smeared."
                                            },
                                            {
                                                "example_id": "7d90b864-53ab-423c-b7d8-aa3803e2a5e0",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "These [putting feet on seats and leaving rubbish behind] are officially among the worst habits revealed by staff working on Northern's trains and at stations. Other bugbears include playing music through loudspeakers, not giving way to passengers getting off the train and actually illegal activities such as fare evasion and vaping in enclosed spaces. The list of misdeeds was released by the operator on March 3 to coincide with Employee Appreciation Day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5059c869-5a8a-408f-8cea-2bafd42e5a30",
                        "source_entry_id": "18f68419-b011-323f-b880-9b8fac4a6584",
                        "source_sense_id": "57af521b-333d-395c-b9a9-70bdf9d80099",
                        "source_sense_description": "een verboden, onwettige, criminele handeling",
                        "target_lang_word": "wrongdoing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrongdoing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4a29ab-4817-398c-aed0-71d4a9b87cc3",
                                        "entry_id": "df93627d-cde1-3c7b-a0b3-222c1ace9c9b",
                                        "glosses": [
                                            "Violation of standards of behavior."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b94933-fbc5-4bb9-9455-65cb73848bd8",
                                                "sense_id": "ef4a29ab-4817-398c-aed0-71d4a9b87cc3",
                                                "text": "A Chinese proverb goes, \"He who commits wrongdoing repeatedly will come to no good end.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf71716-cce2-3f89-9865-75f1eb3c1c22",
                                        "entry_id": "df93627d-cde1-3c7b-a0b3-222c1ace9c9b",
                                        "glosses": [
                                            "An instance of doing wrong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc782303-d214-4cfc-930f-f3c0a5d5d42d",
                                                "sense_id": "9cf71716-cce2-3f89-9865-75f1eb3c1c22",
                                                "text": "I said that some ancient stories suggested that those who were unrighteous or who had committed wrongdoings were more susceptible to plagues or disasters. And sometimes plagues just miraculously disappeared after people realized their wrongdoings and repented."
                                            }
                                        ]
                                    }
                                ]
