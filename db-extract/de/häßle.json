                "senses": [
                    {
                        "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                        "entry_id": "7dc678f2-2f29-3e09-8cd4-a04b7f32f1e8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6565893-c702-447c-9cfe-15a641768e02",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Frau Häßle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "36372c15-f955-4396-898a-36b413c2dc56",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Herr Häßle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "baf241c7-98b5-4db7-8c0b-bc05a1a93ed3",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Die Häßles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1f4a236b-6d7c-4079-83f6-3990cf0ea9aa",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Der Häßle trägt nie die Pullover, die die Häßle ihm strickt."
                            },
                            {
                                "example_id": "ad27ad3b-9ca1-432a-bf75-8aad8ad29769",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häßle kommt, geht der Herr Häßle.“"
                            },
                            {
                                "example_id": "bac88f4c-4ff2-4068-a523-250499f63608",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Häßle kommt und geht."
                            },
                            {
                                "example_id": "fd1cdc50-2f54-4543-8ced-ec36483f0820",
                                "sense_id": "542541d8-bc84-3da0-940c-c6ee40c860d3",
                                "text": "Häßles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
