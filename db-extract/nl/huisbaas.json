                                "sense_id": "c9950969-1c9a-35ed-9eae-3f5cc9f2bcf5",
                                "text": "De huisbaas heeft de huurprijs van het appartement verhoogd.",
                                "translation": "房东涨了房租。"
                            },
                            {
                                "example_id": "671a7cf7-9221-496c-b34f-dc6a110075aa",
                                "sense_id": "c9950969-1c9a-35ed-9eae-3f5cc9f2bcf5",
                                "text": "De huisbaas heeft aangekondigd dat er renovaties in het gebouw zullen plaatsvinden.",
                                "translation": "房东宣布要对这栋楼进行装修。"
                            }
