                "senses": [
                    {
                        "sense_id": "03d06ede-3555-3ae1-b9ec-2bb80c9e084b",
                        "entry_id": "80e64d23-a2f8-3c1b-9fa0-793b59d18833",
                        "glosses": [
                            "Bombe, deren Prinzip auf der Fusion von Wasserstoffkernen beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade89c8f-e30f-4b3f-a399-c1e870332fce",
                                "sense_id": "03d06ede-3555-3ae1-b9ec-2bb80c9e084b",
                                "text": "Die Wasserstoffbombe gehört zu den unseligsten Erfindungen der Menschheit."
                            },
                            {
                                "example_id": "b1b040e9-0692-4562-8a55-ca7004b72b5b",
                                "sense_id": "03d06ede-3555-3ae1-b9ec-2bb80c9e084b",
                                "text": "„Am 6. Jänner 2016 nimmt Pjöngjang seinen vierten unterirdischen Atomwaffentest vor. Pjöngjang spricht von einer Wasserstoffbombe, Experten bezweifeln dies.“"
                            },
                            {
                                "example_id": "ca165f6f-5399-4bf9-a1c8-e034e6d75fb1",
                                "sense_id": "03d06ede-3555-3ae1-b9ec-2bb80c9e084b",
                                "text": "„Zwischen 1951 und 1953 fand der Korea-Krieg statt, und 1952 zündeten die USA die erste Wasserstoffbombe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
