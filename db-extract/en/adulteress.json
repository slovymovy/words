                                            {
                                                "example_id": "97c659ba-680a-4c83-aa9a-e840a17f8c14",
                                                "sense_id": "304d6475-df72-399c-9683-0eea8dc5877b",
                                                "text": "Hij stamelde dat de koningin van Schotland een echtbreekster was en werd verdacht van moord en dat hij een man was die ervan hield op een veilig hoofdkussen te slapen."
                                            },
                                            {
                                                "example_id": "8f7c8881-af36-4e02-ad3a-390889560910",
                                                "sense_id": "304d6475-df72-399c-9683-0eea8dc5877b",
                                                "text": "„Die meid heeft geen zelfrespect”, schreef die laatste online. „Ze spreekt af met getrouwde mannen die kinderen hebben, terwijl ze zelf niet eens nakomelingen wil. Karma is a bitch. Knoop dat maar goed in je oren, echtbreekster. Je krijgt nog wel wat je verdient.”"
                                            }
                                        ]
                                    }
