                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abca154f-1466-4be6-8365-3acac35b87cc",
                                                "sense_id": "09612990-e4bd-30d2-b210-def7e105021e",
                                                "text": "Going down my cellar to look, I put my foot into a heap of turds, by which I find that Mr Turner’s house of office is full and comes into my cellar, which doth trouble me; but I will have it helped."
                                            },
                                            {
                                                "example_id": "d931500c-a73a-4d15-9c78-64cd1707ec07",
                                                "sense_id": "09612990-e4bd-30d2-b210-def7e105021e",
                                                "text": "I never, since I left England, till now, have regal'd Myself with a good house of Office... the holes in Germany are... too round, chiefly owing... to the broader bottoms of the Germans."
                                            },
                                            {
                                                "example_id": "6955e9ab-4c4b-43f9-934d-867060f05b90",
                                                "sense_id": "09612990-e4bd-30d2-b210-def7e105021e",
                                                "text": "The very clerks—those somewhat dirty springs\nOf office, or the House of Office."
                                            }
                                        ]
                                    }
