                ],
                "senses": [
                    {
                        "sense_id": "8758545e-c1bb-3cb6-8f69-55e2252b5d8e",
                        "entry_id": "1c0752d1-eb36-3956-83c3-bdfe9ce0e5d3",
                        "glosses": [
                            "Linguistik, speziell Laut, der im Rachen gebildet wird."
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "46e5c3b3-ed08-44e6-8637-5d00a903c25e",
                                "sense_id": "8758545e-c1bb-3cb6-8f69-55e2252b5d8e",
                                "text": "Rachenlaute kommen im Arabischen vor."
                            },
                            {
                                "example_id": "d347151b-80ec-4347-b0f7-1dee4cd205cf",
                                "sense_id": "8758545e-c1bb-3cb6-8f69-55e2252b5d8e",
                                "text": "Bisweilen wird das hinten gesprochene [R] als „Rachen-R“ und damit als Rachenlaut bezeichnet."
                            },
                            {
                                "example_id": "5080141d-b5c6-4ee8-ab49-52e698161c31",
                                "sense_id": "8758545e-c1bb-3cb6-8f69-55e2252b5d8e",
                                "text": "„Doch was da an sein Ohr drang, war ihm ganz und gar fremd: ein Silbensingsang voller Zungenschnalzen und Rachenlauten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
