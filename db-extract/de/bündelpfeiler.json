                "senses": [
                    {
                        "sense_id": "97a49c47-41f5-3ef1-ae28-43df9038df07",
                        "entry_id": "746edf6d-35d0-392f-8043-119293580b15",
                        "glosses": [
                            "Stütze in der gotischen Architektur, die von mehreren dünnen Säulen (sogenannten Diensten) umschlossen ist"
                        ],
                        "tags": [
                            "Baukunst"
                        ],
                        "examples": [
                            {
                                "example_id": "ed929290-c173-45ac-ac01-d22a66d4a705",
                                "sense_id": "97a49c47-41f5-3ef1-ae28-43df9038df07",
                                "text": "„Das Profil der Stangen erinnert aber auch an die Bündelpfeiler und die Rippen gotischer Kathedralen: Chartres oder Reims, aus Stangensellerie konstruiert – die Lichtkunst der Gotik träte in völlig neue Dimensionen ein.“"
                            },
                            {
                                "example_id": "8bb1fb6d-61be-40e4-88d3-22c70ad9e119",
                                "sense_id": "97a49c47-41f5-3ef1-ae28-43df9038df07",
                                "text": "„Bereits im ersten Raum, den Ottonen gewidmet, wecken die vielen, hinter den historischen Bildzeugnissen senkrecht verlaufenden Rohrleitungen Erinnerungen an die Bündelpfeiler hochmittelalterlicher Dome.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
