                                "example_id": "9e976f38-65ff-46c3-941e-2fc9b5f0850c",
                                "sense_id": "17ee1671-0bdc-3276-ab60-e0aabdbd45bd",
                                "text": "Later in the day, clad in an odd collection of baggy garments, he sat and warmed himself in the sun, which was fast drawing up in the form of a blankety mist the moisture from the ground."
                            },
                            {
                                "example_id": "60a88102-844d-49af-a3e9-2f610988896a",
                                "sense_id": "17ee1671-0bdc-3276-ab60-e0aabdbd45bd",
                                "text": "It's a floating feeling, an eyes-closed, comfy, blankety feeling, the feeling of not having to worry about anything."
