                            {
                                "example_id": "b405f836-0a43-4597-8d95-a8ab15127df6",
                                "sense_id": "45cb7d37-659c-3bcf-9f64-5100ba2d85b9",
                                "text": "Je hebt geen talent en je bent aanstootgevend. Weet wel dat je nimmermeer vruchtdragend wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "328d9044-a5af-378e-811e-fb3999846e36",
                        "entry_id": "8896fff7-6d5c-3143-bbae-54e2a802ea91",
