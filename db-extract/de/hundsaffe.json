                "senses": [
                    {
                        "sense_id": "3b00391f-f3a0-3d43-82d9-e27da71e861a",
                        "entry_id": "80d258b6-a5fa-3637-bb43-3bd9ca0c87a2",
                        "glosses": [
                            "eine Untergruppe der Altweltaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b405d3-d5e7-4d53-b790-e4a15fc32322",
                                "sense_id": "3b00391f-f3a0-3d43-82d9-e27da71e861a",
                                "text": "„Die Altweltaffen wiederum verzweigen sich in Arten mit Schwanz – die Hundsaffen […]; dazu gehören die Meerkatzen, Makaken, Paviane, Languren, Stummelaffen und schwanzlose Arten: die Menschenähnlichen …“"
                            },
                            {
                                "example_id": "addd9d3b-db68-437e-b33a-37a9165258dc",
                                "sense_id": "3b00391f-f3a0-3d43-82d9-e27da71e861a",
                                "text": "„Anders als Hundsaffen besitzen die Menschenaffen oder Andropomorpha bzw. Hominoidea keinen Schwanz“"
                            },
                            {
                                "example_id": "ddfc4c05-9969-4b0c-94d7-6a7f4f9fcfc1",
                                "sense_id": "3b00391f-f3a0-3d43-82d9-e27da71e861a",
                                "text": "„Orang-Utans seien auch nicht so wild wie Paviane, nicht so dumm wie Meerkatzen, nicht so schmutzig wie Springaffen, nicht so ungeduldig und triebhaft wie Hundsaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
