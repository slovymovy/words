                "senses": [
                    {
                        "sense_id": "02da71ff-e03e-34bc-b178-af93197c431f",
                        "entry_id": "f59a4eb8-41fd-336f-8d0d-bff6c32f3b14",
                        "glosses": [
                            "historical bias"
