                "forms": [],
                "senses": [
                    {
                        "sense_id": "0aa6b6de-d7c8-3a91-9421-237347c20487",
                        "entry_id": "ef294f51-89a6-3887-88d2-957f68fe1daa",
                        "glosses": [
                            "Relatif aux Hopis, à leur culture, leur langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0815022-ad49-49a5-9509-1e9851aec26d",
                                "sense_id": "0aa6b6de-d7c8-3a91-9421-237347c20487",
                                "text": "Les chefs spirituels hopi ont un savoir que nous n’avons pas."
                            },
                            {
                                "example_id": "92f791ee-3ec1-47e0-87df-3b2af56916b3",
                                "sense_id": "0aa6b6de-d7c8-3a91-9421-237347c20487",
                                "text": "Le processus d’assimilation est simple, soit le Kachina est purement ajouté sous sa forme actuelle, soit il subit quelques transformations pour paraître plus hopi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8433c4dd-5930-466c-885e-1a61dcc90a4f",
                        "source_entry_id": "ef294f51-89a6-3887-88d2-957f68fe1daa",
                        "source_sense_id": "0aa6b6de-d7c8-3a91-9421-237347c20487",
