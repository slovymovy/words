                        "sense_id": "a79dd3fa-f4bb-32b1-9d53-c9f8b0036689",
                        "entry_id": "813cbf50-7d65-3f7f-9b43-7786285fb7d5",
                        "glosses": [
                            "young, youthful, new"
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "c2c97be3-fbdc-47bc-b887-cb5daec7a369",
                                "sense_id": "a79dd3fa-f4bb-32b1-9d53-c9f8b0036689",
                                "text": "Когда в дом входит год младой,\nА старый уходит вдаль,\nСнежинку хрупкую спрячь в ладонь,\nЖелание загадай.",
                                "translation": "When the new year enters your home,\nAnd the old year goes far away,\nHide a fragile snowflake in your hand,\nMake a wish.",
                                "english": "When the new year enters your home,\nAnd the old year goes far away,\nHide a fragile snowflake in your hand,\nMake a wish."
                            }
                        ]
                    }
                ],
