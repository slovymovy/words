                        "sense_id": "5401c798-2e8f-3a86-b2f7-e37d022cbe59",
                        "entry_id": "61df5952-84d1-3f86-a0fc-fcdb73e590fa",
                        "glosses": [
                            "Gesamtheit der Gegenstände, die der Vermittlung von Wissen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c146b2-dcbd-490d-80a9-4d9dadaecf80",
                                "sense_id": "5401c798-2e8f-3a86-b2f7-e37d022cbe59",
                                "text": "„Für den Unterricht stellen wir deshalb kostenlos Schulungsmaterial und Anzeigedisplays zur Verfügung.“"
                            },
                            {
                                "example_id": "a8ea6b20-f293-46b2-a086-3dda9331337f",
                                "sense_id": "5401c798-2e8f-3a86-b2f7-e37d022cbe59",
                                "text": "„Der Einsatz von interaktivem Schulungsmaterial ist durch eine geeignete Person zu begleiten. Bei geringer Kenntnis der deutschen Sprache der zu Schulenden ist fremdsprachiges Schulungsmaterial oder Schulungsmaterial mit Schwerpunkt auf bild- und symbolhaften Darstellungen geeignet […].“"
                            },
                            {
                                "example_id": "cdf01e5a-d77e-4c36-b8b0-daa59db4fc07",
                                "sense_id": "5401c798-2e8f-3a86-b2f7-e37d022cbe59",
                                "text": "„Äußerungen von Hass gegenüber Juden und Anstiftung dazu wird man im Schulungsmaterial der Hitler-Jugend und des Bundes Deutscher Mädel nicht finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
