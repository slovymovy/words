                "senses": [
                    {
                        "sense_id": "2bf05000-bf6b-3d39-ade9-41f05d3a93ad",
                        "entry_id": "99927839-6657-39ca-8122-8bb4ea9ce631",
                        "glosses": [
                            "To make (something) into a liquid."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "139ae6a6-1433-4cdf-b3f2-0a2591b3253f",
                                "sense_id": "2bf05000-bf6b-3d39-ade9-41f05d3a93ad",
                                "text": "We’ll liquefy this rock by heating it in a furnace until it melts and flows out."
                            },
                            {
                                "example_id": "01a85f4f-5236-4b6f-b627-8228e9d98230",
                                "sense_id": "2bf05000-bf6b-3d39-ade9-41f05d3a93ad",
                                "text": "Faraday succeeded in liquefying a certain number of gases by compression and refrigeration, but there still remained a number that proved absolutely refractory to the most powerful agencies; hence these gases were called permanent. […] A retired manufacturer, who at the same time is a distinguished man of science, M. Cailletet, has subdued the permanent gases, having succeeded in liquefying and solidifying them."
                            },
                            {
                                "example_id": "fe55838a-4d52-4853-a284-8f5bbc8ad6ed",
                                "sense_id": "2bf05000-bf6b-3d39-ade9-41f05d3a93ad",
                                "text": "Place crayfish and fresh pepper in a blender, add small water, liquefy and cook for 20 minutes or until tender."
                            }
                        ]
                    },
                    {
                        "sense_id": "20ca378f-cf66-3c74-a33f-d8c377c3f7a7",
