                "senses": [
                    {
                        "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                        "entry_id": "ba24a2e1-ff12-35a2-966d-d1f8ab2f9834",
                        "glosses": [
                            "kistenartiges Perkussionsinstrument, das zumeist mit den Händen bespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1442a80e-84fc-47c3-9a89-2cb411952c45",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Schlagzeuger Fabian Wolf sorgt für den treibenden Groove oder begleitet sanft auf der Kistentrommel Cajon.“"
                            },
                            {
                                "example_id": "17e6e346-601a-4960-ba06-de09ec9f1797",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Die Südafrikanerin lebt in London und spielt Cajon, grob gesagt eine Kistentrommel.“"
                            },
                            {
                                "example_id": "7ea3f74e-0cb1-402e-8fc7-46bf18d0674d",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Auf der Bühne des Bad Heilbrunner Kursaals steht nichts als ein paar Stühle und ein Cajon, diese ursprünglich peruanische Kistentrommel, die wie eine schlichte Holzkiste aussieht, aber klingt wie ein Schlagzeug, wenn der richtige Percussionist sie mit seinen Händen bearbeitet.“"
                            },
                            {
                                "example_id": "0264e584-6b29-4291-baa0-2c3a80d1e079",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Hier hockt René – auch er trägt das Wort ‚Crew‘ auf dem Rücken seiner blau-gelben DJH-Kluft – auf einer Kistentrommel und demonstriert ein paar Grundschläge.“"
                            },
                            {
                                "example_id": "01a77f21-283a-4710-a493-c69b458c0367",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Sein Cousin Jakob Rebay spielt Cajón, eine Kistentrommel, und hat mit seiner Familie den Lebensmittelpunkt in Weßling.“"
                            },
                            {
                                "example_id": "640dfbc1-0562-408b-b7ce-0b51c688e0f0",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Mit zwei Gitarren, einer Mundharmonika und der Kistentrommel Cajon spielen sie am Samstag, 12.“"
                            },
                            {
                                "example_id": "1b73d727-c680-4fd6-96c1-70f422c887d2",
                                "sense_id": "d3e354ce-ff0a-3c68-bf83-ae1d350b141f",
                                "text": "„Chorgesänge, strenge Percussions und Samples ineinander; die peruanische Kistentrommel Cajón spielt Rhythmusexpertin Naomi ebenso selbstverständlich, wie sie Stolper- und Knisterbeats programmiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
