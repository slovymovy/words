                ],
                "senses": [
                    {
                        "sense_id": "307d75cc-f9f0-3965-9253-a850ecd71fad",
                        "entry_id": "1999e7a8-02cb-372d-b24e-076a555ed77f",
                        "glosses": [
                            "Objet décoratif aimanté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13470d3a-b2de-4526-9e8b-e0c6c419633a",
                                "sense_id": "307d75cc-f9f0-3965-9253-a850ecd71fad",
                                "text": "À sa demande impérieuse, je rapporte à Hugo un magnet de chaque lieu, village des Alpes ou capitale lointaine peu lui importe, un magnet pour preuve indiscutable de mon passage."
                            },
                            {
                                "example_id": "38a1c30d-af65-453b-9cbd-d99f2c68901f",
                                "sense_id": "307d75cc-f9f0-3965-9253-a850ecd71fad",
                                "text": "Le Game est constitué d’un plateau de jeu classique, représentant un plan d’espace intérieur vierge et de magnets représentants les 6 typologies d’espace du Work@OVH."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b89c19a8-4dc3-4a20-8f1a-7e9dc15e581a",
                        "source_entry_id": "1999e7a8-02cb-372d-b24e-076a555ed77f",
                        "source_sense_id": "307d75cc-f9f0-3965-9253-a850ecd71fad",
                        "target_lang_word": "magnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
