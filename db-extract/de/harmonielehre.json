                                "sense_id": "eb164107-7870-3611-85da-86b08a95173d",
                                "text": "Mein Klavierspiel ist gut, aber ich habe Defizite in der Harmonielehre."
                            },
                            {
                                "example_id": "8f9f8fcc-be08-40fc-9e4d-75d86e40d00b",
                                "sense_id": "eb164107-7870-3611-85da-86b08a95173d",
                                "text": "„Die Pythagoreer haben mit der Harmonielehre eine Verzahnung von Mathematik und Musik geschaffen, die bis heute erhalten geblieben ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
