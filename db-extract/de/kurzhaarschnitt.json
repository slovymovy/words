                "senses": [
                    {
                        "sense_id": "9ee8ccd6-f3fe-3703-b763-f33e30f4434e",
                        "entry_id": "71345cb1-14b8-3156-98d9-2c3de51690bd",
                        "glosses": [
                            "Coupe (de cheveux) courte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e01172f-096d-4255-a8b9-807ce1a3135a",
                                "sense_id": "9ee8ccd6-f3fe-3703-b763-f33e30f4434e",
                                "text": "Ich war sehr jung, trug einen Kurzhaarschnitt, an den Ohren große Kreolen und ein langes, blaues Kleid, das mir mehr Blicke, Komplimente, unverschämte und unausgesprochene Angebote einbrachte als sonst.",
                                "translation": "J’étais très jeune, je portais la coupe courte, de grandes créoles aux oreilles, une longue robe bleue qui m’avait valu plus de regards, de compliments, de propositions indécentes et informulées que d’habitude."
                            }
                        ]
                    }
                ],
