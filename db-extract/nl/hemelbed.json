                                "target_senses": [
                                    {
                                        "sense_id": "c4613126-9d8e-3506-abb3-25558d258d71",
                                        "entry_id": "0f46ac5c-d411-3443-86c8-04bd3e0f361e",
                                        "glosses": [
                                            "Lit dont le ciel est tenu au mur en porte-à-faux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ac0a57-8945-4e30-9c92-10e64d15f526",
                                                "sense_id": "c4613126-9d8e-3506-abb3-25558d258d71",
                                                "text": "Les chambres à coucher étaient vastes et obscures avec des lits à baldaquins, des commodes immenses, des portraits de famille noircis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7186d7-71cf-3ad8-bd26-09cbce4b58cf",
                                        "entry_id": "0f46ac5c-d411-3443-86c8-04bd3e0f361e",
                                        "glosses": [
                                            "Désigne aussi couramment le lit à courtines et le lit à colonnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a62c56c-d2ff-459c-a8a5-0955d05331fe",
                                                "sense_id": "3d7186d7-71cf-3ad8-bd26-09cbce4b58cf",
                                                "text": "Leur petite chambre, avec ses massives poutres en chêne taillées à la hache il y avait des siècles de cela. Le lit à baldaquin enveloppé d’un voile vaporeux. L’odeur de cire fraîche qui emplissait l’espace."
                                            }
                                        ]
                                    }
                                ]
                            }
