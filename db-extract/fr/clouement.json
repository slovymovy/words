                        "examples": [
                            {
                                "example_id": "4f6bd255-2e90-4b6b-89fb-b1366c3f72aa",
                                "sense_id": "9e36fe76-8866-30d3-8533-529c51660c01",
                                "text": "L’autre cierge, le plus gros, sera présenté avec déférence à la maîtresse du domaine qui, dans sa chambre, le mettra à côté du Christ en bois taillé dont le clouement lui rappelle, chaque fois qu’elle prie, les souffrances du pauvre Bastien."
                            },
                            {
                                "example_id": "866cfce4-0053-478f-a34c-2a452646f459",
                                "sense_id": "9e36fe76-8866-30d3-8533-529c51660c01",
                                "text": "Note : Il s’employait surtout dans cette expression : Le clouement du Christ."
                            }
                        ]
                    }
