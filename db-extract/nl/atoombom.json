                    },
                    {
                        "translation_id": "3313bfea-b448-40e4-ad8f-e0fad11ba025",
                        "source_entry_id": "f7c2bd92-0ea7-377d-a4d7-4cfda5baf838",
                        "source_sense_id": "f043334b-3370-30eb-a77e-ea010d15e970",
                        "source_sense_description": "een bom waarvan de vernietigingskracht berust op het vrijkomen van energie door de splitsing van atomen",
                        "target_lang_word": "bombe atomique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombe atomique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4824d918-9b33-33c8-b219-68010d77f80b",
                                        "entry_id": "082ab9c5-7f2a-3228-84c0-7f95d05f8f65",
                                        "glosses": [
                                            "Arme nucléaire utilisant la fission nucléaire pour dégager de l’énergie sous forme de chaleur, de souffle et de rayonnements ionisants."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f161e306-3492-4b94-b6c5-6d641c28b7dd",
                                                "sense_id": "4824d918-9b33-33c8-b219-68010d77f80b",
                                                "text": "Le débat existe de savoir si les bombes atomiques lancées sur Hiroshima et Nagazaki en 1945 ont accéléré la reddition du Japon."
                                            },
                                            {
                                                "example_id": "74027819-b21d-4364-96ee-23355a07aaf6",
                                                "sense_id": "4824d918-9b33-33c8-b219-68010d77f80b",
                                                "text": "Comment aurait-il pu prévoir la fission, mais aussi la possibilité de construire des bombes atomiques ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a4190b-7573-3da7-bc89-1376b4f8fb10",
                                        "entry_id": "082ab9c5-7f2a-3228-84c0-7f95d05f8f65",
                                        "glosses": [
                                            "Arme nucléaire, sans préjuger du mode fonctionnement (fusion ou fission)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d3d2b5-e2a2-4e49-b769-03e4a414377e",
                                                "sense_id": "70a4190b-7573-3da7-bc89-1376b4f8fb10",
                                                "text": "Mon oncle un fameux bricoleur faisait en amateur\nDes bombes atomiques\nSans avoir jamais rien appris c’était un vrai génie\nQuestion travaux pratiques, […]"
                                            },
                                            {
                                                "example_id": "f141cf10-31fa-4cbf-a876-a469779dff80",
                                                "sense_id": "70a4190b-7573-3da7-bc89-1376b4f8fb10",
                                                "text": "Ce que serait la guerre avec l’emploi de la bombe atomique nous le savons. Bien que nous soyons impuissants à nous le représenter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a3bfd6-bb3f-3eb8-a63b-dd4694729033",
                                        "entry_id": "082ab9c5-7f2a-3228-84c0-7f95d05f8f65",
                                        "glosses": [
                                            "Femme très attirante."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98504ad-8f74-42f5-a908-dbee6ded66b4",
                                                "sense_id": "a6a3bfd6-bb3f-3eb8-a63b-dd4694729033",
                                                "text": "Pis faut dire qu’on avait pas le temps de mater autre chose que les bombes atomiques en bikini, dit Cédric avec un sourire coquin."
                                            },
                                            {
                                                "example_id": "ab06972d-56ba-46e7-ace6-e991499c4fbd",
                                                "sense_id": "a6a3bfd6-bb3f-3eb8-a63b-dd4694729033",
                                                "text": "Tu me présentes ta voisine ? C’est une bombe atomique !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03d5c979-9e91-44d7-a31b-bfd401819061",
                        "source_entry_id": "f7c2bd92-0ea7-377d-a4d7-4cfda5baf838",
