                    {
                        "sense_id": "60fc35ae-f0e5-3787-93d5-914b2c61e13f",
                        "entry_id": "c737824c-476a-33f6-a173-f524b006dba8",
                        "glosses": [
                            "Floc de Gascogne, vin de liqueur."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "9a6df9ac-d299-4b4f-a4a4-982112375083",
                                "sense_id": "60fc35ae-f0e5-3787-93d5-914b2c61e13f",
                                "text": "Vous connaissez sûrement l’armagnac… vous avez déjà bu du jus de raisin, alors vous connaissez parfaitement le floc de Gascogne ! Eh oui, le floc est un subtil assemblage de jus de raisin frais (pour 2/3) et d’armagnac (pour 1/3) […]"
                            }
                        ]
                    }
                ],
