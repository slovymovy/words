                "senses": [
                    {
                        "sense_id": "d5f09869-ba5a-3199-825d-3d870d866a79",
                        "entry_id": "897ae4e7-0756-394e-b51c-ee5a6ec652d0",
                        "glosses": [
                            "Gruppentanzart, bei der zahlreiche Tänzer in Reihen synchronisiert dieselben Tanzschritte ausführen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b40f8c69-08c4-434d-959f-f8bd058d0e1e",
                                "sense_id": "d5f09869-ba5a-3199-825d-3d870d866a79",
                                "text": "„Sieben Frauen und zwei Männer, Fans des Linedances, trainieren wöchentlich die aus den USA kommenden Figurentänze im Cowboy-Look, die aus verschiedenen Tanzkulturen entstanden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7ecdfbf-2ada-3349-a3a3-abe046a4d56b",
                        "entry_id": "897ae4e7-0756-394e-b51c-ee5a6ec652d0",
                        "glosses": [
                            "einzelne Choreografie der Tanzart des Linedances (in der Bedeutung [1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5514952f-66b8-49ee-92e2-54e425eed30a",
                                "sense_id": "e7ecdfbf-2ada-3349-a3a3-abe046a4d56b",
                                "text": "„Sie macht eine kleine Pause, um zu trinken, und ich erinnere mich an das Grillfest vor drei Jahren, als sie mit Otto einen Linedance anlässlich seines achtzigsten Geburtstags hingelegt hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef1e0524-e2fd-483b-b1b5-72c4775cf9c6",
                        "source_entry_id": "897ae4e7-0756-394e-b51c-ee5a6ec652d0",
                        "source_sense_id": "d5f09869-ba5a-3199-825d-3d870d866a79",
                        "source_sense_description": "synchronisierter Gruppentanz",
                        "target_lang_word": "line dance",
