                        "sense_id": "73c57376-b025-390d-a2b4-ea012d075257",
                        "entry_id": "39781159-1b8b-3210-bd09-c676240acca7",
                        "glosses": [
                            "comparative degree of бли́зкий (blízkij)"
                        ],
                        "tags": [
