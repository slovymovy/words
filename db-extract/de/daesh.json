                                        "examples": [
                                            {
                                                "example_id": "444af313-29e1-4801-a394-d27a0fab7742",
                                                "sense_id": "be4d2a29-ed2f-3d95-aefa-589b6ee36673",
                                                "text": "La ville kurde de Kobané, au nord de la Syrie, est toujours assiégée par les djihadistes de Daesh."
                                            },
                                            {
                                                "example_id": "860c9fda-3dc3-438d-beba-7caf2f1b1465",
                                                "sense_id": "be4d2a29-ed2f-3d95-aefa-589b6ee36673",
                                                "text": "Pourquoi avez-vous souhaité rattacher cette question aux phénomènes post-fascistes et à celui de Daesh ?"
                                            }
