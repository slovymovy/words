                                            {
                                                "example_id": "f3f01b4b-75d2-401f-8afb-a1e98c23ebd3",
                                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                                "text": "Hij begon ooit als verkoopmedewerker, maar is nu al jaren de CEO van deze oliefabrikant."
                                            },
                                            {
                                                "example_id": "b1f6bbfb-48ea-4ac0-9073-0ea34fd8860f",
                                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                                "text": "Over het belang van verantwoord ondernemen denken zes CEO’s van grote Nederlandse bedrijven heel verschillend, bleek in de herstart van het legendarische discussieprogramma."
                                            },
                                            {
                                                "example_id": "42de1e50-bdc8-4b59-a54e-7302ba9626e3",
                                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                                "text": "Een goede CEO pakt problemen aan en lost ze op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
