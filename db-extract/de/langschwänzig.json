                        "examples": [
                            {
                                "example_id": "20fd0995-102a-4756-88ee-c039bf62459a",
                                "sense_id": "ddd7367c-ab1e-3015-a0c0-5b753fd85a8a",
                                "text": "„Gezeigt ist ein kleines Wäldchen, vor dem ein abgestorbener Baum steht. In dessen Mitte klafft eine offene Höhlung, aus der eine Eule herausschaut. Sie gibt drei langschwänzigen Vögeln, die auf den kahlen Ästen sitzen, Anlass zu Geschrei.“"
                            }
                        ],
