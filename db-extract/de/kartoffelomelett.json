                "senses": [
                    {
                        "sense_id": "39156249-e7f5-3f4c-8676-b99468ff6408",
                        "entry_id": "bffd6aa0-8b71-35d5-bf67-54fb94dac0ac",
                        "glosses": [
                            "ein Omelett mit untergeschlagenen Kartoffelstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2964f703-fe6b-4858-b502-93977e9d4e94",
                                "sense_id": "39156249-e7f5-3f4c-8676-b99468ff6408",
                                "text": "Ich esse sehr gerne Kartoffelomelett."
                            },
                            {
                                "example_id": "e70d4159-0187-4558-a3e1-2142a094dcb5",
                                "sense_id": "39156249-e7f5-3f4c-8676-b99468ff6408",
                                "text": "„Übrigens schmeckt das Kartoffelomelett auch kalt, z. B. als Pausensnack am Arbeitsplatz oder bei einem Ausflug.“"
                            },
                            {
                                "example_id": "d86a79ee-8a85-48cf-bd42-206ac69bfcfb",
                                "sense_id": "39156249-e7f5-3f4c-8676-b99468ff6408",
                                "text": "„Wir verstehen uns prächtig, auf dem Tisch steht eine Karaffe Weißwein, aus der wir uns abwechselnd einen Strahl in den Mund gießen und eine Platte mit Kartoffelomelett.“"
                            }
                        ],
