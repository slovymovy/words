                                            "öffentliche Versorgung und Infrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7feab4-012f-4ba6-8533-b1d869494acc",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Die Wasserversorgung an diesem Orte war sehr romantisch: Man holte das Wasser weder aus einem Brunnen noch aus einer Pumpe, sondern aus einer Quelle unterhalb des Hauses, unmittelbar am Elbufer.“"
                                            },
                                            {
                                                "example_id": "f5acd181-54cc-4e17-bbc4-5898bd3409ae",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Die Sicherung der Wasserversorgung, die Bereitstellung von Trinkwasser ist in Kibera in vielen Fällen ein mafiöses Geschäft.“"
                                            },
                                            {
                                                "example_id": "e924e89d-a465-42f0-a569-1ec9eefcd323",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Zusätzliche Mauern gliederten eine Quelle in die Stadt ein und garantierten damit ihre Wasserversorgung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
