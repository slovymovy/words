                        "sense_id": "32b2df98-8ce7-364b-b350-dc9165af48d3",
                        "entry_id": "9c07f13a-992f-3e96-9745-80e336560769",
                        "glosses": [
                            "jemand, der es versteht, sich durch eigene Worte oder Taten in den Vordergrund zu spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637fbc88-52b3-4c67-87b7-6d74895cbce2",
                                "sense_id": "32b2df98-8ce7-364b-b350-dc9165af48d3",
                                "text": "Der neue Kollege wird als Selbstdarsteller nicht sehr geschätzt, obwohl er doch so nur seine Unsicherheit überspielen möchte."
                            },
                            {
                                "example_id": "a5b2d36b-9d44-42be-b852-60042e22ead9",
                                "sense_id": "32b2df98-8ce7-364b-b350-dc9165af48d3",
                                "text": "Vorgeführt werden bei ihm nur die ewigen Selbstdarsteller und Verhaltensauffälligen, die immer auftauchen, wenn irgendwo auf einer Kamera das Rotlicht leuchtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
