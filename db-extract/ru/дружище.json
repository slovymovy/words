                    }
                ],
                "translations": [
                    {
                        "translation_id": "993f8325-9771-474d-963e-3575daa3cde2",
                        "source_entry_id": "0f191ad9-67eb-3d32-9d6a-ce1296facd35",
                        "source_sense_id": "24e8d9d3-7fbe-3e61-96cc-01c4859716ef",
                        "target_lang_word": "old boy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "old boy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed4224a-4889-36c6-8170-7676ce5b2c36",
                                        "entry_id": "6f5e79eb-89e4-3f93-8dec-4ed60f59236e",
                                        "glosses": [
                                            "An alumnus, especially of a public school."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1a678f5-5217-391b-a0ef-5b0295e1a9ba",
                                        "entry_id": "6f5e79eb-89e4-3f93-8dec-4ed60f59236e",
                                        "glosses": [
                                            "A former member of a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8be49b7-4769-4a50-b27d-6ac1300ced43",
                                                "sense_id": "a1a678f5-5217-391b-a0ef-5b0295e1a9ba",
                                                "text": "Swansea named an unchanged side from their win over West Brom, and the visitors made an encouraging start, with Blues old boy Scott Sinclair prominent - Branislav Ivanovic had to make an important block to halt the winger's run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca40b6a1-270f-3e73-a98e-742ebbe64c88",
                                        "entry_id": "6f5e79eb-89e4-3f93-8dec-4ed60f59236e",
                                        "glosses": [
                                            "A man with an established network of friends who assist one another in social and business situations; a good old boy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64aaf5fc-b817-40ed-80a4-30f5bb748616",
                                                "sense_id": "ca40b6a1-270f-3e73-a98e-742ebbe64c88",
                                                "text": "The fact that they have waited to leave messages and have left hand-written evidence indicates to me that they don't believe they are going to be apprehended, that they have friends in 'higher places.' This is a small town. Everybody knows everybody. That 'ol boy' chuminess ^([sic])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f232ceff-55fa-316f-a20a-ec71aaca3e7c",
                                        "entry_id": "6f5e79eb-89e4-3f93-8dec-4ed60f59236e",
                                        "glosses": [
                                            "An elderly man."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1a4e5b-b2c6-4e2d-afb8-cc52f7fca405",
                                                "sense_id": "f232ceff-55fa-316f-a20a-ec71aaca3e7c",
                                                "text": "I got talking to an old boy in the pub, and he told me what the village used to be like in the old days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba16b37-39cb-39ee-8093-9d85a7284aa7",
                                        "entry_id": "6f5e79eb-89e4-3f93-8dec-4ed60f59236e",
                                        "glosses": [
                                            "A familiar term of address for a man of any age."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b15eb5-40ab-4153-9c74-ce5780cb2627",
                                                "sense_id": "4ba16b37-39cb-39ee-8093-9d85a7284aa7",
                                                "text": "Listen, old boy, I've got some news."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d29bf1a-4c1c-4147-b295-d5eb58475357",
                        "source_entry_id": "0f191ad9-67eb-3d32-9d6a-ce1296facd35",
                        "source_sense_id": "24e8d9d3-7fbe-3e61-96cc-01c4859716ef",
                        "target_lang_word": "old man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "old man",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d599e840-0e88-3330-b824-af8395ed79d4",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "An elderly man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "One's father."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aabf2fa-047e-4d7d-b8ac-6376ba1c518f",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "He smacked me around some. Didn't everybody's old man?"
                                            },
                                            {
                                                "example_id": "f9d55b14-77c9-4d48-9909-c54ad0781637",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "‘I use the same back-hand flip me old man useda use to knock me old lady arse-over-’ead an’ Stiffer than Mo.’"
                                            },
                                            {
                                                "example_id": "718a6eaa-60f7-44ed-9e84-1e17477e4ddc",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "See, my old man's got a problem / He lives with a bottle, that's the way it is"
                                            },
                                            {
                                                "example_id": "4327355c-f541-4638-9c32-fc06dcb99b75",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "\"How'd your in-laws feel about you marryin' your wife? Maybe you could pass the paper bag and the comb test, but your old man had dark skin, kinky hair, and he was a dyed-in-the-wool baptist from out in the sticks.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3265b1d-0392-34e6-9ccb-fa7dfbba536a",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "A husband, or male significant other, irrespective of age."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaf4eba-4cd6-490a-b007-0c986704cfa0",
                                                "sense_id": "f3265b1d-0392-34e6-9ccb-fa7dfbba536a",
                                                "text": "“[…] Now if that thing is balling—and your old lady or your old man is off somewhere flashing and doesn't want to be touched—well, you get put down on acid, you can be on a bummer for months.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7c257d-7d86-39c1-8924-66fcd9fc03d7",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "One's male employer, irrespective of age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b7e651c-9d38-3a1d-ae8d-e01137806f48",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "A unit's commanding officer, or the commander of a naval vessel, irrespective of age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Term of address for a male friend, irrespective of age."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bfb163-1335-4642-bb1c-c25ac8c2e3c6",
                                                "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                                "text": "“Don't mention it, old man,” I responded courteously."
                                            },
                                            {
                                                "example_id": "7ca2f554-8503-4b8e-a478-bc556d11379b",
                                                "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                                "text": "'Coming up, coming up, coming up,' Pop said. 'There you are, Charley, old man. Larkin Special. Don't ask what's in it. Don't stare at it. Don't think. Just drink it down. In ten minutes you'll feel perfick again.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47ec811-ca3e-3e46-b9b1-25b12da537a8",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Synonym of Old Adam."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad46cb20-7aaf-3561-94eb-135e057a3895",
