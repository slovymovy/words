                ],
                "senses": [
                    {
                        "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                        "entry_id": "f16d2961-23f8-34c7-93a0-c4726a1d0d35",
                        "glosses": [
                            "Tür, hergestellt aus Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41cef5a-7dd3-4e54-920e-9178c2eb9458",
                                "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                                "text": "Auf der Eisentür waren bereits Spuren von Rost zu sehen."
                            },
                            {
                                "example_id": "48fd5677-acd2-47d7-8ddc-f6cd2262d4cb",
                                "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                                "text": "„Vom oberen Schlossboden gelangt man an eine kupferbeschlagene Eisentür aus dem Jahr 1610, die in eine kleine quadratische Turmkammer führt.“"
                            },
                            {
                                "example_id": "2498c149-fac7-43ce-b25f-6b6c7c228523",
                                "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                                "text": "„Hinter der Eisentür einer Wagenhalle im Stadtteil Braunsfeld unterhält Ritterbach eine geheime Werkstatt.“"
                            },
                            {
                                "example_id": "25e67e0e-44a0-4db5-827c-94bf2a87d4eb",
                                "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                                "text": "„Die Eisentüre ließ sich nur von außen öffnen.“"
                            },
                            {
                                "example_id": "f5807c14-13a9-4b10-ac90-c39942846a68",
                                "sense_id": "5dfa0af1-3fc2-3410-8893-a178f5f03bdc",
                                "text": "„Die schweren Eisentüren schlossen sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
