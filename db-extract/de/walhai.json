                                "example_id": "22d0179a-4f01-40b3-82f2-a4e607fd3ff7",
                                "sense_id": "138f0505-4922-37c6-b9f3-dd12f9cb2683",
                                "text": "„Manche suchen Walhaie im Indischen Ozean, ich finde Kaninchen in Island.“"
                            }
                        ],
