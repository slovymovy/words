                ],
                "senses": [
                    {
                        "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                        "entry_id": "e7240582-7275-3be3-b253-3e9d25ff6921",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca72d200-5299-40f1-ab9c-7104301b21de",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Frau Küchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5ba48deb-bb06-4b8a-b15d-e8a2d61c0cb4",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Herr Küchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3b64efa1-1af3-4f21-8bc1-ca0b65dd9510",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Die Küchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "32597377-e8e4-40d2-96b9-16983764da73",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Der Küchle trägt nie die Pullover, die die Küchle ihm strickt."
                            },
                            {
                                "example_id": "8ce5b035-5924-47c7-8c90-1cfc7dc386a6",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Küchle kommt, geht der Herr Küchle.“"
                            },
                            {
                                "example_id": "9e215554-8836-4ccc-bb2e-8a639283ef42",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Küchle kommt und geht."
                            },
                            {
                                "example_id": "05d1476d-4f4d-41d6-a2fb-60d717390960",
                                "sense_id": "1f1830d3-fd1f-31b0-bf75-d97064f9f444",
                                "text": "Küchle kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
