                                        "glosses": [
                                            "in water voorkomende vaatloos, op een plant gelijkend organisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c1fd98-ae40-49f3-b972-f912b9db2505",
                                                "sense_id": "e196b87b-f67a-32e0-86af-e1e85a058bf6",
                                                "text": "Goldie lachte zich gek toen Pogue stug bleef doorblowen tijdens het eten en ik kreeg herhaaldelijk opmerkingen naar mijn hoofd over de kwaliteit van het slijmerige water, dat inderdaad erg vies smaakte door de groene algen."
                                            }
