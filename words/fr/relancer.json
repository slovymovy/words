{
    "word_family": [
        "relance",
        "relanceur",
        "lancement",
        "lancer",
        "lanceur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                    "sense_definition": "Reprendre contact avec une personne pour obtenir une réponse ou faire avancer une démarche en attente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans réponse de sa part après une semaine, j'ai décidé de le <w>relancer</w> poliment par courriel."
                        },
                        {
                            "text": "La secrétaire doit <w>relancer</w> les clients qui n'ont pas encore payé leur dernière facture."
                        }
                    ],
                    "common_phrases": [
                        "relancer un client",
                        "relancer par courriel"
                    ]
                },
                {
                    "sense_id": "d9ed70c5-a8f8-359b-9391-dab14f72a140",
                    "sense_definition": "Donner une nouvelle impulsion ou stimuler une activité en perte de vitesse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dynamiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a présenté un vaste plan d'investissement pour <w>relancer</w> l'économie nationale."
                        },
                        {
                            "text": "Cet article polémique a permis de <w>relancer</w> le débat sur la transition écologique."
                        }
                    ],
                    "synonyms": [
                        "accélérer",
                        "doper",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "relancer l'économie",
                        "relancer la machine",
                        "relancer le débat"
                    ]
                },
                {
                    "sense_id": "790b9c3e-3f9f-39c0-a2be-baa2c9304c6b",
                    "sense_definition": "Lancer à nouveau un objet ou renvoyer un projectile vers quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lancer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien de but a récupéré le ballon avant de le <w>relancer</w> vers ses attaquants."
                        },
                        {
                            "text": "Mon chien m'a rapporté le bâton pour que je lui <w>relance</w> aussitôt dans le jardin."
                        }
                    ],
                    "common_phrases": [
                        "relancer la balle",
                        "relancer le ballon"
                    ]
                },
                {
                    "sense_id": "a9d3a26e-83a4-3c1a-ba26-dc4d3c1edc2c",
                    "sense_definition": "Redémarrer un appareil, une application ou un système informatique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir installé la dernière mise à jour, vous devez <w>relancer</w> le logiciel pour appliquer les changements."
                        },
                        {
                            "text": "Mon téléphone ne répondait plus du tout, j'ai donc dû le <w>relancer</w> complètement."
                        }
                    ],
                    "common_phrases": [
                        "relancer l'ordinateur",
                        "relancer l'application"
                    ]
                },
                {
                    "sense_id": "c10c2daf-b3d3-38e3-ac27-ae40e84fc2fa",
                    "sense_definition": "Miser une somme plus importante que celle du joueur précédent dans un jeu de cartes ou d'argent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sûr de ses cartes, le joueur a choisi de <w>relancer</w> sans hésiter face à son adversaire."
                        },
                        {
                            "text": "Elle a préféré se coucher plutôt que de <w>relancer</w> avec une main aussi faible."
                        }
                    ],
                    "common_phrases": [
                        "relancer la mise"
                    ]
                }
            ]
        }
    ]
}