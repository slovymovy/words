                                    {
                                        "sense_id": "54c7be72-5d61-3533-94a6-3ef09be398f9",
                                        "entry_id": "1c7ce328-1f32-3877-804a-858e435f44c6",
                                        "glosses": [
                                            "Établissement scolaire accueillant les enfants de 6 à 11 ans environ et ayant pour mission l’apprentissage des notions de base en lecture, écriture et calcul et qui, avec l’école maternelle, constitue l’école primaire."
                                        ],
                                        "tags": [
                                            "France",
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82fbb3d2-aed5-4817-b392-c2b342711c01",
                                                "sense_id": "54c7be72-5d61-3533-94a6-3ef09be398f9",
                                                "text": "Laetitia Pasquet est maman de deux enfants scolarisés à l’école élémentaire Bolivar, dans le 19ᵉ arrondissement, à Paris."
                                            },
                                            {
                                                "example_id": "f40734cc-7c3f-4998-b656-8380d1023ecf",
                                                "sense_id": "54c7be72-5d61-3533-94a6-3ef09be398f9",
                                                "text": "Tous les enfants nés après la guerre entrent à l'école élémentaire dès le début des années 1950, puis au secondaire dans la seconde moitié de cette décennie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
