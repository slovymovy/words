                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ef61ed-4126-47d9-8c14-521ee23d8cf7",
                                "sense_id": "dbc7e59d-1c3d-344e-8bd1-739b124cc6c7",
                                "text": "They skeetered out and then made an elegant racing turn and skeetered directly into her."
                            },
                            {
                                "example_id": "502810c1-2f5a-4e46-853e-a5dbb663ffb6",
                                "sense_id": "dbc7e59d-1c3d-344e-8bd1-739b124cc6c7",
                                "text": "The iceman skeetered here and there, with his brown gabardine trousers dripping over his work shoes and drooping from his hip-less waist."
                            },
                            {
                                "example_id": "6f090156-2600-4f7e-81c3-ffa5053302df",
                                "sense_id": "dbc7e59d-1c3d-344e-8bd1-739b124cc6c7",
                                "text": "Bullets skeetered across the rocks, snapping off fragments in deadly shrapnel bursts, gouging furrows in the serir around the advancing men."
                            },
                            {
                                "example_id": "6731ea2d-c98a-4d3c-8c20-21399596ef2c",
                                "sense_id": "dbc7e59d-1c3d-344e-8bd1-739b124cc6c7",
                                "text": "A twilight fox skeetered across the car park."
                            }
                        ]
                    }
