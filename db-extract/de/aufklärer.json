                "senses": [
                    {
                        "sense_id": "6cd1498e-dc23-3c2a-ab94-7c7d2ea5de01",
                        "entry_id": "5d4924c9-d87c-3c95-8861-9f04380d786b",
                        "glosses": [
                            "Vertreter der Philosophie der Aufklärung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6ad674-612e-4aad-ab34-bb4a674a0621",
                                "sense_id": "6cd1498e-dc23-3c2a-ab94-7c7d2ea5de01",
                                "text": "„Für das Jiddische war im Weltbild der jüdischen Aufklärer kein Platz.“"
                            },
                            {
                                "example_id": "68b18271-41a1-4ee1-afe3-59f0f10fbcc8",
                                "sense_id": "6cd1498e-dc23-3c2a-ab94-7c7d2ea5de01",
                                "text": "„Die Philosophie der Aufklärer steht im Kampf gegen die harmonische, die gebundene Weltauffassung; aber sie greift von den Werten, die hier in Betracht kommen, nur die Religion heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0903335-8f06-38d4-86dc-969010a6b397",
                        "entry_id": "5d4924c9-d87c-3c95-8861-9f04380d786b",
                        "glosses": [
                            "Soldat mit Aufklärungsauftrag"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f1e60be1-5af4-33a9-9d33-cba98ad265b1",
                        "entry_id": "5d4924c9-d87c-3c95-8861-9f04380d786b",
                        "glosses": [
                            "Militärflugzeug mit Aufklärungsauftrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7a60c5-1557-4eac-80fc-e8bc9dc7aa26",
                                "sense_id": "f1e60be1-5af4-33a9-9d33-cba98ad265b1",
                                "text": "„Ein Aufklärer der Air Force hatte stechend scharfe Fotos gemacht.“"
                            }
                        ],
