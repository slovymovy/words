            {
                "entry_id": "8f531939-ad8f-3663-a32a-a0a68dd64306",
                "word": "leed",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                        "entry_id": "8f531939-ad8f-3663-a32a-a0a68dd64306",
                        "glosses": [
                            "verdriet en pijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76be0a51-b715-4476-9c83-99f6bc36ef0b",
                                "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                                "text": "Er is hem behoorlijk wat leed aangedaan."
                            },
                            {
                                "example_id": "9fe4afa0-8fdf-4a52-bff1-3ce6b950bb13",
                                "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                                "text": "De zwarte spore van de vernedering vermenigvuldigt zich tot het er duizenden zijn, en het leed dat onder de oppervlakte heeft gesluimerd, vindt eindelijk een stem."
                            },
                            {
                                "example_id": "4824ff72-92b8-4a44-94a4-4ffb61e9076b",
                                "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                                "text": "En dan had ik ook nog eens mijn handen vol gehad aan een moeder die het leed van mij, haar dochter, niet kon verdragen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfc029ef-91fb-4ef1-a113-5bffcd559cb5",
                        "source_entry_id": "8f531939-ad8f-3663-a32a-a0a68dd64306",
                        "source_sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                        "source_sense_description": "verdriet en pijn",
                        "target_lang_word": "Leid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb6d4d1-5b30-35ca-96e2-264ae7059556",
                                        "entry_id": "9c272082-eb4b-3190-ab44-83d7b35bb82d",
                                        "glosses": [
                                            "starker Kummer, starker psychischer oder seelischer Schmerz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e259a0-58a5-40b6-a0ee-1f8b65900866",
                                                "sense_id": "fbb6d4d1-5b30-35ca-96e2-264ae7059556",
                                                "text": "Auch kleine bewaffnete Auseinandersetzungen verursachen unbeschreiblich viel Leid."
                                            },
                                            {
                                                "example_id": "e3244273-3a10-42fa-b1f8-00c4f82d8269",
                                                "sense_id": "fbb6d4d1-5b30-35ca-96e2-264ae7059556",
                                                "text": "„Leid ist eine Krankheit, hatte Friedrich mir erklärt, das du irgendwann zurücklässt wie die Schlange ihre alte Haut, der Hirsch sein Geweih.“"
                                            },
                                            {
                                                "example_id": "36babf4b-3096-4a72-a5de-3b70dd93a969",
                                                "sense_id": "fbb6d4d1-5b30-35ca-96e2-264ae7059556",
                                                "text": "„In der Novelle Lenz ringt der Held ausdrücklich um die religiöse Sinngebung seines Leids.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "323e8029-fc92-3ef2-9102-09b56aef12c1",
                                        "entry_id": "9c272082-eb4b-3190-ab44-83d7b35bb82d",
                                        "glosses": [
                                            "zugefügtes Böses, Unrecht, Schaden, physischer Schmerz"
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d102562-eb92-4cd9-b78a-f203099b8296",
                                                "sense_id": "323e8029-fc92-3ef2-9102-09b56aef12c1",
                                                "text": "„In der Novelle Lenz ringt der Held ausdrücklich um die religiöse Sinngebung seines Leids.“"
                                            },
                                            {
                                                "example_id": "b4394454-fc32-444d-95b9-83ad9635fa7c",
                                                "sense_id": "323e8029-fc92-3ef2-9102-09b56aef12c1",
                                                "text": "„Mein Vater, mein Vater, jetzt fasst er mich an! Erlkönig hat mir ein Leids getan!“"
                                            },
                                            {
                                                "example_id": "d49a3918-9e80-43ad-abb5-bf3b6994f7e8",
                                                "sense_id": "323e8029-fc92-3ef2-9102-09b56aef12c1",
                                                "text": "„Er spricht über das Leid der Schwarzen unter dem Joch der belgischen Kolonialherren, spricht von Rassenhass, Zwangsarbeit und Verfolgungen.“"
                                            },
                                            {
                                                "example_id": "73c375aa-7574-493d-a04d-3fde29031e2b",
                                                "sense_id": "323e8029-fc92-3ef2-9102-09b56aef12c1",
                                                "text": "„Die vier Evangelisten berichten, wie Christus unter anderem Gelähmte und Blinde durch seine Anwesenheit oder durch Berührung von ihren Leiden befreit hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e70c1989-61cb-4c23-b539-c4fe23a4ecf8",
                        "source_entry_id": "8f531939-ad8f-3663-a32a-a0a68dd64306",
                        "source_sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                        "source_sense_description": "verdriet en pijn",
                        "target_lang_word": "grief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a313748-ce18-35e8-af97-ed5706214fed",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "Suffering, hardship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22f09ed7-b4a0-4546-8b7e-20e942a10e02",
                                                "sense_id": "7a313748-ce18-35e8-af97-ed5706214fed",
                                                "text": "The neighbour's teenage give me grief every time they see me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "Emotional pain, generally arising from misfortune, significant personal loss, bereavement, misconduct of oneself or others, etc.; sorrow; sadness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ed77d0-242c-4b9d-903d-baa90b273f06",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "She was worn out from so much grief."
                                            },
                                            {
                                                "example_id": "3c056609-5afd-40e0-8459-6798b5d79a12",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "The betrayal caused Jeff grief."
                                            },
                                            {
                                                "example_id": "e983f578-a358-4860-a35b-85f5a3b635c1",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "And ſure, although it was invented to eaſe his mynde of griefe, there be a number of caveats therein to forewarne other young gentlemen to foreſtand with good government their folowing yl fortunes; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "419ba808-da08-3531-97d2-34154d3ac235",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "A cause or instance of sorrow or pain; that which afflicts or distresses; a trial."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "905ff2b2-e93d-419b-b041-dd26cbce9949",
                                                "sense_id": "419ba808-da08-3531-97d2-34154d3ac235",
                                                "text": "Surely, he hath borne our griefs, and carried our sorrows."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7871ca26-721c-341f-9af5-b1e0984c8899",
                                        "entry_id": "e3657378-572b-3203-9a9d-d31eed360c9f",
                                        "glosses": [
                                            "To deliberately harass and annoy or cause grief to other players of a game in order to interfere with their enjoyment of it; especially, to do this as one’s primary activity in the game, and especially by exploiting game mechanics without using cheats to do so, often through acts of destruction or vandalism."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bb5b0ae-aa50-4cd9-bf12-0bccf0e6f45d",
                                                "sense_id": "7871ca26-721c-341f-9af5-b1e0984c8899",
                                                "text": "While ban and his pals stand squarely in this tradition, they also stand for something new: the rise of organized griefing, grounded in online message-board communities and thick with in-jokes, code words, taboos, and an increasingly articulate sense of purpose. No longer just an isolated pathology, griefing has developed a full-fledged culture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
