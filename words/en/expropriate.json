{
    "word_family": [
        "expropriation",
        "expropriator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f259830-576f-38be-b0e0-99e83ac7a90b",
                    "sense_definition": "To take private property away from someone, usually for public use by the government.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "property_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>expropriate</w> the land to build a new highway."
                        },
                        {
                            "text": "Local authorities may <w>expropriate</w> buildings that are considered unsafe for the public."
                        }
                    ],
                    "synonyms": [
                        "confiscate",
                        "seize"
                    ],
                    "common_phrases": [
                        "expropriate land",
                        "expropriate assets"
                    ]
                },
                {
                    "sense_id": "b2442f4a-2a42-3965-a2eb-90cadc4c6518",
                    "sense_definition": "To voluntarily give up one's own rights or claims to property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "property_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk chose to <w>expropriate</w> his worldly possessions to live a life of poverty."
                        },
                        {
                            "text": "He felt a spiritual need to <w>expropriate</w> his ego and personal desires."
                        }
                    ],
                    "synonyms": [
                        "relinquish",
                        "renounce"
                    ]
                }
            ]
        }
    ]
}