                                        "entry_id": "e621b005-d9fe-3e0b-9d67-e7ebe431dbad",
                                        "glosses": [
                                            "Bauteil aus bestimmten Halbleitern, das die Energie der Sonnenstrahlen in elektrische Energie umwandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29618e8-05c8-49b6-96c7-c67b19390b9a",
                                                "sense_id": "ea2ec105-f384-3cfc-9543-5589547f26ab",
                                                "text": "Autos mit Solarzellen gibt es schon im Testbetrieb."
                                            },
                                            {
                                                "example_id": "5286b0e5-90be-41fb-9f95-55b3e3393659",
                                                "sense_id": "ea2ec105-f384-3cfc-9543-5589547f26ab",
                                                "text": "„Deutsche Wissenschafter haben die weltweit erste transparente photovoltaische Zelle präsentiert – eine Solarzelle, die zahlreiche neue Möglichkeiten birgt.“"
                                            },
                                            {
                                                "example_id": "074ba22f-ed98-4c31-a4d1-40a6bd1d5475",
                                                "sense_id": "ea2ec105-f384-3cfc-9543-5589547f26ab",
                                                "text": "„Die bislang dünnste Solarzelle ist nur 1,3 Mikrometer hoch, ein Fünfzigstel des Durchmessers von menschlichem Haar.“"
                                            },
                                            {
                                                "example_id": "0d18e994-87b4-460b-9984-a0510c6215e4",
                                                "sense_id": "ea2ec105-f384-3cfc-9543-5589547f26ab",
                                                "text": "„Solarzellen sind eine faszinierende Technik. Kein Lärm, keine Abgase, nicht einmal bewegliche Teile, die verschleißen können und gewartet werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
