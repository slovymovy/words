                    "frequency": "High",
                    "semantic_group_id": "richesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune entrepreneur a fait <w>fortune</w> après avoir vendu son entreprise technologique."
                        },
                        {
                            "text": "Cette magnifique maison au bord du lac a dû coûter une véritable <w>fortune</w>."
                        }
                    ],
                    "synonyms": [
                        "richesse",
                        "patrimoine"
                    ],
                    "antonyms": [
                        "pauvreté",
                        "misère"
                    ],
                    "common_phrases": [
