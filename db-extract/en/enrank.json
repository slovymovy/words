                "senses": [
                    {
                        "sense_id": "b34c4a84-90c5-3e82-b851-aba593f352d7",
                        "entry_id": "bba6787c-2a1c-3300-9688-1c4c8bce6de5",
                        "glosses": [
                            "To place in ranks or in order."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9d772983-a6c6-4b52-991d-fa7cd8f7454a",
                                "sense_id": "b34c4a84-90c5-3e82-b851-aba593f352d7",
                                "text": "No leisure had he to enrank his men;\nHe wanted pikes to set before his archers;\nInstead whereof sharp stakes pluck’d out of hedges\nThey pitched in the ground confusedly,\nTo keep the horsemen off from breaking in."
                            },
                            {
                                "example_id": "d669f6c1-bd6a-4ef5-832c-2a4116014711",
                                "sense_id": "b34c4a84-90c5-3e82-b851-aba593f352d7",
                                "text": "The souldiers all sat downe enrank’t, each by his armes and horse,\nThat then lay downe, and cool’d their hoofes."
                            },
                            {
                                "example_id": "04732a32-eb5f-4705-9dfa-04794f94ebc4",
                                "sense_id": "b34c4a84-90c5-3e82-b851-aba593f352d7",
                                "text": "1624, William Camden, The Historie of the Life and Death of Mary Stuart Queene of Scotland, London: Richard Whitaker, Anno 1568, p. 46,\nWhen I had againe forgiuen them, behold, they laid vpon me a new crime, which themselues had wrought, and signed with their owne hands; and shortly after were enranked in battell against me in the field […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "94317e46-1777-3cce-bf25-a1ef0de2436a",
                        "entry_id": "bba6787c-2a1c-3300-9688-1c4c8bce6de5",
                        "glosses": [
                            "To classify (someone in a particular group); to enroll, register."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5e196db5-04ed-4f27-9d25-468849583982",
                                "sense_id": "94317e46-1777-3cce-bf25-a1ef0de2436a",
                                "text": "[…] thy Lord or Maister enranks thee with the deceaved sort, and so forgets thee!"
                            },
                            {
                                "example_id": "463af073-00cb-43d9-bfe6-c36e449766cd",
                                "sense_id": "94317e46-1777-3cce-bf25-a1ef0de2436a",
                                "text": "[…] hee begat the sonne who is enranked in this genealogicall rolle."
                            },
                            {
                                "example_id": "1c102875-e3dd-40a9-a61c-468974e862a9",
                                "sense_id": "94317e46-1777-3cce-bf25-a1ef0de2436a",
                                "text": "1630, William Vaughan, The Arraignment of Slander Perjury Blasphemy, and other Malicious Sinnes, London: Francis Constable, Lineament 16, p. 174,\nCourteous countrey-men, vnderstanding spirits, whose hap it is to be enrankt into impanelles […]"
                            }
                        ]
                    }
