                "senses": [
                    {
                        "sense_id": "001663da-6e8e-31e8-83e1-486e68901bcd",
                        "entry_id": "33327b16-baaa-31ea-8416-0cf26490fef1",
                        "glosses": [
                            "освободиться, избавиться от чего-либо дурного, нежелательного; искоренить, устранить"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5971fad8-56c2-4a1a-8ee9-81bf910b5137",
                        "source_entry_id": "33327b16-baaa-31ea-8416-0cf26490fef1",
                        "source_sense_id": "001663da-6e8e-31e8-83e1-486e68901bcd",
                        "target_lang_word": "éliminer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éliminer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                                        "entry_id": "4acfaaaa-2c60-3537-8e18-ff20b18193e6",
                                        "glosses": [
                                            "Mettre dehors ; écarter ; ôter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafc29c5-2203-4d74-9afd-6b49901d4807",
                                                "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                                                "text": "Par ailleurs des pièges sélectifs sont nécessaires afin d’éliminer les interférents tels que les hydrocarbures ou différents composés soufrés (H2S, mercaptans et sulfures organiques)."
                                            },
                                            {
                                                "example_id": "5cfa9726-8fc4-4595-a3b8-bc1ba90ca75f",
                                                "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                                                "text": "Les raisins vendangés vont d'abord subir l’égrappage (ou éraflage) qui consiste à égrener les grappes, de façon aujourd'hui mécanique, afin d’éliminer la rafle qui contient des tannins astringents et râpeux souvent indésirables."
                                            },
                                            {
                                                "example_id": "ed36995c-1993-405e-b525-455bc81708a1",
                                                "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                                                "text": "À la suite de la dissolution simple ou extractive, la filtration permet de purifier les solutions en éliminant toutes les particules solides."
                                            },
                                            {
                                                "example_id": "d9aa132e-4d14-4a84-81d0-9d42dddeef22",
                                                "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                                                "text": "L’inspection ante-mortem peut améliorer l’efficacité de l’opération en éliminant un certain nombre d’animaux qui seraient impropres à la consommation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd4fd00-207d-305a-a1cb-12e67f3b2264",
                                        "entry_id": "4acfaaaa-2c60-3537-8e18-ff20b18193e6",
                                        "glosses": [
                                            "Expulser les déchets, en parlant du travail de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d484eaff-511e-42ad-be08-c4ff92564e0c",
                                                "sense_id": "4dd4fd00-207d-305a-a1cb-12e67f3b2264",
                                                "text": "La peau et le rein sont les organes qui éliminent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7338fd-1cbb-3dae-b82c-92e7010b5df1",
                                        "entry_id": "4acfaaaa-2c60-3537-8e18-ff20b18193e6",
                                        "glosses": [
                                            "Retrancher, ôter de."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0dc7a67-54c3-485d-bd4f-2f4d5ec3e148",
                                                "sense_id": "9b7338fd-1cbb-3dae-b82c-92e7010b5df1",
                                                "text": "On a éliminé plusieurs noms de la liste des candidats."
                                            },
                                            {
                                                "example_id": "f6d8e223-f86d-4314-91cc-53ebdaaa12fe",
                                                "sense_id": "9b7338fd-1cbb-3dae-b82c-92e7010b5df1",
                                                "text": "Il n’a pas été reçu à cet examen, il a été éliminé dès les épreuves écrites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ecb6c79-7f77-3690-afab-63b0b0281cb6",
                                        "entry_id": "4acfaaaa-2c60-3537-8e18-ff20b18193e6",
                                        "glosses": [
                                            "assassiner."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3190852-59a8-465c-aa47-5ec82b8eb20c",
                                                "sense_id": "8ecb6c79-7f77-3690-afab-63b0b0281cb6",
                                                "text": "Israël a immédiatement promis d'éliminer Yahya Sinouar, qui remplace le chef politique du Hamas Ismaïl Haniyeh, assassiné le 31 juillet à Téhéran"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0369292c-63fb-3aba-83e1-cd69e81e6c0c",
                                        "entry_id": "4acfaaaa-2c60-3537-8e18-ff20b18193e6",
                                        "glosses": [
                                            "Se dit d’une variable dans un système d'inconnues, dont on souhaite effectuer l’élimination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
