{
    "word_family": [
        "flare"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ae89d28-dae0-3d06-9532-df9e8cdff171",
                    "sense_definition": "Having a tendency to spread outward or burn with a sudden, bright, or unsteady light.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spreading_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flaring</w> sun made it difficult to see the path ahead during our afternoon hike.",
                            "target_lang_translations": {
                                "zh": "午后徒步时，<w>闪耀的</w>太阳让我们很难看清前方的路。"
                            }
                        },
                        {
                            "text": "They built a large <w>flaring</w> fire that illuminated the entire campsite.",
                            "target_lang_translations": {
                                "zh": "他们生了一堆<w>熊熊燃烧的</w>大火，照亮了整个营地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blazing",
                        "glaring"
                    ],
                    "common_phrases": [
                        "flaring fire",
                        "flaring sun"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体向外张开，或指光线突然变得明亮且不稳定。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪耀的",
                                "target_lang_sense_clarification": "形容光线突然明亮或闪烁。"
                            },
                            {
                                "target_lang_word": "张开的",
                                "target_lang_sense_clarification": "形容物体向外扩散或张开的形状。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9df7a4d-2729-36cb-bb4a-6ebd04184adb",
                    "sense_definition": "The industrial practice of burning off excess natural gas during oil extraction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "industrial_burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Environmental regulations are becoming stricter regarding the <w>flaring</w> of methane at oil sites.",
                            "target_lang_translations": {
                                "zh": "关于石油开采点甲烷<w>火炬放空</w>的环保法规正变得越来越严格。"
                            }
                        },
                        {
                            "text": "The company reduced its carbon footprint by minimizing gas <w>flaring</w> at the refinery.",
                            "target_lang_translations": {
                                "zh": "该公司通过减少炼油厂的天然气<w>燃烧</w>来降低碳足迹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gas flaring"
                    ],
                    "target_lang_definitions": {
                        "zh": "工业上指在石油开采过程中燃烧掉多余天然气的做法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火炬放空",
                                "target_lang_sense_clarification": "石油工业术语，指燃烧多余气体。"
                            },
                            {
                                "target_lang_word": "燃烧",
                                "target_lang_sense_clarification": "指工业废气处理中的燃烧过程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2e8ff3-9b36-381b-a79d-b688dc521560",
                    "sense_definition": "The act or instance of something suddenly bursting into light or spreading outward.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spreading_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>flarings</w> of the candle in the drafty room startled the guests.",
                            "target_lang_translations": {
                                "zh": "通风房间里蜡烛的突然<w>闪烁</w>吓了客人们一跳。"
                            }
                        },
                        {
                            "text": "Observers noted several <w>flarings</w> of light across the night sky.",
                            "target_lang_translations": {
                                "zh": "观测者注意到夜空中出现了几次光线的<w>爆发</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指某物突然发出光亮或向外扩散的动作或瞬间。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指光线突然闪现。"
                            },
                            {
                                "target_lang_word": "爆发",
                                "target_lang_sense_clarification": "指光亮或能量的突然迸发。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f21854bd-ec74-36bb-a506-b9f04bf2324f",
                    "sense_definition": "Present participle and gerund of <w>flare</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nostrils of the horse were <w>flaring</w> as it ran across the field.",
                            "target_lang_translations": {
                                "zh": "马儿跑过田野时，鼻孔在<w>张开</w>。"
                            }
                        },
                        {
                            "text": "Tensions were <w>flaring</w> between the two groups during the heated debate.",
                            "target_lang_translations": {
                                "zh": "在激烈的辩论中，两组人之间的紧张情绪正在<w>爆发</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flaring up"
                    ],
                    "target_lang_definitions": {
                        "zh": "指突然燃烧、张开，或情绪突然爆发。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "张开",
                                "target_lang_sense_clarification": "指鼻孔等部位向外扩张。"
                            },
                            {
                                "target_lang_word": "爆发",
                                "target_lang_sense_clarification": "指冲突或情绪突然加剧。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}