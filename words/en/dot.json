    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b817a6b-6117-3ae6-b8ed-cc7925c6ad61",
                    "sense_definition": "A small, round spot or mark.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a white dress with a black <w>dot</w> pattern.",
                            "target_lang_translations": {
                                "ru": "Она была в белом платье в черный <w>горошек</w>.",
                                "zh": "她穿了一件带有黑色<w>圆点</w>图案的白色连衣裙。"
                            }
                        },
                        {
                            "text": "From the airplane, the cars looked like a tiny <w>dot</w> on the road.",
                            "target_lang_translations": {
                                "ru": "С самолета машины казались крошечной <w>точкой</w> на дороге.",
                                "zh": "从飞机上看，路上的汽车看起来就像一个小<w>点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spot",
                        "speck",
                        "fleck",
                        "point"
                    ],
                    "common_phrases": [
                        "polka dot",
                        "blue dot",
                        "small dot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькое круглое пятно или отметка.",
                        "zh": "小的圆形斑点或标记。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "пятнышко"
                            },
                            {
                                "target_lang_word": "горошек",
                                "target_lang_sense_clarification": "узор на ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点",
                                "target_lang_sense_clarification": "小圆点"
                            },
                            {
                                "target_lang_word": "圆点",
                                "target_lang_sense_clarification": "布料上的花纹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86e49f35-be7e-38c9-801c-bced542cef80",
                    "sense_definition": "A punctuation mark used to indicate the end of a sentence; a full stop or period.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should put a <w>dot</w> at the end of every sentence.",
                            "target_lang_translations": {
                                "ru": "В конце каждого предложения нужно ставить <w>точку</w>.",
                                "zh": "你应该在每个句子的末尾加上一个<w>句号</w>。"
                            }
                        },
                        {
                            "text": "The website address ends with <w>dot</w> com.",
                            "target_lang_translations": {
                                "ru": "Адрес веб-сайта заканчивается на <w>точка</w> ком.",
                                "zh": "网站地址以<w>点</w>com结尾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "full stop",
                        "period",
                        "point"
                    ],
                    "common_phrases": [
                        "dot com"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак препинания, используемый для обозначения конца предложения.",
                        "zh": "用于表示句子结束的标点符号；句号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "句号",
                                "target_lang_sense_clarification": "标点符号"
                            },
                            {
                                "target_lang_word": "点",
                                "target_lang_sense_clarification": "用于网址或口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98274c6e-9d7e-3430-882d-a1d8f68e9dfd",
                    "sense_definition": "A symbol used to separate the whole part of a number from the fraction, or to indicate multiplication.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the number 3.5, the <w>dot</w> separates the three from the five.",
                            "target_lang_translations": {
                                "ru": "В числе 3.5 <w>точка</w> отделяет тройку от пятерки.",
                                "zh": "在数字3.5中，<w>小数点</w>将3和5隔开。"
                            }
                        },
                        {
                            "text": "Please check the position of the decimal <w>dot</w> in your calculation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте положение десятичной <w>точки</w> в ваших вычислениях.",
                                "zh": "请检查你计算中<w>小数点</w>的位置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decimal point",
                        "point"
                    ],
                    "common_phrases": [
                        "decimal dot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ, используемый для отделения целой части числа от дробной или для обозначения умножения.",
                        "zh": "用于分隔整数部分和小数部分的符号，或表示乘法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "математический символ"
                            },
                            {
                                "target_lang_word": "запятая",
                                "target_lang_sense_clarification": "десятичный разделитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小数点",
                                "target_lang_sense_clarification": "数学符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad87061-12ee-37c4-ac80-80820914ec4e",
                    "sense_definition": "One of the two symbols used in Morse code, representing a short signal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distress signal SOS consists of three dots, three dashes, and three <w>dots</w>.",
                            "target_lang_translations": {
                                "ru": "Сигнал бедствия SOS состоит из трех точек, трех тире и трех <w>точек</w>.",
                                "zh": "求救信号SOS由三个<w>点</w>、三个横线和三个点组成。"
                            }
                        },
                        {
                            "text": "He tapped out a <w>dot</w> on the telegraph machine.",
                            "target_lang_translations": {
                                "ru": "Он отстучал <w>точку</w> на телеграфном аппарате.",
                                "zh": "他在电报机上敲出了一个<w>点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двух символов азбуки Морзе, обозначающий короткий сигнал.",
                        "zh": "摩尔斯电码中表示短信号的符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "азбука Морзе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点",
                                "target_lang_sense_clarification": "摩尔斯电码"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bae0ca6c-fdb3-351d-8713-bc0496ded6d1",
                    "sense_definition": "A symbol placed after a musical note to increase its duration by half.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer added a <w>dot</w> to the quarter note to change the rhythm.",
                            "target_lang_translations": {
                                "ru": "Композитор добавил <w>точку</w> к четвертной ноте, чтобы изменить ритм.",
                                "zh": "作曲家在四分音符后加了一个<w>附点</w>以改变节奏。"
                            }
                        },
                        {
                            "text": "You must hold the note longer because there is a <w>dot</w> after it.",
                            "target_lang_translations": {
                                "ru": "Вы должны держать ноту дольше, потому что после нее стоит <w>точка</w>.",
                                "zh": "你必须把这个音符拉长，因为它后面有一个<w>附点</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ, помещаемый после музыкальной ноты для увеличения ее длительности наполовину.",
                        "zh": "置于音符后，将其时值延长一半的符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "музыка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附点",
                                "target_lang_sense_clarification": "音乐术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aabe98b-b125-3f59-a05a-5254d10158c6",
                    "sense_definition": "A delivery in cricket from which no runs are scored.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowler bowled three <w>dots</w> in a row to build pressure on the batsman.",
                            "target_lang_translations": {
                                "ru": "Боулер сделал три <w>пустые подачи</w> подряд, чтобы усилить давление на бэтсмена.",
                                "zh": "投球手连续投出了三个<w>零分球</w>，给击球手施加了压力。"
                            }
                        },
                        {
                            "text": "It was a crucial <w>dot</w> ball that stopped the other team from winning.",
                            "target_lang_translations": {
                                "ru": "Это был решающий <w>мяч без пробежек</w>, который помешал другой команде победить.",
                                "zh": "这是一个关键的<w>零分球</w>，阻止了对方球队获胜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dot ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "cricket"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подача в крикете, с которой не набираются очки.",
                        "zh": "板球中未得分的投球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустая подача",
                                "target_lang_sense_clarification": "крикет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "零分球",
                                "target_lang_sense_clarification": "板球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d09d651-78ac-3649-aba4-140e45d6e845",
                    "sense_definition": "A weapon or ability in gaming that deals damage over time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard cast a powerful <w>dot</w> on the boss to slowly drain its health.",
                            "target_lang_translations": {
                                "ru": "Волшебник наложил мощный <w>дот</w> на босса, чтобы медленно вытягивать его здоровье.",
                                "zh": "巫师对BOSS施加了一个强大的<w>持续伤害</w>技能，以缓慢消耗其生命值。"
                            }
                        },
                        {
                            "text": "You should apply a <w>dot</w> and then run away while the enemy takes damage.",
                            "target_lang_translations": {
                                "ru": "Тебе следует повесить <w>дот</w> и убегать, пока враг получает урон.",
                                "zh": "你应该先施加一个<w>持续伤害</w>，然后在敌人掉血时跑开。"
                            }
                        }
                    ],
                    "antonyms": [
                        "HOT"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оружие или способность в играх, наносящие урон с течением времени.",
                        "zh": "游戏中随时间推移造成持续伤害的技能或效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дот",
                                "target_lang_sense_clarification": "сленг, периодический урон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "持续伤害",
                                "target_lang_sense_clarification": "游戏术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d969919-8f52-35da-9052-38c9b90527b5",
                    "sense_definition": "A shotgun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang member was arrested for hiding a <w>dot</w> in his apartment.",
                            "target_lang_translations": {
                                "ru": "Члена банды арестовали за то, что он прятал <w>дробовик</w> в своей квартире.",
                                "zh": "该帮派成员因在公寓里藏匿一把<w>霰弹枪</w>而被捕。"
                            }
                        },
                        {
                            "text": "Police seized several weapons, including a rusty <w>dot</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция изъяла несколько единиц оружия, включая ржавый <w>дробовик</w>.",
                                "zh": "警方查获了几件武器，其中包括一把生锈的<w>霰弹枪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shotty",
                        "scattergun"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "MLE"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дробовик.",
                        "zh": "霰弹枪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробовик",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霰弹枪",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34d2ba57-e5f2-387a-be3a-b67ca037fe89",
                    "sense_definition": "A dowry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride brought a substantial <w>dot</w> to the marriage.",
                            "target_lang_translations": {
                                "ru": "Невеста принесла в брак значительное <w>приданое</w>.",
                                "zh": "新娘带了丰厚的<w>嫁妆</w>出嫁。"
                            }
                        },
                        {
                            "text": "Her father saved money for years to provide a suitable <w>dot</w>.",
                            "target_lang_translations": {
                                "ru": "Ее отец годами копил деньги, чтобы обеспечить достойное <w>приданое</w>.",
                                "zh": "她父亲攒了多年的钱，为她准备了一份体面的<w>嫁妆</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приданое.",
                        "zh": "嫁妆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приданое",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫁妆",
                                "target_lang_sense_clarification": "古语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2893b28f-2b16-3c42-9c06-621fde7031b6",
                    "sense_definition": "To cover or mark a surface with small spots.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mark_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter used a brush to <w>dot</w> the canvas with red paint.",
                            "target_lang_translations": {
                                "ru": "Художник использовал кисть, чтобы <w>покрыть точками</w> красной краски холст.",
                                "zh": "画家用画笔在画布上<w>点缀</w>了红色的颜料。"
                            }
                        },
                        {
                            "text": "Small islands <w>dot</w> the blue ocean.",
                            "target_lang_translations": {
                                "ru": "Маленькие острова <w>усеивают</w> синий океан.",
                                "zh": "蓝色的大海上<w>散布</w>着小岛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stipple",
                        "speckle",
                        "spot",
                        "scatter",
                        "sprinkle"
                    ],
                    "common_phrases": [
                        "dot with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или отмечать поверхность маленькими пятнами.",
                        "zh": "在表面覆盖或标记小点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "покрывать множеством точек"
                            },
                            {
                                "target_lang_word": "покрывать точками",
                                "target_lang_sense_clarification": "ставить точки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "覆盖小点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "591ab6d4-cede-3538-9f5f-b983d202878e",
                    "sense_definition": "To be spread across an area in many different places.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mark_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tiny cottages <w>dot</w> the green landscape.",
                            "target_lang_translations": {
                                "ru": "Крошечные коттеджи <w>усеивают</w> зеленый пейзаж.",
                                "zh": "绿色的风景中<w>散布</w>着小木屋。"
                            }
                        },
                        {
                            "text": "Sheep <w>dot</w> the hillsides in this part of the country.",
                            "target_lang_translations": {
                                "ru": "Овцы <w>виднеются точками</w> на склонах в этой части страны.",
                                "zh": "在这个国家的这个地区，山坡上<w>散布</w>着羊群。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkle",
                        "scatter"
                    ],
                    "common_phrases": [
                        "dotted around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть разбросанным по территории во многих местах.",
                        "zh": "散布在某区域的许多不同地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "быть разбросанным"
                            },
                            {
                                "target_lang_word": "виднеться точками",
                                "target_lang_sense_clarification": "о предметах вдалеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "分布在各处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "742213aa-1317-3a9f-bafa-5a64875afb2f",
                    "sense_definition": "To add a dot or small mark to something, especially in writing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "write",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you <w>dot</w> your i's and cross your t's.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы <w>расставили точки</w> над i и перечеркнули t.",
                                "zh": "确保你在写i时<w>点</w>上点，写t时画上横。"
                            }
                        },
                        {
                            "text": "She carefully <w>dotted</w> the paper with ink.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>поставила точку</w> чернилами на бумаге.",
                                "zh": "她小心翼翼地用墨水在纸上<w>点</w>了点。"
                            }
                        }
                    ],
                    "common_phrases": [
