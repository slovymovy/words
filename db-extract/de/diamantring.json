                "senses": [
                    {
                        "sense_id": "701631b3-6e8a-3e5b-b0fa-93393656b323",
                        "entry_id": "8e51a299-5b25-3d51-affb-29a35bc008ab",
                        "glosses": [
                            "Fingerring, der mit einem oder mehreren Diamanten besetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21f1233-37b3-4320-9019-ca4f04eddb6f",
                                "sense_id": "701631b3-6e8a-3e5b-b0fa-93393656b323",
                                "text": "„Die Pensionistin hatte gegen 15.15 Uhr das Damen-WC aufgesucht und dabei den Diamantring am Waschbeckenrand abgelegt.“"
                            },
                            {
                                "example_id": "6b1a7f28-e7dd-4ef5-9331-879f13c2f93c",
                                "sense_id": "701631b3-6e8a-3e5b-b0fa-93393656b323",
                                "text": "„Wenn ich ein klassisches Stück trug, und war es auch der feinste Diamantring, fühlte ich mich alt.“"
                            },
                            {
                                "example_id": "7146442b-8c6c-4dee-ac47-c4dcca64d376",
                                "sense_id": "701631b3-6e8a-3e5b-b0fa-93393656b323",
                                "text": "„Bei Sotheby's in London wird am 7. Juni ein wertvoller Diamantring versteigert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b56def8-b99b-4b60-be3c-a94dd8d2a698",
                        "source_entry_id": "8e51a299-5b25-3d51-affb-29a35bc008ab",
                        "source_sense_id": "701631b3-6e8a-3e5b-b0fa-93393656b323",
                        "source_sense_description": "Fingerring, der mit einem oder mehreren Diamanten besetzt ist",
                        "target_lang_word": "diamond ring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diamond ring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96cf5772-a8d0-3364-8b21-1c6f283f39b6",
                                        "entry_id": "211858d6-f9e5-360f-bd6a-61fb9416e48a",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see diamond, ring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952c71d6-f414-4613-b58a-c4005b097d01",
                                                "sense_id": "96cf5772-a8d0-3364-8b21-1c6f283f39b6",
                                                "text": "If that mocking bird don’t^([sic]) sing // Daddy’s going to buy me a diamond ring. // If that diamond ring don’t^([sic]) shine // Daddy’s going to buy me a bottle of wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a86986d-c1d9-3fab-8746-757877c3b368",
                                        "entry_id": "211858d6-f9e5-360f-bd6a-61fb9416e48a",
                                        "glosses": [
                                            "By extension, an engagement ring, usually one given by a man to a woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04864379-267f-4483-b8ab-df1c3af1a0c6",
                                                "sense_id": "0a86986d-c1d9-3fab-8746-757877c3b368",
                                                "text": "If it were not a tradition that a woman shall accept from her fiance a diamond ring which the idiot cannot, in all probability, afford to give her — well, women would not accept them."
                                            },
                                            {
                                                "example_id": "53b29a7e-7edd-4267-af57-ceb730c860bc",
                                                "sense_id": "0a86986d-c1d9-3fab-8746-757877c3b368",
                                                "text": "“Delvin, a diamond ring means you are engaged to be married. I barely know you.”"
                                            },
                                            {
                                                "example_id": "433da695-85ec-4f82-96ad-230349daeeb3",
                                                "sense_id": "0a86986d-c1d9-3fab-8746-757877c3b368",
                                                "text": "He frowned slightly, whether at the loss of a potential sale or the unnaturalness of a single woman standing beside a handsome man and not lusting after a diamond ring I couldn't be sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70811272-bed1-32e7-84db-0687e3a2f1cb",
                                        "entry_id": "211858d6-f9e5-360f-bd6a-61fb9416e48a",
                                        "glosses": [
                                            "An optical phenomenon visible during a moment of a solar eclipse when only a tiny part of the sun is not obscured by the moon, shining like a diamond in the ring of the sun’s corona."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
