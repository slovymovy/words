                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e560154-99e3-4fa3-8d53-df16d10732ec",
                                                "sense_id": "db465771-a5d7-3820-bd5b-9cdac7b2bd91",
                                                "text": "„Die beiden Mikrobiologinnen untersuchten die Rolle von Feuchtigkeit, Temperatur und UV-Strahlung bei der Übertragung von Infektionskrankheiten.“"
