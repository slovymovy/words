                "senses": [
                    {
                        "sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
                        "entry_id": "1b14a9ec-e740-39ab-bc27-f19a47bf8897",
                        "glosses": [
                            "A Muslim schoolmaster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2259d942-6773-48d3-940c-0507f9c0384a",
                                "sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
                                "text": "1916, unnamed narrator, quoted in 2008, Viscount Bryce (editor), The Treatment of Armenians in the Ottoman Empire: Documents Presented to Viscount Grey of Fallodon, Secretary of State for Foreign Affairs, by Viscount Bryce, page 315,\nThe next night I heard two hodjas talking, under my window, of a terrible massacre of the Armenians that had just taken place in the mountains; they seemed to be very sorry about it and spoke of it with horror; they did not know, of course, that I was listening."
                            },
                            {
                                "example_id": "89beebfe-8d87-4d3a-b1ae-10df47bfb888",
                                "sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
                                "text": "A young boy chanted the Koran while our hodja sat by the low table swaying himself to its rhythm."
                            },
                            {
                                "example_id": "84dc66e4-e171-4027-b8e5-491bb9ade443",
                                "sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
                                "text": "\"I hate all priests, rabbis, and hodjas,\" he once told me — hodja being the nearest equivalent the Mohammedans have for a minister of religion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0da469ca-25e1-4a41-a756-7982aad2fe3e",
                        "source_entry_id": "1b14a9ec-e740-39ab-bc27-f19a47bf8897",
                        "source_sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
                        "source_sense_description": "a Muslim schoolmaster",
