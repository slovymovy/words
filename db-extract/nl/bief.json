                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01185675-895b-4891-a366-c29f8b811ccf",
                                                "sense_id": "a9e0b56b-f46c-363d-8b8c-02d11aca1c03",
                                                "text": "The beef of his paper was a long rant about government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2c0eaa-8eae-3739-a1b3-9ee6060839a0",
                                        "entry_id": "402a129e-d01a-37a2-a27e-209621e32625",
