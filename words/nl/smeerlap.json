                                "target_lang_sense_clarification": "informal, often affectionate term for a dirty child"
                            },
                            {
                                "target_lang_word": "slob",
                                "target_lang_sense_clarification": "a lazy and untidy person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3440525-ea77-3af7-b103-7d69fd601afd",
                    "sense_definition": "Een man met onsmakelijke of grensoverschrijdende seksuele bedoelingen of voorkeuren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pervers_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze waarschuwde haar vriendinnen voor die <w>smeerlap</w> die altijd nare opmerkingen maakte.",
                            "target_lang_translations": {
                                "en": "She warned her friends about that <w>creep</w> who always made nasty remarks."
                            }
                        },
                        {
                            "text": "De politie hield de <w>smeerlap</w> aan die vrouwen lastigviel in het park.",
                            "target_lang_translations": {
                                "en": "The police arrested the <w>pervert</w> who was harassing women in the park."
                            }
                        }
                    ],
                    "synonyms": [
