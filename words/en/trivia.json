{
    "word_family": [
        "trivial",
        "triviality",
        "trivialize",
        "trivially",
        "trivium"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d11933d5-0423-3d41-93fd-5c60e4d69ea9",
                    "sense_definition": "Insignificant details or pieces of information that are of little importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unimportant_information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our military leaders simply do not have time for such <w>trivia</w> during a national crisis.",
                            "target_lang_translations": {
                                "ru": "У нашего военного руководства просто нет времени на подобные <w>мелочи</w> во время национального кризиса."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon discussing useless <w>trivia</w> instead of finishing his report.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, обсуждая бесполезные <w>пустяки</w> вместо того, чтобы закончить свой отчет."
                            }
                        }
                    ],
                    "synonyms": [
                        "trifles",
                        "minutiae",
                        "details"
                    ],
                    "antonyms": [
                        "essentials",
                        "fundamentals"
                    ],
                    "common_phrases": [
                        "useless trivia",
                        "mere trivia",
                        "unimportant trivia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительные детали или сведения, имеющие мало значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелочи",
                                "target_lang_sense_clarification": "незначительные детали"
                            },
                            {
                                "target_lang_word": "пустяки",
                                "target_lang_sense_clarification": "неважные вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc44d5ba-1801-3092-a080-ba1f9272dbf5",
                    "sense_definition": "A quiz or game that involves answering questions about obscure or interesting facts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quiz_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We go to the local pub every Tuesday for their weekly <w>trivia</w> night.",
                            "target_lang_translations": {
                                "ru": "Каждый вторник мы ходим в местный паб на еженедельную <w>викторину</w>."
                            }
                        },
                        {
                            "text": "I joined the <w>trivia</w> club this semester to test my knowledge of history and movies.",
                            "target_lang_translations": {
                                "ru": "В этом семестре я вступил в клуб <w>знатоков</w>, чтобы проверить свои знания в истории и кино."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiz"
                    ],
                    "common_phrases": [
                        "trivia night",
                        "trivia game",
                        "trivia question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Викторина или игра, в которой нужно отвечать на вопросы о малоизвестных или интересных фактах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "викторина",
                                "target_lang_sense_clarification": "игра с вопросами и ответами"
                            },
                            {
                                "target_lang_word": "тривия",
                                "target_lang_sense_clarification": "интеллектуальная игра на знание фактов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53543f74-21ed-3ab2-bbae-00c80629d815",
                    "sense_definition": "The plural form of <w>trivium</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval universities, the <w>trivia</w> consisted of grammar, rhetoric, and logic.",
                            "target_lang_translations": {
                                "ru": "В средневековых университетах <w>тривий</w> состоял из грамматики, риторики и логики."
                            }
                        },
                        {
                            "text": "The curriculum was divided into the <w>trivia</w> and the quadrivia.",
                            "target_lang_translations": {
                                "ru": "Учебная программа делилась на <w>тривий</w> и квадривий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of trivium"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «тривиум» (гуманитарные науки в средневековом университете)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тривий",
                                "target_lang_sense_clarification": "цикл из трех наук в средневековом образовании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7caa9943-1c5e-3ed6-959f-8fa18098105e",
                    "sense_definition": "An epithet of the Roman goddess Diana, referring to her role as the guardian of crossroads.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "In ancient Roman religion, Diana <w>Trivia</w> was worshipped at the meeting of three roads.",
                            "target_lang_translations": {
                                "ru": "В древнеримской религии Диане <w>Тривии</w> поклонялись на пересечении трех дорог."
                            }
                        },
                        {
                            "text": "The poet addressed the goddess as <w>Trivia</w> in his verses about the moonlit woods.",
                            "target_lang_translations": {
                                "ru": "Поэт обращался к богине как к <w>Тривии</w> в своих стихах о залитых лунным светом лесах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in classical mythology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эпитет римской богини Дианы, относящийся к её роли покровительницы перекрестков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тривия",
                                "target_lang_sense_clarification": "эпитет богини Дианы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}