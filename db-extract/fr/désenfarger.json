                        "examples": [
                            {
                                "example_id": "c21fde47-e209-48e4-a8ff-42982a3ede58",
                                "sense_id": "6b71d942-0156-3401-81db-ff2b984bbf65",
                                "text": "C’est un coureux de femmes, une tête à l’évent, un poulain désenfargé."
                            },
                            {
                                "example_id": "a4130d82-c41b-44d2-8eec-f4c4485be4c7",
                                "sense_id": "6b71d942-0156-3401-81db-ff2b984bbf65",
                                "text": "Elles ont trouvé logique, après avoir brisé les entraves qui les rattachaient au passé, « désenfarger », d’avoir les mouvements aussi libres que leurs pensées et leurs aspirations."
                            },
                            {
                                "example_id": "b7dd3de0-65be-49af-9d43-29b8dff0f0c4",
                                "sense_id": "6b71d942-0156-3401-81db-ff2b984bbf65",
                                "text": "S’il est vrai qu’ils aiment tellement la liberté, qu’ils commencent par se libérer eux-mêmes, en se désenfargeant de la multitude de clauses et clausules inutiles."
                            }
                        ]
                    }
