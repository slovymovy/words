                                        "glosses": [
                                            "Having the power to beget; generative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b6ba9a-2f18-4ae8-9859-95be6be956b0",
                                                "sense_id": "53b0fc72-11d6-3537-93d5-888b056821e1",
                                                "text": "The tortoise, with its characteristic protrusion of the head and neck, was a symbol sacred to Venus. It represented the procreative principle."
                                            }
