                    }
                ],
                "translations": [
                    {
                        "translation_id": "0abf52b1-6512-4a1c-89b4-79634af9d923",
                        "source_entry_id": "1640c3ee-8713-3b1c-a8ee-f09233d15026",
                        "source_sense_id": "fa7495c9-c451-36d5-9ce5-76068e2fb899",
                        "target_lang_word": "stubbornly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubbornly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33ad5e5d-97aa-3b6b-bc1a-4d7c7f76e285",
                                        "entry_id": "c5e78abc-af4c-31b5-b180-d59282183925",
                                        "glosses": [
                                            "In a stubborn manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4492e249-4bf8-4f0e-aceb-51ab72e99282",
                                                "sense_id": "33ad5e5d-97aa-3b6b-bc1a-4d7c7f76e285",
                                                "text": "He stubbornly refused to quit trying, even after failing 20 times."
                                            },
                                            {
                                                "example_id": "beec31d8-e35c-4295-b078-81d48e1ef8d3",
                                                "sense_id": "33ad5e5d-97aa-3b6b-bc1a-4d7c7f76e285",
                                                "text": "It is the outpost which the devil and the flesh most stubbornly maintain against the assaults of grace; and until it be subdued, and its barriers levelled with the very earth, there is more hope of a fool than of the sinner."
                                            },
                                            {
                                                "example_id": "ed8eff4d-19f6-407e-a1f9-42cbcd456e91",
                                                "sense_id": "33ad5e5d-97aa-3b6b-bc1a-4d7c7f76e285",
                                                "text": "The novel he lends his name to is an account of that life, taking more or less the form of a memoir set down in the years immediately after World War II by an old man mentally preparing for death, not quite at home in the twentieth century (and a little proud of it, stubbornly clinging to his eartrumpet), whose significant memories reach back to the early 1890s and beyond."
                                            },
                                            {
                                                "example_id": "ad1c2259-6b50-4b96-bb04-26cbfd605a98",
                                                "sense_id": "33ad5e5d-97aa-3b6b-bc1a-4d7c7f76e285",
                                                "text": "Bradford may have lost on the night but they stubbornly protected a 3-1 first-leg advantage to emulate a feat last achieved by Rochdale in 1962."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2d2face-980f-4c6c-a6d2-6e980b26243f",
                        "source_entry_id": "1640c3ee-8713-3b1c-a8ee-f09233d15026",
                        "source_sense_id": "fa7495c9-c451-36d5-9ce5-76068e2fb899",
                        "target_lang_word": "obstinately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                        "entry_id": "6bdc2688-922e-371a-be99-61ff5d5b0269",
                                        "glosses": [
                                            "In an obstinate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "889f7cbb-6c63-412a-9ec4-861ba53beb88",
                                                "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                                "text": "He obstinately made his motion at every meeting, even though no one else ever supported it and everyone else was bored with it."
                                            },
                                            {
                                                "example_id": "24986585-c1f7-4ee7-b45e-6665a0f17037",
                                                "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                                "text": "'She'll do no such thing,' said the old man obstinately."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31f3db2b-4c03-4772-9b82-5c0610fbfea1",
                        "source_entry_id": "1640c3ee-8713-3b1c-a8ee-f09233d15026",
                        "source_sense_id": "fa7495c9-c451-36d5-9ce5-76068e2fb899",
                        "target_lang_word": "obstinément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                        "entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                                        "glosses": [
                                            "Avec obstination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4afccc-d60e-4fa8-a425-e41859a43e62",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Sa femme s’étant obstinément refusée à céder à ses injonctions, il se résigna de fort méchante humeur à vaquer à ses travaux quotidiens dans la ferme ; […]."
                                            },
                                            {
                                                "example_id": "ea7eb16f-ef17-4ffb-b25d-acda6da6feb1",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Et bien que tout mon cœur obstinément se donne, Ma raison n'ose me donner."
                                            },
                                            {
                                                "example_id": "dcd9695b-b836-4d9b-aea2-d6e7038621f8",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "J'ai beau la conjurer de montrer son visage ; Ma prière au refus obstinément l’engage."
                                            },
                                            {
                                                "example_id": "b387e8db-a3ac-4649-a43a-06ba3c41ff7c",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Après m’avoir obstinément refusé quand je l’en pressais devant sa maîtresse."
                                            },
                                            {
                                                "example_id": "d3ca5658-68bf-40b8-9ba3-7ed26778466d",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Si je parvins à mes fins pour le jeûne, elle refusa obstinément que je déroge aux classes de catéchisme, convaincue que la science de Dieu est plus nécessaire encore que celle du collège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
