{
    "word_family": [
        "stoop"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29dc1187-40a0-3ef8-bea3-943daa5ecef9",
                    "sense_definition": "Having a bent or hunched posture, often due to age or habit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man walked with <w>stooped</w> shoulders after years of hard labor.",
                            "target_lang_translations": {
                                "de": "Der alte Mann ging mit <w>gebeugten</w> Schultern nach Jahren harter Arbeit."
                            }
                        },
                        {
                            "text": "He looked quite <w>stooped</w> as he leaned over his desk to read the small print.",
                            "target_lang_translations": {
                                "de": "Er sah ziemlich <w>gebeugt</w> aus, als er sich über seinen Schreibtisch lehnte, um das Kleingedruckte zu lesen."
                            }
                        }
                    ],
                    "synonyms": [
                        "hunched",
                        "bent",
                        "slouching"
                    ],
                    "antonyms": [
                        "upright",
                        "erect"
                    ],
                    "common_phrases": [
                        "stooped shoulders",
                        "stooped posture"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine gebeugte oder gekrümmte Körperhaltung, oft aufgrund von Alter oder Gewohnheit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gebeugt",
                                "target_lang_sense_clarification": "allgemein für eine nach vorne geneigte Haltung"
                            },
                            {
                                "target_lang_word": "gekrümmt",
                                "target_lang_sense_clarification": "betont die Rundung des Rückens"
                            },
                            {
                                "target_lang_word": "vornübergebeugt",
                                "target_lang_sense_clarification": "spezifisch für eine nach vorne geneigte Haltung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a08a13b-b965-35dd-9d27-d35f58010830",
                    "sense_definition": "Simple past and past participle of <w>stoop</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>stooped</w> down to pick up the coin from the sidewalk.",
                            "target_lang_translations": {
                                "de": "Er <w>bückte sich</w>, um die Münze vom Gehweg aufzuheben."
                            }
                        },
                        {
                            "text": "She <w>stooped</w> to enter the low doorway of the old cottage.",
                            "target_lang_translations": {
                                "de": "Sie <w>bückte sich</w>, um durch den niedrigen Türrahmen des alten Häuschens zu gehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stooped down"
                    ],
                    "target_lang_definitions": {
                        "de": "Die einfache Vergangenheitsform und das Partizip Perfekt von sich bücken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bückte sich",
                                "target_lang_sense_clarification": "Präteritum von sich bücken"
                            },
                            {
                                "target_lang_word": "hat sich gebückt",
                                "target_lang_sense_clarification": "Perfekt von sich bücken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}