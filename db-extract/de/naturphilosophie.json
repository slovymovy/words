                ],
                "senses": [
                    {
                        "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                        "entry_id": "00ff4306-67ed-3e3a-9386-befcd250baf4",
                        "glosses": [
                            "diejenige Disziplin, die die gesamte Natur von den allgemeinen Begriffen und Grundsätzen des Seins und Werdens aus erforscht und durchforscht"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "14d70fbe-0b91-43d2-a1dd-6b8f00b88306",
                                "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                                "text": "Die Ergebnisse der Naturwissenschaft und einige vorwissenschaftliche Naturerkenntnisse bilden die Grundlage der Naturphilosophie."
                            },
                            {
                                "example_id": "41842267-bba3-4ec4-b3f2-d4d665657f8c",
                                "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                                "text": "Der griechische Philosoph Aristoteles gilt als der Begründer der Naturphilosophie."
                            },
                            {
                                "example_id": "3c9ac7e8-7dec-4cb3-bac6-5f4eb8d2699c",
                                "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                                "text": "„Besonders die beiden großen Themen der modernen Physik, die Relativitätstheorie Einsteins und die Quantentheorie Plancks haben vor allem auch methodologische Probleme aufgeworfen, deren erkenntnistheoretische und wissenschaftstheoretische Behandlung Gegenstand positivistisch orientierter Naturphilosophie wurde.“"
                            },
                            {
                                "example_id": "3a6ec227-0e68-44b7-a340-b840839e082f",
                                "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                                "text": "\"Mir scheint aber, daß Joëls Sicht der Geschichte der Naturphilosophie bereits durch eine bestimmte Auffassung von Naturphilosophie vorgeprägt ist, nach der >>große Naturphilosophie<< spekulativ ist - im Unterschied nämlich zur Naturwissenschaft.\""
                            },
                            {
                                "example_id": "f077d493-b43e-4cce-9a1f-e52b4992c07e",
                                "sense_id": "89fcd8a2-2649-31b3-ae41-c4f07aa59f07",
                                "text": "„Seine Naturphilosophie dagegen ist tiefer als die Sades.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
