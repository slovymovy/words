                "senses": [
                    {
                        "sense_id": "2d355567-859e-3a32-a8e4-fc9b09e2f37a",
                        "entry_id": "85652e5f-3a11-3d3d-a79c-6b2b1eb03c3b",
                        "glosses": [
                            "Verfassungsorgan, Vertretung der Bundesländer (kein Plural)"
                        ],
                        "tags": [
                            "Austrian German",
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "c6dcd3d2-5846-43d6-9cca-a7d5b023a856",
                                "sense_id": "2d355567-859e-3a32-a8e4-fc9b09e2f37a",
                                "text": "Der Bundesrat kann Gesetze des Bundes für eine gewisse Zeit aufhalten."
                            },
                            {
                                "example_id": "a3ccad1d-fa3c-4f02-923e-b8ea3ef4791d",
                                "sense_id": "2d355567-859e-3a32-a8e4-fc9b09e2f37a",
                                "text": "„Im Bundesfinanzministerium stellt man sich offenbar schon darauf ein, dass es im November im Bundesrat keine Mehrheit für das Abkommen geben könnte.“"
                            },
                            {
                                "example_id": "fd0d57fe-e7d2-411c-b87c-3455f95b1a32",
                                "sense_id": "2d355567-859e-3a32-a8e4-fc9b09e2f37a",
                                "text": "„Bei einem Mittagessen im Restaurant des französischen Senats und ein paar Tage später im Imbiss des Bundesrates lerne ich mehr über die Demokratie in den beiden Ländern als in jeder Vorlesung über Verfassungsrecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4491fdd1-6e04-3711-a653-2414ceab7995",
                        "entry_id": "85652e5f-3a11-3d3d-a79c-6b2b1eb03c3b",
                        "glosses": [
                            "Regierung"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "b15bd1fb-11a1-4892-81d1-1656d99b6975",
                                "sense_id": "4491fdd1-6e04-3711-a653-2414ceab7995",
                                "text": "„In einer Stellungnahme des Schweizer Bundesrats zum Emigrantenproblem im Lande wird darauf hingewiesen, dass die Schweiz kein Erwerbsland für Einwanderer sein könne, sondern nur eine Durchgangsstation für die Weiterreise nach Übersee.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "28d9b720-302e-32db-b5e7-8a7c120d5683",
                        "entry_id": "85652e5f-3a11-3d3d-a79c-6b2b1eb03c3b",
                        "glosses": [
                            "Person, die dem (schweizerischen) Bundesrat angehört"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
