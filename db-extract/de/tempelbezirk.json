                "senses": [
                    {
                        "sense_id": "357aed09-9cfe-36b4-8214-9dc5ef4329cf",
                        "entry_id": "38c73f4f-d49f-3329-bdd4-a201d4c20967",
                        "glosses": [
                            "abgegrenztes Gebiet, in dem ein oder mehrere Tempel die wichtigsten Gebäude sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "680263b0-d641-40ef-9c9a-d19cfd471e20",
                                "sense_id": "357aed09-9cfe-36b4-8214-9dc5ef4329cf",
                                "text": "„Er gab Befehl, aus den Steinen und dem Schutt des Tempelbezirks eine Kathedrale zu errichten, einen Regierungspalast, ein Ratsgebäude.“"
                            },
                            {
                                "example_id": "fe36566f-54cd-46cb-819a-b3d18710cd71",
                                "sense_id": "357aed09-9cfe-36b4-8214-9dc5ef4329cf",
                                "text": "„Die heiligen Apis-Stiere leben im Tempelbezirk des Ptah zu Memphis und werden im nahegelegenen Sakkara in den unterirdischen Galerien des Serapeums begraben, das man heute als Tourist besichtigen kann.“"
                            },
                            {
                                "example_id": "c91a4ba9-ecc5-4245-9518-6d08a3577e86",
                                "sense_id": "357aed09-9cfe-36b4-8214-9dc5ef4329cf",
                                "text": "„Der Tempelbezirk selbst, im Nordwesten der Stadt unmittelbar am Steilufer gelegen, wurde u-förmig gestaltet und mit einer Arkadenmauer umsäumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
