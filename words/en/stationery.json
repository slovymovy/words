                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student mistakenly used <w>stationery</w> when they meant that the car was not moving.",
                            "target_lang_translations": {
                                "ru": "Студент по ошибке написал <w>stationery</w>, хотя имел в виду, что машина не двигалась."
                            }
                        },
                        {
                            "text": "It is a frequent error to write <w>stationery</w> instead of the adjective meaning fixed in one place.",
                            "target_lang_translations": {
                                "ru": "Часто допускают ошибку, записывая <w>stationery</w> вместо прилагательного, означающего нахождение на одном месте."
                            }
                        }
                    ],
