                        "translation_id": "43aabae0-f6ab-4c29-9fc6-d7654a2ceaf3",
                        "source_entry_id": "89f2fcf2-c20b-3af5-a23a-72b56e35399f",
                        "source_sense_id": "75cc19e7-1da5-3514-ac8f-1c036f8a12a5",
                        "target_lang_word": "pelisse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelisse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe2d829-2276-3e89-9e79-69ea5e8e8ee6",
                                        "entry_id": "4a3e4aee-8db7-3bc7-84fa-6c2f02b2e1b8",
                                        "glosses": [
                                            "A fur-lined robe or cloak, especially as part of a uniform."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cfb7d53-056d-34da-b7fe-8fce525cc008",
                                        "entry_id": "4a3e4aee-8db7-3bc7-84fa-6c2f02b2e1b8",
                                        "glosses": [
                                            "A long cloak formerly worn by women, with a shoulder cape or hood, often lined or trimmed with fur."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0186614-2a8a-4dac-86e3-09248e5cd683",
                                                "sense_id": "6cfb7d53-056d-34da-b7fe-8fce525cc008",
                                                "text": "The mother was crimson in countenance and pelisse, and her ample dimensions spoke years of peace and plenteousness."
                                            },
                                            {
                                                "example_id": "ca6cff19-57c7-4d47-93cd-7fdb793629c5",
                                                "sense_id": "6cfb7d53-056d-34da-b7fe-8fce525cc008",
                                                "text": "Mrs. Wix, after Miss Overmore's last demonstration, addressed herself wholly to the little girl […], drawing from the pocket of her dingy old pelisse a small flat parcel […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd0c7c2-56a0-37fa-8b06-bdb157728f43",
                                        "entry_id": "4a3e4aee-8db7-3bc7-84fa-6c2f02b2e1b8",
                                        "glosses": [
                                            "An overgarment worn by children when outside."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f553a80e-aeaa-4977-8003-0c9d0c1cb3d0",
                                                "sense_id": "5dd0c7c2-56a0-37fa-8b06-bdb157728f43",
                                                "text": "Crawley is made to put on the brightest pea-green in her wardrobe, and my pupils leave off their thick shoes and tight old tartan pelisses, and wear silk stockings and muslin frocks, as fashionable baronets' daughters should."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
