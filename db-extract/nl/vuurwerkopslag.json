                            {
                                "example_id": "e8fe6dd2-c14f-4dfe-97b8-99a24790cc09",
                                "sense_id": "cec4e702-7096-33ec-97e4-7c356f746daa",
                                "text": "Nederlanders opgepakt om vuurwerkopslag bij tankstation: De Belgische politie heeft twee Nederlanders opgepakt omdat ze 2000 kilo zwaar vuurwerk hadden opgeslagen. Het vuurwerk lag in het dorp Kinrooi in een loods die in de buurt staat van een tankstation. Dat zorgde voor een gevaarlijke situatie, laat de politie weten."
                            }
                        ]
                    },
