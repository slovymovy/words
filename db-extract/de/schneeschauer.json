                        "sense_id": "69e0ed98-b113-340b-b3bc-33e1ee8c13e5",
                        "entry_id": "527cb87f-f743-30ff-90c4-3cba7ce7f285",
                        "glosses": [
                            "kurzer, heftiger, auf ein kleines Gebiet begrenzter Schneefall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6816a4-4ac0-4712-92c4-3ecdd8139cb7",
                                "sense_id": "69e0ed98-b113-340b-b3bc-33e1ee8c13e5",
                                "text": "Je höher wir kamen, desto mehr ging der Regen in Schneeschauer über."
                            },
                            {
                                "example_id": "45cd527d-3729-443f-a7ba-a42c71c8c3a0",
                                "sense_id": "69e0ed98-b113-340b-b3bc-33e1ee8c13e5",
                                "text": "„Wir schlendern durch die frühe Dunkelheit, beschließen, wo wir essen werden, und fahren in den ersten Schneeschauern nach Hause, warm eingepackt, unser Atem Dampf in dem alten Delage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
