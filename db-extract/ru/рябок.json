                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                        "entry_id": "901e4241-d7e8-3c93-a926-16fdf16e6189",
                                        "glosses": [
                                            "To complain or grumble."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22781b4a-0ea2-45f8-8de8-64264b0652de",
                                                "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                                "text": "If you're cast for fatigue by a sergeant unkind,\nDon't grouse like a woman, nor crack on, nor blind;\nBe handy and civil, and then you will find\nThat it's beer for the young British soldier."
                                            },
                                            {
                                                "example_id": "e33e412b-56e7-42d6-89a8-c09570002af0",
                                                "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                                "text": "Grouse away!\" he growled. \"If grousin' made a man happy, you'd be the champion.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68fa3946-df2d-3e1c-822d-5b600c0839a8",
                                        "entry_id": "8aa704c2-16ac-3bfa-95ad-d4283028b621",
                                        "glosses": [
                                            "A cause for complaint; a grumble."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                        "entry_id": "28368d84-39de-3fdd-8cd5-89e35631a5c8",
                                        "glosses": [
                                            "Excellent."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d253685f-a061-436b-a0f3-c5b16ad288b8",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "I had a grouse day."
                                            },
                                            {
                                                "example_id": "86fce660-d3d0-4980-b543-c9e4e5b134a0",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "That food was grouse."
                                            },
                                            {
                                                "example_id": "15328279-f404-443e-a2b4-d641948e841d",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "Real grouse birthday this. First time he's had a party."
                                            },
                                            {
                                                "example_id": "0f40b470-f632-4d13-b1f1-f7ccea3e0bab",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "They were the grousest ladies she′d ever met."
                                            },
                                            {
                                                "example_id": "fb1e9615-662c-4645-b029-265a6ff9e8b9",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "Not a question but the gag of Mulder pissing on the ID4 poster was grouse."
                                            },
                                            {
                                                "example_id": "51f220e8-6504-4fa7-87fd-19b96a41ba49",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "I know, but I moved from riding bikes to flying and it is a great move. All riders without a fear of heights I know that flew with me thought it was grouse- and there are no coppers or speed limits up there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
