                    }
                ],
                "senses": [
                    {
                        "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                        "entry_id": "3e4e6660-9a6d-3136-ba22-ce844c7d48bb",
                        "glosses": [
                            "so, dass es nicht beziffert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b287b23-7cb4-4902-a803-2a631c80e601",
                                "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                                "text": "„Es wird angenommen, dass große Verluste nicht nur an der Flora, sondern auch an der Fauna entstanden sind. Einige Schäden ökologischer Art sind unbezifferbar.“"
                            },
                            {
                                "example_id": "dafedaeb-b79c-4d8b-9ba1-17ced2cb8dc8",
                                "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                                "text": "„Die Konsequenzen eines Datenträgerdefekts sind oftmals erheblich und der Schaden nahezu unbezifferbar.“"
                            },
                            {
                                "example_id": "cdc0094b-1ebe-498a-89f6-0e4ccde2af04",
                                "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                                "text": "„Der finanzielle Schaden für den Grazer Tourismus, aber auch für die Bundesligavereine ist derzeit unbezifferbar, wird aber in die Zig-Millionen Euro gehen“"
                            },
                            {
                                "example_id": "80130e10-1911-4c5a-ab10-3bb408bd48b0",
                                "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                                "text": "„Genau darin liegt allerdings die Gefahr von Rückstau. Tritt er einmal auf, sind die Schäden gleich unbezifferbar.“"
                            },
                            {
                                "example_id": "5fa4f0b1-e545-4f80-bce1-8ae26e050668",
                                "sense_id": "03ec8b8c-9311-3555-a63b-902ec0f2fd01",
                                "text": "„Dieser Salon ist ein Bijou sondergleichen – ein unbezifferbar wertvolles Zeugnis feinster Wohnkultur wohlhabenden Landadels am Übergang von der Renaissance zum Barock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
