                "word": "sugariness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bbc6ffaa-d452-34b1-a9d7-802cff6d44d1",
                        "entry_id": "203ddbe4-e698-3bc7-ac38-f10035ac8465",
                        "glosses": [
                            "The property of being sugary or sweet."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26a053cd-ae7a-4f73-bfb4-2929336a1f9c",
                                "sense_id": "bbc6ffaa-d452-34b1-a9d7-802cff6d44d1",
                                "text": "The sugariness of the sauce went well with the tartness of the citrus fruit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "056945d1-3d51-48c6-9136-2cc3e758a27f",
                        "source_entry_id": "203ddbe4-e698-3bc7-ac38-f10035ac8465",
                        "source_sense_id": "bbc6ffaa-d452-34b1-a9d7-802cff6d44d1",
                        "source_sense_description": "property of being sugary",
                        "target_lang_word": "sucrosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sucrosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "140aed5b-b612-3955-a6d4-6a24780c4365",
                                        "entry_id": "bba1b20f-2dad-3c8d-83a7-de03cbf26687",
                                        "glosses": [
                                            "Caractère de ce qui est sucré."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16aee0a5-5030-4f12-aef7-4c553b5121be",
                                                "sense_id": "140aed5b-b612-3955-a6d4-6a24780c4365",
                                                "text": "Les mûres, confites à point, s’alliaient merveilleusement avec la chair tendre et délicatement parfumée du garenne, mais aussi avec la douceur des pommes et la sucrosité acide des figues."
                                            },
                                            {
                                                "example_id": "2b3dc9d7-1737-4ffa-b03d-d618acf50a7c",
                                                "sense_id": "140aed5b-b612-3955-a6d4-6a24780c4365",
                                                "text": "L’ensemble est délicat, évolue sur les fruits jaunes au fil de la gorgée ; l’acidité fait place à un filet de sucrosité, ultra-fin et fugace, car l’amertume reprend le dessus."
                                            },
                                            {
                                                "example_id": "035cd55a-3687-4add-ae72-6d2f1a78a5cd",
                                                "sense_id": "140aed5b-b612-3955-a6d4-6a24780c4365",
                                                "text": "Et on fait gaffe à la sucrosité de certains fruits, tels la mangue et la banane ainsi que les fruits secs qui ont vite fait de vous transformer en Bibendum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
