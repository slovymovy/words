                        "glosses": [
                            "Exécuter le dégrénage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ce1a8e5-4184-30d8-9837-dc1d331828c5",
                        "entry_id": "6235d6df-3cf7-395b-a69b-c783b289e283",
                        "glosses": [
                            "Entraîner, séduire."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "54f05a66-6218-41a8-a9b3-408414d34c05",
                                "sense_id": "3ce1a8e5-4184-30d8-9837-dc1d331828c5",
                                "text": "— Monsieur, je l’sais, dégrène les mômes. Crâne pas. J’veux pas d'histoire. Faudra voir, pourtant, à n’pas r’biffer, si t’as compris."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fb9a2ec-fabe-342a-8d51-91c9af02c0f5",
                        "entry_id": "6235d6df-3cf7-395b-a69b-c783b289e283",
                        "glosses": [
                            "Médire, calomnier. (Variante de dégrainer)"
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d86612a9-7f46-4db0-af37-24d8180fdcfb",
                                "sense_id": "2fb9a2ec-fabe-342a-8d51-91c9af02c0f5",
                                "text": "Dick, toujours réticent lorsqu’on admirait Brigitte, se sentait cette fois moins porté à dégréner."
                            }
                        ]
                    }
