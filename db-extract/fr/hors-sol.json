                    {
                        "translation_id": "d69f73b0-f3ac-44be-b4e8-086663a34191",
                        "source_entry_id": "717f91d4-8246-3831-84a8-225a8392f644",
                        "source_sense_id": "f3e070ef-b6de-398f-87d1-b55c9734286c",
                        "source_sense_description": "Technik, Landwirtschaft: erdelos, hydroponisch, Hors-sol-",
                        "target_lang_word": "hydroponisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydroponisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                        "entry_id": "025e2f72-b2ac-3e1f-9a76-c3543c44fcfb",
                                        "glosses": [
                                            "die Hydroponik betreffend, zur Hydroponik gehörend, auf Hydroponik beruhend"
                                        ],
                                        "tags": [
                                            "Gartenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a04efc-67d2-4de4-b3af-822224adbc6f",
                                                "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                                "text": "Ein Trend in den USA, ein Kuriosum in der Karibik: Im hydroponischen Treibhaus wachsen Gemüse und Salat ohne Erde und ohne Pestizide - versorgt mit einem Mineralcocktail und wassergekühlt."
                                            },
                                            {
                                                "example_id": "0353c355-c6ab-4910-8b2b-6bdc3a295ad8",
                                                "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                                "text": "Bei hydroponischen Systemen werden die von der Pflanze benötigten Nährstoffe und Dünger nur in flüssiger Form an die Wurzeln herangebracht."
                                            },
                                            {
                                                "example_id": "ed9ae714-f5e7-496b-9390-ba40c3b3fd5a",
                                                "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                                "text": "Die Anzucht erfolgt hydroponisch in großen Holzkästen mit jeweils etwa 400 Wurzeln."
                                            },
                                            {
                                                "example_id": "ef213e48-a508-4d2d-b3b3-215b5fba4336",
                                                "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                                "text": "Hydroponische Systeme können im Prinzip mit geringem Aufwand hergestellt werden und daher auch in Ländern mit hohem Wüstenanteil zur Nahrungsgewinnung zum Einsatz kommen."
                                            },
                                            {
                                                "example_id": "d15d4183-74ad-43fb-af52-a3090ac87dc3",
                                                "sense_id": "3dc0ff38-ee3b-3b6c-bdc1-cd677f53e64c",
                                                "text": "Da die Erde als Grundversorger und Puffer für Nährstoffe fehlt, benötigt man spezielle Dünger, die für den hydroponischen Anbau geeignet sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
