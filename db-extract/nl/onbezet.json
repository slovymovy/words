                "senses": [
                    {
                        "sense_id": "b71eedbe-2fed-37df-9c48-c873f98e3f1e",
                        "entry_id": "e027afc0-a437-3c2a-8e6f-ba81ad2f3899",
                        "glosses": [
                            "van een functie: dat er nog niemand voor de functie is benoemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23c3e9b-7373-4a68-88ac-21b8efe8eb98",
                                "sense_id": "b71eedbe-2fed-37df-9c48-c873f98e3f1e",
                                "text": "Volgens de Commissie is er ‘niets ongebruikelijks en al helemaal niets illegaals’ gebeurd en was snelle besluitvorming nodig om een toppost als die van secretaris-generaal niet onnodig onbezet te laten."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f797805-fb50-3e0f-bb46-bcb378dceb7e",
                        "entry_id": "e027afc0-a437-3c2a-8e6f-ba81ad2f3899",
                        "glosses": [
                            "van een zaak: dat niemand het gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4287cd6d-715a-4861-a77e-96f79b9d37e9",
                                "sense_id": "4f797805-fb50-3e0f-bb46-bcb378dceb7e",
                                "text": "De stoelen aan het begin van de Ramblas zijn vrijwel onbezet. De oude mensen van de stad, die hier vaak een babbeltje komen doen of de passerende massa aanschouwen, zijn thuis gebleven."
                            },
                            {
                                "example_id": "3efaf374-e30d-44ec-a10b-93794d6e2d77",
                                "sense_id": "4f797805-fb50-3e0f-bb46-bcb378dceb7e",
                                "text": "In de anderhalve week dat het fietslabyrint in het restaurant van het huis is opgesteld, was het geen dag onbezet. Het bewegingsapparaat werkt beter dan Brunninkhuis had durven geloven. “We krijgen er bewoners mee aan het bewegen, die hier anders niet of nauwelijks aan toe komen."
                            }
                        ]
                    }
                ],
