                        "form": "ста́же"
                    },
                    {
                        "form_id": "0cdbeb52-390e-4bc2-af1d-debf735dad15",
                        "entry_id": "cb1791c4-cfae-301b-8b42-b028e99f98c0",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ста́жах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70f6f513-18fb-3ef5-a729-2170ddc7e3bd",
                        "entry_id": "cb1791c4-cfae-301b-8b42-b028e99f98c0",
                        "glosses": [
                            "продолжительность какой-либо деятельности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89fb344f-f2dc-484a-8078-4f906156136d",
                                "sense_id": "70f6f513-18fb-3ef5-a729-2170ddc7e3bd",
                                "text": "— За сорок лет, — сказал он сокрушенно, давая знать, что стаж далеко не всегда всё решает, — можно было научиться надевать носки под цвет брюк."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cdfbe5f-56b9-37b5-bdaa-196e037086c7",
                        "entry_id": "cb1791c4-cfae-301b-8b42-b028e99f98c0",
                        "glosses": [
                            "количество месяцев или лет трудовой или другой общественно-полезной деятельности, являющееся основанием для возникновения права на пенсионное обеспечение, отпуск и получение пособия по временной нетрудоспособности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd29a7f-c56e-44c6-8f19-dcf1e739eca6",
                                "sense_id": "7cdfbe5f-56b9-37b5-bdaa-196e037086c7",
                                "text": "— По какому документу будет жить альтернативщик — по паспорту или по военному билету? — У него будут паспорт и трудовая книжка. У него будет идти трудовой и профессиональный стаж. А если он будет работать во вредных условиях, то и стаж «вредности»."
                            },
                            {
                                "example_id": "23e2c9e4-9392-4ea4-9433-4587200f21c9",
                                "sense_id": "7cdfbe5f-56b9-37b5-bdaa-196e037086c7",
                                "text": "Согласно этому закону в общий трудовой стаж включалась любая работа, подлежащая социальному страхованию, служба в армии, учёба во всех училищах и в учебных заведениях."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1155dbe-6785-37f5-943e-e04879bd0a3a",
                        "entry_id": "cb1791c4-cfae-301b-8b42-b028e99f98c0",
                        "glosses": [
                            "срок, в течение которого лицо, приступившее к какой-либо работе, деятельности, приобретает практический опыт и овладевает специальностью, а также оценивается с точки зрения пригодности его к данной работе, деятельности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c07eabc-aa6b-4656-bba8-81e2d0033ba8",
                                "sense_id": "c1155dbe-6785-37f5-943e-e04879bd0a3a",
                                "text": "— Послушайте, — говорит он, — как врач с сорокалетним стажем, изучивший не одну тысячу пациентов, хочу предложить вам действительно реальный шанс…"
                            },
                            {
                                "example_id": "4549d355-f8e7-44f2-8b6e-b01e58ca52d1",
                                "sense_id": "c1155dbe-6785-37f5-943e-e04879bd0a3a",
                                "text": "Все соискатели премии делятся на две категории: молодые журналисты до 25 лет и журналисты со стажем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0a97780-b991-4f6c-b398-f3677d772c15",
                        "source_entry_id": "cb1791c4-cfae-301b-8b42-b028e99f98c0",
                        "target_lang_word": "stage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a3060b-9978-3d4a-a3ab-5cfd5d630a37",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Période de travail auprès d’un employeur, effectuée à des fins de formation et faisant partie intégrante d’un cursus scolaire ou de l’enseignement supérieur."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "874b5c62-b88a-488b-9427-725cbbda0532",
                                                "sense_id": "d7a3060b-9978-3d4a-a3ab-5cfd5d630a37",
                                                "text": "Faire un stage en entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e201bc8-d4b1-3c2d-8b2e-808450503c77",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Période de préparation par laquelle doivent passer ceux qui aspirent à certaines professions, pour être admis à les exercer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd2f1b6-a5f3-4b6b-906b-dbce1f0cf4fd",
                                                "sense_id": "8e201bc8-d4b1-3c2d-8b2e-808450503c77",
                                                "text": "Ce jeune homme avait déjà fait un stage de ce genre auprès d’un des ministres tombés en 1827 ; mais le ministre avait eu soin de le placer à la Cour des Comptes."
                                            },
                                            {
                                                "example_id": "af52a263-c10b-47c6-9130-084598dd3e45",
                                                "sense_id": "8e201bc8-d4b1-3c2d-8b2e-808450503c77",
                                                "text": "Il va être nommé secrétaire d’ambassade dans une des grandes capitales de l’Europe ; c’est un stage indispensable, qui n’a d’autre objet que de respecter les usages ; avant peu il sera chargé d’affaires, puis ambassadeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9802ef2c-7dde-3248-82cb-990a55e31d51",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Période pendant laquelle une personne doit attendre avant de formuler une demande ou de bénéficier d'un droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d6b36f-3f82-4f2b-8a54-cb9fea0a15ff",
                                                "sense_id": "9802ef2c-7dde-3248-82cb-990a55e31d51",
                                                "text": "Le stage visé à l’article 62 est réduit à deux ans … pour l’étranger né en France ou marié à une Française."
                                            },
                                            {
                                                "example_id": "69fd79b5-cf7f-4f8e-aa89-8100f8ea2bc8",
                                                "sense_id": "9802ef2c-7dde-3248-82cb-990a55e31d51",
                                                "text": "Les polices d’assurance prévoient parfois un stage pendant lequel certains risques ne sont pas couverts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37d095d-ce29-333d-a337-d58ddfdf6df6",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Situation d’un fonctionnaire recruté mais pas encore titularisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb4fcc6-1392-4ec8-9b37-41ef132088d3",
                                                "sense_id": "f37d095d-ce29-333d-a337-d58ddfdf6df6",
                                                "text": "La durée normale du stage et les conditions dans lesquelles elle peut éventuellement être prorogée sont fixées par les statuts particuliers des cadres d’emplois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b601c1e-5c53-3dfb-b891-9d797da20baa",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Période pendant laquelle on s’exerce à un hobby."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f76e4d5-ebb4-42d5-a243-57af6ef85104",
                                                "sense_id": "9b601c1e-5c53-3dfb-b891-9d797da20baa",
                                                "text": "Stage d’hiver, stage de sport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93907caf-7cd6-3441-b28c-c978aec78f39",
                                        "entry_id": "63c5612f-b0cc-3a7f-baf6-5b056369406d",
                                        "glosses": [
                                            "Séance de sensibilisation civique imposée comme peine."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc57018-2bab-4c59-a504-cff05ff3c3e6",
                                                "sense_id": "93907caf-7cd6-3441-b28c-c978aec78f39",
                                                "text": "Stage de citoyenneté. Peine de stage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
