    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1161479b-fa51-31c3-9b50-14328a645bef",
                "word": "ombre",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11386a27-0115-3003-82e9-7005201e87f1",
                        "entry_id": "1161479b-fa51-31c3-9b50-14328a645bef",
                        "glosses": [
                            "A Spanish card game, usually played by three people. It involves forty cards, omitting the ranks of 8, 9 and 10."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e341e3e-953e-4756-987f-eb01c592aa21",
                                "sense_id": "11386a27-0115-3003-82e9-7005201e87f1",
                                "text": "Belinda now, whom chirst of fame invites, / Burns to encounter two advent'rous Knights, / At Ombre singly to decide their doom / And swells her breast with conquests yet to com"
                            },
                            {
                                "example_id": "6b6126f6-7e87-4ea8-8e1f-bd03be4f0890",
                                "sense_id": "11386a27-0115-3003-82e9-7005201e87f1",
                                "text": "When ombre calls, his hand and heart are free, / And, joined to two, he fails not to make three."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb338a3-c4cc-415a-a6ad-a6bd14c74ad7",
                        "source_entry_id": "1161479b-fa51-31c3-9b50-14328a645bef",
                        "source_sense_id": "11386a27-0115-3003-82e9-7005201e87f1",
                        "source_sense_description": "Translations",
                        "target_lang_word": "hombre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hombre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d855f070-f2bb-301a-a875-324864bc25cc",
                                        "entry_id": "fa357448-4a64-3f1a-89ca-d1ee6a07dc01",
                                        "glosses": [
                                            "Jeu de cartes originaire d’Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15df3aaf-ef67-462b-ae0d-c04fc518e051",
                                                "sense_id": "d855f070-f2bb-301a-a875-324864bc25cc",
                                                "text": "Le jeu de cartes appelé hombre, d’origine espagnole, se jouait à trois, avec 40 cartes."
                                            },
                                            {
                                                "example_id": "becf3847-c122-4db1-b7df-fcf82474a0d5",
                                                "sense_id": "d855f070-f2bb-301a-a875-324864bc25cc",
                                                "text": "Tout comme les bouts de carton bariolés qui ruinent ou enrichissent les joueurs, chaque pièce du jeu légal avait une valeur arbitraire : exactement comme à la blanque ou à l’hombre il était convenu qu’on se gardât à carreau, qu’on brouillât les cartes ou qu’on passât la main, qu’on se couvrît ou qu’on mentît."
                                            },
                                            {
                                                "example_id": "3d8a241f-8496-4fc9-8b28-a0f51f04e17e",
                                                "sense_id": "d855f070-f2bb-301a-a875-324864bc25cc",
                                                "text": "Les tables s’ouvrent, et les joueurs infatigables prennent place autour des tapis verts, où les attendent le boston et l’hombre aimés des vieillards, ou le whist célèbre jusqu’à nos jours, groupe monotone qu’engendrèrent l’avidité et l’ennui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab42dfd7-c30f-313a-9e5f-0734e3b4a129",
                                        "entry_id": "fa357448-4a64-3f1a-89ca-d1ee6a07dc01",
                                        "glosses": [
                                            "Celui qui mène la partie, à ce jeu."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
