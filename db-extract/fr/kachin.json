                        "glosses": [
                            "État le plus septentrional du Myanmar (Birmanie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e255ec5d-7378-4e97-8da1-078b4d150385",
                                "sense_id": "76b8fb93-254a-3fbd-a0e2-44bb637c763c",
                                "text": "En septembre 2011, à la stupéfaction de Pékin, le président birman, Thein Sein, annonçait que les travaux du barrage de Myitsone seraient « suspendus », la majorité de l'électricité qui doit être produite est destinée non au Kachin mais à la province chinoise du Yunnan."
                            }
                        ]
                    }
                ],
