                                "target_senses": [
                                    {
                                        "sense_id": "deb59915-2aa9-3d6e-b6e1-97e2dab8db49",
                                        "entry_id": "6c9777c0-f500-3022-a0d3-b938f2d8ad9e",
                                        "glosses": [
                                            "Lack of orthodoxy; the quality or state of being unorthodox"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88248e8a-4ce9-42e6-92db-1d0564771f26",
                                                "sense_id": "deb59915-2aa9-3d6e-b6e1-97e2dab8db49",
                                                "text": "Where Ms. Rosler’s works exert a fervent but predictable didacticism, Ms. Wilding’s environment conveys an infectious unorthodoxy, a relief from the hierarchical rule of modernist aesthetics over previous decades."
                                            },
                                            {
                                                "example_id": "bae31d5e-76ed-44eb-9ef4-4cefe8652300",
                                                "sense_id": "deb59915-2aa9-3d6e-b6e1-97e2dab8db49",
                                                "text": "It was indeed Aubrey's principal hobby, and allowed him to air his unorthodoxies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
