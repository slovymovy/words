                                        "sense_id": "b163973a-1e28-3559-bd77-ce6c5223bdf4",
                                        "entry_id": "0a428e68-afee-39b1-978a-88b24ed35a24",
                                        "glosses": [
                                            "Oryx gazella soort spiesbok"
