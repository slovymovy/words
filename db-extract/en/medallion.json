                        "target_lang_word": "médaillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médaillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6c1abb-cc32-3ed7-8560-a497d7307fde",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Grosse médaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552e6286-5f79-46f4-83a6-01a4553e6046",
                                                "sense_id": "3b6c1abb-cc32-3ed7-8560-a497d7307fde",
                                                "text": "Médaillon d’or, d’argent, de bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975363d5-21d2-390f-b82b-20ddd7a5c9ee",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Bas-relief rond, sur lequel est représentée la tête de quelque personnage illustre ou quelque action mémorable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1065329c-3f89-3ffa-8461-4327ef469134",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Tableau ou gravure de forme ronde ou ovale."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d20b9ec7-1e97-432c-bbd5-df2515a97bfa",
                                                "sense_id": "1065329c-3f89-3ffa-8461-4327ef469134",
                                                "text": "Au verso du frontispice de la 1ʳᵉ édition on voit le portrait de l’auteur dans un médaillon , gravé par un anonyme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d180b48-3a17-3e5a-9bb5-456957d89974",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Morceau, tranche de viande ou de poisson, plus ou moins rond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76975bc7-f36a-4cac-b914-e35155cec1f2",
                                                "sense_id": "1d180b48-3a17-3e5a-9bb5-456957d89974",
                                                "text": "Disposez la mâche sur les assiettes, puis placez votre médaillon de foie gras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "525b7008-15fa-3970-ab98-48b0fb1842c4",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Bijou, de forme circulaire ou ovale, dans lequel on enferme un portrait, des cheveux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f7d55c-1699-4b1e-8155-b8aca7de1e33",
                                                "sense_id": "525b7008-15fa-3970-ab98-48b0fb1842c4",
                                                "text": "Médaillon d’or, d’écaille."
                                            },
                                            {
                                                "example_id": "76d5ee37-0124-4613-a789-53bb11bdaf6f",
                                                "sense_id": "525b7008-15fa-3970-ab98-48b0fb1842c4",
                                                "text": "Mais il m’avait raconté tant d'histoires de ses illusions, et montré tant de portraits sur ivoire, de médaillons charmants qu’il utilisait depuis à parer des tabatières, tant de billets jaunis, tant de faveurs fanées,… que je m’étais habitué à penser mal de toutes…"
                                            },
                                            {
                                                "example_id": "77175a59-b1b6-482d-b314-f95240b8f4f3",
                                                "sense_id": "525b7008-15fa-3970-ab98-48b0fb1842c4",
                                                "text": "« Cadichon, Cadichon, s’écria-t-elle, maman m’a donné un médaillon de ses cheveux ; je veux y ajouter des tiens, car tu es aussi mon ami ; je t’aime, et j’aurai ainsi les cheveux de ceux que j’aime le plus au monde. »"
                                            },
                                            {
                                                "example_id": "fa45370e-9d26-4a26-9a78-362ea9dfb7b2",
                                                "sense_id": "525b7008-15fa-3970-ab98-48b0fb1842c4",
                                                "text": "Gonzalo ne se souvenait pas de ce médaillon-portrait, et il ne comprenait pas pourquoi il se trouvait dans la poche de ce blouson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d1610f-8378-3be3-b8bd-6c74dd3986d9",
                                        "entry_id": "b22aed6f-8204-34ff-8578-05479f48245f",
                                        "glosses": [
                                            "Court portrait d’un écrivain ou de tout autre personnage notoire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
