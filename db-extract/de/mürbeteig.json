                ],
                "senses": [
                    {
                        "sense_id": "ce0236e9-20d2-3a44-ae58-3fea98a980ad",
                        "entry_id": "8a8d2b7f-e75f-323d-8add-8c11f7ac349f",
                        "glosses": [
                            "viel Zucker, Mehl und Fett und wenig Wasser enthaltender, fester Teig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334e5efc-eda4-45f9-86c7-91e9d03edb70",
                                "sense_id": "ce0236e9-20d2-3a44-ae58-3fea98a980ad",
                                "text": "„Die Formel für einen wunderbar buttrigen Mürbeteig lautet 3-2-1: drei Teile Mehl, zwei Teile Butter, ein Teil Zucker.“"
                            },
                            {
                                "example_id": "a78ffdc8-026c-44f2-a6d3-2a594eb807a7",
                                "sense_id": "ce0236e9-20d2-3a44-ae58-3fea98a980ad",
                                "text": "„Immerhin nimmt der Teig tatsächlich eine Konsistenz an, die der eines Mürbeteigs nahekommt.“"
                            },
                            {
                                "example_id": "4c76e9ae-df24-4323-ac4c-752bb21016ea",
                                "sense_id": "ce0236e9-20d2-3a44-ae58-3fea98a980ad",
                                "text": "„Alle Mürbeteige bestehen aus den Grundzutaten Weizenmehl, Fett und Zucker. Zur Geschmacksgebung und zur Verbesserung des Mürbeteigs können zugesetzt werden: Kochsalz, Aromen und Vollei oder Eidotter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
