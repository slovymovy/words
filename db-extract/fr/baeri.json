                        "glosses": [
                            "Esturgeon sibérien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baed6e2f-c9e3-4258-8fa0-5480ae4b3afb",
                                "sense_id": "253aa962-f7e7-32ff-b0fc-fc3fdfdb5492",
                                "text": "En pisciculture on élève essentiellement des espèces sibériennes le baeri (Acipenser baeri) et un hybride, le \"bester\" (Acipenser ruthenus x Huso huso), dans le but de produire de la chair et du caviar. Il ne serait pas étonnant de retrouver les baeri en rivière puisqu'ils sont parfois introduites pour la pêche en étang."
                            },
                            {
                                "example_id": "da680988-a8c7-42ae-8956-5b5c6571701b",
                                "sense_id": "253aa962-f7e7-32ff-b0fc-fc3fdfdb5492",
                                "text": "Pour rester fidèle à la gastronomie du Sud-Ouest, les nouveaux partenaires choisissent d'élever le baeri (acipenser baeri), plutôt que d'importer des espèces plus connues."
                            }
                        ]
                    }
