                {
                    "sense_id": "4df4208d-41c1-3546-8155-a686cb8dc858",
                    "sense_definition": "Droit qu'un vassal devait acquitter à son seigneur suzerain pour relever et reprendre possession d'un fief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'héritier du domaine devait acquitter le <w>relief</w> auprès de son suzerain pour conserver ses terres."
                        },
                        {
                            "text": "Le seigneur refusait d'investir le jeune noble avant le paiement intégral du droit de <w>relief</w>."
