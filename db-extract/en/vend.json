                        "cross_references": [
                            {
                                "target_word": "vente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee6d719-87a6-34a6-9cb1-da35d8617d43",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Contrat par lequel une chose est aliénée moyennant un prix donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce1cbdfd-42e3-4b04-b942-fa4066a460d5",
                                                "sense_id": "5ee6d719-87a6-34a6-9cb1-da35d8617d43",
                                                "text": "La vente en l'état futur d'achèvement est le contrat par lequel le vendeur transfère immédiatement à l'acquéreur ses droits sur le sol ainsi que la propriété des constructions existantes."
                                            },
                                            {
                                                "example_id": "cb4a9cb5-2097-4439-9d93-6fc888b7fc3f",
                                                "sense_id": "5ee6d719-87a6-34a6-9cb1-da35d8617d43",
                                                "text": "La vente en vertu de la clause de voie parée doit être précédée d'un commandement signifié au débiteur, de payer la somme due, dans un délai qui ne peut être inférieur à quinze jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511e36fd-f8f1-35b1-a703-a2235ddf7725",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Commerce de celui qui vend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93eb580a-ca0e-45cf-9464-ba3d0d884c39",
                                                "sense_id": "511e36fd-f8f1-35b1-a703-a2235ddf7725",
                                                "text": "La vente de légumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a9d15c-05ba-3b25-899a-aea3a3a1425e",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Fonction de ceux qui sont chargés d’écouler, dans une entreprise, les marchandises produites ou achetées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27825c42-4f13-31c7-8f94-b50cf452840a",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Coupe qui se fait dans un bois, dans une forêt, en des temps réglés."
                                        ],
                                        "tags": [
                                            "Eaux & Forêts"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c969fb-4377-4652-ade6-80b6fd6a5e0c",
                                                "sense_id": "27825c42-4f13-31c7-8f94-b50cf452840a",
                                                "text": "Il y a plusieurs ventes dans cette forêt, et chaque vente est de vingt arpents."
                                            },
                                            {
                                                "example_id": "54f3efc7-8cfd-47a2-acb9-e271868e9f3c",
                                                "sense_id": "27825c42-4f13-31c7-8f94-b50cf452840a",
                                                "text": "Les ventes de la forêt de Compiègne, de Germain, d’Orléans."
                                            },
                                            {
                                                "example_id": "ea0c2e69-7ca9-4699-8f7a-5958320c1739",
                                                "sense_id": "27825c42-4f13-31c7-8f94-b50cf452840a",
                                                "text": "Il était un scieur de long auvergnat qui travaillait dans la forêt avec ceux de son équipe. Leur chantier était installé de la veille dans une vente toute voisine de notre Breure, et on l’avait délégué pour aller quérir de l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71353b8-e5b7-33b5-97ae-1212f4135651",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Partie d’une forêt ou d’un bois qui vient d’être coupée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7b361f-f4bd-40d8-b874-a72438accc27",
                                                "sense_id": "c71353b8-e5b7-33b5-97ae-1212f4135651",
                                                "text": "Tout le bois que j’ai coupé est encore dans la vente."
                                            },
                                            {
                                                "example_id": "cf89a87e-874d-4ec3-b198-a70a6753734e",
                                                "sense_id": "c71353b8-e5b7-33b5-97ae-1212f4135651",
                                                "text": "Acheter du bois dans la vente."
                                            },
                                            {
                                                "example_id": "6c6a01da-06d8-49de-b341-2f9f89489ca5",
                                                "sense_id": "c71353b8-e5b7-33b5-97ae-1212f4135651",
                                                "text": "Vider, nettoyer les ventes en enlevant le bois qui est coupé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da03bf08-c2b6-3022-9d2a-2b1f1cff5a3e",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Section de la société secrète des carbonari."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ea0b43-1098-4402-b43b-f0e7596fb838",
                                                "sense_id": "da03bf08-c2b6-3022-9d2a-2b1f1cff5a3e",
                                                "text": "Mais il croyait à la sincérité des hommes qui faisaient partie de la même conspiration que lui, dont certains se cachaient dans les contreforts des Abruzzes (et même on leur avait écrasé les doigts, ce qu’il considérait naïvement comme une certitude absolue de sincérité). Il était allé plusieurs fois les rejoindre sous la verte tente, pour des ventes importantes, toujours avec audace, quelquefois même négligemment, en grand uniforme."
                                            },
                                            {
                                                "example_id": "b81e26ce-9525-44c6-bd60-6d6872eeaf41",
                                                "sense_id": "da03bf08-c2b6-3022-9d2a-2b1f1cff5a3e",
                                                "text": "Je sens, continua le carbonaro, que cet aveu va me faire perdre le seul bien qui m’attache à la vie ; mais il est indigne de moi de vous tromper. Je m’appelle Pietro Missirilli ; j’ai dix-neuf ans ; mon père est un pauvre chirurgien de Saint-Angelo-in-Vado, moi je suis carbonaro. On a surpris notre vente ; j’ai été amené, enchaîné, de la Romagne à Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a79671b1-098c-33c1-84c4-6a9b5a8fcdb7",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Redevance due au seigneur du fief pour la vente d’un domaine compris dans sa censive."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "note": "Souvent associé avec le terme lods",
                                        "examples": [
                                            {
                                                "example_id": "5569c5ef-4cd2-4400-b040-9f8792bf922b",
                                                "sense_id": "a79671b1-098c-33c1-84c4-6a9b5a8fcdb7",
                                                "text": "Il lui devait les lods et ventes de son acquisition."
                                            },
                                            {
                                                "example_id": "d024e3dd-54af-4bbb-ae19-4d100b0fbb91",
                                                "sense_id": "a79671b1-098c-33c1-84c4-6a9b5a8fcdb7",
                                                "text": "Il paya sur-le-champ les lods et ventes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5551f6d4-16fe-3211-a6c6-d0dfbcfd1ca7",
                                        "entry_id": "27e44bd6-c50a-37b0-a02c-181fce4de1d1",
                                        "glosses": [
                                            "Marchandises vendues à rabais, en solde."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7196f6ad-ade9-47e2-a1b8-20f77cc29635",
                                                "sense_id": "5551f6d4-16fe-3211-a6c6-d0dfbcfd1ca7",
                                                "text": "Je vais les acheter lorsqu'elles seront en vente."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef7767d2-571e-3466-9f67-ef85bc259181",
                                        "entry_id": "13af0c3d-7109-3378-aedc-dd7490a26a3e",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de venter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f57f0ac4-1b00-3ec1-9964-682b919f255c",
                                        "entry_id": "13af0c3d-7109-3378-aedc-dd7490a26a3e",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de venter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "997a5df8-f7bd-48a8-95ea-2ffb98b8c92e",
                                                "sense_id": "f57f0ac4-1b00-3ec1-9964-682b919f255c",
                                                "text": "Qu’il pleuve, qu’il neige, qu’il vente, la surveillance doit être assurée sans défaillance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
