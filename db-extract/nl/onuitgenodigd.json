                        "examples": [
                            {
                                "example_id": "7d58bea2-4c7c-4cbd-9f04-9796e6d01d4a",
                                "sense_id": "fe243f32-ab0b-336e-93fe-0a1c85b885f1",
                                "text": "Hij stapte onuitgenodigd over de drempel, gevolgd door de koele avondlucht, waarbij zijn aanwezigheid de kleine keuken vulde."
                            },
                            {
                                "example_id": "933533a1-2d74-4058-8472-2d234cb18a0a",
                                "sense_id": "fe243f32-ab0b-336e-93fe-0a1c85b885f1",
                                "text": "\"Ik wilde heel graag naar de begrafenis van een persoon van wie ik hield en die ik hoog heb zitten. Maar het zou respectloos zijn om daar onuitgenodigd te verschijnen\", zei hij."
                            }
                        ]
                    }
