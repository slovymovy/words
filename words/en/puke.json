                {
                    "sense_id": "c597fbf6-cb24-311a-b18e-780ee4b34699",
                    "sense_definition": "To eject the contents of the stomach through the mouth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vomit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sick child began to <w>puke</w> after eating the spoiled food.",
                            "target_lang_translations": {
                                "tr": "Hasta çocuk bozuk yemeği yedikten sonra <w>kusmaya</w> başladı.",
                                "ru": "Больного ребёнка начало <w>рвать</w> после того, как он съел испорченную еду."
                            }
                        },
                        {
                            "text": "He felt so dizzy that he had to <w>puke</w> up his entire lunch.",
                            "target_lang_translations": {
                                "tr": "O kadar başı döndü ki bütün öğle yemeğini <w>çıkarık</w> zorunda kaldı.",
                                "ru": "У него так сильно закружилась голова, что ему пришлось <w>выблевать</w> весь свой обед."
                            }
