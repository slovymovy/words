                ],
                "senses": [
                    {
                        "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                        "entry_id": "e81029a1-67a5-3555-b5c0-64ee7c2f1e9f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba4e289-dfd4-4bb0-8168-9200e5988fec",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Frau Randow ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "da92d056-3a47-4386-9b3b-c1537ee51d2e",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Herr Randow wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5094223c-5518-4529-9aa7-1a99113e6cb9",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Die Randows fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "47b7800f-55ce-4e8a-8588-4c0ae3d4e943",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Der Randow trägt nie die Pullover, die die Randow ihm strickt."
                            },
                            {
                                "example_id": "acb72c2e-0115-4a55-aacd-9c039ff1c77f",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Randow kommt, geht der Herr Randow.“"
                            },
                            {
                                "example_id": "089f5510-3578-417c-96fb-6bac392372ad",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Randow kommt und geht."
                            },
                            {
                                "example_id": "f07a265c-b341-4e40-8da2-358a81674dec",
                                "sense_id": "8dbd0e40-e5c3-329f-942b-cee7dc8a02cd",
                                "text": "Randows kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
