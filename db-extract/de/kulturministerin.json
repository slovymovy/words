                            {
                                "example_id": "a03bf34b-9e71-4f83-af9c-ce3db455f727",
                                "sense_id": "96160d5c-5fd2-3ac5-9ac1-f959f379c7d7",
                                "text": "Die amtierende Kulturministerin traf ihre Amtsvorgängerin bei einer Ausstellung."
                            },
                            {
                                "example_id": "c3e604b0-cdb6-4ad7-81ed-fdf20cb7365d",
                                "sense_id": "96160d5c-5fd2-3ac5-9ac1-f959f379c7d7",
                                "text": "„Später nahm Sophie mich mit in die auf dem Campus gelegene Wohnung einer Professorin, die in den ersten Jahren der Unabhängigkeit die senegalesische Kulturministerin gewesen war.“"
                            }
                        ],
