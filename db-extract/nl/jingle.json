                    {
                        "sense_id": "e069c836-47bd-3bc1-bac7-093493491a5f",
                        "entry_id": "aecada83-583f-3cb9-bd81-8b1344225e0f",
                        "glosses": [
                            "een kort muziekje dat dient ter herkenning van een programma of programma onderdeel"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "70a242a6-bd59-49a4-ac49-ce9900711fa4",
                                "sense_id": "e069c836-47bd-3bc1-bac7-093493491a5f",
                                "text": "De zender Dozjd (Russisch voor 'regen', in het Engels Rain TV, red) bestaat nu bijna vier jaar. De naam zorgt nog altijd voor verwarring, maar de roze huiskleur, de frisse jingle en de ondertitel 'optimistic channel' laat er geen misverstand over bestaan: dit is andere televisie, televisie voor de generatie Russen die geen televisie meer kijken omdat de grote zenders al lang het vertrouwen hebben verloren. Tegengas tegen de censuur. Hoofdredacteur Michail Zygar heeft het de afgelopen jaren vaak moeten herhalen: 'Nee, we zijn geen oppositionele televisiezender, we doen gewoon ons werk. De rest liegt, wij niet.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "610ebebc-df01-3964-ac05-8e3a0229b240",
                        "entry_id": "aecada83-583f-3cb9-bd81-8b1344225e0f",
                        "glosses": [
                            "reclamemuziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb8f9b5-e450-4ec5-9f0a-81555a05a445",
                                "sense_id": "610ebebc-df01-3964-ac05-8e3a0229b240",
                                "text": "Sinds het land in 1989 voor het eerst na ruim twee decennia militaire dictatuur in vrijheid naar de stembus toog, worden jingles gebruikt om politieke boodschappen over te brengen. De slim gemaakte liedjes liggen goed in het gehoor en zijn er niet zozeer op gericht de kiezer in het hoofd, maar liever juist in het hart te raken."
                            }
                        ]
                    }
