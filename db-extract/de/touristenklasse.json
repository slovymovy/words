                "senses": [
                    {
                        "sense_id": "28a37287-a9ed-350d-a4fb-165b1f01dc3d",
                        "entry_id": "70b61395-a60b-3bd3-bcb4-127421a8996f",
                        "glosses": [
                            "preisgünstigste Kategorie für Hotels oder für Beförderungsmittel wie Schiffen oder Flugzeugen, die für wenig Komfort steht"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0c72f224-3a32-4c03-b954-cb09332db9c3",
                                "sense_id": "28a37287-a9ed-350d-a4fb-165b1f01dc3d",
                                "text": "„Ein wenig müssen Passagiere in der Touristenklasse der Air New Zealand noch mit wenig schlaffreundlichen Sitzen vorlieb nehmen. Aber schon Ende 2010 führt die Airline eine ganz neue Bestuhlung in einer Boeing 777-300 ein, die die Economy-Klasse um einigen Komfort bereichern wird.“"
                            }
                        ],
