                ],
                "senses": [
                    {
                        "sense_id": "b4c376ea-533d-3265-a505-96b91724c903",
                        "entry_id": "bbede43b-e0e3-3cc3-b019-8171c16a94f5",
                        "glosses": [
                            "Schriftzeichen der Hieroglyphenschrift, das bei mehreren Bedeutungsmöglichkeiten eines Zeichens die beabsichtigte Bedeutung spezifiziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36f2188-0657-4a17-a4c1-771701f795a4",
                                "sense_id": "b4c376ea-533d-3265-a505-96b91724c903",
                                "text": "„Determinative sind Zeichen ohne phonetischen Wert; sie werden neben andere Symbole gestellt, um deren Bedeutung einzugrenzen, wenn mehrere Bedeutungen möglich sind.“"
                            },
                            {
                                "example_id": "0a778f76-32f2-497b-9f50-34db1e6aa0be",
                                "sense_id": "b4c376ea-533d-3265-a505-96b91724c903",
                                "text": "„An diesem Punkt müssen sie sumerischen Schreiber Determinative einführen, die die verwendeten Zeichen klassifizieren, um klarzustellen, ob es sich jeweils um das Objekt oder den Lautbezug handelt: Dadurch wird erst ein eindeutiges Lesen möglich.“"
                            },
                            {
                                "example_id": "188c4786-808f-4915-b61c-39a82eb2cc1b",
                                "sense_id": "b4c376ea-533d-3265-a505-96b91724c903",
                                "text": "„Um kenntlich zu machen, welche Bedeutung jeweils gemeint war, wurde im Sumerischen ein Determinativ beigefügt.“"
                            },
                            {
                                "example_id": "2dda258d-d1fb-470a-b523-381521bc8762",
                                "sense_id": "b4c376ea-533d-3265-a505-96b91724c903",
                                "text": "„Hilfreich ist es da, wenn es einem gelingt, ein so genanntes Determinativ oder Bestimmungszeichen ausfindig zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab8eb8a5-2d0c-3242-bf1b-4b3092dff49c",
                        "entry_id": "bbede43b-e0e3-3cc3-b019-8171c16a94f5",
                        "glosses": [
                            "Oberbegriff für Wörter, die ein Substantiv näher bestimmen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19519984-ed5e-428d-a1be-4604d9bb2458",
                                "sense_id": "ab8eb8a5-2d0c-3242-bf1b-4b3092dff49c",
                                "text": "„Kommen in der Substantivgruppe (Determinativ +) Adjektiv + Substantiv im Singular der Kasus und das Genus und im Plural nur der Kasus formal zum Ausdruck, so hat das Adjektiv im Nominativ Singular aller Genera und im Akkusativ Singular bei Feminina und Neutra das Suffix -e…“"
                            },
                            {
                                "example_id": "89421ad6-193d-4f59-bcf2-b117e7f18772",
                                "sense_id": "ab8eb8a5-2d0c-3242-bf1b-4b3092dff49c",
                                "text": "„Determinative sind Begleiter des Nomens, die nie mit einem sächsischen Genitiv kombiniert werden können (…).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
