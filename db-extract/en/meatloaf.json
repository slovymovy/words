                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6310d7f4-7a9e-4c96-b851-4bb3f8622bf1",
                        "entry_id": "62932985-40fb-355f-8ff5-3c48d2484d97",
                        "tags": [
                            "plural"
                        ],
