                ],
                "senses": [
                    {
                        "sense_id": "e392647d-637d-3a0f-8055-2bd864304c0a",
                        "entry_id": "9fe33ab1-8949-3a49-84e8-81469dbd95a3",
                        "glosses": [
                            "van bont gemaakte jas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "158b76dd-503f-4976-8729-d7449552b436",
                                "sense_id": "e392647d-637d-3a0f-8055-2bd864304c0a",
                                "text": "Jagger had het hele concert een paars T-shirt aan, maar verscheen bij Sympathy for the Devil ineens in een geel shirt, met een rode bontmantel en een zwarte broek, de kleuren van de Belgische vlag. \"Rolling Stones tonen sympathie voor Rode Duivels\", concludeerde de Vlaamse publieke omroep VRT."
                            },
                            {
                                "example_id": "c6d8cc11-c463-42a1-94ae-d114d93d4e47",
                                "sense_id": "e392647d-637d-3a0f-8055-2bd864304c0a",
                                "text": "De jurk van Gaga kreeg de stem van één op de vijf internetters, gevolgd door het kostuum van Elton John en de 'oversized' bontmantel van Liberace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2298293a-af81-45da-ad0b-b53861d295e6",
                        "source_entry_id": "9fe33ab1-8949-3a49-84e8-81469dbd95a3",
                        "source_sense_id": "e392647d-637d-3a0f-8055-2bd864304c0a",
                        "source_sense_description": "van bont gemaakte jas",
                        "target_lang_word": "Pelzmantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pelzmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                        "entry_id": "37ae8ae3-83ac-3fec-9ef3-f4a07fe6c7a3",
                                        "glosses": [
                                            "Mantel aus Pelz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b6f70d-e5ed-4596-9d94-71900da146c7",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Vor zwei Jahren hatte sich Rapper West ebenfalls nicht lumpen lassen: Da schenkte er seiner Frau satte 150 Gaben, darunter einen Pelzmantel in Regenbogenfarben und einen Jumpsuit von Prada.“"
                                            },
                                            {
                                                "example_id": "d76c248d-b8c2-4e7c-b545-5ef3dea5c6d1",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Dass der Pelzmantel, einst Symbol von Luxus und Highlife, heute ziemlich stark in der Kritik steht, dürfte den meisten Menschen bewusst sein.“"
                                            },
                                            {
                                                "example_id": "dd13f7f2-f1fc-493d-af5f-169f0a381215",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Keine Pelzdecke und keiner unserer Pelzmäntel kam abhanden, denn dafür interessierten sich die Russen nicht; Pelze sind für sie offenbar reine Gebrauchsgegenstände, über die sie selbst reichlich verfügen.“"
                                            },
                                            {
                                                "example_id": "bf179646-42b6-4699-8613-c4ddb798f2e5",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Almuth, angekleidet, kam herein und warf ihren Pelzmantel über die Schulter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cb1f26a-78e3-4116-9557-62ef8b2043b8",
