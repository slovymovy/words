                "senses": [
                    {
                        "sense_id": "a10d75ef-9d6f-3f77-9f38-9b28ccf84e63",
                        "entry_id": "0a2f7f58-66dd-3f23-8a19-f2ea04e17d73",
                        "glosses": [
                            "Relation sentimentale honnête, franche et assumée avec plusieurs partenaires simultanément (chaque relation pouvant comprendre ou non des rapports sexuels)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497d90aa-bc59-4089-9a2c-c9c5231c0d03",
                                "sense_id": "a10d75ef-9d6f-3f77-9f38-9b28ccf84e63",
                                "text": "Le polyamour, c’est tout d’abord... de l’amour !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a9340d1-37b2-4a96-8a5b-943c855313cf",
                        "source_entry_id": "0a2f7f58-66dd-3f23-8a19-f2ea04e17d73",
                        "source_sense_id": "a10d75ef-9d6f-3f77-9f38-9b28ccf84e63",
                        "target_lang_word": "Polyamorie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyamorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d82b3f40-3ed2-33d2-987f-6afe49a64c74",
                                        "entry_id": "fe6ec1fb-f9c8-3470-bc84-8cad1b827c42",
                                        "glosses": [
                                            "das Führen gleichzeitiger liebevoller Beziehungen zu mehr als einer Person mit Wissen und Einverständnis aller Beteiligten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d483e087-d195-434b-b11b-57d70fc8aa62",
                                                "sense_id": "d82b3f40-3ed2-33d2-987f-6afe49a64c74",
                                                "text": "„Am Stammtisch herrscht die Hoffnung, dass Polyamorie die Menschen sexuell befreien könne, auch die Königshäuser.“"
                                            },
                                            {
                                                "example_id": "53168c11-56d3-4fe4-a061-c08a29c6b6a8",
                                                "sense_id": "d82b3f40-3ed2-33d2-987f-6afe49a64c74",
                                                "text": "„Und Polyamorie ist nicht Polygamie, also nicht „Vielehe“.“"
                                            },
                                            {
                                                "example_id": "32641993-a5ce-4fe0-a589-cf61c6418189",
                                                "sense_id": "d82b3f40-3ed2-33d2-987f-6afe49a64c74",
                                                "text": "„Polyamorie ist für manche nach wie vor ein Tabu, für viele andere aber schon gelebtes Leben. “"
                                            },
                                            {
                                                "example_id": "c6a65945-64f7-4c2c-a57f-cb6a2d6879fe",
                                                "sense_id": "d82b3f40-3ed2-33d2-987f-6afe49a64c74",
                                                "text": "„Polyamorie ist etwas anderes als eine offene Beziehung, bei der Sex mit anderen zwar erlaubt ist, die \"Primärbeziehung\" aber immer Vorrang hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21c082a-26f1-4b20-a00d-96b3fa45e1db",
                        "source_entry_id": "0a2f7f58-66dd-3f23-8a19-f2ea04e17d73",
