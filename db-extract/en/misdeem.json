                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6470e1a2-9261-4e1a-9fb9-89950a0e2888",
                                "sense_id": "82dc8eb7-c7ed-3a80-858b-cf83cad354bf",
                                "text": "The doubt which ye misdeem, fair love, is vain, / That fondly fear to lose your liberty; / […]"
                            },
                            {
                                "example_id": "fa82abbd-ef3b-40fa-8992-024f1e818b8a",
                                "sense_id": "82dc8eb7-c7ed-3a80-858b-cf83cad354bf",
                                "text": "Nor say I this for that I aught misdeem / That Egypt's promis'd succors fail us might."
                            }
                        ]
                    }
