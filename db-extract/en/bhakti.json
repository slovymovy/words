                "senses": [
                    {
                        "sense_id": "4555d90f-72ed-3568-8c9e-2dc8e2076088",
                        "entry_id": "90801d3f-9dbb-3ca6-a80d-b25b49028cf0",
                        "glosses": [
                            "devotion to God"
                        ],
                        "tags": [
                            "Hinduism",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc4135b9-f250-4a6a-8a5a-3a91376414ac",
                                "sense_id": "4555d90f-72ed-3568-8c9e-2dc8e2076088",
                                "text": "It should be obvious by now that bhakti is not merely pious thoughts of \"love\" but rather fearless action. Nārada asks nothing less of the bhakta than complete surrender and complete dedication unto the will of Bhagavān. But if at any point one feels himself unable to reach the ideals taught by Nārada, he is not condemned. Lord Kṛṣṇa also says that if we cannot achieve the topmost surrender, then we should do what we can and try to progress gradually."
                            },
                            {
                                "example_id": "fdba75cb-68b6-4a0e-a91f-79143cc836ca",
                                "sense_id": "4555d90f-72ed-3568-8c9e-2dc8e2076088",
                                "text": "The offering of Bhakti is a specific activity, either mental or physical, through which a devotee can finally attain the knowledge of the Supreme Reality. So, Karma and Jñāna are not antagonistic to the Bhakti Mārga, rather, they are indispensable parts of it."
                            }
                        ]
                    }
                ],
