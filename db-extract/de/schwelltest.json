                ],
                "senses": [
                    {
                        "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                        "entry_id": "49cbf321-943c-3ebf-bd08-039cba7b0f32",
                        "glosses": [
                            "Verfahren, bei dem die Ausdehnung eines Objekts oder Materials unter bestimmten Bedingungen gemessen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df6419d-ccaa-472c-9cb9-694bd133a1a4",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Beim Schwelltest wird die Ausdehnung des Materials nach dem Gefrieren gemessen.“"
                            },
                            {
                                "example_id": "c7d16c99-dc56-40c7-b267-0f60a2718180",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Im klassischen hypoosmotischen Schwelltest wird der Prozentsatz der Spermien, die nach einer Inkubation im hypotonen Puffer schwellen und charakteristisches Aufrollen des Schwanzes oder Schleifen zeigen, mikroskopisch bestimmt.“"
                            },
                            {
                                "example_id": "c56dc1b3-b0cb-4348-ab52-cdbfc9f871bd",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„49 Patienten mit normaler Spermiendichte hatten einen Schwelltest unter 60 % geschwollener Spermien.“"
                            },
                            {
                                "example_id": "c30e161d-272f-41d1-951f-c7c5f8d5e38d",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Der hypoosmotische Schwelltest ergab bei der Konservierung in autologem Seminalplasma zwischen Tag 2 und 4 einen höheren Anteil an Spermien mit veränderter Plasmamembran als bei den anderen Verdünnern.“"
                            },
                            {
                                "example_id": "2b524d24-139d-4cdf-8c7f-61508aca9b88",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Ein anderes Testverfahren ist der Schwelltest, der ebenfalls für die Charakterisierung der Fertilisationsfähigkeit der Spermatozoen empfohlen wird.“"
                            },
                            {
                                "example_id": "94220b5f-964f-44e6-8d87-0a6ecdf349e4",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Außerdem wurde die Funktion der Zellmembran der Spermien durch einen Spermatozoen- (hypoosmotischen) Schwelltest zusammen mit einem Eosintest bewertet.“"
                            },
                            {
                                "example_id": "74ec750a-49d0-42f0-8736-28ee86330e70",
                                "sense_id": "8d1ba52b-30b7-34eb-9ea2-8f202c923d0d",
                                "text": "„Der Schwelltest wies hingegen zwischen positiven und negativen Fertilisationen keinen Unterschied auf […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
