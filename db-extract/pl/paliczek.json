                                    },
                                    {
                                        "sense_id": "a0793bd6-75ac-30b5-bc16-760e48839438",
                                        "entry_id": "ba1d8bbd-53f3-3730-92d2-f6cd25cba457",
                                        "glosses": [
                                            "Any of the joints of an insect's tarsus."
                                        ],
                                        "tags": [],
