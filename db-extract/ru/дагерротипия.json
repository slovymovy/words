                                "target_senses": [
                                    {
                                        "sense_id": "080105ad-0025-3205-aa2f-535ec677c82e",
                                        "entry_id": "4460cd2a-fc82-37db-a502-093a8638e86c",
                                        "glosses": [
                                            "primitieve manier om foto's te maken waarbij een gepolijste, met kwikdampen geprepareerde plaat werd gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4385b9b-3b7d-4a52-a6a7-7860024e2aa1",
                                                "sense_id": "080105ad-0025-3205-aa2f-535ec677c82e",
                                                "text": "Voor toenmalige zogeheten daguerreotypie, waarvoor een gepolijste, verzilverd koperen plaat werd gebruikt, moesten de geportretteerden minutenlang stilzitten om het kiekje te doen slagen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c57248a6-d837-30ea-b28a-7afb5dd3041c",
                                        "entry_id": "4460cd2a-fc82-37db-a502-093a8638e86c",
                                        "glosses": [
                                            "primitieve foto waarbij een gepolijste, met kwikdampen geprepareerde plaat is gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0772f6b-3b01-4d79-8a34-c0137a85f687",
                                                "sense_id": "c57248a6-d837-30ea-b28a-7afb5dd3041c",
                                                "text": "De oudst bekende daguerreotypie uit Suriname is een portret van de ouders van Ellis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
