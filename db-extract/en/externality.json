                                "target_senses": [
                                    {
                                        "sense_id": "4e7b69cf-16f8-3333-82f5-cc8d393a8be2",
                                        "entry_id": "afb3453c-d2b8-3f6e-ac82-448b5813c08b",
                                        "glosses": [
                                            "Effet positif ou négatif de l’activité d’une organisation ou d’une personne sur l’environnement humain, naturel ou économique."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Développement durable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d70c5f0-7b90-4083-a2d9-f992732b12fa",
                                                "sense_id": "4e7b69cf-16f8-3333-82f5-cc8d393a8be2",
                                                "text": "La pollution sous toutes ses formes est une exemple typique d'externalité négative: lorsqu'une usine rejette des déchets dans l'environnement, elle inflige, sans contrepartie, une nuisance aux habitants de la région."
                                            },
                                            {
                                                "example_id": "fb602bbe-7827-4169-a467-245677fc5a64",
                                                "sense_id": "4e7b69cf-16f8-3333-82f5-cc8d393a8be2",
                                                "text": "L'ensemble de ces coûts, considérés comme des externalités, pourrait être estimé « avec un degré raisonnable de précision. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
