                                                "sense_id": "17b89512-fe62-332c-b436-ae7f99dfffa6",
                                                "text": "He blew every last cent."
                                            },
                                            {
                                                "example_id": "b8efd44c-faca-4b34-b80e-4c445518925a",
                                                "sense_id": "17b89512-fe62-332c-b436-ae7f99dfffa6",
                                                "text": "Every cent aside from his own expenses for the barest kind of living went to his down-and-out buddies."
                                            }
                                        ]
                                    },
