                        "source_entry_id": "0b03a3b4-4279-3517-9993-a23e2fd8df57",
                        "source_sense_id": "c3b18454-7041-3080-a96e-c3665419c155",
                        "target_lang_word": "ло́бзик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ло́бзик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c0470ce1-50f7-3a46-a7ba-2afe60d4375d",
                                        "entry_id": "707ab7c0-22c4-32a6-9129-223df854f02e",
                                        "glosses": [
                                            "инструмент с тонкой пилкой для узорного выпиливания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ff63f2-a040-4bb8-b802-bc2a916fb8dc",
                                                "sense_id": "c0470ce1-50f7-3a46-a7ba-2afe60d4375d",
                                                "text": "Прежде чем пилить лобзиком термопластичный материал, нанесите на контур будущего пропила слой машинного масла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a83d05d-755c-3629-b15c-0d162fabe46e",
                                        "entry_id": "707ab7c0-22c4-32a6-9129-223df854f02e",
                                        "glosses": [
                                            "то же, что электролобзик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44978895-e0b6-44a1-a827-9baec3b620f3",
                                                "sense_id": "8a83d05d-755c-3629-b15c-0d162fabe46e",
                                                "text": "Лютую зависть вызывают у меня эти стиральные и посудомоечные машины новейших фасонов, электрические пилы, лобзики, дрели и шлифовальные машины, кухонные комбайны, садовые тракторы и мотоблоки, похожие на аппаратуру иллюзионистов в цирке ― никель и яркая краска."
                                            },
                                            {
                                                "example_id": "dfd2c78c-7dbe-4ef7-8c6e-aa05886ff166",
                                                "sense_id": "8a83d05d-755c-3629-b15c-0d162fabe46e",
                                                "text": "Вам необходимо пользоваться такими электрическими инструментами, как лобзик, плоскошлифовальная машинка, циркулярная пила, и при этом ― не наполнить квартиру пылью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
