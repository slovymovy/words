                                            {
                                                "example_id": "359aaee3-0794-4c27-b171-2d741a3efa16",
                                                "sense_id": "eb33a549-20ed-36e5-a91b-4606126df882",
                                                "text": "На женины деньги, что взял в приданое, и купил-то их… бельё, рубашки вышитые, платочки носовые, полотенчики…"
                                            },
                                            {
                                                "example_id": "d0ccbe46-a3c0-4209-aedf-cdab5c50fb35",
                                                "sense_id": "eb33a549-20ed-36e5-a91b-4606126df882",
                                                "text": "На вот, утрись полотенчиком… дешёвые у тебя слёзы."
                                            },
                                            {
                                                "example_id": "c6974da1-9d47-4b8e-8ead-bb18b673a9a0",
                                                "sense_id": "eb33a549-20ed-36e5-a91b-4606126df882",
                                                "text": "Раковина была чистенькая, блестящая, и полотенчико было пристроено рядом, свежее и, кажется, даже крахмальное."
                                            }
                                        ]
                                    }
