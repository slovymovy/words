                "translations": [
                    {
                        "translation_id": "f1ed0d38-4050-4ed0-ac76-affb55413f66",
                        "source_entry_id": "13310229-ea07-3643-b82a-d82473d1f3f8",
                        "source_sense_id": "9cd12d93-5c11-388c-8a81-c9aa76eb43f4",
                        "target_lang_word": "lilith",
