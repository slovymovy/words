                                                "example_id": "fb5b3593-61a0-41e9-b7b1-4550d7eb5bd1",
                                                "sense_id": "ab5f40ee-e18a-3b72-97b6-f39e9eae5cfa",
                                                "text": "— А у тебя чердак не слетел, подруга?"
                                            }
                                        ]
