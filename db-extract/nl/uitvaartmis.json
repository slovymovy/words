                            {
                                "example_id": "bfced3a7-e257-4ecd-9da1-b160b670a456",
                                "sense_id": "72279a2d-b5e6-34f1-a6e3-8b2211428587",
                                "text": "Ze liet uitvaartmissen lezen die pasten bij een ridder van zijn aanzien."
                            },
                            {
                                "example_id": "01ab8412-4492-4bf4-a73f-96f09f0fe6e6",
                                "sense_id": "72279a2d-b5e6-34f1-a6e3-8b2211428587",
                                "text": "Om 09.30 uur begon de uitvaartmis. Formeel werd deze door paus Franciscus (86) geleid, maar vanwege zijn gezondheidstoestand nam kardinaal Battista Re de meeste taken op zich. Franciscus kan vanwege knieproblemen niet lang staan. Daarom zat hij op een zetel, vlak bij de kist van zijn voorganger."
                            }
