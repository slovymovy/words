                "senses": [
                    {
                        "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                        "entry_id": "011829ee-debf-3ad3-89f6-3309fe64226a",
                        "glosses": [
                            "Miniaturgestalt, vor allem als beliebte Spielgefährtin und Spielzeug von Mädchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaaee7a1-9824-4612-81ed-9faa7f502a12",
                                "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                                "text": "„Anna Freud schreibt die Anfänge Melanie Klein zu, die mit Spielpuppen in der Diagnose und Behandlung von emotional gestörten Kindern arbeitete.“"
                            },
                            {
                                "example_id": "2f39a4e8-2113-4bf4-8d96-c2c7877c3044",
                                "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                                "text": "„Dann nämlich wird endlich in der Donauwörther Betriebsstätte ein Museum eröffnet, das die ersten Puppenstubenpuppen, die Käthe Kruse für ihre Kinder gefertigt hat, wie auch alte Käthe Kruse Spielpuppen vereinen soll.“"
                            },
                            {
                                "example_id": "fae47703-cc3e-4b8b-8f97-88559cd74bf6",
                                "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                                "text": "„Die Budapester Puppenspieler wagten sich an Bartók und Beckett,Llords International aus Kalifornien an den Feuervogel; exotischer Gast war bisher das Wayang Kulit-Schattentheater aus Malaysia, einer der charmantesten André Tahon, und das, obwohl dieser Pariser Künstler sich auf die primitivste Form von Spielpuppen spezialisiert hat, auf die marottes, die aus nichts weiter als einem Kopf und drei Stäben bestehen.“"
                            },
                            {
                                "example_id": "37817daf-37bb-4b9d-b516-3319bc1f2a7f",
                                "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                                "text": "„Vor allem anhand von privaten Quellen […] hat Brigitte Hamann versucht, das Wahnfried-Leben in der NS-Zeit zu rekonstruieren - mit bizarren Details, wenn Winifreds Kinder bei Hans von Wolzogen den Text für ein Nazikasperlestück bestellen und Wolfgang sich einen Juden als Spielpuppe zulegt mit einem herrlichen Zinken.\""
                            },
                            {
                                "example_id": "60b7af62-f107-477a-a149-c7a89cee5973",
                                "sense_id": "48d000b8-140e-3cd7-8367-1d4251c2e89d",
                                "text": "„Wie aus Stoff, Wolle und Lederresten Zier- und Spielpuppen entstehen können, lernt man bei Christa Guardia in 5927 Erndtebrück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0353d605-33b4-3257-b579-0b9fc9370e22",
                        "entry_id": "011829ee-debf-3ad3-89f6-3309fe64226a",
                        "glosses": [
                            "Figur des Puppentheaters oder Jahrmarkts"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9072dc96-32be-33cd-af79-2fbe5fee4f86",
                        "entry_id": "011829ee-debf-3ad3-89f6-3309fe64226a",
                        "glosses": [
                            "manipulierbarer, fremdgesteuerter Mensch"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e4cd671c-8645-41f4-b656-2b996546d5c0",
                                "sense_id": "9072dc96-32be-33cd-af79-2fbe5fee4f86",
                                "text": "„Die Pessimisten sehen in ihm eine Spielpuppe in Putins Hand, die Optimisten einen liberalen Präsidenten mit selbstbestimmtem Programm.“"
                            },
                            {
                                "example_id": "80f53e50-74dd-4577-9753-1f46561df5bb",
                                "sense_id": "9072dc96-32be-33cd-af79-2fbe5fee4f86",
                                "text": "„Tatsächlich verblüfft, wie selbstverständlich Foreman unseren Fritz als seine Spielpuppe vereinnahmt.“"
                            },
                            {
                                "example_id": "a19aaf62-2ce5-438d-b7e5-397e57008fe6",
                                "sense_id": "9072dc96-32be-33cd-af79-2fbe5fee4f86",
                                "text": "„Steffilein war damals anderthalb Jahre alt und wurde ebenfalls gern als exotische Spielpuppe abgeholt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
