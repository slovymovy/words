                                            {
                                                "example_id": "640fc7f0-7e3f-48ae-9206-c3375081fa64",
                                                "sense_id": "cd7ba0f9-4636-34a6-84a1-3eaecb4362f7",
                                                "text": "Er erinnerte sich wehmütig seiner ersten Liebe."
                                            },
                                            {
                                                "example_id": "3a163a54-fb4f-4ddf-889c-6ee4a859dcbe",
                                                "sense_id": "cd7ba0f9-4636-34a6-84a1-3eaecb4362f7",
                                                "text": "Wenn er trank, wurde er wehmütig."
                                            }
                                        ],
