        "fr-extract.jsonl": [
            {
                "entry_id": "88d4ad65-3aa5-36e1-b2ff-6e5321bc0a2f",
                "word": "processionnellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "571e2c2d-88ae-30be-b2e9-38d14fba98f8",
                        "entry_id": "88d4ad65-3aa5-36e1-b2ff-6e5321bc0a2f",
                        "glosses": [
                            "En procession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd415e3f-ad16-4e10-88fe-5f5d7609f009",
                                "sense_id": "571e2c2d-88ae-30be-b2e9-38d14fba98f8",
                                "text": "Le régal était médiocre, mais il fut assaisonné de tant d’éclats de rire et de plaisanteries sur la fureur comique de l’hôtelier voyant son monde sortir processionnellement, et sur le sort des malheureux à qui il ne manquerait pas de représenter ses poulets étiques rafraîchis pour la troisième fois par un tour de poêle, que nous fûmes dédommagés, et au-delà, de la maigreur de la chère."
                            },
                            {
                                "example_id": "73c84896-bf71-4ffc-b0c1-b73c67e191fe",
                                "sense_id": "571e2c2d-88ae-30be-b2e9-38d14fba98f8",
                                "text": "Ils évoquèrent l’orage l’un après l’autre, et du fond de mon lit je comptai avec épouvante douze voix qui traversèrent processionnellement les ténèbres."
                            },
                            {
                                "example_id": "7698d897-c8a2-4cb9-a56e-1f7730a71ce5",
                                "sense_id": "571e2c2d-88ae-30be-b2e9-38d14fba98f8",
                                "text": "Au bord de la mer, il entendit, vers le soir, le chant lugubre des prêtres qui étaient venus chercher processionnellement le corps de sa mère."
                            },
                            {
                                "example_id": "907ce3a1-6d87-4cda-8f50-8c34008ce874",
                                "sense_id": "571e2c2d-88ae-30be-b2e9-38d14fba98f8",
                                "text": "Des collègues traversaient le hall, les fesses serrées. M. le censeur se rendait processionnellement chez le concierge, qui le saluait jusqu’à terre. Des parents d’élèves s’inclinaient devant des professeurs qui leur rendaient leurs courbettes."
                            }
                        ]
                    }
                ],
