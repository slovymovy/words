                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_form",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Слушай, <w>Петь</w>, помоги мне с этой задачей.",
