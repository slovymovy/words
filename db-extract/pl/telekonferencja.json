                        "examples": [
                            {
                                "example_id": "0a884369-c5b7-4014-b977-d9174c671960",
                                "sense_id": "1c8dd18b-6612-33c6-bf02-51720c9ae3e5",
                                "text": "Choć najwyższe organy państwa i firmy przechodzą, na ile mogą, na telekonferencje i zdalną obsługę klientów, a część szkół prowadzi zajęcia przez internet za pomocą bezpłatnych narzędzi, to kłopotów jest sporo"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
