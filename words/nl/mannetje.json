                {
                    "sense_id": "d32f5a3e-3620-3398-8c6b-1a24b0866aa7",
                    "sense_definition": "Iemand die klusjes doet, vaak informeel of zwart betaald.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "handyman",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ken wel een <w>mannetje</w> dat je auto goedkoop kan repareren.",
                            "target_lang_translations": {
                                "en": "I know a <w>guy</w> who can repair your car cheaply.",
                                "ru": "Я знаю одного <w>человечка</w>, который может недорого починить твою машину.",
                                "pl": "Znam pewnego <w>fachowca</w>, który tanio naprawi twój samochód.",
                                "de": "Ich kenne da einen <w>Kontakt</w>, der dein Auto günstig reparieren kann.",
                                "fr": "Je connais un <w>type</w> qui peut réparer ta voiture pour pas cher.",
                                "it": "Conosco un <w>tizio</w> che può riparare la tua auto a poco prezzo.",
