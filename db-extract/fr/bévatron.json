                        "cross_references": [
                            {
                                "target_word": "bevatron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00973dc5-ea71-3511-94bc-56fb09af4dd8",
                                        "entry_id": "a0d3999e-cdf9-393e-aae7-731d7eb265f9",
                                        "glosses": [
                                            "A particle accelerator of the 1950s, capable of imparting energies of billions of electron volts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa2d0e3-6bab-45a1-a12a-075c760e3c2f",
                                                "sense_id": "00973dc5-ea71-3511-94bc-56fb09af4dd8",
                                                "text": "Dr. Ernest O. Lawrence, the inventor of the cyclotron, revealed the plans for one of these machines recently at the Sheffield centennial at Yale. It will be called a bevatron."
                                            },
                                            {
                                                "example_id": "60c81b96-51ff-405a-969f-b58870f20367",
                                                "sense_id": "00973dc5-ea71-3511-94bc-56fb09af4dd8",
                                                "text": "By pursuing this option her physicists had the best of both worlds: they could have access to a bevatron without disrupting their domestic programme."
                                            },
                                            {
                                                "example_id": "6194e313-d6d3-4705-aa20-2a7553046258",
                                                "sense_id": "00973dc5-ea71-3511-94bc-56fb09af4dd8",
                                                "text": "In his science fiction novel, Eye in the Sky, a group of visitors fall through a proton beam when an observation platform breaks at a bevatron facility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
