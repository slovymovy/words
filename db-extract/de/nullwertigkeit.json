                ],
                "senses": [
                    {
                        "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                        "entry_id": "fe5f8703-1d0b-3a2f-b00a-c9eba1df523f",
                        "glosses": [
                            "Eigenschaft, keinen Wert zu besitzen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "21c5ae52-88ae-40e8-be0a-7cf325af243f",
                                "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                                "text": "„Sein Streben, seine positiven Tendenzen, seine Ideale und Sehnsüchte tendieren zur Nullwertigkeit.“"
                            },
                            {
                                "example_id": "420259c6-3880-4425-adf0-fddbe3c2098f",
                                "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                                "text": "„Zudem wird ein Akteur eine Handlungsalternative mit Nullwertigkeit und/oder Nullwahrscheinlichkeit nicht weiter beachten, soferner eine Alternative sieht, die ihm einen positiven Nutzenwert beschert.“"
                            },
                            {
                                "example_id": "125d5111-d99d-45e3-9b5c-929125362d94",
                                "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                                "text": "„Die geistige Anspruchslosigkeit der Interviewsequenz zeigt die Nullwertigkeit von Nachrichten.“"
                            },
                            {
                                "example_id": "3dd04bb4-a1a0-4669-bf7f-2c7b0c305d29",
                                "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                                "text": "„Der Islamismus nutzt die geringe Eigenwertigkeit der Glaubensbrüder und die Nullwertigkeit des Restes der Menschheit schonungslos aus, indem er alle Bewohner westlicher Länder zu Ungläubigen macht […].“"
                            },
                            {
                                "example_id": "f9561b15-f4c7-4a2a-8362-8db4bc2615b2",
                                "sense_id": "de1d8158-5446-3545-be44-0a98b61b609f",
                                "text": "„Eine Besteuerung nach der Leistungsfähigkeit läuft jetzt darauf hinaus, daß Einkommen unterhalb des Existenzminimums wegen der Nullwertigkeit der personellen Wohlfahrtsfunktion im ersten Abschnitt nicht verkürzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                        "entry_id": "fe5f8703-1d0b-3a2f-b00a-c9eba1df523f",
                        "glosses": [
                            "Eigenschaft, keinen Aktanten zu haben"
                        ],
                        "tags": [
                            "bei einem Verb"
                        ],
                        "examples": [
                            {
                                "example_id": "66bc6fff-b766-4296-be3e-6d3d25546ecf",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Von Avalenz (Nullwertigkeit) geht der Weg über Monovalenz (Einwertigkeit) zu höherer Wertigkeit durch Kombination mit Ursache-/Wirkungs-Aktanten und -Relationen.“"
                            },
                            {
                                "example_id": "15bafa10-a9d4-49fa-b966-3bf29f210d40",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Wird nun ein Verb z.B. durch ung-Derivation substantiviert, so wird seine Valenz meist nicht auf Nullwertigkeit reduziert. Die semantische Valenz kann beibehalten werden, so wie die Bedeutung des Verbs überhaupt.“"
                            },
                            {
                                "example_id": "a718859b-dcce-4f49-877f-ea91acd742dd",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Eine vergleichbare Verbgruppe , für die Pilawa keine Belege findet und für die die Bezeichnung der Nullwertigkeit besonders angebracht ist, sind die Witterungsverben.“"
                            },
                            {
                                "example_id": "602afe14-c61c-43d4-acc8-28f41eda4397",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Die syntaktische Valenz der untersuchten Phraseologismen reicht von der Nullwertigkeit bis zu einer Dreiwertigkeit.“"
                            },
                            {
                                "example_id": "e45d7acc-7b70-4f64-89a2-b8de6ba8815c",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Als eine Angelegenheit des Wörterbuchs aufgefaßt und deshalb ausgelassen wurde auch die gesamte Problematik der Valenz, so daß die Nullwertigkeit von Verben gegenüber der Einwertigkeit bzw. die Einwertigkeit gegenüber der Zweiwertigkeit usf. nicht als grammatische Leerstellen in der Systematisierung erscheinen.“"
                            },
                            {
                                "example_id": "31e9c56f-0911-4206-8373-e598ae3ba655",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„Die Witterungsverben und ähnliche Verbtypen, bei denen mit Recht inhaltliche Nullwertigkeit angenommen wird, besetzen offenbar überhaupt keine Kasusrollen.“"
                            },
                            {
                                "example_id": "7cb22be6-e5da-44c7-92d3-4fbcccea47b1",
                                "sense_id": "3df93159-4021-3ae0-8ec6-6a18e0699888",
                                "text": "„So meint Pustet (1997: 43) zum Passiv von Intransitiva im Nahuatl: ‚Die Valenz von Intransitiva wird auf Nullwertigkeit reduziert; dies ermöglicht es, einen Sachverhalt ohne jegliche Bezugnahme auf seine(n) Partizipanten darzustellen.‘“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                        "entry_id": "fe5f8703-1d0b-3a2f-b00a-c9eba1df523f",
                        "glosses": [
                            "Eigenschaft, keine Bindung mit einem anderen Atom einzugehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c190cae6-54f5-41c9-9655-14c80f4a7d16",
                                "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                                "text": "„Die Verbrennung von Schwefel mit Sauerstoff liefert z. B. Schwefeldioxid , SO2, wobei der Schwefel aus seiner Nullwertigkeit in die positiv vierwertige Oxydationsstufe übergeht.“"
                            },
                            {
                                "example_id": "a4c8e86c-3889-490a-af5d-036808a15dbb",
                                "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                                "text": "„Dies bedingt die Nullwertigkeit und chemische Trägheit der Edelgase.“"
                            },
                            {
                                "example_id": "7786d85d-dab9-4d70-a0ed-b3c7f3cc073b",
                                "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                                "text": "„Von der hypothetischen Nullwertigkeit des Heliums usf. erlaube ich mir hier abzusehen.“"
                            },
                            {
                                "example_id": "3e30dde2-9e9d-4a8d-811a-46f4f489418d",
                                "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                                "text": "„Die Nullwertigkeit gewisser Atome (Quecksilbergas) wird durch die Bewegungsverhältnisse derartiger Moleküle bei der hohen Temperatur erklärt, bei welcher die Äusserung chemischer Verwandtschaft nicht mehr zum Ausdruck kommt.“"
                            },
                            {
                                "example_id": "06c1a8c9-146e-4f01-b35c-d6ec354bc6e7",
                                "sense_id": "5a5300c7-4295-37cb-85ac-98ddf158012c",
                                "text": "„Die Wertigkeiten der Elemente schwanken zwischen Nullwertigkeit und Achtwertigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
