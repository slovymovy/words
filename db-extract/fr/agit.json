                    {
                        "sense_id": "57bc965d-14f5-3f09-9135-13b5175a77a4",
                        "entry_id": "6a930236-e331-34b4-b998-ba24a43bc32a",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent de agir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e7478c1d-bb8c-4c4a-94bf-359110f072cd",
                                "sense_id": "57bc965d-14f5-3f09-9135-13b5175a77a4",
                                "text": "L’acide arsénieux est un des poisons les plus violents ; il agit comme tel sur toutes les classes des animaux et sur les plantes."
                            },
                            {
                                "example_id": "96546833-2187-4d6f-8ade-c3dd1667c4da",
                                "sense_id": "57bc965d-14f5-3f09-9135-13b5175a77a4",
                                "text": "Pas de blague, les copains ! s’agit de se dégrouiller et de regarder où le pante s’en va…"
                            },
                            {
                                "example_id": "2314bc52-bba7-4b55-b4b7-98e932f637a9",
                                "sense_id": "57bc965d-14f5-3f09-9135-13b5175a77a4",
                                "text": "Il ne s’agit pas de rien pousser au noir. Il s’agit de prendre des précautions."
                            }
                        ]
                    },
                    {
                        "sense_id": "358a6ca5-5379-3156-a932-2f32b945b246",
