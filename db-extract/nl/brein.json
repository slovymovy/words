                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a98debf-cf35-3c88-82db-a12fcc9cb1cf",
                        "entry_id": "faafb23e-3866-3591-b74e-6bdf74440906",
                        "glosses": [
                            "orɡaan in de schedel dat het denkvermogen herbergt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3782799a-a282-4677-ab1d-dc1bba9b1f36",
                                "sense_id": "2a98debf-cf35-3c88-82db-a12fcc9cb1cf",
                                "text": "Wat gaat er om in je brein, wanneer je dat meemaakt?"
                            },
                            {
                                "example_id": "97a5e383-6453-47db-ac6c-c6bf6fdd92b4",
                                "sense_id": "2a98debf-cf35-3c88-82db-a12fcc9cb1cf",
                                "text": "Het ritme van het lopen met soms wel 70.000 stappen per dag vormde een innerlijke kadans, waarvan sommige wetenschappers beweren dat er op deze manier een inventieve samenwerking ontstaat tussen de twee helften van je brein."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5dd1c49-6e47-3aed-97a6-bb46fe745acb",
                        "entry_id": "faafb23e-3866-3591-b74e-6bdf74440906",
                        "glosses": [
                            "iemand met een goed denkvermogen wiens denken achter een bepaalde organisatie of gebeurtenis te zoeken is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5040587e-319e-43b8-9c2b-49596911a4e2",
                                "sense_id": "a5dd1c49-6e47-3aed-97a6-bb46fe745acb",
                                "text": "Hij was het brein van die bende misdadigers."
                            },
                            {
                                "example_id": "064d881d-5d6d-4fa6-9d69-3ffa48c3eba6",
                                "sense_id": "a5dd1c49-6e47-3aed-97a6-bb46fe745acb",
                                "text": "Brein achter omstreden Zweedse coronastrategie geeft fouten toe"
                            }
                        ]
                    },
                    {
                        "sense_id": "e04e0bc0-ab82-322d-9cbd-fe5c44ff559d",
                        "entry_id": "faafb23e-3866-3591-b74e-6bdf74440906",
                        "glosses": [
                            "het verstand, het geestvermogen dat zetelt in de hersenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5b4f13-0683-4dde-8e01-4db13faaa788",
                                "sense_id": "e04e0bc0-ab82-322d-9cbd-fe5c44ff559d",
                                "text": "Een brein kun je niet opereren, in het brein zit geen tumor of een bloeding: dat kan allemaal wel met de hersenen."
                            },
                            {
                                "example_id": "068b3ef6-e687-4583-9eff-897452091e5f",
                                "sense_id": "e04e0bc0-ab82-322d-9cbd-fe5c44ff559d",
                                "text": "Haar brein zoekt naar woorden, maar die ontglippen haar als ze ze probeert te pakken."
                            },
                            {
                                "example_id": "88d62b9c-edfe-49ed-bf65-90048d0ebb47",
                                "sense_id": "e04e0bc0-ab82-322d-9cbd-fe5c44ff559d",
                                "text": "Het is te veel om het allemaal te bevatten - haar brein zoemt eromheen en probeert erin door te dringen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d078986d-765e-4f9b-9099-4c8c920147ce",
                        "source_entry_id": "faafb23e-3866-3591-b74e-6bdf74440906",
                        "source_sense_id": "2a98debf-cf35-3c88-82db-a12fcc9cb1cf",
                        "source_sense_description": "orgaan",
                        "target_lang_word": "brain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dacd2e75-1d6a-3873-bea7-e9143cf91b76",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "The control center of the central nervous system of an animal located in the skull which is responsible for perception, cognition, attention, memory, emotion, and action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f9fa124-4667-4eaf-bc40-008356f0c726",
                                                "sense_id": "dacd2e75-1d6a-3873-bea7-e9143cf91b76",
                                                "text": "The Ueynes are ſpred foorth throughout the whole bodie, howbeit from one welhead, that is to ſay from the Liuer: ſo be the Sinews, howbeit from the Brayne; So likewiſe are the Heartſtrings, howbeit from the Heart."
                                            },
                                            {
                                                "example_id": "26b0d040-9251-4a05-8a46-57cf844935a1",
                                                "sense_id": "dacd2e75-1d6a-3873-bea7-e9143cf91b76",
                                                "text": "The brain of a calf, sheep, and pig, young and served fresh, is reputedly erotic in its effects."
                                            },
                                            {
                                                "example_id": "d364e265-2765-49ab-90cc-05007aeb4054",
                                                "sense_id": "dacd2e75-1d6a-3873-bea7-e9143cf91b76",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf7c68e-be92-3140-9e46-1ab3bbcac883",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "The control center of the central nervous system of an animal located in the skull which is responsible for perception, cognition, attention, memory, emotion, and action.",
                                            "A part of the brain, especially associated with particular mental functions, abilities, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db396de7-c6d6-4400-abeb-7642f2bb2d80",
                                                "sense_id": "dbf7c68e-be92-3140-9e46-1ab3bbcac883",
                                                "text": "The left brain, or that which supplies and animates the right side of the body, is the most active brain, as a general rule."
                                            },
                                            {
                                                "example_id": "53e11876-0d3a-4ea3-946f-af5633d4fcce",
                                                "sense_id": "dbf7c68e-be92-3140-9e46-1ab3bbcac883",
                                                "text": "What is expressed in the lotus, the plumed serpent, or the staff of Osiris is the yogi's knowledge of the three brains of man. The first brain is the reptilian brain of the spinal cord, the brain of instinctive reflexes, the brain of the subconscious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc07914f-2f58-33bc-8079-9618fcd2691a",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "Mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6caee54-84fe-4799-8cee-7f3b934f52ee",
                                                "sense_id": "cc07914f-2f58-33bc-8079-9618fcd2691a",
                                                "text": "I have too much on my brain today."
                                            },
                                            {
                                                "example_id": "ec45611d-1456-44cc-9cbb-c9b88c55047a",
                                                "sense_id": "cc07914f-2f58-33bc-8079-9618fcd2691a",
                                                "text": "And I should tell him all my pain, / ⁠And how my life had droop’d of late, / ⁠And he should sorrow o’er my state / And marvel what possess’d my brain; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c363f0-a83a-3318-9128-254232f446c8",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "Intellect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "572d914a-e698-4680-83cb-8ff4b1c5f556",
                                                "sense_id": "17c363f0-a83a-3318-9128-254232f446c8",
                                                "text": "\"We provided a lot of brains and a lot of heart to the response when it was needed,\" says Sandra Sanchez, director of AFSC's Immigrants' Voice Program in Des Moines."
                                            },
                                            {
                                                "example_id": "e7b5a9b9-197a-4dc0-b77e-221d73e9a413",
                                                "sense_id": "17c363f0-a83a-3318-9128-254232f446c8",
                                                "text": "She has a lot of brains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b844e25-3859-3daa-a96d-395f52a72684",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "An intelligent person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04d24e66-14f5-47a9-afad-c88429c4c474",
                                                "sense_id": "0b844e25-3859-3daa-a96d-395f52a72684",
                                                "text": "She was a total brain."
                                            },
                                            {
                                                "example_id": "9a078701-d391-46ea-8542-5354f8ce38f3",
                                                "sense_id": "0b844e25-3859-3daa-a96d-395f52a72684",
                                                "text": "Peebee: The brains and I are comparing Remnant notes and filling in the blanks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9fd33a-ac7b-3424-90a3-8f058abf7ab9",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "An intelligent person.",
                                            "A person who provides the intelligence required for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "plural",
                                            "plural-only",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c689b6-1e15-4629-8b69-11696f348fb5",
                                                "sense_id": "0c9fd33a-ac7b-3424-90a3-8f058abf7ab9",
                                                "text": "He is the brains behind the scheme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec4efde7-424b-3dec-9406-d2ce53633ea8",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "An intelligent person.",
                                            "An intellectual or mental capacity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0379fee-ca91-4775-9bd3-25222433872e",
                                                "sense_id": "ec4efde7-424b-3dec-9406-d2ce53633ea8",
                                                "text": "Gerald always acts like he doesn't have a brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d10f7eb-3b00-393a-86a3-be8b0205dc47",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "By analogy with a human brain, the part of a machine or computer that performs calculations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577e2d14-cac1-4558-b7e2-116cb10c6877",
                                                "sense_id": "6d10f7eb-3b00-393a-86a3-be8b0205dc47",
                                                "text": "The computer's brain is capable of millions of calculations a second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39069b3c-a7e3-3797-8743-f8ef53a6be2c",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "Oral sex."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13647b04-35b1-415a-b1c9-f63641fc71da",
                                                "sense_id": "39069b3c-a7e3-3797-8743-f8ef53a6be2c",
                                                "text": "Have you ever popped champagne on a plane, while gettin' some brain?"
                                            },
                                            {
                                                "example_id": "97352ac6-05e6-4e4d-a00a-36ecf38d7617",
                                                "sense_id": "39069b3c-a7e3-3797-8743-f8ef53a6be2c",
                                                "text": "You said I got brain from your dame in the range / In the passing lane / But you really ain't got no proof"
                                            },
                                            {
                                                "example_id": "59038f0b-9ed8-40b0-861c-aaaf639967a9",
                                                "sense_id": "39069b3c-a7e3-3797-8743-f8ef53a6be2c",
                                                "text": "Got your nigga going / Going insane and so do I when he give me brain"
                                            },
                                            {
                                                "example_id": "1315896c-d558-453a-ad61-059b02f8ec8d",
                                                "sense_id": "39069b3c-a7e3-3797-8743-f8ef53a6be2c",
                                                "text": "She giving brain / She eat the dick up like some M&Ms"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c66ab3a-7b9f-33eb-bee0-38603ebdd097",
                                        "entry_id": "76e98c5b-9ba2-3095-b04f-f2c28fdb8dc4",
                                        "glosses": [
                                            "A loose compartment of a backpack that straps on over the top opening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5a6b1b4-27d6-352b-8abe-7df825f4d58e",
                                        "entry_id": "32570637-4e53-3de0-8211-76748f4c20b1",
                                        "glosses": [
                                            "To dash out the brains of; to kill by smashing the skull."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23fabdce-83fd-32ee-9a06-c983844f7b41",
                                        "entry_id": "32570637-4e53-3de0-8211-76748f4c20b1",
                                        "glosses": [
                                            "To strike (someone) on the head."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5352056-10ac-4549-b2d7-b84aae1c745f",
                                                "sense_id": "23fabdce-83fd-32ee-9a06-c983844f7b41",
                                                "text": "Lambdon would require medical attention for a fractured skull. It seemed that Fen had passed his wife a couple of telling pictures, whereupon the drab Mrs. Lambdon had brained her husband with a table lamp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4319e8bb-71cd-3e11-9428-87873f7431d7",
                                        "entry_id": "32570637-4e53-3de0-8211-76748f4c20b1",
                                        "glosses": [
                                            "To destroy; to put an end to."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4154e8af-230a-4ed3-9d41-7fb4cc58a663",
                                                "sense_id": "4319e8bb-71cd-3e11-9428-87873f7431d7",
                                                "text": "There thou maiſt braine him,"
                                            },
                                            {
                                                "example_id": "3d36049d-080c-4f9c-bb4f-d3de92c1febd",
                                                "sense_id": "4319e8bb-71cd-3e11-9428-87873f7431d7",
                                                "text": "It was the ſwift celeritie of his death / […] That brain'd my purpoſe:"
                                            },
                                            {
                                                "example_id": "9b0c91ef-1553-45bf-a96a-afa024b0c746",
                                                "sense_id": "4319e8bb-71cd-3e11-9428-87873f7431d7",
                                                "text": "He was going on with some wild reminiscences about his tomahawk-pipe, which, it seemed, had in its two uses both brained his foes and soothed his soul, when we were directly attracted to the sleeping rigger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7b694c-3d4c-3941-ab97-4b427fe8373e",
                                        "entry_id": "32570637-4e53-3de0-8211-76748f4c20b1",
                                        "glosses": [
                                            "To conceive in the mind; to understand."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a66850-c46a-4de2-a018-e7e01e20303c",
                                                "sense_id": "ed7b694c-3d4c-3941-ab97-4b427fe8373e",
                                                "text": "'Tis still a dream, or else such stuff as madmen / Tongue, and brain not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83afc5af-1378-37df-b78c-ab642cadbbb2",
                                        "entry_id": "32570637-4e53-3de0-8211-76748f4c20b1",
                                        "glosses": [
                                            "To think effectively."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "intransitive",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea2c47be-4f4c-45fe-8289-53b3c8485577",
                                                "sense_id": "83afc5af-1378-37df-b78c-ab642cadbbb2",
                                                "text": "My brain isn't braining right now."
                                            }
                                        ]
                                    }
                                ]
                            }
