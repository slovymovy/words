                                "target_senses": [
                                    {
                                        "sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                                        "entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                                        "glosses": [
                                            "bode die vooruitgestuurd is om de komst van iets of iemand aan te kondigen, voorloper ,aankondiger"
                                        ],
                                        "tags": [
                                            "beroep",
                                            "letterlijk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8698b2d6-ecd6-42f8-aabe-984692273709",
                                                "sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                                                "text": "De voorbode kondigde de komst van de koning en de koningin aan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcff1451-8ee0-3749-b111-91113872f995",
                                        "entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                                        "glosses": [
                                            "iets dat het naderen van een feit in de toekomst bekend maakt, voorteken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adba7196-d87b-4984-8f39-9a2fd87f7a3f",
                                                "sense_id": "dcff1451-8ee0-3749-b111-91113872f995",
                                                "text": "De herfst kan als de voorbode van de winter gezien worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6bc4b23-755a-4640-937a-f12c0b5c48fe",
                        "source_entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "source_sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                        "target_lang_word": "voorspelling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorspelling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5806fa39-0356-3845-b68e-13e3c8d6d403",
                                        "entry_id": "4d8a7f04-c4ab-38a7-954d-ac3f21f9fab7",
                                        "glosses": [
                                            "een uitspraak over iets wat in de toekomst zou kunnen gebeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8da6a0-e6f5-45dc-868f-231bcb50ea3a",
                                                "sense_id": "5806fa39-0356-3845-b68e-13e3c8d6d403",
                                                "text": "Zijn voorspelling is toch nog uitgekomen."
                                            },
                                            {
                                                "example_id": "b8a69e51-f561-456e-a4c1-54442bb7d9bf",
                                                "sense_id": "5806fa39-0356-3845-b68e-13e3c8d6d403",
                                                "text": "Ook kwam hij terug op de favorietenrol die hem vanaf het begin werd toegedicht. ,,Ik heb die voorspellingen nooit beschouwd als waarheden. Het waren voorspellingen, meer niet."
                                            },
                                            {
                                                "example_id": "befff882-5ec8-4697-a5b2-497b732134e3",
                                                "sense_id": "5806fa39-0356-3845-b68e-13e3c8d6d403",
                                                "text": "De voorspellingen zijn goed: met 18 graden en een aardig lentezonnetje belooft het donderdag een heerlijke Bevrijdingsdag te worden. Het festival op de Universiteit Twente - Bevrijdingsdag Enschede - is stijf uitverkocht."
                                            },
                                            {
                                                "example_id": "24900df8-0f3d-4717-a85e-f3332501ea86",
                                                "sense_id": "5806fa39-0356-3845-b68e-13e3c8d6d403",
                                                "text": "Want nadat hij terugkeerde van de Hardangervidda, en de Spoorlijn tegen alle voorspellingen van de zogenaamde kenners in werkelijkheid was geworden, zou zijn leven nooit meer hetzelfde zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
