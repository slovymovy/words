                "senses": [
                    {
                        "sense_id": "c369c590-7b65-38a3-96bc-23229b0f6705",
                        "entry_id": "fbc421af-46b2-3cc3-93a9-deb126addad9",
                        "glosses": [
                            "Not pursued, not followed, not hounded."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc0ffb8e-e1a0-4f47-bcad-b0547548f6f5",
                                "sense_id": "c369c590-7b65-38a3-96bc-23229b0f6705",
                                "text": "All night the dreadless Angel, unpursu’d,\nThrough Heav’ns wide Champain held his way; till Morn,\nWak’t by the circling Hours, with rosie hand\nUnbarr’d the gates of Light."
                            },
                            {
                                "example_id": "9232b0f6-51a1-4986-9e1a-668d0b717e0f",
                                "sense_id": "c369c590-7b65-38a3-96bc-23229b0f6705",
                                "text": "1740, Samuel Johnson, “Debate on incorporating the new-raised men into the standing regiments” in The Works of Samuel Johnson, London: John Stockdale, 1787, Vol. 12, Debates in Parliament, p. 62,\nAt Guastalla, Sir, they attacked the French in their trenches, even with forces inferiour in number, so far were they from any diffidence in the form of their establishment; and after a fight of seven hours, in which their loss was, under all their disadvantages, not greater than that of their enemies, they retreated to their former camp unmolested and unpursued."
                            },
                            {
                                "example_id": "b4d519d7-33e3-4bea-830b-b3ae22e3d347",
                                "sense_id": "c369c590-7b65-38a3-96bc-23229b0f6705",
                                "text": "With doubtful patriotism he left the Danes for a while unpursued, attacked Meath, overran and wasted Connaught, and returning suddenly burnt the royal stronghold of Tara."
                            }
                        ]
                    },
                    {
                        "sense_id": "9535737c-7033-3938-9046-a7e652f03e13",
                        "entry_id": "fbc421af-46b2-3cc3-93a9-deb126addad9",
                        "glosses": [
                            "Not pursued, not sought, not engaged in."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5b6efa4-c42a-4983-9550-9b8063ce58e0",
                                "sense_id": "9535737c-7033-3938-9046-a7e652f03e13",
                                "text": "[…] And thus the soul,\nBy that sweet taste of pleasure unpursu’d\nDoth find itself insensibly dispos’d\nTo virtue and true goodness."
                            },
                            {
                                "example_id": "087968e0-8b8f-4a1b-a710-c2a7bddb20a6",
                                "sense_id": "9535737c-7033-3938-9046-a7e652f03e13",
                                "text": "Our pleasures unpursued age past recall."
                            }
                        ]
                    }
