                    {
                        "translation_id": "cf59d677-39f4-409a-b562-7dc65b03c810",
                        "source_entry_id": "3e34730b-43f7-3600-9ce5-7d292202343d",
                        "source_sense_id": "f04fb129-289d-36df-99f0-c8042244a97b",
                        "source_sense_description": "iemand die de paarden van een koets ment",
                        "target_lang_word": "Kutscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kutscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                        "entry_id": "f7a707d0-a04b-3328-93cf-90956f149aa3",
                                        "glosses": [
                                            "Person, die eine Kutsche lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a43f69ad-41d7-45f9-a278-5d71c5b9f0e6",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "Der Kutscher wartete mit der Kutsche vor dem Haus."
                                            },
                                            {
                                                "example_id": "0bd59405-ec27-4397-8791-7a34054f6946",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "„Mit einer Pferdedroschke fuhren wir nach Bordighera, es war kalt und dunkel, und der Kutscher legte Decken um uns.“"
                                            },
                                            {
                                                "example_id": "48e5d9d5-7b35-47d0-90f1-d22b99ba6a3e",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "Er wäre lieber Arzt als Kutscher geworden."
                                            },
                                            {
                                                "example_id": "387aba91-8039-48e9-ac42-98c14fd9e1d5",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "„Und zu der Sorge wegen der Kutscher war die Sorge um das Futter gekommen.“"
                                            },
                                            {
                                                "example_id": "b16e57f3-0a87-42e2-b746-5a99aebd71ca",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "„In der Gnojnastraße ließ er den Kutscher anhalten, weil Zirele nicht in einer Droschke zu Hause vorfahren wollte.“"
                                            },
                                            {
                                                "example_id": "a74babfe-3775-4aaf-8202-2e186afd08f8",
                                                "sense_id": "1e441f2c-6e59-3b63-b567-69d1a9d30933",
                                                "text": "„Seit siebzehn Jahren war Peter bei der Pferdebahn angestellt, seither war immer derselbe Kutscher im grauen Rock mit grünen Aufschlägen gekommen, hatte ihn angeschirrt und vor den großen, gelben Wagen gespannt, wie heute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
