                                    {
                                        "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                        "entry_id": "761c9c28-d204-3f6a-b6b9-ea8a5e9e5f70",
                                        "glosses": [
                                            "ein schnelles Segelboot mit Doppelrumpf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f0779a-c499-46ba-9b0a-b5dcfff74deb",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "Der Traum eines jeden Segler ist einfach beschrieben: ein Katamaran, viel Speed, eine professionelle Mannschaft und stundenlang auf einer Kufe oder auf den Schwertern auf freier See dahin fliegen, Tage und Wochen lang; Power rund um die Uhr ohne Halt!"
                                            },
                                            {
                                                "example_id": "a1b8e462-f611-4152-8ad3-bb59db8b1473",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "„Katamarane sind im Mittelmeer, der Karibik und auf den Routen der Weltumsegler aus gutem Grund weit verbreitet.“"
                                            },
                                            {
                                                "example_id": "115fc592-04fd-4a2d-a3f1-52a1b2947e1f",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "„Einen Ausflug auf einem Katamaran sollte man sich bei seinem Fuerteventura-Urlaub nicht entgehen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
