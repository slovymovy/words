{
    "word_family": [
        "trendy",
        "trendsetter",
        "trendiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b02141ec-1e49-327e-a12f-86003fbe1b53",
                    "sense_definition": "A fad or fashion style.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miniskirts were one of the biggest <w>trends</w> of the 1960s.",
                            "target_lang_translations": {
                                "ru": "Мини-юбки были одним из самых больших <w>трендов</w> 1960-х годов.",
                                "zh": "迷你裙是20世纪60年代最大的<w>潮流</w>之一。"
                            }
                        },
                        {
                            "text": "She likes to follow the latest <w>trends</w> in clothing and makeup.",
                            "target_lang_translations": {
                                "ru": "Ей нравится следовать последним <w>трендам</w> в одежде и макияже.",
                                "zh": "她喜欢追随服装和化妆方面的最新<w>时尚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fad",
                        "craze",
                        "vogue",
                        "fashion",
                        "style"
                    ],
                    "common_phrases": [
                        "latest trend",
                        "fashion trend",
                        "set the trend",
                        "current trend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Модное веяние или стиль; то, что популярно в данный момент.",
                        "zh": "一种流行的时尚或风格；当前受大众欢迎的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тренд",
                                "target_lang_sense_clarification": "актуальное направление моды"
                            },
                            {
                                "target_lang_word": "мода",
                                "target_lang_sense_clarification": "популярный стиль"
                            },
                            {
                                "target_lang_word": "веяние",
                                "target_lang_sense_clarification": "новое направление во вкусах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潮流",
                                "target_lang_sense_clarification": "流行的趋势或风尚"
                            },
                            {
                                "target_lang_word": "时尚",
                                "target_lang_sense_clarification": "流行的风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1d4f266-22ba-3461-929d-4a4b229b231d",
                    "sense_definition": "An inclination in a particular direction.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The upward <w>trend</w> of stock-market prices is good news for investors.",
                            "target_lang_translations": {
                                "ru": "Восходящая <w>тенденция</w> цен на фондовом рынке — хорошая новость для инвесторов.",
                                "zh": "股市价格的上涨<w>趋势</w>对投资者来说是个好消息。"
                            }
                        },
                        {
                            "text": "There is a worrying <w>trend</w> of rising temperatures across the globe.",
                            "target_lang_translations": {
                                "ru": "Наблюдается тревожная <w>тенденция</w> повышения температуры по всему земному шару.",
                                "zh": "全球气温上升的<w>趋势</w>令人担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tendency",
                        "drift",
                        "movement",
                        "shift",
                        "inclination"
                    ],
                    "common_phrases": [
                        "upward trend",
                        "downward trend",
                        "general trend",
                        "buck the trend",
                        "economic trend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонность или направление развития чего-либо.",
                        "zh": "事物发展的倾向或走向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тенденция",
                                "target_lang_sense_clarification": "направление развития"
                            },
                            {
                                "target_lang_word": "направление",
                                "target_lang_sense_clarification": "курс движения или развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "趋势",
                                "target_lang_sense_clarification": "事物发展的动向"
                            },
                            {
                                "target_lang_word": "倾向",
                                "target_lang_sense_clarification": "偏向某个方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a8970e3-a62d-3127-9939-7310ef038ed3",
                    "sense_definition": "A line drawn on a graph that approximates the general direction of a number of disparate points.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The analyst drew a <w>trend</w> on the chart to predict future sales.",
                            "target_lang_translations": {
                                "ru": "Аналитик нарисовал <w>тренд</w> на графике, чтобы спрогнозировать будущие продажи.",
                                "zh": "分析师在图表上画了一条<w>趋势线</w>来预测未来的销售额。"
                            }
                        },
                        {
                            "text": "Although the daily data fluctuates, the overall <w>trend</w> is clearly positive.",
                            "target_lang_translations": {
                                "ru": "Хотя ежедневные данные колеблются, общий <w>тренд</w> явно положительный.",
                                "zh": "尽管每日数据有所波动，但总体<w>趋势</w>显然是积极的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trend line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия на графике, отображающая общую направленность разрозненных данных.",
                        "zh": "图表上表示数据总体变化方向的线条。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тренд",
                                "target_lang_sense_clarification": "статистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "趋势线",
                                "target_lang_sense_clarification": "统计图表中的线条"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "276e1edf-d483-314f-824b-acb364180622",
                    "sense_definition": "To be the subject of a trend; to be currently popular, relevant or interesting.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What topics have been <w>trending</w> on social networks this week?",
                            "target_lang_translations": {
                                "ru": "Какие темы <w>были в тренде</w> в социальных сетях на этой неделе?",
                                "zh": "这周社交网络上哪些话题最<w>热门</w>？"
                            }
                        },
                        {
                            "text": "The news story started <w>trending</w> immediately after the broadcast.",
                            "target_lang_translations": {
                                "ru": "Эта новость начала <w>набирать популярность</w> сразу после эфира.",
                                "zh": "这则新闻在播出后立即开始<w>流行</w>起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trending topic",
                        "trending now",
                        "trending on social media"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть предметом обсуждения; быть популярным или актуальным (особенно в интернете).",
                        "zh": "成为热门话题；在网络上受到广泛关注。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть в тренде",
                                "target_lang_sense_clarification": "быть популярным"
                            },
                            {
                                "target_lang_word": "набирать популярность",
                                "target_lang_sense_clarification": "становиться известным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热门",
                                "target_lang_sense_clarification": "受到广泛关注"
                            },
                            {
                                "target_lang_word": "流行",
                                "target_lang_sense_clarification": "在社交媒体上广为传播"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7056fd83-a0dd-304d-8b9e-4846deed9ca0",
                    "sense_definition": "To have a particular direction; to run; to stretch; to tend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shore of the sea <w>trends</w> to the southwest for several miles.",
                            "target_lang_translations": {
                                "ru": "Берег моря <w>простирается</w> на юго-запад на несколько миль.",
                                "zh": "海岸线向西南方向<w>延伸</w>了数英里。"
                            }
                        },
                        {
                            "text": "Public opinion has <w>trended</w> away from the policy in recent months.",
                            "target_lang_translations": {
                                "ru": "Общественное мнение в последние месяцы <w>склонилось</w> против этой политики.",
                                "zh": "近几个月来，公众舆论已<w>趋向</w>反对这项政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tend",
                        "veer",
                        "incline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь определенное направление; простираться; иметь склонность.",
                        "zh": "具有某种走向；延伸；倾向于。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "о географическом направлении"
                            },
                            {
                                "target_lang_word": "склоняться",
                                "target_lang_sense_clarification": "иметь тенденцию (об мнении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延伸",
                                "target_lang_sense_clarification": "地理上的走向"
                            },
                            {
                                "target_lang_word": "趋向",
                                "target_lang_sense_clarification": "向某个方向发展"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1005e470-e175-38d9-b139-62a9b5a44be7",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Trend</w> has lived in this village for over fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тренд</w> живет в этой деревне уже более пятидесяти лет.",
                                "zh": "<w>特伦德</w>先生在这个村子里已经住了五十多年了。"
                            }
                        },
                        {
                            "text": "We are looking for a file belonging to a client named <w>Trend</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем файл, принадлежащий клиенту по фамилии <w>Тренд</w>.",
                                "zh": "我们正在寻找一份属于一位名叫<w>特伦德</w>的客户的文件。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тренд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特伦德",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb41321b-f99d-3d36-8d2a-70a8d034a8a0",
                    "sense_definition": "A town in Vesthimmerland Municipality, North Jutland, Denmark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small town of <w>Trend</w> during their trip to Denmark.",
                            "target_lang_translations": {
                                "ru": "Они посетили маленький городок <w>Тренд</w> во время своей поездки в Данию.",
                                "zh": "他们在丹麦旅行期间参观了<w>特伦德</w>这个小镇。"
                            }
                        },
                        {
                            "text": "<w>Trend</w> is located in the northern part of the country.",
                            "target_lang_translations": {
                                "ru": "<w>Тренд</w> расположен в северной части страны.",
                                "zh": "<w>特伦德</w>位于该国北部。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в муниципалитете Вестхиммерланд, Северная Ютландия, Дания.",
                        "zh": "丹麦北日德兰大区的一个城镇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тренд",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特伦德",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}