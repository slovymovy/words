                        "form": "горбу́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4da5e91-dad1-3d1d-92e7-11fa06474b0c",
                        "entry_id": "4d686de3-0e87-301d-96f0-0e84bb266934",
                        "glosses": [
                            "непочатый край буханки; кусок, отрезанный, отломанный от такого края"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3e227d-7232-4d79-9ae4-3f7228dfee54",
                                "sense_id": "c4da5e91-dad1-3d1d-92e7-11fa06474b0c",
                                "text": "Попадались и горбушки черствого пайкового хлеба, куски мыла, серые куски рафинада в синей бумаге, осьмушки, а чаще пол осьмушки махорки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b6af2fe-2c22-4197-89b1-f705a3ad8ec6",
                        "source_entry_id": "4d686de3-0e87-301d-96f0-0e84bb266934",
                        "source_sense_id": "c4da5e91-dad1-3d1d-92e7-11fa06474b0c",
                        "target_lang_word": "Knust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3355a2e6-db36-37ae-8940-21c421ae2dbe",
                                        "entry_id": "6acd9b33-c5a9-346c-9f8e-35a43071db5b",
                                        "glosses": [
                                            "Endstück eines Brotes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb789604-d11f-45d0-bd93-d1ff06fc1839",
                                                "sense_id": "3355a2e6-db36-37ae-8940-21c421ae2dbe",
                                                "text": "„Ich zog den letzten Knust durch und durch verschimmelten Brotes vor.“"
                                            },
                                            {
                                                "example_id": "39a4e583-a5af-424f-8b0b-a908e9538242",
                                                "sense_id": "3355a2e6-db36-37ae-8940-21c421ae2dbe",
                                                "text": "„Abschied ist ein scharfes Schwert. Und Abschnitt ist ein hartes Brot. Der Rest ist Scherzl oder Knust oder Ränftl oder wie man sonst noch zum Brotkanten sagt.“"
                                            },
                                            {
                                                "example_id": "299a41dd-aaa6-4a12-8c3f-0f945063528c",
                                                "sense_id": "3355a2e6-db36-37ae-8940-21c421ae2dbe",
                                                "text": "„Carl hatte vermutlich bereits zu Abend gegessen, aber vielleicht gab es noch einen Knust Brot und ein wenig Wein auf dem Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
