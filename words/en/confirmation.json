{
    "word_family": [
        "confirm",
        "confirmatory",
        "confirmed",
        "confirmable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd3751e0-eaa5-303c-940a-d39243beeda1",
                    "sense_definition": "A statement, document, or message stating that an arrangement or plan is definite.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will send you a written <w>confirmation</w> of your hotel booking.",
                            "target_lang_translations": {
                                "ru": "Мы вышлем вам письменное <w>подтверждение</w> бронирования отеля.",
                                "zh": "我们将向您发送酒店预订的书面<w>确认</w>。"
                            }
                        },
                        {
                            "text": "Please print your flight <w>confirmation</w> before going to the airport.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, распечатайте <w>подтверждение</w> рейса перед поездкой в аэропорт.",
                                "zh": "请在前往机场前打印您的航班<w>确认</w>单。"
                            }
                        }
                    ],
                    "antonyms": [
                        "cancellation"
                    ],
                    "common_phrases": [
                        "booking confirmation",
                        "written confirmation",
                        "email confirmation",
                        "order confirmation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление, документ или сообщение, подтверждающее, что договоренность или план являются окончательными.",
                        "zh": "指明某项安排或计划已确定的声明、文件或信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "документ или сообщение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确认",
                                "target_lang_sense_clarification": "指确认某事已安排妥当的凭证"
                            },
                            {
                                "target_lang_word": "确认函",
                                "target_lang_sense_clarification": "书面形式的确认文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                    "sense_definition": "The action of confirming something or the state of being confirmed; proof that something is true or correct.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The announcement in the newspaper was a <w>confirmation</w> of my suspicions.",
                            "target_lang_translations": {
                                "ru": "Объявление в газете стало <w>подтверждением</w> моих подозрений.",
                                "zh": "报纸上的公告<w>证实</w>了我的怀疑。"
                            }
                        },
                        {
                            "text": "We are still waiting for official <w>confirmation</w> regarding the election results.",
                            "target_lang_translations": {
                                "ru": "Мы все еще ждем официального <w>подтверждения</w> результатов выборов.",
                                "zh": "我们仍在等待有关选举结果的官方<w>确认</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "verification",
                        "proof",
                        "corroboration",
                        "validation",
                        "substantiation"
                    ],
                    "antonyms": [
                        "denial",
                        "rejection",
                        "refutation"
                    ],
                    "common_phrases": [
                        "confirmation of",
                        "official confirmation",
                        "seek confirmation",
                        "independent confirmation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по подтверждению чего-либо или состояние подтвержденности; доказательство того, что что-то верно или правильно.",
                        "zh": "证实某事的过程或状态；证明某事真实或正确的证据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "действие или доказательство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "证实",
                                "target_lang_sense_clarification": "指证明某事属实的行为"
                            },
                            {
                                "target_lang_word": "证明",
                                "target_lang_sense_clarification": "指作为事实依据的证据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da94b533-4a9d-3869-81bd-6fd7b5db9e4f",
                    "sense_definition": "A religious ceremony in some Christian churches where a person is made a full member of the church.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a white dress for her <w>confirmation</w> at the local church.",
                            "target_lang_translations": {
                                "ru": "Она надела белое платье на свою <w>конфирмацию</w> в местной церкви.",
                                "zh": "她穿着白裙参加了当地教会的<w>坚振礼</w>。"
                            }
                        },
                        {
                            "text": "The bishop presided over the <w>confirmation</w> ceremony on Sunday.",
                            "target_lang_translations": {
                                "ru": "Епископ возглавил церемонию <w>конфирмации</w> в воскресенье.",
                                "zh": "主教在周日主持了<w>坚振礼</w>仪式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "confirmation class",
                        "confirmation sponsor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозный обряд в некоторых христианских церквях, при котором человек становится полноправным членом церкви.",
                        "zh": "某些基督教教会中的宗教仪式，受礼者借此成为教会的正式成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфирмация",
                                "target_lang_sense_clarification": "обряд в западных церквях"
                            },
                            {
                                "target_lang_word": "миропомазание",
                                "target_lang_sense_clarification": "таинство в восточных церквях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚振礼",
                                "target_lang_sense_clarification": "天主教及部分新教教会的入教仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17f71ab6-0896-3005-9fa7-8ccbfc4c2c67",
                    "sense_definition": "An act whereby something conditional or voidable is made sure and unavoidable, especially the possession of an estate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deed provided <w>confirmation</w> of his title to the land.",
                            "target_lang_translations": {
                                "ru": "Этот документ послужил <w>подтверждением</w> его права собственности на землю.",
                                "zh": "该契约提供了他拥有这片土地所有权的<w>证明</w>。"
                            }
                        },
                        {
                            "text": "Legal <w>confirmation</w> is required to finalize the transfer of the estate.",
                            "target_lang_translations": {
                                "ru": "Для завершения передачи имущества требуется юридическое <w>подтверждение</w>.",
                                "zh": "完成遗产转让需要法律上的<w>认定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ratification"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт, делающий что-либо условное или оспоримое несомненным и неоспоримым, особенно владение имуществом.",
                        "zh": "使有条件或可撤销的事项变得确定且不可更改的行为，尤指对财产所有权的法律认定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "юридическое"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "официальное закрепление прав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "指法律上的正式认可"
                            },
                            {
                                "target_lang_word": "认定",
                                "target_lang_sense_clarification": "指对权利或事实的法律确认"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}