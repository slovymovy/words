                    {
                        "sense_id": "c01b9d83-a27e-3ca3-878b-59517114ca21",
                        "entry_id": "a5c89d74-f21a-338d-93cc-edc26fb5870a",
                        "glosses": [
                            "Ensemble de dialectes du grec ancien, parlés en Arcadie (région centrale de la presqu’île du Péloponnèse) ainsi que dans l’île de Chypre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488f911e-4af8-4695-b74b-64e0ffed3c35",
                                "sense_id": "c01b9d83-a27e-3ca3-878b-59517114ca21",
                                "text": "Comme son nom l’indique, l’arcado-cypriote est caractéristique de l’Arcadie (au centre du Péloponnèse) et de la plus grande partie de l’île de Chypre, dont certaines villes remontent à l’époque achéenne."
                            }
                        ]
                    }
