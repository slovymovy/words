                "senses": [
                    {
                        "sense_id": "8ae91890-5c4d-3eca-ad16-6e3c866d3543",
                        "entry_id": "e92e752e-9414-3631-8aba-e42c101a7198",
                        "glosses": [
                            "Qui ressemble, en parlant de peinture, de sculpture, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87503021-329a-4311-b43d-600e4ea13338",
                                "sense_id": "8ae91890-5c4d-3eca-ad16-6e3c866d3543",
                                "text": "Une mauvaise copie, peu ressemblante à l’original."
                            },
                            {
                                "example_id": "954ee35f-ee74-4b9d-abcd-0e06914154ef",
                                "sense_id": "8ae91890-5c4d-3eca-ad16-6e3c866d3543",
                                "text": "Il faudrait représenter Rabourdin habillé en boucher, mais bien ressemblant, chercher des analogies entre un bureau et une cuisine, lui mettre à la main un tranche-lard, peindre les principaux employés des ministères en volailles, les encager dans une immense souricière sur laquelle on écrirait : Exécutions administratives, et il serait censé leur couper le cou un à un."
                            },
                            {
                                "example_id": "22d9e962-50d2-4927-8371-811ae3dd059d",
                                "sense_id": "8ae91890-5c4d-3eca-ad16-6e3c866d3543",
                                "text": "On a eu la malignité de placer côte à côte le François Iᵉʳ de Clouet et celui du Titien. Quelqu’un déclare : « Je trouve celui du Titien plus ressemblant ! »"
                            }
                        ]
                    }
                ],
