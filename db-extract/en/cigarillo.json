                        "translation_id": "bd55bca6-8732-47b3-ab58-fa182f153011",
                        "source_entry_id": "87115f8e-9a5d-3373-a860-83311998a861",
                        "source_sense_id": "251b484f-60a4-32a0-b408-4d76255fcdb3",
