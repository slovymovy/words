                ],
                "senses": [
                    {
                        "sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                        "entry_id": "f391b621-5804-36e8-b675-30bf5d3eac86",
                        "glosses": [
                            "Sulfate hydraté naturel de sodium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c2cc11-db3d-4190-be28-5f9038eee742",
                                "sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                                "text": "Les galeries souterraines du gypse de Lacourt sont souvent tapissées d'efflorescences de mirabilite […]."
                            },
                            {
                                "example_id": "52fbe513-dfd2-4bf2-9a49-ee9e0563d887",
                                "sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                                "text": "Les sulfates très solubles, comme l’epsomite, magnésienne, la bloedite, sodique et magnésienne et la mirabilite, sodique, se rencontrent dans des dépôts marins aussi bien que dans les lacs salés."
                            },
                            {
                                "example_id": "5f765c7c-42dd-4dfc-8321-63ad129729d6",
                                "sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                                "text": "Convaincu que l’eau était la mère de toutes les infections, le charlatan de 65 ans imposait à ses patients des traitements au sel de Glauber, une substance également appelée mirabilite utilisée pour fabriquer la soude et, accessoirement, employée comme laxatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bea4f5d5-fd5f-4f7d-9059-4c14970544a2",
                        "source_entry_id": "f391b621-5804-36e8-b675-30bf5d3eac86",
                        "source_sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                        "source_sense_description": "Sulfate hydraté naturel de sodium",
                        "target_lang_word": "Mirabilit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "93d07c44-9771-442d-b26d-be60d6a2005f",
                        "source_entry_id": "f391b621-5804-36e8-b675-30bf5d3eac86",
                        "source_sense_id": "611c6f14-e9dc-3501-97c9-97f93fecee20",
                        "source_sense_description": "Sulfate hydraté naturel de sodium",
                        "target_lang_word": "mirabilite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirabilite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40426985-de4e-3afb-b56f-7e679b4fb987",
                                        "entry_id": "ccedc2ad-1291-346f-95c1-8a2b0e57c68e",
                                        "glosses": [
                                            "An evaporite, consisting of sodium sulfate, with the chemical formula Na₂SO₄·10H₂O."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc68cef6-75a4-4936-8e1a-b383f07affca",
                                                "sense_id": "40426985-de4e-3afb-b56f-7e679b4fb987",
                                                "text": "Mounds of mirabilite have been observed near the north-west side of White Island, (e.g., Debenham 1965). These mirabilites probably originated by infiltration of sea water into the ice shelf, followed by ablation of the surface until the brines were exposed to evaporation and freeze concentration with precipitation of mirabilite on the surface."
                                            },
                                            {
                                                "example_id": "c084dcde-f282-4001-977a-c11858917457",
                                                "sense_id": "40426985-de4e-3afb-b56f-7e679b4fb987",
                                                "text": "Bedded deposits of mirabilite occur in coastal areas of East Antarctica, such as the Vestfold Hills and in the Skarvsnes area of Lutzow-Holm Bay, about 1500 km further west (Fig 1.3)."
                                            },
                                            {
                                                "example_id": "8c060654-2c55-4a28-8f3f-71d82ed6c4bc",
                                                "sense_id": "40426985-de4e-3afb-b56f-7e679b4fb987",
                                                "text": "Mirabilite could have been and probably was scooped up off the cave floor and out of breakdown hollows, or brushed off ceilings and walls where it forms abundantly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
