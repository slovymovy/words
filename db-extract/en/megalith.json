                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ea4bfdf-821a-4a26-9ea2-ccc7063e03a3",
                        "source_entry_id": "5705d534-52fb-3ed9-ac38-c6a26f98df53",
                        "source_sense_description": "large stone slab making up a prehistoric monument, or part of such a monument",
