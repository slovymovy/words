                        "cross_references": []
                    },
                    {
                        "translation_id": "a753556c-0f3e-4816-97e7-fdeb741869cd",
                        "source_entry_id": "79f2195a-b70a-3e74-99b1-46100a49a03f",
                        "source_sense_id": "fd61026d-eb47-3dd6-9be7-3c10ca078a59",
                        "target_lang_word": "warmonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warmonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ec20ec-5d2f-3a4f-a8a3-f5b9b30d451d",
                                        "entry_id": "6b3e75c9-4f0e-309f-adec-30876c278a04",
                                        "glosses": [
                                            "Someone who advocates war; a militarist."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cb3388-686c-4bd6-87d5-8bdf0ef7dbc2",
                                                "sense_id": "48ec20ec-5d2f-3a4f-a8a3-f5b9b30d451d",
                                                "text": "Wham! Overnight he [Dwight D. Eisenhower] became a warmonger."
                                            },
                                            {
                                                "example_id": "922fe615-b525-4c66-956b-141563475057",
                                                "sense_id": "48ec20ec-5d2f-3a4f-a8a3-f5b9b30d451d",
                                                "text": "Do you hear revolution's call? / Time to fight our own denial / Warmongers keep us locked in fear / Invoke the past, a moment of tears / An ugly truth put forth by our youth / Under the threat of patriotic brute / So use your rage / It is a weapon we now must engage / Let trumpets sound our call / Or by their lies we will fall"
                                            },
                                            {
                                                "example_id": "1f341ddd-c2e5-4aad-8987-bdb5cd191d57",
                                                "sense_id": "48ec20ec-5d2f-3a4f-a8a3-f5b9b30d451d",
                                                "text": "“He’s not the only one doing this,” Rohrabacher answered. “But it seems to me like what we’ve got are warmongers claiming other people are war criminals. This is the wrong kind of tone. That type of rhetoric is leading us to a point where we will be in conflict and the Russians will think that we are out to get them.”"
                                            },
                                            {
                                                "example_id": "a99bd92e-e380-421e-ac4a-f56caea3beb8",
                                                "sense_id": "48ec20ec-5d2f-3a4f-a8a3-f5b9b30d451d",
                                                "text": "“He’s a 70-year-old childless warmonger and he has no stake in the future of this country,” Dans said. “He is the very reason that MAGA started in the first place, and we only have to look at 2016 when he was a vehement Trump hater. A leopard doesn’t change its spots.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d4af75-4aad-35a3-9ddd-ad371547dd41",
                                        "entry_id": "6b3e75c9-4f0e-309f-adec-30876c278a04",
                                        "glosses": [
                                            "A mercenary soldier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24653a9a-5755-4488-b2c3-e3678c52e407",
                                                "sense_id": "a2d4af75-4aad-35a3-9ddd-ad371547dd41",
                                                "text": "With that, out of his bouget forth he drew\nGreat ſtore of treaſure, therewith him to tempt;\nBut he on it lookt ſcornefully askew,\nAs much diſdeigning to be ſo miſdempt,\nOr a war-monger to be baſely nempt;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warmonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7e3b00-8cac-3e97-b367-0d3a9be8f3b0",
                                        "entry_id": "fb33c81a-2e4b-34c0-8952-b38fe612b75d",
                                        "glosses": [
                                            "To advocate war."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
