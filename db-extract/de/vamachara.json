                "senses": [
                    {
                        "sense_id": "7cb26618-9248-3937-8671-daa82a30cd4f",
                        "entry_id": "69843947-3484-35b0-976f-b8174d861ca3",
                        "glosses": [
                            "tantrischer Pfad, der unorthodoxe, gesellschaftlich nicht akzeptierte Praktiken umfasst, um spirituelle Befreiung zu erreichen"
                        ],
