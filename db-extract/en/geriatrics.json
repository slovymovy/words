                "word": "geriatrics",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9492ab14-ccaf-33ec-840f-54b64c5e6a12",
                        "entry_id": "745c4843-ee49-3d45-8d08-45b1b6e04f6e",
                        "glosses": [
                            "The branch of medicine that focuses on health promotion and the prevention and treatment of disease and disability in later life. The term itself can be distinguished from gerontology, which is the study of the aging process itself."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6cd1734-5f59-457f-ab2a-d6357f118110",
                        "source_entry_id": "745c4843-ee49-3d45-8d08-45b1b6e04f6e",
                        "source_sense_id": "9492ab14-ccaf-33ec-840f-54b64c5e6a12",
