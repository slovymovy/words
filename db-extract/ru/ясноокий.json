                "senses": [
                    {
                        "sense_id": "40f0b132-84ac-3ea1-beab-d3f8b1a05385",
                        "entry_id": "43e3974e-6eed-3931-a0e2-fbf90e466422",
                        "glosses": [
                            "поэт. с ясными очами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3e5211-5968-4171-a6c7-290662e4d6d9",
                                "sense_id": "40f0b132-84ac-3ea1-beab-d3f8b1a05385",
                                "text": "И я принёс тебе, царевне ясноокой, // Тот жемчуг слёз моих печали одинокой // И нежную вуаль из пенности волны."
                            },
                            {
                                "example_id": "a6ce20bb-bcdf-407e-9ebb-1123746f213f",
                                "sense_id": "40f0b132-84ac-3ea1-beab-d3f8b1a05385",
                                "text": "На одной была картинка, ― ясноокий гимназист на углу улицы кормит своим завтраком облезлую собаку."
                            }
                        ]
                    }
