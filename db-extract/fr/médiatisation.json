                "entry_id": "b0b8eb04-028a-32c6-81d4-6ae4bedc922b",
                "word": "médiatisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14a9aa38-eb78-4f07-aade-08adc495a732",
                        "entry_id": "b0b8eb04-028a-32c6-81d4-6ae4bedc922b",
                        "tags": [
                            "plural"
                        ],
                        "form": "médiatisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "189a2867-dd63-3e6a-a736-96aebb90562b",
                        "entry_id": "b0b8eb04-028a-32c6-81d4-6ae4bedc922b",
                        "glosses": [
                            "Le fait pour un prince, un pays, en Allemagne antérieure à la république, de ne plus relever immédiatement de l’empereur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd172b4-0122-49fc-92eb-a80d343feb25",
                                "sense_id": "189a2867-dd63-3e6a-a736-96aebb90562b",
                                "text": "Tel seigneur ecclésiastique, prélat ou abbé, brandissait d’anciens diplômes pour échapper à la médiatisation dont sa seigneurie était menacée et réclamer le privilège de relever de l’empereur sans intermédiaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15704926-ae54-4b58-8640-c3780bc13289",
                        "source_entry_id": "b0b8eb04-028a-32c6-81d4-6ae4bedc922b",
                        "source_sense_id": "189a2867-dd63-3e6a-a736-96aebb90562b",
                        "target_lang_word": "Mediatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mediatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c92f16c-0e0e-36c3-9e50-04674a71750b",
                                        "entry_id": "e249cb47-a7d0-3b75-bd6c-010809a2dcc8",
                                        "glosses": [
                                            "Mittelbarmachung; den Entzug der unmittelbaren Unterstellung von Reichsstädten und -gebieten unter den Kaiser des Heiligen Römischen Reiches und die Unterstellung unter den jeweiligen Landesherren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146f1dc3-4cae-433b-8b0e-b572c8f4d11c",
                                                "sense_id": "4c92f16c-0e0e-36c3-9e50-04674a71750b",
                                                "text": "\"Zum anderen wurde die schrittweise Mediatisierung der nachgeordneten Stände und Untertanen im Reich weniger als Ausdruck des säkularen Konflikts zwischen Fürst und Ständen, sondern auch als Preis der Verrechtlichung des Konfessionskonfliktes verstanden.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99d31bf2-a8ac-34ee-9e2a-d33437ca3573",
                                        "entry_id": "e249cb47-a7d0-3b75-bd6c-010809a2dcc8",
                                        "glosses": [
                                            "Prozess, wonach Kommunikation zunehmend über Medien stattfindet"
                                        ],
                                        "tags": [
                                            "Kommunikationswissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a90de2-2d2a-43d5-8392-7928381d6e43",
                                                "sense_id": "99d31bf2-a8ac-34ee-9e2a-d33437ca3573",
                                                "text": "\"Die strategische politische Kommunikation verändert sich durch das Internet . . . auch, weil die Mediatisierung der individuellen politischen Kommunikation für eine Fülle von Daten sorgt . . .\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
