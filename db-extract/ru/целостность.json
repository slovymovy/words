                "senses": [
                    {
                        "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                        "glosses": [
                            "свойство по значению прилагательного целостный; полнота, завершённость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269366cd-f047-4e88-9f5b-9d0ddb27d33e",
                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                "text": "Восприятие зрительного поля определяется не отдельными элементами, как в случае ассоциаций, предшествующим опытом и т. д., а динамическими силами, определяющими целостность восприятия."
                            },
                            {
                                "example_id": "046a994f-b872-4ae0-b340-2fa266444ffa",
                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                "text": "При подсветке водных объектов уместно цветное освещение — главное, чтобы сохранилась целостность композиционного замысла."
                            }
                        ]
                    },
                    {
                        "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                        "glosses": [
                            "свойство по значению прилагательного целый; отсутствие повреждений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8e0d4a-7bc8-4263-8f9f-ca0689cb4e4e",
                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                "text": "Опустите глубоко в землю фундамент — и вы не будете бояться за целостность вашего жилища."
                            },
                            {
                                "example_id": "3bffc3f8-a1dd-4636-b578-3758d9c2d514",
                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                "text": "Отщепившись от молекулы белка в результате ряда жизненных процессов, ароматическая группа, правда, претерпевает целый ряд превращений, но ароматическое ядро во всех фазах своего превращения и вплоть до момента своего выделения из организма животного сохраняет свою целостность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "023cc006-1e22-49b4-acb9-1d197899069f",
                        "source_entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                        "target_lang_word": "integrity",
                        "target_lang_code": "en",
