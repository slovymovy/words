                                                "example_id": "5cff7b97-37f0-4c76-bf35-877bbc5e69c7",
                                                "sense_id": "e1a2451f-285a-38b0-bba8-0d5efdcadc89",
                                                "text": "Feeling okey-dokey, Audrey? Why don’t you hop in?"
                                            },
