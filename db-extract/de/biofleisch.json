                "senses": [
                    {
                        "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                        "entry_id": "dff689c3-89af-3265-870d-982e91f66c78",
                        "glosses": [
                            "Fleisch, das aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4490e05e-ed65-4baa-b8b5-97e326ab09d5",
                                "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                                "text": "„Du musst wenigstens Biofleisch aus Deutschland nehmen oder irgendwas mit Veggie machen.“"
                            },
                            {
                                "example_id": "4e2589af-926d-4418-8187-647ec3e7b9f7",
                                "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                                "text": "„Zudem sollte sie reich an guten tierischen Proteinquellen sein wie bei Biofleisch, Bioeiern, Biomilchprodukten und Wild.“"
                            },
                            {
                                "example_id": "b749a069-091f-4ea5-835f-e9daca16db59",
                                "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                                "text": "„Beim Einkauf stellt sich als erstes die Frage: Kaufe ich Biofleisch oder Fleisch aus konventioneller Haltung?“"
                            },
                            {
                                "example_id": "b37d870d-4f80-432c-8db9-4fdb46e4402d",
                                "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                                "text": "„Gerade bei Biofleisch könnte ich mir dreimal die Woche nicht leisten, denn ich habe andere Ausgaben, die ebenfalls teuer sind.“"
                            },
                            {
                                "example_id": "a2acceb2-639b-4a9c-b172-e23c355b13b4",
                                "sense_id": "dd5a8ebe-36a9-3d9f-a0c4-5fa018ca545d",
                                "text": "„Wer Biofleisch wählt, kann sicher sein, dass in ihm keine Antibiotika und Hormone enthalten sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
