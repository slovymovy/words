    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "519f592a-9606-34c2-b085-1dff3fe981f3",
                    "sense_definition": "Relating to factories, manufacturing, or the production of goods.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manufacturing_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has a large <w>industrial</w> zone near the river.",
                            "target_lang_translations": {
                                "ru": "В городе есть большая <w>промышленная</w> зона у реки.",
                                "zh": "这座城市在河边有一个大型<w>工业</w>区。"
                            }
                        },
                        {
                            "text": "We learned about the <w>industrial</w> revolution in history class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали <w>индустриальную</w> революцию на уроке истории.",
                                "zh": "我们在历史课上学习了<w>工业</w>革命。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nonindustrial"
                    ],
                    "common_phrases": [
                        "industrial revolution",
                        "industrial estate",
                        "industrial waste",
                        "industrial production"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к промышленности, производству товаров или фабрикам.",
                        "zh": "与工厂、制造业或商品生产相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промышленный",
                                "target_lang_sense_clarification": "относящийся к производству товаров"
                            },
                            {
                                "target_lang_word": "индустриальный",
                                "target_lang_sense_clarification": "связанный с развитием промышленности (напр. революция)"
                            },
                            {
                                "target_lang_word": "производственный",
                                "target_lang_sense_clarification": "относящийся к процессу производства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工业的",
                                "target_lang_sense_clarification": "与工业生产相关的"
                            },
                            {
                                "target_lang_word": "产业的",
                                "target_lang_sense_clarification": "与产业活动相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a450b37-2736-39ac-8e07-7bec3f249c9e",
                    "sense_definition": "Having a highly developed economy based on factories and manufacturing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "manufacturing_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Germany is a major <w>industrial</w> power in Europe.",
                            "target_lang_translations": {
                                "ru": "Германия — крупная <w>промышленная</w> держава в Европе.",
                                "zh": "德国是欧洲主要的<w>工业</w>强国。"
                            }
                        },
                        {
                            "text": "Pollution is often a serious problem in <w>industrial</w> societies.",
                            "target_lang_translations": {
                                "ru": "Загрязнение часто является серьезной проблемой в <w>индустриальных</w> обществах.",
                                "zh": "污染在<w>工业化</w>社会中往往是一个严重的问题。"
                            }
                        }
