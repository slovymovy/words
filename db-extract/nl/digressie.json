                                    },
                                    {
                                        "sense_id": "784cf8b0-e536-38db-b720-726a6bbec4c8",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "A deviation, an act of straying from a path."
