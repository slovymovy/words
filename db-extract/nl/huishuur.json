                                        "sense_id": "611a7a64-1b32-34ae-a0b1-5d55482ca4e5",
                                        "entry_id": "43b6cb6b-48cd-3697-bdf9-fe31b6a4513e",
                                        "glosses": [
                                            "That has been torn or rent; ripped; torn."
