                "senses": [
                    {
                        "sense_id": "dd262bce-8a99-3eab-a7d5-7fd64993e632",
                        "entry_id": "a3efa1a1-f6a0-3954-80d4-09b50b58e9c5",
                        "glosses": [
                            "plötzlicher Fluss von Elektrizität im Körper durch Kontakt mit einem stromführenden Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a140ca-ddb2-4377-894d-0abd8603c8bf",
                                "sense_id": "dd262bce-8a99-3eab-a7d5-7fd64993e632",
                                "text": "„Ich weiß auch von anderen Dorfbewohnern, dass sie ab und zu an verschiedenen Orten und völlig unerwartet Stromschläge bekommen.“"
                            },
                            {
                                "example_id": "d79fee28-2a26-48a2-99e0-b735279744e5",
                                "sense_id": "dd262bce-8a99-3eab-a7d5-7fd64993e632",
                                "text": "„Als hätte ich einen kräftigen Stromschlag bekommen, der einen Schwall undeutlicher Gedanken und irrationaler Gefühle in mir auslöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1395b5ac-bb47-4186-a5c1-9b6f0b4c47e7",
                        "source_entry_id": "a3efa1a1-f6a0-3954-80d4-09b50b58e9c5",
                        "source_sense_id": "dd262bce-8a99-3eab-a7d5-7fd64993e632",
                        "source_sense_description": "plötzlicher Fluss von Elektrizität im Körper",
                        "target_lang_word": "electric shock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electric shock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b198fe5-3e98-3165-979f-0acc34d2a3c6",
                                        "entry_id": "faaeca23-1113-35a6-969e-bc6c054d8237",
                                        "glosses": [
                                            "An instance of subjecting (someone or something) to an electric shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a775978-bfa6-4dc1-bc57-d6c02843702b",
                                                "sense_id": "0b198fe5-3e98-3165-979f-0acc34d2a3c6",
                                                "text": "The newer taser delivered a more powerful electric shock to the target than the older one did."
                                            },
                                            {
                                                "example_id": "3a0a4343-1eeb-4e0b-b715-1e3c30d226d4",
                                                "sense_id": "0b198fe5-3e98-3165-979f-0acc34d2a3c6",
                                                "text": "Ships' logs noted observations of the northern lights as far south as the Caribbean, and telegraph systems across the world were disrupted as electrical currents were induced in the copper lines. Several telegraph operators received electric shocks and some telegraph stations even caught fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f7f339-b343-3e94-ad8c-ca592cb20fe4",
                                        "entry_id": "faaeca23-1113-35a6-969e-bc6c054d8237",
                                        "glosses": [
                                            "The physical reaction or shock caused by the flow of electricity through the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a0e52db-a1cd-4fe6-9da9-0d71f625bd04",
                        "source_entry_id": "a3efa1a1-f6a0-3954-80d4-09b50b58e9c5",
                        "source_sense_id": "dd262bce-8a99-3eab-a7d5-7fd64993e632",
                        "source_sense_description": "plötzlicher Fluss von Elektrizität im Körper",
                        "target_lang_word": "décharge électrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décharge électrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23f45924-1df9-3b95-ab00-074a7d61ac60",
                                        "entry_id": "82b2fab7-e7f6-3c3e-9f3e-167fb898b79b",
                                        "glosses": [
                                            "Perte de charge électrique d'un composant électrique (pile, accumulateur, condensateur, batterie), par transfert d'énergie à un consommateur, par autodécharge, voire par un court-circuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0716335a-f228-4556-b5df-a77237713726",
                                                "sense_id": "23f45924-1df9-3b95-ab00-074a7d61ac60",
                                                "text": "Les deux principales applications des condensateurs électriques sont le filtrage et sa stabilisation, la décharge électrique incluant la commutation."
                                            },
                                            {
                                                "example_id": "53391ef8-c53f-4b49-8451-574492cff0a3",
                                                "sense_id": "23f45924-1df9-3b95-ab00-074a7d61ac60",
                                                "text": "Un système électrochimique, comme une batterie lithium ion, peut être considéré comme un dipôle électrique. De la sorte, on peut modéliser la réponse à une sollicitation (une charge ou une décharge électrique) à l’aide d’un circuit équivalent (MCE)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71da2fc6-423b-38da-8a55-42f9bbfad243",
                                        "entry_id": "82b2fab7-e7f6-3c3e-9f3e-167fb898b79b",
                                        "glosses": [
                                            "Électrisation d'un être vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa691e3-49e8-4c02-9bc3-9749b015a55c",
                                                "sense_id": "71da2fc6-423b-38da-8a55-42f9bbfad243",
                                                "text": "Le monteur ayant inversé la phase et la terre, j'ai reçu une décharge électrique en touchant le boîtier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11bfc9e-f86f-3d12-9f52-75e79577ec9a",
                                        "entry_id": "82b2fab7-e7f6-3c3e-9f3e-167fb898b79b",
                                        "glosses": [
                                            "Courant électrique s'établissant lorsque le champ électrique dans un isolant est trop grand, provoquant un claquage, avec des phénomènes différents, brutaux ou stables, par exemple l'arc électrique (dont la foudre et la décharge électrostatique), ainsi que la décharge luminescente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028b6011-f09a-4d33-a45d-18f1016c9687",
                                                "sense_id": "c11bfc9e-f86f-3d12-9f52-75e79577ec9a",
                                                "text": "C'est à la fin du XIXᵉ siècle que commença l'étude poussée des décharges électriques dans les gaz raréfiés."
                                            },
                                            {
                                                "example_id": "ad528769-0618-4ca0-8fa2-3b6349c408e4",
                                                "sense_id": "c11bfc9e-f86f-3d12-9f52-75e79577ec9a",
                                                "text": "L'électro-érosion, aussi appelée étincelage, consiste à usiner une pièce conductrice par décharges électriques."
                                            },
                                            {
                                                "example_id": "a7ee92f4-3523-4e3d-87d8-5d96092a667c",
                                                "sense_id": "c11bfc9e-f86f-3d12-9f52-75e79577ec9a",
                                                "text": "C'est au milieu du siècle des Lumières, le XVIIIᵉ, qu'il fut établi que la foudre trouvait son origine non pas dans la colère des dieux, mais dans des décharges électriques atmosphériques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
