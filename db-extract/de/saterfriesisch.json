                "senses": [
                    {
                        "sense_id": "5b2e0631-81f1-3d14-a412-4313916dffa1",
                        "entry_id": "448d3226-5cac-31da-af8e-ee458e3d87ae",
                        "glosses": [
                            "verbleibende Varietät der ostfriesischen Sprache, die im Landkreis Cloppenburg noch von rund 2000 Menschen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3b926c-7fba-4a4f-818b-be3512af91e4",
                                "sense_id": "5b2e0631-81f1-3d14-a412-4313916dffa1",
                                "text": "Wie heißt das auf Saterfriesisch?"
                            },
                            {
                                "example_id": "28f4a850-95a9-430e-a015-f3e58e484290",
                                "sense_id": "5b2e0631-81f1-3d14-a412-4313916dffa1",
                                "text": "„Die zahlreichen Sprachforscher, die das Saterfriesische untersuchten, benutzten bis zur Mitte des 20. Jahrhunderts verschiedene, teils selbst erdachte Schreibweisen.“"
                            },
                            {
                                "example_id": "ec69a578-cdc9-4470-997b-0b0d97a54c31",
                                "sense_id": "5b2e0631-81f1-3d14-a412-4313916dffa1",
                                "text": "„Seit 2005 ist der Vorgänger nicht mehr in Kraft, der die Rahmenbedingungen für Niederdeutsch und Saterfriesisch in der Schule regelte…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
