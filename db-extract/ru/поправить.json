                ],
                "senses": [
                    {
                        "sense_id": "7989f743-e8e9-3fa4-8cc1-073052b2790b",
                        "entry_id": "1bbbda3e-78e1-3179-8b3d-db1bb349c07e",
                        "glosses": [
                            "то же, что исправить, сделать правильным, таким, каким нужно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbfdb6a-198d-49c9-a19a-ed298ddc15b3",
                                "sense_id": "7989f743-e8e9-3fa4-8cc1-073052b2790b",
                                "text": "В этом тексте я поправил не меньше двадцати ошибок."
                            }
                        ]
                    },
                    {
                        "sense_id": "90091457-b236-3ffa-be03-7b9af73995d4",
                        "entry_id": "1bbbda3e-78e1-3179-8b3d-db1bb349c07e",
                        "glosses": [
                            "указать кому-либо на ошибку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f91ef6-6759-4541-8f1c-007b1b2d7862",
                                "sense_id": "90091457-b236-3ffa-be03-7b9af73995d4",
                                "text": "Если я ошибусь, поправьте меня!"
                            }
                        ]
                    },
                    {
                        "sense_id": "28422ad0-edb7-3915-9b1b-aad80d91ecdf",
                        "entry_id": "1bbbda3e-78e1-3179-8b3d-db1bb349c07e",
                        "glosses": [
                            "привести в надлежащее положение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e7d472-a493-44d7-be97-5a9d32bbd581",
                                "sense_id": "28422ad0-edb7-3915-9b1b-aad80d91ecdf",
                                "text": "Она посмотрела в зеркало и поправила шляпку."
                            }
                        ]
                    },
                    {
                        "sense_id": "13cc3bf5-eba1-3e1f-9b0a-63c09581f153",
                        "entry_id": "1bbbda3e-78e1-3179-8b3d-db1bb349c07e",
                        "glosses": [
                            "улучшить, починить, восстановить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435e9a82-35dc-405b-bcb0-0ecd0974a86d",
                                "sense_id": "13cc3bf5-eba1-3e1f-9b0a-63c09581f153",
                                "text": "Еду на юг, чтобы поправить здоровье."
                            }
                        ]
                    }
