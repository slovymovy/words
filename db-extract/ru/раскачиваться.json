                ],
                "senses": [
                    {
                        "sense_id": "9d7b9ae7-1d3c-3aa9-b46e-15365a879a2b",
                        "entry_id": "bf135c9b-0a38-3d0c-9c92-1d01dac7012d",
                        "glosses": [
                            "совершать колебательные движения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb5315c-7b62-4411-9ae6-83596754f82d",
                                "sense_id": "9d7b9ae7-1d3c-3aa9-b46e-15365a879a2b",
                                "text": "Ксения обхватила голову руками и принялась раскачиваться из стороны в сторону."
                            },
                            {
                                "example_id": "4fcfb618-d6b7-4be1-9d25-1c702747a496",
                                "sense_id": "9d7b9ae7-1d3c-3aa9-b46e-15365a879a2b",
                                "text": "Парень разжал руки и начал раскачиваться взад и вперёд, как маятник метронома."
                            },
                            {
                                "example_id": "2cb9d504-45b3-4e2d-9525-338f0c70465c",
                                "sense_id": "9d7b9ae7-1d3c-3aa9-b46e-15365a879a2b",
                                "text": "Громче застонали, сильнее стали раскачиваться камыши, будто хотели смести с неба затуманенное солнце."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4afeb68-9195-306d-b7b3-2aa951fed1c8",
                        "entry_id": "bf135c9b-0a38-3d0c-9c92-1d01dac7012d",
                        "glosses": [
                            "перен., неодобр. неспешно, непозволительно долго готовиться к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0f447a-b988-46fa-b1fd-0b6ff63fb00e",
                                "sense_id": "c4afeb68-9195-306d-b7b3-2aa951fed1c8",
                                "text": "Ждать до весны, раскачиваться, устраиваться, формироваться невозможно."
                            },
                            {
                                "example_id": "dab60484-8efe-4507-bd2c-329ef818c309",
                                "sense_id": "c4afeb68-9195-306d-b7b3-2aa951fed1c8",
                                "text": "Президент конкретно обозначил чёткие задачи и подчеркнул, что «проблема не даёт возможности долго раскачиваться»."
                            }
                        ]
                    }
                ],
                "translations": [],
