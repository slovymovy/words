                                    {
                                        "sense_id": "507e91c7-5f93-3598-9021-9db94b7c3214",
                                        "entry_id": "94b5f0c2-6a0f-397c-89f7-08fe606dfe3a",
                                        "glosses": [
                                            "Person, die Tote beschwört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a48006d-c5e2-4ca6-b21d-500de048a00c",
                                                "sense_id": "507e91c7-5f93-3598-9021-9db94b7c3214",
                                                "text": "Der Nekromant erweckte die Leiche zum Leben und machte sie zu seinem Diener."
                                            },
                                            {
                                                "example_id": "d33a2fb7-ec0d-4e86-ba98-6b65fac7cac7",
                                                "sense_id": "507e91c7-5f93-3598-9021-9db94b7c3214",
                                                "text": "„Ich fürchtete, dass die Nekromanten des Nordens diese Wesen sofort wieder zum Leben erwecken würden, dass diese Mückenzombies sich alle erheben würden, um mich zu entsaften.“"
                                            },
                                            {
                                                "example_id": "b137da05-c1ef-44eb-a52c-b7112f3d0a9d",
                                                "sense_id": "507e91c7-5f93-3598-9021-9db94b7c3214",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9ad62fd-bb35-471b-a769-25cf3fd0f9a2",
                        "source_entry_id": "d8de1dde-16f4-3137-b833-de6dec2f841f",
