                                            {
                                                "example_id": "4b4e677a-749f-45f0-a47e-c36caa014fe2",
                                                "sense_id": "c193e9f2-8424-32e5-b59c-9b9379da3821",
                                                "text": "It's a new film based on a best-selling novel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e961aa-5ab8-3108-b26b-8d16c30bfdb8",
