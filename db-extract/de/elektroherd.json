                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c4b87b-8ce5-49bd-be16-4746771412d5",
                                "sense_id": "1427c8a4-5aae-3bb1-ab98-c22d5518310b",
                                "text": "„Auch ein Gasherd oder Elektroherd gehört in unsere Liste der wichtigsten Haushaltsgeräte.“"
                            },
                            {
                                "example_id": "55e25de7-51b2-442f-9905-cb1fd28915db",
                                "sense_id": "1427c8a4-5aae-3bb1-ab98-c22d5518310b",
                                "text": "„Den Tisch mit der grau-weiß melierten Resopalplatte, den Kühlschrank und auch den Elektroherd hatten sie sich im Laufe der Jahre neu angeschafft.“"
                            }
                        ],
