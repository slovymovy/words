                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если разделить один на три, то тройка будет в <w>периоде</w>.",
