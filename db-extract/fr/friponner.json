                "senses": [
                    {
                        "sense_id": "4961ae40-4115-31a8-845a-3fe9040fd607",
                        "entry_id": "1ef7b492-91b3-33d7-8a7f-0e648c1b3885",
                        "glosses": [
                            "Réussir à voler quelque chose par ruse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4caae341-9196-4f34-88c3-15e7d8b18f6a",
                                "sense_id": "4961ae40-4115-31a8-845a-3fe9040fd607",
                                "text": "Il m’a friponné cent cinquante euros, le rat."
                            },
                            {
                                "example_id": "f20ee7cf-6bd7-4941-af5e-4b6a723dbcfe",
                                "sense_id": "4961ae40-4115-31a8-845a-3fe9040fd607",
                                "text": "Ça je n’en sais rien, mais lui et Staviskov ont friponné grave à Hemen Baita, je n’ai pas encore les détails."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d68bb18-6f11-35ce-900b-ff1e1821fae7",
                        "entry_id": "1ef7b492-91b3-33d7-8a7f-0e648c1b3885",
                        "glosses": [
                            "Dépouiller adroitement quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97e28cb-f503-4c87-804b-b377dbe6f8d1",
                                "sense_id": "7d68bb18-6f11-35ce-900b-ff1e1821fae7",
                                "text": "Je n’étais pas fripon, je fus friponné, je me ruinai."
                            }
                        ]
                    }
