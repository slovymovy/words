                        "examples": [
                            {
                                "example_id": "fdad42eb-3d98-4e0f-a728-2d12adac4ea8",
                                "sense_id": "64b109fb-65dc-38c1-b8d3-b4b8bf41638c",
                                "text": "Volgens berekeningen van analisten daalde de yenkoers circa 12 procent tegenover de dollar. Mede daardoor nam de omzet met eenvijfde toe tot 4020 miljard yen (34,2 miljard euro)."
                            },
