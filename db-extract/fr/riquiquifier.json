                ],
                "senses": [
                    {
                        "sense_id": "94c33b6c-2f34-385e-9638-0c3709455f5f",
                        "entry_id": "878b96dd-a012-3ec8-bf14-85c90f9672ca",
                        "glosses": [
                            "Rendre riquiqui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a642b5e1-410e-4b75-ad86-92274309dfa7",
                                "sense_id": "94c33b6c-2f34-385e-9638-0c3709455f5f",
                                "text": "Inventer, avec lui, une formule ou un petit rituel pour chasser ses peurs : chez nous, on a souvent fait fonctionner la « machine invisible à riquiquifier les peurs »."
                            },
                            {
                                "example_id": "40211619-f4cd-4b32-a22b-7402d311d8d3",
                                "sense_id": "94c33b6c-2f34-385e-9638-0c3709455f5f",
                                "text": "Au fait j'ai oublié de te remercier pour le tuto du sac de sport, je l'ai riquiquifié et transformé en trousse pour l'anniv' d'un petit gars, et c'était top !!!"
                            },
                            {
                                "example_id": "0e631a51-e7b5-4ddf-9134-8ba68677ab2c",
                                "sense_id": "94c33b6c-2f34-385e-9638-0c3709455f5f",
                                "text": "100 jours après le sommet de Copenhague, l’Everest à l’horizontal et en 2D de l’écologie, cet ersatz d’idéologie créé à l’image du monde qui l’a chié, cette sphère aplatie, ratatinée et riquiquifiée, les écolocrates et autres écolossociatifs plus ou moins glam, remettent le couvert de leurs « 60 minutes pour sauver la Terre »."
                            }
                        ]
                    }
                ],
