                "senses": [
                    {
                        "sense_id": "cf23ec67-b346-3b27-81a4-c1955d8279da",
                        "entry_id": "f4f4bb5e-7f9c-34c4-a115-3a3982e219e3",
                        "glosses": [
                            "Plaquer par un procédé électrochimique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441fcb9a-1ad2-4391-bf15-8e3146a69e1c",
                                "sense_id": "cf23ec67-b346-3b27-81a4-c1955d8279da",
                                "text": "La présente invention concerne l'utilisation d'un additif choisi à partir du groupe constitué par la silice amorphe, la poudre de graphite et un mélange de celles-ci, dans un procédé pour électroplaquer ou électropolir un métal sur substrat, à l'aide d'un liquide ionique comme électrolyte, pour augmenter l'épaisseur de couche métallique."
                            },
                            {
                                "example_id": "7ad85ad6-aa8b-4e4a-8674-04b8f7dc3179",
                                "sense_id": "cf23ec67-b346-3b27-81a4-c1955d8279da",
                                "text": "Procédé pour électroplaquer directement en zinc une bande à base d'aluminium"
                            },
                            {
                                "example_id": "880df432-08e7-474e-9413-b3ad70e53c21",
                                "sense_id": "cf23ec67-b346-3b27-81a4-c1955d8279da",
                                "text": "Il était ajouté qu'il était possible d'électroplaquer des couches d'or pur 24 carats sur la carrosserie inox."
                            }
                        ]
                    }
                ],
