                                "target_senses": [
                                    {
                                        "sense_id": "9b01fd87-8321-3c93-a912-77fd63676693",
                                        "entry_id": "d2316a33-7154-3416-aacf-a8dd75f86065",
                                        "glosses": [
                                            "Teil des Gehirns zwischen Hinterhirn und Zwischenhirn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f6e99b-1ef1-4ceb-8d7f-834324daae64",
                                                "sense_id": "9b01fd87-8321-3c93-a912-77fd63676693",
                                                "text": "„Er selbst wollte eigentlich auch nicht, die Tat vollzog sich aber trotz seines Nichtwollens gewissermaßen automatisch, sie vollzog sich hauptsächlich unter Beteiligung seines Mittelhirns: Er war nämlich stark alkoholisiert.“"
                                            }
