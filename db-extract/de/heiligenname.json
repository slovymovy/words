                "senses": [
                    {
                        "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                        "entry_id": "c251525d-5a35-3ddf-94d0-4c490f9b8640",
                        "glosses": [
                            "Name einer Person, die als Heilige/Heiliger verehrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296a83e5-d316-4c4f-b8c0-d45adbbde54b",
                                "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                                "text": "„Die beliebtesten Namen tragen derzeit höchstens noch zwei bis drei Prozent eines Altersjahrgangs. Ganz anders dagegen im Spätmittelalter, als die Heiligennamen die Namengebung europaweit und vor allem in den Städten eroberten.“"
                            },
                            {
                                "example_id": "f40d604e-fc3f-475b-98e9-eb0d12fa1253",
                                "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                                "text": "„Die Beliebtheit läßt dann nach, steigt aber in der Reformation wieder stark an, um – auch in Reaktion auf die katholischen Heiligennamen – durch die Wahl dieses Rufnamens die Menschen bewußt wieder auf die Nachfolge Christi zu verpflichten.“"
                            },
                            {
                                "example_id": "2726bbdd-e5e6-4419-a6a0-9b454dc2feb6",
                                "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                                "text": "„Die Reformation brachte eine Abkehr von den Heiligennamen; statt ihrer wurden in den protestantischen Familien Namen aus dem Alten Testament bevorzugt (…), oder man griff wieder auf altdeutsche Rufnamen zurück.“"
                            },
                            {
                                "example_id": "ddb2be50-b999-45b4-9a2e-2f500b63ef0f",
                                "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                                "text": "„Vor allem durch die seit dem 12. Jahrhundert zunehmende Heiligenverehrung werden die christlichen Heiligennamen weiter verbreitet.“"
                            },
                            {
                                "example_id": "b3963d75-0c2d-4e64-a2c3-60d516083cfb",
                                "sense_id": "1edcfd0a-591c-350c-8821-ff8349dcd4d9",
                                "text": "„Sankt Nimmerlein ist ein erfundener Heiligenname, der umgangssprachlich verwendet wird, um nach ihm einen Termin zu benennen, der niemals eintreten wird, den ‚Sankt-Nimmerleins-Tag‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
