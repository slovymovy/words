                    "sense_id": "b3a33746-163b-3b66-8eec-0490f36a89f4",
                    "sense_definition": "Een bolvormig voorwerp waarop baby's kunnen zuigen om zich te kalmeren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baby_artikelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby stopte met huilen zodra hij de <w>tul</w> in zijn mond kreeg.",
                            "target_lang_translations": {
                                "en": "The baby stopped crying as soon as he got the <w>pacifier</w> in his mouth."
                            }
                        },
                        {
                            "text": "Zorg ervoor dat je de <w>tul</w> regelmatig steriliseert voor de hygiëne.",
                            "target_lang_translations": {
                                "en": "Make sure to sterilize the <w>pacifier</w> regularly for hygiene."
                            }
