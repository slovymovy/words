                        "glosses": [
                            "een eiland waarop een fort is gebouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0fcde5-7265-406d-9706-5101587d99b5",
                                "sense_id": "5dd8a0bf-923b-39d9-a45c-f320de19b7ac",
                                "text": "Het zijn in totaal tien zegels. Alleen de Van Nellefabriek in Rotterdam ontbreekt. Unesco verklaarde het gebouw afgelopen juni tot werelderfgoed, maar toen werden de postzegels al gedrukt. De Stelling van Amsterdam is daarom twee keer afgebeeld, zowel het fort bij Spijkerboor als forteiland Pampus."
                            },
                            {
                                "example_id": "928c47b4-e6aa-4fa2-9653-d2de881db128",
                                "sense_id": "5dd8a0bf-923b-39d9-a45c-f320de19b7ac",
                                "text": "Het forteiland Pampus wordt weer een onbewoond eiland. Vanwege financiële problemen heeft de stichting die het eiland beheert ontslag aangevraagd voor de twee fortwachters Kris van de Voorde en Maartje Terwindt."
                            }
                        ]
                    }
