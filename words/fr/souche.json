                    ],
                    "common_phrases": [
                        "souche de cheminée"
                    ]
                },
                {
                    "sense_id": "66f6617d-14c3-34f0-aa5d-1018611c2bed",
                    "sense_definition": "Personne totalement immobile, passive ou insensible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté comme une <w>souche</w> pendant que tout le monde s'activait autour de lui."
                        },
                        {
                            "text": "Malgré l'annonce surprenante, elle ne réagit point et demeura immobile comme une <w>souche</w>."
