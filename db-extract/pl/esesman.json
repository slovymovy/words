                ],
                "translations": [
                    {
                        "translation_id": "0273fa33-6595-475f-8b56-ee2ef24900d3",
                        "source_entry_id": "f22a0765-c950-3c65-be51-d85b5ef96a9e",
                        "source_sense_id": "707f4df6-eb45-31ff-9ddf-e6f04cc18618",
                        "target_lang_word": "SS-Mann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SS-Mann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "279ba4da-4bd7-3693-bb7c-95f0b7afeffa",
                                        "entry_id": "cea89023-725f-3c6e-80a5-25d9c881226f",
                                        "glosses": [
                                            "Angehöriger der Schutzstaffel"
                                        ],
                                        "tags": [
                                            "Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a2de23a-50ef-4647-9b30-266ce9fc27b9",
                                                "sense_id": "279ba4da-4bd7-3693-bb7c-95f0b7afeffa",
                                                "text": "„Es gab einen berüchtigten SS-Mann, der aber zu den Kindern freundlich war.“"
                                            },
                                            {
                                                "example_id": "96475f8c-d4ae-444e-91ef-7ec25b7a114b",
                                                "sense_id": "279ba4da-4bd7-3693-bb7c-95f0b7afeffa",
                                                "text": "„SS-Männer hatten mich erschossen, eine Kugel mitten durch den Leib, vorn rein, im Rücken raus, ohne Schmerz, wenig Blut, aber ich war tot, und ich sah zu, wie sie meine Leiche auf der Bahre wegtrugen.“"
                                            },
                                            {
                                                "example_id": "0f514308-4180-424f-9a0d-8d7ef3b399cc",
                                                "sense_id": "279ba4da-4bd7-3693-bb7c-95f0b7afeffa",
                                                "text": "„Neben ihnen liefen SS-Männer, die alles andere als müde aussahen.“"
                                            },
                                            {
                                                "example_id": "029ef959-5f55-452f-89a9-de03fac85565",
                                                "sense_id": "279ba4da-4bd7-3693-bb7c-95f0b7afeffa",
                                                "text": "„Die Leute begreifen auch, warum ich unter allen SS-Leuten gerade Max Schulz verdächige, obwohl ich das nicht beweisen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
