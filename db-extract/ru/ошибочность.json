                        ]
                    },
                    {
                        "translation_id": "6dfea011-8e80-4556-889f-4a97797596dc",
                        "source_entry_id": "4967be51-13fa-39c4-9e5d-e94950fa001f",
                        "source_sense_id": "493fe840-f19c-33d0-bcac-d1dbc64d4b01",
                        "target_lang_word": "falsity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6ec86a-edd5-34f5-b759-a76b3a5ff03d",
                                        "entry_id": "96879a67-2a09-3d7e-ba53-f6ec26e01add",
                                        "glosses": [
                                            "Something that is false; an untrue assertion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ded4f57-4cd4-404a-93ea-d7b17da01a02",
                                                "sense_id": "6f6ec86a-edd5-34f5-b759-a76b3a5ff03d",
                                                "text": "The belief that the world is flat is a falsity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "880736fa-7804-35d9-96a6-e07885e8248c",
                                        "entry_id": "96879a67-2a09-3d7e-ba53-f6ec26e01add",
                                        "glosses": [
                                            "The characteristic of being untrue."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6641dcab-bf72-4a10-bffb-0b39c0b91144",
                                                "sense_id": "880736fa-7804-35d9-96a6-e07885e8248c",
                                                "text": "The falsity of that statement is easily proven."
                                            },
                                            {
                                                "example_id": "39dcd52b-d393-43c6-a20f-b78ecfd0281b",
                                                "sense_id": "880736fa-7804-35d9-96a6-e07885e8248c",
                                                "text": "The Party intellectual knows in which direction his memories must be altered; he therefore knows that he is playing tricks with reality; but by the exercise of DOUBLETHINK he also satisfies himself that reality is not violated. The process has to be conscious, or it would not be carried out with sufficient precision, but it also has to be unconscious, or it would bring with it a feeling of falsity and hence of guilt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
