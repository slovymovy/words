                    {
                        "sense_id": "c12092a2-bf84-3655-b881-8e87eb3a3c3b",
                        "entry_id": "e2598ab2-7a45-3fe3-a8ee-5947c147bcb8",
                        "glosses": [
                            "een wedstrijd die meetelt in de strijd om een beker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82926d55-cdf6-4c61-9b2c-fd0c659355e4",
                                "sense_id": "c12092a2-bf84-3655-b881-8e87eb3a3c3b",
                                "text": "Ajax verloor de bekerwedstrijd tegen Heracles."
                            },
                            {
                                "example_id": "799625e1-7311-4afd-ac65-11a101facabc",
                                "sense_id": "c12092a2-bf84-3655-b881-8e87eb3a3c3b",
                                "text": "Na het uitblijven van een doorbraak bij Ajax stapte Bakker afgelopen zomer transfervrij over naar PSG. Hij maakte op 29 januari tegen Pau (0-2 winst) in de Franse beker al zijn debuut in het eerste. Drie dagen geleden deed hij ook mee in de bekerwedstrijd tegen Dijon (1-6 winst)."
                            },
                            {
                                "example_id": "0176faf6-cc88-41aa-aab4-fc76bff40ddc",
                                "sense_id": "c12092a2-bf84-3655-b881-8e87eb3a3c3b",
                                "text": "Gregg, die dertien dagen na de ramp bij München alweer in een bekerwedstrijd het doel verdedigde, droeg tussen 1957 en 1966 bijna 250 keer het shirt van Manchester United."
                            }
                        ]
                    }
