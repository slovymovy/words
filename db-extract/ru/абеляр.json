                "senses": [
                    {
                        "sense_id": "207ed93a-b4fa-36c9-8c0c-957785db694e",
                        "entry_id": "08f907ec-70dc-3a6b-b99c-96a9cd2bdf8a",
                        "glosses": [
                            "французская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84a8259a-dbf5-425f-9481-a984cc0e2ba6",
                                "sense_id": "207ed93a-b4fa-36c9-8c0c-957785db694e",
                                "text": ".. школа Нотр-Дам была первой во Франции школой богословия, можно сказать, первым французским университетом, где преподавали такие знаменитые богословы-философы и риторики, как Гийом де Шампо, Пьер Абеляр, Морис де Сюлли, Святой Доминик и Святой Бонавентура."
                            },
                            {
                                "example_id": "12cff994-6804-461d-a42e-d079fc4ee5a0",
                                "sense_id": "207ed93a-b4fa-36c9-8c0c-957785db694e",
                                "text": "В XII веке в школе при Нотр-Дам здесь преподавал 40-летний священник и философ Пьер Абеляр, полюбивший 17-летнюю Элоизу."
                            }
                        ]
                    }
