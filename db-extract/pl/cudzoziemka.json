                "senses": [
                    {
                        "sense_id": "a18709d0-66c9-30a5-9728-56e282aa0019",
                        "entry_id": "555ae20c-e523-30e2-a7df-5bdb647899a8",
                        "glosses": [
                            "Bewohnerin und/oder Bürgerin eines fremden Landes; Ausländerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125f3248-6396-4099-9d9a-ec2725038a2b",
                                "sense_id": "a18709d0-66c9-30a5-9728-56e282aa0019",
                                "text": "Jego brat ożenił się z cudzoziemką.",
                                "translation": "Sein Bruder heiratete eine Ausländerin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e330c29-785a-426a-b8e9-b462af83dcef",
                        "source_entry_id": "555ae20c-e523-30e2-a7df-5bdb647899a8",
                        "source_sense_id": "a18709d0-66c9-30a5-9728-56e282aa0019",
                        "source_sense_description": "Bewohnerin und/oder Bürgerin eines fremden Landes; Ausländerin",
                        "target_lang_word": "Ausländerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausländerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "946522f6-251a-317d-96c2-1f903aaea7e0",
                                        "entry_id": "bb6649ec-d3a9-3046-b1a8-770188e55a82",
                                        "glosses": [
                                            "weiblicher Ausländer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e324a2-70d9-4d9a-bf1f-4c266a3acaff",
                                                "sense_id": "946522f6-251a-317d-96c2-1f903aaea7e0",
                                                "text": "So gut wie ihre Aussprache ist, meint man kaum, dass sie Ausländerin ist."
                                            },
                                            {
                                                "example_id": "727ef6a0-92f1-49be-92c4-405d06fb9da1",
                                                "sense_id": "946522f6-251a-317d-96c2-1f903aaea7e0",
                                                "text": "„Auf lange Sicht ist damit zu rechnen, daß ein großer Teil der zugewanderten Ausländerinnen und Ausländer in der deutschen Gesellschaft aufgehen wird, sicher nicht ohne bewußt bewahrte Rückstände des Andersseins, aber keineswegs nur in Äußerlichkeiten ‚eingedeutscht‘.“"
                                            },
                                            {
                                                "example_id": "0f4aa356-73f3-45a5-845a-510186861099",
                                                "sense_id": "946522f6-251a-317d-96c2-1f903aaea7e0",
                                                "text": "„Bei den Respektlosigkeiten, Beleidigungen und Erniedrigungen, die ich mir als Frau und auch als Ausländerin gefallen lassen muss, fällt mir das schon deutlich schwerer.“"
                                            },
                                            {
                                                "example_id": "60b5b959-52b5-4906-9949-627509bcc48b",
                                                "sense_id": "946522f6-251a-317d-96c2-1f903aaea7e0",
                                                "text": "„Davor war ich die Türkin, davor die Ausländerin und wieder davor die Arbeitertochter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
