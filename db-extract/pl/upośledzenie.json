                "translations": [
                    {
                        "translation_id": "1842a7bc-aa24-4724-81ef-4b900fc79b5e",
                        "source_entry_id": "4dda2717-80f9-341b-823f-4ec8f17935dc",
                        "source_sense_id": "12384d4d-29d6-3f0b-bab8-d6113580ce5a",
                        "target_lang_word": "handicap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Something that prevents, hampers, or hinders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbaea73d-8a1d-48ae-af1e-aff6170090a5",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Age is often a handicap."
                                            },
                                            {
                                                "example_id": "2ad4a5a7-5db0-422c-ae84-985eb873fee7",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An allowance of a certain amount of time or distance in starting, granted in a race (or other contest of skill) to the competitor possessing disadvantages; or an additional weight or other hindrance imposed upon the one possessing advantages, in order to equalize, as much as possible, the chances of success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab7bf2c-4383-4205-b54b-c10184cade4a",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "The older boy won, even though his opponent had been granted a handicap of five meters."
                                            },
                                            {
                                                "example_id": "ff2e065f-920c-4ec7-8f76-eb4544b82c55",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "A handicap in chess often involves removal of the queen's rook."
                                            },
                                            {
                                                "example_id": "05245edf-16e8-488d-9f58-49e815f1de16",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "Eventually the elephant and camel were depatched by themselves with two laps start of the bicyclist and horse, the motor car being scratch. It was a sensational race owing to the conduct of the field, but on the handicap the elephant won, bicycle second, motor car third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa05bf8-d42f-382b-8f62-79b17724b471",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "The disadvantage itself, in particular physical or mental disadvantages of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "403de27e-71b0-3d19-9e07-0308d1f4be11",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "A race or similar contest in which there is an allowance of time, distance, weight, or other advantage, to equalize the chances of the competitors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An old card game, similar to lanterloo."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb76d35-0873-41cc-877b-6eba6e9eb4db",
                                                "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                                "text": "Here some of us fell to handicap, a sport that I never knew before, which was very good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f462b6b-f912-3bbb-a6b0-a8d8825e0a96",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Synonym of hand-in-cap (“old English trading game”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "handicap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b5bd25-2df1-31aa-975d-035590315424",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To encumber with a handicap in any contest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4511a661-f13d-3339-a7a1-b451791572a1",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To place at disadvantage."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc317a3-d8b5-4fa7-a397-2f603b409da4",
                                                "sense_id": "4511a661-f13d-3339-a7a1-b451791572a1",
                                                "text": "The candidate was handicapped by her lack of experience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689fa9a9-4d7e-3e7b-9a2c-60a307d1877a",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To estimate betting odds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729de6cd-5d9b-40c0-8209-a5d65f443a77",
                                                "sense_id": "689fa9a9-4d7e-3e7b-9a2c-60a307d1877a",
                                                "text": "Grandpa Andy would buy the racing form the day ahead of time so he could handicap the race before he even arrived at the track."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7b9085-41ee-41c6-b774-f7e308efcffe",
                        "source_entry_id": "4dda2717-80f9-341b-823f-4ec8f17935dc",
                        "source_sense_id": "12384d4d-29d6-3f0b-bab8-d6113580ce5a",
                        "target_lang_word": "Behinderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behinderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                        "entry_id": "91cd3a52-5887-35c4-b5bd-28181c1aa182",
                                        "glosses": [
                                            "körperliche oder psychische Funktionsstörung einer Person, so dass sie von dem für das Lebensalter typischen Zustand abweicht und daher ihre Teilhabe am Leben der Gesellschaft beeinträchtigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b5b9c2-7e60-4ebe-bf81-2dfa7850a414",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "Behinderungen führen in vielen Fällen dazu, dass jemand seinen Alltag nicht allein bewältigen kann."
                                            },
                                            {
                                                "example_id": "900dd549-01eb-463d-95b0-560cf85f8bf1",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Die Inklusion an Schulen finden viele Menschen gut. Denn dann fühlen sich Kinder mit Behinderung weniger ausgeschlossen. Und Kinder ohne Behinderung lernen schon früh mit Menschen umzugehen, die eine Behinderung haben. Davon haben beide Seiten etwas.“"
                                            },
                                            {
                                                "example_id": "c3da7dbe-f5de-4379-a9ab-ecece3993b3e",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Seine Schwester Marie ist Lukas Rieger ganz besonders wichtig. […] Sie hat eine seltene Krankheit, die eine Behinderung zur Folge hat.“"
                                            },
                                            {
                                                "example_id": "b0f497a2-c072-40ac-ab8a-b4c6f991a103",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Bei einigen Patienten wird eine langfristige Behinderung zurückbleiben, andere werden sich gut erholen\", so Michael Zandi.“"
                                            },
                                            {
                                                "example_id": "12f03ccb-0c9d-4933-8a77-bf096340a61b",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Dieser Claus trug die Schellenkappe nicht aus Schlauheit, sondern wegen seiner geistigen Behinderung, wie wir heute sagen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                        "entry_id": "91cd3a52-5887-35c4-b5bd-28181c1aa182",
                                        "glosses": [
                                            "Maßnahme oder Ereignis, die dazu führt, dass etwas Beabsichtigtes nicht oder nur erschwert getan werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e835b2c-e73c-4874-9d20-3692fae60b39",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Baustellen führen oft zu starken Behinderungen im Reiseverkehr."
                                            },
                                            {
                                                "example_id": "831100cf-30a9-491d-9c2d-8f75f88ca2ae",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "[…] eine neue Aschewolke des Vulkans Eyjafjallajökull [sorgt] bereits am kommenden Montag, dem 17. Mai 2010, voraussichtlich für neue Behinderungen im europäischen Luftraum."
                                            },
                                            {
                                                "example_id": "ca53f8d7-96d7-481d-b51e-df059dc06c71",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Der öffentliche Nahverkehr wird weiträumig umgeleitet. […] Besonders Anwohner mussten deshalb Behinderungen hinnehmen."
                                            },
                                            {
                                                "example_id": "57be4bae-8c08-4d97-b6ac-d51dbcb17458",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Bei Verstößen [gegen die Winterreifenpflicht] droht ein Bußgeld von 20 Euro, bei Behinderung Anderer 40 Euro sowie ein Punkt in Flensburg."
                                            },
                                            {
                                                "example_id": "64caad04-ea27-4bca-af34-eeaf575b4068",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Ein Kurzschluss führte zum Stromausfall der Schweizer Bahnen. Bis heute Morgen gab es noch immer Behinderungen im Schweizer Bahnverkehr (SBB)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
