                                "target_senses": [
                                    {
                                        "sense_id": "0cab2f43-5c67-3cb9-bf0a-fd97367c99a7",
                                        "entry_id": "c3ba4537-4c0c-39f9-a4be-13c7c877cf2b",
                                        "glosses": [
                                            "Synonym of ergot."
                                        ],
                                        "tags": [
