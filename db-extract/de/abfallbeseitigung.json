                        "examples": [
                            {
                                "example_id": "04c251a5-9930-4b7e-8f52-176b1cf4769f",
                                "sense_id": "2b39064f-0293-359c-8ccc-6c0b9071354c",
                                "text": "„Abfallverwertung hat Vorrang vor Abfallbeseitigung – es sei denn, diese sei besser umweltverträglich.“"
                            },
                            {
                                "example_id": "62862d47-93d4-450a-a327-bbe8eab2f59c",
                                "sense_id": "2b39064f-0293-359c-8ccc-6c0b9071354c",
                                "text": "„Allgemein kommt der Abfallvermeidung Vorrang vor der Abfallverwertung zu und diese soll wiederum Vorrang vor der Abfallbeseitigung haben.“"
                            }
                        ],
