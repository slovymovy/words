                "senses": [
                    {
                        "sense_id": "7e1d8a20-ce47-3c9a-959c-af06f73ba46d",
                        "entry_id": "debb0eba-96fb-30e0-bc76-3a375b3c4046",
                        "glosses": [
                            "Pénétrer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8c0afec8-8e61-4fc1-9188-b15e2f0fba60",
                                "sense_id": "7e1d8a20-ce47-3c9a-959c-af06f73ba46d",
                                "text": "Pour entifler le Milieu, il fallait, à part de rares exceptions, avoir étudié dans le ruisseau et fait ses preuves."
                            },
                            {
                                "example_id": "5a4f6970-2be1-47e5-bf5c-ec2cdec79be0",
                                "sense_id": "7e1d8a20-ce47-3c9a-959c-af06f73ba46d",
                                "text": "Si j’en connaissais un petit bout comment l’Achille m’entiflait !"
                            }
                        ]
                    },
                    {
                        "sense_id": "70fef878-f89a-394f-987f-dbe477602d9f",
                        "entry_id": "debb0eba-96fb-30e0-bc76-3a375b3c4046",
                        "glosses": [
                            "Se marier."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "e10194ea-3f5d-4cb6-9e95-1f066f5e307d",
                                "sense_id": "70fef878-f89a-394f-987f-dbe477602d9f",
                                "text": "Dis donc, la môme, tu vas pas t’entifler avec ce cave !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5ca571a-851f-3091-a5f3-6b427ab4b81b",
                        "entry_id": "debb0eba-96fb-30e0-bc76-3a375b3c4046",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
