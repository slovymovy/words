                ],
                "senses": [
                    {
                        "sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
                        "entry_id": "3fbe9d17-3d0a-30b7-b422-9a3fa89d96b8",
                        "glosses": [
                            "beschönigend/euphemistisch: die Nacht vom 9. auf den 10. November 1938, in der durch die SA jüdische Synagogen in Brand gesteckt und jüdische Geschäfte zerstört wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe33d0e-423d-4921-9dbb-427273a71395",
                                "sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
                                "text": "In der Reichskristallnacht wurden viele Menschen ermordet."
                            },
                            {
                                "example_id": "aa8ef79e-6abe-4e81-b5b3-9ccf3c84a02f",
                                "sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
                                "text": "„Auf dem Weg zu seiner kleinen Pension wurde er in dieser Nacht, die später als die Reichskristallnacht in die Geschichte einging, Zeuge, wie aufgehetzte Jugendliche und uniformierte SA-Männer jüdische Geschäfte und Wohnungen zerstörten.“"
                            },
                            {
                                "example_id": "203c9a47-9678-4292-9d6c-b5495647450a",
                                "sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
                                "text": "„Kurz vor der Reichskristallnacht, in der die Synagogen in Flammen aufgingen, gelang es seiner Frau, ihren zögernden Mann nach Frankreich zu schleusen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21e5f528-8aa9-4e70-9f72-4ad5703f8cf9",
                        "source_entry_id": "3fbe9d17-3d0a-30b7-b422-9a3fa89d96b8",
                        "source_sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
