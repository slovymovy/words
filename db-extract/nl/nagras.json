                        "entry_id": "840849b7-a8c0-3f26-afa8-812c670dd669",
                        "glosses": [
                            "gras dat op een weide groeit waarvan al eerder in het jaar het hooi is geoogst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b36e3f5-79e2-4ba8-82ea-338ac967d88d",
                                "sense_id": "057d2dd6-7f15-368d-84ab-695e37fa505f",
                                "text": "Etgroen, etgras of nagras is het tweede grasgewas dat na het maaien van het eerste opschiet."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d6f1b79-d926-3f32-9c6b-2539236c5944",
                        "entry_id": "840849b7-a8c0-3f26-afa8-812c670dd669",
                        "glosses": [
                            "het overschot; nawoord"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "29c6061d-a65c-48f4-b8ed-a03509be05aa",
                                "sense_id": "3d6f1b79-d926-3f32-9c6b-2539236c5944",
                                "text": "Dinsdag trof ik in Puntkomma de recensie van ”Eb” aan, de prachtige roman van Rebekka Bremmer die een dag uit het wachtende leven van vissersvrouw Geeske beschrijft. Lees die bespreking –het gras– vooral. Maar voor fervente grazers hierbij nog wat nagras."
                            }
                        ]
                    }
                ],
