                "senses": [
                    {
                        "sense_id": "d8478561-9e96-3eb3-8bde-1a7af0f7dd7e",
                        "entry_id": "adac391f-69d8-3e43-b583-c4f1fe837b32",
                        "glosses": [
                            "jemand, der als Angestellter in einem Hotel arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2d2f16-d6b5-406d-b13e-5eaa06ebe9a0",
                                "sense_id": "d8478561-9e96-3eb3-8bde-1a7af0f7dd7e",
                                "text": "„Der Hotelangestellte an der Rezeption reserviert für uns Zugtickets nach Teheran für den nächsten Morgen.“"
                            },
                            {
                                "example_id": "543e0505-824d-43b3-8625-233139138886",
                                "sense_id": "d8478561-9e96-3eb3-8bde-1a7af0f7dd7e",
                                "text": "„Der Verdächtige ist laut Polizei ein Hotelangestellter, der sich am Montag dieser Woche gegen 6 Uhr morgens mit Hilfe eines Duplikats der Schlüsselkarte Zugang zum Zimmer der Frau verschafft haben soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
