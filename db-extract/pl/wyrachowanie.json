                        "translation_id": "2f8c35fe-bf1f-4d07-8d14-f8a72422343d",
                        "source_entry_id": "5f58410a-0ca2-350f-871e-b1dbf0f00f78",
                        "source_sense_id": "6e1e919f-3f3f-3af1-a7a0-8f3dc1d53cce",
                        "target_lang_word": "Berechnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berechnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                        "entry_id": "8bd494b0-9158-3e8b-860d-ccc134ea41d7",
                                        "glosses": [
                                            "Auflösen von Formeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67c93a1-bd2f-4303-b5d4-d094dfdf13ea",
                                                "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                                "text": "Die Berechnung der Fläche eines Quadrats kann einfach durch das Quadrieren der Seitenlänge erfolgen."
                                            },
                                            {
                                                "example_id": "2c5a29b6-f87e-4301-8aa2-963101c016c1",
                                                "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                                "text": "„Da kommt ein einziger Dax-Vorstandschef Berechnungen zufolge auf Pensionszusagen von 30 Millionen Euro, insgesamt liegt die Summe der Rückstellungen für Pensionen im Dax bei sagenhaften 637 Millionen Euro.“"
                                            },
                                            {
                                                "example_id": "f66e1d5b-e210-4c78-ad2e-31478b73773e",
                                                "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                                "text": "„Hohe Rendite steht für hohes Risiko, darüber sollten sich Kapitalanleger bewusst sein. Statt auf die Höhe der Rendite zu schielen, sollte man daher besser prüfen, worauf die Berechnungen basieren und ob die Annahmen auch langfristig gelten.“"
                                            },
                                            {
                                                "example_id": "7a73ea4a-b5f6-4b0c-aeaf-9c4ccaf2b3d2",
                                                "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                                "text": "„Er legte das Ergebnis seiner Berechnungen bald auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "68e42191-3e9a-4811-ad83-5a9aacd7a955",
                                                "sense_id": "6ee0ec45-df88-3e9a-80d6-93047af42072",
                                                "text": "„Und er nahm seine Berechnung wieder auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "673410fc-8a99-31da-8444-8b00d540c364",
                                        "entry_id": "8bd494b0-9158-3e8b-860d-ccc134ea41d7",
                                        "glosses": [
                                            "wohlüberlegte Planung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e509df3f-7732-42ad-93da-d0e9c2f05b5e",
                                                "sense_id": "673410fc-8a99-31da-8444-8b00d540c364",
                                                "text": "Der Berater hat ihn mit kalter Berechnung hereingelegt."
                                            },
                                            {
                                                "example_id": "0d03b295-a967-46f0-944c-ec77288d852a",
                                                "sense_id": "673410fc-8a99-31da-8444-8b00d540c364",
                                                "text": "„Denn Engelke war einer von den guten Menschen, die nicht aus Berechnung oder Klugheit, sondern von Natur hingebend und demütig sind und in einem treuen Dienen ihr Genüge finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5fb809-6ea6-4e8c-baf1-af0638803306",
                        "source_entry_id": "5f58410a-0ca2-350f-871e-b1dbf0f00f78",
                        "source_sense_id": "6e1e919f-3f3f-3af1-a7a0-8f3dc1d53cce",
                        "target_lang_word": "Kalkül",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalkül",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c95dc830-f279-3e23-ba6b-b9f4fa6714f3",
                                        "entry_id": "d19a7e25-90f9-31b7-a15e-8eee58afc369",
                                        "glosses": [
                                            "Methode zur systematischen Lösung bestimmter Probleme"
                                        ],
                                        "tags": [
                                            "Logik",
                                            "nur Maskulinum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403d66dc-6ffb-436d-872f-69c69107a1e9",
                                                "sense_id": "c95dc830-f279-3e23-ba6b-b9f4fa6714f3",
                                                "text": "Für moralische Probleme entwarf Jeremy Bentham den hedonistischen Kalkül."
                                            },
                                            {
                                                "example_id": "59aa6045-1fe6-4151-8a32-8cff9d497d97",
                                                "sense_id": "c95dc830-f279-3e23-ba6b-b9f4fa6714f3",
                                                "text": "„Wer mit dem Ergebnis dennoch unzufrieden ist, sollte nicht übersehen, daß auch in der Mathematik durch Kalküle keineswegs die gesamte Wissenschaft ausgeschöpft wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                        "entry_id": "d19a7e25-90f9-31b7-a15e-8eee58afc369",
                                        "glosses": [
                                            "Vollzug einer Erwägung, Überlegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b7d08d-3bb6-487e-85f8-5db4900f7bff",
                                                "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                                "text": "Wir hatten diese Komplikationen in unser Kalkül einbezogen."
                                            },
                                            {
                                                "example_id": "65d1b0b9-2bdb-4bcc-a67d-4faa6621bf19",
                                                "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                                "text": "„Zunächst ging sein Kalkül auf.“"
                                            },
                                            {
                                                "example_id": "3161207e-a548-4f04-9709-5c6e28d8f5a6",
                                                "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                                "text": "„Das Kalkül ging auf: Fast den ganzen 31. Juli über war sein Lokal bis auf den letzten Platz gefüllt, die Umsätze entwickelten sich prächtig.“"
                                            },
                                            {
                                                "example_id": "4b0a7157-1b41-4d01-9cd2-998b254285f1",
                                                "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                                "text": "„Diese Politik wird nicht allein vom Rassismus der Buren angetrieben, sondern auch vom strategischen Kalkül der National Party.“"
                                            },
                                            {
                                                "example_id": "3292a7d9-6b7a-477f-a4da-12ca681e3f40",
                                                "sense_id": "e6f4544c-8df9-3845-9505-6a3e0d23c7d1",
                                                "text": "„Nach dem Kalkül der anderen Fürsten soll er allerdings wohl nicht mehr sein als ein Anhängsel der Kaiserin, kontrolliert vom Rat der Minister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
