                    {
                        "translation_id": "14b97a25-daf9-40a3-a59c-f51ceae8836a",
                        "source_entry_id": "0f8045fa-b7fd-36b2-a879-5e100ef14554",
                        "source_sense_id": "5f6007b9-d584-3361-86bc-df582dce3504",
                        "target_lang_word": "Schmuggel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmuggel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                        "entry_id": "9087c983-8648-35f0-adce-94d6b5a0a857",
                                        "glosses": [
                                            "heimlicher Transport zollpflichtiger oder verbotener Waren beziehungsweise von nicht zum Übertritt berechtigten Personen über Grenzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6ee4d8d-62bb-4108-8795-6d58c02e399b",
                                                "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                                "text": "In der Nachkriegszeit war Schmuggel an vielen Grenzen üblich."
                                            },
                                            {
                                                "example_id": "ea59d1d4-51e4-4327-bb6f-45f360233fba",
                                                "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                                "text": "„Zu jener Zeit saß er eine dreimonatige Haftstrafe wegen Schmuggels ab - er hatte Feuersteine in den Hosentaschen nach Polen geschmuggelt.“"
                                            },
                                            {
                                                "example_id": "d85c6d37-7fb7-4601-97f6-e29e78a7423d",
                                                "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                                "text": "„Viele muslimische Händler umgehen das Monopol der Europäer, Schmuggel ist verbreitet.“"
                                            },
                                            {
                                                "example_id": "f7cf1b9a-34ef-4431-9b9b-993fcbb4c109",
                                                "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                                "text": "„Am besten florierten Schmuggel, Geldwäsche und internationaler Waffenhandel.“"
                                            },
                                            {
                                                "example_id": "ec11601d-cacd-43c1-9a22-bcb80cae6de7",
                                                "sense_id": "d7f1c709-89ae-3c76-8ef5-f6dd761d49b3",
                                                "text": "„Wenn die stillschweigende Duldung der Zollbeamten dem Schmuggel in China rechtfertigt, dann tut sie das auch in London und möglicherweise New York.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
