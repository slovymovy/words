                        "form": "неизмери́мо"
                    },
                    {
                        "form_id": "6c919fbb-97a8-4a1a-8c09-08bfc3d76cf7",
                        "entry_id": "e9e0b739-8722-3c19-ac30-bb0cb2030cde",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "неизмери́ма"
                    },
                    {
                        "form_id": "a5485d21-ed2d-4594-8326-249b34239d7a",
                        "entry_id": "e9e0b739-8722-3c19-ac30-bb0cb2030cde",
                        "tags": [
                            "plural",
