                        "examples": [
                            {
                                "example_id": "587e6d38-f66d-4a2c-a4bb-80da7293ab5d",
                                "sense_id": "3b286cca-7553-320c-ad83-29842aae468d",
                                "text": "Et, se retournant vers ses chevaux, il leur cingla une râclée de coups de fouet qui leur fit prendre le galop : la voiture allait d’un bord à l’autre de la route."
                            },
                            {
                                "example_id": "4d4ea546-e51b-40f2-973e-9a4be528569c",
                                "sense_id": "3b286cca-7553-320c-ad83-29842aae468d",
                                "text": "Le père Larache l’avait attrapé par son sarrau, entre les épaules, et lui administrait une râclée sur les jambes, à coups de pique-feu."
                            },
                            {
                                "example_id": "51e81773-d5e3-4cec-92ee-0a48c5206d11",
                                "sense_id": "3b286cca-7553-320c-ad83-29842aae468d",
                                "text": "Attends un peu, femme, que je te passe la râclée !"
                            },
                            {
                                "example_id": "442f98c9-995a-42c9-b127-daed5968f2f4",
                                "sense_id": "3b286cca-7553-320c-ad83-29842aae468d",
                                "text": "Polype, qui s’attendait à soulever l’indignation et à recevoir une râclée formidable, est tout oppressé d’entendre de joyeuses paroles et de bénéficier d’un accueil plutôt cordial."
                            }
                        ]
                    }
