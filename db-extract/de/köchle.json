                ],
                "senses": [
                    {
                        "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                        "entry_id": "652d57db-a876-32f8-8496-68282586fe8a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a521bb71-f40e-40e3-afaa-832fe23f9d2f",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Frau Köchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "63f92b6d-43c2-4d9a-8f29-07e98efa5db1",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Herr Köchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b85be7cd-5b70-40d2-8744-33e7f6a2d302",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Die Köchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "195ea9d3-6bd6-4971-9703-c6c056f3bcf9",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Der Köchle trägt nie die Pullover, die die Köchle ihm strickt."
                            },
                            {
                                "example_id": "c5769318-eebc-4d74-b0a7-dc6614c27f50",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Köchle kommt, geht der Herr Köchle.“"
                            },
                            {
                                "example_id": "9814a188-62f6-456f-8552-7dc4e731cfc1",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Köchle kommt und geht."
                            },
                            {
                                "example_id": "11a8361d-1001-49b8-a404-6d406440c5d4",
                                "sense_id": "780aa1fd-6b93-3be0-8f8c-df67ca4d9dd4",
                                "text": "Köchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
