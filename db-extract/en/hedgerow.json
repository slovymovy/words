                        "target_lang_word": "Hecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                        "entry_id": "312573e8-210c-3d63-b360-187f4b8c40d8",
                                        "glosses": [
                                            "Aufwuchs dicht beieinander stehender und stark verzweigter Sträucher oder Büsche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6672f2b-3494-41b6-ba37-7910733cf781",
                                                "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                                "text": "Der Vogel nistet in Hecken am Rande der Äcker."
                                            },
                                            {
                                                "example_id": "20e82715-3688-4b55-bc12-88df46f581d8",
                                                "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                                "text": "„Wir bogen nun links ab, an hohen Hecken vorbei, bis ein Bauernhof in Sichtweite kam.“"
                                            },
                                            {
                                                "example_id": "d487285f-6602-4b43-8f3b-6198be36b884",
                                                "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                                "text": "„Die Hecke war sorgfältig geschnitten, vor dem Haus blühten Rittersporn und Phlox.“"
                                            },
                                            {
                                                "example_id": "169ff23f-b950-4e27-b120-547467f6d9d1",
                                                "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                                "text": "„Beide Mädchen wandelten Arm in Arm durch die Hecken und Pflanzungen ihrem Häuschen zu, ohne ein Wort zu sprechen.“"
                                            },
                                            {
                                                "example_id": "2c758d6c-a288-47ba-be3b-8f433ff4e4e3",
                                                "sense_id": "e21108d6-ad0a-34db-a0c8-6e0a5332be8b",
                                                "text": "„Ursprünglich umgab wohl nur eine Hecke den Kultbezirk, nach der römischen Eroberung wurde er aber als modernes Gebäude aus Mauerwerk und gebranntem Kalk aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                        "entry_id": "312573e8-210c-3d63-b360-187f4b8c40d8",
                                        "glosses": [
                                            "angepflanzte und gepflegte Umzäunung aus lebenden Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c8813c-1c01-48d8-993a-dfa87b0d0582",
                                                "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                                "text": "„Die Hecke war sorgfältig geschnitten, vor dem Haus blühten Rittersporn und Phlox.“"
                                            },
                                            {
                                                "example_id": "2c999874-cbee-4e46-92da-bf51e7faf8df",
                                                "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                                "text": "„Beide Mädchen wandelten Arm in Arm durch die Hecken und Pflanzungen ihrem Häuschen zu, ohne ein Wort zu sprechen.“"
                                            },
                                            {
                                                "example_id": "e9c7a6ba-7399-477f-a215-6979881edb55",
                                                "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                                "text": "„Ursprünglich umgab wohl nur eine Hecke den Kultbezirk, nach der römischen Eroberung wurde er aber als modernes Gebäude aus Mauerwerk und gebranntem Kalk aufgeführt.“"
                                            },
                                            {
                                                "example_id": "b642bf0a-0fb5-4faf-8d93-7e34f9163690",
                                                "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                                "text": "Wir möchten zur Straße hin eine Hecke aus Liguster pflanzen."
                                            },
                                            {
                                                "example_id": "f622101f-ac6c-4254-9bc5-c244492b98c1",
                                                "sense_id": "8ee3c5e9-e163-3f96-9289-f06a4e457fa6",
                                                "text": "„Fabiola zuckte zusammen, als eine Katze kurz vor ihnen aus einer Hecke sprang und nach rechts über die Straße lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "259931cc-e930-319c-a2a5-15a71ec55ef6",
                                        "entry_id": "312573e8-210c-3d63-b360-187f4b8c40d8",
                                        "glosses": [
                                            "Falle zum Fangen von Wild (oft von Wilddieben verwendet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6c84b2b-8962-44d6-8959-ad607661fdbc",
                                                "sense_id": "259931cc-e930-319c-a2a5-15a71ec55ef6",
                                                "text": "Es war eine mondlose Nacht, pechschwarz, und die Wilddiebe konnten ihre Hecken unbemerkt stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
