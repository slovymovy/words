                ],
                "senses": [
                    {
                        "sense_id": "a24d842e-308b-37ff-a021-384fe59ab887",
                        "entry_id": "e06a21ee-d6b4-3692-a1db-d3c310f2bbc9",
                        "glosses": [
                            "Métaplasme qui consiste dans l'addition d'une lettre ou d'une syllabe au commencement d'un mot, sans en changer le sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6153512c-0f9f-44bc-bf48-cb39f4d474c8",
                                "sense_id": "a24d842e-308b-37ff-a021-384fe59ab887",
                                "text": "La prosthèse ne constitue pas un préfixe. Il s'agit d'une forme destinée à faciliter la prononciation en formant une nouvelle syllabe à partir d'un ensemble de consonnes."
                            },
                            {
                                "example_id": "654f936f-d8c8-43b7-a90d-a3ee68a01988",
                                "sense_id": "a24d842e-308b-37ff-a021-384fe59ab887",
                                "text": "La prosthèse est un phénomène fréquent du passage du latin au français dans les groupes du type consonne « s » et consonne (p, k, t). La voyelle prosthétique est le plus souvent « e »."
                            },
                            {
                                "example_id": "9b9e62d6-9517-4030-80f1-b17514eea6f1",
                                "sense_id": "a24d842e-308b-37ff-a021-384fe59ab887",
                                "text": "Il existe des prosthèses spontanées en français populaire comme un « esquelette »."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd81a706-ee7f-34b8-ae2a-d1a0fe1669ef",
                        "entry_id": "e06a21ee-d6b4-3692-a1db-d3c310f2bbc9",
                        "glosses": [
                            "Remplacement d'une partie perdue, par des pièces artificielles ; prothèse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b246baf9-93fa-44f2-bc70-d2250e294ea4",
                                "sense_id": "cd81a706-ee7f-34b8-ae2a-d1a0fe1669ef",
                                "text": "Elle ne portait pas de prosthèse et employait son petit bras pour faire tout ce qu’elle avait besoin de faire d'une manière très naturelle."
                            }
                        ]
                    }
                ],
