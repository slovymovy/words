                    {
                        "form_id": "98e4e324-3c2f-4775-8fd1-c2c11ffd4a7a",
                        "entry_id": "8946b728-d848-33d1-97d6-5c4d9a70f0e9",
                        "tags": [],
                        "form": "junky"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                        "entry_id": "8946b728-d848-33d1-97d6-5c4d9a70f0e9",
                        "glosses": [
                            "Personne présentant une dépendance à une drogue (en particulier à une drogue dure)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1962f5e3-3a08-46e1-bd4d-91e3d1b0235e",
                                "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                                "text": "Moi, je consomme une fois par jour, maximum. J’ai le contrôle. C’est facile, ici, d’avoir le contrôle, en tout cas pour moi. Mais si je prenais le métro pis que je retournais là-bas, je serais junkie certain…"
                            },
                            {
                                "example_id": "3cbcb316-f5f9-4708-b6ce-b512caf00354",
                                "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                                "text": "Je suis pas une junkie !"
                            },
                            {
                                "example_id": "187766b9-ea29-48d0-8745-3efcf4558ebc",
                                "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                                "text": "Ah ben ça c’est de la balle ! Voila la mater dolorosa qui vire junkie à l’âge de la ménopause…"
                            },
                            {
                                "example_id": "705b396d-efb1-43e6-acc4-745198e3a5aa",
                                "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                                "text": "Fabio grimaça. Le côté junkie défoncé était en effet à double tranchant."
                            },
                            {
                                "example_id": "0cb1c246-cd38-47f3-848e-52c9883f4274",
                                "sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                                "text": "— T'es encore à traîner dans ce bar de junkies? T'as rien de mieux à foutre de ta vie?\n — Occupe-toi de ton cul.\n Il lui colle une grande baffe. Elle fait un pas de côté sous le choc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5e66dee-c5e6-45b7-af42-ff3bb331b088",
                        "source_entry_id": "8946b728-d848-33d1-97d6-5c4d9a70f0e9",
                        "source_sense_id": "b48b1c97-2a1e-3021-999d-eb69e1508c6c",
                        "target_lang_word": "Junkie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Junkie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                        "entry_id": "824d6fed-f0e5-3bcb-9cfc-2b22b9ee48b2",
                                        "glosses": [
                                            "Person, die von etwas abhängig ist, ursprünglich drogenabhängig"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd13e553-7b7d-459b-a71a-498654c82360",
                                                "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                                "text": "Woran erkennt man einen Junkie?"
                                            },
                                            {
                                                "example_id": "ee51dce5-4984-4ff0-9e5f-28e672e10bcf",
                                                "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                                "text": "Morgens liegen die Junkies in der Einkaufspassage."
                                            },
                                            {
                                                "example_id": "13c64b76-2dad-4485-8864-4a8e3ab86089",
                                                "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                                "text": "Tom ist ein echter Junkie, der sitzt mindestens neun Stunden täglich vorm Rechner."
                                            },
                                            {
                                                "example_id": "01fa2bc2-09e9-4664-8632-24e719265fb7",
                                                "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                                "text": "„Bei all den Leuten und Junkies, die sich hier in ihren Zimmern einschließen, wirkt meine rasende Verzweiflung irgendwie normal und erwartungsgemäß.“"
                                            },
                                            {
                                                "example_id": "77d16b2d-1469-4fbf-b677-4115c79ee942",
                                                "sense_id": "821acf34-426b-3390-a620-4c0b92f2202f",
                                                "text": "„Ich denke also an Jørgensen und versuche, den Junkie in mir zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39f69f50-5239-4fb3-a436-e9b2752bd692",
                        "source_entry_id": "8946b728-d848-33d1-97d6-5c4d9a70f0e9",
