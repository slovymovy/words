                "senses": [
                    {
                        "sense_id": "d9e03670-c903-3d19-83fe-49bcc985cbea",
                        "entry_id": "751b3743-6880-366b-9f38-7a4bdcc87b9a",
                        "glosses": [
                            "zob. obiektyw zmiennoogniskowy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3965b947-3220-4d25-bd80-c7d10c42ce92",
                                "sense_id": "d9e03670-c903-3d19-83fe-49bcc985cbea",
                                "text": "Kupiłem porządny zoom do mojego kita, mogę teraz zająć się fotografią przyrodniczą."
                            },
                            {
                                "example_id": "eb2cf246-8418-4616-af71-43959f278602",
                                "sense_id": "d9e03670-c903-3d19-83fe-49bcc985cbea",
                                "text": "Mam znajomego, który uważa, że stałki są o wiele lepsze od zoomów w każdym aspekcie"
                            },
                            {
                                "example_id": "d4fa7742-78cd-48cd-9a2c-783a901b9292",
                                "sense_id": "d9e03670-c903-3d19-83fe-49bcc985cbea",
                                "text": "Niestety nie da się zastąpić dobrej stałki zoomem i vice versa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "756359d0-feeb-3913-9a61-0b9249da5d42",
                        "entry_id": "751b3743-6880-366b-9f38-7a4bdcc87b9a",
                        "glosses": [
                            "funkcja aparatu fotograficznego, projektora multimedialnego itp. lub programu komputerowego pozwalająca na zwiększanie lub zmniejszanie widzianego obiektu (zdjęcia, mapy, obiektu 3D)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fec667e-9380-49a9-a842-e3232b17a227",
                                "sense_id": "756359d0-feeb-3913-9a61-0b9249da5d42",
                                "text": "Wiadomo, że funkcja zoomu cyfrowego to gadżet marketingowy, a jakość zdjęć otrzymywanych tą metodą jest kiepska"
                            },
                            {
                                "example_id": "da3eff05-71c1-424d-a2fb-7781d4d6bc2a",
                                "sense_id": "756359d0-feeb-3913-9a61-0b9249da5d42",
                                "text": "Program prócz funkcji zoom zawiera marker, którym możliwe jest pisanie po ekranie, oraz opcję blokowania pulpitu na określony czas"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
