                "forms": [],
                "senses": [
                    {
                        "sense_id": "00032f4d-8fc1-38bf-94dc-9cc60a34a6e1",
                        "entry_id": "3779bf08-f4fd-3164-9d74-8c72e2c1f41a",
                        "glosses": [
                            "Synästhesie"
                        ],
                        "tags": [],
