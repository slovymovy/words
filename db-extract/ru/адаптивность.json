                ],
                "senses": [
                    {
                        "sense_id": "fbde51f6-5a0e-3294-b2b1-41f0953d85db",
                        "entry_id": "fcc82f89-6a45-3c21-b250-a4b71e71e5e8",
                        "glosses": [
                            "книжн. способность к адаптации, приспособлению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b456eed7-5968-442c-9e77-c17d243586f4",
                                "sense_id": "fbde51f6-5a0e-3294-b2b1-41f0953d85db",
                                "text": "Между априорностью, как неизменной и трансцендентной данностью, и адаптивностью, как изменчивостью и основой индивидуальных различий, лежал непреодолимый барьер."
                            },
                            {
                                "example_id": "1cbfd730-c147-4d24-8475-01f1d4dc48dc",
                                "sense_id": "fbde51f6-5a0e-3294-b2b1-41f0953d85db",
                                "text": "Кроме того, активность элементов системы приводит, в свою очередь, к свойству адаптивности системы, т.е. приспосабливаемости к изменяющимся внешним и внутренним условиям."
                            }
                        ]
                    }
