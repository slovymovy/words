                        "entry_id": "c8e0d518-7fd8-3092-907c-ec18fcd450ae",
                        "glosses": [
                            "A longitudinal channel, groove, or recess cut out of the edge or face of a plank of wood or other material; especially, one intended to fit another member to form a joint."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24433b24-a694-4785-8b5e-c620d61e0474",
                        "source_entry_id": "c8e0d518-7fd8-3092-907c-ec18fcd450ae",
                        "source_sense_id": "e09c6a56-ed0d-3412-89b5-1e2588596c44",
                        "source_sense_description": "channel, groove of recess in e.g. wood",
                        "target_lang_word": "feuillure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuillure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee89a66-ac04-3688-94a3-2c92b0fde0b4",
                                        "entry_id": "4da6c91f-c49d-323a-8dee-3fe6cfd43dd2",
                                        "glosses": [
                                            "Entaillure dans laquelle les fenêtres et les portes s’engagent un peu pour fermer juste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc8dc6e-6798-432a-ad98-6b096fdab9a4",
                                                "sense_id": "3ee89a66-ac04-3688-94a3-2c92b0fde0b4",
                                                "text": "Deux ongles se sont foutus dans la feuillure."
                                            },
                                            {
                                                "example_id": "e18449c0-0064-4b7d-99d1-3691e7dc7b00",
                                                "sense_id": "3ee89a66-ac04-3688-94a3-2c92b0fde0b4",
                                                "text": "Je sentais Marco seule, dure et fiévreuses, derrière le battant. La bouche contre la feuillure, je dis « c’est moi » et Marco m’ouvrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d24f51-ba52-3526-bf9e-6e84417f4202",
                                        "entry_id": "4da6c91f-c49d-323a-8dee-3fe6cfd43dd2",
                                        "glosses": [
                                            "Entaillure grâce à laquelle on insère une feuille d'un matériau dans un cadre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "008c6f1e-6897-4b54-9f68-462592195412",
                                                "sense_id": "17d24f51-ba52-3526-bf9e-6e84417f4202",
                                                "text": "Les éléments sont pré-moulés dans nos usines avec des feuillures longitudinales et d’extrémité, permettant leur emboîtement."
                                            },
                                            {
                                                "example_id": "5e46b2d1-6715-4cbb-9769-4d760dabacda",
                                                "sense_id": "17d24f51-ba52-3526-bf9e-6e84417f4202",
                                                "text": "Avant de mastiquer une vitre dans sa feuillure, on la maintient par quelques pointes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e808315e-857f-41ff-95fb-f11bb8ae88ed",
