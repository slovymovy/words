                    {
                        "translation_id": "383e5b44-8b4e-4f9b-b14e-8581e5ecb920",
                        "source_entry_id": "82ff7f0e-325b-3818-84c6-ff76a3e6d75a",
                        "source_sense_id": "b3a2f0e9-21ce-39b3-83ee-fc573780c073",
