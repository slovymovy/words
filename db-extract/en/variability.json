                                "target_senses": [
                                    {
                                        "sense_id": "edd516f9-6e0a-3659-b994-be2e88ea1a32",
                                        "entry_id": "7c0bba1a-6f35-3b23-b3ea-9b823b8c4332",
                                        "glosses": [
                                            "Disposition habituelle à varier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8608f91e-baef-4670-a37d-0921104923d6",
                                                "sense_id": "edd516f9-6e0a-3659-b994-be2e88ea1a32",
                                                "text": "La variabilité du temps, de la température."
                                            },
                                            {
                                                "example_id": "fe204dd5-34dc-4a0f-b613-2a638cb1cf12",
                                                "sense_id": "edd516f9-6e0a-3659-b994-be2e88ea1a32",
                                                "text": "La variabilité des goûts, des humeurs."
                                            },
                                            {
                                                "example_id": "22b46d63-1271-46cb-b688-a255095ba88f",
                                                "sense_id": "edd516f9-6e0a-3659-b994-be2e88ea1a32",
                                                "text": "La variabilité des performances est essentielle. Si elle est faible, la performance des animaux sélectionnés comme les meilleurs peut n’être que légèrement supérieure à la moyenne de la population. Par contre, si la variabilité est forte, la même proportion d’individus sélectionnés présentera une performance moyenne bien supérieure à la moyenne de la population. — (Wiener Gerald, Rouvier Roger, Amélioration génétique animale, 280 p., page 84, 2009, Quae/ CTA/ Presses agronomiques de Gembloux, Agricultures en poche, présentation)"
                                            }
                                        ]
                                    }
                                ]
