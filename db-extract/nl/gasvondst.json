                        "examples": [
                            {
                                "example_id": "aaf699f3-38d9-4df1-ad2c-2abc720779a3",
                                "sense_id": "a7bc8ee1-2faf-387e-8d94-ec21dc3f0f60",
                                "text": "Gasvondst gedaan bij Schiermonnikoog, Waddenvereniging bezorgd"
                            },
                            {
                                "example_id": "abb7ba3a-8567-4938-89b6-6a9584dfaf98",
                                "sense_id": "a7bc8ee1-2faf-387e-8d94-ec21dc3f0f60",
                                "text": "In eigen land heeft de NAM, de Nederlandse Aardolie Maatschappij, een grote gasvondst gedaan. Het is de grootste vondst sinds 1995."
                            },
                            {
                                "example_id": "6ba3f1f8-7349-4520-9884-9c39fda30c0c",
                                "sense_id": "a7bc8ee1-2faf-387e-8d94-ec21dc3f0f60",
                                "text": "NAM-directeur Van de Leemput spreekt van de grootste gasvondst sinds 1995 op land. \"Deze gasvondst overtrof onze verwachtingen. Dit is een fantastisch resultaat en dat geeft ons energie om door te gaan op de ingeslagen weg.\""
                            },
                            {
                                "example_id": "2e16973c-ae08-4b4d-a8bb-baa77be89069",
                                "sense_id": "a7bc8ee1-2faf-387e-8d94-ec21dc3f0f60",
                                "text": "Gasvondst: Toen ten zuiden van Cyprus, onder de Middellandse Zee, gas werd gevonden, ontstond een nieuw conflict: van wie is het? Turkije en Cyprus vinden allebei dat ze er recht op hebben."
                            }
                        ]
