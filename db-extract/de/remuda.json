                "senses": [
                    {
                        "sense_id": "6f24f8b9-e5da-3a74-b3a1-d430e43f1235",
                        "entry_id": "fb55d0e2-6601-333b-b805-9f940d73d13c",
                        "glosses": [
                            "Reserve- und Auswechselbestand an Pferden, der bei Viehtrieben mitgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2583ad-0f4f-4ced-8a8e-f28d10d877d5",
                                "sense_id": "6f24f8b9-e5da-3a74-b3a1-d430e43f1235",
                                "text": "„Die übrigen Reiter waren stehen geblieben und sahen herüber; einer trieb das letzte Ersatzpferd aus der Remuda heran, aber sonst kam keiner Miller zu Hilfe.“"
                            },
                            {
                                "example_id": "3c83f724-8bba-4f9a-a78a-0e15fc6b8191",
                                "sense_id": "6f24f8b9-e5da-3a74-b3a1-d430e43f1235",
                                "text": "„›Und wieso sollten sich Pferdediebe an deiner Remuda vergreifen, wenn es im Tal nur so von Mustangs wimmelt, die unseren Kühen das Gras wegfressen?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b80cde18-33c2-46f0-b208-0cf787f2269e",
                        "source_entry_id": "fb55d0e2-6601-333b-b805-9f940d73d13c",
                        "source_sense_id": "6f24f8b9-e5da-3a74-b3a1-d430e43f1235",
                        "source_sense_description": "Reserve- und Auswechselbestand an Pferden",
                        "target_lang_word": "remuda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remuda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b16da796-ac1a-3752-9f39-cf03106f3767",
                                        "entry_id": "86fe3be8-c4de-3dbf-b661-d04aff1430c2",
                                        "glosses": [
                                            "A herd of horses from which the horses to be used for a particular purpose are selected."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256abba5-fe9f-4a0e-9764-6dc01c1c11f0",
                                                "sense_id": "b16da796-ac1a-3752-9f39-cf03106f3767",
                                                "text": "‘Don’t die!’ You can bet your Red River remuda on that."
                                            },
                                            {
                                                "example_id": "c2180821-8bc1-4c9d-9000-4c74ac6badf3",
                                                "sense_id": "b16da796-ac1a-3752-9f39-cf03106f3767",
                                                "text": "To one side of the barn was a remuda of work-horses, perhaps twenty in all."
                                            },
                                            {
                                                "example_id": "8a6e8881-d87a-4ea8-a9e6-969d857154bf",
                                                "sense_id": "b16da796-ac1a-3752-9f39-cf03106f3767",
                                                "text": "Buddy did not know what his mother was going to do, but he was sure that whatever she did would be right; so he hoisted his saddle on the handiest fresh horse, and loped off to drive in the remuda, feeling certain that his father would move swiftly to save his cattle that ranged back in the foothills, and that the saddle horses would be wanted at a moment's notice."
                                            },
                                            {
                                                "example_id": "a514594a-cd93-48cd-ad96-4f04ac91106c",
                                                "sense_id": "b16da796-ac1a-3752-9f39-cf03106f3767",
                                                "text": "A big remuda had been driven up, Cayuse ponies mixed with larger American horses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
