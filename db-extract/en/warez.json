                        "sense_id": "dae713d9-d7c2-3267-95bf-ebbaa5bcba3b",
                        "entry_id": "e82b3d41-de1f-38e1-8d09-16d263d62787",
                        "glosses": [
                            "Software that is illegally obtained or distributed."
                        ],
                        "tags": [
                            "Internet",
                            "Leet",
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "41350135-684a-40f1-b028-6b4cd3975881",
                                "sense_id": "dae713d9-d7c2-3267-95bf-ebbaa5bcba3b",
                                "text": "By the end of the day Mad Hatter, a ringleader of the software piracy group called the Inner Circle, will have poured 300 Mbytes of illegal “warez” onto the Internet."
                            },
                            {
                                "example_id": "4a1b9bfc-5c50-44be-9991-82528f7ac32d",
                                "sense_id": "dae713d9-d7c2-3267-95bf-ebbaa5bcba3b",
                                "text": "Too many gamers see nothing wrong with downloading “warez” (usually pronounced “wares,” but also “wah-rez”), retail software products that have been “ripped” to make them smaller and remove copy protection."
                            },
                            {
                                "example_id": "5239e250-896e-49a9-b349-52a7a6616b58",
                                "sense_id": "dae713d9-d7c2-3267-95bf-ebbaa5bcba3b",
                                "text": "Warez appeared in the 1980s with the advent of Bulletin Board Systems."
                            }
                        ]
                    }
                ],
