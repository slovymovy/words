                "senses": [
                    {
                        "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                        "entry_id": "3aad18b7-e362-385d-b6c7-18ca2ce889c9",
                        "glosses": [
                            "Kraftwerk, das der Erzeugung von Fernwärme dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc36f6bb-ef8c-42a8-a6bb-2a9ea86669b1",
                                "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                                "text": "Mit einem Fernwärmekraftwerk kann man ganze Siedlungen mit Wärme versorgen."
                            },
                            {
                                "example_id": "b19059d5-bce4-44ea-8822-cd1473df9b88",
                                "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                                "text": "„Der im Kraftwerk Scholven produzierte Strom deckt etwa 3% des deutschen Strombedarfes. Die Blöcke B - F, das Fernwärmekraftwerk Buer (FWK) und das Dampfwerk Scholven (DWS) liefern Dampf an benachbarte Chemiebetriebe und Fernwärme an einige umliegende Städte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
