{
    "word_family": [
        "dwang",
        "dwingeland",
        "bedwingen",
        "afdwingen",
        "opdringen",
        "verdringen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8be6326b-434d-39f0-b036-bdd10128efc9",
                    "sense_definition": "iemand met geweld of morele druk verplichten om iets te doen tegen zijn of haar wil",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verplichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overvallers probeerden de winkelbediende te <w>dwingen</w> de kluis te openen.",
                            "target_lang_translations": {
                                "en": "The robbers tried to <w>force</w> the shop assistant to open the safe."
                            }
                        },
                        {
                            "text": "Ik zal je niet <w>dwingen</w> om te komen, maar ik zou het op prijs stellen.",
                            "target_lang_translations": {
                                "en": "I won't <w>force</w> you to come, but I would appreciate it."
                            }
                        }
                    ],
                    "synonyms": [
                        "forceren",
                        "verplichten"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "common_phrases": [
                        "iemand dwingen tot",
                        "zichzelf dwingen"
                    ],
                    "target_lang_definitions": {
                        "en": "To oblige someone to do something against their will using violence or moral pressure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "force",
                                "target_lang_sense_clarification": "to make someone do something against their will"
                            },
                            {
                                "target_lang_word": "compel",
                                "target_lang_sense_clarification": "to constrain or coerce someone into an action"
                            },
                            {
                                "target_lang_word": "coerce",
                                "target_lang_sense_clarification": "to pressure someone into doing something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d0edbe5-0726-3cae-bbab-4f3f08b9b8b6",
                    "sense_definition": "een bepaalde handeling of situatie onvermijdelijk maken door omstandigheden of regels",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verplichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wet kan bedrijven <w>dwingen</w> milieuvriendelijke maatregelen te nemen.",
                            "target_lang_translations": {
                                "en": "The law can <w>compel</w> companies to take environmentally friendly measures."
                            }
                        },
                        {
                            "text": "De omstandigheden <w>dwongen</w> ons om een beslissing te nemen.",
                            "target_lang_translations": {
                                "en": "Circumstances <w>forced</w> us to make a decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "forceren"
                    ],
                    "common_phrases": [
                        "de omstandigheden dwingen",
                        "tot actie dwingen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a certain action or situation inevitable due to circumstances or rules."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "force",
                                "target_lang_sense_clarification": "to make a decision or situation necessary"
                            },
                            {
                                "target_lang_word": "compel",
                                "target_lang_sense_clarification": "to make an action required by logic or law"
                            },
                            {
                                "target_lang_word": "necessitate",
                                "target_lang_sense_clarification": "to make something unavoidable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25179343-9733-377b-8fe9-ddadcbfb24d2",
                    "sense_definition": "met grote nadruk of autoriteit iets eisen of ergens op aandringen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verplichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn krachtige stem en houding <w>dwongen</w> respect af bij het hele publiek.",
                            "target_lang_translations": {
                                "en": "His powerful voice and attitude <w>commanded</w> respect from the entire audience."
                            }
                        },
                        {
                            "text": "Zij bleef <w>dwingen</w> tot hij eindelijk toegaf aan haar verzoek.",
                            "target_lang_translations": {
                                "en": "She kept <w>insisting</w> until he finally gave in to her request."
                            }
                        }
                    ],
                    "common_phrases": [
                        "respect dwingen"
                    ],
                    "target_lang_definitions": {
                        "en": "To demand something or insist on something with great emphasis or authority."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "to evoke or require something like respect or attention"
                            },
                            {
                                "target_lang_word": "compel",
                                "target_lang_sense_clarification": "to powerfully motivate or produce a reaction"
                            },
                            {
                                "target_lang_word": "enforce",
                                "target_lang_sense_clarification": "to ensure observance of or obedience to"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}