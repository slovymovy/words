                        "target_lang_word": "spade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8a370e-4c56-3b6b-a5cd-b8812531a414",
                                        "entry_id": "d0e67061-fdb2-3955-aedc-3a02ea505515",
                                        "glosses": [
                                            "A garden tool with a handle and a flat blade for digging. Not to be confused with a shovel which is used for moving earth or other materials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd98f6a-97bc-4df5-ad83-76bb3ac1e85e",
                                                "sense_id": "1f8a370e-4c56-3b6b-a5cd-b8812531a414",
                                                "text": "'Make your mind easy,' Ratsey said; 'I have dug too often in this graveyard for any to wonder if they see me with a spade.'"
                                            },
                                            {
                                                "example_id": "a732b979-38a7-4a52-a554-66cc250b2a23",
                                                "sense_id": "1f8a370e-4c56-3b6b-a5cd-b8812531a414",
                                                "text": "\"[...] And not a single spade has gone in the ground - not a single mile of track built.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a6dc07-6627-32a6-ae1e-411d33df093a",
                                        "entry_id": "d0e67061-fdb2-3955-aedc-3a02ea505515",
                                        "glosses": [
                                            "A cutting instrument used in flensing a whale."
                                        ],
