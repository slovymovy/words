                "senses": [
                    {
                        "sense_id": "2ff2f9f3-8f5f-3308-b097-9217a82fba6c",
                        "entry_id": "395c8e7a-7709-347d-9270-0b8d4d5a60bd",
                        "glosses": [
                            "Abwehrspieler, der auf einer Innenposition spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48db32c-1a23-4342-b365-e90dd7e56db1",
                                "sense_id": "2ff2f9f3-8f5f-3308-b097-9217a82fba6c",
                                "text": "Der linke Innenverteidiger verpasste den Ball, so dass der Stürmer nur noch den Ball über die Linie drücken musste."
                            },
                            {
                                "example_id": "2f32b0ef-156c-4c59-9f47-efa29e991420",
                                "sense_id": "2ff2f9f3-8f5f-3308-b097-9217a82fba6c",
                                "text": "Ein Wechsel von Innenverteidiger Jan Simunek vom VfL Wolfsburg in die Pfalz droht derweil am Geld zu scheitern."
                            },
                            {
                                "example_id": "7aeb1a08-34b9-4df5-8d92-3ac35379f16b",
                                "sense_id": "2ff2f9f3-8f5f-3308-b097-9217a82fba6c",
                                "text": "Er ist ein guter zweiter Innenverteidiger, braucht aber einen Chef an seiner Seite."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
