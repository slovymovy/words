                "senses": [
                    {
                        "sense_id": "c01b79ea-1811-316e-903b-851052389f3c",
                        "entry_id": "a148144e-7f57-3fc9-8241-9ed61ecb1bd2",
                        "glosses": [
                            "Composer. Réutiliser la vapeur utilisée par un moteur dans un autre moteur."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "65b8ada1-d313-4c06-8ad5-50a1a75483b5",
                                "sense_id": "c01b79ea-1811-316e-903b-851052389f3c",
                                "text": "Les mêmes considérations s’appliquent au transport d’énergie entre un générateur et un récepteur synchrones : on peut compounder l’un ou l’autre des deux appareils : l’auteur conseille le compoundage partiel du moteur […]"
                            },
                            {
                                "example_id": "02dc6ce3-be3f-4727-b7c3-fd777f694043",
                                "sense_id": "c01b79ea-1811-316e-903b-851052389f3c",
                                "text": "Au lieu de chercher à compounder chaque moteur séparément, il serait préférable de les compounder les uns par les autres."
                            },
                            {
                                "example_id": "5075c975-3ce0-4c5e-9713-883ee86da19a",
                                "sense_id": "c01b79ea-1811-316e-903b-851052389f3c",
                                "text": "On compounde ou on isochronise pour les charges extrêmes, et la pseudo-constance est obtenue pour les charges intermédiaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "e24a773d-12af-3064-afae-0d9739694604",
                        "entry_id": "a148144e-7f57-3fc9-8241-9ed61ecb1bd2",
                        "glosses": [
                            "Combiner plusieurs matériaux pour en faire un matériau composite."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d9ed4c6d-9594-4824-92cf-e294da2bc194",
                                "sense_id": "e24a773d-12af-3064-afae-0d9739694604",
                                "text": "Compounder des matériaux coûteux, tels que des nano-composites, des biopolymères ou des produits pharmaceutiques n’est dès lors plus un problème."
                            }
                        ]
                    }
                ],
