                ],
                "senses": [
                    {
                        "sense_id": "9fceec9d-2745-3893-9c65-7f79d100cf45",
                        "entry_id": "b94b7c49-12ef-3afe-9196-9e2a50132196",
                        "glosses": [
                            "chroniczna potrzeba dostarczania określonych, na ogół szkodliwych bodźców do organizmu człowieka, zwykle sprzeczna z jego wolą i intelektem"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "9199a79f-f526-4140-bda3-807c777557a1",
                                "sense_id": "9fceec9d-2745-3893-9c65-7f79d100cf45",
                                "text": "Miałem niestety sposobność każdego dnia oglądać to, co uzależnienie robi z człowieka. W związku z tym nie mam obaw, że uzależnię się od alkoholu czy też innych używek. Zawsze miałem i mam nad tym pełną kontrolę. Uzależnienie od Clonazepamu to inna bajka. Wpadłem w jego sidła całkowicie nieświadomie, nie mając pojęcia o uzależniającym potencjale tego, bądź co bądź przez lekarzy zapisywanego leku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bc9c1011-e38e-33aa-955e-317db2aadc38",
                        "entry_id": "b94b7c49-12ef-3afe-9196-9e2a50132196",
                        "glosses": [
                            "uczynienie kogoś lub czegoś zależnym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a86b8a1-d10d-4730-aa9b-90ac9e227ce0",
                        "source_entry_id": "b94b7c49-12ef-3afe-9196-9e2a50132196",
                        "source_sense_id": "9fceec9d-2745-3893-9c65-7f79d100cf45",
                        "target_lang_word": "addiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "addiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1e8a2d7-55f9-3ba5-ad70-607bc4d8ddc4",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A state that is characterized by compulsive drug use or compulsive engagement in rewarding behavior, despite negative consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0aaf080-5485-4743-aea3-b4f3e5f2e9b7",
                                                "sense_id": "f1e8a2d7-55f9-3ba5-ad70-607bc4d8ddc4",
                                                "text": "Do your lethal addictions to self-prescriptions numb the ache of the darkest days?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab3c2b6-5264-3e84-a574-049def1e10a5",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "The state of being addicted; devotion; inclination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97b7dd5c-86af-3d86-8c2e-871f57891c21",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A habit or practice that damages, jeopardizes or shortens one's life but when ceased causes trauma."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "201889aa-a738-36d0-b9f4-e37d3469cc20",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A pathological relationship to mood altering experience that has life damaging consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea04ed5-67cc-4d12-b332-fa34962457d7",
                                                "sense_id": "201889aa-a738-36d0-b9f4-e37d3469cc20",
                                                "text": "His addiction was to courses vain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85402092-ab17-4e88-a03f-8ae97fc2547e",
                        "source_entry_id": "b94b7c49-12ef-3afe-9196-9e2a50132196",
                        "source_sense_id": "9fceec9d-2745-3893-9c65-7f79d100cf45",
                        "target_lang_word": "dépendance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépendance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67875bd3-0716-3614-a9c4-6f81f0958069",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Tout accessoire d’une chose principale, de tout ce qui tient ou se rattache à une chose sans la constituer essentiellement."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fb5a40-df6d-4ce5-80bc-0d55725a106c",
                                                "sense_id": "67875bd3-0716-3614-a9c4-6f81f0958069",
                                                "text": "La seule dépendance de Chevrainvilliers est le hameau de Verteau, qui se trouve à un quart de lieue au nord-ouest. Il y avait aussi un château dans ce hameau."
                                            },
                                            {
                                                "example_id": "e8fcf637-0418-4751-a01d-bed626d77204",
                                                "sense_id": "67875bd3-0716-3614-a9c4-6f81f0958069",
                                                "text": "Toute chose établie à perpétuelle demeure dans une maison en est une dépendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c443841a-060b-37c6-8b8e-32762abcaf50",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Accessoires d’un domaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a71143d-5588-4d6e-a819-19311441aacd",
                                                "sense_id": "c443841a-060b-37c6-8b8e-32762abcaf50",
                                                "text": "Ce parc est une dépendance du château que vous voyez là-bas."
                                            },
                                            {
                                                "example_id": "12e68bcb-55f5-429e-a075-0116692b7c93",
                                                "sense_id": "c443841a-060b-37c6-8b8e-32762abcaf50",
                                                "text": "Ce château a de fort belles dépendances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473b8b14-3031-3757-960e-57ef2cbd14d2",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Terre qui dépendaient d’une autre."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "708e69f8-d0d1-4779-97c1-4ac5c0703ec4",
                                                "sense_id": "473b8b14-3031-3757-960e-57ef2cbd14d2",
                                                "text": "Cette terre était de la dépendance de tel seigneur, était de sa dépendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bcc13e-ca79-3179-891a-926ee79f3650",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Rapports qui lient certaines choses, certains êtres, et qui les rendent nécessaires les uns par rapport aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5522ef13-31ce-4b33-a3d9-b44592605466",
                                                "sense_id": "c6bcc13e-ca79-3179-891a-926ee79f3650",
                                                "text": "Dans certains cas, on observe en outre de la céphalalgie, de la dyspnée, du coma, symptômes qui sont presque toujours sous la dépendance de l'urémie occasionnée par la néphrite."
                                            },
                                            {
                                                "example_id": "6b58d7ee-55e5-4175-8ca9-d1f823ab554f",
                                                "sense_id": "c6bcc13e-ca79-3179-891a-926ee79f3650",
                                                "text": "Il y a entre ce phénomène et cet autre une dépendance mutuelle, une telle dépendance que…"
                                            },
                                            {
                                                "example_id": "59bf9ba5-1084-4979-8654-f5e3e78b5ffc",
                                                "sense_id": "c6bcc13e-ca79-3179-891a-926ee79f3650",
                                                "text": "Pour diminuer la dépendance européenne, la stratégie propose de favoriser la production de plantes riches en protéines, telles que le soja, le tournesol, le colza et les légumineuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47005330-974a-331b-b8e7-7169b3ea0879",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Ce qui traite des rapports d’un mot ou d’un groupe de mots avec tel ou tel mot dont il dépend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00a4aac-b359-4e5b-b1a9-8ec42fe1c09c",
                                                "sense_id": "47005330-974a-331b-b8e7-7169b3ea0879",
                                                "text": "Syntaxe de dépendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16153ad-4a1e-3be6-b9dc-6026c3903373",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Sujétion ; subordination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ad3e2f-3eb4-483e-9eb6-b513662a9b77",
                                                "sense_id": "d16153ad-4a1e-3be6-b9dc-6026c3903373",
                                                "text": "Le fragile édifice du crédit, – qui avait des proportions que nul n’avait prévues, et qui avait tenu dans une dépendance réciproque des centaines de millions d’hommes, sans que personne s’en rendît clairement compte, – s’effondra dans la panique."
                                            },
                                            {
                                                "example_id": "06373788-76d9-4f3b-878b-7f4938f8c969",
                                                "sense_id": "d16153ad-4a1e-3be6-b9dc-6026c3903373",
                                                "text": "L’affaire offre un exemple frappant du fossé qui sépare le désir d’autonomie de l’Europe dans des domaines sensibles comme l’informatique, et la réalité de sa dépendance à l’égard de la technologie américaine."
                                            },
                                            {
                                                "example_id": "be9d9e66-5f9c-4002-b870-416df4868d16",
                                                "sense_id": "d16153ad-4a1e-3be6-b9dc-6026c3903373",
                                                "text": "Pour nombre de PVD l’exportation de main-d’œuvre et de cerveaux est devenue une véritable ressource, la conséquence étant une véritable dépendance vis-à-vis de ce « commerce » : l’Égypte, qui fournit les Pays du Golfe en actifs a été directement concernée par les crises qui ont affecté cette région depuis les années 1980."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed34512b-1c45-32de-a1c8-c30d6f0b6818",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Sujétion à un stupéfiant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c246eb4d-cd28-4b2b-a0ac-38b73214a4bc",
                                                "sense_id": "ed34512b-1c45-32de-a1c8-c30d6f0b6818",
                                                "text": "Entre l’addictologie et Laurent Karila, c’est une histoire d’affect qui dure. Après un internat de psychiatrie, il s’entiche rapidement de la science des dépendances."
                                            },
                                            {
                                                "example_id": "11c52945-dce8-4047-9693-4e934fe5d416",
                                                "sense_id": "ed34512b-1c45-32de-a1c8-c30d6f0b6818",
                                                "text": "La dépendance à l’alcool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a329c5fb-26a9-3aa2-9b21-513145f50a17",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "État d’une personne qui ne peut pas (ou très difficilement) effectuer seule les actes essentiels de la vie courante, et qui nécessite pour cela une assistance quotidienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb2c710-ec4f-417b-9ded-0f30ba639d45",
                                                "sense_id": "a329c5fb-26a9-3aa2-9b21-513145f50a17",
                                                "text": "La dépendance des personnes âgées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce257887-f240-30c0-bcd7-0fb8e32f99e8",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Construction annexe qui dépend d'un bâtiment principal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2c68380-738a-3869-a737-12e69d686557",
                                        "entry_id": "533b8a56-2d3a-3c17-a4c0-0b8f5d613adf",
                                        "glosses": [
                                            "Bibliothèque ou programme tiers utilisé par le programme courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e613fc-40ff-4f4c-807e-7d5f902ea62d",
                                                "sense_id": "c2c68380-738a-3869-a737-12e69d686557",
                                                "text": "Aptitude n'affiche par défaut que les chaînes de dépendances « most installed, strongest, tightest, shortest ». Dans ce cas, il cherche une chaîne qui ne contient que les paquets qui sont installés ou qui seront installés. Il recherche les dépendances les plus fortes possibles dans ce cadre, et recherche les chaînes qui évitent les dépendances ORed et Provides, et il recherche la chaîne de dépendance la plus courte qui respecte ces contraintes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
