                "senses": [
                    {
                        "sense_id": "9031b032-832f-35ae-a2b6-37b35b1d8d97",
                        "entry_id": "10415b5a-e9a3-35f6-815f-24991fda1d17",
                        "glosses": [
                            "Menschen, die sich lieben, die ineinander verliebt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04599c3b-523a-4fc2-a062-faeda4dffd32",
                                "sense_id": "9031b032-832f-35ae-a2b6-37b35b1d8d97",
                                "text": "„Plötzlich hört man aus irgend einem Gebirgswinkel, daß ein Gerichtsvorsteher zwei Liebesleuten die Alternative gestellt hat, zu heiraten oder auseinanderzugehen.“"
                            },
                            {
                                "example_id": "7e5faa77-3d6a-4fa3-9d6a-01c50bc81405",
                                "sense_id": "9031b032-832f-35ae-a2b6-37b35b1d8d97",
                                "text": "„Der Junge hat zufällig eine heimliche Liebesaffäre beobachtet; man droht ihm daraufhin, seine Zunge abzuschneiden, wenn er die Liebesleute verraten würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
