                "senses": [
                    {
                        "sense_id": "9d930ac6-b643-3f97-9fee-71251f8fbc0e",
                        "entry_id": "1c8bd1c8-c9f5-39d3-ba4b-2df9f16b5324",
                        "glosses": [
                            "związany z Ardenami, pochodzący z obszaru Ardenów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcdf390f-3d71-4d05-8341-e5e05164519e",
                                "sense_id": "9d930ac6-b643-3f97-9fee-71251f8fbc0e",
                                "text": "Raz on tam w czasie turnieju chwycił, po skruszeniu kopii, pewnego rycerza ardeńskiego wpół, wywlókł go z kulbaki i wyrzucił na wysokość kopii w górę, chociaż Ardeńczyk cały był w żelazo zakuty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c17d1880-0373-34a1-8be8-21a24a26487f",
                        "entry_id": "1c8bd1c8-c9f5-39d3-ba4b-2df9f16b5324",
                        "glosses": [
                            "związany z francuskim departamentem Ardeny"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "680bb09e-6036-4a6c-81b3-8b742dadcd8f",
                        "source_entry_id": "1c8bd1c8-c9f5-39d3-ba4b-2df9f16b5324",
                        "source_sense_id": "9d930ac6-b643-3f97-9fee-71251f8fbc0e",
