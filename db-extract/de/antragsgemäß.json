                ],
                "senses": [
                    {
                        "sense_id": "e06ee9b0-f0c2-34bb-aee2-d69d674c3fdf",
                        "entry_id": "6a3cf7c7-12b3-3a0e-bbe4-09d3973f51e7",
                        "glosses": [
                            "so ausgeführt, wie es beantragt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d872b9-2abe-43b1-b972-a39e5b136eb0",
                                "sense_id": "e06ee9b0-f0c2-34bb-aee2-d69d674c3fdf",
                                "text": "„Die Depotbanken und andere Intermediäre müssen insbesondere den Namen und die Kontaktdaten des Aktionärs, die Anzahl der gehaltenen Aktien sowie den Beginn der Beteiligung antragsgemäß an das Unternehmen übermitteln.“"
                            },
                            {
                                "example_id": "85ed9e35-177c-49f9-b9f2-01390e4ea8af",
                                "sense_id": "e06ee9b0-f0c2-34bb-aee2-d69d674c3fdf",
                                "text": "„Das habe am Mittwoch ein Haftrichter antragsgemäß entschieden, teilte die Staatsanwaltschaft nach Angaben der Deutschen Presse-Agentur mit.“"
