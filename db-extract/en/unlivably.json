                        "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                        "entry_id": "6c93fc89-692f-3edd-a95c-0c2c5cf0b871",
                        "glosses": [
                            "In a manner that is unconducive to living."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92cbd8b3-120a-40e6-87fe-a33efa7c78f9",
                                "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                                "text": "the unlivably low wages"
                            },
                            {
                                "example_id": "4f071700-3293-4598-9c11-3c88ec6f1b38",
                                "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                                "text": "They joked about being in a Kipling story of the hill stations in India where the Raj's females lived in cool idleness while their husbands worked in the unlivably hot cities. Kate bemoaned her fate […]"
                            },
                            {
                                "example_id": "fb7e9a98-c9b8-49a7-86df-626b762e183c",
                                "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                                "text": "[…] that enable human beings to extend their presence into unlivably hostile environments (deep space, ocean abysses), […]"
                            },
                            {
                                "example_id": "fc2c16f7-2139-43c9-aaa0-66b68f1ae671",
                                "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                                "text": "Later I'd keep imagining them up there in the winter to come, freezing in one of those tiny cabins—previously abandoned because they were unlivably cold."
                            },
                            {
                                "example_id": "ffceff0c-f7a9-4ba8-a266-1928cf084f53",
                                "sense_id": "488f9153-f12b-32a0-ba0e-7c71cfda4836",
                                "text": "\"[T]hey are not trying to live a decent life in the United States.” They couldn't, on their meager wages. Their frame of reference is their much poorer home country, and what seem like unlivably low wages here and worth a lot more there."
                            }
                        ]
                    }
