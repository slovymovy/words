                    {
                        "sense_id": "1dfd7eed-cb8d-3de9-a655-e3994be71f31",
                        "entry_id": "90d07899-bc25-3358-8314-9957eac587d0",
                        "glosses": [
                            "Abbreviation of Musical Instrument Digital Interface."
                        ],
                        "tags": [
