                        "examples": [
                            {
                                "example_id": "b24e5b42-d4a9-4087-a575-2f63f9322b8c",
                                "sense_id": "1195473e-d858-3441-96c6-7f86fe509751",
                                "text": "— Я его́ к тебе́ в во́тчину пришлю́! корми́ на свой счёт! — пригрози́лась она́ бурми́стру, — не на во́тчинный счёт, а на со́бственный свой!",
                                "translation": "‘I’ll send him to your village! You can feed him at your own cost!’ she threatened the bailiff. ‘Not at the village cost either, but your own!’",
                                "english": "‘I’ll send him to your village! You can feed him at your own cost!’ she threatened the bailiff. ‘Not at the village cost either, but your own!’"
                            }
                        ]
