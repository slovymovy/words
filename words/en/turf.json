{
    "word_family": [
        "turfy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77b621cb-88dc-324e-b400-9a05d296216b",
                    "sense_definition": "The upper layer of ground that is covered with grass and plant roots.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_grass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players slipped on the wet <w>turf</w> during the football match.",
                            "target_lang_translations": {
                                "ru": "Игроки поскользнулись на мокром <w>газоне</w> во время футбольного матча.",
                                "zh": "足球比赛中，球员们在湿滑的<w>草皮</w>上滑倒了。"
                            }
                        },
                        {
                            "text": "We decided to lay new <w>turf</w> in the garden to improve the lawn.",
                            "target_lang_translations": {
                                "ru": "Мы решили уложить новый <w>дёрн</w> в саду, чтобы улучшить лужайку.",
                                "zh": "我们决定在花园里<w>铺设</w>新的草皮以改善草坪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sod",
                        "grass"
                    ],
                    "common_phrases": [
                        "lay turf",
                        "green turf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхний слой почвы, покрытый травой и корнями растений.",
                        "zh": "覆盖着草和植物根系的表层土壤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дёрн",
                                "target_lang_sense_clarification": "слой почвы с травой"
                            },
                            {
                                "target_lang_word": "газон",
                                "target_lang_sense_clarification": "травяное покрытие (спорт/сад)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草皮",
                                "target_lang_sense_clarification": "带有草和根系的土壤层"
                            },
                            {
                                "target_lang_word": "草坪",
                                "target_lang_sense_clarification": "用于园艺或运动的草地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                    "sense_definition": "A synthetic material made to look like grass, often used for sports fields.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_artificial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many modern stadiums use artificial <w>turf</w> because it is easier to maintain than real grass.",
                            "target_lang_translations": {
                                "ru": "Многие современные стадионы используют <w>искусственный газон</w>, потому что за ним легче ухаживать, чем за настоящей травой.",
                                "zh": "许多现代体育场使用<w>人造草坪</w>，因为它比真草更容易维护。"
                            }
                        },
                        {
                            "text": "The hockey team practiced on the <w>turf</w> field regardless of the weather.",
                            "target_lang_translations": {
                                "ru": "Хоккейная команда тренировалась на поле с <w>искусственным покрытием</w> независимо от погоды.",
                                "zh": "无论天气如何，曲棍球队都在<w>人造草皮</w>场地上训练。"
                            }
                        }
                    ],
                    "synonyms": [
                        "artificial grass"
                    ],
                    "common_phrases": [
                        "artificial turf",
                        "turf field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Синтетический материал, имитирующий траву, часто используемый для спортивных полей.",
                        "zh": "一种模仿草地的合成材料，常用于运动场地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусственный газон",
                                "target_lang_sense_clarification": "синтетическое покрытие"
                            },
                            {
                                "target_lang_word": "искусственное покрытие",
                                "target_lang_sense_clarification": "для спортивных площадок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人造草坪",
                                "target_lang_sense_clarification": "合成材料制成的草地"
                            },
                            {
                                "target_lang_word": "人造草皮",
                                "target_lang_sense_clarification": "用于运动场的人造覆盖物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9cb0483-3342-3db8-b1f9-6a639891d735",
                    "sense_definition": "An area, subject, or sphere of influence that a person or group considers their own.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "territory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local gang aggressively defended their <w>turf</w> from outsiders.",
                            "target_lang_translations": {
                                "ru": "Местная банда агрессивно защищала свою <w>территорию</w> от чужаков.",
                                "zh": "当地帮派极力保护他们的<w>地盘</w>，防止外人侵入。"
                            }
                        },
                        {
                            "text": "I feel much more confident when I am negotiating on my own <w>turf</w>.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя гораздо увереннее, когда веду переговоры на своей <w>территории</w>.",
                                "zh": "当我在自己的<w>地盘</w>上谈判时，我感到自信多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "territory",
                        "domain",
                        "patch"
                    ],
                    "common_phrases": [
                        "home turf",
                        "on one's turf",
                        "protect one's turf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, сфера влияния или область деятельности, которую человек или группа считают своей.",
                        "zh": "个人或团体认为属于自己的领域、势力范围或活动区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "зона влияния или контроля"
                            },
                            {
                                "target_lang_word": "своя территория",
                                "target_lang_sense_clarification": "родные стены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地盘",
                                "target_lang_sense_clarification": "势力范围或控制区域"
                            },
                            {
                                "target_lang_word": "领域",
                                "target_lang_sense_clarification": "擅长或掌控的范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a48a3604-98c3-3559-9cc9-138bec2116cc",
                    "sense_definition": "The sport of horse racing or the track where it takes place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "racing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost a significant amount of money betting on the <w>turf</w>.",
                            "target_lang_translations": {
                                "ru": "Он проиграл значительную сумму денег, делая ставки на <w>скачках</w>.",
                                "zh": "他在<w>赛马</w>上押注输了一大笔钱。"
                            }
                        },
                        {
                            "text": "Fans of the <w>turf</w> gathered early to watch the championship race.",
                            "target_lang_translations": {
                                "ru": "Поклонники <w>скачек</w> собрались пораньше, чтобы посмотреть чемпионский заезд.",
                                "zh": "<w>赛马</w>迷们早早聚集在一起观看冠军赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "horse racing"
                    ],
                    "common_phrases": [
                        "the turf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конный спорт или ипподром, где проходят скачки.",
                        "zh": "赛马运动或进行赛马的场地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачки",
                                "target_lang_sense_clarification": "вид спорта"
                            },
                            {
                                "target_lang_word": "беговая дорожка",
                                "target_lang_sense_clarification": "на ипподроме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赛马",
                                "target_lang_sense_clarification": "指代赛马运动"
                            },
                            {
                                "target_lang_word": "跑马场",
                                "target_lang_sense_clarification": "赛马的场地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a19db3f-b4ea-3f15-953f-868ac92d27ae",
                    "sense_definition": "A block of peat dried for use as fuel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers cut <w>turf</w> from the bog to burn in their fireplaces during winter.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители вырезали <w>торф</w> на болоте, чтобы топить им камины зимой.",
                                "zh": "村民们从沼泽地里切割<w>泥炭</w>，以便冬天在壁炉里燃烧取暖。"
                            }
                        },
                        {
                            "text": "A pile of drying <w>turf</w> stood near the entrance of the old cottage.",
                            "target_lang_translations": {
                                "ru": "Куча сохнущего <w>торфа</w> лежала у входа в старый коттедж.",
                                "zh": "旧小屋门口堆着一堆正在晾干的<w>泥炭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peat"
                    ],
                    "common_phrases": [
                        "cut turf",
                        "burn turf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Ireland and parts of the UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брикет торфа, высушенный для использования в качестве топлива.",
                        "zh": "切成块并干燥后用作燃料的泥炭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торф",
                                "target_lang_sense_clarification": "топливо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泥炭",
                                "target_lang_sense_clarification": "用作燃料的有机物质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7cfdf6b-3955-32d1-8456-dc71f29fd4cf",
                    "sense_definition": "To force someone to leave a place or to get rid of something unwanted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guards <w>turfed</w> the unruly fans out of the stadium.",
                            "target_lang_translations": {
                                "ru": "Охранники <w>вышвырнули</w> буйных фанатов со стадиона.",
                                "zh": "保安把闹事的球迷<w>赶出</w>了体育场。"
                            }
                        },
                        {
                            "text": "They decided to <w>turf</w> the old furniture to make space for the new renovation.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>выбросить</w> старую мебель, чтобы освободить место для нового ремонта.",
                                "zh": "他们决定把旧家具<w>扔掉</w>，为新的装修腾出空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eject",
                        "expel",
                        "throw out",
                        "kick out"
                    ],
                    "common_phrases": [
                        "turf out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то покинуть место или избавиться от чего-то ненужного.",
                        "zh": "强迫某人离开某地，或丢弃不需要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышвыривать",
                                "target_lang_sense_clarification": "грубо выгонять"
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться от вещей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶走",
                                "target_lang_sense_clarification": "强迫某人离开"
                            },
                            {
                                "target_lang_word": "扔掉",
                                "target_lang_sense_clarification": "丢弃不需要的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f1c05c0-7aa3-3637-a9d2-e5a4544c9cc1",
                    "sense_definition": "To cover a patch of ground with grass or sod.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cover_grass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>turf</w> the backyard before the summer heat arrives.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>уложить дёрн</w> на заднем дворе до наступления летней жары.",
                                "zh": "我们需要在酷暑到来之前给后院<w>铺设草皮</w>。"
                            }
                        },
                        {
                            "text": "The landscapers <w>turfed</w> the area around the new office building.",
                            "target_lang_translations": {
                                "ru": "Ландшафтные дизайнеры <w>покрыли дёрном</w> территорию вокруг нового офисного здания.",
                                "zh": "景观设计师在新办公楼周围<w>铺设</w>了草皮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать участок земли дёрном или травой.",
                        "zh": "在地面上铺设草皮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укладывать дёрн",
                                "target_lang_sense_clarification": "создавать газон"
                            },
                            {
                                "target_lang_word": "одерновывать",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺设草皮",
                                "target_lang_sense_clarification": "通过铺草来覆盖地面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}