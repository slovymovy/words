                "senses": [
                    {
                        "sense_id": "d024a9c1-53d8-3d15-a1c6-1e98854dd4e1",
                        "entry_id": "ca34759f-7781-36da-9915-74fa9f07f3cf",
                        "glosses": [
                            "computernetwerk waarbij allerlei gegevens op aanvraag beschikbaar worden gesteld (meestal via internet), terwijl de eindgebruiker niet weet op hoeveel of welke server(s) de applicatie draait of waar die servers precies staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef705f9e-85c4-4444-b148-55bbe3f8eb2b",
                                "sense_id": "d024a9c1-53d8-3d15-a1c6-1e98854dd4e1",
                                "text": "Is bestanden opslaan in de cloud veilig?"
                            },
                            {
                                "example_id": "dc9e9a92-b2f2-424a-8a80-23a332e14abf",
                                "sense_id": "d024a9c1-53d8-3d15-a1c6-1e98854dd4e1",
                                "text": "Ook op nationaal niveau hebben volksvertegenwoordigers bestuurders opdracht gegeven de afhankelijkheid van de drie grote Amerikaanse cloudpartijen (Amazon, Microsoft en Google) te verminderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c86e4bd-70fb-4ae4-a554-eba6ebe42776",
                        "source_entry_id": "ca34759f-7781-36da-9915-74fa9f07f3cf",
                        "source_sense_id": "d024a9c1-53d8-3d15-a1c6-1e98854dd4e1",
                        "source_sense_description": "een verwijzing naar het internet",
                        "target_lang_word": "cloud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf8f542-d4f6-388d-96ed-421208f8aab3",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A rock; boulder; a hill."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e755d7c3-e2c4-30d9-843c-8df5d2c1b99d",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A visible mass of water droplets suspended in the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06234a23-0ce0-4fb0-bb3d-ceda453dac05",
                                                "sense_id": "e755d7c3-e2c4-30d9-843c-8df5d2c1b99d",
                                                "text": "While he thus ſpake, there came a cloud, and ouerſhadowed them, ⁊ they feared, as they entred into the cloude."
                                            },
                                            {
                                                "example_id": "b8cb5a61-abc0-4ff9-bf03-d29f3627ce62",
                                                "sense_id": "e755d7c3-e2c4-30d9-843c-8df5d2c1b99d",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7be0c5f-1de5-38ac-9bdc-07e84168425f",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "Any mass of dust, steam or smoke resembling such a mass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffcaf9d-5abc-48f3-9daf-155868d7e147",
                                                "sense_id": "f7be0c5f-1de5-38ac-9bdc-07e84168425f",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ff41891-c912-39dc-aafa-649c43cb9de7",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "Anything which makes things foggy or gloomy. Example: The clouds were grey so James thought it was about to rain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "548097d0-e654-3233-a39b-16f8e6337f59",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "Anything unsubstantial."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22b64d00-c9cf-3718-ba61-9c2b1447d347",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A dark spot on a lighter material or background."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29a930d3-c744-3d1d-8150-f8e9eee07317",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A group or swarm, especially suspended above the ground or flying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87eb2362-7821-4c3a-8d26-2302597d238a",
                                                "sense_id": "29a930d3-c744-3d1d-8150-f8e9eee07317",
                                                "text": "He opened the door and was greeted by a cloud of bats."
                                            },
                                            {
                                                "example_id": "d50067f8-bbdb-4efc-a263-f5225b819105",
                                                "sense_id": "29a930d3-c744-3d1d-8150-f8e9eee07317",
                                                "text": "so great a cloud of witnesses"
                                            },
                                            {
                                                "example_id": "e4a58dae-7000-4180-9ce6-7234277f99d8",
                                                "sense_id": "29a930d3-c744-3d1d-8150-f8e9eee07317",
                                                "text": "The place was horribly haunted by clouds of mosquitoes and every form of flying pest, so we were glad to find solid ground again and to make a circuit among the trees, which enabled us to outflank this pestilent morass, which droned like an organ in the distance, so loud was it with insect life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f534ae4-4171-3688-84de-051a5fa88c34",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "An elliptical shape or symbol whose outline is a series of semicircles, supposed to resemble a cloud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25399ed6-5c9c-4401-9b74-7919b7638449",
                                                "sense_id": "4f534ae4-4171-3688-84de-051a5fa88c34",
                                                "text": "The comic-book character's thoughts appeared in a cloud above his head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eef7963-abd5-3ab3-bf74-0da79e81fcc4",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A telecom network (from their representation in engineering drawings)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4baf6150-9cb6-3375-99c8-498619865d2f",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "The Internet, regarded as an abstract amorphous omnipresent space for processing and storage, the focus of cloud computing."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef96c93-b209-421b-8617-e4d6e74e5587",
                                                "sense_id": "4baf6150-9cb6-3375-99c8-498619865d2f",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            },
                                            {
                                                "example_id": "d647080c-f338-4a12-aff8-51e35406f93d",
                                                "sense_id": "4baf6150-9cb6-3375-99c8-498619865d2f",
                                                "text": "[…]the cloud could do this, it could do that. The cloud could be powerful and intelligent. It became a business buzzword and a selling point."
                                            },
                                            {
                                                "example_id": "2c7106e3-e7e5-48f2-93b2-224c48c043d6",
                                                "sense_id": "4baf6150-9cb6-3375-99c8-498619865d2f",
                                                "text": "“But there’s no fucking cloud,” says Crabapple, “there’s other people’s computers. There are vast datacentres that are sucking up water and electricity and rare-earth metals, literally boiling up the planet […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54498364-87b8-314d-90d3-bf9492e0d275",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A negative or foreboding aspect of something positive: see every cloud has a silver lining or every silver lining has a cloud."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b50f6486-c837-4af5-ab25-8bf027a7e690",
                                                "sense_id": "54498364-87b8-314d-90d3-bf9492e0d275",
                                                "text": "But when he found that some of his interrogatories were evaded, and others answered undecisively, the look of gentleness which he had assumed, vanished, and his brow wore the cloud of disappointment and of anger."
                                            },
                                            {
                                                "example_id": "b3543560-99ce-488c-9464-f560fc20fb4e",
                                                "sense_id": "54498364-87b8-314d-90d3-bf9492e0d275",
                                                "text": "The only cloud on their night was that injury to Rafael, who was followed off the pitch by his anxious brother Fabio as he was stretchered away down the tunnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dce3f8a-778c-351f-ad71-1000a826823e",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "Crystal methamphetamine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a64bd020-170b-3008-bd7b-898efeb7262d",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A large, loosely-knitted headscarf worn by women."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b5a69de-4db5-3157-864d-93df70b95a92",
                                        "entry_id": "52cfc0c0-7340-3681-823e-7b35772cdcf7",
                                        "glosses": [
                                            "A white cat."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "endearing",
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cloud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3da2aa7-ad6d-3fdb-8e2e-1755d2762066",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To become foggy or gloomy, or obscured from sight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f69e21-6926-4b5d-80d1-94f21cc11f03",
                                                "sense_id": "b3da2aa7-ad6d-3fdb-8e2e-1755d2762066",
                                                "text": "The glass clouds when you breathe on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5836195a-f340-3faa-a05a-4c761e0042ab",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To overspread or hide with a cloud or clouds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d208745-b37d-4eee-a0dd-07c18440d66f",
                                                "sense_id": "5836195a-f340-3faa-a05a-4c761e0042ab",
                                                "text": "The sky is clouded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d153b71a-bfd0-3453-9c90-9b862a726a09",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "Of the breath, to become cloud; to turn into mist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afae53a0-62e5-443e-a74c-db4ab09d0214",
                                                "sense_id": "d153b71a-bfd0-3453-9c90-9b862a726a09",
                                                "text": "The horses stamping\nTheir warm breath clouding\nIn the sharp and frosty morning\nOf the day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1722b548-e23f-376f-bed4-8472f2dfb9cb",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To make obscure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad6551d7-dba9-4a70-90e7-22c5922b179d",
                                                "sense_id": "1722b548-e23f-376f-bed4-8472f2dfb9cb",
                                                "text": "All this talk about human rights is clouding the real issue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8240289b-1464-365a-804f-d7920fc6fe94",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To make less acute or perceptive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494aab44-5c0d-4312-a653-cd21864290c3",
                                                "sense_id": "8240289b-1464-365a-804f-d7920fc6fe94",
                                                "text": "Your emotions are clouding your judgement."
                                            },
                                            {
                                                "example_id": "f1cdd812-93fb-4aab-a9a5-066a13be7290",
                                                "sense_id": "8240289b-1464-365a-804f-d7920fc6fe94",
                                                "text": "The tears began to well up and cloud my vision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef6f9bf-5024-314a-91fe-c5cece540f86",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To make gloomy or sullen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df00332-60a3-4841-9381-2e63e0f04a94",
                                                "sense_id": "4ef6f9bf-5024-314a-91fe-c5cece540f86",
                                                "text": "One day too late, I fear me, noble lord,\n Hath clouded all thy happy days on earth."
                                            },
                                            {
                                                "example_id": "b6ccc572-8a77-4b3a-870b-774aed4c22b3",
                                                "sense_id": "4ef6f9bf-5024-314a-91fe-c5cece540f86",
                                                "text": "Be not disheartened, then, nor cloud those looks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d069be00-42be-39ec-9318-41bfab0e5789",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To blacken; to sully; to stain; to tarnish (reputation or character)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "978228d0-5c09-4cdc-a003-2ee6b2045df9",
                                                "sense_id": "d069be00-42be-39ec-9318-41bfab0e5789",
                                                "text": "I would not be a stander-by to hear\n My sovereign mistress clouded so, without\n My present vengeance taken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb40f4ed-93e1-3d76-b60a-638c1813236d",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To mark with, or darken in, veins or sports; to variegate with colors."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04642fab-67c0-4b6a-80bc-cc8804f469da",
                                                "sense_id": "fb40f4ed-93e1-3d76-b60a-638c1813236d",
                                                "text": "to cloud yarn"
                                            },
                                            {
                                                "example_id": "8e087498-d0d6-4592-bcc6-d5bfc2eaba92",
                                                "sense_id": "fb40f4ed-93e1-3d76-b60a-638c1813236d",
                                                "text": "The nice conduct of a clouded cane"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1894eeb2-8237-3fd1-a871-b787e3d214cc",
                                        "entry_id": "b8ae4040-9032-30fb-bf98-e4d4bc38d233",
                                        "glosses": [
                                            "To become marked, darkened or variegated in this way."
                                        ],
