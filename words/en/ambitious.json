{
    "word_family": [
        "ambition",
        "ambitiously",
        "ambitiousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                    "sense_definition": "Having or showing a strong desire to achieve success, power, or distinction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personal_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>ambitious</w> person who hopes to become the CEO of the company one day.",
                            "target_lang_translations": {
                                "ru": "Она <w>амбициозный</w> человек, который надеется однажды стать генеральным директором компании."
                            }
                        },
                        {
                            "text": "His <w>ambitious</w> nature drove him to work harder than anyone else in the office.",
                            "target_lang_translations": {
                                "ru": "Его <w>честолюбивая</w> натура заставляла его работать усерднее всех остальных в офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspiring"
                    ],
                    "antonyms": [
                        "unambitious"
                    ],
                    "common_phrases": [
                        "ambitious person",
                        "ambitious nature",
                        "highly ambitious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий сильным желанием достичь успеха, власти или отличия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбициозный",
                                "target_lang_sense_clarification": "стремящийся к успеху"
                            },
                            {
                                "target_lang_word": "честолюбивый",
                                "target_lang_sense_clarification": "стремящийся к славе и признанию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                    "sense_definition": "Intended to satisfy high aspirations or requiring great effort and resources to succeed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "projects_and_goals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government launched an <w>ambitious</w> plan to reduce carbon emissions by fifty percent.",
                            "target_lang_translations": {
                                "ru": "Правительство запустило <w>амбициозный</w> план по сокращению выбросов углекислого газа на пятьдесят процентов."
                            }
                        },
                        {
                            "text": "Building a new hospital in just six months was an <w>ambitious</w> project for the small town.",
                            "target_lang_translations": {
                                "ru": "Строительство новой больницы всего за шесть месяцев было <w>амбициозным</w> проектом для маленького городка."
                            }
                        }
                    ],
                    "antonyms": [
                        "unambitious"
                    ],
                    "common_phrases": [
                        "ambitious project",
                        "ambitious plan",
                        "ambitious goal",
                        "ambitious attempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленный на удовлетворение высоких устремлений или требующий больших усилий и ресурсов для достижения успеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбициозный",
                                "target_lang_sense_clarification": "о планах или проектах"
                            },
                            {
                                "target_lang_word": "грандиозный",
                                "target_lang_sense_clarification": "масштабный и смелый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d4b129-e4f0-3e53-8fb8-1dc5fcb813c1",
                    "sense_definition": "Difficult to achieve or accomplish due to its scale or complexity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "projects_and_goals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proposed timeline for the software update is very <w>ambitious</w> given the current bugs.",
                            "target_lang_translations": {
                                "ru": "Предложенные сроки обновления программного обеспечения очень <w>смелые</w>, учитывая текущие ошибки."
                            }
                        },
                        {
                            "text": "This new scheme is more technologically <w>ambitious</w> than any previous engineering feat.",
                            "target_lang_translations": {
                                "ru": "Эта новая схема более <w>амбициозна</w> в технологическом плане, чем любое предыдущее инженерное достижение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "technologically ambitious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для достижения или выполнения из-за своего масштаба или сложности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбициозный",
                                "target_lang_sense_clarification": "сложный и масштабный"
                            },
                            {
                                "target_lang_word": "смелый",
                                "target_lang_sense_clarification": "требующий решительности из-за сложности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd9a4a0-fc48-3d92-ada9-71235f1ac257",
                    "sense_definition": "Strongly desiring or eager to do something specific.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athletes were <w>ambitious</w> to prove their skills on the international stage.",
                            "target_lang_translations": {
                                "ru": "Молодые атлеты <w>жаждали</w> доказать свое мастерство на международной арене."
                            }
                        },
                        {
                            "text": "The club is <w>ambitious</w> to return to its former glory by winning the championship.",
                            "target_lang_translations": {
                                "ru": "Клуб <w>стремится</w> вернуть былую славу, выиграв чемпионат."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ambitious to do"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно желающий или стремящийся сделать что-то конкретное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаждущий",
                                "target_lang_sense_clarification": "сильно желающий чего-либо"
                            },
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "настроенный на достижение цели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}