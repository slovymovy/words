                "senses": [
                    {
                        "sense_id": "8c7ac0e0-3255-3dd7-93f1-bebca642af6d",
                        "entry_id": "ed24410e-ee63-3f27-909d-b3b45170a266",
                        "glosses": [
                            "устар., психол. полная покорность судьбе, безропотное смирение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31b9b99-6a17-4232-a757-a1b53ef347bf",
                                "sense_id": "8c7ac0e0-3255-3dd7-93f1-bebca642af6d",
                                "text": "Толстой в молодости хотел осчастливить человеческий род и только под старость, убедившись, что осчастливить не в его силах, стал проповедовать отречение, резиньяцию и т. п."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a305bd94-c4b6-489f-bea0-0661f798e69d",
                        "source_entry_id": "ed24410e-ee63-3f27-909d-b3b45170a266",
                        "source_sense_id": "8c7ac0e0-3255-3dd7-93f1-bebca642af6d",
                        "target_lang_word": "resignation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resignation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a24799ba-d715-3146-9506-990ced0f7fae",
                                        "entry_id": "99bf21e6-dd77-3937-93bb-a33fe7f4a36c",
                                        "glosses": [
                                            "The act of resigning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597189a2-097f-4fbb-81de-6986ce8852da",
                                                "sense_id": "a24799ba-d715-3146-9506-990ced0f7fae",
                                                "text": "Jane tendered her resignation to the board of directors, but they refused."
                                            },
                                            {
                                                "example_id": "8160803a-81da-4a0d-a6c9-bc376821726f",
                                                "sense_id": "a24799ba-d715-3146-9506-990ced0f7fae",
                                                "text": "I knew my Cabinet well, and despite Haig's reports that they were all holding firm I knew that there would be great pressure on them all, and great temptations, to make public demands for my resignation. That was something I had to prevent if I possibly could. I was determined not to appear to have resigned the presidency because of a consensus of staff or Cabinet opinion or because of public pressure from the people around me. For me and no less for the country, I believed that my resignation had to be seen as something that I had decided upon completely on my own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "469d1c88-d6ac-31e8-bec4-2174ca5e87c8",
                                        "entry_id": "99bf21e6-dd77-3937-93bb-a33fe7f4a36c",
                                        "glosses": [
                                            "A written or oral declaration that one resigns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df13588b-5800-4823-889c-980e1d8318fc",
                                                "sense_id": "469d1c88-d6ac-31e8-bec4-2174ca5e87c8",
                                                "text": "hand in one's resignation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5121fe56-6c5e-311c-b07e-d5cd1c010aad",
                                        "entry_id": "99bf21e6-dd77-3937-93bb-a33fe7f4a36c",
                                        "glosses": [
                                            "An uncomplaining acceptance of something undesirable but unavoidable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "455610c1-5ffa-4c02-a225-bdaeaae0bffa",
                                                "sense_id": "5121fe56-6c5e-311c-b07e-d5cd1c010aad",
                                                "text": "With resignation I acknowledged that after the accident I would not be able to ski again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f755ada-1ab9-3a60-83fa-7dadbd347f98",
                                        "entry_id": "99bf21e6-dd77-3937-93bb-a33fe7f4a36c",
                                        "glosses": [
                                            "The form by which a vassal returns the feu into the hands of a superior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
