        "pl-extract.jsonl": [
            {
                "entry_id": "185a1be1-bdcf-3775-821b-ed190255f273",
                "word": "błam",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98bbbdec-40da-3358-99b9-d80f99e90eac",
                        "entry_id": "185a1be1-bdcf-3775-821b-ed190255f273",
                        "glosses": [
                            "materiał kuśnierski ze zszytych brzegami skór futerkowych, służący m.in. do podszycia płaszcza lub uszycia futra; również sztuka futra pewnej miary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25bc550d-0d47-45a5-a430-da0bc8089687",
                                "sense_id": "98bbbdec-40da-3358-99b9-d80f99e90eac",
                                "text": "A kiedy się wystrychnie w usarskim ubierze, / Po kołnierzu go poznasz, bo błam futra bierze"
                            },
                            {
                                "example_id": "e1b5c102-ba81-4742-a024-64cbfd9da42c",
                                "sense_id": "98bbbdec-40da-3358-99b9-d80f99e90eac",
                                "text": "Na wór dla zagrzania ślicznych nóżek Wci serca mego posyłam wilczych ogonów samych błam, w których włożyłoby się sto takich nóżek, jako u Wci serca mego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "551d3161-77fd-31d0-8428-efebf0d30c4f",
                        "entry_id": "185a1be1-bdcf-3775-821b-ed190255f273",
                        "glosses": [
                            "płat, płachta czegoś"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "83b204bc-cc6c-46c3-aaa3-5d8b47cc8524",
                                "sense_id": "551d3161-77fd-31d0-8428-efebf0d30c4f",
                                "text": "Rozłożyła wiosna spódnicę zieloną, / Przykryła błota bury błam. / Pachnie ziemia ciałem młodym / Póki wiosna, póki trwa"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
