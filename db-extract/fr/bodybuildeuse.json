                        "examples": [
                            {
                                "example_id": "f1bf6e59-3047-4c9e-8490-9442958ddb2b",
                                "sense_id": "48cfd429-e179-3d56-8cf5-4fdd5585a469",
                                "text": "Le propriétaire vient de recruter un nouveau coach, une femme bodybuildeuse, qui lorsqu’elle ne travaille pas en coaching prépare des compétitions."
                            },
                            {
                                "example_id": "00d6f845-0887-4c4a-a864-35cdf23a177f",
                                "sense_id": "48cfd429-e179-3d56-8cf5-4fdd5585a469",
                                "text": "Bien que l'attention se tourne peu à peu vers la musculation féminine, il admet que la plupart des femmes viennent à la salle pour rester en forme ou perdre du poids. Très peu veulent devenir bodybuildeuses."
                            }
