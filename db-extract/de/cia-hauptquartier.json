                "senses": [
                    {
                        "sense_id": "23d4cf2d-3cbc-3664-a511-dcb6a55b85a3",
                        "entry_id": "d2fd6048-d676-33f3-8cdc-04827164fd49",
                        "glosses": [
                            "Hauptquartier des US-amerikanischen Auslandsnachrichtendienstes CIA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01bed3b5-356e-4b02-952e-e031e5a4f661",
                                "sense_id": "23d4cf2d-3cbc-3664-a511-dcb6a55b85a3",
                                "text": "„Lass mich raten. Du drückst mir einen Revolver ins Kreuz und forderst mich dringend auf, dich ins CIA-Hauptquartier zu bringen?“"
                            },
                            {
                                "example_id": "4f9cc39f-ac15-4d10-9b90-eb176ae1ba90",
                                "sense_id": "23d4cf2d-3cbc-3664-a511-dcb6a55b85a3",
                                "text": "„Das Zentrum für Terrorbekämpfung musste sich mit wenigen Räumen im Keller des alten CIA-Hauptquartiers begnügen.“"
                            },
                            {
                                "example_id": "5b1451a9-75dd-44a5-8874-ac05964a512d",
                                "sense_id": "23d4cf2d-3cbc-3664-a511-dcb6a55b85a3",
                                "text": "„Die örtliche Presse war eingeladen, und am nächsten Tag schickte die Beiruter Station Kopien sämtlicher Artikel an das CIA-Hauptquartier in Langley, wo sie auf beträchtliches Interesse stießen.“"
                            },
                            {
                                "example_id": "f7f3f79f-5ffa-44ef-a90b-dedac6c156d9",
                                "sense_id": "23d4cf2d-3cbc-3664-a511-dcb6a55b85a3",
                                "text": "„Er wohnte kaum fünf Minuten vom CIA-Hauptquartier entfernt und es passierte ständig, dass man ihn kurzfristig einbestellte - und sei es nur, um das Gespräch in einer sicheren Umgebung zu führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
