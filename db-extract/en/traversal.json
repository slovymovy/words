                        ]
                    },
                    {
                        "translation_id": "1506e089-d1b3-40d2-a64d-b7995d6fdd21",
                        "source_entry_id": "ee5bf573-1b8a-3736-8c77-31d1ba2e42e4",
                        "source_sense_id": "929ea167-7d37-3da3-9a5d-53e3e331acae",
                        "source_sense_description": "Akt oder Instanz des Querens",
                        "target_lang_word": "Durchquerung",
