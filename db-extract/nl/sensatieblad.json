                "senses": [
                    {
                        "sense_id": "bc79fabe-5661-3350-b414-ded1037ed806",
                        "entry_id": "5ff4e4f8-0eec-37e7-b644-0888962c6727",
                        "glosses": [
                            "een krant waarin naast het politieke en algemene nieuws zeer veel aandacht gaat naar sport, roddel, (seks)schandalen van beroemdheden, de \\\"sterren\\\", het (tv-)amusement en sensationele verhalen over extreme en vaak ook zeer gewelddadige moorden, verkrachtingen en berovingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4cc8f96-a5d6-4e8c-88cc-fd54fb644131",
                                "sense_id": "bc79fabe-5661-3350-b414-ded1037ed806",
                                "text": "‘De horrorcurve die ons spaargeld bedreigt’, titelde het sensatieblad Bild op zijn website. Daarmee verwijzend naar de stijgende inflatie die inmiddels een stuk hoger ligt dan de rente op het spaarboekje, waardoor sparen de gewone Duitser almaar meer geld kost."
                            },
                            {
                                "example_id": "346a523a-8199-4264-a7fc-216d7e3321c2",
                                "sense_id": "bc79fabe-5661-3350-b414-ded1037ed806",
                                "text": "Sensatieblad krijgt ton boete voor publiceren toplessfoto's prinses Kate"
                            },
                            {
                                "example_id": "287b941f-9de0-4fc7-874a-991595490a89",
                                "sense_id": "bc79fabe-5661-3350-b414-ded1037ed806",
                                "text": "Hij kocht eens een hele pagina in New York Daily News om de doodstraf te eisen tegen vijf Afro-Amerikaanse jongens die beschuldigd werden van een verkrachting in Central Park. De jongens bleken later onschuldig. Hij citeerde steeds vaker het onbetrouwbare sensatieblad National Enquirer. En hij bleef dat doen, onder meer toen hij de vader van rivaal Ted Cruz beschuldigde van betrokkenheid bij de moord op John F. Kennedy."
                            }
                        ]
                    }
                ],
