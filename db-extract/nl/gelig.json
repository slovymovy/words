                                        "sense_id": "66f0fd67-34ef-3482-9f13-5eb9e476cc7a",
                                        "entry_id": "d0e96dc5-7f20-377a-ad7d-b4e28598456d",
                                        "glosses": [
                                            "der Farbe gelb ähnlich, an gelb erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e992162-e54b-4e8d-be0d-76393f4b3430",
                                                "sense_id": "66f0fd67-34ef-3482-9f13-5eb9e476cc7a",
                                                "text": "Manchmal verraten gelbliche Finger den starken Raucher."
                                            }
