                "senses": [
                    {
                        "sense_id": "c85974e5-f811-3c71-955c-a83da7e4510d",
                        "entry_id": "6e63bb75-fe08-35a2-9fb4-33a8bf73c1a4",
                        "glosses": [
                            "Faire l’amour avec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237efd68-173a-4ba5-8da1-0a7bc1b68655",
                                "sense_id": "c85974e5-f811-3c71-955c-a83da7e4510d",
                                "text": "Mais parfois, c’est parce que dans un demi-sommeil nous laissons nos mains s’égarer sur votre toison et que le désir de vous choser nous prend irrépressiblement."
                            },
                            {
                                "example_id": "53a17167-5764-45fb-8526-45d451e79b19",
                                "sense_id": "c85974e5-f811-3c71-955c-a83da7e4510d",
                                "text": "Celui qui dit s’est fait choser par Jane Birkin sans préciser que c’était dans un rêve éveillé"
                            },
                            {
                                "example_id": "94e989c8-db86-43c5-ac26-9bba248a926b",
                                "sense_id": "c85974e5-f811-3c71-955c-a83da7e4510d",
                                "text": "je vois qu’il y en a un qui veut te choser!!"
                            }
                        ]
                    }
