                {
                    "sense_id": "503cddbc-45a6-319c-8519-551c961a489d",
                    "sense_definition": "État ou sentiment de bonheur parfait, plénitude morale ou physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bonheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passer l'après-midi au soleil avec un bon livre, c'est le <w>paradis</w> pour moi."
                        },
                        {
                            "text": "Après des semaines de stress intense, ces quelques jours de repos étaient le <w>paradis</w>."
                        }
                    ]
                },
                {
