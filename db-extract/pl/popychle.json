                        ],
                        "examples": [
                            {
                                "example_id": "7b3d2104-ed2c-43f9-979c-36c386eecda6",
                                "sense_id": "18b3589d-5d79-3351-ba7c-3f8a7f3e1829",
                                "text": "Z kocmołucha i popychla, przekształciła się w zawsze czystą, coraz bardziej elegancko ubraną i coraz lepiej wykształconą, wychowanicę pana inżyniera"
                            },
                            {
                                "example_id": "68afcec7-0d21-4089-bd14-efcaeb49840b",
                                "sense_id": "18b3589d-5d79-3351-ba7c-3f8a7f3e1829",
                                "text": "Wiecznie traktował ją jak popychle, głupie, nędzne popychle, i pędził do roboty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
