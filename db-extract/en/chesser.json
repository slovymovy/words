                ],
                "senses": [
                    {
                        "sense_id": "929b82f8-d5da-3c11-be68-d2d44e2956d8",
                        "entry_id": "889fc397-870c-301c-8921-31047f6bb843",
                        "glosses": [
                            "A chess player."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f4fb2f39-a067-41a0-8609-acd50c0b43c0",
                                "sense_id": "929b82f8-d5da-3c11-be68-d2d44e2956d8",
                                "text": "Where are those principles of fair play that allow both sides a hearing? that give a move to each player in turn? and what neglect of a chesser's analytical powers to make up your mind and decision from the analysis of the moves only of the Attack, not regarding what the Defense can move in reply?"
                            },
                            {
                                "example_id": "be7b1c85-acf8-49f4-a37f-693e4df96045",
                                "sense_id": "929b82f8-d5da-3c11-be68-d2d44e2956d8",
                                "text": "[…] a chesser of old, / Won a game in a shower of gold. / His move had the crowd floored, / And coins showered the board. / (They were paying off bets, I am told.)"
                            },
                            {
                                "example_id": "c3af73fb-e24f-4930-9a39-c4ba0732fefc",
                                "sense_id": "929b82f8-d5da-3c11-be68-d2d44e2956d8",
                                "text": "Earlier this summer I played Nigel Short, the world number three, at what chessers call a charity ‘simul’, or simultaneous display."
                            }
                        ]
                    }
                ],
