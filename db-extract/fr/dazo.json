                        "entry_id": "5cae0358-f4a8-3e7d-b618-8d8935e1a225",
                        "glosses": [
                            "Espèce du genre Coleus cultivée pour ses tubercules comestibles et plus particulièrement Coleus esculentus (anciennement Coleus dazo)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3093c07d-e0ef-4565-9e53-63fce56b4013",
                                "sense_id": "7e79a328-1553-38c2-b8a2-0aa258b088b8",
                                "text": "Le dazo ou Coleus dazo A. Chev., … a été cultivé de tout temps en Oubangui-Chari. On sait que le mot dazo est le nom Banda de la plante typique, que le Professeur Chevalier a gardé."
                            },
                            {
                                "example_id": "33605e0d-d373-44b5-adc8-71cfc233659c",
                                "sense_id": "7e79a328-1553-38c2-b8a2-0aa258b088b8",
                                "text": "Le dazo est une plante cultivée dans tout l’Oubangui et plus particulièrement chez les Bandas, pour ses tubercules comestibles."
                            }
                        ]
                    },
                    {
                        "sense_id": "23c9f300-eea6-3b63-a522-bf0d41a0d047",
                        "entry_id": "5cae0358-f4a8-3e7d-b618-8d8935e1a225",
                        "glosses": [
                            "Tubercule de cette plante."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "2e914f62-e5d6-4716-b006-0ba613742a3b",
                                "sense_id": "23c9f300-eea6-3b63-a522-bf0d41a0d047",
                                "text": "Aha ! le manioc, les patates, les dazos, les courges, l’igname, le maïs !"
                            }
                        ]
