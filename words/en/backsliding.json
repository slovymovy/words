{
    "word_family": [
        "backslide",
        "backslider"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                    "sense_definition": "A relapse into bad habits, wrong behavior, or lower standards, especially morally, politically, or religiously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Political analysts warned against democratic <w>backsliding</w> in the newly established republic.",
                            "target_lang_translations": {
                                "ru": "Политические аналитики предостерегали от <w>отката</w> от демократии в недавно образованной республике."
                            }
                        },
                        {
                            "text": "After months of healthy eating, a brief period of <w>backsliding</w> caused him to regain weight.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев здорового питания короткий период <w>срыва</w> привел к тому, что он снова набрал вес."
                            }
                        }
                    ],
                    "synonyms": [
                        "relapse",
                        "regression",
                        "recidivism",
                        "lapse"
                    ],
                    "antonyms": [
                        "progress",
                        "improvement",
                        "advancement"
                    ],
                    "common_phrases": [
                        "democratic backsliding",
                        "moral backsliding",
                        "prevent backsliding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возврат к дурным привычкам, неверному поведению или ухудшению стандартов, особенно в моральном, политическом или религиозном плане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откат",
                                "target_lang_sense_clarification": "отступление назад, регресс в реформах или политике"
                            },
                            {
                                "target_lang_word": "регресс",
                                "target_lang_sense_clarification": "ухудшение, движение назад"
                            },
                            {
                                "target_lang_word": "отступничество",
                                "target_lang_sense_clarification": "в моральном или религиозном контексте"
                            },
                            {
                                "target_lang_word": "рецидив",
                                "target_lang_sense_clarification": "повторение вредных привычек или ошибок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8b84bc9-f10a-3c5e-a626-70c77dc9b434",
                    "sense_definition": "present participle and gerund of <w>backslide</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled with <w>backsliding</w> into his old, destructive habits whenever he felt stressed.",
                            "target_lang_translations": {
                                "ru": "Всякий раз при стрессе он боролся с <w>возвращением</w> к своим старым разрушительным привычкам."
                            }
                        },
                        {
                            "text": "She was worried about <w>backsliding</w> after making so much progress during therapy.",
                            "target_lang_translations": {
                                "ru": "Она боялась <w>отката назад</w> после столь значительного прогресса в ходе терапии."
                            }
                        }
                    ],
                    "synonyms": [
                        "relapsing",
                        "regressing"
                    ],
                    "antonyms": [
                        "progressing",
                        "improving"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола backslide (возвращаться к дурному, отступать от стандартов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращение к прежнему",
                                "target_lang_sense_clarification": "действие по герундию (к старым привычкам)"
                            },
                            {
                                "target_lang_word": "откат назад",
                                "target_lang_sense_clarification": "скатывание к худшему состоянию"
                            },
                            {
                                "target_lang_word": "отступающий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0576a983-28cd-3730-913c-296447daf98e",
                    "sense_definition": "Relapsing or reverting into worse behavior, lower standards, or undesirable conditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government faced criticism from human rights groups over its <w>backsliding</w> policies.",
                            "target_lang_translations": {
                                "ru": "Правительство столкнулось с критикой со стороны правозащитных групп из-за своей <w>регрессивной</w> политики."
                            }
                        },
                        {
                            "text": "He showed a <w>backsliding</w> attitude toward his daily responsibilities and commitments.",
                            "target_lang_translations": {
                                "ru": "Он проявлял <w>халатное</w> отношение к своим ежедневным обязанностям и обещаниям, скатываясь к прежнему поведению."
                            }
                        }
                    ],
                    "synonyms": [
                        "regressive",
                        "relapsing"
                    ],
                    "antonyms": [
                        "progressive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регрессивный, возвращающийся к худшему поведению, низким стандартам или нежелательному состоянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регрессивный",
                                "target_lang_sense_clarification": "направленный назад, ухудшающий положение"
                            },
                            {
                                "target_lang_word": "откатывающийся назад",
                                "target_lang_sense_clarification": "ухудшающийся, скатывающийся к прежнему"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}