                        "glosses": [
                            "Maisonnette d'alpage à l’usage des bergers."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "e5c7cce2-a75e-4eb2-8777-1bee73d981b3",
                                "sense_id": "23f0404a-3c42-3668-9429-4a804ff71b81",
                                "text": "D’abord ces vides domestiqués des champs et des clochers, puis celui des forêts frémissantes et le vide berceur des alpages chamarrés de haberts et de troupeaux."
                            },
                            {
                                "example_id": "3fb918af-af20-47fd-a800-b678eaf5bdc7",
                                "sense_id": "23f0404a-3c42-3668-9429-4a804ff71b81",
                                "text": "Dès six heures nous étions tous là, quatre-vingts hommes : pères, fils, frères et grands-pères, ravis d’entendre notre Langlois se débrouiller dans tous nos lieux-dits, nos vallons, nos crêtes, nos haberts, nos jas, et nos pistes les plus secrètes."
                            }
                        ]
                    }
