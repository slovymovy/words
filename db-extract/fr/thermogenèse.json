                "senses": [
                    {
                        "sense_id": "ff1d3013-ca87-3a6c-ae4d-2dd9438a978b",
                        "entry_id": "739f34ee-23b4-301e-b37d-f6aa00d65770",
                        "glosses": [
                            "Production d’une ou de plusieurs liaisons covalentes, consécutive à l’exposition d’un composé à une élévation de température, ou tout processus dans lequel une telle production joue un rôle essentiel."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e31488d4-8869-3e68-bd84-5c58720c9e80",
                        "entry_id": "739f34ee-23b4-301e-b37d-f6aa00d65770",
                        "glosses": [
                            "Production de chaleur chez les animaux mais aussi chez certaines plantes comme les aracées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40c2a19-79c4-4750-affb-23568d8152fe",
                                "sense_id": "e31488d4-8869-3e68-bd84-5c58720c9e80",
                                "text": "En 1937, Adriaan Van Herk montre que des inflorescences coupées peu de temps avant la phase de thermogenèse libèrent normalement de la chaleur."
                            },
                            {
                                "example_id": "a5be1cb2-12d2-454a-a2e5-bb1e63003eb8",
                                "sense_id": "e31488d4-8869-3e68-bd84-5c58720c9e80",
                                "text": "Les chercheurs ont ainsi découvert que l’activité physique à une phase active précoce augmentait l’expression des gènes impliqués dans la dégradation du tissu adipeux, la thermogenèse (production de chaleur) et les mitochondries dans le tissu adipeux, indiquant un taux métabolique plus élevé."
                            }
                        ]
                    }
                ],
