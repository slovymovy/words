                "translations": [
                    {
                        "translation_id": "eef26ea9-970a-4329-8782-c42ed6031c52",
                        "source_entry_id": "591f6734-c786-30cf-8dd8-b16239690e7c",
                        "source_sense_id": "8fea457b-c9cc-3777-b880-133dd4c6ff4f",
                        "target_lang_word": "autecology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autecology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d028174e-4c10-3e3f-aeab-1a20bd44b63a",
                                        "entry_id": "df266c19-13a2-3368-bc55-896c2fe58628",
                                        "glosses": [
                                            "one of two broad subdivisions of ecology, which studies the individual organism or species."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d0b40d-7cf7-4c87-9353-2b694512bdf8",
                                                "sense_id": "d028174e-4c10-3e3f-aeab-1a20bd44b63a",
                                                "text": "1959: Odum, '\nIn regard to subdivisions, ecology is commonly divided into autecology' and synecology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bf88d21-876b-498c-afe4-0d4b209e0727",
                        "source_entry_id": "591f6734-c786-30cf-8dd8-b16239690e7c",
                        "source_sense_id": "8fea457b-c9cc-3777-b880-133dd4c6ff4f",
                        "target_lang_word": "autécologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autécologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "437c6c65-8a65-33e7-ba81-0018cf065dea",
                                        "entry_id": "269aeedb-19b8-3ede-b2ea-11d7691a56c6",
                                        "glosses": [
                                            "Écologie particulière d'une espèce animale ou végétale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d206579-3fcc-450f-861c-a42d2e94284d",
                                                "sense_id": "437c6c65-8a65-33e7-ba81-0018cf065dea",
                                                "text": "Pour l’autécologie des différentes espèces de cette association, il suffira de noter ici qu’elles présentent presque toutes les caractères organiques ou épharmoniques bien connus et ordinairement interprétés comme étant en rapport avec la vie flottante : […]."
                                            },
                                            {
                                                "example_id": "b6560cc0-ad6c-4dec-9165-4a43cfd090d5",
                                                "sense_id": "437c6c65-8a65-33e7-ba81-0018cf065dea",
                                                "text": "Ces lois de la nature, les écologistes des quelques dernières générations ont pensé qu'on pouvait les formuler en distinguant l’autécologie, la synécologie et la dynécologie."
                                            },
                                            {
                                                "example_id": "cca51591-d2ca-4d04-aca3-87dac18f97dc",
                                                "sense_id": "437c6c65-8a65-33e7-ba81-0018cf065dea",
                                                "text": "L’autécologie des mélèzes est assez mal connue, tout du moins dans les zones où ils ont été et sont introduits comme essence de reboisement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38665d07-d864-446f-818e-197ad681f354",
                        "source_entry_id": "591f6734-c786-30cf-8dd8-b16239690e7c",
                        "source_sense_id": "8fea457b-c9cc-3777-b880-133dd4c6ff4f",
                        "target_lang_word": "Autökologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autökologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8decd5-7798-3dbf-96c2-2aae311a187b",
                                        "entry_id": "2a0f9c33-ad70-3550-bcf1-dbf30d29302f",
                                        "glosses": [
                                            "Teilgebiet der Ökologie, das die Beziehungen einzelner Arten zu verschiedenen Umweltfaktoren untersucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb0e6d0-7ee1-45aa-bed6-20c081798a07",
                                                "sense_id": "3c8decd5-7798-3dbf-96c2-2aae311a187b",
                                                "text": "Die Autökologie beschreibt die Wechselwirkungen zwischen der Umwelt und dem Individuum. Autökologische Standortansprüche sind demnach die Anforderungen eines Lebewesens an seine Umwelt ohne Betrachtung von Konkurrenzeffekten durch andere Arten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
