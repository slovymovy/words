                                "example_id": "0148a83b-d4d8-43b0-843d-014963936190",
                                "sense_id": "59ea246e-fa58-3e87-a048-29b0fe58cfa8",
                                "text": "„Die Spiele werden kommentiert von Laura Gissler-Weber, passionierte Polospielerin und Mitglied des Poloclubs Gut Rixförde.“"
                            },
                            {
                                "example_id": "3c192109-4d91-455f-818d-294ff2167bbf",
                                "sense_id": "59ea246e-fa58-3e87-a048-29b0fe58cfa8",
                                "text": "„Nachdem Karen zunächst auf einem Holzpferd Trockenübungen absolvieren muss, darf sie anschließend mit Deutschlands erfolgreichster Polospielerin Eva Brühl bei einem Mannschaftsspiel dabei sein.“"
                            }
                        ],
