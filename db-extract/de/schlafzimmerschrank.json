                "senses": [
                    {
                        "sense_id": "46f7759e-432e-35b4-b59c-7bddc608d0d9",
                        "entry_id": "9a30df4d-565e-39b7-bbb9-62f2bbc077a2",
                        "glosses": [
                            "Schrank für ein Schlafzimmer, vor allem für Kleidung und Wäsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49eab2d8-9ab1-48b5-a27c-2c31e57bc1e2",
                                "sense_id": "46f7759e-432e-35b4-b59c-7bddc608d0d9",
                                "text": "„Von ihrem Ersparten kaufte meine Mutter eine Kücheneinrichtung und einen Schlafzimmerschrank.“"
                            },
                            {
                                "example_id": "028842b8-ce6e-4f27-ac1d-91cb1a7ed31c",
                                "sense_id": "46f7759e-432e-35b4-b59c-7bddc608d0d9",
                                "text": "„Er stand neben einem breiten Bett und war gerade dabei gewesen, den Schlafzimmerschrank zu durchwühlen.“"
                            },
                            {
                                "example_id": "907339f1-5d7e-48d5-afdf-9743618366f3",
                                "sense_id": "46f7759e-432e-35b4-b59c-7bddc608d0d9",
                                "text": "„Einmal sagst du zu mir: »Ich brauche noch den gelben Pullover mit dem V-Ausschnitt, der links im Schlafzimmerschrank hängt.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
