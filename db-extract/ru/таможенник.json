                    {
                        "translation_id": "1b143ca8-c879-4476-8144-31adfc42d672",
                        "source_entry_id": "308e43a7-bc37-3a1e-8488-c4de462af85a",
                        "source_sense_id": "1232de38-f89c-36c4-ac57-3bcd5c54d938",
                        "target_lang_word": "Zöllner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zöllner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                        "entry_id": "f4e34025-d8bc-349c-a853-b7a8764b0345",
                                        "glosses": [
                                            "ein Beamter der Zollbehörde"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85ba887-f385-44da-a3bf-20aab21ff678",
                                                "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                                "text": "An der Grenze kontrollierte der Zöllner die Reisedokumente."
                                            },
                                            {
                                                "example_id": "17372140-e825-4ca3-a3ac-7c55f0512578",
                                                "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                                "text": "„Immer wieder kamen Zöllner herein, immer wieder ging der, der sie verhörte, hinaus, und schließlich wurde sie auf den Flur geschickt.“"
                                            },
                                            {
                                                "example_id": "1bdd8563-ff72-455a-870c-3d2d624e836a",
                                                "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                                "text": "„Beim letzten Zollwitz fehlt der Zöllner.“"
                                            },
                                            {
                                                "example_id": "60838d74-62ba-46eb-a697-a37c8402f3fd",
                                                "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                                "text": "„Mit förmlicher Höflichkeit entließen ihn die Zöllner.“"
                                            },
                                            {
                                                "example_id": "0038b0cf-966b-4f19-98a8-647f3b64f774",
                                                "sense_id": "f1c87af2-ccac-3e7d-a267-7721b5957790",
                                                "text": "„Als der Staub verflogen war, erkannten sie einen Schiffsmast, der unter dem Stiefel des Zöllners zerbröckelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
