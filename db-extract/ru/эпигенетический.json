                    {
                        "translation_id": "ea45fafe-5cdc-457f-a000-cd1772c3271b",
                        "source_entry_id": "11047d81-a8b7-3f79-9726-b0eafda1174e",
                        "target_lang_word": "epigenetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigenetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3b20d1-88fd-3e83-9ce4-ad63b7d4f715",
                                        "entry_id": "a25fd443-d23f-34f1-bae5-6d55793f791d",
                                        "glosses": [
                                            "die Epigenese betreffend, also die Tatsache, dass sich Lebewesen in ihrer Embryogenese von einem undifferenzierten in einen hochkomplex ausdifferenzierten Zustand entwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c809170b-29c6-496c-b973-3fcf568155c6",
                                                "sense_id": "3b3b20d1-88fd-3e83-9ce4-ad63b7d4f715",
                                                "text": "Das neue epigenetische Konzept wird zur Wurzel und zum Modellfall für Herbert Spencers Konzept einer universalen Evolution."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70a2de0d-229b-34df-8f18-7552febc2bca",
                                        "entry_id": "a25fd443-d23f-34f1-bae5-6d55793f791d",
                                        "glosses": [
                                            "die Epigenetik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd9f1ed2-ee03-46e8-bbcb-9c45a196fab2",
                                                "sense_id": "70a2de0d-229b-34df-8f18-7552febc2bca",
                                                "text": "Epigenetische Phänomene ermöglichen lamarckistischen Ansichten im Sinne einer Vererbung erworbener Eigenschaften ein begrenztes Comeback."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95bd3b53-3582-3a61-b08c-b2161f8ec3d8",
                                        "entry_id": "a25fd443-d23f-34f1-bae5-6d55793f791d",
                                        "glosses": [
                                            "Vorgänge in der Natur betreffend, die bestehendes nachträglich überformen oder überlagern (wie beispielsweise die Neuanlage eines Flusstales durch Laufverlegung des ursprünglichen Flusses oder die spätere Entstehung von geologischen Lagerstätten)"
                                        ],
