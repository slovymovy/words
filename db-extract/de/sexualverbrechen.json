                "senses": [
                    {
                        "sense_id": "3e837779-4a76-35dd-b066-45b372601a28",
                        "entry_id": "2d461835-81e2-367b-a589-a6ef5e16bc2d",
                        "glosses": [
                            "schwere Straftat in sexueller Hinsicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "439b9bd1-efdb-4c42-9937-31b98d640e32",
                                "sense_id": "3e837779-4a76-35dd-b066-45b372601a28",
                                "text": "„Er macht auf die üble Wirkung der öffentlichen Verhandlung von Sexualverbrechen aufmerksam.“"
                            },
                            {
                                "example_id": "573b484b-17b4-4ef8-a1db-b1e574f5bba7",
                                "sense_id": "3e837779-4a76-35dd-b066-45b372601a28",
                                "text": "„Obwohl das Opfer vollständig bekleidet aufgefunden wurde, spricht eine frische Verletzung im Vaginalbereich für ein Sexualverbrechen.“"
                            },
                            {
                                "example_id": "aa0f57fd-3acd-404d-986b-db52e2287c30",
                                "sense_id": "3e837779-4a76-35dd-b066-45b372601a28",
                                "text": "„Es sollte wie ein Sexualverbrechen aussehen - deshalb war der BH hochgeschoben und der Schambereich freigelegt -, obwohl es keinen Hinweis auf Vergewaltigung gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
