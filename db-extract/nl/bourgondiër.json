                        "examples": [
                            {
                                "example_id": "b81abee8-9b25-46e3-adff-6cc48f7471c9",
                                "sense_id": "68c59db3-6aa6-3049-a31d-8865af04c803",
                                "text": "Frans Duijts zegt in een openhartig interview dat hij er aan het begin van zijn carrière niet uit zag. Ook vertelt hij dat hij voor altijd een strijd zal voeren tegen de kilo’s, omdat hij naar eigen zeggen een echte bourgondiër is."
                            },
                            {
                                "example_id": "65c26653-0fb0-45a5-87c2-7cb7f131d366",
                                "sense_id": "68c59db3-6aa6-3049-a31d-8865af04c803",
                                "text": "Gent is misschien wel de leukste stad van België. De sfeer is vrijgevochten en knus, maar het straatbeeld middeleeuws: een verrassende combinatie. Gentenaren zijn bovendien echte bourgondiërs, ontdekte Kim de Klonia."
                            }
                        ]
                    }
