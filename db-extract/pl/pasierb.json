                    {
                        "translation_id": "381563fc-c55c-41d3-a4e9-6efd4656e366",
                        "source_entry_id": "fe42d567-1cd2-3205-8588-c8c9c66715f5",
                        "source_sense_id": "e0ed8a35-3832-377c-a271-92f40454a125",
                        "target_lang_word": "Stiefsohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefsohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                        "entry_id": "f46c04a9-49c9-3180-a82a-88e89322f2a8",
                                        "glosses": [
                                            "ein Sohn der Ehefrau oder des Ehemanns aus einer früheren Ehe oder einer außerehelichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8c7420-4b9d-433d-a776-270a4d5c079c",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "Sie behandelte Ihren Stiefsohn immer korrekt."
                                            },
                                            {
                                                "example_id": "9e393caa-2352-4847-8cd3-9b4244288199",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Der Stiefvater wusste, dass der Oberst ein Theaterliebhaber war und hatte ihm von dem Theaterinteresse seines Stiefsohnes erzählt.“"
                                            },
                                            {
                                                "example_id": "d7c32742-343d-48a2-a424-b3eb775913b9",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Und Hélène ist für Martin Mutter und ältere Freundin in einem - es trennen sie viel weniger Jahre von ihrem Stiefsohn als von ihrem Ehemann.“"
                                            },
                                            {
                                                "example_id": "322dd991-620f-48f0-9479-de34d32c94d0",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Sein Stiefsohn sah ihn kein einziges Mal an, sondern steuerte unsicheren Schrittes auf die Treppe zu, seinen Hut am Hinterkopf balancierend, den Schirm noch in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d3e4e20-24df-4a17-8e93-d001e1736a18",
                        "source_entry_id": "fe42d567-1cd2-3205-8588-c8c9c66715f5",
                        "source_sense_id": "e0ed8a35-3832-377c-a271-92f40454a125",
                        "target_lang_word": "пасынок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пасынок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e09f6abf-00ed-31ea-99fc-85026201a781",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "неродной сын одного из супругов, приходящийся родным другому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7ec7b3-478d-4876-b678-bb5afa4c789e",
                                                "sense_id": "e09f6abf-00ed-31ea-99fc-85026201a781",
                                                "text": "Это ― хороший человек, и он жестоко обижен; жизнь обращалась с ним несправедливо, как мачеха с пасынком."
                                            },
                                            {
                                                "example_id": "f6b21611-9d3b-41c7-82d0-5e8648e96242",
                                                "sense_id": "e09f6abf-00ed-31ea-99fc-85026201a781",
                                                "text": "Нетрудоспособные нуждающиеся в помощи отчим и мачеха, воспитывавшие и содержавшие своих пасынков или падчериц, имеют право требовать в судебном порядке предоставления содержания от трудоспособных совершеннолетних пасынков или падчериц, обладающих необходимыми для этого средствами, если они не могут получить содержание от своих совершеннолетних трудоспособных детей или от супругов (бывших супругов)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce19138c-f346-3f97-846a-a84ba62f8212",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "истор. в Древней Руси — княжеский дружинник боярского происхождения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc7848f-225a-4b7b-8f8e-bdd8fbe2f8ac",
                                                "sense_id": "ce19138c-f346-3f97-846a-a84ba62f8212",
                                                "text": "Сей князь… собрал многочисленную дружину, бояр, гридней, так называемых пасынков, или отроков боярских, и шёл с ними ко Владимиру."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1dd17be-c618-30e8-a42a-600db596e8f8",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "перен. тот, кто лишён необходимого внимания, заботы, любви"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fccb5d70-5100-4077-92ba-9fcafdaf10b4",
                                                "sense_id": "a1dd17be-c618-30e8-a42a-600db596e8f8",
                                                "text": "Средневековье — пасынок истории; историческая память человечества обошлась с ним сурово."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9e4788-9bee-3d9f-83d8-b8eab63d0cfb",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "неодуш. ботан., с.-х. боковой побег растения, развивающийся в пазухах листьев главного стебля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5296d4bd-2710-4fe9-8ccf-742b90a3bdd8",
                                                "sense_id": "aa9e4788-9bee-3d9f-83d8-b8eab63d0cfb",
                                                "text": "Важно не упустить начало формирования растений томата, чтобы не допустить отрастания пасынков или раздвоения вершин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a926741-7726-30ab-ab2e-aaeff7ec8b6c",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "неодуш. ботан. сук, расположенный под небольшим углом к оси ствола дерева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea2fd84-f8e8-490a-8e80-d9e2d3613cd7",
                                                "sense_id": "9a926741-7726-30ab-ab2e-aaeff7ec8b6c",
                                                "text": "У сильно ослабленных и усыхающих деревьев нередко по всей длине ствола появляются так называемые водяные побеги (побеги, образующиеся не в кроне дерева и ухудшающие декоративность растения), а также пасынки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f59e873-e7ff-3b60-adcf-230ccf21672b",
                                        "entry_id": "8d8188ad-4f14-375f-a31d-3ddf4c2cd968",
                                        "glosses": [
                                            "неодуш. архит. то же, что укосина; наклонная подпорка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
