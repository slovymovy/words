                        "examples": [
                            {
                                "example_id": "a095324b-2e11-4d39-b8a8-38bec7738b2c",
                                "sense_id": "a2e927a5-6fbf-3498-849d-44c90e293d06",
                                "text": "Bio-industrie of vee-industrie is de industrie die met de hoogst mogelijke efficiëntie dierlijke producten produceert."
                            },
                            {
                                "example_id": "61c7dd1c-b863-40bc-9189-fb89445f29be",
                                "sense_id": "a2e927a5-6fbf-3498-849d-44c90e293d06",
                                "text": "In de bio-industrie hebben de dieren meestal maar een kleine ruimte tot hun beschikking."
                            },
                            {
                                "example_id": "e70febdb-b04d-4661-b26b-5081d5a14e1f",
                                "sense_id": "a2e927a5-6fbf-3498-849d-44c90e293d06",
                                "text": "Een druk station en ook andere drukke plekken zijn te vergelijken met de situatie in de bio-industrie. Daar zal men elkaar gemakkelijk besmetten. Zo werkt de natuur."
