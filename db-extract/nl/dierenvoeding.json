                        "glosses": [
                            "eten dat minder geschikt is voor menselijke consumptie en daarom gebruikt wordt als voedsel voor (huis)dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667e756e-3b51-47b3-a1c2-ceb6bf9e61c0",
                                "sense_id": "9d697f64-2f06-3567-a58e-cb48ab555b37",
                                "text": "Een deel van de bokjes wordt daarom meteen na de geboorte afgemaakt en belandt in de dierenvoeding."
                            },
                            {
                                "example_id": "80c6ae6c-f0d8-4a31-a27f-f07479750471",
                                "sense_id": "9d697f64-2f06-3567-a58e-cb48ab555b37",
                                "text": "Dierenartsen merken steeds vaker op dat mensen dierenvoeding uit de winkel afwijzen. Ze kiezen liever voor natuurlijke varianten als rauw vlees, botten of een glutenvrij of vegetarisch dieet."
                            }
                        ]
                    }
