        "de-extract.jsonl": [
            {
                "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                "word": "Ernährungssicherheit",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "6caee150-61ab-40de-85f9-2b829105fa04",
                        "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Ernährungssicherheit"
                    },
                    {
                        "form_id": "de416198-ad3b-46da-9e41-a47dd7d02129",
                        "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Ernährungssicherheit"
                    },
                    {
                        "form_id": "52819ed3-c5dd-4f61-b29e-2781b01acbd6",
                        "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Ernährungssicherheit"
                    },
                    {
                        "form_id": "72a9df56-4362-423a-92d7-2dec6f31e360",
                        "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Ernährungssicherheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                        "entry_id": "c7ac6dd3-58ee-3692-b293-b3890bc13614",
                        "glosses": [
                            "Zustand, in dem die ausreichende Verfügbarkeit von Nahrungsmitteln, insbesondere Grundnahrungsmitteln, sichergestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1237ac-ee17-43fc-814f-2bf23ff28d57",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Ernährungssicherheit ist mehr als die Abwesenheit von Hunger. Es zählt auch die Gewissheit, dass dies so bleibt.“"
                            },
                            {
                                "example_id": "1542b2f8-6cdc-49d3-8f6d-e11051941cc4",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Russlands Angriff auf die Ukraine gefährdet die globale Ernährungssicherheit.“"
                            },
                            {
                                "example_id": "2a146961-1cd1-4af6-8be9-7dbecbc78c0c",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Schon vor Corona kämpfte Ägypten mit wachsender Armut. Nun bedroht der Krieg in der Ukraine die Ernährungssicherheit der Bevölkerung.“"
                            },
                            {
                                "example_id": "0cac6945-84ab-42ec-8250-d77766d11085",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Der Krieg in der Ukraine trifft nicht nur die Menschen in den Kriegsgebieten, er könnte auch die Ernährungssicherheit in vulnerablen Regionen der Welt gefährden und Millionen Menschen in den Hunger treiben.“"
                            },
                            {
                                "example_id": "b194b549-7ce2-4523-a87c-cf3c79fbfc71",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Der Sonderbericht des Weltklimarats (IPCC) zur Landnutzung und Ernährungssicherheit empfiehlt, Weideflächen und Ackerland weltweit zu reduzieren.“"
                            },
                            {
                                "example_id": "63e19598-9d2b-4203-840f-a35246379af5",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Es hungern wieder mehr Menschen auf der Welt. Der Bericht zur Ernährungssicherheit der Vereinten Nationen nennt dafür vor allem drei Gründe: Konflikte, langsames Wirtschaftswachstum und den Klimawandel.“"
                            },
                            {
                                "example_id": "0c52cca9-d147-4e57-bb59-9a4722db9fd2",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„2005 hat das World Food Programme der Vereinten Nationen die Ernährungssicherheit von über 90 % der Binnenvertriebenen in Aserbaidschan als „food insecure“ bezeichnet.“"
                            },
                            {
                                "example_id": "cb3fc300-bd90-41fd-9a97-9142339b322a",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "[Klimakrise:] „Zu den möglichen Folgen zählen ein verheerendes Artensterben mit bedrohlichen Folgen auch für die weltweite Ernährungssicherheit, ein für Küstenregionen gefährlicher Anstieg der Meeresspiegel und die Verödung großer Teile heute fruchtbaren Landes.“"
                            },
                            {
                                "example_id": "2d222a34-bca0-40a5-bf15-226f67018584",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "[Globale Erwärmung:] „Hunderte Millionen Menschen werden vom Anstieg des Meeresspiegels und Missernten, welche die globale Ernährungssicherheit gefährden, betroffen sein.“"
                            },
                            {
                                "example_id": "817fcd14-7837-4ad7-8d83-195ef3d3225f",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "[…] „mit dem Klimawandel wird die Sorge um die Ernährungssicherheit zwangsläufig wieder eine globale.“"
                            },
                            {
                                "example_id": "4d7bbf76-a80c-4d34-88ae-3e3f9fde41e0",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Fast weltweit bringt es Vorteile, die Fruchtbarkeit des Bodens zu erhalten, zum Beispiel durch Mulchen oder mit Kompost. In Entwicklungsländern trägt eine Vielfalt an Weidetieren wie Rindern und Schafen auch zur Ernährungssicherheit bei.“"
                            },
                            {
                                "example_id": "ad6dc074-f29c-4273-b3cf-319b8eb5e601",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Landwirtschaft dient der Ernährungssicherheit der Weltbevölkerung, doch Monokulturen schaffen Probleme.“"
                            },
                            {
                                "example_id": "246e868f-0369-4939-ad27-22bbf0c36fc3",
                                "sense_id": "149e9feb-67e3-3a3e-a3ed-3c892dcf686c",
                                "text": "„Der zunehmend globale Handel mit Lebensmitteln gefährdet die Ernährungssicherheit. Modellrechnungen von Forschern aus den USA und der Schweiz legen nahe: Vor allem Ländern, die vom Import abhängig sind, drohen immer häufiger Versorgungskrisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
