                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стабилизация",
                                "target_lang_sense_clarification": "общий термин для процесса придания устойчивости"
                            },
                            {
                                "target_lang_word": "укрепление",
                                "target_lang_sense_clarification": "процесс фиксации или придания прочности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
