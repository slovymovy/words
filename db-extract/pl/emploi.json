                                "example_id": "6ddd126f-2f53-4cbe-9161-aa5d44a4f5d4",
                                "sense_id": "4688be72-7db8-3e75-8c8f-ccbd4e74df0d",
                                "text": "Chichotliwa dziecinność i prawdziwa naiwność bohaterki jakoś mi nie pasuje do jej emploi wścibskiej i rezolutnej kobitki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
