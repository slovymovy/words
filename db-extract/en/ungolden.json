                        "examples": [
                            {
                                "example_id": "a606c794-6c37-4ee6-88f2-778816088d2c",
                                "sense_id": "07bd1602-0f4e-33f0-a734-067f7fbd9a5d",
                                "text": "Being at a banker's a few days since, and seeing on the counter a number of [sovereigns] of a very dusky ungolden hue, I asked what was the matter with them?"
                            },
                            {
                                "example_id": "03eb8186-1523-40fe-88bc-46aef933446b",
                                "sense_id": "07bd1602-0f4e-33f0-a734-067f7fbd9a5d",
                                "text": "Zelda belonged to the ungolden world—her element was the golden age which was not of gold."
                            }
                        ]
                    }
