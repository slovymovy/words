                                "sense_id": "918519f3-577b-30bd-a29f-dd0d352716b1",
                                "text": "Dat is me verdorie wat moois!",
                                "translation": "Eh ben, c’est du beau ! / du propre !"
                            },
                            {
                                "example_id": "3524c6bc-2a76-4101-8b99-53d07b95b64d",
                                "sense_id": "918519f3-577b-30bd-a29f-dd0d352716b1",
                                "text": "Verdorie! daar heb ik mijn portemonnee vergeten!",
                                "translation": "Zut ! j’ai oublié mon portemonnaie."
                            }
                        ]
