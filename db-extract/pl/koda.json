                    {
                        "translation_id": "11cef4ba-b398-4ba6-8472-0a42e5b2c338",
                        "source_entry_id": "d78ccd29-5e6a-3c3d-8b83-e62387efb264",
                        "source_sense_id": "65173e93-189e-3064-9230-88c39912eb4d",
                        "target_lang_word": "Abschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b34d3256-0822-369f-9524-d447f149abeb",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "der Verschluss oder die Isolierung eines Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44acba0-d623-40f7-bfc7-00a827a13e13",
                                                "sense_id": "b34d3256-0822-369f-9524-d447f149abeb",
                                                "text": "Der luftdichte Abschluss der Verpackung gewährleistet längere Haltbarkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "469941be-3a11-3e51-8070-a36834feae59",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "eine abschließende Verzierung an Flächenbegrenzungen, Kleidungsstücken oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e452aa1-1b23-4422-85ce-240cad3f571e",
                                                "sense_id": "469941be-3a11-3e51-8070-a36834feae59",
                                                "text": "Den Abschluss der Rasenfläche bilden langgezogene Blumenbeete."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "erfolgreiche Beendigung eines Vorhabens, zum Beispiel eines schulischen oder universitären Bildungsganges"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dbe05c3-a256-44d0-9cc2-9d9e4ebc1b6b",
                                                "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                                "text": "Weißt Du schon, wo Du Dich nach Abschluss deines Studiums bewerben wirst?"
                                            },
                                            {
                                                "example_id": "9014c010-42b3-4180-b363-f90042665fdc",
                                                "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                                "text": "Aus Familien, in denen mindestens ein Elternteil einen akademischen Abschluss hat, studieren 79 Prozent der Kinder. Aus Familien, in denen beide Elternteile keinen beruflichen Abschluss haben, dagegen nur 12 Prozent."
                                            },
                                            {
                                                "example_id": "554fe155-52a5-4bdf-99d2-4e5bfab174fe",
                                                "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                                "text": "„2017 verließen gut 29 Prozent der türkischstämmigen Jungs die Schule ohne Abschluss.“"
                                            },
                                            {
                                                "example_id": "b2cc6310-db83-40c9-b0b1-63ac717deea6",
                                                "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                                "text": "„Universitäten wollte ein Fürstentum haben, weil sie Ausbildungsstätten waren, etwa für Ärzte, weshalb man vertraglich dafür sorgte, dass, wer einen Abschluss machte, auch im Lande praktizierte.“"
                                            },
                                            {
                                                "example_id": "1ffa35b1-f537-408c-844b-967d82321b34",
                                                "sense_id": "a23ea08f-adfb-3bbf-85f0-0a66c68bec7e",
                                                "text": "„In jenem Frühjahr hatte Haraldur seinen Abschluss an der Landwirtschaftsschule in Hvanneyri gemacht und sollte im Lauf der Zeit den Hof auf Nes übernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dd2c9ff4-0146-3a2d-9d82-1ec5c5066a3d",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "das geplante (erfolgreiche) Ende von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5776919a-01cd-4b57-b18d-e88ac4db302b",
                                                "sense_id": "dd2c9ff4-0146-3a2d-9d82-1ec5c5066a3d",
                                                "text": "Ich hoffe, dass die Bauarbeiten dieses Jahr noch zum Abschluss gelangen."
                                            },
                                            {
                                                "example_id": "747a9cbe-f176-4efa-a8d8-dd1c996b5e84",
                                                "sense_id": "dd2c9ff4-0146-3a2d-9d82-1ec5c5066a3d",
                                                "text": "Der Abschluss der Vertragsverhandlungen ist zum Ende des Monats geplant."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d62f2213-f03e-3ed7-a7b2-e90c0abb3bf3",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "der Abschluss der Konten am Ende einer wirtschaftlichen Periode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f23a4c-9d39-45e7-861f-5c34b372109a",
                                                "sense_id": "d62f2213-f03e-3ed7-a7b2-e90c0abb3bf3",
                                                "text": "Bei Kapitalgesellschaften wird der Abschluss von den gesetzlichen Vertretern aufgestellt und anschließend zur Prüfung und Feststellung weitergeleitet."
                                            }
                                        ],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "2c1c4d7f-64b0-385b-b6e0-2c3c2406836c",
                                        "entry_id": "c64d285b-7f33-3066-8986-fa56b8286b01",
                                        "glosses": [
                                            "eine Vereinbarung über ein Geschäft oder einen Handel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6ca1f8-a0e9-46a9-a11a-8ded0ffcb4af",
                                                "sense_id": "2c1c4d7f-64b0-385b-b6e0-2c3c2406836c",
                                                "text": "Man unterscheidet Sozialversicherungspflicht sowie die Pflicht zum Abschluss privater Versicherungen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33ee8d72-5e57-4141-b000-e9a721745244",
