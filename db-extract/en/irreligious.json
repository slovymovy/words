                "senses": [
                    {
                        "sense_id": "acde37db-aeb6-3533-9887-92abf7026c34",
                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                        "glosses": [
                            "Having no relation to religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0695aadc-ad58-43fa-ba95-8039f56a4ff1",
                                "sense_id": "acde37db-aeb6-3533-9887-92abf7026c34",
                                "text": "(not the same, just as \"not black\" or \"not female\" does not equal \"anti-black\" or \"anti-female\")"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5a482b9-5df8-36a6-a69a-b1e3a6840e7b",
                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                        "glosses": [
                            "Contrary to religious beliefs and practices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d30ec7-92ad-40b2-b980-c03811fbecb4",
                                "sense_id": "a5a482b9-5df8-36a6-a69a-b1e3a6840e7b",
                                "text": "[T]he virtuous reader may condemn her for showing too great regard to a base-born infant, to which all charity is condemned by law as irreligious […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1b26515-62fe-3365-b5f7-d53b2eae3a14",
                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                        "glosses": [
                            "Contrary to religious beliefs and practices.",
                            "In conscious rejection of religion."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26214d5b-eaab-48c8-8983-89635890720e",
                        "source_entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                        "source_sense_description": "contrary to religious beliefs and practices",
                        "target_lang_word": "irréligieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irréligieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d24925a1-05b6-37e9-96ce-030841f73bf1",
                                        "entry_id": "51b2995d-09b1-3b2b-84e1-39854584a7a4",
                                        "glosses": [
                                            "Qui n’est pas religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574ef8de-b4d8-48d0-bb43-ade8be2098cf",
                                                "sense_id": "d24925a1-05b6-37e9-96ce-030841f73bf1",
                                                "text": "La Marquise.– Je m’accuse de mouvements de colère, de doutes irréligieux et injurieux pour notre saint-père le pape."
                                            },
                                            {
                                                "example_id": "a5e6ae54-6d06-4f7d-9cce-31bb0434d362",
                                                "sense_id": "d24925a1-05b6-37e9-96ce-030841f73bf1",
                                                "text": "Elle comptait que la France, témoin attristé des méfaits d’un gouvernement sectaire, saisirait avec empressement l’occasion de lui signifier qu’elle en avait assez de sa politique irréligieuse et qu’elle allait châtier par son bulletin de vote les attentats journellement perpétrés contre le Dieu de ses pères."
                                            },
                                            {
                                                "example_id": "f733c2ea-4667-474c-99d4-7bd70beccddb",
                                                "sense_id": "d24925a1-05b6-37e9-96ce-030841f73bf1",
                                                "text": "Anticlérical pour faire échec à la puissance toujours indiscrète du curé, irréligieux parce que la perspective d’une vie éternelle l’écœurait."
                                            },
                                            {
                                                "example_id": "b080aa54-bbb1-4036-93d4-fb9b878c2f19",
                                                "sense_id": "d24925a1-05b6-37e9-96ce-030841f73bf1",
                                                "text": "Ce chevalier-là, ce vieil homme qui en savait bien plus que ceux du Cercle des Dix, plus que der Führer lui-même, cet Allemand chenu au bon visage, baignant dans les profondeurs d’un cynisme irréligieux dont il n’avait, depuis la mort de ses trois fils, jamais fait part à quiconque, cet homme considéra les femmes de sa congrégation avec une pitié qui n’avait rien d’allemand, ni de mâle, loin s’en fallait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff4b8f3-cc1b-3db4-b159-1857e554908a",
                                        "entry_id": "51b2995d-09b1-3b2b-84e1-39854584a7a4",
                                        "glosses": [
                                            "Qui n’a pas trait à la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0599ec74-1eae-4eac-92f2-b0489e9cfcce",
                                                "sense_id": "7ff4b8f3-cc1b-3db4-b159-1857e554908a",
                                                "text": "Le degré d’intégration à un univers religieux ou irréligieux modifie-t-il toujours les attitudes politiques, économiques et sociales"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
