                ],
                "senses": [
                    {
                        "sense_id": "23de18ca-5573-3c80-bd70-197ccf22354b",
                        "entry_id": "53390ca8-f4b2-31ff-93e0-a43a178e864e",
                        "glosses": [
                            "Form des Passivs, die einen Zustand, etwas, das sich nicht verändert, beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b34dca-14cc-457f-92df-b010849b59ce",
                                "sense_id": "23de18ca-5573-3c80-bd70-197ccf22354b",
                                "text": "„Der Satz Das Fenster ist gestrichen kann als Zustandspassiv analog zu Das Fenster wird gestrichen (Vorgangspassiv) gelesen werden.“"
                            },
                            {
                                "example_id": "3c9c8263-c481-4098-bd4c-2fcee843f632",
                                "sense_id": "23de18ca-5573-3c80-bd70-197ccf22354b",
                                "text": "„Die Verwendung des Vorgangspassivs (VP) und des Zustandpassivs (ZP) im Deutschen stellt eine bedeutende Fehlerquelle im Deutschunterricht mit tschechischen Lernerinnen und Lernern dar.“"
                            },
                            {
                                "example_id": "6edd8cfd-dc27-4508-8dac-78b36cfbccfb",
                                "sense_id": "23de18ca-5573-3c80-bd70-197ccf22354b",
                                "text": "„Das Zustandspassiv ist: täterabgewandt und nicht vorgangsorientiert; der Täter darf bei vielen Verben nicht genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
