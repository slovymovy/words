        "nl-extract.jsonl": [
            {
                "entry_id": "434c2387-b2ab-3f04-abfd-a091849eb96a",
                "word": "afbeulen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db8c3935-0a42-3aff-8031-72e78ec359c6",
                        "entry_id": "434c2387-b2ab-3f04-abfd-a091849eb96a",
                        "glosses": [
                            "heel hard laten werken tot het niet meer gaat"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5fe40111-69e7-42ee-8670-f64b9387dcf0",
                                "sense_id": "db8c3935-0a42-3aff-8031-72e78ec359c6",
                                "text": "Michels zelf deed vrijwel nooit de ‘keeperstraining’: een keeper in recordtijd afbeulen. Stuy veroordeelt dat beulswerk: ‘Iedere trainer kan een keeper binnen vijf minuten zoek spelen. Maar dat is onzin. In een wedstrijd krijg je ook niet tien schoten binnen een minuut."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ae11df0-6c77-3b87-abc7-c6e772aae976",
                        "entry_id": "434c2387-b2ab-3f04-abfd-a091849eb96a",
                        "glosses": [
                            "heel hard werken"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c81e28e-dc7d-49e0-b5f1-3592f845fcf4",
                                "sense_id": "8ae11df0-6c77-3b87-abc7-c6e772aae976",
                                "text": "Als de leiders in de wedstrijd op 80 procent van hun race zitten en het begint te miezeren in Drenthe, haalt de jury Yu uit de wedstrijd. Zo zijn eenmaal de regels, de organisatie heeft geen mededogen met een Japanner die al tien jaar op eigen kosten vanuit Japan naar België reist en zich daar aangekomen vaak machteloos laat afbeulen door soms tien jaar jongere gasten. Om zich na de wedstrijd zonder zich te douchen in een oude camper naar Vlaanderen te laten rijden."
                            }
                        ]
                    }
                ],
