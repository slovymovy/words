                "senses": [
                    {
                        "sense_id": "87d83470-a7b8-30f4-9b21-8c5f955f923c",
                        "entry_id": "addc609b-fb58-38b5-9e64-9d2b61416c89",
                        "glosses": [
                            "geen baan hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d0a0c0-c182-4a02-94bb-e93d997c5d1e",
                                "sense_id": "87d83470-a7b8-30f4-9b21-8c5f955f923c",
                                "text": "Hoog niveau: Voorzitter Bob Hoogendoorn van het Koninklijk Nederlands Geologisch-Mijnbouwkundig Genootschap (KNGMG) valt hem bij. \"Er is echt geen werkloze afgestudeerde op dit moment. Er is enorm veel vraag naar.\" Bovendien is de kwaliteit van het onderwijs en onderzoek aan de VU van wereldniveau, benadrukt hij. Niet goedkoop weliswaar, mede door het veldwerk, maar wel erg goed."
                            }
                        ]
                    },
                    {
                        "sense_id": "d72cd171-3529-31d1-9196-9eb2ff816f96",
                        "entry_id": "addc609b-fb58-38b5-9e64-9d2b61416c89",
                        "glosses": [
                            "werkeloos, niets doend, niets verrichtend, niet werkend"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3848fc60-7f49-4895-a1d4-4c534aa0aa05",
                        "source_entry_id": "addc609b-fb58-38b5-9e64-9d2b61416c89",
                        "target_lang_word": "arbeitslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arbeitslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                        "entry_id": "d241fd42-34f5-3cd4-b70a-6007fcc057dc",
                                        "glosses": [
                                            "ohne Erwerbseinkommen, ohne Arbeit, keine Arbeit habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd055a2-7862-40f9-9237-20628dda0ecf",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "Viele Leute sind in den letzten Jahren arbeitslos geworden."
                                            },
                                            {
                                                "example_id": "15648abf-9a9d-4f30-beef-3443c3cacf6f",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "„Die Anzahl der arbeitslosen Jugendlichen in Europa ist schlicht nicht akzeptabel!“"
                                            },
                                            {
                                                "example_id": "23ad3807-3601-4a26-b771-18f80cc41c1c",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "Der Diakon und Sozialarbeiter Michael Heinisch […] gründet den sozialdiakonischen Verein SozDia. Arbeitslose Jugendliche werden zu Maurern und Tischlern ausgebildet, ein Mietshaus nach dem anderen wird professionell saniert."
                                            },
                                            {
                                                "example_id": "0700cf0a-b6fe-425d-b377-1693bf96dcd1",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "[…] Und die Tendenz geht weiter nach oben. Nach Berechnungen der Weltarbeitsorganisation werden in fünf Jahren schon 218 Millionen Menschen auf der Erde arbeitslos sein."
                                            },
                                            {
                                                "example_id": "3c8de127-a3df-44d0-9ee0-1cc979093846",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "Die Jobcenter müssen nicht jeden Einzelfall prüfen, wenn sie arbeitslosen EU-Bürgern die [Sozial-]Leisungen streichen."
                                            },
                                            {
                                                "example_id": "a565e569-5665-4cc3-a672-38ceb90509b4",
                                                "sense_id": "c7071ca3-b46b-3593-8c9c-b5627db36709",
                                                "text": "In den Armengruben um die polnische Industriestadt Waldenburg fördern Tausende von arbeitslosen Bergleuten unter Lebensgefahr Kohle wie im 17. Jahrhundert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9522b3e9-35ff-4050-9565-3bc6c1a26d2c",
                        "source_entry_id": "addc609b-fb58-38b5-9e64-9d2b61416c89",
                        "target_lang_word": "unemployed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unemployed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                        "entry_id": "f9f378dd-1b8f-397c-b4c2-05461b3cccc9",
                                        "glosses": [
                                            "Having no job despite being able and willing to work."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab9ccf8-9d4b-4650-8627-7ac1992ee397",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "The government announced a new initiative to help the unemployed."
                                            },
                                            {
                                                "example_id": "2e140983-f6fd-4a55-a958-a2b75704a21f",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "The number of unemployed keeps rising steadily."
                                            },
                                            {
                                                "example_id": "700cbf7d-25e6-424b-8c3d-0c3a3d1361c2",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "Several special types of unemployed workers are described. These include nonmodal workers, threshold workers, \"the unemployables\", and the physically handicapped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8746edd8-149a-3156-be59-9b0e62655b7f",
                                        "entry_id": "f9f378dd-1b8f-397c-b4c2-05461b3cccc9",
                                        "glosses": [
                                            "Having no use, not doing work"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c1bf9d-c867-481f-b979-30da10b64586",
                                                "sense_id": "8746edd8-149a-3156-be59-9b0e62655b7f",
                                                "text": "England's attacking impetus was limited to one shot from Lampard that was comfortably collected by keeper Iker Casillas, but for all Spain's domination of the ball his England counterpart Joe Hart was unemployed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unemployed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80603858-47b5-3cf0-9e16-25358999cd61",
                                        "entry_id": "e10b1419-7679-39c9-90f2-5deba229ab84",
                                        "glosses": [
                                            "The unemployed people of a society or the world, taken collectively."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfc1cc47-ead1-456d-9b44-c27c3babcbbf",
                        "source_entry_id": "addc609b-fb58-38b5-9e64-9d2b61416c89",
                        "target_lang_word": "jobless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jobless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb1e29a-1d60-3da1-a722-f9f74ebf4ddb",
                                        "entry_id": "f8d1d315-9349-34ca-9377-e2436c8a7194",
                                        "glosses": [
                                            "Lacking employment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0300f8a0-f48d-489c-95ae-1f575818eefc",
                                                "sense_id": "cbb1e29a-1d60-3da1-a722-f9f74ebf4ddb",
                                                "text": "a jobless man"
                                            },
                                            {
                                                "example_id": "d572f752-6503-4f98-9015-4e83169c452b",
                                                "sense_id": "cbb1e29a-1d60-3da1-a722-f9f74ebf4ddb",
                                                "text": "The government announced a new initiative to help the jobless."
                                            },
                                            {
                                                "example_id": "c37f1e46-3915-485e-aada-e3e788a06b1f",
                                                "sense_id": "cbb1e29a-1d60-3da1-a722-f9f74ebf4ddb",
                                                "text": "The report was slightly gloomier than in June, when unemployment rates eased in more than half of all U.S. states for a third straight month and only five states reported jobless rate increases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "072e18b6-e677-39be-8a7a-9b29f1d4fbef",
                                        "entry_id": "f8d1d315-9349-34ca-9377-e2436c8a7194",
                                        "glosses": [
                                            "Having too much time on one's hands; having nothing better to do."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "817742f6-89b7-4d1c-a863-db52b6f8d3d7",
                                                "sense_id": "072e18b6-e677-39be-8a7a-9b29f1d4fbef",
                                                "text": "― I’m showing him our texts with her, the liar.\n― Bro, that is so jobless!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
