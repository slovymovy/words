{
    "word_family": [
        "танковый",
        "танкист",
        "танковый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c5b925f-188a-36ef-bd18-ccb00021e460",
                    "sense_definition": "Боевая бронированная машина на гусеничном ходу, обладающая высокой проходимостью и мощным вооружением.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "military_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На поле боя появился тяжёлый <w>танк</w> противника.",
                            "target_lang_translations": {
                                "en": "A heavy enemy <w>tank</w> appeared on the battlefield."
                            }
                        },
                        {
                            "text": "Экипаж быстро занял свои места в <w>танк</w>е перед началом атаки.",
                            "target_lang_translations": {
                                "en": "The crew quickly took their places in the <w>tank</w> before the attack began."
                            }
                        }
                    ],
                    "common_phrases": [
                        "боевой танк",
                        "тяжёлый танк"
                    ],
                    "target_lang_definitions": {
                        "en": "An armored military vehicle that moves on caterpillar tracks and is equipped with a cannon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tank",
                                "target_lang_sense_clarification": "military armored vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f950a05-3e43-3be0-b52e-a484e65aec0a",
                    "sense_definition": "Большой резервуар или ёмкость для хранения жидкостей или газов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На заводе установили новый <w>танк</w> для хранения топлива.",
                            "target_lang_translations": {
                                "en": "A new <w>tank</w> for fuel storage was installed at the factory."
                            }
                        },
                        {
                            "text": "Рабочие начали очистку <w>танк</w>а от остатков химических веществ.",
                            "target_lang_translations": {
                                "en": "Workers began cleaning the <w>tank</w> of chemical residues."
                            }
                        }
                    ],
                    "synonyms": [
                        "цистерна"
                    ],
                    "common_phrases": [
                        "топливный танк"
                    ],
                    "target_lang_definitions": {
                        "en": "A large container or reservoir used for storing liquids or gases."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tank",
                                "target_lang_sense_clarification": "container for liquids or gases"
                            },
                            {
                                "target_lang_word": "cistern",
                                "target_lang_sense_clarification": "a tank for storing water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2feaabac-4b3d-3462-a2da-e086d4003014",
                    "sense_definition": "Игровой персонаж, чья основная задача — принимать на себя основной урон от противников.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>танк</w> должен стоять впереди и защищать лекарей.",
                            "target_lang_translations": {
                                "en": "Our <w>tank</w> must stand in front and protect the healers."
                            }
                        },
                        {
                            "text": "Без хорошего <w>танк</w>а команда не сможет победить босса.",
                            "target_lang_translations": {
                                "en": "Without a good <w>tank</w>, the team will not be able to defeat the boss."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "используется в контексте компьютерных игр"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A character in a video game whose primary role is to absorb damage and protect teammates."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tank",
                                "target_lang_sense_clarification": "gaming character role"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "80d5f18a-13ae-3e29-8936-5c0152225d38",
                    "sense_definition": "Город в Пакистане, административный центр одноимённого округа.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Город <w>Танк</w> расположен в провинции Хайбер-Пахтунхва.",
                            "target_lang_translations": {
                                "en": "The city of <w>Tank</w> is located in the Khyber Pakhtunkhwa province."
                            }
                        },
                        {
                            "text": "Многие жители региона часто посещают <w>Танк</w> по торговым делам.",
                            "target_lang_translations": {
                                "en": "Many residents of the region often visit <w>Tank</w> for trade purposes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A city in Pakistan, serving as the administrative center of the district of the same name."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Tank",
                                "target_lang_sense_clarification": "geographical location"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}