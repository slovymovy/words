                "senses": [
                    {
                        "sense_id": "d0b9181a-32a7-3167-aac4-8f6229ea6672",
                        "entry_id": "096703c1-62b4-3081-a705-54425fd4f1c0",
                        "glosses": [
                            "Faire porter l'accent sur la dernière syllabe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5e2deb-25f7-427d-a5dd-dbb4e001c216",
                                "sense_id": "d0b9181a-32a7-3167-aac4-8f6229ea6672",
                                "text": "Ainsi, le français oxytonise la dernière syllabe des mots qu'il emprunte ;"
                            },
                            {
                                "example_id": "a4529367-9c6a-487a-b660-096c59b9e426",
                                "sense_id": "d0b9181a-32a7-3167-aac4-8f6229ea6672",
                                "text": "le français en effet ne connaît pas l'accent spécifique d'un mot, il fait porter toujours celui-ci sur la syllabe finale en situation normale; on dit qu'il « oxytonise » les mots."
                            }
                        ]
                    }
