                                            {
                                                "example_id": "2e8bf0b7-62cd-47aa-a387-968964e03077",
                                                "sense_id": "1a65e6ec-5adc-367f-979e-2f75833c09b3",
                                                "text": "Seine Taten spiegelten einen boshaften Menschen wider."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f8b57cfc-1e44-3b20-838c-a273344acb27",
