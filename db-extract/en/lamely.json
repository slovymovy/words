                        "glosses": [
                            "In a foolish or ineffective way."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9858e1fa-d04d-4e50-80ca-8d74c08aea76",
                                "sense_id": "f31a82e9-52e7-3504-b9b1-dcb3b19964bf",
                                "text": "He lamely tried to lie his way out of the situation, but he wasn't really trying and no-one believed him."
                            },
                            {
                                "example_id": "ca9109d4-c9b2-4020-8603-248c2577ce53",
                                "sense_id": "f31a82e9-52e7-3504-b9b1-dcb3b19964bf",
                                "text": "\"I quite admire cats,\" he said. \"There is something about them,\" he added, \"which...\" He could not find the words. \"Which is quite admirable,\" he ended lamely."
                            }
                        ]
                    }
