                "senses": [
                    {
                        "sense_id": "c48d3bfa-1414-330b-8c5a-e983f4a885a5",
                        "entry_id": "806d212b-50b1-33b9-b67d-a0360a8b6d1d",
                        "glosses": [
                            "digitaler Gegenschlag nach einem Cyber- beziehungsweise Hackerangriff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bfe1ff-6d35-4ca1-8c8a-8447cf89c899",
                                "sense_id": "c48d3bfa-1414-330b-8c5a-e983f4a885a5",
                                "text": "„Die Cybertruppe der Bundeswehr könnte im Fall eines Hackerangriffs auf deutsche Rechner und Netze mit einem sogenannten Hackback zurückschlagen.“"
                            },
                            {
                                "example_id": "ccea2afa-5bcc-40c9-b13c-cce1c40f4800",
                                "sense_id": "c48d3bfa-1414-330b-8c5a-e983f4a885a5",
                                "text": "„Zitis soll die Werkzeuge und Schwachstellen bereitstellen, die dann von den Behörden genutzt werden, um Cyber-Angriffe wie Hackbacks auszuführen. Sie selbst hat keine operativen Befugnisse und es ist auch noch unklar, welche Behörde in Deutschland überhaupt Hackbacks durchführen können soll.“"
                            },
                            {
                                "example_id": "5e9951d1-b6bb-4c2e-8876-abcbefa4a285",
                                "sense_id": "c48d3bfa-1414-330b-8c5a-e983f4a885a5",
                                "text": "„Befürworter des Hackbacks gehen allerdings ohnehin davon aus, dass für die Möglichkeit zum ‚Hackback‘ das Grundgesetz geändert werden muss.“"
                            },
                            {
                                "example_id": "90111088-61ba-4790-be2d-d8df37bbb676",
                                "sense_id": "c48d3bfa-1414-330b-8c5a-e983f4a885a5",
                                "text": "„Im Koalitionsvertrag von SPD, Grünen und FDP sind Hackbacks ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
