                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa31970e-1189-4376-bcd5-324f785e621c",
                                                "sense_id": "b7bc72d2-67d4-3e56-bf2e-27c0bd43be65",
                                                "text": "Agathe hat ihren Bruder erschossen."
                                            }
                                        ],
