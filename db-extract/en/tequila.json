                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76498c50-eac7-4acf-9285-0bed7f1b3f77",
                                                "sense_id": "2c81b966-2d71-3254-84ab-3dde71a96dfb",
                                                "text": "Le célèbre cocktail margarita est préparé avec de la téquila, du Cointreau, du jus de citron vert et du sel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbcb24fc-fd6f-4e8d-ba37-c273df1a9fea",
                        "source_entry_id": "ffae017c-0791-30d5-ab26-3aac68984a26",
                        "source_sense_id": "89d15811-4ec8-3212-80e4-69595765652f",
