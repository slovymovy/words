                                        "sense_id": "f76d6389-3924-3702-8aeb-8e41934f7774",
                                        "entry_id": "378b9290-e659-3564-8392-91bdb4426dfe",
                                        "glosses": [
                                            "Action de trépaner ; opération du trépan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8162f7d2-2c02-4fd3-875e-9acc6cdf8443",
                                                "sense_id": "f76d6389-3924-3702-8aeb-8e41934f7774",
                                                "text": "Autrefois, on effectuait des trépanations pour soigner une fracture du crâne ou pour en faire sortir un mauvais esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90dfe35e-c2df-4c38-a965-287ec7b88d93",
                        "source_entry_id": "f1f3c525-eaf9-3fed-a643-e47afb9b868e",
                        "source_sense_id": "1e089502-df82-3b2c-a55e-9507b607413f",
                        "source_sense_description": "practice of drilling a hole in the skull",
                        "target_lang_word": "Trepanation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trepanation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                        "entry_id": "7c062bfe-6eac-3162-be47-bb4f41f4c2bd",
                                        "glosses": [
                                            "operatives Verfahren zur Öffnung des Schädels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0619933b-b10a-4cf4-a286-264c39414489",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Trepanationen dienten vor allem der Behandlung von Kriegsverletzungen, […].“"
                                            },
                                            {
                                                "example_id": "9ab8aeea-6165-4310-b2de-a8133cfe1b02",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Er möchte nämlich eine Trepanation durchführen und mit dem Skalpell eine bestimmte Partie des rechten Gehirnlappens einritzen.“"
                                            },
                                            {
                                                "example_id": "140185e5-6a6b-479d-9edf-0e6cbdcda35e",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Meist waren die Schädel der Menschen künstlich deformiert und mehrere zeigten die Spuren von Trepanationen, wie die Öffnung des Schädels bezeichnet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
