                "senses": [
                    {
                        "sense_id": "db930536-3733-35ec-bf0b-ca42b0584022",
                        "entry_id": "6c1a5393-30fd-366e-9a38-5a38172e6a07",
                        "glosses": [
                            "Teil der nördlichen Voralpen im österreichischen Bundesland Vorarlberg"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "3423905d-192f-465c-bfae-c827950cfe0f",
                                "sense_id": "db930536-3733-35ec-bf0b-ca42b0584022",
                                "text": "Die Dokumentation zeigt die Schönheit und Vielfalt der Region, von schroffen Gebirgen bis hin zu romantischen Tälern, und lädt dazu ein, den Bregenzerwald selbst zu entdecken."
                            },
                            {
                                "example_id": "6732b577-4613-459d-baee-b6e53dd6198d",
                                "sense_id": "db930536-3733-35ec-bf0b-ca42b0584022",
                                "text": "Viele Gäste kombinieren auch Besuche der Bregenzer Festspiele – bekannt für ihre spektakulären Operninszenierungen auf der Seebühne – mit einem Urlaub im Bregenzerwald."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
