                                        "glosses": [
                                            "Partaking in idolatry; worshipping idols or false gods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7379d0a-7112-49ab-af19-cecc625767de",
                                                "sense_id": "d01ceff3-4c84-30d5-a441-179f7c5820f6",
                                                "text": "the priests of an idolatrous religion"
                                            },
                                            {
                                                "example_id": "0ea42e65-9cd5-4594-b664-73ffd6b1dd73",
                                                "sense_id": "d01ceff3-4c84-30d5-a441-179f7c5820f6",
                                                "text": "Once Robert Smellie found her in a ruinous kirk on the Lang Muir, where of old the idolatrous rites of Rome were practiced."
                                            }
