                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74221d57-f525-45a7-8546-a2bf7d528463",
                                                "sense_id": "486d1c5c-669e-31ab-a675-5add7bbdc720",
                                                "text": "La calcinose circonscrite se présente sous la forme d’une zone focale de calcification dystrophique surgissant sur des sites de traumatismes répétés ou anciens."
                                            },
                                            {
                                                "example_id": "e6bbc0a6-1134-4db9-8e29-2ae8b8ac4012",
                                                "sense_id": "486d1c5c-669e-31ab-a675-5add7bbdc720",
                                                "text": "Un diagnostic de calcinose circonscrite par pénétration transcutanée de chlorure de calcium fut proposé."
                                            }
