                ],
                "senses": [
                    {
                        "sense_id": "6f628e44-6f18-3295-a141-8885ddcfef1b",
                        "entry_id": "c1a7b893-8e2b-3f9f-a865-96c2dca6662d",
                        "glosses": [
                            "ein kleines Deck seitlich der Kommandobrücke (eines größeren Motorschiffes)"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "e0d51b6a-71ec-4a11-9e2d-a141cb5e8cae",
                                "sense_id": "6f628e44-6f18-3295-a141-8885ddcfef1b",
                                "text": "Aus der Nock heraus hat man eine gute Rundumsicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28e9f2f4-29ac-3ebb-b80c-61a459ae75dd",
                        "entry_id": "c1a7b893-8e2b-3f9f-a865-96c2dca6662d",
                        "glosses": [
                            "äußeres Ende einer Spiere, eines Rundholzes (an dem zum Beispiel die Segel eines Segelschiffs befestigt sind)"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "956d85cf-57c1-4f54-8501-303e80283ab7",
                                "sense_id": "28e9f2f4-29ac-3ebb-b80c-61a459ae75dd",
                                "text": "„Sie sind aber nicht mit der Nock verbunden, sondern laufen über 2 Blöcke von dort weiter zu den Schiffsseiten herab.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
