        "fr-extract.jsonl": [
            {
                "entry_id": "dfd8ae31-e6a3-3bd9-b4a1-2a1ae7e93d84",
                "word": "rhétoriquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06a0dbe4-5398-3349-bbd0-2095a067d460",
                        "entry_id": "dfd8ae31-e6a3-3bd9-b4a1-2a1ae7e93d84",
                        "glosses": [
                            "Avec le caractère de la rhétorique, en rhétoricien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8378d300-a493-40fc-bad1-219594121031",
                                "sense_id": "06a0dbe4-5398-3349-bbd0-2095a067d460",
                                "text": "Les anciens faisaient parler politiquement, et les modernes rhétoriquement."
                            },
                            {
                                "example_id": "9d66d714-ca77-4f89-a443-9409e7961ba1",
                                "sense_id": "06a0dbe4-5398-3349-bbd0-2095a067d460",
                                "text": "Et je ne subtiliserais nullement en vous disant que cette page de pure expansion est écrite d'un bout à l'autre sur ce mode rhétoriquement appelé sublime, - depuis les lignes jaillissantes qui le traversent l'idée qui s'éclaire à mesure qu'elle arrive à son sommet jusqu à l'inimitable tête de Christ […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35385553-f089-44b4-a1d1-6da24cbbc2d6",
                        "source_entry_id": "dfd8ae31-e6a3-3bd9-b4a1-2a1ae7e93d84",
                        "source_sense_id": "06a0dbe4-5398-3349-bbd0-2095a067d460",
                        "target_lang_word": "rhetorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhetorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29caca54-6a57-3824-b997-7ae837eaa507",
                                        "entry_id": "89e5b931-7da2-3aec-95ad-0bec4dedaeec",
                                        "glosses": [
                                            "auf die Fähigkeit zu reden bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e31fcbc-24c2-47c5-ad36-e96c6716e1c3",
                                                "sense_id": "29caca54-6a57-3824-b997-7ae837eaa507",
                                                "text": "Er hat sich mit seinen rhetorischen Mitteln gut aus der Affaire gezogen."
                                            },
                                            {
                                                "example_id": "d3139bef-d628-4b89-97eb-ba13dab967dc",
                                                "sense_id": "29caca54-6a57-3824-b997-7ae837eaa507",
                                                "text": "„Nach der rhetorischen Glanzleistung des Präsidenten folgte ein Schwall blecherner patriotischer Phrasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c446575-6554-344c-acc7-50b754da3740",
                                        "entry_id": "89e5b931-7da2-3aec-95ad-0bec4dedaeec",
                                        "glosses": [
                                            "auf die Rhetorik bezogen"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de1f285-3c9c-4121-a44d-c420ebe9eb4d",
                                                "sense_id": "2c446575-6554-344c-acc7-50b754da3740",
                                                "text": "Die Klimax ist ein rhetorisches Mittel, um Zuhörer zu beeinflussen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                        "entry_id": "89e5b931-7da2-3aec-95ad-0bec4dedaeec",
                                        "glosses": [
                                            "in der Verbindung rhetorische Frage: nicht ernst gemeint"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa053da5-b3f4-493b-9404-560d49005c44",
                                                "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                                "text": "Eine Frage wird dann als rhetorisch aufgefasst, wenn man unterstellt, dass sie nicht wirklich als Frage gemeint war."
                                            },
                                            {
                                                "example_id": "f5b03d4c-7bfd-4888-b036-b4306cb435e6",
                                                "sense_id": "822eb898-5796-3a5e-958b-5362e4e2edab",
                                                "text": "Ich nehme mal an, das war jetzt eine rein rhetorische Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
