                        "target_lang_word": "administratif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administratif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                        "entry_id": "fa01b34c-4eda-316e-973c-8d093d9deb36",
                                        "glosses": [
                                            "Relatif à l’administration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71dd14a2-4a52-4171-b4ab-78a3d28d9d99",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "Auguste Comte avait fabriqué une caricature du catholicisme, dans laquelle il n’avait conservé que la défroque administrative, policière et hiérarchique de cette Église."
                                            },
                                            {
                                                "example_id": "f64c3329-41e6-42ee-ba9f-255c5a192993",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "Le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes."
                                            },
                                            {
                                                "example_id": "490bdc3c-efd6-40d0-b9a8-dd0df24095fc",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "La véritable foi transporte les montagnes, mais, à cause de cela, elle ne saurait être transportée elle-même, par simple décret administratif, dans l’âme de l’incroyant..."
                                            },
                                            {
                                                "example_id": "792e497a-8615-478a-9f76-f0336f589eae",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "Mais la technocratie administrative est cousine germaine de celle qui « pantoufle » au service du grand capital."
                                            },
                                            {
                                                "example_id": "457a935d-b746-45c1-a896-029ceef4ef44",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "Plus de la moitié de ces hauts salaires sont des cadres administratifs ou commerciaux : leur poids parmi les très hauts salaires s’est accru de 8 points en 10 ans."
                                            },
                                            {
                                                "example_id": "3f55f079-075b-496c-a1b2-742121a060f8",
                                                "sense_id": "2c56afc8-061a-3183-8eb4-ed5f8b0a22a9",
                                                "text": "Les changements à répétition des règles débouchent sur des imbroglios administratifs et juridiques inextricables et l’illégalité ouvre la porte à tous les trafics, mafias et répressions policières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "administratif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "053fa50b-1501-34a2-a450-6223a8c19447",
                                        "entry_id": "05c8d7cd-c052-321b-a266-3f1dce7d936a",
                                        "glosses": [
                                            "Employé d’une administration."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631a32cf-98f6-4d86-8ab3-8998843fc4c5",
                                                "sense_id": "053fa50b-1501-34a2-a450-6223a8c19447",
                                                "text": "Son reportage plein d’affabulations décrivait de faux héros opposés à des administratifs tatillons et avides de pouvoirs."
                                            },
                                            {
                                                "example_id": "ea088e86-6e9e-4dc1-be7e-35416ea15338",
                                                "sense_id": "053fa50b-1501-34a2-a450-6223a8c19447",
                                                "text": "À midi seize, les rares employés qui travaillaient ce jour-là quittèrent l’hôtel de ville puis ce fut le tour des « administratifs » de l’hôtel de police."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
