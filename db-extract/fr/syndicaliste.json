                "forms": [
                    {
                        "form_id": "40a82ba7-72a5-42f9-938c-f37e8dbced67",
                        "entry_id": "380c87c1-de36-31c8-936b-9776e2cc4987",
                        "tags": [
                            "plural",
                            "masculine",
