                "senses": [
                    {
                        "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                        "entry_id": "11f10931-9ef2-35af-8f3c-58ee7ae4964f",
                        "glosses": [
                            "der Zustand, frei von Gerüchen zu sein beziehungsweise keine Geruchswahrnehmung vorzuweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e3eb23-e7cd-4b50-8587-6ff8e9305612",
                                "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                                "text": "„Kostentragung für die Beseitigung der Geruchsbelästigung durch austretende Fomaldehydgase aus gelieferten Spanplatten; Rechtzeitige Rüge als Voraussetzung für die Geltendmachung von Gewährleistungsansprüchen; Voraussetzungen für das Vorliegen einer wirksamen Zusicherung der Geruchsfreiheit von Spanplatten; Beschränkte Nachprüfbarkeit von Individualerklärungen in der Revisionsinstanz.“"
                            },
                            {
                                "example_id": "d47f70f5-d5b0-421a-9f44-bd77ad6e4dcd",
                                "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                                "text": "„Ein einfaches Abluftsystem sorgt für die völlige Geruchsfreiheit auch bei intensiver Benutzung, der Urin wird über eine spezielle Tasse aufgefangen und mit 1/8 Liter Spülwasser in einem Kanister gesammelt und periodisch in der Natur ausgebracht.“"
                            },
                            {
                                "example_id": "406e213d-a724-44b8-ba7f-57849e5dadff",
                                "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                                "text": "„Die Spülung leistet einen wichtigen Beitrag zur Geruchsfreiheit und Hygiene eines Schulklos.“"
                            },
                            {
                                "example_id": "c7a9b0cf-d46b-4611-a4e1-99d4b9944d95",
                                "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                                "text": "„Die weitgehende Geruchsfreiheit ist dabei aber nur ein, wenn auch sicher sehr positiver Nebeneffekt.“"
                            },
                            {
                                "example_id": "40fea684-8104-4ca9-ae6f-d0b6ba300e8e",
                                "sense_id": "eb5ba059-ade7-3934-bb3c-276630c499f4",
                                "text": "„Ausgrund seiner Geruchsfreiheit wird das Holz für Obst- oder Gemüsekisten benutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
