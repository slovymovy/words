                                        "glosses": [
                                            "Any of the large cosmopolitan carnivorous eels of the family Muraenidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f696afdc-b7e4-431f-aee5-919808dfb533",
                        "source_entry_id": "2f046704-9b6f-36b9-9c5b-01b32eb5843c",
