                ],
                "senses": [
                    {
                        "sense_id": "70e040f0-1196-3d84-a3e2-7b8552779722",
                        "entry_id": "ed45b0c7-f466-3d88-b325-70c15667c854",
                        "glosses": [
                            "Petite baie, crique, parfois profonde et entourée de terres élevées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e91fc56-cbaf-432b-bd99-f7781883f481",
                                "sense_id": "70e040f0-1196-3d84-a3e2-7b8552779722",
                                "text": "Presque aussitôt nous nous glissâmes dans une calanque, large à peine de quelques mètres et si profonde qu’elle paraissait un trait de scie dans la masse du plateau."
                            },
                            {
                                "example_id": "1d2fcfdb-3620-41f6-8c24-b9a10528fce4",
                                "sense_id": "70e040f0-1196-3d84-a3e2-7b8552779722",
                                "text": "En ombres chinoises sur le feu d’artifice chromatique d’un couchant somptueux, ils descendaient à présent sans se presser, par le chemin côtier qui mène à la calanque de Callelongue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cba993fd-20a6-4155-b66d-67d33a6e1b1c",
                        "source_entry_id": "ed45b0c7-f466-3d88-b325-70c15667c854",
                        "source_sense_id": "70e040f0-1196-3d84-a3e2-7b8552779722",
                        "target_lang_word": "Calanque",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
