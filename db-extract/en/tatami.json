                "senses": [
                    {
                        "sense_id": "9688c0a1-6de1-3bd5-90e2-adb681cf7e59",
                        "entry_id": "2afcf6c6-9a1f-3fc8-b330-bec350369f88",
                        "glosses": [
                            "Straw matting, in a standard size, used as a floor covering in Japanese houses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cac0a6-699d-4f6d-bc34-51c4e30c374b",
                                "sense_id": "9688c0a1-6de1-3bd5-90e2-adb681cf7e59",
                                "text": "Heny Hankovitch, con guítar, / did a short Zen pray, / on his tatami in a relaxed lotos / fixin his mind on nuffin, rose-blue breasts,"
                            },
                            {
                                "example_id": "19ba2418-23fd-4f52-a73e-85e56bd17bee",
                                "sense_id": "9688c0a1-6de1-3bd5-90e2-adb681cf7e59",
                                "text": "Small tools are spread on the tatami: a razor knife, a sprue cutter, curls of emery paper."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9b66974-2eda-3f91-a7ae-3b34508854d9",
                        "entry_id": "2afcf6c6-9a1f-3fc8-b330-bec350369f88",
                        "glosses": [
                            "A unit of area equal to a standard-sized tatami mat, approximately 1.65 square metres."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a6fc71d-df89-454f-82d9-7bca269f2351",
                        "source_entry_id": "2afcf6c6-9a1f-3fc8-b330-bec350369f88",
                        "source_sense_description": "straw matting in Japanese houses",
                        "target_lang_word": "tatami",
