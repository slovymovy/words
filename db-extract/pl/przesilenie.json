                                "target_senses": [
                                    {
                                        "sense_id": "5e610c74-8309-3bc3-97a7-ef7cce65d750",
                                        "entry_id": "6c8b096e-66e3-397d-9c1a-5a3105a561b2",
                                        "glosses": [
                                            "okamžik, kdy se slunce pomyslně nachází nad obratníkem a nastává nejkratší nebo nejdelší světlá část dne v roce"
