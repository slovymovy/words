                ],
                "senses": [
                    {
                        "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                        "entry_id": "4540bcfb-80ab-3d9e-9580-5e05bddefdf1",
                        "glosses": [
                            "Papier, das aus Altpapier und gebrauchten Kartonagen hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b58209-bf90-4415-a2f6-8cd333187ab3",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Recyclingpapier belastet die Umwelt deutlich weniger als Papier aus frisch gefällten Bäumen.“"
                            },
                            {
                                "example_id": "3f58099b-c91b-4db8-b3f8-6552c20e8f32",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„«Der Verbrauch von Wasser, Holz und Energie ist bei der Produktion von Recyclingpapier deutlich geringer als bei der Herstellung von Frischfaserpapier», so Sabine Stammbach vom WWF.“"
                            },
                            {
                                "example_id": "5051ba29-5e75-4aa8-a1b4-fa737e257e8b",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Seit der 17. Ausgabe wird das Magazin nach eigenen Angaben auf Recyclingpapier gedruckt.“"
                            },
                            {
                                "example_id": "dd0ad91e-8766-49fb-9ba8-19e5a18398b7",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Das Buch hat 208 Seiten und ist auf Recyclingpapier gedruckt.“"
                            },
                            {
                                "example_id": "a7757542-e42b-4112-bba7-61c0a1269eca",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Für fast jeden Papierbedarf gibt es ein passendes Recyclingpapier.“"
                            },
                            {
                                "example_id": "fa352753-15ec-4431-97c5-de626d970949",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Ob für Drucker oder Kopierer, für Klopapier oder Küchenrolle, ob weiß oder bunt: Recyclingpapier kann fast überall bedenkenlos eingesetzt werden.“"
                            },
                            {
                                "example_id": "2f919f11-3575-4092-ac3a-79a604d41360",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Auch die Bundesverwaltung in Berlin setzt ab sofort auf Recyclingpapier und verwendet künftig in allen Bereichen nur noch wiederaufbereitetes Altpapier.“"
                            },
                            {
                                "example_id": "45776271-b245-4486-8c51-58b9202c5908",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„102 Städte nutzen durchschnittlich 89 Prozent Recyclingpapier mit dem Siegel „Blauer Engel“, so die IPR.“"
                            },
                            {
                                "example_id": "012c6ca7-611f-412a-b3db-ea02f3f48c40",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Nur eins von zehn verkauften Schulheften ist aus Recyclingpapier.“"
                            },
                            {
                                "example_id": "429861d8-bf69-4d54-9c5b-9974393a318a",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Klopapier, Küchenrollen und Taschentücher werden mehrheitlich nicht aus Recyclingpapier, sondern aus frischen Holzfasern hergestellt, kritisiert die Umweltschutzorganisation Greenpeace.“"
                            },
                            {
                                "example_id": "7c276b88-806b-45ae-9e5c-d58fd2fa2b1b",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„In den vergangenen Jahren hat sich“ […] „die Qualität des Recyclingpapiers ständig verbessert,“ […]."
                            },
                            {
                                "example_id": "2695d603-0d98-4a98-8498-321fa3f9ddf2",
                                "sense_id": "373fee45-3b11-3f13-bdde-cdd3f95af7c7",
                                "text": "„Greiz ist das einzige Werk des Papierherstellers, wo hochwertiges Recyclingpapier produziert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
