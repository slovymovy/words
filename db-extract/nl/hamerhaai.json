                "senses": [
                    {
                        "sense_id": "dfd77ae3-482d-3a5a-97f4-8ce5b67bc118",
                        "entry_id": "c72af423-7a11-386c-a615-316d696922c6",
                        "glosses": [
                            "benaming voor vissen uit de familie Sphyrnidae, haaien met een T-vormige kop"
                        ],
                        "tags": [
                            "kraakbeenvissen"
                        ],
                        "examples": [
                            {
                                "example_id": "22f5921a-8404-44ba-954c-ee92c3264334",
                                "sense_id": "dfd77ae3-482d-3a5a-97f4-8ce5b67bc118",
                                "text": "Cites is er niet in geslaagd regels op te stellen voor een verbod op de handel in twee bedreigde haaiensoorten. De organisatie die zich bezighoudt met de internationale handel in bedreigde dier- en plantsoorten heeft geprobeerd regels in te voeren voor de hamerhaai en de witpunt-rifhaai."
                            },
                            {
                                "example_id": "87af1078-0583-4b56-af02-efab6a305dd7",
                                "sense_id": "dfd77ae3-482d-3a5a-97f4-8ce5b67bc118",
                                "text": "Kalasjnikov zit dus ook in de drones. Er is een apart paviljoen met onbemande vliegtuigen, helikopters en duikboten. In het midden staat een enorme onderzeeër, die eruit ziet als een hamerhaai. Zo heet de drone ook, de Hammerhead. De toenemende vraag naar drones is een van de gevolgen van de strijd tegen IS."
                            }
                        ]
                    }
