{
    "word_family": [
        "accablant",
        "accablement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f58eaf35-7d97-3eb4-bbba-20d0a9627220",
                    "sense_definition": "Peser lourdement sur quelqu'un au point d'épuiser ses forces physiques ou morales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "epuisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chaleur étouffante finit par <w>accabler</w> tous les ouvriers du chantier."
                        },
                        {
                            "text": "La mauvaise nouvelle risque d'<w>accabler</w> cette famille déjà très éprouvée."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "épuiser",
                        "abattre"
                    ],
                    "antonyms": [
                        "soulager",
                        "revigorer"
                    ],
                    "common_phrases": [
                        "accablé par le chagrin",
                        "accablé par la fatigue"
                    ]
                },
                {
                    "sense_id": "401a993e-08df-346d-a24d-9a7de0c7cc96",
                    "sense_definition": "Faire supporter à quelqu'un une abondance excessive de choses désagréables ou pénibles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surabondance_penible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes continuent d'<w>accabler</w> de questions le ministre à sa sortie."
                        },
                        {
                            "text": "Il ne sert à rien d'<w>accabler</w> un collègue d'insultes après une simple erreur."
                        }
                    ],
                    "synonyms": [
                        "assaillir",
                        "inonder",
                        "submerger"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "accabler de reproches",
                        "accabler de questions",
                        "accabler de dettes"
                    ]
                },
                {
                    "sense_id": "a71fc58d-a204-32e2-b55f-f804b5f7ba09",
                    "sense_definition": "Apporter des preuves ou des témoignages décisifs contre une personne accusée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le procureur a présenté de nouvelles pièces pour <w>accabler</w> le suspect lors de l'audience."
                        },
                        {
                            "text": "Ce témoignage inattendu risque d'<w>accabler</w> l'accusé de manière irrémédiable."
                        }
                    ],
                    "synonyms": [
                        "enfoncer",
                        "charger",
                        "compromettre"
                    ],
                    "antonyms": [
                        "défendre",
                        "blanchir",
                        "disculper"
                    ],
                    "common_phrases": [
                        "témoignage pour accabler"
                    ]
                },
                {
                    "sense_id": "1ee358fa-0305-328f-9ecd-ddb004446cf1",
                    "sense_definition": "Donner à quelqu'un quelque chose de positif avec un excès presque gênant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exces_positif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les critiques aiment <w>accabler</w> ce jeune auteur d'éloges dithyrambiques depuis son succès."
                        },
                        {
                            "text": "Le maire ne cesse d'<w>accabler</w> ses invités d'attentions et de prévenances."
                        }
                    ],
                    "synonyms": [
                        "combler",
                        "couvrir"
                    ],
                    "antonyms": [
                        "priver"
                    ],
                    "common_phrases": [
                        "accabler d'éloges",
                        "accabler de louanges",
                        "accabler d'attentions"
                    ]
                }
            ]
        }
    ]
}