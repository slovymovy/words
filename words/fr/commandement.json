            "senses": [
                {
                    "sense_id": "881318db-6f41-3bf3-a5d0-a8a69d29dc75",
                    "sense_definition": "Pouvoir, autorité ou fonction d'une personne qui dirige, en particulier dans le domaine militaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général a pris le <w>commandement</w> des opérations dès le début de la crise."
                        },
                        {
                            "text": "Ce jeune officier a démontré de remarquables aptitudes au <w>commandement</w> sur le terrain."
                        }
                    ],
                    "synonyms": [
                        "direction",
                        "autorité",
                        "gouvernement"
                    ],
                    "antonyms": [
                        "obéissance",
                        "soumission"
                    ],
                    "common_phrases": [
                        "poste de commandement",
                        "prendre le commandement",
                        "centre de commandement"
                    ]
                },
                {
                    "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                    "sense_definition": "Ordre formel donné par une personne investie d'une autorité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont immédiatement obéi au <w>commandement</w> sans poser la moindre question."
                        },
                        {
                            "text": "Il a refusé d'exécuter ce <w>commandement</w> qu'il jugeait totalement injuste."
                        }
                    ],
                    "synonyms": [
                        "ordre",
                        "injonction",
                        "prescription"
                    ],
                    "common_phrases": [
