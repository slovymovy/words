                "senses": [
                    {
                        "sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                        "entry_id": "cbed2af1-2041-31a6-a8a9-a6ec00eec54b",
                        "glosses": [
                            "республика в составе Российской Федерации, со столицей в Улан-Удэ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf0f692-5753-4356-9b2b-3a54d88de446",
                                "sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                                "text": "Климат Бурятии резко-континентальный."
                            },
                            {
                                "example_id": "aa127aba-2e7d-48eb-8207-8d4652f849fd",
                                "sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                                "text": "Несмотря на статус столицы Бурятии, Улан-Удэ ― городок небольшой, всего 375 тыс. жителей, провинциальный, типично российский, но с азиатской экзотикой."
                            },
                            {
                                "example_id": "7f9c1b92-fd95-4332-8ab8-30b670d3e138",
                                "sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                                "text": "Неслучайно в Иркутском научном центре и в Бурятии работали многие знаменитые учёные-геологи, да и сегодня регулярно отправляются экспедиции в Саяны, на Байкальский хребет и в соседнюю Монголию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cea1771-5088-4ac3-97c8-94a525f6a5d4",
                        "source_entry_id": "cbed2af1-2041-31a6-a8a9-a6ec00eec54b",
                        "source_sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                        "target_lang_word": "Buryatia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buryatia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9538c809-68f2-3e1a-abb6-5ee75b16f745",
                                        "entry_id": "32ec387e-ec23-34e7-8dc8-fdc8b4ce4d00",
                                        "glosses": [
                                            "A republic and federal subject of Russia, bordering Mongolia to the south and Lake Baikal to the west. Capital: Ulan-Ude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e08bf864-2698-48cc-8459-809e7fe4978d",
                        "source_entry_id": "cbed2af1-2041-31a6-a8a9-a6ec00eec54b",
                        "source_sense_id": "6bf1ab0e-1e55-309a-ac62-6890b1d16612",
                        "target_lang_word": "Bouriatie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bouriatie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81b9ca9c-cdff-31af-9a16-7fd76b7b5c2a",
                                        "entry_id": "1d64f0ff-e759-380d-b76a-3e030e2b6ef9",
                                        "glosses": [
                                            "République de la Fédération de Russie, située à proximité du lac Baïkal."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e546c76-e831-4ffc-a220-7aa925683af5",
                                                "sense_id": "81b9ca9c-cdff-31af-9a16-7fd76b7b5c2a",
                                                "text": "Au sein de la Fédération de Russie, deux populations de langues mongoles forment des républiques : en Bouriatie, au sud-est du lac Baïkal, elles parlent bouriate (360 000 locuteurs) ; en Kalmoukie, au sud-ouest de la basse Volga, elles parlent kalmouk (150 000 locuteurs)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
