    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4abd55ce-8e71-3ce3-832c-23b077f0d67a",
                    "sense_definition": "Situated on the inside or belonging to the interior part of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inward</w> structure of the building is made of steel.",
                            "target_lang_translations": {
                                "zh": "这座建筑的<w>内部</w>结构是由钢材制成的。"
                            }
                        },
                        {
                            "text": "He examined the <w>inward</w> mechanism of the clock to find the problem.",
                            "target_lang_translations": {
                                "zh": "他检查了时钟的<w>内部</w>机械装置以找出问题所在。"
                            }
                        }
                    ],
                    "antonyms": [
                        "outward"
                    ],
                    "target_lang_definitions": {
                        "zh": "位于内部的或属于某物内部部分的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "指位于物体或结构内部的。"
                            },
                            {
                                "target_lang_word": "内在的",
                                "target_lang_sense_clarification": "指属于事物本质或内部结构的。"
                            }
                        ]
