                ],
                "senses": [
                    {
                        "sense_id": "bd0bc4cd-57d0-33fa-93e6-91d975871c29",
                        "entry_id": "f19c5d88-a54b-36ad-8e9f-089cfa50a2be",
                        "glosses": [
                            "kostbares Schmuckstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e63f04-820c-497d-a771-588919aa676d",
                                "sense_id": "bd0bc4cd-57d0-33fa-93e6-91d975871c29",
                                "text": "Die Kirche von Hablingbo (schwedisch Hablingbo kyrka) ist eine der größten Kirchen auf der schwedischen Insel Gotland. Sie ist über die Architektur hinaus eine Preziose der Inselgeschichte im südlichen Drittel der Insel …"
                            },
                            {
                                "example_id": "92d1cd14-8761-4dde-b337-147e434d0d4d",
                                "sense_id": "bd0bc4cd-57d0-33fa-93e6-91d975871c29",
                                "text": "„Zur Hälfte verschwinden ihre Konturen im Dunkel der Halle, zur anderen Hälfte vergolden einzelne Sonnenstrahlen, die durch Lücken in den Fensterabdeckungen dringen, die seltsamen Pretiosen.“"
                            },
                            {
                                "example_id": "0182d6a7-8638-4388-9891-3f63d22bdacd",
                                "sense_id": "bd0bc4cd-57d0-33fa-93e6-91d975871c29",
                                "text": "„Auch im sogenannten schwäbischen Troja gehen die Rastauratoren davon aus, dass die frühkeltischen Fürsten viele ihrer fein ziselierten Preziosen bei den Etruskern in Mittelitalien erwarben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
