                "senses": [
                    {
                        "sense_id": "71a04c95-ef4d-30a0-94cb-be3361966513",
                        "entry_id": "432e8be6-9cca-34c2-af97-d3c9a2539d4b",
                        "glosses": [
                            "Illuminated by or as if by twilight; half-lit"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a894a1-e582-45b1-b7c8-903702d939af",
                                "sense_id": "71a04c95-ef4d-30a0-94cb-be3361966513",
                                "text": "He was like someone lying in twilit, formless, preëxistence, and stretching out his hands lovingly towards many-coloured, many-sounding life."
                            },
                            {
                                "example_id": "44f14388-f128-44d1-8d17-7e12d56ccf61",
                                "sense_id": "71a04c95-ef4d-30a0-94cb-be3361966513",
                                "text": "The effect of the closing inside the booths was to turn the line of concessions into a twilit tunnel."
                            }
                        ]
                    }
                ],
