                ],
                "senses": [
                    {
                        "sense_id": "946aa90d-9008-38f6-b50c-355943f93dc5",
                        "entry_id": "2d867a11-cfe0-3647-a72f-080076c7ed72",
                        "glosses": [
                            "Unvergänglichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e36ad93-eb1c-4105-9a84-13803ce0bcb4",
                                "sense_id": "946aa90d-9008-38f6-b50c-355943f93dc5",
                                "text": "„Die individuelle Immortalität der Seele ist bekanntlich das Fundament der christlichen Theologie.“"
                            },
                            {
                                "example_id": "75fa0258-9b61-4f83-adfe-0c303207d139",
                                "sense_id": "946aa90d-9008-38f6-b50c-355943f93dc5",
                                "text": "„Durch symbolische Immortalität werde ich selbst Teil einer Gemeinschaft, die auch über meinen individuellen Tod hinaus Bestand hat.“"
                            },
                            {
                                "example_id": "02f526b5-9508-4008-aedc-6bcd7ab5bc1f",
                                "sense_id": "946aa90d-9008-38f6-b50c-355943f93dc5",
                                "text": "„Sie erreichen replikative Immortalität, können sich also unbegrenzt teilen – eine Eigenschaft, die sonst ausschließlich Stammzellen vorbehalten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
