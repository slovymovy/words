                "senses": [
                    {
                        "sense_id": "12c57ef9-0d14-392f-8a49-b1b4e005cb3b",
                        "entry_id": "5f6f1325-35de-367b-8997-be7068fa22f9",
                        "glosses": [
                            "Wissenschaftler, der sich mit einer Geisteswissenschaft beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbfc25b-ed7f-462b-94d2-eeb96f857250",
                                "sense_id": "12c57ef9-0d14-392f-8a49-b1b4e005cb3b",
                                "text": "Manchmal werden studierte Geisteswissenschaftler arbeitslos."
                            },
                            {
                                "example_id": "db601a60-4ed7-4adc-a7fb-78014a30b35c",
                                "sense_id": "12c57ef9-0d14-392f-8a49-b1b4e005cb3b",
                                "text": "„Redselig beginnt er die nächste Stunde, denn er hat sei dem Aufstehen nur einmal kurz gebrummt und als Geisteswissenschaftler nun enormen Nachholbedarf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
