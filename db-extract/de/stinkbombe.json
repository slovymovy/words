                    {
                        "translation_id": "6c86fd8e-8d0c-4ff5-b9f4-73fb54280006",
                        "source_entry_id": "58558728-4888-3fdd-9b24-56f19422e62d",
                        "source_sense_id": "b9ab1719-2795-3639-98d3-635e481ef27d",
                        "source_sense_description": "ein Gegenstand, durch dessen Einsatz man intensiven Gestank verbreiten kann",
                        "target_lang_word": "boule puante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boule puante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2509cde3-7067-3e2c-bf92-acbfb3594247",
                                        "entry_id": "6dace357-8b79-3fad-86b0-4cccb66ef143",
                                        "glosses": [
                                            "Petite ampoule de verre contenant du sulfure d’hydrogène, qui dégage une odeur nauséabonde quand on la brise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e866bc-36c3-4186-a164-dba3d246bb29",
                                                "sense_id": "2509cde3-7067-3e2c-bf92-acbfb3594247",
                                                "text": "On venait parfois le consulter de bien loin et même de la cour des moyens pour lui demander ce que l’on risquait pour le bris d’un carreau, le lancement d’une boule puante, ou l’explosion d’une bombe japonaise."
                                            },
                                            {
                                                "example_id": "58724343-f7e8-4c29-ba95-1275e75a9311",
                                                "sense_id": "2509cde3-7067-3e2c-bf92-acbfb3594247",
                                                "text": "Pas qu’on soit portés sur la gaudriole, mais rien de ce qui concerne le verre baveur et la boule puante ne nous est étranger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c65036c0-ee5e-388b-b3be-27fd6a9e5b64",
                                        "entry_id": "6dace357-8b79-3fad-86b0-4cccb66ef143",
                                        "glosses": [
                                            "En politique, révélation d’une affaire, souvent diffamatoire, touchant le camp adverse pour le déstabiliser."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aaf4af3-aac8-4f68-a758-2722d112fc87",
                                                "sense_id": "c65036c0-ee5e-388b-b3be-27fd6a9e5b64",
                                                "text": "Ceux qui lancent ces boules puantes finissent par sentir plus mauvais que ceux qui les reçoivent."
                                            },
                                            {
                                                "example_id": "e609d334-c00e-4f54-9f4a-21c0e4b83bb2",
                                                "sense_id": "c65036c0-ee5e-388b-b3be-27fd6a9e5b64",
                                                "text": "On ne fait pas une campagne avec des boules puantes."
                                            },
                                            {
                                                "example_id": "62c4c522-a70b-443e-9cfa-85c442551480",
                                                "sense_id": "c65036c0-ee5e-388b-b3be-27fd6a9e5b64",
                                                "text": "Ce vilain frémissement des narines qui sentent venir les boules puantes et qui se régalent à l’idée de renifler des odeurs d’égouts"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
