                "word": "ungoogelbar",
                "pos": "adj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                        "entry_id": "6c6f7c22-55bf-39f7-902f-d9eb1dc18a9a",
                        "glosses": [
                            "so, dass es nicht gegoogelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348a4267-2946-4a70-809f-692d1ef5c3fd",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Etwas, das „ungoogelbar“ ist, soll also per Definition „mit Google“ nicht zu finden sein.“"
                            },
                            {
                                "example_id": "e1066d98-2526-4022-b482-52942c41ee1f",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Und sind International Music wirklich ungoogelbar? Diese Fragen beantworten International Music im Gespräch mit detektor.fm-Moderatorin Bernadette Huber.“"
                            },
                            {
                                "example_id": "35bbed85-2fd6-440e-b158-c05f8a734af0",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Google protestierte: Googeln sei nur auf Google zu beziehen und dürfe nicht für das Surfen auf anderen Plattformen verwendet werden. Ungooglebar sei nur, was man auf Google nicht findet.“"
                            },
                            {
                                "example_id": "31239240-3234-4ed4-bbac-ede2a2999619",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Ich vermute ja, dass Google nicht mit dem Begriff assoziiert werden wollte; „ungoogelbar“ ist nicht gerade ein Kompliment für die Suchmaschine.“"
                            },
                            {
                                "example_id": "2afc04fc-3db3-41b5-8960-fe1294917b1a",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Wer sich SIND nennt, muss fest daran glauben, dass seine Musik so gut ist, dass sie auch gefunden wird, obwohl man quasi ungoogelbar ist.“"
                            },
                            {
                                "example_id": "6e8caf78-e574-45f7-a9a6-2c4bddbc36c3",
                                "sense_id": "c9d7a54a-9d7f-310c-a45a-db0848637877",
                                "text": "„Kurzum: Was läge näher, als diese Band ganz einfach völlig ungoogelbar „H“ zu nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
