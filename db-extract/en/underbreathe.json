                        "sense_id": "66f3668c-efd6-3946-9b08-0aaf05a1bca7",
                        "entry_id": "0fc7f94f-6a85-334a-89ad-fb14ce7d9efb",
                        "glosses": [
                            "To hypoventilate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e86f39ee-5cfb-48e0-8b5f-d87fc502bd50",
                                "sense_id": "66f3668c-efd6-3946-9b08-0aaf05a1bca7",
                                "text": "Buteyko believed that teaching people with asthma to underbreathe could raise their carbon dioxide levels and dilate their airways without medication."
                            },
                            {
                                "example_id": "ad0c4c21-542c-4be2-856d-a49acb54c347",
                                "sense_id": "66f3668c-efd6-3946-9b08-0aaf05a1bca7",
                                "text": "Traumatized clients who tend to underbreathe (hypoventilate) or overbreathe (hyperventilate) can benefit from this chapter."
                            },
                            {
                                "example_id": "122ee3aa-ee9e-47c8-842f-3f3497d2e19e",
                                "sense_id": "66f3668c-efd6-3946-9b08-0aaf05a1bca7",
                                "text": "But, 30 percent of obese patients don't respond to this increased drive; their breathing muscles become fatigued and they underbreathe."
                            }
                        ]
                    }
