                        ],
                        "examples": [
                            {
                                "example_id": "654887d3-cc61-4607-b3d9-66d0d236cb16",
                                "sense_id": "6edee721-c3ef-3218-8a99-90f6ca93f4be",
                                "text": "Michalina ma szajbę na punkcie czystości."
                            },
                            {
