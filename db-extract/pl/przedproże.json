                "senses": [
                    {
                        "sense_id": "e4883b63-221f-3c7d-8b49-89084a6412c3",
                        "entry_id": "b5b9a8db-bd94-3a02-9c2d-b24d89fbc5a0",
                        "glosses": [
                            "taras poprzedzający wejście do budynku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad839663-1ef2-4809-af04-919f162c5da3",
                                "sense_id": "e4883b63-221f-3c7d-8b49-89084a6412c3",
                                "text": "Przedproża to typowe elementy gdańskich kamienic"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "413ab867-531d-4a46-86fb-8610ca84a46e",
                        "source_entry_id": "b5b9a8db-bd94-3a02-9c2d-b24d89fbc5a0",
                        "source_sense_id": "e4883b63-221f-3c7d-8b49-89084a6412c3",
                        "target_lang_word": "stoop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd842b0-9796-35ae-9b89-f19094382bd8",
                                        "entry_id": "695d2ea1-47d0-3d89-9b40-8eb26bf12b32",
                                        "glosses": [
                                            "A stooping, bent position of the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26e2e0d-9e55-4e11-a868-39bf9f49d19c",
                                                "sense_id": "1fd842b0-9796-35ae-9b89-f19094382bd8",
                                                "text": "The old man walked with a stoop."
                                            },
                                            {
                                                "example_id": "030bb349-07c5-4a49-b2ed-2d289b00b34a",
                                                "sense_id": "1fd842b0-9796-35ae-9b89-f19094382bd8",
                                                "text": "Theo Walcott's final pass has often drawn criticism but there could be no complaint in the 11th minute when his perfect delivery to the far post only required a stoop and a nod of the head from Young to put England ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc94459-3666-31a6-9b98-b433117d000c",
                                        "entry_id": "695d2ea1-47d0-3d89-9b40-8eb26bf12b32",
                                        "glosses": [
                                            "An accelerated descent in flight, as that for an attack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec73d13a-d8c4-4a5f-ba84-794340acc0e2",
                                                "sense_id": "dcc94459-3666-31a6-9b98-b433117d000c",
                                                "text": "At length the hawk got the upper hand, and made a rushing stoop at her quarry"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b4a4eb-9ec3-3c15-ac23-d97e73dd3903",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To bend the upper part of the body forward and downward to a half-squatting position; crouch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef0eb75-c313-4cc1-9f87-bae236570a49",
                                                "sense_id": "48b4a4eb-9ec3-3c15-ac23-d97e73dd3903",
                                                "text": "Their walk had continued not more than ten minutes when they crossed a creek by a wooden bridge and came to a row of mean houses standing flush with the street. At the door of one, an old black woman had stooped to lift a large basket, piled high with laundered clothes."
                                            },
                                            {
                                                "example_id": "9bef199a-4216-4e96-87fc-156db0f8d376",
                                                "sense_id": "48b4a4eb-9ec3-3c15-ac23-d97e73dd3903",
                                                "text": "Pedersen took a short corner and El-Hadji Diouf was given time to send in a cross for Mame Diouf to stoop and head home from close range."
                                            },
                                            {
                                                "example_id": "891a7edf-1030-4965-b5b7-e152c7c915ad",
                                                "sense_id": "48b4a4eb-9ec3-3c15-ac23-d97e73dd3903",
                                                "text": "He stooped to tie his shoe-laces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a958900-7792-3473-8986-b64900f99342",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To lower oneself; to demean oneself in doing something below one's status, standards, or morals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9111a353-3773-4489-948a-4a8a37b54a77",
                                                "sense_id": "8a958900-7792-3473-8986-b64900f99342",
                                                "text": "Can you believe that a salesman would stoop so low as to hide his customers' car keys until they agreed to the purchase?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0f5904-c7c6-3537-9c49-2d099c7d5b2f",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "Of a bird of prey: to swoop down on its prey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb6ede5-2871-4600-87e0-abfe90af482b",
                                                "sense_id": "ad0f5904-c7c6-3537-9c49-2d099c7d5b2f",
                                                "text": "the holy eagle\nStoop'd, as to foote vs: his Ascension is\nMore sweet then our blest Fields"
                                            },
                                            {
                                                "example_id": "847ae6a7-3709-46e8-92db-682832431d93",
                                                "sense_id": "ad0f5904-c7c6-3537-9c49-2d099c7d5b2f",
                                                "text": "Presently the bird stooped and seized a salmon, and a violent struggle ensued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2af1497-f8f9-3a14-b1ad-657c1fa85713",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To cause to incline downward; to slant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c672fa-efd9-4ef2-9cf0-91992c1b6c9b",
                                                "sense_id": "b2af1497-f8f9-3a14-b1ad-657c1fa85713",
                                                "text": "to stoop a cask of liquor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1055796-961d-373a-990f-4ae045631a4f",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To cause to submit; to prostrate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ee469a-f31c-48a0-b0a9-268fe1d9bb64",
                                                "sense_id": "a1055796-961d-373a-990f-4ae045631a4f",
                                                "text": "Many of those whose states so tempt thine ears / Are stoopt by death; and many left alive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d881442-512d-3740-866a-09e27958cb98",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To yield; to submit; to bend, as by compulsion; to assume a position of humility or subjection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd0a91f-98c3-4b84-9f52-5982c459230b",
                                                "sense_id": "5d881442-512d-3740-866a-09e27958cb98",
                                                "text": "The grasse stoops not, she treads on it so light"
                                            },
                                            {
                                                "example_id": "94f7b84b-ba9e-4a8b-ab26-2322fb3b0b00",
                                                "sense_id": "5d881442-512d-3740-866a-09e27958cb98",
                                                "text": "Mighty in her ships stood Carthage long, […] / Yet stooped to Rome, less wealthy, but more strong."
                                            },
                                            {
                                                "example_id": "77025b97-cb91-420f-999e-63facad6b3c1",
                                                "sense_id": "5d881442-512d-3740-866a-09e27958cb98",
                                                "text": "Theſe, theſe are Arts, my Prince, / In which your Zama does not ſtoop to Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae78aa1-24bf-3f11-b3c5-6e73154e8b09",
                                        "entry_id": "2cf75102-a672-3021-a0ef-a4131f4057e5",
                                        "glosses": [
                                            "To descend from rank or dignity; to condescend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13389a98-5c3b-42c2-acb2-0000d5aa39b7",
                                                "sense_id": "8ae78aa1-24bf-3f11-b3c5-6e73154e8b09",
                                                "text": "Where men of great wealth do stoop to husbandry, it multiplieth riches exceedingly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33914a22-c4ff-370c-8ca7-cfbdc221d34d",
                                        "entry_id": "89726741-b6b9-3e4d-a351-6360a82432be",
                                        "glosses": [
                                            "A vessel for holding liquids; like a flagon but without the spout."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e58637f6-17c7-3ce3-8137-c898cee8135f",
                                        "entry_id": "17cd01b1-97e5-3554-87f4-937de0231edf",
                                        "glosses": [
                                            "The staircase and landing or porch leading to the entrance of a residence."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "New-Jersey",
                                            "New-York",
                                            "also"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40371579-2241-4553-ae61-418c86d1f3e5",
                                                "sense_id": "e58637f6-17c7-3ce3-8137-c898cee8135f",
                                                "text": "Nearly all the houses were built with their gables to the streets and each had heavy wooden Dutch stoops, with seats, at its door."
                                            },
                                            {
                                                "example_id": "86b6c1b2-a29d-45b9-8e93-08fce178c616",
                                                "sense_id": "e58637f6-17c7-3ce3-8137-c898cee8135f",
                                                "text": "...the entrance being at the side of the house and reached by a low front stoop with four or five risers..."
                                            },
                                            {
                                                "example_id": "5c7bc121-54ed-472a-b127-c30c2a266868",
                                                "sense_id": "e58637f6-17c7-3ce3-8137-c898cee8135f",
                                                "text": "The guard at the door coughed up blood, and died instantly. Fina was carrying an empty rifle with a sharpened bayonet, and she'd thrust it straight up through his neck, severing the spinal cord. She levered him off the front stoop and into the bushes, then stood up on the tips of her toes to peer through the window in the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                                        "entry_id": "17cd01b1-97e5-3554-87f4-937de0231edf",
                                        "glosses": [
                                            "The threshold of a doorway; a doorstep."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f9a1e9-f654-4853-9ea9-4b9e378df527",
                                                "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                                                "text": "A short flight of iron steps leads up to it and a storm door is built over the stoop, forming a little vestibule, and serving to keep out the gusts."
                                            },
                                            {
                                                "example_id": "6d86aaf2-e1b2-472b-a99a-a0775ab6926d",
                                                "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                                                "text": "You better hurry up and get strong, if you going to carry me across the stoop."
                                            },
                                            {
                                                "example_id": "61531ef9-5287-4125-86c1-aedad4562b37",
                                                "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                                                "text": "Holding her breath while she set one foot over the stoop and followed it up into the house"
                                            },
                                            {
                                                "example_id": "5fc17720-00c1-4cd5-84d8-42ca668f5040",
                                                "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                                                "text": "She grins at me and lifts her walker over the stoop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoop",
                                "target_lang_code": "en",
                                "target_senses": [
