                "senses": [
                    {
                        "sense_id": "17a22eb3-61c0-3bc0-b068-9eeeb888de66",
                        "entry_id": "2a28cf4d-bd63-334b-bdea-7dc4a77fd423",
                        "glosses": [
                            "Esprit ou démon qui possède le corps d’un individu."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "acee7396-438d-448e-bc96-ef57441c4412",
                                "sense_id": "17a22eb3-61c0-3bc0-b068-9eeeb888de66",
                                "text": "Celle-ci est incarnée littérairement par sa mère, que l’écrivain transfigure en une sorte de figure de dibbouk qui se serait emparée de sa personnalité."
                            },
                            {
                                "example_id": "ca34501b-d4c2-4af6-b8f7-998d06580ef8",
                                "sense_id": "17a22eb3-61c0-3bc0-b068-9eeeb888de66",
                                "text": "– C’est bizarre ce que je vais te dire… Mais parfois j’ai l’impression qu’une force invisible me pousse…\n– Tes dibbouks ? m’a demandé Georges le lendemain, à l’heure du déjeuner."
                            },
                            {
                                "example_id": "a6b72b0e-62fb-47df-9333-c115ae1fd5cd",
                                "sense_id": "17a22eb3-61c0-3bc0-b068-9eeeb888de66",
                                "text": "Pendant le trajet, j’ai repensé aux dibbouks, dont Georges m’avait parlé, ces esprits troublés qui entrent dans les corps des gens pour vivre à travers eux des histoires aussi puissantes qu’invisibles – et retrouver ainsi la sensation d’êtres vivants."
                            }
                        ]
                    }
                ],
