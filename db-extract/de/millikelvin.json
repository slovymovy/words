                "senses": [
                    {
                        "sense_id": "2c5ddedb-11bd-3fab-822c-23c7e675748f",
                        "entry_id": "7f951019-057f-34d1-90fe-35fb9a8ed37e",
                        "glosses": [
                            "ein tausendstel Kelvin"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "05df7390-7789-472a-9694-7e684d390971",
                                "sense_id": "2c5ddedb-11bd-3fab-822c-23c7e675748f",
                                "text": "„Während sie zuschauten, fiel die Temperatur auf der Anzeige auf 10, dann auf 9, bis sie schließlich bei 8,5 Millikelvin stehen blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93047e45-5442-47d8-beba-f0616522eb76",
                        "source_entry_id": "7f951019-057f-34d1-90fe-35fb9a8ed37e",
                        "source_sense_id": "2c5ddedb-11bd-3fab-822c-23c7e675748f",
                        "source_sense_description": "ein tausendstel Kelvin",
                        "target_lang_word": "millikelvin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millikelvin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c45fb2e4-81ab-3085-a467-07b03d5c5105",
                                        "entry_id": "9f26e44b-5ba2-3605-9d82-445686f6a6a0",
                                        "glosses": [
                                            "One thousandth of a kelvin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d6a012c-5d35-4e32-ba55-debde921dd14",
                                                "sense_id": "c45fb2e4-81ab-3085-a467-07b03d5c5105",
                                                "text": "ILT's device cools samples to several millikelvins, cold enough to freeze helium."
                                            },
                                            {
                                                "example_id": "11829512-4c7d-472d-9c81-ca2032d2fdae",
                                                "sense_id": "c45fb2e4-81ab-3085-a467-07b03d5c5105",
                                                "text": "This zero-bias maximum disappears as temperature is raised above several hundred millikelvin, in agreement with theory ( 8 ): Because V sd is equal to the separation between the Fermi levels of the two leads, finite V sd splits the Kondo resonance into two peaks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "millikelvin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                        "entry_id": "f1becdfd-fd4a-37aa-8de4-d22f1be5dd74",
                                        "glosses": [
                                            "Of or relating to the temperature range at which temperatures are expressed in millikelvins"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d6a93e-9c1c-42b8-8b76-8a005e948c75",
                                                "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                                "text": "The temperatures required for producing a crystalline solid out of such a \"one-component plasma\" (3) are in the millikelvin range."
                                            },
                                            {
                                                "example_id": "41d76c8f-4ec2-42cb-963b-f4df3a75c650",
                                                "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                                "text": "These results imply that DNA molecules can be conducting down to millikelvin temperature and that phase coherence is maintained over several hundred nanometers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "584f7a3d-36cd-49a8-b717-bd69008ee401",
                        "source_entry_id": "7f951019-057f-34d1-90fe-35fb9a8ed37e",
                        "source_sense_id": "2c5ddedb-11bd-3fab-822c-23c7e675748f",
                        "source_sense_description": "ein tausendstel Kelvin",
                        "target_lang_word": "millikelvin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millikelvin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7a1998-d72b-3f61-8fe9-c6bcdf739b33",
                                        "entry_id": "64a042ae-1e53-38d0-8eb4-c2bbc9b67fea",
                                        "glosses": [
                                            "Unité de mesure de température du Système international (SI), valant 10⁻³ kelvin, et dont le symbole est mK."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2994c410-e996-4f98-9130-41a77a11a1e0",
                                                "sense_id": "cd7a1998-d72b-3f61-8fe9-c6bcdf739b33",
                                                "text": "Signalons d’emblée qu’on n'est plus ici dans le domaine de quelques kelvins où se situent la superfluidité de l’hélium 4 et la supraconductivité, mais bien plutôt dans la région du millikelvin."
                                            }
                                        ]
                                    }
                                ]
