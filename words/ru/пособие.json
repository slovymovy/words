    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8498f45f-2729-3578-af75-bc12365e5250",
                    "sense_definition": "Денежная помощь, выплачиваемая государством или организацией в определённых случаях (например, по безработице или уходу за ребёнком).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После потери работы он сразу оформил <w>пособие</w> по безработице.",
                            "target_lang_translations": {
                                "en": "After losing his job, he immediately applied for unemployment <w>benefit</w>.",
                                "de": "Nach dem Verlust der Arbeit beantragte er sofort <w>Arbeitslosengeld</w>."
                            }
                        },
                        {
                            "text": "Молодая семья получает ежемесячное <w>пособие</w> на ребёнка.",
                            "target_lang_translations": {
                                "en": "The young family receives a monthly child <w>allowance</w>.",
                                "de": "Die junge Familie bezieht monatlich <w>Kindergeld</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "субсидия"
                    ],
                    "common_phrases": [
                        "пособие по безработице",
                        "детское пособие",
                        "выходное пособие",
                        "социальное пособие"
                    ],
                    "target_lang_definitions": {
                        "en": "Financial assistance provided by the state or an organization in specific cases (e.g., for unemployment or child care).",
                        "de": "Finanzielle Unterstützung, die vom Staat oder einer Organisation in bestimmten Fällen gezahlt wird (z. B. bei Arbeitslosigkeit oder zur Kinderbetreuung)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "benefit",
                                "target_lang_sense_clarification": "payment from the government or insurance"
                            },
                            {
                                "target_lang_word": "allowance",
                                "target_lang_sense_clarification": "regular financial payment"
                            },
                            {
                                "target_lang_word": "welfare",
                                "target_lang_sense_clarification": "government financial support"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Beihilfe",
                                "target_lang_sense_clarification": "finanzielle Unterstützung"
                            },
                            {
                                "target_lang_word": "die Unterstützung",
                                "target_lang_sense_clarification": "Geldleistung des Staates"
                            },
                            {
                                "target_lang_word": "das Geld",
                                "target_lang_sense_clarification": "z. B. Arbeitslosengeld, Kindergeld"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb4516c5-98e3-30f6-832a-965127c0a474",
                    "sense_definition": "Книга, справочник или наглядный материал, помогающие в изучении какого-либо предмета.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Профессор рекомендовал студентам купить новое учебное <w>пособие</w> по истории.",
                            "target_lang_translations": {
                                "en": "The professor recommended that the students buy a new history <w>study guide</w>.",
                                "de": "Der Professor empfahl den Studenten, ein neues <w>Lehrbuch</w> für Geschichte zu kaufen."
                            }
                        },
                        {
                            "text": "На стене висело наглядное <w>пособие</w>, объясняющее строение солнечной системы.",
                            "target_lang_translations": {
                                "en": "On the wall hung a visual <w>aid</w> explaining the structure of the solar system.",
                                "de": "An der Wand hing ein <w>Anschauungsmaterial</w>, das den Aufbau des Sonnensystems erklärte."
                            }
                        }
                    ],
                    "synonyms": [
                        "учебник"
                    ],
                    "common_phrases": [
                        "учебное пособие",
                        "наглядное пособие",
                        "методическое пособие"
                    ],
                    "target_lang_definitions": {
                        "en": "A book, reference guide, or visual material that assists in learning a subject.",
                        "de": "Buch, Nachschlagewerk oder Anschauungsmaterial, das beim Erlernen eines Fachs oder Themas hilft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manual",
                                "target_lang_sense_clarification": "instructional book"
                            },
                            {
                                "target_lang_word": "aid",
                                "target_lang_sense_clarification": "visual or teaching material"
                            },
                            {
                                "target_lang_word": "study guide",
                                "target_lang_sense_clarification": "educational reference book"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Lehrbuch",
                                "target_lang_sense_clarification": "Buch zum Lernen oder Unterrichten"
                            },
                            {
                                "target_lang_word": "das Lehrmittel",
                                "target_lang_sense_clarification": "Unterrichts- oder Anschauungsmaterial"
                            },
                            {
                                "target_lang_word": "der Leitfaden",
                                "target_lang_sense_clarification": "systematische Einführung oder Anleitung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b69c94c3-bb40-3e32-8585-fa062b4015fb",
                    "sense_definition": "Содействие, помощь или поддержка в каком-либо деле.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При деятельном <w>пособии</w> друзей он смог быстро построить дом.",
                            "target_lang_translations": {
                                "en": "With the active <w>assistance</w> of friends, he was able to build the house quickly.",
                                "de": "Mit der tatkräftigen <w>Unterstützung</w> seiner Freunde konnte er das Haus schnell bauen."
                            }
                        },
                        {
                            "text": "Врач оказал пострадавшему необходимое медицинское <w>пособие</w> прямо на улице.",
                            "target_lang_translations": {
                                "en": "The doctor provided the necessary medical <w>aid</w> to the victim right on the street.",
                                "de": "Der Arzt leistete dem Verletzten direkt auf der Straße die notwendige medizinische <w>Hilfe</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "помощь",
                        "поддержка"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Assistance, help, or support in a particular endeavor.",
                        "de": "Mitwirkung, Hilfe oder Beistand bei einer Angelegenheit (veraltet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assistance",
                                "target_lang_sense_clarification": "formal help or support"
                            },
