    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "167f14e5-fb5d-3ed4-9f81-944aeb80c686",
                    "sense_definition": "het begin van een bepaalde periode of tijdstip",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een nieuw tijdperk <w>breekt</w> nu <w>aan</w> voor de hele bevolking.",
                            "target_lang_translations": {
                                "en": "A new era is now <w>dawning</w> for the entire population."
                            }
                        },
                        {
                            "text": "De jagers vonden het lijk vlak voor het <w>aanbreken</w> van de dag.",
                            "target_lang_translations": {
                                "en": "The hunters found the body just before the <w>break</w> of day."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de dag breekt aan",
                        "een nieuw tijdperk aanbreken",
                        "bij het aanbreken van"
                    ],
                    "target_lang_definitions": {
                        "en": "the beginning of a specific period or point in time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dawn",
                                "target_lang_sense_clarification": "to begin to appear or happen"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "to arrive (specifically of day or morning)"
                            },
                            {
                                "target_lang_word": "begin",
                                "target_lang_sense_clarification": "to start a new phase"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64983b71-79d5-3f38-a4c1-8eba74cc9826",
                    "sense_definition": "iets voor de eerste keer openen om het te gaan gebruiken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "openen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben een nieuwe fles wijn <w>aangebroken</w> om het goede nieuws te vieren.",
                            "target_lang_translations": {
                                "en": "We <w>opened</w> a new bottle of wine to celebrate the good news."
                            }
                        },
                        {
                            "text": "Zij hebben de andere voorraad gelukkig nog niet <w>aangebroken</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, they haven't <w>broken into</w> the other stock yet."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanspreken"
                    ],
                    "common_phrases": [
                        "een fles aanbreken",
                        "de voorraad aanbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to open something for the first time in order to start using it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break into",
                                "target_lang_sense_clarification": "to start using a supply or stock"
                            },
                            {
                                "target_lang_word": "open",
                                "target_lang_sense_clarification": "to unseal a container for use"
                            },
                            {
                                "target_lang_word": "tap into",
                                "target_lang_sense_clarification": "to begin using a resource or reserve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fae13ca3-0d7c-34ea-999b-bdc418382dc3",
                    "sense_definition": "met geweld of stormenderhand naderen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aanvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vijandelijke troepen <w>braken</w> met grote snelheid <w>aan</w> op de vesting.",
                            "target_lang_translations": {
                                "en": "The enemy troops <w>advanced</w> on the fortress with great speed."
                            }
                        },
                        {
                            "text": "Het leger <w>brak</w> onverwachts <w>aan</w> tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The army <w>charged</w> unexpectedly during the storm."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis komt zelden voor in modern Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
