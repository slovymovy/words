                "senses": [
                    {
                        "sense_id": "3a774e2b-5ebd-3f51-a9aa-a5c07f3c096a",
                        "entry_id": "75d2d212-1510-3c90-b7d9-7ef560ca61dd",
                        "glosses": [
                            "hemp fibre (for making into cloth or rope)"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "804c3d21-c2ff-4061-97e4-98265009f3fd",
                                "sense_id": "3a774e2b-5ebd-3f51-a9aa-a5c07f3c096a",
                                "text": "— Пра́во, я всё не приберу́, как мне быть; лу́чше я вам пеньку́ прода́м.\n— Да что ж пенька́? Поми́луйте, я вас прошу́ совсе́м о друго́м, а вы мне пеньку́ суёте! Пенька́ пенько́ю, в друго́й раз прие́ду, заберу́ и пеньку́. Так как же, Наста́сья Петро́вна?",
                                "translation": "'I really can't make up my mind what to do; I had really better sell you my hemp.'\n'Hemp! Upon my soul, I asked you about something quite different and you foist hemp upon me. Hemp is hemp, another time I'll come and take your hemp, too. So how is it to be, Nastasya Petrovna?'",
                                "english": "'I really can't make up my mind what to do; I had really better sell you my hemp.'\n'Hemp! Upon my soul, I asked you about something quite different and you foist hemp upon me. Hemp is hemp, another time I'll come and take your hemp, too. So how is it to be, Nastasya Petrovna?'"
                            }
                        ]
                    }
