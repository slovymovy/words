                                        "entry_id": "7ce6d218-2a71-31cd-8811-7743cbbc746b",
                                        "glosses": [
                                            "Not relevant to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f2501f2-941c-4898-90bf-59d85448bfca",
                                                "sense_id": "2be0f260-c541-3911-953e-2ecd5242c7a0",
                                                "text": "That is beside the point / beside the topic / beside the subject / beside the focus of this discussion."
                                            },
                                            {
                                                "example_id": "f6e87731-9ea5-4c57-8747-d40150055209",
