                        "sense_id": "58210234-ffe2-3ab0-ac3c-74bd14700890",
                        "entry_id": "0066339f-1c65-3673-b1ae-b258aeb33269",
                        "glosses": [
                            "the herbaceous plant verbena (Verbena officinalis), or the herb derived from this plant"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b4970132-d958-41b5-bfa1-c4b9302374f1",
                                "sense_id": "58210234-ffe2-3ab0-ac3c-74bd14700890",
                                "text": "Naast de uiteenlopende bladvormen zijn ook de vijf kroonbladen […] duidelijke kenmerken van ijzerhard.",
                                "translation": "Besides the varying leaf shapes, the five petals […] are also salient features of verbena.",
                                "english": "Besides the varying leaf shapes, the five petals […] are also salient features of verbena."
                            },
                            {
                                "example_id": "279c319f-956b-4b8a-b9ca-526e20728d5b",
                                "sense_id": "58210234-ffe2-3ab0-ac3c-74bd14700890",
                                "text": "Er kwamen takjes tevoorschijn van een plant, met lange groene bladen en piepkleine lila bloemetjes. \"Dit is ijzerhard, verse ijzerhard,\" zei hij zacht, met een rustige, indringende stem.",
                                "translation": "Small sprigs of a plant came out, with long green leaves and tiny lilac flowers. \"This is verbena, fresh verbena,\" he said softly, with a quiet, intense voice.",
                                "english": "Small sprigs of a plant came out, with long green leaves and tiny lilac flowers. \"This is verbena, fresh verbena,\" he said softly, with a quiet, intense voice."
                            }
                        ]
                    }
