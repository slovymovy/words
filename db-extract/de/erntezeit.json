                    },
                    {
                        "translation_id": "b22961d8-217e-4be7-9d4e-ff0f9d6f396c",
                        "source_entry_id": "86b8a579-941c-3ba6-92bc-e7fc8bd51e81",
                        "source_sense_id": "ab8570ce-b09b-36e7-bda3-f7c09518dcfa",
                        "source_sense_description": "Zeitraum, in der etwas geerntet werden kann",
                        "target_lang_word": "страда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "страда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb469df-252c-3bd9-b208-aed02c66fd28",
                                        "entry_id": "6fa38bcc-0beb-3e8e-9272-3e57cdbc1d66",
                                        "glosses": [
                                            "напряжённая летняя работа во время косьбы, жатвы и уборки хлеба"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca3a8b4-8cd3-48d1-88aa-f7cb60f8b4d3",
                                                "sense_id": "5fb469df-252c-3bd9-b208-aed02c66fd28",
                                                "text": "И прошло его шестилетнее служение в судейской камере, как для трудолюбивого пахаря дни летней страды."
                                            },
                                            {
                                                "example_id": "bb1985b3-76ba-4574-94ae-a0edea514ca5",
                                                "sense_id": "5fb469df-252c-3bd9-b208-aed02c66fd28",
                                                "text": "В полном разгаре страда деревенская… // Доля ты! — русская долюшка женская!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01727dcc-42e5-36a5-8ddf-23564defeba1",
                                        "entry_id": "6fa38bcc-0beb-3e8e-9272-3e57cdbc1d66",
                                        "glosses": [
                                            "период такой работы; время жатвы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7612558d-7d98-402f-9921-5546fd0e62bb",
                                                "sense_id": "01727dcc-42e5-36a5-8ddf-23564defeba1",
                                                "text": "Летом, в страду, он гнал нас всех на покос и давал там по литовке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9120922-82a5-3f08-9ba6-a15b03e0c5f9",
                                        "entry_id": "6fa38bcc-0beb-3e8e-9272-3e57cdbc1d66",
                                        "glosses": [
                                            "перен. тяжёлый, напряжённый труд, приуроченный к ограниченному, определённому отрезку времени, сезону, поре́"
                                        ],
                                        "tags": [
                                            "обыч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b16a4c-6f78-49db-aa3e-025e669ce03f",
                                                "sense_id": "a9120922-82a5-3f08-9ba6-a15b03e0c5f9",
                                                "text": "Был ли он занят чем, метался ли, подобно угорелому, справляя какую-нибудь домашнюю страду, но, лишь только обращался к нему с просьбою сход, он бросал всё и шёл на сход."
                                            },
                                            {
                                                "example_id": "c84bacbf-3ab3-40ed-9534-db636f34f23e",
                                                "sense_id": "a9120922-82a5-3f08-9ba6-a15b03e0c5f9",
                                                "text": "Земледелие само по себе, когда составляет исключительный предмет занятий целой страны, по существу дела приучает к «страде», к труду порывистому, к отдыху многие месяцы после немногих трудных недель."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d214b42-2f96-3f68-9b49-b1ba081ecdaf",
                                        "entry_id": "6fa38bcc-0beb-3e8e-9272-3e57cdbc1d66",
                                        "glosses": [
                                            "перен. период такого труда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb3f66e-dbb5-45ab-899a-416615e8b1bf",
                                                "sense_id": "0d214b42-2f96-3f68-9b49-b1ba081ecdaf",
                                                "text": "Наступила масленица — страда артистов. Спектакли шли утром и вечером."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75600cd4-b4bf-3ba2-816f-7c17d69a6fd5",
                                        "entry_id": "6fa38bcc-0beb-3e8e-9272-3e57cdbc1d66",
                                        "glosses": [
                                            "нар.-поэт. страдание, мучение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd8ef388-8dfb-4281-9bd6-f4a3bfde1d87",
                                                "sense_id": "75600cd4-b4bf-3ba2-816f-7c17d69a6fd5",
                                                "text": "Оставит меня с тяжким горем на слёзы и страду!.."
                                            },
                                            {
                                                "example_id": "d302ad10-e64b-4efb-8f64-a628e5442f2f",
                                                "sense_id": "75600cd4-b4bf-3ba2-816f-7c17d69a6fd5",
                                                "text": "Плачем и рыдаем, на страды взираем — Сокати святый дух царствовать на землю!.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
