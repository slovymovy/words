                    {
                        "sense_id": "5d62f8fc-b2ed-3540-9b71-c1fed8bb290c",
                        "entry_id": "cdae6138-88a7-3313-9501-621334214bd3",
                        "glosses": [
                            "żołnierz lekkiej piechoty, przeznaczonej do zwiadów, potyczek czy wreszcie zadań strzelców wyborowych, rekrutowanej pierwotnie z myśliwych, gajowych i leśników"
                        ],
