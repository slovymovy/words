                                        "glosses": [
                                            "A country in Southeast Asia. Official name: Kingdom of Thailand. Capital: Bangkok. Former name: Siam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbbfd290-93be-4412-9ebc-bdcb6c49b6f6",
                                                "sense_id": "f20c71e6-9532-3385-ae3c-807fe901801a",
                                                "text": "Are you from Thailand? I got you soup from Thailand!"
                                            },
                                            {
                                                "example_id": "8e57a38c-32ce-4729-8a3f-0e17af1463d2",
                                                "sense_id": "f20c71e6-9532-3385-ae3c-807fe901801a",
                                                "text": "Bangkok typically sees temperatures between 73 and 91 degrees Fahrenheit (23 to 33 degrees Celsius) during January, according to the Tourism Authority of Thailand – one reason why it’s a paradise for many tourists looking to escape winter in the northern hemisphere."
                                            }
                                        ]
                                    },
