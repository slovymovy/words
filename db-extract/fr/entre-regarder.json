                ],
                "senses": [
                    {
                        "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                        "entry_id": "e3d8d31b-785d-37f6-a5b7-3f66d537d2e2",
                        "glosses": [
                            "Se regarder mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea87f2fe-7b69-4b1f-a5a9-1ea8a3b86d0a",
                                "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                                "text": "Le roi promena son regard sur le groupe des femmes qui pâlissaient en s’entre-regardant."
                            },
                            {
                                "example_id": "cb3304f3-fee5-48c2-a6b9-c8689d3b7a81",
                                "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                                "text": "En voyant venir les Anglais, les chiens et les gens du roi s’entre-regardèrent en se demandant ainsi sans dire un mot :…."
                            },
                            {
                                "example_id": "8ceed373-b162-4616-98b8-b36c2a9bc66c",
                                "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                                "text": "Buttant contre l’étui de contrebasse, ils s’entre-regardèrent, étonnés, les bras ballants."
                            },
                            {
                                "example_id": "b9386b73-07b7-4ec0-aa9a-2a51a408a4d7",
                                "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                                "text": "S’il avait osé parler librement à Honoré, il lui aurait dit que des enfants de bonne famille ne jouent pas à s’entre-regarder l’intérieur des cuisses, comme faisaient Gustave et Clotilde."
                            },
                            {
                                "example_id": "e95f036e-b83a-46fa-ab74-cbb991542fac",
                                "sense_id": "ddf18ec7-15ef-396e-95a0-3eaeb97c1e7f",
                                "text": "Tous, nous faisions silence, et, nous entre-regardant, nous attendions."
                            }
                        ]
                    }
                ],
