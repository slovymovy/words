                ],
                "senses": [
                    {
                        "sense_id": "777b8aa7-8f39-3e6d-96d5-8d421dcd2756",
                        "entry_id": "ca08e385-587d-3df5-916c-c80cb10d9e5c",
                        "glosses": [
                            "Provoquer un nouveau traumatisme chez (quelqu’un) qui était déjà traumatisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f230afe-b511-4216-85d1-60c5c993ff52",
                                "sense_id": "777b8aa7-8f39-3e6d-96d5-8d421dcd2756",
                                "text": "Dans le coffret il y aurait un truc viril, histoire de ne pas surtraumatiser le garçon : un hot-dog, par exemple."
                            },
                            {
                                "example_id": "abb42058-5ac9-480b-ad39-bf7151eacef9",
                                "sense_id": "777b8aa7-8f39-3e6d-96d5-8d421dcd2756",
                                "text": "Face à un timide maladif il faut faire preuve de retenue pour ne pas le surtraumatiser."
                            },
                            {
                                "example_id": "089a643b-ec00-4384-83f7-8cc7e165ba6f",
                                "sense_id": "777b8aa7-8f39-3e6d-96d5-8d421dcd2756",
                                "text": "Il s’agit alors, pour le sujet narcissiquement déstabilisé, de détruire ce qui risque de l’abandonner et de le surtraumatiser une fois de plus."
                            }
                        ]
                    }
                ],
