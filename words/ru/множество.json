                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Menge",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für eine große Anzahl"
                            },
                            {
                                "target_lang_word": "Vielzahl",
                                "target_lang_sense_clarification": "betont die große Anzahl verschiedener Dinge"
                            },
                            {
