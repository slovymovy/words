                ],
                "senses": [
                    {
                        "sense_id": "8ba4709e-fb8a-31b6-9923-b6ad2f85de13",
                        "entry_id": "561ec131-c9b4-3a60-aa99-1b349573bd99",
                        "glosses": [
                            "rechtlich geschütztes Zeichen eines Unternehmens, einer Organisation, eines Produktes oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f46b93-f4f6-4c38-8cc3-cc643cc0a6b5",
                                "sense_id": "8ba4709e-fb8a-31b6-9923-b6ad2f85de13",
                                "text": "Herrn Gleismann-Kubitzki war nicht bekannt, dass das Wort Regionalexpress ein Markenzeichen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e8d262e-bb8f-38ab-bf42-6e4740570269",
                        "entry_id": "561ec131-c9b4-3a60-aa99-1b349573bd99",
                        "glosses": [
                            "Besonderheit, an der man etwas wiedererkennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e862af5-ed64-4691-8820-ec30c956430b",
                                "sense_id": "9e8d262e-bb8f-38ab-bf42-6e4740570269",
                                "text": "„Zerfließende Uhren und ein spitzer Schnurrbart sind Salvador Dalís Markenzeichen, ein expressionistischer Pinsel dagegen weniger.“"
                            },
                            {
                                "example_id": "a9ee7e6c-cf01-4a0e-b2cb-6a9fb6dc4864",
                                "sense_id": "9e8d262e-bb8f-38ab-bf42-6e4740570269",
                                "text": "„Doch von Pinien eingerahmte Meeresbuchten sind nach wie vor ein Markenzeichen dieses Teils der Mittelmeerküste.“"
                            },
                            {
                                "example_id": "26d623ed-2b53-46d0-adcb-6bb4cf879e8c",
                                "sense_id": "9e8d262e-bb8f-38ab-bf42-6e4740570269",
                                "text": "„Sie war in Stadt und Land eine Berühmtheit, ihres Busens wegen, dem Markenzeichen, worüber die abenteuerlichsten Informationen umgingen, von denen möglicherweise keine einzige stimmte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
