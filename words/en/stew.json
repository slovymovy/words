    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e280def1-f65f-3fa5-abdc-ff5e62b7a2bb",
                    "sense_definition": "A dish of meat and vegetables cooked slowly in liquid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a cold winter evening, nothing is better than a bowl of hot <w>stew</w>.",
                            "target_lang_translations": {
                                "ru": "Холодным зимним вечером нет ничего лучше тарелки горячего <w>рагу</w>."
                            }
                        },
                        {
                            "text": "The chef prepared a hearty <w>stew</w> with beef, carrots, and potatoes for the guests.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил для гостей сытное <w>рагу</w> из говядины, моркови и картофеля."
                            }
                        }
                    ],
                    "synonyms": [
                        "casserole",
                        "hotpot"
                    ],
                    "common_phrases": [
                        "hearty stew",
                        "beef stew",
                        "vegetable stew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо из мяса и овощей, медленно приготовленное в жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рагу",
                                "target_lang_sense_clarification": "блюдо из тушёных кусочков мяса и овощей"
                            },
                            {
                                "target_lang_word": "тушёное мясо",
                                "target_lang_sense_clarification": "мясо, приготовленное путём тушения"
                            },
                            {
                                "target_lang_word": "жаркое",
                                "target_lang_sense_clarification": "густое мясное блюдо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a40d7ee-15aa-32a9-8a6b-1081144fad11",
                    "sense_definition": "A state of agitated excitement, worry, or confusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was in a real <w>stew</w> after realizing he had lost his passport before the flight.",
                            "target_lang_translations": {
                                "ru": "Он был в настоящем <w>смятении</w>, осознав, что потерял паспорт перед вылетом."
                            }
                        },
                        {
                            "text": "Don't get yourself in a <w>stew</w> over such a minor mistake.",
                            "target_lang_translations": {
                                "ru": "Не стоит так <w>переживать</w> из-за такой пустяковой ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "fret",
                        "worry"
                    ],
                    "common_phrases": [
                        "in a stew"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'in a stew'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного волнения, беспокойства или замешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "состояние тревоги или суеты"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "сильное волнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "497ded8d-751e-3d7d-9a83-0c7153a924d1",
                    "sense_definition": "A steward or stewardess on an airplane or boat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked as a <w>stew</w> for a major airline for over ten years.",
                            "target_lang_translations": {
                                "ru": "Она проработала <w>стюардессой</w> в крупной авиакомпании более десяти лет."
                            }
                        },
                        {
                            "text": "The <w>stew</w> walked down the aisle to check if everyone had their seatbelts fastened.",
                            "target_lang_translations": {
                                "ru": "<w>Бортпроводник</w> прошел по проходу, чтобы проверить, все ли пристегнуты ремнями безопасности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal abbreviation used within the industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стюард или стюардесса на самолете или судне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бортпроводник",
                                "target_lang_sense_clarification": "сотрудник авиалинии"
                            },
                            {
                                "target_lang_word": "стюард",
                                "target_lang_sense_clarification": "обслуживающий персонал на транспорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eef29039-0bf2-3180-9b7d-14658507e77a",
                    "sense_definition": "A pool or pond in which fish are kept in preparation for eating.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monastery had a private <w>stew</w> to ensure fresh fish for the monks on Fridays.",
                            "target_lang_translations": {
                                "ru": "У монастыря был собственный <w>садок</w>, чтобы обеспечивать монахов свежей рыбой по пятницам."
                            }
                        },
                        {
                            "text": "They stocked the <w>stew</w> with carp every spring to maintain their food supply.",
                            "target_lang_translations": {
                                "ru": "Каждую весну они запускали в <w>пруд</w> карпов, чтобы поддерживать запасы продовольствия."
                            }
                        }
                    ],
                    "synonyms": [
                        "stewpond"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бассейн или пруд, в котором содержат рыбу перед употреблением в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садок",
                                "target_lang_sense_clarification": "место для хранения живой рыбы"
                            },
                            {
                                "target_lang_word": "рыбный пруд",
                                "target_lang_sense_clarification": "искусственный водоем для рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "414bfdfe-ed79-351e-9785-55929b92196b",
                    "sense_definition": "A brothel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical novel, the protagonist was forced to live in the <w>stews</w> of London.",
                            "target_lang_translations": {
                                "ru": "В историческом романе главный герой был вынужден жить в лондонских <w>притонах</w>."
                            }
                        },
                        {
                            "text": "The authorities eventually closed down the notorious <w>stew</w> near the docks.",
                            "target_lang_translations": {
                                "ru": "Власти в конце концов закрыли пресловутый <w>бордель</w> рядом с доками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичный дом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бордель",
                                "target_lang_sense_clarification": "публичный дом"
                            },
                            {
                                "target_lang_word": "притон",
                                "target_lang_sense_clarification": "место сомнительной репутации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b0ab5f0-7869-39ab-9b8c-fa918364e9f6",
                    "sense_definition": "To cook food by slowly boiling or simmering in a closed pot.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>stew</w> the meat for at least two hours to make it tender.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>тушить</w> мясо не менее двух часов, чтобы оно стало нежным."
                            }
                        },
                        {
                            "text": "She decided to <w>stew</w> some apples with cinnamon for a simple dessert.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>потушить</w> яблоки с корицей для простого десерта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slowly stew",
                        "stew the meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить пищу путем медленного кипячения или томления в закрытой посуде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тушить",
                                "target_lang_sense_clarification": "варить на медленном огне в закрытой посуде"
                            },
                            {
                                "target_lang_word": "томить",
                                "target_lang_sense_clarification": "долго варить на слабом огне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f3fb5bb-cd2f-3470-92fc-b0afd04891e0",
                    "sense_definition": "To be in a state of elevated anxiety, anger, or suppressed resentment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of talking about the problem, he just sat there and continued to <w>stew</w> in his own juices.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы обсудить проблему, он просто сидел и продолжал <w>вариться</w> в собственном соку."
                            }
                        },
                        {
                            "text": "She was left to <w>stew</w> over the insulting comments her boss had made.",
                            "target_lang_translations": {
                                "ru": "Ее оставили <w>мучиться</w> из-за оскорбительных замечаний начальника."
                            }
                        }
                    ],
                    "synonyms": [
                        "brood",
                        "fret",
                        "sweat",
                        "worry"
                    ],
                    "common_phrases": [
                        "stew in one's own juices"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии сильной тревоги, гнева или подавленной обиды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариться в собственном соку",
                                "target_lang_sense_clarification": "переживать в одиночестве"
                            },
                            {
                                "target_lang_word": "изводить себя",
                                "target_lang_sense_clarification": "мучиться от беспокойства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5f9355-4653-3aef-aaa5-fd7e96a64db5",
                    "sense_definition": "To suffer under uncomfortably hot conditions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were left to <w>stew</w> in the crowded bus without any air conditioning.",
                            "target_lang_translations": {
                                "ru": "Нас оставили <w>париться</w> в переполненном автобусе без кондиционера."
                            }
                        },
                        {
                            "text": "The fans weren't working, and the audience had to <w>stew</w> in the heat for hours.",
                            "target_lang_translations": {
                                "ru": "Вентиляторы не работали, и зрителям пришлось часами <w>изнывать</w> от жары."
                            }
                        }
                    ],
                    "synonyms": [
                        "bake",
                        "boil",
                        "sweat",
                        "swelter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage regarding heat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдать от некомфортно жарких условий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "париться",
                                "target_lang_sense_clarification": "страдать от жары и духоты"
                            },
                            {
                                "target_lang_word": "изнывать от жары",
                                "target_lang_sense_clarification": "мучиться в жарких условиях"
                            }
                        ]
                    }
                }
            ]
        },
