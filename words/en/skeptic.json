                        "vocal skeptic"
                    ]
                },
                {
                    "sense_id": "3cecbf35-52e6-372e-8e00-ab2074e6f02d",
                    "sense_definition": "A person who questions or denies the existence of God or the truth of religious doctrines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "doubter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher was known as a <w>skeptic</w> regarding traditional religious teachings."
                        },
                        {
                            "text": "Even religious <w>skeptics</w> often appreciate the moral lessons found in ancient texts."
                        }
                    ],
                    "synonyms": [
