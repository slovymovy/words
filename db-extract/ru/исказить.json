                                "target_senses": [
                                    {
                                        "sense_id": "a8aac84a-447f-3eb3-acf8-c3865eb1e5b2",
                                        "entry_id": "442510c0-8d8c-352c-b227-a82514b472e6",
                                        "glosses": [
                                            "To bring something out of shape, to misshape."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bda6da-d88e-4594-91d5-0e9b65d6c061",
                                                "sense_id": "a8aac84a-447f-3eb3-acf8-c3865eb1e5b2",
                                                "text": "This she did with the utmost politeness, though cold by race, and through her politeness ran a sense of what the Teutons call Duty, which would once have repelled me; but I have wandered over a great part of the world and I know it now to be a distorted kind of virtue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23c717f-1311-3599-a528-1ab2e25c8d8a",
                                        "entry_id": "442510c0-8d8c-352c-b227-a82514b472e6",
                                        "glosses": [
                                            "To become misshapen."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f96c3a97-1b62-3c2e-976f-6facb9861ced",
                                        "entry_id": "442510c0-8d8c-352c-b227-a82514b472e6",
                                        "glosses": [
                                            "To give a false or misleading account of; pervert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd9a5efb-ca3e-48ec-a8cc-2687675d6d22",
                                                "sense_id": "f96c3a97-1b62-3c2e-976f-6facb9861ced",
                                                "text": "In their articles, journalists sometimes distort the truth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distort",
                                "target_lang_code": "en",
                                "target_senses": [
