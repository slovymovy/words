                ],
                "senses": [
                    {
                        "sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                        "entry_id": "246c716f-24b4-3d44-9b21-3987495fe80a",
                        "glosses": [
                            "een fictieve persoon in een verhaal, boek, toneelstuk e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84de28a7-ab8a-400e-8079-64695256d15a",
                                "sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                                "text": "De personages in zijn boeken zijn werkelijk levensecht te noemen."
                            },
                            {
                                "example_id": "4779d49d-a717-43ec-8c22-4e1e2dc43061",
                                "sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                                "text": "Ik kan niet alles letterlijk reproduceren en ik moet toegeven dat ik ook niet alles verstond, omdat ik niet was voorbereid op deze uitbarsting van Franse poëzie, maar ik verstond genoeg om te begrijpen dat het ging om een feministische visie op drie verlaten vrouwen uit de mythologie, Nausica, Medea en Dido, die volgens mij werden samengesmolten tot één modern personage in de gedaante van een zwerfster in de metro van Parijs, maar voor het laatste deel van deze interpretatie moet ik gezien de particuliere metaforiek een slag om de arm houden."
                            },
                            {
                                "example_id": "88084922-ea91-4fea-8dbd-0d909d17e686",
                                "sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                                "text": "Babette van Veen maakt een half jaar na haar gedwongen vertrek in Goede Tijden, Slechte Tijden alweer haar rentree in de langlopende RTL 4-soapserie. Haar personage Linda Dekker is vanaf volgende week weer te zien, zo maakte de actrice zondag bekend in RTL Boulevard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf669d6-86f9-48aa-84db-ad2915117800",
                        "source_entry_id": "246c716f-24b4-3d44-9b21-3987495fe80a",
                        "source_sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                        "target_lang_word": "Figur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Figur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86086aa7-89ad-31de-bf77-be42a7b3d1fc",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Körperform, menschliche Gestalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00859f3c-e96b-417b-afcf-8fb8b23cb842",
                                                "sense_id": "86086aa7-89ad-31de-bf77-be42a7b3d1fc",
                                                "text": "Sie hat eine gute Figur."
                                            },
                                            {
                                                "example_id": "905c29fd-4869-465e-89ff-144b9113414d",
                                                "sense_id": "86086aa7-89ad-31de-bf77-be42a7b3d1fc",
                                                "text": "„Der schwarze Einteiler betonte die Figur, und kaum jemand konnte es lassen, ihr tief in den Ausschnitt zu gucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68d36634-d6fa-3250-bb46-edbb3be8a0e6",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "künstlerische Darstellung, Rolle, Charakter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf23d4e-8799-4a99-9b57-a88db4fbe4ac",
                                                "sense_id": "68d36634-d6fa-3250-bb46-edbb3be8a0e6",
                                                "text": "Im Roman treten verschiedene Figuren auf."
                                            },
                                            {
                                                "example_id": "39d4164e-294f-4d8e-a6db-b9dddf72a8cc",
                                                "sense_id": "68d36634-d6fa-3250-bb46-edbb3be8a0e6",
                                                "text": "„Der wie seine Figuren, die gern einsilbige Namen wie Zürn, Halm oder Horn tragen, schwer unter Abhängigkeiten leidet, die der Einzelne nicht selbst beeinflussen kann.“"
                                            },
                                            {
                                                "example_id": "8df546b9-b81a-433b-a99c-77a63395208f",
                                                "sense_id": "68d36634-d6fa-3250-bb46-edbb3be8a0e6",
                                                "text": "„Bei Wolfssohn sprechen die unaufgeklärten, rückständigen Figuren Jiddisch, der aufgeklärte positive Held reines Hochdeutsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "758356fd-acfa-3d2f-b2ae-e1827d094d68",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "künstlich hergestelltes Modell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295fe25e-95c0-4ca4-8ea2-2d668c530f53",
                                                "sense_id": "758356fd-acfa-3d2f-b2ae-e1827d094d68",
                                                "text": "Er fabriziert Figuren von wilden Tieren und ist besonders für seine Affenfiguren berühmt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7f4e53ec-ef11-3953-ad67-e7fedb9f2473",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "künstlerische Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f4b85d-2e61-43ad-9e9f-d92648ae88d0",
                                                "sense_id": "7f4e53ec-ef11-3953-ad67-e7fedb9f2473",
                                                "text": "Die Figur wurde von einem Künstler geschaffen."
                                            },
                                            {
                                                "example_id": "332bdc89-88e7-4692-afce-8164a4c7c350",
                                                "sense_id": "7f4e53ec-ef11-3953-ad67-e7fedb9f2473",
                                                "text": "„Hiervon macht vor allem der Kunstflieger mit seinen Figuren wie Loopings, Steilkehren, Spiralen, Trudeln, Rückenkreisen, Gestoßenen und Gesteuerten Rollen Gebrauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "55471716-b8d4-32d4-bc48-fa197450966c",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Spielstein bei Brettspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6029bcc-d908-4bba-ac00-0863ef5fe5a0",
                                                "sense_id": "55471716-b8d4-32d4-bc48-fa197450966c",
                                                "text": "Die Figur zieht nach gegenüber."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b3e7f54b-fddb-3e04-8855-f233b2e789f0",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Umrisszeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e2326f-af09-4712-85ee-65f05e4c5221",
                                                "sense_id": "b3e7f54b-fddb-3e04-8855-f233b2e789f0",
                                                "text": "Mit einigen kurzen Strichen skizzierte sie eine grafische Figur."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "15bc93d9-eff1-3951-8750-8cd73dea79b8",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Abbildung, grafische Darstellung zur Illustrierung eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f9e67f-d99d-402b-ba8e-0b6b1f081141",
                                                "sense_id": "15bc93d9-eff1-3951-8750-8cd73dea79b8",
                                                "text": "Zu diesem Text siehe Figur 2."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "f503e972-134c-3441-ae05-05beaec30bd0",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Person in ihrer Bedeutung und Wirksamkeit nach außen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a509fe69-ff7c-4c42-a5ee-0c504f199f94",
                                                "sense_id": "f503e972-134c-3441-ae05-05beaec30bd0",
                                                "text": "Er macht eine gute Figur."
                                            },
                                            {
                                                "example_id": "40632498-82fc-4fdb-b2dd-948c914d4b19",
                                                "sense_id": "f503e972-134c-3441-ae05-05beaec30bd0",
                                                "text": "„Von der Figur dieses Umherschweifenden und planlos Genießenden sind die folgenden Gedankenspaziergänge inspiriert.“"
                                            },
                                            {
                                                "example_id": "db101dd3-555d-4f6a-a26a-3a987743c574",
                                                "sense_id": "f503e972-134c-3441-ae05-05beaec30bd0",
                                                "text": "„Erst von 1928 an übernahmen rechtsstehende Figuren die Führung der DNVP, de schließlich zum Juniorpartner der Nationalsozialisten werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "0b594265-2602-334e-ab63-13bf630b987c",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Bewegungsabfolge bei bestimmten Übungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7925b3e-bc62-4f31-bfdc-8802dcc5b7e6",
                                                "sense_id": "0b594265-2602-334e-ab63-13bf630b987c",
                                                "text": "„Hiervon macht vor allem der Kunstflieger mit seinen Figuren wie Loopings, Steilkehren, Spiralen, Trudeln, Rückenkreisen, Gestoßenen und Gesteuerten Rollen Gebrauch.“"
                                            },
                                            {
                                                "example_id": "fc9724de-f4ba-4e79-89d0-11dbb2991725",
                                                "sense_id": "0b594265-2602-334e-ab63-13bf630b987c",
                                                "text": "Ich möchte heute eine neue Figur vorstellen, die wir dann nächstes Wochenende beim Abschlussball vorführen."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "2837253e-efaf-3472-8606-c4e35a68b385",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "in sich geschlossene prägnante musikalische Tonfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9479ff3-f2eb-46c7-b5bb-889304d2c8e9",
                                                "sense_id": "2837253e-efaf-3472-8606-c4e35a68b385",
                                                "text": "Melodische Figuren sind nicht immer harmonisch melodisch."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "dbaef6bd-8113-33c1-8049-c93143257b0f",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Redewendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7855e369-358d-4387-9856-6320951e8251",
                                                "sense_id": "dbaef6bd-8113-33c1-8049-c93143257b0f",
                                                "text": "Heute nachmittag stehen Übung zu rhetorischen Figuren auf dem Programm."
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "0a5be5bf-6c34-36f2-9db7-a84857450bc0",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "Verzierung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "d56b74c7-fa9d-3f2c-b5b9-76548c5aa51d",
                                        "entry_id": "b3e5ae9c-578d-3276-b1bf-a8da43ae00ca",
                                        "glosses": [
                                            "verächtliche Bezeichnung für eine Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e538e8-57fd-4b2f-8d15-924da011b521",
                                                "sense_id": "d56b74c7-fa9d-3f2c-b5b9-76548c5aa51d",
                                                "text": "Da haben sie ja ein paar schöne Figuren in den Vorstand gewählt!"
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "729f6a29-3637-4997-a06c-8f8b171b4b39",
                        "source_entry_id": "246c716f-24b4-3d44-9b21-3987495fe80a",
                        "source_sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                        "target_lang_word": "personage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0364363d-6dcc-3ddc-b203-17753fd0b36b",
                                        "entry_id": "e9ee4eb0-bc02-3de8-8f69-6c498ea35eac",
                                        "glosses": [
                                            "A person, especially one who is famous or important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0a39b8-7a6a-4f65-8747-813140d7d403",
                                                "sense_id": "0364363d-6dcc-3ddc-b203-17753fd0b36b",
                                                "text": "I can only say they have been in pretty close conversation several times of late, and, if I dared to think it of so very calm and dignified a personage, I should say that her color was a little heightened after one or more of these interviews."
                                            },
                                            {
                                                "example_id": "d26adeb2-a773-4b7c-a7e3-b7abd9dc071f",
                                                "sense_id": "0364363d-6dcc-3ddc-b203-17753fd0b36b",
                                                "text": "The Matchmaking Festival provided social events for these lonely-hearted pilgrims, and allowed local personages to keep undesirables away from their daughters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd591ec9-5b9b-356b-878e-545098c4ec2b",
                                        "entry_id": "e9ee4eb0-bc02-3de8-8f69-6c498ea35eac",
                                        "glosses": [
                                            "A character (in a film, book, play, etc)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "651aa086-b85b-37a9-9849-135eb74c732c",
                                        "entry_id": "e9ee4eb0-bc02-3de8-8f69-6c498ea35eac",
                                        "glosses": [
                                            "The creation of corporate persons named after living people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee82198f-5dfd-387b-973a-4855246ffbd7",
                                        "entry_id": "e9ee4eb0-bc02-3de8-8f69-6c498ea35eac",
                                        "glosses": [
                                            "Character represented; external appearance; persona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459876a5-b160-4838-93a3-a31297c400dc",
                                                "sense_id": "ee82198f-5dfd-387b-973a-4855246ffbd7",
                                                "text": "But tell me, that haſt ſeene him, Menaphon,\nWhat ſtature wields he, and what perſonage?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "844675b2-0550-4f45-a234-ab52d7035834",
                        "source_entry_id": "246c716f-24b4-3d44-9b21-3987495fe80a",
                        "source_sense_id": "ec8b551c-db21-3996-a73d-6c7f215d085c",
                        "target_lang_word": "personnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Personne ; avec une certaine idée de grandeur, d’autorité, d’importance sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db7fa09-0cc9-4fe6-a9e5-b74b07c5f69c",
                                                "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                                "text": "Le marquis, en voyant le zèle de Pierre, s’était finement abrité derrière lui. À quoi bon se mettre en vue, quand un homme à fortes épaules veut bien endosser toutes les sottises d’un parti. Il laissa Pierre trôner, se gonfler d’importance, parler en maître, se contentant de le retenir ou de le jeter en avant, selon les nécessités de la cause.. Aussi l’ancien marchand d’huile fut-il bientôt un personnage."
                                            },
                                            {
                                                "example_id": "cbee5253-522a-49dc-8587-2a119a53201d",
                                                "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                                "text": "D’ailleurs, ce qui est particulier à la politique de l’histoire sainte, c’est que, chaque fois qu’un personnage marquant fait quelque chose de mal, c’est toujours le pauvre peuple qui écope."
                                            },
                                            {
                                                "example_id": "ee104052-a70e-4d97-9bed-6fec6209dc30",
                                                "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                                "text": "Et nous autres, les gens du peuple, nous sommes des imbéciles. On se figurait que les personnages de la haute savaient où ils voulaient en venir, et ils ne savaient rien du tout."
                                            },
                                            {
                                                "example_id": "4abb8a81-9006-4d5a-b111-c9cdbd0070f7",
                                                "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                                "text": "Il se fabriquait une étrange réputation, personnage de légende qui voyait à travers le brouillard, savait se rendre invisible aux gabelous, capable de tout !"
                                            },
                                            {
                                                "example_id": "2c5dead3-05e5-416b-b2a3-d932be24262e",
                                                "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                                                "text": "Bagambiki, je l’apprendrai plus tard, est un personnage influent venant du MRND, le parti du président assassiné, dont il est l’un des durs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857dbb35-6a86-331c-9a54-46656236ed12",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Personne mise en action dans un ouvrage dramatique, d’après les légendes dont le théâtre est issu ; en ce sens, il s’applique aux femmes comme aux hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeee4a7-bb32-45d1-8311-020a6f203f13",
                                                "sense_id": "857dbb35-6a86-331c-9a54-46656236ed12",
                                                "text": "La poésie de la Renaissance ne peut pas se contenter de cette simplicité biblique, et, pour célébrer cette nuit de réparation, elle appelle la Joie, personnage allégorique..."
                                            },
                                            {
                                                "example_id": "95e6442f-80c0-419b-81b4-1725b6ea187f",
                                                "sense_id": "857dbb35-6a86-331c-9a54-46656236ed12",
                                                "text": "Loin de s'occuper des jappements indicatifs du chien, notre personnage se plaisait à suivre loisireusement le sentier tortueux dans lequel il marchait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e74c34-cdba-31a4-b968-61a7b1453a98",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Ces mêmes personnes, par rapport aux comédiens qui les représentent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821e38b0-7b42-4a71-8afe-7ad35f548d50",
                                                "sense_id": "f3e74c34-cdba-31a4-b968-61a7b1453a98",
                                                "text": "La star internationale, hyperglamour sur les marches du Palais — le 20 mai, aux côtés des deux cinéastes belges et de Fabrizio Rongione — peut-elle encore s’effacer au profit de son personnage ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8315a734-adde-3d72-a49d-6019f622b195",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Personne fictive qui figure dans un ouvrage narratif, tel un conte, une nouvelle ou un roman."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0b2585-b224-4662-b02e-ea1fc764adbf",
                                                "sense_id": "8315a734-adde-3d72-a49d-6019f622b195",
                                                "text": "Nos grands-parents inventaient des personnages à faire peur. Des personnages se rapprochant du Père Fouettard et destinés à effrayer les enfants. En quelque sorte des croquemitaines."
                                            },
                                            {
                                                "example_id": "0051671b-b94c-4f6f-ab95-f0d837ad9777",
                                                "sense_id": "8315a734-adde-3d72-a49d-6019f622b195",
                                                "text": "Alors que le romancier, riche de son don d’ubiquité, peut se dédoubler en autant de personnages que son humeur daigne susciter au fil des pages, le poète reste fixé à la finitude de son expérience, à la racine de son cri."
                                            },
                                            {
                                                "example_id": "3ea2cbd0-8ae0-499b-a387-d98f48aac0fe",
                                                "sense_id": "8315a734-adde-3d72-a49d-6019f622b195",
                                                "text": "Euphorique n'est pas précisément l’épithète que l'on peut impunément accoler aux personnages houellebecquiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Manière dont on se conduit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646377d9-1108-41a9-9352-d4b1351813c6",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Cet homme-là est destiné à jouer un grand personnage."
                                            },
                                            {
                                                "example_id": "39c92a07-c6d7-46ae-a7cb-479519d5da9a",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Il a joué dans cette affaire un étrange personnage."
                                            },
                                            {
                                                "example_id": "dd3c34f6-e7b1-4a14-9def-9128a0fa82d5",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Il fait un triste, un sot, un plat personnage."
                                            },
                                            {
                                                "example_id": "43380e18-b0dc-4978-a44c-45c5c447d120",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Il joue bien, il soutient bien son personnage."
                                            },
                                            {
                                                "example_id": "d1ef7db7-494f-41a4-89e2-49c73d66f043",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Un intrigant est obligé de jouer bien des personnages à la fois."
                                            },
                                            {
                                                "example_id": "a3937bea-b0a5-4a2f-a0bb-694350c49477",
                                                "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                                                "text": "Un fripon ne fait pas longtemps le personnage d’homme de bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22de930c-0288-3fc1-9727-55024305feca",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Figure d’une composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6a5d5c-f6f8-453f-8a94-c578819723bc",
                                                "sense_id": "22de930c-0288-3fc1-9727-55024305feca",
                                                "text": "Un personnage placé au premier plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                                        "entry_id": "89eb4647-f952-35d3-8e5d-a227eab327cc",
                                        "glosses": [
                                            "Personne dont le sujet de dénigrement est alors qualifié par une épithète."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b59d67e-ff88-43d6-bf8a-84e1a7df9f29",
                                                "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                                                "text": "Je le répète, il n’entre pas dans ma pensée, ni dans mon sujet, d’insister particulièrement sur ce personnage […] qui, d’ailleurs, vient d’être frappé durement par un rigoureux arrêt de cour d’assises."
                                            },
                                            {
                                                "example_id": "b650bd46-58be-4ed7-8ecc-b55fef90fb05",
                                                "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                                                "text": "Il discernait qu’il avait affaire à un personnage exceptionnellement distrait, mais il n’était pas responsable d’une pareille balourdise chez cet hurluberlu qui visait à l’élégance."
                                            },
                                            {
                                                "example_id": "14f01396-7827-4ffb-822d-2730cc9ee307",
                                                "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                                                "text": "Les chefs d’accusation se multipliaient, mais au moins il ne serait pas l’insignifiant personnage balayé en toute hâte par une justice expéditive, comme probablement Sébastien Théus l’eût été."
                                            },
                                            {
                                                "example_id": "c00e8cda-246d-4c2c-8127-2d7c20c6f9f8",
                                                "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                                                "text": "— Je connais le personnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
