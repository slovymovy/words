                    "frequency": "Low",
                    "semantic_group_id": "oenologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vin rouge du Sud est particulièrement <w>chaleureux</w> et riche en arômes de fruits mûrs."
                        },
                        {
                            "text": "Le sommelier nous a servi un vin <w>chaleureux</w> idéal pour accompagner ce plat de gibier."
