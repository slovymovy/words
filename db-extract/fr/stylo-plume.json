                    }
                ],
                "senses": [
                    {
                        "sense_id": "78f863ec-1453-3a92-80a0-a704cba0fe8c",
                        "entry_id": "d636dfd4-2aeb-3358-9ac3-584d64634490",
                        "glosses": [
                            "Stylographe muni d’un réservoir d’encre et d’une plume métallique pour écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bce193a-fc0b-4070-bc30-7a450f5fa4a0",
                                "sense_id": "78f863ec-1453-3a92-80a0-a704cba0fe8c",
                                "text": "Il ouvrit son cahier et sortit son stylo-plume..."
                            },
                            {
                                "example_id": "bc9229b1-673e-4dff-b14a-4779062146d5",
                                "sense_id": "78f863ec-1453-3a92-80a0-a704cba0fe8c",
                                "text": "En 1906, trois allemands (un papetier, un banquier, un ingénieur) inventent le porte-plume fonctionnant avec son propre réservoir qui deviendra un stylo-plume ou stylo (raccourci du mot stylographe)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b250d21-57e5-467d-affe-9f4357a0d192",
                        "source_entry_id": "d636dfd4-2aeb-3358-9ac3-584d64634490",
                        "source_sense_id": "78f863ec-1453-3a92-80a0-a704cba0fe8c",
                        "target_lang_word": "Füllfederhalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Füllfederhalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                        "entry_id": "78bc1e18-85ba-390b-9ae5-21b9de5476d1",
                                        "glosses": [
                                            "Schreibgerät, das einen kleinen Speicher für Tinte enthält und somit andauerndes Schreiben mit Tinte ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d096dd-6042-4e5c-912c-9d452fbd9375",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "Ein Füllfederhalter schreibt wesentlich schöner als ein Kugelschreiber, finde ich."
                                            },
                                            {
                                                "example_id": "7ea564d6-f093-478d-be44-61378417f7dc",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "Die Spitze meines Füllfederhalters ist abgebrochen."
                                            },
                                            {
                                                "example_id": "512f3fe5-7e90-46f8-9036-c535fe1d92ff",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "Ich habe meinen Füllfederhalter verloren."
                                            },
                                            {
                                                "example_id": "2513598f-fa8d-4166-875b-5fcd92c9eb0c",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "Die Füllfederhalter dieser Firma kaufe ich nie wieder."
                                            },
                                            {
                                                "example_id": "2a4476cd-28a1-425d-b8d4-b621d229686c",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "„Max zog seinen Füllfederhalter aus der Tasche und begann Zahlen in sein Notizbuch zu schreiben.“"
                                            },
                                            {
                                                "example_id": "216e4c71-95ab-4192-89f4-3c9778bd1015",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "„Wenn die Hände einen gewissen Rhythmus fanden, schien es, als würde das Kratzen des Füllfederhalters die Sinne beruhigen, und an einigen Tagen schrieb er eine ganze Seite, die zu gebrauchen war.“"
                                            },
                                            {
                                                "example_id": "6284c744-4c6b-40e0-9af9-902f1c9c2efb",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "„Er probierte den Füllfederhalter aus.“"
                                            },
                                            {
                                                "example_id": "ea8337c4-78a0-4751-957a-3e12e2b43108",
                                                "sense_id": "d8b07cd2-2603-315a-b9f0-82a3ffabef64",
                                                "text": "„Die Aktentasche eng an den Körper gepresst, widerstand er der Versuchung einer feuchtfröhlichen Einkehr und blieb erst vor einem Schaufenster stehen, in dessen Auslage die glänzenden Füllfederhalter der Firma Goldfink präsentiert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1da18697-4ebc-4db3-86da-eda886136f3d",
                        "source_entry_id": "d636dfd4-2aeb-3358-9ac3-584d64634490",
                        "source_sense_id": "78f863ec-1453-3a92-80a0-a704cba0fe8c",
                        "target_lang_word": "Füller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Füller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                        "entry_id": "cba7dc7f-25d5-38bd-96d7-69a0623ea541",
                                        "glosses": [
                                            "Füllfederhalter, Schreibgerät, das einen Tank für Tinte enthält und somit andauerndes Schreiben ermöglicht"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f5b88a0-dab7-4e51-8816-6b4872def0c8",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "Mit einem Füller kann man schreiben."
                                            },
                                            {
                                                "example_id": "eb6140a2-cfcf-4516-bde2-5b2f47a29340",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "Die Gravur meines Füllers sieht sehr edel aus."
                                            },
                                            {
                                                "example_id": "8222403f-8bbb-4039-b6df-4e27ac74c556",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "Ständig verbiege ich die Metallspitzen meiner Füller."
                                            },
                                            {
                                                "example_id": "edb56c29-aebe-456c-ad76-17b5b06f797e",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "Der am weitesten verbreitete Tintenspeicher bei Füllern ist die Tintenpatrone."
                                            },
                                            {
                                                "example_id": "3235f320-840c-471e-ab0f-27dd37b9b29e",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "„Wir mußten jetzt mit Füller schreiben.“"
                                            },
                                            {
                                                "example_id": "622dec2b-a3fd-4cfa-bb48-f35da9dfb49c",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "„Dundee hatte einen Füller in der Hand und machte Krakel auf ein Blatt Papier.“"
                                            },
                                            {
                                                "example_id": "04518664-b667-4f75-85f5-300c778ee97b",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "„Der Füller funktionierte ausgezeichnet, kein Wunder, ein Parker 21, siehst du wohl!“"
                                            },
                                            {
                                                "example_id": "33849640-6f65-4f67-8efe-3a9873db1a03",
                                                "sense_id": "5c2e5397-4d32-3403-8a03-6bfcfbfb968f",
                                                "text": "„Er legt den Füller zur Seite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71a1b6ef-45f5-3722-ae10-194774b5cf5f",
                                        "entry_id": "cba7dc7f-25d5-38bd-96d7-69a0623ea541",
                                        "glosses": [
                                            "Artikel, mit dem freier Raum (zum Beispiel in einer Zeitung) gefüllt werden soll, oftmals mit wenig aktueller Relevanz aber passendem zeilenmäßigen Umfang"
                                        ],
                                        "tags": [
                                            "Journalismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6383977-955b-4736-a7f6-0676cf7f8931",
                                                "sense_id": "71a1b6ef-45f5-3722-ae10-194774b5cf5f",
                                                "text": "Hier, vor den Kleinanzeigen rechts, brauchen wir noch einen Füller, einspaltig, 8 Zeilen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Füller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                        "entry_id": "3ca49b6b-6792-3e94-8c53-9e2727f90691",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8dc827-d952-44aa-8a80-1e0ad12e5407",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Frau Füller ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e7288ba9-ecd6-467e-bf7f-9a6a341ee922",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Herr Füller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "749d2f9e-6211-487c-b219-aefefca9e909",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Die Füllers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "f855680d-4458-46cb-93c7-d319e77cf625",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Der Füller trägt nie die Schals, die die Füller ihm strickt."
                                            },
                                            {
                                                "example_id": "08d61fe6-e82a-499d-9ebc-23953bb546fa",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Füller kommt, geht der Herr Füller.“"
                                            },
                                            {
                                                "example_id": "2ea5cb97-6222-4c4c-9a71-047ff0c455c0",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Füller kommt und geht."
                                            },
                                            {
                                                "example_id": "021764fd-4848-4948-a11b-40f51d0be559",
                                                "sense_id": "368987ea-d945-3db5-aaaf-90da6c737326",
                                                "text": "Füllers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2644e6-2e60-4573-b503-bde185feaa1b",
