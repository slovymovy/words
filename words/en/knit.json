                    "sense_definition": "A garment, such as a sweater or dress, that has been knitted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "garment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a heavy woollen <w>knit</w> to protect herself from the cold.",
                            "target_lang_translations": {
                                "ru": "Она надела теплую шерстяную <w>вязаную вещь</w>, чтобы защититься от холода.",
                                "zh": "她穿了一件厚重的羊毛<w>针织品</w>来御寒。",
                                "es": "Ella llevaba una <w>prenda de punto</w> de lana gruesa para protegerse del frío."
                            }
                        },
                        {
                            "text": "The store displays a new collection of summer <w>knits</w> in bright colors.",
                            "target_lang_translations": {
                                "ru": "В магазине представлена новая коллекция летнего <w>трикотажа</w> ярких цветов.",
                                "zh": "这家店展示了一系列色彩鲜艳的夏季<w>针织品</w>。",
                                "es": "La tienda exhibe una nueva colección de <w>tejidos</w> de verano en colores brillantes."
                            }
