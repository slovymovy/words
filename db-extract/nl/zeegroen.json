                    {
                        "translation_id": "acad7037-2223-46c5-9a9c-04d4ce73bbcd",
                        "source_entry_id": "b86cfda2-7dcd-3c7c-9d0d-5bc3eab806f8",
                        "source_sense_id": "421606ff-d29e-3c8e-b032-1c891a75bf67",
                        "source_sense_description": "blauwachtig groen, kleur van de zee",
                        "target_lang_word": "vert de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
