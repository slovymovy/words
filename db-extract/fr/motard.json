                        "examples": [
                            {
                                "example_id": "12d3c115-bc84-41dc-8d65-b7278e374f0d",
                                "sense_id": "705b8ded-d6e5-33ec-b983-888a4b9f9167",
                                "text": "Le caricaturiste Plantu a reçu un courrier où Nicolas Sarkozy se plaignait des mouches dessinées au-dessus de sa tête, c'est un motard du ministère de l'Intérieur qui a livré la lettre.",
                                "translation": "De karikaturist Plantu heeft een brief gekregen waarin Nicolas Sarkozy klaagde over de vliegen die boven zijn hoofd getekend waren, en een motorrijder van het ministerie van Binnenlandse Zaken heeft de brief afgeleverd."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf3ae032-4210-3cdd-9525-85238aeeee0f",
                        "entry_id": "bb3b2f49-81f4-31e5-b566-ae2be2fcf542",
