                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "deef2a27-1939-49c3-aa95-cae6dc14b2a1",
                                "sense_id": "4211f398-44cb-3ee5-84ff-6c5ebca1a014",
                                "text": "Si on prenait Mam’zelle Clorinde pour juge, elle dirait peut-être qu’il mérite moins d’être cloîtré que toi d’être pendu."
                            }
                        ]
