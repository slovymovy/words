                    ]
                },
                {
                    "sense_id": "6359f3ca-782b-3c71-a581-3cb6ec705e06",
                    "sense_definition": "En géométrie, qualifie deux ou plusieurs figures qui ont des formes identiques, des angles égaux et des côtés proportionnels.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous demande de démontrer que ces deux triangles sont <w>semblables</w>."
                        },
                        {
                            "text": "Des polygones <w>semblables</w> possèdent les mêmes angles intérieurs."
                        }
                    ],
                    "common_phrases": [
