                "senses": [
                    {
                        "sense_id": "85b834ad-cb3b-3ff0-8306-7afa0f918a5c",
                        "entry_id": "403d6c72-6704-3f20-913b-1ec874b04d82",
                        "glosses": [
                            "rechter Nebenfluss der Murr, der in den Löwensteiner Bergen entspringt und nach 18 km Flusslauf in Steinheim in die Murr mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d7cad5-3750-4ba1-8364-a8818479d7cc",
                                "sense_id": "85b834ad-cb3b-3ff0-8306-7afa0f918a5c",
                                "text": "„Länger als gedacht dauert die Erneuerung des Radweges entlang der Bottwar sowie der Einbau des neuen Kanals und der Wasserleitung.“"
                            },
                            {
                                "example_id": "e1b58cb1-1dff-4a2d-b431-de227ab77ff3",
                                "sense_id": "85b834ad-cb3b-3ff0-8306-7afa0f918a5c",
                                "text": "„An der Murr entlang geht es zunächst nach Steinheim und dort über den Steppi-Kreisel am alten Bahnhöfle auf den Radweg entlang der Bottwar.“"
                            },
                            {
                                "example_id": "7299f0d1-1da6-49ba-a5c1-161677492d87",
                                "sense_id": "85b834ad-cb3b-3ff0-8306-7afa0f918a5c",
                                "text": "„Auch wenn sich die Radfahrer entlang der Bottwar noch ganz sorgenfrei auf dem Radweg bewegen – ganz ohne ist die Situation nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
