                    "frequency": "High",
                    "semantic_group_id": "klopfen_schlagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>klopfen</w> Sie laut an die Tür, bevor Sie das Zimmer betreten."
                        },
                        {
                            "text": "Er <w>klopfte</w> dreimal leise an das Fenster, aber niemand öffnete ihm."
                        }
                    ],
                    "synonyms": [
                        "pochen"
                    ],
                    "common_phrases": [
                        "an die Tür klopfen"
                    ]
                },
                {
                    "sense_id": "20a140d2-457c-365f-a6f1-c4d1677eb227",
                    "sense_definition": "schnell, heftig und deutlich spürbar schlagen, besonders vom Herzen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "klopfen_pulsieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der schweren Prüfung <w>klopfte</w> mein Herz so laut, dass ich kaum atmen konnte."
                        },
                        {
                            "text": "Wenn er Sport treibt, <w>klopft</w> sein Herz immer sehr schnell und gleichmäßig."
                        }
                    ],
                    "synonyms": [
                        "pochen",
                        "schlagen"
                    ],
                    "common_phrases": [
