                        "sense_id": "15792ea5-320d-3cd4-81dc-76a9652756d0",
                        "entry_id": "2b504067-b6a4-3eef-9623-db2af25b2973",
                        "glosses": [
                            "grotere open plaats in een stad waar meerdere straten en wegen bij elkaar komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ac0930-3740-413c-9b55-dc269e5f60c2",
                                "sense_id": "15792ea5-320d-3cd4-81dc-76a9652756d0",
                                "text": "Op de hoek van het Stadsplein begroette hem het bordje 'Klachtenbureau'op de deur van Bestuurlijke Zaken."
                            },
                            {
                                "example_id": "5fb666d4-7ead-4ecd-9843-16d95e6ba478",
                                "sense_id": "15792ea5-320d-3cd4-81dc-76a9652756d0",
                                "text": "Uiteindelijk staat het verloop van de strijd al vast. Na de siësta winnen de christenen als in het nagebouwde kasteel op het stadsplein de heilige Joris is verschenen. Joris, bijgenaamd de Morendoder, schiet zijn pijlen af op de moslims en beslist zo de gevechten. Volgens de overlevering is het in 1276 allemaal echt gebeurd."
                            }
                        ]
                    }
