                                "target_lang_sense_clarification": "falta de atención a responsabilidades"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分心",
                                "target_lang_sense_clarification": "一时注意力不集中"
                            },
                            {
                                "target_lang_word": "走神",
                                "target_lang_sense_clarification": "思绪飘开，不专心"
                            }
                        ]
