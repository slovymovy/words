                {
                    "sense_id": "1639c5bb-070f-3e8e-9a67-a30d4ec318e5",
                    "sense_definition": "Plural of <w>root</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "morphology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tree's <w>roots</w> go deep into the ground to find water.",
                            "target_lang_translations": {
                                "ru": "<w>Корни</w> дерева уходят глубоко в землю в поисках воды.",
                                "fr": "Les <w>racines</w> de l'arbre s'enfoncent profondément dans le sol pour trouver de l'eau."
                            }
                        },
                        {
                            "text": "Carrots and potatoes are edible <w>roots</w> that we use in cooking.",
                            "target_lang_translations": {
                                "ru": "Морковь и картофель — это съедобные <w>корнеплоды</w>, которые мы используем в кулинарии.",
                                "fr": "Les carottes et les pommes de terre sont des <w>racines</w> comestibles que nous utilisons en cuisine."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «корень»; подземная часть растений, которая удерживает их в почве и впитывает влагу.",
                        "fr": "Partie souterraine d'une plante qui la fixe au sol et absorbe l'eau et les nutriments."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корни",
                                "target_lang_sense_clarification": "у растений"
                            },
                            {
                                "target_lang_word": "корнеплоды",
                                "target_lang_sense_clarification": "овощи"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "racines",
                                "target_lang_sense_clarification": "partie souterraine des plantes"
                            },
                            {
                                "target_lang_word": "racines",
                                "target_lang_sense_clarification": "légumes racines"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f61b4fc3-925f-3413-bdc4-b9bb29ead401",
                    "sense_definition": "A person's family or ethnic origins and cultural background.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "origins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have both Irish and German <w>roots</w>.",
                            "target_lang_translations": {
                                "ru": "У меня есть и ирландские, и немецкие <w>корни</w>.",
                                "fr": "J'ai des <w>racines</w> à la fois irlandaises et allemandes."
                            }
                        },
                        {
                            "text": "She traveled to Italy to trace her family <w>roots</w>.",
                            "target_lang_translations": {
                                "ru": "Она отправилась в Италию, чтобы отследить свои семейные <w>корни</w>.",
                                "fr": "Elle a voyagé en Italie pour retrouver ses <w>racines</w> familiales."
                            }
                        }
                    ],
