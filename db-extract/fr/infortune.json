        "fr-extract.jsonl": [
            {
                "entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
                "word": "infortune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d0c5aa9-fc40-418c-a34d-7eacdeeaeb7f",
                        "entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
                        "tags": [
                            "plural"
                        ],
                        "form": "infortunes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "242cf7d2-9c25-3b26-b1c8-86b345780af7",
                        "entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
                        "glosses": [
                            "Revers de fortune."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d2683c98-1c4f-4bc3-b8af-69d483a6bd24",
                                "sense_id": "242cf7d2-9c25-3b26-b1c8-86b345780af7",
                                "text": "De grandes infortunes."
                            },
                            {
                                "example_id": "e2f7c146-4b82-480f-b8cd-b149ab9485c0",
                                "sense_id": "242cf7d2-9c25-3b26-b1c8-86b345780af7",
                                "text": "Faire le récit de ses infortunes."
                            },
                            {
                                "example_id": "82a41446-6061-48a8-a9a0-2452cfff9af1",
                                "sense_id": "242cf7d2-9c25-3b26-b1c8-86b345780af7",
                                "text": "Au milieu de tant d’infortunes son âme resta sereine."
                            },
                            {
                                "example_id": "75cbce7f-8885-4a4a-99b6-62bf221d6006",
                                "sense_id": "242cf7d2-9c25-3b26-b1c8-86b345780af7",
                                "text": "La mort termina ses infortunes."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                        "entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
                        "glosses": [
                            "Malchance, adversité, mauvaise fortune."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "6a2e7e03-cf91-404a-b85d-b006737b3f45",
                                "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                                "text": "Tomber dans l’infortune."
                            },
                            {
                                "example_id": "b0fc381e-204f-4b61-9351-1903bcc9aa05",
                                "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                                "text": "Vivre dans l’infortune."
                            },
                            {
                                "example_id": "b0976812-8789-4351-ac04-500bccbf8865",
                                "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                                "text": "Je plains son infortune."
                            },
                            {
                                "example_id": "066e5b47-f524-473a-9e39-09dec7e60d62",
                                "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                                "text": "Illustre infortune."
                            },
                            {
                                "example_id": "dc39f545-750c-4db9-a650-1f55e5192527",
                                "sense_id": "4ca5c826-cf39-3be7-991f-09df8a2ef2a2",
                                "text": "Les leçons de l’infortune sont presque toujours un bienfait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb8c394d-41c9-46fc-b464-8077461350ea",
                        "source_entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
                        "target_lang_word": "misfortune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misfortune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb7ae0a-94f1-3e56-90b6-ffe0f02dcdfe",
                                        "entry_id": "2f59cb27-a5b4-3bfc-8952-02aa2275c84e",
                                        "glosses": [
                                            "Bad luck."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5863e1-449e-4119-8446-dd4efa951f58",
                                                "sense_id": "ddb7ae0a-94f1-3e56-90b6-ffe0f02dcdfe",
                                                "text": "The worst tour I have ever had the misfortune to experience."
                                            },
                                            {
                                                "example_id": "09a92fb9-68f4-4de8-b169-b31359f688ba",
                                                "sense_id": "ddb7ae0a-94f1-3e56-90b6-ffe0f02dcdfe",
                                                "text": "Cycling's complex etiquette contains an unwritten rule that riders in contention for a race win should not be penalised for sheer misfortune."
                                            },
                                            {
                                                "example_id": "2f234745-592f-4554-bcba-2d9a91d50956",
                                                "sense_id": "ddb7ae0a-94f1-3e56-90b6-ffe0f02dcdfe",
                                                "text": "It was my fortune, or misfortune, to be called to the office of Chief Executive without any previous political training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e854fb94-413c-3015-86f2-02cbb4f0e73b",
                                        "entry_id": "2f59cb27-a5b4-3bfc-8952-02aa2275c84e",
                                        "glosses": [
                                            "An undesirable event such as an accident."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86801905-210f-4bb4-ad7a-15841e8851d0",
                                                "sense_id": "e854fb94-413c-3015-86f2-02cbb4f0e73b",
                                                "text": "She had to come to terms with a number of misfortunes."
                                            },
                                            {
                                                "example_id": "33a163ff-eef9-49d6-99b2-7ecc00a4c4ba",
                                                "sense_id": "e854fb94-413c-3015-86f2-02cbb4f0e73b",
                                                "text": "The snowstorm, which was the cause of their misfortune, happened in the middle of January, corresponding to our July, and in the latitude of Durham!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1baa1534-2453-4c91-b3c0-24bcb663e7e4",
                        "source_entry_id": "72053502-89e2-3f61-9052-6494ba591f79",
