                "senses": [
                    {
                        "sense_id": "83964a20-a3fe-3cee-85d7-f303dbb2823f",
                        "entry_id": "cbc7d874-d1ad-3c79-b2da-3d10764b7703",
                        "glosses": [
                            "een verbinding van water en koolstofdioxide met de formule H₂CO₃"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9796d78-0b7f-4b37-9199-80ce8c2d9b35",
                                "sense_id": "83964a20-a3fe-3cee-85d7-f303dbb2823f",
                                "text": "Als verbinding is koolzuur zelf weinig stabiel, maar er zijn wel zouten van afgeleid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c57484aa-68f3-4938-bbfc-7be69d228bce",
                        "source_entry_id": "cbc7d874-d1ad-3c79-b2da-3d10764b7703",
                        "source_sense_id": "83964a20-a3fe-3cee-85d7-f303dbb2823f",
                        "source_sense_description": "H₂CO₃",
                        "target_lang_word": "Kohlensäure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlensäure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
                                        "entry_id": "9cd35953-b950-33ba-b6c0-c8d86447abaf",
                                        "glosses": [
                                            "instabiles Reaktionsprodukt aus Kohlendioxid und Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25519532-59e1-4a51-b65e-7513cc16e828",
                                                "sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
                                                "text": "In Mineralwasser ist Kohlensäure enthalten."
                                            },
                                            {
                                                "example_id": "bd5af6f3-2e24-4519-a43e-940ef35375c3",
                                                "sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
                                                "text": "„Sie wird unfruchtbar werden; alles Holz und alle Steinkohle wird sich in Kohlensäure verwandeln und kein Lebewesen mehr existieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24886aaf-78ad-4376-ab46-4563559b497e",
                        "source_entry_id": "cbc7d874-d1ad-3c79-b2da-3d10764b7703",
                        "source_sense_id": "83964a20-a3fe-3cee-85d7-f303dbb2823f",
                        "source_sense_description": "H₂CO₃",
                        "target_lang_word": "carbonic acid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbonic acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                        "entry_id": "c157204e-a66c-39c1-815a-f5e6f98a886e",
                                        "glosses": [
                                            "A weak unstable acid, H₂CO₃, known only in solution, and as carbonate salts; it is present in carbonated drinks, and sparkling wine, but decomposes to form carbon dioxide and water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab2d291-a863-4f86-93c1-60414e402d02",
                                                "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                                "text": "Had she lived now, she would have talked of the last delightful lecture on gas, or the charming new treatise on carbonic acid; she would have studied German, and delighted in the society of \"talented people.\""
                                            },
                                            {
                                                "example_id": "8325054d-7497-498e-83d9-a390e59f33ce",
                                                "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                                "text": "[I]t sank down through the air and poured over the ground in a manner rather liquid than gaseous, abandoning the hills, and streaming into the valleys and ditches and water-courses even as I have heard the carbonic acid gas that pours from volcanic clefts is wont to do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3d95e9-6111-3a7f-8f23-286582e97ece",
                                        "entry_id": "c157204e-a66c-39c1-815a-f5e6f98a886e",
                                        "glosses": [
                                            "Carbon dioxide."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d6708a-a645-4fc5-8fef-4633952bc295",
                        "source_entry_id": "cbc7d874-d1ad-3c79-b2da-3d10764b7703",
                        "source_sense_id": "83964a20-a3fe-3cee-85d7-f303dbb2823f",
                        "source_sense_description": "H₂CO₃",
                        "target_lang_word": "acide carbonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide carbonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39f59e14-300b-3751-8bae-f19a7dbc9dd6",
                                        "entry_id": "75fb5258-5e81-39aa-bad8-cd3d808dd982",
                                        "glosses": [
                                            "Acide faible, très instable, de formule brute H₂CO₃, se formant par réaction entre l’eau et le dioxyde de carbone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c664dc12-0128-4355-b6b7-77fc87579deb",
                                                "sense_id": "39f59e14-300b-3751-8bae-f19a7dbc9dd6",
                                                "text": "En 1833, Mlle Fischer, qui travaillait parfois la nuit quand elle avait beaucoup d'ouvrage, sentit, vers une heure du matin, une odeur d’acide carbonique, et entendit les plaintes d’un mourant."
                                            },
                                            {
                                                "example_id": "cfac5dd4-ba51-4828-bf91-051d246902af",
                                                "sense_id": "39f59e14-300b-3751-8bae-f19a7dbc9dd6",
                                                "text": "La chaux ne se rencontre jamais à l'état libre dans la nature. Elle est le plus souvent combinée avec l’acide carbonique, et forme un corps que les chimistes appellent carbonate de chaux et qui est le principal composant des pierres calcaires."
                                            },
                                            {
                                                "example_id": "3c9f70b8-595c-4743-b8d0-55f5bfff9e65",
                                                "sense_id": "39f59e14-300b-3751-8bae-f19a7dbc9dd6",
                                                "text": "On sait depuis longtemps que les spadices des Aroïdées s’échauffent au moment de la floraison et Garreau a démontré que cet échauffement est accompagné d’un fort dégagement d’acide carbonique, qu’il n’est donc que l’un des résultats d’une respiration très active."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
