                "senses": [
                    {
                        "sense_id": "1453f851-3431-3672-898e-c8bcce295617",
                        "entry_id": "a4b50438-f5fe-3f2e-be40-fc28499e6585",
                        "glosses": [
                            "Personne qui empaille des chaises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de53f94c-8aa1-4364-9ec8-15e682baade5",
                                "sense_id": "1453f851-3431-3672-898e-c8bcce295617",
                                "text": "Empailleur de chaises."
                            }
                        ]
                    },
                    {
                        "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                        "entry_id": "a4b50438-f5fe-3f2e-be40-fc28499e6585",
                        "glosses": [
                            "Personne qui empaille des animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271ee707-66ae-4e0d-adf4-bd824635dbd1",
                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                "text": "Or, plus la vie est facile, plus ces occupations sont fastidieuses, à moins d’appartenir à la secte des quakers-tourneurs, à l’honorable corps des charpentiers ou des empailleurs d’oiseaux."
                            },
                            {
                                "example_id": "05363b93-6361-4662-81aa-8703a8a50040",
                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                "text": "Enfin, il arriva, — et splendide, droit sur une branche d’arbre, qui se vissait dans un socle d’acajou, une patte en l’air, la tête oblique, et mordant une noix, que l’empailleur par amour du grandiose avait dorée."
                            },
                            {
                                "example_id": "4136e404-e4e6-46d5-a559-fc8aab0def10",
                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                "text": "C’était un bon commerçant autant qu’un empailleur talentueux, et ses affaires prospéraient grâce à sa faconde."
                            }
                        ]
                    }
                ],
