                            {
                                "target_word": "larmoiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f6da6ef-583a-3437-a1dd-e80b61acaaae",
                                        "entry_id": "2c229069-0e6b-3694-8905-bce9926d96b5",
                                        "glosses": [
                                            "Écoulement de larmes involontaire et continuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cf88ea-a24a-4bb4-ba94-3d51f5c17ef1",
                                                "sense_id": "7f6da6ef-583a-3437-a1dd-e80b61acaaae",
                                                "text": "Aux femmes les voix criardes, les mots cent fois répétés, les soupirs, le larmoiement."
                                            },
                                            {
                                                "example_id": "4e57a72a-2771-4508-9ad6-e22e5ddc0c47",
                                                "sense_id": "7f6da6ef-583a-3437-a1dd-e80b61acaaae",
                                                "text": "L'exposition à la lewisite et au phosgène provoque une douleur immédiate. Les lésions tissulaires apparaissent en quelques minutes. En cas d'exposition des yeux, il y a douleur, photophobie, larmoiement et perte d'acuité visuelle."
                                            },
                                            {
                                                "example_id": "e1a65241-868d-4178-918c-7f080cbc52bb",
                                                "sense_id": "7f6da6ef-583a-3437-a1dd-e80b61acaaae",
                                                "text": "Contact avec les yeux: Irritation mécanique due aux particules de produit, d’où larmoiement et légère douleur temporaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
