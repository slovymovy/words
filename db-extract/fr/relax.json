                        "glosses": [
                            "Détendu, relaxant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "204ff0be-02f7-4710-89ae-bd51b280ff84",
                                "sense_id": "0ae1a8bd-f6e4-3694-92ea-3b09d42d34f7",
                                "text": "On a passé un dimanche relax à la campagne."
