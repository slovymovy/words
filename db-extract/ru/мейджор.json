                "senses": [
                    {
                        "sense_id": "b6ada396-f18d-3bb3-91cc-7b3738df77af",
                        "entry_id": "da294713-355f-3f90-b1fa-23ce2102e832",
                        "glosses": [
                            "крупная компания, которая занимает лидирующее положение на рынке (обычно о киностудиях и рекорд-лейблах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2272626-fcea-4436-9b7c-c4430167f8f0",
                                "sense_id": "b6ada396-f18d-3bb3-91cc-7b3738df77af",
                                "text": "В артхаусном прокате, как правило, идут картины американских независимых режиссёров, а также европейское кино, которому просто нет места в большом прокате, контролируемом голливудскими мейджорами."
                            },
                            {
                                "example_id": "165ea5fb-b934-4ce8-b6b0-e26a935dc6d7",
                                "sense_id": "b6ada396-f18d-3bb3-91cc-7b3738df77af",
                                "text": "Так, когда рынок музыки был поделён между несколькими мейджорами, те могли диктовать артистам, что петь."
                            }
                        ]
                    },
