                        "entry_id": "f3fac24b-5b8a-3420-aed7-9fe39d55d547",
                        "glosses": [
                            "Qualifie un espace topologique qu'on peut relier par un homéomorphisme à un autre espace topologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b98e89d7-fdb0-4aeb-9f88-9601d572813b",
                                "sense_id": "50646d94-524f-3dc6-8cfe-aa33fe2a0099",
                                "text": "Ou E est homéomorphe à F."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b4f86d6-5b0f-340a-a9b3-0c412e9b4ca1",
                        "entry_id": "f3fac24b-5b8a-3420-aed7-9fe39d55d547",
                        "glosses": [
                            "Qualifie une paire d'espaces topologiques reliés par un homéomorphisme."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "44a657dd-015c-48b7-b067-8d03aceb6d8d",
                                "sense_id": "4b4f86d6-5b0f-340a-a9b3-0c412e9b4ca1",
                                "text": "Les deux espaces E et F sont homéomorphes s’il existe un homéomorphisme entre E et F."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1287efa6-27aa-4043-85c4-86a9c8a52c2c",
