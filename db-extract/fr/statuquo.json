                                "example_id": "bdde6718-49d6-462e-ac59-577f9b6f2b18",
                                "sense_id": "dea97c6d-7918-3ad7-bcfc-49c1c0376cd2",
                                "text": "Il existe trois types de résultats: La réussite, l'échec et le statuquo."
                            },
                            {
                                "example_id": "490027e8-3916-427e-9fb3-3e037a06dfea",
                                "sense_id": "dea97c6d-7918-3ad7-bcfc-49c1c0376cd2",
                                "text": "L’un des plus ahurissants paradoxes du débat sur l’assurance santé, c’est le fait que le président Obama proclame s’attaquer au statuquo, alors qu’en fait, il l’entretient."
                            }
                        ]
                    }
