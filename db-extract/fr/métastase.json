        "fr-extract.jsonl": [
            {
                "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                "word": "métastase",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f206af7c-2386-4104-a286-6ed5305e1e46",
                        "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                        "tags": [
                            "plural"
                        ],
                        "form": "métastases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                        "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                        "glosses": [
                            "Croissance d’un organisme pathogène ou d’une cellule tumorale à distance du site initialement atteint."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f55fbcea-6ec1-4045-b3e6-37ac1583889b",
                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                "text": "L’urographie intraveineuse montrait, de son côté, une dilatation de l’uretère, le non-fonctionnement du rein droit cependant que la radiographie du thorax révélait des métastases circutuelles…"
                            },
                            {
                                "example_id": "9f4a6025-edd6-436e-be11-851709e38bd1",
                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                "text": "L’opération s’était bien passée, bien qu’il ait fallu lui enlever deux côtes, sur lesquelles des métastases s’étaient développées."
                            },
                            {
                                "example_id": "3c0ba7f6-987d-4f6b-9338-f1821272a94a",
                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                "text": "Un an plus tôt, elle a été opérée pour un cancer du sein. Aucune métastase n'a été trouvée."
                            },
                            {
                                "example_id": "478704d9-6976-485c-be62-a967ebf05775",
                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                "text": "Cette tumeur primitive libère ensuite d’autres cellules cancéreuses, qui se déplacent dans la circulation sanguine (ou lymphatique) jusqu'à un tissu ou un organe éloigné pour y former des tumeurs secondaires appelées métastases."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe97fd64-504c-3434-a334-96ae5f3f54fb",
                        "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                        "glosses": [
                            "Figure de rhétorique qui consiste dans son discours à rejeter sur d'autre des fautes, des erreurs que l'on a commises et que l'on est forcé d'admettre."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1959c7a9-beac-431b-ab57-3017807cf48a",
                        "source_entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                        "source_sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                        "source_sense_description": "Croissance d’un organisme pathogène",
                        "target_lang_word": "Metastase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metastase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faf8130a-d535-394c-b980-7fed088dd12b",
                                        "entry_id": "1c55ed04-645d-3300-9fa6-7d9043df33ab",
                                        "glosses": [
                                            "auf Grund der Verschleppung von Materie innerhalb eines Organismus neu entstandener, zusätzlicher Krankheitsherd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83020c8f-3415-4862-b26c-46725ac1dae1",
                                                "sense_id": "faf8130a-d535-394c-b980-7fed088dd12b",
                                                "text": "Metastasen entstehen durch die Verschleppung belebter Materie, wie körpereigener Zellen oder Bakterien, aber auch durch die Verschleppung unbelebter Stoffe wie Pigmenten oder Kalk."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                        "entry_id": "1c55ed04-645d-3300-9fa6-7d9043df33ab",
                                        "glosses": [
                                            "durch Verschleppung von Tumorzellen neu entstandener, bösartiger Tumor"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3854ad-9f8a-4a4a-95c8-c2b8f74a0dc3",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "Da der Tumor bereits Metastasen gebildet hat, ist die Heilungschance erheblich verschlechtert."
                                            },
                                            {
                                                "example_id": "828accf8-204a-49a3-9ab2-1bd54e3c58d8",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "Mit bildgebenden Verfahren wurde nach Metastasen in der Leber gesucht."
                                            },
                                            {
                                                "example_id": "d2e7b23b-cecc-4c6f-a207-ad7592b864fd",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "„Der Blasenkrebs war bereits ins letzte Stadium getreten, als Herd und Metastasen von Doktor Aaron entdeckt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "946e2543-2153-4fb0-9b5c-b26df2cc4f08",
