    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "65c7057a-8e6a-370d-afc7-725802ef4a67",
                "word": "oncoming",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                        "entry_id": "65c7057a-8e6a-370d-afc7-725802ef4a67",
                        "glosses": [
                            "approaching; coming closer"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "87346e21-a840-4356-902d-2827cb38c51e",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "Look carefully before pulling out into oncoming traffic."
                            },
                            {
                                "example_id": "0a4946dd-5600-4044-84a1-5644096602d0",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "1894, Ivan Dexter, Talmud: A Strange Narrative of Central Australia, published in serial form in Port Adelaide News and Lefevre's Peninsula Advertiser (SA), Chapter XIII, http://gutenberg.net.au/ebooks16/1600641.txt\nThe attack was made so unexpectedly that Garfield had no time to escape the oncoming spears, three of which struck him in the body."
                            },
                            {
                                "example_id": "495d9168-1231-4211-9de0-da1e2747185e",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "A bitter easterly breeze blew with a threat of oncoming winter."
                            },
                            {
                                "example_id": "257b0d8e-c45e-40e6-bf86-2833523f7310",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "For example, when trailers containing new automobiles were first piggybacked two areas of potential damage became evident: (1) diesel locomotive exhaust left a film of oil on the new autos; and (2) auto windshields could be scarred or cracked by the metal-tipped \"tell-tales\" which warn men atop trains of oncoming bridges or tunnels."
                            },
                            {
                                "example_id": "8b21b174-b08c-4fde-9e3b-11893b5b229e",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "A healthier, stronger individual can deal with it better and is less frightened by oncoming death when it is still \"miles away\" than when it \"is right in front of the door,\" as one of our patients put it so appropriately."
                            },
                            {
                                "example_id": "04b1c105-b88e-492e-a5d2-f06d03974226",
                                "sense_id": "7f754dcf-b9b6-3a9b-a0aa-d0e126f51a18",
                                "text": "Because it had not taken place immediately, the oncoming fight would lack spontaneity; it would be calculated, uninspired, and deadly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fd6c935-26a2-4ffe-aed7-7cd7251315e7",
                        "source_entry_id": "65c7057a-8e6a-370d-afc7-725802ef4a67",
