        "fr-extract.jsonl": [
            {
                "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                "word": "perversité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3b9bbea-1f7f-466e-8530-3a88416a883e",
                        "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                        "tags": [
                            "plural"
                        ],
                        "form": "perversités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                        "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                        "glosses": [
                            "Caractère de celui qui est pervers, qui a de la complaisance pour la dépravation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54aaf33-26da-4e08-a4b1-626fea688325",
                                "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                                "text": "Suis-je une brute inconsciente, livrée au despotisme de l’instinct, vouée au fatalisme de la perversité ? Un fou que le sang attire comme des lèvres de femme, et qui se rue au meurtre, comme on se rue à l’amour ?"
                            },
                            {
                                "example_id": "546a61fe-53d4-488d-9504-93ff46e09afe",
                                "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                                "text": "Cet homme est d’une profonde perversité."
                            }
                        ]
                    },
                    {
                        "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                        "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                        "glosses": [
                            "Nature de ce qui est pervers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e4add2-c9df-4b48-ac43-ed28f0452269",
                                "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                                "text": "La perversité de l’esprit. — La perversité de ses principes, de ses conseils."
                            },
                            {
                                "example_id": "1dd3575c-aeaa-450d-bfba-32aa68f386cd",
                                "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                                "text": "Mais la particularité des temps présents est de devoir se battre à la fois contre des actes et contre une communication d’une perversité extrême puisqu'elle prétend le contraire de ce qui est réellement fait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85d1bff-061c-42d4-bb66-b47fa6535ccd",
                        "source_entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                        "target_lang_word": "perversity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perversity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfab4201-726c-38c8-94af-f56eb48b6714",
                                        "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                                        "glosses": [
                                            "The quality of being perverse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0e13ba8-4d74-4e29-a042-6cc73e4fd7bc",
                                                "sense_id": "dfab4201-726c-38c8-94af-f56eb48b6714",
                                                "text": "Hey kids, the word of the week is \"pupaphobia\"! Others may enjoy being frightened by chainsaw-wielding maniacs and cannibal clowns, but my Halloween is never complete without a murderous Muppet or two. Thankfully, a pair of events last Friday the 13th provided a perfect double feature of puppet perversity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                                        "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                                        "glosses": [
                                            "Something which is perverse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "568a7f01-05ce-4163-92bb-db81bda3adeb",
                                                "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                                                "text": "More generally, for the ULD property to hold, the substitution effects (which are always well behaved) must be large enough to overcome possible “perversities” coming from the wealth effects."
                                            },
                                            {
                                                "example_id": "104cd353-8c8b-4746-bee1-bc0ed6ff012a",
                                                "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                                                "text": "“Of all this world's perversities, there is only one I cannot abide: the kink-shame. I'm off!” “You can't walk out! I'm walking out!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
