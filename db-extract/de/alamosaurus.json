                "senses": [
                    {
                        "sense_id": "5193d661-3989-37d6-868c-89f28436dae8",
                        "entry_id": "8bc09a13-9d29-32e8-8e35-cd09982b8084",
                        "glosses": [
                            "Vertreter einer Gattung großer pflanzenfressender Dinosaurier aus der späten Kreidezeit"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "728ca1d6-1693-4d53-b91f-6078c1c77705",
                                "sense_id": "5193d661-3989-37d6-868c-89f28436dae8",
                                "text": "„Alamosaurus ist der einzigste bisher gefundene Sauropode, der in der späten Kreidezeit des heutigen Nordamerika lebte. Er gilt gleichzeitig als einer der letzten großen Sauropoden vor dem großen Massenaussterben am Ende der Kreidezeit.“"
                            },
                            {
                                "example_id": "5ab392f0-5b40-4a55-9e8d-3c30d93982bf",
                                "sense_id": "5193d661-3989-37d6-868c-89f28436dae8",
                                "text": "„Paläontologen vermuten, dass es sich bei dem Skelett, das bereits 1996 in einem abgelegenen Teil des 3200 Quadratkilometer großen Parks ausgegraben worden war, um einen riesigen Alamosaurus handeln könnte.“"
                            },
                            {
                                "example_id": "3aaef8d1-1ff4-4056-b137-7ec3b4637759",
                                "sense_id": "5193d661-3989-37d6-868c-89f28436dae8",
                                "text": "„Alamosaurier gehören damit zu den größten Tiere, die jemals die Erdoberfläche betreten haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
