        "fr-extract.jsonl": [
            {
                "entry_id": "bdd890e0-1028-3613-8d37-b8be38181f44",
                "word": "mésamour",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0723914d-1d1f-4621-a325-bcebaa7ba8c9",
                        "entry_id": "bdd890e0-1028-3613-8d37-b8be38181f44",
                        "tags": [
                            "plural"
                        ],
                        "form": "mésamours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a134ed9-7478-38a1-b8d5-d3b7284ab3b2",
                        "entry_id": "bdd890e0-1028-3613-8d37-b8be38181f44",
                        "glosses": [
                            "Mésentente amoureuse ; amour brisé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "517c2065-91d1-43fe-8474-571a121ac083",
                                "sense_id": "7a134ed9-7478-38a1-b8d5-d3b7284ab3b2",
                                "text": "[…] ils sont peut-être trois mille à quatre mille, si on leur associe les jeunes gens partis faire « le djihad » en Syrie depuis trois ans — mais ils ne sont pas isolables et isolés de dizaines — voire de centaines — de milliers de jeunes gens qui sont dans le « mésamour », le ressentiment, la colère et parfois la haine à l'égard d'une France regardée de plus en plus comme une terre ennemie de l'islam, une terre d'impiété, une nation de croisés malgré sa déchristianisation massive."
                            },
                            {
                                "example_id": "7f7b542f-506e-4bb1-a609-bf5b5563a92a",
                                "sense_id": "7a134ed9-7478-38a1-b8d5-d3b7284ab3b2",
                                "text": "Sans effacer ce qui a produit un sentiment de mésamour, le (re)considérer permet de le mettre à distance, de cicatriser les plaies occasionnées, de transformer une expérience négative car douloureuse en expérience moins douloureuse […]."
                            },
                            {
                                "example_id": "e42dc606-57ae-40e4-8627-f14add3b2950",
                                "sense_id": "7a134ed9-7478-38a1-b8d5-d3b7284ab3b2",
                                "text": "J'avais beau écouter cette phrase chaque jour et m'efforcer de l'intégrer presque avec violence, je ne pouvais me soustraire au désir de sa voix tant les nuits sans lui, étaient des successions de mésamours."
                            }
                        ]
                    }
                ],
