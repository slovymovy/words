                        "translation_id": "7f908e97-5c82-4a9e-b41a-f81d5fd1092d",
                        "source_entry_id": "cc6f8b32-7b98-3832-8ec1-335b775dbe90",
                        "source_sense_id": "658a2fa9-390e-395b-961c-5d7bd8db38f5",
                        "source_sense_description": "einem Pavian (körperlich oder geistig) ähnlich",
                        "target_lang_word": "affenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                        "entry_id": "cf9a48e0-8253-3d06-80f0-b440558602a0",
                                        "glosses": [
                                            "an einen Affen erinnernd, wie ein Affe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bf2359-9148-4bed-b435-d20b7938a00c",
                                                "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                                "text": "„Die Gesichtszüge wachsen nicht nur, sondern nehmen ein fast affenartiges Aussehen an, und mit fortschreitender Krankheit nimmt selbst der Schädel annähernd Affenformen an.“"
                                            },
                                            {
                                                "example_id": "1e592a32-3310-4fa6-a5b6-487b993fdb43",
                                                "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                                "text": "„In der CIA bezeichnete man Leute wie ihn oft abschätzig als ›Arbeitsschimpansen‹, weil sie mit affenartigem Geschick die ›manuellen‹ Aufgaben wie das Installieren von Wanzen erledigten oder paramilitärische Aktionen durchführten.“"
                                            },
                                            {
                                                "example_id": "7871bc79-f52c-4112-b964-d5782f0b73ab",
                                                "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                                "text": "„Es schien, als vermochten selbst die Voormis mit ihrer affenartigen Gewandtheit diese Steilklippe kaum zu erklimmen.“"
                                            },
                                            {
                                                "example_id": "e1456e18-8dc9-4305-8bc0-bed0fe2970e4",
                                                "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                                "text": "„Ein affenartiger Buckliger trug in seinen Armen eine atemberaubend schöne Frau, die ohnmächtig war, und ging mit ihr in ein nicht sehr düsteres Kellergeschoss, wo er sie vorsichtig auf einen Tisch legte.“"
                                            },
                                            {
                                                "example_id": "be1c3509-3f1b-436b-82cd-b1d58269c31b",
                                                "sense_id": "b8d238c5-fdf0-350a-9eb8-708b56995faa",
                                                "text": "„Ohne in Lewis' Richtung zu schauen, schloss es ruhig die Tür hinter sich und überquerte den Hof, wobei sich sein Gang innerhalb dieser wenigen Schritte von einem affenartigen Geschlinger zu dem trippelnden Gewatschel verwandelte, mit dem es das Menschsein simulierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fcce634-7587-4d55-bcce-9e6e8f070762",
                        "source_entry_id": "cc6f8b32-7b98-3832-8ec1-335b775dbe90",
