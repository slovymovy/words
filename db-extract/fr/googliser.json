                "senses": [
                    {
                        "sense_id": "463ff257-f25a-3872-83bb-680b2b9a07d0",
                        "entry_id": "c3284293-cb69-3324-b3d4-b61676d4d89f",
                        "glosses": [
                            "Rechercher sur Internet en utilisant Google."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4568d8a8-20b6-4275-ac0d-297dc5dcdc94",
                                "sense_id": "463ff257-f25a-3872-83bb-680b2b9a07d0",
                                "text": "Se faire «googliser» par son employeur est désormais monnaie courante, mais cette pratique peut réserver quelques mauvaises surprises."
                            },
                            {
                                "example_id": "3f091a95-9df2-414f-8a55-1384c3869a31",
                                "sense_id": "463ff257-f25a-3872-83bb-680b2b9a07d0",
                                "text": "Les recruteurs doivent s'interdire de googliser les candidats"
                            },
                            {
                                "example_id": "b461f094-4914-4d45-90df-213dcc1ee5f0",
                                "sense_id": "463ff257-f25a-3872-83bb-680b2b9a07d0",
                                "text": "Un inconnu me prête son appartement, vous ne m’en voudrez pas de vous avoir googlisé ?"
                            }
                        ]
