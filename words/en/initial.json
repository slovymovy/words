            "senses": [
                {
                    "sense_id": "c1a22794-5fa9-3ea9-9108-be9b59030e72",
                    "sense_definition": "To mark a document with the first letters of one's name to show acknowledgement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>initial</w> each page of the contract before signing it.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>парафировать</w> каждую страницу контракта перед подписанием.",
                                "zh": "在签署合同之前，你需要<w>签署首字母</w>在每一页上。"
                            }
                        },
                        {
                            "text": "Please <w>initial</w> the changes to confirm that you accept them.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поставьте инициалы</w> рядом с изменениями, чтобы подтвердить, что вы их принимаете.",
                                "zh": "请在修改处<w>签署首字母</w>以确认你接受这些变动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "initial the contract",
                        "initial here"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помечать документ первыми буквами своего имени в знак подтверждения.",
                        "zh": "在文件上签署姓名首字母以示确认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парафи́ровать",
                                "target_lang_sense_clarification": "официально визировать инициалами"
                            },
                            {
