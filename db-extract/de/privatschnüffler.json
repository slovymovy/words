                        "examples": [
                            {
                                "example_id": "d90d0d4f-05c4-4a37-b61b-5393c097464f",
                                "sense_id": "366e60b5-08cc-3a45-891a-b6c24bda04bd",
                                "text": "„Shaw brauchte Mulliner zwar nicht von sich zu überzeugen, wie ein Privatschnüffler dies bei einem neuen Klienten tun würde, war aber auf Informationen angewiesen.“"
                            },
                            {
                                "example_id": "f9d4de9d-2075-4650-97b2-3aa765c69306",
                                "sense_id": "366e60b5-08cc-3a45-891a-b6c24bda04bd",
                                "text": "„›Sie sind ein abgehalfterter Privatschnüffler, der glaubt, er könnte sich alles erlauben und würde damit durchkommen, nur weil man seine Tochter getötet hat.‹“"
                            }
                        ],
