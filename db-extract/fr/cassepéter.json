                        "examples": [
                            {
                                "example_id": "506f76c6-275b-45ae-a84f-9155dcc2b5d7",
                                "sense_id": "b8bd4c4f-4986-3087-b5ee-e2f90e7be05c",
                                "text": "[Mon crâne est] couvert d’un tarbouch rouge qui cassepète de couleur rouge et m’a fait les premiers jours cassepéter de chaleur."
                            },
                            {
                                "example_id": "f380f2a6-9233-46c4-8909-b740d67093e8",
                                "sense_id": "b8bd4c4f-4986-3087-b5ee-e2f90e7be05c",
                                "text": "Je cassepète du besoin de te dire mon surnom."
                            },
                            {
                                "example_id": "4348d680-5b3d-4722-9939-0ef441b368f6",
                                "sense_id": "b8bd4c4f-4986-3087-b5ee-e2f90e7be05c",
                                "text": "J’ai vu Thèbes, vieux ; c’est bien beau. Nous y sommes arrivés un soir à 9 heures, par un clair de lune qui cassepétait sur les colonnes."
                            }
                        ]
                    }
