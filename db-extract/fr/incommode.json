        "fr-extract.jsonl": [
            {
                "entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                "word": "incommode",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c50092d-7955-46bd-bacf-7b94ae77b530",
                        "entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incommodes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5a30644-c1e7-34fa-b844-5d77b9f82c71",
                        "entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                        "glosses": [
                            "Qui n’est pas commode, dont l’usage cause la gêne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe2c41f7-8235-429d-a095-7610804180e9",
                                "sense_id": "f5a30644-c1e7-34fa-b844-5d77b9f82c71",
                                "text": "Le toit est plat ; l’escalier est en bois, très grossier et très incommode."
                            },
                            {
                                "example_id": "dc453255-a89f-486e-b168-0f69b02ef40c",
                                "sense_id": "f5a30644-c1e7-34fa-b844-5d77b9f82c71",
                                "text": "Elles apitoyaient : leurs vêtements incommodes, effrangés par les broussailles, salis de terre rouge, étaient indignes d’épouses de prêtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6a7ab30-5c48-329c-837b-917f68821387",
                        "entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                        "glosses": [
                            "Qui cause du malaise, de la fatigue, de l’ennui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983eb3da-eee6-40be-b490-62317c1bc183",
                                "sense_id": "d6a7ab30-5c48-329c-837b-917f68821387",
                                "text": "L’intensité du froid avait d’ailleurs fait de cette neige une poussière, assez incommode au marcheur."
                            },
                            {
                                "example_id": "7069cee5-549c-429e-8951-0f1bad524318",
                                "sense_id": "d6a7ab30-5c48-329c-837b-917f68821387",
                                "text": "Le voyageur se tenait assis ou accroupi sur la selle, dans une posture incommode, tandis qu’un domestique conduisait l’animal par la bride."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c232cd4-5c40-33aa-a8b7-9478590e0456",
                        "entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                        "glosses": [
                            "Qui est importun, en parlant d’une personne ou d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309f232e-d246-408b-8a81-b4ece811ff71",
                                "sense_id": "6c232cd4-5c40-33aa-a8b7-9478590e0456",
                                "text": "Il n’y a point de sots si incommodes que ceux qui ont de l’esprit."
                            },
                            {
                                "example_id": "e32e25c7-849c-4a28-92b5-9b05b828b127",
                                "sense_id": "6c232cd4-5c40-33aa-a8b7-9478590e0456",
                                "text": "Il trouvait qu’il y avait plus de naturel qu’à Paris ; mais, par une conséquence naturelle, les sots étaient bien plus incommodes à Nancy."
                            },
                            {
                                "example_id": "11fdd555-023c-448f-a3a3-fd6d112bba66",
                                "sense_id": "6c232cd4-5c40-33aa-a8b7-9478590e0456",
                                "text": "Près de Saigon, un couple de tigres rôdait naguère aux environs des forts du sud. La garnison résolut de se débarrasser de ces voisins incommodes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "699d80ce-925c-46ca-b545-190522519885",
                        "source_entry_id": "50bd6c74-b0da-3f1e-a3b2-a7c69982d3f4",
                        "target_lang_word": "uncomfortable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncomfortable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3621be-528f-30c1-a874-0df7c7231b92",
                                        "entry_id": "d8385166-22a2-38c7-b5a4-49da29ab21f3",
                                        "glosses": [
                                            "Not comfortable; causing discomfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8a72ea-4055-4548-af54-437364efd910",
                                                "sense_id": "fd3621be-528f-30c1-a874-0df7c7231b92",
                                                "text": "The class squirmed and fidgeted in the uncomfortable new chairs."
                                            },
                                            {
                                                "example_id": "c436645d-5d54-46cc-8a06-2886a7f9ca32",
                                                "sense_id": "fd3621be-528f-30c1-a874-0df7c7231b92",
                                                "text": "Edward Churchill still attended to his work in a hopeless mechanical manner like a sleep-walker who walks safely on a well-known round. But his Roman collar galled him, his cossack stifled him, his biretta was as uncomfortable as a merry-andrew's cap and bells."
                                            },
                                            {
                                                "example_id": "4d603b33-c10d-4dd7-84c0-ae88f27e9590",
                                                "sense_id": "fd3621be-528f-30c1-a874-0df7c7231b92",
                                                "text": "The coaches were filthy outside and did not appear to have been painted or washed for years. Inside there were uncomfortable seats covered with a cane-like material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8efd3fbd-bef0-3b57-a9d1-4a9ec15a05a9",
                                        "entry_id": "d8385166-22a2-38c7-b5a4-49da29ab21f3",
                                        "glosses": [
                                            "Experiencing discomfort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16f89f1b-0239-386a-b7b7-1c895d19f71f",
                                        "entry_id": "d8385166-22a2-38c7-b5a4-49da29ab21f3",
                                        "glosses": [
                                            "Uneasy or anxious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b917d77c-a6af-45fe-b19c-2696f290059e",
                                                "sense_id": "16f89f1b-0239-386a-b7b7-1c895d19f71f",
                                                "text": "Sharing a house with them made me uncomfortable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78943439-1de6-3872-a240-062d9d366acc",
                                        "entry_id": "d8385166-22a2-38c7-b5a4-49da29ab21f3",
                                        "glosses": [
                                            "Put off or disgusted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
