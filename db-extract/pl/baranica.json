                        "examples": [
                            {
                                "example_id": "805c4698-1454-4a80-a52f-9c4bb678fcd5",
                                "sense_id": "2eb88d3d-fc4d-3d04-b353-2b6deef59a7c",
                                "text": "Wdział na głowę baranicę i spiesznie wyszedł z izby.",
                                "translation": "Nasadil si na hlavu beranici a spěšně vyšel z pokoje."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d14b6d7-1fd4-37ea-a7bb-2de9468a96d8",
