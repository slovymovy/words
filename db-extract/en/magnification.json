                        "entry_id": "9f5d7b9c-866d-3e07-8e8a-5d3dacf67d65",
                        "glosses": [
                            "The act of magnifying; enlargement; exaggeration."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "55d636b9-ceb5-4870-8c67-f10139528317",
                                "sense_id": "a84ddc1f-1001-38c7-b9e8-ea997d4ea3e6",
                                "text": "His story included a magnification of the events."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dc56fda-826d-36e2-8585-2887196a40a7",
                        "entry_id": "9f5d7b9c-866d-3e07-8e8a-5d3dacf67d65",
                        "glosses": [
                            "The apparent enlargement of an object in an image, for example using a lens, or by zooming in on a computer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
