                    {
                        "sense_id": "41c66087-ec85-3629-b8a4-cebef12ad3b6",
                        "entry_id": "696bfa0d-063c-385e-8486-5af2263e49df",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc85a09-9625-445c-811b-a37a28a44571",
                                "sense_id": "41c66087-ec85-3629-b8a4-cebef12ad3b6",
                                "text": "„Leon“ ist ein sehr beliebter Jungenname."
                            },
                            {
                                "example_id": "ef684ab8-521d-4b9a-aa68-0170695a603e",
                                "sense_id": "41c66087-ec85-3629-b8a4-cebef12ad3b6",
                                "text": "„Hier zusammenfassend werden die jeweils ersten zehn Mädchen- und Jungennamen 2011 aufgeführt…“"
                            },
                            {
                                "example_id": "2dcbe661-eb10-4d78-b1b6-8fb8131e7be8",
                                "sense_id": "41c66087-ec85-3629-b8a4-cebef12ad3b6",
                                "text": "„Gegenüber dem Vorjahr haben sich nur wenige Veränderungen in der Häufigkeitsrangfolge der Jungennamen ergeben.“"
                            },
                            {
                                "example_id": "9abf7248-7857-4754-af01-86a87f034929",
                                "sense_id": "41c66087-ec85-3629-b8a4-cebef12ad3b6",
                                "text": "„Modenamen kommen und gehen, doch läßt sich bei den Jungennamen eine gewisse Konstanz beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
