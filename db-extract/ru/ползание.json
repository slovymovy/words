                                    },
                                    {
                                        "sense_id": "581c0c9a-d40f-319e-b9ba-baec133413e2",
                                        "entry_id": "714142a6-56cb-3cea-a11d-3d6b64fc2e34",
                                        "glosses": [
                                            "An increase in strain with time; the gradual flow or deformation of a material under stress."
                                        ],
