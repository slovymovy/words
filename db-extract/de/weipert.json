                ],
                "senses": [
                    {
                        "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                        "entry_id": "e71004ac-8ba1-3490-a218-929f1e0a9669",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121f6551-76d4-46b8-ae18-91b86e0867e0",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Frau Weipert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "43136ecc-6894-4aa0-b0b3-bb3f71f8d96f",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Herr Weipert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5d144137-f90a-4d9e-96c1-798b9b964a0e",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Die Weiperts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3bd53785-ccce-459c-af6d-0d200c337298",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Der Weipert trägt nie die Pullover, die die Weipert ihm strickt."
                            },
                            {
                                "example_id": "9b233a81-0f57-451a-b534-092429612548",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weipert kommt, geht der Herr Weipert.“"
                            },
                            {
                                "example_id": "e6dfda09-611d-49f7-ab18-de7e09b1f18d",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Weipert kommt und geht."
                            },
                            {
                                "example_id": "8408b622-920a-4235-b220-c10b1116e5a4",
                                "sense_id": "42846b37-276a-380b-91ba-4c5cc9d5b0c4",
                                "text": "Weiperts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
