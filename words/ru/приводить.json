{
    "word_family": [
        "привод",
        "приведение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "313b13d6-7376-3aa9-917e-b2a28829e7d2",
                    "sense_definition": "Вести или сопровождать кого-либо, помогая добраться до определенного места",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро отец <приводит> сына в детский сад.",
                            "target_lang_translations": {
                                "en": "Every morning the father <brings> his son to kindergarten.",
                                "cs": "Každé ráno otec <přivádí> syna do školky."
                            }
                        },
                        {
                            "text": "Ты можешь <приводить> друзей к нам в гости по выходным.",
                            "target_lang_translations": {
                                "en": "You can <bring> friends over to visit us on weekends.",
                                "cs": "O víkendech můžeš <přivádět> kamarády k nám na návštěvu."
                            }
                        }
                    ],
                    "synonyms": [
                        "доставлять",
                        "вести"
                    ],
                    "antonyms": [
                        "уводить"
                    ],
                    "common_phrases": [
                        "приводить домой",
                        "приводить гостей",
                        "приводить ребенка",
                        "приводить врача"
                    ],
                    "target_lang_definitions": {
                        "en": "To lead or accompany someone to a specific place",
                        "cs": "Vést nebo doprovázet někoho, pomáhat mu dostat se na určité místo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "accompany someone to a place"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "escort someone to a destination"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přivádět",
                                "target_lang_sense_clarification": "doprovodit někoho někam"
                            },
                            {
                                "target_lang_word": "doprovázet",
                                "target_lang_sense_clarification": "jít s někým jako průvodce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3951158e-d541-3753-9f0d-2b2abfac629c",
                    "sense_definition": "Заставлять оказаться в каком-либо состоянии, изменять состояние или вид объекта",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change_of_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам нужно срочно <приводить> комнату в порядок перед праздником.",
                            "target_lang_translations": {
                                "en": "We need to urgently <put> the room in order before the holiday.",
                                "cs": "Před svátkem musíme pokoj urychleně <uvést> do pořádku."
                            }
                        },
                        {
                            "text": "Громкая музыка может <приводить> соседей в бешенство.",
                            "target_lang_translations": {
                                "en": "Loud music can <drive> the neighbors to a frenzy.",
                                "cs": "Hlasitá hudba může sousedy <dovádět> k šílenství."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приводить в порядок",
                        "приводить в чувство",
                        "приводить в восторг",
                        "приводить в исполнение",
                        "приводить в соответствие"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone or something to be in a certain state or condition",
                        "cs": "Způsobit, že se někdo nebo něco ocitne v určitém stavu nebo podmínkách."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "into a state (e.g., to order, to senses)"
                            },
                            {
                                "target_lang_word": "put",
                                "target_lang_sense_clarification": "into a condition (e.g., in order)"
                            },
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "to an emotional state (e.g., to frenzy)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "uvádět",
                                "target_lang_sense_clarification": "dostat do určitého stavu (např. do pořádku)"
                            },
                            {
                                "target_lang_word": "dostávat",
                                "target_lang_sense_clarification": "přivést do určitého stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a9a1532-a746-30f6-a450-26cb46fbc97e",
                    "sense_definition": "Быть причиной чего-либо, иметь что-либо своим следствием",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Упорный труд всегда <приводит> к хорошим результатам.",
                            "target_lang_translations": {
                                "en": "Hard work always <leads> to good results.",
                                "cs": "Usilovná práce vždy <vede> k dobrým výsledkům."
                            }
                        },
                        {
                            "text": "Невнимательность на дороге часто <приводит> к авариям.",
                            "target_lang_translations": {
                                "en": "Inattention on the road often <leads> to accidents.",
                                "cs": "Nepozornost na silnici často <vede> k nehodám."
                            }
                        }
                    ],
                    "synonyms": [
                        "вызывать",
                        "влечь"
                    ],
                    "common_phrases": [
                        "приводить к успеху",
                        "приводить к последствиям",
                        "приводить к выводу",
                        "приводить к конфликту"
                    ],
                    "target_lang_definitions": {
                        "en": "To be the cause of something or have something as a consequence",
                        "cs": "Být příčinou něčeho nebo mít něco jako následek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead to",
                                "target_lang_sense_clarification": "result in a specific outcome"
                            },
                            {
                                "target_lang_word": "result in",
                                "target_lang_sense_clarification": "cause an effect"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vést k",
                                "target_lang_sense_clarification": "mít za následek určitý výsledek"
                            },
                            {
                                "target_lang_word": "způsobovat",
                                "target_lang_sense_clarification": "být příčinou něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87b8d91c-fb49-31d6-abc3-3842e6acab5d",
                    "sense_definition": "Называть, сообщать или цитировать что-либо для подтверждения своих слов",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель любил <приводить> примеры из собственной жизни.",
                            "target_lang_translations": {
                                "en": "The teacher loved to <give> examples from his own life.",
                                "cs": "Učitel rád <uváděl> příklady ze svého vlastního života."
                            }
                        },
                        {
                            "text": "В споре необходимо <приводить> весомые аргументы.",
                            "target_lang_translations": {
                                "en": "In a dispute, it is necessary to <present> weighty arguments.",
                                "cs": "V hádce je nutné <uvádět> pádné argumenty."
                            }
                        }
                    ],
                    "synonyms": [
                        "цитировать",
                        "упоминать",
                        "указывать"
                    ],
                    "common_phrases": [
                        "приводить пример",
                        "приводить доказательства",
                        "приводить аргументы",
                        "приводить цитату",
                        "приводить факты"
                    ],
                    "target_lang_definitions": {
                        "en": "To mention or quote something to support one's words",
                        "cs": "Zmínit nebo citovat něco na podporu svých slov."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "quote as evidence or proof"
                            },
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "provide examples"
                            },
                            {
                                "target_lang_word": "present",
                                "target_lang_sense_clarification": "submit arguments or facts"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "uvádět",
                                "target_lang_sense_clarification": "předkládat argumenty nebo příklady"
                            },
                            {
                                "target_lang_word": "citovat",
                                "target_lang_sense_clarification": "doslovně opakovat něčí slova"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9304aa7e-cf9d-317a-96a0-d25dc91dcb1c",
                    "sense_definition": "Производить математические или логические преобразования для получения определенного вида",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Школьников учат <приводить> дроби к общему знаменателю.",
                            "target_lang_translations": {
                                "en": "Schoolchildren are taught to <reduce> fractions to a common denominator.",
                                "cs": "Žáky učí <převádět> zlomky na společného jmenovatele."
                            }
                        },
                        {
                            "text": "В этом уравнении нужно <приводить> подобные слагаемые.",
                            "target_lang_translations": {
                                "en": "In this equation, one needs to <collect> like terms.",
                                "cs": "V této rovnici je třeba <sloučit> podobné členy."
                            }
                        }
                    ],
                    "synonyms": [
                        "преобразовывать"
                    ],
                    "common_phrases": [
                        "приводить к знаменателю",
                        "приводить подобные слагаемые"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To perform mathematical or logical transformations to achieve a specific form",
                        "cs": "Provádět matematické nebo logické transformace pro dosažení určitého tvaru."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reduce",
                                "target_lang_sense_clarification": "fractions to a common denominator"
                            },
                            {
                                "target_lang_word": "collect",
                                "target_lang_sense_clarification": "like terms in an equation"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "převádět",
                                "target_lang_sense_clarification": "matematická úprava (např. na společného jmenovatele)"
                            },
                            {
                                "target_lang_word": "slučovat",
                                "target_lang_sense_clarification": "matematická úprava (např. podobné členy)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}