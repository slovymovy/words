                    "frequency": "High",
                    "semantic_group_id": "propriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre <w>appartient</w> à ma sœur depuis des années.",
                            "target_lang_translations": {
                                "en": "This book <w>has belonged to</w> my sister for years.",
                                "ru": "Эта книга уже много лет <w>принадлежит</w> моей сестре.",
                                "nl": "Dit boek <w>behoort</w> al jaren <w>toe</w> aan mijn zus.",
                                "de": "Dieses Buch <w>gehört</w> seit Jahren meiner Schwester.",
                                "pl": "Ta książka od lat <w>należy do</w> mojej siostry.",
                                "it": "Questo libro <w>appartiene</w> a mia sorella da anni.",
                                "cs": "Tato kniha <w>patří</w> mé sestře už roky.",
                                "tr": "Bu kitap yıllardır kız kardeşime <w>ait</w>.",
                                "es": "Este libro <w>pertenece</w> a mi hermana desde hace años.",
                                "zh": "这本书<w>属于</w>我妹妹已经好多年了。"
                            }
                        },
                        {
                            "text": "Cette vieille maison n'<w>appartient</w> plus à notre famille.",
                            "target_lang_translations": {
                                "en": "This old house no longer <w>belongs to</w> our family.",
                                "ru": "Этот старый дом больше не <w>принадлежит</w> нашей семье.",
                                "nl": "Dit oude huis <w>behoort</w> niet meer <w>toe</w> aan onze familie.",
                                "de": "Dieses alte Haus <w>gehört</w> unserer Familie nicht mehr.",
                                "pl": "Ten stary dom już <w>nie należy do</w> naszej rodziny.",
                                "it": "Questa vecchia casa non <w>appartiene</w> più alla nostra famiglia.",
                                "cs": "Tenhle starý dům naší rodině už <w>nepatří</w>.",
                                "tr": "Bu eski ev artık ailemize <w>ait değil</w>.",
                                "es": "Esta vieja casa ya no <w>pertenece</w> a nuestra familia.",
                                "zh": "这栋老房子已经不再<w>属于</w>我们家了。"
                            }
                        }
