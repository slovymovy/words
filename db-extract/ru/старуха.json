                    },
                    {
                        "translation_id": "2e6198a3-fb8c-4642-b55b-b8e2987f6916",
                        "source_entry_id": "ce2cd31d-9556-3e95-a427-701a8b60c147",
                        "target_lang_word": "old lady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "old lady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac09cc8-af9f-3cb1-830b-0d86cbec35c0",
                                        "entry_id": "e0ce9a7e-0209-3926-9e87-fd416f4e6feb",
                                        "glosses": [
                                            "An elderly woman."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5209ea1f-1592-416c-a431-8f5a78eaee1a",
                                                "sense_id": "6ac09cc8-af9f-3cb1-830b-0d86cbec35c0",
                                                "text": "Near-synonym: LOL"
                                            },
                                            {
                                                "example_id": "b96d7f01-0b2c-4539-9d4a-e842c9d5f1f1",
                                                "sense_id": "6ac09cc8-af9f-3cb1-830b-0d86cbec35c0",
                                                "text": "The door was opened by a little old lady."
                                            },
                                            {
                                                "example_id": "853546b6-75fb-4821-8101-b4ef193a807e",
                                                "sense_id": "6ac09cc8-af9f-3cb1-830b-0d86cbec35c0",
                                                "text": "A dear old lady said she thought the ancient castle at Conway most picturesque, but that it was a pity they put it so close to the railway!"
                                            },
                                            {
                                                "example_id": "3a72715a-9181-4460-8749-051dc37c57ea",
                                                "sense_id": "6ac09cc8-af9f-3cb1-830b-0d86cbec35c0",
                                                "text": "\"Ninety per cent of our passengers will know where they are going. They'll come in and do the same journey every day. Therefore, I always base Waterloo not on the commuter, but on the little old lady who's lost in the middle of the station and just wants some help."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd6c22b-6b46-3ef1-b05c-2f8145519de2",
                                        "entry_id": "e0ce9a7e-0209-3926-9e87-fd416f4e6feb",
                                        "glosses": [
                                            "One's mother."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d067eed-a069-4dc7-98ad-78b0d165793c",
                                                "sense_id": "ffd6c22b-6b46-3ef1-b05c-2f8145519de2",
                                                "text": "My old lady was fond of corporal punishment."
                                            },
                                            {
                                                "example_id": "7a9c013d-ae03-4f4a-be81-9ee4be45c6ce",
                                                "sense_id": "ffd6c22b-6b46-3ef1-b05c-2f8145519de2",
                                                "text": "‘I use the same back-hand flip me old man useda use to knock me old lady arse-over-’ead an’ Stiffer than Mo.’"
                                            },
                                            {
                                                "example_id": "bea91624-8bf1-47fe-acb3-3d188dac73a2",
                                                "sense_id": "ffd6c22b-6b46-3ef1-b05c-2f8145519de2",
                                                "text": "I swiped it from the old lady's liquor cabinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3d240c-edd7-3c2d-90af-fc1d2424c83d",
                                        "entry_id": "e0ce9a7e-0209-3926-9e87-fd416f4e6feb",
                                        "glosses": [
                                            "One's girlfriend, wife or significant other."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b882dd-64f8-419f-9fd9-a48dc88c35eb",
                                                "sense_id": "0d3d240c-edd7-3c2d-90af-fc1d2424c83d",
                                                "text": "His wife was asking where their savings account balance had gone, but the way he put it was that his old lady was ragging him about his pay rate."
                                            },
                                            {
                                                "example_id": "618ec049-44ad-4a3d-b7c4-afe607702e5e",
                                                "sense_id": "0d3d240c-edd7-3c2d-90af-fc1d2424c83d",
                                                "text": "“[…] Now if that thing is balling—and your old lady or your old man is off somewhere flashing and doesn't want to be touched—well, you get put down on acid, you can be on a bummer for months.”"
                                            },
                                            {
                                                "example_id": "67799dc1-d769-4478-b0b9-8a44ad1c362e",
                                                "sense_id": "0d3d240c-edd7-3c2d-90af-fc1d2424c83d",
                                                "text": "But you know it could be a hassle / Trying to explain myself to a police officer / About how it was your old lady got herself stiffed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b3bbf6-e4bd-3cdb-84e7-d6ada867e554",
                                        "entry_id": "e0ce9a7e-0209-3926-9e87-fd416f4e6feb",
                                        "glosses": [
                                            "The Bank of England, sometimes referred to as the “Old Lady of Threadneedle Street” or simply “The Old Lady”."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15e923c4-6771-3c2b-9ea7-8c181ca7694c",
                                        "entry_id": "e0ce9a7e-0209-3926-9e87-fd416f4e6feb",
                                        "glosses": [
                                            "A queen."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0767a9f-6f5a-47ed-8fcc-2b0a5f3ab3c8",
                                                "sense_id": "15e923c4-6771-3c2b-9ea7-8c181ca7694c",
                                                "text": "Watch out for that old lady waiting for you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
