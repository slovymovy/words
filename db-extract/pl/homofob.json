                        "translation_id": "9e6dd1fa-ea63-4684-be60-acf0063a5b91",
                        "source_entry_id": "3591c30b-d230-386e-b9a4-7d08dd6f1406",
                        "source_sense_id": "bb739174-0ad7-3b3c-aeb8-02255d93d303",
                        "target_lang_word": "homophobe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homophobe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2b19566-ccac-323a-a2f6-ba7cf9a39690",
                                        "entry_id": "e809bfa6-4a5e-3ee0-a6e1-5ea647f02158",
                                        "glosses": [
                                            "One who is prejudiced against homosexual people, or LGBTQ people in general; one who exhibits homophobia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ab18d3-d524-47c6-a98b-c2dc39dda717",
                                                "sense_id": "d2b19566-ccac-323a-a2f6-ba7cf9a39690",
                                                "text": "That one can love another of the same gender, that is what the homophobe really cannot stand."
                                            },
                                            {
                                                "example_id": "d74aeefd-04c9-4b52-93aa-24f007b147ea",
                                                "sense_id": "d2b19566-ccac-323a-a2f6-ba7cf9a39690",
                                                "text": "If you're against gay marriage, just be honest, put a scarlet 'H' on your shirt, and say, \"I am a homophobe!\""
                                            },
                                            {
                                                "example_id": "6a375b48-d49d-4ea2-aeb4-f566b9ea9f67",
                                                "sense_id": "d2b19566-ccac-323a-a2f6-ba7cf9a39690",
                                                "text": "To me, Ennis stands for the conservative side of America. He's the biggest homophobe in the whole movie — culturally and psychologically — but by the time he admits his feelings, it's too late."
                                            },
                                            {
                                                "example_id": "4a5c1548-f4cd-4b46-b63f-62b13797a0ff",
                                                "sense_id": "d2b19566-ccac-323a-a2f6-ba7cf9a39690",
                                                "text": "Narrators demonstrated resistance coping techniques through direct confrontation with aggressors, such as racists, sexists, homophobes, elitists, and misogynoirists."
                                            }
                                        ]
                                    }
                                ]
                            },
