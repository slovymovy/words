                "senses": [
                    {
                        "sense_id": "7eaf6fbc-3423-322d-93f3-4d38c7fdbf7a",
                        "entry_id": "a59aeae3-a9a8-30cb-9caf-467f1146d3f2",
                        "glosses": [
                            "Relating to, or supported by two groups, especially by two political parties."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "deba6c86-8fe1-4760-91d6-4bb28bafef13",
                                "sense_id": "7eaf6fbc-3423-322d-93f3-4d38c7fdbf7a",
                                "text": "a bipartisan bill"
                            },
                            {
                                "example_id": "69ce8073-771a-48a1-bb12-f9bf1276d485",
                                "sense_id": "7eaf6fbc-3423-322d-93f3-4d38c7fdbf7a",
                                "text": "The derision for this bipartisan bill is—sigh—bipartisan. Hugh Hewitt scoffs at the idea that employers will respond to a $1000 gimmick."
                            },
                            {
                                "example_id": "014074b0-27d9-40f1-a4d8-e2ba6e3c4c6d",
                                "sense_id": "7eaf6fbc-3423-322d-93f3-4d38c7fdbf7a",
                                "text": "As a city with over two centuries of rail expertise and home to the country's largest train factory, this announcement received bipartisan support."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d24616-c353-4140-9b67-b477f992cacd",
                        "source_entry_id": "a59aeae3-a9a8-30cb-9caf-467f1146d3f2",
                        "source_sense_id": "7eaf6fbc-3423-322d-93f3-4d38c7fdbf7a",
