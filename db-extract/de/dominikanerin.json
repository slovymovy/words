                    {
                        "sense_id": "862749f4-5359-3486-8f8a-adb12ea9e4bd",
                        "entry_id": "44052d7f-b94a-3f0e-b9c7-442a64a30014",
                        "glosses": [
                            "Staatsbürgerin der Dominikanischen Republik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc8c251-41c6-4b27-af59-ce353bd975d6",
                                "sense_id": "862749f4-5359-3486-8f8a-adb12ea9e4bd",
                                "text": "Bei unserem Urlaub in der Dominikanischen Republik haben wir in einem sehr schmucken Hotel gewohnt, das von einer Dominikanerin geführt wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a745b9a-ce44-3a12-8ca7-30ecf8eb3d37",
                        "entry_id": "44052d7f-b94a-3f0e-b9c7-442a64a30014",
                        "glosses": [
                            "Mitglied des Nonnenordens der Dominikanerinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6511fc-03db-4ec6-a3a9-d390ade94ea1",
                                "sense_id": "6a745b9a-ce44-3a12-8ca7-30ecf8eb3d37",
                                "text": "„Trotzdem ist auch bei den Dominikanerinnen nicht unbedingt Halligalli angesagt. »Gehorsam, Keuschheit in Ehelosigkeit und Armut« lautet das Gelübde des Ordens“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07304e90-e606-415c-a024-0177fda1019e",
