    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2c75bb8-19cf-30bb-935c-521c63caef8b",
                    "sense_definition": "betrekking hebbend op een openbaar ambt of de functie van een ambtenaar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "officieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester nam een <w>ambtelijk</w> besluit over de nieuwe veiligheidsregels in de stad.",
                            "target_lang_translations": {
                                "en": "The mayor made an <w>official</w> decision regarding the new safety rules in the city."
                            }
                        },
                        {
                            "text": "Hij draagt zijn <w>ambtelijke</w> kleding alleen tijdens officiële ceremonies op het stadhuis.",
                            "target_lang_translations": {
                                "en": "He only wears his <w>official</w> attire during formal ceremonies at city hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "officieel",
                        "dienstig"
                    ],
                    "common_phrases": [
                        "ambtelijk besluit",
                        "ambtelijke status"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to a public office or the function of a civil servant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "official",
                                "target_lang_sense_clarification": "relating to an office or public trust"
                            },
                            {
                                "target_lang_word": "administrative",
                                "target_lang_sense_clarification": "relating to the management of an office or organization"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c72a72-4889-3762-9ab0-37d1d7d11ab0",
                    "sense_definition": "afkomstig van of uitgevoerd door een overheidsinstantie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "officieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder een <w>ambtelijk</w> bevel mag de politie de woning niet zomaar betreden.",
                            "target_lang_translations": {
                                "en": "Without an <w>official</w> warrant, the police may not simply enter the residence."
                            }
                        },
                        {
                            "text": "De organisatie wacht nog op de <w>ambtelijke</w> goedkeuring van de provincie voor het bouwproject.",
                            "target_lang_translations": {
                                "en": "The organization is still waiting for <w>governmental</w> approval from the province for the construction project."
                            }
                        }
                    ],
                    "synonyms": [
                        "formeel",
                        "overheidswege"
                    ],
                    "antonyms": [
                        "onofficieel",
                        "particulier"
                    ],
                    "common_phrases": [
                        "ambtelijk bevel",
                        "ambtelijke molen"
                    ],
                    "target_lang_definitions": {
                        "en": "originating from or carried out by a government agency"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "official",
                                "target_lang_sense_clarification": "authorized by an appropriate authority"
                            },
                            {
                                "target_lang_word": "governmental",
                                "target_lang_sense_clarification": "issued by the government"
                            },
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "officially sanctioned or recognized"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda7ca61-94ec-31fa-9bae-92158e59eeb9",
                    "sense_definition": "gekenmerkt door overdreven veel regels, procedures en traagheid",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bureaucratisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Om dit voorstel goedgekeurd te krijgen moet het eerst door de hele <w>ambtelijke</w> molen.",
                            "target_lang_translations": {
                                "en": "To get this proposal approved, it first has to go through the entire <w>bureaucratic</w> mill."
                            }
                        },
                        {
                            "text": "Veel burgers klagen over het <w>ambtelijke</w> taalgebruik in de brieven van de belastingdienst.",
                            "target_lang_translations": {
                                "en": "Many citizens complain about the <w>bureaucratic</w> language used in letters from the tax authorities."
                            }
                        }
                    ],
                    "synonyms": [
                        "bureaucratisch",
                        "stijf"
                    ],
                    "antonyms": [
                        "flexibel",
                        "vlot"
                    ],
                    "common_phrases": [
                        "ambtelijke molen",
                        "ambtelijk taalgebruik"
                    ],
                    "target_lang_definitions": {
                        "en": "characterized by excessive rules, procedures, and slowness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bureaucratic",
                                "target_lang_sense_clarification": "involving complicated and unnecessary rules"
                            },
                            {
                                "target_lang_word": "red-tape",
                                "target_lang_sense_clarification": "relating to excessive administrative hurdles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}