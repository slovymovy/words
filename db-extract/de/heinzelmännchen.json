                "senses": [
                    {
                        "sense_id": "2aab2496-a4f9-3c88-a0de-09d5c669a42f",
                        "entry_id": "3326f151-6aa4-3624-a393-ef686a6378c6",
                        "glosses": [
                            "liebevoller Zwerg oder Hausgeist, der heimlich die Arbeit von Menschen verrichtet"
                        ],
                        "tags": [
                            "Sage",
                            "Märchen"
                        ],
                        "examples": [
                            {
                                "example_id": "5c3927bd-235e-4911-8380-ff70b90cfabb",
                                "sense_id": "2aab2496-a4f9-3c88-a0de-09d5c669a42f",
                                "text": "„Wie war's in Köln doch vordem, mit Heinzelmännchen so bequem.“"
                            },
                            {
                                "example_id": "c98784ae-a537-4131-8ec3-d3ae97e76c92",
                                "sense_id": "2aab2496-a4f9-3c88-a0de-09d5c669a42f",
                                "text": "„Nun sollten aber auch die anderen aufstehen, damit man denen sagen konnte, daß die Heinzelmänchen den Tisch gedeckt hätten.“"
                            },
                            {
                                "example_id": "fc7f1ee0-47cc-45eb-9d65-8ff34920fd90",
                                "sense_id": "2aab2496-a4f9-3c88-a0de-09d5c669a42f",
                                "text": "„Selbstverständlich haben die Heinzelmännchen einen besonders engen Kontakt zu Tieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
