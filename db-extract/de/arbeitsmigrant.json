                "senses": [
                    {
                        "sense_id": "6bae3c96-fb2d-3994-93ce-ce458c6f2876",
                        "entry_id": "3e917f78-1804-39a2-aaa8-2c997eac246d",
                        "glosses": [
                            "Person, die aus beruflichen Gründen über längere Zeit in einem fremden Land arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b063360-4af7-4ef0-a042-467851a9694a",
                                "sense_id": "6bae3c96-fb2d-3994-93ce-ce458c6f2876",
                                "text": "„[…] Usbekistan legt zum großen Teil von Rücküberweisungen seiner Arbeitsmigranten in Russland, der Türkei oder in Kasachstan.“"
                            },
                            {
                                "example_id": "51e9c7af-6cc4-402e-bd2a-007f61ffd346",
                                "sense_id": "6bae3c96-fb2d-3994-93ce-ce458c6f2876",
                                "text": "„Dazu gehören zun einen der Deobandismus, benannt nach dem geistigen Zentrum im nordindischen Deoband, und zum anderen der Wahhabismus, den etwa pakistanische Arbeitsmigranten von der Arabischen Halbinsel mitbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
