                ],
                "senses": [
                    {
                        "sense_id": "6d178a59-13d5-3610-bfaf-a64280255737",
                        "entry_id": "7637cdc3-1df4-3b8e-8565-0ae88c1908b9",
                        "glosses": [
                            "meist fetthaltige Substanz zur äußerlichen Pflege der Haut"
                        ],
                        "tags": [
                            "Kosmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "ed564a94-cace-4fa4-930f-84f2f40c0f4c",
                                "sense_id": "6d178a59-13d5-3610-bfaf-a64280255737",
                                "text": "War Phloretin in der Crème hoch dosiert, stoppte es die SEAP-Herstellung."
                            },
                            {
                                "example_id": "89a752ee-5b06-4556-a2bf-9527cfe085d0",
                                "sense_id": "6d178a59-13d5-3610-bfaf-a64280255737",
                                "text": "Brav nimmt er die Crème, legt sie zurück und schließt die Schublade."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0ae57136-32b1-3890-8c1f-87176989e169",
                        "entry_id": "7637cdc3-1df4-3b8e-8565-0ae88c1908b9",
                        "glosses": [
                            "häufig süße Speise, die ihre charakteristische Konsistenz zum Beispiel durch aufgeschlagene Sahne, Butter oder Eier erhält"
                        ],
                        "tags": [
                            "Kochkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "f8057dbe-0dfd-4e6d-acb8-4ccdca2a9f42",
                                "sense_id": "0ae57136-32b1-3890-8c1f-87176989e169",
                                "text": "Etwas Crème in einen Spritzbeutel mit Sterntülle füllen."
                            },
                            {
                                "example_id": "287ada4f-0265-4b3f-811c-1521490deeff",
                                "sense_id": "0ae57136-32b1-3890-8c1f-87176989e169",
                                "text": "Man wünschte ihm eine Geburtstagstorte ins Gesicht, deren Crème aus dem Eigelb eines ranzigen Straußeneis angerührt worden ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8a8ac28c-ccb8-3db2-8c5a-62afa82aca46",
                        "entry_id": "7637cdc3-1df4-3b8e-8565-0ae88c1908b9",
                        "glosses": [
                            "Gruppe von Leuten, die als die ranghöchsten Vertreter auf einem bestimmten Gebiet gelten"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "6a66a3bb-4963-4d65-9a08-1ea00105f736",
                                "sense_id": "8a8ac28c-ccb8-3db2-8c5a-62afa82aca46",
                                "text": "„Kurz, auf Lincoln gab sich die Crème der Alten und Neuen Welt die Klinke in die Hand.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
