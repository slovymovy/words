                    {
                        "sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                        "entry_id": "85cd4e62-dd98-362b-b6cc-b3724adca83e",
                        "glosses": [
                            "een land in Centraal-Azië en het uiterste oosten van Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea19a0d-fea1-4694-8db1-76f4a0a8d414",
                                "sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                                "text": "Ik heb een vriend die in Kazachstan woont."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38607a62-6472-4c2a-8d95-00ff2ddc66ca",
                        "source_entry_id": "85cd4e62-dd98-362b-b6cc-b3724adca83e",
                        "source_sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                        "source_sense_description": "een land in Centraal-Azië en het uiterste oosten van Europa",
                        "target_lang_word": "Kasachstan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kasachstan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "940bd0f0-4849-35b2-915d-688b5601a70c",
                                        "entry_id": "67c2b909-3c87-3d8a-959b-626a3dfae8ad",
                                        "glosses": [
                                            "Staat, der hauptsächlich Asien, jedoch zu einem geringen Teil auch Europa zugehörig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44805fd5-55ff-48c1-94e9-39fb3b893bf1",
                                                "sense_id": "940bd0f0-4849-35b2-915d-688b5601a70c",
                                                "text": "„Kasachstan ist mit einer Fläche von 2.724.900 Quadratkilometern das neuntgrößte Land der Erde und außerdem der größte Binnenstaat.“"
                                            },
                                            {
                                                "example_id": "71a15919-646c-4eee-a440-9943607a13d4",
                                                "sense_id": "940bd0f0-4849-35b2-915d-688b5601a70c",
                                                "text": "„Allein in Kasachstan betrugen die chinesischen Auslandsinvestitionen im Jahr 2018 mehr als 15 Milliarden US-Dollar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c73b9dca-01e7-444a-aa61-e5b1c42ced56",
                        "source_entry_id": "85cd4e62-dd98-362b-b6cc-b3724adca83e",
                        "source_sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                        "source_sense_description": "een land in Centraal-Azië en het uiterste oosten van Europa",
                        "target_lang_word": "Kazakhstan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kazakhstan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                        "entry_id": "31a992a5-2d65-3bdd-a1ff-86778f0b3453",
                                        "glosses": [
                                            "A country in Central Asia and Eastern Europe. Official name: Republic of Kazakhstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99bef841-2de2-4ba5-9f88-a74aded40bb9",
                                                "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                                "text": "At a signing ceremony in the Kazakh capital, Astana, on May 29, the presidents of Russia, Belarus, and Kazakhstan ratified the Eurasian Economic Union (EEU) into existence. An EEU modeled on the European Union was first mooted back in 1994 by Kazakh President Nursultan Nazarbayev, but took off only after his Russian counterpart, Vladimir Putin, seized upon its potential as a Moscow-centered, Asia-oriented alternative to the EU."
                                            },
                                            {
                                                "example_id": "b0014592-17b5-4cae-aed7-046a191cdbdb",
                                                "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                                "text": "Longtime NASA astronaut Don Pettit, who has ventured to space four times, returned to Earth on Saturday night from the International Space Station. Pettit, who turned 70 on Sunday, landed at 9:20 p.m. ET in a Soyuz spacecraft with Roscosmos cosmonauts Alexey Ovchinin and Ivan Vagner near Zhezkazgan, Kazakhstan, after a seven-month stay aboard the orbiting laboratory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5e4f805-57e7-4f67-8e97-2b743e53421c",
                        "source_entry_id": "85cd4e62-dd98-362b-b6cc-b3724adca83e",
                        "source_sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                        "source_sense_description": "een land in Centraal-Azië en het uiterste oosten van Europa",
                        "target_lang_word": "Kazakhstan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kazakhstan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7da51858-d03d-3976-b208-bda80dc7897a",
                                        "entry_id": "1b686c9b-244e-390b-b15c-41e73850b129",
                                        "glosses": [
                                            "Grand pays d’Asie, entouré de la Russie au nord, de la Chine à l’est, du Kirghizistan au sud-est, de l’Ouzbékistan au sud-ouest, du Turkménistan à l’ouest-sud-ouest et de la mer Caspienne à l’ouest. Sa capitale est Astana."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5a7ff5-88ad-40b8-840d-33a056425b0a",
                                                "sense_id": "7da51858-d03d-3976-b208-bda80dc7897a",
                                                "text": "Ni le Kazakhstan ni la Russie n’ont fourni des preuves d’une quelconque implication étrangère dans les émeutes."
                                            },
                                            {
                                                "example_id": "5fc5e9ed-0362-4ee8-92ae-c497cfd256d3",
                                                "sense_id": "7da51858-d03d-3976-b208-bda80dc7897a",
                                                "text": "Alors que l’Ouzbékistan devient très répressif pendant les années 1990 et que son économie devient un mélange d’étatisme et pratiques ultracorrompues, le Kazakhstan privatise à tour de bras ses vieux mastodontes de l’industrie minière — avec certes quelques ratés — et semble emprunter la voie libérale."
                                            },
                                            {
                                                "example_id": "3e8623f0-09cd-4cd8-8f37-59f57a7e6c0f",
                                                "sense_id": "7da51858-d03d-3976-b208-bda80dc7897a",
                                                "text": "Oljas Souleïmenov est né en 1936 à Alma-Ata (aujourd’hui Almaty) capitale du Kazakhstan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77e7180b-9299-4ad2-8be2-cf3d6049abf9",
                        "source_entry_id": "85cd4e62-dd98-362b-b6cc-b3724adca83e",
                        "source_sense_id": "f1e9903b-6084-3677-8e54-231a8ef3c0e8",
                        "source_sense_description": "een land in Centraal-Azië en het uiterste oosten van Europa",
