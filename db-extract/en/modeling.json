                                                "sense_id": "0d38dc09-85f6-34a4-bf19-f37041c1d42d",
                                                "text": "Elle est jeune, svelte et jolie. Elle devrait se lancer dans le mannequinat."
                                            },
                                            {
                                                "example_id": "0da73e72-d7ca-44ae-ad8c-a13d41bbac01",
                                                "sense_id": "0d38dc09-85f6-34a4-bf19-f37041c1d42d",
