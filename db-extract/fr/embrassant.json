                    {
                        "sense_id": "d260285a-0de9-344e-acfc-26f61a652d70",
                        "entry_id": "eea239cc-e1b8-3497-8d1c-064dc62b3bc6",
                        "glosses": [
                            "Qui a l’habitude d’embrasser, qui aime à embrasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e3376e-98b0-43b2-b611-ebc341b9a30d",
                                "sense_id": "d260285a-0de9-344e-acfc-26f61a652d70",
                                "text": "Ces enfants ne sont pas embrassants."
                            },
                            {
                                "example_id": "c9b643c0-7510-4589-879e-a80ab683539c",
                                "sense_id": "d260285a-0de9-344e-acfc-26f61a652d70",
                                "text": "— Que cela est beau ! s’écria-t-elle. Monsieur Mille, souffrez que je vous embrasse.\nUn capucin qui, son menton sur le manche de sa bêche, se tenait dans le cercle des curieux, battit des mains à la vue d’un si grand embrassement. Alors de jeunes patriotes qui l’entouraient le poussèrent en riant vers l’embrassante dame, qui l’embrassa au milieu des acclamations. M. Mille m’embrassa, j’embrassai M. Mille."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f688275-ba1b-3c6d-ac6a-6b88f1713007",
                        "entry_id": "eea239cc-e1b8-3497-8d1c-064dc62b3bc6",
                        "glosses": [
                            "Se dit des feuilles et du pétiole quand leur expansion embrasse tout ou partie de la tige d’où ils sortent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c63bf56-64fd-49d0-9e80-f1f2a769b8f7",
                                "sense_id": "9f688275-ba1b-3c6d-ac6a-6b88f1713007",
                                "text": "Feuilles embrassantes."
                            },
                            {
                                "example_id": "d09e4edb-ae25-4a37-b8af-93cdd90e1bd1",
                                "sense_id": "9f688275-ba1b-3c6d-ac6a-6b88f1713007",
                                "text": "Feuilles demi-embrassantes."
                            }
                        ]
                    }
