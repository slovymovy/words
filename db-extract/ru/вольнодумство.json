                "senses": [
                    {
                        "sense_id": "21a3e4c5-250a-3190-aff4-a3f60a508011",
                        "entry_id": "3d411501-a418-338a-b185-f8f079004771",
                        "glosses": [
                            "free thought"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e213e6da-b160-48ec-a396-d86b3564ba76",
                                "sense_id": "21a3e4c5-250a-3190-aff4-a3f60a508011",
                                "text": "Э́то называ́лось в уе́зде вольноду́мством, и мно́гие смотре́ли на э́то вольноду́мство как на неви́нное и безоби́дное чуда́чество; но оно́, одна́ко, сде́лало его́ глубоко́ несча́стным.",
                                "translation": "In the district this was called free-thinking, and many people looked upon this free-thinking as an innocent and harmless eccentricity; it made him profoundly unhappy, however.",
                                "english": "In the district this was called free-thinking, and many people looked upon this free-thinking as an innocent and harmless eccentricity; it made him profoundly unhappy, however."
                            }
                        ]
                    }
                ],
