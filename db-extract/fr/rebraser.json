                        "glosses": [
                            "Braser de nouveau (deux morceaux de fer mal joints)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5770343b-3141-4a31-b11c-7589cbea1096",
                                "sense_id": "ea2968df-593b-372f-b375-1f796f9ec0e6",
                                "text": "Pour l'enlever il faut découper le pot, faire sauter la bride et rebraser le tout."
                            },
                            {
                                "example_id": "fd6919a9-3b64-41d0-b6c4-5d3eedce6a38",
                                "sense_id": "ea2968df-593b-372f-b375-1f796f9ec0e6",
                                "text": "Comme cette issue vers le dehors ne présentait aucun intérêt pour moi, j’ai ajourné le soin de rouvrir cette porte et d’en faire rebraser la clef."
                            }
                        ]
                    }
