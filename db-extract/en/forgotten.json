                                        "sense_id": "92ce4f7f-f41a-3325-8ca6-46e722ef91df",
                                        "entry_id": "c9a9a79e-5a59-376d-ab58-af6c898e6183",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e2b400-4266-442c-b842-fd1a9ac57cc7",
                                                "sense_id": "92ce4f7f-f41a-3325-8ca6-46e722ef91df",
                                                "text": "Il avait oublié que les Puissances pouvaient télépathiser, comme disait Karima."
                                            }
                                        ]
                                    }
                                ]
