                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "A cylindrical or rectangular container usually of lightweight metal, plastic, or laminated pasteboard used for holding a dry product (as tea, crackers, flour, matches)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3038a800-90f0-44a8-9c97-63af4fe503ce",
                                                "sense_id": "d17a8cfb-b99b-3e9c-9d7b-759306123973",
                                                "text": "Everything a living animal could do to destroy and to desecrate bed and walls had been done. […] A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd6bb68b-77a9-3df3-bf95-ea589396485f",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "Any of various cylindrical metal receptacles usually with a removable close-fitting top."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d369bdb3-c8fa-3272-829e-c6dc941b7fbb",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "A special short-range antipersonnel projectile consisting of a casing of light metal, loaded with preformed submissiles such as flechettes or steel balls. The casing is designed to open just beyond the muzzle of the weapon, dispersing the submissiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4288fe9a-e257-3d20-9638-032540710630",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "A projectile component containing colored or screening smoke or riot control agent composition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d5bf055-a70d-3efa-8677-4c3b263aaf2d",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "A component of canister-type protective masks containing a mechanical filter and chemical filling to filter, neutralize and/or absorb toxic chemical, biological and radiological agents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05ed24f2-ba81-30ff-b83d-2704be9ae7c2",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "Part of a windmill that connects the sails to the windshaft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f7069c2-5090-3787-911e-8533e9185cb8",
                                        "entry_id": "44a7a829-dee5-3c7f-b675-0bf587f91bca",
                                        "glosses": [
                                            "A person's head."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11abfec-60af-4b23-bd89-dfa241bf3e4d",
                                                "sense_id": "8f7069c2-5090-3787-911e-8533e9185cb8",
                                                "text": "Caunt let fly left and right, but Bendy ducked his canister, and got down with more caution than gallantry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6451302-859c-3dda-96a7-86d082a02244",
                                        "entry_id": "827e3b6b-b366-3148-abd4-7bb0741df6c7",
                                        "glosses": [
                                            "To pack into a canister."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
