    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1482bf8d-2360-3c4c-a624-c301deff0547",
                    "sense_definition": "To place or adjust something back into the middle or center position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>recenter</w> the image on the page so it looks balanced.",
                            "target_lang_translations": {
                                "zh": "你应该把页面上的图片<w>重新居中</w>，这样看起来才平衡。"
                            }
                        },
                        {
                            "text": "The software will automatically <w>recenter</w> the map after you zoom in.",
                            "target_lang_translations": {
                                "zh": "放大地图后，软件会自动将地图<w>重新居中</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "realign",
                        "reposition"
                    ],
                    "common_phrases": [
                        "recenter the view",
                        "recenter the image"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物重新放置或调整到中间或中心位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重新居中",
                                "target_lang_sense_clarification": "指将物体或视图调整回中心位置。"
                            },
                            {
                                "target_lang_word": "重新对齐",
                                "target_lang_sense_clarification": "指通过调整位置使其恢复平衡或中心状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49075a55-4abc-3645-9d5b-f4902a6edbd8",
                    "sense_definition": "The comparative form of <w>recent</w>: more recent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This report is <w>recenter</w> than the one we discussed last week.",
                            "target_lang_translations": {
                                "zh": "这份报告比我们上周讨论的那份<w>更新</w>。"
                            }
                        },
                        {
                            "text": "We need to look at <w>recenter</w> data to understand the current trend.",
                            "target_lang_translations": {
                                "zh": "我们需要查看<w>更近期</w>的数据来了解当前的趋势。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative form of recent"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容词 recent 的比较级：更近的，更新的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "更新的",
                                "target_lang_sense_clarification": "指时间上更接近现在。"
                            },
                            {
                                "target_lang_word": "更近期的",
                                "target_lang_sense_clarification": "指在时间序列中处于较晚的位置。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
