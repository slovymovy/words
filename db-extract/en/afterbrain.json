                "entry_id": "df089374-30a9-3b67-b13e-1c6bf78859aa",
                "word": "afterbrain",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "475e2747-084f-438c-9c48-7f667367298e",
                        "entry_id": "df089374-30a9-3b67-b13e-1c6bf78859aa",
                        "tags": [
                            "plural"
