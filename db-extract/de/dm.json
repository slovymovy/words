                                "example_id": "5643e2a2-54b8-4e5f-b256-d9cdfba77b5c",
                                "sense_id": "5a64c87d-e0c7-3180-9309-95e24be5a7b8",
                                "text": "Der Patient hat DM Typ II."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04e40b3b-acae-337d-bb3a-8ac41d19ca3e",
                        "entry_id": "2c6b0af0-420b-39c3-a1e0-930f90300c5b",
                        "glosses": [
                            "Deutsche Mark (ehemalige deutsche Geldwährung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd7a4cf-01ea-4460-929a-35bdfbc8bf71",
                                "sense_id": "04e40b3b-acae-337d-bb3a-8ac41d19ca3e",
                                "text": "„Das berühmte Evangeliar Heinrichs des Löwen, das König Georg V. aus dem Prager Domkapitel erworben und dem Welfenschatz hinzugefügt hatte, wurde 1983 zum Preis von 32,5 Mio. DM (16,6 Mio. Euro) in die Bundesrepublik Deutschland zurückersteigert.“"
                            },
                            {
                                "example_id": "da34ccf3-ba13-44f3-8b36-d77d91ccecfe",
                                "sense_id": "04e40b3b-acae-337d-bb3a-8ac41d19ca3e",
                                "text": "„Für die großen Massenszenen wurden damals russisch aussehende Menschen für sechzig DM Tagesgage angeheuert, um bei der Schlacht von Stalingrad sowjetische Soldaten zu spielen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "75c529c6-4ad5-3f24-8310-a4ffbd8b024e",
                        "entry_id": "2c6b0af0-420b-39c3-a1e0-930f90300c5b",
                        "glosses": [
                            "Death Match"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47e7b43-01f0-462a-b9f2-9aeab3a8c9c2",
                                "sense_id": "75c529c6-4ad5-3f24-8310-a4ffbd8b024e",
                                "text": "Manche einer spielt lieber CtF (Capture the Flag) als DM."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "2bfd895d-ca3b-3e9b-9122-5a80cf0497a3",
                        "entry_id": "2c6b0af0-420b-39c3-a1e0-930f90300c5b",
                        "glosses": [
                            "Deutsche Meisterschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
