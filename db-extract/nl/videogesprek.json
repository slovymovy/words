                            {
                                "example_id": "72ffcbbb-0a76-4c76-bbe8-99b929eb18f4",
                                "sense_id": "e45f97e0-4d9e-3221-bceb-5565ef160b31",
                                "text": "Tijdens het videogesprek kon ik mijn familie aan de andere kant van de wereld zien.",
                                "translation": "During the video call, I could see my family on the other side of the world.",
                                "english": "During the video call, I could see my family on the other side of the world."
                            },
                            {
                                "example_id": "cf12b074-fc01-4a3c-8524-db5d5a50895f",
                                "sense_id": "e45f97e0-4d9e-3221-bceb-5565ef160b31",
                                "text": "Het videogesprek met mijn collega's was erg handig omdat we allemaal op afstand werkten.",
                                "translation": "The video call with my colleagues was very useful as we were all working remotely.",
                                "english": "The video call with my colleagues was very useful as we were all working remotely."
                            },
                            {
                                "example_id": "3c98a076-06ff-4d66-a031-b7eda00d0efb",
                                "sense_id": "e45f97e0-4d9e-3221-bceb-5565ef160b31",
                                "text": "Ze voerden regelmatig videogesprekken om contact te houden, ook al waren ze fysiek gescheiden.",
                                "translation": "They had regular video calls to stay in touch, even though they were physically apart.",
                                "english": "They had regular video calls to stay in touch, even though they were physically apart."
                            },
                            {
                                "example_id": "7ad1b4b4-a2fd-4534-a4ca-180060b77545",
                                "sense_id": "e45f97e0-4d9e-3221-bceb-5565ef160b31",
                                "text": "Tijdens het videogesprekje toonde de peuter enthousiast zijn speelgoed aan zijn grootouders.",
                                "translation": "During the video call, the toddler enthusiastically showed his toys to his grandparents.",
                                "english": "During the video call, the toddler enthusiastically showed his toys to his grandparents."
                            },
                            {
                                "example_id": "413b1202-9972-469c-8245-58334fc8008d",
                                "sense_id": "e45f97e0-4d9e-3221-bceb-5565ef160b31",
                                "text": "Het videogesprekje met mijn vrienden verliep soepel, en het voelde bijna alsof we in dezelfde kamer waren.",
                                "translation": "The video call with my friends went smoothly, and it almost felt like we were in the same room.",
                                "english": "The video call with my friends went smoothly, and it almost felt like we were in the same room."
                            }
                        ]
