                ],
                "translations": [
                    {
                        "translation_id": "dd13b107-e5e2-47ce-9c61-1eee1f68b758",
                        "source_entry_id": "176f9558-63ac-32de-96c9-b91d5ebeda5c",
                        "target_lang_word": "ausbreiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausbreiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adca9106-9315-30f2-bb99-d48da0bdcd20",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "etwas entfalten, übersichtlich nebeneinanderlegen (um jemandem etwas zu zeigen)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70432773-d58f-4442-8a96-226ac2d820f6",
                                                "sense_id": "adca9106-9315-30f2-bb99-d48da0bdcd20",
                                                "text": "Über dem Tisch, auf dem eine auseinandergepackte Musterkollektion von Tuchwaren ausgebreitet war, hing das Bild."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "an Einfluss, Ausmaß, Fläche, Raum zunehmen; in einen größeren Umkreis gelangen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b621030-ceaa-4b63-9024-7fdc899a757e",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Ein schöner, frischer Geruch breitet sich im Raum aus."
                                            },
                                            {
                                                "example_id": "39b059a7-8222-469b-a669-acefdbcd202c",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Das Coronavirus breitete sich im Laufe der kalten Monate in Deutschland stark aus."
                                            },
                                            {
                                                "example_id": "06655924-38b8-438d-98a3-d53973fe01a3",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Das Feuer konnte sich ungehindert ausbreiten."
                                            },
                                            {
                                                "example_id": "5a893b16-04d3-4622-821a-79f99c961e79",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "„Der Orden breitete sich rasch über Europa und auch nach Amerika aus.“"
                                            },
                                            {
                                                "example_id": "a0a2de73-8076-4841-92ad-17e14ce46bb1",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "„Sie sammeln unzählige Daten, die allesamt zeigen, wie sich westliche Rationalität und Organisationsformen in alle Winkel dieser Welt ausbreiten, und wie sich Entscheider zunehmend auf ethische Ziele berufen müssen, um Legitimität zu erhalten.“"
                                            },
                                            {
                                                "example_id": "98716685-fbda-40f3-a07f-512ea5332a2e",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "„Der Tabakkonsum breitete sich vom 17. Jahrhundert an rasch aus, wozu auch Kriege beitrugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf18d5ea-abbd-3ab6-8748-c15860d6948a",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "zur Seite hin ausstrecken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de3663d-9002-4e8e-ae50-a09230dee216",
                                                "sense_id": "cf18d5ea-abbd-3ab6-8748-c15860d6948a",
                                                "text": "Der Rabe breitet seine Flügel aus und flog davon."
                                            },
                                            {
                                                "example_id": "d8dc84f0-1f63-45a4-bba7-6ae8abe3fce9",
                                                "sense_id": "cf18d5ea-abbd-3ab6-8748-c15860d6948a",
                                                "text": "Mit ausgebreiteten Armen begrüßte die stolze Mutter seinen freudestrahlenden Sohn."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "19bb90f5-4b4d-3f39-8621-3fef7a73193c",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "eine bestimmte räumliche Ausdehnung haben; sich erstrecken, bis zu etwas hin reichen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4fd5a52-80ab-4ceb-b6a2-2faecd8419ea",
                                                "sense_id": "19bb90f5-4b4d-3f39-8621-3fef7a73193c",
                                                "text": "Der Wald breitet sich kilometerweit nach Norden aus."
                                            },
                                            {
                                                "example_id": "4c2d8023-8930-415a-9013-b09480a13327",
                                                "sense_id": "19bb90f5-4b4d-3f39-8621-3fef7a73193c",
                                                "text": "Eine riesige, scheinbar endlose Landschaft breitete sich vor den Augen der Freunde aus."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1535af42-67d9-3166-a3df-a15454d584ca",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "etwas in aller Ausführlichkeit darstellen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c51524a3-d077-431b-bce1-c50d88a6f6ee",
                                                "sense_id": "1535af42-67d9-3166-a3df-a15454d584ca",
                                                "text": "Die beiden konnten sich stundenlang über ihre Erlebnisse letzter Zeit ausbreiten."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "48a59fe9-4015-3d01-a4de-6d13b94e2999",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "sich gemütlich irgendwo niederlassen und dabei viel Platz einnehmen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
