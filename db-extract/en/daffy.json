                "senses": [
                    {
                        "sense_id": "6864661e-9bd3-3d27-bfdf-8e8c732145f2",
                        "entry_id": "be6bd929-e377-3f21-bfd3-f75a549179ab",
                        "glosses": [
                            "Somewhat mad or eccentric."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f931f8da-473f-47da-b0ea-0c198c57d20b",
                                "sense_id": "6864661e-9bd3-3d27-bfdf-8e8c732145f2",
                                "text": "Now I'm hungry as a Rocky Mountain lion so come, let's go and get this poor, daffy, tealess widow and wine and dine with her and make it all up."
                            },
                            {
                                "example_id": "75c36950-b46c-4484-a97c-701c368fa567",
                                "sense_id": "6864661e-9bd3-3d27-bfdf-8e8c732145f2",
                                "text": "\"You've gone so plum daffy you are forgetting your dinner,\" jeered her mother."
                            },
                            {
                                "example_id": "0fd49d84-9dba-4825-a406-ac8520aa2e33",
                                "sense_id": "6864661e-9bd3-3d27-bfdf-8e8c732145f2",
                                "text": "He was daffy about her and she could twist him around her little finger."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
