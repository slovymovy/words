                    "sense_id": "0913cc7c-7e85-3d42-8eac-b221bf584fdb",
                    "sense_definition": "een mannelijk kind van dezelfde ouders",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oudere <w>broer</w> heeft vaak ruzie met zijn klasgenoten op school.",
                            "target_lang_translations": {
                                "en": "My older <w>brother</w> often has arguments with his classmates at school.",
                                "ru": "Мой старший <w>брат</w> часто ссорится со своими одноклассниками в школе."
                            }
                        },
                        {
                            "text": "Ik heb een <w>broer</w> en twee zussen die in Amsterdam wonen.",
                            "target_lang_translations": {
                                "en": "I have a <w>brother</w> and two sisters who live in Amsterdam.",
                                "ru": "У меня есть <w>брат</w> и две сестры, которые живут в Амстердаме."
                            }
                        }
                    ],
                    "synonyms": [
                        "broeder"
                    ],
                    "antonyms": [
                        "zus"
                    ],
                    "common_phrases": [
                        "een oudere broer",
                        "een jongere broer"
                    ],
                    "target_lang_definitions": {
                        "en": "a male child of the same parents",
                        "ru": "сын тех же родителей по отношению к другим их детям"
                    },
                    "translations": {
