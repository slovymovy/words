                                "target_senses": [
                                    {
                                        "sense_id": "9a9c29ba-c329-3e81-b3a7-c58490610c76",
                                        "entry_id": "3c3a8e77-3428-316c-9f82-668b59158252",
                                        "glosses": [
                                            "Que comete sacrilegio."
                                        ],
                                        "tags": [],
