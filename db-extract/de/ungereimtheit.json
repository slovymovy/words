                ],
                "senses": [
                    {
                        "sense_id": "d4bfe2cc-74af-31a8-8c17-5972aa352326",
                        "entry_id": "755fe12b-a85f-3f4f-8980-3f8205c34b9a",
                        "glosses": [
                            "verworrene, nicht stimmige Art und Weise"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "738f1827-757c-44a7-9fc4-51ff9c3e39e9",
                                "sense_id": "d4bfe2cc-74af-31a8-8c17-5972aa352326",
                                "text": "Aufgrund der Ungereimtheit seiner Aussagen wurde der angebliche Zeuge als Lügner entlarvt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7db05667-2546-3646-951f-b40947413970",
                        "entry_id": "755fe12b-a85f-3f4f-8980-3f8205c34b9a",
                        "glosses": [
                            "etwas, das nicht schlüssig/stimmig ist; etwas, das Fragen aufwirft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f0fe68-8abb-4a15-8012-8ee8e62b2d0d",
                                "sense_id": "7db05667-2546-3646-951f-b40947413970",
                                "text": "„Bei seiner Wahl zum Bischof muss es zu Ungereimtheiten gekommen sein.“"
                            },
                            {
                                "example_id": "097432d9-d60b-49c5-8b25-b32e665bde98",
                                "sense_id": "7db05667-2546-3646-951f-b40947413970",
                                "text": "„Die spanische Komödie war voll Ungereimtheiten, gefiel mir aber trotzdem ganz gut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c601aae8-8a50-455b-8a04-801dd2d6da9b",
                        "source_entry_id": "755fe12b-a85f-3f4f-8980-3f8205c34b9a",
                        "source_sense_id": "d4bfe2cc-74af-31a8-8c17-5972aa352326",
                        "source_sense_description": "kein Plural: verworrene, nicht stimmige Art und Weise",
                        "target_lang_word": "inconsistency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsistency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d12b7dcb-23cc-3a03-8c5f-4131a148f29a",
                                        "entry_id": "d716bcd5-791c-391c-9c29-ac79c6f78d18",
                                        "glosses": [
                                            "The state of being inconsistent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996e1195-7f00-4ae4-a181-b6a2ffae22c7",
                                                "sense_id": "d12b7dcb-23cc-3a03-8c5f-4131a148f29a",
                                                "text": "It was a strange inconsistency, but never till then had I been so much struck with the worthless and frivolous life of society. Never till then did I feel the deep and eternal debt of gratitude that human nature owes to those who assert its higher influence; who feel their generous activity stirred by a thrice noble emulation; who appeal from the present to the future, and redeem their kind, by shewing of how much that is good and great ambition and genius are capable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a68072a-421d-3ef7-82c9-ae4bc51be8df",
                                        "entry_id": "d716bcd5-791c-391c-9c29-ac79c6f78d18",
                                        "glosses": [
                                            "An incompatibility between two propositions that cannot both be true."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
