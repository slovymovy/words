{
    "word_family": [
        "sleighing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "feed8e18-309c-307e-aa32-c852f10fe78e",
                    "sense_definition": "A vehicle, typically pulled by animals, that moves over snow or ice on runners, used for transporting people or goods.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Santa Claus travels across the world in a <w>sleigh</w>.",
                            "target_lang_translations": {
                                "ru": "Санта-Клаус путешествует по миру на <w>санях</w>."
                            }
                        },
                        {
                            "text": "We enjoyed a ride in a horse-drawn <w>sleigh</w> through the snowy forest.",
                            "target_lang_translations": {
                                "ru": "Нам очень понравилась поездка на запряжённых лошадьми <w>санях</w> по заснеженному лесу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horse-drawn sleigh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повозка на полозьях для езды по снегу или льду, обычно запрягаемая животными, предназначенная для перевозки людей или грузов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сани",
                                "target_lang_sense_clarification": "крупная повозка на полозьях"
                            },
                            {
                                "target_lang_word": "санки",
                                "target_lang_sense_clarification": "небольшие сани"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d2ca114-7467-3c1a-8095-770122c9c01b",
                    "sense_definition": "To travel or transport someone in a sleigh.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to <w>sleigh</w> across the frozen lake during the winter festival.",
                            "target_lang_translations": {
                                "ru": "Семья решила <w>прокатиться на санях</w> по замёрзшему озеру во время зимнего фестиваля."
                            }
                        },
                        {
                            "text": "They <w>sleighed</w> through the deep snow to reach the remote cabin.",
                            "target_lang_translations": {
                                "ru": "Они <w>ехали на санях</w> по глубокому снегу, чтобы добраться до отдалённой избушки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать или кататься на санях, либо перевозить кого-то на санях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на санях",
                                "target_lang_sense_clarification": "передвигаться ради отдыха или развлечения"
                            },
                            {
                                "target_lang_word": "ехать на санях",
                                "target_lang_sense_clarification": "передвигаться как на транспорте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5a0f94be-c951-34c8-93eb-4a8752754442",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named Mr. <w>Sleigh</w>.",
                            "target_lang_translations": {
                                "ru": "Автора статьи зовут мистер <w>Слей</w>."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Sleigh</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я познакомился с женщиной по имени Сара <w>Слей</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Слей",
                                "target_lang_sense_clarification": "фамилия английского происхождения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}