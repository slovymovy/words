                        "sense_id": "202ba8f4-19f0-3aac-b037-7b7b43a60818",
                        "entry_id": "1425c7cf-7f46-3751-a7d0-55aabc166b13",
                        "glosses": [
                            "een groot gebied dat -vaak permanent- door een relatief vlakke sneeuwlaag wordt bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2259f5-8805-4620-a959-00fa32ec9597",
                                "sense_id": "202ba8f4-19f0-3aac-b037-7b7b43a60818",
                                "text": "Ik schaamde me er bijna voor, maar ik verlangde naar de rust en voorspelbaarheid van Noord-Californië, het deel van de trail dat vaak als saai wordt beschreven. De hoge sneeuwvelden waar ik nu doorheen liep waren toch een stuk serieuzer dan ik had verwacht."
                            },
                            {
                                "example_id": "e2e7c7be-3f20-4afc-aa76-6bb04f574f00",
                                "sense_id": "202ba8f4-19f0-3aac-b037-7b7b43a60818",
                                "text": "De Roemeen daalde met drie vrienden af zonder van touwen gebruik te maken. De man gleed uit en stortte neer over een sneeuwveld en de sneeuwvrije gletsjer."
                            }
                        ]
                    }
