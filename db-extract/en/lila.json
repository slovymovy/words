                    {
                        "sense_id": "c9ec1d33-5873-3ea4-a9fc-9f74e7111345",
                        "entry_id": "3f23fe53-0aad-3a75-9427-5a14dcacdf4b",
                        "glosses": [
                            "A female given name from Arabic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce832ad-5ccb-4b68-ab66-63d35bef3778",
                                "sense_id": "c9ec1d33-5873-3ea4-a9fc-9f74e7111345",
                                "text": "Your name is flowery too. I used to say Mamita would have called you Lady Viola; but violet colors and lilac colors are cousins, and they both suit your complexion and your name, Mamita Lila."
                            },
                            {
                                "example_id": "3c9b2ed7-e033-4f33-b292-d5b8cf9c288e",
                                "sense_id": "c9ec1d33-5873-3ea4-a9fc-9f74e7111345",
                                "text": "“I been thinking about ‘Lila.’ I had a sister Lila. Give her a pretty name, maybe she could turn out pretty.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
