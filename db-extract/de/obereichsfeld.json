                        "form": "das Obereichsfeld"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                        "entry_id": "3dfeabbb-30b9-3b1f-bb72-99d3a33f4390",
                        "glosses": [
                            "Teil des Eichsfeldes, der im mitteldeutschen Sprachgebiet und großenteils in Thüringen, zum kleineren Teil in Hessen liegt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "37b0b35f-dfac-4884-a839-b4ce74962941",
                                "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                                "text": "„Ähnliches deutet sich für das Obereichsfeld an, das nach dem Willen der Erfurter Landesregierung ebenfalls mit den Nachbarkreisen fusionieren soll.“"
                            },
                            {
                                "example_id": "56cbced8-cd36-47a6-823b-e566665e1a8f",
                                "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                                "text": "„Das Untereichsfeld ist Teil des niedersächsischen Landkreises Göttingen, das Obereichsfeld liegt im thüringischen Landkreis Eichsfeld.“"
                            },
                            {
                                "example_id": "7efa7729-e5d5-4c1d-b48d-41bd4c82694f",
                                "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                                "text": "„Allgemein gliedert man dieses gesamte Gebiet in zwei Teile auf, und zwar in das Ober- und Untereichsfeld, wobei aber über den Verlauf einer genauen Grenzlinie zwischen beiden Teilen keineswegs Einigkeit besteht.“"
                            },
                            {
                                "example_id": "f54d1b65-1f2a-4f12-9359-35d7aec0fa4c",
                                "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                                "text": "„Das Ureichsfeld des Thüringerreiches lag dort, wo das Südeichsfeld, auch Obereichsfeld, bis zu 500m Höhe ansteigt.“"
                            },
                            {
                                "example_id": "7ea01dcc-8a5f-4bbf-b0a8-de4eef18e0c5",
                                "sense_id": "4ab8555b-ec28-315d-be49-9f5a1c952da5",
                                "text": "„Dass Leinefelde aber sogar einmal die größte Ansiedlung im Obereichsfeld werden würde, konnte wohl selbst der befähigteste Hellseher nicht voraussehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
