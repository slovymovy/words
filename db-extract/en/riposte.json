                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                        "entry_id": "8e7d0ee3-19d4-3fa0-82fa-4429d7693d82",
                                        "glosses": [
                                            "einen Gegenstand wieder in den Besitz der Person geben, die den Gegenstand zuvor hatte, beziehungsweise wieder in den Besitz des Eigentümers geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddd724c-82bd-43b6-bd82-90f9e782820f",
                                                "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                                "text": "Petra hat sich von Sybille 30 Euro geliehen, aber das Geld nie zurückgegeben."
                                            },
                                            {
                                                "example_id": "7028d34e-c458-4c79-bab4-5ca2f8118b69",
                                                "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                                "text": "Ich muss noch bei der Bücherei anhalten und die geliehenen Bücher zurückgeben."
                                            },
                                            {
                                                "example_id": "b378d7bb-7611-4f4d-a4c5-ea19ccb7b855",
                                                "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                                "text": "Sie fragte, ob man einen Orden oder einen Titel einfach so zurückgeben könne."
                                            },
                                            {
                                                "example_id": "6631f87c-315c-4d5a-bb54-2537ffeb6b09",
                                                "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                                "text": "Das Land wurde mehrfach aufgefordert, die sogenannte Beutekunst zurückzugeben."
                                            },
                                            {
                                                "example_id": "787b0f2c-f265-4df3-93ee-10ff0ab5a2d3",
                                                "sense_id": "07136acb-e335-39f0-98ed-d37b550ccb29",
                                                "text": "Gib mir meinen Teddy zurück, dann kriegst du deine Puppe wieder."
                                            }
