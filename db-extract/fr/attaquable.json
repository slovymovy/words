                "senses": [
                    {
                        "sense_id": "482130c8-62e7-3e12-a808-7a0380bb83ba",
                        "entry_id": "2ecefe70-9a8f-3630-9bc8-470ae17b4828",
                        "glosses": [
                            "Qui peut être attaqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96bf38e-980c-4866-aef5-331fd3839bda",
                                "sense_id": "482130c8-62e7-3e12-a808-7a0380bb83ba",
                                "text": "Une pluie de flèches tomba sur les voyageurs qui n’eurent d’autre ressource que de se blottir contre la muraille, où ils étaient plus difficilement attaquables."
                            },
                            {
                                "example_id": "60acde72-c47c-4659-a669-3274a3d50bc1",
                                "sense_id": "482130c8-62e7-3e12-a808-7a0380bb83ba",
                                "text": "Ce titre est attaquable."
                            },
                            {
                                "example_id": "776b4c55-c7eb-4ac9-8689-2cf66146091d",
                                "sense_id": "482130c8-62e7-3e12-a808-7a0380bb83ba",
                                "text": "Ce raisonnement n’est pas attaquable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c86bb917-a59e-4067-9a44-6f6d977ba213",
                        "source_entry_id": "2ecefe70-9a8f-3630-9bc8-470ae17b4828",
                        "source_sense_id": "482130c8-62e7-3e12-a808-7a0380bb83ba",
                        "target_lang_word": "assailable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assailable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                        "entry_id": "006e8f31-7863-304a-932c-b4b85e7a1a56",
                                        "glosses": [
                                            "Able to be assailed or attacked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a75a80d-909d-4ac6-8fa5-5379238ee6fe",
                                                "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                                "text": "There’s comfort yet; they [Banquo and Fleance] are assailable; / Then be thou jocund: ere the bat hath flown / His cloister’d flight […] there shall be done / A deed of dreadful note."
                                            },
                                            {
                                                "example_id": "00d3fe43-2c20-4fc7-a3c5-eae6d162730a",
                                                "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                                "text": "1791, Hannah Brand, Huniades, or, The siege of Belgrave, Act IV, Scene 3, in Plays and Poems, Norwich, 1798, p. 82,\nPlant the ordnance ’gainst the postern, / North of the Eastern tower; for there I deem / The wall is most assailable."
                                            },
                                            {
                                                "example_id": "90dc22a9-4a27-4e35-a55f-de2a929ae073",
                                                "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                                "text": "Indeed, he lived among a generation of sinners, whose consciences were not assailable by smooth circumlocutions, and whose vices required the scourge and the hot iron."
                                            },
                                            {
                                                "example_id": "ed3b78b6-b7f7-4600-b319-05ad265794f9",
                                                "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                                "text": "All that most maddens and torments ; all that stirs up the lees of things ; all truth with malice in it ; all that cracks the sinews and cakes the brain ; all the subtle demonisms of life and thought ; all evil, to crazy Ahab, were visibly personified, and made practically assailable in Moby Dick."
                                            },
                                            {
                                                "example_id": "525c501f-d2cc-4840-855f-c5564bd91a52",
                                                "sense_id": "51eb9e76-074e-32ad-8c9e-c4e204aa3c91",
                                                "text": "What is assailable is that in the process of achieving that goal [equality], you level everybody down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "721d03b6-9740-4d48-a70e-ba37ee8bbada",
