                        "entry_id": "aef936f9-e25d-38d0-8812-3ac626a6c839",
                        "glosses": [
                            "The act of building something again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "678d5f7b-bba0-492a-a145-684a2f9acd64",
                                "sense_id": "3435d1c0-9013-31f9-a181-08090b462b28",
                                "text": "The complete 1892 rebuilding, indeed, followed an accident in 1890, when No. 6 ran away down the Buckley branch, and got badly smashed up in a collision at Connah's Quay."
                            },
                            {
                                "example_id": "66a9539a-4592-4dec-86ce-824428a30c0f",
                                "sense_id": "3435d1c0-9013-31f9-a181-08090b462b28",
                                "text": "These have certainly witnessed many events of interest, chief among them, undoubtedly, being the rebuilding of the Bulleid Pacifics."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ad74486-0af0-47ab-b908-5b0b982999f7",
                        "source_entry_id": "aef936f9-e25d-38d0-8812-3ac626a6c839",
                        "source_sense_id": "3435d1c0-9013-31f9-a181-08090b462b28",
