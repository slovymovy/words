                        "cross_references": [
                            {
                                "target_word": "abyssin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "069a9b40-851f-38e7-935d-9114bb37bebe",
                                        "entry_id": "ee9dd958-e269-3c88-a4c9-75d8effb9861",
                                        "glosses": [
                                            "Qui concerne l’Abyssinie, son peuple, sa culture."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712511b0-6b1a-4032-a7b9-12937b10b7eb",
                                                "sense_id": "069a9b40-851f-38e7-935d-9114bb37bebe",
                                                "text": "D’une très profonde cour intérieure monte l’odeur des peaux grillées au soleil des hauts plateaux abyssins, sur la pierraille des somalilands […]"
                                            },
                                            {
                                                "example_id": "aee72d9b-bcca-49f3-83ea-057ce2bd1825",
                                                "sense_id": "069a9b40-851f-38e7-935d-9114bb37bebe",
                                                "text": "Mais sans doute, dans ses prévisions guerrières, le Duce ne comptait-il pas que sur la route abyssine se dresserait devant lui l’Angleterre et sa flotte."
                                            },
                                            {
                                                "example_id": "5edfeab6-593c-4c46-874e-fc0dca936aa6",
                                                "sense_id": "069a9b40-851f-38e7-935d-9114bb37bebe",
                                                "text": "Le littoral abyssin de la mer Rouge est peut-être une des plus curieuses parties de l’Afrique, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abyssin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34c1ca96-2eb1-3ddb-8fb9-e2a45ff9f8f1",
                                        "entry_id": "e1512676-ccaa-3b92-b255-827b7ba3d381",
                                        "glosses": [
                                            "Race de chat, à tête un peu triangulaire, aux grandes oreilles, au corps long et mince, à queue longue, à poil court, au pelage de motif tabby et de couleur souvent bleu, roux ou brun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b73e33-3fac-492d-ace3-8c865fde485b",
                                                "sense_id": "34c1ca96-2eb1-3ddb-8fb9-e2a45ff9f8f1",
                                                "text": "Dans la partie animalerie, elle s’amuse avec un chaton au poil roux, aux yeux verts, félin et joueur qui réussit à l’attendrir. C’est un abyssin. Elle l’achète : — C’est un cadeau pour Zeinab. Elle n’a pas la passion de la terre mais elle adore les animaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
