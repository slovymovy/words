                "senses": [
                    {
                        "sense_id": "ceeee19b-902a-3e32-b7d3-304708c75735",
                        "entry_id": "14192b1b-fde5-345f-a61f-3fc6e76f6ca1",
                        "glosses": [
                            "Niais, infantile."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "12b556cc-e34f-408c-97dc-56400153ccaf",
                                "sense_id": "ceeee19b-902a-3e32-b7d3-304708c75735",
                                "text": "Chaque détail révélait, ici, l’amour du luxe cher et grossier, là, une tendance regrettable à la romance, à l’attendrissement bébête."
                            },
                            {
                                "example_id": "635308d4-b40c-4d10-925e-a593cc877cca",
                                "sense_id": "ceeee19b-902a-3e32-b7d3-304708c75735",
                                "text": "C’est ainsi que je l’aime, que je la voudrais toujours, à moitié bébête, à moitié perverse, toute torturée d’impureté sous son attitude chaste…"
                            },
                            {
                                "example_id": "47926319-e5d8-4838-aa13-6b10b779ce63",
                                "sense_id": "ceeee19b-902a-3e32-b7d3-304708c75735",
                                "text": "Elle est franchement bébête, d’ailleurs, et n’affirme sa supériorité que dans la gymnastique amoureuse."
                            },
                            {
                                "example_id": "7f3c09b3-f1fe-4fee-ac03-cca4715ad481",
                                "sense_id": "ceeee19b-902a-3e32-b7d3-304708c75735",
                                "text": "Possédant une voix de ténor agréable, il chantait des romances de Massenet, et cette sensualité bébête m’exaspérait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c5db25-2b43-44b9-92b3-1775adccdfa8",
                        "source_entry_id": "14192b1b-fde5-345f-a61f-3fc6e76f6ca1",
