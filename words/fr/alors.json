                    "sense_id": "53a3455e-c10c-3b5f-865c-f06673aa92d1",
                    "sense_definition": "Marque la conséquence ou la conclusion ; dans ce cas.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu as fini tes devoirs, <w>alors</w> tu peux sortir jouer dehors.",
                            "target_lang_translations": {
                                "en": "If you've finished your homework, <w>then</w> you can go out and play outside.",
                                "ru": "Если ты уже сделал уроки, <w>тогда</w> можешь идти гулять на улицу.",
                                "nl": "Als je je huiswerk af hebt, <w>dan</w> mag je naar buiten om te spelen.",
                                "de": "Wenn du deine Hausaufgaben fertig hast, <w>dann</w> darfst du draußen spielen gehen.",
                                "pl": "Jeśli odrobiłeś lekcje, <w>w takim razie</w> możesz wyjść pobawić się na dwór.",
                                "it": "Se hai finito i compiti, <w>allora</w> puoi uscire a giocare fuori.",
                                "cs": "Když máš hotové úkoly, <w>tak</w> můžeš jít ven si hrát.",
                                "tr": "Ödevlerini bitirdiysen <w>o zaman</w> dışarı çıkıp oynayabilirsin.",
                                "es": "Si ya has terminado los deberes, <w>entonces</w> puedes salir a jugar fuera.",
                                "zh": "如果你做完作业了，<w>那么</w>就可以出去玩了。"
                            }
                        },
                        {
                            "text": "Il n'y avait plus de train, <w>alors</w> nous sommes rentrés à pied.",
                            "target_lang_translations": {
                                "en": "There were no more trains, <w>so</w> we walked home.",
                                "ru": "Поездов уже не было, <w>поэтому</w> мы вернулись домой пешком.",
                                "nl": "Er was geen trein meer, <w>dus</w> zijn we te voet naar huis gelopen.",
                                "de": "Es fuhr kein Zug mehr, <w>also</w> gingen wir zu Fuß nach Hause.",
                                "pl": "Nie było już pociągu, <w>więc</w> wróciliśmy do domu pieszo.",
                                "it": "Non c'era più il treno, <w>quindi</w> siamo tornati a casa a piedi.",
                                "cs": "Už nejel žádný vlak, <w>takže</w> jsme šli domů pěšky.",
                                "tr": "Artık tren kalmamıştı, <w>bu yüzden</w> yürüyerek eve döndük.",
                                "es": "No había más trenes, <w>así que</w> volvimos a casa a pie.",
                                "zh": "已经没有火车了，<w>所以</w>我们只好步行回家了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "donc"
                    ],
                    "common_phrases": [
                        "et alors"
