                        "examples": [
                            {
                                "example_id": "62591703-f8e1-48ff-b9c8-e755e4cf3f2d",
                                "sense_id": "039a235d-14e1-3e29-8c50-478c46810122",
                                "text": "Пришёл Данило Сазоныч и стал буянить. Он долго буянил и разбил стекло в окне."
                            },
                            {
                                "example_id": "6db9fe92-6403-4863-b431-1defe12e96b7",
                                "sense_id": "039a235d-14e1-3e29-8c50-478c46810122",
                                "text": "В эту минуту статный молодой мужик вышел из людской избы, и с видом надменным спросил меня, как я смею буянить."
                            }
