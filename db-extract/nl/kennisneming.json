                                                "example_id": "d26450cd-2485-4c82-9531-2a4d6c642039",
                                                "sense_id": "95e18cc8-3f01-3e17-933a-48688fe95ba0",
                                                "text": "The NHRC conducted onsite inspections of Chienchen and Suao Fishing Harbors and held numerous seminars with industry, government, and academia representatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8e2135-36bd-3594-addc-873dd09cc4cf",
                                        "entry_id": "0c889129-e084-345f-91ec-26c8a6c2ae79",
                                        "glosses": [
