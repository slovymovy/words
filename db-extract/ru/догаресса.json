                ],
                "translations": [
                    {
                        "translation_id": "228d9a95-1824-4826-a5c4-52b58c651532",
                        "source_entry_id": "9858810e-3caf-3f56-85b8-209e0c0d4289",
                        "source_sense_id": "dc6a4788-6f13-35cb-be79-5d15b6e50e78",
