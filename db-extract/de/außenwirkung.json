                "senses": [
                    {
                        "sense_id": "7db86592-1825-37b9-af76-96cef72ca16c",
                        "entry_id": "cc94c85c-f8eb-3bde-b795-01f7a57e3a9d",
                        "glosses": [
                            "Wahrnehmung eines Vereins, einer Organisation oder Ähnliches durch die Öffentlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e0416b-b735-4d37-b518-12acf574eb67",
                                "sense_id": "7db86592-1825-37b9-af76-96cef72ca16c",
                                "text": "„Die Diskussionsabende wurden eingestellt, und die Münchner USPD entwickelte ebenfalls keine nennenswerte Außenwirkung mehr.“"
                            },
                            {
                                "example_id": "b41227c2-a442-4fc7-9d41-7fb8204b3267",
                                "sense_id": "7db86592-1825-37b9-af76-96cef72ca16c",
                                "text": "„Ihre Lieben waren beschäftigt mit den letzten Vorbereitungen, sodass das Starlet von Trikala seine Gefühle und Gedanken sortieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2394cf97-7363-3b81-bac6-1ed04f46960d",
                        "entry_id": "cc94c85c-f8eb-3bde-b795-01f7a57e3a9d",
                        "glosses": [
                            "von einer Stelle der öffentlichen Verwaltung mittels der ihr zu Gebote stehenden Handlungsformen (etwa Verwaltungsakte) vorgenommene Beeinflussung des Rechtskreises eines Rechtssubjekts, welches außerhalb der Verwaltung steht"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "dc69ecb7-2874-4297-a728-1f601eda6c0b",
                                "sense_id": "2394cf97-7363-3b81-bac6-1ed04f46960d",
                                "text": "Nach langen Beratungen über eine Anpassung der Maßnahmen zum Infektionsschutz entschied man sich im Rathaus, noch am selben Tag Außenwirkung in Gestalt einer ab dem Folgetag geltenden Allgemeinverfügung herzustellen."
                            },
                            {
                                "example_id": "2b7ad041-2add-473b-8836-ff4f2f4acd13",
                                "sense_id": "2394cf97-7363-3b81-bac6-1ed04f46960d",
                                "text": "Solange ein Verwaltungsakt noch nicht bekanntgegeben wurde, entfaltet er keine Außenwirkung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
