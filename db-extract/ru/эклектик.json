                    {
                        "translation_id": "0d5b81fa-7100-4509-947b-5b555043f3a4",
                        "source_entry_id": "9875383b-3135-3d4e-a61a-f6e228009bf3",
                        "source_sense_id": "b4f3ef4c-65d1-3a66-8318-17b54c378fee",
                        "target_lang_word": "eclectic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eclectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                        "entry_id": "1312cda4-7d59-3706-a64a-5e2e14715272",
                                        "glosses": [
                                            "Selecting a mixture of what appears to be best of various doctrines, methods or styles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0b6e55-d179-4d63-8375-15e9352cd8d0",
                                                "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                                "text": "Chunder Sen and the Progressive Brahmists broke entirely with Hinduism...and he selected from the scriptures of all creeds what seemed best in them for instruction and for worship. […] It is an eclectic religion: it seeks to select what is good from all religions, and it has become the latest evidence that no eclectic religion can ever influence large numbers of men."
                                            },
                                            {
                                                "example_id": "065c993d-c193-4fc2-9d6a-cc3d12fa070d",
                                                "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                                "text": "Though rooted in jazz, Byron's music is stylistically eclectic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                        "entry_id": "1312cda4-7d59-3706-a64a-5e2e14715272",
                                        "glosses": [
                                            "Unrelated and unspecialized; heterogeneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b473f8bc-a3c2-441a-8aa4-fa4cf4e7d197",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "All members of the Hominoidea, apes and man, show an eclectic taste in food but select, from a wide range of possibilities, only a few to provide the bulk of their diet."
                                            },
                                            {
                                                "example_id": "1c487f6d-92c1-4a33-817e-a25086a353e1",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "Colvin said Obama has an eclectic taste in music, listening to everything from Indonesian flute music to OutKast to Motown."
                                            },
                                            {
                                                "example_id": "f07df02b-a161-45d0-9909-8711e87e07e0",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "The Austrians concentrated their entire armored formation into the 1st Division; the 2nd Division consisted solely of the wooden ship of the line Kaiser, looking incredibly out of place in a battle of ironclads, along with five frigates; and the 3rd Division had an eclectic collection of smaller gunboats and armed merchantmen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eclectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                                        "entry_id": "60e57a52-c0dd-3f57-b151-66fe6d918021",
                                        "glosses": [
                                            "Someone who selects according to the eclectic method."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17275101-59fe-4aed-ad30-adbb19e0e185",
                                                "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                                                "text": "Neo-Pagans are eclectics, often borrowing from a variety of cultural traditions as they try to shape their religious organizations and practices to meet group and individual needs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
