                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68790083-fe11-43e6-a628-d4f5fa560964",
                        "source_entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "source_sense_description": "pertaining to the Semitic subdivision of Afroasiatic languages",
                        "target_lang_word": "Semitisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semitisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7720913c-989a-36c8-b148-1facbc1a93e9",
                                        "entry_id": "234eb419-b24b-3562-b55a-03b8030bd072",
                                        "glosses": [
                                            "van de Semieten of het Semitisch"
                                        ],
                                        "tags": [
                                            "Jiddisch-Hebreeuws"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c95587a0-ce2b-34a8-b999-bf7ab684bd02",
                                        "entry_id": "234eb419-b24b-3562-b55a-03b8030bd072",
                                        "glosses": [
                                            "behorend of met betrekking tot de taalfamilie waartoe het Arabisch en het Hebreeuws behoren"
                                        ],
                                        "tags": [
                                            "linguistics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1efaf6-1149-4c31-a7a8-8afb422f2578",
                                                "sense_id": "c95587a0-ce2b-34a8-b999-bf7ab684bd02",
                                                "text": "⧖ Sedert eenigen tijd, evenwel, is het in Duitschland, en nu ook in Frankrijk , gebruik geworden , deze liever Semitische Talen te noemen, om ze daardoor van andere te onderscheiden, die in het uitgebreide Oosten gesproken worden, doch van een' andere oorsprong zijn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Semitisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64fa0ea6-c63a-3dee-82b1-f28c1b3b1fb1",
                                        "entry_id": "23aab397-100a-35ac-8f06-d1b45b9bedcc",
                                        "glosses": [
                                            "gereconstrueerde taal als voorganger van de latere Semitische talen"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f813e40-d889-4d99-83aa-291c40dc099a",
                                                "sense_id": "64fa0ea6-c63a-3dee-82b1-f28c1b3b1fb1",
                                                "text": "Een deel van deze Marokkanen sprak Marokkaans-Arabisch en een ander deel sprak een Berbertaal, wat geen Semitische taal is maar wel behoort tot dezelfde taalfamilie als het Semitisch, namelijk het Hamito-semitisch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "021d082c-46f9-4172-bea0-32c94b507e7e",
                        "source_entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "source_sense_description": "pertaining to the Semitic subdivision of Afroasiatic languages",
                        "target_lang_word": "sémitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sémitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "070afb35-b8e1-3800-93be-d1bd5b4e95d7",
                                        "entry_id": "1263e503-8aee-37d0-a15e-3bf19973e7a9",
                                        "glosses": [
                                            "Qui appartient aux sémites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332f0908-df1b-4b71-a229-87e0857448bf",
                                                "sense_id": "070afb35-b8e1-3800-93be-d1bd5b4e95d7",
                                                "text": "Le midi de la France prend de bonne heure le génie mercantile des nations sémitiques."
                                            },
                                            {
                                                "example_id": "da9d92a9-ddae-415b-96d3-90d0f1672e99",
                                                "sense_id": "070afb35-b8e1-3800-93be-d1bd5b4e95d7",
                                                "text": "C’est ce qui permit à une minorité conquérante, politiquement et socialement dominante, de populations surtout chrétiennes, païennes et zoroastriennes, de consolider l’Islam et de soumettre rapidement les mondes sémitiques et iranien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0dc44d-6619-3581-88e0-1759f0aa0135",
                                        "entry_id": "1263e503-8aee-37d0-a15e-3bf19973e7a9",
                                        "glosses": [
                                            "Qui appartient à un groupe de langues possédant des racines de trois lettres autour desquelles s’organisent leur vocabulaire (notamment l’hébreu, l’arabe)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13ac53c-98bb-4f27-81ae-78c572fcb478",
                                                "sense_id": "0a0dc44d-6619-3581-88e0-1759f0aa0135",
                                                "text": "Les langues sémitiques."
                                            },
                                            {
                                                "example_id": "0d6045e0-a213-4579-8406-b20fd7c1d231",
                                                "sense_id": "0a0dc44d-6619-3581-88e0-1759f0aa0135",
                                                "text": "Son exposition de la grammaire hébraïque, avec comparaison des autres idiomes sémitiques, était admirable."
                                            },
                                            {
                                                "example_id": "8767ac8a-4d2d-47d4-8c3d-eff8a9224509",
                                                "sense_id": "0a0dc44d-6619-3581-88e0-1759f0aa0135",
                                                "text": "Pour fournir une vision plus concrète, nous avons choisi de nous pencher sur l'une des langues abordées au Niger, le tamachek. Il s'agit d'une langue appartenant à la famille des langues berbères, parlée par les Touaregs du Sahara nigérien, et apparentée au kabyle d'Algérie. Outre l'alphabet tifinagh, le tamachek du Niger s'écrit aussi dans un alphabet à base latine, enrichi de plusieurs signes diacritiques et de deux caractères non latins - en tout, seize caractères spéciaux. Ce nombre n'est pas surprenant, puisque le tamachek est une langue sémitique, avec un système de consonnes bien plus riche que celui des langues latines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c4b48a-8715-41d4-a01a-326ec402d46e",
                        "source_entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "source_sense_description": "pertaining to the Semitic subdivision of Afroasiatic languages",
                        "target_lang_word": "semitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26eb1f3d-a44b-3df4-8d12-35e61968305e",
                                        "entry_id": "e975034d-20da-3bfd-9c1b-bbd6c1ea3b04",
                                        "glosses": [
                                            "die Semiten oder deren Sprache betreffend, dazu gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f7473e-a164-46a5-909c-0e3d7b629553",
                                                "sense_id": "26eb1f3d-a44b-3df4-8d12-35e61968305e",
                                                "text": "„Die semitische Kultur ist außerdem durch die Ausbreitung des Islam weit in die ganze Welt transportiert worden.“"
                                            },
                                            {
                                                "example_id": "d95a7cee-1219-4a78-9a8e-b7d44bc097b8",
                                                "sense_id": "26eb1f3d-a44b-3df4-8d12-35e61968305e",
                                                "text": "„Im Zentrum erhob sich ein mit Juwelen besetzter Prachttempel, der dem semitischen Sonnengott Elagabal gewidmet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
