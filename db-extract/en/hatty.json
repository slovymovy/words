    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                "word": "hatty",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "93682a17-a359-48d8-b780-8da48d209417",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "hattier"
                    },
                    {
                        "form_id": "895e459c-e12a-4d81-8e78-bcebc41966e3",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "hattiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99a6198f-c234-3df8-94be-2c7377ff8830",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "glosses": [
                            "Of, relating to, or resembling, a hat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48273fdb-3c84-49b3-88cb-af32a00c7ec8",
                                "sense_id": "99a6198f-c234-3df8-94be-2c7377ff8830",
                                "text": "Every one agrees that there ought to be a reform in Hats […] A proclamation could never accomplish a hatty reform; but we are not prepared to say something might not be done by shrieval interference, which would be consistent with those municipal Institutions that all Englishmen cherish."
                            },
                            {
                                "example_id": "401f56bc-bceb-44a9-bd6d-18c9475c1e1d",
                                "sense_id": "99a6198f-c234-3df8-94be-2c7377ff8830",
                                "text": "Expect a hat which fits the size of your head – it's a very hatty date ."
                            },
                            {
                                "example_id": "f8d73c0e-8ce1-47b6-8e4d-2b582492c74c",
                                "sense_id": "99a6198f-c234-3df8-94be-2c7377ff8830",
                                "text": "The window curtains were milky white, but over-hatted in the hattiest pelmets imaginable."
                            },
                            {
                                "example_id": "0cb024fc-4372-486a-8689-0daf18aae7e9",
                                "sense_id": "99a6198f-c234-3df8-94be-2c7377ff8830",
                                "text": "Everyone will see my hat collections! Today is the day! It will be a Hatty Birthday!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9ffdfe36-caf0-39df-a4a5-94e7b2677ffa",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "glosses": [
                            "Having the features one expects of a hat."
                        ],
                        "tags": [
                            "of a hat"
                        ],
                        "examples": [
                            {
                                "example_id": "17e5528a-cf5e-42e8-94c8-743e9882c5ea",
                                "sense_id": "9ffdfe36-caf0-39df-a4a5-94e7b2677ffa",
                                "text": "He saw a hat, and a most hatty hat, a piece of green felt, shaped with leather and cloth, combining in itself all the quintessentials of hatness contained in all the hats ever made."
                            },
                            {
                                "example_id": "4345ffb9-e663-4324-afd2-2e5682535274",
                                "sense_id": "9ffdfe36-caf0-39df-a4a5-94e7b2677ffa",
                                "text": "She should be very happy with the new hatty hats, but she should wear them at a slight angle."
                            },
                            {
                                "example_id": "27504bfe-0973-4469-92e8-9d0876cfdee6",
                                "sense_id": "9ffdfe36-caf0-39df-a4a5-94e7b2677ffa",
                                "text": "Dey not only made our clo's, but also made out hats. Of co'se dey wa'n't very hatty, but was mo' cappy."
                            },
                            {
                                "example_id": "ed784492-1881-426f-941b-35f593ae2ad0",
                                "sense_id": "9ffdfe36-caf0-39df-a4a5-94e7b2677ffa",
                                "text": "Many of the hattier hats, believe me, were downright gruesome."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b86c839-00cf-304f-bffa-dff21976e9ec",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "glosses": [
                            "Fond of hats."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "ebfb7da5-a040-461b-b620-2da283f79ad3",
                                "sense_id": "8b86c839-00cf-304f-bffa-dff21976e9ec",
                                "text": "Never mind about the top-hat. We aren't hatty people."
                            },
                            {
                                "example_id": "9138ea1b-3af1-4456-95e8-8ba1bc3ca33b",
                                "sense_id": "8b86c839-00cf-304f-bffa-dff21976e9ec",
                                "text": "Mother was a wee bit hatty and she got the milliner in Clarkston Road to line our straw hats with pink silk, and put daisies round them."
                            },
                            {
                                "example_id": "9f434e15-a270-4c6f-86c5-7ad8680eee34",
                                "sense_id": "8b86c839-00cf-304f-bffa-dff21976e9ec",
                                "text": "We must confess that we never yet heard of such a very hatty Lord Mayor , though we have frequently heard of a Hatti-Sheriff."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b5b9d7f-bd5a-3a52-8414-2041a1e321f2",
                        "entry_id": "5ccd2de5-0235-35a3-bae4-19a307bea8c1",
                        "glosses": [
                            "Characterized by the wearing of hats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d9f76f-92a1-4265-b4b3-d27fc117a734",
                                "sense_id": "3b5b9d7f-bd5a-3a52-8414-2041a1e321f2",
                                "text": "London remains the hattiest city in the world, and yet in this year of celebrations it has let Paris glorify the birth of the beaver."
                            },
                            {
                                "example_id": "b908fd84-fdbc-46ae-af8c-f00bf4e054a1",
                                "sense_id": "3b5b9d7f-bd5a-3a52-8414-2041a1e321f2",
                                "text": "They all sat about in the summer-house and in garden-chairs, and were very hatty and ruffly and sunshadey: Three ladies and the curate played croquet with a general immense gravity broken by occasional loud cries of feigned distress from the curate."
                            },
                            {
                                "example_id": "1d2bfb03-a1d2-4357-8670-59c5b0983c26",
                                "sense_id": "3b5b9d7f-bd5a-3a52-8414-2041a1e321f2",
                                "text": "The first time it happened we were at some big soirée, full of respectable, hatty ladies."
                            },
                            {
                                "example_id": "ce2a20cd-d77c-4315-ad1c-2c18ec7a0e05",
                                "sense_id": "3b5b9d7f-bd5a-3a52-8414-2041a1e321f2",
                                "text": "In addition, Stephen Jones produced seven hats and, as the show was only eighteen looks, it was, he said, “fairly hatty”."
                            }
                        ]
                    }
                ],
