                "senses": [
                    {
                        "sense_id": "fa63e98c-34cf-36f4-bd3d-7c8f17c90a2a",
                        "entry_id": "2d71fd0e-c80c-3ca1-bbe8-f5b4cf72625c",
                        "glosses": [
                            "weibliche Person, die das Hammerwerfen ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f18dcc-a525-4029-b525-dd5bb87ffd8e",
                                "sense_id": "fa63e98c-34cf-36f4-bd3d-7c8f17c90a2a",
                                "text": "Als Hammerwerferin hat Karlotta einige Erfolge vorzuweisen."
                            },
                            {
                                "example_id": "af624972-4fd0-4b59-ae52-1ab2f60e09f1",
                                "sense_id": "fa63e98c-34cf-36f4-bd3d-7c8f17c90a2a",
                                "text": "Die jungen Hammerwerferinnen Ludmilla und Gyde kommen heute zu uns in den Unterricht und wollen euch für ihren Sport begeistern."
                            },
                            {
                                "example_id": "0b5f0c32-50cd-470a-a121-6cd7147ac741",
                                "sense_id": "fa63e98c-34cf-36f4-bd3d-7c8f17c90a2a",
                                "text": "„Hammerwerferin Tatjana Lysenko ist der aktuellste Fall in der Reihe jener Sportler, deren Dopingproben der Olympischen Spiele 2008 und 2012 bei Nachtests positiv gewesen waren.“"
                            }
                        ],
