    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                "word": "broomstick",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f8bcc7da-2606-4c67-a8d9-5e76ed8111f7",
                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "tags": [
                            "plural"
                        ],
                        "form": "broomsticks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bdc16e2-c4c4-3bfa-aab0-e3f851389aa1",
                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "glosses": [
                            "The handle of a broom (sweeping tool); (sometimes) the entire broom."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "glosses": [
                            "A broom imbued with magic, enabling one to fly astride the handle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebdc3046-8200-4713-9f0a-4f63a53b4daf",
                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                "text": "Witches of all ages attended these lively gatherings by flying away on their broomsticks[.]"
                            },
                            {
                                "example_id": "7dce2699-ebb2-40a7-b690-5743b5277218",
                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                "text": "She really was a witch now. No one but a witch could fly a broomstick."
                            },
                            {
                                "example_id": "f2e2e906-db2d-4ac8-a920-554496dc5734",
                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                "text": "Harry ripped the parcel open and gasped as a magnificent, gleaming broomstick rolled out onto his bedspread. [...] It was a Firebolt, identical to the dream broom Harry had gone to see every day in Diagon Alley."
                            },
                            {
                                "example_id": "2e7ab98e-4167-40de-a071-047249411be8",
                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                "text": "Greebo, hiccuping occasionally, oozed into his accustomed place among the bristles of Nanny’s broomstick. As they rose above the forest a thin plume of smoke also rose from the castle."
                            },
                            {
                                "example_id": "ffb3b9f2-0d75-468e-86cd-1e18cee79527",
                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                "text": "Most people are familiar with the age-old superstition that witches fly on broomsticks to their covens (though they were formerly also reputed to use shovels, cleft sticks, eggshells, ANIMALS and other means of flight)."
                            }
                        ]
                    },
                    {
                        "sense_id": "3734edb3-00a2-3226-b490-4c6c6f81fd9a",
                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "glosses": [
                            "A control stick of an airplane or other vehicle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "167c442f-50ee-364f-8d24-deaf5a65ac30",
                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "glosses": [
                            "A firearm."
                        ],
                        "tags": [
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "84e8e3ae-1602-4c0f-896b-25ca6562cb8d",
                                "sense_id": "167c442f-50ee-364f-8d24-deaf5a65ac30",
                                "text": "Gangdem known for the shootings, go ask Ramz – got whooshed with a broomstick."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2946dc71-f2cf-49bb-a285-c71cdb522e5b",
                        "source_entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                        "source_sense_description": "the handle of a broom",
                        "target_lang_word": "bezemsteel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezemsteel",
