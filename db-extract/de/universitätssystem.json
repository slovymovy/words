                "senses": [
                    {
                        "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                        "entry_id": "8b5dd99b-1942-3563-9e76-558b781b2bb3",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der akademischen Ausbildung an einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75877b57-487c-4aeb-9184-c4ddff887ee5",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„Das deutsche Universitätssystem transferiert jährlich enorm viel Geld, Status, Privilegien und Teilhabechancen in die höheren Gesellschaftsschichten.“"
                            },
                            {
                                "example_id": "f6414f16-ccc0-49ae-90a6-6c3acdaaecd5",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„In Großbritannien sieht man in den Reformplänen eine Gefahr für das Universitätssystem.“"
                            },
                            {
                                "example_id": "cca7e146-5132-4c86-a798-9285d45397b3",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„‚Bis man die eigenen Lernmethoden an das Universitätssystem angepasst hat, können die ersten Rückschläge in Form von nicht oder nur schlecht bestandenen Prüfungen bereits eingetreten sein. […]‘“"
                            },
                            {
                                "example_id": "60d9f33b-ff81-486e-a920-e1647ebf381a",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„Zum Erfolg: Die Reform des Schul- und Universitätssystems muß - nicht erst seit Pisa - in Deutschland an erster Stelle stehen.“"
                            },
                            {
                                "example_id": "275cdc94-956b-43a4-9351-3b34165d4208",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„Deutschland löst danach mit seinen gut 250.000 Studierenden, die ihre Studienberechtigung im Ausland erworben haben, Frankreich auf Platz vier der meistbesuchten Universitätssysteme ab.“"
                            },
                            {
                                "example_id": "f8611687-87a0-4381-be07-1c11beddd28a",
                                "sense_id": "b732f001-5b39-3e61-8756-fb2381764cee",
                                "text": "„An Universitätssystemen, die schon länger Erfahrungen mit derartigen Reformen gemacht haben, kann man einen Effekt beobachten: die Neigung der Begabten zur Wissenschaft selber nimmt ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
