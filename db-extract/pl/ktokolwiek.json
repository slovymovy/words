                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35babb5-2272-45c9-8fd6-04bc57f30926",
                                                "sense_id": "271babf6-3858-366a-8fc1-c5a464f61069",
                                                "text": "Everybody who wants to be anybody will come to Jake's party."
                                            },
                                            {
                                                "example_id": "4b601933-7681-4f85-b4ca-6fc2473b9a3e",
                                                "sense_id": "271babf6-3858-366a-8fc1-c5a464f61069",
                                                "text": "Here one isn't anybody, if one doesn't dance like Travolta."
