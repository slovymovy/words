                "senses": [
                    {
                        "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                        "entry_id": "2f6570e9-80df-3671-a32a-abcd5210ecfb",
                        "glosses": [
                            "die Menge der Zuseher"
                        ],
                        "tags": [
                            "besonders österreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "b148d9ba-fb93-4df6-892a-97ed6b7a3599",
                                "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                                "text": "„Selbst die Rede zur Nation der US-Präsidenten werde damit an einer ausgewählten Zuseherschaft vorab auf ihre Wirkung getestet.“"
                            },
                            {
                                "example_id": "1180dcde-5afd-415f-82d6-414dbf9e4f1f",
                                "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                                "text": "Die Zuseherschaft dieses Fernsehsenders ist hauptsächlich am Sport interessiert."
                            },
                            {
                                "example_id": "17cf24f2-a33d-4cc3-9eb8-b0aa87ec0f58",
                                "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                                "text": "Dass - wie der Beschwerdeführer behauptet - durch die Schlussbemerkung – „bleibt heute offen, was tatsächlich gesagt wurde“ – ein durch Einstellung der Ermittlungen „geschlossenes Verfahren für die Zuseherschaft aufs Neue aufgemacht wird“, kann der Bundeskommunikationssenat daher nicht erkennen."
                            },
                            {
                                "example_id": "fb00f664-ccf5-41a0-bb1d-73703daec60e",
                                "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                                "text": "Die Austrian Freeski Open 2009, Österreichs größter Freeski Event, gingen letzte Woche in einem fulminanten Finale zu Ende. Atemberaubende Aufnahmen inkl. Helikopter finden in den TV-Highlights sowie den 13 und 26 Minuten TV-Shows weltweite Zuseherschaft…"
                            },
                            {
                                "example_id": "f32005aa-72cb-443d-927a-af88b4c6a772",
                                "sense_id": "2163eb21-afce-31f5-8a73-856c6a1f788a",
                                "text": "Vor einigen Jahren hat die US-Spielshow „Let´s Make A Deal“ (Moderator Monty Hall) für heftige Kontroversen unter der Zuseherschaft geführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
