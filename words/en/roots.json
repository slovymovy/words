                        "family roots",
                        "return to one's roots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Семейное или этническое происхождение человека, его предки.",
                        "fr": "Origines familiales, ethniques ou culturelles d'une personne."
                    },
                    "translations": {
