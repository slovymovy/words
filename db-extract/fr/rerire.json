                                "sense_id": "07537cd7-817c-35e5-82b6-65e1b429da8f",
                                "text": "Jean-qui-rerit"
                            },
                            {
                                "example_id": "797a2a61-a86e-4d13-ac32-140ce89bcfad",
                                "sense_id": "07537cd7-817c-35e5-82b6-65e1b429da8f",
                                "text": "Ben, si qu’y r’pique au balthazar, / Gn’a pas d’erreur, on va rerire."
                            },
                            {
                                "example_id": "3a23b341-b7b7-4495-b180-e4590a907ea5",
                                "sense_id": "07537cd7-817c-35e5-82b6-65e1b429da8f",
                                "text": "Rebonsoir, chérie... Es-tu prête à rerire jusqu'à en pleurer ?"
                            },
                            {
                                "example_id": "a6e88ea6-124f-477b-9ec5-3718e2441d2e",
                                "sense_id": "07537cd7-817c-35e5-82b6-65e1b429da8f",
                                "text": "donc je me fais rire et même rerire de me relire !!"
                            }
                        ]
