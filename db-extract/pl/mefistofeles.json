                "senses": [
                    {
                        "sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                        "entry_id": "8ef49ecb-f01c-393e-9de1-302cee0953fb",
                        "glosses": [
                            "upadły anioł"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71ed3aa9-ed31-40ba-b3e1-f43d9a7f6e52",
                                "sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                                "text": "Ale przed nim miał jeszcze przyjść diabeł filozof, oświeceniowy intelektualista, goetheański Mefistofeles"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428b8f9e-7a0b-4b08-b020-9654487b32c0",
                        "source_entry_id": "8ef49ecb-f01c-393e-9de1-302cee0953fb",
                        "source_sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                        "target_lang_word": "Mephistopheles",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mephistopheles",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22713b3-9784-3230-b6f7-878a75bfcb1c",
                                        "entry_id": "d782133c-e479-3373-908c-45347508e282",
                                        "glosses": [
                                            "The Devil to whom Faust sold his soul in the legend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c3f0cd-92f9-420e-8b37-ca0bf3ceb4f0",
                                                "sense_id": "e22713b3-9784-3230-b6f7-878a75bfcb1c",
                                                "text": "I let him run on, this papier-maché Mephistopheles, and it seemed to me that if I tried I could poke my forefinger through him, and find nothing inside but a little loose dirt, maybe."
                                            },
                                            {
                                                "example_id": "71786d0a-f39c-4854-9f27-4346aa704e20",
                                                "sense_id": "e22713b3-9784-3230-b6f7-878a75bfcb1c",
                                                "text": "When I'm at the pearly gates / This'll be on my videotape, my videotape / When Mephistopheles is just beneath / And he's reaching up to grab me"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mephistopheles",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                                        "entry_id": "15c0b6df-b717-38fc-a1bc-dba110aa23ea",
                                        "glosses": [
                                            "A fiendish person, especially one who tricks someone into following a destructive or disastrous course of action; a tempter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24511b56-a384-4621-a644-f3eb1468374e",
                                                "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                                                "text": "Poison in my idle mind makes quick work for the Mephistopheles, / Who quickly makes his excuses"
                                            },
                                            {
                                                "example_id": "cbeeda54-7965-4faf-82a9-597ae9ac1a13",
                                                "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                                                "text": "A man weeping in moral torment over bags of money; another so bored, depressed and isolated that he can barely raise his eyes to yet another shopping cart full of cash. These are the products of what I have come to think of as Donaldson in full Mephistopheles mode. “Look what these creatures of flesh and blood will do for cash,” he seems constantly on the verge of intoning, as he observes his subjects like so many mazed rats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6dc39ea-5f4a-42fe-8caf-9cc7cb11f284",
                        "source_entry_id": "8ef49ecb-f01c-393e-9de1-302cee0953fb",
                        "source_sense_id": "89eac26a-27ed-3766-a80a-5d7b30c6408a",
                        "target_lang_word": "Méphistophélès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Méphistophélès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3856fe27-bdd5-3338-ac60-acc0d283ddcc",
                                        "entry_id": "5a800cf2-2f77-3e76-9f2d-85374ea047f7",
                                        "glosses": [
                                            "Représentation du diable ou du démon en religion, dans la littérature et dans la peinture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f630710-6612-4c59-a359-2650edb7dc42",
                                                "sense_id": "3856fe27-bdd5-3338-ac60-acc0d283ddcc",
                                                "text": "Eh bien! se dit-il en riant comme Méphistophelès, j’ai plus d’esprit qu’eux; je sais choisir l’uniforme de mon siècle."
                                            },
                                            {
                                                "example_id": "4c1645ac-8682-40ea-bc21-ca219e371e8b",
                                                "sense_id": "3856fe27-bdd5-3338-ac60-acc0d283ddcc",
                                                "text": "Vous ne sauriez imaginer combien un pareil visage vous intrigue ; surtout quand ce visage, pâle et creusé, se termine en pointé comme celui de Méphistophélès que les peintres ont copié sur le masque des chats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
