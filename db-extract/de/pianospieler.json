                    {
                        "translation_id": "9bd2e7c5-fddb-4908-8e5c-b20f21798213",
                        "source_entry_id": "3728fe69-7c1b-3573-b527-f297ff05c8cb",
                        "source_sense_id": "b4a43ba9-fcec-3df8-a5e6-5d97f5f4f2e4",
                        "source_sense_description": "Person, die (professionell) Piano spielt",
                        "target_lang_word": "pianist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pianist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A person who plays the piano, particularly with skill or as part of an orchestra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc4df5c-b31d-4fc0-be89-4401c335d124",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "By the time she became the world's greatest pianist, she had already practised for thousands of hours on her prized piano."
                                            },
                                            {
                                                "example_id": "dd939a5c-e068-4009-a6c7-756028df8914",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "Table IV shows that the pianists were significantly better on both motor and perceptual timing than the nonpianists."
                                            },
                                            {
                                                "example_id": "9cfeebfc-cfdc-4c7d-84f4-bcc351db338f",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "The pianist was Jason Moran, another Houstonian, for whom the past converges with the present: he sometimes likes to find an unobtrusive sequence inside an old standard and turn it into fresh headlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6a82f5-1234-33a8-9fe7-a5664c3535d5",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A spy using radio or wireless telegraphy to keep in touch with headquarters during the Second World War."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c98e9a4b-8e1d-4514-809b-8b477168a9a2",
                        "source_entry_id": "3728fe69-7c1b-3573-b527-f297ff05c8cb",
                        "source_sense_id": "b4a43ba9-fcec-3df8-a5e6-5d97f5f4f2e4",
