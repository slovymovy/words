                ],
                "senses": [
                    {
                        "sense_id": "d6280ae1-c917-3cc0-a81f-9445f6aaed95",
                        "entry_id": "8196cf59-f32d-3e9d-941b-050e3e8025a9",
                        "glosses": [
                            "Fabriquer (des pièces creuses) à partir d’un matériau polymère, le plus souvent en poudre fine, qui fond et qui se répartit de manière uniforme sur la paroi interne d’un moule chaud animé de mouvements de rotation autour de plusieurs axes."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "c49f532f-fb86-43a5-a9cb-4135a8f8dc8d",
                                "sense_id": "d6280ae1-c917-3cc0-a81f-9445f6aaed95",
                                "text": "La première difficulté à rotomouler des composites tient au fait qu’une différence de taille ou de poids (masse volumique) entre les particules polymères et l’agent de renfort/remplissage engendre une ségrégation naturelle lors de la rotation dans le moule."
                            },
                            {
                                "example_id": "4512cfb4-8584-4509-968c-add33c45e08e",
                                "sense_id": "d6280ae1-c917-3cc0-a81f-9445f6aaed95",
                                "text": "Au sein de ses ateliers, l’entreprise compte aujourd’hui 4 machines permettant de rotomouler des sphères jusqu’à 3,50 m de diamètre."
                            },
                            {
                                "example_id": "38d781a4-d80b-4de2-8850-b4e4b5dd025c",
                                "sense_id": "d6280ae1-c917-3cc0-a81f-9445f6aaed95",
                                "text": "En même temps, il possède d’excellentes propriétés thermiques et mécaniques, il est polyvalent, facile à rotomouler et relativement peu coûteux."
                            }
                        ]
                    }
                ],
