            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72896638-6f47-3990-a675-1a50a94a24e6",
                    "sense_definition": "gebeuren of plaatsvinden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gebeurtenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dergelijke fouten <w>komen</w> helaas nog vaak <w>vóór</w> in dit systeem.",
                            "target_lang_translations": {
                                "en": "Such errors unfortunately still <w>occur</w> often in this system.",
                                "ru": "Такие ошибки, к сожалению, все еще часто <w>встречаются</w> в этой системе."
                            }
                        },
                        {
                            "text": "Het kan <w>vóórkomen</w> dat de trein een paar minuten vertraging heeft.",
                            "target_lang_translations": {
                                "en": "It can <w>happen</w> that the train is delayed by a few minutes.",
                                "ru": "Может <w>случиться</w>, что поезд задержится на несколько минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebeuren",
                        "plaatsvinden",
                        "voorvallen"
                    ],
                    "common_phrases": [
                        "vaak vóórkomen",
                        "zelden vóórkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to happen, occur, or take place",
                        "ru": "происходить или иметь место"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "to happen or take place"
                            },
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to take place by chance or as a result of something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "о событиях или ошибках"
                            },
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "о ситуациях"
                            },
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "о частоте явлений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c3b1fce-6719-3c59-8d39-071861f1ed25",
