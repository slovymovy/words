                        "examples": [
                            {
                                "example_id": "95915ec8-b734-411c-88fc-c899dd610bfb",
                                "sense_id": "ae42f4d4-ee0e-3913-ba5f-14653db68178",
                                "text": "Een doodverklaarde gevangene is bij bewustzijn gekomen in een mortuarium in de regio Asturië in het noorden van Spanje. Gonzalo Montayo Jiménez kwam bij in een lijkzak, kort voordat autopsie op hem zou worden uitgevoerd."
                            },
                            {
                                "example_id": "82a31ba2-409e-43ba-9f0c-6779b8adc462",
                                "sense_id": "ae42f4d4-ee0e-3913-ba5f-14653db68178",
                                "text": "Na aanhouding van de 27-jarige man op 5 januari zou de verdachte zich tijdens zijn verhoor bedreigend hebben uitgelaten richting de politieagenten. De man zei onder meer: ‘Als ik vrij kom heb je pas een zaak, dan kunnen jullie een lijkzak meenemen. Als ik vast kom te zitten, is ze pas echt aan de beurt.’"
                            }
                        ]
                    }
