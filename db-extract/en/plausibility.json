                    },
                    {
                        "translation_id": "7af1f083-281a-4951-9adf-83bcc4928eaf",
                        "source_entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                        "source_sense_description": "believability",
                        "target_lang_word": "Plausibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plausibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b693fa7-e65c-3152-b13a-7f893f2765ad",
                                        "entry_id": "ebf76411-0f15-3cb0-9e0c-0ff30c6ed421",
                                        "glosses": [
                                            "Eigenschaft, nachvollziehbar aufgebaut und allem Anschein nach so, wie dargestellt, glaubhaft/richtig (plausibel) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9cf47b-1ee4-4aa7-ae2a-157b2ddc2b64",
                                                "sense_id": "7b693fa7-e65c-3152-b13a-7f893f2765ad",
                                                "text": "„Die Leistung ‚Prüfung der Verdingungsunterlagen für die Vergabeeinheiten auf Vollständigkeit und Plausibilität sowie Bestätigen der Versandfertigkeit‘ wurde in der Kommentierung überarbeitet.“"
                                            },
                                            {
                                                "example_id": "a240ed88-83c5-45b2-91fc-01be24e5d07e",
                                                "sense_id": "7b693fa7-e65c-3152-b13a-7f893f2765ad",
                                                "text": "„Ab § 8 mangelt es dem Bericht des Thukydides deutlich an Plausibilität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84c9ae5a-3a68-3250-9a7e-0d146175e12b",
                                        "entry_id": "ebf76411-0f15-3cb0-9e0c-0ff30c6ed421",
                                        "glosses": [
                                            "Eigenschaft/Tatsache, zwar vermutlich glaubhaft, dennoch aber unbewiesen und hypothetisch zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769d8a2c-f583-4610-aa34-112436f62d0f",
                                                "sense_id": "84c9ae5a-3a68-3250-9a7e-0d146175e12b",
                                                "text": "„Die Zuordnung der Motive zu den Grundbedürfnissen erfolgte über Plausibilität und Indizien.“"
                                            },
                                            {
                                                "example_id": "c2cd66d0-6dd3-4a93-aebf-7752d90e9232",
                                                "sense_id": "84c9ae5a-3a68-3250-9a7e-0d146175e12b",
                                                "text": "„Ganz folgerichtig besteht auch hier wie dort die Interpretation der Funde zunächst im Erarbeiten von Plausibilitäten.“"
                                            },
                                            {
                                                "example_id": "5fc0e67a-9802-43d2-bd18-2326cfe778c8",
                                                "sense_id": "84c9ae5a-3a68-3250-9a7e-0d146175e12b",
                                                "text": "„Nicht zu übersehen ist dabei die Gefahr, da sich in Sprachglossen und Stillehren zur vordergründigen Plausibilität noch die Überzeugungskraft der glänzenden Formulierung gesellt, daß nicht einmal nur vertrauensselige Gemüter allzuleicht geneigt sein werden, so auch das gutverpackte Negative als sprachstilistische Wahrheit zu akzeptieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
