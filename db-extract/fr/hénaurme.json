                        "examples": [
                            {
                                "example_id": "8ad2cd3d-9e52-4033-aed2-e7ab8401ba0b",
                                "sense_id": "40710412-aa27-3caa-b438-cb6283495eeb",
                                "text": "« C’est évidemment assez hénaurme » s’écria Jerphanion, repris par une bienfaisante gaîté intellectuelle, « assez hénaurme, et d’ailleurs très vraisemblable »."
                            },
                            {
                                "example_id": "7497819e-4bda-4865-8e5b-d6963e37a7b7",
                                "sense_id": "40710412-aa27-3caa-b438-cb6283495eeb",
                                "text": "Emma, telle qu’il nous la racontait, n’était pas seulement une idiote gangrenée par « la poussière des vieux cabinets de lecture », mais un sac d’énergie phénoménal, et c’était Flaubert qu’on entendait, par la voix de Perros ricaner devant ce gâchis Hénaurme !"
                            },
                            {
                                "example_id": "0e65fbea-f44c-43b7-b42d-cc8644b2a9a6",
                                "sense_id": "40710412-aa27-3caa-b438-cb6283495eeb",
                                "text": "Il y a eu un hénaurme travail de débroussaillage fait par les journalistes en ce qui concerne la corruption, la collusion et les retours d'ascenseur dans le domaine politique."
                            }
                        ]
                    }
