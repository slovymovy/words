                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                                        "entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                                        "glosses": [
                                            "A believer in the Mormon religion, which views Joseph Smith as a prophet of God and holds the Bible and the Book of Mormon as its primary scriptures."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71eb344d-171f-49c8-94d8-a3e44a4d06e0",
                                                "sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                                                "text": "That year, 1871, had marked a change which had been gradually coming in the lives of the peace-loving Mormons of the border."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mormon",
                                "target_lang_code": "en",
