                "senses": [
                    {
                        "sense_id": "51ae1c3c-e87e-3eec-916c-fd95cc4df846",
                        "entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
                        "glosses": [
                            "геогр. историческая и географическая область на Балканах"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb61a61b-6b3d-3326-a189-eb152a17cf07",
                        "entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
                        "glosses": [
                            "полит. частично признанное государство в Юго-Восточной Европе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf43f870-06da-4ac9-815f-196fd2a2766b",
                                "sense_id": "eb61a61b-6b3d-3326-a189-eb152a17cf07",
                                "text": "― Она граничит с Албанией, Косово, Сербией, Черногорией."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e003eb3-f3a2-30d6-a899-9af73618c34e",
                        "entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
                        "glosses": [
                            "истор. вилайет Османской империи"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "03fa825e-0f8a-3159-b9b8-a7b3d80c642e",
                        "entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
                        "glosses": [
                            "геогр. названия некоторых населённых пунктов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4094795d-e201-4533-8ca0-dc52e52c1cb5",
                                "sense_id": "03fa825e-0f8a-3159-b9b8-a7b3d80c642e",
                                "text": "Потом был в Косове, что в Закарпатье."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad2b72b-9735-4e61-a75f-5994b2a2f20b",
                        "source_entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
                        "source_sense_description": "историческая область",
                        "target_lang_word": "Kosovo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosovo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                        "entry_id": "73e86c34-e757-37d3-affe-45aaa7258195",
                                        "glosses": [
                                            "A partly-recognized country on the Balkan Peninsula in Southeast Europe. Official name: Republic of Kosovo. Capital and largest city: Pristina. Considered by the Republic of Serbia to be one of its two autonomous provinces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d821cadf-f327-4383-bf06-62e6be3f2c9b",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            },
                                            {
                                                "example_id": "93629df5-941e-48da-b486-d135d8302b6e",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "After Milosevic’s overthrow in October 2000, international pressure on the new authorities in Belgrade to extradict Milosevic for alleged war crimes committed during the Kosovo conflict was intense."
                                            },
                                            {
                                                "example_id": "be7d6c04-a698-48b0-ab06-98fe763996d8",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "A prominent Kosovo Serb politician, Oliver Ivanovic, was shot dead outside his party offices Tuesday morning, halting talks between Kosovar and Serb delegates that had been set to resume that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1755dff0-befd-3e68-8c40-7aa21521f9ab",
                                        "entry_id": "73e86c34-e757-37d3-affe-45aaa7258195",
                                        "glosses": [
                                            "One of five administrative districts of the above region as viewed by the Serbian government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8956136-b819-43e7-9098-168a46a38bf9",
                        "source_entry_id": "e00a84e2-7370-3c82-98e2-0ee1c2726067",
