                        ],
                        "examples": [
                            {
                                "example_id": "54bb8089-1b39-48ad-b0ce-970bc50057c8",
                                "sense_id": "cf78f2e9-c0c5-3589-b678-3336daf2c245",
                                "text": "— Ты это читал? — Ну? (то есть: да, читал, и что?)"
                            }
                        ]
                    },
                    {
                        "sense_id": "8d76ac71-2936-3602-8897-aa73fef751c6",
