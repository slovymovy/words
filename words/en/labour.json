{
    "word_family": [
        "labourer",
        "laborious",
        "laboriously",
        "belabour"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50f8b8c1-e6d5-326a-9f34-79d1cfb8d779",
                    "sense_definition": "Physical or mental effort expended on a particular task; hard work.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction of the bridge required years of hard <w>labour</w>.",
                            "target_lang_translations": {
                                "ru": "Строительство моста потребовало многих лет тяжелого <w>труда</w>.",
                                "zh": "这座桥的建造需要多年的艰苦<w>劳动</w>。"
                            }
                        },
                        {
                            "text": "He was exhausted after a long day of manual <w>labour</w> in the fields.",
                            "target_lang_translations": {
                                "ru": "Он был измотан после долгого дня физического <w>труда</w> в полях.",
                                "zh": "在田里干了一整天体力<w>劳动</w>后，他精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "work",
                        "toil",
                        "effort"
                    ],
                    "common_phrases": [
                        "manual labour",
                        "hard labour",
                        "division of labour",
                        "fruits of labour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физические или умственные усилия, затрачиваемые на определенную задачу; тяжелая работа.",
                        "zh": "指在特定任务上所付出的体力或脑力，即辛苦的工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труд",
                                "target_lang_sense_clarification": "усилие, деятельность"
                            },
                            {
                                "target_lang_word": "работа",
                                "target_lang_sense_clarification": "занятие, дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劳动",
                                "target_lang_sense_clarification": "指体力或脑力劳动"
                            },
                            {
                                "target_lang_word": "工作",
                                "target_lang_sense_clarification": "指职业或任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69121da3-4315-398a-a169-899d1257a84c",
                    "sense_definition": "Workers in general, considered as a group or class, especially those doing manual work.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "workforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cost of <w>labour</w> has increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Стоимость <w>рабочей силы</w> в этом году значительно выросла.",
                                "zh": "今年<w>劳动力</w>成本大幅上升。"
                            }
                        },
                        {
                            "text": "There is a shortage of skilled <w>labour</w> in the manufacturing sector.",
                            "target_lang_translations": {
                                "ru": "В производственном секторе наблюдается нехватка квалифицированной <w>рабочей силы</w>.",
                                "zh": "制造业部门缺乏熟练<w>劳动力</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "child labour",
                        "skilled labour",
                        "cheap labour",
                        "labour market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рабочие в целом, рассматриваемые как группа или класс, особенно занимающиеся физическим трудом.",
                        "zh": "指作为一个群体或阶层的劳动者，尤指从事体力劳动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочая сила",
                                "target_lang_sense_clarification": "экономический ресурс"
                            },
                            {
                                "target_lang_word": "рабочие",
                                "target_lang_sense_clarification": "персонал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劳动力",
                                "target_lang_sense_clarification": "作为经济资源的工人"
                            },
                            {
                                "target_lang_word": "工人",
                                "target_lang_sense_clarification": "指劳动者群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75197c86-2068-369e-a790-37612afea026",
                    "sense_definition": "The process of giving birth to a baby, involving the contraction of the uterus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "childbirth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went into <w>labour</w> early in the morning and went to the hospital.",
                            "target_lang_translations": {
                                "ru": "У нее начались <w>роды</w> рано утром, и она поехала в больницу.",
                                "zh": "她清晨开始<w>分娩</w>，随后去了医院。"
                            }
                        },
                        {
                            "text": "The woman was in <w>labour</w> for twelve hours before the baby was born.",
                            "target_lang_translations": {
                                "ru": "Женщина была в <w>родах</w> двенадцать часов, прежде чем родился ребенок.",
                                "zh": "这位女士经历了十二个小时的<w>阵痛</w>才生下孩子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in labour",
                        "go into labour",
                        "long labour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс рождения ребенка, сопровождающийся сокращениями матки.",
                        "zh": "指分娩的过程，伴随子宫收缩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роды",
                                "target_lang_sense_clarification": "рождение ребенка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分娩",
                                "target_lang_sense_clarification": "指生产过程"
                            },
                            {
                                "target_lang_word": "阵痛",
                                "target_lang_sense_clarification": "指分娩时的宫缩痛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a038250a-1325-39ec-8fb9-06e0cf69bf73",
                    "sense_definition": "A traditional unit of land area used in Mexico and Texas, equivalent to about 177 acres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The original land grant included one <w>labour</w> of fertile ground.",
                            "target_lang_translations": {
                                "ru": "Первоначальный земельный надел включал один <w>лабор</w> плодородной земли.",
                                "zh": "最初的土地授予包括一<w>拉博</w>肥沃的土地。"
                            }
                        },
                        {
                            "text": "Farmers in the region historically measured their fields by the <w>labour</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры в этом регионе исторически измеряли свои поля <w>лаборами</w>.",
                                "zh": "该地区的农民历史上用<w>拉博</w>来测量田地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quarter-section"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mexico and Texas"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "traditional unit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная единица измерения площади земли, используемая в Мексике и Техасе, равная примерно 177 акрам.",
                        "zh": "墨西哥和德克萨斯州使用的一种传统土地面积单位，约合177英亩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабор",
                                "target_lang_sense_clarification": "мера площади в Мексике и Техасе (≈177 акров)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉博",
                                "target_lang_sense_clarification": "墨西哥和德克萨斯州的土地面积单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3beaec8-4179-3350-a32e-c330e69113d9",
                    "sense_definition": "To work hard or make a great effort to achieve something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team <w>laboured</w> for months to complete the project on time.",
                            "target_lang_translations": {
                                "ru": "Команда <w>трудилась</w> месяцами, чтобы завершить проект вовремя.",
                                "zh": "团队为了按时完成项目，<w>辛勤工作</w>了数月。"
                            }
                        },
                        {
                            "text": "Farmers <w>laboured</w> in the fields from dawn until dusk.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>трудились</w> в полях от рассвета до заката.",
                                "zh": "农民们从黎明到黄昏都在田里<w>苦干</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grind"
                    ],
                    "common_phrases": [
                        "labour under",
                        "labour for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело работать или прилагать большие усилия для достижения чего-либо.",
                        "zh": "指努力工作或为达成某事付出巨大努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трудиться",
                                "target_lang_sense_clarification": "усердно работать"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "заниматься делом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辛勤工作",
                                "target_lang_sense_clarification": "指努力地工作"
                            },
                            {
                                "target_lang_word": "苦干",
                                "target_lang_sense_clarification": "指付出巨大努力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df47f3d0-4e28-3880-b780-45e6b6d1aa93",
                    "sense_definition": "To move or function with difficulty, often due to a heavy burden or resistance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old truck <w>laboured</w> up the steep hill with its heavy load.",
                            "target_lang_translations": {
                                "ru": "Старый грузовик <w>с трудом взбирался</w> на крутой холм с тяжелым грузом.",
                                "zh": "那辆旧卡车装载着沉重的货物，<w>吃力地</w>爬上了陡坡。"
                            }
                        },
                        {
                            "text": "His breathing was <w>laboured</w> after running the marathon.",
                            "target_lang_translations": {
                                "ru": "Его дыхание было <w>затрудненным</w> после марафона.",
                                "zh": "跑完马拉松后，他的呼吸变得很<w>费力</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "labour up",
                        "labour along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или функционировать с трудом, часто из-за тяжелого груза или сопротивления.",
                        "zh": "指因沉重的负担或阻力而移动或运作困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с трудом двигаться",
                                "target_lang_sense_clarification": "двигаться или работать с напряжением, преодолевая сопротивление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃力地移动",
                                "target_lang_sense_clarification": "指动作费力"
                            },
                            {
                                "target_lang_word": "费力",
                                "target_lang_sense_clarification": "指运作困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2a1779e-05ce-3437-a5f3-d69a2c4f74cb",
                    "sense_definition": "To explain or discuss a point at excessive length or in too much detail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_emphasize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I understand your opinion, so there is no need to <w>labour</w> the point.",
                            "target_lang_translations": {
                                "ru": "Я понимаю ваше мнение, так что нет нужды <w>мусолить</w> этот вопрос.",
                                "zh": "我明白你的意思了，所以没必要再<w>纠缠</w>这一点。"
                            }
                        },
                        {
                            "text": "The speaker <w>laboured</w> the details until the audience became bored.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>слишком долго обсуждал</w> детали, пока аудитория не заскучала.",
                                "zh": "演讲者对细节<w>喋喋不休</w>，直到听众感到厌烦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "labour the point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объяснять или обсуждать вопрос слишком долго или слишком подробно.",
                        "zh": "指对某一点进行过度的解释或讨论，过于冗长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусолить",
                                "target_lang_sense_clarification": "разжёвывать, слишком долго обсуждать (labour a point)"
                            },
                            {
                                "target_lang_word": "разжёвывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喋喋不休",
                                "target_lang_sense_clarification": "指反复唠叨"
                            },
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "指在某点上过度纠结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95a2862-66ab-3a94-b1dd-90189ab2bcd7",
                    "sense_definition": "Of a ship, to pitch or roll heavily in rough seas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small vessel <w>laboured</w> in the storm, taking on water with every wave.",
                            "target_lang_translations": {
                                "ru": "Маленькое судно <w>тяжело шло</w> сквозь шторм, черпая воду с каждой волной.",
                                "zh": "小船在风暴中<w>颠簸</w>，每一波浪打来都会进水。"
                            }
                        },
                        {
                            "text": "As the wind increased, the ship began to <w>labour</w> against the tide.",
                            "target_lang_translations": {
                                "ru": "Когда ветер усилился, корабль начал <w>с трудом преодолевать</w> течение.",
                                "zh": "随着风力增强，船只开始<w>颠簸</w>着逆流而行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О корабле: сильно качаться на волнах в бурном море.",
                        "zh": "指船只在波涛汹涌的海面上剧烈颠簸或摇晃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжело идти",
                                "target_lang_sense_clarification": "о судне: тяжело переваливаться на волне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颠簸",
                                "target_lang_sense_clarification": "指船只在风浪中摇晃"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b16e7715-f9ba-3750-af51-da86ef4493b5",
                    "sense_definition": "A major political party, typically representing the interests of workers and trade unions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political_party",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "She has voted for <w>Labour</w> in every election since she turned eighteen.",
                            "target_lang_translations": {
                                "ru": "Она голосовала за <w>лейбористов</w> на каждых выборах с тех пор, как ей исполнилось восемнадцать.",
                                "zh": "她从十八岁起，每次选举都投给<w>工党</w>。"
                            }
                        },
                        {
                            "text": "The <w>Labour</w> candidate promised to improve public services.",
                            "target_lang_translations": {
                                "ru": "Кандидат от <w>лейбористов</w> пообещал улучшить государственные услуги.",
                                "zh": "<w>工党</w>候选人承诺改善公共服务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Labour Party",
                        "New Labour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная политическая партия, обычно представляющая интересы рабочих и профсоюзов.",
                        "zh": "一个主要的政党，通常代表工人和工会的利益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лейбористская партия",
                                "target_lang_sense_clarification": "политическая организация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工党",
                                "target_lang_sense_clarification": "政党名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}