                "senses": [
                    {
                        "sense_id": "0f6a2216-5901-3c4f-a37d-fc81462f0bd5",
                        "entry_id": "7383bf84-b0ac-301c-aed1-319df833edbb",
                        "glosses": [
                            "Explosion, die durch die Entzündung eines Wasserstoff-Sauerstoff-Gemisches verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b380ad-85ea-44bf-b0be-38fa0166d33e",
                                "sense_id": "0f6a2216-5901-3c4f-a37d-fc81462f0bd5",
                                "text": "Eine Knallgasexplosion wird oft im Chemieuntericht vorgeführt."
                            },
                            {
                                "example_id": "27b411b0-618c-4edd-8beb-c55b051e1682",
                                "sense_id": "0f6a2216-5901-3c4f-a37d-fc81462f0bd5",
                                "text": "„Knallgasexplosionen sind gefährlich.“"
                            },
                            {
                                "example_id": "3d713667-76d1-44c8-88d1-16d87321cb31",
                                "sense_id": "0f6a2216-5901-3c4f-a37d-fc81462f0bd5",
                                "text": "„Ein 40-jähriger Arbeiter ist bei einer Knallgasexplosion Mittwoch früh in der Entsorgungsfirma Vorwagner in Pinsdorf (Bezirk Gmunden) in Oberösterreich verletzt worden.“"
                            },
                            {
                                "example_id": "1b042a92-30f3-4a70-b473-86a817d00ee8",
                                "sense_id": "0f6a2216-5901-3c4f-a37d-fc81462f0bd5",
                                "text": "„In Block 1 von Fukushima-Daiichi (Infografik zum Kernkraftwerk Fukushima 1) kam es am Samstag zu einer Knallgasexplosion, nachdem die Verantwortlichen Meerwasser eingeleitet hatten, um die überhitzten Brennstäbe zu kühlen und so eine möglicherweise fatale Kernschmelze zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
