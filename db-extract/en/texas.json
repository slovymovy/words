                                        "sense_id": "356d3f20-89c6-36be-99d9-f12bbbd42799",
                                        "entry_id": "dce2aa9b-3a0c-3947-b7f5-131956042a71",
                                        "glosses": [
                                            "een van de vijftig deelstaten van de Verenigde Staten van Amerika die ligt aan de Golf van Mexico en die grenst aan de deelstaten Nieuw Mexico, Oklahoma, Arkansas en Louisiana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32585601-f441-4830-8f02-95b0fa215786",
                                                "sense_id": "356d3f20-89c6-36be-99d9-f12bbbd42799",
                                                "text": "Ik vertelde de masseur dat ik de vraag ook aan anderen hikers had gesteld om erachter te komen waarom ze de PCT liepen.Een jongen van 20 jaar uit Texas had me verteld dat hij na het afronden van zijn school direct twee banen had moeten nemen en zich rot verveelde in zijn leven."
                                            }
