                    {
                        "translation_id": "54b45fab-700b-4d96-8a33-275627a56a2c",
                        "source_entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                        "source_sense_description": "an AI machine in science fiction",
                        "target_lang_word": "Terminator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terminator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                        "entry_id": "df041aa4-919f-33a4-a3f7-98fb3c6cd35c",
                                        "glosses": [
                                            "optische Grenzlinie zwischen Tag und Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf5b80a-8417-4d82-97b3-989fdf7b491d",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "Am Terminator sind Mondkrater wegen des Schattenwurfs besonders gut zu beobachten."
                                            },
                                            {
                                                "example_id": "578b5258-d03b-40e8-90f2-423df99a0ac1",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Diese Trennlinie, Terminator genannt, schiebt sich am Mondäquator täglich um 370 km weiter, also mit gemächlichen 15 km/h.“"
                                            },
                                            {
                                                "example_id": "662e3bbb-ff6f-47a9-8aad-41e1f8b9776c",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Die Grenze zwischen Licht und Schatten, der Terminator, wandert langsam über die Mondoberfläche.“"
                                            },
                                            {
                                                "example_id": "48a2aa59-77cc-48e5-8460-d87c5d08f89a",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Die Grenze zwischen beleuchteter und unbeleuchteter Seite, also die Tag-Nacht-Grenze, nennt man Terminator.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Terminator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "380d38bb-89f2-31d6-a902-8e72688cf073",
                                        "entry_id": "29d8dbbb-08bd-3f7d-a111-8dfa0a21be7f",
                                        "glosses": [
                                            "fiktiver Androide aus der gleichnamigen Filmreihe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51ecedc-0a43-4c6e-836b-3d048e7a9f49",
                                                "sense_id": "380d38bb-89f2-31d6-a902-8e72688cf073",
                                                "text": "„›Wir sind vom Stamm der Kalendjin, Krieger ... so wie Rambo‹, antwortete einer und zeigte lachend auf mich. ›Oder Terminator‹, sagte ein anderer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
