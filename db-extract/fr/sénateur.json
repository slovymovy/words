                                            {
                                                "example_id": "43a88175-5f4c-469a-a533-5a098113a04f",
                                                "sense_id": "40f3dd99-0190-3370-a338-71de2a52ce4b",
                                                "text": "В зал входят двенадцать сенаторов, все люди преклонного возраста, у которых на груди больше орденов, чем волос на голове."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fb59ce-4313-32b2-bea4-5411e0186adb",
                                        "entry_id": "787115f7-5cf9-327c-81bc-ca708da7fe35",
                                        "glosses": [
                                            "полит. член верхней палаты законодательного органа, парламента"
                                        ],
                                        "tags": [
                                            "в ряде стран"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4515c5e1-e355-44ab-acab-ced11282ac91",
                                                "sense_id": "11fb59ce-4313-32b2-bea4-5411e0186adb",
                                                "text": "На одном из таких мероприятий был замечен сенатор Тэд Кеннеди."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
