                "senses": [
                    {
                        "sense_id": "edd50afd-3d81-3c7a-b006-c682fd771099",
                        "entry_id": "5ee02323-7307-3e3b-a952-9207c33df297",
                        "glosses": [
                            "osoba aktywna w określonej dziedzinie życia publicznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e1b258-dfac-4aef-8e74-07236914b71f",
                                "sense_id": "edd50afd-3d81-3c7a-b006-c682fd771099",
                                "text": "Polski futbol leży na łopatkach, za to działacze PZPN mają się jak pączki w maśle"
                            },
                            {
                                "example_id": "139dd4df-8186-4593-b5d8-005e5ca7090d",
                                "sense_id": "edd50afd-3d81-3c7a-b006-c682fd771099",
                                "text": "Wiadomość o audiencji przeniknęła do prasy dwa dni po wyjeździe z Włoch działaczy afrykańskich i odbiła się szerokim echem w świecie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "150257b8-8e3b-4937-98cd-d5e9e0d2d6b9",
                        "source_entry_id": "5ee02323-7307-3e3b-a952-9207c33df297",
                        "source_sense_id": "edd50afd-3d81-3c7a-b006-c682fd771099",
                        "target_lang_word": "activist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is politically active in the role of a citizen; especially, one who campaigns for change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d51dbc0-8b5a-4f81-8685-3742673278a8",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            },
                                            {
                                                "example_id": "3987b315-eb54-4a92-87a4-8b07106648c0",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "The six activists will now face a retrial at Highbury Magistrates' Court, in front of a new judge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688bdc77-53e8-3b64-9ebb-e187cffb26a7",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is conspicuously active in carrying out any occupational or professional functions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                        "entry_id": "ba5970b6-e294-398c-90fe-26912fc94068",
                                        "glosses": [
                                            "Behaving as an activist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86eb1319-2809-4571-af82-cc7118489603",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Even in the area of free speech, Justice Harlan sometimes emerged as more activist than his brother"
                                            },
                                            {
                                                "example_id": "41cb93d1-ac0c-4d05-a68a-041573a01159",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Now GM has what may well be the most activist board ever."
                                            },
                                            {
                                                "example_id": "87a8ad9b-2808-49a1-80c1-b561da93f64e",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Gov. Chris Christie has long complained that New Jersey's Supreme Court is too liberal and too activist"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3ebe26-566a-478a-9c73-0c121e932628",
                        "source_entry_id": "5ee02323-7307-3e3b-a952-9207c33df297",
                        "source_sense_id": "edd50afd-3d81-3c7a-b006-c682fd771099",
                        "target_lang_word": "деятель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "деятель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cc6bb1-f41a-3116-906c-e9deb7046891",
                                        "entry_id": "005581a9-d2da-32f7-8a6c-dbaec16385a7",
                                        "glosses": [
                                            "тот, кто проявил себя в какой-либо области общественной жизни; участник чего-либо, активист, лицо, играющее важную активную роль в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d4ee74-59d6-44f2-b7cc-94cc5b3ccdb1",
                                                "sense_id": "a7cc6bb1-f41a-3116-906c-e9deb7046891",
                                                "text": "Он непрерывно занимался трёпом, иной раз небезобидным: всячески разыгрывал напыщенного комсомольского деятеля Петушкова («Наш приятель Петушков без задорин и сучков»), влюбил в себя маленькую, хрупкого вида девочку, и потом отверг её в тот самый момент, когда она готова была ему принадлежать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15134997-fb1d-3220-8aae-0bcf76a07845",
                                        "entry_id": "005581a9-d2da-32f7-8a6c-dbaec16385a7",
                                        "glosses": [
                                            "пренебр. тот, кто действует неуклюже, глупо или отличается слишком активной работой на каком-либо поприще"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
