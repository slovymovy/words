{
    "word_family": [
        "calumniate",
        "calumniator",
        "calumnious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b51156c-42f6-30dd-8e39-b7171a411db1",
                    "sense_definition": "A false and malicious statement made to damage someone's reputation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician dismissed the accusations against him as nothing more than a baseless <w>calumny</w>."
                        },
                        {
                            "text": "She refused to let the cruel <w>calumny</w> destroy her professional standing in the community."
                        }
                    ],
                    "synonyms": [
                        "slander",
                        "defamation",
                        "libel"
                    ]
                },
                {
                    "sense_id": "9275b37d-6804-33d7-8a58-c905d1879846",
                    "sense_definition": "The act of spreading false information to discredit or disparage someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered years of public <w>calumny</w> before his name was finally cleared by the court."
                        },
                        {
                            "text": "The article was filled with such vile <w>calumny</w> that the subject immediately filed a lawsuit."
                        }
                    ],
                    "synonyms": [
                        "vilification",
                        "obloquy",
                        "disparagement"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3070d941-cc36-3bd2-8a1a-8b26f5df09c1",
                    "sense_definition": "To make false and damaging statements about someone's character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rival factions continued to <w>calumny</w> the leader in an attempt to weaken his influence."
                        },
                        {
                            "text": "It is deeply unfair to <w>calumny</w> a person who has no opportunity to defend themselves."
                        }
                    ],
                    "synonyms": [
                        "defame",
                        "slander",
                        "vilify",
                        "malign"
                    ]
                }
            ]
        }
    ]
