                ],
                "senses": [
                    {
                        "sense_id": "f47212e5-0cda-3f1e-94cd-d092b6b7d018",
                        "entry_id": "7cb59258-7b3f-3dfc-a00e-e5932862df7e",
                        "glosses": [
                            "przedstawicielka subkultury młodzieżowej, dziewczyna z blokowiska na co dzień nosząca ubrania sportowe, kojarzona z zaczepnym zachowaniem, tandetnym gustem i skłonnością do popełniania drobnych przestępstw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3297e8e-d34a-46b1-bb2c-c594b8e0cf05",
                                "sense_id": "f47212e5-0cda-3f1e-94cd-d092b6b7d018",
                                "text": "Co ona potrafi? A taka Herbuś to lepsza? Nawet z twarzy jej widać, że prostaczka. Taka trochę jak Doda. Dresiara. Miss blokowiska. Panie to chyba im zazdroszczą, że tak krytykują? A czego mamy zazdrościć? Pięciu minut sławy bez pokrycia?"
                            },
                            {
                                "example_id": "71e50f71-5a2a-4014-98e4-ae8bd9d3e095",
                                "sense_id": "f47212e5-0cda-3f1e-94cd-d092b6b7d018",
                                "text": "Każda dresiara wie, że im bardziej kogoś kochasz, tym bardziej powinnaś to ukrywać, zwłaszcza w stałym związku. Ten, kto bardziej kocha, jest zawsze pod butem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14c5d5fb-8ad0-4bb4-80cd-1a26c1867141",
                        "source_entry_id": "7cb59258-7b3f-3dfc-a00e-e5932862df7e",
                        "source_sense_id": "f47212e5-0cda-3f1e-94cd-d092b6b7d018",
                        "target_lang_word": "chavette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chavette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c509c6d8-e380-3e92-8599-e52cd0830e24",
                                        "entry_id": "8f4d60c6-5081-30b3-adca-14a03713ef1c",
                                        "glosses": [
                                            "A female chav."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "007ee6e7-e836-478e-98b1-fec774dc35a7",
                                                "sense_id": "c509c6d8-e380-3e92-8599-e52cd0830e24",
                                                "text": "So, whenever a big game is being shown on telly the streets and shopping centres will become chav-free zones. (You might spot a few straggling chavettes around who haven't quite realized that the way to attract a chav bloke is to feign an interest in the beautiful game.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
