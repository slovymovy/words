        "fr-extract.jsonl": [
            {
                "entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                "word": "discernement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f9f4b4f9-9f08-41f0-8e38-cd3e92d9e696",
                        "entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                        "tags": [
                            "plural"
                        ],
                        "form": "discernements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                        "entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                        "glosses": [
                            "Faculté de l’esprit qui sert à distinguer les choses, à séparer les questions, à en juger sainement, à apprécier la valeur intellectuelle et morale des gens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ace7c17-c2c2-4e16-98df-31baee31c9ff",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "On a traqué et tué sans relâche. Ces massacres se sont faits sans discernement. Les petits, les femelles pleines n'ont même pas été épargnés."
                            },
                            {
                                "example_id": "832f4b54-5086-428a-be32-f642fb14d474",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "Je ne l’ai rencontré que trois ou quatre fois, assez pour reconnaître un esprit tout ensemble avisé et de faible discernement, je veux dire prodigieusement influençable."
                            },
                            {
                                "example_id": "0e9be56d-0e5b-457e-bb4b-64cc735d814e",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "Avec ce manque complet de discernement qui caractérise les hommes dont on encourage les manies, Pierre trouva Fromentine loyale, franche, naturelle."
                            },
                            {
                                "example_id": "95f51a43-94b4-48e7-a1aa-386593ef4cb3",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "Je me refuse à m’associer à cette bande de tire-blanchaille qui appâtent avec de véritables drogues et ne songent qu’à ramener, sans aucun discernement, le plus gros paquet de poissons possible."
                            },
                            {
                                "example_id": "8bce7220-8462-4db0-9e1b-d8ead5c0f1ce",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "Cabanel, l’homme du présent, mais qui, Zola en fiche son billet et se remet au discernement de l’avenir, sera oublié."
                            },
                            {
                                "example_id": "0a8b3b3d-91fc-4fa7-b5e3-4e554d7548a2",
                                "sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                                "text": "Un vieillard dit : « De toutes les vertus, la plus grande est le discernement. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "393f2b60-3f91-46d7-9a58-bda8330b140a",
                        "source_entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                        "source_sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                        "target_lang_word": "Unterscheidungsvermögen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterscheidungsvermögen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c21812-783d-371e-bc4d-f1c2f58da950",
                                        "entry_id": "cfb690b5-14ff-30b2-acb7-07dd6da695d4",
                                        "glosses": [
                                            "Fähigkeit, Gabe, unterscheiden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f785140e-e2e3-4671-ada3-fc05062a8fd2",
                                                "sense_id": "f2c21812-783d-371e-bc4d-f1c2f58da950",
                                                "text": "„Man definiert ihn als ein beonderes Unterscheidungsvermögen, als eine schnelle Urteilsfähigkeit, als die Gabe, gewisse Zusammenhänge gesondert zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0983201-422c-4ce8-a49a-8247eab57df9",
                        "source_entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                        "source_sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                        "target_lang_word": "Urteilsvermögen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urteilsvermögen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb525d6d-9c9c-34cd-84b3-dda638776b9b",
                                        "entry_id": "d425cf7f-915b-3ded-a8b0-13d951ece9e4",
                                        "glosses": [
                                            "Eigenschaft, Sachverhalte gegeneinander abwägen zu können und sich ein bewertendes Bild zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e07aff7c-1ef2-43f7-86d4-fc3eedb2a0b9",
                                                "sense_id": "eb525d6d-9c9c-34cd-84b3-dda638776b9b",
                                                "text": "Bei fortschreitender Demenz sinkt das Urteilsvermögen."
                                            },
                                            {
                                                "example_id": "e41d9a66-f8bd-4966-8eee-e65394a57466",
                                                "sense_id": "eb525d6d-9c9c-34cd-84b3-dda638776b9b",
                                                "text": "Wer die Zwangslage, den Leichtsinn, die Unerfahrenheit oder den Mangel an Urteilsvermögen eines anderen ausbeutet, handelt kriminell und wird bestraft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
