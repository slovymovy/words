                        "form": "кругове́ртях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddf10527-3bb1-3909-aca6-e7bc9f5ed9ec",
                        "entry_id": "70445243-f356-3b9b-853d-8a32b708285c",
                        "glosses": [
                            "рег., разг. круговое движение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860a4f82-cc12-42d5-a9d3-7acabe985767",
                                "sense_id": "ddf10527-3bb1-3909-aca6-e7bc9f5ed9ec",
                                "text": "Мы выскочили на мостки, смотрим: в воде круговерть, что происходит - не понятно."
                            },
                            {
                                "example_id": "9adc1391-f156-495e-871a-e74c0e7f5aa6",
                                "sense_id": "ddf10527-3bb1-3909-aca6-e7bc9f5ed9ec",
                                "text": "Втихаря зашёптывая смерть, — // Не синяк, не ссадину, не рану, — // Вспоминаешь мельниц круговерть // И в подушках стихшего Кихано..."
                            }
                        ]
                    },
                    {
                        "sense_id": "aad3f1f6-9466-38d9-ab2b-29e0abf01c47",
                        "entry_id": "70445243-f356-3b9b-853d-8a32b708285c",
                        "glosses": [
                            "перен., разг. непрерывное изменение, чередование дел, событий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a620a8-5a89-42df-a12b-d025b1c52380",
                                "sense_id": "aad3f1f6-9466-38d9-ab2b-29e0abf01c47",
                                "text": "Вернулись домой, а у меня опять круговерть поездок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afcd1440-a8ac-43ff-be7a-ebf0c94a715d",
                        "source_entry_id": "70445243-f356-3b9b-853d-8a32b708285c",
                        "target_lang_word": "whirl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22bf4185-5a99-3e76-bc03-66549d59573e",
                                        "entry_id": "4f18c644-a621-34c5-bb03-770fdf5bcfea",
                                        "glosses": [
                                            "To rotate, revolve, spin or turn rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f49914-1205-4a84-9bca-514f147ced06",
                                                "sense_id": "22bf4185-5a99-3e76-bc03-66549d59573e",
                                                "text": "The dancer whirled across the stage, stopped, and whirled around to face the audience."
                                            },
                                            {
                                                "example_id": "8c15f299-3130-46cd-a8c5-7fbc31f190a3",
                                                "sense_id": "22bf4185-5a99-3e76-bc03-66549d59573e",
                                                "text": "The house whirled around two or three times and rose slowly through the air. Dorothy felt as if she were going up in a balloon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf1fd33-b4a7-3b07-baac-6dfba348a5e7",
                                        "entry_id": "4f18c644-a621-34c5-bb03-770fdf5bcfea",
                                        "glosses": [
                                            "To have a sensation of spinning or reeling."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47daa28a-c510-4f3b-93a4-d8611e187aed",
                                                "sense_id": "9cf1fd33-b4a7-3b07-baac-6dfba348a5e7",
                                                "text": "My head is whirling after all that drink."
                                            },
                                            {
                                                "example_id": "cb5c0f41-aa3e-4725-bf46-a0987954c32f",
                                                "sense_id": "9cf1fd33-b4a7-3b07-baac-6dfba348a5e7",
                                                "text": "My brained ^([sic]) whirled as he went on, but yet there was a fearful impression that the worst was not told."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3696a01-6efb-35d6-8e56-de79b7ef7adc",
                                        "entry_id": "4f18c644-a621-34c5-bb03-770fdf5bcfea",
                                        "glosses": [
                                            "To make something or someone whirl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3529b213-1935-490f-8981-35a9a0cc1874",
                                                "sense_id": "a3696a01-6efb-35d6-8e56-de79b7ef7adc",
                                                "text": "The dancer whirled his partner round on her toes."
                                            },
                                            {
                                                "example_id": "5d067f4c-e0d5-4ba5-8bca-e6dff3c8aa06",
                                                "sense_id": "a3696a01-6efb-35d6-8e56-de79b7ef7adc",
                                                "text": "He whirls his sword around without delay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778389fd-5d00-3eef-ac42-b3e77148160d",
                                        "entry_id": "4f18c644-a621-34c5-bb03-770fdf5bcfea",
                                        "glosses": [
                                            "To remove or carry quickly with, or as with, a revolving motion; to snatch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51387049-09b2-4ad0-a504-6d9bc718cce3",
                                                "sense_id": "778389fd-5d00-3eef-ac42-b3e77148160d",
                                                "text": "See, see the chariot, and those rushing wheels, / That whirled the prophet up at Chebar flood."
                                            },
                                            {
                                                "example_id": "774f2eb2-2a22-4b9c-91b3-48aae7149f08",
                                                "sense_id": "778389fd-5d00-3eef-ac42-b3e77148160d",
                                                "text": "To-night the winds begin to rise\n⁠And roar from yonder dropping day:\n⁠The last red leaf is whirl’d away,\nThe rooks are blown about the skies; […]"
                                            },
                                            {
                                                "example_id": "d19137cd-24f1-41a2-8ab7-21bad8007378",
                                                "sense_id": "778389fd-5d00-3eef-ac42-b3e77148160d",
                                                "text": "The passionate heart of the poet is whirl’d into folly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9075aa66-40e8-3637-b528-cf5495e8ac2c",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "An act of whirling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d96f5e5-f1a3-42a4-95e3-887df270f39e",
                                                "sense_id": "9075aa66-40e8-3637-b528-cf5495e8ac2c",
                                                "text": "She gave the top a whirl and it spun across the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c504eb-51e2-384a-a4f2-accd3236d587",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "Something that whirls, such as a whirlwind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce088b3-e9e8-3514-b9e6-1a7a8cad5039",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "A confused tumult."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75f69fd0-0b93-3ef5-8729-2280c52c01cc",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "A rapid series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08aea44-32fa-4cf3-aa2b-6dce91ce95b7",
                                                "sense_id": "75f69fd0-0b93-3ef5-8729-2280c52c01cc",
                                                "text": "My life is one social whirl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea59eefd-68b9-3e0a-9d66-ae296e880a60",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "Dizziness or giddiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deeb2b33-9921-44af-8f5a-0fb0d6a3a3e3",
                                                "sense_id": "ea59eefd-68b9-3e0a-9d66-ae296e880a60",
                                                "text": "My mind was in a whirl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9fc6f7-494d-3458-9423-440dc83eb551",
                                        "entry_id": "5ed429fc-7589-3def-b13b-a8ef13f0f650",
                                        "glosses": [
                                            "(usually following “give”) A brief experiment or trial."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3653c76a-109a-4649-b225-53f28ef94229",
                                                "sense_id": "4a9fc6f7-494d-3458-9423-440dc83eb551",
                                                "text": "OK, let's give it a whirl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db545b46-7c0b-4106-a8f7-7456f3ef3d95",
