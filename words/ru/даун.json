                    "sense_definition": "человек с синдромом Дауна",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашем центре работают специалисты, которые помогают <w>даунам</w> адаптироваться в обществе.",
                            "target_lang_translations": {
                                "en": "Our center employs specialists who help <w>people with Down syndrome</w> adapt to society."
                            }
                        },
                        {
                            "text": "Каждый <w>даун</w> нуждается в особом внимании и поддержке со стороны близких людей.",
                            "target_lang_translations": {
                                "en": "Every <w>person with Down syndrome</w> needs special attention and support from loved ones."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person with Down syndrome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "person with Down syndrome",
                                "target_lang_sense_clarification": "The medically accurate and respectful term."
                            }
                        ]
