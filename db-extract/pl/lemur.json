                        "glosses": [
                            "Lemur Linnaeus, madagaskarska ogoniasta małpiatka o puszystym futrze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bde6de-6733-4fa0-860c-a58dc00a2821",
                                "sense_id": "31c214b4-5452-3da2-bc40-337620339cb0",
                                "text": "Ogon pomaga również lemurowi utrzymać równowagę w trakcie wykonywania iście akrobatycznych skoków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "38943989-8dbf-3a81-9f18-157891a421ea",
                        "entry_id": "5c6b18da-a4a4-37f4-8294-282627ead4a3",
