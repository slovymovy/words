                "senses": [
                    {
                        "sense_id": "dccd49de-1c47-3751-ba0b-23234120d1aa",
                        "entry_id": "bb4aa8c9-1254-39df-b86d-29a6010f6b01",
                        "glosses": [
                            "Gesamtheit der Prozesse, die zur Entstehung des Abflusses (im Flussbett) führen"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0aec4d1d-ac7c-4e81-89d3-d2013fc38136",
                                "sense_id": "dccd49de-1c47-3751-ba0b-23234120d1aa",
                                "text": "„Nach der Abflussbildung beschäftigt sich die Abflusskonzentration mit der Frage in welcher zeitlichen Verteilung der gebildete Direktabfluss am Auslass eines Einzugsgebietes erscheint.“"
                            },
                            {
                                "example_id": "6a41b4d6-681a-4359-881a-06c764499e05",
                                "sense_id": "dccd49de-1c47-3751-ba0b-23234120d1aa",
                                "text": "„Bei der Abflusskonzentration erfolgt eine Transformation der Effektivniederschlagsganglinie in die Durchflussganglinie bei der eine zeitliche Verschiebung erfolgt (Translation) als auch eine Dämpfung (Retention).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
