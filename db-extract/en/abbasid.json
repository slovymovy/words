            {
                "entry_id": "6a50382d-45ef-3560-a5da-007024cab868",
                "word": "Abbasid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8f8ec747-f7bb-4b12-a8d6-c6d16fb149e0",
                        "entry_id": "6a50382d-45ef-3560-a5da-007024cab868",
                        "tags": [
                            "plural"
                        ],
                        "form": "Abbasids"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb16b2e7-f4ff-313e-917f-ab71f7849270",
                        "entry_id": "6a50382d-45ef-3560-a5da-007024cab868",
                        "glosses": [
                            "A member of the dynasty of caliphs that ruled from Baghdad, from about 750 to 1250, claiming ancestry of Abbas."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b473072-1555-4112-9c0b-e4aeeabd60f3",
                        "source_entry_id": "6a50382d-45ef-3560-a5da-007024cab868",
                        "source_sense_id": "eb16b2e7-f4ff-313e-917f-ab71f7849270",
                        "source_sense_description": "member of the dynasty that ruled from Baghdad from about to 750 to 1250",
                        "target_lang_word": "Abbaside",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abbaside",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7c73392-bfdc-3a8f-8ae1-24f27a36a89d",
                                        "entry_id": "c8aea39e-1651-3aff-8b64-3fc97957c0d3",
                                        "glosses": [
                                            "Angehöriger eines zwischen den Jahren 750 und 1258 in der irakischen Stadt Bagdad ansässigen Kalifengeschlechts"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db7d013-ce33-4d06-b553-56a5300f3fac",
                                                "sense_id": "e7c73392-bfdc-3a8f-8ae1-24f27a36a89d",
                                                "text": "„Seine größte Ausdehnung erreichte das islamische Reich während der rund 500 Jahre dauernden Herrschaft der Abbasiden. […] Die Abbasiden verlagerten um die Mitte des 8. Jahrhunderts das Kalifat nach Bagdad. […] Letztlich scheiterten aber auch die Abbasiden an ihrem Anspruch, einen gerechten Gottesstaat auf Erden zu errichten.“"
                                            },
                                            {
                                                "example_id": "fe63352c-986e-405a-a730-65888434200b",
                                                "sense_id": "e7c73392-bfdc-3a8f-8ae1-24f27a36a89d",
                                                "text": "„Nach dem Sturz der Dynastie durch die Abbasiden (750) gründet der letzte überlebende Omaijaden-Prinz ein Emirat in Spanien (756, Emirat von Córdoba).“"
                                            },
                                            {
                                                "example_id": "50e81db5-39b0-4e4e-9d3d-19085d6e8e06",
                                                "sense_id": "e7c73392-bfdc-3a8f-8ae1-24f27a36a89d",
                                                "text": "„Die Abbasiden führen ihr Geschlecht auf Abbas, den Onkel des Propheten Mohammed, zurück und verleihen ihrer Dynastie dadurch und durch ihre stärker theokratisch ausgerichtete Herrschaft die gewünschte Legitimität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
