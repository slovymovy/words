                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6a7fc88-b33d-46a6-a8f9-d1b54823efa7",
                        "source_entry_id": "f3323b8c-dc52-3d30-9b85-ca9cd6c70d1c",
                        "source_sense_id": "d3fb61fd-7c8f-392f-a04d-87a29009b9bd",
                        "target_lang_word": "Lesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12ae43f4-70e3-333f-b1db-e1f4be90edf4",
                                        "entry_id": "135028a7-6bf8-3245-b2da-1d16f2ee12c0",
                                        "glosses": [
                                            "Handlung einer Person, einen schriftlich verfassten Text gedanklich aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b819724f-a7f2-4726-8b6e-f5e73b935933",
                                                "sense_id": "12ae43f4-70e3-333f-b1db-e1f4be90edf4",
                                                "text": "„Mich fasziniert zum Beispiel, dass wir lesen können, obwohl die Evolution unser Hirn nicht darauf hingetrimmt hat; das Lesen ist erst vor etwa 5000 Jahren erfunden worden.“"
                                            },
                                            {
                                                "example_id": "575a711f-b5de-4fb5-9ded-73f66513db22",
                                                "sense_id": "12ae43f4-70e3-333f-b1db-e1f4be90edf4",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            },
                                            {
                                                "example_id": "67aca95a-dc29-4535-869a-1d73e5048610",
                                                "sense_id": "12ae43f4-70e3-333f-b1db-e1f4be90edf4",
                                                "text": "Lesen verschafft nicht nur Zugang zu Inhalten, es verbessert auch die Wahrnehmung von Gesichtern, Gebäuden und anderen Objekten. Das zeigt eine neue Studie, die das Gehirn von Analphabeten, Leseanfängern und versierten Lesern verglichen hat."
                                            },
                                            {
                                                "example_id": "0ac43082-1ba5-4dd8-93bc-2d573ad20501",
                                                "sense_id": "12ae43f4-70e3-333f-b1db-e1f4be90edf4",
                                                "text": "„In Finnland etwa greift schon nach drei Monaten ein Krisenmanagement, wenn es mit Lesen und Schreiben nicht voran geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
