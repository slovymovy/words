                                        "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                        "entry_id": "6610d874-c926-3312-ad29-8036ccb0069f",
                                        "glosses": [
                                            "Oberhaupt eines deutschen Bundeslandes oder eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067fd56a-1ac2-4ef0-ac4a-1af0f3a13424",
                                                "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                                "text": "Christian Wulff war von 2003 bis 2010 der Ministerpräsident des Landes Niedersachsen."
                                            },
                                            {
                                                "example_id": "8fc607f4-ba26-4917-ab2a-f8040fb6e3f6",
                                                "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                                "text": "„Man sollte als Politiker auch die Fähigkeit besitzen, Fehler einzuräumen und sich zu entschuldigen. Diese Prinzipien habe ich als Umweltminister immer einzuhalten versucht, und dasselbe versuche ich auch heute noch als Ministerpräsident.“"
                                            },
                                            {
                                                "example_id": "a4d63d3e-d965-4032-9072-2bc9ced665b0",
                                                "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                                "text": "„Brandenburgs Ministerpräsident Dietmar Woidke (SPD) fordert eine finanzielle Beteiligung des Bundes an den Kosten für die Beseitigung von Weltkriegsmunition der Alliierten.“"
                                            },
                                            {
                                                "example_id": "0d2f6316-6497-49b5-bf48-4401fb9d015b",
                                                "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                                "text": "„Drei Ministerpräsidenten haben sich vor einer Tasse Kaffee niedergelassen.“"
                                            },
                                            {
                                                "example_id": "6bc4dc6c-dd14-432c-a04a-cad81b7b258d",
                                                "sense_id": "5ce0e468-6953-3c39-b0af-7f5116717c0a",
                                                "text": "„Diesen Brief schickte sie an das Büro des Ministerpräsidenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
