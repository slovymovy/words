                                "target_senses": [
                                    {
                                        "sense_id": "b9c3d41b-6b43-3efe-a707-3e9556dec229",
                                        "entry_id": "cf70b3db-2835-3d48-a49a-d041ad804033",
                                        "glosses": [
                                            "Assassin d’un roi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4696f82d-16a6-4d52-85f3-43a24dfb6126",
                                                "sense_id": "b9c3d41b-6b43-3efe-a707-3e9556dec229",
                                                "text": "Le « tsar libérateur » est mort en 1881, […], déchiqueté par les bombes […]. On a pendu les régicides et proclamé sous Alexandre III, l’autocratie « inébranlable »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79c6ad8-3684-3955-9e96-15e91d34cb4c",
                                        "entry_id": "cf70b3db-2835-3d48-a49a-d041ad804033",
                                        "glosses": [
                                            "Juge qui condamne un roi à mort."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238e9d63-9160-4864-aeb6-0e6a56ecdaf4",
                                                "sense_id": "c79c6ad8-3684-3955-9e96-15e91d34cb4c",
                                                "text": "Le bannissement des régicides sous Louis XVIII."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "régicide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44fa03b7-068b-333f-8119-d8496468f64c",
                                        "entry_id": "dd137cb8-cc47-3f38-a0c5-1541bfccb69b",
                                        "glosses": [
                                            "Relatif à l’assassinat de roi, à ceux qui le pratiquent, à leurs doctrines, à leurs actes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
