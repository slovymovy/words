        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb45d767-0e5e-3241-83f2-1ae72d3d9469",
                "word": "anticlimax",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1807992e-dc47-4c95-8837-bad991a21fe0",
                        "entry_id": "fb45d767-0e5e-3241-83f2-1ae72d3d9469",
