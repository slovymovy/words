                                        "examples": [
                                            {
                                                "example_id": "d4e2d802-ab07-42c5-ae3e-731796a95b24",
                                                "sense_id": "55baafcd-02fe-3895-8900-499e5100594d",
                                                "text": "fece più scherzi sapendo che prima o poi l'avrebbero smascherato"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cabfbf-5d4e-3ddf-ab6c-17676721fabb",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "giocare con parole o concetti rispetto a qualcuno e/o qualcosa, in modo veritiero o con falsità, spesso per giungere ad un apparente consenso ma anche per ferire e/o imbrogliare"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9cc99b8-7774-4fa4-a9cf-7458673d0eee",
                                                "sense_id": "d0cabfbf-5d4e-3ddf-ab6c-17676721fabb",
                                                "text": "quello scherzo permise di capire la natura della loro amicizia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83877937-f1a2-3ec8-a51c-e9d82dc41d14",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "ridere per un motivo e/o istintivamente, spontaneamente"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f720ff58-4cd1-42b9-a165-fa149dce95f6",
                                                "sense_id": "83877937-f1a2-3ec8-a51c-e9d82dc41d14",
                                                "text": "invero quello scherzo lo fece soffrire"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b7a22cd-da63-3982-be93-6cba4aa4dc57",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "beffa, burla che serve per prendersi gioco di qualcuno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffce43d2-6df3-4ce7-b4c5-fd0968fd8598",
                                                "sense_id": "5b7a22cd-da63-3982-be93-6cba4aa4dc57",
                                                "text": "iniziò con uno scherzo e finì in rissa"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e41ef0e-2d05-3017-a6ae-6e70a1e180d9",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "leggerezza nell'affrontare qualcosa invece grave"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2298fd-269e-4f45-a5e0-d1e44d64d1e7",
                                                "sense_id": "2e41ef0e-2d05-3017-a6ae-6e70a1e180d9",
                                                "text": "la guerra non è uno scherzo o un gioco..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d98dd5cb-63cc-3c57-b1d0-f39ef4836bc1",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "cogliere volutamente impreparato qualcuno attraverso un effetto falsato ma ironico"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec60314-d283-4ab0-a29a-3f3d316e26a2",
                                                "sense_id": "d98dd5cb-63cc-3c57-b1d0-f39ef4836bc1",
                                                "text": "lo scherzo non è riuscito"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f9b0f2-e9c3-3e2d-8c44-bbb1c4c94b79",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "affrontare un rapporto e/o un dialogo in modo derisorio e superficiale, talvolta denigratorio o sfacciato"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d70836-f5ca-42a6-a7a2-8e82ad9673bb",
                                                "sense_id": "60f9b0f2-e9c3-3e2d-8c44-bbb1c4c94b79",
                                                "text": "per lui è tutto uno scherzo"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9822833d-b748-329e-904a-6bfb39412944",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "tentativo, non sempre possibile, per creare un'amicizia, in modo ridicolo ma anche affettuoso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9318186d-f108-4cb4-9916-ce2b8f033986",
                                                "sense_id": "9822833d-b748-329e-904a-6bfb39412944",
                                                "text": "era uno scherzo... per ridere un po'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "551e342c-57f2-331c-b39d-6ec67fe2a562",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "vivere un paradosso, anche esistenziale, in modo conviviale ed allegro, talvolta in modo indulgente"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe23d781-123a-4c8a-a354-ba0e25515db2",
                                                "sense_id": "551e342c-57f2-331c-b39d-6ec67fe2a562",
                                                "text": "\"bello scherzo, eh...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d041d6e-3957-3564-a267-191916cda9b5",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "esaltazione gioiosa nel trasformare inaspettatamente un errore in un'opportunità, anche in modo esageratamente plateale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d1997c-fac4-4ba7-a9f3-fa3feb9082f4",
                                                "sense_id": "1d041d6e-3957-3564-a267-191916cda9b5",
                                                "text": "\"...che scherzo fenomenale!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef36e2f-6f6c-3ec9-ae05-f3fa2ed22b94",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
                                            "giocare in modo distaccato ma con senso di superiorità rispetto ad una o più mancanze altrui"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe56025c-fef5-426c-8135-cd5a68492b85",
                                                "sense_id": "3ef36e2f-6f6c-3ec9-ae05-f3fa2ed22b94",
                                                "text": "quello scherzo gli cambiò la vita..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a71d89-056d-3aaa-b775-327058116c04",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
