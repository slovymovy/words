                "senses": [
                    {
                        "sense_id": "6d3121c2-54f9-3b59-8278-8f4581f5e57e",
                        "entry_id": "dbe19c8c-6bca-33c6-ba38-d3927f715ece",
                        "glosses": [
                            "dotyczący życia i polityki Napoleona, charakterystyczny, typowy dla Napoleona, taki jak u Napoleona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522e72e7-86e9-490e-90e3-97f4a20583e4",
                                "sense_id": "6d3121c2-54f9-3b59-8278-8f4581f5e57e",
                                "text": "Na skrzyżowaniu ulic tkwili policjanci z założonemi po napoleońsku rękami i gwarzyli spokojnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62685aac-430b-4a0f-aeee-ce438116198c",
                        "source_entry_id": "dbe19c8c-6bca-33c6-ba38-d3927f715ece",
                        "source_sense_id": "6d3121c2-54f9-3b59-8278-8f4581f5e57e",
                        "target_lang_word": "Napoleonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Napoleonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c6ef969-eef0-36e0-8640-6807f9ece997",
                                        "entry_id": "7af0bd73-6113-3ed1-9573-d667c2dcb94b",
                                        "glosses": [
                                            "Of or pertaining to Napoleon Bonaparte."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c37c2579-1506-4e05-9ecc-a4737b70eb41",
                                                "sense_id": "8c6ef969-eef0-36e0-8640-6807f9ece997",
                                                "text": "Napoleonic Wars"
                                            },
                                            {
                                                "example_id": "fe4eac65-aa10-4447-ad38-44681ecaec7b",
                                                "sense_id": "8c6ef969-eef0-36e0-8640-6807f9ece997",
                                                "text": "A half-burned cigar rolled between his mobile lips, he sat on the back of his neck, and yet he had an air Napoleonic; Nietzschean, it might better be said—although it is safe to assert that these moulders of American institutions knew little about that terrible philosopher who had raised his voice against the “slave morals of Christianity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef3b501-5a52-3afa-a84d-7dd5c792f8a7",
                                        "entry_id": "7af0bd73-6113-3ed1-9573-d667c2dcb94b",
                                        "glosses": [
                                            "Suffering from Napoleon complex."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26722b87-fa85-3cc6-9f7f-ff271e520be2",
                                        "entry_id": "7af0bd73-6113-3ed1-9573-d667c2dcb94b",
                                        "glosses": [
                                            "Having to do with the Napoleonic Wars."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0182afc9-4860-46ba-8dae-6dfca3e55f20",
                        "source_entry_id": "dbe19c8c-6bca-33c6-ba38-d3927f715ece",
                        "source_sense_id": "6d3121c2-54f9-3b59-8278-8f4581f5e57e",
                        "target_lang_word": "napoléonien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "napoléonien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14cf521f-614c-3a58-b57b-e4c105977219",
                                        "entry_id": "ce96d3d1-bb68-37b8-a842-0cb68c0d984a",
                                        "glosses": [
                                            "Propre ou relatif à Napoléon Bonaparte, empereur français de 1804 à 1814 sous le nom de souverain de Napoléon 1ᵉʳ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c00fb7-3664-4936-82e2-b974bb19b046",
                                                "sense_id": "14cf521f-614c-3a58-b57b-e4c105977219",
                                                "text": "Le mécanicien redoute la machine que le voyageur admire, et les officiers étaient un peu les chauffeurs de la locomotive napoléonienne, s’ils n’en furent pas le charbon."
                                            },
                                            {
                                                "example_id": "c2130da3-0ee1-48d8-9416-c4550ce09cfe",
                                                "sense_id": "14cf521f-614c-3a58-b57b-e4c105977219",
                                                "text": "En 1830, il reparut dans l’administration comme quart de ministre, lors de cette espèce de conscription levée par Louis-Philippe dans les vieilles bandes napoléoniennes."
                                            },
                                            {
                                                "example_id": "92944e7f-83ec-4bb7-b8d4-2ac2202e0f7d",
                                                "sense_id": "14cf521f-614c-3a58-b57b-e4c105977219",
                                                "text": "A Nonancourt, le rempart urbain, bien visible sur le cadastre napoléonien, ne semble pas remonter au delà de la fin du Moyen-Age."
                                            },
                                            {
                                                "example_id": "1d80835d-2320-4a9c-8c3b-cb4bb7e5a037",
                                                "sense_id": "14cf521f-614c-3a58-b57b-e4c105977219",
                                                "text": "L'empire napoléonien n'en finissait plus de prendre de l'expansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ccd5290-b9fb-35f6-9d01-d823a2067e94",
                                        "entry_id": "ce96d3d1-bb68-37b8-a842-0cb68c0d984a",
                                        "glosses": [
                                            "Relatif à Napoléon III, à ses pompes ou à ses œuvres."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce86955f-c3ff-4027-a485-06318277d150",
                                                "sense_id": "8ccd5290-b9fb-35f6-9d01-d823a2067e94",
                                                "text": "Au contraire, la polyvalence de la notion de gloire pacifique motive des ralliements politiques de la part d'activistes qui voient dans l'œuvre napoléonienne la continuité de leurs efforts quarante-huitards. Leur ralliement réoriente le patriotisme pacifiste des années 1840, axé sur le peuple, sur le régime et sur l'État."
                                            },
                                            {
                                                "example_id": "a0e8dfcd-4f59-4494-86eb-f9d0cc2df0cc",
                                                "sense_id": "8ccd5290-b9fb-35f6-9d01-d823a2067e94",
                                                "text": "Ce frère en romantisme, ce napoléonien incomplet. … j'ai distingué son amour de la gloire, son orgueil cabré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
