                        "examples": [
                            {
                                "example_id": "3bc0f8d7-1f22-42c3-a43a-6807e41466d4",
                                "sense_id": "ba3381a8-b28e-38b2-a77e-ef5fea5327dd",
                                "text": "Mais j’entends le son du tambour, c’est le tocsin du camp qui appelle aux armes ; sans doute nous avons été aperçus, et comme il nous serait impossible de nous défendre contre ces enragés qui ne manqueraient pas de nous prendre et de nous défalaiser, nous n’avons qu’à nous sauver bien vite."
                            },
                            {
                                "example_id": "f226345c-d2e8-4f20-bd04-874f02173167",
                                "sense_id": "ba3381a8-b28e-38b2-a77e-ef5fea5327dd",
                                "text": "demain, à l’aube, tous les traîtres seront « défalaisés » (jetés du haut de la falaise) par moi, en personne […]"
                            }
                        ]
