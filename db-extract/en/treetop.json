                        ]
                    },
                    {
                        "translation_id": "ffb6f77c-9c3b-46a6-820b-6f0b0a285c05",
                        "source_entry_id": "b42c5b56-c8ef-3230-b19d-5e3f763e069f",
                        "source_sense_id": "899a9d16-d28e-33e4-bbcc-d0acb6a39ed4",
                        "source_sense_description": "crown or uppermost branches of a tree",
                        "target_lang_word": "Baumkrone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumkrone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                        "entry_id": "8ecd9fc0-fc85-3639-b92e-0f1d54be25ed",
                                        "glosses": [
                                            "benadelter bzw. belaubter Teil des Baumes, der sich zwischen dem Kronenansatz (erster grüner Ast, ohne Berücksichtigung der Klebäste) und dem Baumwipfel befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8902ac-33db-4618-876d-a06a124c60bf",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "Baumkronen sind überall wichtige Lebensräume, so dienen sie Vögeln als Nistplätze oder Eichhörnchen als Nahrungsquelle."
                                            },
                                            {
                                                "example_id": "3dd575e7-8872-460f-8990-78d163e65d16",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Die Granate schien in einer Baumkrone krepiert zu sein.“"
                                            },
                                            {
                                                "example_id": "24a562ee-a1ac-4c47-b53a-ac51f222aea2",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Er zeigte auf eine Hügelkette, die sich auf der anderen Seite des Tals über die Baumkronen erhob.“"
                                            },
                                            {
                                                "example_id": "b97a1d48-6d62-434c-8f0e-806c9b807436",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Anfangs hielten die Baumkronen das Wasser ab, dann fiel es umso heftiger auf die im Gras Schlafenden.“"
                                            },
                                            {
                                                "example_id": "ecd422f6-e2b6-4509-bd16-c6da72b7c5a7",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Sie hockten unter Brückenbögen, in Baumkronen, in den Dachböden alter Windmühlen und Bauernhäuser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a156f4c7-505f-4d83-8032-d33a34ed9aea",
                        "source_entry_id": "b42c5b56-c8ef-3230-b19d-5e3f763e069f",
                        "source_sense_id": "899a9d16-d28e-33e4-bbcc-d0acb6a39ed4",
                        "source_sense_description": "crown or uppermost branches of a tree",
                        "target_lang_word": "Baumwipfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumwipfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                        "entry_id": "cd1c38b4-dd6b-3e88-a7a7-0467d38e8764",
                                        "glosses": [
                                            "alleroberster Teil eines Baumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1774b1f-051b-4f7c-a6b2-6fc7eb8bd683",
                                                "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                                "text": "Die Baumwipfel wiegen im Wind."
                                            },
                                            {
                                                "example_id": "e96eb10f-abf9-45a4-bedb-9ea63de0b722",
                                                "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                                "text": "„Mifflin, der ruhig neben mir saß, hatte einen Fuß auf seine ausgebeulte Tasche gelegt und betrachtete drei Baumwipfel, die im kühlen Wind schaukelten.“"
                                            },
                                            {
                                                "example_id": "73824cfe-55a2-4d4d-b7f3-f146a8f85d58",
                                                "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                                "text": "„So sitzen wir dort eine Weile, während das Wasser weiter plätschert, der Wind durch die Baumwipfel streicht, ein Sperling tschilpt.“"
                                            },
                                            {
                                                "example_id": "75c8a385-5036-40fb-9bb9-1efcf566d206",
                                                "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                                "text": "„Endlich erhob er sich und sah auf die Baumwipfel hinüber, die jetzt in vollem Mondlichte lagen.“"
                                            },
                                            {
                                                "example_id": "ef00d838-92dd-4681-b908-537079173af1",
                                                "sense_id": "0cb58f3b-f467-3cb7-827e-6c31a0a18ded",
                                                "text": "„Der Leutnant hatte sich zurückgezogen, und die Nacht war hereingebrochen, der Halbmond schwand eben hinter den westlichen Baumwipfeln hinab, der alte Mann war aufgestanden und trat schweigend mit seinem Gaste vor die Türe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
