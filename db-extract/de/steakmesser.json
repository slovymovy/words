                "senses": [
                    {
                        "sense_id": "73eb2cca-5456-3e2f-95ff-3f928d3da31f",
                        "entry_id": "cee2fcc6-fc58-3646-9494-1bc0e9211d0c",
                        "glosses": [
                            "spezielles Tafelmesser/Besteckmesser zum Schneiden von Steaks oder anderen kompakten Fleischstücken"
                        ],
                        "tags": [
                            "Haushalt"
                        ],
                        "examples": [
                            {
                                "example_id": "8ad38c6a-ee1c-44ad-90e7-a805f6466894",
                                "sense_id": "73eb2cca-5456-3e2f-95ff-3f928d3da31f",
                                "text": "“Ich hab doch zuhause Besteck genug – wozu brauche ich ein Steakmesser?” Wer sich das fragt, sollte einmal die Schärfe seiner Tafelmesser an einem ordentlichen Steak testen."
                            },
                            {
                                "example_id": "dc968f57-372f-4850-b6e8-1cc06ff4e0ed",
                                "sense_id": "73eb2cca-5456-3e2f-95ff-3f928d3da31f",
                                "text": "Diese Steakmesser bestehen aus hochwertigem Edelstahl und sind absolut spülmaschinenfest."
                            },
                            {
                                "example_id": "309255b3-7ab6-4ad1-887c-6cbbb675107e",
                                "sense_id": "73eb2cca-5456-3e2f-95ff-3f928d3da31f",
                                "text": "„Sommer, das ist die Zeit der Morde ohne Motiv, der Steakmesser mit abgebrochener Klinge und der verbogenen Eisenstangen; es ist die Zeit der echten Gefahr, der massiven und sofortigen Vergeltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
