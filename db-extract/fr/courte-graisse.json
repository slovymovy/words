                        "glosses": [
                            "Nom donné en Flandre à l’engrais provenant des fosses d’aisance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f189d2-d3c7-4f70-a26d-8dcfd59b4604",
                                "sense_id": "372271e8-3877-31d5-b188-5596e5ee1f26",
                                "text": "La courte-graisse est destinée principalement à la culture des plantes oléagineuses et du tabac. Les fabricants de sucre ne se soucient point de la voir employer sur les betteraves."
                            },
                            {
                                "example_id": "f40b2cd3-d510-4be8-a29f-881262a11e85",
                                "sense_id": "372271e8-3877-31d5-b188-5596e5ee1f26",
                                "text": "Dans certaines régions, notamment dans le nord de la France, les matières de vidange sont fréquemment employées pour la fertilisation du sol; on leur donne le nom d'engrais flamand, courte-graisse ou gadoue."
                            }
                        ]
                    }
