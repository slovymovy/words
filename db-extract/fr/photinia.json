                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd95b3f-280d-469a-8cc5-c60e7fcb0ce3",
                                "sense_id": "8a5e1429-1636-3a74-9dcb-8bce1a84ac6d",
                                "text": "Le buisson en question était un photinia profondément écarlate, au feuillage dense et aux feuilles ovales très allongées."
                            },
                            {
                                "example_id": "373762ca-3168-4e29-8815-62f6d29f444d",
                                "sense_id": "8a5e1429-1636-3a74-9dcb-8bce1a84ac6d",
                                "text": "Il demeurait dans une petite maison en plein cœur de ce Montmartre où il était né, qu'un jardinet séparait de la rue par une haie de photinias surmontée d'une glycine centenaire qui gagnait la façade et serpentait entre les fenêtres des chambres."
                            }
                        ]
