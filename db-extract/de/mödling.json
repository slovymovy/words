                ],
                "senses": [
                    {
                        "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                        "entry_id": "a15bb8eb-5cc0-3c1c-8331-0fcd28fdeec8",
                        "glosses": [
                            "österreichische Stadt in Niederösterreich südlich von Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c98d0b-c53b-427d-9292-52ff03bf494d",
                                "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                                "text": "Am 1. bzw. 15. Oktober 1938 wurde Mödling nach Wien eingemeindet (Groß-Wien) und namengebender Hauptort des damals geschaffenen 24. Bezirks, seit 1. September 1954 ist es wieder niederösterreichische Bezirkshauptstadt, deren Sprengel allerdings kleiner ist als vor 1938; …"
                            },
                            {
                                "example_id": "73cd9f57-5bc7-4226-95da-0032e8d5aaea",
                                "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                                "text": "Die Freiwillige Feuerwehr der Stadt Mödling ist rund um die Uhr für Sie da!"
                            },
                            {
                                "example_id": "bf8566dd-5ce6-4683-a7bb-3b799aa929dc",
                                "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                                "text": "In der Stadt Mödling gibt es seit dem Jahre 1896, also seit 110 Jahren, das Rote Kreuz."
                            },
                            {
                                "example_id": "4364faf9-599d-4a43-8971-b906f1da602d",
                                "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                                "text": "Zweimal wurde Mödling durch die Osmanen zerstört und auch zwei Pestepidemien verschonten die Mödlinger Bevölkerung nicht."
                            },
                            {
                                "example_id": "53e52fc2-b166-42ac-8484-133d74024d09",
                                "sense_id": "4c72a8b9-cb52-393c-bdea-e048dbdbfcbd",
                                "text": "Kaiser Friedrich III. verlieh dem Markt Mödling am 24. Jänner 1458 ein Wappen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                        "entry_id": "a15bb8eb-5cc0-3c1c-8331-0fcd28fdeec8",
                        "glosses": [
                            "österreichischer Verwaltungsbezirk in Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fffc2c0c-3c68-4bb0-8dbd-dce1528ff270",
                                "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                                "text": "Die Gesamtstrategie, der Regionale Leitplan, wurde von 19 der 20 Gemeinden des politischen Bezirks Mödling beschlossen."
                            },
                            {
                                "example_id": "69078b72-cf6f-410f-a826-01ff56c76c3d",
                                "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                                "text": "Als sie von einem Kaufhausdetektiv auf frischer Tat erwischt wurde, ist eine Ladendiebin am Montag im Bezirk Mödling rabiat geworden."
                            },
                            {
                                "example_id": "f21ef076-3891-4d1b-94e9-c7c029873e90",
                                "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                                "text": "„… Wir sind sehr gerne eine Marktgemeinde und haben kein Problem damit, dass wir zum Bezirk Mödling gehören“, sagt Martin Schuster, Bürgermeister von Perchtoldsdorf, wo die Autos das Kennzeichen „MD“ haben."
                            },
                            {
                                "example_id": "0d02655d-5925-42a9-8029-9b6a4e8c66ae",
                                "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                                "text": "… Hannes Weninger: „Der Bezirk Mödling ist einer der größten Steuerlieferanten in Österreich, und es muss Geld in diese Region zurückfließen, um die Lebensqualität zu erhalten.“"
                            },
                            {
                                "example_id": "d91231d1-98dc-4e36-8819-ca150e2c6763",
                                "sense_id": "7e7505b9-21b6-3276-bba1-638773bcde27",
                                "text": "In der Wienerwaldgemeinde Breitenfurt im Bezirk Mödling leben derzeit neun Flüchtlinge in privaten Quartieren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
