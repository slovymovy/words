                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f86a7a6d-d040-3dff-9a71-8fd42e1e9aca",
                                        "entry_id": "8f9a57b1-8f00-3be2-9996-eab95c96c146",
                                        "glosses": [
                                            "The murdering of one's own wife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8af254a4-6a22-4b0f-9377-49c4f4530b2d",
                                                "sense_id": "f86a7a6d-d040-3dff-9a71-8fd42e1e9aca",
                                                "text": "Terms related to familicide include filicide (the killing of one's child or children), uxoricide (the killing of one's wife), fratricide or sororicide (the killing of one's brother or sister), avunculicide (the killing of one's uncle), and nepoticide (the killing of one's nephew)."
                                            },
                                            {
                                                "example_id": "38f18976-328f-4b1d-b5a1-b3a9e76e979e",
                                                "sense_id": "f86a7a6d-d040-3dff-9a71-8fd42e1e9aca",
                                                "text": "In order for someone to green-light a movie of this story, they’d need to have at least background knowledge of the sexual shenanigans of Sartre and Beauvoir, and of Althusser’s uxoricide – though not necessarily a close acquaintance with their published work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
