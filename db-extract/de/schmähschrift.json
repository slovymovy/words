                ],
                "senses": [
                    {
                        "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                        "entry_id": "497b6827-3580-3d15-ab04-39619329e8c9",
                        "glosses": [
                            "leidenschaftlich, verächtlich machend gegen eine Sache oder Person verfasstes Schriftstück, bei dem Sachlichkeit in den Hintergrund tritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b99bb1-43bd-470b-bfcf-cf206acd5724",
                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                "text": "„Seine Schmähschrift gegen die Menschenrechtlerin Beck macht jedoch eine wichtige Gemeinsamkeit zwischen der alten revolutionären Linken und dem neulinken Milieu deutlich.“"
                            },
                            {
                                "example_id": "c006023f-f78a-474d-8dde-d5045a9957fe",
                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                "text": "„Im lateinischen Schrifttum fragt man, wer wohl die Schmähschrift »Invectiva in Ciceronem« geschrieben haben mag.“"
                            },
                            {
                                "example_id": "65acd78d-2b8c-4c37-9b8c-252ea8c6eb59",
                                "sense_id": "0647b9a1-5b1b-32f6-9b7b-40bdb776aa22",
                                "text": "„Der Abate Pizzi, Hüter des heiligen Lorbeers der ›Arcadia‹ und Hauptanstifter zur Apotheose der Dichterin, wurde von allen Seiten mit Schmähschriften und bissigen Artikeln überschwemmt und wagte einige Monate nicht auszugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
