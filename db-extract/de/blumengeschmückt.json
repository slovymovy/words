                ],
                "senses": [
                    {
                        "sense_id": "e8285622-1bfb-35bf-a1cb-bb564f3c26a7",
                        "entry_id": "a99f27c8-e5a0-3b9f-9716-9f37827cb6cc",
                        "glosses": [
                            "mit Blumen geschmückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d9f472-2f0c-4ae6-a13b-942b02878077",
                                "sense_id": "e8285622-1bfb-35bf-a1cb-bb564f3c26a7",
                                "text": "„Atal, der auf einer Elfenbeinempore in einem blumengeschmückten Schrein in der höchsten Kammer des Tempels saß, war ganze drei Jahrhunderte alt, verfügte aber noch immer über einen scharfen Verstand und ein gutes Gedächtnis.“"
                            },
                            {
                                "example_id": "11e4b5cd-e7f7-476a-88b3-d55cee863b93",
                                "sense_id": "e8285622-1bfb-35bf-a1cb-bb564f3c26a7",
                                "text": "„Das Grab war offen: Die Erde lag auf einer Seite aufgehäuft, auf der anderen ruhte der blumengeschmückte Sarg auf der Grasnarbe.“"
                            }
