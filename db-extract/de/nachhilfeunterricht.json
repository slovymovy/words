                "senses": [
                    {
                        "sense_id": "ec6c95a6-b54b-34b8-8a30-80a52ffc6fed",
                        "entry_id": "d5ba3d63-b9ab-3ae8-9387-366e6ac3e07d",
                        "glosses": [
                            "Unterricht, der Nachhilfe leisten soll, also helfen soll, Lerndefizite auszugleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c7fb16-142a-465c-943f-b56e56f13370",
                                "sense_id": "ec6c95a6-b54b-34b8-8a30-80a52ffc6fed",
                                "text": "„Er durfte seit einiger Zeit jüngeren Schülern Nachhilfeunterricht in Latein geben.“"
                            },
                            {
                                "example_id": "ee0b71eb-ba4f-47d4-b8be-96c723bdb1b7",
                                "sense_id": "ec6c95a6-b54b-34b8-8a30-80a52ffc6fed",
                                "text": "„In Finnland gibt es praktisch keinen Nachhilfeunterricht, der von Eltern finanziert werden muss.“"
                            },
                            {
                                "example_id": "ec139a69-2d22-4205-98ba-fe57edfb0d19",
                                "sense_id": "ec6c95a6-b54b-34b8-8a30-80a52ffc6fed",
                                "text": "„Dean gibt jetzt dreimal in der Woche Nachhilfeunterricht.“"
                            },
                            {
                                "example_id": "a2f9395f-f8ff-4ae5-816c-8a8f654168dc",
                                "sense_id": "ec6c95a6-b54b-34b8-8a30-80a52ffc6fed",
                                "text": "„Von Zeit zu Zeit luden sie Edelduft zwecks Erteilung teuren häuslichen Nachhilfeunterrichts in ihre Wohnung und ließen sich gemeinsam von ihr in dem Wissenszweig höherer Liebestechnik unterrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
