                "senses": [
                    {
                        "sense_id": "85a2f7b0-ac96-3e60-aefd-9a4bcd18a111",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "umożliwienie pasażerowi opuszczenia pojazdu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c5b1e5-0255-4579-805e-b1fe6238e20f",
                                "sense_id": "85a2f7b0-ac96-3e60-aefd-9a4bcd18a111",
                                "text": "Starszy pan poprosił kierowcę o wysadzenie go na światłach obok przychodni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "19f506b8-cc80-30a7-8dc8-3692dc3c4d5e",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "umożliwienie pasażerowi opuszczenia statku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83396f4e-e057-40a2-9408-50fc3e104059",
                                "sense_id": "19f506b8-cc80-30a7-8dc8-3692dc3c4d5e",
                                "text": "Kapitan pozwolił na wysadzenie emigrantów na wyspie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "daaa1d75-6554-394b-9544-51d3d3bbc7a5",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "zniszczenie czegoś przy użyciu materiałów wybuchowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0279050d-d03c-425a-8b54-57c7c76a4b56",
                                "sense_id": "daaa1d75-6554-394b-9544-51d3d3bbc7a5",
                                "text": "Po wysadzeniu lodu na rzece saperzy spotkali się z uczniami miejscowej szkoły."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "7060b648-85b2-3c56-9034-938f94a1b2ee",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "ozdobienie czegoś poprzez osadzenie kamieni szlachetnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2a4777-5c34-4180-aa4a-0c51c9d4f1ba",
                                "sense_id": "7060b648-85b2-3c56-9034-938f94a1b2ee",
                                "text": "Dziadek zaplanował wysadzenie ryngrafu pięcioma czerwonymi kamieniami."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "aaf48284-9c3b-346f-a95e-df2853ea74e4",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "przeniesienie sadzonek ze szklarni do gruntu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b51abc-5b88-4405-82fc-9e8bafe5f57e",
                                "sense_id": "aaf48284-9c3b-346f-a95e-df2853ea74e4",
                                "text": "Kierownik prosił, byś zajrzała do niego przed wysadzeniem nowych rozsad."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "88bbdf24-ebc1-326e-99e8-45efee7fa7d8",
                        "entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "glosses": [
                            "obsadzenie roślinami czegoś dookoła lub wzdłuż"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c61b71a-2050-4e35-9fea-5aa2e29eef5a",
                                "sense_id": "88bbdf24-ebc1-326e-99e8-45efee7fa7d8",
                                "text": "Już jesienią rozmawiali o wysadzeniu kilku rabat trawą pampasową."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc8eb2f-b93a-4c28-869a-7a7934d0ecf1",
                        "source_entry_id": "56c81b58-e79a-3b55-aace-e7b0b8045df8",
                        "source_sense_id": "daaa1d75-6554-394b-9544-51d3d3bbc7a5",
                        "target_lang_word": "Sprengung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprengung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3219e34c-0026-30a2-aee7-0118be25cf54",
                                        "entry_id": "dd9b557b-619d-3147-8087-d6019745ffd1",
                                        "glosses": [
                                            "Zerstörung mit Hilfe eines explodierenden Materials"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9244d7-f01e-4a59-8048-2a5633a45faf",
                                                "sense_id": "3219e34c-0026-30a2-aee7-0118be25cf54",
                                                "text": "„Loest beschreibt dagegen die wirkliche Sprengung der völlig intakten Universitätskirche St. Paul am 30. Mai 1968.“"
                                            },
                                            {
                                                "example_id": "81b607f4-32a8-411a-95ae-93808008dcf6",
                                                "sense_id": "3219e34c-0026-30a2-aee7-0118be25cf54",
                                                "text": "„Die Gebirgspioniere bereiteten die großen Straßen hinter der Front zur Sprengung vor.“"
                                            },
                                            {
                                                "example_id": "16c5dbf3-6767-4c2d-9c2d-9f4e900d843f",
                                                "sense_id": "3219e34c-0026-30a2-aee7-0118be25cf54",
                                                "text": "Der offene Tagebau in Nord Mara erinnert an eine gigantische Baugrube. Per Sprengung wird das Edelmetall [Gold] aus dem Boden geholt, 2011 waren es 170.000 Unzen (4,8 Tonnen)."
                                            },
                                            {
                                                "example_id": "decb4216-8c34-4e14-94d8-db302ac0b983",
                                                "sense_id": "3219e34c-0026-30a2-aee7-0118be25cf54",
                                                "text": "„In Lützel an der Trierer Straße gab es beispielsweise Häuser, deren Fenster durch die Sprengungen der Feste Franz zu Bruch gingen und deren Mauerwerk rissig wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "241ac764-dc22-383e-be6f-a115f634f95f",
                                        "entry_id": "dd9b557b-619d-3147-8087-d6019745ffd1",
                                        "glosses": [
                                            "Besprühung mit einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
