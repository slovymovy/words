                                "target_senses": [
                                    {
                                        "sense_id": "18ffb28d-e9b6-38af-bfd9-30bd5fa9f96b",
                                        "entry_id": "fdad951f-2b16-39e3-9f70-0eed1f640075",
                                        "glosses": [
                                            "slavnostní církevní průvod"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72ec732-be3f-48fc-a2df-c9cd94be5059",
                                                "sense_id": "18ffb28d-e9b6-38af-bfd9-30bd5fa9f96b",
                                                "text": "Bylo před svatým Janem r. 1807. Ze všech krajin české vlasti chystaly se k matičce Praze průvody a procesí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9249668-752d-3c23-9a7f-b6943e660149",
                                        "entry_id": "fdad951f-2b16-39e3-9f70-0eed1f640075",
                                        "glosses": [
                                            "zástup lidí nebo jiných účastníků"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ecd84f9-27b5-42b8-bef7-65849becd583",
                                                "sense_id": "e9249668-752d-3c23-9a7f-b6943e660149",
                                                "text": "Jediná nehoda změnila nudné procesí v dramatický závod plný předjíždění."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "procesí",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea0deae-fb6a-3cd6-a3b3-a06d9da40e54",
                                        "entry_id": "002b98d9-ee47-33b4-b1d4-98a308486462",
                                        "glosses": [
                                            "slavnostní církevní průvod"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39360159-b57b-466a-806c-eacb8e41dc59",
                                                "sense_id": "4ea0deae-fb6a-3cd6-a3b3-a06d9da40e54",
                                                "text": "I veselá jest zajisté taková procesí, poněvadž hudba vejskavé všeliké tance a samé kusy pro obveselení mysli hrá. (…) Osmého října bratrstvo svatého Šebestiána procesí slavnou drží. (…) Když se nemocný zaopatřiti dává, svátost se s procesí a s pompou do domu jeho nese."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
