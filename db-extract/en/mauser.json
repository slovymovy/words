                        "entry_id": "abbe0067-f165-31d6-b6be-30b7ff52b1b1",
                        "glosses": [
                            "Any of the firearms made or designed by the German company Mauser, notably automatic pistols and bolt action rifles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860fe359-9249-40a4-b703-4672abe2f59d",
                                "sense_id": "05730e63-f58f-3e71-ad17-eec13089e4b2",
                                "text": "The war has begun, confrontations are escalating across the region, and all his men own are old Mausers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cf39d38-c0f3-40fa-ac05-e39031d71ab1",
