                "senses": [
                    {
                        "sense_id": "e4562f5a-96e0-3da3-8af7-d86ec3bc02cc",
                        "entry_id": "bbe98166-9954-3228-afa0-91b19c8851ec",
                        "glosses": [
                            "Faire perdre son caractère flétri à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a19904-92ae-4ad2-a75d-ece2d9c6a72b",
                                "sense_id": "e4562f5a-96e0-3da3-8af7-d86ec3bc02cc",
                                "text": "Ah ! Les dernières médecines à la mode… Y en avait-il une seule capable de nous garder en santé et en jeunesse ? Une seule capable de chasser la ride et déflétrir l’âme ?"
                            },
                            {
                                "example_id": "b4939c41-685a-4cf8-a1dd-522789b52374",
                                "sense_id": "e4562f5a-96e0-3da3-8af7-d86ec3bc02cc",
                                "text": "Si l’idée de déflétrir notre nature équivaut à transformer nos besoins, à ne pas les satisfaire en l’état, il peut sembler que le danger moral que l’on encourt est celui d’un moralisme idéaliste, d’oublier les besoins de l’autre en l’état."
                            },
                            {
                                "example_id": "ae118364-e0eb-441a-ad83-88ee9be88469",
                                "sense_id": "e4562f5a-96e0-3da3-8af7-d86ec3bc02cc",
                                "text": "La technique de Sioux pour déflétrir la salade : laisser tremper la salade dans de l’eau avec un demi citron."
                            }
                        ]
                    }
                ],
