                                        "entry_id": "c4a40bca-3577-3b0d-bbc9-d4fdbf5e6ad5",
                                        "glosses": [
                                            "Getränk aus Vorderasien, das üblicherweise auf Basis von Joghurt, Wasser und Salz zubereitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c6cd57-5224-4a86-a232-4fcb7bd2065f",
                                                "sense_id": "c74f6157-c7f7-3a41-abbd-df3f547a7108",
                                                "text": "„Während Mango-Lassi durch fruchtige Süße betört, ist Ayran ein salzig gewürztes Getränk.“"
                                            },
                                            {
                                                "example_id": "2ac989aa-7de4-4c69-a845-f3f673cf9437",
                                                "sense_id": "c74f6157-c7f7-3a41-abbd-df3f547a7108",
                                                "text": "„Weitere populäre Produkte der Milchsäuregärung sind Käse, Buttermilch, Lassi, Ayran, Kefir und Kumyss (vergorene Eselsmilch).“"
                                            }
                                        ],
