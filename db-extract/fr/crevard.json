                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60494ad6-04e2-34f7-84ad-daea7d85bd80",
                        "entry_id": "5d4852c7-a87b-3ebb-9e04-e9d344b6034b",
                        "glosses": [
                            "sukkelaar, loser"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "13528648-d318-42bf-931a-da469cb7807b",
                                "sense_id": "60494ad6-04e2-34f7-84ad-daea7d85bd80",
                                "text": "Ah! C’est toujours la même chose avec toi, t’es un vrai crevard!",
                                "translation": "Het is altijd hetzelfde met jou, je bent een echte loser!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f4b3011-5329-3348-a00d-fb48b755ce24",
                        "entry_id": "5d4852c7-a87b-3ebb-9e04-e9d344b6034b",
                        "glosses": [
                            "veelvraat, slokop"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "265fac97-1146-4344-a49a-6cb8e35cf2d0",
                                "sense_id": "5f4b3011-5329-3348-a00d-fb48b755ce24",
                                "text": "A l’anniversaire de Béatrice, tous ces crevards se sont précipités sur le buffet.",
                                "translation": "Op de verjaardag van Béatrice stortten al die vreetzakken zich op het buffet."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8eacbf-c4bb-3047-aaef-0547d422cc44",
                        "entry_id": "5d4852c7-a87b-3ebb-9e04-e9d344b6034b",
                        "glosses": [
                            "gierig, krenterig"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "1a268b60-cb31-4821-a618-dd237aa62a39",
                                "sense_id": "8b8eacbf-c4bb-3047-aaef-0547d422cc44",
                                "text": "C’est trop un crevard c’gars-là, il veut même pas me donner un bout de son kit-kat.",
                                "translation": "Die kerel is een echte krent, hij wil me zelfs geen stukje van zijn KitKat geven."
                            }
                        ]
                    }
                ],
