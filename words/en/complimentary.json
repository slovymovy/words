{
    "word_family": [
        "compliment",
        "complimenter",
        "complimentary-wise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "db4d22a7-fcf2-37f0-be04-c2e98f7ea78e",
                    "sense_definition": "Provided for free, usually as a courtesy or for promotional purposes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "free of charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers <w>complimentary</w> breakfast to all guests staying in the executive suites.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает <w>бесплатный</w> завтрак всем гостям, проживающим в люксах."
                            }
                        },
                        {
                            "text": "We enjoyed <w>complimentary</w> drinks while waiting for our table to be ready at the restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались <w>бесплатными</w> напитками, пока ждали, когда освободится наш столик в ресторане."
                            }
                        }
                    ],
                    "synonyms": [
                        "free of charge",
                        "gratis",
                        "free",
                        "gratuitous"
                    ],
                    "common_phrases": [
                        "complimentary drinks",
                        "complimentary breakfast",
                        "complimentary tickets",
                        "complimentary toiletries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый бесплатно, обычно в качестве любезности или в рекламных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесплатный",
                                "target_lang_sense_clarification": "предоставляемый без оплаты"
                            },
                            {
                                "target_lang_word": "комплиментарный",
                                "target_lang_sense_clarification": "в качестве подарка от заведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74c16588-e5ea-3725-b234-41fe431592af",
                    "sense_definition": "Expressing a compliment; praising or approving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic wrote a very <w>complimentary</w> remark about the lead actor's performance in the new play.",
                            "target_lang_translations": {
                                "ru": "Критик написал очень <w>лестный</w> отзыв об игре главного актера в новой пьесе."
                            }
                        },
                        {
                            "text": "She was quite <w>complimentary</w> about my work during the annual performance review.",
                            "target_lang_translations": {
                                "ru": "Она весьма <w>лестно</w> отозвалась о моей работе во время ежегодной аттестации."
                            }
                        }
                    ],
                    "antonyms": [
                        "uncomplimentary"
                    ],
                    "common_phrases": [
                        "complimentary remark",
                        "complimentary review",
                        "highly complimentary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий похвалу или одобрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лестный",
                                "target_lang_sense_clarification": "содержащий похвалу"
                            },
                            {
                                "target_lang_word": "похвальный",
                                "target_lang_sense_clarification": "выражающий одобрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30dd974b-f485-338e-a41b-8595f0f8f00b",
                    "sense_definition": "Relating to the formal and professional closing of a letter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>complimentary</w> close like Sincerely yours is standard for most professional business letters.",
                            "target_lang_translations": {
                                "ru": "<w>Заключительная</w> вежливая фраза, такая как «Искренне ваш», является стандартной для большинства деловых писем."
                            }
                        },
                        {
                            "text": "The teacher explained that the <w>complimentary</w> closing should match the tone of the salutation.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, что <w>заключительная</w> формула вежливости должна соответствовать тону приветствия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "complimentary close",
                        "complimentary closing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in formal correspondence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к официальному и профессиональному завершению письма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключительный",
                                "target_lang_sense_clarification": "о вежливой формуле в конце письма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}