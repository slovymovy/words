                "senses": [
                    {
                        "sense_id": "52257d90-424d-38a5-bdb6-92260431f0fe",
                        "entry_id": "e31a533a-b17d-317a-be69-11809d3339c7",
                        "glosses": [
                            "ter zake nieuw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f800ec4-ca1a-40ce-80e1-b0cfb9e49889",
                                "sense_id": "52257d90-424d-38a5-bdb6-92260431f0fe",
                                "text": "De onervaren leraar kreeg te maken met een onwillige klas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "043905d3-69d5-47c1-9a29-7824bd68ab53",
                        "source_entry_id": "e31a533a-b17d-317a-be69-11809d3339c7",
                        "source_sense_id": "52257d90-424d-38a5-bdb6-92260431f0fe",
                        "source_sense_description": "ter zake nieuw",
                        "target_lang_word": "unerfahren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerfahren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97ec4df8-fbbe-3329-b8e4-00e7ca5ecc77",
                                        "entry_id": "0d5e7971-c44d-35fb-bd83-5d8ab8f13a6e",
                                        "glosses": [
                                            "keine oder sehr wenig Erfahrung in etwas haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48068579-ca12-431a-9cb3-8990036e1578",
                                                "sense_id": "97ec4df8-fbbe-3329-b8e4-00e7ca5ecc77",
                                                "text": "Unerfahrene Benutzer eines Internetprojekts sind gut beraten, aus den Hinweisen und Änderungen anderer Benutzer zu lernen."
                                            },
                                            {
                                                "example_id": "8f049f28-eeab-4f38-b145-045e4aa1d674",
                                                "sense_id": "97ec4df8-fbbe-3329-b8e4-00e7ca5ecc77",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            },
                                            {
                                                "example_id": "30018e90-5bde-472a-8138-ae4f8e6ff697",
                                                "sense_id": "97ec4df8-fbbe-3329-b8e4-00e7ca5ecc77",
                                                "text": "„Gerade in der Kapitalanlage noch unerfahrene Privatkunden sollten eher nach Immobilien Ausschau halten, die vom eigenen Wohnort höchstens 100 km entfernt sind.“"
                                            },
                                            {
                                                "example_id": "d3282292-487e-4906-b915-c49849fd643c",
                                                "sense_id": "97ec4df8-fbbe-3329-b8e4-00e7ca5ecc77",
                                                "text": "„Es war eines jener schwankartigen Lustspiele, bei denen auch der unerfahrenste Theaterbesucher von der ersten Minute an weiß, daß das Liebespaar sich kriegen wird, so finster manchmal auch der Himmel dräuen mag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2147b12-7d4a-33ff-8864-c5f77fba4948",
                                        "entry_id": "0d5e7971-c44d-35fb-bd83-5d8ab8f13a6e",
                                        "glosses": [
                                            "wenig Lebenserfahrung haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea7fd23-06cf-4b06-8e2a-7860d4f51ea5",
                                                "sense_id": "c2147b12-7d4a-33ff-8864-c5f77fba4948",
                                                "text": "Du kannst Stefan doch nicht alleine eine Weltreise machen lassen; er ist noch so unerfahren."
                                            },
                                            {
                                                "example_id": "f54ff8ec-7c50-4432-978f-95f4e862f976",
                                                "sense_id": "c2147b12-7d4a-33ff-8864-c5f77fba4948",
                                                "text": "„Der Hund — jung und unerfahren, nehme ich an — kam der Wolke zu nah und im nächsten Moment war er mittendrin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
