                        "dessécher"
                    ]
                },
                {
                    "sense_id": "e67524af-fcf0-38d3-9102-33517c1c8b67",
                    "sense_definition": "Démasquer ou surprendre quelqu'un en train d'accomplir une action secrète ou répréhensible.",
