                    }
                ],
                "senses": [
                    {
                        "sense_id": "3026a816-f7f2-3f5f-bd3b-7a6badb57d8a",
                        "entry_id": "0f17bd50-18f0-3fdc-b4e9-9ad1f05a5bcb",
                        "glosses": [
                            "Relatif à l'hydroponie, qui se pratique hors-sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd06c5b-d6bd-49e9-80dd-26efdfc6a5aa",
                                "sense_id": "3026a816-f7f2-3f5f-bd3b-7a6badb57d8a",
                                "text": "Je tenterais bien une conversion vers la culture hydroponique, ou semi-hydroponique, mais j’aime trop le parfum de la tourbe."
                            },
                            {
                                "example_id": "59761dbf-79db-4660-89ec-43ef7797e8f3",
                                "sense_id": "3026a816-f7f2-3f5f-bd3b-7a6badb57d8a",
                                "text": "Ils préfèrent maintenant, à trois semaines de plage, investir le budget de leurs vacances dans huit jours de balnéarité hydroponique, à l'abri des tempêtes."
                            },
                            {
                                "example_id": "f204d95d-30f1-402e-ac5b-e84e9dbec98e",
                                "sense_id": "3026a816-f7f2-3f5f-bd3b-7a6badb57d8a",
                                "text": "Si donc nous voulons examiner la nutrition végétale, il nous faut travailler sans sols (hydroponiques) ou en sols biologiquement neutres (semi-hydroponiques) en fournissant à la plante des liquides nutritifs de composition connue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcf630f3-08e2-4008-bbac-254bf1f299db",
                        "source_entry_id": "0f17bd50-18f0-3fdc-b4e9-9ad1f05a5bcb",
                        "source_sense_id": "3026a816-f7f2-3f5f-bd3b-7a6badb57d8a",
                        "target_lang_word": "hydroponic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydroponic",
