                                    {
                                        "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                        "entry_id": "f57a9e4b-8b4a-3a8a-868e-ecf49491045d",
                                        "glosses": [
                                            "kleines mit Motor betriebenes Wasserfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d645c6b-07f9-4ba6-8efa-e4da8604cc84",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "Das Motorboot begleitet das Ruderboot beim Training."
                                            },
                                            {
                                                "example_id": "2110846b-d5f7-4ecb-b892-1e767442ba62",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Sobald eine Gruppe von Grindwalen in der Nähe der Küste gesichtet wird, machen sich die Färinger in wendigen Motorbooten auf und treiben die Tiere in Richtung Strand.“"
                                            },
                                            {
                                                "example_id": "9f52eb2b-d187-412b-a3e8-fdea6a79ac23",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Wir wurden in ein Motorboot verstaut, das einer Barkasse glich.“"
                                            },
                                            {
                                                "example_id": "7ef75754-2723-4640-8f23-b64081487d40",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Er mietete ein Motorboot, fuhr Wasserski mit ihr.“"
                                            },
                                            {
                                                "example_id": "e2d50eb6-2340-4281-b785-f6148dbffd13",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Ich […] sprang in das Motorboot und fuhr es auf die andere Seite des Stegs, um es dort festzumachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
