                                "target_lang_sense_clarification": "о расстройстве личности или симптомах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "734527dc-6e54-3156-88a2-ed945f8ee101",
                    "sense_definition": "Nearly; not entirely but nevertheless to a great extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>borderline</w> hypoglycemic and needs to watch his sugar intake.",
                            "target_lang_translations": {
                                "ru": "Он <w>на грани</w> гипогликемии, поэтому ему нужно следить за потреблением сахара."
                            }
                        },
                        {
                            "text": "I expected the movie to be boring but it was actually <w>borderline</w> funny.",
                            "target_lang_translations": {
                                "ru": "Я ожидал, что фильм будет скучным, но он оказался <w>практически</w> смешным."
                            }
