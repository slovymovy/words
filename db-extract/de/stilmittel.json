                ],
                "senses": [
                    {
                        "sense_id": "fc6e8cab-9099-35ae-bb9b-cc0768588d0e",
                        "entry_id": "8705e694-057e-3bff-8a38-f17e42156165",
                        "glosses": [
                            "eine gezielte Textform, mit der ein Autor auf die Hauptaussage seines Gedichts, seiner Kurzgeschichte und so weiter aufmerksam macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8326c3-42c3-4b22-9f38-4612f2b6a80b",
                                "sense_id": "fc6e8cab-9099-35ae-bb9b-cc0768588d0e",
                                "text": "Die Metapher und der Vergleich sind Stilmittel."
                            },
                            {
                                "example_id": "20055e04-4586-4bd4-b089-423c5c2c2340",
                                "sense_id": "fc6e8cab-9099-35ae-bb9b-cc0768588d0e",
                                "text": "„Für die beiden Verfasser sind Metaphern mehr als ein dekoratives Stilmittel.“"
                            },
                            {
                                "example_id": "0815fce4-f906-4885-8ced-0cb01165eb0a",
                                "sense_id": "fc6e8cab-9099-35ae-bb9b-cc0768588d0e",
                                "text": "„Das Stilmittel der Wiederholung wird also sowohl im Glauben als auch im Aberglauben auf die Spitze getrieben.“"
                            },
                            {
                                "example_id": "9757e26e-d7d4-4fea-8b4e-4e7ee5c0fb76",
                                "sense_id": "fc6e8cab-9099-35ae-bb9b-cc0768588d0e",
                                "text": "„Es geht um das Stilmittel der Metapher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1e5e18f1-ec8f-3c21-bb4b-7c6a77cea7a9",
                        "entry_id": "8705e694-057e-3bff-8a38-f17e42156165",
                        "glosses": [
                            "etwas, das verwendet wird, um eine Aussage mit den Mitteln der jeweiligen Richtung zum Ausdruck zu bringen und oft typisch für eine Stilrichtung ist"
                        ],
                        "tags": [
                            "Malerei",
                            "Bildhauerei",
                            "Grafik",
                            "Tanz"
                        ],
                        "examples": [
                            {
                                "example_id": "435a5497-2aea-4179-915d-3ce72c5533fa",
                                "sense_id": "1e5e18f1-ec8f-3c21-bb4b-7c6a77cea7a9",
                                "text": "Schon früh begann Glass, die Provokation als Stilmittel einzusetzen und befolgte die schlichte Regel \"Sex sells\"."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
