                        "source_sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                        "source_sense_description": "Messinstrument für den Wasserverbrauch",
                        "target_lang_word": "contador del agua",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b9fdc748-bbe5-4a5c-9890-ac6a8488b583",
                        "source_entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
                        "source_sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                        "source_sense_description": "Uhr, bei der der Abfluss von Wasser als Zeitmesser dient",
                        "target_lang_word": "clepsydre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clepsydre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                        "entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                                        "glosses": [
                                            "Horloge qui indique la marche du temps par l’écoulement d’une certaine quantité d’eau."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec91ad78-a470-482a-95bd-d03dd963f4ed",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "Les anciens se servaient ordinairement de clepsydres pour mesurer le temps."
                                            },
                                            {
                                                "example_id": "61c148b9-9ba0-448b-bb1c-646edcbd3e1e",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "Mais Daniel Soutif, directeur du développement culturel du Centre et commissaire de l’exposition, tenait au symbole : la clepsydre est l’un des plus anciens instruments de mesure du temps et elle réunit deux notions, « l’écoulement continu », celui de l’eau qu'elle contient, et sa graduation, « tentative de réduire ce flux au commensurable »."
                                            },
                                            {
                                                "example_id": "400c5367-a443-49b7-abb0-0b8a8071de86",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "La clepsydre est l’un des plus anciens instruments découverts pour mesurer la durée du temps."
                                            },
                                            {
                                                "example_id": "cbd1cbbc-10e5-4a80-a448-bb8f253715b7",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "En fait, avoir 40 ans, c’est vivre en permanence dans « Fort Boyard » : moi, j’ai l’impression qu’Olivier Minne ne cesse de me souffler dans l’oreille : « La clepsydre... la clepsydre... Sors ! Sors ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a27bc7-757e-4425-a779-5d4333c3ae04",
                        "source_entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
