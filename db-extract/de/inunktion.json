                    {
                        "sense_id": "a9f62cb0-2e5d-3c9b-b629-a6f8220c7ff0",
                        "entry_id": "76e0510b-33df-31a5-a532-ebbf75f11cd3",
                        "glosses": [
                            "Einreibung (von flüssigen, pasten- oder salbenartigen Arzneimitteln)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b5d726-2458-496a-a992-263080cbf9b3",
                                "sense_id": "a9f62cb0-2e5d-3c9b-b629-a6f8220c7ff0",
                                "text": "„Dank seiner Inunktionen und Injektionen fühle er sich zum ersten Mal seit langer Zeit wieder wohl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
