                "senses": [
                    {
                        "sense_id": "8c9aec6f-4f36-361a-9c69-08c2dd7322dc",
                        "entry_id": "a8534382-5dfb-3c32-acf0-a9fadd957983",
                        "glosses": [
                            "machine die heipalen in de grond kan drijven als fundering voor bouwwerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b85e91-e7fb-4b0f-9df0-aa95acb6f5b3",
                                "sense_id": "8c9aec6f-4f36-361a-9c69-08c2dd7322dc",
                                "text": "Na de bevrijding hadden deze collaborateurs grote opdrachten van de Nederlandse staat binnengehaald, met hulp van de Marshall-gelden; zij hadden het materieel om direct aan de slag te gaan. Reid had op zijn handen na niks; geen hamer, geen graver, geen heimachine."
                            },
                            {
                                "example_id": "74b3263e-ae48-47ae-9480-6d23de1f462d",
                                "sense_id": "8c9aec6f-4f36-361a-9c69-08c2dd7322dc",
                                "text": "Even verderop leunt een heimachine tegen een betonnen zuil. Vanwege de strenge vorst is de bouw op het park tijdelijk tot stilstand gekomen."
                            },
                            {
                                "example_id": "e70b12a4-4936-447d-ae52-ee19bc16608c",
                                "sense_id": "8c9aec6f-4f36-361a-9c69-08c2dd7322dc",
                                "text": "Het project heeft vertraging opgelopen door een defecte heimachine en onvoorziene grondsanering. Sinds dinsdag wordt er al tot 's avonds laat geheid."
                            }
                        ]
                    }
                ],
