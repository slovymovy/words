{
    "word_family": [
        "environment",
        "environmental",
        "environmentalist",
        "environs"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ec3237b-bbc2-3bfa-b15b-9b3bc0d6d237",
                    "sense_definition": "A surrounding area or place; an environment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cottage was built in a quiet <w>environ</w> surrounded by dense pine woods. ",
                            "target_lang_translations": {
                                "ru": "Коттедж был построен в тихом <w>окружении</w> густого соснового бора."
                            }
                        },
                        {
                            "text": "They spent the morning exploring the historic castle and its peaceful rural <w>environ</w>.",
                            "target_lang_translations": {
                                "ru": "Утро они провели, исследуя исторический замок и его мирные сельские <w>окрестности</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rural environ",
                        "quiet environ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружающая местность, окружение или окрестности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружение",
                                "target_lang_sense_clarification": "обстановка, окружающая среда"
                            },
                            {
                                "target_lang_word": "окрестности",
                                "target_lang_sense_clarification": "прилегающая территория"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e0eefb2-df7d-30ff-ab6a-dcdb6fb1bb0e",
                    "sense_definition": "To encircle or surround someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High stone walls completely <w>environ</w> the ancient palace garden.",
                            "target_lang_translations": {
                                "ru": "Высокие каменные стены полностью <w>окружают</w> древний дворцовый сад."
                            }
                        },
                        {
                            "text": "A thick blanket of morning mist began to <w>environ</w> the quiet lake.",
                            "target_lang_translations": {
                                "ru": "Густое покрывало утреннего тумана начало <w>окутывать</w> тихое озеро."
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop"
                    ],
                    "common_phrases": [
                        "environ the garden",
                        "environ the city"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать или оказывать кольцом вокруг кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "находиться или располагаться вокруг"
                            },
                            {
                                "target_lang_word": "опоясывать",
                                "target_lang_sense_clarification": "окружать кольцом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aae5c1b-43c9-3e60-a30d-fd69fd7102f5",
                    "sense_definition": "To encircle or surround so as to attack from all sides; to besiege.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hostile army prepared to <w>environ</w> the fortress at nightfall.",
                            "target_lang_translations": {
                                "ru": "Вражеская армия готовилась <w>осадить</w> крепость с наступлением темноты."
                            }
                        },
                        {
                            "text": "Reinforcements arrived just before enemy troops could fully <w>environ</w> the camp.",
                            "target_lang_translations": {
                                "ru": "Подкрепление прибыло как раз перед тем, как вражеские войска смогли полностью <w>окружить</w> лагерь."
                            }
                        }
                    ],
                    "synonyms": [
                        "beleaguer",
                        "besiege"
                    ],
                    "common_phrases": [
                        "environ the fortress",
                        "environ the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать с целью нападения со всех сторон; осаждать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осаждать",
                                "target_lang_sense_clarification": "блокировать силами армии"
                            },
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "брать в кольцо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "257dc107-87d0-33ad-8db4-4d608cfff5b3",
                    "sense_definition": "To cover, enclose, or envelop completely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deep shadows began to <w>environ</w> the valley as twilight descended.",
                            "target_lang_translations": {
                                "ru": "Глубокие тени начали <w>окутывать</w> долину с наступлением сумерек."
                            }
                        },
                        {
                            "text": "The speaker felt a sudden sense of mystery <w>environ</w> the room.",
                            "target_lang_translations": {
                                "ru": "Говорящий почувствовал, как внезапное ощущение тайны <w>обволакивает</w> комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop",
                        "enwrap"
                    ],
                    "common_phrases": [
                        "environ in shadow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or poetic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью покрывать, окутывать или обволакивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "покрывать со всех сторон"
                            },
                            {
                                "target_lang_word": "обволакивать",
                                "target_lang_sense_clarification": "заволакивать, покрывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68d64f2e-0270-3431-baeb-4e4314d2b191",
                    "sense_definition": "Of danger or difficulty: to beset or affect someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many hidden perils <w>environ</w> those who travel through unknown mountains.",
                            "target_lang_translations": {
                                "ru": "Множество скрытых опасностей <w>подстерегает</w> тех, кто путешествует по неизвестным горам."
                            }
                        },
                        {
                            "text": "Unexpected troubles seemed to <w>environ</w> the newly appointed leader.",
                            "target_lang_translations": {
                                "ru": "Казалось, неожиданные неприятности <w>окружили</w> новоназначенного руководителя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perils environ"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Об опасностях или трудностях: тяготеть, подстерегать или преследовать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "тяготеть, сопутствовать"
                            },
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "быть со всех сторон (о бедах, трудностях)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad3ff26-7306-3fcc-8088-e9916e6a8250",
                    "sense_definition": "To encircle a heraldic element on a shield or coat of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two golden branches <w>environ</w> the central shield in the crest.",
                            "target_lang_translations": {
                                "ru": "Две золотые ветви <w>обрамляют</w> центральный щит на гербе."
                            }
                        },
                        {
                            "text": "The heraldic artist chose to <w>environ</w> the cross with a laurel wreath.",
                            "target_lang_translations": {
                                "ru": "Геральдист решил <w>окружить</w> крест лавровым венком."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specialized heraldic terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окаймлять или обрамлять геральдический элемент на гербе или щите."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "в геральдике: обрамлять герб или элемент"
                            },
                            {
                                "target_lang_word": "обрамлять",
                                "target_lang_sense_clarification": "окаймлять"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "500397f2-4c27-3377-bab9-03e928e4d2a5",
                    "sense_definition": "In the neighbourhood; around or nearby.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler looked <w>environ</w> to see if any shelter was near.",
                            "target_lang_translations": {
                                "ru": "Путешественник поглядел <w>вокруг</w>, чтобы проверить, нет ли поблизости укрытия."
                            }
                        },
                        {
                            "text": "Guards were stationed <w>environ</text> to ensure the king's safety.",
                            "target_lang_translations": {
                                "ru": "Стражники были расставлены <w>кругом</w>, чтобы обеспечить безопасность короля."
                            }
                        }
                    ],
                    "synonyms": [
                        "round",
                        "round about"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic adverbial use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поблизости, вокруг, неподалеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокруг",
                                "target_lang_sense_clarification": "поблизости, кругом"
                            },
                            {
                                "target_lang_word": "кругом",
                                "target_lang_sense_clarification": "находиться рядом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15253143-b838-3a75-89ad-fbbbbadcd4ed",
                    "sense_definition": "Almost; nearly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>environ</w> midnight when the messengers finally arrived.",
                            "target_lang_translations": {
                                "ru": "Было <w>около</w> полуночи, когда гонцы наконец прибыли."
                            }
                        },
                        {
                            "text": "They had walked <w>environ</w> three miles before finding the path.",
                            "target_lang_translations": {
                                "ru": "Они прошли <w>почти</w> три мили, прежде чем нашли тропу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "obsolete sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Почти; около."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почти",
                                "target_lang_sense_clarification": "приблизительно"
                            },
                            {
                                "target_lang_word": "около",
                                "target_lang_sense_clarification": "приблизительно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}