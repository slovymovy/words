                    },
                    {
                        "form_id": "33c4f127-98dc-4b48-9397-e16cc9567065",
                        "entry_id": "a1f7e6f9-6482-31d9-9caa-75888c62c79b",
                        "tags": [],
                        "form": "spinaker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f3505f9-e317-34a0-9eef-1f2d8833335e",
                        "entry_id": "a1f7e6f9-6482-31d9-9caa-75888c62c79b",
                        "glosses": [
                            "Voile d'avant très légère et très creuse hissée aux allures portantes."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "235c489b-8089-471b-9c5e-87df70dd493d",
                                "sense_id": "3f3505f9-e317-34a0-9eef-1f2d8833335e",
                                "text": "Il y avait beaucoup de lumières sur la mer, et le vent régulier et violent qui soufflait, après avoir contourné le promontoire, poussait devant lui un sloop dont la grand-voile et le spinnaker étaient totalement déployés."
                            },
                            {
                                "example_id": "ade46190-2c8e-4734-8219-b926a2a1432b",
                                "sense_id": "3f3505f9-e317-34a0-9eef-1f2d8833335e",
                                "text": "Un matin de juillet, le rêve devient réalité, Jeanne en prend conscience la première, elle pointe le doigt vers la mer et dit : « Regarde, Albert, je ne rêve pas ! » Entre deux bandes de ciel et d'eau, le spinnaker d'un deux mâts se gorge de vent."
                            },
                            {
                                "example_id": "bcd2806b-15c5-4415-ab0c-9cec213cd2e8",
                                "sense_id": "3f3505f9-e317-34a0-9eef-1f2d8833335e",
                                "text": "Des voiliers traçaient un sillage blanc sur une mer d'huile, leurs spinnakers multicolores gonflés par un vent léger, côtoyant les ferries qui ramenaient les employés chez eux ou transportaient les touristes vers le centre-ville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ea3741-1ffe-4fa6-ab75-022f298e5d36",
                        "source_entry_id": "a1f7e6f9-6482-31d9-9caa-75888c62c79b",
                        "source_sense_id": "3f3505f9-e317-34a0-9eef-1f2d8833335e",
                        "target_lang_word": "spinnaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spinnaker",
