                "senses": [
                    {
                        "sense_id": "076543c9-ed50-30f0-8eb9-e7b15299fed4",
                        "entry_id": "ae89707c-ea5b-3bae-b58f-7cd2f9b25fbc",
                        "glosses": [
                            "Pseudonyme d’Alexis Nolent, écrivain et scénariste de bandes dessinées français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec13482-3ede-4ec5-9624-18a896789b4d",
                                "sense_id": "076543c9-ed50-30f0-8eb9-e7b15299fed4",
                                "text": "Ce film adapte de manière glaçante une série de bandes dessinées démarrée en 1998, signée par Luc Jacamon et Matz et publiée chez Casterman."
                            },
                            {
                                "example_id": "6567a06b-35e1-49af-92b9-3e1dde5f3453",
                                "sense_id": "076543c9-ed50-30f0-8eb9-e7b15299fed4",
                                "text": "Né en 1967, Matz a grandi à la Martinique, puis à Paris."
                            },
                            {
                                "example_id": "aefdced8-769d-4c9f-b678-b3dbaae95fe3",
                                "sense_id": "076543c9-ed50-30f0-8eb9-e7b15299fed4",
                                "text": "Matz est né à Rouen sous le nom d’Alexis Nolent."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3c2364e1-8050-3a44-9b7a-16682ca14562",
                "word": "matz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bcae0e4d-8c21-3ada-aa7d-b9bf4239ed3e",
                        "entry_id": "3c2364e1-8050-3a44-9b7a-16682ca14562",
                        "glosses": [
                            "Homme, individu masculin."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "93d6f2cb-4786-425e-98ff-21367a468730",
                                "sense_id": "bcae0e4d-8c21-3ada-aa7d-b9bf4239ed3e",
                                "text": "En Attila du tendron, il apparaissait, ce matz !"
                            },
                            {
                                "example_id": "f759cf8f-891d-4478-9242-70f8438300c1",
                                "sense_id": "bcae0e4d-8c21-3ada-aa7d-b9bf4239ed3e",
                                "text": "Réciproquement, un matz peut se voir régaler suprêmement le cigarillo par une nana d’élite, et, dans le même temps lui réserver pour le futur un traitement d’une cruelle ingratitude."
                            },
                            {
                                "example_id": "fefdd350-dab7-480e-b197-f5efcc0fb3a0",
                                "sense_id": "bcae0e4d-8c21-3ada-aa7d-b9bf4239ed3e",
                                "text": "« Je connais un matz…\n— Allez, allez… Un matz qui ?…\n— … qui pourrait nous filer un sacré bon coup de paluche. »"
                            }
                        ]
                    }
