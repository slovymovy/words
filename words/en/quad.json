                {
                    "sense_id": "80205c6e-2e30-3edc-8f06-e334b63f9e4d",
                    "sense_definition": "A quadriplegic person; someone who is paralyzed in all four limbs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital provides specialized equipment to help a <w>quad</w> regain some independence.",
                            "target_lang_translations": {
                                "ru": "Больница предоставляет специализированное оборудование, чтобы помочь <w>квадриплегику</w> вернуть некоторую независимость.",
                                "zh": "医院提供专业设备，帮助<w>四肢瘫痪者</w>恢复一定的独立生活能力。"
                            }
