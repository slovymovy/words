                "senses": [
                    {
                        "sense_id": "aeeaab80-0e8c-3c64-946b-f11cb780355c",
                        "entry_id": "d91bd182-6823-34c1-8027-fa9b92cd4c7b",
                        "glosses": [
                            "Rivière du Nouveau-Brunswick au Canada, affluent du fleuve Saint-Jean à Edmunston."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d2137fc3-10c6-3635-9c23-59ed107971a7",
                        "entry_id": "d91bd182-6823-34c1-8027-fa9b92cd4c7b",
                        "glosses": [
                            "Région limitrophe de la Gaspésie, du Nouveau-Brunswick et du Maine."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "479df885-2f03-43be-82a3-e2fa96d3c81c",
                                "sense_id": "d2137fc3-10c6-3635-9c23-59ed107971a7",
                                "text": "À l’approche de Noël [1837], les troupiers franchissent la frontière, encore litigieuse, entre le Nouveau-Brunswick, le Maine et le Bas-Canada. La région, nommée Madawaska, est encore très peu colonisée par les Blancs, hormis pour quelques endroits et hameaux, dont la rive ouest du lac Témiscouata."
                            },
                            {
                                "example_id": "28db1425-d8af-46d3-939c-62eadb80d4fd",
                                "sense_id": "d2137fc3-10c6-3635-9c23-59ed107971a7",
                                "text": "Michael propose une réflexion sur l'homme et pas seulement sur le fait qu'il est lui-même homosexuel et membre de la Première Nation malécite, dont la réserve est située dans le Madawaska."
                            }
                        ]
                    },
                    {
                        "sense_id": "63854cd9-bf63-3f4a-8c6f-48f99863ce21",
                        "entry_id": "d91bd182-6823-34c1-8027-fa9b92cd4c7b",
                        "glosses": [
                            "Comté du nord-ouest du Nouveau-Brunswick au Canada."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "90e7ae6d-7b6c-42a7-99ca-3633b68a7bcd",
                                "sense_id": "63854cd9-bf63-3f4a-8c6f-48f99863ce21",
                                "text": "Les deux prochaines semaines seront donc déterminantes à savoir si l’éclosion du virus au Bas-Saint-Laurent aura des répercussions du côté néo-brunswickois de la frontière du Madawaska."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd65169a-82b6-3dfc-ac2c-1501cb4bc020",
                        "entry_id": "d91bd182-6823-34c1-8027-fa9b92cd4c7b",
                        "glosses": [
                            "Ville de l’État du Maine aux États-Unis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a22ba877-8f64-334b-aabd-eece7ea3252e",
                        "entry_id": "d91bd182-6823-34c1-8027-fa9b92cd4c7b",
                        "glosses": [
                            "Rivière de l’Ontario, affluent de la rivière Outaouais à Arnprior."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c57fd6-a79c-4dd9-98c1-ee79cb69746b",
                                "sense_id": "a22ba877-8f64-334b-aabd-eece7ea3252e",
                                "text": "En 1870, on lui confia la responsabilité des glissoires, des estacades, des barrages, des ponts, des canaux, des quais et des bâtiments de 11 postes situés sur l’Outaouais, 15 sur la Madawaska, 31 sur la Petawawa, 11 sur la Dumoine, un sur la Gatineau, un sur la Coulonge et un sur la rivière Noire."
                            }
                        ]
                    },
