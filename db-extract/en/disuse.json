                        "examples": [
                            {
                                "example_id": "82a66c79-c816-4198-ab69-9682f5f4dc79",
                                "sense_id": "d91fa667-97ab-32e6-93ba-b5a2770c163a",
                                "text": "The garden fell into disuse and became overgrown."
                            },
                            {
                                "example_id": "08df0616-d803-4c74-8224-6e750c0fff78",
                                "sense_id": "d91fa667-97ab-32e6-93ba-b5a2770c163a",
                                "text": "The decline and eventual closing of the various industrial undertakings and the non-renewal of the L.N.W.R. lease led to the railway falling into disuse, and most of it has now been lifted."
                            }
                        ]
                    }
                ],
