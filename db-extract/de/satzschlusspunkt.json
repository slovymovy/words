                        "target_lang_word": "point final",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point final",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30610cec-90c0-3d73-a018-d4e45c0ce1a6",
                                        "entry_id": "c817b5b8-e7d0-3c7d-b2aa-9b771a5a1ce0",
                                        "glosses": [
                                            "Point qui indique la fin d’une phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1c0213-2c78-44e3-b8b2-0bb7ed12db30",
                                                "sense_id": "30610cec-90c0-3d73-a018-d4e45c0ce1a6",
                                                "text": "Le point final est placé à l'intérieur des parenthèses lorsque le commentaire forme une phrase complète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3dcdc5-f151-3455-a23a-03be2fdf36fd",
                                        "entry_id": "c817b5b8-e7d0-3c7d-b2aa-9b771a5a1ce0",
                                        "glosses": [
                                            "Fin de quelque chose ; événement qui met un terme à quelque chose."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0790fe3-e27f-4b16-b9d9-3f12c924b118",
                                                "sense_id": "3f3dcdc5-f151-3455-a23a-03be2fdf36fd",
                                                "text": "L’arrêt de la Cour ne met pourtant pas un point final aux incertitudes concernant le mandat d’arrêt européen."
                                            },
                                            {
                                                "example_id": "9382e875-4f27-4aa0-995f-50207861a405",
                                                "sense_id": "3f3dcdc5-f151-3455-a23a-03be2fdf36fd",
                                                "text": "On se croyait tiré d'affaire ? Eh bien non, le point final n'était qu'un point-virgule."
                                            },
                                            {
                                                "example_id": "dfab6508-0ae9-4e07-938c-8a684a3a5ec1",
                                                "sense_id": "3f3dcdc5-f151-3455-a23a-03be2fdf36fd",
                                                "text": "« Dix minutes, comme je vous l’ai dit. Ne soyez pas en retard ou ils devront partir sans vous, point final. »"
                                            },
                                            {
                                                "example_id": "089730f6-e37f-4523-89b4-b92111f31668",
                                                "sense_id": "3f3dcdc5-f151-3455-a23a-03be2fdf36fd",
                                                "text": "Ça ne devrait pas seulement être en lien avec la diffusion d’information relative à une organisation criminelle. Diffusion de l’information, point final!"
                                            }
                                        ]
                                    }
                                ]
                            },
