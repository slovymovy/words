                                                "text": "Die Spritze machte sie schläfrig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d687ff4-c0e3-3555-b48c-376be4bd8177",
