                    {
                        "sense_id": "5e934a47-5c01-3702-b713-0e2630649af2",
                        "entry_id": "a1d1b871-8bf4-3a21-84b9-d3169aee733b",
                        "glosses": [
                            "A Protestant or evangelical Christian."
                        ],
                        "tags": [
                            "Early",
                            "Modern",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d69f21c5-b863-47e4-bbe0-885864592ff0",
                                "sense_id": "5e934a47-5c01-3702-b713-0e2630649af2",
                                "text": "If thou be a papist, there shalt thou want no kinde of supersticion to feede vpon. If thou be a gospeller, no man shall aske why thou comest not to churche."
                            },
                            {
                                "example_id": "7d4bab0b-da88-44d9-b6c5-1ae288eeda60",
                                "sense_id": "5e934a47-5c01-3702-b713-0e2630649af2",
                                "text": "You know I have conferred with many, and I ensure you, I never found man, so far as I do remembre, neyther old nor new Gospeller or Papist, of what judgment soever he was, in this thing to be a contrary opinion."
                            },
                            {
                                "example_id": "d52a6609-0930-42fd-85da-d933219246d1",
                                "sense_id": "5e934a47-5c01-3702-b713-0e2630649af2",
                                "text": "He for some time kept School at Reading in Barkshire, but after a time being found to be a Gospeller he was forced to fly thence, and repairing to his own Mother, who was a Papist."
                            }
                        ]
                    }
