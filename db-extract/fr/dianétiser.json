                        "glosses": [
                            "Faire adhérer à la dianétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff719d3e-745e-41be-9d5a-8009914ebc50",
                                "sense_id": "3fc4414d-d63d-3ebf-b6c2-01c87edf22fb",
                                "text": "Très peu pour moi, le nabot dianétisé."
                            },
                            {
                                "example_id": "4a5bd55a-c139-44ae-aaf8-5094524b1ce2",
                                "sense_id": "3fc4414d-d63d-3ebf-b6c2-01c87edf22fb",
                                "text": "[…] et au moins la ^([sic : là]) il n’avait plus à convaincre ses fideles ^([sic : fidèles]) apres ^([sic : après]) les avoir bien Dianétisés…"
                            },
                            {
                                "example_id": "cede222b-ed29-4355-a35b-b1bd30e7ed3c",
                                "sense_id": "3fc4414d-d63d-3ebf-b6c2-01c87edf22fb",
                                "text": "Du haut de l’Élysée et du bas de la Lanterne, il gouvernait le monde sous les projecteurs des extraterrestres dianétisés, qui eux aussi s’intéressaient à notre lider ^([sic : leader]) et à l’Histoire en marche ou en jogging je ne sais plus."
                            }
                        ]
                    }
