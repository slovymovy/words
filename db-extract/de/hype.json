                "translations": [
                    {
                        "translation_id": "bb13eb81-1d57-4900-8447-c63889a97f94",
                        "source_entry_id": "4f85e630-52e9-3964-a748-57d8a506843b",
                        "source_sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                        "source_sense_description": "großes Getue, Riesenrummel um eine Tatsache, Sache oder Person",
                        "target_lang_word": "hype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                        "entry_id": "80638c0b-9fa8-30ef-93ac-ed45a6d399b9",
                                        "glosses": [
                                            "Promotion or propaganda, especially exaggerated claims."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a126c95e-7423-40a3-a797-f65bfe562c43",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "After all the hype for the diet plan, only the results ended up slim."
                                            },
                                            {
                                                "example_id": "2d09b9e8-5980-478e-9cfe-f04bf3a12d0b",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "Don't believe the hype, it's a sequel / As an equal can I get this through to you"
                                            },
                                            {
                                                "example_id": "8b6131da-dbee-4859-8a38-345d4af791ef",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "I was never one to believe the hype\nSave that for the black and white"
                                            },
                                            {
                                                "example_id": "abe9841c-a262-42bc-9090-a3667c43001c",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "The first Grand Slam showpiece between the two dominant players on the ATP Tour had been a tantalising prospect - and it surpassed the hype."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                        "entry_id": "290ab517-82d5-349c-a748-048a916ac270",
                                        "glosses": [
                                            "To promote heavily; to advertise or build up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1722602-a3c0-4db3-b560-de15de1f8e96",
                                                "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                                "text": "They started hyping the new magazine months before its release."
                                            },
                                            {
                                                "example_id": "b959ca4d-abcf-4748-ab09-aa7cb585a87d",
                                                "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                                "text": "Hydrogen fuel cells are hugely hyped but have yet to prove themselves in the real world beyond a few limited trials or small fleets on the European mainland."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hype",
