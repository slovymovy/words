                "senses": [
                    {
                        "sense_id": "e5657e9d-67e8-3f15-a24f-7e5b80899559",
                        "entry_id": "8e1ca476-9c42-3cc7-a841-c016d84ad65c",
                        "glosses": [
                            "muslimische Seeräuber, die im Mittelmeer aktiv waren"
                        ],
                        "tags": [
                            "Frühe Neuzeit"
                        ],
                        "examples": [
                            {
                                "example_id": "49590c61-7bff-45a3-b775-5e5365fd95f3",
                                "sense_id": "e5657e9d-67e8-3f15-a24f-7e5b80899559",
                                "text": "„Die Kaperfahrten der Barbaresken sorgten zwar weiter für Unruhe, änderten an der Gesamtlage nichts.“"
                            },
                            {
                                "example_id": "0d61c552-4f94-4832-99f1-725f2419d423",
                                "sense_id": "e5657e9d-67e8-3f15-a24f-7e5b80899559",
                                "text": "„Und noch dem schwächelnden Venedig gelang im 18. Jahrhundert ein Sieg über die Barbaresken, weil diese nichts verkörperten als die eigene Raubgier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "314c8433-8cff-3fa9-9fbd-2d89187ab6b5",
                        "entry_id": "8e1ca476-9c42-3cc7-a841-c016d84ad65c",
                        "glosses": [
                            "Region in Nordafrika, zu der die Gebiete um Tunis, Tripolis, Algier und Marokko gezählt werden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1780e36b-5984-474e-ac36-cebf43e42a89",
                                "sense_id": "314c8433-8cff-3fa9-9fbd-2d89187ab6b5",
                                "text": "„Zudem diente ihm der Hafen als Flottenstützpunkt, und auch größere Kaperschiffe aus den unter osmanischer Oberhoheit stehenden Barbaresken in Nordafrika nutzten ihn als Versorgungsstation.“"
                            },
                            {
                                "example_id": "fec0f42e-5878-4b95-8350-c15124bfa490",
                                "sense_id": "314c8433-8cff-3fa9-9fbd-2d89187ab6b5",
                                "text": "„In den dazwischenliegenden 150 Jahren wurden etwa 36.000 Protestanten durch die Barbaresken gewaltsam nach Nordafrika gebracht, von denen wohl weniger als die Hälfte ihre Heimat wiedergesehen haben dürfte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
