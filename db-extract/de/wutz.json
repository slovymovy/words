                                "sense_id": "032f5fb5-0c76-3fe3-8d66-77b0e45397a3",
                                "text": "Die Wutzen können aber schnell laufen!"
                            },
                            {
                                "example_id": "58731e6d-6d48-456f-9f0b-69ac222ce468",
                                "sense_id": "032f5fb5-0c76-3fe3-8d66-77b0e45397a3",
                                "text": "Seit mein Auto in der Werkstatt war, rennt es wie die Wutz."
                            },
                            {
                                "example_id": "dcc5f27d-de30-417b-8f8f-9225dea4149d",
                                "sense_id": "032f5fb5-0c76-3fe3-8d66-77b0e45397a3",
                                "text": "„Kalli nannte Wildschweine Wutzen und sagte, die seien friedlich, es sei denn, sie hätten gerade Frischlinge geworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
