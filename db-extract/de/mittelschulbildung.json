                        "examples": [
                            {
                                "example_id": "26a18c6b-5498-4ed0-a753-fda3352afe44",
                                "sense_id": "990438e4-10e2-388c-8e5b-13f3ce91490a",
                                "text": "„23 Prozent hatten demnach eine Mittelschulbildung, 17 Prozent gingen lediglich auf die Grundschule.“"
                            },
                            {
                                "example_id": "2d2046e2-9dcf-4d46-9556-1929faf61e71",
                                "sense_id": "990438e4-10e2-388c-8e5b-13f3ce91490a",
                                "text": "„Am 1. April wird ihre Schulreform in Kraft gesetzt, die die Schulzeit bis zum 15. Lebensjahr verlängert und die Einführung der Mittelschulbildung für die Allgemeinheit vorsieht.“"
                            },
                            {
                                "example_id": "e0a420fe-6ebe-4411-945c-cd46468d95f3",
                                "sense_id": "990438e4-10e2-388c-8e5b-13f3ce91490a",
                                "text": "„Für die geistigen Ansprüche gilt grundsätzlich die Volks- und Mittelschulbildung von Sechs- bis Vierzehnjährigen als Maß.“"
                            }
                        ],
