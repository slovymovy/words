                        "vol de reconnaissance"
                    ]
                },
                {
                    "sense_id": "ac91faa5-383a-32da-9e21-0fa599575384",
                    "sense_definition": "Acte diplomatique par lequel un État admet l'existence ou la légitimité d'un autre État ou gouvernement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>reconnaissance</w> officielle de ce nouvel État a pris plusieurs mois de négociations."
                        },
                        {
                            "text": "Le président a annoncé la pleine <w>reconnaissance</w> du gouvernement voisin."
                        }
                    ],
                    "common_phrases": [
