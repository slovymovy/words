                                    {
                                        "sense_id": "7397a66c-9fdb-33a7-b72d-5b0b3fc0b815",
                                        "entry_id": "bde7d8ad-5766-3bf9-b3c7-afbbd65af0dc",
                                        "glosses": [
                                            "Soldat qui sert la mitrailleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dcb5cac-f6c4-4be9-947e-23348665c9ae",
                                                "sense_id": "7397a66c-9fdb-33a7-b72d-5b0b3fc0b815",
                                                "text": "La première victoire aérienne aurait eu lieu le 5 octobre 1914, le pilote Franz et son mitrailleur Louis Quenault abattant un aviatik à Jonchery-sur-Vesle (Marne)."
                                            }
