                        "glosses": [
                            "met betrekking tot een baan dat ze deze de helft van de werkweek uitoefent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ac920c-1f98-4994-9e35-cdb5b1ece413",
                                "sense_id": "b6d4caba-4f89-31f0-8979-8a456d34f734",
                                "text": "Leraren die 4 of 4,5 dag in de week werken, blijken nog zoveel tijd kwijt te zijn aan extra taken, dat ze in feite fulltime werken. Ook mensen die halftime of minder werken, zijn relatief vaak thuis nog bezig. Het lesgeven zelf is niet zo'n belasting. Leraren voelen vooral de druk van ouderavonden, surveilleren tijdens hun pauzes en het nakijken van opdrachten."
                            }
                        ]
                    }
                ],
