                        "sense_id": "b63a9b35-29d4-3ec3-a649-de5f956f40e8",
                        "entry_id": "e81eac22-5d68-3327-a06f-41c20b99bcdc",
                        "glosses": [
                            "The edible saltwater clam Paphies australis, of the family Mesodesmatidae, endemic to New Zealand."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "b690a33b-0d5b-4b25-aaa9-cbf0d4099d25",
                                "sense_id": "b63a9b35-29d4-3ec3-a649-de5f956f40e8",
                                "text": "She chuckles, and prises another shrinking pipi from its shell."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1a1ec34-05d3-3c19-ba38-f723aff554eb",
                        "entry_id": "e81eac22-5d68-3327-a06f-41c20b99bcdc",
                        "glosses": [
                            "The edible saltwater clam Plebidonax deltoides, endemic to Australia."
                        ],
                        "tags": [
                            "Australia",
                            "New-South-Wales"
                        ],
                        "examples": [
                            {
                                "example_id": "c053b9d8-7e41-49ac-8f4c-00fc6cf2ee51",
                                "sense_id": "e1a1ec34-05d3-3c19-ba38-f723aff554eb",
                                "text": "The sand whiting feeds on nippers, pipis, prawns and especially beach, squirt or blood worms and all these make terrific baits."
                            },
                            {
                                "example_id": "e3aef2c0-29d0-44b7-9f3a-0fd72064f0ff",
                                "sense_id": "e1a1ec34-05d3-3c19-ba38-f723aff554eb",
                                "text": "Pipis are very good baits for catching bream, trevally, whiting, particularly King George Whiting, leatherjackets and many others."
                            },
                            {
                                "example_id": "d6d1dcb4-f7c5-4669-9373-d721aef8316e",
                                "sense_id": "e1a1ec34-05d3-3c19-ba38-f723aff554eb",
                                "text": "Bivalves are shells with two valves joined at a hinge, like oysters, pipis and many of the shells picked up on a modern beach."
                            }
                        ]
                    }
                ],
