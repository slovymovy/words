                        "examples": [
                            {
                                "example_id": "8d19e2fb-dd28-4547-ae03-a774fa2c28bb",
                                "sense_id": "a461ed8e-5729-3c11-90b7-3cba2b2acfee",
                                "text": "La largade est le « vent de la mer » des pêcheurs provençaux. Ce vent souffle du SW et donne rapidement une mer démontée."
                            },
                            {
                                "example_id": "e520441a-a2cd-45f3-9681-c3bd8c53bdba",
                                "sense_id": "a461ed8e-5729-3c11-90b7-3cba2b2acfee",
                                "text": "Elle n'avait pas de boussole et ses connaissances maritimes se réduisaient à ce que les largades d'est voulaient bien lui raconter."
                            },
                            {
                                "example_id": "d675de81-86fc-4e67-a602-fec2ef411739",
                                "sense_id": "a461ed8e-5729-3c11-90b7-3cba2b2acfee",
                                "text": "Les largades à la pelleteuse casseront concasseront / carrelages bouteilles cruches et assiettes / jetés par les fenêtres comme / le temps de l'enfance"
                            }
                        ]
                    }
