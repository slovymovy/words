                    "sense_definition": "een groet bij aankomst of vertrek",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "groet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je niet even <w>gedag</w> zeggen tegen oma voor we weggaan?",
                            "target_lang_translations": {
