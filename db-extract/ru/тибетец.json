                                    {
                                        "sense_id": "dd37fe63-65f3-3660-bcb7-bef49a664f44",
                                        "entry_id": "723fcd64-6c8e-329d-9404-27e646d8efbc",
                                        "glosses": [
                                            "mieszkaniec Tybetu, Tybetańskiego Regionu Autonomicznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e9a6e3-eaad-4cf8-92a9-8f100b6722b5",
                                                "sense_id": "dd37fe63-65f3-3660-bcb7-bef49a664f44",
                                                "text": "Obiekty te ocalały pomimo ogromnych zniszczeń, jakich dokonano podczas rewolucji kulturalnej, i dowodzą ciągłości osadniczej Tybetańczyków na tych ziemiach"
                                            },
                                            {
                                                "example_id": "3cabbe37-e582-4661-9ea5-5f8317cb7cce",
                                                "sense_id": "dd37fe63-65f3-3660-bcb7-bef49a664f44",
                                                "text": "Tybetańczycy tę rzekomą, tajemniczą, budzącą strach istotę nazywają kanguli, Nepalczycy natomiast yeti."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
