                "senses": [
                    {
                        "sense_id": "c0ffe903-52ee-39f3-b3d4-47ea09040618",
                        "entry_id": "f589f6e3-3206-3d49-806a-9ac55f8ee0cc",
                        "glosses": [
                            "Enlever le brome contenu dans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f950c72d-7536-45cf-afb9-12c0a16ee04b",
                                "sense_id": "c0ffe903-52ee-39f3-b3d4-47ea09040618",
                                "text": "On peut débromer des dibromures vicinaux en les traitant avec certains agents réducteurs, comme l'ion iodure ou le zinc."
                            },
                            {
                                "example_id": "bc09b649-13e0-405b-87b0-73ba8132cb4a",
                                "sense_id": "c0ffe903-52ee-39f3-b3d4-47ea09040618",
                                "text": "Des études indiquent que, dans certaines circonstances, les DE les plus bromés peuvent se débromer et se convertir en DE moins bromés dans l'environnement et dans le biote."
                            },
                            {
                                "example_id": "373958ef-ccc3-45a5-8bc4-8dcca2f59f46",
                                "sense_id": "c0ffe903-52ee-39f3-b3d4-47ea09040618",
                                "text": "Ces résultats suggèrent que certaines bactéries peuvent débromer le décaBDE dans des conditions appropriées."
                            }
                        ]
                    }
