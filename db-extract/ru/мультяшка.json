                ],
                "senses": [
                    {
                        "sense_id": "aa39928f-c9e2-3545-9221-8818e35f863e",
                        "entry_id": "7f3cb7eb-b8ab-34ad-a3a2-63ebf54f2009",
                        "glosses": [
                            "разг. персонаж мультфильма или комикса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3852c8-1c80-425c-8a32-7ef2c214a314",
                                "sense_id": "aa39928f-c9e2-3545-9221-8818e35f863e",
                                "text": "По моему глубокому убеждению, выгляжу я очень непропорционально – как рисованная мультяшка."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9e4a45-b134-3ab0-9a5c-b6c88a49af04",
                        "entry_id": "7f3cb7eb-b8ab-34ad-a3a2-63ebf54f2009",
                        "glosses": [
                            "разг. мультфильм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8921ee8b-c444-4e29-96f7-1c01535d7613",
                                "sense_id": "7b9e4a45-b134-3ab0-9a5c-b6c88a49af04",
                                "text": "Что сказать по поводу графики? Это обычная компьютерная мультяшка. Герой игры нарисован бородатым и в маскировочном костюме."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a069eec9-6ad2-4030-9027-aa99fe05d8a4",
                        "source_entry_id": "7f3cb7eb-b8ab-34ad-a3a2-63ebf54f2009",
                        "target_lang_word": "toon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "891d2715-c090-3b25-83a6-70fbbdfe7b1f",
                                        "entry_id": "e29654dd-a378-30f6-8633-97d086cc0ec4",
                                        "glosses": [
                                            "A cartoon, especially an animated television show."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2edf54df-7449-41db-b0cb-1e9c73d27cbb",
                                                "sense_id": "891d2715-c090-3b25-83a6-70fbbdfe7b1f",
                                                "text": "Did you know Nash had a complete break with reality, that he was loonier than a toon for almost four months?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03841b3c-893d-3282-8009-f60ee31bdc95",
                                        "entry_id": "e29654dd-a378-30f6-8633-97d086cc0ec4",
                                        "glosses": [
                                            "A player's avatar or visible character in a massively multiplayer online role-playing game."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77adb685-eb89-4cb5-85cf-4188545846ae",
                                                "sense_id": "03841b3c-893d-3282-8009-f60ee31bdc95",
                                                "text": "Proxemics are very important, however, as the positioning of an agent's toon in anon-combat grouping or in the environment can show place within a social group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5319ccbf-bb7b-34f2-a264-29d4bda2bff5",
                                        "entry_id": "e29654dd-a378-30f6-8633-97d086cc0ec4",
                                        "glosses": [
                                            "An animated cartoon character."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f43ed5-07e3-4ba1-a99d-e99bcde7d4e7",
                                                "sense_id": "5319ccbf-bb7b-34f2-a264-29d4bda2bff5",
                                                "text": "In 1947 Los Angeles, animated cartoon characters, or \"toons\", co-exist with humans, often employing their skills to entertain as film stars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c134353-3bf0-32be-b380-10ddf633088a",
                                        "entry_id": "8ca13a46-0f17-3a5e-a724-84d4fe9c25bd",
                                        "glosses": [
                                            "A southeast Asian and Australian tree (Toona ciliata or Toona australis) of the mahogany family with fragrant dark red wood and flowers that yield a dye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd013c99-7701-4ffc-a068-2e33633fbb93",
                                                "sense_id": "6c134353-3bf0-32be-b380-10ddf633088a",
                                                "text": "Each plot held 10 cull trees so that 60 Australian toon and 40 tropical ash trees were treated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eabea22-e5df-3370-959c-7034d6c330f1",
                                        "entry_id": "8ca13a46-0f17-3a5e-a724-84d4fe9c25bd",
                                        "glosses": [
                                            "The wood of this tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37417d75-6ab7-453e-9fff-be3a6d3ceee7",
                                                "sense_id": "7eabea22-e5df-3370-959c-7034d6c330f1",
                                                "text": "After 7 years, all paint combinations except the self-primed latex are showing some failure on all species of wood except Australian toon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f0de97-d9ee-3880-9ec1-9526d9fbe491",
                                        "entry_id": "d5454a36-4cff-34d9-a0b8-8ae92aa0759a",
                                        "glosses": [
                                            "A town."
                                        ],
                                        "tags": [
                                            "Northumbria",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce6e65e5-ee47-4b26-87a9-3c3476e4c7ff",
                                                "sense_id": "b7f0de97-d9ee-3880-9ec1-9526d9fbe491",
                                                "text": "Whan I was a callan, I took the play to mysel' for a week, or maybe twa, and gaed wi' a frien' i' the same trade's mysel', to see what was to be seen alang a screed o' the seacoast, frae toon to toon."
                                            },
                                            {
                                                "example_id": "2240c736-4a13-48c9-bb87-7b7667553f88",
                                                "sense_id": "b7f0de97-d9ee-3880-9ec1-9526d9fbe491",
                                                "text": "Sic changes owre oor toon hae passed Since Mungo placed thee there — A wee bit slender fragile stem, That needed watchfu' care."
                                            },
                                            {
                                                "example_id": "aeaf3b51-cb7d-4e65-a2a7-63e4fb2679f2",
                                                "sense_id": "b7f0de97-d9ee-3880-9ec1-9526d9fbe491",
                                                "text": "It tane Bill three month fae the time he pairtit wi Beatrice tae get tae the toon o Shanzi. He stuid on a crest as the sin rase, an saw the fortress toon on the neist ridge, a silhouette lichtenin gradually intae ugly breezeblock buildins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f116cf1-8ddb-3c0c-9043-69598ea12567",
                                        "entry_id": "69c7ee89-a98c-3e2f-9dec-5097421536c8",
                                        "glosses": [
                                            "Eye dialect spelling of tune."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29b83772-11f4-4978-ba37-7dfa9286cc27",
                                                "sense_id": "8f116cf1-8ddb-3c0c-9043-69598ea12567",
                                                "text": "But why dress me in bloo? Why not in gray, ef I play Confedrit toons?"
                                            },
                                            {
                                                "example_id": "17fcc7a5-6e4e-4708-8f45-4f1faed6d0ed",
                                                "sense_id": "8f116cf1-8ddb-3c0c-9043-69598ea12567",
                                                "text": "Hark at the way them wires plays toons, as if all the imps of wickedness, and—never mind where—was fiddling dismal toons on purpose to drive a man out of his wits, or to scare him so that he couldn't do his work."
                                            },
                                            {
                                                "example_id": "f0040467-15a1-4e0e-82fb-a44ed18c0339",
                                                "sense_id": "8f116cf1-8ddb-3c0c-9043-69598ea12567",
                                                "text": "“But toon up, and a song all round.”"
                                            },
                                            {
                                                "example_id": "07ad8d1c-df47-42e0-bca7-aad4fab30cc7",
                                                "sense_id": "8f116cf1-8ddb-3c0c-9043-69598ea12567",
                                                "text": "Why suddenly you're so eager to know the toon, now, Dwight? Before you was saying you didn't even hear no toon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
