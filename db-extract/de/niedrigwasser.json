                        "source_sense_id": "87c2e786-f430-3398-af4e-1ce9e20b6c98",
                        "source_sense_description": "in Bezug auf die Meeresküste: Tiefstand des Wassers am Ende der Ebbe",
                        "target_lang_word": "marée basse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marée basse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                        "entry_id": "8c8c7a0a-9dd6-3a28-8c30-570761ee7ee6",
                                        "glosses": [
                                            "Période de la journée où l’attraction conjuguée de la lune et du soleil est au minimum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb8b45d-d920-4180-8217-2464545e08d6",
                                                "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                                "text": "Lorsqu’un vent de nord-ouest pousse les eaux vers le sud, surtout au moment de la marée basse, on peut traverser le golfe à cheval, ou même à pied, en allant au nord."
                                            },
                                            {
                                                "example_id": "9b9c12af-d0cc-4e2d-aa26-2fe6512cb28e",
                                                "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                                "text": "Pas de mer ! C’était la marée basse. Il n’y avait que du sable à perte de vue, et puis une étroite bande luisante, très, très loin."
                                            },
                                            {
                                                "example_id": "58122524-0e95-4ea9-831f-9b24b47f1ad6",
                                                "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                                "text": "À son seau et sa pelle en fer-blanc, il préfère son filet à crevettes, qu’il pousse devant lui en raclant le fond des flaques à marée basse."
                                            },
                                            {
                                                "example_id": "06ee3388-67a8-41a2-b169-5b3a7f7d663b",
                                                "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                                "text": "Son embouchure, à 32 ou 33 kilomètres au sud de Safi, est bloquée par une barre guéable à marée basse pendant presque toute l’année."
                                            },
                                            {
                                                "example_id": "53f3b770-4317-4334-8eb9-c8d2b76ccbbe",
                                                "sense_id": "109f599a-e43f-3a71-99f4-bde651a8caa3",
                                                "text": "Des rochers bas, couverts de mousses et de varechs, émergent à marée basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc0c83c-2da6-37ad-990c-e0b50729323f",
                                        "entry_id": "8c8c7a0a-9dd6-3a28-8c30-570761ee7ee6",
                                        "glosses": [
                                            "Verre vide."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0dac4dd-1dde-410e-a09f-bfe744de7a54",
                                                "sense_id": "9fc0c83c-2da6-37ad-990c-e0b50729323f",
                                                "text": "Dis donc, y a marée basse, se plaignit-elle en me tendant sa flûte vide."
                                            }
                                        ]
                                    }
                                ]
                            }
