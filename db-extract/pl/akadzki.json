                        "sense_id": "561af0e0-25e0-3ecd-8cc0-f870f348272a",
                        "entry_id": "efc4bb5b-ce4d-37c1-8bdc-2ba69dd44ec9",
                        "glosses": [
                            "sich auf die Akkadier beziehend; akkadisch"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
