                        "entry_id": "e218e7e4-9a47-3899-a0a7-34ada25c412b",
                        "glosses": [
                            "Alcool polycyclique complexe présent dans les organismes animaux, végétaux et les champignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a96a52a-924a-4a69-8090-b69fa675c5af",
                                "sense_id": "c4169a26-7394-3c45-a332-200e2d793450",
                                "text": "Le cholestérol, la vitamine D ou les hormones sexuelles sont des stérols bien connus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faf925e7-fff9-4abb-a7a7-e0d633fc31c5",
