                "entry_id": "1a7f2100-367d-3ea1-92f3-47da7c8008be",
                "word": "transmigratory",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fd76c3f-0c7a-319e-9a8f-65a78f03702f",
                        "entry_id": "1a7f2100-367d-3ea1-92f3-47da7c8008be",
                        "glosses": [
                            "Of, pertaining to, or undergoing transmigration, as a soul from one body to another."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc3c0452-b528-4672-89f0-275b9badd875",
                                "sense_id": "5fd76c3f-0c7a-319e-9a8f-65a78f03702f",
                                "text": "I think of him as of some transmigratory votary of Indian legend, who says, \"Though I be dog, or jackal, or pismire, in the last rudiments of nature, under what integument or ferocity, I cleave to right, as the sure ladder that leads up to man and to God.\""
                            },
                            {
                                "example_id": "55359cd3-7f67-4a52-bd4e-5840c5465766",
                                "sense_id": "5fd76c3f-0c7a-319e-9a8f-65a78f03702f",
                                "text": "To the Brahmin, the lower animal kingdom is a vast masquerade of transmigratory souls."
                            },
                            {
                                "example_id": "70b31242-335d-4026-9c50-e582580811f1",
                                "sense_id": "5fd76c3f-0c7a-319e-9a8f-65a78f03702f",
                                "text": "[W]e probably called others bad only so far as we were wrapped in ourselves and lacking in the transmigratory forces of imagination."
                            }
                        ]
                    },
                    {
                        "sense_id": "db1afce4-6bfe-38a4-9bc8-29c3f57b94ec",
                        "entry_id": "1a7f2100-367d-3ea1-92f3-47da7c8008be",
                        "glosses": [
                            "Of, pertaining to, or undergoing transmigration, as between places."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "61ff95fb-7baf-476f-b540-f39f4d574f60",
                                "sense_id": "db1afce4-6bfe-38a4-9bc8-29c3f57b94ec",
                                "text": "[T]he Kuala Gula Bird Sanctuary offers a hideaway to see some of the transmigratory birds that regular flock to the area."
                            },
                            {
                                "example_id": "15a72cc0-8dfa-4973-b7b0-96aed3243c2f",
                                "sense_id": "db1afce4-6bfe-38a4-9bc8-29c3f57b94ec",
                                "text": "Changes in the diet of a South Asian transmigratory population may be associated with an increase in incidence of childhood diabetes."
                            }
                        ]
                    }
                ],
