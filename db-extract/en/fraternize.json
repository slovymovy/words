                    },
                    {
                        "translation_id": "85a38c00-ee79-4649-a7fe-944131075af6",
                        "source_entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "source_sense_description": "to associate with others in a brotherly manner",
                        "target_lang_word": "zbratać się",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e9277fd8-a63b-452c-b068-c6e4c75a0321",
                        "source_entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "source_sense_description": "to associate with others in a brotherly manner",
                        "target_lang_word": "брататься",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брататься",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd9c7c9-bccd-37f4-9d4f-1b36c40cff4e",
                                        "entry_id": "5bdd6af0-c329-3b10-95c7-bb8640063b01",
                                        "glosses": [
                                            "прекращать военные действия, заявляя о взаимных братских чувствах, солидарности, взаимно выказывая чувства товарищества (о солдатах противоборствующих армий)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82b2fda-0160-4b42-b688-f6ba36f9a2f6",
                                                "sense_id": "fdd9c7c9-bccd-37f4-9d4f-1b36c40cff4e",
                                                "text": "Казаки Уссурийцы стали брататься с большевиками."
                                            },
                                            {
                                                "example_id": "85f2f082-2b2a-4e19-97c6-cd31e87b8ed1",
                                                "sense_id": "fdd9c7c9-bccd-37f4-9d4f-1b36c40cff4e",
                                                "text": "Бывало, вечером идёшь мимо театра и видишь, что здание окружено солдатами. Значит, идёт митинг, на коем эти умные головы решают вопрос: что лучше — драться ли с немцами или брататься?"
                                            },
                                            {
                                                "example_id": "19907d98-19d1-44f4-83de-79a272d6a6d2",
                                                "sense_id": "fdd9c7c9-bccd-37f4-9d4f-1b36c40cff4e",
                                                "text": "Каторжник начинает читать письма с фронта: немцы хотят брататься с русскими товарищами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43949fac-f91b-3230-94e0-ce3d6f06ba42",
                                        "entry_id": "5bdd6af0-c329-3b10-95c7-bb8640063b01",
                                        "glosses": [
                                            "разг. вступать в тесную дружбу, в братские отношения с кем-либо; проявлять братские чувства к кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b25d7a64-8e28-4d32-8965-c0c75b721c72",
                                                "sense_id": "43949fac-f91b-3230-94e0-ce3d6f06ba42",
                                                "text": "На первых порах я сознательно, а отчасти по тогдашней моде, братался с народом, жал и косил, носил мужицкую рубашку, прощал недоимки…"
                                            },
                                            {
                                                "example_id": "c8f1c42d-e54d-4088-bb98-6abd9bd93971",
                                                "sense_id": "43949fac-f91b-3230-94e0-ce3d6f06ba42",
                                                "text": "Одни побежали вразвалочку да охая за казарму. Другие исчезли в казарме или бросились брататься с разомлевшим сытым дневальным да расхватывать вкусные его сигареты."
                                            },
                                            {
                                                "example_id": "26f8dd03-e463-4786-879e-ff72b768486a",
                                                "sense_id": "43949fac-f91b-3230-94e0-ce3d6f06ba42",
                                                "text": "Подумав над этим предложением, вологодцы предложили ему выпить, на что тот охотно согласился. Коньяк ему подливали почаще, что разрядило обстановку — вымогатель стал брататься с приезжими, сказал, что зовут его Сергеем Л., и денег больше не просил."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97152b10-3ae4-38cf-9008-add7aac8e884",
                                        "entry_id": "5bdd6af0-c329-3b10-95c7-bb8640063b01",
                                        "glosses": [
                                            "устар. давать кому-либо обет вечной дружбы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1ddc2b-2791-4166-bba9-38ca3f52f38f",
                                                "sense_id": "97152b10-3ae4-38cf-9008-add7aac8e884",
                                                "text": "Он давно позабыл, что в России братанье — когда обмениваются нательными крестами; никогда не знал, что на Кавказе братались, делая надрез на руках и прикладывая одну ранку к другой — кровь смешивая; он и предположить не может, что брататься можно и шашками — когда крови, к несчастью, бывает чересчур много."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
