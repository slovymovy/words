                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director used <w>cheating</w> to make the actors appear closer together than they actually were.",
                            "target_lang_translations": {
                                "ru": "Режиссер использовал <w>читинг</w>, чтобы актеры казались ближе друг к другу, чем были на самом деле.",
                                "tr": "Yönetmen, oyuncuların gerçekte olduklarından daha yakın görünmelerini sağlamak için <w>kamera hilesi</w> kullandı."
                            }
                        },
                        {
                            "text": "Visual <w>cheating</w> is often necessary when filming in tight spaces.",
                            "target_lang_translations": {
                                "ru": "Визуальный <w>обман</w> часто необходим при съемке в тесных помещениях.",
                                "tr": "Dar alanlarda çekim yaparken görsel <w>hileler</w> sıklıkla gereklidir."
                            }
