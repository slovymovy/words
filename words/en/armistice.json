{
    "word_family": [
        "armisticial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcbc1d5f-9503-33de-975b-effa0d7c3b98",
                    "sense_definition": "A temporary pause in fighting between opposing sides.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation_of_hostilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two armies agreed to a short <w>armistice</w> to collect their wounded soldiers from the battlefield."
                        },
                        {
                            "text": "Both sides hoped that the <w>armistice</w> would eventually lead to a permanent peace treaty."
                        }
                    ],
                    "synonyms": [
                        "ceasefire",
                        "truce"
                    ],
                    "common_phrases": [
                        "sign an armistice",
                        "declare an armistice"
                    ]
                },
                {
                    "sense_id": "d9a2c0c6-7a29-38fa-b3a4-78f5c21b4d79",
                    "sense_definition": "A formal agreement between nations to stop military conflict.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation_of_hostilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warring nations finally signed a formal <w>armistice</w> to end the long and bloody conflict."
                        },
                        {
                            "text": "Diplomats worked through the night to draft the terms of the <w>armistice</w> before the morning deadline."
                        }
                    ],
                    "synonyms": [
                        "ceasefire",
                        "truce"
                    ],
                    "common_phrases": [
                        "negotiate an armistice",
                        "terms of armistice"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c20463db-d611-3313-9023-5627b38dc6ab",
                    "sense_definition": "The specific agreement signed on November 11, 1918, that ended the fighting in World War I.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical_event",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Every year on November 11, many countries observe a moment of silence to mark the signing of the <w>Armistice</w>."
                        },
                        {
                            "text": "The railway carriage where the 1918 <w>Armistice</w> was signed has become a significant historical site."
                        }
                    ],
                    "common_phrases": [
                        "the 1918 Armistice"
                    ]
                },
                {
                    "sense_id": "7708f60d-fe5e-3712-bc05-2f8b4774438f",
                    "sense_definition": "A lowercase reference to the historical agreement that ended World War I.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical_event",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Historians often debate whether the <w>armistice</w> of 1918 was truly effective in preventing future conflicts."
                        },
                        {
                            "text": "The political climate in Europe changed drastically in the months following the <w>armistice</w>."
                        }
                    ]
                }
            ]
        }
    ]
