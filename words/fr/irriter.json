                {
                    "sense_id": "87528fe3-1640-3152-a471-440f73f640d1",
                    "sense_definition": "Provoquer une inflammation, une rougeur ou une sensation douloureuse sur la peau ou les muqueuses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contact avec cette plante peut fortement <w>irriter</w> la peau sensible.",
                            "target_lang_translations": {
                                "en": "Contact with this plant can severely <w>irritate</w> sensitive skin.",
                                "ru": "Контакт с этим растением может сильно <w>раздражать</w> чувствительную кожу.",
                                "de": "Der Kontakt mit dieser Pflanze kann empfindliche Haut stark <w>reizen</w>.",
                                "es": "El contacto con esta planta puede <w>irritar</w> gravemente la piel sensible.",
                                "zh": "接触这种植物可能会严重<w>刺激</w>敏感的皮肤。"
                            }
                        },
                        {
                            "text": "La fumée de cigarette a tendance à <w>irriter</w> la gorge des personnes présentes.",
                            "target_lang_translations": {
                                "en": "Cigarette smoke tends to <w>irritate</w> the throats of those present.",
                                "ru": "Сигаретный дым, как правило, <w>раздражает</w> горло присутствующих.",
                                "de": "Zigarettenrauch neigt dazu, den Hals der Anwesenden zu <w>reizen</w>.",
                                "es": "El humo del cigarrillo tiende a <w>irritar</w> la garganta de los presentes.",
                                "zh": "香烟的烟雾容易<w>刺激</w>在场人的喉咙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enflammer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "soulager"
                    ],
                    "common_phrases": [
                        "irriter la peau",
                        "irriter la gorge"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause inflammation, redness or pain on the skin or mucous membranes.",
                        "ru": "Вызывать воспаление, покраснение или болезненное ощущение на коже или слизистых оболочках.",
                        "de": "Auf Haut oder Schleimhäuten Entzündung, Rötung oder Schmerzen hervorrufen.",
                        "es": "Causar inflamación, enrojecimiento o dolor en la piel o las mucosas.",
                        "zh": "使皮肤或黏膜发炎、发红或感到疼痛。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "skin or mucous membranes, medical"
                            },
