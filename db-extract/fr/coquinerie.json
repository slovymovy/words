                "entry_id": "607cdcf1-51cf-31d9-aa08-d9abc5a2ff9f",
                "word": "coquinerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bbf66023-4755-4470-be7c-710d446996ba",
                        "entry_id": "607cdcf1-51cf-31d9-aa08-d9abc5a2ff9f",
                        "tags": [
                            "plural"
