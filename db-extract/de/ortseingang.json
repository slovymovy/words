                "senses": [
                    {
                        "sense_id": "190c0c36-1c2d-3043-bfcb-3241250e1f4c",
                        "entry_id": "f9fdc27e-fdee-37f6-9a89-15bef050b412",
                        "glosses": [
                            "Stelle, an der man in einen Ort hineinfährt/-geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f89a7c-dd6d-4715-b55b-bf6f683f3752",
                                "sense_id": "190c0c36-1c2d-3043-bfcb-3241250e1f4c",
                                "text": "„Wir hatten die kurze Strecke vom Ortseingang zum Zentrum hinter uns gelassen und fuhren bereits zum zweitenmal um den Platz herum.“"
                            },
                            {
                                "example_id": "57eb6c62-512b-468e-b5eb-10feecba91ac",
                                "sense_id": "190c0c36-1c2d-3043-bfcb-3241250e1f4c",
                                "text": "„Toftanes befindet sich gegenüber vom Hafen am westlichen Ortseingang.“"
                            },
                            {
                                "example_id": "4fb4d120-6b91-468c-b19f-bc763401254d",
                                "sense_id": "190c0c36-1c2d-3043-bfcb-3241250e1f4c",
                                "text": "„Kurz vor dem Ortseingang spazieren wir durch einen Weinlehrpfad, der Auskunft gibt über Geschichte und Geologie, über Böden, Klima und Mineralien, über Sorten und Erträge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
