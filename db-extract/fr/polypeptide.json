                "senses": [
                    {
                        "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                        "entry_id": "70be622a-1337-3881-91fb-65aed6513d07",
                        "glosses": [
                            "Polymère linéaire composé d’un grand nombre (10 à 30) d’acides aminés liés par des liaisons peptidiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec87f4c-fe2c-4aca-8ab6-c30dcf24be32",
                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                "text": "Cette séquence constitue la carte d’identité d’un polypeptide."
                            },
                            {
                                "example_id": "3d4a3fbc-9ecd-4199-8852-ec10a3d72b79",
                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                "text": "Les protéines sont formées par un ou plusieurs polypeptides."
                            },
                            {
                                "example_id": "44d4df8a-75d0-4e6d-9430-ce05717897a2",
                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                "text": "Les FGF constituent une famille de sept polypeptides (FGF1 à FGF7) mitogènes pour les fibroblastes, sauf FGF 7."
                            },
                            {
                                "example_id": "4174642e-fd08-40f2-930d-a7eb1b7af167",
                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                "text": "Certains antibiotiques sont des polypeptides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
