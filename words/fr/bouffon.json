                },
                {
                    "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                    "sense_definition": "Personne qui cherche constamment à amuser les autres par des plaisanteries et des pitreries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "farceur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore faire le <w>bouffon</w> en classe pour attirer l'attention de ses camarades.",
                            "target_lang_translations": {
                                "en": "He loves <w>clowning around</w> in class to attract the attention of his classmates.",
                                "ru": "Он обожает <w>паясничать</w> на уроках, чтобы привлекать внимание одноклассников.",
                                "de": "Er liebt es, in der Klasse den <w>Clown</w> zu spielen, um die Aufmerksamkeit seiner Mitschüler auf sich zu ziehen.",
                                "es": "Le encanta hacer el <w>payaso</w> en clase para llamar la atención de sus compañeros.",
                                "zh": "他很爱在课堂上扮<w>小丑</w>，以引起同学们的注意。"
                            }
                        },
                        {
                            "text": "Ce garçon est un vrai <w>bouffon</w> qui trouve toujours une blague à raconter.",
                            "target_lang_translations": {
                                "en": "That boy is a real <w>clown</w> who always comes up with a joke to tell.",
                                "ru": "Этот мальчик — настоящий <w>балагур</w>: у него всегда найдётся шутка для рассказа.",
                                "de": "Dieser Junge ist ein echter <w>Spaßvogel</w>, der immer einen Witz auf Lager hat.",
                                "es": "Este chico es un verdadero <w>bromista</w> que siempre tiene un chiste que contar.",
                                "zh": "这个男孩真是个<w>开心果</w>，总能想出笑话来讲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clown",
                        "farceur",
                        "pitre"
                    ],
                    "common_phrases": [
                        "faire le bouffon"
