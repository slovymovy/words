                "senses": [
                    {
                        "sense_id": "74dbd83d-1d60-36e6-a299-4fb2cae9d561",
                        "entry_id": "ff4c15b9-7003-3e9b-b355-6bc0a5ffb0a8",
                        "glosses": [
                            "Rock mit innen eingearbeiteten Shorts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c763e086-0bc2-4013-8607-fcd8dbf2743a",
                                "sense_id": "74dbd83d-1d60-36e6-a299-4fb2cae9d561",
                                "text": "„Ich fühlte die modrigen Säfte meines Seelenbruders an mir hinablaufen und meinen Skort besudeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eefc1c30-5505-461f-a5af-c96edf71783b",
                        "source_entry_id": "ff4c15b9-7003-3e9b-b355-6bc0a5ffb0a8",
                        "source_sense_id": "74dbd83d-1d60-36e6-a299-4fb2cae9d561",
                        "source_sense_description": "Rock mit innen eingearbeiteten Shorts",
                        "target_lang_word": "skort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                        "entry_id": "706cbd6b-f7dd-32e2-91ac-a514606fc0d9",
                                        "glosses": [
                                            "A pair of shorts designed to look like a skirt via the addition of a panel of fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fde404b-3303-49c7-b832-ebec31bfa304",
                                                "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                                "text": "Fashion has given the English language a new word to contend with: “skort,” a hybrid garment consisting of a mid-thigh-length pleated skirt with a matching pair of short bloomers attached underneath."
                                            },
                                            {
                                                "example_id": "8873c2af-f9c0-47aa-a314-c1df16994c28",
                                                "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                                "text": "All the major athletic apparel companies now offer skirts, or skorts. (What's the difference between a skort and a running skirt? Nothing, really, but I like the latter term better.)"
                                            },
                                            {
                                                "example_id": "c56ea566-80f8-40ba-a234-6b03768b1754",
                                                "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                                "text": "Trina: I'm holding a pair of skorts.\nJen: (gasp) Trina, listen very carefully to me. Put the skorts down and back away slowly. BACK AWAY! Look for the nearest exit!"
                                            },
                                            {
                                                "example_id": "7441bc2b-6c41-488e-9f9d-9244b5db7fc7",
                                                "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                                "text": "Often erroneously confused with culottes (see also: culottes), the skort appears to be a skirt in the front (due to a clever little fabric flap) but reveals its essential shorts-ness from behind. The skort is typically short (often very short) and is designed for sporty activities such as tennis and hiking."
                                            },
                                            {
                                                "example_id": "7eee8369-2051-4b22-a690-ceee79285985",
                                                "sense_id": "8f1a5860-dac1-3898-860d-677540642356",
                                                "text": "Skorts—a hybrid garment that traditionally blends culotte-style shorts with a wrapover fabric at the front that resembles a skirt—have soared in popularity lately thanks to the rise of “tenniscore” fashion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
