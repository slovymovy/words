                ],
                "senses": [
                    {
                        "sense_id": "5feaf776-85e7-35f0-b2a5-3c75ba480d6e",
                        "entry_id": "4175e61c-3b1f-3563-85c6-ab6c62a6c5e6",
                        "glosses": [
                            "Exclusivité ou primeur d'une information."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "bd69b0b7-de04-42d5-87c0-98da15ec08ef",
                                "sense_id": "5feaf776-85e7-35f0-b2a5-3c75ba480d6e",
                                "text": "— Écoute, Vincent ! En toute amitié, je te conseille de garder pour toi ce scoop ! Je n’aimerais pas qu’on dise que tu yoyotes !\n— Je me fiche pas mal du qu’en-dira-t-on, Hanna !"
                            },
                            {
                                "example_id": "6639db48-81cc-4f8f-bc61-cae9bc6823d3",
                                "sense_id": "5feaf776-85e7-35f0-b2a5-3c75ba480d6e",
                                "text": "Dans Cartel, Pablo Mora, aussi passionné par son métier que mal payé, voit sa ville, Ciudad Juárez, à la frontière du Texas, lentement transformée en abattoir. « Le scoop, déplore-t-il, ce serait l’absence de cadavre dans les rues. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c79e758-17be-429f-a44a-1b832a62812e",
                        "source_entry_id": "4175e61c-3b1f-3563-85c6-ab6c62a6c5e6",
                        "source_sense_id": "5feaf776-85e7-35f0-b2a5-3c75ba480d6e",
                        "target_lang_word": "scoop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "Any cup-shaped or bowl-shaped tool, usually with a handle, used to lift and move loose or soft solid material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36da75c5-ebb3-4fc5-8804-f0e6b2fea3de",
                                                "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                                "text": "She kept a scoop in the dog food."
                                            },
                                            {
                                                "example_id": "5240b7c8-2f9e-459b-a9bf-e6639996b2eb",
                                                "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                                "text": "an ice-cream scoop"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The amount or volume of loose or solid material held by a particular scoop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377e5d4c-fd05-4619-942d-cbab2bed3caf",
                                                "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                                "text": "Use one scoop of coffee for each pot."
                                            },
                                            {
                                                "example_id": "181bcc33-497c-4e15-ab35-075e81d9ab62",
                                                "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                                "text": "I'll have one scoop of chocolate ice-cream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e1f0e1-9331-3ec3-a723-77acb66692ff",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The act of scooping, or taking with a scoop or ladle; a motion with a scoop, as in dipping or shovelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393ce3a0-9982-4201-a86f-a52cb85d755a",
                                                "sense_id": "b8e1f0e1-9331-3ec3-a723-77acb66692ff",
                                                "text": "with a quick scoop, she fished the frog out of the pond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A story or fact; especially, news learned and reported before anyone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f4d73f-da75-4962-a663-f8fd7833ae5c",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "He listened carefully, in hopes of getting the scoop on the debate."
                                            },
                                            {
                                                "example_id": "cc220867-ce68-485a-a258-efb0b088e4e5",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "\"We may get a scoop, if we are lucky. You'll be there in any case, so you'll just give us a pretty full report.\""
                                            },
                                            {
                                                "example_id": "bb55e640-8097-453a-b279-888fa79cee15",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "The problem is that the public, disobediently giggling over their social media accounts, reckon they’ve already got the scoop without needing to see the film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a80a0cbc-4c41-3e46-812a-77e6d96a7cb0",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "An opening in a hood/bonnet or other body panel to admit air, usually for cooling the engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3389b83-b84d-3eb1-b73c-789bef1773c9",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The digging attachment on a front-end loader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17e42998-8466-3a3b-aee4-44dd08bf1d41",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A place hollowed out; a basinlike cavity; a hollow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507c20a3-49e1-4238-a692-1521b2a9e08e",
                                                "sense_id": "17e42998-8466-3a3b-aee4-44dd08bf1d41",
                                                "text": "Some had lain in the scoop of the rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b6a441f-5659-3fd5-92c4-94aff6c25418",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A spoon-shaped surgical instrument, used in extracting certain substances or foreign bodies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9af3a4ba-7622-35c7-babb-1a61456f0390",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A special spinal board used by emergency medical service staff that divides laterally to scoop up patients."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "febe7018-3f4d-3c55-b9d0-0f9bf6eb20ea",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A sweep; a stroke; a swoop."
                                        ],
                                        "tags": [],
