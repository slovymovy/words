                ],
                "senses": [
                    {
                        "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                        "entry_id": "4c2af601-00c6-325d-940b-ec5bcab05dcc",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31b2cd2-4d16-4cf8-987a-a2fd4b779413",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Frau Malik ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c5c4b678-3515-4995-b9bf-3954a6fbebd9",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Herr Malik wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ab104a1-1927-4547-b94b-dfc1521c20db",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Die Maliks fahren heute nach Essen."
                            },
                            {
                                "example_id": "6b03ec83-4249-4061-bfff-dc0727b70372",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Der Malik trägt nie die Pullover, die die Malik ihm strickt."
                            },
                            {
                                "example_id": "07564335-b62d-4c71-8ab0-44fa5024c2bc",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Malik kommt, geht der Herr Malik.“"
                            },
                            {
                                "example_id": "b98288b8-cc83-4216-8860-0ec166fe1b5c",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Malik kommt und geht."
                            },
                            {
                                "example_id": "8f0ad964-2ef4-47ac-ae51-f61dd07c4576",
                                "sense_id": "63fca2fe-d230-3c8e-bc43-cbe9c1916773",
                                "text": "Maliks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
