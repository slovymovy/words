                        "glosses": [
                            "Technologie axée sur l’éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e532729-cb22-439d-bfa1-f37714f5c2d4",
                                "sense_id": "3fdc6fe9-8897-3b4c-a3d7-193b7122d35b",
                                "text": "Depuis la pandémie de Covid-19, l’edtech est devenue un secteur intéressant pour les grandes firmes mondiales."
                            }
                        ]
                    },
                    {
                        "sense_id": "35fa49c3-8bde-3b85-aba4-a2ee70a28224",
                        "entry_id": "4eb403eb-e82a-3b64-ac23-ae9dfd719b21",
                        "glosses": [
                            "Entreprise qui fournit des technologies au monde de l’éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb947e6-a692-46d2-9ff2-17ac0654011c",
                                "sense_id": "35fa49c3-8bde-3b85-aba4-a2ee70a28224",
                                "text": "Après la levée de 600 000 $ en avril pour soutenir sa croissance, l’edtech malgache Sayna s’associe à Orange, un de ses investisseurs, dans le but d’atteindre son objectif phare : formé 8 000 développeurs d’ici 2024."
                            },
                            {
                                "example_id": "c6b69f5b-0262-48cb-b3b2-6ce8c9272a2a",
                                "sense_id": "35fa49c3-8bde-3b85-aba4-a2ee70a28224",
                                "text": "Les edtechs qui proposent des solutions à destination du milieu scolaire (le segment K-12, dans le jargon) n’ont pas d’autre choix que de travailler avec les collectivités locales et le ministère de l’Education nationale."
                            }
                        ]
                    }
