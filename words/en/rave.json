                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о сильном движении стихии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea051524-c4e0-37c3-b454-b5d0a624ca9c",
                    "sense_definition": "To wander or roam about aimlessly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost travelers continued to <w>rave</w> through the woods without a map.",
                            "target_lang_translations": {
                                "ru": "Заблудившиеся путешественники продолжали <w>блуждать</w> по лесу без карты."
                            }
                        },
                        {
                            "text": "He would <w>rave</w> across the countryside for hours in deep thought.",
                            "target_lang_translations": {
                                "ru": "Он часами <w>бродил</w> по сельской местности, погруженный в глубокие раздумья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесцельно бродить или скитаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "бродить без цели"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "ходить без определенного направления"
                            }
                        ]
