                "senses": [
                    {
                        "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                        "entry_id": "4029d31e-2b0c-3332-83de-3de3bf5145b3",
                        "glosses": [
                            "Woche, in der ein Gebiet militärisch besetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a91bf7-38ba-4e74-ae0c-6413067593df",
                                "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                                "text": "„Der vor dem Krieg begonnene Bau wurde in den ersten Besatzungswochen beendet; […].“"
                            },
                            {
                                "example_id": "0f1b5e51-7503-4fc8-8105-898ad9abd0aa",
                                "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                                "text": "„Während der ersten paar Besatzungswochen ging der Alltag normal weiter.“"
                            },
                            {
                                "example_id": "d181eae4-16e6-44fa-9abb-024a6aef5553",
                                "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                                "text": "„Aus ungeklärten Ursachen brannten in der ersten Besatzungswoche zwei Häuser im Dorf ab.“"
                            },
                            {
                                "example_id": "de1fa731-ca60-4965-9cc3-ddd54a2c278c",
                                "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                                "text": "„300 000 Menschen wurden ermordet und während der ersten Besatzungswochen 20 000 Frauen vergewaltigt und dann getötet.“"
                            },
                            {
                                "example_id": "19cf3a57-a388-4af3-a0db-dafd67ac6eb9",
                                "sense_id": "68f0de8c-b6ad-303c-9305-3a21c1bf6d29",
                                "text": "„Hunderte jüdische Männer wurden in den ersten Besatzungswochen ermordet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
