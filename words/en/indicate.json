{
    "word_family": [
        "indication",
        "indicator",
        "indicative",
        "indicant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0104d562-bed1-36fd-9f49-8fc88e9f7d68",
                    "sense_definition": "To show, point out, or make something known.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard blew his whistle to <w>indicate</w> imminent departure.",
                            "target_lang_translations": {
                                "ru": "Проводник свистнул, чтобы <w>указать</w> на скорое отправление.",
                                "tr": "Muhafız, yaklaşan kalkışı <w>belirtmek</w> için düdüğünü çaldı.",
                                "zh": "警卫吹响哨子以<w>示意</w>即将出发。"
                            }
                        },
                        {
                            "text": "Recent studies <w>indicate</w> a clear link between diet and health.",
                            "target_lang_translations": {
                                "ru": "Недавние исследования <w>показывают</w> четкую связь между диетой и здоровьем.",
                                "tr": "Son araştırmalar, beslenme ile sağlık arasında net bir bağlantı olduğunu <w>gösteriyor</w>.",
                                "zh": "最近的研究<w>显示</w>饮食与健康之间存在明确的联系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "betoken",
                        "index",
                        "speak of",
                        "bespeak"
                    ],
                    "common_phrases": [
                        "indicate a preference",
                        "indicate a change",
                        "clearly indicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать, указывать или сообщать о чем-либо.",
                        "tr": "Bir şeyi göstermek, işaret etmek veya belirtmek.",
                        "zh": "展示、指出或使某事为人所知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "сообщать или делать известным"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "служить признаком чего-либо"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "демонстрировать данные или факты"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "veri veya olguları açığa vurmak"
                            },
                            {
                                "target_lang_word": "belirtmek",
                                "target_lang_sense_clarification": "açıklamak veya belli etmek"
                            },
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "bir şeye dikkat çekmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指出",
                                "target_lang_sense_clarification": "明确地指明某事"
                            },
                            {
                                "target_lang_word": "显示",
                                "target_lang_sense_clarification": "通过数据或事实表现出来"
                            },
                            {
                                "target_lang_word": "表明",
                                "target_lang_sense_clarification": "通过迹象或证据说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "953a57d6-77c7-3113-a5c0-eeb7499a0edc",
                    "sense_definition": "To use a signal on a vehicle to show the intention to turn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "driving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>indicate</w> left before you turn into the driveway.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>показать левый поворот</w> перед тем, как свернуть на подъездную дорожку.",
                                "tr": "Garaj yoluna dönmeden önce sola <w>sinyal vermelisiniz</w>.",
                                "zh": "在转入车道前，你必须<w>打转向灯</w>示意左转。"
                            }
                        },
                        {
                            "text": "The driver failed to <w>indicate</w> before changing lanes on the highway.",
                            "target_lang_translations": {
                                "ru": "Водитель не <w>включил поворотник</w> перед сменой полосы на шоссе.",
                                "tr": "Sürücü, otoyolda şerit değiştirmeden önce <w>sinyal vermedi</w>.",
                                "zh": "司机在高速公路上变道前没有<w>打转向灯</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "indicate left",
                        "indicate right",
                        "fail to indicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать световой сигнал на транспортном средстве, чтобы показать намерение повернуть.",
                        "tr": "Araçla dönme niyetini göstermek için sinyal kullanmak.",
                        "zh": "驾驶车辆时使用信号灯以表示转弯意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показывать поворот",
                                "target_lang_sense_clarification": "использовать поворотник"
                            },
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "подавать сигнал поворотником"
                            },
                            {
                                "target_lang_word": "включать поворотник",
                                "target_lang_sense_clarification": "сигнализировать о маневре"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sinyal vermek",
                                "target_lang_sense_clarification": "araçla dönüş yönünü bildirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打转向灯",
                                "target_lang_sense_clarification": "操作车辆的转向信号装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b31ef3c-5bae-361a-8a49-9e79b0083323",
                    "sense_definition": "To suggest or manifest a condition through symptoms or signs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A high fever may <w>indicate</w> a serious infection.",
                            "target_lang_translations": {
                                "ru": "Высокая температура может <w>указывать</w> на серьезную инфекцию.",
                                "tr": "Yüksek ateş, ciddi bir enfeksiyona <w>işaret edebilir</w>.",
                                "zh": "高烧可能<w>预示</w>着严重的感染。"
                            }
                        },
                        {
                            "text": "Great prostration of strength <w>indicates</w> the use of stimulants.",
                            "target_lang_translations": {
                                "ru": "Сильный упадок сил <w>говорит о</w> необходимости применения стимуляторов.",
                                "tr": "Aşırı güç kaybı, uyarıcı kullanımını <w>gösterir</w>.",
                                "zh": "极度的体力衰竭<w>表明</w>需要使用兴奋剂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "symptoms indicate",
                        "tests indicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предполагать или проявлять состояние через симптомы или признаки.",
                        "tr": "Belirti veya işaretler aracılığıyla bir durumu düşündürmek veya ortaya koymak.",
                        "zh": "通过症状或迹象暗示或表现出某种状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "быть признаком состояния"
                            },
                            {
                                "target_lang_word": "говорить о",
                                "target_lang_sense_clarification": "свидетельствовать о наличии чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "bir duruma işaret etmek"
                            },
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "bir durumun göstergesi olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预示",
                                "target_lang_sense_clarification": "作为某种情况的征兆"
                            },
                            {
                                "target_lang_word": "显示",
                                "target_lang_sense_clarification": "作为某种病症或状态的体现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78105a9f-4aeb-3d74-bb99-1e27bfcdfab8",
                    "sense_definition": "To suggest a particular treatment or remedy as necessary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Surgery is not usually <w>indicated</w> for this type of minor injury.",
                            "target_lang_translations": {
                                "ru": "Хирургическое вмешательство обычно не <w>показано</w> при таком типе легкой травмы.",
                                "tr": "Bu tür hafif yaralanmalar için genellikle cerrahi müdahale <w>gerekli görülmez</w>.",
                                "zh": "对于这种轻微伤，通常不<w>建议</w>进行手术。"
                            }
                        },
                        {
                            "text": "The doctor said that bed rest was medically <w>indicated</w> for her recovery.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что постельный режим был медицински <w>рекомендован</w> для её выздоровления.",
                                "tr": "Doktor, iyileşmesi için yatak istirahatinin tıbben <w>gerekli olduğunu</w> söyledi.",
                                "zh": "医生说，为了她的康复，卧床休息在医学上是<w>适宜</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medically indicated",
                        "clinically indicated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать определенное лечение или средство как необходимое.",
                        "tr": "Belirli bir tedaviyi veya çareyi gerekli olarak önermek.",
                        "zh": "建议某种治疗或补救措施是必要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть показанным",
                                "target_lang_sense_clarification": "о медицинских процедурах"
                            },
                            {
                                "target_lang_word": "рекомендоваться",
                                "target_lang_sense_clarification": "в качестве необходимого лечения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerekli kılmak",
                                "target_lang_sense_clarification": "tıbbi açıdan uygun veya gerekli görmek"
                            },
                            {
                                "target_lang_word": "gösterilmek",
                                "target_lang_sense_clarification": "tıbbi olarak tavsiye edilmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适宜",
                                "target_lang_sense_clarification": "医学上认为适合采用某种疗法"
                            },
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "作为必要的医疗手段提出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7725e69b-5551-3da3-be0d-17596143ead0",
                    "sense_definition": "To measure the power or performance of an engine using a specific instrument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer needed to <w>indicate</w> the engine to check its efficiency.",
                            "target_lang_translations": {
                                "ru": "Инженеру нужно было <w>проиндицировать</w> двигатель, чтобы проверить его эффективность.",
                                "tr": "Mühendisin verimliliğini kontrol etmek için motoru <w>göstergeyle ölçmesi</w> gerekiyordu.",
                                "zh": "工程师需要对发动机进行<w>测量</w>以检查其效率。"
                            }
                        },
                        {
                            "text": "It is easy to <w>indicate</w> an engine at high speeds with the right tools.",
                            "target_lang_translations": {
                                "ru": "С помощью подходящих инструментов легко <w>снимать показания</w> двигателя на высоких скоростях.",
                                "tr": "Doğru araçlarla yüksek hızlarda bir motoru <w>ölçmek</w> kolaydır.",
                                "zh": "使用合适的工具，很容易在高速下对发动机进行<w>测量</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "indicate an engine"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерять мощность или производительность двигателя с помощью специального прибора (индикатора).",
                        "tr": "Özel bir cihaz kullanarak bir motorun gücünü veya performansını ölçmek.",
                        "zh": "使用特定仪器测量发动机的功率或性能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индицировать",
                                "target_lang_sense_clarification": "снимать индикаторную диаграмму двигателя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstergeyle ölçmek",
                                "target_lang_sense_clarification": "motor performans verilerini kaydetmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "测量",
                                "target_lang_sense_clarification": "通过仪器获取发动机性能数据"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}