                ],
                "senses": [
                    {
                        "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                        "entry_id": "f160030f-cadf-3cdc-be47-5b8eb9a661d8",
                        "glosses": [
                            "Boden aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11180a14-c6c5-46dc-99ea-2bd1104ae90f",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„Das Mädchen blickt auf und muss mich daher sehen, und dann schwebt sie in ihren schwarzen Filzschuhen lautlos über den Marmorboden auf mich zu.“"
                            },
                            {
                                "example_id": "8f9393d5-4e6b-4eb4-856a-4d8458721fa4",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„Die Stimme des Bisons dröhnte und hallte, als wäre sein Haus riesig groß, und die Äffin stellte ihn sich vor, wie er in ein vergoldetes Telefon sprach und in einer großen Halle mit Marmorboden und Deckenfresken saß.“"
                            },
                            {
                                "example_id": "175a1748-812f-48c2-a2c4-d992f9d1eb37",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„Auf meinen nackten Streifzügen verweilte ich zwischen den nach Leder duftenden Regalen der Bibliothek, wanderte barfuß über den kalten Marmorboden und sah mir die Bücher an.“"
                            },
                            {
                                "example_id": "decce8ef-694f-42c0-9847-116db2726255",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„Es gab keine Bar, kein Bankett. Nur den schimmernden Marmorboden.“"
                            },
                            {
                                "example_id": "bd4152d1-639a-458a-b4aa-fc302405b2ea",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„El-Khayab lauschte, während die drei Männer über den Marmorboden gingen und sich vor seinem Schreibtisch auf die Stühle setzten.“"
                            },
                            {
                                "example_id": "737475f8-30a4-4785-ade8-92ecfbf2f7e4",
                                "sense_id": "33f425c9-6846-3384-8019-2bd45d5910fa",
                                "text": "„Sie liebte es, ihre Absätze auf dem Marmorboden des Ausstellungsraumes klappern zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
