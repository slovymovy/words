                "senses": [
                    {
                        "sense_id": "b210c0db-7ff4-3af9-a993-e287ff88115a",
                        "entry_id": "33a5ad2f-7694-388d-a3ab-79136cd3ba71",
                        "glosses": [
                            "die lotrechte Entfernung eines Ortes von der der Erdoberfläche"
                        ],
                        "tags": [
                            "bergmännisch"
                        ],
                        "examples": [
                            {
                                "example_id": "b9df6675-5ae4-482f-903b-9bd3ee2c3144",
                                "sense_id": "b210c0db-7ff4-3af9-a993-e287ff88115a",
                                "text": "Das zweite Lausitzer Braunkohlenflöz beginnt hier bei einer Teufe von 80 Metern."
                            },
                            {
                                "example_id": "f4cd018f-f610-45cb-8ac1-b80ca6f0b374",
                                "sense_id": "b210c0db-7ff4-3af9-a993-e287ff88115a",
                                "text": "Der Schacht wird bis zu einer Teufe von 1200 Metern niedergebracht."
                            },
                            {
                                "example_id": "cf22ee4e-50e7-454e-b9ab-da2983823a95",
                                "sense_id": "b210c0db-7ff4-3af9-a993-e287ff88115a",
                                "text": "Ein Schacht von 200 Metern Teufe."
                            },
                            {
                                "example_id": "1f0ee9d4-c3aa-4785-9d00-6e8cb83e407e",
                                "sense_id": "b210c0db-7ff4-3af9-a993-e287ff88115a",
                                "text": "„Die Schurfberechtigung gilt für einen als Freischurf bezeichneten Kreis mit einem Radius von 425 Metern, der bis in die ewige Teufe gilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
