                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afa4926-998d-4cf4-9c1c-3cf98ad7026c",
                                "sense_id": "d633134d-cdda-320d-b943-c884e6bfbcdc",
                                "text": "„Ein hübsch am See gelegenes Städtchen, das sich, ruhig im Zonenrandgebiet gelegen, idyllisch gab.“"
                            },
                            {
                                "example_id": "d95de671-9673-4efa-961a-f186410609ca",
                                "sense_id": "d633134d-cdda-320d-b943-c884e6bfbcdc",
                                "text": "„Unsere erste Station ist Duderstadt im Untereichsfeld, nur drei Kilometer von der alten DDR-Staatsgrenze entfernt, ehemals sogenanntes Zonenrandgebiet.“"
                            }
                        ],
