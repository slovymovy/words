                "senses": [
                    {
                        "sense_id": "918aec5a-58b5-3310-93bd-99ed0cd950c6",
                        "entry_id": "a645b782-79e4-38a6-b119-6e0102a5ffe3",
                        "glosses": [
                            "морск., устар. парусная рыбацкая лодка Черного и Азовского морей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92d5bdf-63ec-4195-aa0b-f2c079c0f486",
                                "sense_id": "918aec5a-58b5-3310-93bd-99ed0cd950c6",
                                "text": "Медленно распуская парус, дубок, с выцветшими синими и красными полосами, тихо шевелился, отражаясь в воде вплоть до кончика своей мачты, и вместе с ним пошевеливалась маленькая черная, привязанная к нему лодочка."
                            },
                            {
                                "example_id": "00a712ce-d7e4-4a81-8ef4-2220a52cc007",
                                "sense_id": "918aec5a-58b5-3310-93bd-99ed0cd950c6",
                                "text": "На темном берегу, над зеленой от лунного света водой, над баржами и дубками стояла древняя турецкая крепость."
                            }
                        ]
                    }
