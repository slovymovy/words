                        "examples": [
                            {
                                "example_id": "16bc610c-4774-4af7-8ca5-5fa568692832",
                                "sense_id": "331046ca-0190-3677-98d6-38476182048e",
                                "text": "Ik zal kijken of deze wasmachine voorradig is, want dan ik ze vandaag nog bij u thuis brengen."
