                    "sense_definition": "Naar de plaats of toestand waar men vandaan kwam.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga vanavond laat <w>terug</w> naar huis.",
                            "target_lang_translations": {
                                "en": "I am going <w>back</w> home late tonight.",
                                "ru": "Я поеду <w>обратно</w> домой сегодня поздно вечером.",
                                "pl": "Idę dziś późnym wieczorem <w>z powrotem</w> do domu.",
                                "de": "Ich gehe heute Abend spät <w>zurück</w> nach Hause.",
                                "fr": "Je rentre <w>chez moi</w> tard ce soir.",
                                "it": "Stasera tardi vado <w>indietro</w> a casa.",
                                "cs": "Dnes večer pozdě se vracím <w>zpátky</w> domů.",
                                "tr": "Bu gece geç saatte eve <w>geri</w> döneceğim.",
                                "es": "Voy <w>de vuelta</w> a casa tarde esta noche."
                            }
                        },
                        {
                            "text": "Zet de melk alsjeblieft <w>terug</w> in de koelkast.",
                            "target_lang_translations": {
                                "en": "Please put the milk <w>back</w> in the fridge.",
                                "ru": "Пожалуйста, поставь молоко <w>обратно</w> в холодильник.",
                                "pl": "Proszę, odstaw mleko <w>z powrotem</w> do lodówki.",
                                "de": "Stell die Milch bitte <w>zurück</w> in den Kühlschrank.",
                                "fr": "S'il te plaît, remets le lait <w>à sa place</w> dans le réfrigérateur.",
                                "it": "Per favore, rimetti il latte <w>a posto</w> nel frigorifero.",
                                "cs": "Dej prosím to mléko <w>zpátky</w> do lednice.",
                                "tr": "Lütfen sütü buzdolabına <w>geri</w> koy.",
                                "es": "Por favor, <w>vuelve a poner</w> la leche en la nevera."
                            }
                        }
