                ],
                "senses": [
                    {
                        "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                        "entry_id": "d5267864-6885-3c23-8366-d956cbb5194b",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b19fd20e-9d28-444f-a57a-e526b0f0ea6e",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Frau Langnese ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d7fc2d3-0489-4396-915d-ad919426e458",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Herr Langnese wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b20d0793-d9f5-48ed-80b1-1eac60c7d004",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Die Langneses fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "99ad6c4f-4098-481c-893b-e2c3dfbfd58b",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Der Langnese trägt nie die Schals, die die Langnese ihm strickt."
                            },
                            {
                                "example_id": "a32fcc15-e38b-4fb9-aaee-015e4e3eaa15",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Langnese kommt, geht der Herr Langnese.“"
                            },
                            {
                                "example_id": "af5907a7-2d21-4bae-b266-77a153897f07",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Langnese kommt und geht."
                            },
                            {
                                "example_id": "35201b13-6595-4d1e-abd8-1d5c77699ccf",
                                "sense_id": "7e2b9528-df7b-31a6-81bc-fb6700a1fa41",
                                "text": "Langneses kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
