                ],
                "senses": [
                    {
                        "sense_id": "9c91aab4-aa62-37be-a960-ef37ffffe5a2",
                        "entry_id": "36ddf597-6308-3bec-92f0-df88b5fb4d7a",
                        "glosses": [
                            "cecha człowieka, który stosuje restrykcyjne zasady, jest wymagający i stanowczy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911779c7-a181-4c50-be3b-bad6a758a199",
                                "sense_id": "9c91aab4-aa62-37be-a960-ef37ffffe5a2",
                                "text": "Była znana z surowości wobec swoich uczniów."
                            },
                            {
                                "example_id": "a610d0a7-a00b-41a9-b6b3-10dddba57692",
                                "sense_id": "9c91aab4-aa62-37be-a960-ef37ffffe5a2",
                                "text": "Surowością swojego charakteru budził respekt, a czasem wręcz strach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ac297058-80c3-307f-b6ef-a3c4e960b520",
                        "entry_id": "36ddf597-6308-3bec-92f0-df88b5fb4d7a",
                        "glosses": [
                            "cecha środowiska lub warunków życia, które są nieprzyjazne, trudne i niekorzystne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b419f8bb-cc4d-40a4-9ecf-53edcc3e5385",
                                "sense_id": "ac297058-80c3-307f-b6ef-a3c4e960b520",
                                "text": "Było coś pięknego w surowości tego pustynnego krajobrazu."
                            },
                            {
                                "example_id": "0ef42912-15a2-425e-bfc1-412b201a1bfe",
                                "sense_id": "ac297058-80c3-307f-b6ef-a3c4e960b520",
                                "text": "Podczas ekspedycji naukowcy zmagali się z surowością arktycznych warunków."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5aa27c20-fcaa-368e-a167-32f2f83bd2bb",
                        "entry_id": "36ddf597-6308-3bec-92f0-df88b5fb4d7a",
                        "glosses": [
                            "cecha estetyki lub stylu, który jest minimalistyczny, pozbawiony wygód i ozdób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc43fa9d-ac5f-4b00-b53a-8414be24f89e",
                                "sense_id": "5aa27c20-fcaa-368e-a167-32f2f83bd2bb",
                                "text": "Surowość minimalistycznego wnętrza sprawiała, że było ono bardzo nowoczesne."
                            },
                            {
                                "example_id": "9dcd07a7-bdb9-414a-bdb0-1e12dace1846",
                                "sense_id": "5aa27c20-fcaa-368e-a167-32f2f83bd2bb",
                                "text": "Brutalizm to styl architektoniczny charakteryzujący się surowością formy i użyciem betonu jako głównego materiału konstrukcyjnego"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "b38db869-bf3d-3b8b-a234-ef8bb6a1b122",
                        "entry_id": "36ddf597-6308-3bec-92f0-df88b5fb4d7a",
                        "glosses": [
                            "cecha przepisów prawnych, które są rygorystyczne i przewidują dotkliwe kary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d9e2fc0-5177-4115-837b-64b79bf164c6",
                                "sense_id": "b38db869-bf3d-3b8b-a234-ef8bb6a1b122",
                                "text": "Byłem zaskoczony surowością mandatu."
                            },
                            {
                                "example_id": "e5f96a32-938f-4db8-9b16-56783a5d612e",
                                "sense_id": "b38db869-bf3d-3b8b-a234-ef8bb6a1b122",
                                "text": "Surowość przepisów ruchu drogowego ma na celu zwiększenie bezpieczeństwa."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "19fe5627-6096-3588-aa9e-5f6b6e6181f2",
                        "entry_id": "36ddf597-6308-3bec-92f0-df88b5fb4d7a",
                        "glosses": [
                            "cecha potrawy lub jej składników, które nie zostały ugotowane, usmażone czy upieczone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97631d7-7824-43cc-ad14-2593bec6cd2c",
                                "sense_id": "19fe5627-6096-3588-aa9e-5f6b6e6181f2",
                                "text": "Weganie cieszyli się surowością buraków w tej sałatce."
                            },
                            {
                                "example_id": "ee932886-728b-406d-ba44-160c433f0120",
                                "sense_id": "19fe5627-6096-3588-aa9e-5f6b6e6181f2",
                                "text": "Surowość ryb w sushi była zachwycająca."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
