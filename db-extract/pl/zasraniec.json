                "senses": [
                    {
                        "sense_id": "444afc29-7b43-3d30-bf61-8748c1d7ef56",
                        "entry_id": "15b54c1e-c67b-3a1c-b504-19b79dedebe0",
                        "glosses": [
                            "o chłopcu lub o młodym mężczyźnie budzącym w kimś silną niechęć"
                        ],
                        "tags": [
                            "scornfully",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "49e1e827-3c50-4429-99a6-7456470abcad",
                                "sense_id": "444afc29-7b43-3d30-bf61-8748c1d7ef56",
                                "text": "Zasraniec, czyli gówniarz, to według mojej prywatnej definicji człowiek, który domaga się przywilejów wieku dorosłego lub piastowanej funkcji, lecz nie chce się podporządkować obowiązkom z tego wynikającym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4925530c-80d7-36c2-918a-874ff4b6ec2c",
                        "entry_id": "15b54c1e-c67b-3a1c-b504-19b79dedebe0",
                        "glosses": [
                            "o mężczyźnie lub do mężczyzny bez względu na wiek"
                        ],
                        "tags": [
                            "scornfully",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "505e7ee5-8426-488a-9d13-d56465adf9e6",
                                "sense_id": "4925530c-80d7-36c2-918a-874ff4b6ec2c",
                                "text": "Nie tłumacz się, zasrańcu!"
                            }
                        ],
