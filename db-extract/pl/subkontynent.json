                                    {
                                        "sense_id": "b7564956-9c09-34c8-9297-656d9888e869",
                                        "entry_id": "c671bf77-8d7e-3c5f-bb21-c0852b807883",
                                        "glosses": [
                                            "A large landmass which is either smaller than a continent (such as Greenland), or part of an even larger continent (such as the Indian subcontinent)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subcontinent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                        "entry_id": "88c857e7-d3e1-3eb6-b7dc-ea685c2c4eb9",
                                        "glosses": [
                                            "The Indian subcontinent, South Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e75abd-2604-46c3-aa37-427a8710b0ce",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "The Turks had acquired the culture of power of Persia and implemented its political and administrative traditions in the subcontinent."
                                            },
                                            {
                                                "example_id": "f98c024f-9818-4914-bcec-2667b1ed9313",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "The terrorist attack on the Sri Lanka team in Lahore could lead to Dubai and Abu Dhabi becoming the \"home\" venues for the subcontinent’s cricket-playing countries for the forseeable future, according to leading officials in England and worldwide."
                                            },
                                            {
                                                "example_id": "18438962-aeb6-42d7-8842-cc3ca35b4556",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "Highlights include a debate on east London architecture, quirky performances staged at the Barbican, music and dance from the subcontinent, and the East Commonwealth Games in Spitalfields Market, with events ranging from bicycle polo to kabaddi (a cross between tag and wrestling)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cf6e60f-6e58-4f4b-9103-474434395a36",
                        "source_entry_id": "ca08adf2-af6d-34c3-8c9a-c7c2c383b2a3",
                        "source_sense_id": "b7cd0c33-5394-36e7-a302-11b9d0b9ddbe",
                        "target_lang_word": "sous-continent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-continent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                                        "entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                                        "glosses": [
                                            "Division d’un continent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec24605-16fb-40e9-9525-c8ee4ee48ccf",
                                                "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                                                "text": "Que d'épreuves a dû surmonter le régime, après tant d'années de guerres civiles ou étrangères et de fléaux naturels, pour donner à ce sous-continent les moyens de nourrir une population foisonnante, de la vêtir, de la loger, de l'instruire – de la contenir !"
                                            },
                                            {
                                                "example_id": "90ce05fe-372a-476b-af00-d66f5487fb5f",
                                                "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                                                "text": "Il a exploré le sous-continent et rencontré son principal souverain : le Grand Moghol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9940ef7-0cbc-4ea7-87ba-0c0945c112f4",
                        "source_entry_id": "ca08adf2-af6d-34c3-8c9a-c7c2c383b2a3",
