                "senses": [
                    {
                        "sense_id": "39e3a2a7-561f-3979-8322-d1a9a0099c6d",
                        "entry_id": "630751a8-d0bf-3da2-b5c0-a17e69136c35",
                        "glosses": [
                            "Qui a une apparence de vérité ; qui est accepté ou admis jusqu’à preuve du contraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e021a4f-cf91-458f-9d57-a5fd32136679",
                                "sense_id": "39e3a2a7-561f-3979-8322-d1a9a0099c6d",
                                "text": "Cette étape est plausible , car NO est une espèce à nombre impair d'électrons, et deux molécules peuvent former une liaison covalente quand elle se rencontrent. Le fait que le dimère N₂O₂ existe aussi dans le solide rend la suggestion plausible."
                            },
                            {
                                "example_id": "63ff53f7-a8b6-41d2-b4b3-65127f92a277",
                                "sense_id": "39e3a2a7-561f-3979-8322-d1a9a0099c6d",
                                "text": "Le relargage d’œufs ou de juvéniles lors du vidage de ballasts de navires en provenance de l’océan Pacifique est moins plausible, et aucune analyse ne vient le confirmer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e21b3da-d646-4e19-8871-60a3d9230b61",
                        "source_entry_id": "630751a8-d0bf-3da2-b5c0-a17e69136c35",
                        "source_sense_id": "39e3a2a7-561f-3979-8322-d1a9a0099c6d",
                        "target_lang_word": "plausibel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plausibel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                        "entry_id": "7be5f29d-3e18-3f0c-9aa2-c0c2f99776b9",
                                        "glosses": [
                                            "so, dass man es glauben, nachvollziehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc6e344-6942-4805-8cac-44a21abc672e",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "Das ist eine plausible Erklärung."
                                            },
                                            {
                                                "example_id": "b6f198ab-df3d-4770-892d-a59d0a3c9251",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "„Es scheint sich herumgesprochen zu haben, dass die Existenz des christlichen Gottes genauso plausibel ist wie die der anderen Götter.“"
                                            },
                                            {
                                                "example_id": "1c05722e-f2ac-4129-947b-3c1c0caccf28",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "„Sie klingen oftmals ebenso plausibel wie empörend - und sind doch frei erfunden. Der EU-Kommissionschef verlangt mehr Selbstkontrolle der sozialen Netzwerke, um sogenannte Fake-News zu verbannen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19092c64-2865-4d6d-984b-9685225c995e",
                        "source_entry_id": "630751a8-d0bf-3da2-b5c0-a17e69136c35",
