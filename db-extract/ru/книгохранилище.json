                "senses": [
                    {
                        "sense_id": "bac85e46-79df-300c-b811-be7e65fe623f",
                        "entry_id": "95c463f7-03dd-351f-8b8b-6bc36757a4cb",
                        "glosses": [
                            "книжн. очень крупная библиотека общественного значения, представляющая научную или историческую ценность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a774a78d-9040-4744-b2ad-d8fb88818c41",
                                "sense_id": "bac85e46-79df-300c-b811-be7e65fe623f",
                                "text": "Крупнейшие книгохранилища в Москве - Ленинская библиотека и библиотека Исторического музея."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc63cf7f-cb18-3482-aa9d-67e6946df9fd",
                        "entry_id": "95c463f7-03dd-351f-8b8b-6bc36757a4cb",
                        "glosses": [
                            "книжн. книжный склад, помещение для хранения книг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf6cdba-f906-437d-a79d-bde53c4ecbeb",
                                "sense_id": "dc63cf7f-cb18-3482-aa9d-67e6946df9fd",
                                "text": "Книгохранилище Академии наук."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9361475f-c631-4b37-87c0-642792cc9ce4",
                        "source_entry_id": "95c463f7-03dd-351f-8b8b-6bc36757a4cb",
                        "target_lang_word": "library",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "library",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ef4480-1569-3d9f-9dd4-cf721b52420c",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "An institution which holds books and/or other forms of media for use by the public or qualified people often lending them out, as well as providing various other services for its users."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d54eafc-b973-426e-b19e-4a4bffc1a070",
                                                "sense_id": "f8ef4480-1569-3d9f-9dd4-cf721b52420c",
                                                "text": "She went to exchange her books at her local library."
                                            },
                                            {
                                                "example_id": "f14d1be5-e874-4813-a1ea-8876859631f8",
                                                "sense_id": "f8ef4480-1569-3d9f-9dd4-cf721b52420c",
                                                "text": "Libraries have been burnt and whole religious movements wiped out because their belief and myths have been considered to be of dubious origin by the upholders of orthodoxy[.]"
                                            },
                                            {
                                                "example_id": "ccdd4105-ee96-4730-a642-21ea5118dd55",
                                                "sense_id": "f8ef4480-1569-3d9f-9dd4-cf721b52420c",
                                                "text": "When all else fails, give up and go to the library."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49ca93a-2358-3cd2-807d-9cb1bfb74550",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "Any institution that lends out its goods for use by the public or a community."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3966efda-133c-3d0e-8601-eb3a2a28e18f",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "A collection of books or other forms of stored information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0146ba-4a33-4779-b398-f95dd43ccbef",
                                                "sense_id": "3966efda-133c-3d0e-8601-eb3a2a28e18f",
                                                "text": "A small library of books has been written on the subject."
                                            },
                                            {
                                                "example_id": "01377062-1880-4dcd-b716-0daf3d81bfc2",
                                                "sense_id": "3966efda-133c-3d0e-8601-eb3a2a28e18f",
                                                "text": "My library is not a single beast but a composite of many others, a fantastic animal made up of the several libraries built and then abandoned, over and over again, throughout my life. I can’t remember a time in which I didn’t have a library of some sort. The present one is a sort of multilayered autobiography, each book holding the moment in which I opened it for the first time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353e2066-66a6-3521-8280-3e14fb45b44d",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "An equivalent collection of analogous information in a non-printed form, e.g. record library."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81f6e115-cc45-3c87-9420-6532afb0feb0",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "A room dedicated to storing books."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52e6d6e3-672c-3fc8-8a2e-aebd0ee09813",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "A collection of software routines that provide functionality to be incorporated into or used by a computer program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28669c97-202a-4424-99ee-b9b83e86c14f",
                                                "sense_id": "52e6d6e3-672c-3fc8-8a2e-aebd0ee09813",
                                                "text": "A static library is much like any other library in that it contains a bunch of code for your application to use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b24f9e-e41d-34e2-ac98-9f4b7f272574",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "A collection of DNA material from a single organism or relative to a single disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                        "entry_id": "fe252dca-5c36-37e7-907d-ee2869923229",
                                        "glosses": [
                                            "The deck or draw pile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f186c4bc-a607-44d9-b8cd-ec0055ade690",
                                                "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                                "text": "At the conclusion of every duel, each player must show the remaining cards in his or her hand to the opponent to verify that no Restricted List duplicate cards appear there (e.g., to prove that a second Time Walk wasn't drawn from his library)."
                                            },
                                            {
                                                "example_id": "0e53a099-8b27-4739-a3f1-9ad3ee2bdbcf",
                                                "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                                "text": "But why did very good players shy away from cards that are so obviously good from our perspectives? One very real possibility is that library manipulation/increased selection and redundancy tech had not yet been established - after all, many players were amazed at Lestree's use of the Sylvan Library to draw extra cards!"
                                            },
                                            {
                                                "example_id": "a55640f8-6d19-4387-8497-73f0dd35091d",
                                                "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                                "text": "To win a game of Magic, you must achieve one of two chief goals: either be the first to reduce your opponent's life total from 20 to 0, or force him or her to attempt to draw a card from his or her library when there are no cards left in it."
                                            },
                                            {
                                                "example_id": "22f1a69a-53eb-4349-a0a7-d4ab1777f6e5",
                                                "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                                "text": "The deck becomes the draw pile, also called the library, from which each player repeatedly draws cards for his or her own hand, cards that are gradually included into the game."
                                            },
                                            {
                                                "example_id": "aacc7972-a256-4561-8eb8-54c2754d66dc",
                                                "sense_id": "4db68625-0470-3922-b4c7-363cbf9830aa",
                                                "text": "At this phase, most of TCGs only allow players drawing card(s) from a pack which is also called library or deck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113e165c-c820-4cf4-b425-4ed8c9bb5083",
                        "source_entry_id": "95c463f7-03dd-351f-8b8b-6bc36757a4cb",
                        "target_lang_word": "Bibliothek",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bibliothek",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f332053-3fbd-3c23-85d9-6bf17a00de02",
                                        "entry_id": "80bc87df-6d03-366b-9b6c-aa152f1e8417",
                                        "glosses": [
                                            "Institution, in der Bücher und/oder sonstige Medien gelesen oder ausgeliehen werden können; oft einschließlich Bd. [2], heutzutage auch digital"
                                        ],
                                        "tags": [
                                            "Institution",
                                            "Organisation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9a51ad-2c41-4429-861d-2a94e7569d97",
                                                "sense_id": "7f332053-3fbd-3c23-85d9-6bf17a00de02",
                                                "text": "In Bibliotheken kann man immer interessante Bücher entdecken."
                                            },
                                            {
                                                "example_id": "6dc2f9a6-3873-4700-ae76-c6a70b3d0735",
                                                "sense_id": "7f332053-3fbd-3c23-85d9-6bf17a00de02",
                                                "text": "„Sie schrieb auch mehrmals, dass sie gerne weiter in einer Bibliothek oder einer Buchhandlung arbeiten würde, denn im Westerwald (und später in Köln) hatte sie ja viele Jahre als Bibliothekarin gearbeitet.“"
                                            },
                                            {
                                                "example_id": "2b422bb0-e4d0-4d7b-b8c9-e0f1b95dff08",
                                                "sense_id": "7f332053-3fbd-3c23-85d9-6bf17a00de02",
                                                "text": "„Bei den meisten handelte es sich um Geschenke aus Bibliotheken der Nachbarländer, aber auch von Privatpersonen, Färingern wie Ausländern.“"
                                            },
                                            {
                                                "example_id": "62146d74-c8b6-40c5-bb22-772be7209306",
                                                "sense_id": "7f332053-3fbd-3c23-85d9-6bf17a00de02",
                                                "text": "„Wem diente das Archiv, das, wie er deutlich spürte, von einer der landesüblichen Bibliotheken von Grund auf verschieden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                        "entry_id": "80bc87df-6d03-366b-9b6c-aa152f1e8417",
                                        "glosses": [
                                            "besondere Räumlichkeiten für Bücher/Medien und deren Benutzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90dee38a-7705-4263-a7be-976024b0cacf",
                                                "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                                "text": "In Bibliotheken kann man immer interessante Bücher entdecken."
                                            },
                                            {
                                                "example_id": "f53003c5-01cc-480c-9805-b61d1d750d52",
                                                "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                                "text": "„Von einer großzügigen Eingangshalle mit gewundener Treppe gelangt man in ein knappes Dutzend Räume, darunter ein Salon, ein Esszimmer, ein Raucherzimmer, ein Arbeitszimmer plus Bibliothek und im Obergeschoss mindestens fünf Schlafräume.“"
                                            },
                                            {
                                                "example_id": "168dcc06-8dfc-4260-a70b-1f8863bc477a",
                                                "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                                "text": "„Das also war die Bibliothek, das Lesezimmer der Klinik.“"
                                            },
                                            {
                                                "example_id": "92f3227b-0805-4010-94f0-7de6680b914c",
                                                "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                                "text": "Das Gebäude da hinten ist unsere Bibliothek."
                                            },
                                            {
                                                "example_id": "643d28d8-29e3-4e38-bc4e-c29b0b14f0e9",
                                                "sense_id": "a8cdcf7e-3e6e-3977-9e12-e0ae336a59b3",
                                                "text": "„In der großen Bibliothek hätten sie gern die genaue Anzahl der Bände gewußt.“",
                                                "translation": "[3, mit Bedeutungsübergang zu 1] „Mit der Säkularisation 1802/03 gingen die Bibliotheken der Stifte und Klöster des ehemaligen Hochstifts Bamberg in das Eigentum des bayerischen Staates über und wurden […] in die Kurfürstliche Bibliothek […] überführt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c07b0880-b33f-3284-a42d-846dd97c1c5c",
                                        "entry_id": "80bc87df-6d03-366b-9b6c-aa152f1e8417",
                                        "glosses": [
                                            "tendenziell planvoll angelegte oder/und historisch gewachsene Sammlung von Büchern eines Eigentümers oder zu einem Themenbereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d3b00a-d918-4fa1-8f5a-461f692645d6",
                                                "sense_id": "c07b0880-b33f-3284-a42d-846dd97c1c5c",
                                                "text": "„Der Leser darf das E-Book nicht vererben […]. Eine digitale Bibliothek muss der Erbe also unter Umständen neu aufbauen, während gedruckte Bücher an die Erben weitergegeben werden. können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "45852d4c-784e-3fae-bbc7-61f45fb4c3bf",
                                        "entry_id": "80bc87df-6d03-366b-9b6c-aa152f1e8417",
                                        "glosses": [
                                            "Name einer als besonders hochwertig empfundenen herausgegebenen Gruppe/Reihe von Werken"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aead01aa-cb7b-4f27-8bd7-469075fd56b1",
                                                "sense_id": "45852d4c-784e-3fae-bbc7-61f45fb4c3bf",
                                                "text": "„Die Bibliothek von Babel (La Biblioteca de Babel) ist eine Erzählung von Jorge Luis Borges und gleichzeitig der Titel einer von Borges herausgegebenen Buchreihe phantastischer Literatur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36bf103e-e364-3f2e-94bb-148ed939b028",
                                        "entry_id": "80bc87df-6d03-366b-9b6c-aa152f1e8417",
                                        "glosses": [
                                            "Sammlung von Anwendungs(bau)teilen (oder [fachsprachlich auch] Programmmodulen)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08659b98-2b43-4c8f-a518-20b99ade347a",
                                                "sense_id": "36bf103e-e364-3f2e-94bb-148ed939b028",
                                                "text": "„Python wird mit einer Bibliothek von Standard-Modulen verbreitet, die in einem separaten Dokument, der Python Bibliotheks-Referenz […] beschrieben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fd65036-0d5e-45ab-89c4-c73e9a3bbacd",
                        "source_entry_id": "95c463f7-03dd-351f-8b8b-6bc36757a4cb",
                        "target_lang_word": "Bücherei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bücherei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a55a38eb-0140-365a-8d88-5df0b5c20884",
                                        "entry_id": "ca50766c-970e-34fc-9837-389ac40f0c30",
                                        "glosses": [
                                            "eine meist kleinere Bibliothek, in der man Bücher ausleihen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de2fbc79-e87d-4915-abbc-c211b869db16",
                                                "sense_id": "a55a38eb-0140-365a-8d88-5df0b5c20884",
                                                "text": "Die Deutsche Bücherei in Leipzig wurde 1912 gegründet."
                                            },
                                            {
                                                "example_id": "42f261a9-675c-41ad-89f0-9a08374dd069",
                                                "sense_id": "a55a38eb-0140-365a-8d88-5df0b5c20884",
                                                "text": "In der philosophischen Bücherei finde ich Bücher zur Philosophie des 20. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "1bd95fb3-d065-4aa3-8974-adea13be4c88",
                                                "sense_id": "a55a38eb-0140-365a-8d88-5df0b5c20884",
                                                "text": "Wenn ich mir etwas aus der Bücherei ausleihen kann, muss ich es nicht im Buchladen kaufen."
