                "translations": [
                    {
                        "translation_id": "f7179b94-eba6-4c1f-8b25-e35468d32ad2",
                        "source_entry_id": "58a453a3-de8f-388b-8236-f3e2c3bd1838",
                        "source_sense_id": "a93293c1-db20-3b65-b6fd-f1eb5fb3cd46",
                        "source_sense_description": "de binnenbekleding van een voorwerp",
                        "target_lang_word": "Futter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Futter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "Nahrung der Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b5dc97-867a-4059-9c50-173e22c39a42",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Hast du den Schweinen heute schon Futter gegeben?"
                                            },
                                            {
                                                "example_id": "7126d9ee-59df-4d3f-8074-f0719035d845",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Im Nest schreien die um Futter bettelnden Jungvögel."
                                            },
                                            {
                                                "example_id": "b6e0e42b-5dd4-4d10-929f-1b8663ace94c",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Sie sind eigentlich immer auf der Suche nach Futter."
                                            },
                                            {
                                                "example_id": "65ad83d6-e359-49bf-ad78-e9fff3e077f7",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "„Und zu der Sorge wegen der Kutscher war die Sorge um das Futter gekommen.“"
                                            },
                                            {
                                                "example_id": "032bad0c-abf1-49be-bb99-255e9e3c4b1d",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "„Abends sahen sie sich auf Bauernhöfen nach Übernachtungsmöglichkeiten um, und tatsächlich fand sich jedes Mal eine Scheune und etwas Futter für die Pferde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b85a2c95-a900-398a-a3ba-c266d0325a90",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "Essen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2ad607-74dd-40c8-9979-2222bbecb02a",
                                                "sense_id": "b85a2c95-a900-398a-a3ba-c266d0325a90",
                                                "text": "Karl steht gut im Futter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "geistige Nahrung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16aaa84-f665-4c24-8457-61872643b747",
                                                "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                                "text": "Er braucht Futter fürs Hirn."
                                            },
                                            {
                                                "example_id": "6b3ea0e7-596b-464d-a7b6-4644f601c383",
                                                "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                                "text": "„Im letzten Sommer hatte er auf der Suche nach literarischem Futter begonnen, Briefe und Fotos zu studieren, die sich in den fast vierzig Jahren in Connecticut angesammelt hatten, woraus sich schon bald »eine Erinnerungsübung« entwickelte: Um einem neuen Biografen besser helfen zu können, begann er eine zusammengeschusterte Schilderung seines Lebens zu schreiben –»ohne sich über Sätze, Wiederholungen oder leeres Gerede Gedanken zu machen. Viel angenehmer. Und nützlich«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Futter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "Stoff auf der Innenseite von Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a47cf86-f2e1-4fe3-bf77-2833c6076f88",
                                                "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                                "text": "Das Futter in meiner Jacke geht kaputt."
                                            },
                                            {
                                                "example_id": "6af1fd5b-3077-491c-b846-31139540f8f4",
                                                "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                                "text": "„Sie antwortete mir, sie könne nur daran denken, mich glücklich zu machen, wenn sie selbst dabei glücklich werde, und werde mir schreiben, was ich dazu tun könne; den Brief werde sie zwischen Futter und Überzug der Kapuze des Dominos einnähen, und deshalb solle ich diesen erst am folgenden Tag holen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f451f13e-c901-36cb-8a3a-1f7d0b233d58",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "die Ausfüllung von Zwischenräumen bei Türen, Fenstern, Mauern oder ähnlichen Bauteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf38ff21-616d-4b78-9c47-5b5b20a320cb",
                                                "sense_id": "f451f13e-c901-36cb-8a3a-1f7d0b233d58",
                                                "text": "Das Futter der Tür ist die Verkleidung der inneren, seitlichen Wandflächen, das kann zum Beispiel eine Blockzarge sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d25bc99b-70ea-372d-b170-8f8f94e61191",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "eine Einspannvorrichtung an Maschinen für Werkzeuge oder Werkteile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cd924a-bf04-455f-81d5-2b1d1043e1b0",
                                                "sense_id": "d25bc99b-70ea-372d-b170-8f8f94e61191",
                                                "text": "Vorne an der Bohrmaschine, ist am unteren Ende ein geriffelter Ring. Den mit der linken Hand festhalten, dann das Futter mit der rechten nach rechts drehen. Wenn der Zwischenraum groß genug ist, den Bohrer herausnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
