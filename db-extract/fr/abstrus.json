                                        "sense_id": "14bb8682-47f3-3bd6-a845-8160debc27d1",
                                        "entry_id": "53020555-256c-38d9-9c95-c264f7f2def3",
                                        "glosses": [
                                            "Difícil de comprender o entender."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfb8943-cd33-48fe-bd15-828e12a2ea37",
                                                "sense_id": "14bb8682-47f3-3bd6-a845-8160debc27d1",
                                                "text": "¡Todavía no, cabeza de hierro! ¡Todavía no! —respondió el Capitán, levantándose con aire muy reflexivo como si estuviese buscando forma a un pensamiento abstruso y delicado—."
                                            }
