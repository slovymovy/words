                        "glosses": [
                            "In a manner that is not hearty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f88f37f-3df4-430e-9509-128e77f45539",
                                "sense_id": "132df5f7-4224-3fc6-8f02-5720cef33881",
                                "text": "He had such care and attention as could be given him, and it was given by no means grudgingly or unheartily."
                            },
                            {
                                "example_id": "e32c6374-231f-4b12-af85-cc38d0664a3f",
                                "sense_id": "132df5f7-4224-3fc6-8f02-5720cef33881",
                                "text": "\"I know it,\" she replied, but it was still unheartily."
                            },
                            {
                                "example_id": "2d003d07-590c-45c2-b9d5-3bfc37e2cf41",
                                "sense_id": "132df5f7-4224-3fc6-8f02-5720cef33881",
                                "text": "Earl laughed after the others, unheartily but genially."
                            },
                            {
                                "example_id": "e446692b-1909-4c80-b741-5c113cc5b741",
                                "sense_id": "132df5f7-4224-3fc6-8f02-5720cef33881",
                                "text": "She now laughed, and not unheartily, at Miriam's humorous teasings that the two of them would soon be grandmothers."
                            }
                        ]
                    }
                ],
