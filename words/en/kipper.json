                },
                {
                    "sense_id": "461c69b6-1d72-308a-ad05-5fee03d90bd1",
                    "sense_definition": "A naval torpedo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine launched a <w>kipper</w> toward the enemy convoy in the bay.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка выпустила <w>торпеду</w> в сторону вражеского конвоя в бухте."
                            }
                        },
                        {
                            "text": "Sailors braced for impact after spotting a fast-moving <w>kipper</w> in the water.",
                            "target_lang_translations": {
                                "ru": "Моряки приготовились к удару, заметив в воде стремительно приближающуюся <w>торпеду</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Naval military slang"
