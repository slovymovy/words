                "senses": [
                    {
                        "sense_id": "ff5faf58-ad01-330a-9418-d0399eb9f53f",
                        "entry_id": "c75f2cf4-b27f-3769-b4f9-f2513147c977",
                        "glosses": [
                            "unterstützender, dem verantwortlichen Cheftrainer nachgeordneter Trainer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0fb53a-5ee6-4f03-ac1e-5ec1db5ae296",
                                "sense_id": "ff5faf58-ad01-330a-9418-d0399eb9f53f",
                                "text": "„Dad ist mit mir gereist und war in meinem ersten Jahr in der Profiliga mein Trainerassistent.“"
                            },
                            {
                                "example_id": "59313335-12fd-4304-88d0-082c3d68933e",
                                "sense_id": "ff5faf58-ad01-330a-9418-d0399eb9f53f",
                                "text": "„Dirk Ahlfeld ist von heute an nicht mehr bei uns als Trainerassistent beschäftigt.“"
                            },
                            {
                                "example_id": "fbb701ce-f163-47a9-b223-0f5c7cff14e8",
                                "sense_id": "ff5faf58-ad01-330a-9418-d0399eb9f53f",
                                "text": "„Der zweite Trainerassistent setzt sich hingegen ganz oben auf die Tribüne, wo er einen guten Überblick über das Spielgeschehen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
