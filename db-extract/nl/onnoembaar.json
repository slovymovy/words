                "senses": [
                    {
                        "sense_id": "49e4c1a1-8954-3b38-b043-ac7d0da0a142",
                        "entry_id": "73c9371a-9d64-307f-b1b6-e19c062f6fd9",
                        "glosses": [
                            "waar geen woorden of namen voor zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a00851-7776-4454-8ed7-18a130878595",
                                "sense_id": "49e4c1a1-8954-3b38-b043-ac7d0da0a142",
                                "text": "Nadat de echtgenoot de vreemdeling heeft afgetuigd, ontfermt de vrouw zich over hem, uit schuldgevoel, of mogelijk uit een diep verlangen naar iets onnoembaars. Wie zal het zeggen, maar feit is dat de familie het kwaad zelf in huis haalt."
                            },
                            {
                                "example_id": "fa7cbca3-f545-415b-ba77-6c300be28b41",
                                "sense_id": "49e4c1a1-8954-3b38-b043-ac7d0da0a142",
                                "text": "Voor de meeste moslims is wat terroristen doen onnoembaar, vreselijk, onbegrijpelijk, vervolgt hij. „Over het algemeen willen moslims uiteindelijk net als iedereen in vrede leven, een familie hebben, werken, houden van anderen, van gehouden worden. Ook voor hen is er niets ergers dan een einde maken aan een leven. Dát is pas God verzoeken: de ander haten uit liefde voor God.”"
                            }
                        ]
