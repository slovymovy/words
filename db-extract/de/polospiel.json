                "senses": [
                    {
                        "sense_id": "a1f0dd71-0c9d-32b4-be84-4f43f03a07b4",
                        "entry_id": "f86a6bd9-2c8a-3e1e-bb12-de8c1eaa4700",
                        "glosses": [
                            "Ballsportart zu Pferd"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7afaa679-7a44-4168-8976-7738839d94be",
                                "sense_id": "a1f0dd71-0c9d-32b4-be84-4f43f03a07b4",
                                "text": "„Historisch belegt ist jedenfalls, dass das Polospiel von woher auch immer nach Indien gelangte, etwa zur selben Zeit wie die Kolonialmacht Großbritannien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "614f0201-b592-3402-b513-614d4d44ab78",
                        "entry_id": "f86a6bd9-2c8a-3e1e-bb12-de8c1eaa4700",
                        "glosses": [
                            "eine einzelne Partie Polo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b10add-c74f-4292-89ac-184e73ee014a",
                                "sense_id": "614f0201-b592-3402-b513-614d4d44ab78",
                                "text": "„Bei einem Polospiel zugunsten einer Hilfsorganisation in Südafrika purzelte der Queen-Enkel am Samstag kopfüber vom Rücken seines braunen Pferdes.“"
                            },
                            {
                                "example_id": "5c5e3dcb-1e2f-4a02-aeba-9907c772f3af",
                                "sense_id": "614f0201-b592-3402-b513-614d4d44ab78",
                                "text": "„An beiden Tagen stehen ab 12 Uhr jeweils sechs packende Polospiele auf dem Programm.“"
                            },
                            {
                                "example_id": "4d509d65-280c-40fb-9a3a-d7865a69a6f6",
                                "sense_id": "614f0201-b592-3402-b513-614d4d44ab78",
                                "text": "„Polospiele dauern eine Stunde, jede Muskel wird benutzt, die Anstrengung ist groß und kann nur durch genügende Vorbereitungen (vorsichtige, regelmäßige Ernährung) überstanden werden.“"
                            },
                            {
                                "example_id": "40c5473e-2d9c-42db-b606-90e252e0fcce",
                                "sense_id": "614f0201-b592-3402-b513-614d4d44ab78",
                                "text": "„Am Morgen hatte sie sich ganz diskret im Dorf nach kulturellen Ereignissen erkundigt und dabei erfahren, dass der größte Teil der besseren Gesellschaft am heutigen Nachmittag das Polospiel verfolgen werde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
