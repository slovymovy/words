                        "examples": [
                            {
                                "example_id": "1161073a-b643-4906-a83c-740c6692d092",
                                "sense_id": "0a22d184-181d-373f-a805-4157f762f97e",
                                "text": "De twee waren in een echtscheidingszaak verwikkeld. Volgens de rechtbank heeft de vrouw vier mannen uit Ghana aangezet tot de moord. Ze zei dat haar man haar dochter had verkracht en dat er veel geld in huis lag, maar dat was niet zo."
                            },
                            {
                                "example_id": "6a2b4547-f2f3-42a7-a5c6-390169db3a60",
                                "sense_id": "0a22d184-181d-373f-a805-4157f762f97e",
                                "text": "De zwaarste straf was voor een advocaat die zijn praktijk had beëindigd, maar verzuimde de dossiers over te dragen aan een andere advocaat. In een ander geval liet een advocaat termijnen in een echtscheidingszaak verlopen, terwijl hij zijn cliënt in de waan liet dat de scheiding rond was."
                            }
                        ]
                    }
