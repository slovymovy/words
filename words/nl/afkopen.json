            "senses": [
                {
                    "sense_id": "37e6c55d-1fd3-3644-b2a6-11a156b76d59",
                    "sense_definition": "door betaling van een bedrag een schuld, verplichting of eis doen vervallen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financiele_verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf besloot de rechtszaak met een schikking <w>af</w> te <w>kopen</w>.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen beschloss, den Rechtsstreit mit einem Vergleich <w>beizulegen</w>."
                            }
                        },
                        {
                            "text": "Hij <w>kocht</w> zijn resterende studieschuld in één keer <w>af</w>.",
                            "target_lang_translations": {
                                "de": "Er <w>löste</w> seine verbleibenden Studienschulden auf einen Schlag <w>ab</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflossen"
                    ],
                    "common_phrases": [
                        "een schuld afkopen",
                        "een claim afkopen"
                    ],
                    "target_lang_definitions": {
                        "de": "durch Zahlung eines Geldbetrags eine Schuld, Verpflichtung oder Forderung erlöschen lassen"
                    },
                    "translations": {
