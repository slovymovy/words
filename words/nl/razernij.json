{
    "word_family": [
        "razend",
        "razen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f29c506f-97c8-33b4-a007-55f7045bb3cd",
                    "sense_definition": "een toestand van extreme, ongecontroleerde woede of drift",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "woede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man ontstak in <w>razernij</w> toen hij de kras op zijn nieuwe auto zag.",
                            "target_lang_translations": {
                                "en": "The man flew into a <w>rage</w> when he saw the scratch on his new car."
                            }
                        },
                        {
                            "text": "Zijn blinde <w>razernij</w> maakte het onmogelijk om nog rustig met hem te praten.",
                            "target_lang_translations": {
                                "en": "His blind <w>fury</w> made it impossible to talk to him calmly anymore."
                            }
                        }
                    ],
                    "synonyms": [
                        "woede",
                        "drift"
                    ],
                    "antonyms": [
                        "kalmte",
                        "beheersing"
                    ],
                    "common_phrases": [
                        "blinde razernij",
                        "in razernij ontsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of extreme, uncontrolled anger or fury"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "uncontrolled anger"
                            },
                            {
                                "target_lang_word": "fury",
                                "target_lang_sense_clarification": "intense, wild anger"
                            },
                            {
                                "target_lang_word": "frenzy",
                                "target_lang_sense_clarification": "a state of wild excitement or anger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4b933f2-4f2a-38e4-8f4b-4d2910e36060",
                    "sense_definition": "een aanval van waanzin of een psychotische toestand van extreme opwinding",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waanzin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt verkeerde in een staat van <w>razernij</w> en moest door verpleegkundigen worden gekalmeerd.",
                            "target_lang_translations": {
                                "en": "The patient was in a state of <w>frenzy</w> and had to be calmed down by nurses."
                            }
                        },
                        {
                            "text": "De psychoticus ontstak in een wilde woeste <w>razernij</w> zonder dat iemand begreep waarom.",
                            "target_lang_translations": {
                                "en": "The psychotic person flew into a wild, savage <w>delirium</w> without anyone understanding why."
                            }
                        }
                    ],
                    "synonyms": [
                        "krankzinnigheid"
                    ],
                    "common_phrases": [
                        "vlaag van razernij"
                    ],
                    "target_lang_definitions": {
                        "en": "a fit of madness or a psychotic state of extreme agitation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delirium",
                                "target_lang_sense_clarification": "agitated mental state"
                            },
                            {
                                "target_lang_word": "frenzy",
                                "target_lang_sense_clarification": "wild, psychotic excitement"
                            },
                            {
                                "target_lang_word": "madness",
                                "target_lang_sense_clarification": "insanity or extreme agitation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}