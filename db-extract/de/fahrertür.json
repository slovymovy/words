                        "tags": [],
                        "examples": [
                            {
                                "example_id": "562fb955-edc2-438c-811c-c71eeb5dc2a0",
                                "sense_id": "6a40511e-9c74-3cbb-b5ba-b6b9e053699b",
                                "text": "Die Fahrertür hat eine Delle abbekommen."
                            },
                            {
                                "example_id": "e638dc26-74f1-4701-97ee-b2b69e419bc1",
                                "sense_id": "6a40511e-9c74-3cbb-b5ba-b6b9e053699b",
                                "text": "„Ich schnappte mir meine Videokamera, kickte die Fahrertür auf und ging zum Haus.“"
                            },
                            {
                                "example_id": "46dcbff5-8077-4e35-a506-c9acf903c250",
                                "sense_id": "6a40511e-9c74-3cbb-b5ba-b6b9e053699b",
                                "text": "„Siavasch wandte den Blick ab und bewegte sich, eine Hand zum Abschiedsgruß erhoben, zur Fahrertür.“"
                            }
                        ],
