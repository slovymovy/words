{
    "word_family": [
        "returnable",
        "returnee",
        "returner",
        "returning",
        "non-returnable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d942e409-648b-347a-b9d2-68859ebf246b",
                    "sense_definition": "To come or go back to a place or person.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although the birds fly north for the summer, they <w>return</w> here in winter.",
                            "target_lang_translations": {
                                "ru": "Хотя на лето птицы улетают на север, зимой они <w>возвращаются</w> сюда."
                            }
                        },
                        {
                            "text": "I will <w>return</w> home as soon as the meeting is over.",
                            "target_lang_translations": {
                                "ru": "Я <w>вернусь</w> домой, как только закончится собрание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return home",
                        "return to work",
                        "return from holiday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться или прийти обратно к месту или человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "процесс возвращения"
                            },
                            {
                                "target_lang_word": "вернуться",
                                "target_lang_sense_clarification": "завершенное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d54a4802-dc03-33ee-ba26-1c267c11e930",
                    "sense_definition": "To give something back to its original holder or owner.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>return</w> the library book within one month.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>вернуть</w> библиотечную книгу в течение месяца."
                            }
                        },
                        {
                            "text": "Please <w>return</w> the keys to the front desk before you leave.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>верните</w> ключи на стойку регистрации перед уходом."
                            }
                        }
                    ],
                    "synonyms": [
                        "give back",
                        "restore"
                    ],
                    "antonyms": [
                        "take"
                    ],
                    "common_phrases": [
                        "return a book",
                        "return the keys",
                        "return a favor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдать что-либо обратно его первоначальному владельцу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "отдавать обратно"
                            },
                            {
                                "target_lang_word": "вернуть",
                                "target_lang_sense_clarification": "отдать обратно (завершенное)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce90af41-d9b2-3d57-86f7-5675729e1b85",
                    "sense_definition": "To take back something to a vendor for a complete or partial refund.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the shirt does not fit, you can <w>return</w> it for a full refund.",
                            "target_lang_translations": {
                                "ru": "Если рубашка не подойдет, вы можете <w>вернуть</w> её и получить полный возврат денег."
                            }
                        },
                        {
                            "text": "I had to <w>return</w> the faulty toaster to the shop yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мне пришлось <w>сдать</w> неисправный тостер обратно в магазин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return an item",
                        "return for refund"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть товар продавцу для получения полного или частичного возмещения стоимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "товар в магазин"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "обратно в магазин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb93d1f-d7da-3a5e-a379-c3be6a27619b",
                    "sense_definition": "To reciprocate a visit or telephone call.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hello, I am just <w>returning</w> your call from this morning.",
                            "target_lang_translations": {
                                "ru": "Здравствуйте, я просто <w>перезваниваю</w> по поводу вашего утреннего звонка."
                            }
                        },
                        {
                            "text": "She promised to <w>return</w> my call as soon as she finished her lunch.",
                            "target_lang_translations": {
                                "ru": "Она обещала <w>перезвонить</w> мне, как только закончит обедать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return a call",
                        "return a visit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответить взаимностью на визит или телефонный звонок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезванивать",
                                "target_lang_sense_clarification": "ответ на звонок"
                            },
                            {
                                "target_lang_word": "наносить ответный визит",
                                "target_lang_sense_clarification": "о посещении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b36098c-511b-3d9a-89d5-44f56a07868b",
                    "sense_definition": "To recur; to come again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winter <w>returns</w> every year with cold winds and snow.",
                            "target_lang_translations": {
                                "ru": "Зима <w>возвращается</w> каждый год с холодными ветрами и снегом."
                            }
                        },
                        {
                            "text": "The symptoms of the illness may <w>return</w> if you stop taking the medicine.",
                            "target_lang_translations": {
                                "ru": "Симптомы болезни могут <w>вернуться</w>, если вы прекратите принимать лекарство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "symptoms return",
                        "peace returns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторяться; наступать снова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "о состоянии или времени года"
                            },
                            {
                                "target_lang_word": "повторяться",
                                "target_lang_sense_clarification": "о симптомах или событиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b276c474-7d30-35ac-8f1c-79a22bf81051",
                    "sense_definition": "To say in reply; to respond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Do it yourself!\" she <w>returned</w> with a look of annoyance.",
                            "target_lang_translations": {
                                "ru": "«Сделай это сам!» — <w>отрезала</w> она с раздраженным видом."
                            }
                        },
                        {
                            "text": "He <w>returned</w> an answer that was both polite and firm.",
                            "target_lang_translations": {
                                "ru": "Он <w>дал</w> ответ, который был одновременно вежливым и твердым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return an answer",
                        "return thanks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать в ответ; возразить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвечать",
                                "target_lang_sense_clarification": "говорить в ответ"
                            },
                            {
                                "target_lang_word": "возражать",
                                "target_lang_sense_clarification": "отвечать с несогласием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c16f978-1704-3257-befd-97f542ddf297",
                    "sense_definition": "To pass data back to the calling procedure in computer programming.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This function <w>returns</w> the number of files in the directory.",
                            "target_lang_translations": {
                                "ru": "Эта функция <w>возвращает</w> количество файлов в директории."
                            }
                        },
                        {
                            "text": "The script will <w>return</w> an error if the database is not found.",
                            "target_lang_translations": {
                                "ru": "Скрипт <w>выдаст</w> ошибку, если база данных не будет найдена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return a value",
                        "return an error"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать данные обратно вызывающей процедуре в программировании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "значение функции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "035cd6cc-ee0c-3b3b-abbc-f9b039c8aae9",
                    "sense_definition": "The act of returning to a place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_returning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I expect the house to be spotless upon my <w>return</w>.",
                            "target_lang_translations": {
                                "ru": "Я ожидаю, что к моему <w>возвращению</w> в доме будет идеальная чистота."
                            }
                        },
                        {
                            "text": "The explorer was greeted with a parade upon his <w>return</w> from the Arctic.",
                            "target_lang_translations": {
                                "ru": "Исследователя встретили парадом по его <w>возвращении</w> из Арктики."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaincoming"
                    ],
                    "common_phrases": [
                        "upon my return",
                        "safe return"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт возвращения в какое-либо место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращение",
                                "target_lang_sense_clarification": "процесс или факт прибытия назад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c82d0618-b1f9-3e4e-b60d-bda425163bac",
                    "sense_definition": "A ticket that allows travel to a destination and back again.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you want a one-way or a <w>return</w> to London?",
                            "target_lang_translations": {
                                "ru": "Вам билет в одну сторону или <w>туда и обратно</w> до Лондона?"
                            }
                        },
                        {
                            "text": "A <w>return</w> is often cheaper than buying two single tickets.",
                            "target_lang_translations": {
                                "ru": "Билет <w>туда и обратно</w> часто дешевле, чем покупка двух билетов в одну сторону."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return ticket",
                        "buy a return"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Билет, позволяющий доехать до места назначения и обратно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "билет туда и обратно",
                                "target_lang_sense_clarification": "проездной документ"
                            },
                            {
                                "target_lang_word": "обратный билет",
                                "target_lang_sense_clarification": "билет на путь назад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06bbea38-8697-358b-9c28-f9de72255101",
                    "sense_definition": "An item that is sent back to a shop, often because it is faulty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Last year there were 250 <w>returns</w> of this product due to defects.",
                            "target_lang_translations": {
                                "ru": "В прошлом году было 250 <w>возвратов</w> этого товара из-за дефектов."
                            }
                        },
                        {
                            "text": "The store has a dedicated counter for customer <w>returns</w>.",
                            "target_lang_translations": {
                                "ru": "В магазине есть специальная стойка для <w>возвратов</w> от покупателей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "customer returns",
                        "product returns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товар, который отправляют обратно в магазин, часто из-за дефекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возврат",
                                "target_lang_sense_clarification": "возвращенный товар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd0ea6f-9083-3b9c-b4d5-6cf4b27c99aa",
                    "sense_definition": "The profit or gain made from an investment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The savings account yielded a <w>return</w> of five percent this year.",
                            "target_lang_translations": {
                                "ru": "Сберегательный счет принес в этом году пятипроцентную <w>доходность</w>."
                            }
                        },
                        {
                            "text": "Investors are always looking for a high <w>return</w> on their capital.",
                            "target_lang_translations": {
                                "ru": "Инвесторы всегда ищут высокую <w>отдачу</w> на свой капитал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "return on investment",
                        "annual return"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибыль или доход, полученный от инвестиций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доходность",
                                "target_lang_sense_clarification": "процент прибыли"
                            },
                            {
                                "target_lang_word": "отдача",
                                "target_lang_sense_clarification": "результат вложений"
                            },
                            {
                                "target_lang_word": "прибыль",
                                "target_lang_sense_clarification": "финансовый результат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78c1ee6b-395c-30ee-aab2-db242a4205ad",
                    "sense_definition": "An official report of income submitted for tax purposes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must hand in your <w>return</w> within ninety days of the end of the tax year.",
                            "target_lang_translations": {
                                "ru": "Вы должны подать <w>декларацию</w> в течение девяноста дней после окончания налогового года."
                            }
                        },
                        {
                            "text": "I spent the whole weekend filling out my annual tax <w>return</w>.",
                            "target_lang_translations": {
                                "ru": "Я провел все выходные, заполняя свою ежегодную налоговую <w>декларацию</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax return",
                        "file a return"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный отчет о доходах, подаваемый для целей налогообложения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "налоговый документ"
                            },
                            {
                                "target_lang_word": "налоговая декларация",
                                "target_lang_sense_clarification": "полное название документа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}