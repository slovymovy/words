                        "glosses": [
                            "Chronic inflammation and enlargement of the lymphatic glands, such as is found in Hodgkin's disease."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "659382f5-66df-4662-b16f-500e613ad45f",
                                "sense_id": "15f611e9-c235-3261-8986-7d9a682c12b9",
                                "text": "At the tumour period the diagnosis is easier, and the differential diagnosis chiefly concerns cutaneous lymphadenia and sarcoma."
                            },
                            {
                                "example_id": "c10dc10f-fa8b-446d-8e88-728621b7fd30",
                                "sense_id": "15f611e9-c235-3261-8986-7d9a682c12b9",
                                "text": "Lymphadenids cover the eruptive varieties allied to the lymphadenias."
                            },
                            {
                                "example_id": "3ec8a601-45b6-4074-97f8-96562ec267df",
                                "sense_id": "15f611e9-c235-3261-8986-7d9a682c12b9",
                                "text": "The lymphangitis and the lymphadenitis affect the upper as well as the inferior limbs and the genitalia (epididymitis, pain, and hyperesthesia scrotal might occur; being complicated in advanced stages with lymphadenia and scrotal elephantiasis)."
                            }
                        ]
                    }
