                    {
                        "translation_id": "e57029d3-70a3-4242-943d-efdb478f2ac7",
                        "source_entry_id": "c0047c0f-da02-3a1f-ab23-653c69d88135",
                        "target_lang_word": "Langeweile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langeweile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                        "entry_id": "d318e77a-9292-35a0-af79-6d447aaf1134",
                                        "glosses": [
                                            "Gefühl der Untätigkeit, der Eintönigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207c4c5c-233a-4c37-b56f-99a9c5ed3447",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "Aus Langeweile haben schon viele Kinder Schaden angerichtet."
                                            },
                                            {
                                                "example_id": "5001a739-4611-41b8-b9a0-0df92de90692",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Die Langeweile wird in der heutigen Gesellschaft leider gar nicht geschätzt.“"
                                            },
                                            {
                                                "example_id": "26d6e442-e676-4aa8-850a-4ea8d2a468b7",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Eine Nacht und einen Tag hatte sie allein im Zimmer gewartet, hatte vor Langeweile den Sextanten auseinandergenommen, die gesammelten Pflanzen durcheinander gebracht, von dem für Präparate vorgesehenen Spiritus getrunken und ihren Rausch ausgeschlafen.“"
                                            },
                                            {
                                                "example_id": "e5b0be1d-02bc-4f27-8db9-e54ecd114836",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Auf der anderen Seite drang die Langeweile jeden Tag stärker wie tödliches Gift in mich ein.“"
                                            },
                                            {
                                                "example_id": "1026d52b-17e8-46be-ba75-6fa93bce5489",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Schlump hatte Langeweile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
