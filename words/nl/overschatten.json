            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af040977-9d1b-3ee3-98c3-2b08e128dd5b",
                    "sense_definition": "iets groter of van groter belang inschatten dan het in werkelijkheid blijkt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rol van voetbaltrainers wordt vaak <w>overschat</w> door de media.",
                            "target_lang_translations": {
                                "en": "The role of football coaches is often <w>overrated</w> by the media."
                            }
                        },
                        {
                            "text": "Kijk, ik wil mezelf niet <w>overschatten</w>, maar ik heb wel talent voor muziek.",
                            "target_lang_translations": {
                                "en": "Look, I don't want to <w>overestimate</w> myself, but I do have a talent for music."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwaarderen"
                    ],
                    "antonyms": [
                        "onderschatten"
                    ],
                    "common_phrases": [
                        "jezelf overschatten",
                        "de situatie overschatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to estimate something as larger or more important than it actually is"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overestimate",
                                "target_lang_sense_clarification": "to judge or calculate too highly"
                            },
                            {
                                "target_lang_word": "overrate",
                                "target_lang_sense_clarification": "to value or praise something more than it deserves"
                            }
                        ]
                    }
                },
                {
