                "senses": [
                    {
                        "sense_id": "3d180ce6-9eb4-39e1-b8e4-173f00593a1b",
                        "entry_id": "8d53fe3a-1494-3810-bb6b-ccfe8a6a9a8b",
                        "glosses": [
                            "onverschillig, niet emotioneel ergens bij betrokken zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "630ebf72-901d-4db4-ab10-ed720d2ea429",
                                "sense_id": "3d180ce6-9eb4-39e1-b8e4-173f00593a1b",
                                "text": "De afstandelijke houding van de norse arts stelde de patiënt niet gerust."
                            },
                            {
                                "example_id": "e50da7d7-bb2c-418f-9d4b-273c8193fa66",
                                "sense_id": "3d180ce6-9eb4-39e1-b8e4-173f00593a1b",
                                "text": "Waarom werd Martina toch met de seconde afstandelijker? Zowel in haar woordkeus als houding."
                            },
                            {
                                "example_id": "167b3d8f-a635-4d8c-946a-8c05d9d9a692",
                                "sense_id": "3d180ce6-9eb4-39e1-b8e4-173f00593a1b",
                                "text": "Haar blik is kil en afstandelijk en haar neusvleugels trillen alsof ze de alcohol en de angst van een afstand kan ruiken."
                            }
                        ]
                    }
                ],
