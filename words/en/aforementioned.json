            "senses": [
                {
                    "sense_id": "dbf8c54f-f437-39f0-8d2f-715233d136df",
                    "sense_definition": "The person or thing that was mentioned previously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
