                        "glosses": [
                            "abgeschiedener Ort, an dem ein indischer Asket lebt"
                        ],
                        "tags": [
                            "speziell Hinduismus"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02821bee-852f-3da0-9bfa-da514485e1dc",
                        "entry_id": "0b7ae4dc-233d-36e8-866a-67bc7e2bc0e3",
                        "glosses": [
                            "Anlage, die einem Kloster ähnelt und in der sich Jünger um einen Guru sammeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122cb2e5-2260-40de-9a73-cb59852a0504",
                                "sense_id": "02821bee-852f-3da0-9bfa-da514485e1dc",
                                "text": "„Hinter dem Tempel gibt es einen Aschram. Dort wohnen Govindas 15 Jünger. Es sind junge Sadhus, die zwei, drei Jahre bei ihm bleiben, bevor sie zu einem anderen Meister weiterziehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
