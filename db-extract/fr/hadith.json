                                    {
                                        "sense_id": "56bb0fc0-606d-3798-9d10-bcefdb426fa7",
                                        "entry_id": "ea43bdf3-a401-3c68-b9e2-86529eb87c4f",
                                        "glosses": [
                                            "An eyewitness account of a saying or action of Muhammad or sometimes one of his companions not otherwise found in the Quran."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d6397d-ca5a-43a2-a081-2085129bbbeb",
                                                "sense_id": "56bb0fc0-606d-3798-9d10-bcefdb426fa7",
                                                "text": "In addition to the Quran, Muslims also look to the hadiths for moral and spiritual guidance in their daily lives."
                                            },
                                            {
                                                "example_id": "454385e9-0d50-42c3-93f3-33b762a836da",
                                                "sense_id": "56bb0fc0-606d-3798-9d10-bcefdb426fa7",
                                                "text": "There are four main Shia books of hadith and six main Sunni books of hadith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f666be5-e43d-37cb-bede-d438e117ac45",
                                        "entry_id": "ea43bdf3-a401-3c68-b9e2-86529eb87c4f",
                                        "glosses": [
                                            "A particular accepted collection of such accounts, as from a single source or within a particular branch of Islam or Islamic jurisprudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
