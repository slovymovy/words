    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c97ab037-dfd3-3f02-b1dc-b2d7fac024b9",
                    "sense_definition": "iets volledig voltooien of tot een goed einde brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zijn studie nog niet <w>afgerond</w>.",
                            "target_lang_translations": {
                                "en": "He hasn't <w>finished</w> his studies yet.",
                                "ru": "Он еще не <w>завершил</w> свое обучение."
                            }
                        },
                        {
                            "text": "We moeten dit project voor het einde van de week <w>afronden</w>.",
                            "target_lang_translations": {
                                "en": "We need to <w>complete</w> this project before the end of the week.",
                                "ru": "Мы должны <w>закончить</w> этот проект до конца недели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een studie afronden",
                        "een project afronden"
                    ],
                    "target_lang_definitions": {
                        "en": "to fully complete something or bring it to a successful conclusion",
                        "ru": "полностью завершить что-либо или довести до успешного конца"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to reach the end of a task or activity"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "to make something whole or finished"
                            },
                            {
                                "target_lang_word": "wrap up",
                                "target_lang_sense_clarification": "to conclude or summarize a project or meeting"
                            },
                            {
                                "target_lang_word": "finalize",
                                "target_lang_sense_clarification": "to put into final form"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "доводить дело или процесс до конца"
                            },
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "прекращать деятельность, выполнив её"
                            },
                            {
                                "target_lang_word": "подводить итоги",
                                "target_lang_sense_clarification": "завершать обсуждение или проект резюме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fedb1871-c45a-356b-b9c8-a40ee34b0c6c",
                    "sense_definition": "een getal vervangen door een eenvoudiger getal dat er dichtbij ligt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winkel <w>ronde</w> men de prijzen <w>af</w> tot veelvouden van 5 cent.",
                            "target_lang_translations": {
                                "en": "In the shop, they <w>rounded</w> the prices to multiples of 5 cents.",
                                "ru": "В магазине цены <w>округляли</w> до кратных 5 центам."
                            }
                        },
                        {
                            "text": "Je moet het bedrag naar boven <w>afronden</w>.",
                            "target_lang_translations": {
                                "en": "You have to <w>round up</w> the amount.",
                                "ru": "Вы должны <w>округлить</w> сумму в большую сторону."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar boven afronden",
                        "naar beneden afronden"
                    ],
                    "target_lang_definitions": {
                        "en": "to replace a number with a simpler number that is close to it",
                        "ru": "заменить число на более простое, близкое к нему по значению"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "to change a number to the nearest whole number or decimal"
                            },
                            {
                                "target_lang_word": "round up",
                                "target_lang_sense_clarification": "to increase a number to the nearest higher value"
                            },
                            {
                                "target_lang_word": "round off",
                                "target_lang_sense_clarification": "to simplify a number by removing decimals"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "округлять",
                                "target_lang_sense_clarification": "изменять число до ближайшего целого или десятичного значения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f15084ca-4079-3a32-b953-b36c2c83a372",
                    "sense_definition": "scherpe hoeken of randen een ronde vorm geven",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vormgeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoeken van de tafel zijn nog niet <w>afgerond</w>.",
                            "target_lang_translations": {
                                "en": "The corners of the table have not been <w>rounded off</w> yet.",
                                "ru": "Углы стола еще не <w>скруглены</w>."
                            }
                        },
                        {
                            "text": "De timmerman gaat de scherpe randen van de kast <w>afronden</w>.",
                            "target_lang_translations": {
                                "en": "The carpenter is going to <w>round</w> the sharp edges of the cabinet.",
                                "ru": "Плотник собирается <w>закруглить</w> острые края шкафа."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondmaken"
                    ],
                    "common_phrases": [
                        "hoeken afronden"
                    ],
                    "target_lang_definitions": {
                        "en": "to give sharp corners or edges a round shape",
                        "ru": "придавать острым углам или краям округлую форму"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "round off",
                                "target_lang_sense_clarification": "to make an edge or corner smooth and curved"
                            },
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "to make something circular or curved"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скруглять",
                                "target_lang_sense_clarification": "делать края или углы гладкими и изогнутыми"
                            },
                            {
                                "target_lang_word": "закруглять",
                                "target_lang_sense_clarification": "придавать предмету круглую форму"
                            }
                        ]
                    }
                }
            ]
        }
    ]
