    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "209bbade-0c8f-37c4-9077-cdee4653aac9",
                    "sense_definition": "Involving, resembling, or marked by sudden, violent, and irregular movements or spasms.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "convulsions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden and <w>convulsive</w> shudder ran down his entire spine as the temperature plunged.",
                            "target_lang_translations": {
                                "de": "Ein plötzlicher und <w>krampfhafter</w> Schauer lief ihm die gesamte Wirbelsäule hinunter, als die Temperatur schlagartig sank."
                            }
                        },
                        {
                            "text": "She took a deep breath between bursts of <w>convulsive</w> sobbing.",
                            "target_lang_translations": {
                                "de": "Sie holte zwischen den Schüben <w>krampfhaften</w> Schluchzens tief Luft."
                            }
                        }
                    ],
                    "synonyms": [
                        "spasmodic"
                    ],
                    "common_phrases": [
                        "convulsive sobbing",
                        "convulsive shudder"
                    ],
                    "target_lang_definitions": {
                        "de": "Gekennzeichnet durch plötzliche, heftige, ruckartige oder krampfartige Bewegungen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krampfhaft",
                                "target_lang_sense_clarification": "ruckartig, unwillkürlich heftig"
                            },
                            {
                                "target_lang_word": "zuckend",
                                "target_lang_sense_clarification": "durch unwillkürliche ruckartige Bewegungen"
                            },
                            {
                                "target_lang_word": "krampfartig",
                                "target_lang_sense_clarification": "an Krämpfe erinnernd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212cb22f-6cc8-338a-a755-c16a8a00b276",
                    "sense_definition": "Suffering from or causing involuntary, uncontrolled muscular contractions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "convulsions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced a severe <w>convulsive</w> seizure that required immediate medical intervention.",
                            "target_lang_translations": {
                                "de": "Der Patient erlitt einen schweren <w>konvulsiven</w> Anfall, der sofortiges medizinisches Eingreifen erforderte."
                            }
                        },
                        {
                            "text": "The toxic chemical caused violent <w>convulsive</w> reactions in laboratory animals.",
                            "target_lang_translations": {
                                "de": "Die giftige Chemikalie rief bei den Labortieren heftige <w>krampfartige</w> Reaktionen hervor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convulsive seizure",
                        "convulsive disorder"
                    ],
                    "target_lang_definitions": {
                        "de": "Medizinisch: unkontrollierte Muskelkontraktionen verursachend oder von solchen Anfällen begleitet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "konvulsiv",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für krampfartig"
                            },
                            {
                                "target_lang_word": "krampfartig",
                                "target_lang_sense_clarification": "im Zusammenhang mit medizinischen Anfällen"
                            },
                            {
                                "target_lang_word": "konvulsivisch",
                                "target_lang_sense_clarification": "mit Krämpfen einhergehend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}