                        "translation_id": "3c98dbe7-3cb1-4ad4-8e4b-567b0b88cb97",
                        "source_entry_id": "cbeaf8a4-053e-3426-8820-f6e5720545a4",
                        "source_sense_id": "ca07b8f0-902b-35e2-ae36-d7c4a18fd4ac",
                        "target_lang_word": "donation",
