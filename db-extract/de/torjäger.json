                "senses": [
                    {
                        "sense_id": "db8be40a-035d-3ae1-958f-e1d39f2c7181",
                        "entry_id": "bccce390-2217-3c54-98f2-e7f27365918e",
                        "glosses": [
                            "Spieler, der viele Tore schießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0fc9fa-100d-452b-bb5e-5cac245e5353",
                                "sense_id": "db8be40a-035d-3ae1-958f-e1d39f2c7181",
                                "text": "Der Goldene Schuh ist eine Auszeichnung im europäischen Fußball. Sie wird jedes Jahr an den erfolgreichsten Torjäger einer Saison vergeben."
                            },
                            {
                                "example_id": "141516fa-9609-46d1-bddf-4dab2ffb93c8",
                                "sense_id": "db8be40a-035d-3ae1-958f-e1d39f2c7181",
                                "text": "Enrique David Borja Garcia (* 30. Dezember 1945) ist ein bekannter ehemaliger mexikanischer Fußballspieler und erfolgreicher Torjäger."
                            },
                            {
                                "example_id": "476b6203-40b6-4eee-bb90-107ad2cb6c49",
                                "sense_id": "db8be40a-035d-3ae1-958f-e1d39f2c7181",
                                "text": "Walitza gehörte Anfang der siebziger Jahre als Mannschaftskapitän und Torjäger zu den entscheidenden Figuren des ersten Bundesliga-Aufstiegs des VfL Bochum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20ce0172-b6d9-4886-ab85-3396278b2854",
                        "source_entry_id": "bccce390-2217-3c54-98f2-e7f27365918e",
                        "source_sense_id": "db8be40a-035d-3ae1-958f-e1d39f2c7181",
                        "source_sense_description": "Sport: Spieler, der viele Tore schießt",
                        "target_lang_word": "buteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                        "entry_id": "f720ee11-04e0-33b6-9e82-70c0a57c6828",
                                        "glosses": [
                                            "Personne qui marque un but, ou a l’habitude de marquer des buts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05abb64d-ad17-438e-8984-1cc2d66c9aa6",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "C’est le meilleur buteur français de l’année."
                                            },
                                            {
                                                "example_id": "1579d118-474d-4b40-8558-f5729917484c",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "En outre, Tondo Judith (FC GHK) et Nzuzi Vumungo (FC FT) ont été sacrées meilleures buteuses, avec chacune huit réalisations."
                                            },
                                            {
                                                "example_id": "21b7062a-dc66-45fa-b611-ddff8f7fda6c",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "Le directeur sportif du Napoli - qui suit aussi le Rennais Yann M’vila - a également confirmé l’intérêt du club italien pour le meilleur buteur du Championnat de France (16 réalisations) : «on le suit avec des scouts parce que c’est un bon joueur»."
                                            },
                                            {
                                                "example_id": "8a807ee6-0dc9-4852-9adc-56a74392b116",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "Les Cityzens, qui ont commencé sans leur buteur vedette, Erling Haaland, resté sur le banc, ne se sont pas rendus la tâche facile, avec l’expulsion, dès le 30ᵉ minute, de Sergio Gomez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ce13c39-60cd-4a24-a174-07d80f93402b",
                        "source_entry_id": "bccce390-2217-3c54-98f2-e7f27365918e",
