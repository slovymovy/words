                "senses": [
                    {
                        "sense_id": "6746a88f-156b-37cd-9052-9d38233c58e3",
                        "entry_id": "47e212d1-8948-3662-a763-07491371cd5f",
                        "glosses": [
                            "Pousser son cri, en parlant du coq de bruyère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fa2d08-67e8-42c6-9f55-068d00f1598d",
                                "sense_id": "6746a88f-156b-37cd-9052-9d38233c58e3",
                                "text": "Les ronflements des deux braves épuisés couvrirent une fois encore le cri de l'alouette qui turlute, de la bécasse qui croûte, […], du coq de bruyère qui dodeldire, de la corneille qui corbine, […], et bien d'autres bruissements d'animaux qu'il serait une fois encore trop long d'énumérer ici..."
                            },
                            {
                                "example_id": "d02c85de-5a3c-4d2e-8948-6229baa43430",
                                "sense_id": "6746a88f-156b-37cd-9052-9d38233c58e3",
                                "text": "Les puristes râleront. Un tétras lyre ne glousse pas. Il dodeldire. Du genre « gloudougloudouglou »."
                            }
                        ]
                    }
                ],
