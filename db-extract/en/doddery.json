                        "examples": [
                            {
                                "example_id": "a8d08fc2-49e3-43a9-8ff9-10e7171ee9a6",
                                "sense_id": "9f1f9269-3622-3d91-bbf6-271b009dbad2",
                                "text": "That is not to say that he became a doddery old man — far from it. He was just a bit thoughtful at times, and I would catch him looking at me pensively..."
                            },
                            {
                                "example_id": "3a61c35e-d929-4c15-8555-4f5a2d401347",
                                "sense_id": "9f1f9269-3622-3d91-bbf6-271b009dbad2",
                                "text": "The old boy's so doddery now he can hardly finish the course at all. I timed him today. It took him seventy-five seconds..."
                            }
                        ]
                    }
                ],
