                {
                    "sense_id": "978392bf-eada-3bc0-a75c-57cf355e3dfd",
                    "sense_definition": "Of, relating to, or coming from the continent of Asia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves cooking traditional <w>Asian</w> dishes for her family.",
                            "target_lang_translations": {
                                "ru": "Она любит готовить традиционные <w>азиатские</w> блюда для своей семьи.",
                                "zh": "她喜欢为家人烹饪传统的<w>亚洲</w>菜肴。"
                            }
                        },
                        {
                            "text": "Many <w>Asian</w> economies have grown rapidly in recent decades.",
                            "target_lang_translations": {
                                "ru": "Многие <w>азиатские</w> экономики быстро росли в последние десятилетия.",
                                "zh": "近几十年来，许多<w>亚洲</w>经济体增长迅速。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Asian food",
                        "Asian culture",
                        "Asian countries",
                        "Asian markets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Азии или происходящий из неё.",
                        "zh": "指亚洲的，或来自亚洲的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "азиа́тский",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亚洲的",
                                "target_lang_sense_clarification": "形容词，指地理或文化属性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f93fd6f-b295-39cc-b55b-21d604d052de",
                    "sense_definition": "A person from Asia, especially one with ancestry from East or Southeast Asia.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university supports a large association of <w>Asians</w> and Pacific Islanders.",
                            "target_lang_translations": {
                                "ru": "Университет поддерживает крупную ассоциацию <w>азиатов</w> и жителей островов Тихого океана.",
                                "zh": "这所大学支持一个由<w>亚洲人</w>和太平洋岛民组成的大型协会。"
                            }
                        },
                        {
                            "text": "Many <w>Asians</w> celebrate the Lunar New Year with their families.",
                            "target_lang_translations": {
                                "ru": "Многие <w>азиаты</w> отмечают Лунный Новый год в кругу семьи.",
                                "zh": "许多<w>亚洲人</w>会与家人一起庆祝农历新年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "East Asian"
                    ],
                    "common_phrases": [
                        "Asian American",
                        "Asian community"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "especially North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек родом из Азии, особенно восточноазиатского происхождения.",
                        "zh": "亚洲人，尤指东亚或东南亚裔。"
                    },
