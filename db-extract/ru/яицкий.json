                "senses": [
                    {
                        "sense_id": "926b385e-5875-35e0-a562-4ded2e83090f",
                        "entry_id": "e812818f-cfa6-3180-8bea-13dfc7efd6f5",
                        "glosses": [
                            "истор. относящийся к реке Яик, связанный с ней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd329ea2-b64e-4514-9f0d-32434be3d5b3",
                                "sense_id": "926b385e-5875-35e0-a562-4ded2e83090f",
                                "text": "Третьи добирались до яицких прибрежных станиц, ежевичных, икряных, осетровых…"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a898afe-61ba-3f67-b891-94419c81650e",
                        "entry_id": "e812818f-cfa6-3180-8bea-13dfc7efd6f5",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительным Яицкий городок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df1675cd-9b08-486c-b383-5606dc19e123",
                                "sense_id": "5a898afe-61ba-3f67-b891-94419c81650e",
                                "text": "На площади Яика-городка под барабан пешего бирюча яицкие жители оповещались: «Приехал в город государев служилый, большой человек, голова Сакмышев из Астрахани, что всех зовет в воротную башню и храм Спаса нерукотворного»."
                            }
                        ]
                    }
                ],
