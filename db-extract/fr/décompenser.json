                ],
                "senses": [
                    {
                        "sense_id": "c85e5d06-7eb0-362e-b736-ae82d7a86202",
                        "entry_id": "ff8cdc75-9ecd-3dad-90e0-13c896c2d885",
                        "glosses": [
                            "Aggraver par arrêt de la compensation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad5d76a-80f0-4191-985e-49ab9c890ab6",
                                "sense_id": "c85e5d06-7eb0-362e-b736-ae82d7a86202",
                                "text": "Tout ce que je veux dire, c’est qu’il existe plusieurs exemples de tueurs organisés qui décompensent et finissent par dérailler."
                            },
                            {
                                "example_id": "a9af2439-801e-4cde-b1aa-57cccbeae643",
                                "sense_id": "c85e5d06-7eb0-362e-b736-ae82d7a86202",
                                "text": "Sans doute ne décompenserait-on pas si la succession d’accidents, d’échecs, de rejets trouvait à s’arrêter sur la digue d’une amitié solide, d’une relation valorisante, d’un dialogue rassurant qui volatiliserait l’atmosphère dépressive, mélancolique où tout se noie dans le sentiment grave, envahissant, définitif de l’inéluctable."
                            },
                            {
                                "example_id": "ad184cef-0094-4767-a6cb-3da7d6904e04",
                                "sense_id": "c85e5d06-7eb0-362e-b736-ae82d7a86202",
                                "text": "Pour ne pas décompenser, pour ne pas être en manque, le chef exige davantage de soumission, davantage d’adoration, car il lui faut combler l’angoisse de la dette primaire, la peur panique de se retrouver à nouveau seul, pauvre, laid, peureux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dbbab75-beab-46aa-80d5-b0d83a57b292",
                        "source_entry_id": "ff8cdc75-9ecd-3dad-90e0-13c896c2d885",
                        "source_sense_id": "c85e5d06-7eb0-362e-b736-ae82d7a86202",
                        "target_lang_word": "decompensate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decompensate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53dcc634-355d-322f-a58e-9bb63cf77455",
                                        "entry_id": "53ccb9b5-5691-37d5-99b6-2f2a341cc725",
                                        "glosses": [
                                            "To deteriorate in function due to an inability to invoke normal defensive mechanisms that compensate for ailments and other stresses."
                                        ],
                                        "tags": [
                                            "of a bodily organ or mental state"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a0c7a6-b344-49fa-92df-90fc4ac42990",
                                                "sense_id": "53dcc634-355d-322f-a58e-9bb63cf77455",
                                                "text": "The infant whose heart is decompensating has a rapid pulse, rapid respirations, and respiratory distress."
                                            },
                                            {
                                                "example_id": "8bfadda5-a112-4003-821f-98f6f9cdfe85",
                                                "sense_id": "53dcc634-355d-322f-a58e-9bb63cf77455",
                                                "text": "In some cases, the fragile individual, overwhelmed by the implicit demands and expectations for sociability, coherence, and \"constructive\" behavior, rapidly decompensates, taking flight into psychosis or protective withdrawal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
