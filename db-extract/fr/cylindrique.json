                                        "sense_id": "4a05758f-cafd-3154-b71f-7b46d5daa91b",
                                        "entry_id": "47fa90fc-4188-3067-adc1-62e332848b37",
                                        "glosses": [
                                            "die Form eines Zylinders aufweisend; in Form eines Zylinders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "106bd934-6e04-4cb5-bfbb-fff2cdaff7a1",
                                                "sense_id": "4a05758f-cafd-3154-b71f-7b46d5daa91b",
                                                "text": "Es ist ein zylindrischer Gegenstand aus Glas."
                                            },
                                            {
                                                "example_id": "e4941a0a-b18d-44bb-9b93-2349acc1c329",
                                                "sense_id": "4a05758f-cafd-3154-b71f-7b46d5daa91b",
                                                "text": "Eine Bombette ist ein zylindrisch geformter Feuerwerkskörper aus Pappe oder fest gewickeltem oder umschnürtem Papier."
