                    {
                        "translation_id": "dd0a9631-8453-4e64-8126-60241632b6c9",
                        "source_entry_id": "13dc4944-4d65-345c-9e35-5bd3efbf9c33",
                        "source_sense_id": "49d962e4-63b8-3d40-9218-9d9314e10f19",
                        "target_lang_word": "Haupthaar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haupthaar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf10257c-abe8-3e6b-a420-1353e8245368",
                                        "entry_id": "3652fa82-9253-3314-a71e-dfbfd947cfff",
                                        "glosses": [
                                            "Behaarung auf dem Kopf einer Person"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5963683c-a362-4af9-b104-1492da5565cb",
                                                "sense_id": "cf10257c-abe8-3e6b-a420-1353e8245368",
                                                "text": "„Das Haupthaar, zu langen dünnen Zöpfen geflochten, fällt zum Teil in den Nacken, aber auch in die Stirn, wo es zu einem dunklen Strunk gebunden wurde, der bis zu den Augenbrauen reicht.“"
                                            },
                                            {
                                                "example_id": "23585f48-375b-407c-a240-e2e723f03f79",
                                                "sense_id": "cf10257c-abe8-3e6b-a420-1353e8245368",
                                                "text": "„Das Haupthaar wird seit ein paar Jahren lichter, aber im Gegensatz zu deutschen Haaren fallen türkische Haare nicht einfach aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5fbbe65-c369-4dcf-a826-2b1906e75ee8",
                        "source_entry_id": "13dc4944-4d65-345c-9e35-5bd3efbf9c33",
                        "source_sense_id": "49d962e4-63b8-3d40-9218-9d9314e10f19",
                        "target_lang_word": "Haarschopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarschopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c486644a-0485-302d-b634-69758d8f1168",
                                        "entry_id": "2c35103b-7ce2-3656-85ad-53f3cea1f656",
                                        "glosses": [
                                            "das gesamte (dichte) Kopfhaar (meist eines Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95061a4-9850-4512-999e-e849ee86d36c",
                                                "sense_id": "c486644a-0485-302d-b634-69758d8f1168",
                                                "text": "„Plötzlich erkannte ich auf den obersten Stufen einen Haarschopf – ebenso wirr und leuchtend wie jener andere Haarschopf, den ich vor drei Wochen unter der Erde hatte verschwinden sehen.“"
                                            },
                                            {
                                                "example_id": "09828f6e-5df4-4201-9faf-19d05d579773",
                                                "sense_id": "c486644a-0485-302d-b634-69758d8f1168",
                                                "text": "„Da erwachte Jón Hreggvidsson plötzlich aus seiner Betäubung, guckte nicht mehr durch die Maueröffnung, steckte die Finger in seinen Haarschopf unter dem Hut und juckte sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80fa1bd2-5c06-32fe-b5db-ea22c2b82c10",
                                        "entry_id": "2c35103b-7ce2-3656-85ad-53f3cea1f656",
                                        "glosses": [
                                            "Bündel, Büschel von Haaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9892114b-dc7e-4da8-bea1-4fdc1a8bda69",
                                                "sense_id": "80fa1bd2-5c06-32fe-b5db-ea22c2b82c10",
                                                "text": "„Bobby stopfte sich den Haarschopf unwillkürlich in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e79ad2ae-b2bb-4819-a78f-0415aac80d21",
                        "source_entry_id": "13dc4944-4d65-345c-9e35-5bd3efbf9c33",
                        "source_sense_id": "49d962e4-63b8-3d40-9218-9d9314e10f19",
                        "target_lang_word": "chevelure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevelure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Ensemble des cheveux d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5826ad-775c-4ac3-9b2a-e50de2d637c3",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Ce jeune homme frais, coquet et pommadé semblait ne penser qu’à sa chevelure et à l’effet de ses charmes sur son entourage féminin."
                                            },
                                            {
                                                "example_id": "fb95d20e-a5a5-4cac-8bfb-56765c692bf1",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Cette chevelure était éclatante et profonde, douce comme une fourrure, plus longue qu'une aile, souple, innombrable, animée, pleine de chaleur."
                                            },
                                            {
                                                "example_id": "e32eeaa0-9ab7-48c3-bd9d-051252ff2545",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Ses yeux bruns étaient bordés de noir ou plutôt meurtris ; sa lèvre supérieure était ornée d’un duvet brun qui dessinait une espèce de fumée ; elle avait les lèvres menues, et son front impérieux était rehaussé par une chevelure jadis noire, mais qui tournait au chinchilla."
                                            },
                                            {
                                                "example_id": "ffc2dd3d-240d-4b06-970e-f2187d3433bb",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Sa chevelure luxuriante, d’une nuance entre le brun et le blond, était partagée d’une manière gracieuse et élégante en nombreuses boucles où l’art avait assisté la nature."
                                            },
                                            {
                                                "example_id": "96b564d6-ce81-435c-b284-10b07ad69637",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Les étranges figures dont tout Mangarévien bigarrait sa peau, jointes à sa longue barbe et sa chevelure flottante, lui donnaient un air martial et terrible, […]."
                                            },
                                            {
                                                "example_id": "f9d47ed2-8763-4321-8476-566232b83671",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Non, François ne se troublait pas. Cette jouvencelle aux yeux de paille mûre, cette blondeur capiteuse de la chevelure, cet arôme violent d'un corps en plein épanouissement, le remarquait-il ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Nébulosité entourant le noyau de certaines comètes et qui s’étire à l’opposé du soleil."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276628fc-69db-4f4a-9119-381255880cf8",
                                                "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                                "text": "La chevelure d’une comète est constituée de gaz et de particules solides arrachées au noyau."
                                            },
                                            {
                                                "example_id": "ab16e334-1bb3-45f3-9dea-2904998da6d6",
                                                "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                                "text": "Les astrophysiciens ont étudié la composition de la chevelure – ou coma – de Tchouri, alimentée par les dégazages du noyau cométaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee9e0999-7129-398e-8c56-1f9cb7ae0b1d",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Ensemble des feuilles des arbres, voire d'autres végétaux."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ff1423-6929-4482-a63a-39d5ac15c4d4",
                                                "sense_id": "ee9e0999-7129-398e-8c56-1f9cb7ae0b1d",
                                                "text": "C'est ainsi qu'à la ferme de la Faille près de Sainte-Marie-en-Chaux, […], le Ranunculus fluitans déploie seul ses longues chevelures sur de larges étendues, masquant presque totalement les galets du fond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b31ade-277c-43eb-be48-8e67f2eef020",
                        "source_entry_id": "13dc4944-4d65-345c-9e35-5bd3efbf9c33",
                        "source_sense_id": "49d962e4-63b8-3d40-9218-9d9314e10f19",
                        "target_lang_word": "toison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d81640-a330-3f42-bea5-987141c81e16",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Ensemble de la laine qui recouvre une brebis, un mouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95131298-36e3-4600-8c00-4cc8eaf206b3",
                                                "sense_id": "a2d81640-a330-3f42-bea5-987141c81e16",
                                                "text": "[…], et l’on y voit de grands troupeaux de mérinos, remarquables par leur bonne conformation et l’abondance et la finesse de leurs toisons […]."
                                            },
                                            {
                                                "example_id": "e0fe0b81-9a99-4344-a01f-be110cd92455",
                                                "sense_id": "a2d81640-a330-3f42-bea5-987141c81e16",
                                                "text": "La laine est une matière textile fournie par la toison du mouton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e3d0463-dc55-33b7-ac9f-e78815f519ca",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Abondante et épaisse chevelure."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9504b7f1-2069-4810-a461-dd185062a0d7",
                                                "sense_id": "5e3d0463-dc55-33b7-ac9f-e78815f519ca",
                                                "text": "Je voyais de loin sa toison glorieuse déborder de son chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bc77b7d-2628-357b-bb9f-ace9773ddee5",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Ensemble des poils pubiens, chez la femme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96274198-a700-41a9-adc0-5611084a4f9a",
                                                "sense_id": "4bc77b7d-2628-357b-bb9f-ace9773ddee5",
                                                "text": "Rien de très précis, mais un peu comme ces effluves électriques qui vous chatouillent le cuir, avant l’orage, et font se redresser à rebrousse-poil la toison intime des ménesses."
                                            },
                                            {
                                                "example_id": "4576ee84-a386-4ed0-a76a-0c87aaff23bc",
                                                "sense_id": "4bc77b7d-2628-357b-bb9f-ace9773ddee5",
                                                "text": "Au sujet de la toison sexuelle, je suis tentée de croire que le sieur de Brantôme a voulu faire de la fantaisie dans son livre : Des dames galantes. S'attacher les poils pubiques autour des cuisses me paraît absolument invraisemblable."
                                            },
                                            {
                                                "example_id": "f3830fd4-8533-46b8-9cf8-982cd9e45be2",
                                                "sense_id": "4bc77b7d-2628-357b-bb9f-ace9773ddee5",
                                                "text": "Je n’en avais pas moins l’impression bizarre que c’était sa toison intime que Thérèse exhibait aussi ostensiblement aux yeux du promeneur !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb15de3a-07b0-307e-b016-ebe8e621bd6b",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Poils du torse, chez l’homme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e250cb19-22d7-4c20-958e-f3a1c2f348af",
                                                "sense_id": "cb15de3a-07b0-307e-b016-ebe8e621bd6b",
                                                "text": "Abondante, sa toison pileuse bouffe jusqu'à mi-cou, faisant comme un col roulé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fedd5a4f-bcc1-3d54-856a-0fed292ecea2",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Poils sous les aisselles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33c4b34-b181-4ae4-b883-183880eeae04",
                                                "sense_id": "fedd5a4f-bcc1-3d54-856a-0fed292ecea2",
                                                "text": "À intervalle régulier, le mouvement saccadé de ses bras découvrait la fine toison sous ses aisselles et des effluves capiteux remontaient jusqu’à Gabriel."
                                            },
                                            {
                                                "example_id": "f78e000b-b3a7-460e-8494-2c30b299af52",
                                                "sense_id": "fedd5a4f-bcc1-3d54-856a-0fed292ecea2",
                                                "text": "Madonna avait, elle aussi, déjà choqué bon nombre d'âmes sensibles en posant en 2014 avec une toison dorée sous les aisselles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7face5e7-050d-343a-831d-4fcd6548620b",
                                        "entry_id": "5ab7bd2d-040b-366a-93af-6b5c1cc6f179",
                                        "glosses": [
                                            "Ce qui ressemble à une fourrure fournie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ef5856-59d8-4275-81fe-bd852ac6f529",
                                                "sense_id": "7face5e7-050d-343a-831d-4fcd6548620b",
                                                "text": "Sur la terre grise des champs, dans la toison verte des prés, ensemble nous avons couru en nous tenant par la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
