                        "entry_id": "693bcda2-cbc4-3432-9476-f47ab89caa67",
                        "glosses": [
                            "Mann, der vom Lande, vom Dorf oder aus abgelegenen Gebieten kommt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "18aab505-ff83-43a5-ab15-c3f690a2d7e3",
                                "sense_id": "26003d27-67cb-3bb9-b86b-c98cb2d2e7f0",
                                "text": "Was für ein Provinzler!"
                            },
                            {
                                "example_id": "13e58652-b70b-4c5e-b1bf-6dc90bb3c5de",
                                "sense_id": "26003d27-67cb-3bb9-b86b-c98cb2d2e7f0",
                                "text": "„Das Vineta war ein populäres Tanzbums, mit Tischtelefon, Rohrpost und ähnlichen Sachen für Provinzler.“"
                            },
                            {
                                "example_id": "c4267f40-b692-4844-90d4-3d41f6758701",
                                "sense_id": "26003d27-67cb-3bb9-b86b-c98cb2d2e7f0",
                                "text": "Manche Zeitgenossen entlarven sich selbst als Provinzler."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
