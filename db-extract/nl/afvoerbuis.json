                    {
                        "sense_id": "ef84c77d-6458-31f3-b4e3-6748ca889b17",
                        "entry_id": "a3976dd3-ba1d-3be8-ac32-f3be039e0fdd",
                        "glosses": [
                            "pijp waarmee men overvloedige vloeistof kan laten wegvloeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348507b3-39d6-47d0-8d77-509234288048",
                                "sense_id": "ef84c77d-6458-31f3-b4e3-6748ca889b17",
                                "text": "De afvoerbuis van de wastafel was verstopt door de lange haren van de vrouwen die boven de wastafel hun haren kamden."
                            },
                            {
                                "example_id": "e390eaca-d7d7-4fff-bb1b-151e16711e5c",
                                "sense_id": "ef84c77d-6458-31f3-b4e3-6748ca889b17",
                                "text": "De ovaalvormige vloer waarop ze lag, was ongeveer tweeëneenhalf bij drie meter, met in het midden een smalle afvoerbuis."
                            },
                            {
                                "example_id": "9248494c-208a-4e6f-90d1-27c14da0b803",
                                "sense_id": "ef84c77d-6458-31f3-b4e3-6748ca889b17",
                                "text": "„En wijzelf ook, natuurlijk,\" zei hij dan met zijn lach, die deed denken aan water dat door een afvoerbuis stroomt en mij ook altijd aan het lachen maakte."
                            }
                        ]
                    }
                ],
