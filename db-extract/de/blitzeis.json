                "senses": [
                    {
                        "sense_id": "d35800cf-56a7-3949-9723-01326d125537",
                        "entry_id": "e4f25d34-1096-39e7-a6c9-c4014906435d",
                        "glosses": [
                            "A coating of ice, caused by a downpour of freezing rain, that forms rapidly on exposed surfaces; black ice."
                        ],
                        "tags": [
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "74f7a70a-df2a-40f4-958f-9192360b3562",
                                "sense_id": "d35800cf-56a7-3949-9723-01326d125537",
                                "text": "Vor ein paar Tagen kam das Blitzeis und fror sie ein in ihren Bewegungen.",
                                "translation": "Just a couple of days later, the ice came suddenly and froze them in their tracks.",
                                "english": "Just a couple of days later, the ice came suddenly and froze them in their tracks."
                            },
                            {
                                "example_id": "4eb1bc4e-dca1-4448-a0a2-02380cce04b4",
                                "sense_id": "d35800cf-56a7-3949-9723-01326d125537",
                                "text": "Kommt nach Jahren ein Regenguss, entsteht Glätte, die man mit dem in Deutschland auftretenden Blitzeis vergleichen kann.",
                                "translation": "Once every few years comes a torrential downpour, which results in a layer of black ice comparable with German \"Blitzeis\".",
                                "english": "Once every few years comes a torrential downpour, which results in a layer of black ice comparable with German \"Blitzeis\"."
                            },
                            {
                                "example_id": "a6ce911a-6f5c-4ca0-9c36-7cba1d026e23",
                                "sense_id": "d35800cf-56a7-3949-9723-01326d125537",
                                "text": "Blitzeis bildet sich, wenn Regentropfen auf einen gefrorenen Untergrund fallen.",
                                "translation": "Black ice forms when rain falls onto already frozen ground.",
                                "english": "Black ice forms when rain falls onto already frozen ground."
                            },
                            {
                                "example_id": "4271e539-0557-431d-a4d4-ea1172fcc58d",
                                "sense_id": "d35800cf-56a7-3949-9723-01326d125537",
                                "text": "Das Winterwetter mit Blitzeis und Schneefällen hat tausenden Schülern im Hochtaunuskreis gestern einen freien Tag beschert.",
                                "translation": "The wintery weather, which included freezing rain and snow, gave thousands of students in Hochtaunuskreis a day off yesterday.",
                                "english": "The wintery weather, which included freezing rain and snow, gave thousands of students in Hochtaunuskreis a day off yesterday."
                            }
                        ]
                    }
                ],
