                        {
                            "text": "Elle a décidé de <w>tenter</w> un concours difficile cette année.",
                            "target_lang_translations": {
                                "en": "She has decided to <w>try</w> a difficult competition this year.",
                                "ru": "В этом году она решила <w>попробовать свои силы</w> в сложном конкурсе.",
                                "nl": "Zij heeft besloten dit jaar een moeilijk concours te <w>proberen</w>.",
                                "de": "Sie hat beschlossen, dieses Jahr einen schwierigen Wettbewerb zu <w>wagen</w>.",
                                "pl": "Postanowiła w tym roku <w>spróbować</w> swoich sił w trudnym konkursie.",
                                "it": "Quest'anno ha deciso di <w>tentare</w> un concorso difficile.",
                                "cs": "Letos se rozhodla <w>pokusit se</w> o náročnou soutěž.",
                                "tr": "Bu yıl zor bir sınava girmeyi <w>denemeye</w> karar verdi.",
                                "es": "Este año ha decidido <w>presentarse</w> a un concurso difícil.",
                                "zh": "她今年决定<w>尝试</w>参加一场难度很大的比赛。"
                            }
                        },
                        {
                            "text": "Les alpinistes <w>tenteront</w> d'atteindre le sommet de la montagne dès le lever du soleil.",
                            "target_lang_translations": {
                                "en": "The climbers will <w>attempt</w> to reach the summit of the mountain at sunrise.",
                                "ru": "Альпинисты <w>попытаются</w> взойти на вершину горы на рассвете.",
                                "nl": "De bergbeklimmers zullen bij zonsopgang de top van de berg <w>proberen</w> te bereiken.",
                                "de": "Die Bergsteiger <w>werden versuchen</w>, bei Sonnenaufgang den Gipfel des Berges zu erreichen.",
                                "pl": "Alpiniści <w>spróbują</w> zdobyć szczyt góry już o wschodzie słońca.",
                                "it": "Gli alpinisti <w>tenteranno</w> di raggiungere la vetta della montagna fin dal sorgere del sole.",
                                "cs": "Horolezci se <w>pokusí</w> vystoupat na vrchol hory hned při východu slunce.",
                                "tr": "Dağcılar güneşin doğuşuyla birlikte dağın zirvesine ulaşmayı <w>deneyecekler</w>.",
                                "es": "Los alpinistas <w>intentarán</w> alcanzar la cima de la montaña al amanecer.",
                                "zh": "登山者将在日出时分<w>试图</w>登顶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "entreprendre"
