{
    "word_family": [
        "endorse",
        "endorser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0587551-4665-31ba-99c9-3743639f4f33",
                    "sense_definition": "The act of giving public approval or support to someone or something",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The association announced its <w>endorsement</w> of the new environmental policy.",
                            "target_lang_translations": {
                                "ru": "Ассоциация объявила о своем <w>одобрении</w> новой экологической политики."
                            }
                        },
                        {
                            "text": "The candidate was thrilled to receive an official <w>endorsement</w> from the local union.",
                            "target_lang_translations": {
                                "ru": "Кандидат был в восторге от получения официальной <w>поддержки</w> со стороны местного профсоюза."
                            }
                        }
                    ],
                    "synonyms": [
                        "approval",
                        "support",
                        "sanction",
                        "advocacy"
                    ],
                    "antonyms": [
                        "opposition",
                        "disapproval",
                        "rejection"
                    ],
                    "common_phrases": [
                        "official endorsement",
                        "public endorsement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт публичного одобрения или поддержки кого-либо или чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "признание правильным или хорошим"
                            },
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "публичное содействие или выражение согласия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4df4cd8-32c6-3e15-a809-c152e1260161",
                    "sense_definition": "A statement or action by a famous person or organization recommending a product or service",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marketing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Companies sometimes pay millions for a celebrity <w>endorsement</w> to boost their sales.",
                            "target_lang_translations": {
                                "ru": "Компании иногда платят миллионы за <w>эндорсмент</w> со стороны знаменитостей, чтобы увеличить свои продажи."
                            }
                        },
                        {
                            "text": "The athlete signed a lucrative <w>endorsement</w> deal with a major sports brand.",
                            "target_lang_translations": {
                                "ru": "Спортсмен подписал выгодный <w>рекламный</w> контракт с крупным спортивным брендом."
                            }
                        }
                    ],
                    "synonyms": [
                        "recommendation",
                        "testimonial",
                        "sponsorship"
                    ],
                    "common_phrases": [
                        "celebrity endorsement",
                        "product endorsement",
                        "endorsement deal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или действие известного человека или организации, рекомендующее продукт или услугу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эндорсмент",
                                "target_lang_sense_clarification": "рекламная поддержка со стороны знаменитости"
                            },
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "совет или отзыв от известного лица"
                            },
                            {
                                "target_lang_word": "спонсорство",
                                "target_lang_sense_clarification": "финансовая поддержка в обмен на рекламу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54f50ab4-22a8-31d6-b1b0-b8c1f72b1906",
                    "sense_definition": "An official note or amendment added to a document, such as an insurance policy or a driver's license",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "documentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mr. Jones paid extra for the flood damage <w>endorsement</w> on his house insurance.",
                            "target_lang_translations": {
                                "ru": "Мистер Джонс доплатил за <w>дополнение</w> о страховании от ущерба при наводнении в своем полисе страхования дома."
                            }
                        },
                        {
                            "text": "The driver had a special <w>endorsement</w> on his license allowing him to operate heavy machinery.",
                            "target_lang_translations": {
                                "ru": "У водителя была специальная <w>отметка</w> в правах, позволяющая ему управлять тяжелой техникой."
                            }
                        }
                    ],
                    "synonyms": [
                        "amendment",
                        "annotation",
                        "rider",
                        "codicil"
                    ],
                    "common_phrases": [
                        "insurance endorsement",
                        "license endorsement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное примечание или поправка, добавленная к документу, например, к страховому полису или водительскому удостоверению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "изменение или дополнение к документу"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "дополнительное условие в полисе или контракте"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "корректировка условий документа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62aae09f-24cb-3b72-a2f6-249795da1647",
                    "sense_definition": "A specific qualification or permission added to a professional license to perform certain tasks",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To transport gasoline, truckers must have a valid license and the hazardous materials <w>endorsement</w>.",
                            "target_lang_translations": {
                                "ru": "Для перевозки бензина водители грузовиков должны иметь действующую лицензию и <w>допуск</w> к перевозке опасных грузов."
                            }
                        },
                        {
                            "text": "The school is looking for an accredited teacher with a mathematics <w>endorsement</w>.",
                            "target_lang_translations": {
                                "ru": "Школа ищет аккредитованного учителя с <w>квалификацией</w> в области математики."
                            }
                        }
                    ],
                    "synonyms": [
                        "certification",
                        "qualification",
                        "authorization"
                    ],
                    "common_phrases": [
                        "teaching endorsement",
                        "hazardous materials endorsement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальная квалификация или разрешение, добавленное к профессиональной лицензии для выполнения определенных задач"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отметка",
                                "target_lang_sense_clarification": "запись в правах или лицензии о допуске"
                            },
                            {
                                "target_lang_word": "категория",
                                "target_lang_sense_clarification": "дополнительная квалификация в удостоверении"
                            },
                            {
                                "target_lang_word": "допуск",
                                "target_lang_sense_clarification": "разрешение на выполнение специфических работ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44a9756-8094-3ed3-a84e-d1a1f537190f",
                    "sense_definition": "A signature in a logbook by an instructor verifying that a student has practiced specific skills",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once she obtained the <w>endorsement</w> of her night flying hours, Joanna was approved for the exam.",
                            "target_lang_translations": {
                                "ru": "Как только она получила <w>подтверждение</w> часов ночных полетов, Джоанна была допущена к экзамену."
                            }
                        },
                        {
                            "text": "The flight instructor provided the necessary <w>endorsement</w> after the student completed the solo cross-country flight.",
                            "target_lang_translations": {
                                "ru": "Летный инструктор сделал необходимую <w>запись</w> после того, как студент совершил самостоятельный перелет."
                            }
                        }
                    ],
                    "synonyms": [
                        "validation",
                        "verification",
                        "sign-off"
                    ],
                    "common_phrases": [
                        "flight endorsement",
                        "logbook endorsement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подпись инструктора в журнале, подтверждающая, что студент отработал определенные навыки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "запись инструктора о прохождении практики"
                            },
                            {
                                "target_lang_word": "заверение",
                                "target_lang_sense_clarification": "официальная подпись о выполнении нормативов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}