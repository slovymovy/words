    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b13a5ef6-e19b-3796-8fe6-190f84d01435",
                    "sense_definition": "Szybko przemieszczać się używając nóg, w taki sposób, że w pewnych momentach obie stopy są oderwane od ziemi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motion_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój mały pies wesoło <w>biegnie</w> do swojego właściciela.",
                            "target_lang_translations": {
                                "ru": "Мой маленький пёс весело <w>бежит</w> к своему хозяину.",
                                "en": "My little dog is happily <w>running</w> to its owner."
                            }
                        },
                        {
                            "text": "Musimy szybko <w>biec</w> na przystanek, żeby zdążyć na autobus do szkoły.",
                            "target_lang_translations": {
                                "ru": "Мы должны быстро <w>бежать</w> на остановку, чтобы успеть на автобус в школу.",
                                "en": "We have to <w>run</w> quickly to the stop to catch the bus to school."
                            }
                        }
                    ],
                    "synonyms": [
                        "pędzić",
                        "gnać"
                    ],
                    "antonyms": [
                        "stać"
                    ],
                    "common_phrases": [
                        "biec do celu",
                        "biec szybko",
                        "biec przed siebie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро перемещаться с помощью ног, так, что в определенные моменты обе ноги оторваны от земли.",
                        "en": "To move quickly on foot, such that both feet are off the ground at certain moments."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "о людях и животных"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "очень быстро бежать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to move swiftly on foot"
                            },
                            {
                                "target_lang_word": "trot",
                                "target_lang_sense_clarification": "to move at a pace faster than a walk but slower than a run"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63d88204-ed52-3d1d-a54b-1bedb3e7b1c5",
                    "sense_definition": "Szybko mijać lub upływać (używane w kontekście czasu).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motion_abstract_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niestety czas <w>biegnie</w> bardzo szybko, gdy dobrze się bawimy.",
                            "target_lang_translations": {
                                "ru": "К сожалению, время <w>бежит</w> очень быстро, когда мы хорошо проводим время.",
                                "en": "Unfortunately, time <w>runs</w> very fast when we are having fun."
                            }
                        },
                        {
                            "text": "Kolejne lata <w>biegną</w>, a my wciąż jesteśmy najlepszymi przyjaciółmi.",
                            "target_lang_translations": {
                                "ru": "Годы <w>бегут</w>, а мы всё ещё лучшие друзья.",
                                "en": "The years <w>run</w> by, and we are still best friends."
                            }
                        }
                    ],
                    "synonyms": [
                        "mknąć"
                    ],
                    "common_phrases": [
                        "czas biegnie",
                        "lata biegną",
                        "życie biegnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро проходить или утекать (используется в контексте времени).",
                        "en": "To pass or elapse quickly (used in the context of time)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "лететь",
                                "target_lang_sense_clarification": "очень быстро проходить"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to continue or elapse (of time)"
                            },
                            {
                                "target_lang_word": "fly",
                                "target_lang_sense_clarification": "to pass very quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79740d2-36fe-3c57-b35d-2b5961c78ec8",
                    "sense_definition": "Rozciągać się lub prowadzić w określonym kierunku (o drodze, rzece, granicy lub instalacji).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_extension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta wąska ścieżka <w>biegnie</w> prosto przez gęsty las aż do rzeki.",
                            "target_lang_translations": {
                                "ru": "Эта узкая тропинка <w>бежит</w> прямо через густой лес к реке.",
                                "en": "This narrow path <w>runs</w> straight through the dense forest to the river."
                            }
                        },
                        {
                            "text": "Główna ulica miasta <w>biegnie</w> od rynku aż do starego dworca kolejowego.",
                            "target_lang_translations": {
                                "ru": "Главная улица города <w>проходит</w> от рыночной площади до старого вокзала.",
                                "en": "The main street of the city <w>runs</w> from the market square to the old train station."
                            }
                        }
                    ],
                    "synonyms": [
                        "prowadzić",
                        "przebiegać",
                        "wieść"
                    ],
                    "common_phrases": [
                        "droga biegnie",
                        "trasa biegnie",
                        "granica biegnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простираться или вести в определенном направлении (о дороге, реке, границе).",
                        "en": "To extend or go in a specific direction (of a road, river, boundary, or installation)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "о дороге, улице или границе"
                            },
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "о тропинке или реке"
                            },
                            {
                                "target_lang_word": "тянуться",
                                "target_lang_sense_clarification": "простираться на расстояние"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to extend in a certain direction"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to reach or extend in a spatial direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "728a9e24-c31b-3159-a08f-ab3e80ae26b5",
                    "sense_definition": "Toczyć się, rozwijać lub zmieniać w czasie (o wydarzeniach, akcji utworu lub procesach).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motion_abstract_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Akcja tego filmu <w>biegnie</w> dwutorowo i jest niezwykle interesująca.",
                            "target_lang_translations": {
                                "ru": "Действие этого фильма <w>развивается</w> по двум линиям и чрезвычайно интересно.",
                                "en": "The plot of this film <w>develops</w> along two tracks and is extremely interesting."
                            }
                        },
                        {
                            "text": "Wszystkie sprawy urzędowe <w>biegną</w> swoim ustalonym, powolnym rytmem.",
                            "target_lang_translations": {
                                "ru": "Все официальные дела <w>идут</w> своим установленным, медленным чередом.",
                                "en": "All official matters <w>proceed</w> at their own set, slow pace."
                            }
                        }
                    ],
                    "common_phrases": [
                        "akcja biegnie",
                        "sprawy biegną",
                        "historia biegnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить, развиваться или меняться во времени (о событиях, сюжете или процессах).",
                        "en": "To proceed, develop, or change over time (of events, plot, or processes)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развиваться",
                                "target_lang_sense_clarification": "о сюжете или действии"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "о ходе дел или процессов"
                            },
                            {
                                "target_lang_word": "протекать",
                                "target_lang_sense_clarification": "о течении событий"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "develop",
                                "target_lang_sense_clarification": "to unfold or progress (of a plot or action)"
                            },
                            {
                                "target_lang_word": "proceed",
                                "target_lang_sense_clarification": "to continue or move forward (of events or processes)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}