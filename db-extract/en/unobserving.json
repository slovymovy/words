                        "glosses": [
                            "Failing to observe something; unobservant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4866971f-ae9a-410b-9af8-cd9a23826d1e",
                                "sense_id": "39f9d203-1c02-397d-a713-6f7ca0f9d354",
                                "text": "It was full of heartbreak, and Katy was too unobserving to notice how round and steady and commercial the penmanship was, and how large and fine were the flourishes."
                            },
                            {
                                "example_id": "8c8fbbb2-9dc2-47fe-97a9-66e899a883cc",
                                "sense_id": "39f9d203-1c02-397d-a713-6f7ca0f9d354",
                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                            },
                            {
                                "example_id": "0a451ded-d9b9-44f7-9e14-c61fb9e84038",
                                "sense_id": "39f9d203-1c02-397d-a713-6f7ca0f9d354",
                                "text": "Then she looked at Chase and winked, with a meaning nod at the unobserving Deppingham."
                            }
                        ]
                    }
