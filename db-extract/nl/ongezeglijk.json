                "senses": [
                    {
                        "sense_id": "3fd70675-3449-34ce-b603-aa0257c8af71",
                        "entry_id": "b9267b82-e58a-39e4-ba15-aa6483c7e11f",
                        "glosses": [
                            "van een persoon (meestal een kind) dat je hem niets kunt zeggen omdat hij toch niet luistert en geboden niet wil opvolgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e1cab3-b64f-4890-9a69-da6e7276896c",
                                "sense_id": "3fd70675-3449-34ce-b603-aa0257c8af71",
                                "text": "Je hebt nog voetballers die trouw blijven aan zichzelf. Radja Nainggolan, ongeveer even eigenzinnig. Hij eet nog liever zijn ballen op dan voor Juve te gaan voetballen en rookt zijn sigaret als híj dat wil en waar híj dat wil. In Rome dus of ergens of op een balkon. Sommige coaches leiden daaruit af dat hij ook op het veld ongezeglijk is."
                            },
                            {
                                "example_id": "dbdca257-939a-497f-b4d1-c94f47266b81",
                                "sense_id": "3fd70675-3449-34ce-b603-aa0257c8af71",
                                "text": "Een vat vol tegenstrijdigheden. Zo kan het Nederlands onderwijs worden gekenschetst. Enerzijds doen de leerlingen het goed in vergelijking met hun leeftijdsgenoten elders in Europa en worden ze op school adequaat toegerust voor de arbeidsmarkt. Anderzijds zijn die leerlingen gedesinteresseerd en ongezeglijk."
                            }
                        ]
                    }
                ],
