                "senses": [
                    {
                        "sense_id": "b47f78e0-22b3-3255-b9fd-7c32d6b0c564",
                        "entry_id": "207505c5-6289-32b4-bd1a-a02a018a3f17",
                        "glosses": [
                            "weibliche Person oder Institution, die das von einem anderen Gelieferte oder Produzierte gegen eine Gegenleistung annimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7868f63-31d1-4e0b-821f-5cf722473eeb",
                                "sense_id": "b47f78e0-22b3-3255-b9fd-7c32d6b0c564",
                                "text": "Die Abnehmerin verpflichtet sich, die Waren zeitnah gekühlt einzulagern."
                            },
                            {
                                "example_id": "e0a31200-f531-4ee9-817b-5314ebb4b966",
                                "sense_id": "b47f78e0-22b3-3255-b9fd-7c32d6b0c564",
                                "text": "Die GmbH des Beschuldigten trat als Abnehmerin auf."
                            },
                            {
                                "example_id": "4312e09c-b96f-47ff-bae2-4606460ace06",
                                "sense_id": "b47f78e0-22b3-3255-b9fd-7c32d6b0c564",
                                "text": "Meine Nachbarin war eine dankbare Abnehmerin der Äpfel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
