                "senses": [
                    {
                        "sense_id": "a1c919ea-cbe5-3ddf-adcb-f40391148034",
                        "entry_id": "3c63424b-17d3-35e4-bb97-f421367f9a43",
                        "glosses": [
                            "Wolke, die die Form eines Pilzes hat und beispielsweise nach einer nuklearen Explosion entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39e0334-997e-4af2-a8c5-0eac25f403a8",
                                "sense_id": "a1c919ea-cbe5-3ddf-adcb-f40391148034",
                                "text": "Die maximale Höhe der Pilzwolke hängt vor allem von der Explosionsenergie, ferner auch von der Detonationshöhe und von der Wetterlage ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9b4caf7-aaf1-4f5e-bb90-0e29a5bbffc5",
                        "source_entry_id": "3c63424b-17d3-35e4-bb97-f421367f9a43",
                        "source_sense_id": "a1c919ea-cbe5-3ddf-adcb-f40391148034",
                        "source_sense_description": "Wolke, die die Form eines Pilzes hat und beispielsweise nach einer nuklearen Explosion entsteht",
                        "target_lang_word": "mushroom cloud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mushroom cloud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f31f221e-75d9-3a08-9323-a63703cbf436",
                                        "entry_id": "376a718c-fb1c-358a-9468-f1776d87db13",
                                        "glosses": [
                                            "A large cloud of smoke, flame and debris that rises into the sky as a result of a large explosion, especially after a nuclear explosion, characterized by a long shaft rising from the ground into a much-larger or more-spread-out top, reminiscent of a mushroom in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a252fff-d4d9-495c-9ee8-18f3846b8d9f",
                                                "sense_id": "f31f221e-75d9-3a08-9323-a63703cbf436",
                                                "text": "This is Radio Clash underneath a mushroom cloud"
                                            },
                                            {
                                                "example_id": "f8b97fcd-64ed-4f5e-b996-20136e7b88f3",
                                                "sense_id": "f31f221e-75d9-3a08-9323-a63703cbf436",
                                                "text": "It's Christmas at ground zero / There's panic in the crowd / We can dodge debris / While we trim the tree / Underneath a mushroom cloud"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a0ff1b-b0e4-40e1-acf6-a8c5c9220f5b",
                        "source_entry_id": "3c63424b-17d3-35e4-bb97-f421367f9a43",
                        "source_sense_id": "a1c919ea-cbe5-3ddf-adcb-f40391148034",
                        "source_sense_description": "Wolke, die die Form eines Pilzes hat und beispielsweise nach einer nuklearen Explosion entsteht",
                        "target_lang_word": "paddenstoelwolk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paddenstoelwolk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "85236cff-768a-3d60-8412-56adc580b00e",
                                        "entry_id": "a7decc71-e0d9-3520-a612-c8d1865d9f02",
                                        "glosses": [
                                            "wolk met de vorm van een paddenstoel zoals deze ontstaat na de explosie van een atoombom of vulkaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a28450c-f260-4853-9f4a-046db49d89aa",
                                                "sense_id": "85236cff-768a-3d60-8412-56adc580b00e",
                                                "text": "Toen hij in de richting van een ande- 152 re terminal leunde keek de natuurkundige die erachter zat op en zei: 'Meneer de president, er is geen paddenstoelwolk, als u die soms zoekt."
                                            },
                                            {
                                                "example_id": "9d6dc090-f4de-4789-a26f-780f07ddbefa",
                                                "sense_id": "85236cff-768a-3d60-8412-56adc580b00e",
                                                "text": "Alles wat we nu zo gemakkelijk kunnen visualiseren wanneer zich een explosie voordoet - de paddenstoelwolk, de ineenzijgende gebouwen, de regen van grijs stof wordt voor ons gezien door het oog van een camera."
                                            },
                                            {
                                                "example_id": "8ac543f3-e1b2-4df6-bf5f-6d8639c815be",
                                                "sense_id": "85236cff-768a-3d60-8412-56adc580b00e",
                                                "text": "De beelden van de paddenstoelwolk die opsteeg boven het atol Mururoa leidden steeds vaker tot internationale protesten. In 2010 maakte de Franse regering honderden miljoenen euro's vrij om de bewoners van Frans-Polynesië te compenseren. Het geld was ook bestemd voor Algerije, waar eveneens kernproeven werden gehouden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
