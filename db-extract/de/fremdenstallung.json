                "senses": [
                    {
                        "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                        "entry_id": "4a37ec8c-b761-30ff-a12f-09972f63f0a4",
                        "glosses": [
                            "Unterstell- und Versorgungsmöglichkeit für fremde Reit- und Zugtiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b2c727-3ca4-4a1c-a042-cc2f5777af4f",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Den nördlichen Außenhof riegeln vom westlichen Außenhof zwei Gebäude ab, die als Fremdenstallung und Fahrzeugremise dienten.“"
                            },
                            {
                                "example_id": "1b76efec-eb9e-407d-bba5-c28ffe4d6786",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Halt und Einkehr wurde gleichfalls an bestimmten Herbergen gemacht, die mächtige Fremdenstallungen hatten.“"
                            },
                            {
                                "example_id": "a460efdd-b290-410c-a4d9-668b73d9e158",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Kam ein fremdes Pferd herein — was oft genug vorkam, nicht nur in der Fremdenstallung —, so redete er mit ihm, freundlich, in gemütlichem Ton, gab ihm einen lustigen Namen, […]“"
                            },
                            {
                                "example_id": "9c805021-0151-4f8d-9224-bf604b721c09",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Sie hatte das Geld mitgebracht und konnte es ihrem Mann leicht beibringen, daß man auch eine große Fremdenstallung haben müsse an der Straße hin.“"
                            },
                            {
                                "example_id": "9f3e5324-789e-4dd2-8e77-1bf680557544",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Die Gendarmen der Hauptstation Eggenfelden erstellten über den Aufenthalt solcher Korbmacher in der Fremdenstallung einer Gastwirtschaft im niederbayerischen Rottal folgenden Rapport: […]“"
                            },
                            {
                                "example_id": "bef5330b-07eb-4808-8c85-46edef08451f",
                                "sense_id": "4301bd3f-9040-372c-94f1-09429882fd3d",
                                "text": "„Eigene Fremdenstallungen der Gaststätten bereiteten den Pferden bei einem guten Hafer und einem Bündel Heu ein paar gemütliche Stunden während die Herren Ökonomen eine oder mehrere Maß von dem süffigen Gerstensaft schlürften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
