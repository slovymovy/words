                "translations": [
                    {
                        "translation_id": "d3decbc7-5046-4898-a038-8cfa2f52e839",
                        "source_entry_id": "b285ae62-0759-3b75-9f66-3a1e525c3371",
                        "source_sense_id": "95a69852-5e16-35cb-a960-dfa947fa6c7f",
                        "target_lang_word": "disintegration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disintegration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80cf7596-fa67-3a28-b4a2-4abe138c5e74",
                                        "entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                                        "glosses": [
                                            "A process by which anything disintegrates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68366ac3-d597-47c4-bf94-bf60239ee8d2",
                                                "sense_id": "80cf7596-fa67-3a28-b4a2-4abe138c5e74",
                                                "text": "A Pan American World Airways, Inc., B-707-321B, N761PA, experienced an explosive disintegration of the third stage turbine disk of the No. 4 engine at approximately 1410 P.d.t, June 28, 1965. The accident occurred shortly after takeoff from San Francisco International Airport, San Francisco, California, at an altitude of about 800 feet above the ground. Disintegration of the turbine disk was followed by a fire in the No. 4 engine area and an explosion in the outboard reserve fuel tank. The No. 4 engine and approximately 25 feet of the right outer wing separated from the aircraft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7e3099-f6bb-3fc3-9ee7-4fd5f5706aa9",
                                        "entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                                        "glosses": [
                                            "The condition of anything which has disintegrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4932d3d-e9c0-3a6c-9ede-39b6c60b72b6",
                                        "entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                                        "glosses": [
                                            "The wearing away or falling to pieces of rocks or strata, produced by atmospheric action, frost, ice, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40ce7ad8-2617-3d1e-a86d-78611b3a1651",
                                        "entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                                        "glosses": [
                                            "The process of radioactive decay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a13fb9a2-3469-34ba-b514-d55c3299aafb",
                                        "entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                                        "glosses": [
                                            "The process of radioactive decay.",
                                            "The radioactive decay of a single atom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52dc9c0b-32d0-494a-b3d3-5702428fac56",
                                                "sense_id": "a13fb9a2-3469-34ba-b514-d55c3299aafb",
                                                "text": "The sample exhibited an activity of three disintegrations per second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "555a7c1a-615b-455d-9dd1-10509bef68e1",
                        "source_entry_id": "b285ae62-0759-3b75-9f66-3a1e525c3371",
                        "source_sense_id": "95a69852-5e16-35cb-a960-dfa947fa6c7f",
                        "target_lang_word": "désintégration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désintégration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                        "entry_id": "29df17d8-7c54-3582-ba49-1f9f25a7516e",
                                        "glosses": [
                                            "Action de se désintégrer ; le fait de se désintégrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a52bda0-ec90-48d0-a3eb-0a72945da8c0",
                                                "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                                "text": "La désintégration des structures étatiques, en Autriche-Hongrie ou en Allemagne, produit les mêmes effets suicidigènes. Ces personnalités fragiles ont besoin de cadres sociaux rigides."
                                            },
                                            {
                                                "example_id": "c47851e1-e20a-4fac-bb1b-1e9a06144b55",
                                                "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                                "text": "De plus, une ligne est restée connectée pendant 45 minutes après la désintégration complète de l’avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85302dc8-5bfc-32a1-ade6-288bb5033fd5",
                                        "entry_id": "29df17d8-7c54-3582-ba49-1f9f25a7516e",
                                        "glosses": [
                                            "Destruction spontanée ou provoquée du noyau atomique d’un élément chimique, qui se transforme en d’autres éléments de masse atomique plus faible, avec libération d’énergie sous forme de radiations."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bcb30d9-0295-47e5-9e42-15e81da29319",
                        "source_entry_id": "b285ae62-0759-3b75-9f66-3a1e525c3371",
                        "source_sense_id": "95a69852-5e16-35cb-a960-dfa947fa6c7f",
