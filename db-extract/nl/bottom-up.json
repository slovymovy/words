                                        "entry_id": "3b4fcb7c-f41a-3d45-a9d3-0d6002c76296",
                                        "glosses": [
                                            "Of or relating to a hierarchical system that progresses from multiple small subunits to a single, large basic unit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3781ef8-2cfc-4a2e-b4fe-aa6fa142f04a",
                                                "sense_id": "681b72d6-2990-3622-8d64-6708ba09eb1e",
                                                "text": "The software is checked very carefully in a bottom-up fashion. First, each new line of code is checked, then sections of code or modules with special functions are verified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8166dc9f-b907-35fc-955f-f1ab0d91c61c",
                                        "entry_id": "3b4fcb7c-f41a-3d45-a9d3-0d6002c76296",
                                        "glosses": [
                                            "Of or relating to a hierarchical system in which lower levels influence higher levels."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f3690ca-7ae9-4e17-a32a-f66fc8746c84",
                                                "sense_id": "8166dc9f-b907-35fc-955f-f1ab0d91c61c",
                                                "text": "bottom-up management"
                                            },
                                            {
                                                "example_id": "a6ff8bf2-c772-44b2-b401-6e88df178e2d",
                                                "sense_id": "8166dc9f-b907-35fc-955f-f1ab0d91c61c",
                                                "text": "The papacy has for centuries brought with it a place on the world stage. Francis, who from the off gave the impression of being a man in a hurry, was determined to use that platform to push a bottom-up agenda for the world."
                                            }
                                        ]
