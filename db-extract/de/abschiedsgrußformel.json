                "senses": [
                    {
                        "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                        "entry_id": "3674feaa-194c-3bdc-92d9-149221d33555",
                        "glosses": [
                            "formelhaft verwendeter Abschiedsgruß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a83c5f2-d894-4270-99d8-a3793dcc5933",
                                "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                                "text": "In der deutschen Sprache werden eine Vielzahl Abschiedsgrußformeln unterschiedlicher Art verwendet."
                            },
                            {
                                "example_id": "c6cb9704-a16f-4c97-b4ec-4e573155d88c",
                                "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                                "text": "„Auch in der Abschiedsgrußformel lässt sich die Subjektsform um diese Zeit nicht mehr belegen:…“"
                            },
                            {
                                "example_id": "70cc332d-8ccd-421c-a317-f602a2a38211",
                                "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                                "text": "„…;seit einiger Zeit hat sich aber eine nominale Wendung mit ‚dèmen‘ herausgebildet, und zwar die inzwischen sehr häufig gebrauchte Abschiedsgrußformel: ‚Adan on dèmen!‘ (Bis morgen!)“"
                            },
                            {
                                "example_id": "425259a7-100a-448e-9d3f-c064941c1326",
                                "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                                "text": "„Die persönliche Unterschrift sollte immer handschriftlich ausgeführt werden und sich unter der Abschiedsgrußformel und über dem gedruckten Namen befinden.“"
                            },
                            {
                                "example_id": "2e7b385e-6308-478a-afa4-a3f7c7118e3f",
                                "sense_id": "47c7c0d2-6819-38c0-9e1d-7c9c99b00ac9",
                                "text": "„Die gewöhnliche Abschiedsgrußformel war: ‚Gehe hin in Frieden, d. i. im Segen!‚“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
