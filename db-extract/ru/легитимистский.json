                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ef21b87-6af3-4d0d-8ea8-1a086013c58f",
                        "source_entry_id": "f6d6b6c3-0528-3ee4-834c-96174d93b5a5",
                        "source_sense_id": "f2eda815-715d-38c0-bc62-14e828d0329d",
