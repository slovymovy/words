                "senses": [
                    {
                        "sense_id": "7eb74933-fe02-3430-8c9d-daa9d0e6e552",
                        "entry_id": "2878b854-f7d5-3f19-8eff-479449de0672",
                        "glosses": [
                            "Investir en réaction à un échec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61dd4cf0-f6a3-40c2-acfe-856bc4d8258f",
                                "sense_id": "7eb74933-fe02-3430-8c9d-daa9d0e6e552",
                                "text": "De la même façon, comme nous le verrons plus loin, Ferenczi, à l'époque, a dû contre-investir fortement sa haine culpabilisante à l'égard de Freud."
                            },
                            {
                                "example_id": "1f636544-edae-4417-9703-c9868717149d",
                                "sense_id": "7eb74933-fe02-3430-8c9d-daa9d0e6e552",
                                "text": "On comprend que le fétiche sert lui-même à refouler et à contre-investir ; devons-nous dire, à la suite de Freud, « l'affect » ? lié à la perception des organes génitaux féminins."
                            }
                        ]
                    }
