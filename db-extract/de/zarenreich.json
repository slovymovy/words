                ],
                "senses": [
                    {
                        "sense_id": "7a12fd85-ba7a-35cc-b349-ded0d8f21a5f",
                        "entry_id": "d87dc960-eb7e-3b6e-b36a-ee47211651e1",
                        "glosses": [
                            "Gebiet, in dem ein Zar herrscht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4bae9cf2-52f4-470e-83bf-7c18f1e0602e",
                                "sense_id": "7a12fd85-ba7a-35cc-b349-ded0d8f21a5f",
                                "text": "„Allfälliger Kontrahent und eventueller Partner der Donaumonarchie in ihrer Balkanpolitik war in erster Linie das Zarenreich.“"
                            },
                            {
                                "example_id": "547ee6df-48d9-420d-9b76-88dc462a17b9",
                                "sense_id": "7a12fd85-ba7a-35cc-b349-ded0d8f21a5f",
                                "text": "„Trotz der unmittelbaren Nähe zur Grenze des Zarenreichs herrschte selbst in Ostpreußen längst wieder Normalität.“"
                            },
                            {
                                "example_id": "a9aeb0d1-73d9-4a41-9923-929877a6d6af",
                                "sense_id": "7a12fd85-ba7a-35cc-b349-ded0d8f21a5f",
                                "text": "„Nur im Zarenreich wollte nichts Großes geschehen.“"
                            },
                            {
                                "example_id": "0785087d-cc59-4eb6-81db-a9b6d2dc76be",
                                "sense_id": "7a12fd85-ba7a-35cc-b349-ded0d8f21a5f",
                                "text": "„Eine andere trifft den Sohn einer reichen Witwe, die vor den Unruhen im Zarenreich auf einen Landsitz nahe bei Tewjes Dorf geflohen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
