                        "target_lang_word": "имажи́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "имажи́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fde68f53-ca1f-3d10-9e44-8d48ce1b47a7",
                                        "entry_id": "47511f12-6079-3b08-b0ad-e4c94c7c97f7",
                                        "glosses": [
                                            "филол. модернистское течение в английской и американской поэзии в начале XX века (с 1909 по 1917 год), последователи которого стремились достичь наивысшей точности образа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe8b475-aeed-4ca8-bf70-1f12923b0e1c",
                                                "sense_id": "fde68f53-ca1f-3d10-9e44-8d48ce1b47a7",
                                                "text": "Значение имажизма определяется не столько поэзией, созданной самими имажистами, – никто толком не знал, что это такое – поэт-имажист, – а скорее тем, что имажизм открыл путь для дальнейшего развития поэзии, решительно отвергнув сентиментальное викторианское многословие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
