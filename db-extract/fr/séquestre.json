        "fr-extract.jsonl": [
            {
                "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                "word": "séquestre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ecdae472-2587-479d-99c9-290a1297cfd4",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "tags": [
                            "plural"
                        ],
                        "form": "séquestres"
                    },
                    {
                        "form_id": "05a35bdc-18a8-4fee-9fbd-770c1c647a55",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "tags": [],
                        "form": "sequestre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ff84bf8-0b3f-3d9e-99e2-5e8d3701b2d0",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "État d’une chose litigieuse remise en main tierce par ordre de justice ou par convention des parties, jusqu’à ce qu’il soit réglé et jugé à qui elle appartiendra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8061024b-6e51-4833-ac8c-885ac4467048",
                                "sense_id": "7ff84bf8-0b3f-3d9e-99e2-5e8d3701b2d0",
                                "text": "Le séquestre est la mise sous main de justice d'objets destinés à désintéresser les créanciers (voir décision du Conseil fédéral du 18. avril 1893, recours Stutz, Archives, II, 72) ; aussi peuvent euls être séquestrés aux termes .de l'art. 275 qui vise les art. 92 et 93 L.P. des objets saisissables."
                            },
                            {
                                "example_id": "5f900d12-5f7e-4a6b-9bca-6800d9f2e337",
                                "sense_id": "7ff84bf8-0b3f-3d9e-99e2-5e8d3701b2d0",
                                "text": "Comme Madame ne l’ignorait pas, les biens de Monsieur de Battenbourg avaient été confisqués après son exécution. Ils étaient encore sous séquestre, la vente au profit de l’État ne devant avoir lieu qu’après le payement des dettes aux particuliers."
                            },
                            {
                                "example_id": "2c0ca2b0-4ef1-42df-a0a7-fdefb7f6cb65",
                                "sense_id": "7ff84bf8-0b3f-3d9e-99e2-5e8d3701b2d0",
                                "text": "Le scepticisme subjectif a pu m’obséder par moments ; il ne m’a jamais fait sérieusement douter de la réalité ; ses objections sont par moi tenues en séquestre dans une sorte de parc d’oubli ; je n’y pense jamais."
                            },
                            {
                                "example_id": "5118cc3a-0899-4248-a577-3df577168ef2",
                                "sense_id": "7ff84bf8-0b3f-3d9e-99e2-5e8d3701b2d0",
                                "text": "Saint-Augustin venait être mis en séquestre, je ne sais pour quelle raison, et on ne pouvait y entrer sans une autorisation spéciale de l’administration."
                            }
                        ]
                    },
                    {
                        "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Dépositaire, celui entre les mains de qui les choses sont mises en séquestre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa5f94d-7e6e-4205-911d-bab4d0d4391b",
                                "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                                "text": "Administrateur séquestre, dépositaire séquestre, séquestre de guerre."
                            },
                            {
                                "example_id": "96f224fd-7391-4d6a-8034-45e8edf59425",
                                "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                                "text": "Le séquestre n’a, en principe, que les pouvoirs d’administration nécessaires à la conservation de la chose; le juge lui-même ne peut pas élargir ces pouvoirs. Lorsque les actes qu’il fait rentrent dans ses pouvoirs, le séquestre représente le propriétaire des biens séquestrés, et le lie ainsi que pourrait le faire tout mandataire de justice."
                            },
                            {
                                "example_id": "10543dba-7a3e-4088-b192-c0edfdd8d114",
                                "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                                "text": "Il faut choisir un séquestre solvable."
                            },
                            {
                                "example_id": "af7ae728-b3d0-44c6-8730-9b0ff419c947",
                                "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                                "text": "Contraindre le séquestre."
                            },
                            {
                                "example_id": "ccceb90e-7535-4b3f-8a57-a23511812afc",
                                "sense_id": "c46ebafa-d809-3d06-85c0-65dd3897ac63",
                                "text": "Décharger le séquestre."
                            }
                        ]
                    },
                    {
                        "sense_id": "99644b17-796d-3448-86a2-f50e917debe2",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "La chose séquestrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b304c759-1c38-471e-a290-c7f020d6cb0c",
                                "sense_id": "99644b17-796d-3448-86a2-f50e917debe2",
                                "text": "On a mis un gardien infidèle qui a pillé le séquestre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f714c04a-ae0b-330e-b67e-70621d068139",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Main mise d’un État sur des territoires ou des biens appartenant à un autre État ou à ses ressortissants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4d2eacb5-2dcc-396e-9d84-f38de7c600d6",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "État d’une personne que l’on prive illégalement et arbitrairement de sa liberté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11751cf1-652c-4d1c-a439-a52b28c7bbb4",
                                "sense_id": "4d2eacb5-2dcc-396e-9d84-f38de7c600d6",
                                "text": "Les parents demeurèrent d’accord de mettre cette fille en séquestre dans tel monastère, chez telle dame."
                            }
                        ]
                    },
                    {
                        "sense_id": "651e576b-51d8-3501-a0e9-1760d9490ebe",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Lieu où l’on enfermait un enfant (collégien, apprenti) par mesure de punition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7b1878-f37d-41c8-b68c-67c5875f130b",
                                "sense_id": "651e576b-51d8-3501-a0e9-1760d9490ebe",
                                "text": "[…] quatre jours de séquestre, mon petit !"
                            },
                            {
                                "example_id": "ce65aa8b-8461-4718-a977-66d46b65992b",
                                "sense_id": "651e576b-51d8-3501-a0e9-1760d9490ebe",
                                "text": "Vous le ferez arrêter [votre enfant qui a filé] par les gendarmes, mettre au séquestre ou au cachot."
                            }
                        ]
                    },
                    {
                        "sense_id": "495a176c-df79-3b20-b71e-dc385517a2e2",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Personne qui assure la garde d’une personne séquestrée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e14ebe94-5267-39a4-8daf-7f7791fd2cd1",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Celui chez qui on déposait l’argent destiné à acheter des juges, des électeurs."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "778b0a90-e83f-3523-ada1-ed3598578c3b",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Portion nécrosée d’un tissu cellulaire, notamment fragment d’os, qui se trouve enclavé dans les tissus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843f82c9-4486-48ac-a676-a94abe1cd951",
                                "sense_id": "778b0a90-e83f-3523-ada1-ed3598578c3b",
                                "text": "Séquestre pulmonaire."
                            },
                            {
                                "example_id": "cd83c76c-6b20-486d-8c2d-53bb6a109590",
                                "sense_id": "778b0a90-e83f-3523-ada1-ed3598578c3b",
                                "text": "Les cartilages peuvent se détacher en partie ou en totalité sous la forme de coques, qui jouent le rôle de corps étrangers, isolement qui constitue une sorte de séquestre."
                            },
                            {
                                "example_id": "47ca9873-01af-4f07-a891-45f2208bbdcb",
                                "sense_id": "778b0a90-e83f-3523-ada1-ed3598578c3b",
                                "text": "Un séquestre cornéen est une partie de cornée « morte » qui est ensuite rejeté par la cornée saine restante. La plupart des séquestres affectent le centre de la cornée."
                            }
                        ]
                    },
                    {
                        "sense_id": "81979dac-2c14-3d02-9102-f24d67545951",
                        "entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "glosses": [
                            "Médicament utilisé pendant une opération et conservé pour analyse ultérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea3578e-76bd-41a1-a96f-aabcedc9456a",
                                "sense_id": "81979dac-2c14-3d02-9102-f24d67545951",
                                "text": "Les enquêteurs de la brigade criminelle se sont donc appuyés sur d’autres éléments pour identifier un \"mode opératoire\" : saisie des dossiers médicaux et des \"séquestres\" (les médicaments conservés après les interventions), consultation des résultats d’autopsies, exhumation de certains corps, auditions des familles et des médecins, \"le soir tard\", quand ils n’étaient pas au bloc…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "201c36a1-7cc0-4ec8-868e-c679ce50d33a",
                        "source_entry_id": "528c69e2-122a-300f-9867-946dcba30b28",
                        "target_lang_word": "Beschlagnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschlagnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e72c7a9b-3234-350b-a89f-a02cb09b7823",
                                        "entry_id": "822b6c9f-43ff-353d-86b5-44707a0603b3",
                                        "glosses": [
                                            "Entzug von Besitztum aufgrund amtlicher Anweisung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6952d239-5bf2-4afa-94d5-f93b6c65d8bb",
                                                "sense_id": "e72c7a9b-3234-350b-a89f-a02cb09b7823",
                                                "text": "„Die erste populäre Handlung der Regierung ist die Beschlagnahme der gehamsterten Lebensmittel, es bleibt bei der Beschlagnahme.“"
                                            },
                                            {
                                                "example_id": "22484076-6176-44a7-b170-02544cd62063",
                                                "sense_id": "e72c7a9b-3234-350b-a89f-a02cb09b7823",
                                                "text": "„In der Zwischenzeit stieg der Salzpreis so sehr, dass sich die Beschlagnahme gar als Vorteil für die Händler erwies.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
