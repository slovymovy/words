                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vérifiez l'<w>alignement</w> des étagères avant de percer le mur pour poser les fixations."
                        },
