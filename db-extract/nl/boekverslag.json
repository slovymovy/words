                        "examples": [
                            {
                                "example_id": "32616797-37cd-48a5-acbd-1eca7035bc29",
                                "sense_id": "00807f4e-ed35-35fb-a130-47628ab8cfe9",
                                "text": "Williams had de Mount Vernon High School vrijwel afgerond, maar moest nog één boekverslag inleveren. Dat weigerde ze. Ze had het betreffende boek een paar jaar eerder al gelezen en vond het niet leuk. Ze had geen zin om het boek voor een verslag nogmaals te lezen."
                            },
                            {
                                "example_id": "6c1610aa-d95b-4c1a-80e1-57940bb0d6d1",
                                "sense_id": "00807f4e-ed35-35fb-a130-47628ab8cfe9",
                                "text": "McEwan: \"Ik heb zijn boekverslag niet gelezen, maar blijkbaar was de docent het niet met hem eens.\" Greg kreeg het verslag namelijk niet terug met een verwachte pluim, maar met een C+. Dat is omgerekend naar Nederlandse cijfers zoiets als een 6,5."
                            }
