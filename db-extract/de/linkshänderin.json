                                    {
                                        "sense_id": "0f3ac5e0-c3b4-3490-8ccf-98df2cb334af",
                                        "entry_id": "fcb37e12-4406-3d90-8851-1199741d1bad",
                                        "glosses": [
                                            "One who is left-handed, especially in sports."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0456eeff-512f-49ab-98d1-04c190619d82",
                                                "sense_id": "0f3ac5e0-c3b4-3490-8ccf-98df2cb334af",
                                                "text": "Never touch the food until your host has said grace (\"Bismillah\") and then not till he has told you to. Eat only with your right hand—it is considered very rude to use the left, even if you are a southpaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d318b7f-ba8a-326b-99e8-dd92a3701ce2",
                                        "entry_id": "fcb37e12-4406-3d90-8851-1199741d1bad",
                                        "glosses": [
                                            "One who is left-handed, especially in sports.",
                                            "A left-handed pitcher."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db5d47a-ce96-4027-a93a-1f3eedc4c24c",
                                                "sense_id": "6d318b7f-ba8a-326b-99e8-dd92a3701ce2",
                                                "text": "Since home plate is generally in the southwest corner to avoid glare in the batter's eyes, a southpaw's pitching hand is to the south."
                                            },
                                            {
                                                "example_id": "05b75125-926f-437a-a294-61441c08714b",
                                                "sense_id": "6d318b7f-ba8a-326b-99e8-dd92a3701ce2",
                                                "text": "Eleanor would pitch, probably southpaw. Rosalind was outfield, wonderful hitter, Clara first base, maybe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0bb1a7-50a6-3570-8657-c3cc821c1eff",
                                        "entry_id": "fcb37e12-4406-3d90-8851-1199741d1bad",
                                        "glosses": [
                                            "One who is left-handed, especially in sports.",
                                            "A boxer who leads with the right hand and guards with the left."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7c379f-c099-4bdf-8666-7897da5e68da",
                        "source_entry_id": "53745310-9f03-3cd0-bc99-2855a6fd311c",
