                "senses": [
                    {
                        "sense_id": "f0d4021c-372e-3128-94e0-30a5cd3e0a42",
                        "entry_id": "06803286-1e41-3406-a1c9-4d037489e353",
                        "glosses": [
                            "Form des Betrugs, bei der der Täter sich als in Not geratener Enkel des Betrugsopfers ausgibt und um finanzielle Hilfe (oder andere Beute) bittet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcb7776-03f9-4db1-83e4-fd8e6a6d841d",
                                "sense_id": "f0d4021c-372e-3128-94e0-30a5cd3e0a42",
                                "text": "„Sie würden sich wundern, wie oft dieser Enkeltrick funktioniert.“"
                            },
                            {
                                "example_id": "cce9d370-14b8-441f-b4da-81902c5d93d4",
                                "sense_id": "f0d4021c-372e-3128-94e0-30a5cd3e0a42",
                                "text": "„Doch dann habe er sich an den Enkeltrick erinnert, mit dem Betrüger versuchen, älteren Menschen ihre Ersparnisse zu stehlen.“"
                            },
                            {
                                "example_id": "e8450934-38e7-45fc-ba9e-ab7dee381e21",
                                "sense_id": "f0d4021c-372e-3128-94e0-30a5cd3e0a42",
                                "text": "„Das bisschen, was sie gespart und unter ihren Deckchen oder in Keksdosen versteckt hatte, klauten ihr mit einer griechischen Variante des Enkeltricks auch noch dreiste Ganoven.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
