                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anéthique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "347d0738-b7cd-3937-83d5-9df17c1f356f",
                                        "entry_id": "2818f8e2-b995-3836-9b53-47721c90752d",
                                        "glosses": [
                                            "Qui n’est pas concerné par la morale, sans éthique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a184a3-3ebb-4095-81eb-29238d53bb48",
                                                "sense_id": "347d0738-b7cd-3937-83d5-9df17c1f356f",
                                                "text": "La liberté de la recherche est souvent décrite, aujourd’hui, comme l’impératif anéthique de la technique : « il faut faire tout ce qui est possible, toutes les expériences », et cet impératif présuppose avec plus ou moins de force que « rien n’est impossible »…"
                                            },
                                            {
                                                "example_id": "57f07934-8842-4171-ae9b-7afb27d22b65",
                                                "sense_id": "347d0738-b7cd-3937-83d5-9df17c1f356f",
                                                "text": "L’attitude jonassienne est fondamentaliste en ce qu’elle qualifie d’anéthique ou d’anti-éthique, toute conception qui n’accorderait pas de sens et de valeur à l’existence de l’humanité dans le futur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a0c2bb4-ca30-4132-b4e6-8e25aad3314c",
                        "source_entry_id": "73dcde55-8f2f-3083-8a32-dd470e7e51f3",
                        "source_sense_id": "352ace34-93e9-3583-a631-851fc32224c6",
