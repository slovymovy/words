                                        "sense_id": "b78dfaaa-0d14-385a-a915-d324cc4b5d34",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "An officer employed to drive out to troops and transmit back requests for support via a special radio link."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ba3aad-447b-49cc-a601-43ca854255a2",
                                                "sense_id": "b78dfaaa-0d14-385a-a915-d324cc4b5d34",
                                                "text": "A joint RAF/Army staffed Air Support Control (ASC) headquarters was established at each army corps and each armoured division, linked to the forward brigades by a 'tentacle' equipped with two-way wireless telegraphy."
                                            }
