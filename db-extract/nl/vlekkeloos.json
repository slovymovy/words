                        "examples": [
                            {
                                "example_id": "3227f12a-d427-4c36-a29e-6e1aa883a1d4",
                                "sense_id": "68d7114a-b411-335e-bb88-76ad8a22e2b2",
                                "text": "Er kwam een grote rode wijnvlek op het vlekkeloze witte jurkje."
                            },
                            {
                                "example_id": "668828df-09a7-4db2-b746-c3e2bbf1ec2c",
                                "sense_id": "68d7114a-b411-335e-bb88-76ad8a22e2b2",
                                "text": "Ik heb mijn geld altijd makkelijk verdiend. Als ik met behulp van de gemeente uit de criminaliteit wil stappen, moet het vlekkeloos gaan"
                            }
                        ]
                    }
