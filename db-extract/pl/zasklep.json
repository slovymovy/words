                    },
                    {
                        "translation_id": "e1c9f648-784d-4d26-a94e-abeb5dfa2018",
                        "source_entry_id": "88e5cbc1-3c25-3126-bf4d-e218d3b9d267",
                        "source_sense_id": "37a64ccf-beb1-3daf-8ed7-ffaaf4e294cf",
                        "target_lang_word": "Abkapselung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abkapselung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75fe97a6-75d0-393d-8a70-8c78fcdc176b",
                                        "entry_id": "9ef4bedc-6eb0-322f-b58c-dcb14d0bad13",
                                        "glosses": [
                                            "Absonderung, Rückzug von der Außenwelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64aed78f-ac4d-40db-9be6-3e2da27924b2",
                                                "sense_id": "75fe97a6-75d0-393d-8a70-8c78fcdc176b",
                                                "text": "„Dass die Verbleibenden sich in die «innere Immigration» zurückzogen, sich nur in ihren eigenen Kreisen der Klubs und Sportvereine bewegten, wurde von der schwarzen Bevölkerung mit Recht als rassistische Abkapselung aufgefasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbb4be2f-8d9a-4231-ab92-63d0f50d6577",
                        "source_entry_id": "88e5cbc1-3c25-3126-bf4d-e218d3b9d267",
                        "source_sense_id": "68fd5ad8-653b-3c90-b596-6690282c7d73",
                        "target_lang_word": "Verdeckelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d67e87c8-6cda-44f2-b8e5-d21b97117bec",
                        "source_entry_id": "88e5cbc1-3c25-3126-bf4d-e218d3b9d267",
                        "source_sense_id": "68fd5ad8-653b-3c90-b596-6690282c7d73",
                        "target_lang_word": "Deckel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deckel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                        "entry_id": "d9a65814-8bad-399b-937a-1715bc77865b",
                                        "glosses": [
                                            "Vorrichtung zum Abdecken oder Verschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8e68e5-46f3-489d-9ce3-2036e5b708f6",
                                                "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                                "text": "Für diesen Topf brauchen wir einen anderen Deckel."
                                            },
                                            {
                                                "example_id": "380523f5-16ad-4bbe-9910-047d503caa38",
                                                "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                                "text": "„Mit einer Eisenstange, die er in einer Wandnische entdeckte, stemmte er die Deckel zweier Fässer auf.“"
                                            },
                                            {
                                                "example_id": "3b0cf069-dd26-4366-9919-9b1cf4abf29d",
                                                "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                                "text": "„Die Vorstellung, daß Züpfner Marie beim Ankleiden zuschauen könnte oder zusehen darf, wie sie den Deckel auf die Zahnpastatube schraubt, machte mich ganz elend.“"
                                            },
                                            {
                                                "example_id": "5ba9bea6-78d7-4bf2-8f59-6c4ad881777c",
                                                "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                                "text": "„Die alte Dienerin knickste, die Patronin legte den Deckel auf die Suppenschüssel und winkte leicht mit der Hand, der Patron, dessen Schnurrbart noch schwärzer als vordem glänzte, warf einen prüfenden Blick über Tisch und Gast, wobei er das Tischtuch andeutend zurechtzog.“"
                                            },
                                            {
                                                "example_id": "1270653b-c53f-4604-b144-914768b613cc",
                                                "sense_id": "9d0707ba-180c-352d-af1a-140678b93842",
                                                "text": "„Um den Deckel von der Truhe heben zu können, mussten alle vier Schlösser geöffnet, mithin alle vier Schlüsselverwahrer hinzugezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bcacdc6-ec4b-388f-af37-e7288bc24cd9",
                                        "entry_id": "d9a65814-8bad-399b-937a-1715bc77865b",
                                        "glosses": [
                                            "stabiler Einband eines Buches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398dadf8-f07a-4bdc-975a-933019abddf7",
                                                "sense_id": "0bcacdc6-ec4b-388f-af37-e7288bc24cd9",
                                                "text": "Die Deckel dieses Buches haben schon sehr gelitten."
                                            },
                                            {
                                                "example_id": "6098027b-7a1f-464b-a705-21772ca36186",
                                                "sense_id": "0bcacdc6-ec4b-388f-af37-e7288bc24cd9",
                                                "text": "„Unter den ersten Sachen war auch eine Schreibmappe, deren Deckel eine Photographie zeigte, das Bild seiner Schwester.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8b7e9382-47d0-353e-9742-caffe08c5478",
                                        "entry_id": "d9a65814-8bad-399b-937a-1715bc77865b",
                                        "glosses": [
                                            "Hut, Kopfbedeckung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4abcb3b0-da84-48cf-9bf7-d8e85cefb1d1",
                                                "sense_id": "8b7e9382-47d0-353e-9742-caffe08c5478",
                                                "text": "Was hast du denn heute für einen Deckel auf?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a84e764e-dccc-32ad-b2fb-fa067b120551",
                                        "entry_id": "d9a65814-8bad-399b-937a-1715bc77865b",
                                        "glosses": [
                                            "amtliche Kontrollkarte für Prostituierte"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6227e036-c35b-49fe-bc41-43d6ec288056",
                                                "sense_id": "a84e764e-dccc-32ad-b2fb-fa067b120551",
                                                "text": "„Laut Polizei sind derzeit 2200 Prostituierte registriert. „Das ändert sich aber immer wieder“, sagte Polizeisprecher Mario Hejl. „Dafür gibt es drei Kriterien: Erstens müssen sie über 18 Jahre alt sein, zweitens haben sie einen gültigen Bescheid der Bundespolizeidirektion Wien und drittens eine Kontrollkarte der Stadt Wien, den sogenannten Deckel.“”"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
