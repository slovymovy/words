                        "translation_id": "4d76a13e-5ce7-4553-b749-5adfa7acad8f",
                        "source_entry_id": "850df26b-2ca8-3200-af64-eda2885991a4",
                        "source_sense_id": "f4c54887-810d-3b4e-9223-f64119ccc27c",
                        "source_sense_description": "Feststellung einer Krebserkrankung in einem frühen Stadium",
                        "target_lang_word": "cancer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cancer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6666b4c1-ef15-3fc3-9b0d-31e9ab3ca09f",
                                        "entry_id": "8a551021-96e0-37de-bd78-32397ea51b9c",
                                        "glosses": [
                                            "A disease in which the cells of a tissue undergo uncontrolled (and often rapid) proliferation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a2bf93-7717-45ab-8278-3741a4b0e8db",
                                                "sense_id": "6666b4c1-ef15-3fc3-9b0d-31e9ab3ca09f",
                                                "text": "If successful, Edison and Ford—in 1914—would move society away from the[…]hazards of gasoline cars: air and water pollution, noise and noxiousness, constant coughing and the undeniable rise in cancers caused by smoke exhaust particulates."
                                            },
                                            {
                                                "example_id": "074cc32b-a673-4ef5-8956-3b2f42f564f5",
                                                "sense_id": "6666b4c1-ef15-3fc3-9b0d-31e9ab3ca09f",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            },
                                            {
                                                "example_id": "8fc914d0-71e7-4790-b4c3-d30a1576427a",
                                                "sense_id": "6666b4c1-ef15-3fc3-9b0d-31e9ab3ca09f",
                                                "text": "Cancers are common diseases; in the aggregate, they are among the leading causes of death nationally and worldwide, and their incidence is increasing as the population ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba51aea5-f64a-32c3-9dfc-32f7d76e5690",
                                        "entry_id": "8a551021-96e0-37de-bd78-32397ea51b9c",
                                        "glosses": [
                                            "Something damaging that spreads throughout something else."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "164d6473-ddee-4eef-92d7-f2c5b221acc0",
                                                "sense_id": "ba51aea5-f64a-32c3-9dfc-32f7d76e5690",
                                                "text": "The disease of the self runs through my blood; It's a cancer fatal to my soul."
                                            },
                                            {
                                                "example_id": "721d6d90-3e3d-4e48-8a52-7658dc5c6923",
                                                "sense_id": "ba51aea5-f64a-32c3-9dfc-32f7d76e5690",
                                                "text": "Sierra Leone's post-dictator problems are almost absurd in their breadth. It once exported rice; now it can't feed itself. The life span of the average citizen is 39, the shortest in Africa. Unemployment stands at 87 percent and tuberculosis is spreading out of control. Corruption, brazen and ubiquitous, is a cancer on the economy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cancer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9547b060-1bfe-38df-a3af-8b903ad9a5ea",
                                        "entry_id": "1d69bbce-085b-38d7-8c83-d7326bd18af3",
                                        "glosses": [
                                            "Extremely unpleasant and annoying."
                                        ],
