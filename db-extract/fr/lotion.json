        "fr-extract.jsonl": [
            {
                "entry_id": "12529173-c876-30db-8ef3-85692d357573",
                "word": "lotion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9af596c0-3da1-4d15-b864-5822c2634eee",
                        "entry_id": "12529173-c876-30db-8ef3-85692d357573",
                        "tags": [
                            "plural"
                        ],
                        "form": "lotions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bfec4f1-51e8-3600-9b30-62b93f9c5631",
                        "entry_id": "12529173-c876-30db-8ef3-85692d357573",
                        "glosses": [
                            "Action de mouiller, d’imbiber d’un liquide quelque partie du corps pour l’adoucir, l’amollir, la rafraîchir, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0489bf1-2e5c-4e66-88d0-945822a59a60",
                                "sense_id": "7bfec4f1-51e8-3600-9b30-62b93f9c5631",
                                "text": "S'il était nécessaire de prendre un demi-bain ou de faire une lotion totale, ce serait écrit sur l'ordonnance."
                            }
                        ]
                    },
                    {
                        "sense_id": "97c93248-5cf3-3e1b-a115-5dc72c6d275b",
                        "entry_id": "12529173-c876-30db-8ef3-85692d357573",
                        "glosses": [
                            "Liquide qui sert à cet usage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "05f3d4ee-686d-42d1-9b46-a8a763301c4b",
                                "sense_id": "97c93248-5cf3-3e1b-a115-5dc72c6d275b",
                                "text": "Pour les soins de la chevelure on peut encore faire usage de lotions toniques et de lotions antiseptiques."
                            },
                            {
                                "example_id": "60c77aa8-dc95-43ee-a623-e57efa22e5f2",
                                "sense_id": "97c93248-5cf3-3e1b-a115-5dc72c6d275b",
                                "text": "On se baque ensemble, miss et moi. Elle m'oint. Si tu verrais ces crèmes, lotions, onguents qu'elle dispose (c.d.B.) ! Un fourbi formide. Et efficace !"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e99ce50-db26-304d-9d42-6098c12ebb92",
                        "entry_id": "12529173-c876-30db-8ef3-85692d357573",
                        "glosses": [
                            "Action de laver des terres, des cendres ou autres matières, pour en extraire les parties solubles qu’elles contiennent."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6df7b88-de6a-4bac-b4d3-921eeaf0acb3",
                        "source_entry_id": "12529173-c876-30db-8ef3-85692d357573",
                        "target_lang_word": "Lotion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lotion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12172de0-5764-3bd0-b340-d474ca815ba8",
                                        "entry_id": "73d04eb8-f1b6-3805-8f9a-c8900356c8f9",
                                        "glosses": [
                                            "kosmetischer Artikel mit flüssiger Konsistenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355b0ae0-908a-49b5-ba8b-055bb95c9baf",
                                                "sense_id": "12172de0-5764-3bd0-b340-d474ca815ba8",
                                                "text": "„Also zerdrückte er einen Lippenpflegestift zu einer festen Paste, fügte sein persönliches Serum aus antiseptischer Lotion und einer Salbe gegen Mundgeschwüre hinzu und goss das Ganze dann in die Vase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba27cac3-cd10-403a-b29c-d603ed26d452",
                        "source_entry_id": "12529173-c876-30db-8ef3-85692d357573",
