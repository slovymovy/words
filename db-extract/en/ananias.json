                "senses": [
                    {
                        "sense_id": "cc46b616-bfc9-3e55-b827-ef5f912df149",
                        "entry_id": "9432c3c8-d86d-303d-b84e-d5b7a436d0d3",
                        "glosses": [
                            "In the New Testament, any of certain members of the early Christian church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1524f42e-69d8-4367-8fea-c6ca6713945e",
                                "sense_id": "cc46b616-bfc9-3e55-b827-ef5f912df149",
                                "text": "But Peter said, Ananias, why hath Satan filled thine heart to lie to the Holy Ghost, and to keep back part of the price of the land?"
                            },
                            {
                                "example_id": "f3db6023-0e08-496e-af31-8d432bbec3fa",
                                "sense_id": "cc46b616-bfc9-3e55-b827-ef5f912df149",
                                "text": "And hath seen in a vision a man named Ananias coming in, and putting his hand on him, that he might receive his sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "25c87af9-29f7-3291-b8dc-9bea2d37e179",
                        "entry_id": "9432c3c8-d86d-303d-b84e-d5b7a436d0d3",
                        "glosses": [
                            "(with reference to Acts 5.3) A liar."
                        ],
                        "tags": [],
                        "examples": [
                            {
