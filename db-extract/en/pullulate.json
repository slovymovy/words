                    {
                        "translation_id": "f39effb6-444f-4d64-adc9-f3289359aff7",
                        "source_entry_id": "8e7e7b48-706c-3ed1-a6e9-76a68e84c890",
                        "source_sense_description": "to germinate",
                        "target_lang_word": "zich ontwikkelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6546fd0e-8e16-45dd-be87-4b935a88b543",
                        "source_entry_id": "8e7e7b48-706c-3ed1-a6e9-76a68e84c890",
                        "source_sense_description": "to germinate",
                        "target_lang_word": "keimen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keimen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                        "entry_id": "08b2b652-ea63-3be4-bded-606bb8ee7ce4",
                                        "glosses": [
                                            "aus einem Keim wachsen, aus der Erde wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ab11da-d91d-4c7a-8017-0e9b98eaaa3b",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "Man sollte die Töpfe mit Plastikfolie überziehen, bis die Sämlinge gekeimt haben."
                                            },
                                            {
                                                "example_id": "90f72a76-ca76-41c7-8ece-716cdb48b3b1",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Damit der Samen keimt, braucht er nur Wärme und Feuchtigkeit.“"
                                            },
                                            {
                                                "example_id": "1e1797e4-ea3f-42a2-8d78-d9d78b522a5b",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Dass der Samen des sibirischen Leimkrauts auch nach mehreren zehntausend Jahren noch keimen konnte, verdankt sich einer Kette glücklicher Zufälle.“"
                                            },
                                            {
                                                "example_id": "551b3f3c-909d-4383-9061-46e4649cb6b8",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Der Anbau von Kresse ist noch einfacher. Sie keimen beispielsweise schon auf einem nassen Blatt Papier.“"
                                            },
                                            {
                                                "example_id": "45762a14-ad64-4d65-b105-626d6d810f88",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "Damit Gurkensamen keimen, brauchen sie mindestens 20°C, besser 23° oder 24°C."
                                            },
                                            {
                                                "example_id": "9c68429c-4109-4dce-abd1-4922b721f28c",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Nach 7 bis 10 Tagen keimen die Gurken.“"
                                            },
                                            {
                                                "example_id": "598b1767-c8d2-4f9a-b755-1c7b376b1da7",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Bis die ersten Rasensamen keimen, können locker zwei Wochen vergehen.“"
                                            },
                                            {
                                                "example_id": "6b40c161-5f0a-4b13-976c-1a3694f0af11",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„100-jähriger Versuch - Wie lange keimt tiefgekühltes Saatgut?“"
                                            },
                                            {
                                                "example_id": "86a46a6c-d7dd-45c6-886c-7c08d1b4631c",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Wichtig ist, dass das Papier gleichmäßig feucht gehalten wird und die Schale an einem warmen Platz steht. Nach einiger Zeit sollten die Samen dann keimen.“"
                                            },
                                            {
                                                "example_id": "3fc5e7e3-326f-4dd4-865f-6d08293dc039",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Alpenveilchen sind \"Dunkelkeimer\". Nach etwa vier bis sechs Wochen ist die Saat mit ein bisschen Glück gekeimt.“"
                                            },
                                            {
                                                "example_id": "e2b7b787-8407-48fc-8ab4-407046786a40",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Der Salat will nicht keimen? Die Jungpflanzen der Kräutersamen kommen einfach nicht aus der Anzuchterde? Vielleicht handelt es sich bei dem Saatgut um Lichtkeimer.“"
                                            },
                                            {
                                                "example_id": "30a4bf64-7c2b-415c-836b-50c47378d9c7",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "„Der Dill ist nur schlecht oder gar nicht gekeimt.“"
                                            },
                                            {
                                                "example_id": "2c6e4f54-2325-44a3-891e-9110fc82cc9e",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "[Klimakatastophe:] „»Wir haben Mais gesät, aber es war so trocken, er hat nicht mal gekeimt. Ich habe nichts auf dem Feld.«“"
                                            },
                                            {
                                                "example_id": "af1afd41-8712-45fa-8c36-53563ff5c4ff",
                                                "sense_id": "5ee9da1a-64a1-38b0-97d1-63fc88e08708",
                                                "text": "[Bierbrauen:] „In der Mälzerei kommt die Gerste nach dem Weichen in große Keimkästen. In fünf bis sechs Tagen keimt das Korn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                        "entry_id": "08b2b652-ea63-3be4-bded-606bb8ee7ce4",
                                        "glosses": [
                                            "sich zu entwickeln beginnen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb493c9e-752e-4901-ae3d-2710fa8e83b7",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "In ihm keimte der Verdacht, seine Frau könnte fremdgegangen sein."
                                            },
                                            {
                                                "example_id": "e1243a03-b06c-4c67-8e26-6016fa514023",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Nach der Entscheidung des obersten Gerichts Polens keimt der Verdacht, das Land wolle nun die EU verlassen.“"
                                            },
                                            {
                                                "example_id": "9422d7f1-23b2-4065-b4ae-b4a41b5ef94a",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Bei Feist keimte ein Gedanke: ‚Wenn so ein kleiner Laden schon 100 Taschen will, vielleicht gibt es dann ja noch größere Läden, die so was wollen.‘“"
                                            },
                                            {
                                                "example_id": "126cbcef-5839-4615-8216-b6625a70e7f3",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Vor fünf Jahren begann der Förderverein mit den Planungen für das ehrgeizige Projekt – die Idee dafür keimte aber schon viel länger.“"
                                            },
                                            {
                                                "example_id": "86af9c82-8926-4ce6-bc11-28340c308b3c",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "[…] „Aus dem Glauben einer Handvoll unbedeutender Männer und Frauen keimt eine Bewegung, die schon bald den Gang der Welt verändert und das Christentum über den ganzen Erdkreis verbreitet.“"
                                            },
                                            {
                                                "example_id": "ef350125-a2d5-4554-9e65-30b13cb813cc",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„In mir keimte der Wunsch: Vielleicht kann ich ja doch einen Wikinger-Film drehen?“"
                                            },
                                            {
                                                "example_id": "3227f748-1311-4800-90c8-5f0c196a1936",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "[Fußball:] Nach dem Abgang im Juli 2022 von Lewandowski bei den Bayern keimt die leise Hoffnung, dass in der nächsten Saison nach neun Meisterschaften in Folge eine andere Mannschaft deutscher Meister wird."
                                            },
                                            {
                                                "example_id": "c5cd7f68-2584-49e9-86ea-18e9fd56ab6c",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Bei vielen afghanischen Asylbewerbern, die Angst vor einer Abschiebung haben, keimt wohl nun die Hoffnung, doch vorerst bleiben zu können.“"
                                            },
                                            {
                                                "example_id": "442f5c6d-480c-4897-9ffb-a7de8e23f912",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Von der Zeit, als Wladimir Putin im Deutschen Bundestag die Abgeordneten begeisterte, gar die Hoffnung keimte, es könne etwas werden mit einem neuen, modernen Russland - ist nichts geblieben.“"
                                            },
                                            {
                                                "example_id": "0b1648e4-5146-4c98-b95c-5a452c9fdb6c",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "„Erste Hoffnung auf Einigung keimt, das Ziel ist noch nicht erreicht.“"
                                            },
                                            {
                                                "example_id": "512e7e33-1a84-489d-8f3f-738a51470767",
                                                "sense_id": "2960f179-7da4-34a7-ae4a-bf95eb164ccc",
                                                "text": "[Iran – Atomstreit:] „Zuletzt war die Hoffnung gekeimt, dass die USA unter dem nächsten Präsidenten Joe Biden, der in gut zwei Wochen ins Amt eingeführt wird, wieder in den Vertrag zurückkehren könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
