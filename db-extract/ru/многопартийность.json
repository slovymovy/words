                                        "sense_id": "e25b54f2-20f5-3a80-be1b-69db5281c934",
                                        "entry_id": "cabaa19c-bccc-3774-9c1f-6bf723c2f750",
                                        "glosses": [
                                            "Politique autorisant plus d'un parti politique, opposé à la politique du parti-état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1ae4e5-8af7-493c-a293-f6e17d47fc55",
                                                "sense_id": "e25b54f2-20f5-3a80-be1b-69db5281c934",
                                                "text": "Les chefs confrériques, marginalisés pendant la période postcoloniale, firent ainsi leur retour sur la scène politique nationale avec la crise politique régionale et le multipartisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8da807d0-8a79-4c13-b87f-e74fb6732e7c",
                        "source_entry_id": "43b6db0c-4ae3-317c-bf58-84f0c5ff1a22",
                        "source_sense_id": "f60027a5-800c-3059-85ca-7fea4f8f9114",
                        "target_lang_word": "pluripartisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluripartisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                                        "entry_id": "c5867459-8882-391c-9f07-6660a9c905ae",
                                        "glosses": [
                                            "Coexistence de plusieurs partis politiques dans un même État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d32fdbb8-d58b-4a8f-9302-208d8aa0f2d1",
                                                "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                                                "text": "Comment se manifesteront les « dissonances » sociales que provoque l’actuelle révolution technologique ? Dans le Parti, disent certains. Par le pluripartisme, préconisent les autres."
                                            },
                                            {
                                                "example_id": "839a7467-1532-4615-b86e-adf9e10013d7",
                                                "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                                                "text": "L’ouvrir d’emblée à un pluripartisme n’aurait pas abouti à un pluripartisme politique mais, tout simplement à un multipartisme ethnique, c’est-à-dire le contraire d’une unité nationale à construire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
