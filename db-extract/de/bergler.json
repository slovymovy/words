                                "target_senses": [
                                    {
                                        "sense_id": "e6c74167-d521-3188-8775-6a3ce214441c",
                                        "entry_id": "69a58587-7a20-3655-9a2e-faf3e0964a1d",
                                        "glosses": [
                                            "Qui habite les montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61cf182-9a74-4d5d-841f-3aefe148bd30",
                                                "sense_id": "e6c74167-d521-3188-8775-6a3ce214441c",
                                                "text": "J'imagine que le pessimisme grec provient de tribus pauvres, guerrières et monta­gnardes, qui avaient un énorme orgueil aristocratique, mais dont la situation était par contre fort médiocre."
                                            },
                                            {
                                                "example_id": "bd5f7ba8-a246-4a7b-9d4a-616a6bb2e088",
                                                "sense_id": "e6c74167-d521-3188-8775-6a3ce214441c",
                                                "text": "L’endémisme est particulièrement développé dans trois sortes de flores : les flores isolées, les flores montagnardes, les flores insulaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deed833a-e708-31a1-a4b2-69366ecd83a1",
                                        "entry_id": "69a58587-7a20-3655-9a2e-faf3e0964a1d",
