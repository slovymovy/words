                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschiebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e86ce3ae-9e47-366c-a815-9b357c67ff09",
                                        "entry_id": "97176920-3bc8-3173-ae56-790f576fab40",
                                        "glosses": [
                                            "Erzwingung der Ausreisepflicht gegenüber Personen, die dieser nicht freiwillig nachkommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab33792-f07d-4fe6-934d-cb9d7129b101",
                                                "sense_id": "e86ce3ae-9e47-366c-a815-9b357c67ff09",
                                                "text": "Die Abschiebung von Personen ist in einem rechtlichen Verfahren geregelt."
                                            },
                                            {
                                                "example_id": "7cf3da75-3b28-4cb3-ad96-7245d5954619",
                                                "sense_id": "e86ce3ae-9e47-366c-a815-9b357c67ff09",
                                                "text": "„Dort irgendwo warten Greenpeace-Aktivisten auf ihre Abschiebung.“"
                                            },
                                            {
                                                "example_id": "3374636a-05b0-4bda-9874-04e152751a82",
                                                "sense_id": "e86ce3ae-9e47-366c-a815-9b357c67ff09",
                                                "text": "„Unter Androhung von Abschiebehaft und Abschiebung wurde ich aufgefordert, das Land innerhalb einer kurzen Frist zu verlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8a4e488-1246-3dcc-ba54-7f1c32dd4387",
                                        "entry_id": "97176920-3bc8-3173-ae56-790f576fab40",
                                        "glosses": [
                                            "Verwerfung in den geologischen Schichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e84dc4-0e36-4389-a495-9940060e8518",
                                                "sense_id": "e8a4e488-1246-3dcc-ba54-7f1c32dd4387",
                                                "text": "„Drei grundsätzliche tektonische Regimes (rot) mit Spannungsverhältnissen (blau) und den charakteristischen Strukturen (schwarz): Extension mit Abschiebung, Blattverschiebung (Strike-Slip) und Kompression mit der Aufschiebung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b7f4181-0728-46b9-acff-ff2bcb61c61e",
                        "source_entry_id": "4e0c4863-d3a8-396d-9b77-d7473a8cdec0",
                        "source_sense_id": "ab11f41e-cdea-3321-b0df-52a3154cb4c8",
