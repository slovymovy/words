                        "source_sense_id": "5792fb8b-1025-385f-95ae-fe215cf33d44",
                        "source_sense_description": "wechselseitige militärische Aufrüstung zweier oder mehrerer Konkurrenten",
                        "target_lang_word": "course à l’armement",
