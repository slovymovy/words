                            {
                                "target_lang_word": "unoccupied",
                                "target_lang_sense_clarification": "of places, tables, or seats"
                            },
                            {
                                "target_lang_word": "vacant",
                                "target_lang_sense_clarification": "not taken, empty"
                            },
                            {
                                "target_lang_word": "free",
                                "target_lang_sense_clarification": "available for use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b71eedbe-2fed-37df-9c48-c873f98e3f1e",
                    "sense_definition": "Van een functie of betrekking: waarvoor nog niemand is benoemd of aangenomen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vacature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door een tekort aan kandidaten bleef de belangrijke bestuursfunctie lange tijd <w>onbezet</w>.",
                            "target_lang_translations": {
                                "en": "Due to a shortage of candidates, the important board position remained <w>vacant</w> for a long time."
                            }
                        },
                        {
                            "text": "Het bedrijf probeert de <w>onbezette</w> post zo snel mogelijk in te vullen.",
                            "target_lang_translations": {
                                "en": "The company is trying to fill the <w>unfilled</w> post as quickly as possible."
                            }
                        }
                    ],
