                "senses": [
                    {
                        "sense_id": "340d40fc-1871-3493-9ee8-1bab075e8c2c",
                        "entry_id": "cb82dc53-7d42-3002-8bee-1ddd02b015d0",
                        "glosses": [
                            "Coloniser de façon indirecte via des habitudes alimentaires et culturelles comme la consommation de Coca-Cola."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e8f614e-c34f-47fb-9955-bb63b0677f05",
                                "sense_id": "340d40fc-1871-3493-9ee8-1bab075e8c2c",
                                "text": "En novembre 1949, le journal l'Humanité titrait « Serons-nous coca-colonisés ? »."
                            },
                            {
                                "example_id": "f266cf91-9712-4e8c-85ec-164f2170efab",
                                "sense_id": "340d40fc-1871-3493-9ee8-1bab075e8c2c",
                                "text": "Ne vous laissez pas coca-coloniser"
                            },
                            {
                                "example_id": "4e85608c-3162-4587-8d21-627d41d51f0f",
                                "sense_id": "340d40fc-1871-3493-9ee8-1bab075e8c2c",
                                "text": "Je me bats pour qu'elle perdure, mais j'ai peur qu'à brève échéance on soit tous coca-colonisé."
                            }
                        ]
                    }
