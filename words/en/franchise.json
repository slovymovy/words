                    "semantic_group_id": "politics_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government passed a law to extend the <w>franchise</w> to all citizens over eighteen.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло закон о предоставлении <w>избирательного права</w> всем гражданам старше восемнадцати лет.",
                                "zh": "政府通过了一项法律，将<w>选举权</w>扩大到所有十八岁以上的公民。"
                            }
                        },
                        {
                            "text": "Activists fought for decades to ensure the <w>franchise</w> was granted to women.",
                            "target_lang_translations": {
                                "ru": "Активисты десятилетиями боролись за то, чтобы женщинам было предоставлено <w>право голоса</w>.",
                                "zh": "活动家们奋斗了几十年，以确保女性获得<w>选举权</w>。"
                            }
                        }
