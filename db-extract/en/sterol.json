                "senses": [
                    {
                        "sense_id": "83c10e81-2ec4-3522-ac92-7dc38d9a4e56",
                        "entry_id": "0e2b5585-3f74-3d5e-ae54-65ee2c3a92c2",
                        "glosses": [
                            "Any steroid that contains a hydroxyl group in the 3-position of the A-ring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c98ebd6-b213-4bbc-9a75-1fc67c92406a",
                                "sense_id": "83c10e81-2ec4-3522-ac92-7dc38d9a4e56",
                                "text": "Sterols are found in all animal and plant tissue and play an important role in hormone chemistry."
                            },
                            {
                                "example_id": "ba174316-1c89-4f7a-b9c7-2a3e3d2843cd",
                                "sense_id": "83c10e81-2ec4-3522-ac92-7dc38d9a4e56",
                                "text": "Research into marine sterols falls neatly into three chronological periods."
                            },
                            {
                                "example_id": "2cd8b6f5-a363-46bd-ac9d-32c6d9166f0e",
                                "sense_id": "83c10e81-2ec4-3522-ac92-7dc38d9a4e56",
                                "text": "1989, Alain Rahier, Pierre Benveniste, 11: Mass Spectral Identification of Phytosterols, W. David Nes, Edward J. Parish (editors), Analysis of Sterols and Other Biologically Significant Steroids, Harcourt Brace Jovanovich (Academic Press), page 223,\nMass spectrometry (MS) and particularly the combination of mass spectrometry with gas spectrometry (GS/MS) has become an indispensable method for studying plant sterols and their biosynthesis."
                            },
                            {
                                "example_id": "d9d44262-9a49-4ad4-97bb-455215aebda2",
                                "sense_id": "83c10e81-2ec4-3522-ac92-7dc38d9a4e56",
                                "text": "The third major class of lipids is sterols. Sitosterol and stigmasterol are the major sterols found in plant membranes whereas cholesterol and ergosterol are found in small quantities. The primary sterol of yeast and other fungi is ergosterol Several sterol derivatives are found in nature."
                            }
                        ]
                    }
