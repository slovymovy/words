                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce6b7f9-dfcd-3b27-bd9b-bdcfea18cf37",
                                        "entry_id": "c8d2dc4a-518d-3b88-a332-86501808419c",
                                        "glosses": [
                                            "über etwas entlang fliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "890d9641-35a0-417a-a1d4-b044947c3c6e",
                                                "sense_id": "5ce6b7f9-dfcd-3b27-bd9b-bdcfea18cf37",
                                                "text": "Das Flugzeug überflog die Stadt."
                                            },
                                            {
                                                "example_id": "da662219-26a2-404a-98d0-76d625078b83",
                                                "sense_id": "5ce6b7f9-dfcd-3b27-bd9b-bdcfea18cf37",
                                                "text": "Wenn man dem Gewitter nicht ausweichen kann, ist es unter Umständen sicherer, das Gewitter zu überfliegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92a9be6a-2514-3e66-a064-ea4ea1b270b9",
                                        "entry_id": "c8d2dc4a-518d-3b88-a332-86501808419c",
                                        "glosses": [
                                            "(einen Text) schnell und oberflächlich lesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4f078f-eef6-4b24-b5f8-0b6676ac9a16",
                                                "sense_id": "92a9be6a-2514-3e66-a064-ea4ea1b270b9",
                                                "text": "Es hilft, vor der Klausur die Lektionen noch einmal schnell zu überfliegen."
                                            },
                                            {
                                                "example_id": "5aac82bb-ba9c-4ed8-bf92-3c2f6db85ed0",
                                                "sense_id": "92a9be6a-2514-3e66-a064-ea4ea1b270b9",
                                                "text": "Ich komme gleich, ich möchte nur erst kurz die Post überfliegen."
                                            },
                                            {
                                                "example_id": "7e6d8dd7-7803-467e-b425-cf3ab5e29606",
                                                "sense_id": "92a9be6a-2514-3e66-a064-ea4ea1b270b9",
                                                "text": "„Drei Monate später saß Hagen in seinem Büro und überflog den Papierstoß auf seinem Schreibtisch.“"
                                            },
                                            {
                                                "example_id": "5e79e23e-5c43-4030-8452-6eb4ba745d4e",
                                                "sense_id": "92a9be6a-2514-3e66-a064-ea4ea1b270b9",
                                                "text": "„Er schlug das Buch auf und überflog ein paar Sätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
