                    {
                        "sense_id": "d35ee17d-aa87-37f6-b479-42aa1b313bb0",
                        "entry_id": "d459907e-b9ac-3d7c-abb0-e88bdbc346eb",
                        "glosses": [
                            "bedieningsvakman voor grote technische installaties in allerlei fabrieken en dergelijke, in het bijzonder in de procesindustrie, bedieningsdeskundige"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "01781ea1-9e76-41af-a3a9-400122ea9e89",
                                "sense_id": "d35ee17d-aa87-37f6-b479-42aa1b313bb0",
                                "text": "Als operator ben je de mens achter de machine. Want al is de productie voor een groot deel geautomatiseerd, zonder de operator staat het proces stil. Jij bent onmisbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6be1315-3cb4-31d9-b59e-f60b7cf7efcb",
                        "entry_id": "d459907e-b9ac-3d7c-abb0-e88bdbc346eb",
                        "glosses": [
                            "een bedrijf dat grote technische installaties beheert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1898c785-9a3b-4a1a-8783-7ec3b54781fa",
                                "sense_id": "c6be1315-3cb4-31d9-b59e-f60b7cf7efcb",
                                "text": "Belron breidt zijn activiteiten in Scandinavië verder uit met de overname in Zweden van de belangrijkste operator op de markt van de herstelling en vervanging van voertuigbeglazing."
                            }
                        ]
                    }
