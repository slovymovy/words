                                        "examples": [
                                            {
                                                "example_id": "f604dda7-9c93-4e5b-84df-fe20cb5a70a5",
                                                "sense_id": "5df0d238-75e2-3e2f-b594-346a1bfa3e66",
                                                "text": "Il y avait réception chez Izeddin-Ali-effendi, au fond de Stamboul."
                                            },
                                            {
                                                "example_id": "c8a6d8a1-2998-48fe-957f-9f48725b8cac",
                                                "sense_id": "5df0d238-75e2-3e2f-b594-346a1bfa3e66",
                                                "text": "« Ça fait de la peine de quitter sa femme, Effendi ? »"
                                            },
                                            {
                                                "example_id": "464b4df3-7220-4b0d-a341-ea432e47ed8d",
                                                "sense_id": "5df0d238-75e2-3e2f-b594-346a1bfa3e66",
                                                "text": "Quand elle eut fini, elle s’inclina devant Heykal en l’appelant, poésie pure pour moi, « Effendi »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "326d8afb-26bc-47f1-a50a-7dd3e1e8e316",
