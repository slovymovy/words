                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9d634c0-0f04-4728-9936-0c19367c71a3",
                                "sense_id": "67e3d947-30ed-3ba2-878f-bbba5806aafc",
                                "text": "I shook my head. In a crawlsome way, he was amusing. He was all eyebrows and they were so busy. They wriggled. Big black caterpillars. Little black eyes peered piercingly from under them. He made me laugh."
                            },
                            {
                                "example_id": "e6cc13c7-d0ed-485b-a7aa-489403dd1698",
                                "sense_id": "67e3d947-30ed-3ba2-878f-bbba5806aafc",
                                "text": "Not all the whites who have to live in places like Port Darwin, Wyndham, Broome or Hedland are color-serving, crawlsome creatures, who care nothing for the future of our young nation."
                            }
                        ]
                    }
