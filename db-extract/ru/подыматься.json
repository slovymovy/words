                ],
                "senses": [
                    {
                        "sense_id": "3f9b0b89-5b97-3fa6-8a66-105454315413",
                        "entry_id": "3be7646d-cedd-3383-a410-5f379ea4be26",
                        "glosses": [
                            "прост. то же, что подниматься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f370a4e-8210-4d45-9112-66a3cce50e42",
                                "sense_id": "3f9b0b89-5b97-3fa6-8a66-105454315413",
                                "text": "Я же его вахмистром сделал, он же на меня и подымается!"
                            },
                            {
                                "example_id": "85fc3921-8e58-49bf-acda-214239040591",
                                "sense_id": "3f9b0b89-5b97-3fa6-8a66-105454315413",
                                "text": "Самые те, которые от слабости и болезни не подымались с постели, мгновенно были исцелены."
                            },
                            {
                                "example_id": "f6d0dc80-7765-40d8-9a31-6a56ea446b70",
                                "sense_id": "3f9b0b89-5b97-3fa6-8a66-105454315413",
                                "text": "Луна сияла ― июльская ночь была тиха ― изредко подымался ветерок, и лёгкий шорох пробегал по всему саду."
                            },
                            {
                                "example_id": "798bdc7b-c96d-4107-a756-4f8c2869195f",
                                "sense_id": "3f9b0b89-5b97-3fa6-8a66-105454315413",
                                "text": "Один из них забыл положить кадило, и тонкая струйка дыма подымалась с углей."
                            }
                        ]
                    }
                ],
                "translations": [
