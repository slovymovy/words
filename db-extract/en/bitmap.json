                "senses": [
                    {
                        "sense_id": "229a7051-23d7-33d7-947b-29b5e8c8b1dc",
                        "entry_id": "0433d14d-6671-3e8c-a4d1-0ef60fd955bf",
                        "glosses": [
                            "Série de bits représentant une série de pixels formant en général une image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4f7459-e3c0-4fb2-be44-bfd3263eba36",
                                "sense_id": "229a7051-23d7-33d7-947b-29b5e8c8b1dc",
                                "text": "You give the size in pixels of the bitmap to be created ( and consequently , the number of cells in the bitmap editing area )",
                                "translation": "Vous donnez la taille en pixels du bitmap à créer (et conséquement, le nombre de cellules dans la zone d'édition bitmap)"
                            },
                            {
                                "example_id": "ec0db39d-918d-4b89-a817-a119a905e3f9",
                                "sense_id": "229a7051-23d7-33d7-947b-29b5e8c8b1dc",
                                "text": "There are many file formats for storing bitmaps under DOS. One de facto standard is ZSoft's PC paintbrush format with the filename extension .PCX. Many bitmaps are available on CompuServe with the extension .GIF (Graphics Interchange Format). Perhaps the most sophisticated bitmap format is TIFF (tagged-image file format). Windows (and OS/2 Presentation Manager) bitmap files have an extension of .BMP."
                            }
                        ]
                    }
                ],
