                                        "sense_id": "ceafc5cd-bec9-3975-8130-9e91ddc90953",
                                        "entry_id": "a1b67507-70af-3ca8-bbb9-d2392c3dd189",
                                        "glosses": [
                                            "The act or process by which something is undermined."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26fa95e8-dde3-476c-a31e-c8c2663cb1ba",
                                                "sense_id": "ceafc5cd-bec9-3975-8130-9e91ddc90953",
                                                "text": "The piece, titled You, calls up many references from the past and the present: from Michael Heizer's earthworks to Chris Burden's institutional underminings to Monica Bonvicini's simulations of the same."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "undermining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "055c385c-273a-37a3-9062-8cc65a675f9d",
                                        "entry_id": "80955f9a-9ffa-3044-9036-673ac1075524",
                                        "glosses": [
                                            "present participle and gerund of undermine"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e800b04-91b8-4b36-b7da-c312db875489",
                                                "sense_id": "055c385c-273a-37a3-9062-8cc65a675f9d",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you[…] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    }
                                ]
