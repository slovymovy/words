                    },
                    {
                        "translation_id": "f6ab8df3-0bde-4bbe-acb0-78689ebd83ab",
                        "source_entry_id": "80732c38-d773-36f5-9d0f-bda7e99cd4c4",
                        "source_sense_id": "fd9a0dbb-620e-3c08-96bd-8129b2759589",
                        "target_lang_word": "blutleer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blutleer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "715a84a2-966e-3aaf-a2c3-5c5f57d1a714",
                                        "entry_id": "4913058f-8d57-3959-8b28-351077a08b47",
                                        "glosses": [
                                            "ohne Blutzufuhr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f24fdba-f0bf-43b3-885f-fc39c61e2b83",
                                                "sense_id": "715a84a2-966e-3aaf-a2c3-5c5f57d1a714",
                                                "text": "„Anstatt des Herzens trug sie vorsichtshalber ein Stück Eis in der Brust. Diesem unnatürlichen Umstand war es wahrscheinlich beizumessen, daß sie sehr fahl und blutleer aussah, und daß ihre Züge von erschreckender Schärfe waren.“ (Ossip Schubin, Die Hoffnung)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3aa03995-e4df-3c30-a762-ba4e3da75b7e",
                                        "entry_id": "4913058f-8d57-3959-8b28-351077a08b47",
                                        "glosses": [
                                            "im übertragenen Sinne: leblos, nicht lebendig wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ec387e-ed8b-422b-8460-969cf201f49d",
                                                "sense_id": "3aa03995-e4df-3c30-a762-ba4e3da75b7e",
                                                "text": "Der Roman wirkt aufgrund der eindimensionalen Figuren blutleer und langweilig."
                                            },
                                            {
                                                "example_id": "92b3b03d-7d59-45c1-b9f4-563a0f0583c7",
                                                "sense_id": "3aa03995-e4df-3c30-a762-ba4e3da75b7e",
                                                "text": "„In diesem Umfeld blieb auch die Kreditentwicklung blutleer.“"
                                            },
                                            {
                                                "example_id": "a23b14a2-e1f9-40ff-b13c-ff79172f0a96",
                                                "sense_id": "3aa03995-e4df-3c30-a762-ba4e3da75b7e",
                                                "text": "„Die Jahre 2025 und 2026 stehen im Zeichen einer blutleeren Erholung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "367bbd3c-be8b-474c-bf40-dffeaf26029f",
                        "source_entry_id": "80732c38-d773-36f5-9d0f-bda7e99cd4c4",
                        "source_sense_id": "fd9a0dbb-620e-3c08-96bd-8129b2759589",
                        "target_lang_word": "niedokrwienny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6949e9f-189c-4aa1-b417-9c9744b2e1b0",
                        "source_entry_id": "80732c38-d773-36f5-9d0f-bda7e99cd4c4",
                        "source_sense_id": "fd9a0dbb-620e-3c08-96bd-8129b2759589",
                        "target_lang_word": "ischemiczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "95ce6423-16dd-4683-a67c-ebe4b0bb9bfe",
                        "source_entry_id": "80732c38-d773-36f5-9d0f-bda7e99cd4c4",
                        "source_sense_id": "fd9a0dbb-620e-3c08-96bd-8129b2759589",
                        "target_lang_word": "ischémique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ischémique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38df0395-8c0d-3bc1-8f18-211456d1696f",
                                        "entry_id": "2622f9dd-aa32-320e-8c2d-bf08f94bfe87",
                                        "glosses": [
                                            "Qui concerne la diminution de l’arrivée du sang : l’ischémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af64ce1c-0c2e-4965-9a4f-430b0d8f4242",
                                                "sense_id": "38df0395-8c0d-3bc1-8f18-211456d1696f",
                                                "text": "Dans plus de la moitié des cas, l’insuffisance cardiaque a une origine ischémique, explique le Pʳ Desnos. Plus précisément, le muscle cardiaque est lésé parce qu’il a été privé d’oxygène soit de façon transitoire, à cause d’un infarctus du myocarde essentiellement, soit de manière chronique, lorsque les artères coronaires qui alimentent le cœur en oxygène sont partiellement bouchées par des plaques d’athérome."
                                            },
                                            {
                                                "example_id": "594141b6-f0b3-4ea7-b2e3-9cad276b4e91",
                                                "sense_id": "38df0395-8c0d-3bc1-8f18-211456d1696f",
                                                "text": "Cette dernière découverte ouvre la voie d’un lien entre la pénétration du virus dans les neurones observés à la fois dans les cultures de cellules cérébrales et les tissus cérébraux post-mortem, et l’hypoxie et les accidents ischémiques observés dans le cerveau des malades."
                                            },
                                            {
                                                "example_id": "d818efcb-697f-4fe3-b028-ca3194fd0c07",
                                                "sense_id": "38df0395-8c0d-3bc1-8f18-211456d1696f",
