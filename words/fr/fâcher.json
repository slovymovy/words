{
    "word_family": [
        "fâcherie",
        "fâcheux",
        "fâcheusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b15ba49c-07cb-33bc-9e3e-84aac4d48115",
                    "sense_definition": "Mettre quelqu'un en colère, irriter ou mécontenter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses remarques désobligeantes finissent toujours par <w>fâcher</w> tout le monde autour de la table."
                        },
                        {
                            "text": "Ne dis rien à ton frère, tu risques de le <w>fâcher</w> encore plus."
                        }
                    ],
                    "synonyms": [
                        "exaspérer",
                        "irriter",
                        "mécontenter"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ]
                },
                {
                    "sense_id": "78a518c2-7899-3d70-90ac-3cf0c476ea2d",
                    "sense_definition": "Se mettre en colère, manifester un vif mécontentement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas se <w>fâcher</w> pour un simple malentendu entre amis."
                        },
                        {
                            "text": "Mon père se <w>fâche</w> rarement, mais aujourd'hui il a perdu patience."
                        }
                    ],
                    "antonyms": [
                        "se calmer"
                    ],
                    "common_phrases": [
                        "se fâcher tout rouge",
                        "se fâcher pour rien"
                    ]
                },
                {
                    "sense_id": "42347984-6934-3d6b-a76c-79118f8bac47",
                    "sense_definition": "Rompre de bonnes relations, se brouiller avec quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont cessé de se parler après s'être <w>fâchés</w> pour une histoire d'argent."
                        },
                        {
                            "text": "Je refuse de me <w>fâcher</w> avec mes collègues à cause de ce projet."
                        }
                    ],
                    "synonyms": [
                        "se brouiller"
                    ],
                    "antonyms": [
                        "se réconcilier"
                    ],
                    "common_phrases": [
                        "se fâcher avec quelqu'un",
                        "se fâcher à mort"
                    ]
                },
                {
                    "sense_id": "0168a7a9-e0fa-3bd2-a229-c4db59c4ce8a",
                    "sense_definition": "Causer du déplaisir, du regret ou de la contrariété à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'annulation soudaine de son voyage l'a beaucoup <w>fâché</w>."
                        },
                        {
                            "text": "Je suis bien <w>fâché</w> d'apprendre cette mauvaise nouvelle ce matin."
                        }
                    ],
                    "synonyms": [
                        "contrarier",
                        "indisposer"
                    ],
                    "antonyms": [
                        "réjouir"
                    ],
                    "common_phrases": [
                        "être fâché de"
                    ]
                },
                {
                    "sense_id": "935a1206-a81d-3723-a36a-c35c468f6a26",
                    "sense_definition": "Gronder ou réprimander un enfant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reprimande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant avait peur de se faire <w>fâcher</w> après avoir cassé le vase."
                        },
                        {
                            "text": "La maîtresse a dû le <w>fâcher</w> parce qu'il refusait de faire ses devoirs."
                        }
                    ],
                    "common_phrases": [
                        "se faire fâcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Principalement utilisé dans le Midi de la France"
                        }
                    ]
                }
            ]
        }
    ]
