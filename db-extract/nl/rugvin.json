                "translations": [
                    {
                        "translation_id": "a08fd51a-61d9-4bbb-8771-4bc9c3ce0b6a",
                        "source_entry_id": "fe01ec18-35b6-324c-8206-0fe8818a49f0",
                        "source_sense_id": "682d78f5-cb0c-36ed-8b94-b0ddae107461",
                        "target_lang_word": "Rückenflosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückenflosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31d9dacd-2f77-382c-bd91-f800aa0e3e0a",
                                        "entry_id": "93ebd305-1d77-3181-8a41-2f94bb344820",
                                        "glosses": [
                                            "Flosse, die sich am Rücken eines Meereslebewesens befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa737f4a-0ed4-4054-919a-433c508abce4",
                                                "sense_id": "31d9dacd-2f77-382c-bd91-f800aa0e3e0a",
                                                "text": "„Ihm war zu Forschungszwecken die Nummer 252 auf der Rückenflosse eingeprägt worden.“"
                                            },
                                            {
                                                "example_id": "8c4a1293-5de5-45f3-ad21-a26fe8715089",
                                                "sense_id": "31d9dacd-2f77-382c-bd91-f800aa0e3e0a",
                                                "text": "„Die Rückenflosse knickte endgültig ab, ein bei Orcas in Gefangenschaft wegen des fehlenden Schwimmpensums häufiges Leiden.“"
                                            },
                                            {
                                                "example_id": "39eeb70d-a96e-46c3-b469-a6d2ed0db4db",
                                                "sense_id": "31d9dacd-2f77-382c-bd91-f800aa0e3e0a",
                                                "text": "„An den Rückenflossen zählte ich zwölf bis vierzehn bogenförmige Strahlen, bei einzelnen Exemplaren mischten sich dunkle Punkte dazwischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60d8e2c3-6f1e-4a9e-ab55-f55e1c401152",
                        "source_entry_id": "fe01ec18-35b6-324c-8206-0fe8818a49f0",
                        "source_sense_id": "682d78f5-cb0c-36ed-8b94-b0ddae107461",
                        "target_lang_word": "Finne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f30acb9-e62d-3f81-82a1-e2570a30620b",
                                        "entry_id": "62a953e3-f4ff-37ea-9fa5-dedf23262244",
                                        "glosses": [
                                            "Einwohner Finnlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7f73d6-9ca8-4609-9bea-c3efe0f9a2bb",
                                                "sense_id": "0f30acb9-e62d-3f81-82a1-e2570a30620b",
                                                "text": "Manche Finnen sprechen Schwedisch als Muttersprache."
                                            },
                                            {
                                                "example_id": "2cc95417-716b-4f3c-9e65-12aec56a9e8b",
                                                "sense_id": "0f30acb9-e62d-3f81-82a1-e2570a30620b",
                                                "text": "„Natürlich frage ich mich, wie Aulis das so macht, als monolingualer Finne Funkfreundschaften in aller Welt zu pflegen…“"
                                            },
                                            {
                                                "example_id": "6a6728b5-0b27-4f16-a048-1ce148de6203",
                                                "sense_id": "0f30acb9-e62d-3f81-82a1-e2570a30620b",
                                                "text": "„Die Finnen sind Individualisten, auch hier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Finne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee057815-fa0f-3b95-b2d8-04d55acb3156",
                                        "entry_id": "e77f2d9b-a36d-32a2-bd11-ea1adddd4961",
                                        "glosses": [
                                            "die geschlechtslose Jugendform (das zweite Larvenstadium) von Bandwürmern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a904b311-ea53-45e0-8b51-db20a07e39b5",
                                                "sense_id": "ee057815-fa0f-3b95-b2d8-04d55acb3156",
                                                "text": "Beim Fuchs- und Hundebandwurm sind die Finnen für die Erkrankung verantwortlich."
                                            },
                                            {
                                                "example_id": "26687a4f-5061-4be7-9d9e-df146b1aa2ae",
                                                "sense_id": "ee057815-fa0f-3b95-b2d8-04d55acb3156",
                                                "text": "„Leber, Milz, Nieren, Magen, Darm, Gehirn, Rückenmark und Euter sowie das Fett dieser Tiere sind - falls diese Teile frei von Finnen befunden wurden - ohne Einschränkungen tauglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5881fff-4b1b-36da-88b9-fb2c3d682ea7",
                                        "entry_id": "e77f2d9b-a36d-32a2-bd11-ea1adddd4961",
                                        "glosses": [
                                            "Pickel (bei Akne)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5be2c4b-9c51-4828-82d6-79eda55cfea3",
                                                "sense_id": "f5881fff-4b1b-36da-88b9-fb2c3d682ea7",
                                                "text": "Das Gesicht ist von Finnen ganz verunstaltet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ed53eb97-0a05-3978-b3ae-c3d1aa34c790",
                                        "entry_id": "e77f2d9b-a36d-32a2-bd11-ea1adddd4961",
                                        "glosses": [
                                            "Rückenflosse eines Hais oder Wals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b5afa6-888d-4397-a041-d86c1509a253",
                                                "sense_id": "ed53eb97-0a05-3978-b3ae-c3d1aa34c790",
                                                "text": "Die Finne ist ein wichtiges Merkmal der verschiedenen Hai- und Walarten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4837f782-5951-3c58-abfd-1a188e53276b",
                                        "entry_id": "e77f2d9b-a36d-32a2-bd11-ea1adddd4961",
                                        "glosses": [
                                            "spitze Seite des Hammers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822ffc01-e639-41a7-9bb1-3e01340c2f32",
                                                "sense_id": "4837f782-5951-3c58-abfd-1a188e53276b",
                                                "text": "Ich möchte den Hammer mit gespaltener Finne."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
