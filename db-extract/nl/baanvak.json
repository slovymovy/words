                                    {
                                        "sense_id": "2be2f9c0-ad64-341c-a7d7-15b7d120a781",
                                        "entry_id": "e860faf5-e95f-32a2-a97d-5807eed8999d",
                                        "glosses": [
                                            "To commit (a person) to a hospital for mental health treatment as an involuntary patient. So called after various sections of legal acts regarding mental health."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810c2032-3f77-44d0-b1dc-144bf2bf0eff",
                                                "sense_id": "2be2f9c0-ad64-341c-a7d7-15b7d120a781",
                                                "text": "Tribunals were set up as watchdogs in cases of compulsory detention (sectioning). […] Informal patients, however, could be sectioned, and this was often a fear of patients once they were in hospital."
                                            },
                                            {
                                                "example_id": "817a799a-a12f-4d84-8ca3-85234a2db245",
                                                "sense_id": "2be2f9c0-ad64-341c-a7d7-15b7d120a781",
                                                "text": "The doctor then sectioned her, making her an involuntary patient, and had her moved to a secure ward."
                                            },
                                            {
                                                "example_id": "35831b71-19f3-42a9-9540-2b27e6cba294",
                                                "sense_id": "2be2f9c0-ad64-341c-a7d7-15b7d120a781",
                                                "text": "After explaining that for 7 years, from ’88 to ’95, I was permanently sectioned under the Mental Health act, robbed of my freedom, my integrity, my rights, I wrote at the time;- […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b6c8292-4183-3171-afd5-77533c6586d8",
                                        "entry_id": "e860faf5-e95f-32a2-a97d-5807eed8999d",
                                        "glosses": [
                                            "To perform a cesarean section on (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5980a13-27e0-45c6-bb31-e9d9d7be2c3d",
                                                "sense_id": "0b6c8292-4183-3171-afd5-77533c6586d8",
                                                "text": "\"But if she's gone into active labour she could be bleeding massively and you may have to section her there and then.\""
                                            },
                                            {
                                                "example_id": "5b86f733-37f0-4546-a76c-66f439934d41",
                                                "sense_id": "0b6c8292-4183-3171-afd5-77533c6586d8",
                                                "text": "You may hear a physician say, \"I don't want to section her until the baby declares itself.\""
                                            }
                                        ]
                                    }
