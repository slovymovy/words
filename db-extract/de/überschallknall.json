                "senses": [
                    {
                        "sense_id": "6d0f0b85-fa50-3da0-a0aa-d26884fdafbd",
                        "entry_id": "2b41a120-6854-384c-b78d-5b214d210a32",
                        "glosses": [
                            "Knall, der beim Durchbrechen der Schallmauer entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47530daa-1caa-4d7f-b7ca-daf56bcdcad7",
                                "sense_id": "6d0f0b85-fa50-3da0-a0aa-d26884fdafbd",
                                "text": "„Der Lärm, den ein Schuss aus einer Waffe macht, kommt hauptsächlich von sich ausdehnenden Gasen, und dann ist da noch der winzige Überschallknall, den eine Kugel erzeugt, weil sie so schnell fliegt.“"
                            },
                            {
                                "example_id": "1a649e13-8e7d-413d-b601-ffa6a8e0f166",
                                "sense_id": "6d0f0b85-fa50-3da0-a0aa-d26884fdafbd",
                                "text": "„Mit einem Überschallknall flog ein Geschoss rechts an ihm vorbei, weniger als 30 Zentimeter von seiner Kehle entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
