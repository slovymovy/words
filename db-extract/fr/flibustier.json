                                        "entry_id": "17b7160f-9d45-389d-a183-39cf80b1b256",
                                        "glosses": [
                                            "An adventurer who pillages, plunders, or thieves privately or for compensation; or wages ad-hoc war on other nations, similar to mercenary; also a \\\"freeboot\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aff73e3-7aa0-45bf-821d-3d4f8165edbb",
                                                "sense_id": "2227b870-c936-3c2a-8bfd-6e94acbc1db2",
                                                "text": "The military aspect should, however, be carefully studied, as the result may be to dispel the time-honoured connection between forest and freebooter under modern conditions with long-range rifles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dddddc8-8402-333d-8d29-b87c18940582",
                                        "entry_id": "17b7160f-9d45-389d-a183-39cf80b1b256",
                                        "glosses": [
                                            "One who rehosts online media without authorization, a form of intellectual property theft; one who freeboots."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "159ec51b-8434-4b27-8ef5-51b4c230785b",
