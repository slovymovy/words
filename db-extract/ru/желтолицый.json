                        "examples": [
                            {
                                "example_id": "51538249-3a32-4dae-8f81-c9522c458381",
                                "sense_id": "4a000add-2c2d-3d57-924f-24059400cfe9",
                                "text": "Это был господин мрачного вида, длинноволосый, желтолицый, в больших синих очках и с сиплым голосом."
                            },
                            {
                                "example_id": "7d17eb3c-e570-45a4-8508-741dde41e59f",
                                "sense_id": "4a000add-2c2d-3d57-924f-24059400cfe9",
                                "text": "И принес ей в подарок желтолицую куколку."
                            }
                        ]
                    }
