                },
                {
                    "sense_id": "8e419cd4-6bbb-3948-9a76-a07d8f5128a8",
                    "sense_definition": "Démarche ou discussion menée entre particuliers pour régler une affaire privée ou familiale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'achat de cette maison ancienne a demandé une longue <w>négociation</w> entre les héritiers."
                        },
                        {
                            "text": "Elle a mené une habile <w>négociation</w> avec son propriétaire pour faire baisser le loyer."
