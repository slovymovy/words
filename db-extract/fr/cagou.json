                    {
                        "form_id": "198f136c-0ca3-452d-9187-318d90c0566d",
                        "entry_id": "4b22fa2f-1895-3b45-893c-28b40593a498",
                        "tags": [],
                        "form": "kagou"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cad1027-6ce1-3f1c-94c4-b6fb93bf0c32",
                        "entry_id": "4b22fa2f-1895-3b45-893c-28b40593a498",
                        "glosses": [
                            "Échassier de la Nouvelle-Calédonie ; il ne vole pas, ses ailes ne lui servant qu’à accélérer sa course."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c97102-c7c0-42bb-b481-fe476aca3d13",
                                "sense_id": "3cad1027-6ce1-3f1c-94c4-b6fb93bf0c32",
                                "text": "M. le comte Vignes a fait don au Muséum de vingt-six couples d’oiseaux des plus rares, et entre autres d’une paire de cagoux ; c’est la première fois que ces oiseaux, qui appartiennent à la famille des échassiers, ont pu être rapportés vivants de la Nouvelle-Calédonie ; haut de trente centimètres environ, le cagou est gris cendré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d0a362c-6ab0-48bd-afee-2da7331b42a9",
                        "source_entry_id": "4b22fa2f-1895-3b45-893c-28b40593a498",
                        "source_sense_id": "3cad1027-6ce1-3f1c-94c4-b6fb93bf0c32",
                        "target_lang_word": "kagu",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kagu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "798572c9-5258-3285-8a73-6fa827cd9e7f",
                                        "entry_id": "6f05bfcd-b912-38e6-ae5d-67f8a2b40a8b",
                                        "glosses": [
                                            "A New Caledonian endemic bird species, Rhynochetos jubatus, the only surviving member of the family Rhynochetidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33e00d8-17c5-4011-a9a8-fb810f22ec2d",
                                                "sense_id": "798572c9-5258-3285-8a73-6fa827cd9e7f",
                                                "text": "Therewith hastened the Kagu into the shadowy hall, moving softly and rolling a little in her gait, with her head thrust forward; and a little flurried was she in her bearing as she darted this way and that her large and beautiful eyes, mild and timid, that were like liquid gold heated to redness. Somewhat like a heron she was, but stouter, and shorter of leg, and her beak shorter and thicker than the heron’s; and so long and delicate was her pale gray plumage that hard it was to say whether it were hair or feathers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "d5804b1b-bf22-3e4b-b426-993aec717baa",
                "word": "cagou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67ed65a6-9299-480b-9dc0-e0d4f79bbc2c",
                        "entry_id": "d5804b1b-bf22-3e4b-b426-993aec717baa",
                        "tags": [
                            "plural"
                        ],
                        "form": "cagoux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "366141b4-6b38-3b5d-b84b-bba0232ede0f",
                        "entry_id": "d5804b1b-bf22-3e4b-b426-993aec717baa",
                        "glosses": [
                            "Homme qui vit mesquinement et ne voit personne."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "10491150-dcd6-4d31-b93c-35de46b8380e",
                                "sense_id": "366141b4-6b38-3b5d-b84b-bba0232ede0f",
                                "text": "Mais alors messire Hugues, le prévôt, cracha dans un brasier de fer avec la grimace d'un cagou qui a avalé une araignée en mangeant sa soupe."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac9e8e6c-e32c-3454-94ff-f06f196993ad",
                        "entry_id": "d5804b1b-bf22-3e4b-b426-993aec717baa",
                        "glosses": [
                            "Chef des mendiants de la cour des miracles à Paris au Moyen-Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cac594d-7732-4c82-96d5-b17df5a5136d",
                                "sense_id": "ac9e8e6c-e32c-3454-94ff-f06f196993ad",
                                "text": "Je suis truand au fond du cœur, je suis argotier dans l'âme, je suis né cagou."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb3a1a9a-5ff2-3fb2-85f6-27d13d2e3434",
                        "entry_id": "d5804b1b-bf22-3e4b-b426-993aec717baa",
                        "glosses": [
                            "Voyou, truand."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf6ec29-02dd-462c-9580-404a22f63675",
                                "sense_id": "fb3a1a9a-5ff2-3fb2-85f6-27d13d2e3434",
                                "text": "Le bruit de leurs peaux d’âne et de leurs archets faisait aboyer tous les chiens du pays, auxquels répondaient ceux des cagous, attachés sous les chariots."
                            },
                            {
                                "example_id": "02a4e21e-67e0-4b9f-9ccf-461605b48b60",
                                "sense_id": "fb3a1a9a-5ff2-3fb2-85f6-27d13d2e3434",
                                "text": "Je regardais curieusement défiler devant moi tous ces pauvres diables, cette cour des miracles de la Hollande, ces cagoux, ces marcandiers, ces rifodés, ces polissons, ces capons."
                            }
                        ]
                    }
                ],
