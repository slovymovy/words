                        "sense_id": "d5955a3c-8c68-3f94-9630-a9708a3bfd47",
                        "entry_id": "5a4541a5-e029-3bc5-b509-957c58b1e727",
                        "glosses": [
                            "een krijgsmacht in de lucht die bestaant uit vliegtuigen, raketten, projectielen en personeel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa2329e-8de1-4470-bf7a-48196ad58319",
                                "sense_id": "d5955a3c-8c68-3f94-9630-a9708a3bfd47",
                                "text": "Hij wil erg graag een opleiding bij de luchtmacht doen."
                            }
                        ]
