                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881080f6-9ad1-4d4e-ab0e-b435c8e8295f",
                                "sense_id": "0e7d38c3-b214-39cc-a095-0a65f6fde639",
                                "text": "Table thématique, table des morceaux d’un opéra, d’un recueil de sonates, etc., dans laquelle la première phrase musicale est ordinairement indiquée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec959840-9551-4991-9d11-95f99db784f3",
                        "source_entry_id": "490e0e60-2321-3289-9121-1fbf974a006d",
                        "target_lang_word": "thematisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thematisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                        "entry_id": "aea85bcf-426b-3c8f-860a-79a4779e3c87",
                                        "glosses": [
                                            "auf ein Thema bezogen, an einem Thema orientiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e40dc50-008a-4ece-93c5-6602008570b4",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "Denn um thematische Auseinandersetzungen, um Sachpolitik geht es dabei meistens gar nicht."
                                            },
                                            {
                                                "example_id": "fdb30758-8bac-4b06-b82a-416596398c78",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "\"Durch stärkere thematische und ästhetische Bündelung der Aktivitäten in der Freien Szene, der Entwicklung von dynamischen Produktionsnetzwerken und der stärkeren Vernetzung der lokalen Wiener Szene in internationale Produktionszusammenhänge soll 'brut' (…) zu einem Kommunikationsraum für nationale und internationale Kunstproduktion werden\", heißt es in einer Aussendung."
                                            },
                                            {
                                                "example_id": "7e0a3ecc-c454-49ce-84ff-a9eb988fa8f7",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "Thematischer Höhepunkt wird die erstmalige Verleihung eines Grazer Menschenrechtspreises für Verdienste um die Menschenrechte am 9. Dezember sein."
                                            },
                                            {
                                                "example_id": "d5283fbb-b0bd-4aad-87e4-770f85209102",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "Thematisch kreisen sie um den Gegensatz zwischen alter und neuer Zeit, um das Verhältnis von Naturzustand und gesellschaftlichem Zustand, um das eigene Selbst, um Gerechtigkeit, Wahrheit, politische Ordnung, Freiheit und Unterdrückung."
                                            },
                                            {
                                                "example_id": "8217161a-4c45-4640-9542-da08d4c9de65",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "1754 kehrte er nach Königsberg zurück, wurde zum Magister promoviert, habilitierte sich und nahm eine thematisch sehr breite Vorlesungstätigkeit auf: Logik, Metaphysik, Moralphilosophie, Mathematik, Physik, Geographie (die er als akademisches Lehrfach einführte), später noch Anthropologie, Pädagogik, Naturrecht, natürliche Theologie, gelegentlich auch Festungsbau."
                                            },
                                            {
                                                "example_id": "68cd2125-001c-450b-96d8-393d377ccd20",
                                                "sense_id": "b5eed6eb-2084-3a6e-bc4f-208812a0bcf5",
                                                "text": "Anonyme, aber hervorragende Rechtslehrer sehen in diesen Dingen eine Gelegenheit, sich in die Mannesbrust zu werfen, mit dem Voll- und Ganzbart zu protestieren, und sie loben einen Causeur erst dort, wo er sich endlich auch thematisch in ihren Horizont begeben hat und zum Leitartikel emporwächst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fac3a1d-a347-3ba4-9acf-54cb5e1f08b8",
                                        "entry_id": "aea85bcf-426b-3c8f-860a-79a4779e3c87",
                                        "glosses": [
                                            "bei Wortbildungen: mit einem Themavokal gebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66cc7661-29dd-403c-8f45-e33456837ae3",
                                                "sense_id": "3fac3a1d-a347-3ba4-9acf-54cb5e1f08b8",
                                                "text": "In der lateinischen Sprache sind fast alle Verben thematisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15287f9e-95ec-3467-81a4-025e30fef612",
                                        "entry_id": "aea85bcf-426b-3c8f-860a-79a4779e3c87",
                                        "glosses": [
                                            "einen melodischen Hauptgedanken in Variationen enthaltend"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "von Kompositionen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac64821-ca50-4376-9eb3-8f0646aeea3e",
                                                "sense_id": "15287f9e-95ec-3467-81a4-025e30fef612",
                                                "text": "Die Prinzipien der thematischen Arbeit regten A. Schönberg zur Zwölftontechnik an."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
