                        "sense_id": "07bdd488-b07f-3a8b-8fc4-2beda7fbe4a4",
                        "entry_id": "fab88270-548c-36a5-b1b3-81f065254914",
                        "glosses": [
                            "moody, fickle"
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f7d2b8b-0134-49b9-83a0-869bf9a78ce9",
                                "sense_id": "07bdd488-b07f-3a8b-8fc4-2beda7fbe4a4",
                                "text": "So wetterwendisch nämlich sonst die Seldwyler in ihren politischen Stimmungen waren, so beharrlich blieben sie in der Teilnahme an allem Freischaren- und Zuzügerwesen, […]",
                                "translation": "The People from Seldwyla",
                                "english": "The People from Seldwyla"
                            },
                            {
                                "example_id": "4bbdd413-02cd-4d22-ad1d-ae6fa74e5e9b",
                                "sense_id": "07bdd488-b07f-3a8b-8fc4-2beda7fbe4a4",
                                "text": "Das geschah bald und wiederholt unter verschiedenen Umständen. Der Februar ging zu Ende, es kamen der ahnungsvolle März, der wetterwendische April, der zärtliche Mai.",
                                "translation": "Royal Highness",
                                "english": "Royal Highness"
                            },
                            {
                                "example_id": "02a62923-3e9d-4ec5-ab72-e7b8f7e646ce",
                                "sense_id": "07bdd488-b07f-3a8b-8fc4-2beda7fbe4a4",
                                "text": "[…]Mit den biologisch abbaubaren Werbeschildern demonstrieren die Genossen, dass sie an der Seite der Grünen stehen und nicht etwa heimlich an eine Große Koalition mit der unverrottbaren Kanzlerin und deren wetterwendischen CDU denken."
                            }
                        ]
                    }
