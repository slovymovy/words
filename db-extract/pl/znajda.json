                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Findelkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "420b8880-3461-34eb-832e-d659dbd6174f",
                                        "entry_id": "7c7147c5-12d2-3b00-9b84-08d0f96c567d",
                                        "glosses": [
                                            "Kleinkind, das verlassen/hilflos aufgefunden oder von seinen Eltern ausgesetzt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63edea30-a393-45a3-aea7-13463e3f3d78",
                                                "sense_id": "420b8880-3461-34eb-832e-d659dbd6174f",
                                                "text": "Moses war ein Findelkind."
                                            },
                                            {
                                                "example_id": "2bf0b785-4010-4dcd-adf0-5760ea879a5b",
                                                "sense_id": "420b8880-3461-34eb-832e-d659dbd6174f",
                                                "text": "„Außer Waldrut Mergenin und Garlinda wußte kein Mensch, daß Laura Leonora ein Findelkind unbekannter Herkunft war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d65c9644-6bb2-4df9-8041-8234d30da5e4",
                        "source_entry_id": "367f7781-2e49-3dbb-8e70-1630e13db28e",
                        "source_sense_id": "5d7b8189-846c-3937-977f-1b54f2978158",
                        "target_lang_word": "Findling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Findling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "053fc2cf-3061-3b9a-aa38-0e0324379bfd",
                                        "entry_id": "7fc7b63a-6020-379a-afce-f37af9335413",
                                        "glosses": [
                                            "Felsblock ab einem Kubikmeter Volumen, der durch einen Gletscher transportiert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de8333b1-780f-4cc1-9a51-1342f5a17c4e",
                                                "sense_id": "053fc2cf-3061-3b9a-aa38-0e0324379bfd",
                                                "text": "In ehemals vergletscherten Regionen kann man viele Findlinge finden."
                                            },
                                            {
                                                "example_id": "b6f31263-7cdb-4e88-b32c-e620b7e8dd67",
                                                "sense_id": "053fc2cf-3061-3b9a-aa38-0e0324379bfd",
                                                "text": "„Der zwei Meter große Findling wurde mit einer Büste des Bildhauers Sigmund Mayer und einem Hakenkreuz »verziert«.“"
                                            },
                                            {
                                                "example_id": "8291e64b-10fb-4e91-a123-9bcfab40aea0",
                                                "sense_id": "053fc2cf-3061-3b9a-aa38-0e0324379bfd",
                                                "text": "„Die jungen Männer setzen sich auf einige der runden Findlinge, holen, sichtbar durstig, aus ihren Netzen die Wasserflaschen und trinken sofort eine ihrer Flaschen leer, danach verzehren sie die in den Netzen mitgebrachten belegten Brote.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34be2bce-b4d3-3034-9cc4-3adbeb37e704",
                                        "entry_id": "7fc7b63a-6020-379a-afce-f37af9335413",
                                        "glosses": [
                                            "Kleinkind, das verlassen/hilflos aufgefunden wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfb2dc3-a3e8-4dfc-900b-40dec74fedfe",
                                                "sense_id": "34be2bce-b4d3-3034-9cc4-3adbeb37e704",
                                                "text": "„In der Abteilung »Neuzeit« ist von der Ansbacher Polizei ein Zimmer dem Andenken des armen Findlings Kaspar Hauser geweiht; man sieht seine Uhr, seine Kleider und Wäsche mit den Stichmarken des Mordinstrumentes und die ganze Literatur über diesen geheimnisvollen Unbekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c0023cc-45f6-3707-9e63-99a80a48ca4c",
                                        "entry_id": "7fc7b63a-6020-379a-afce-f37af9335413",
                                        "glosses": [
                                            "weiße Rebsorte, die durch Mutation aus dem Müller-Thurgau entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ad9dd1-39e3-414a-8381-f436b826905f",
                                                "sense_id": "2c0023cc-45f6-3707-9e63-99a80a48ca4c",
                                                "text": "Der Findling wird vereinzelt in Baden und in Württemberg angebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51493e6b-262f-4284-8d1f-c697f5381204",
                        "source_entry_id": "367f7781-2e49-3dbb-8e70-1630e13db28e",
                        "source_sense_id": "5d7b8189-846c-3937-977f-1b54f2978158",
                        "target_lang_word": "найдёныш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "найдёныш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                        "entry_id": "ec6637fa-2026-341e-ace9-80c8967e0258",
                                        "glosses": [
                                            "разг. найденный ребёнок, оставленный родителями, подброшенный другим людям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b485670e-ab18-4692-bb40-7f86129dde50",
                                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                                "text": "Найденыша обыкновенно несли в удельный приказ, а там сдавали на воспитанье желающему принять ребенка."
                                            },
                                            {
                                                "example_id": "693646a8-5105-4b14-8d01-0919116f29e0",
                                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                                "text": "И долго еще после того Ваня навещал своего найдёныша, которому дали имя Алексей."
                                            },
                                            {
                                                "example_id": "cc1f3c8d-7296-4fb0-8522-d165f8eb4d64",
                                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                                "text": "За сердце ж дочери моей // Я заплачу тебе, злодей, // Тебе, найденыш без креста, // Презренный раб и сирота!.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                                        "entry_id": "ec6637fa-2026-341e-ace9-80c8967e0258",
                                        "glosses": [
                                            "разг. найденный детёныш животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13f69be-a4bb-41c6-8fc9-acfb3fe86b64",
                                                "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                                                "text": "Через год несчастный найдёныш превратился в толстого, холёного, наглого манула, разгуливающего то по всей деревне, то по Васиному столу в кабинете."
                                            },
                                            {
                                                "example_id": "99a792a8-f3a1-479b-9102-083c71aee41d",
                                                "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                                                "text": "Каждому хотелось чем-то помочь найденышу, дочка-дошкольница просила хоть на минуточку дать ей подержать зверька."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
