                "senses": [
                    {
                        "sense_id": "d2262595-86ce-3429-8a06-c378cfc0bebb",
                        "entry_id": "d27d98dc-2b6e-302d-9c06-3560cfe05371",
                        "glosses": [
                            "Mund-Nasen-Schutz zur Vermeidung von Ansteckung/Kontamination/Schädigung/Vergiftung, der die Augen unbedeckt lässt"
                        ],
                        "tags": [
                            "Hygiene",
                            "Arbeitsschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "47fc63ee-6d3a-4966-bdcd-5c2a207610dc",
                                "sense_id": "d2262595-86ce-3429-8a06-c378cfc0bebb",
                                "text": "„Die partikelfiltrierende Halbmaske ist ein vollständiges Atemschutzgerät, das ganz oder überwiegend aus dem Filtermaterial besteht, durch das die Einatemluft strömt, oder bei dem das Hauptfilter einen untrennbaren Teil des Gerätes darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0cbc8f8b-6c70-3b55-ab40-49b0d40354ec",
                        "entry_id": "d27d98dc-2b6e-302d-9c06-3560cfe05371",
                        "glosses": [
                            "Gesichtslarve (Maske), welche die Augen bedeckt, bis zur Nase hinuntergeht, aber den Mund unbedeckt lässt"
                        ],
                        "tags": [
                            "Theater",
                            "Kultur"
                        ],
                        "examples": [
                            {
                                "example_id": "06963286-e962-46b6-ad4a-e904691ab638",
                                "sense_id": "0cbc8f8b-6c70-3b55-ab40-49b0d40354ec",
                                "text": "„[…] so findet man in Venedig allenthalben Masken — oder besser: Halbmasken, meinte der Schriftsteller Jean Giono. Diese sehr hübschen, aus Taft oder Seide gefertigten Visiere verdecken Stirn, Augen und Nase, lassen aber den Mund frei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
