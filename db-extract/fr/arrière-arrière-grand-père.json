                        "sense_id": "47c4e288-5868-3a83-b41b-9afc275b978c",
                        "entry_id": "70ba7e57-d1eb-3e7a-9b09-28c061340488",
                        "glosses": [
                            "Père de l’un des arrière-grands-parents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b883612-d453-4342-b089-d6b421b0bb45",
                                "sense_id": "47c4e288-5868-3a83-b41b-9afc275b978c",
                                "text": "En effet, mon arrière-arrière-grand-père avait fui la Chine, vers 1890, pour aller au Cambodge, à cause de la misère et de la pauvreté. Il n’est jamais retourné en Chine."
                            },
                            {
                                "example_id": "eb476cdb-9a19-4f64-a350-a66ad5055c15",
                                "sense_id": "47c4e288-5868-3a83-b41b-9afc275b978c",
                                "text": "Un de ses arrière-arrière-grands-pères, Berisa Serifbej, avait fait la «besa» - promesse solennelle qui engage toute la famille pour des générations à venir - que jamais un des siens ne lèvera plus la main sur un Serbe qui ne lui aurait fait du mal, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37651bca-9332-431e-ab7c-3f11760e256d",
                        "source_entry_id": "70ba7e57-d1eb-3e7a-9b09-28c061340488",
                        "source_sense_id": "47c4e288-5868-3a83-b41b-9afc275b978c",
