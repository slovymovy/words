                                        ]
                                    },
                                    {
                                        "sense_id": "549715e2-94e6-3ec1-8cd6-5abaf3e5b996",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "река в России, протекающая в Воронежской, Липецкой и Тамбовской областях, левый приток Дона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69dee8f-6174-4440-bee8-ccdca53068b0",
                                                "sense_id": "549715e2-94e6-3ec1-8cd6-5abaf3e5b996",
                                                "text": "Река Воронеж впадает в Дон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437c4a1c-61bd-3c69-bf99-0948f8f82270",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "посёлок городского типа на Украине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9bf9fc-d6d7-49af-9c0d-ecca2f92238f",
                                                "sense_id": "437c4a1c-61bd-3c69-bf99-0948f8f82270",
                                                "text": "Здесь помещен очерк о Воронеже — посёлке городского типа Шосткинского района."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b02a704-6dca-36fb-8e49-f8598ececa76",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "посёлок в Алтайском крае России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91677ffb-9b4f-4420-a541-5d66c81702ed",
                                                "sense_id": "9b02a704-6dca-36fb-8e49-f8598ececa76",
                                                "text": "Посёлок Воронеж входит в состав Карамышевского сельсовета Змеиногорского района."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08578b40-6633-3cbc-9175-27a49f2cb62c",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "деревня в Ивановской области России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b0d2fa-c4a4-4380-b8a7-38b99803f8df",
                                                "sense_id": "08578b40-6633-3cbc-9175-27a49f2cb62c",
                                                "text": "Деревня Воронеж входит в Перемиловское сельское поселение Шуйского района."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd4c245-950d-3c8a-bf5f-93c2a85586db",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "астероид"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386e7b5d-ac4e-4897-adf0-ed01a378696d",
                                                "sense_id": "4dd4c245-950d-3c8a-bf5f-93c2a85586db",
                                                "text": "Астероид Воронеж назван в честь города Воронежа — центра Центрально-Чернозёмной области, в которой родился его первооткрыватель Николай Черных."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
