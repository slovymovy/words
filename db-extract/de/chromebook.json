                "senses": [
                    {
                        "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                        "entry_id": "e6996b75-7898-3516-97fa-ffc9f23beb84",
                        "glosses": [
                            "Notebook oder Netbook, das mit dem Betriebssystem Google Chrome OS ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf23b92-8c0f-4c11-af51-7e336519d2a9",
                                "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                                "text": "„Im US-Bildungsbereich dominieren Chromebooks mittlerweile klar.“"
                            },
                            {
                                "example_id": "7577ca8b-7816-4005-a57a-8e049bec5de8",
                                "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                                "text": "„Letztes Jahr brachte das Unternehmen schon das Chromebook Pixel auf den Markt, ein Notebook mit Googles Betriebssystem Chrome.“"
                            },
                            {
                                "example_id": "6e83704b-36c4-4457-9b47-e52625fb991c",
                                "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                                "text": "„Microsoft dürfte mit der neuen Light-Version vor allem Googles Chromebooks Paroli bieten wollen.“"
                            },
                            {
                                "example_id": "b710cba2-3836-481b-8ba9-f2fad07576fc",
                                "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                                "text": "„Google hat in einem Blogeintrag angekündigt, seine Chromebooks nun auch in Australien, Kanada, Frankreich, Deutschland, Irland und den Niederlande anzubieten.“"
                            },
                            {
                                "example_id": "a08b83f7-3ee9-4b1b-b020-2cd88a4b5d27",
                                "sense_id": "34558c36-ebb2-38b6-a79d-3742d11fc324",
                                "text": "„Hat man sich mit seinem Google-Account angemeldet, bekommt man endlich zu sehen, was das neue Chromebook einzigartig macht: das Display.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
