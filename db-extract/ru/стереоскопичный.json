                ],
                "senses": [
                    {
                        "sense_id": "6dde4a9a-a812-3772-a228-707a5fd6336f",
                        "entry_id": "e5d79cd3-b925-356d-ae1f-150b4098201a",
                        "glosses": [
                            "то же, что стереоскопический"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b997ce70-2359-4094-a092-08a1a422896b",
                                "sense_id": "6dde4a9a-a812-3772-a228-707a5fd6336f",
                                "text": "Свет дня — к тому же чистый и резкий — делал особенно стереоскопичной, особенно выпуклой картину этого города, его римскую арену, где теперь происходят корриды, его скупые по линиям, пустынные улицы, напоминающие о соседней Испании, сиротливый маленький дом Ван Гога, уцелевший на краю пустыря, оставшегося после разбитого воздушной бомбардировкой квартала."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb916d0-23ce-4c4d-ae1f-b824ee889a13",
                        "source_entry_id": "e5d79cd3-b925-356d-ae1f-150b4098201a",
                        "source_sense_id": "6dde4a9a-a812-3772-a228-707a5fd6336f",
                        "target_lang_word": "räumlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "räumlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                        "entry_id": "9f74ce48-5ad8-324a-965c-54de5b168372",
                                        "glosses": [
                                            "auf den Raum bezüglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df037f4-03ca-4c5e-a118-86ca55889f0a",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Die Zimmer werden demnächst räumlicher eingerichtet."
                                            },
                                            {
                                                "example_id": "a66c1b2f-8b7f-4460-a44c-d20ec9931340",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Dein Pappkarton ist innen räumlich und bietet für die Gegenstände viel Raum."
                                            },
                                            {
                                                "example_id": "4f35048a-0ea2-48ea-bcee-ef0fffdcf277",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Der Ursprung ist der räumliche oder zeitliche Ausgangs- oder Referenzpunkt eines Ereignisses oder Systems."
                                            },
                                            {
                                                "example_id": "395e1730-2e78-4c99-9c49-3ec97f577bdd",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "„Vielmehr sind die USA sowohl, was die Bevölkerung als auch was die räumliche Ausdehnung angeht, das drittgrößte Land der Erde.“"
                                            },
                                            {
                                                "example_id": "10d460f1-5b7e-4e32-9c67-1f53cc9eec16",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "„Dem Bericht zufolge plante die renommierte Lehranstalt in den späten Neunzigerjahren eine räumliche Erweiterung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
