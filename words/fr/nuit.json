                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le manque de sommeil régulier <w>nuit</w> gravement à la santé de chacun."
                        },
                        {
                            "text": "Ce comportement égoïste <w>nuit</w> à la réputation de toute l'équipe."
