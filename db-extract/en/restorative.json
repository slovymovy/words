                        "target_lang_word": "restaurativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restaurativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                        "entry_id": "dc950f2c-21da-394c-9f2d-aa0e6b94e0dc",
                                        "glosses": [
                                            "auf die Wiedereinrichtung früherer gesellschaftlicher oder politischer Verhältnisse bezogen; auf die Restauration gerichtet, die Restauration betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd29613b-752b-4b62-9f54-ba4f60cdf1d4",
                                                "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                                "text": "„Nur bei sehr oberflächlicher Betrachtung kann man die beschwörende Erinnerung einer idealen, harmonischen mittelalterlichen Katholizität als vormodern, restaurativ oder gar reaktionär verstehen.“"
                                            },
                                            {
                                                "example_id": "2aa68bd5-7b56-4314-9f02-072627d60641",
                                                "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                                "text": "„Inwieweit man die damalige Gesetzgebung als ‚restaurativ‘ bezeichnen will oder nicht, ist letztlich eine Wertungsfrage, auf die wir nicht näher eingegangen sind.“"
                                            },
                                            {
                                                "example_id": "f5841b2d-a514-4df8-b3fb-1c0ebc1c739c",
                                                "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                                "text": "„Es ist kein Wunder, dass diese restaurative Nostalgie oft Hand in Hand mit Verschwörungstheorien und mittelgroßen Lügen geht.“"
                                            },
                                            {
                                                "example_id": "2f7a060f-caf1-4d36-81b0-0f7827dd4efb",
                                                "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                                "text": "„Diese Wendung Schlegels vermittelt und leitet den Übergang auf eine restaurative Position ein.“"
                                            },
                                            {
                                                "example_id": "e8d96168-4b68-42fa-96ee-275f0e7a1e6d",
                                                "sense_id": "2e870bd4-fbfe-3ae6-9ff2-d27470848d7e",
                                                "text": "„Die fünfziger Jahre wurden die restaurativsten in der Geschichte der Bundesrepublik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
