                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4265a0f0-6be0-4bf1-bf9a-eb44322ed1b4",
                        "source_entry_id": "901233ca-e223-3c04-a989-d2a77f00a6b5",
                        "source_sense_id": "dab97866-c02d-3839-9d79-69dd7829c5ee",
                        "source_sense_description": "Feststellung, ob eine Gruppe von Personen an einem Ort vollzählig anwesend ist",
                        "target_lang_word": "appel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action d’appeler par la voix, par un geste ou par tout autre signal, pour faire venir à soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53921ca1-7bbb-45df-9ec3-26b831a4ea8f",
                                                "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                                "text": "— Reviens, reviens, criaient les camarades ; reviens vite ! Lebrac, aux trois quarts enlisé, céda à leurs appels et voulut tourner bride."
                                            },
                                            {
                                                "example_id": "ed4a289c-4f54-4faf-824b-f03fd82bce73",
                                                "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                                "text": "Mais un appel connu des Bretons frappa son oreille le chant du hibou, qui fut le cri de ralliement des Chouans et qu'on n'entend jamais à Paris."
                                            },
                                            {
                                                "example_id": "ca94e513-adac-4647-a143-022bdd63636f",
                                                "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                                "text": "Bientôt tes appels ne seront plus que rauquements de plus en plus sourds, beuglements de désespoir si fatigués qu’ils ne dépasseront plus ta gorge, étranglée de terreur […]"
                                            },
                                            {
                                                "example_id": "54270dda-c965-40df-8d52-7cc43ad69af5",
                                                "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                                "text": "En contrebas du hameau, une voix féminine a retenti : “Plume !” Obéissant à l’appel de sa propriétaire, la chienne est repartie fissa. Mais nous avions un nom."
                                            },
                                            {
                                                "example_id": "75875477-0964-4c18-a700-12fbaa75167b",
                                                "sense_id": "753e6841-7fae-3ca4-8e64-50daa847cdb4",
                                                "text": "En 2006 le 18 Juin a été institué par décret « journée nationale non chômée en commémoration de l'appel historique à refuser la défaite et à poursuivre le combat contre l'ennemi que le général de Gaulle » a lancé par radio sur les ondes de la BBC le 18 juin 1940. Dès le 18 juin 1941 le général de Gaulle fait de son appel l'événement inaugural, le symbole fondateur de la Résistance et le fait coïncider avec la naissance de la France libre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39fea669-d420-3644-8a63-0ca084fd8351",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Lors d’une progression en virée, annonce à haute voix des arbres marqués afin qu’ils soient enregistrés par le pointeur et que les autres membres des virées soient informés du marquage effectué."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80eca4bf-1c6d-4db4-9654-53221dc9618f",
                                                "sense_id": "39fea669-d420-3644-8a63-0ca084fd8351",
                                                "text": "On a donc inventé des compteurs plus ou moins perfectionnés, tel le compteur français DUBOZ — qui améliore sensiblement l'exactitude des appels, et reste croyons-nous le seul capable, par ses 3 ou 4 touches, d'enregistrer plusieurs essences, ou des catégories différentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff465fa0-af24-301c-befa-f98c75a5ca62",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Entrée en communication par l’intermédiaire du téléphone."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9523d95d-bb29-4c76-b464-6df6d9d4b062",
                                                "sense_id": "ff465fa0-af24-301c-befa-f98c75a5ca62",
                                                "text": "Le téléphone d’où est passé l’appel est immédiatement localisé. La communication a été émise depuis une cabine téléphonique située au lieu-dit La Commodité, sur la RN 7 à Solterre dans le Loiret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bcb8b4b-5c42-317d-9b84-d96d062452be",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action d’appeler au moyen d’un signal des personnes à s’assembler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24a2899-b8ff-4914-bd9b-6051a00ea466",
                                                "sense_id": "3bcb8b4b-5c42-317d-9b84-d96d062452be",
                                                "text": "Battre ou sonner l’appel (par exemple : des troupes, des soldats, des pompiers, de la population pour une annonce officielle, etc.), traditionnellement au moyen d'un tambour (« battre »), d'un clairon, d'une sonnerie, d'une clochette, d'une cloche (« sonner »)."
                                            },
                                            {
                                                "example_id": "cc71a7f4-3387-46c9-9f8c-44356f4f9def",
                                                "sense_id": "3bcb8b4b-5c42-317d-9b84-d96d062452be",
                                                "text": "Les paysans répondirent à l’appel du tocsin."
                                            },
                                            {
                                                "example_id": "eaee10ad-46a3-465d-aa79-3168b3c670c6",
                                                "sense_id": "3bcb8b4b-5c42-317d-9b84-d96d062452be",
                                                "text": "Le muezzin est monté chanter l’appel à la prière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3b0cd9-115a-3cdf-8917-fb1742f7da70",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action de réclamer, d’invoquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1196d42-de1f-49cc-8839-f60ceeda5e8d",
                                                "sense_id": "6c3b0cd9-115a-3cdf-8917-fb1742f7da70",
                                                "text": "Expressions : appel au secours, appel à la solidarité humaine, appel de fonds, appel d'offres, (etc.)."
                                            },
                                            {
                                                "example_id": "6951a609-c57b-4930-b0a3-9a744a03594c",
                                                "sense_id": "6c3b0cd9-115a-3cdf-8917-fb1742f7da70",
                                                "text": "Je lance un appel à votre générosité."
                                            },
                                            {
                                                "example_id": "b497b810-1051-4451-93e9-ba0b6da629e7",
                                                "sense_id": "6c3b0cd9-115a-3cdf-8917-fb1742f7da70",
                                                "text": "L’appel du pouvoir corrompt tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e08709d-96ca-3b8d-9ea3-85d2b3676e48",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Élan que l’on prend en appuyant sur le sol le pied qui va assurer la projection du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fce4338-16af-4fe1-9ca4-89b187259ccc",
                                                "sense_id": "8e08709d-96ca-3b8d-9ea3-85d2b3676e48",
                                                "text": "Ton pied d’appel préférentiel, est-ce le pied droit ou le pied gauche ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "931f8577-9906-3812-b603-5b9e668111bb",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            ": Battement du pied fait sur place pour commencer l’attaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84389aa2-8884-474f-b097-1dc8a932599e",
                                                "sense_id": "931f8577-9906-3812-b603-5b9e668111bb",
                                                "text": "Sa rapière, vivant serpent, sifflait dans sa main. Son pied battait des appels, il les provoquait, les menaçait de la voix, du regard, de tout son être tendu comme un ressort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10416d8c-9b4d-3eb7-b48d-cdc1434c02c5",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action d’appeler à haute voix des personnes qui doivent se trouver dans une classe, un groupe, etc., afin de s’assurer qu’elles sont présentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a150ea-3bcf-4934-93d3-fe64c79ee7b6",
                                                "sense_id": "10416d8c-9b4d-3eb7-b48d-cdc1434c02c5",
                                                "text": "Nous sortîmes sur la grande cour de la prison et là, dans un coin à gauche, devant la porte entrouverte, on fit quelque chose comme un appel nominal."
                                            },
                                            {
                                                "example_id": "ae14f495-304d-4819-a28e-88ac6a98ac2e",
                                                "sense_id": "10416d8c-9b4d-3eb7-b48d-cdc1434c02c5",
                                                "text": "Lidoire.– Silence à l’appel ! — Manque personne, mon lieutenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa04d034-5afd-3d10-a214-28464bb7a1ee",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Demander à ce qu’une affaire soit rejugée en seconde instance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359027ef-08c8-49f6-84bf-246a794325f4",
                                                "sense_id": "fa04d034-5afd-3d10-a214-28464bb7a1ee",
                                                "text": "L’exécution de la sentence est suspendue car il a fait appel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "836a8b52-9d7d-3665-b9de-ea1a1448d45a",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action d’appeler à haute voix chaque membre d’une assemblée parlementaire pour qu’il exprime son opinion ou donne son vote."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cd820a4-ec1f-321d-98a8-883ac329cf9d",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Provocation en duel, un cartel. On dit plus ordinairement défi."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5fce2c-2ea0-40ee-bad7-661a892d1152",
                                                "sense_id": "5cd820a4-ec1f-321d-98a8-883ac329cf9d",
                                                "text": "Les appels sont défendus comme les duels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c3564a-c3a3-32bc-8110-4a0e4b108748",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Action d’appeler des conscrits sous les drapeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee0836b-2803-4c39-b482-7dc3b76a4c9a",
                                                "sense_id": "c5c3564a-c3a3-32bc-8110-4a0e4b108748",
                                                "text": "Il n’y a pas eu de réfractaires, tous les jeunes gens ont répondu à l’appel qui leur a été fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353e318d-828f-325f-a2bf-6afddba6fa86",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Utilisation d'une variable connue ou exécution d’une fonction connue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "378e67b7-4131-3b18-80cf-6cca3112d1de",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "Fait de se sentir irrésistiblement enjoint de faire un choix de vie crucial."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfff3564-6aa4-4630-aa36-77c0cbc9c78d",
                                                "sense_id": "378e67b7-4131-3b18-80cf-6cca3112d1de",
                                                "text": "Dans la Trilogie marseillaise de Marcel Pagnol, théâtrale et cinématographique, l’appel du large que ressent le jeune Marius est au début plus fort que son profond amour pour la petite Fanny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a2f3bb6-1078-3855-ab38-c47df403da16",
                                        "entry_id": "12a2d13f-91f7-38ea-9d63-57c1b402e188",
                                        "glosses": [
                                            "(Vocabulaire technique) et Définition manquante ou à compléter. (Ajouter)"
                                        ],
