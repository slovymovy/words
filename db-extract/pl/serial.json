                                    {
                                        "sense_id": "83cb904e-98dd-3893-8060-a65efaabf7e2",
                                        "entry_id": "8af3d50b-cb71-362a-b946-d9469305d435",
                                        "glosses": [
                                            "Having to do with or arranged in a series."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9fc981c-267b-4d77-b2fd-5da3456c3763",
                                                "sense_id": "83cb904e-98dd-3893-8060-a65efaabf7e2",
                                                "text": "These singular ribs have a very different direction from that of the serial teeth of the hinge, and cannot be taken for teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                        "entry_id": "8af3d50b-cb71-362a-b946-d9469305d435",
                                        "glosses": [
                                            "Who performs a specified action or course of action repeatedly or regularly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b9428a8-23bb-4ec9-ae6c-d2b0ea71a144",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "The serial killer had a string of victims across seven states."
                                            },
                                            {
                                                "example_id": "7ac0845b-f992-4f5d-b5ac-72fc7ae5abe2",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "He was a serial entrepreneur, always coming up with a new way to make cash."
                                            },
                                            {
                                                "example_id": "4f58fbbd-7092-447b-9eb5-5a9166fbc2f2",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "\"No I could not!\" Kate looked at Max sternly. \"I am not a cheat and I am not a serial monogamist.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d668f5f-e95c-3836-bd93-3161fb225d84",
                                        "entry_id": "8af3d50b-cb71-362a-b946-d9469305d435",
                                        "glosses": [
                                            "Published or produced in installments."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4e219ac-e8e9-394b-916a-58a1e9444b4a",
                                        "entry_id": "8af3d50b-cb71-362a-b946-d9469305d435",
                                        "glosses": [
                                            "Of or relating to a grammatical aspect relating to an action that is habitual and ongoing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "serial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2276b025-1e21-3738-b6eb-bfcbc17ad096",
                                        "entry_id": "802b2334-999e-34bc-8100-aa703c725b20",
                                        "glosses": [
                                            "A literary or dramatic work, such as a radio or television programme, published in installments, often numbered and without a specified end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90928c26-a790-3316-bf5d-d6581858f29e",
                                        "entry_id": "802b2334-999e-34bc-8100-aa703c725b20",
                                        "glosses": [
                                            "A publication issued in successive parts, often numbered and with no predetermined end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0723f3e9-a752-37da-81da-5089dc0d08c8",
                                        "entry_id": "802b2334-999e-34bc-8100-aa703c725b20",
                                        "glosses": [
                                            "A serial number, esp. one required to activate software."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6559a34a-50e9-4d82-af2e-f21b8385c963",
                                                "sense_id": "0723f3e9-a752-37da-81da-5089dc0d08c8",
                                                "text": "Go to these sites for serials, cracks and keygens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "181e34ef-c17c-3889-95d3-843a4649ef02",
                                        "entry_id": "802b2334-999e-34bc-8100-aa703c725b20",
                                        "glosses": [
                                            "A unit of police officers equipped with shields to tackle a riot."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d502e1-5ac5-4197-ac8e-e6bb5a84e725",
                                                "sense_id": "181e34ef-c17c-3889-95d3-843a4649ef02",
                                                "text": "The practice, especially among members of shield serials, of 'whooping like cowboys and indians' and beating of truncheons on riot shields must cease as this tends to frighten and intimidate rioters."
                                            },
                                            {
                                                "example_id": "6187b65d-70de-496d-bd72-3ba8ce299fed",
                                                "sense_id": "181e34ef-c17c-3889-95d3-843a4649ef02",
                                                "text": "The serials worked in pairs, one with long shields and one with short shields."
                                            }
                                        ]
                                    }
                                ]
