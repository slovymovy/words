                "senses": [
                    {
                        "sense_id": "8a053f5a-7308-3131-891e-c02577b6c67c",
                        "entry_id": "ec4115eb-0ed4-3e9b-b6fb-2f074dbc7428",
                        "glosses": [
                            "elk van de symbolen voor een klank waaruit een alfabet is opgebouwd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0240a1d6-02d5-41ae-9e5b-ac35a792a252",
                                "sense_id": "8a053f5a-7308-3131-891e-c02577b6c67c",
                                "text": "Het aantal lettertekens waaruit een alfabet is opgebouwd verschilt per taal; in het Nederlands kent men er 26, maar in bijvoorbeeld het Zweeds zijn er 29."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f6965e0-5c32-48b2-93f9-59393ad06ed8",
                        "source_entry_id": "ec4115eb-0ed4-3e9b-b6fb-2f074dbc7428",
                        "source_sense_id": "8a053f5a-7308-3131-891e-c02577b6c67c",
                        "source_sense_description": "elk van de symbolen voor een klank waaruit een alfabet is opgebouwd",
                        "target_lang_word": "Schriftzeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftzeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                        "entry_id": "93ee2053-dddd-3452-a3b2-1dfc6935bf85",
                                        "glosses": [
                                            "kleinstes, einzelnes Zeichen zur schriftlichen Wiedergabe von sprachlichen Äußerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0332a1dc-9ba3-4cfd-bac6-655866d72787",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "In einigen europäischen Sprachen gibt es für die Umlaute spezielle Schriftzeichen."
                                            },
                                            {
                                                "example_id": "26a5a8a3-fb5b-4a2d-904b-f4f8a2f07d4b",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Die Einheiten, auf die sich chinesischen Schriftzeichen beziehen, sind bedeutungsvolle sprachliche Formen.“"
                                            },
                                            {
                                                "example_id": "c345fb64-a93b-4298-9c9a-6b3b3238aa95",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Wenn im Folgenden dennoch von ›Schriftzeichen‹ die Rede ist, dann folge ich dem Usus der einschlägigen Literatur.“"
                                            },
                                            {
                                                "example_id": "bb54b19f-bbe3-47a7-a71c-fb8e6abe0b72",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Die Schriftzeichen auf diesen Bruchstücken gelten als die ältesten bekannten Spuren der chinesischen Schrift.“"
                                            },
                                            {
                                                "example_id": "69e1b394-86ad-4202-b371-159e04af21a8",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Nicht für Feder und Tinte sind die Schriftzeichen gemacht, nicht für schwungvolles Schreiben auf Pergament.“"
                                            },
                                            {
                                                "example_id": "66b5ad43-3b38-42c7-8299-07f81700e34c",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Woher die Schriftzeichen tatsächlich stammen, darüber streiten die Gelehrten seit langem.“"
                                            },
                                            {
                                                "example_id": "7bfdd34b-553e-497b-a9b3-8805334d6b96",
                                                "sense_id": "dcb1074d-7a96-3588-8dd1-a7e0f49b1168",
                                                "text": "„Mirko starrte die schon hundertmal ihm erklärten Schriftzeichen immer wieder fremd an;“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "671c54c3-51a6-4c4b-9b39-37db5bb1bf6f",
                        "source_entry_id": "ec4115eb-0ed4-3e9b-b6fb-2f074dbc7428",
                        "source_sense_id": "8a053f5a-7308-3131-891e-c02577b6c67c",
                        "source_sense_description": "elk van de symbolen voor een klank waaruit een alfabet is opgebouwd",
                        "target_lang_word": "character",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "character",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eaaa755-0412-37a8-be05-a085effc4598",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A being involved in the action of a story; a persona."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e2042c-db0f-4d0b-a7d0-4c9ae7703a75",
                                                "sense_id": "4eaaa755-0412-37a8-be05-a085effc4598",
                                                "text": "[I]n a tragedy, or epick poem, the hero of the piece must be advanced foremost to the view of the reader or spectator; he must outshine the rest of all the characters; he must appear the prince of them, like the sun in the Copernican system, encompassed with the less noble planets …"
                                            },
                                            {
                                                "example_id": "df679959-fdaa-4879-bfa9-7b2965dc23b0",
                                                "sense_id": "4eaaa755-0412-37a8-be05-a085effc4598",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "8398bb55-575d-4d50-a6c3-4fa4651ee64e",
                                                "sense_id": "4eaaa755-0412-37a8-be05-a085effc4598",
                                                "text": "But Pirates! comes with all the usual Aardman strengths intact, particularly the sense that its characters and creators alike are too good-hearted and sweet to nitpick. The ambition is all in the craft rather than in the storytelling, but it’s hard to say no to the proficiency of that craft, or the mild good cheer behind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0948e6e5-ccbf-3e6f-876d-8e69f791df33",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A distinguishing feature; characteristic; trait; nature; phene."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e40f95ce-4d40-47c2-b846-054a3cdb1077",
                                                "sense_id": "0948e6e5-ccbf-3e6f-876d-8e69f791df33",
                                                "text": "A single locus governing the petal colour character was detected on the linkage group A2."
                                            },
                                            {
                                                "example_id": "b00532be-ced3-405b-8310-2f962548a69b",
                                                "sense_id": "0948e6e5-ccbf-3e6f-876d-8e69f791df33",
                                                "text": "We were not able to ascertain the character of the relationship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764df215-7f4d-35a9-a585-1893bc24dee9",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A complex of traits marking a person, group, breed, or type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "076ebbfa-2171-41ee-ac4a-bfab0550211b",
                                                "sense_id": "764df215-7f4d-35a9-a585-1893bc24dee9",
                                                "text": "A man of […] thoroughly subservient character"
                                            },
                                            {
                                                "example_id": "55f39414-2b42-489d-9a8c-dc89ae666719",
                                                "sense_id": "764df215-7f4d-35a9-a585-1893bc24dee9",
                                                "text": "A study of the suspect's character and his cast iron alibi ruled him out."
                                            },
                                            {
                                                "example_id": "4900f7a2-204a-42c9-b05b-8fa80a0836f3",
                                                "sense_id": "764df215-7f4d-35a9-a585-1893bc24dee9",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc066a6-131b-3f7a-9148-5604849148b1",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "Strength of mind; resolution; independence; individuality; moral strength."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13539ee5-f83a-4480-9148-e92067346e95",
                                                "sense_id": "dbc066a6-131b-3f7a-9148-5604849148b1",
                                                "text": "He has a great deal of character."
                                            },
                                            {
                                                "example_id": "766423b2-cf65-40ca-9113-b26d2dcbfd00",
                                                "sense_id": "dbc066a6-131b-3f7a-9148-5604849148b1",
                                                "text": "\"You may not like to eat liver,\" said Calvin's father, \"but it builds character.\""
                                            },
                                            {
                                                "example_id": "bcd24b5a-7374-4b72-9e24-7ec1829a79ae",
                                                "sense_id": "dbc066a6-131b-3f7a-9148-5604849148b1",
                                                "text": "Shepard: Are you attracted to other species?\nKelly: Well, part of my job is predicting the motives and feelings of humans and aliens. Intimacy brings understanding.\nKelly: And passion is nice wherever you find it. Character matters, not race or gender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62e228b-7ebc-30e0-a173-52442dd1e381",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A unique or extraordinary individual; a person characterized by peculiar or notable traits, especially charisma."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf0c943-e6d6-48ee-93cb-9b670e256922",
                                                "sense_id": "e62e228b-7ebc-30e0-a173-52442dd1e381",
                                                "text": "Julius Caesar is a great historical character."
                                            },
                                            {
                                                "example_id": "7afb8158-a101-42d6-a2f3-a3149ffb73d4",
                                                "sense_id": "e62e228b-7ebc-30e0-a173-52442dd1e381",
                                                "text": "That bloke is such a character."
                                            },
                                            {
                                                "example_id": "5af26cab-aeb6-47c3-b917-912d0e55ae9b",
                                                "sense_id": "e62e228b-7ebc-30e0-a173-52442dd1e381",
                                                "text": "STINGER: Don't screw around with me Maverick. You're a hell of an instinctive pilot. Maybe too good. I'd like to bust your butt but I can't. I got another problem here. I gotta send somebody from this squadron to Miramar. I gotta do something here, I still can't believe it. I gotta give you your dream shot, I'm gonna send you up against the best. You two characters are going to Top Gun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1364a533-e90b-30ea-b4d3-22f5af9d6a22",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A written or printed symbol, or letter."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c849ee4-7a44-4fce-b5dd-0b9fa3c963b3",
                                                "sense_id": "1364a533-e90b-30ea-b4d3-22f5af9d6a22",
                                                "text": "It were much to be wished that there were throughout the world but one sort of character for each letter to express it to the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f237e12-7163-3a93-bbb3-0138f6f95d99",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "Style of writing or printing; handwriting; the particular form of letters used by a person or people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffe45122-05e5-4ac8-a561-1ad6b98d9ea3",
                                                "sense_id": "0f237e12-7163-3a93-bbb3-0138f6f95d99",
                                                "text": "an inscription in the Runic character"
                                            },
                                            {
                                                "example_id": "dd4c6754-ced2-4b97-afa8-5ef902e149e5",
                                                "sense_id": "0f237e12-7163-3a93-bbb3-0138f6f95d99",
                                                "text": "You know the character to be your brother's?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56816b6a-2de1-3b97-910a-a592d3d7dbe6",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A secret cipher; a way of writing in code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fd1d275-254f-3ee5-841d-befbfb5e602d",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "One of the basic elements making up a text file or string: a code representing a printing character or a control character."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e8e19a-717a-453c-8ae6-76b335c736ae",
                                                "sense_id": "6fd1d275-254f-3ee5-841d-befbfb5e602d",
                                                "text": "We'll start at the beginning, with the basic building blocks not just of emoji, nor even digital communication, but of all written language: characters and character sets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e94f92a-e30f-3b4f-929d-bb6da558dea4",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A person or individual, especially one who is unknown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3990268b-ec40-4c7b-8f08-d3f6497aaea9",
                                                "sense_id": "8e94f92a-e30f-3b4f-929d-bb6da558dea4",
                                                "text": "We saw a shady character slinking out of the office with some papers."
                                            },
                                            {
                                                "example_id": "bf5c1635-122a-4602-8703-99c5df6f7d7d",
                                                "sense_id": "8e94f92a-e30f-3b4f-929d-bb6da558dea4",
                                                "text": "That old guy is a real character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e536672a-6d3c-3dc2-82fe-43ac5d33b694",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "An assignment of complex numbers to each element of a group, in particular a finite abelian group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "533726d2-d867-3983-9542-3f470b86884b",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "Quality, position, rank, or capacity; quality or conduct with respect to a certain office or duty."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75fc5aa5-d29e-4c49-bd4f-f87bc6009d18",
                                                "sense_id": "533726d2-d867-3983-9542-3f470b86884b",
                                                "text": "in the miserable character of a slave"
                                            },
                                            {
                                                "example_id": "4afc32c0-d87e-463a-8d35-91a62683986f",
                                                "sense_id": "533726d2-d867-3983-9542-3f470b86884b",
                                                "text": "in his character as a magistrate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd26e3b2-984d-340e-8a22-18e9ccf36210",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "The estimate, individual or general, put upon a person or thing; reputation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74969d66-2775-4861-8cb6-ef1d8925a3e5",
                                                "sense_id": "cd26e3b2-984d-340e-8a22-18e9ccf36210",
                                                "text": "a man's character for truth and veracity"
                                            },
                                            {
                                                "example_id": "729f25be-1d61-42ab-93cb-fdb8f6b42443",
                                                "sense_id": "cd26e3b2-984d-340e-8a22-18e9ccf36210",
                                                "text": "Her actions give her a bad character."
                                            },
                                            {
                                                "example_id": "16ebddd2-19e1-422a-8801-535bfa67af16",
                                                "sense_id": "cd26e3b2-984d-340e-8a22-18e9ccf36210",
                                                "text": "This subterraneous passage is much mended since Seneca gave so bad a character of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "227d66b6-1c17-300c-9176-a6179f5bca5a",
                                        "entry_id": "2b61f94f-ca28-3258-bd35-d1684a016b5d",
                                        "glosses": [
                                            "A reference given to a servant, attesting to their behaviour, competence, etc."
                                        ],
