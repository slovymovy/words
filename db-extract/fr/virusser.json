                                    },
                                    {
                                        "sense_id": "bfee1431-48c0-36c7-92a2-227a2066a42f",
                                        "entry_id": "c6cc2090-abe0-3c9a-8c02-0f0867424d22",
                                        "glosses": [
                                            "rozšířit negativní jev"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe5315bc-13fc-4bcc-bb73-8cb82346a00b",
                                                "sense_id": "bfee1431-48c0-36c7-92a2-227a2066a42f",
                                                "text": "Není to velké překvapení – v historii to byla výspa islámu v Evropě a přibližně polovina etnických Albánců, kteří tvoří většinu i v Kosovu, se s ním ve velké míře ztotožňuje. A úřady v obou zemích nyní upozorňují, že se radikalismu zrozenému v Sýrii podařilo společnost rychle „zavirovat“."
                                            }
                                        ]
                                    }
                                ]
