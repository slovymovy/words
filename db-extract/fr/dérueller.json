                "senses": [
                    {
                        "sense_id": "bcf13a9e-9a7b-3224-84f2-babfc96f0ca5",
                        "entry_id": "a5c76895-a9ea-3698-817c-f08bf1c25a25",
                        "glosses": [
                            "Enlever la terre qui avait été mise contre les ceps quand on avait ruellé la vigne."
                        ],
                        "tags": [
                            "Extrêmement rare",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "09aaf1a7-7a13-4459-8e2c-22bee21ce9e0",
                                "sense_id": "bcf13a9e-9a7b-3224-84f2-babfc96f0ca5",
                                "text": "On a coutume de fumer les jeunes plantes lorsqu'elles ont trois ou quatre ans, & ce fumage se fait de deux façons ; savoir, par trous dans les terres, qu'on ne ruelle pas ; & dans celles qu'on ruelle, par rigoles longues, qui se font au milieu des perchées, en tirant de côté & d'autre la terre contre les ceps ; ce qui releve les deux moitiés de la perchée, & les joint ensemble en dos-d'âne."
                            }
                        ]
                    }
