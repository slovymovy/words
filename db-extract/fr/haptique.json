                    },
                    {
                        "form_id": "261baad3-738b-47b1-9758-868782ce2764",
                        "entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
                        "tags": [],
                        "form": "aptique"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                        "entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
                        "glosses": [
                            "Relatif au toucher, aux interfaces, procurant cette sensation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39ec0a10-e7b7-4951-b8b6-f3f9fb2db37a",
                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                "text": "De nombreuses recherches soulignent l’efficience du système perceptif haptique, qui peut appréhender presque toutes les propriétés accessibles par la vision."
                            },
                            {
                                "example_id": "b1859350-b9e4-4eb0-ab0b-0a84cff6a354",
                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                "text": "Le sens haptique résulte de l'activité simultanée et coordonnée des récepteurs tactiles et kinesthésiques qui fournissent de l'objet une perception unique en trois dimensions."
                            },
                            {
                                "example_id": "a4266a56-9a83-459c-9511-8cdc319d6cc7",
                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                "text": "Les sensations haptiques englobent un large éventail de perceptions, incluant les vibrations, les textures, la température, la dureté, le poids et la forme à différentes échelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d404c9b-fe90-4cd3-86ef-7b117bbfe24a",
                        "source_entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
                        "source_sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                        "target_lang_word": "haptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                        "entry_id": "6b01a8f1-4139-3fa9-9227-1bf46ce8a597",
                                        "glosses": [
                                            "den Tastsinn betreffend, auf ihm beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8ced89-8dd4-48e5-92c9-966eb8826285",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Der Tastsinn ist die haptische Wahrnehmung von Lebewesen."
                                            },
                                            {
                                                "example_id": "b3fbb769-a81c-45bb-a8fb-0beb7182fda0",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Diese Geräte erlauben das intuitive „Begreifen“ und die haptisch unterstützte Manipulation von Objekten in der 3D-Simulationsumgebung."
                                            },
                                            {
                                                "example_id": "196d7288-687a-40cf-9e74-8aa675cc9e76",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Durch die Bilder und die Aktivität des Schreibens haben die Lerner einen haptischeren Zugang zum Thema, als wenn sie sich theoretisch und reflektierend damit befassen würden."
                                            },
                                            {
                                                "example_id": "cba824ea-4d87-4307-9239-d8b1a4a4860f",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Es war der vielleicht haptischste Versuch, den Raum als Ganzes zurückzuerobern, seit dieser nicht mehr gebraucht wurde von PC und Bildschirm."
                                            },
                                            {
                                                "example_id": "a4ce83aa-f30b-4f4c-9fdf-a1c7084d6536",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Überhaupt betont selbstverständlich das Fleischliche die Körperlichkeit in der Kunst, sodass Hrdlicka pointiert behauptet, dass sein Kontakt zu Prostituierten ihm in der Entscheidung, sich der Bildhauerei - der haptischsten künstlerischen Gattung - zuzuwenden, behilflich gewesen sei."
                                            },
                                            {
                                                "example_id": "b729d8bd-e0f1-4c75-8a22-b1adefb8b7ac",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "… auf die Frage, ob die Rollen von modernen Vätern und Müttern austauschbar sind: \"Das glaube ich nicht. Väter sind viel haptischer mit ihren Kindern. Greta fordert mich zur Zeit dauernd zum Ringen heraus, wir machen fast jeden Abend eine Runde Wrestling. Klar, dass ich sie gewinnen lasse.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "263eb511-915a-42b4-ad86-74b9d8a895ea",
                        "source_entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
                        "source_sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                        "target_lang_word": "haptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc98dbe-b1e9-3ceb-8f50-6d6f2b1c3984",
                                        "entry_id": "fe30f90e-6a28-3f42-9969-ac94790f84ba",
                                        "glosses": [
                                            "Of or relating to the sense of touch."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf9847c-d9b5-406b-b1ef-d164e5ea219d",
                                                "sense_id": "7fc98dbe-b1e9-3ceb-8f50-6d6f2b1c3984",
                                                "text": "So there may be sciences of touch, taste, and smell; which will be Haptic, Geustic and Osphrantic."
                                            },
                                            {
                                                "example_id": "9e787c3f-889e-4968-88d2-13dd3e14aab1",
                                                "sense_id": "7fc98dbe-b1e9-3ceb-8f50-6d6f2b1c3984",
                                                "text": "Although the five basic senses are often studied as individual systems covering visual, auditory, taste, smell, orientation and the haptic sensations, there is an interplay between the senses."
                                            },
                                            {
                                                "example_id": "a6a022c1-cb98-413d-99af-029ab8db8846",
                                                "sense_id": "7fc98dbe-b1e9-3ceb-8f50-6d6f2b1c3984",
                                                "text": "An engineer tends to describe haptics primarily in terms of forces, elongations, frequencies, mechanical tensions, and shear forces. This of course makes sense and is important for the technical design process. However haptics is more than that. Haptic perceptions range from minor interactions in everyday life, e.g., drinking from a glass or writing this text, to a means of social communication, e.g., shaking hands or giving someone a pat on the shoulder, and very personal and private interpersonal experiences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b14b7bf-05a2-36d6-9c30-6178ebe9a570",
                                        "entry_id": "fe30f90e-6a28-3f42-9969-ac94790f84ba",
                                        "glosses": [
                                            "Of or relating to haptics (“the study of user interfaces that use the sense of touch”)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b880bace-cb50-40bd-9d63-706bd3297eda",
                                                "sense_id": "5b14b7bf-05a2-36d6-9c30-6178ebe9a570",
                                                "text": "[T]he new standard should encompass other media, such as video, audio (both captured and synthetic), and in principle be extensible to new modalities such as haptic output and speech or gestural input, which have become increasingly integrated within graphics applications; […]"
                                            },
                                            {
                                                "example_id": "99312115-7dac-4d0f-995a-986447fe23aa",
                                                "sense_id": "5b14b7bf-05a2-36d6-9c30-6178ebe9a570",
                                                "text": "We might think, for example, about tele- (or remote) surgery, a technique that, now more than ever before, is enabling surgeons around the world to operate using haptic interfaces that control robotic systems located at different locations."
                                            },
                                            {
                                                "example_id": "0f131d07-d599-47d3-bb18-fdd67f065393",
                                                "sense_id": "5b14b7bf-05a2-36d6-9c30-6178ebe9a570",
                                                "text": "Haptic feedback, or virtual touch, can also contribute to an IVE [immersive virtual environment] by providing forces or resistance with a physical device that resists a physical hand or finger. […] Vibration motors in smartphones and tablets can also be seen as a rudimentary form of haptic feedback."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3889a835-5468-440c-9024-e1e1fec22e4b",
                        "source_entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
