                        "glosses": [
                            "Appareil optique qui produit un rayonnement d’une seule couleur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37d6c7b0-42a8-3060-95b5-ea88a713fb88",
                        "entry_id": "ef198e08-629b-3d82-a364-bce4ffae097a",
                        "glosses": [
                            "Système optique permettant d’isoler et de produire une radiation, une lumière monochromatique, c’est-à-dire à une seule longueur d’onde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4729db6d-8c22-466f-9b44-6911b74e21d9",
                                "sense_id": "37d6c7b0-42a8-3060-95b5-ea88a713fb88",
                                "text": "Si, dans un spectroscope, on supprime l’oculaire et que l’on place une fente dans le plan focal de l’objectif, fente réglable micrométriquement et ne laissant passer qu’une partie du spectre, on obtient un monochromateur […] permettant de sélectionner des radiations monochromatiques de longueurs d’onde connues."
                            }
                        ]
