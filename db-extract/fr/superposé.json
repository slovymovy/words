                "senses": [
                    {
                        "sense_id": "0e3eac4d-c1be-35ea-885a-c65fdf68341f",
                        "entry_id": "58a3984c-1d81-324f-ae40-dd2c2a7fec7e",
                        "glosses": [
                            "Situé l’un au-dessus de l’autre, en parlant de plusieurs choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44591122-0d5d-402b-9c0c-11de9b0057e0",
                                "sense_id": "0e3eac4d-c1be-35ea-885a-c65fdf68341f",
                                "text": "L’État a choisi le dossier Cofiroute et son tunnel de dix kilomètres à deux niveaux de circulation superposés réservé aux seuls véhicules légers : les poids lourds n’emprunteront pas l’ouvrage, ils auront le leur."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a569547-0592-389f-bc46-dd459263f93f",
                        "entry_id": "58a3984c-1d81-324f-ae40-dd2c2a7fec7e",
                        "glosses": [
                            "Se dit de meubles de même importance posés les uns sur les autres en montant vers le chef (contrairement à posé et soutenant qui introduisent une notion de hiérarchie entre les meubles)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51cfe98-077a-46f9-8c25-fd300016591f",
                                "sense_id": "3a569547-0592-389f-bc46-dd459263f93f",
                                "text": "De gueules à trois pal d'or, parti de sinople aux deux ponts superposés et surmontés d'une fontaine, le tout d'argent maçonné de sable au chef de France, qui est de Juvisy-sur-Orge → voir illustration « ponts superposés »"
                            }
                        ]
                    }
                ],
