                "senses": [
                    {
                        "sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                        "entry_id": "5f6068aa-a8f9-3a59-9a44-6c81d7bace7f",
                        "glosses": [
                            "sehr kleiner Schallwandler, der an oder in den Ohren getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39630c81-3a94-4030-a547-8bfb279f4ef3",
                                "sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                                "text": "Ergonomisch geformte, leichte Ohrhörer mit Geräuschisolierung bieten hohen Komfort."
                            },
                            {
                                "example_id": "3e310215-6576-4b84-b3ad-8888fdb0e67c",
                                "sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                                "text": "„Apple hatte die Technik, bei der die Ohrhörer per Funk und nicht per Kabel miteinander verbunden sind, mit seinen Kopfhörern massentauglich gemacht und zu einem Milliardengeschäft ausgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fcb002f-f9bf-4aef-bb1a-0183cc195429",
                        "source_entry_id": "5f6068aa-a8f9-3a59-9a44-6c81d7bace7f",
                        "source_sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                        "source_sense_description": "sehr kleiner Schallwandler, der an oder in den Ohren getragen wird",
                        "target_lang_word": "earphone",
