                        ],
                        "form": "expertes"
                    },
                    {
                        "form_id": "58f3c56e-7ec1-424b-8d7e-da4e6983ddf5",
                        "entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
                        "tags": [
                            "masculine"
                        ],
                        "form": "expert"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bea92e5-df8a-3d34-84f0-97d596b3223d",
                        "entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
                        "glosses": [
                            "Celle qui est nommée par autorité de justice, ou choisie par les parties intéressées pour examiner, pour estimer certaines choses et en faire son rapport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9250c30-d64c-4842-8bc6-95d1aea5e491",
                                "sense_id": "7bea92e5-df8a-3d34-84f0-97d596b3223d",
                                "text": "Selon l’experte à la barre, les troubles dont souffrirait l’actrice entraîneraient des comportements abusifs envers ses partenaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e90bc57-c601-36aa-bd6b-1cf01a42be9b",
                        "entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
                        "glosses": [
                            "Celle qui a un savoir, une connaissance, reconnus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e47cec-f23c-471d-aca4-1e2d9be31dd5",
                                "sense_id": "3e90bc57-c601-36aa-bd6b-1cf01a42be9b",
                                "text": "Le seul mot de « champignon » semblait déclencher son immédiate salivation et, si elle ne mentait pas en se prétendant experte dans l’art des accommodages, elle n’y connaissait strictement rien en identification, se fiant — avec l’obstination entêtée d’une vieille mule — à un ramassis de recettes douteuses : pièces de monnaie qui noircissent, queues de persil qui jaunissent, passages de limaces, réactions au vinaigre, etc."
                            },
                            {
                                "example_id": "91931009-61f7-48b4-a85c-965cae485dc6",
                                "sense_id": "3e90bc57-c601-36aa-bd6b-1cf01a42be9b",
                                "text": "« Tout un courant s’est développé depuis quinze-vingt ans, la “technostalgie”, une manière d’innover à partir des technologies du passé », explique l’experte, citant les walkmans Bluetooth, les applications qui permettent de filmer à la manière d’une VHS et autre machine à écrire USB."
                            },
                            {
                                "example_id": "99a0d08f-3b90-4a0b-8431-5107ef6fd2a1",
                                "sense_id": "3e90bc57-c601-36aa-bd6b-1cf01a42be9b",
                                "text": "« Cela fait référence aux impacts irréversibles liés au changement climatique, c’est-à-dire ceux qui sont déjà réels et qu’on ne pourra éviter », cadre Fanny Petitbon, experte climat à Care France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bc787af-4853-483f-84f2-1463f8435d2d",
                        "source_entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
                        "target_lang_word": "Expertin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Expertin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                        "entry_id": "5f6525d0-0954-38a3-953b-50db32f798a6",
                                        "glosses": [
                                            "weibliche Person, die in einem bestimmten Gebiet bzw. Fach sehr bewandert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c92b5991-0448-472e-86f6-baa29b4d4979",
                                                "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                                "text": "Sie weiß einfach alles über Musik. Sie ist eine absolute Expertin in dem Fach."
                                            },
                                            {
                                                "example_id": "cc554e14-0c97-474e-9f86-698b4cdb24d8",
                                                "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                                "text": "„Eigentlich ist sie keine Expertin für Vögel - ihr Forschungsgebiet sind Moschusochsen, jene Urviecher, die jemand in den Sechzigerjahren in der Nähe des Flughafens von Kangerlussuaq angesiedelt hat - und die sehr zartes Fleisch liefern.“"
                                            },
                                            {
                                                "example_id": "b75f5bda-5d67-4682-989b-2dcfda74ebf5",
                                                "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                                "text": "„Hier hat man geradezu spektakuläre Schriftfunde gemacht, wie die Aufsätze der beiden Expertinnen in diesem Band eindrücklich belegen.“"
                                            },
                                            {
                                                "example_id": "82a74f36-0530-468d-a28d-ad483726aee9",
                                                "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                                "text": "„In meinem Laden bin ich kompetente Ansprechpartnerin, Expertin und Chefin, und viele Kundinnen sind sehr glücklich, wenn sie von mir persönlich beraten werden.“"
                                            },
                                            {
                                                "example_id": "662fb8c4-8fd1-459d-8e12-7de75f9e871b",
                                                "sense_id": "29f43e16-85b5-3bc9-80d5-5b0b72292e64",
                                                "text": "„Expertinnen für die Geschichte der Indigenen Nordamerikas vermuten mittlerweile, dass Smith in ein Ritual zur Aufnahme in den Powhatan eingebunden wurde, dies aber nicht erkannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b03d5013-9d2e-4949-956f-ed0ef2e6a19a",
                        "source_entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
