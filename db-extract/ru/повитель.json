                "senses": [
                    {
                        "sense_id": "f9d81e0f-a82f-34f4-aed3-d9402b595f82",
                        "entry_id": "f328fba2-810e-3136-9ee4-2dffe16580ac",
                        "glosses": [
                            "bindweed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4a9406-96d1-41c0-a439-344390d650ad",
                                "sense_id": "f9d81e0f-a82f-34f4-aed3-d9402b595f82",
                                "text": "Плетни́ от безлю́дья то́же зацвели́: их обви́ли хмель и повите́ль, а не́которые ко́лья и хворости́ны приняли́сь и обеща́ли стать ро́щей, е́сли лю́ди не верну́тся.",
                                "translation": "In the absence of people, the wattle fences had also begun to flower; hops and bindweed had wound around them, and some of the stakes and switches had taken root, promising to turn into thickets unless people came back.",
                                "english": "In the absence of people, the wattle fences had also begun to flower; hops and bindweed had wound around them, and some of the stakes and switches had taken root, promising to turn into thickets unless people came back."
                            }
                        ]
                    }
