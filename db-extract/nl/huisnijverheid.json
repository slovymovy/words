                        "sense_id": "b12f51d6-1b75-3d61-9277-fde696abe5fd",
                        "entry_id": "cc8c9c66-345c-3f0d-af4c-e83dc7684131",
                        "glosses": [
                            "beroep of ambacht waarbij vanuit huis gewerkt en geproduceerd wordt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "fbd24aea-eb0b-48fb-b8dd-905fa761ddc7",
                                "sense_id": "b12f51d6-1b75-3d61-9277-fde696abe5fd",
                                "text": "Verbeteringen in de huisnijverheid en landbouw legden de basis voor het ontstaan van de Industriële Revolutie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3073684d-0c59-44dc-a12e-25cf34449627",
                        "source_entry_id": "cc8c9c66-345c-3f0d-af4c-e83dc7684131",
                        "source_sense_id": "b12f51d6-1b75-3d61-9277-fde696abe5fd",
                        "target_lang_word": "cottage industry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cottage industry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e2a4db-d13f-3837-9171-6cfeb623f2aa",
                                        "entry_id": "f560f1b8-05eb-3cae-aa6a-c1ff97481f03",
                                        "glosses": [
                                            "A job or occupation carried out at home or on a part-time basis, historically often manufacturing work such as sewing, lacemaking, or spinning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4427803-aefa-4b33-9d1c-1cae436e2d48",
                                                "sense_id": "f4e2a4db-d13f-3837-9171-6cfeb623f2aa",
                                                "text": "Near-synonym: proto-industry"
                                            },
                                            {
                                                "example_id": "9e642fd0-6d69-468a-8041-ce68f110a08d",
                                                "sense_id": "f4e2a4db-d13f-3837-9171-6cfeb623f2aa",
                                                "text": "A craft such as quilting may be pursued as a hobby or as a cottage industry."
                                            },
                                            {
                                                "example_id": "23dd17cb-b8e2-42fa-9303-91a21e1dfaeb",
                                                "sense_id": "f4e2a4db-d13f-3837-9171-6cfeb623f2aa",
                                                "text": "Scotland and Ireland are famous for their tweeds and homespuns and what are known as the \"cottage industries\" have been recently revived in those countries as the products of their hand looms have become deservedly popular abroad."
                                            },
                                            {
                                                "example_id": "12c9ba8b-512b-46c2-9564-99ad55fc5778",
                                                "sense_id": "f4e2a4db-d13f-3837-9171-6cfeb623f2aa",
                                                "text": "Oak bark is still used to some extent. Shoe-making used to be an important cottage industry, but the introduction of machinery has carried the work to large factories elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0364e5d8-787e-34c9-8451-4e243cfecb29",
                                        "entry_id": "f560f1b8-05eb-3cae-aa6a-c1ff97481f03",
                                        "glosses": [
                                            "A small-scale industry, with relatively few employees or a limited customer base or low economic impact."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6bd2867-0d5b-4026-a7a3-1bd6d88d09b3",
                                                "sense_id": "0364e5d8-787e-34c9-8451-4e243cfecb29",
                                                "text": "Customers quickly sensed the change when CA took over a company: The new owners vigorously enforced license agreements, often in the courts. A cottage industry soon sprang up to advise companies on how to negotiate with CA."
                                            },
                                            {
                                                "example_id": "f4e04326-d04d-4d1f-9419-7a1d3e819f16",
                                                "sense_id": "0364e5d8-787e-34c9-8451-4e243cfecb29",
                                                "text": "So why was there so much breathlessness about a blogger joining this emphatically non-exclusive club? Because the blogging story has become a cottage industry, a cultural fashion trend that blogger and establishment alike have a vested interest in keeping alive."
                                            },
                                            {
                                                "example_id": "2ce89ae5-d6d6-4a96-8cf1-11a49d40e0d0",
                                                "sense_id": "0364e5d8-787e-34c9-8451-4e243cfecb29",
                                                "text": "Microfinance, once a relative cottage industry championed by antipoverty activists and development wonks, is on the verge of a revolution, with billions of dollars from big banks, private-equity shops and pension funds pouring in."
                                            },
                                            {
                                                "example_id": "2f5e05f6-0af2-49c6-a99e-70950465e51b",
                                                "sense_id": "0364e5d8-787e-34c9-8451-4e243cfecb29",
                                                "text": "Remote and difficult to access, many villages in China’s interior have developed a criminal cottage industry, involving anything from drugs to internet fraud to counterfeiting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
