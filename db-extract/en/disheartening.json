                "senses": [
                    {
                        "sense_id": "9b89dc34-b3bf-3ee5-9083-f2df53d33ead",
                        "entry_id": "34363c5a-f2f0-322a-b866-3a5c8e0e06a9",
                        "glosses": [
                            "Causing a person to lose heart; making despondent or gloomy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61fbd5ed-a768-4cf1-96c6-dee5825bd10c",
                                "sense_id": "9b89dc34-b3bf-3ee5-9083-f2df53d33ead",
                                "text": "After this, with the disheartening failures after the Railway Mania, railway projection in east Cornwall went to sleep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63b06ff1-9118-4185-b1d0-188a999b6f7a",
                        "source_entry_id": "34363c5a-f2f0-322a-b866-3a5c8e0e06a9",
                        "source_sense_id": "9b89dc34-b3bf-3ee5-9083-f2df53d33ead",
                        "source_sense_description": "Translations",
                        "target_lang_word": "démoralisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoralisant",
