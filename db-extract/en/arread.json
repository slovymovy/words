                "senses": [
                    {
                        "sense_id": "a373b2fe-028a-3f00-954f-5056627dca7a",
                        "entry_id": "6782b736-963b-33b6-b77b-8f7a12329752",
                        "glosses": [
                            "To declare; tell; interpret; explain."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "722cf958-fb07-40e7-9093-ceffb766d11f",
                                "sense_id": "a373b2fe-028a-3f00-954f-5056627dca7a",
                                "text": "But mark what I arread thee now. Avaunt; …"
                            },
                            {
                                "example_id": "6160bd9c-7f14-4dab-8b3f-d22b38b0223a",
                                "sense_id": "a373b2fe-028a-3f00-954f-5056627dca7a",
                                "text": "His hall resounds!―amaz'd the stranger wight Arreads it all as done to him in fell despight."
                            },
                            {
                                "example_id": "d7713ff2-07be-495a-b94b-2b78c4941f36",
                                "sense_id": "a373b2fe-028a-3f00-954f-5056627dca7a",
                                "text": "Nothing but mirth can conquer fortune's spite; No sky is heavy, if the heart be light: Patience is sorrow's salve; what can't be cur'd, So Donald right arreads, must be endur'd."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0d0e1f3-5811-3724-8830-526a8d53bf0c",
                        "entry_id": "6782b736-963b-33b6-b77b-8f7a12329752",
                        "glosses": [
                            "To counsel; advise; direct; teach."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "af6aa9cc-523b-4a20-8cec-f381a0f07ec6",
                                "sense_id": "f0d0e1f3-5811-3724-8830-526a8d53bf0c",
                                "text": "My tongue shall speak but what my heart arreads, Nor varnish use to blacken more thy deeds; …"
                            }
                        ]
                    },
                    {
                        "sense_id": "9c334d4b-bd29-3f38-aa4d-ab36c6f8b718",
                        "entry_id": "6782b736-963b-33b6-b77b-8f7a12329752",
                        "glosses": [
                            "To guess; conjecture."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a36dfa45-ce9c-49c5-a6ec-67c40861ff3c",
                                "sense_id": "9c334d4b-bd29-3f38-aa4d-ab36c6f8b718",
                                "text": "Soldier, I come. But, ere we part, I will arread thy doom, Proud ruthless woman!"
                            },
                            {
                                "example_id": "866a5ac0-70db-466f-881a-4dda4deedb2d",
                                "sense_id": "9c334d4b-bd29-3f38-aa4d-ab36c6f8b718",
                                "text": "Now, good Christe arread, and gesse whoe gaue thee the buffet?"
                            }
                        ]
                    },
                    {
                        "sense_id": "33115943-bc79-3f34-ae7b-138e9ce3f66e",
                        "entry_id": "6782b736-963b-33b6-b77b-8f7a12329752",
                        "glosses": [
                            "To read."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ed30fc29-28e2-4e1b-a313-49164542d1ec",
                                "sense_id": "33115943-bc79-3f34-ae7b-138e9ce3f66e",
                                "text": "You arread me aright."
                            }
                        ]
                    }
