                                        "examples": [
                                            {
                                                "example_id": "6b34855d-9b2b-4c41-a405-35ea2c53bcf2",
                                                "sense_id": "25d33b93-13fa-3ca2-83d9-00ec8956dbd9",
                                                "text": "This is a tessellation of the plane with squares and regular octagons."
                                            },
                                            {
                                                "example_id": "95710b3c-24fb-4394-b145-ed7b10a294a7",
                                                "sense_id": "25d33b93-13fa-3ca2-83d9-00ec8956dbd9",
                                                "text": "Decorative arches intersect the graceful latticework of the expansive ridge and furrow trainshed rooves, woven together by a staggering tessellation of 48,000 glass panels."
