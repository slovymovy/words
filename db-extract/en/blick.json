                "senses": [
                    {
                        "sense_id": "dd6f8a71-631a-30b1-9483-2ca223b43caf",
                        "entry_id": "5271abbe-18ec-3c7e-a21f-a61d12515739",
                        "glosses": [
                            "Of gold or silver: To exhibit blick."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3e9080c4-2545-493b-8277-7e39e842cd4c",
                                "sense_id": "dd6f8a71-631a-30b1-9483-2ca223b43caf",
                                "text": "When the cupellation is nearly finished, a play of colors is seen, and the button [sc. of silver] suddenly brightens or “blicks,” and becomes white, and is free from lead."
                            },
                            {
                                "example_id": "b369fdc6-f27a-457f-a534-600836125803",
                                "sense_id": "dd6f8a71-631a-30b1-9483-2ca223b43caf",
                                "text": "The English cupelling furnaces are used; the bars of rich bullion being fed continually until the silver blicks, the litharge running into small iron pots for removal."
                            },
                            {
                                "example_id": "0767e4b8-3905-4014-887e-bb84814f90d7",
                                "sense_id": "dd6f8a71-631a-30b1-9483-2ca223b43caf",
                                "text": "As the last of the lead is oxidized the iridescence suddenly disappears and the surface brightens or “blicks.\""
                            }
                        ]
                    }
                ],
