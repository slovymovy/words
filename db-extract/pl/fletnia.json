                        "entry_id": "48e4f2f8-ea9b-3805-93a8-13a88d547297",
                        "glosses": [
                            "instrument muzyczny dęty złożony z kilku piszczałek różnej długości; aerofon wargowy"
                        ],
                        "tags": [],
                        "examples": [
