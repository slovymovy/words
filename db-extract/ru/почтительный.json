                ],
                "senses": [
                    {
                        "sense_id": "c70af9d6-2a84-39cb-9bda-6c598296bfec",
                        "entry_id": "a6d7ec1c-6638-3e8e-ba4d-a29e477e086a",
                        "glosses": [
                            "содержащий в себе или выражающий почтение; уважительный в отношении к кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29571e2e-3fa1-46bb-aa0f-31aa046a38bb",
                                "sense_id": "c70af9d6-2a84-39cb-9bda-6c598296bfec",
                                "text": "Король уселся на постели, а перед ним стали в почтительном молчании вожди польской рати."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e34c16b-d922-3f72-84ea-b35fd702d087",
                        "entry_id": "a6d7ec1c-6638-3e8e-ba4d-a29e477e086a",
                        "glosses": [
                            "перен. достаточно большой, значительный; безопасный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1072691a-5add-4682-b5cb-8e8b4821fa67",
                                "sense_id": "1e34c16b-d922-3f72-84ea-b35fd702d087",
                                "text": "Мальчишки и девчонки, прижимаясь к матерям и друг к другу, с испуганным удивлением следят за всеми движениями не виданных ещё ими армейских и на почтительном расстоянии бегают за ними."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9f543a2-75c1-49b6-9a86-40bad1f064c3",
                        "source_entry_id": "a6d7ec1c-6638-3e8e-ba4d-a29e477e086a",
                        "source_sense_description": "выражающий почтение; уважительный",
                        "target_lang_word": "respectful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respectful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                        "entry_id": "7ca7a165-647f-3bf4-8d55-19e6fa56757d",
                                        "glosses": [
                                            "Marked or characterized by respect"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d914d67-3464-4fde-8132-984b6392dbb9",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "1907, Marshall Broomhall (Editor), The Chinese Empire. A General & Missionary Survey/The Province of Kansu\nOn the whole, indifference rather than open hostility has been the attitude of the people towards the Gospel, but since 1900 there has been a more eager and respectful attention to the things taught."
                                            },
                                            {
                                                "example_id": "34b6a6a2-de61-4e2e-a6e0-77e02096643b",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "It is of great importance that you act in a respectful manner towards the duke and duchess."
                                            },
                                            {
                                                "example_id": "34c700e1-59a8-486e-a4c7-0f771d9f28aa",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "They used highly respectful language when conversing with the elders."
                                            }
