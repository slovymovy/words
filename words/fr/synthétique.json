    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "264aaa26-80dc-3dc3-8cf8-44762e757a75",
                    "sense_definition": "Produit ou fabriqué par voie de synthèse chimique, de manière artificielle et non naturelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce manteau d'hiver est fabriqué avec un tissu <w>synthétique</w> particulièrement résistant au froid."
                        },
                        {
                            "text": "Le nouveau terrain de football est recouvert d'un gazon <w>synthétique</w> de grande qualité."
                        }
                    ],
                    "synonyms": [
                        "artificiel"
                    ],
                    "common_phrases": [
                        "tissu synthétique",
                        "gazon synthétique",
                        "matière synthétique"
                    ]
                },
                {
                    "sense_id": "7c55d304-0194-3ed6-a691-9a59301bbd1f",
                    "sense_definition": "Qui procède par synthèse intellectuelle ou qui résume l'essentiel de manière claire et concise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a proposé un résumé <w>synthétique</w> et particulièrement clair de ses recherches."
                        },
                        {
                            "text": "Cette présentation propose une vue <w>synthétique</w> de l'évolution financière de notre entreprise."
                        }
                    ],
                    "synonyms": [
                        "concis",
                        "résumé"
                    ],
                    "antonyms": [
                        "analytique"
                    ],
                    "common_phrases": [
                        "esprit synthétique",
                        "vue synthétique",
                        "tableau synthétique"
                    ]
                },
                {
                    "sense_id": "bdd91cf5-72a6-3f39-92b9-c119cd545770",
                    "sense_definition": "En linguistique, qualifie une langue qui exprime des rapports grammaticaux au moyen de flexions plutôt que de mots séparés.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le latin classique est souvent considéré comme une langue <w>synthétique</w> en raison de ses cas."
                        },
                        {
                            "text": "Une langue <w>synthétique</w> regroupe généralement plusieurs éléments grammaticaux au sein d'un seul mot."
                        }
                    ],
                    "antonyms": [
                        "analytique"
                    ],
                    "common_phrases": [
                        "langue synthétique"
                    ]
                }
            ]
        }
