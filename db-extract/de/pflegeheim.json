                    {
                        "form_id": "424e4300-200b-4fb0-a3c5-b96b6f55cd1c",
                        "entry_id": "00f976b0-c37b-3a2d-94a0-fb064f563dae",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pflegeheime"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea4613e8-4e02-3b69-90d8-7d2574b5484c",
                        "entry_id": "00f976b0-c37b-3a2d-94a0-fb064f563dae",
                        "glosses": [
                            "Ort, an dem pflegebedürftige Personen stationär betreut und gepflegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191f391e-b92a-4325-aa00-ca06cc05c31b",
                                "sense_id": "ea4613e8-4e02-3b69-90d8-7d2574b5484c",
                                "text": "„Die durch Bewegungsmangel begünstigten Arthrosen gehören zu den häufigsten Gründen, warum ältere Menschen ins Pflegeheim müssen.“"
                            },
                            {
                                "example_id": "b69c15eb-f914-469c-8e07-c543d80fce90",
                                "sense_id": "ea4613e8-4e02-3b69-90d8-7d2574b5484c",
                                "text": "„2005 war er nach 59 Jahren aus der SPD ausgetreten, lag am Ende in einem Pflegeheim, war enttäuscht, verbittert und redete wie einer, der nichts zu verlieren hat.“"
                            },
                            {
                                "example_id": "b99105b8-806d-47d8-ae9e-c3fd37dd8b10",
                                "sense_id": "ea4613e8-4e02-3b69-90d8-7d2574b5484c",
                                "text": "„Als die Alten 1987 ins Pflegeheim Lágargardur einzogen, war der Preis auf annähernd 70 Millionen Kronen gestiegen.“"
                            },
                            {
                                "example_id": "68c8df83-f557-48c5-bce8-3f0a6274f737",
                                "sense_id": "ea4613e8-4e02-3b69-90d8-7d2574b5484c",
                                "text": "„Ein Arzt hatte das Gebäude der ehemaligen Mittelschule gekauft, das lange Zeit leer gestanden hatte, und ein privates Pflegeheim daraus gemacht, und dort hatte Ugla jetzt eine Stelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
