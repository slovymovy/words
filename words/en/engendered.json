    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f9f6b94-b06c-3e70-b04f-230140f101f6",
                    "sense_definition": "Produced, caused, or brought into existence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>engendered</w> conflict between the two parties led to a long and difficult legal battle.",
                            "target_lang_translations": {
                                "nl": "Het <w>ontstane</w> conflict tussen beide partijen leidde tot een lange en moeilijke juridische strijd."
                            }
                        },
                        {
                            "text": "The new policy <w>engendered</w> a sense of hope among the employees who were previously worried about their jobs.",
                            "target_lang_translations": {
                                "nl": "Het nieuwe beleid <w>bracht</w> een gevoel van hoop <w>teweeg</w> onder de werknemers die zich eerder zorgen maakten over hun baan."
                            }
                        }
                    ],
                    "synonyms": [
                        "produced",
                        "caused",
                        "generated",
                        "created"
                    ],
                    "common_phrases": [
                        "engendered conflict",
                        "engendered hope"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voortgebracht, veroorzaakt of ontstaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontstaan",
                                "target_lang_sense_clarification": "als gevolg voortgebracht"
                            },
                            {
                                "target_lang_word": "teweeggebracht",
                                "target_lang_sense_clarification": "veroorzaakt"
                            },
                            {
                                "target_lang_word": "veroorzaakt",
                                "target_lang_sense_clarification": "tot stand gebracht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ecce83-586c-3e2c-b82c-60c38f146f96",
                    "sense_definition": "Having a strong association with gender; gendered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author explores how the <w>engendered</w> expectations of society limit the choices available to young people.",
                            "target_lang_translations": {
                                "nl": "De auteur onderzoekt hoe de <w>gegenderde</w> verwachtingen van de maatschappij de keuzes van jongeren beperken."
                            }
                        },
                        {
                            "text": "Many historical professions were highly <w>engendered</w> and restricted based on traditional roles.",
                            "target_lang_translations": {
                                "nl": "Veel historische beroepen waren sterk <w>geslachtsgebonden</w> en beperkt op basis van traditionele rollen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gendered"
                    ],
                    "common_phrases": [
                        "engendered expectations",
                        "engendered roles"
                    ],
                    "target_lang_definitions": {
                        "nl": "Sterk verbonden met gender of traditionele rolpatronen; gegenderd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gegenderd",
                                "target_lang_sense_clarification": "gekoppeld aan geslacht of gender"
                            },
                            {
                                "target_lang_word": "geslachtsgebonden",
                                "target_lang_sense_clarification": "gebonden aan mannelijk/vrouwelijk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "482b8ca0-c7da-3cf7-8dc5-ce6d0f2d3265",
                    "sense_definition": "Simple past and past participle of <w>engender</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial decision <w>engendered</w> much debate within the community.",
                            "target_lang_translations": {
                                "nl": "De controversiële beslissing <w>veroorzaakte</w> veel debat binnen de gemeenschap."
                            }
                        },
                        {
                            "text": "His speech <w>engendered</w> a feeling of unity among the diverse group of listeners.",
                            "target_lang_translations": {
                                "nl": "Zijn toespraak <w>deed</w> een gevoel van eenheid <w>ontstaan</w> onder de diverse groep luisteraars."
