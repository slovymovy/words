                "senses": [
                    {
                        "sense_id": "3cfea2b8-2a4c-3dda-b007-0a3088f1f1c6",
                        "entry_id": "b865430d-37a5-32ef-a3b5-12ef47309821",
                        "glosses": [
                            "Pâque, une des trois fêtes de pélerinage, que les juifs célèbrent tous les ans en mémoire de leur sortie d’Égypte."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69e41302-db8a-48c6-a38a-ff3030fd1b03",
                        "source_entry_id": "b865430d-37a5-32ef-a3b5-12ef47309821",
                        "source_sense_id": "3cfea2b8-2a4c-3dda-b007-0a3088f1f1c6",
                        "target_lang_word": "Passah",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passah",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
                                        "entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                                        "glosses": [
                                            "alljährlich am Abend des 14. Nisan beginnendes, sieben Tage währendes Fest, an dem des Auszugs des jüdischen Volkes aus Ägypten gedacht wird"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c32490ad-fd43-4f35-9de9-b8c449467123",
                                                "sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
                                                "text": "„Doch Ostern ist eine gute Zeit, sich zu vergegenwärtigen, dass das jüdische Passah, bevor es mit religiösem Inhalt erfüllt wurde, als Fest des alljährlichen ersten Gestenschnittes gefeiert wurde. (Das Wochenfest, bzw. Pfingsten markierte den ersten Weizenschnitt, das Laubhüttenfest die Obst- und Weinernte.) Nicht zufällig ist geboten, an Passah ungesäuertes Brot, \"das Brot des Elends\" (5. Mose 15.16) zu essen; nicht zufällig liegen vor Ostern die wichtigsten Fastenzeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cd2a44e-1d54-334c-8797-051015728c61",
                                        "entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                                        "glosses": [
                                            "jüdische Religion: Kurzform von hebräisch קרבן פסח (Korban Pessach) ^(→ he) („Pessachopfer“): Lamm, das in biblischen Zeiten anlässlich des unter [1] beschriebenen Fests am Sederabend verspeist wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6bedcb-54bb-468f-87ec-b169f1eafcc6",
                                                "sense_id": "9cd2a44e-1d54-334c-8797-051015728c61",
                                                "text": "„Und du sollst für den HERRN, deinen Gott, das Passah schlachten, Schafe und Rinder, an der Stätte, die der HERR erwählen wird, um seinen Namen dort wohnen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "805f484c-d475-488e-9667-5199beadd7b6",
                        "source_entry_id": "b865430d-37a5-32ef-a3b5-12ef47309821",
                        "source_sense_id": "3cfea2b8-2a4c-3dda-b007-0a3088f1f1c6",
                        "target_lang_word": "Passa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bacfed0-0ee2-34ad-bdb6-d0aeae05334d",
                                        "entry_id": "a2c27873-86db-3c2c-b5d7-193064c6544c",
                                        "glosses": [
                                            "alternative Schreibweise von Passah"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bd87fc-64a0-4088-8035-2b798cbf4252",
                                                "sense_id": "4bacfed0-0ee2-34ad-bdb6-d0aeae05334d",
                                                "text": "„Und die, die aus der Gefangenschaft zurückgekommen waren, hielten Passa am vierzehnten Tage des ersten Monats.“"
                                            },
                                            {
                                                "example_id": "4fb8324a-499b-43d6-914a-e18cccac161f",
                                                "sense_id": "4bacfed0-0ee2-34ad-bdb6-d0aeae05334d",
                                                "text": "„Am vierzehnten Tag des ersten Monats sollt ihr das Passa halten und sieben Tage feiern und ungesäuertes Brot essen.“"
                                            },
                                            {
                                                "example_id": "92ca5b79-cf1c-4d10-8b1f-e97eb3ec04d5",
                                                "sense_id": "4bacfed0-0ee2-34ad-bdb6-d0aeae05334d",
                                                "text": "„Und Mose berief alle Ältesten Israels und sprach zu ihnen: Lest Schafe aus und nehmt sie für euch nach euren Geschlechtern und schlachtet das Passa.“"
                                            },
                                            {
                                                "example_id": "d1dbad93-526b-4c0a-8b60-c29fce81f2ad",
                                                "sense_id": "4bacfed0-0ee2-34ad-bdb6-d0aeae05334d",
                                                "text": "„Du darfst nicht Passa schlachten in irgendeiner deiner Städte, die dir der HERR, dein Gott, gegeben hat, | sondern an der Stätte, die der HERR, dein Gott, erwählen wird, dass sein Name daselbst wohne. Da sollst du das Passa schlachten am Abend, wenn die Sonne untergegangen ist, zu der Zeit, als du aus Ägypten zogst, | und sollst es kochen und essen an der Stätte, die der HERR, dein Gott, erwählen wird, und sollst am Morgen umkehren und heimgehen in deine Wohnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0314e03e-8bb8-4286-90d0-9e9e5ee3a7fc",
                        "source_entry_id": "b865430d-37a5-32ef-a3b5-12ef47309821",
                        "source_sense_id": "3cfea2b8-2a4c-3dda-b007-0a3088f1f1c6",
                        "target_lang_word": "Pascha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pascha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd5dae9-3b1c-3a19-961b-77758dd89e25",
                                        "entry_id": "fb033c17-1ac6-31f2-ae15-bc92761535ed",
                                        "glosses": [
                                            "hoher Offizier oder Beamter"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f088f9-85fc-4ef8-9b73-92805e0a17ac",
                                                "sense_id": "dbd5dae9-3b1c-3a19-961b-77758dd89e25",
                                                "text": "„Der dänische Generalkonsul, der einzige der dem Pascha nicht nach Kairo gefolgt ist, hatte ihm auf dem französischen Dampfschiffbüro das Notwendige verschafft, und so konnte er glücklich mit uns fortgehen.“"
                                            },
                                            {
                                                "example_id": "490b1095-5173-4a12-9ad7-cb23d6f95396",
                                                "sense_id": "dbd5dae9-3b1c-3a19-961b-77758dd89e25",
                                                "text": "„Vor vielen Jahren habe ich in Khartum einen schwarzen Pascha kennen gelernt, der es unter dem Khedive Jsmail zum Oberbefehlshaber der ägyptischen Truppen im Sudan gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "cee53712-5cda-479f-9b49-4e5b3bdb2772",
                                                "sense_id": "dbd5dae9-3b1c-3a19-961b-77758dd89e25",
                                                "text": "„Da sieht man auf der Straße den stets stolzen und selbstbewußten Mohammedaner, auf dem Kopf den roten Fez und im Knopfloch das Bildnis des Mustafa Kemal Pascha.“"
                                            },
                                            {
                                                "example_id": "e79b5d1e-dd35-40f0-8136-8e0b93ddc8d0",
                                                "sense_id": "dbd5dae9-3b1c-3a19-961b-77758dd89e25",
                                                "text": "„Beständig lag er »krank« in seiner Koje und ließ sich bedienen wie ein Pascha.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4148ab1-43bf-3643-9d3e-343181086ec3",
                                        "entry_id": "fb033c17-1ac6-31f2-ae15-bc92761535ed",
                                        "glosses": [
                                            "Mensch, der (keine Kritik duldet und) sich gerne verwöhnen lässt, besonders ein Mann, der es als selbstverständlich ansieht, dass eine Frau ihn bedient"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf2268d-24e1-4266-aac2-9e146995a96f",
                                                "sense_id": "b4148ab1-43bf-3643-9d3e-343181086ec3",
                                                "text": "„Beständig lag er »krank« in seiner Koje und ließ sich bedienen wie ein Pascha.“"
                                            },
                                            {
                                                "example_id": "64e7df83-d7a7-447d-8659-403ce6a64e94",
                                                "sense_id": "b4148ab1-43bf-3643-9d3e-343181086ec3",
                                                "text": "„Aus deinen Briefen, du Ungeheuer, du Pascha von Neusiedel, du Don Juan vom Kohlmarkt – du hast sie ja heiraten wollen, aber ihre Koketterie, ihre Eifersucht, ihr Dolch jagte dir das Herz in die Sohlen, du fingst zu laufen an und ließest sie sitzen.“ (1864)"
                                            },
                                            {
                                                "example_id": "c8a28479-68a1-4f14-8a05-52aab1bebc1c",
                                                "sense_id": "b4148ab1-43bf-3643-9d3e-343181086ec3",
                                                "text": "„Für die Eltern war dieser Junge ein kleiner Pascha, der eventuell einen kleinen Fehler gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pascha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38875725-1097-3375-841d-7d00ded172fb",
                                        "entry_id": "b47277fe-00be-3114-aadb-3bc078a6e1fc",
                                        "glosses": [
                                            "in der Ökumene verwendete Nebenform von Passah"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b6c3e5-d61a-4908-9d23-50f3d899b3d2",
                                                "sense_id": "38875725-1097-3375-841d-7d00ded172fb",
                                                "text": "„Als die Israeliten in Gilgal ihr Lager hatten, feierten sie am Abend des vierzehnten Tages jenes Monats in den Steppen von Jericho das Pascha.“"
                                            },
                                            {
                                                "example_id": "efe6b305-6f50-4c20-a8dc-19d1d1c0b448",
                                                "sense_id": "38875725-1097-3375-841d-7d00ded172fb",
                                                "text": "„Dann brieten sie das Pascha der Vorschrift gemäß am Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a99bece6-ed14-4c1e-964e-9902d368fa95",
