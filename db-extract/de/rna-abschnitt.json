                "senses": [
                    {
                        "sense_id": "4b45d692-a9a8-386c-910a-d27497e1e400",
                        "entry_id": "328779e2-bb7e-3483-ae4a-5da60429a587",
                        "glosses": [
                            "Teilbereich auf der Kette/Einfachhelix der RNA, ein Teilstück der Kette, ein kurzes RNA-Molekül"
                        ],
                        "tags": [
                            "oder"
                        ],
                        "examples": [
                            {
                                "example_id": "f11a1754-0f26-47b6-ac6c-2a45f7ad1d21",
                                "sense_id": "4b45d692-a9a8-386c-910a-d27497e1e400",
                                "text": "Die DNA speichert das Ergbut und die RNA hilft, die genetische Informationen aus diesem Bauplan zu übertragen, um neue Proteine zu erstellen. Dabei regulieren kleine RNA-Abschnitte das Ablesen von Genen."
                            },
                            {
                                "example_id": "b83ee6f7-825c-4cb6-9576-4b499255c66f",
                                "sense_id": "4b45d692-a9a8-386c-910a-d27497e1e400",
                                "text": "„Bei der Aptamer-Domäne handelt es sich um einen kurzen RNA-Abschnitt, der eine spezielle 3D-Struktur ausbilden und dadurch ein spezifisches Zielmolekül, beispielsweise Tetracyclin binden kann.“"
                            },
                            {
                                "example_id": "89824235-f02c-49d1-8755-3aab4f622329",
                                "sense_id": "4b45d692-a9a8-386c-910a-d27497e1e400",
                                "text": "„Ein Replikon ist ein DNA- bzw. RNA-Abschnitt, der bei der Replikation zwischen zwei Origins liegt und dadurch in einem Stück repliziert wird.“"
                            },
                            {
                                "example_id": "904a9ae9-ee50-45ee-a1f5-f53bf1536d55",
                                "sense_id": "4b45d692-a9a8-386c-910a-d27497e1e400",
                                "text": "„Einer dieser Rezeptoren ist MDA5, der durch das Ausbilden von Filamenten an der RNA insbesondere lange und vernetzte virale RNA erkennt. RIG-I selbst erkennt eher kürzere virale RNA-Abschnitte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
