                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19b4e86c-f3c8-38c4-8823-1e9be6662fde",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74724514-c4cb-4ce2-a756-af14a57c7e2c",
                                                "sense_id": "19b4e86c-f3c8-38c4-8823-1e9be6662fde",
                                                "text": "Oh vvhat a ſimpathie of vvoe is this, / As farre from helpe, as Lymbo is from bliſſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f19652-64f5-3abc-a3a3-03e850354ac2",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling.",
                                            "Support in the form of shared feelings or opinions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70b9a0ad-e250-3029-9744-ba86025dc0a8",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling.",
                                            "Feeling of loyalty; tendency towards, agreement with or approval of an opinion or aim; a favorable attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa7073d-c22a-42da-9e91-95560d5bd2a8",
                                                "sense_id": "70b9a0ad-e250-3029-9744-ba86025dc0a8",
                                                "text": "Many people in Hollywood were blacklisted merely because they were suspected of Communist sympathies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "An affinity, association or mutual relationship between people or things such that they are correspondingly affected by any condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b71bad-02a0-4aca-886a-4bbecbd11a93",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "He observed, also, the frequent sympathy of volcanic and terremotive action in remote districts of the earth's surface, thus showing how deeply seated must be the cause of these convulsions."
                                            },
                                            {
                                                "example_id": "3061d678-1034-4c93-95b9-2d9a3129882e",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "A peculiarity of were-animals is the sympathy that exists between their animal form and that of the human with whom it is connected."
                                            },
                                            {
                                                "example_id": "af8e51dc-ec71-444e-8fe7-17a1488c22aa",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "The solution to coach riding defects, at least, seems to require much more co-operative practical experiment by all engineering departments to achieve better sympathy between the vehicle body, its undercarriage and the track on which it rides."
                                            },
                                            {
                                                "example_id": "15b50f01-a753-42c2-b38d-bcbf3a164ada",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "Sympathy likened anything to anything else in universal attraction, e.g. the fate of men to the course of the planets."
                                            }
                                        ]
                                    },
