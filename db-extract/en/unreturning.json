                        "glosses": [
                            "Not returning; not coming back."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1353699d-ebb6-4d46-a120-6013375f6fa7",
                                "sense_id": "5767afe7-c02a-3431-9071-b246a0230ea3",
                                "text": "So, thou hast pass'd the unreturning gate,\nWhere dust with dust doth linger, and gone down\nIn all the beauty of thy blooming years\nTo this most sacred city of the dead."
                            },
                            {
                                "example_id": "7a850f91-e6ad-402b-bfa4-4c75d5aa32b0",
                                "sense_id": "5767afe7-c02a-3431-9071-b246a0230ea3",
                                "text": "For gifts that die have living memories—\nVoices of unreturning days, that breathe\nThe spirit of a day that never dies."
                            }
                        ]
                    }
