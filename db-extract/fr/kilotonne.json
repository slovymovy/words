                    }
                ],
                "senses": [
                    {
                        "sense_id": "37beb372-0e92-32fa-973b-f0ca56788cce",
                        "entry_id": "a4969349-51e5-3769-808d-66305b40dfe3",
                        "glosses": [
                            "Unité de mesure de masse en dehors du Système international (mais dont l’usage est accepté avec le SI), valant 10³ tonnes, et dont le symbole est kt."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a329d79c-d197-31dc-be5d-85bcca6ae6e7",
                        "entry_id": "a4969349-51e5-3769-808d-66305b40dfe3",
                        "glosses": [
                            "Unité de mesure d’énergie explosive, équivalant à mille tonnes de TNT. Son symbole est kt ou ktTNT."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df41f5d-5f29-499a-9854-551cf5c06656",
                                "sense_id": "a329d79c-d197-31dc-be5d-85bcca6ae6e7",
                                "text": "Je ne croyais pas qu’une jeune fille pouvait rire encore ainsi, sur le second versant du XXᵉ siècle, alors qu’une bombe atomique de 20 kilotonnes pouvait faire quarante mille morts."
                            },
                            {
                                "example_id": "2d897a42-c413-42fb-9abc-ce468a040246",
                                "sense_id": "a329d79c-d197-31dc-be5d-85bcca6ae6e7",
                                "text": "Des médias russes ajoutent que la puissance estimée de l’explosion est « de 1,3 à 1,8 kilotonne », l’onde de choc s’est propagée « sur 200 à 300 kilomètres ». À titre de comparaison, l’explosion de Beyrouth en 2020 a été estimée à environ 1,8 à 2,4 kilotonnes de TNT."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4426c0c-c5ea-42ac-8a35-3a9fb82d6702",
                        "source_entry_id": "a4969349-51e5-3769-808d-66305b40dfe3",
                        "target_lang_word": "kiloton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiloton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f643ef-ad8a-355e-998e-8a487247788e",
                                        "entry_id": "8efc989f-cb67-3258-be32-39de4c872982",
                                        "glosses": [
                                            "A measure of the strength of an explosion or a bomb based on how many thousand tons of TNT would be needed to produce the same energy. (A derived unit for TNT equivalent.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c449dbff-4ea3-4c3a-a729-cc86f38547e6",
                                                "sense_id": "c7f643ef-ad8a-355e-998e-8a487247788e",
                                                "text": "Holonyms: megaton < gigaton < teraton < petaton < exaton (rare) < zettaton (rare) < yottaton (rare)"
                                            },
                                            {
                                                "example_id": "46e2d171-a00c-4763-8b01-fc1cc26ed82b",
                                                "sense_id": "c7f643ef-ad8a-355e-998e-8a487247788e",
                                                "text": "Meronym: ton of TNT"
                                            },
                                            {
                                                "example_id": "bfec8fa7-abb2-46b5-8dea-4b5e4b617ddc",
                                                "sense_id": "c7f643ef-ad8a-355e-998e-8a487247788e",
                                                "text": "That's a 300-kiloton nuclear warhead."
                                            },
                                            {
                                                "example_id": "0c65b092-0af7-4a74-accd-3bb9fdfbaf36",
                                                "sense_id": "c7f643ef-ad8a-355e-998e-8a487247788e",
                                                "text": "Halifax in Canada was devastated by a ship exploding in 1917. SS Mont Blanc, a French vessel loaded with 2.9 kilotons of explosives, collided with the Imo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be784d18-6aae-3ad0-8539-5eb2885c8ba8",
                                        "entry_id": "8efc989f-cb67-3258-be32-39de4c872982",
                                        "glosses": [
                                            "One thousand tons.",
                                            "One thousand short tons (10³ × 2000 lb)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
