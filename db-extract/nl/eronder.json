                                                "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                                "text": "The treasure is buried two meters below the surface."
                                            },
                                            {
                                                "example_id": "5bf0f30d-3e61-4cd6-8242-3e2250e60da4",
                                                "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                                "text": "The marmalade is on the shelf below the bread."
                                            }
                                        ]
                                    },
