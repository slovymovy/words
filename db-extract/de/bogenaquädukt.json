                ],
                "senses": [
                    {
                        "sense_id": "4c8ee289-5c39-3306-bf61-117404531fce",
                        "entry_id": "9da88d5e-5cf2-3230-81fa-ae7e6e7e9184",
                        "glosses": [
                            "oberirdisch verlaufende Wasserleitung, deren Konstruktion Bögen aufweist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "896c9a77-7dfe-4de4-be01-d1bc21b8516f",
                                "sense_id": "4c8ee289-5c39-3306-bf61-117404531fce",
                                "text": "„Bei Ausgrabungen in der antiken Königsstadt Artaxata sind Forschende auf ein Bogenaquädukt aus der Zeit der größten Ausdehnung des römischen Reiches gestoßen.“"
                            },
                            {
                                "example_id": "5c1735d7-7739-47f3-81fd-48b9dbb064c3",
                                "sense_id": "4c8ee289-5c39-3306-bf61-117404531fce",
                                "text": "„Am imposantesten waren die zahlreichen oberirdisch geführten gewölbten Bogenaquädukte die bis heute zum typischen Bild der Antike gehören.“"
                            },
                            {
                                "example_id": "00822702-3faa-4cfa-8064-2366171b01e4",
                                "sense_id": "4c8ee289-5c39-3306-bf61-117404531fce",
                                "text": "„Ein schlanker Bogenaquädukt, dessen Erbauungszeit noch zu bestimmen ist, brachte Wasser von der grossen, aus dem Tale des Lamos kommenden Leitung nach der Insel.“"
                            },
                            {
                                "example_id": "295188c2-3574-47ac-add6-cf329680df05",
                                "sense_id": "4c8ee289-5c39-3306-bf61-117404531fce",
                                "text": "„Die Bautechnik selbst erwies sich gleichwohl als den natürlichen Verhältnissen inadäquat, denn bereits 178 n. Chr. zerstörte ein Erdbeben diese Bogenaquädukte, die dann weitgehend durch eine unterirdische Neuanlage der Leitung nach altem Muster ersetzt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
