            {
                "entry_id": "2738faad-1b56-3b5e-be50-3ce61ca1c567",
                "word": "dyscalculie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9790f20-5260-4437-9758-d3bb161feea6",
                        "entry_id": "2738faad-1b56-3b5e-be50-3ce61ca1c567",
                        "tags": [
                            "plural"
                        ],
                        "form": "dyscalculies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b196e4e-bfed-3c1e-a539-ed3fcd61acfa",
                        "entry_id": "2738faad-1b56-3b5e-be50-3ce61ca1c567",
                        "glosses": [
                            "Faiblesse dans l’apprentissage des opérations de calcul, difficulté d’appréhension des chiffres ou de la compréhension des mathématiques."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5febca21-367e-4c92-9671-e878b66d2b60",
                                "sense_id": "3b196e4e-bfed-3c1e-a539-ed3fcd61acfa",
                                "text": "Extradys organise une journée sur les difficultés d’enfants, d’adolescents souffrant de Troubles spécifiques du langage et des Apprentissages (TSLA) appelés communément « Troubles DYS » (dyslexie, dysorthographie, dysgraphie, dyscalculie, dyspraxie, dysphasie), dimanche 18 juin à la salle en dessous du dojo à Malemort de 9h30 à 13h."
                            },
                            {
                                "example_id": "57965d95-10f1-40a6-baf0-c2509a925c35",
                                "sense_id": "3b196e4e-bfed-3c1e-a539-ed3fcd61acfa",
                                "text": "Il est important d’évoquer la dyscalculie, dont on parle de plus en plus, mais qui est plutôt un symptôme associé à d’autres formes de troubles, qu’un trouble isolé."
                            },
                            {
                                "example_id": "90b4b4a0-2e1b-4568-9bbe-4982839440a1",
                                "sense_id": "3b196e4e-bfed-3c1e-a539-ed3fcd61acfa",
                                "text": "Il s’agit de Mila-Learn, une solution innovante, certifiée médicalement et dédiée aux enfants ayant des troubles de l’apprentissage tels que la dyslexie, la dysorthographie et la dyscalculie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79d7170-b318-46cc-87cb-36e44bcecabb",
                        "source_entry_id": "2738faad-1b56-3b5e-be50-3ce61ca1c567",
                        "source_sense_id": "3b196e4e-bfed-3c1e-a539-ed3fcd61acfa",
                        "target_lang_word": "Dyskalkulie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dyskalkulie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43a5dfbe-130e-3009-a333-0265c069222d",
                                        "entry_id": "f6e504ef-9de5-34e6-bfa3-bc65deb89fae",
                                        "glosses": [
                                            "Beeinträchtigung des mathematischen Denkens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d63cc89-6f28-47de-9214-ae782e2383c4",
                                                "sense_id": "43a5dfbe-130e-3009-a333-0265c069222d",
                                                "text": "Sabine leidet seit der dritten Klasse an einer Dyskalkulie."
                                            },
                                            {
                                                "example_id": "8795840c-5642-47f3-9556-491fd1041593",
                                                "sense_id": "43a5dfbe-130e-3009-a333-0265c069222d",
                                                "text": "Dyskalkulie ist eine der Legasthenie vergleichbare Lernstörung."
                                            },
                                            {
                                                "example_id": "dbd47fcd-80d6-44ff-80fa-d89a18564861",
                                                "sense_id": "43a5dfbe-130e-3009-a333-0265c069222d",
                                                "text": "„Ich war eine vollkommen hohle Nuss in Mathematik, ich glaube, ich litt unter einer milden Form der Dyskalkulie, die mich auch nie wieder verlassen hat.“"
                                            },
                                            {
                                                "example_id": "578bcd6d-3102-45ee-82c8-4609c11b7f5f",
                                                "sense_id": "43a5dfbe-130e-3009-a333-0265c069222d",
                                                "text": "In fast jeder Schulklasse sitzen Kinder mit einer Dyskalkulie, einer Rechenstörung. Anders als bei einer Lese-Rechtschreibschwäche werden bei der Rechenschwäche Diagnose- und Fördermethoden an Schulen immer noch selten eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "675fbb64-4232-4b4e-b19b-d9bfc42b2d52",
                        "source_entry_id": "2738faad-1b56-3b5e-be50-3ce61ca1c567",
