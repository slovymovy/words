                        "accords de coopération",
                        "en étroite coopération"
                    ]
                },
                {
                    "sense_id": "bec665bb-c427-3fbb-97f7-1bd9d9285f23",
                    "sense_definition": "Système économique et social fondé sur l'association de personnes pour gérer une entreprise commune et en partager les résultats.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
