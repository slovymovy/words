            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5381b2dc-48b6-3811-a3ea-f7057725103a",
                    "sense_definition": "Een adellijke titel voor een man, één rang lager dan een markies en één rang hoger dan een burggraaf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>graaf</w> woonde in een prachtig kasteel aan de rand van het bos.",
                            "target_lang_translations": {
                                "en": "The <w>count</w> lived in a beautiful castle on the edge of the forest.",
                                "ru": "<w>Граф</w> жил в прекрасном замке на опушке леса."
                            }
                        },
                        {
                            "text": "In de middeleeuwen had de <w>graaf</w> veel macht over zijn eigen graafschap.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, the <w>earl</w> had a lot of power over his own county.",
                                "ru": "В Средние века <w>граф</w> обладал большой властью над своим графством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de graaf van"
                    ],
                    "target_lang_definitions": {
                        "en": "A noble title for a man, one rank below a marquess and one rank above a viscount.",
                        "ru": "Дворянский титул для мужчины, на одну ступень ниже маркиза и на одну ступень выше виконта."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "count",
                                "target_lang_sense_clarification": "European noble title"
                            },
                            {
                                "target_lang_word": "earl",
                                "target_lang_sense_clarification": "British or Irish noble title"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "граф",
                                "target_lang_sense_clarification": "дворянский титул"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a22e34a8-1a9d-3d0c-a8b3-4cb45e362bdb",
                    "sense_definition": "Een wiskundige weergave van een verzameling punten die verbonden zijn door lijnen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de informatica worden <w>grafen</w> gebruikt om netwerken in kaart te brengen.",
                            "target_lang_translations": {
                                "en": "In computer science, <w>graphs</w> are used to map out networks.",
                                "ru": "В информатике <w>графы</w> используются для картографирования сетей."
                            }
                        },
                        {
                            "text": "Een elektrisch netwerk is een voorbeeld waar de theorie van de gerichte <w>grafen</w> kan worden toegepast.",
                            "target_lang_translations": {
                                "en": "An electrical network is an example where the theory of directed <w>graphs</w> can be applied.",
                                "ru": "Электрическая сеть — это пример, где может быть применена теория ориентированных <w>графов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grafe"
                    ],
                    "common_phrases": [
                        "gerichte graaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gespeld als grafe"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A mathematical representation of a set of points connected by lines.",
                        "ru": "Математическое представление набора точек, соединенных линиями."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "graph",
                                "target_lang_sense_clarification": "discrete mathematics"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "граф",
                                "target_lang_sense_clarification": "в дискретной математике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6339e9e0-510c-3568-a85c-2995d0d08031",
                    "sense_definition": "Een door mensen gegraven waterloop, zoals een gracht of een brede greppel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water in de oude <w>graaf</w> stond deze zomer erg laag.",
                            "target_lang_translations": {
                                "en": "The water in the old <w>ditch</w> was very low this summer.",
                                "ru": "Уровень воды в старом <w>канале</w> этим летом был очень низким."
                            }
                        },
                        {
                            "text": "Langs de velden liep een diepe <w>graaf</w> om het overtollige regenwater af te voeren.",
                            "target_lang_translations": {
                                "en": "A deep <w>canal</w> ran along the fields to drain excess rainwater.",
                                "ru": "Вдоль полей тянулась глубокая <w>канава</w> для отвода лишней дождевой воды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A man-made watercourse, such as a canal or a wide ditch.",
                        "ru": "Искусственный водоток, такой как канал или широкая канава."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ditch",
                                "target_lang_sense_clarification": "man-made watercourse"
                            },
                            {
                                "target_lang_word": "canal",
                                "target_lang_sense_clarification": "dug waterway"
                            },
                            {
                                "target_lang_word": "moat",
                                "target_lang_sense_clarification": "defensive ditch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "вырытый водоток"
                            },
                            {
                                "target_lang_word": "ров",
                                "target_lang_sense_clarification": "оборонительный или дренажный"
                            },
                            {
                                "target_lang_word": "канава",
                                "target_lang_sense_clarification": "широкое углубление для воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b4a11ad-710f-38ad-89cd-cf6e5816c386",
                    "sense_definition": "Een stuk gereedschap dat wordt gebruikt om aarde te verplaatsen; een spade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zette de <w>graaf</w> in de grond om een gat voor de boom te maken.",
                            "target_lang_translations": {
                                "en": "He put the <w>spade</w> into the ground to make a hole for the tree.",
                                "ru": "Он вонзил <w>лопату</w> в землю, чтобы выкопать яму для дерева."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>graaf</w> is het zwaar werk om de hele tuin om te spitten.",
                            "target_lang_translations": {
                                "en": "Without a good <w>shovel</w>, it is hard work to dig up the entire garden.",
                                "ru": "Без хорошей <w>лопаты</w> перекопать весь сад — тяжелая работа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in bepaalde dialecten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tool used for moving earth; a spade.",
                        "ru": "Инструмент, используемый для перемещения земли; лопата."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spade",
                                "target_lang_sense_clarification": "digging tool"
                            },
                            {
                                "target_lang_word": "shovel",
                                "target_lang_sense_clarification": "tool for moving earth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лопата",
                                "target_lang_sense_clarification": "инструмент для копания"
                            },
                            {
                                "target_lang_word": "заступ",
                                "target_lang_sense_clarification": "вид лопаты"
                            }
                        ]
                    }
                }
            ]
