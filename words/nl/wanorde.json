{
    "word_family": [
        "wanordelijk",
        "wanordelijkheid",
        "ordelijk",
        "ordeloos",
        "ordeloosheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02862bb3-55ce-3e24-96cb-ab6fc6237a65",
                    "sense_definition": "Een toestand van chaos, rommel of verwarring waarin alles door elkaar ligt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaos-en-rommel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het wilde feestje was de woonkamer veranderd in een complete <w>wanorde</w>.",
                            "target_lang_translations": {
                                "en": "After the wild party, the living room had turned into complete <w>disorder</w>."
                            }
                        },
                        {
                            "text": "Zonder een goede opruimbeurt blijft de kamer een <w>wanorde</w>.",
                            "target_lang_translations": {
                                "en": "Without a proper clean-up, the room remains a <w>mess</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "rommel",
                        "troep",
                        "zooi"
                    ],
                    "antonyms": [
                        "orde"
                    ],
                    "common_phrases": [
                        "een complete wanorde"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of chaos, mess, or confusion in which everything is jumbled together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorder",
                                "target_lang_sense_clarification": "lack of order or arrangement"
                            },
                            {
                                "target_lang_word": "mess",
                                "target_lang_sense_clarification": "untidy state"
                            },
                            {
                                "target_lang_word": "chaos",
                                "target_lang_sense_clarification": "complete disorder and confusion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34fd404e-f122-3d20-9ad7-453031365020",
                    "sense_definition": "Een situatie waarin regels, structuur of regelmaat ontbreken en er geen toezicht is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebrek-aan-structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er heerst momenteel een <w>wanorde</w> in het verkeer door de kapotte stoplichten.",
                            "target_lang_translations": {
                                "en": "There is currently <w>chaos</w> in the traffic due to the broken traffic lights."
                            }
                        },
                        {
                            "text": "Zonder duidelijke leiding ontstaat er snel <w>wanorde</w> binnen de organisatie.",
                            "target_lang_translations": {
                                "en": "Without clear leadership, <w>disorder</w> quickly arises within the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "verwarring"
                    ],
                    "antonyms": [
                        "orde"
                    ],
                    "common_phrases": [
                        "wanorde in het verkeer"
                    ],
                    "target_lang_definitions": {
                        "en": "A situation in which rules, structure, or regularity are lacking and there is no supervision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorder",
                                "target_lang_sense_clarification": "disturbance of public order or lack of control"
                            },
                            {
                                "target_lang_word": "chaos",
                                "target_lang_sense_clarification": "complete lack of structure or control"
                            },
                            {
                                "target_lang_word": "confusion",
                                "target_lang_sense_clarification": "lack of clarity or order"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fc1f23b-3f99-326b-8870-866ff41445aa",
                    "sense_definition": "Een gebrek aan overzicht of systematiek, met name in administratieve of organisatorische zaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebrek-aan-structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boekhouding van dat bedrijf is verwaarloosd, het is daar een administratieve <w>wanorde</w>.",
                            "target_lang_translations": {
                                "en": "The bookkeeping of that company has been neglected; it is an administrative <w>shambles</w> there."
                            }
                        },
                        {
                            "text": "Door de administratieve <w>wanorde</w> konden de juiste documenten niet op tijd worden gevonden.",
                            "target_lang_translations": {
                                "en": "Due to the administrative <w>disorganization</w>, the correct documents could not be found in time."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwarring",
                        "chaos"
                    ],
                    "antonyms": [
                        "orde"
                    ],
                    "common_phrases": [
                        "administratieve wanorde"
                    ],
                    "target_lang_definitions": {
                        "en": "A lack of overview or system, particularly in administrative or organizational matters."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorder",
                                "target_lang_sense_clarification": "lack of systematic arrangement"
                            },
                            {
                                "target_lang_word": "disorganization",
                                "target_lang_sense_clarification": "poor planning or lack of system"
                            },
                            {
                                "target_lang_word": "chaos",
                                "target_lang_sense_clarification": "complete administrative mess"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "face89b7-0b2a-3946-afa7-bbe63da2e094",
                    "sense_definition": "Een gebrek aan samenhang, harmonie of eenheid binnen een groep of bestuur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gebrek-aan-structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door alle ruzies heerst er <w>wanorde</w> in het bestuur.",
                            "target_lang_translations": {
                                "en": "Because of all the arguments, there is <w>discord</w> within the board."
                            }
                        },
                        {
                            "text": "De interne meningsverschillen leidden tot een grote <w>wanorde</w> binnen de politieke partij.",
                            "target_lang_translations": {
                                "en": "The internal disagreements led to great <w>disarray</w> within the political party."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwarring",
                        "chaos"
                    ],
                    "antonyms": [
                        "orde"
                    ],
                    "common_phrases": [
                        "wanorde in het bestuur"
                    ],
                    "target_lang_definitions": {
                        "en": "A lack of cohesion, harmony, or unity within a group or governing body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorder",
                                "target_lang_sense_clarification": "lack of unity or harmony"
                            },
                            {
                                "target_lang_word": "discord",
                                "target_lang_sense_clarification": "disagreement and lack of harmony"
                            },
                            {
                                "target_lang_word": "disarray",
                                "target_lang_sense_clarification": "state of organizational confusion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}