            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1c8a6aa-ad07-3994-922c-b6509347117a",
                    "sense_definition": "Grand poisson d'eau douce de la famille des cyprinidés, vivant dans les eaux calmes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pêcheur a passé toute la matinée au bord de l'étang pour attraper une grosse <w>carpe</w>."
                        },
                        {
                            "text": "Dans ce grand bassin japonais nagent de magnifiques <w>carpes</w> aux couleurs éclatantes."
                        }
                    ],
                    "common_phrases": [
                        "pêche à la carpe",
                        "carpe commune"
                    ]
                },
                {
                    "sense_id": "ae4c46c5-3106-3428-b6c0-431feab4935f",
                    "sense_definition": "Chair comestible de ce poisson, préparée pour l'alimentation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aliment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le repas de fête, le cuisinier a préparé une délicieuse <w>carpe</w> farcie selon une recette traditionnelle."
                        },
                        {
                            "text": "Certains clients trouvent que la chair de la <w>carpe</w> a parfois un léger goût de vase."
                        }
                    ],
                    "common_phrases": [
                        "carpe farcie",
                        "filet de carpe"
                    ]
                },
                {
                    "sense_id": "9f3b5b5b-b5c2-3f85-a65d-2437e37f017e",
                    "sense_definition": "Ensemble des huit petits os articulés formant le squelette du poignet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une radiographie a révélé une fracture sur l'un des huit os qui composent le <w>carpe</w>."
                        },
                        {
                            "text": "Le chirurgien a examiné attentivement l'articulation du <w>carpe</w> après la chute violente du patient."
                        }
                    ],
                    "common_phrases": [
                        "os du carpe",
                        "articulation du carpe"
                    ]
                }
            ]
        }
