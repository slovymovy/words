                                        "sense_id": "f82f64e2-809c-37e7-a672-14e35f0266c3",
                                        "entry_id": "fc3d08d0-5184-3cd3-be36-2a2cc9007c3a",
                                        "glosses": [
                                            "A pile of materials to be heated in a controlled way, stacked or heaped together with fuel so that the fire permeates the pile; the material of interest may be bricks to be fired, ore for roasting, coal for coking, or wood to be charcoalized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4cfba45-0318-48ef-8fa7-b070c82a9319",
                                                "sense_id": "f82f64e2-809c-37e7-a672-14e35f0266c3",
                                                "text": "[T]he pots would be stacked in a heap, covered with wood chippings and brushwood and domed over with turves, leaving a few air vents around the sides. When complete the clamp would be fired[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb005a0b-657d-3f0f-9c5f-4899cb282526",
                                        "entry_id": "fc3d08d0-5184-3cd3-be36-2a2cc9007c3a",
                                        "glosses": [
                                            "A compact pile of agricultural produce (such as root vegetables or silage) used for temporary storage (often covered with straw, earth, or both)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88d5133b-015d-31b4-ab86-31d65b86ef6c",
                                        "entry_id": "fc3d08d0-5184-3cd3-be36-2a2cc9007c3a",
                                        "glosses": [
                                            "A piece of wood (batten) across the grain of a board end to keep it flat, as in a breadboard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f365eb5-d087-3106-b74e-babcb9417f40",
                                        "entry_id": "fc3d08d0-5184-3cd3-be36-2a2cc9007c3a",
                                        "glosses": [
