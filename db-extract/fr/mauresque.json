                    {
                        "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                        "entry_id": "91c7be5a-3781-3a84-9ae5-d1ca81ed8810",
                        "glosses": [
                            "Qui appartient aux Maures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe997977-67d2-4624-a700-4369175f3992",
                                "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                                "text": "« Voici, Monsieur, quelques renseignements intéressants sur les tribus mauresques les plus voisines de notre colonie du Sénégal ; …."
                            },
                            {
                                "example_id": "a35e4c53-7d94-4c90-8c10-2893b640528a",
                                "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                                "text": "Seulement, elle étouffait entre les quatre murs blancs de la cour mauresque où elle était enfermée, et elle regrettait amèrement l'immensité libre de sa plaine natale, …."
                            }
                        ]
                    }
                ],
