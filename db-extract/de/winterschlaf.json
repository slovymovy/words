                "senses": [
                    {
                        "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                        "entry_id": "6312a896-acec-38fa-b7ce-705b6b6979c8",
                        "glosses": [
                            "schlafähnlicher Zustand, in dem sich manche Säugetiere und vereinzelte Vogelarten während der kalten Jahreszeit befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b6b22b-2c23-41a2-98a7-d50f94feb2f7",
                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                "text": "„Für den Winterschlaf legen die Fledermäuse spezielle Fettvorräte an, deren alleiniger Zweck es ist, während des Aufwachens die notwendige Energie zu liefern, mit der wieder die normale Körpertemperatur erreicht werden kann.“"
                            },
                            {
                                "example_id": "318917fe-5e81-40f5-8c89-290e1f1160a4",
                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                "text": "„Irgendwann in unserer oder zumindest in meiner zoologischen Vergangenheit muß der Winterschlaf ein wichtiger Faktor gewesen sein.“"
                            },
                            {
                                "example_id": "af0996b1-9f46-4645-a702-728174d35638",
                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                "text": "Als ich ihn fragte, woher er so müde ist, meinte er: \"Auf den Winterschlaf folgt die Frühjahrsmüdigkeit gefolgt von der Sommerlethargie.\""
                            },
                            {
                                "example_id": "540673d6-346a-49d5-a120-c05c833069e6",
                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                "text": "„Rosa knirschte mit den Zähnen, schlug sich selbst an die Brust und dann ins Gesicht, als stünde sie im Kampf mit einem inneren Wesen, das gerade wutentbrannt aus seinem Winterschlaf erwachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
