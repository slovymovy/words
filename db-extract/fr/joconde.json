            {
                "entry_id": "ce10ca04-f6ed-30b5-81a7-b83510bf9c13",
                "word": "Joconde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4327733d-792b-3460-8b54-6f3ad5be01cd",
                        "entry_id": "ce10ca04-f6ed-30b5-81a7-b83510bf9c13",
                        "glosses": [
                            "Don Juan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a819fa-a64e-402c-b664-91e86db8dc93",
                                "sense_id": "4327733d-792b-3460-8b54-6f3ad5be01cd",
                                "text": "Tu n’es qu’un mauvais sujet, un Joconde, un Lovelace."
                            },
                            {
                                "example_id": "62859765-bcdb-4eb8-b0a4-fa9ff0d00a4b",
                                "sense_id": "4327733d-792b-3460-8b54-6f3ad5be01cd",
