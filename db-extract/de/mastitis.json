                                        "entry_id": "fc6f2370-c611-33a1-b505-d2c451984729",
                                        "glosses": [
                                            "Inflammation des mamelles."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19cf58b-3768-4f59-91ed-64e90b291adf",
                                                "sense_id": "9ffe56ee-2f2c-39f3-b72e-9ef617585730",
                                                "text": "D’ailleurs, une mastite se manifeste souvent à un moment où vous êtes particulièrement fatiguée."
