                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to <w>Harbor</w> to be closer to the coast.",
                            "target_lang_translations": {
                                "ru": "Они решили переехать в <w>Харбор</w>, чтобы быть ближе к побережью.",
                                "zh": "他们决定搬到<w>哈伯</w>，以便离海岸更近。",
                                "fr": "Ils ont décidé de déménager à <w>Harbor</w> pour être plus proches de la côte."
                            }
                        },
                        {
