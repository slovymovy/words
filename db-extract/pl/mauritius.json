                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbc65b7-22a5-4eaa-929f-06ad85c33a5e",
                                                "sense_id": "3e283b25-723c-3cd3-9f19-d5c58fa0e35d",
                                                "text": "Wir machen Urlaub auf Mauritius."
                                            },
                                            {
                                                "example_id": "d27ebb08-cdce-4859-aeae-645308d16603",
                                                "sense_id": "3e283b25-723c-3cd3-9f19-d5c58fa0e35d",
                                                "text": "Port Louis ist die Hauptstadt von Mauritius."
                                            },
                                            {
                                                "example_id": "56b972c1-4268-461a-a3de-068e418bf3f8",
                                                "sense_id": "3e283b25-723c-3cd3-9f19-d5c58fa0e35d",
                                                "text": "„Vor der Unabhängigkeit war die Wirtschaft in Mauritius fast nur von Zuckerrohr abhängig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
