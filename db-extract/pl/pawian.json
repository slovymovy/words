                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "Im alten Ägypten galten Paviane als heilige Tiere."
                                            },
                                            {
                                                "example_id": "4c656f25-d3a7-4d94-90ac-30754be09a4e",
                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "„Eigentlich interessiere ich mich nicht für Tiere, aber eine Kollegin aus der Bürogemeinschaft muss einmal gehört haben, wie ich sagte, dass ich Paviane lustig finde.“"
                                            },
                                            {
                                                "example_id": "8232a177-b438-4471-b23b-bdcfc6180516",
                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "„Orang-Utans seien auch nicht so wild wie Paviane, nicht so dumm wie Meerkatzen, nicht so schmutzig wie Springaffen, nicht so ungeduldig und triebhaft wie Hundsaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcab9dc-a702-4441-b50c-0ef0e0ce0107",
                        "source_entry_id": "6f203937-0a33-329c-818f-5e38bb65d9f8",
                        "source_sense_id": "83a5d133-648e-3ded-a321-201c543ceefa",
                        "target_lang_word": "павиан",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "павиан",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94f12cd2-b23a-3713-80df-a78562e61c3c",
                                        "entry_id": "1fd0d920-170d-3501-be04-d45ca5ea59c3",
                                        "glosses": [
                                            "зоол. род узконосых обезьян семейства мартышковых с коротким хвостом и пышной гривой (лат. Papio)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fced9bd1-2a1a-47f0-ae9c-a46a3a712417",
                                                "sense_id": "94f12cd2-b23a-3713-80df-a78562e61c3c",
                                                "text": "Жили в обезьяннике две самки павиана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b5ad8f-9c9f-310d-9815-7933f41bd9a2",
                                        "entry_id": "1fd0d920-170d-3501-be04-d45ca5ea59c3",
                                        "glosses": [
                                            "разг., неодобр. глупый, напыщенный, неприятный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4a0166-32cb-4f55-a0a8-a3b442ab2775",
                                                "sense_id": "97b5ad8f-9c9f-310d-9815-7933f41bd9a2",
                                                "text": "Когда пискливый голос павиана Геббельса благодаря громкоговорителям и вассальным радиостанциям превращается в рёв, я вспоминаю старую персидскую пословицу: «Если бы рёв имел цену, самым дорогим животным на свете был бы осёл!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
