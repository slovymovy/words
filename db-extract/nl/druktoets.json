                    {
                        "sense_id": "582475ea-7b5f-389e-b763-de90df2fb22d",
                        "entry_id": "449be28f-8692-35d6-b473-524b70c562c7",
                        "glosses": [
                            "knopje dat verbinding maakt bij indrukken en bij loslaten weer terugspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51546a5e-fa31-4b2e-81bf-8ac78043d47f",
                                "sense_id": "582475ea-7b5f-389e-b763-de90df2fb22d",
                                "text": "De eerste ziet eruit als een gewone betaalkaart, maar met een grote druktoets. Daarmee kunt u het bedrag van uw laatste transactie of informatie over uw betaallimiet op uw zichtrekening opvragen zonder dat u daarvoor naar bank of betaalautomaat moet. Een Turkse bankdochter van BNP Paribas heeft de primeur."
                            },
                            {
                                "example_id": "baff3c78-3c69-483a-b940-79162718626e",
                                "sense_id": "582475ea-7b5f-389e-b763-de90df2fb22d",
                                "text": "Op een stuur vol knoppen voor de meeste functies bevindt zich ter bestendiging van de geluidshinder de druktoets voor het Uitlaatgeluid Sport, die geen vlogger is ontschoten."
                            }
                        ]
                    }
