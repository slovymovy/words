        "de-extract.jsonl": [
            {
                "entry_id": "27abab0a-3758-306b-ae3b-44ec5a1db43e",
                "word": "signifié",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdd8ff86-eec5-3240-9e3e-c55cc31426c5",
                        "entry_id": "27abab0a-3758-306b-ae3b-44ec5a1db43e",
                        "glosses": [
                            "Bedeutung des sprachlichen Zeichens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a858f79a-95cf-4c1f-a32a-a8ff403ab7ea",
                                "sense_id": "fdd8ff86-eec5-3240-9e3e-c55cc31426c5",
                                "text": "„Nous proposons de conserver le mot signe pour désigner le total, et de remplacer concept et image acoustique respectivement par signifié et signifiant…“ Deutsche Übersetzung: „Ich schlage also vor, daß man das Wort Zeichen beibehält für das Ganze, und Vorstellung bzw. Lautbild durch Bezeichnetes und Bezeichnung (Bezeichnendes) ersetzt…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a81e6e0-f7da-45ba-9e98-ba0e32acd5b6",
                        "source_entry_id": "27abab0a-3758-306b-ae3b-44ec5a1db43e",
                        "source_sense_id": "fdd8ff86-eec5-3240-9e3e-c55cc31426c5",
                        "source_sense_description": "Linguistik: Bedeutung des sprachlichen Zeichens",
                        "target_lang_word": "Bedeutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bedeutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                        "entry_id": "cc6971c0-8a85-3de0-afd1-9c6052b1aaf7",
                                        "glosses": [
                                            "Sinn einer Information, Handlung oder Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a71cc3-c1a8-47c2-b02b-83120b9efc4f",
                                                "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                                "text": "Die eigentliche Bedeutung des Gesetzes war es, die Opfer zu schützen."
                                            },
                                            {
                                                "example_id": "b6577cb0-91ed-4bc9-9381-75bf69e01f91",
                                                "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                                "text": "„Die schon in der Antike bekannten, vor allem aus Kreta überlieferten Stierspiele […] hatten ursprünglich rituelle Bedeutung.“"
                                            },
                                            {
                                                "example_id": "e0c7e0ea-7908-419b-bc3f-36dcce3d8e08",
                                                "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                                "text": "„Seine Welt ist vielmehr das fein gesponnene Netz an Bedeutungen, mit denen er alles Faktische auflädt.“"
                                            },
                                            {
                                                "example_id": "9479ba15-e1ba-48d0-abb2-98f44cd7a5e1",
                                                "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                                "text": "„Aber etwas geschah mit mir, als ich mit Benjamin zusammen über die Dokumente meiner Tante gebeugt dasaß und wir über die Bedeutung der in ihrer unleserlichen Sauklaue geschriebenen Worte diskutierten wie über die in einem antiquarischen Manuskript.“"
                                            },
                                            {
                                                "example_id": "43192957-9e01-4c9f-95e8-f733a515585f",
                                                "sense_id": "31385b7e-a19b-3ff4-bd99-5dcbce67d4c0",
                                                "text": "„Das Hauptziel des Lehrens ist nicht, Bedeutungen zu erklären, sondern an die Tür des Geistes zu klopfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                        "entry_id": "cc6971c0-8a85-3de0-afd1-9c6052b1aaf7",
                                        "glosses": [
                                            "Relevanz einer Information, Handlung oder Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f9834e-3751-4b27-b9ed-688f11e32473",
                                                "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                                "text": "„Messen Sie dem Gesagten keine Bedeutung zu!“"
                                            },
                                            {
                                                "example_id": "4aff620f-ebc8-46af-9e5c-b2c48ea371f1",
                                                "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                                "text": "„Das Hauptziel des Lehrens ist nicht, Bedeutungen zu erklären, sondern an die Tür des Geistes zu klopfen.“"
                                            },
                                            {
                                                "example_id": "1128fad5-83e8-453b-ade2-52bcd3de7197",
                                                "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                                "text": "„Das Römerlager an der Werra verlor dadurch fast schlagartig seine Bedeutung.“"
                                            },
                                            {
                                                "example_id": "f4c07094-5361-4557-b1fb-0adfec370cc8",
                                                "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                                "text": "„Man könnte meinen, es spiele keine Rolle, ob man die Bedeutung eines historischen Geschehnisses so oder anders erklärt.“"
                                            },
                                            {
                                                "example_id": "ae2e2d71-9322-4ecb-b3a3-a6368bf3ae66",
                                                "sense_id": "f981aec9-cb22-3b15-a565-ead2c014a887",
                                                "text": "„Dabei erfahren wir auch etwas über grundsätzliche Fehlschlüsse und die meist unterschätzte Bedeutung von Vorinformationen, und wir lernen, wie man Informationen quantitativ verknüpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                        "entry_id": "cc6971c0-8a85-3de0-afd1-9c6052b1aaf7",
                                        "glosses": [
                                            "Inhalt eines sprachlichen Zeichens, besonders eines Wortes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c9080c-2ab4-46d8-bfca-7eef62521d48",
                                                "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                                "text": "Die Bedeutung des Wortes „Frau“ kann z.T. mit den Semen „Mensch“, „erwachsen“, „weiblich“ beschrieben werden."
                                            },
                                            {
                                                "example_id": "3eb0cb51-49a6-4a93-beb9-a15f0245b8ce",
                                                "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                                "text": "„Zwar wissen wir, daß sich Aussprache, Schreibung und Bedeutung von Wörtern und Wendungen im Laufe der Jahrhunderte wandeln.“"
                                            },
                                            {
                                                "example_id": "6cc68f34-1abb-486b-9cef-f489607ab2aa",
                                                "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                                "text": "„Keine Bedeutung steht ganz für sich allein.“"
                                            },
                                            {
                                                "example_id": "82c6c824-f10b-42b6-ab14-aae40a07ecd3",
                                                "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                                "text": "„Die beiden Bedeutungen, die im Singular vereint sind, gehen im Plural auseinander.“"
                                            },
                                            {
                                                "example_id": "38688481-9d89-4fb6-8aab-1b77c8d7c5fa",
                                                "sense_id": "6ee30531-15e5-3b1a-8bf5-6f2891c69464",
                                                "text": "„Auch die Bedeutung einzelner Wörter oder deren mehrere Bedeutungen, also ihre Semantik, lässt Witze entstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
