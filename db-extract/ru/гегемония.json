                        "sense_id": "18a58f40-4f2f-3cf2-8655-91e1ee338108",
                        "entry_id": "7945b45a-62b0-3747-9a0d-790679512b7b",
                        "glosses": [
                            "книжн. первенство, руководство, превосходство в силе, влиянии; господство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3c1b80-a170-44aa-a0a4-520021a566ae",
                                "sense_id": "18a58f40-4f2f-3cf2-8655-91e1ee338108",
                                "text": "Гегемония Рима принесла Дельфам не упадок, а, скорее, ещё больший расцвет их обаяния."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ffe9cc-a2f6-4f51-aa03-9accf275605e",
                        "source_entry_id": "7945b45a-62b0-3747-9a0d-790679512b7b",
                        "source_sense_id": "18a58f40-4f2f-3cf2-8655-91e1ee338108",
                        "target_lang_word": "hegemony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hegemony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7390bf5-92d2-316d-bff6-ac572dfc3a23",
                                        "entry_id": "ab8ff8d7-4243-3706-819f-0a3833c2f235",
                                        "glosses": [
                                            "Domination, influence, or authority over another, especially by one political group over a society or by one nation over others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab08703c-f0cd-4d0f-b457-a38920a0c32a",
                                                "sense_id": "e7390bf5-92d2-316d-bff6-ac572dfc3a23",
                                                "text": "The idea of a German republic and confederacy like the American, is surely less fantastical than a hegemony to which nobody is willing to submit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07168a8c-ae50-3706-9b6f-3555d72044a3",
                                        "entry_id": "ab8ff8d7-4243-3706-819f-0a3833c2f235",
                                        "glosses": [
                                            "Dominance of one social group over another, such that the ruling group or hegemon acquires some degree of consent from the subordinate, as opposed to dominance purely by force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93eb7ede-6739-43c9-a254-65ba118821c7",
                                                "sense_id": "07168a8c-ae50-3706-9b6f-3555d72044a3",
                                                "text": "The two political parties battled viciously for hegemony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
