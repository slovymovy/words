                ],
                "translations": [
                    {
                        "translation_id": "5417257b-d11b-4d9c-af2c-0271df874e35",
                        "source_entry_id": "bf879b64-312b-31fc-80d8-042bb15b6977",
                        "target_lang_word": "migrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68f68311-1128-3343-89ff-399e0e7d8e6e",
                                        "entry_id": "9ffba40e-3d69-3c67-9941-77bec6623d61",
                                        "glosses": [
                                            "Passer d’un pays dans un autre pour s’y établir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "657942dc-7b6d-3e44-8cec-6315bb8d64f3",
                                        "entry_id": "9ffba40e-3d69-3c67-9941-77bec6623d61",
                                        "glosses": [
                                            "Voyager, en parlant des oiseaux et autres animaux migrateurs, qui se déplacent tous les ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331a9e4c-0788-4778-aa77-4f31b35adaa0",
                                                "sense_id": "657942dc-7b6d-3e44-8cec-6315bb8d64f3",
                                                "text": "Les oies migrent vers le sud en automne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fb517e-0a46-3c41-8434-d389305a8964",
                                        "entry_id": "9ffba40e-3d69-3c67-9941-77bec6623d61",
                                        "glosses": [
                                            "Se déplacer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30150802-a75d-4d9b-b093-68f9e926841f",
                                                "sense_id": "89fb517e-0a46-3c41-8434-d389305a8964",
                                                "text": "Les multicoques furent inventés dès le Néolithique, probablement par les peuples du Pacifique qui migraient, d'île en île, sur ces embarcations rapides."
                                            },
                                            {
                                                "example_id": "bfe1b1c8-e8a2-4312-8f2c-6e60af34fa7c",
                                                "sense_id": "89fb517e-0a46-3c41-8434-d389305a8964",
                                                "text": "J’avais dû être ultra-convaincant, car finalement le chauffeur migra sur le siège passager tout en me lorgnant de travers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0947c160-794d-3ded-936d-c7db9b857cf0",
                                        "entry_id": "9ffba40e-3d69-3c67-9941-77bec6623d61",
                                        "glosses": [
                                            "Transférer, changer de logiciel ou de machine, ce qui peut impliquer des traitements complexes des données déjà existantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5096e29f-74ee-4c8d-a140-c52f382a6db3",
                                                "sense_id": "0947c160-794d-3ded-936d-c7db9b857cf0",
                                                "text": "La Commission européenne a publié un guide pour migrer vers l'\"open source\"."
                                            },
                                            {
                                                "example_id": "fda191e8-938a-4553-8137-e26b458d8eaa",
                                                "sense_id": "0947c160-794d-3ded-936d-c7db9b857cf0",
                                                "text": "L'entreprise cherche à migrer ses données vers le cloud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce48014c-2d9d-4efd-9951-a8c7a4ea5fd1",
                        "source_entry_id": "bf879b64-312b-31fc-80d8-042bb15b6977",
                        "target_lang_word": "émigrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émigrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62be868d-908e-3217-9864-c98bbcc32af4",
                                        "entry_id": "64020b00-273c-3fc7-905a-18f8dd7c4174",
                                        "glosses": [
                                            "Quitter son pays pour aller s’établir dans un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c79a86c-964f-415f-8295-d6faa7a6ebb2",
                                                "sense_id": "62be868d-908e-3217-9864-c98bbcc32af4",
                                                "text": "Il faut que la misère des Islandais soit bien grande pour les déterminer à émigrer. L’émigration islandaise a commencé en 1870, sous l’impulsion de M. Olafsson, journaliste radical et membre du parlement de Reykjavik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608adb3a-33f4-3eca-914c-7528203edc71",
                                        "entry_id": "64020b00-273c-3fc7-905a-18f8dd7c4174",
                                        "glosses": [
                                            "Quitter la France durant la Convention, en parlant des aristocrates et de leurs affidés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2083cc29-e8a2-46ae-956a-88969d554c44",
                                                "sense_id": "608adb3a-33f4-3eca-914c-7528203edc71",
                                                "text": "Mon père se cache de son côté en attendant une occasion d'émigrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53b6071-5cdc-33a4-b191-32e61fe84ba0",
                                        "entry_id": "64020b00-273c-3fc7-905a-18f8dd7c4174",
                                        "glosses": [
                                            "Quitter périodiquement une région pour séjourner dans une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc493b6-7ff1-46c7-8138-09e070c7396f",
                                                "sense_id": "c53b6071-5cdc-33a4-b191-32e61fe84ba0",
                                                "text": "Vers le 20 mars, les chasseurs signalèrent les premiers cygnes, qui émigraient des territoires méridionaux et s'envolaient vers le nord en poussant d'aigres sifflements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6edc89ef-42b1-3761-aa79-b93060153083",
                                        "entry_id": "64020b00-273c-3fc7-905a-18f8dd7c4174",
                                        "glosses": [
                                            "Migrer d'un lieu à un autre."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eea4e7d-e331-43fc-adf7-3a6d0d091236",
                                                "sense_id": "6edc89ef-42b1-3761-aa79-b93060153083",
                                                "text": "Ce Charançon pullule principalement dans les zones de culture de la Betterave, il hiverne dans les betteravières de l'année précédente et émigre au printemps, dès sa sortie, vers les nouvelles plantations consécutives à l’assolement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
