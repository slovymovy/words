                                        "sense_id": "f6ecb9e0-cc0b-377f-982c-dbcaed96dbf4",
                                        "entry_id": "b3a20b51-b994-32e8-9ee9-27c429826bfd",
                                        "glosses": [
                                            "Qui a les caractéristiques d’un comburant."
                                        ],
