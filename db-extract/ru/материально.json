                                            {
                                                "example_id": "04e2584b-1665-4b68-9587-0782247387dd",
                                                "sense_id": "ed529d5a-ff51-3821-b266-8ce52a76711f",
                                                "text": "Chi ha materialmente realizzato quest'opera?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b57cea-c3ec-376c-9c68-5531a91f25d8",
                                        "entry_id": "811fd8f7-d19f-3832-b801-10e818464c61",
                                        "glosses": [
                                            "in senso fisico, relativamente alla materia e al mondo reale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe163cdd-2874-4ee0-93a5-352b5a62cd69",
                                                "sense_id": "e2b57cea-c3ec-376c-9c68-5531a91f25d8",
                                                "text": "Non è materialmente possibile costruire qualcosa di queste dimensioni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470ef307-2fa4-3f72-bce0-d2a2efb3ef77",
                                        "entry_id": "811fd8f7-d19f-3832-b801-10e818464c61",
                                        "glosses": [
                                            "in senso finanziario"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b7d4c2-01df-425f-b654-ef8f65e970fb",
                                                "sense_id": "470ef307-2fa4-3f72-bce0-d2a2efb3ef77",
                                                "text": "Ha aiutato materialmente il figlio in quell'impresa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ddb28c-a2fa-3e8d-ae0c-d0af7dbfadb6",
