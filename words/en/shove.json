                {
                    "sense_id": "91e4db45-d6b8-3f6c-831b-2365c28a24be",
                    "sense_definition": "To bet all of one's remaining chips in a game of poker.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>shove</w> with a pair of aces hoping for a call.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пойти ва-банк</w> с парой тузов, надеясь на колл.",
                                "zh": "他决定拿着一对A<w>全下</w>，希望有人跟注。",
                                "cs": "Rozhodl se <w>jít all-in</w> s párem es v naději, že to někdo dorovná."
                            }
                        },
                        {
                            "text": "If you <w>shove</w> now, the other players might fold immediately.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>пойдешь ва-банк</w> сейчас, остальные игроки могут сразу сбросить карты.",
                                "zh": "如果你现在<w>全压</w>，其他玩家可能马上弃牌。",
                                "cs": "Pokud teď <w>vsadíš vše</w>, ostatní hráči mohou okamžitě složit karty."
                            }
                        }
                    ],
                    "synonyms": [
                        "go all in"
                    ],
                    "antonyms": [
                        "fold"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gambling context"
                        }
