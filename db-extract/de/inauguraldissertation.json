                "senses": [
                    {
                        "sense_id": "699b69f1-95e8-3aa5-a6f9-8d0d0e3f63ca",
                        "entry_id": "3b713f42-b3ec-3ce3-8fb0-d27b37fd5d39",
                        "glosses": [
                            "wissenschaftliche Arbeit zur Erlangung der Doktorwürde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0311b0be-4b37-4c6f-82ab-2bca7b7880eb",
                                "sense_id": "699b69f1-95e8-3aa5-a6f9-8d0d0e3f63ca",
                                "text": "„Erst 1770 wurde Kant endlich zum „Professore Ordinario der Logic und Metaphysic“ ernannt, […] Vor Antritt der Professur war noch eine öffentliche Inauguraldissertation vor dem akademischen Senat zu verteidigen.“"
                            },
                            {
                                "example_id": "c3da76d1-9640-4491-8d19-9571d6f7f34c",
                                "sense_id": "699b69f1-95e8-3aa5-a6f9-8d0d0e3f63ca",
                                "text": "„Mit der lateinischen Inauguraldissertation wird Kant zum ersten Male positiv-kritisch tätig, indem er sich nun an die mühsame Arbeit macht, nach Beseitigung der Trümmer der bisherigen Metaphysik das Gebiet der Philosophie neu zu begründen und zu festigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
