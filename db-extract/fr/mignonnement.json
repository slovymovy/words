                "senses": [
                    {
                        "sense_id": "91653328-c33f-35d4-a9fb-0af5a5f525a3",
                        "entry_id": "08f8c4bc-ba81-3c9a-80fe-14b870f1d954",
                        "glosses": [
                            "D’une façon mignonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f828328b-922f-4344-ba49-ed297a364702",
                                "sense_id": "91653328-c33f-35d4-a9fb-0af5a5f525a3",
                                "text": "Ses doigts étaient mignonnement groupés autour de son joli menton."
                            },
                            {
                                "example_id": "6c1f0ede-0e04-4efd-a0b1-474eb1be522d",
                                "sense_id": "91653328-c33f-35d4-a9fb-0af5a5f525a3",
                                "text": "Calyste fit alors ce qu’il n’avait jamais fait, il prit Camille par la taille et la baisa au cou mignonnement, sans amour, mais avec tendresse et comme il embrassait sa mère."
                            },
                            {
                                "example_id": "683e7d67-62e5-4720-8609-ea3424639219",
                                "sense_id": "91653328-c33f-35d4-a9fb-0af5a5f525a3",
                                "text": "Bientôt l’aiguille mignonnement ouvrée de la Sainte-Chapelle s’élança par-dessus les combles du palais pénétrée par les dernières lueurs du couchant."
                            }
                        ]
                    }
