                ],
                "senses": [
                    {
                        "sense_id": "4a4d7f53-166b-32ab-b71b-29d31911f0c7",
                        "entry_id": "7738567c-08af-3d48-9be0-64f40a3f5589",
                        "glosses": [
                            "теплый, сильный, сухой южный или юго-восточный ветер в Средиземноморье, приносящий в Южную Европу большое количество пыли из пустынь Северной Африки и Аравийского полуострова."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c93b13-55de-4401-81b0-5f1b4a8c2fea",
                                "sense_id": "4a4d7f53-166b-32ab-b71b-29d31911f0c7",
                                "text": "Я не смотрю на мир бегущих линий, // Мои мечты лишь вечному покорны. // Пускай сирокко бесится в пустыне, // Сады моей души всегда узорны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d26f9145-36d8-45e1-9e53-41a07f87688e",
                        "source_entry_id": "7738567c-08af-3d48-9be0-64f40a3f5589",
                        "source_sense_id": "4a4d7f53-166b-32ab-b71b-29d31911f0c7",
                        "target_lang_word": "sirocco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sirocco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                        "entry_id": "cb9fbbdf-4c49-3c21-8a26-2f9d2ab5ed01",
                                        "glosses": [
                                            "A hot and often strong southerly to southeasterly wind on the Mediterranean that originates in the Sahara and adjacent North African regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd5ec11-d9df-469f-a440-8d1b9ced5fb9",
                                                "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                                "text": "But come, the board is spread; our silver lamp / Is trimm’d, and heeds not the sirocco’s damp."
                                            },
                                            {
                                                "example_id": "90452674-fbf4-45dd-b8d2-0085122f507a",
                                                "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                                "text": "Diese Toleranz und largeur des Herzens, die Alles „verzeiht“, weil sie Alles „begreift“, ist Scirocco für uns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0552eefb-276b-308a-90dc-9896e8b56041",
                                        "entry_id": "cb9fbbdf-4c49-3c21-8a26-2f9d2ab5ed01",
                                        "glosses": [
                                            "A draft of hot air from an artificial source of heat."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dabccf8-2bd4-481c-8b29-a06f9526d3e1",
                                                "sense_id": "0552eefb-276b-308a-90dc-9896e8b56041",
                                                "text": "In the hearth at the north wall a large fire cracked and lisped, flushing the room with a dry sirocco that caused frozen skin to tingle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48cf2ab6-221c-46e2-89d3-b9fcbd69c564",
