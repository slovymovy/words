                ],
                "senses": [
                    {
                        "sense_id": "c2b397c7-9188-3535-8b29-16842d14967f",
                        "entry_id": "089f2d32-e761-3c5d-9550-932e9e6f651b",
                        "glosses": [
                            "Dépollution par le moyen des plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b193753e-2c95-4c09-9525-68b6e904e67e",
                                "sense_id": "c2b397c7-9188-3535-8b29-16842d14967f",
                                "text": "Les chercheurs estiment qu’ils pourront les exploiter pour concevoir ou sélectionner des variétés végétales utilisables pour la phytoremédiation – la décontamination des sols pollués par des métaux."
                            },
                            {
                                "example_id": "b451af2c-b519-4192-944c-3d7740e7546e",
                                "sense_id": "c2b397c7-9188-3535-8b29-16842d14967f",
                                "text": "« […] le site de 392 m² deviendra un jardin expérimental par le biais de la phytoremédiation, comprenez la dépollution, in situ des sols, eau, air par les plantes qui métabolisent les métaux toxiques », se félicite Alain Giordano, maire du 9ᵉ"
                            },
                            {
                                "example_id": "8500a68a-7516-4131-8be6-165cd37f14a2",
                                "sense_id": "c2b397c7-9188-3535-8b29-16842d14967f",
                                "text": "La phytoremédiation est un terme général qui désigne plus spécifiquement divers procédés dits de bio-dépollution (Bert et Deram, 1999 ; ARTEB, 2006) tels que la phytoextraction, la rhizofiltration, la phytostabilisation, la phytodégradation, la rhizodégradation et la phytovolatilisation."
                            }
                        ]
                    }
                ],
