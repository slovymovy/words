                "senses": [
                    {
                        "sense_id": "6611173c-941f-3785-a36a-c231f798d94e",
                        "entry_id": "c1554a13-6708-3688-b75b-9c37ffb29b2f",
                        "glosses": [
                            "het achterste gedeelte van een groter geheel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584b0ea0-2ee5-4211-ab09-fe1af5f56cf2",
                                "sense_id": "6611173c-941f-3785-a36a-c231f798d94e",
                                "text": "Het containerschip Rena, dat voor de kust van Nieuw-Zeeland op een rif is gelopen, is in tweeën gebroken. Het voorstuk zit nog vast op het rif, het achterstuk is zo'n 30 meter weggedreven."
                            },
                            {
                                "example_id": "6601bbac-c813-4a58-9134-9c75a25cafe8",
                                "sense_id": "6611173c-941f-3785-a36a-c231f798d94e",
                                "text": "Als basis voor de schuilplaatsen gebruikte Wernink rioolbuizen, die het bedrijf voor die tijd al produceerde. Alleen de entree en het achterstuk met ventilatieopening moesten worden ontwikkeld."
                            }
                        ]
                    }
