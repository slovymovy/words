                "senses": [
                    {
                        "sense_id": "7155ac8a-4405-3b49-99e8-e2fba6a11a3e",
                        "entry_id": "1012a746-cf7e-3d8d-9740-08bc139ffe92",
                        "glosses": [
                            "methodische Anwendung von Wasser zur therapeutischen Behandlung akuter oder chronischer Beschwerden, zur Stabilisierung von Körperfunktionen (Abhärtung), zur Vorbeugung, zur Rehabilitation und/oder zur Regeneration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8114dd-8974-4e26-8816-57cdd937782a",
                                "sense_id": "7155ac8a-4405-3b49-99e8-e2fba6a11a3e",
                                "text": "„Die Hydrotherapie, also Anwendungen mit kaltem oder warmem Wasser, gehört zu den klassischen Naturheilverfahren mit Wurzeln in der griechischen Antike.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b411c1c-5a3c-4a5c-9b30-62146e69cd2b",
                        "source_entry_id": "1012a746-cf7e-3d8d-9740-08bc139ffe92",
                        "source_sense_id": "7155ac8a-4405-3b49-99e8-e2fba6a11a3e",
                        "target_lang_word": "hydrotherapy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrotherapy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "218dec09-631f-3a2c-bb39-f62b9e3c901c",
                                        "entry_id": "4d197a11-cba2-35c2-a10d-3125e7adc1f6",
                                        "glosses": [
                                            "Any of various techniques that use water, either externally or internally, for the treatment of disease and for the soothing of pain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f52d3ce-a799-4509-b537-22cf0493e269",
                                                "sense_id": "218dec09-631f-3a2c-bb39-f62b9e3c901c",
                                                "text": "Radio-active baths are said to act favourably in a sexual direction. So too with arsenical springs, cold water treatment, and hydrotherapy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41cd5450-0622-4351-a5bb-ba725b1cb072",
                        "source_entry_id": "1012a746-cf7e-3d8d-9740-08bc139ffe92",
                        "source_sense_id": "7155ac8a-4405-3b49-99e8-e2fba6a11a3e",
                        "target_lang_word": "hydrothérapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrothérapie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                        "entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                                        "glosses": [
                                            "Traitement des maladies par l’usage externe de l’eau froide ou chaude ou par la gymnastique aquatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82e59672-5f59-4919-8dbb-93d7d75713d1",
                                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                                "text": "— … C’était chez elle une habitude. En sortant de table, elle est allée prendre son bain, afin d’être plus tôt prête à partir… Vois-tu, elle se traitait par l’hydrothérapie ; il y a une source, chez eux, et elle s’y baignait régulièrement chaque jour. À peine entrée dans l’eau, elle a eu une attaque d’apoplexie."
                                            },
                                            {
                                                "example_id": "af0cca78-0e98-4b2a-9635-5af889659243",
                                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                                "text": "À Bordeaux, elle sortait tous les deux jours pendant trois heures, sous prétexte d’aller faire de l’hydrothérapie."
                                            },
                                            {
                                                "example_id": "3487a75e-468b-4895-bfa0-b36ebca2634f",
                                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                                "text": "Le commissaire.— Madame, au plaisir de vous revoir. Conseillez à votre mari le bromure, la marche et l’hydrothérapie."
                                            },
                                            {
                                                "example_id": "801259bb-d670-420f-98c2-30f59d978737",
                                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                                "text": "Ayant su que je me destinais à la médecine et que je fréquentais chez le docteur Charcot, il [Guy de Maupassant] m’entreprit un certain soir sur l’hydrothérapie, qui lui tenait fort au cœur et lui paraissait destinée à remplacer tout autre remède. Il avait entendu parler d’un certain jet glacé sur la nuque, en usage, je crois, à Divonne, auquel ne résistait aucune névralgie oculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
