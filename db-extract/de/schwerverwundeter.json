                "senses": [
                    {
                        "sense_id": "f1d446f5-f33e-33ed-9639-02463e16af3d",
                        "entry_id": "417ed60a-4229-351e-92f3-3eaf28f8d949",
                        "glosses": [
                            "männliche Person, die im Krieg erheblich verwundet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24202ab-7872-4aa4-ba6d-b7969e49c917",
                                "sense_id": "f1d446f5-f33e-33ed-9639-02463e16af3d",
                                "text": "„Bedrückend wirkten die ersten Transporte mit Schwerverwundeten, die aus den harten Grenzschlachten in den Vogesen in die Stadt gebracht wurden.“"
                            },
                            {
                                "example_id": "9ecfd0f6-84ae-4e61-ba27-686dcab8aed2",
                                "sense_id": "f1d446f5-f33e-33ed-9639-02463e16af3d",
                                "text": "„Drei Schwerverwundete lagen mit einer Zeltbahn zugedeckt im Regen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
