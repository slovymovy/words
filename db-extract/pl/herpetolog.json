                "senses": [
                    {
                        "sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                        "entry_id": "d8bc9f5b-aa94-3d5a-88ba-230c590051b4",
                        "glosses": [
                            "zoolog badający płazy i gady"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc9c772-5330-4e20-bbed-18f2d4d6cac7",
                                "sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                                "text": "Południowoafrykańskiemu herpetologowi nie udało się odkryć nowego gatunku żaby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d71e5514-a782-4d88-af09-89cb8dbeea19",
                        "source_entry_id": "d8bc9f5b-aa94-3d5a-88ba-230c590051b4",
                        "source_sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                        "target_lang_word": "herpetologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpetologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c1e85d-561a-3c0b-b60a-41b5835971b6",
                                        "entry_id": "08fd9462-1406-326f-8dc4-5d1f7cf663b8",
                                        "glosses": [
                                            "One who studies reptiles and amphibians; a reptile and amphibian specialist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1da26720-5ad0-4a64-b078-7b8810abeba1",
                                                "sense_id": "e0c1e85d-561a-3c0b-b60a-41b5835971b6",
                                                "text": "Already, Griffith has observed several amphibian extinctions. Pretty much every herpetologist working out in the field has watched several."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84d1b2eb-7def-46d6-a595-60eb91471aa8",
                        "source_entry_id": "d8bc9f5b-aa94-3d5a-88ba-230c590051b4",
                        "source_sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                        "target_lang_word": "erpétologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erpétologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac3b84c-e283-314d-b5d2-b3d793b499b1",
                                        "entry_id": "d876bd89-7023-354f-b285-a9bec9da6f87",
                                        "glosses": [
                                            "Variante de herpétologiste."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac48e07-15af-4edf-900d-59830dafcf28",
                                                "sense_id": "0ac3b84c-e283-314d-b5d2-b3d793b499b1",
                                                "text": "L’entomologiste Fabre, l’erpétologiste Rollinat, sont du même rang et de la même trempe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6808d99-da92-41e2-9daf-05031991652d",
                        "source_entry_id": "d8bc9f5b-aa94-3d5a-88ba-230c590051b4",
                        "source_sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                        "target_lang_word": "herpétologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpétologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32f908ff-2e1c-3025-882f-f3c591977233",
                                        "entry_id": "00824319-e9a4-30c1-a99d-b36ed9169b0c",
                                        "glosses": [
                                            "Herpétologue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31099bf5-4f9d-4cac-af9c-4f960c974af0",
                                                "sense_id": "32f908ff-2e1c-3025-882f-f3c591977233",
                                                "text": "Lorsqu'on lui fait mal, il peut jeter un grand cri, analogue, dit le savant herpétologiste Lastaste, « au bruit que produit le frottement d'un parchemin tendre et humide ». (Jean Rostand, La vie des crapauds, 1933)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "def56844-bb0c-48b0-86f8-da264ae9bd11",
                        "source_entry_id": "d8bc9f5b-aa94-3d5a-88ba-230c590051b4",
                        "source_sense_id": "828d725c-a463-39ad-af5b-d5acdae0bfd9",
                        "target_lang_word": "herpétologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpétologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                        "entry_id": "e7df6b05-25e2-3823-8cae-b7a8826fa16c",
                                        "glosses": [
                                            "Spécialiste des reptiles et des amphibiens, qui étudie l’herpétologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a143ba-b708-474a-a18e-d1bd144f457a",
                                                "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                                "text": "Il obtient, en 1870, un poste non salarié au Senckenberg Museum de Francfort, d’abord comme paléontologue et ensuite comme herpétologue en 1875."
                                            },
                                            {
                                                "example_id": "a02c2701-07e4-4e45-abff-9f9874f0bd17",
                                                "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                                "text": "Une nasse tambour a été placée la veille dans une mare par Maud Berroneau, herpétologue et cheffe de projet à Cistude nature pour capturer la tortue Cistude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c130b77d-90da-427a-86af-87d8da02c9a5",
