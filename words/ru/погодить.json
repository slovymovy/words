{
    "word_family": [
        "годить",
        "погода",
        "погодя",
        "обождать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "323045e9-583a-302d-a665-5a37882242fe",
                    "sense_definition": "Подождать немного, повременить с чем-либо (часто в форме повелительного наклонения).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ожидание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты лучше <w>погоди</w> немного, сейчас на улице сильный дождь.",
                            "target_lang_translations": {
                                "de": "Du solltest lieber ein wenig <w>warten</w>, draußen regnet es gerade stark."
                            }
                        },
                        {
                            "text": "Они решили немного <w>погодить</w> с покупкой новой квартиры до весны.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, mit dem Kauf einer neuen Wohnung noch bis zum Frühjahr <w>abzuwarten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подождать",
                        "повременить"
                    ],
                    "antonyms": [
                        "поспешить"
                    ],
                    "common_phrases": [
                        "погоди немного",
                        "погоди минуту"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein wenig warten, sich etwas Zeit lassen oder mit etwas zögern (oft als Aufforderung verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "warten",
                                "target_lang_sense_clarification": "einen Moment innehalten oder ausharren"
                            },
                            {
                                "target_lang_word": "abwarten",
                                "target_lang_sense_clarification": "noch etwas gedulden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "059c636d-09e4-3c61-a1b2-9d45792a22d6",
                    "sense_definition": "Отложить осуществление или начало какого-либо действия на более поздний срок.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ожидание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С этой сложной поездкой вполне можно было <w>погодить</w> ещё пару недель.",
                            "target_lang_translations": {
                                "de": "Mit dieser anstrengenden Reise hätte man gut noch ein paar Wochen <w>warten</w> können."
                            }
                        },
                        {
                            "text": "Директор посоветовал <w>погодить</w> с увольнением до окончания текущего проекта.",
                            "target_lang_translations": {
                                "de": "Der Direktor riet dazu, mit der Kündigung bis zum Ende des aktuellen Projekts <w>zu warten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "повременить",
                        "подождать"
                    ],
                    "antonyms": [
                        "приступить",
                        "поспешить"
                    ],
                    "common_phrases": [
                        "погодить с решением",
                        "погодить с отъездом"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Handlung oder ein Vorhaben auf einen späteren Zeitpunkt verschieben; zuwarten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abwarten",
                                "target_lang_sense_clarification": "mit einer Handlung oder Entscheidung noch warten"
                            },
                            {
                                "target_lang_word": "aufschieben",
                                "target_lang_sense_clarification": "zeitlich nach hinten verlegen"
                            },
                            {
                                "target_lang_word": "zuwarten",
                                "target_lang_sense_clarification": "eine Weile mit etwas warten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "699b7229-02ac-3097-87e0-fc5803eaf979",
                    "sense_definition": "О наступлении или сохранении плохой, ненастной погоды (в безличном значении).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "погода",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Осенью в этих краях нередко <w>погодит</w>, заряжая долгими холодными дождями.",
                            "target_lang_translations": {
                                "de": "Im Herbst <w>ist das Wetter</w> in dieser Gegend oft <w>ungemütlich</w> und bringt langanhaltende, kalte Regengüsse mit sich."
                            }
                        },
                        {
                            "text": "К вечеру снова сильно <w>погодило</w>, и рыбакам пришлось вернуться на берег.",
                            "target_lang_translations": {
                                "de": "Gegen Abend <w>zog wieder schlechtes Wetter auf</w>, und die Fischer mussten ans Ufer zurückkehren."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "диалектное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Unwetterartig sein; von schlechtem, regnerischem Wetter geprägt sein (unpersönlich, dialektal)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unbeständig sein",
                                "target_lang_sense_clarification": "in Bezug auf regnerisches, schlechtes Wetter"
                            },
                            {
                                "target_lang_word": "schlechtes Wetter sein",
                                "target_lang_sense_clarification": "dauerhaft regnen oder stürmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}