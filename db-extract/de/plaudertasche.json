                "senses": [
                    {
                        "sense_id": "75bc8d58-5f0f-38a3-a48f-1ac0d0c8ae94",
                        "entry_id": "3dcc1d49-0f6b-3a4b-abb0-3fb32ca0715a",
                        "glosses": [
                            "redselige, meist weibliche Person, die gerne plaudert beziehungsweise versehentlich ausplaudert"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cc701442-fd66-4ba2-b722-58d8a913267a",
                                "sense_id": "75bc8d58-5f0f-38a3-a48f-1ac0d0c8ae94",
                                "text": "Meine Tante Josefine ist eine richtige Plaudertasche."
                            },
                            {
                                "example_id": "f8d9ae32-8b91-4825-a214-851a01b4b2a4",
                                "sense_id": "75bc8d58-5f0f-38a3-a48f-1ac0d0c8ae94",
                                "text": "„Eigentlich ist eine Plaudertasche von Natur aus redselig, so dass sie aus Unachtsamkeit oder Navität ein Geheimnis einfach »ausplaudert«. Dass eine Plaudertasche gerade weiblichen Geschlechts ist, dürfte rein zufällig sein.“"
                            },
                            {
                                "example_id": "866bbc00-c672-4f2b-9a46-4159271f1332",
                                "sense_id": "75bc8d58-5f0f-38a3-a48f-1ac0d0c8ae94",
                                "text": "„Zaldivar war als Plaudertasche bekannt, der es gefiel, private Angelegenheiten ziemlich detailliert öffentlich auszubreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b144bbf-9ffa-40f7-ba4d-b97afa3f388b",
