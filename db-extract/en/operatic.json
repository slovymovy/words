                "senses": [
                    {
                        "sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                        "entry_id": "dfae310c-b97d-39bf-ac57-47e06c022aa0",
                        "glosses": [
                            "Of, related to, or typical of opera."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f23edd-8bbe-4034-b919-935f0ada8075",
                                "sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                                "text": "The politician's address was so flamboyant as to be operatic."
                            },
                            {
                                "example_id": "f5e7c7ce-9581-409c-89b6-bbbe629ec050",
                                "sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                                "text": "She had stormed dramatically off and got on the first train she saw at Waterloo station and rode it the whole way down to Brighton, taking a room in a seedy B and B. But then, after a nap, still feeling wobbly and also wallowingly sorry for herself, Diantha climbed off the bed and sat down at the desk to write Charles some operatic note of farewell."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9d58396-cf22-44f0-822c-e273bd51e12a",
                        "source_entry_id": "dfae310c-b97d-39bf-ac57-47e06c022aa0",
                        "source_sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                        "source_sense_description": "of or relating to opera",
                        "target_lang_word": "opératique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opératique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d411bc5d-ef48-3291-8882-4bcc9aaa7a44",
                                        "entry_id": "965313c9-c14e-3bde-a328-2975f717cfb6",
                                        "glosses": [
                                            "Qui concerne, qui est en rapport avec l’opéra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d22e352-d500-416e-8c86-a4a02e25ddcb",
                                                "sense_id": "d411bc5d-ef48-3291-8882-4bcc9aaa7a44",
                                                "text": "En quoi leur vécu stylisé et codé par les normes du genre opératique, leurs émotions transmises par le biais de lois musicales et scéniques, ont-ils le pouvoir de concerner non seulement les générations passées mais aussi celles de demain ?"
                                            },
                                            {
                                                "example_id": "fcc30522-047a-4741-b04b-f13f2cccfbcd",
                                                "sense_id": "d411bc5d-ef48-3291-8882-4bcc9aaa7a44",
                                                "text": "Mais est-ce seulement ce mélange de la vraie nature associée à un arrangement opératique, qui a fait obtenir à Watteau cette victoire ?"
                                            },
                                            {
                                                "example_id": "8643d69b-18d7-40fd-90e3-16fc179837a6",
                                                "sense_id": "d411bc5d-ef48-3291-8882-4bcc9aaa7a44",
                                                "text": "Les demoiselles, très élégantes en robe longue et chaussures de bal, alternent sur scène avec leurs camarades masculins, très chics également, arborant qui un complet sombre et sobre, qui des couleurs plus opératiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opératique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "893c3839-13b6-3c9c-a054-23897dc36a0b",
