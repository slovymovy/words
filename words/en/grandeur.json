{
    "word_family": [
        "grand",
        "grandly",
        "grandness",
        "aggrandize",
        "aggrandizement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd1ee1c0-469b-30b3-9e6b-985e20315fd1",
                    "sense_definition": "The quality of being very beautiful, impressive, and large in scale.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "magnificence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace was restored to its former <w>grandeur</w> after the war.",
                            "target_lang_translations": {
                                "ru": "Дворцу вернули его былое <w>великолепие</w> после войны.",
                                "de": "Nach dem Krieg wurde der Palast in seiner früheren <w>Pracht</w> wiederhergestellt."
                            }
                        },
                        {
                            "text": "The soaring vaults of the cathedral gave the interior an unexpected <w>grandeur</w>.",
                            "target_lang_translations": {
                                "ru": "Высокие своды собора придавали интерьеру неожиданное <w>величие</w>.",
                                "de": "Die emporragenden Gewölbe der Kathedrale verliehen dem Innenraum eine unerwartete <w>Erhabenheit</w>."
                            }
                        },
                        {
                            "text": "We stood in silence, admiring the scenic <w>grandeur</w> of the canyon.",
                            "target_lang_translations": {
                                "ru": "Мы стояли в тишине, любуясь живописным <w>величием</w> каньона.",
                                "de": "Wir standen schweigend da und bewunderten die malerische <w>Größe</w> der Schlucht."
                            }
                        }
                    ],
                    "synonyms": [
                        "magnificence",
                        "splendor",
                        "majesty",
                        "opulence",
                        "glory"
                    ],
                    "antonyms": [
                        "insignificance",
                        "modesty",
                        "simplicity",
                        "ordinariness"
                    ],
                    "common_phrases": [
                        "delusions of grandeur",
                        "scenic grandeur",
                        "faded grandeur",
                        "restore grandeur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впечатляющая красота, масштабность и великолепие.",
                        "de": "Die Eigenschaft, sehr schön, eindrucksvoll und von großem Ausmaß zu sein."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великолепие",
                                "target_lang_sense_clarification": "роскошь, пышная красота"
                            },
                            {
                                "target_lang_word": "величие",
                                "target_lang_sense_clarification": "торжественная красота, мощь"
                            },
                            {
                                "target_lang_word": "величественность",
                                "target_lang_sense_clarification": "впечатляющий внешний вид"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Pracht",
                                "target_lang_sense_clarification": "Glanz, Prunk, prachtvolle Schönheit"
                            },
                            {
                                "target_lang_word": "die Erhabenheit",
                                "target_lang_sense_clarification": "feierliche, ehrfurchtgebietende Größe"
                            },
                            {
                                "target_lang_word": "die Größe",
                                "target_lang_sense_clarification": "imposantes, beeindruckendes Ausmaß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a38a491-dc4b-3902-9c99-d6f3f6a1153b",
                    "sense_definition": "High rank, social importance, or noble character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his poverty, the old man maintained a certain <w>grandeur</w> of manner.",
                            "target_lang_translations": {
                                "ru": "Несмотря на бедность, старик сохранял определенную <w>величественность</w> манер.",
                                "de": "Trotz seiner Armut bewahrte sich der alte Mann eine gewisse <w>Vornehmheit</w> in seinem Auftreten."
                            }
                        },
                        {
                            "text": "She faced her difficult situation with quiet <w>grandeur</w> and dignity.",
                            "target_lang_translations": {
                                "ru": "Она встретила свою тяжелую ситуацию с тихим <w>благородством</w> и достоинством.",
                                "de": "Sie begegnete ihrer schwierigen Situation mit stiller <w>Größe</w> und Würde."
                            }
                        }
                    ],
                    "synonyms": [
                        "nobility",
                        "dignity",
                        "stateliness",
                        "eminence"
                    ],
                    "antonyms": [
                        "baseness",
                        "humbleness"
                    ],
                    "common_phrases": [
                        "moral grandeur",
                        "grandeur of soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое положение, важность или благородство характера.",
                        "de": "Hoher sozialer Rang, gesellschaftliche Bedeutung oder ein edler Charakter."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородство",
                                "target_lang_sense_clarification": "высокие моральные качества"
                            },
                            {
                                "target_lang_word": "знатность",
                                "target_lang_sense_clarification": "высокое происхождение"
                            },
                            {
                                "target_lang_word": "величие",
                                "target_lang_sense_clarification": "достоинство в поведении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "der Edelmut",
                                "target_lang_sense_clarification": "nobler Charakter, seelische Größe"
                            },
                            {
                                "target_lang_word": "die Würde",
                                "target_lang_sense_clarification": "erhabenes Auftreten, Haltung"
                            },
                            {
                                "target_lang_word": "die Vornehmheit",
                                "target_lang_sense_clarification": "hoher Rang oder edle Art"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}