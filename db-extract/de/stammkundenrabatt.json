                        "examples": [
                            {
                                "example_id": "4037d2f7-5575-4906-b4f5-9c338476e4e5",
                                "sense_id": "790f2838-8a26-3e85-87c8-a674e0ca0cd1",
                                "text": "„Um in den Genuss von unserem Stammkundenrabatt zu gelangen, hinterlegen Sie Ihre Adresse in unserer Kartei.“"
                            },
                            {
                                "example_id": "da3a64bd-fdfe-4194-828d-3acd474ab37b",
                                "sense_id": "790f2838-8a26-3e85-87c8-a674e0ca0cd1",
                                "text": "„Bequemlichkeit soll nicht dazu führen, seine Vorlieben preiszugeben. Ein bisschen Geheimnis wiegt mehr als der Stammkundenrabatt.“"
                            }
                        ],
