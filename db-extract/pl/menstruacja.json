                "senses": [
                    {
                        "sense_id": "a04969a5-047f-3ff8-ba0b-7c1389c4673a",
                        "entry_id": "b77efb79-0050-3748-adcb-a85b2637d814",
                        "glosses": [
                            "cykliczne złuszczanie się nabłonka macicy kobiety pod wpływem zmian stężenia hormonów płciowych"
                        ],
                        "tags": [],
