                                "example_id": "44ef8e1b-ca29-4ed0-9615-84e42ea984e2",
                                "sense_id": "808a8ee2-5287-315d-8e91-242f9c9673f5",
                                "text": "„Jedesmal, wenn Flüchtlinge sich trafen, kamen neue Tricks und neue Abwehrmaßnahmen hinzu.“"
                            }
                        ],
