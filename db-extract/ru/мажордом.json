                "senses": [
                    {
                        "sense_id": "6b460d7a-4c46-30c6-918d-0c6e61dca04c",
                        "entry_id": "dad23bcb-4d31-386e-9003-51c1040b5a68",
                        "glosses": [
                            "истор. в эпоху раннего средневековья — министр королевского двора, управитель королевских дворцов, высший придворный и государственный сановник, заведовавший королевской дружиной, доменами и вассалами"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "efa9ea41-1312-3608-b470-003167e14d9b",
                        "entry_id": "dad23bcb-4d31-386e-9003-51c1040b5a68",
                        "glosses": [
                            "домоправитель, старший лакей, дворецкий в богатых барских домах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c981b6-60b0-4253-9118-05c7a5cb9d72",
                                "sense_id": "efa9ea41-1312-3608-b470-003167e14d9b",
                                "text": "Мажордом (по-прежнему ― дворецкий), старый богомольный слуга, обритый и наряженный, как на святках, стукнул тростью и выкрикнул, что приехала боярыня Волкова."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c2c62a9-eff6-4aad-94f3-f24263167f78",
                        "source_entry_id": "dad23bcb-4d31-386e-9003-51c1040b5a68",
                        "target_lang_word": "majordomo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majordomo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "The head servant or official in a royal Spanish or Italian household; later, any head servant in a wealthy household in a foreign country; a leading servant or butler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08989a8b-8ebb-4f3d-b69c-ce26dd613d74",
                                                "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                                "text": "Pancho, the major-domo, came up to say that Colonel Morales was waiting below. Appleby bade him bring out cigars and wine, and rose from his seat when Morales came in."
                                            },
                                            {
                                                "example_id": "841414e2-0492-4876-9f1b-06c1ccd21e00",
                                                "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                                "text": "In return for ruling over the king's palace, serving as the monarch's alter ego in the domestic sphere, and bearing the burden of accountability, the majordomo was compensated amply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84cc8db-6ec1-3bc3-8b39-5d0923b55d96",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "A manager of a hacienda, ranch or estate."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe201bd-f2c3-4ed8-89e2-eb4bbbc44445",
                                                "sense_id": "e84cc8db-6ec1-3bc3-8b39-5d0923b55d96",
                                                "text": "She called upon a Missouri cousin named Edward Hardy Clark, who became the indispensable majordomo of the Hearst estate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52913b5c-0cb0-3e65-9953-3ab3f5510a07",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "Any overseer, organizer, person in command."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c143c62-4389-4bd6-98a5-bec20831b5b3",
                                                "sense_id": "52913b5c-0cb0-3e65-9953-3ab3f5510a07",
                                                "text": "The United Nation's climate majordomo -- tasked with herding 192 nations toward a do-or-die deal by year's end -- does not have the power to impose an agreement on how to curb greenhouse gases and cope with its consequences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
