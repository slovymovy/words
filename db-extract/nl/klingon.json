                                "target_senses": [
                                    {
                                        "sense_id": "af85d46f-37ed-37b7-a4d4-dba2988ac0e9",
                                        "entry_id": "1f6203c4-3c88-3f1f-a7d4-c08b17e290f4",
                                        "glosses": [
                                            "Langue artificielle, supposée parlée par les Klingons, extra-terrestres adversaires des humains dans l’univers de Star Trek."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8beb2d-bc5f-4f9b-a1e1-c83badd6c742",
                                                "sense_id": "af85d46f-37ed-37b7-a4d4-dba2988ac0e9",
                                                "text": "Le klingon a été inventé par le linguiste Marc Okrand pour le film Star Trek III: The Search for Spock, et a été utilisé dans les films et séries télévisées subséquents ; bon nombre d’avides amateurs ont pris la peine de l’apprendre."
                                            },
                                            {
                                                "example_id": "a5480c65-714a-47e3-8e14-6d293c8e31f2",
                                                "sense_id": "af85d46f-37ed-37b7-a4d4-dba2988ac0e9",
                                                "text": "Il lui est aussi arrivé de faire n’importe, quoi, comme –à la demande d’un festival– d’adapter En attendant Godot en klingon, cette langue des cruels extraterrestres dans Star Trek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
