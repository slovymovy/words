                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                        "glosses": [
                            "A narrow area behind a defensive wall's parapet elevated above its terreplein and used by defenders to shoot at attackers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ab4c70e-2e1b-37f0-bddf-c0a610d17cc4",
                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                        "glosses": [
                            "A bench built into a wall, especially (military) one built into a wall of a defensive trench, used for sitting and for shooting at attackers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f1a2871b-7eac-30cd-a4f6-2acae10a2be0",
                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                        "glosses": [
                            "An upholstered bench, e.g., along a wall of a restaurant or lounge area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42cf3388-caa4-464b-a334-891e2879431e",
                                "sense_id": "f1a2871b-7eac-30cd-a4f6-2acae10a2be0",
                                "text": "Stoned, she would traipse in, overtly sexual in last night's dress, and throw herself exhausted across the banquette."
                            }
                        ]
                    },
                    {
                        "sense_id": "77d9cb94-e379-3b8a-8ead-86f048bece66",
                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                        "glosses": [
                            "A bench or similar seat on top of a diligence or other public vehicle."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "39ca0a8b-31e9-4d2d-8dfb-46cd64782c3b",
                                "sense_id": "77d9cb94-e379-3b8a-8ead-86f048bece66",
                                "text": "My brother-in-law […] took refuge in the banquette."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                        "glosses": [
                            "A sidewalk."
                        ],
                        "tags": [
                            "Louisiana",
                            "Texas"
                        ],
                        "examples": [
                            {
                                "example_id": "2d10b647-2bca-4752-9f4f-14cb0d980c9f",
                                "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                                "text": "The boys were dragging along the banquette a small “express wagon,” which they had filled with blocks and sticks."
                            },
                            {
                                "example_id": "2a1cd5d0-2412-4175-84e9-3b8546269bda",
                                "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                                "text": "“Get the hell away from that stove, Charmaine, and go play out on the banquette before I bust you right in the mouth.”"
                            }
                        ]
                    }
                ],
