                                        "glosses": [
                                            "kleines/kurzes Lied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d75aa82-5e6d-46e2-831a-24645c9c19c7",
                                                "sense_id": "ed2d29bb-1a1b-33e4-825d-879b8b9c6c39",
                                                "text": "„Das Liedchen, das er pfiff, sein Gang, die Geste, mit der er sich den Schnurrbart zwirbelte, alles das empfand Pierre jetzt als Beleidigung.“"
                                            },
                                            {
                                                "example_id": "a108cc36-9c22-41d0-aa03-1605bb07f4f8",
                                                "sense_id": "ed2d29bb-1a1b-33e4-825d-879b8b9c6c39",
                                                "text": "„Gar einfach und fein kam das Liedchen aus seiner Fratze heraus, aus seinem verqueren Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
