                        "entry_id": "bd553806-b2b1-319f-8924-d5dac0e3b829",
                        "glosses": [
                            "A narrow, tightly-coiled tube connecting the efferent ducts from the rear of each testicle to its vas deferens, where sperm are stored during maturation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0ef9b5f-1bd1-40d7-a5d5-a5bd796292db",
                                "sense_id": "3dfac79d-8090-32b6-b361-1b79390c4c97",
                                "text": "Most men, I daresay, have never heard of their epididymis."
                            }
                        ]
                    }
