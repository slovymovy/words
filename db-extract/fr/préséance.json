                                        "sense_id": "fb76d0e3-e281-3087-80b5-b458d1b90099",
                                        "entry_id": "ff30146c-64bd-3358-9855-e42ea27b28a4",
                                        "glosses": [
                                            "een rangschikking naar belangrijkheid, een zaak gerangschikt naar zijn ingeschat belang"
