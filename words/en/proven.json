                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new system has <w>proven</w> to be much faster than the old one.",
                            "target_lang_translations": {
                                "ru": "Новая система <w>оказалась</w> намного быстрее старой.",
                                "zh": "新系统<w>被证实</w>比旧系统快得多。",
                                "es": "El nuevo sistema ha <w>resultado</w> ser mucho más rápido que el anterior."
                            }
                        },
                        {
                            "text": "She had <w>proven</w> her loyalty to the company over many years.",
                            "target_lang_translations": {
                                "ru": "Она <w>доказала</w> свою преданность компании за многие годы.",
                                "zh": "多年来，她已经<w>证明</w>了她对公司的忠诚。",
                                "es": "Ella había <w>probado</w> su lealtad a la empresa durante muchos años."
                            }
                        }
                    ],
