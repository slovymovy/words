                                        "glosses": [
                                            "Rompre, abattre le mât, les mâts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1437356f-82f2-4ae9-a741-7d3d94e156ac",
                                                "sense_id": "20d58319-dab5-31da-92d4-ca87cbbc47b0",
                                                "text": "Démâter un vaisseau à coups de canon."
                                            },
                                            {
                                                "example_id": "ab1e2866-d025-4398-b98a-b2bb70e6fede",
                                                "sense_id": "20d58319-dab5-31da-92d4-ca87cbbc47b0",
                                                "text": "Tirer à démâter."
                                            },
                                            {
                                                "example_id": "7d0fa88c-e63d-450e-ae77-e431e60e44a8",
                                                "sense_id": "20d58319-dab5-31da-92d4-ca87cbbc47b0",
                                                "text": "C’est la tempête, le vent qui a démâté ce bateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f675c4-69ae-3b4e-9889-1a9efebe05a4",
                                        "entry_id": "97f4d3db-28c0-3b26-a06e-37f025d0e8ae",
                                        "glosses": [
                                            "Se dit d’un bâtiment qui est démâté par la tempête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b16f01-8751-47e5-a483-e483a5fe6b23",
                                                "sense_id": "18f675c4-69ae-3b4e-9889-1a9efebe05a4",
                                                "text": "Ce vaisseau a démâté du mât de misaine, de ses mâts de hune."
                                            },
                                            {
                                                "example_id": "62ed4d67-5b4b-4708-841c-95d8c56c503f",
                                                "sense_id": "18f675c4-69ae-3b4e-9889-1a9efebe05a4",
                                                "text": "Il a démâté de tous ses mâts."
                                            },
                                            {
                                                "example_id": "f9982296-b49e-46a8-9d23-f7870fb3289b",
                                                "sense_id": "18f675c4-69ae-3b4e-9889-1a9efebe05a4",
                                                "text": "Il régnait dans la rue principale un chaos indescriptible. Deux voiliers, dont l'un avait démâté, s'y étaient engouffrés, propulsés par l'océan avant de s'encastrer entre les trottoirs et les véhicules abandonnés sur place, immergés aux trois quarts."
                                            }
                                        ]
                                    }
