                        "sense_id": "d4162ecb-7ea9-31bb-bfc3-a66de0ee5ce1",
                        "entry_id": "a1498f5a-1b36-3ea8-b801-958d2652bc65",
                        "glosses": [
                            "meekly, docilely"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92f357e0-0c02-4229-a23e-34b790623d68",
                                "sense_id": "d4162ecb-7ea9-31bb-bfc3-a66de0ee5ce1",
                                "text": "I często ten, który wszedł arogancko, szorstko[,] i śmiało, okazuje się skromnym, miłym[,] i potulnym człowiekiem, inny zaś, zaprezentowany skromnie i potulnie — szorstkim arogantem.",
                                "translation": "And often the one, who entered arrogantly, roughly[,] and boldly, turns out to be a modest, kind[,] and docile human, while another, presented modestly and docilely — a coarse arrogant.",
                                "english": "And often the one, who entered arrogantly, roughly[,] and boldly, turns out to be a modest, kind[,] and docile human, while another, presented modestly and docilely — a coarse arrogant."
                            },
                            {
                                "example_id": "4723f73d-60d8-461f-a2e1-de37deb68a40",
                                "sense_id": "d4162ecb-7ea9-31bb-bfc3-a66de0ee5ce1",
                                "text": "Zamiast obrazić się, wzruszyła ramionami i odrzekła potulnie: — Czemu pan tak na mnie krzyczy?",
                                "translation": "Instead of taking offence, she shrugged her shoulders and replied meekly: — Why are you shouting at me like that?",
                                "english": "Instead of taking offence, she shrugged her shoulders and replied meekly: — Why are you shouting at me like that?"
                            },
                            {
                                "example_id": "32cfcaee-6989-443b-8829-8ba6239a2898",
                                "sense_id": "d4162ecb-7ea9-31bb-bfc3-a66de0ee5ce1",
                                "text": "Żadna z nas nie umiała połykać proszków[…], więc tabletki rozkruszano i rozpuszczano w wodzie, a my potulnie piłyśmy to rzadkie świństwo z naszych wytwornych, ciemnozielonych kieliszków.",
                                "translation": "None of us knew how to swallow powders […], so the tablets were crushed and dissolved in water, and we meekly drank this distilled pigment from our refined, dark green glasses.",
                                "english": "None of us knew how to swallow powders […], so the tablets were crushed and dissolved in water, and we meekly drank this distilled pigment from our refined, dark green glasses."
                            }
                        ]
                    }
