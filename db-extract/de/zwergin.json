                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b834bb0b-8daf-3a3f-8ee1-3e9124927793",
                                        "entry_id": "9300bee6-c3c9-3ff4-bdf4-897306fe1383",
                                        "glosses": [
                                            "Créature mythologique de même aspect qu’une femme, mais de taille plus petite."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
