                "senses": [
                    {
                        "sense_id": "a05463c9-cb9c-3109-bac3-d42eefa043db",
                        "entry_id": "3f52c137-20dc-371e-adf0-caf96c957165",
                        "glosses": [
                            "Qui est de forme convexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24f4ba3-017d-48ea-b9fa-4367d30d1908",
                                "sense_id": "a05463c9-cb9c-3109-bac3-d42eefa043db",
                                "text": "Le premier était un assez beau mâle de quelque vingt ans, blond, haut en couleur, ayant poitrine bombée, casquette sur l’oreille, talons hauts et gilet jusqu’aux genoux ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "a3784093-b677-3a85-b7ef-1eebac5d7a7a",
                        "entry_id": "3f52c137-20dc-371e-adf0-caf96c957165",
                        "glosses": [
                            "Dont la posture est modifiée, révélant une fierté, une arrogance, une suffisance."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4d474883-fd5d-4057-b934-b6a7ce9f2f90",
                                "sense_id": "a3784093-b677-3a85-b7ef-1eebac5d7a7a",
                                "text": "Le ministre, bombé d’arrogance, a soutenu hier que la commissaire a déclenché une enquête parce qu’elle « doit répondre au Journal de Montréal »."
                            }
                        ]
                    }
                ],
                "translations": [
