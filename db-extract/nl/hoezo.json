                "senses": [
                    {
                        "sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                        "entry_id": "5d57c408-4d5c-3d55-97d7-fe848e2889f4",
                        "glosses": [
                            "vraagt naar de logica achter een bepaalde bewering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1154fca-c20b-4458-ab3e-5b6fb92758db",
                                "sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                                "text": "Hoezo? Dat is toch niet verboden?"
                            },
                            {
                                "example_id": "2ad7906d-5de2-414c-bd12-8a00a89650a0",
                                "sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                                "text": "Hoezo? Is er iets mee?' Ze liet haar duim over de hals glijden, een schone veeg door het stof."
                            },
                            {
                                "example_id": "ea07bed6-3806-45b1-a5aa-d6ea60a74588",
                                "sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                                "text": "'Hoezo?' 'Nee, mijn moeder vond het natuurlijk niet nodig om je dat te vertellen."
                            },
                            {
                                "example_id": "e7001a4d-b1bf-4379-9fbd-64588674da7c",
                                "sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                                "text": "' 'Op Sicilië? Hoezo?' 'Een vriendin in crisis bijstaan,' zeg ik met mijn hand om het toestel zodat Lot me niet kan horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b80f46d-567b-4c69-b76e-81e0eaa0edf9",
                        "source_entry_id": "5d57c408-4d5c-3d55-97d7-fe848e2889f4",
                        "source_sense_id": "0bd5b1dd-504f-38ff-9897-dbc5edea1181",
                        "source_sense_description": "vraagt naar de logica achter een bepaalde bewering",
                        "target_lang_word": "wieso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wieso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet eine indirekte Frage nach dem Grund ein"
                                        ],
                                        "tags": [
                                            "Interrogativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5073f7f-c3eb-4728-8ea0-5a9b645f82b6",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "Er fragte sie, wieso sie ihn geschlagen habe."
                                            },
                                            {
                                                "example_id": "25c5585f-ca2e-4aa4-b11d-93c18faa1a06",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "Sie wollte wissen, wieso er ihr gegenüber immer so aufbrausend sei."
                                            },
                                            {
                                                "example_id": "58f7368f-068f-4454-bc93-2585fce2a88c",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "„Ich frage Leute auf der Straße, in der U-Bahn, im Büro, alle woll'n Computer haben, keiner weiß genau wieso.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet eine direkte Frage nach dem Grund ein"
                                        ],
                                        "tags": [
                                            "Interrogativadverb",
                                            "mit zweifelnder",
                                            "erstaunter Nuance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c3047f-30bc-43b8-b4c0-9783d7f03459",
                                                "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                                "text": "„Wieso sollte ich aufhören, wenn ich mich in guter Verfassung befinde?“"
                                            },
                                            {
                                                "example_id": "410ba2ab-d3bb-4198-96a5-a66d581de687",
                                                "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                                "text": "„Wieso ist er so schnell abgereist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet einen Nebensatz ein, der einen Grund für etwas angibt"
                                        ],
                                        "tags": [
                                            "Relativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da77f44-a668-4a95-9567-19e3ec53130c",
                                                "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                                "text": "Die Frage, wieso das passieren konnte, steht immer noch unbeantwortet im Raum."
                                            },
                                            {
                                                "example_id": "a03a9e9a-b944-45a6-9c99-13ef60b15257",
                                                "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                                "text": "Der Gedanke, wieso sie so spät gekommen war, ging ihm nicht mehr aus dem Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2e01e187-ec70-3c60-836e-59079349f6e2",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "wie kommst du darauf?"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf3952b-9196-49d0-a6b8-810a7ef89c13",
                                                "sense_id": "2e01e187-ec70-3c60-836e-59079349f6e2",
                                                "text": "„Bist du sauer?“ - „Wieso?“"
                                            }
