                                        "glosses": [
                                            "Of, from, or pertaining to Chad, a country in Africa."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b2c0fd-6c04-48a8-9227-62e56b11bd71",
                                                "sense_id": "c6be37c0-3ed8-3893-844e-8f924fa83c84",
                                                "text": "Cameroonian and Chadian soldiers stationed there managed to kill 150 invaders. Among them was the son of Ahmadou Moustafa, a Fotokol resident."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
