                            {
                                "example_id": "92689d52-7de2-4c03-9ee4-37186bef162c",
                                "sense_id": "eb406819-93fc-3ed8-9f2b-9fc552ec5eab",
                                "text": "„Er schloss die Augen für einen Moment, nahm dann den Eisschaber aus dem Wagen, kratzte vorne und hinten ein Guckloch frei und setzte sich in den kalten Wagen.“"
                            },
                            {
                                "example_id": "a0a26f11-d506-42a4-b62c-dc044f89767b",
                                "sense_id": "eb406819-93fc-3ed8-9f2b-9fc552ec5eab",
                                "text": "„In den Fächern der Innentüren befanden sich ein Eisschaber, eine Parkuhr und ein Schwämmchen zum Säubern der Scheibe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
