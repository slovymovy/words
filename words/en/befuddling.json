                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confusing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest political <w>befuddlings</w> left the commentators at a total loss for words.",
