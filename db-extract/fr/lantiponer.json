                ],
                "senses": [
                    {
                        "sense_id": "48b2e231-23c6-373d-b853-78035602b0fe",
                        "entry_id": "eb09afe2-9d01-38e3-8212-15a230a78af7",
                        "glosses": [
                            "Autre orthographe de lantiponner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6fc098c-a6cb-4fa6-a430-4f9843a5bd03",
                                "sense_id": "48b2e231-23c6-373d-b853-78035602b0fe",
                                "text": "À quoi bon tant lantiponer ?"
                            },
                            {
                                "example_id": "218abc55-3da2-4c5b-9a6a-f505f12cd20d",
                                "sense_id": "48b2e231-23c6-373d-b853-78035602b0fe",
                                "text": "On discute à perte de vue, on se gourme un peu les uns les autres. Au total on lantipone.\n Pourtant tout cela presse, car il y va de la santé de tout le pays."
                            },
                            {
                                "example_id": "25998648-7025-4700-9541-57d7dd353f91",
                                "sense_id": "48b2e231-23c6-373d-b853-78035602b0fe",
                                "text": "Dis-moi donc sans plus lantiponer où, quand, sous quelle forme, à quelles conditions je pourrai rencontrer Sa Grâce Lucifer."
                            },
                            {
                                "example_id": "3eb9e363-a8e8-4e75-adc9-0c1a6cea002c",
                                "sense_id": "48b2e231-23c6-373d-b853-78035602b0fe",
                                "text": "Bien acagnardé contre le zinc à pampres de son estaminet de prédilection, Antonin lantiponait à foison parmi des norias de pieds nickelés en mouillage. Il retrouvait en ces lieux surchauffés des gens de toutes conditions, de toutes extractions […]."
                            }
                        ]
                    }
                ],
