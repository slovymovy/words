            {
                "entry_id": "194b58d0-c98f-3960-9c16-7cdc26e495d6",
                "word": "FAR",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbdbba9d-384c-3efb-ac4a-c3820eb48d63",
                        "entry_id": "194b58d0-c98f-3960-9c16-7cdc26e495d6",
                        "glosses": [
                            "Association française qui s’est donnée la mission de collecter, numériser et valoriser les archives audiovisuelles privées du département de la Charente-Maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d94ff9-a5d0-4597-a4a8-2802bda9f6c9",
                                "sense_id": "dbdbba9d-384c-3efb-ac4a-c3820eb48d63",
                                "text": "Il a aussi réalisé la musique de la pub que la librairie Bulles en cavale projette au cinéma. Ou encore mis en musique des archives de particuliers pour le compte du Fonds audiovisuel de recherches (FAR)."
                            },
                            {
                                "example_id": "d14611dd-7e82-4d94-9b2d-3b6db5915430",
                                "sense_id": "dbdbba9d-384c-3efb-ac4a-c3820eb48d63",
                                "text": "C’est un ouf de soulagement que pousse Claude Guillot, le président du FAR (Fonds audiovisuel de recherche) de La Rochelle."
                            },
                            {
                                "example_id": "44bd2ad6-d43b-4d22-aabd-4a6af23a2314",
                                "sense_id": "dbdbba9d-384c-3efb-ac4a-c3820eb48d63",
                                "text": "Le lundi 12 décembre, Le FAR (fonds audiovisuel de recherche) est venu au lycée pour plusieurs interventions liées au pré-cinéma et au trucage."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
