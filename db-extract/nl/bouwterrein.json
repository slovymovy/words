                                "sense_id": "b5633c8d-03d4-3c9d-b93d-2a89de9ac32e",
                                "text": "Het bouwterrein was afgezet met hekken.",
                                "translation": "The building site was cordoned off with fences.",
                                "english": "The building site was cordoned off with fences."
                            },
                            {
