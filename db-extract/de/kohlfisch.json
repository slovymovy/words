                        "cross_references": [
                            {
                                "target_word": "lieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f45757c6-ba79-3f7b-a011-92fb0d301996",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Portion de l’espace, soit prise en elle-même, soit considérée par rapport à ce qui l’occupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5503a42f-6c88-4742-96a6-8d473d76f20f",
                                                "sense_id": "f45757c6-ba79-3f7b-a011-92fb0d301996",
                                                "text": "D’après une étude réalisée en Côte d’Ivoire, dans les lieux où les éléphants avaient disparu depuis longtemps on ne trouvait plus de plants de certaines espèces forestières qu’ils ont coutume de disséminer (Alexandre, 1978)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b214cba-7784-3f11-a26d-4e2331cf5b3c",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Il se dit aussi par rapport à la destination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4eb971c-966c-46c9-9b49-4f1993240ead",
                                                "sense_id": "9b214cba-7784-3f11-a26d-4e2331cf5b3c",
                                                "text": "Le criminel était arrivé au lieu du supplice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2575e7df-b44d-34c8-b8aa-4b85d69e4500",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Endroit désigné ou indiqué."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c83f1ab-fad0-41eb-ac99-fb1b9a865cf2",
                                                "sense_id": "2575e7df-b44d-34c8-b8aa-4b85d69e4500",
                                                "text": "Sale et productif comme le commerce, ce passage, toujours plein d’allants et de venants, de charrettes, de haquets, est d’un aspect repoussant, et la population qui y grouille est en harmonie avec les choses et les lieux."
                                            },
                                            {
                                                "example_id": "df72d0f8-2f1e-4043-a410-1b5a5bb622a9",
                                                "sense_id": "2575e7df-b44d-34c8-b8aa-4b85d69e4500",
                                                "text": "Les juges ordonnèrent une descente sur les lieux."
                                            },
                                            {
                                                "example_id": "382771ca-6eae-4aaf-8a95-b211723de00b",
                                                "sense_id": "2575e7df-b44d-34c8-b8aa-4b85d69e4500",
                                                "text": "Une descente de lieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0411a3-3745-3a38-a401-5e735fe6cf5a",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Appartement ; différentes pièces d’un bien immobilier."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a48818a-37ed-4e5d-ab97-a009e41afc93",
                                                "sense_id": "1b0411a3-3745-3a38-a401-5e735fe6cf5a",
                                                "text": "Il faut visiter les lieux et voir s’ils sont en état."
                                            },
                                            {
                                                "example_id": "583257ea-97de-4a4f-85d1-e174e962f5e4",
                                                "sense_id": "1b0411a3-3745-3a38-a401-5e735fe6cf5a",
                                                "text": "État des lieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a35ef3-4043-3aff-a120-ade971e7d822",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "(Au pluriel) Lieu d’aisance, latrines."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11c8779-1554-4816-82d5-89c4bdac86a2",
                                                "sense_id": "66a35ef3-4043-3aff-a120-ade971e7d822",
                                                "text": "Les prisonniers ne pouvaient même plus s’isoler aux lieux, depuis qu’un haut fonctionnaire de la Sécurité sociale s’y était pendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c641707-4472-376a-b1fc-50fda374748e",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Objet d’étude de la topologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "569f36d5-30e6-428a-a3c4-d9646c1ee019",
                                                "sense_id": "9c641707-4472-376a-b1fc-50fda374748e",
                                                "text": "Lieu géométrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d433b1c-82ed-36e6-a3fa-6d8c4b9c25ab",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Objet d’étude de la topographie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a339b44-1d65-3296-83df-6cbdc9cf40b4",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Point du ciel auquel répond une planète, une comète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf10adaa-6762-4f8a-aeba-6a997659f3d1",
                                                "sense_id": "4a339b44-1d65-3296-83df-6cbdc9cf40b4",
                                                "text": "La ligne du vrai lieu et la ligne du lieu apparent sont différentes, elles forment entr’elles un angle qu’on appelle parallaxe."
                                            },
                                            {
                                                "example_id": "b57c0715-e966-4c4f-a3cd-a70f638eee73",
                                                "sense_id": "4a339b44-1d65-3296-83df-6cbdc9cf40b4",
                                                "text": "Lieu astronomique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720a1dad-5594-3344-b7ed-5a880454412a",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Place, rang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c093b2-ac49-49d3-8411-d551ee575359",
                                                "sense_id": "720a1dad-5594-3344-b7ed-5a880454412a",
                                                "text": "Il tient le premier lieu."
                                            },
                                            {
                                                "example_id": "6bf5bfc1-550b-4543-bc98-f34a3efffc86",
                                                "sense_id": "720a1dad-5594-3344-b7ed-5a880454412a",
                                                "text": "Il faut que chaque chose y soit en son lieu, Il faut que chaque chose soit à la place qui lui convient."
                                            },
                                            {
                                                "example_id": "cc5b4330-a753-417f-8cb0-9a53e0e28e68",
                                                "sense_id": "720a1dad-5594-3344-b7ed-5a880454412a",
                                                "text": "Chaque créancier viendra en son lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba84068e-658d-39e3-b163-4f63da51f3a8",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Place, rang.",
                                            "En termes de Procédure, Être au lieu et place de quelqu’un, avoir la cession de ses droits et actions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8c48478-1a8b-378a-b6f8-37df3a74ca7d",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Maison ou famille, comme dans ces phrases :"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "112e9a6e-1137-4022-8ed4-4664ed731c03",
                                                "sense_id": "e8c48478-1a8b-378a-b6f8-37df3a74ca7d",
                                                "text": "Cette personne est de bon lieu, elle est de bonne famille."
                                            },
                                            {
                                                "example_id": "3f722311-1813-4b60-bc7a-3142524fc54c",
                                                "sense_id": "e8c48478-1a8b-378a-b6f8-37df3a74ca7d",
                                                "text": "Il s’est allié en bon lieu, il s’est bien allié."
                                            },
                                            {
                                                "example_id": "7975929b-7a65-4284-bff1-54e4508c0882",
                                                "sense_id": "e8c48478-1a8b-378a-b6f8-37df3a74ca7d",
                                                "text": "Il sent le lieu d’où il vient, il a les habitudes, les goûts des gens de sa classe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce8d35e-128b-33d0-aab8-cf6f6e6ffb6a",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Endroit, temps convenable pour dire, pour faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b040d24-ff74-49d9-81ff-8c4683c5fc2b",
                                                "sense_id": "bce8d35e-128b-33d0-aab8-cf6f6e6ffb6a",
                                                "text": "Ce n’est pas ici le lieu de parler de cela, le lieu de disputer."
                                            },
                                            {
                                                "example_id": "103799cf-a07d-401f-bfdd-5738261a7201",
                                                "sense_id": "bce8d35e-128b-33d0-aab8-cf6f6e6ffb6a",
                                                "text": "J’ai parlé de ce fait en son lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254083d7-c186-32dc-9798-ed1e1c188cda",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Moyen, sujet, occasion. → voir avoir lieu et avoir lieu de"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fcf692-277f-46e5-bc3d-32c628e75bbc",
                                                "sense_id": "254083d7-c186-32dc-9798-ed1e1c188cda",
                                                "text": "Il n’y a pas lieu de douter, de craindre, d’espérer."
                                            },
                                            {
                                                "example_id": "18b1b0f3-fccf-48f9-87d0-cfb12f1f9150",
                                                "sense_id": "254083d7-c186-32dc-9798-ed1e1c188cda",
                                                "text": "Je vous avertirai, s’il y a lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a8b2a8-7760-3b6e-855a-480b0b4ed3e5",
                                        "entry_id": "bbafe2a0-f1b6-3e32-b17e-6ad542235acb",
                                        "glosses": [
                                            "Passage d’un livre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402fa34c-5203-4c8e-ba1e-151db1c9fa19",
                                                "sense_id": "41a8b2a8-7760-3b6e-855a-480b0b4ed3e5",
                                                "text": "En quel lieu Platon l’a-t-il dit ?"
                                            },
                                            {
                                                "example_id": "813b6592-e55f-4e70-b499-c1fa276d2d69",
                                                "sense_id": "41a8b2a8-7760-3b6e-855a-480b0b4ed3e5",
                                                "text": "Aristote dit dans plus d’un lieu…"
                                            }
                                        ]
                                    }
                                ]
                            },
