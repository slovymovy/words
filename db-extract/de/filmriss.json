                                "target_senses": [
                                    {
                                        "sense_id": "47cbf7b1-e58f-3e8c-8b03-45a85fb88422",
                                        "entry_id": "a835443d-fc92-35f3-b885-3b8e39b4323f",
                                        "glosses": [
                                            "Panne généralisée, coupure de courant électrique à grande échelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65c3309-6ad2-4337-91bd-6629c87147bc",
                                                "sense_id": "47cbf7b1-e58f-3e8c-8b03-45a85fb88422",
                                                "text": "Le 4 novembre 2006, suite à un incident survenu dans le Nord de l’Allemagne, le réseau électrique européen est divisé en trois zones déconnectées les unes des autres. Ces zones subissent des déséquilibres entre la production et la consommation très différents. Le bon déroulement des procédures de sauvegarde a permis aux gestionnaires de réseau d’éviter un blackout à l’échelle européenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57a4a112-6fd5-32b9-a68f-4661f65ce365",
                                        "entry_id": "a835443d-fc92-35f3-b885-3b8e39b4323f",
                                        "glosses": [
                                            "En temps de guerre, réduction de l’éclairage ou silence imposé pour protéger un lieu d’une attaque ennemie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92738723-a6f3-4aba-a575-68e84e72baf8",
                                                "sense_id": "57a4a112-6fd5-32b9-a68f-4661f65ce365",
                                                "text": "Imposer le blackout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3a3f9a-67b9-3ea4-885f-db1ae372a02c",
                                        "entry_id": "a835443d-fc92-35f3-b885-3b8e39b4323f",
                                        "glosses": [
                                            "Perte momentanée de mémoire ou de conscience après avoir consommé un produit psychotrope, alcool ou drogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77694441-41ba-440b-b12f-8bd4dc5c6ee3",
                                                "sense_id": "0b3a3f9a-67b9-3ea4-885f-db1ae372a02c",
                                                "text": "Ce genre de consommation d’alcool se solde souvent par un blackout massif. Ah non, ça me concerne pas, je me biture souvent le week end mais je connais mes limites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e41fe02-691b-3173-9b3b-7d5ebf0837e7",
                                        "entry_id": "a835443d-fc92-35f3-b885-3b8e39b4323f",
                                        "glosses": [
                                            "Silence médiatique sur un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10147e7-f4a6-4e54-a4a1-daf71adb4180",
                                                "sense_id": "0e41fe02-691b-3173-9b3b-7d5ebf0837e7",
                                                "text": "Pourquoi le blackout sur les arrangements du web citoyen ? Qui doit être maintenu dans l’ignorance et pourquoi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4413b80-7b1e-3e7b-a6ac-2fb1246f02b5",
                                        "entry_id": "a835443d-fc92-35f3-b885-3b8e39b4323f",
                                        "glosses": [
                                            "Voile noir."
                                        ],
