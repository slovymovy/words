                        "entry_id": "18a48975-d96f-341b-8deb-c45c8018c275",
                        "glosses": [
                            "Membre d’un groupe de rock ou artiste qui joue du rock."
                        ],
                        "tags": [
                            "Rock"
                        ],
                        "note": "Ce terme implique une notion de célébrité",
                        "examples": [
                            {
                                "example_id": "df7423ce-a00c-4926-a169-3f9340d9fc82",
                                "sense_id": "8adbab24-9518-3f98-afd3-a3ca1a31df72",
                                "text": "Le contexte: après Born To Run, bombardé rockstar, Bruce prend son temps."
                            },
                            {
                                "example_id": "3979ac97-4a87-48c0-a937-39cab71d4e26",
                                "sense_id": "8adbab24-9518-3f98-afd3-a3ca1a31df72",
                                "text": "La rockstar la bouffe du regard un moment puis l’attrape par la taille et se colle derrière elle pour suivre ses mouvements langoureux. Ils finissent par s'embrasser passionnément, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20c03689-8110-4acc-8aaf-6225eba9239a",
                        "source_entry_id": "18a48975-d96f-341b-8deb-c45c8018c275",
                        "source_sense_id": "8adbab24-9518-3f98-afd3-a3ca1a31df72",
                        "target_lang_word": "rockstar",
