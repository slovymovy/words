                                "sense_id": "e348e881-e3ae-3c5c-b2f1-963715a94e91",
                                "text": "Er zijn beperkingen op de invoer van alcoholische dranken.",
                                "translation": "There are restrictions on the import of alcoholic beverages.",
                                "english": "There are restrictions on the import of alcoholic beverages."
                            },
                            {
                                "example_id": "78cadfa6-1020-430c-92d4-0ed09c2daefc",
                                "sense_id": "e348e881-e3ae-3c5c-b2f1-963715a94e91",
                                "text": "De stad profiteert van de invoer van exotisch fruit.",
                                "translation": "The city benefits from the import of exotic fruits.",
                                "english": "The city benefits from the import of exotic fruits."
                            },
                            {
                                "example_id": "ff404948-753b-4d72-994b-058c854ed254",
                                "sense_id": "e348e881-e3ae-3c5c-b2f1-963715a94e91",
                                "text": "De invoer van buitenlandse goederen is de laatste jaren gestegen.",
                                "translation": "The import of foreign goods has increased in recent years.",
                                "english": "The import of foreign goods has increased in recent years."
                            }
