                ],
                "senses": [
                    {
                        "sense_id": "70c843c2-b0f6-383f-ab55-a1a8047ef8cf",
                        "entry_id": "b6487f5d-3ea1-377a-8970-16535c465f6d",
                        "glosses": [
                            "onderkomen voor (meerdere) honden (of katten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4bb56a9-5300-4ba0-b6c4-3d5a61570197",
                                "sense_id": "70c843c2-b0f6-383f-ab55-a1a8047ef8cf",
                                "text": "- „Als ik niet meer leef word ik eerst hier beneden opgebaard, zodat de katten dicht bij me kunnen zijn. Daarna gaan de katten mee naar de begrafenis; in hun kennels staan ze dan rond mijn kist. Maar ik word honderd hoor.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdc53157-133a-49e6-8d4a-74421daac802",
                        "source_entry_id": "b6487f5d-3ea1-377a-8970-16535c465f6d",
                        "source_sense_id": "70c843c2-b0f6-383f-ab55-a1a8047ef8cf",
                        "target_lang_word": "dog-kennel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "214cd58e-e4a8-4a3a-b967-50d212119883",
                        "source_entry_id": "b6487f5d-3ea1-377a-8970-16535c465f6d",
                        "source_sense_id": "70c843c2-b0f6-383f-ab55-a1a8047ef8cf",
                        "target_lang_word": "kennel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kennel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24baf222-5962-39ee-a073-fead041986d1",
                                        "entry_id": "66473562-4591-3906-a74d-f012b4648d04",
                                        "glosses": [
                                            "A house or shelter for a dog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784c95a3-5f50-4398-b742-9fd8bc9a71e8",
                                                "sense_id": "24baf222-5962-39ee-a073-fead041986d1",
                                                "text": "– We want to look at the dog kennels.\n– That's the pet department, second floor."
                                            },
                                            {
                                                "example_id": "89221967-342e-440d-8708-3169f61abc00",
                                                "sense_id": "24baf222-5962-39ee-a073-fead041986d1",
                                                "text": "A fals double tunge is more fiers and fell\nThen Cerberus the cur couching in the kenel of hel;\nWherof hereafter, I thinke for to write,\nOf fals double tunges in the diſpite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349ecd0e-7c89-351d-be49-8ff81e88d84d",
                                        "entry_id": "66473562-4591-3906-a74d-f012b4648d04",
                                        "glosses": [
                                            "A facility at which dogs are reared or boarded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733fdcfe-eff0-4fcd-9345-1a5b2ef5deb7",
                                                "sense_id": "349ecd0e-7c89-351d-be49-8ff81e88d84d",
                                                "text": "The town dog-catcher operates the kennel for strays."
                                            },
                                            {
                                                "example_id": "e12484c3-f1d3-46f1-8ba9-6dcd90ed3597",
                                                "sense_id": "349ecd0e-7c89-351d-be49-8ff81e88d84d",
                                                "text": "She raises registered Dalmatians at her kennel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96204e0f-2956-3bbb-b6ce-5a4ade8fca97",
                                        "entry_id": "66473562-4591-3906-a74d-f012b4648d04",
                                        "glosses": [
                                            "The dogs kept at such a facility; a pack of hounds."
                                        ],
                                        "tags": [
                                            "UK",
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd73a80a-961a-4511-963c-35a879826300",
                                                "sense_id": "96204e0f-2956-3bbb-b6ce-5a4ade8fca97",
                                                "text": "A little herd of England's timorous deer, / Mazed with a yelping kennel of French curs!"
                                            },
                                            {
                                                "example_id": "e6e671e5-a168-4876-b0d5-d00c2742b696",
                                                "sense_id": "96204e0f-2956-3bbb-b6ce-5a4ade8fca97",
                                                "text": "A world of mere Patent-Digesters will soon have nothing to digest: such world ends, and by Law of Nature must end, in ‘over-population;’ in howling universal famine, ‘impossibility,’ and suicidal madness, as of endless dog-kennels run rabid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a8b8b19-7130-3dc6-af41-51b54eb66145",
                                        "entry_id": "66473562-4591-3906-a74d-f012b4648d04",
                                        "glosses": [
                                            "The hole of a fox or other animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kennel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f98dc4-3bdf-31b2-be0c-e6c7ac5e0ce5",
                                        "entry_id": "a5c0bb3e-d092-3bb6-919a-9f36316c7e9f",
                                        "glosses": [
                                            "To house or board a dog (or less commonly another animal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8195343d-b784-4936-ae42-3ebf4f642a7b",
                                                "sense_id": "f0f98dc4-3bdf-31b2-be0c-e6c7ac5e0ce5",
                                                "text": "While we're away our friends will kennel our pet poodle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35fbce72-2901-3e0a-9b96-ef20d3ea5444",
                                        "entry_id": "a5c0bb3e-d092-3bb6-919a-9f36316c7e9f",
                                        "glosses": [
                                            "To lie or lodge; to dwell, as a dog or a fox."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0698a0fb-796f-4aff-81f4-342cb6aa3432",
                                                "sense_id": "35fbce72-2901-3e0a-9b96-ef20d3ea5444",
                                                "text": "Truth's a dog must to kennel;"
                                            },
                                            {
                                                "example_id": "3a97da31-55d4-42a1-8d19-7464b9329ce6",
                                                "sense_id": "35fbce72-2901-3e0a-9b96-ef20d3ea5444",
                                                "text": "The Dog Kennell'd in the Body of a Hollow Tree, and the Cock Roosted at night upon the Boughs."
                                            },
                                            {
                                                "example_id": "93a575b7-161e-4eb7-a875-9fd823190b41",
                                                "sense_id": "35fbce72-2901-3e0a-9b96-ef20d3ea5444",
                                                "text": "Below to thy nightly grave ; where such as ye sleep between shrouds, to use ye to the filling one at last. — Down, dog, and kennel!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b841d9-9f10-30a1-87f7-9a13b0224b27",
                                        "entry_id": "a5c0bb3e-d092-3bb6-919a-9f36316c7e9f",
                                        "glosses": [
                                            "To drive (a fox) to covert in its hole."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb6de5b-f9a2-4903-81bd-062806c3ca2f",
                                                "sense_id": "13b841d9-9f10-30a1-87f7-9a13b0224b27",
                                                "text": "This is the time that the horseman are flung out, not having the cry to lead them to the death. When quadruped animals of the venery or hunting kind are at rest, the stag is said to be harboured, the buck lodged, the fox kennelled, the badger earthed, the otter vented or watched, the hare formed, and the rabbit set."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kennel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                        "entry_id": "0f331cbf-df70-30c2-b36b-f78134d10594",
                                        "glosses": [
                                            "The gutter at the edge of a street; a surface drain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "febac03b-a1a4-411c-89ce-5480122d0757",
                                                "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                                "text": "Ay, kennel, puddle, sink, whose filth and dirt / Troubles the silver spring where England drinks […]."
                                            },
                                            {
                                                "example_id": "9ce12d77-0e60-4797-a6f1-8e3402915c6c",
                                                "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                                "text": "[A] scavenger working in the kennel"
                                            },
                                            {
                                                "example_id": "55295045-748b-4df7-b26a-5ab4ba6e5454",
                                                "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                                "text": "Soon ſhall the Kennels ſvvell vvith rapid Streams, / And ruſh in muddy Torrents to the Thames."
                                            },
                                            {
                                                "example_id": "1a94c1db-8c1b-4bbf-9efe-8263125d1f61",
                                                "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                                "text": "[A] chair happening to pass, he laid hold of the opportunity, and by an exertion of his muscles pitched upon the top of the carriage, which was immediately overturned in the kennel […]."
                                            },
                                            {
                                                "example_id": "daceb9aa-e72a-4a22-8e1b-d7d1dbc4d31c",
                                                "sense_id": "cda309ea-a1eb-333a-a86f-dcbd591726ee",
                                                "text": "A biting wind whistled through the streets, the pavements were dotted with umbrella-laden figures, the kennels ran like mill-sluices, while the roads were only a succession of lamp-lit puddles through which the wheeled traffic splashed continuously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714a0120-97e4-3ea0-a94e-29af3d89110e",
                                        "entry_id": "0f331cbf-df70-30c2-b36b-f78134d10594",
                                        "glosses": [
                                            "A puddle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eec00467-d77a-4f3b-b6d9-fac65fa4bc5e",
                        "source_entry_id": "b6487f5d-3ea1-377a-8970-16535c465f6d",
                        "source_sense_id": "70c843c2-b0f6-383f-ab55-a1a8047ef8cf",
                        "target_lang_word": "chenil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chenil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Lieu où logent les chiens de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97944ac2-651a-4c6d-81db-fca640cc6715",
                                                "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                                "text": "Les chiens au chenil aboyèrent tous."
                                            },
                                            {
                                                "example_id": "140d7eec-20bb-4553-9541-d69a265b9b3e",
                                                "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                                "text": "Mr. et Mrs. Joliffe, aussitôt sortis de la maison, s’étaient rendus, l’un au chenil, l’autre à l’étable des rennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d480f70a-f803-35ed-8045-4923d87d2174",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Logement fort sale et fort vilain."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db0259f3-9afd-48d5-be4c-55da9f5af388",
                                                "sense_id": "d480f70a-f803-35ed-8045-4923d87d2174",
                                                "text": "C’est un vrai chenil'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292c8453-51d4-3823-8f62-3d6e6a0e5f71",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Établissement où on accueille les chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf84027-0387-4055-aded-f7726aff6e0c",
                                                "sense_id": "292c8453-51d4-3823-8f62-3d6e6a0e5f71",
                                                "text": "— Comment, dit Gazonal en regardant avec dédain le mobilier du salon par la porte que ses complices avaient laissée entr’ouverte, et en supputant ce que valait celui de la salle à manger, comment laisse-t-on une femme comme vous dans un pareil chenil ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3014bbca-f8c4-396f-8ba7-63f4b8e10369",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Établissement où on élève les chiens dans le but de les vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae0b200-0e42-4bad-9b35-520d9624cc6f",
                                                "sense_id": "3014bbca-f8c4-396f-8ba7-63f4b8e10369",
                                                "text": "Le directeur du chenil, un homme sensible, conservait depuis quarante ans les copies des pedigrees et une petite photo d’identité de tous les chiens qu’il avait vendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Tas de poussière obtenu quand on balaye."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b59bdd23-7bf7-4f1c-ba79-527c5934b7ff",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "Ramasser le chenil'"
                                            },
                                            {
                                                "example_id": "39c506a6-c86d-4414-b444-edb754f6eac1",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "Ne marchez pas dans mon chenil'"
                                            },
                                            {
                                                "example_id": "e1227d2b-835a-4d2d-a2f3-0f66c1237af1",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "La pelle, la brosse à chenil'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a116333a-6ba1-30d0-a728-82dd2a856d51",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Tas de poussière obtenu quand on balaye.",
                                            "Désordre."
                                        ],
