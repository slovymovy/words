                    {
                        "translation_id": "b4ad4323-4cef-47b7-9dc9-462316a93074",
                        "source_entry_id": "30ddfdb6-a4f1-31d5-bc4e-4d9b3bcb53d2",
                        "source_sense_id": "fe5cf105-340c-373b-8c1a-a80a05f58163",
                        "target_lang_word": "Nachahmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachahmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                        "entry_id": "b505aebc-e5e0-31eb-b44a-14592f8c6ed7",
                                        "glosses": [
                                            "das Nachahmen, Imitieren, Kopieren eines Gegenstandes, einer Person oder Verhaltensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3da0a6-caeb-4f21-b6ef-a283427522c5",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "Bates bezeichnete die Nachahmung eines wehrhaften oder ungenießbaren Tieres durch harmlose Tiere zur Täuschung von Feinden als Mimikry."
                                            },
                                            {
                                                "example_id": "8f9998eb-cda8-41ae-8327-4a5a0cb0d2d0",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„In einem Augenblick sprach er Englisch in einer Nachahmung der Redeweise seines halben ungarischen Landsmannes George Sanders, an den sich Frauen über sechzig als einen sanften Herzensbrecher aus Hollywood erinnern werden.“"
                                            },
                                            {
                                                "example_id": "39ef2a2a-c8bd-49d7-895e-39f545b556dd",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„Damit wollte er ihr den sicheren Weg zum ewigen Heil weisen, in Nachahmung der Buße ihrer neuen Schutzpatronin, deren Leben sie bisher geführt hatte.“"
                                            },
                                            {
                                                "example_id": "83b4a83c-3926-4967-8b71-46a5cfbf5fa2",
                                                "sense_id": "e189e2aa-0a30-3e82-9ae6-e04de92a34c3",
                                                "text": "„Natürlich ist das schön von dir, als Dichter bist du ein Berg, aber zur Nachahmung empfiehlt es sich kaum, seinen Freund mit Einsamkeit zu trösten, auch wenn sie so schön bedichtet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
