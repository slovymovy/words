                    {
                        "sense_id": "42efb4fe-e88b-3718-9247-3c85d21445db",
                        "entry_id": "11645b95-d70e-39cd-8ba5-34004784243f",
                        "glosses": [
                            "een hinderlijke onderbreking, een bepaald proces wordt onderbroken of bemoeilijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25126cc-7956-48fa-be60-206a6914585c",
                                "sense_id": "42efb4fe-e88b-3718-9247-3c85d21445db",
                                "text": "Door een storing is er de hele dag geen treinverkeer tussen Amsterdam en Leiden."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6664d06-0484-3f51-acf3-aff368a2dd4b",
                        "entry_id": "11645b95-d70e-39cd-8ba5-34004784243f",
                        "glosses": [
                            "een slecht signaalontvangst van bijvoorbeeld televisie, radio of internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "717cad83-dfd8-4dd4-b6db-40227f130319",
                                "sense_id": "e6664d06-0484-3f51-acf3-aff368a2dd4b",
                                "text": "In de vroege jaren van de Nederlandse Televisie Stichting was het bordje storing een veelgeziene verschijning."
                            }
                        ]
                    },
                    {
                        "sense_id": "356ca0a4-869d-3f9b-ba17-e907fca10627",
                        "entry_id": "11645b95-d70e-39cd-8ba5-34004784243f",
                        "glosses": [
                            "plaatselijke turbulentie de atmosfeer waardoor wind en regen ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ea5b40-71d8-45ad-ae0d-604d32ad53b8",
                                "sense_id": "356ca0a4-869d-3f9b-ba17-e907fca10627",
                                "text": "Bonnie komt waarschijnlijk sneller aan dan verwacht omdat de oostenwind steviger is dan voorzien. Dat heeft volgens CWC wel als voordeel dat het noodweer ook sneller overwaait. \"Omdat de storing zich zo snel naar het westen verplaatst, is de kans op de eerder voorspelde 75 tot 125 millimeter regen klein\", zegt CWC-weerman Olav Geijs vanaf Curaçao."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41652e50-0810-487a-9f41-15ef10fd981b",
                        "source_entry_id": "11645b95-d70e-39cd-8ba5-34004784243f",
                        "source_sense_id": "42efb4fe-e88b-3718-9247-3c85d21445db",
                        "source_sense_description": "een hinderlijke onderbreking, een bepaald proces wordt onderbroken of bemoeilijkt",
                        "target_lang_word": "Störung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Störung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bcf4944-d6d4-316c-8641-57aad131e13c",
                                        "entry_id": "0866cce3-9205-3ba6-90cf-fc803544cdbc",
                                        "glosses": [
                                            "unerwünschte Beeinträchtigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89ddc73-4417-470e-a812-428f916e1eb0",
                                                "sense_id": "4bcf4944-d6d4-316c-8641-57aad131e13c",
                                                "text": "„Außerdem werde Frixe eine Telefonnummer mitgeteilt, über die er bei Störungen direkt Kontakt aufnehmen könne.“"
                                            },
                                            {
                                                "example_id": "467720fb-7b83-471a-823e-39fcb2631dd0",
                                                "sense_id": "4bcf4944-d6d4-316c-8641-57aad131e13c",
                                                "text": "„Ohne weitere Störung beendeten sie den Unterricht.“"
                                            },
                                            {
                                                "example_id": "cd0feaf2-c9aa-4926-b81f-a2aca338e8d5",
                                                "sense_id": "4bcf4944-d6d4-316c-8641-57aad131e13c",
                                                "text": "„Daraufhin beschlossen die Eltern, diese Störung loszuwerden und die Verrückte aus der Gegend zu verjagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cff4594-f3ed-3e86-96a2-ebba8e48e7ee",
                                        "entry_id": "0866cce3-9205-3ba6-90cf-fc803544cdbc",
                                        "glosses": [
                                            "vorübergehende Fehlfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eeddbab-7c31-4d79-830c-8277fb813967",
                                                "sense_id": "4cff4594-f3ed-3e86-96a2-ebba8e48e7ee",
                                                "text": "Der Drucker funktioniert nicht. Er hat eine Störung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c897632-3272-4d59-8e59-c614421a5788",
                        "source_entry_id": "11645b95-d70e-39cd-8ba5-34004784243f",
