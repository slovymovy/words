                {
                    "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                    "sense_definition": "Action de diviser ou de distribuer quelque chose entre plusieurs personnes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>partage</w> des tâches ménagères permet d'équilibrer la vie de famille."
                        },
                        {
                            "text": "Ils ont procédé au <w>partage</w> équitable des biens de la succession."
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "division",
                        "répartition"
                    ],
                    "antonyms": [
                        "accaparement",
                        "monopole"
                    ],
                    "common_phrases": [
