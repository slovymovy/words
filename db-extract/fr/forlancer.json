                "senses": [
                    {
                        "sense_id": "cf561607-81b0-3942-af36-38d4e83d90eb",
                        "entry_id": "0b4547f1-3a00-3ee5-9fb7-946121cbd771",
                        "glosses": [
                            "Faire sortir une bête de son gîte."
                        ],
                        "tags": [],
