        "de-extract.jsonl": [
            {
                "entry_id": "eb792f05-ccec-3710-a64d-7f4edef2b766",
                "word": "ChatGPT",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "3b0ff1b8-4f9a-480d-9e88-e5c85ad7ea64",
                        "entry_id": "eb792f05-ccec-3710-a64d-7f4edef2b766",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "ChatGPTs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                        "entry_id": "eb792f05-ccec-3710-a64d-7f4edef2b766",
                        "glosses": [
                            "interaktive Anwendung/Chatbot, bei der eine Person mit einer Maschine menschenähnlich kommunizieren kann (beispielsweise kann die Maschine Fragen beantworten, Texte erstellen, Bilder/Videos/Musik erzeugen)"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "0173cac1-849b-41ee-b939-fd218533f403",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Sprachmodelle wie ChatGPT haben das Schreiben revolutioniert.“"
                            },
                            {
                                "example_id": "c14fe04f-e50e-4f2d-acfb-e94bb7378335",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Im November 2022 wurde der KI-Chatbot ChatGPT 3.5 freigeschaltet und binnen weniger Tage nutzten mehr als 100 Millionen User weltweit das Programm. Damit war ChatGPT die am schnellsten wachsende Plattform aller Zeiten.“"
                            },
                            {
                                "example_id": "c90f9a3a-a967-470b-b2f6-92ea480c73c9",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„KI-Systeme wie ChatGPT demonstrieren, welche enormen Fortschritte die Künstliche Intelligenz in den letzten Jahren gemacht haben.“"
                            },
                            {
                                "example_id": "60721f40-9d79-47ad-81a8-ad07531c7644",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "[…] „KI-Systeme wie ChatGPT scheinen fast alles zu wissen und werden vielfach als Lernhelfer genutzt.“"
                            },
                            {
                                "example_id": "0ea6c4fe-f83c-4e32-8057-c4064251a4e0",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Texte schreiben, Webseiten programmieren oder Steuerklärungen machen. KI-Systeme wie ChatGPT können uns viel Arbeit abnehmen.“"
                            },
                            {
                                "example_id": "75336d74-8e9d-4f3b-af1a-13cc6fdc8046",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Auf den ersten Blick ist ChatGPT des Schülers bester Freund: Die Künstliche Intelligenz schreibt Aufsätze und macht Hausaufgaben.“"
                            },
                            {
                                "example_id": "e6788ef2-1a79-4ea8-84e8-db4da9a55d66",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„In einer weiteren Demonstration erfand ChatGPT eine Gute-Nacht-Geschichte und las sie vor.“"
                            },
                            {
                                "example_id": "8e32e656-a3bd-4c41-bf3d-77e9b9b0d991",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Im Mai hatte ChatGPT in einem Experiment des Bayerischen Rundfunks sogar das bayerische Abitur bestanden.“"
                            },
                            {
                                "example_id": "06c3deef-6080-4b59-92d6-e03a636316c6",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Weil ChatGPT nur Sprachmuster wiedergibt, aber die Inhalte nicht wirklich versteht oder begreift, produziert der Bot auch überzeugend klingende Fake-News, diskriminierende Aussagen oder verzerrte Darstellungen.“"
                            },
                            {
                                "example_id": "e2ea81dd-888c-47db-98d6-13d7dac5208a",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„»ChatGPT ist zwar Open Access, aber nicht Open Source«, erklären Jerôme Rutinowski von der Technischen Universität Dortmund und seine Kollegen.“"
                            },
                            {
                                "example_id": "17135ef9-a86e-47a5-bac7-049f88fddf19",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Aufgrund seiner vielseitigen Fähigkeiten ist ChatGPT für viele mittlerweile auch ein wichtiger Assistent bei schulischen und beruflichen Aufgaben.“"
                            },
                            {
                                "example_id": "e69c79bc-aba1-452c-af9e-4fde27fdddf6",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Doch ChatGPT und vergleichbare Anwendungen sind längst nicht perfekt und stehen häufig in der Kritik.“"
                            },
                            {
                                "example_id": "0b011549-6e45-495b-a8f6-a5f04779bd94",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "[…] „während die Wortwahl eines Menschen kreativer, beliebiger, ja zufälliger ist, arbeiten Sprachmodelle wie ChatGPT mit Wahrscheinlichkeiten; sie verwenden also Worte, die sie an einer bestimmten Stelle für besonders wahrscheinlich halten.“"
                            },
                            {
                                "example_id": "23d38283-676e-4c13-adf2-06554892d7a2",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Nicht einmal ihre Entwickler wissen so genau, wieso ChatGPT und Co. tun, was sie tun.“"
                            },
                            {
                                "example_id": "9ae7d997-2872-4c28-9e08-735a7d232b01",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„ChatGPT bestimmt also nach statistischer Wahrscheinlichkeit, wie eine Frage beantwortet wird, wie ein Antwortsatz weitergeht. Die KI hat aber keine Ahnung, was sie da schreibt:“ […]."
                            },
                            {
                                "example_id": "40e876b6-91be-4aec-8b64-e9d134fb3a9d",
                                "sense_id": "f6ff1d64-8841-3fa5-8044-e379cbf6a743",
                                "text": "„Mit ChatGPT können nun nicht mehr nur hochgebildete IT-Experten die Vorzüge von Künstlicher Intelligenz nutzen, sondern ebenso der Durchschnittsmensch. Wie sehr ChatGPT damit ins Schwarze getroffen hat, zeigen auch seine Nutzerzahlen. Vergangenes Jahr hat es gerade einmal fünf Tage gedauert, bis eine Million Nutzer das Programm ausgetestet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42462384-1452-47cd-861a-a6dafbd4fa6b",
