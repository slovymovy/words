                    {
                        "sense_id": "5aa0d376-e5df-3a8d-bdea-6c417d187877",
                        "entry_id": "20fd7dd0-a02a-3c34-b15a-d9a3c05dbeb6",
                        "glosses": [
                            "Sumpfgras, das an den Ufern von Seen und Teichen wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b75ddef-e7d4-46bf-92a5-e5f765576092",
                                "sense_id": "5aa0d376-e5df-3a8d-bdea-6c417d187877",
                                "text": "„Er steuerte den Land Rover so tief wie möglich in das hohe bräunliche Schilfgras am Ufer, stieg aus, rannte nach hinten, setzte den Rucksack auf und zog einen länglichen ockerfarbenen Koffer aus dem Laderaum.“"
                            },
                            {
                                "example_id": "51343502-045a-4e90-9b64-15c37b062dfa",
                                "sense_id": "5aa0d376-e5df-3a8d-bdea-6c417d187877",
                                "text": "„Er ist so dünn wie sein Vater; das sind sie alle, wie Schilfgras im Wind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
