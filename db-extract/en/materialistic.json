                ],
                "senses": [
                    {
                        "sense_id": "9031fac0-1586-34c2-a2f1-7a9185f5492a",
                        "entry_id": "fc821f6e-57e4-32cb-9dca-6abd310006e4",
                        "glosses": [
                            "Being overly concerned with material possessions and wealth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8024b87-274e-43eb-a237-d53e3e30ff14",
                                "sense_id": "9031fac0-1586-34c2-a2f1-7a9185f5492a",
                                "text": "Where American Jewish men contend with stereotypes of being oversexed, needy, nebbishy and neurotic (like Woody Allen, boo hiss), Jewish women are cast as withholding, bossy, exotic, and materialistic (like Fran Drescher, which honestly? Goals)."
                            }
                        ]
                    },
                    {
                        "sense_id": "b400f888-00d6-3393-8207-c6040eb8c53e",
                        "entry_id": "fc821f6e-57e4-32cb-9dca-6abd310006e4",
                        "glosses": [
                            "Of or concerning philosophical materialism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347aabe5-348b-4570-9445-d48900e7efe6",
                                "sense_id": "b400f888-00d6-3393-8207-c6040eb8c53e",
                                "text": "But to me his very spiritualism seemed more materialistic than his physics."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da5d53ee-c2d4-4185-b7fa-3d625c60a45c",
