{
    "word_family": [
        "jaunt"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b315fb5-ac92-3ff0-8387-08f39ae855fa",
                    "sense_definition": "Dapper or stylish in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>jaunty</w> outfit that was all the rage.",
                            "target_lang_translations": {
                                "es": "Llevaba un atuendo <w>desenfadado</w> que causaba furor."
                            }
                        },
                        {
                            "text": "She looked quite <w>jaunty</w> in her new hat and scarf.",
                            "target_lang_translations": {
                                "es": "Se la veía muy <w>vistosa</w> con su sombrero y bufanda nuevos."
                            }
                        }
                    ],
                    "synonyms": [
                        "dapper",
                        "stylish",
                        "smart"
                    ],
                    "common_phrases": [
                        "jaunty hat",
                        "jaunty outfit"
                    ],
                    "target_lang_definitions": {
                        "es": "Elegante, vistoso o con estilo en apariencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desenfadado",
                                "target_lang_sense_clarification": "estilo fresco y con gracia"
                            },
                            {
                                "target_lang_word": "vistoso",
                                "target_lang_sense_clarification": "llamativo y elegante"
                            },
                            {
                                "target_lang_word": "garboso",
                                "target_lang_sense_clarification": "con garbo o apostura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f50562dd-0f43-356d-b13e-303af2976042",
                    "sense_definition": "Having or expressing a lively, cheerful, and self-confident manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked down the street with a <w>jaunty</w> swaggering step, as if daring others to intrude upon his good mood.",
                            "target_lang_translations": {
                                "es": "Caminaba por la calle con un paso <w>desenvuelto</w> y chulesco, como desafiando a los demás a alterar su buen humor."
                            }
                        },
                        {
                            "text": "The team marched onto the field with a <w>jaunty</w> air of confidence.",
                            "target_lang_translations": {
                                "es": "El equipo entró al campo con un aire <w>alegre</w> y seguro."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "lively",
                        "confident"
                    ],
                    "antonyms": [
                        "depressed",
                        "somber"
                    ],
                    "common_phrases": [
                        "jaunty air",
                        "jaunty step"
                    ],
                    "target_lang_definitions": {
                        "es": "Que muestra o tiene un porte alegre, vivo y lleno de seguridad en sí mismo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alegre",
                                "target_lang_sense_clarification": "lleno de viveza y buen humor"
                            },
                            {
                                "target_lang_word": "desenvuelto",
                                "target_lang_sense_clarification": "con soltura y confianza"
                            },
                            {
                                "target_lang_word": "jacarandoso",
                                "target_lang_sense_clarification": "alegre y desenvuelto"
                            },
                            {
                                "target_lang_word": "animado",
                                "target_lang_sense_clarification": "vivaz y entusiasta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d0d1103-b3e9-33bc-a818-0f4b63f8cbf0",
                    "sense_definition": "Showy or overly concerned with fine details.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>jaunty</w> display of wealth felt quite unnecessary.",
                            "target_lang_translations": {
                                "es": "Su <w>ostentosa</w> exhibición de riqueza pareció del todo innecesaria."
                            }
                        },
                        {
                            "text": "The room was decorated in a <w>jaunty</w> and fussy style.",
                            "target_lang_translations": {
                                "es": "La habitación estaba decorada con un estilo <w>llamativo</w> y recargado."
                            }
                        }
                    ],
                    "synonyms": [
                        "showy",
                        "finical"
                    ],
                    "target_lang_definitions": {
                        "es": "Ostentoso o excesivamente preocupado por los detalles refinados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ostentoso",
                                "target_lang_sense_clarification": "llamativo por exceso de adorno o exhibición"
                            },
                            {
                                "target_lang_word": "llamativo",
                                "target_lang_sense_clarification": "que busca llamar la atención"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad3b41d4-8afc-39ec-85f0-3729b670c715",
                    "sense_definition": "Characterized by an affected or fantastical manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He adopted a <w>jaunty</w> persona that seemed entirely fake.",
                            "target_lang_translations": {
                                "es": "Adoptó un personaje <w>afectado</w> que parecía completamente falso."
                            }
                        },
                        {
                            "text": "The actor gave a <w>jaunty</w> performance that lacked sincerity.",
                            "target_lang_translations": {
                                "es": "El actor ofreció una actuación <w>artificiosa</w> a la que le faltaba sinceridad."
                            }
                        }
                    ],
                    "synonyms": [
                        "affected"
                    ],
                    "target_lang_definitions": {
                        "es": "Caracterizado por una actitud afectada, artificiosa o extravagante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "afectado",
                                "target_lang_sense_clarification": "poco natural o fingido"
                            },
                            {
                                "target_lang_word": "artificioso",
                                "target_lang_sense_clarification": "que carece de espontaneidad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51e4598e-53c3-3978-9af5-9ff240aa5dd0",
