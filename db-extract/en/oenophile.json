                    {
                        "translation_id": "6173b7b5-ff98-4268-98ae-e66408d94663",
                        "source_entry_id": "e5411331-d39b-301a-91f8-1c1f4e07e905",
                        "source_sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                        "source_sense_description": "wine-lover",
                        "target_lang_word": "Weinliebhaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinliebhaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae77f5d-4f90-3cf6-a257-d77563507efb",
                                        "entry_id": "886e08db-5d50-3907-90b8-747a82340dee",
                                        "glosses": [
                                            "Person, die den Wein zu schätzen, zu lieben und zu genießen weiß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0708fe88-a4b5-4bb9-ada7-2e66ed16b56d",
                                                "sense_id": "9ae77f5d-4f90-3cf6-a257-d77563507efb",
                                                "text": "Mein Onkel ist ein ausgesprochener Weinliebhaber."
                                            },
                                            {
                                                "example_id": "14ab0864-9992-427d-8206-d7a791e238df",
                                                "sense_id": "9ae77f5d-4f90-3cf6-a257-d77563507efb",
                                                "text": "„Die Traubenpreise liegen laut Schmuckenschlager weiter über dem Durchschnitt der letzten Jahre, die Fasspreise würden zurzeit stagnieren. Weinliebhaber werden trotzdem nicht tiefer in die Tasche greifen müssen, Schmuckanschlager rechnet mit einer stabilen Preisentwicklung.“"
                                            },
                                            {
                                                "example_id": "97a19d0a-7a8a-4abf-bba6-305dd56f813a",
                                                "sense_id": "9ae77f5d-4f90-3cf6-a257-d77563507efb",
                                                "text": "„Die heutigen Touristen müssen sich mit einem alkoholfreien Getränk begnügen, das nach dem arabischen Dichter Omar al Khayam benannt wurde; der selbst war ein großer Weinliebhaber und hat eine so grausame Nachwelt wirklich nicht verdient.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205eb638-a126-4f0b-8ba3-7b65c44bf9f0",
                        "source_entry_id": "e5411331-d39b-301a-91f8-1c1f4e07e905",
                        "source_sense_id": "2052e74c-f51a-3546-b123-762adcb440f2",
                        "source_sense_description": "wine-lover",
                        "target_lang_word": "Weinkenner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinkenner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd2afa21-1cc3-32ab-8b4a-f8b94857b8f2",
                                        "entry_id": "de731876-3bc6-3963-b38d-93029f9fde1c",
                                        "glosses": [
                                            "Person, die sich mit Weinen und deren Herstellung besonders gut auskennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60cc392c-55c4-4cac-8cdb-011a76387b19",
                                                "sense_id": "fd2afa21-1cc3-32ab-8b4a-f8b94857b8f2",
                                                "text": "Erhard ist wirklich ein ausgewiesener Weinkenner."
                                            },
                                            {
                                                "example_id": "3f444c15-f7d9-466d-9839-b3c2e6bd3b12",
                                                "sense_id": "fd2afa21-1cc3-32ab-8b4a-f8b94857b8f2",
                                                "text": "„Dieser Fürstabt war ein Feinschmecker ersten Ranges und dazu ein Weinkenner, der nur enthaltsam tat.“"
                                            },
                                            {
                                                "example_id": "b6fda393-5b0c-42d4-bf04-e8269d1d5c25",
                                                "sense_id": "fd2afa21-1cc3-32ab-8b4a-f8b94857b8f2",
                                                "text": "„Er markiert den Weinkenner, der probiert, ob der Wein korkig sei.“"
                                            },
                                            {
                                                "example_id": "45514592-0cb9-44b0-aad5-e1a2fc0993d9",
                                                "sense_id": "fd2afa21-1cc3-32ab-8b4a-f8b94857b8f2",
                                                "text": "„Das zottelige Tier stand breitbeinig da und hielt seinen Kopf dabei auf eine äußerst komische Weise, etwa wie ein Weinkenner, der das Bouquet eines berühmten Jahrgangs zunächst mit der Nase genießt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
