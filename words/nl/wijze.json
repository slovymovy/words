                                "target_lang_sense_clarification": "простая мелодия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebb264ea-3265-35e6-a355-7709fd4e33ce",
                    "sense_definition": "Een grammaticale categorie die de houding van de spreker ten opzichte van de handeling uitdrukt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aantonende <w>wijze</w> wordt het meest gebruikt in de Nederlandse taal.",
                            "target_lang_translations": {
                                "en": "The indicative <w>mood</w> is used most often in the Dutch language.",
                                "ru": "Изъявительное <w>наклонение</w> чаще всего используется в нидерландском языке."
                            }
                        },
                        {
                            "text": "In deze zin staat het werkwoord in de gebiedende <w>wijze</w>.",
                            "target_lang_translations": {
                                "en": "In this sentence, the verb is in the imperative <w>mood</w>.",
                                "ru": "В этом предложении глагол стоит в повелительном <w>наклонении</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "modus"
                    ],
                    "common_phrases": [
                        "aantonende wijze",
                        "gebiedende wijze",
                        "aanvoegende wijze"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "taalkunde"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatical category that expresses the speaker's attitude toward the action (mood).",
                        "ru": "Грамматическая категория, выражающая отношение говорящего к действию."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mood",
                                "target_lang_sense_clarification": "grammatical category such as indicative or imperative"
                            },
                            {
                                "target_lang_word": "mode",
                                "target_lang_sense_clarification": "a verb form relating to the speaker's assertion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наклонение",
                                "target_lang_sense_clarification": "грамматическая категория глагола"
                            }
                        ]
                    }
                }
            ]
        },
