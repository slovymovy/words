                                            {
                                                "example_id": "ca743306-64e0-4a12-aa79-5ae0556db137",
                                                "sense_id": "53971e93-5f06-3e99-b2e7-fd97037e4149",
                                                "text": "Als Verbraucherin diverser Hygieneartikel nimmt sie immer mal wieder an Konsumentenbefragungen teil."
