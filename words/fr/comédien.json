                                "target_lang_sense_clarification": "театр, кино, эстрада"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schauspieler",
                                "target_lang_sense_clarification": "Theater, Film, Fernsehen"
                            },
                            {
                                "target_lang_word": "Darsteller",
                                "target_lang_sense_clarification": "Film und Theater, allgemein"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "actor",
                                "target_lang_sense_clarification": "teatro, cine o televisión"
                            },
                            {
                                "target_lang_word": "intérprete",
                                "target_lang_sense_clarification": "término general, teatro y cine"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演员",
                                "target_lang_sense_clarification": "戏剧、电影或电视"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "991a05d1-3d24-3dc4-a2e0-d09b43ae1a8c",
                    "sense_definition": "Personne qui feint des émotions ou dissimule ses intentions afin de tromper autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne crois pas à ses larmes car c'est un véritable <w>comédien</w>.",
                            "target_lang_translations": {
                                "en": "Don't believe his tears, because he's a real <w>faker</w>.",
                                "ru": "Не верь его слезам, ведь он настоящий <w>притворщик</w>.",
                                "de": "Glaub seinen Tränen nicht, denn er ist ein echter <w>Heuchler</w>.",
                                "es": "No te fíes de sus lágrimas, porque es un verdadero <w>farsante</w>.",
                                "zh": "别相信他的眼泪，他可是个十足的<w>演员</w>。"
                            }
                        },
                        {
                            "text": "Il fait semblant d'être surpris, mais tout le monde sait que c'est un grand <w>comédien</w>.",
                            "target_lang_translations": {
                                "en": "He pretends to be surprised, but everyone knows he's a great <w>actor</w>.",
                                "ru": "Он делает вид, что удивлён, но всем известно, что он большой <w>притворщик</w>.",
                                "de": "Er tut so, als wäre er überrascht, aber alle wissen, dass er ein großer <w>Heuchler</w> ist.",
                                "es": "Hace como si estuviera sorprendido, pero todo el mundo sabe que es un gran <w>comediante</w>.",
                                "zh": "他装出一副很惊讶的样子，但大家都知道他是个高明的<w>演员</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grand comédien",
                        "sacré comédien"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who feigns emotions or hides their intentions in order to deceive others.",
                        "ru": "Человек, который притворяется в своих чувствах или скрывает свои намерения, чтобы обмануть других.",
                        "de": "Person, die Gefühle vortäuscht oder ihre Absichten verbirgt, um andere zu täuschen.",
                        "es": "Persona que finge emociones o esconde sus intenciones para engañar a los demás.",
                        "zh": "假装出某种情感或隐藏真实意图，以欺骗他人的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "faker",
                                "target_lang_sense_clarification": "insincere, informal, feigned emotion"
                            },
                            {
                                "target_lang_word": "dissembler",
                                "target_lang_sense_clarification": "concealing true feelings or intentions"
                            },
                            {
                                "target_lang_word": "actor",
                                "target_lang_sense_clarification": "figurative: insincere, feigned behaviour"
                            }
                        ],
                        "ru": [
