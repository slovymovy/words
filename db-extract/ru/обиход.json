                            },
                            {
                                "example_id": "26d141b7-1234-4c7f-8b5e-4302b9ef5393",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "предме́ты дома́шнего обихо́да",
