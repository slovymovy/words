                        "form": "бро́ду"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99d87048-a60d-39b7-a339-dae062855bfe",
                        "entry_id": "7832a6f5-28df-3079-a809-8de68a9a99e6",
                        "glosses": [
                            "неглубокое, мелкое место во всю ширину реки, озера и т. п., через которое можно переходить или переезжать, передвигаясь по дну"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9282ed83-aabb-4fb8-8244-dc8508e020a2",
                                "sense_id": "99d87048-a60d-39b7-a339-dae062855bfe",
                                "text": "Мы нашли брод, обозначенный вехами, и переехали реку, только чуть замочив подошвы сапог."
                            },
                            {
                                "example_id": "04608837-d83b-4b41-b5c5-488069abb724",
                                "sense_id": "99d87048-a60d-39b7-a339-dae062855bfe",
                                "text": "Это большая река, с быстрым течением, брод через которую очень опасен, и поэтому только в конце второго дня, когда река становится мельче, проводник переводит караван на другой берег."
                            }
                        ]
                    },
                    {
                        "sense_id": "32f04206-074f-3e12-87fd-3b6d0d2790ca",
                        "entry_id": "7832a6f5-28df-3079-a809-8de68a9a99e6",
                        "glosses": [
                            "переход, передвижение через реку, озеро и т. п. в таком месте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e61b03-d4fe-4c6e-a5ac-22da45d93a47",
                                "sense_id": "32f04206-074f-3e12-87fd-3b6d0d2790ca",
                                "text": "Мы спускаемся в широкую каменистую долину, переходим в брод несколько рукавов обмелевшей реки и выходим на тропу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ef5429c-da24-4245-9b9c-3daacfbb0fc3",
                        "source_entry_id": "7832a6f5-28df-3079-a809-8de68a9a99e6",
                        "source_sense_description": "неглубокое, мелкое место во всю ширину реки, озера и т. п., через которое можно переходить или переезжать, передвигаясь по дну",
                        "target_lang_word": "ford",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ford",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1720e38d-4a85-36ac-bd53-0f39d4c684b5",
                                        "entry_id": "8003c089-83ad-3b87-a687-c807b7e55044",
                                        "glosses": [
                                            "A location where a stream is shallow and the bottom has good footing, making it possible to cross from one side to the other with no bridge, by walking, riding, or driving through the water; a crossing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31336216-d60f-4a27-a2da-79b480332f33",
                                                "sense_id": "1720e38d-4a85-36ac-bd53-0f39d4c684b5",
                                                "text": "He swam the Esk river where ford there was none."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382589ed-84e4-369c-8f64-0e2d13a8ce6a",
                                        "entry_id": "8003c089-83ad-3b87-a687-c807b7e55044",
                                        "glosses": [
                                            "A stream; a current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2680dc2-eb84-450d-909b-94b21468a227",
                                                "sense_id": "382589ed-84e4-369c-8f64-0e2d13a8ce6a",
                                                "text": "With water of the ford / Or of the clouds."
                                            },
                                            {
                                                "example_id": "c0916259-3020-491a-b34f-31776c141764",
                                                "sense_id": "382589ed-84e4-369c-8f64-0e2d13a8ce6a",
                                                "text": "Permit my ghost to pass the Stygian ford."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ford",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fba54db-7f3e-3cef-87d1-efd856177472",
                                        "entry_id": "7c79bc1f-3001-3dd7-a8dc-20ca205d3720",
                                        "glosses": [
                                            "To cross a stream by walking through it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e2ed46-02e5-4f05-a411-b8cc2fc2adfc",
                                                "sense_id": "1fba54db-7f3e-3cef-87d1-efd856177472",
                                                "text": "He named that place, for it was near her dwelling, and on the road between Balerynie and Heriotside, which fords the Sker Burn."
                                            },
                                            {
                                                "example_id": "f7bb304b-ba63-4599-b339-71ff1578b919",
                                                "sense_id": "1fba54db-7f3e-3cef-87d1-efd856177472",
                                                "text": "Since the time of Seyavi the deer have shifted their feeding ground across the valley at the beginning of deep snows, by way of the Black Rock, fording the river at Charley's Butte, and making straight for the mouth of the cañon that is the easiest going to the winter pastures on Waban."
                                            },
                                            {
                                                "example_id": "b5bd7b15-b8b4-4f26-a9d4-cc59d6483dd5",
                                                "sense_id": "1fba54db-7f3e-3cef-87d1-efd856177472",
                                                "text": "Ratau drove with reckless authority through the quiet morning fires of his father's and forefathers' town and forded a river of goats on the road leading out of it."
                                            },
                                            {
                                                "example_id": "8c6373b5-e100-47e9-8419-d80006ce1032",
                                                "sense_id": "1fba54db-7f3e-3cef-87d1-efd856177472",
                                                "text": "2016, Bruce McClure and Deborah Byrd, \"EarthSky's meteor shower guide for 2016\" in earthsky.org, http://earthsky.org/astronomy-essentials/earthskys-meteor-shower-guide\nSome who witnessed the 1966 Leonid meteor storm said they felt as if they needed to grip the ground, so strong was the impression of Earth plowing along through space, fording the meteoroid stream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fbd3436-93fc-4eec-8e2d-88020ba8d9df",
                        "source_entry_id": "7832a6f5-28df-3079-a809-8de68a9a99e6",
                        "source_sense_description": "неглубокое, мелкое место во всю ширину реки, озера и т. п., через которое можно переходить или переезжать, передвигаясь по дну",
                        "target_lang_word": "Furt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Furt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                        "entry_id": "248289f7-6dc3-3221-a68a-fa1588b50c5d",
                                        "glosses": [
                                            "durchfahrbare Stelle eines Flusses, Flussübergang an einer flachen (aber nicht sumpfigen) Stelle des Gewässers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f75fb200-5338-4a35-ae38-024cfb1f7e3c",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "An der Stelle der früheren Furt wurde 1844/45 eine Brücke errichtet."
                                            },
                                            {
                                                "example_id": "b1ad6eb2-e8b7-4de0-9ce2-49885cc7ee4b",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "Bevor man in der Lage war, große Brücken zu bauen, war eine Furt die einzige Möglichkeit, einen Fluss zu überqueren."
                                            },
                                            {
                                                "example_id": "3ff88dfa-aa73-4a11-bc00-64bf8d18f3ec",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "Viele Städte wuchsen an einer Furt, was sich noch immer in den Städtenamen wie Frankfurt, Ochsfurt, Schweinfurt niederschlägt."
                                            },
                                            {
                                                "example_id": "6d03693d-123c-496a-b398-83459d0c937d",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "„Rom war als Siedlungsplatz wohl deshalb besonders attraktiv, weil es an einer Furt des Tiber lag, die wichtig war für die Verbindungen zwischen dem nördlich gelegenen Etrurien und dem südlich gelegenen Kampanien, und weil hier die Salzstraße vorbeiführte, auf der dieses schon in der Frühgeschichte wichtige Mineral von den Salzbuchten an der Tibermündung ins Landesinnere geschafft wurde.“"
                                            },
                                            {
                                                "example_id": "4b781de2-4b73-4619-89dc-a21a901e3e77",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "„Wichtige Zwischenstation und Versorgungspunkt war das Lager Hedemünden an einer Furt der Werra.“"
                                            },
                                            {
                                                "example_id": "a095cc5f-23e1-4020-bd38-cbd4cb9af517",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "„Als wir endlich die zehnte Furt hinter uns hatten, befanden wir uns auf dem Hofpfad, der aber nicht zu sehen war.“"
                                            },
                                            {
                                                "example_id": "757f3ad4-ac98-4e26-b168-3c53fae61d79",
                                                "sense_id": "d078d6b6-bf09-3b99-a894-4d1565871a7f",
                                                "text": "„An die Brücke erinnerte ich mich gut, und ich wusste auch noch, dass es auf einer Seite bei Ebbe eine kleine Furt gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93189063-c948-4777-a0be-64edd4d16045",
                        "source_entry_id": "7832a6f5-28df-3079-a809-8de68a9a99e6",
                        "source_sense_description": "неглубокое, мелкое место во всю ширину реки, озера и т. п., через которое можно переходить или переезжать, передвигаясь по дну",
                        "target_lang_word": "gué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                        "entry_id": "1ae4ee6e-60aa-3369-b18a-40910f043786",
                                        "glosses": [
                                            "Endroit d’une rivière, d’un fleuve où l’eau est assez basse et le fond assez ferme pour qu’on puisse traverser à pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2d98ed-63f3-4798-beb1-f1dd773cf8db",
                                                "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                                "text": "Ces dépôts sont souvent enfouis à des points de passage obligés ou privilégiés (gués, confluences), ainsi que sur des sites de hauteur fortifiés, permettant le contrôle des voies de communication ; ils semblent ainsi servir de marqueurs au sein du territoire."
                                            },
                                            {
                                                "example_id": "26d97359-7e23-4446-b621-d09e7278f1d6",
                                                "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                                "text": "Je connais un passage à gué. On se mouille les chevilles."
                                            },
                                            {
                                                "example_id": "3d132736-3471-4891-8d21-5a5a8a891c78",
                                                "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                                "text": "C’est un vrai torrent. Il va falloir chercher un gué."
                                            },
                                            {
                                                "example_id": "4a97a34e-3e29-4ccb-b378-417f5018ed06",
                                                "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                                "text": "J’espère qu’il y a un gué en amont."
                                            },
                                            {
                                                "example_id": "c869a8df-e179-4b51-b071-69724a09c778",
                                                "sense_id": "37aa264e-473e-35a0-890f-34d95c95f17e",
                                                "text": "Passer la rivière à gué."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a94e7c11-6206-344a-a9bd-42d6b24cc83e",
                                        "entry_id": "a0dda0cb-dd8d-3200-bd0e-e24ec76a3b9c",
                                        "glosses": [
                                            "Exprime la joie dans les chansons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968e10bf-3d3e-49bd-aa28-1ea7c52725d9",
                                                "sense_id": "a94e7c11-6206-344a-a9bd-42d6b24cc83e",
                                                "text": "Il avait nom Corne d'Aurochs, ô gué! ô gué! Tout l'mond' peut pas s'app'ler Durand, ô gué! ô gué! Il avait nom Corne d'Aurochs, ô gué! ô gué! Tout l'mond' peut pas s'app'ler Durand, ô gué! ô gué!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
