                "senses": [
                    {
                        "sense_id": "b12094fc-0f3a-369c-95a7-2840e2ce3051",
                        "entry_id": "3aa1756e-add8-3348-bde0-cf3422a4923d",
                        "glosses": [
                            "Wissenschaft, die sich mit verschiedenen Formen krankhaft veränderten Bewusstseins, Erinnerungsvermögens und Gefühls- bzw. Seelenlebens beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0465a5-6ca0-4dcd-b94e-e35a8d27bede",
                                "sense_id": "b12094fc-0f3a-369c-95a7-2840e2ce3051",
                                "text": "„Aus der allgemeinen gesellschaftlichen Situation weit eher als aus der Psychopathologie ist denn wohl das Vergessen des Nationalsozialismus zu begreifen.“"
                            },
                            {
                                "example_id": "29def88d-27d3-418a-97df-091823420d5e",
                                "sense_id": "b12094fc-0f3a-369c-95a7-2840e2ce3051",
                                "text": "„Die Haltung der SPD ist eigentlich nur noch in Begriffen der klinischen Psychopathologie zu beschreiben.“"
                            },
                            {
                                "example_id": "6c2c4bfd-a349-4376-b46a-2bbcdb5421e1",
                                "sense_id": "b12094fc-0f3a-369c-95a7-2840e2ce3051",
                                "text": "„Um die Jahrhundertwende hatte Freud sich der Psychopathologie des Alltagslebens, der Traumdeutung und der sexuellem Bestimmung des Witzes zugewandt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
