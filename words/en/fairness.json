{
    "word_family": [
        "fair",
        "fairly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "421134f0-5b3b-3357-8043-35ccf9200d48",
                    "sense_definition": "The quality of treating people equally or in a way that is right or reasonable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge was praised for the <w>fairness</w> of her final decision.",
                            "target_lang_translations": {
                                "ru": "Судью похвалили за <w>справедливость</w> её окончательного решения."
                            }
                        },
                        {
                            "text": "Many citizens began to question the <w>fairness</w> of the new laws regarding taxation.",
                            "target_lang_translations": {
                                "ru": "Многие граждане начали сомневаться в <w>справедливости</w> новых налоговых законов."
                            }
                        },
                        {
                            "text": "To ensure basic <w>fairness</w> in the competition, all participants must follow the same rules.",
                            "target_lang_translations": {
                                "ru": "Чтобы обеспечить элементарную <w>честность</w> в соревновании, все участники должны следовать одним и тем же правилам."
                            }
                        }
                    ],
                    "antonyms": [
                        "unfairness",
                        "injustice"
                    ],
                    "common_phrases": [
                        "basic fairness",
                        "sense of fairness",
                        "ensure fairness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество равного отношения к людям или поведение, которое является правильным или разумным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справедливость",
                                "target_lang_sense_clarification": "соответствие морально-этическим и правовым нормам"
                            },
                            {
                                "target_lang_word": "беспристрастие",
                                "target_lang_sense_clarification": "отсутствие предубеждений и личного интереса"
                            },
                            {
                                "target_lang_word": "честность",
                                "target_lang_sense_clarification": "соблюдение правил и порядочность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bd15fdb-b792-374c-9aad-26f4ae688835",
                    "sense_definition": "The state or quality of being physically beautiful or pleasing to the eye.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote extensively about the <w>fairness</w> of the lady's complexion.",
                            "target_lang_translations": {
                                "ru": "Поэт много писал о <w>красоте</w> цвета лица этой дамы."
                            }
                        },
                        {
                            "text": "The natural <w>fairness</w> of the valley was preserved despite the nearby construction.",
                            "target_lang_translations": {
                                "ru": "Природная <w>красота</w> долины сохранилась, несмотря на стройку неподалеку."
                            }
                        }
                    ],
                    "synonyms": [
                        "beauty",
                        "fairhood"
                    ],
                    "antonyms": [
                        "ugliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to describe beauty"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество физической красоты или внешней привлекательности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красота",
                                "target_lang_sense_clarification": "внешняя привлекательность"
                            },
                            {
                                "target_lang_word": "прелесть",
                                "target_lang_sense_clarification": "очарование или изящество"
                            },
                            {
                                "target_lang_word": "светлость",
                                "target_lang_sense_clarification": "о цвете кожи или волос"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}