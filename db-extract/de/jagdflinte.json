                "senses": [
                    {
                        "sense_id": "8cbbc038-fcfe-3992-9795-0165c6ab5bc1",
                        "entry_id": "addcd0b6-24b4-3b5d-8d5d-8d6f3872797b",
                        "glosses": [
                            "Flinte, die zur Jagd verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f906a8e-5517-487c-9714-d15e71526d8b",
                                "sense_id": "8cbbc038-fcfe-3992-9795-0165c6ab5bc1",
                                "text": "„Bei diesem Köder biss er an und sagte, ich solle die Jagdflinte an Bord bringen und sie ihm zeigen.“"
                            },
                            {
                                "example_id": "cf847fc2-39e8-425f-97c8-0ac82c6484fd",
                                "sense_id": "8cbbc038-fcfe-3992-9795-0165c6ab5bc1",
                                "text": "„Auf derselben Seite hing ein Karabiner von amerikanischer Arbeit und daneben ein zweiter sehr schön gearbeiteter doppelläufiger Stutzen und eine Jagdflinte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "600d2fa3-0d2e-4d70-b83e-cd07e24b3e06",
                        "source_entry_id": "addcd0b6-24b4-3b5d-8d5d-8d6f3872797b",
                        "source_sense_id": "8cbbc038-fcfe-3992-9795-0165c6ab5bc1",
                        "source_sense_description": "Flinte, die zur Jagd verwendet wird",
                        "target_lang_word": "fusil de chasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusil de chasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d49f739-54a7-31db-a3b1-449b5d3b003f",
                                        "entry_id": "93ea5724-c5b0-35e8-9881-97f68bbb7e46",
                                        "glosses": [
                                            "Fusil destiné à la chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b4ae4e-2be8-40c2-a7f6-3901e48d3710",
                                                "sense_id": "9d49f739-54a7-31db-a3b1-449b5d3b003f",
                                                "text": "Quoi qu’il en soit, je dirai cependant qu’en général tous les canons des fusils de chasse n’ont à cet égard aucun avantage les uns sur les autres ; et je le dirai d’après des épreuves multipliées que j’ai faites pour m’en assurer."
                                            },
                                            {
                                                "example_id": "846cd7ee-bab5-4103-b9d7-8282624b4c40",
                                                "sense_id": "9d49f739-54a7-31db-a3b1-449b5d3b003f",
                                                "text": "Une des causes qui contribuèrent le plus efficacement à répandre le fusil de chasse, ce fut l’invention de la grenaille de plomb."
                                            },
                                            {
                                                "example_id": "210ad23c-19be-41ed-bffd-af1451dd85f5",
                                                "sense_id": "9d49f739-54a7-31db-a3b1-449b5d3b003f",
                                                "text": "Il marchait le buste projeté en avant sur son bassin rompu comme si le poids du fusil de chasse à deux canons qu’il portait sur une épaule l’écrasait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
