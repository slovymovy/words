                        "glosses": [
                            "Like a yeoman: stout and true."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e05eb85-2074-4f2a-b0bd-3492f2698991",
                                "sense_id": "d915afdb-21f4-35dc-a588-901a6dbe04ca",
                                "text": "“Say as thou list, Wamba,” replied the Knight, “these yeomen did thy master Cedric yeomanly service at Torquilstone.”"
                            },
                            {
                                "example_id": "3686e0f1-2714-4703-bf57-1d2ee89f899b",
                                "sense_id": "d915afdb-21f4-35dc-a588-901a6dbe04ca",
                                "text": "[…] it was almost as if he were back at Wethermel, so yeomanly and free seemed all about him."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eac4abf-05e2-3f25-a467-a11ed9a5e9be",
                        "entry_id": "14dfc964-b2d9-302f-8988-c77c187c7f9a",
                        "glosses": [
                            "Of or proper to the class of yeomen in British history"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a62c52-3464-4f91-aa58-dc63e186977f",
                                "sense_id": "8eac4abf-05e2-3f25-a467-a11ed9a5e9be",
                                "text": "Judge Abbott is, therefore, of good yeomanly pedigree."
                            },
                            {
                                "example_id": "70d97260-f176-4e58-8b33-ab99b93c1f4e",
                                "sense_id": "8eac4abf-05e2-3f25-a467-a11ed9a5e9be",
                                "text": "Her name was Anne Bowden; and she was of a respectable family, that had been long stationary in Devonshire, but of a yeomanly rank[…]."
                            }
                        ]
                    }
