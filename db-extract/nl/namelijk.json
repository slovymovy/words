                    {
                        "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                        "entry_id": "349e51b0-0478-3de4-9e3a-ba2d53f58da5",
                        "glosses": [
                            "met name genoemd: luidt een nadere precisering in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3551edd2-0162-48d6-aad9-391835f20b4a",
                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                "text": "Ook woorden in het Lezgi zijn op WikiWoordenboek te vinden. Het is namelijk een meertalig woordenboek."
                            },
                            {
                                "example_id": "bc385567-5e33-4222-a4a1-720cc3777333",
                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                "text": "Vanaf de late achttiende eeuw werd (Griekse) lichaamsoefening namelijk gezien als een razend relevante manier om de volksgezondheid én het nationale gevoel te bevorderen."
                            },
                            {
                                "example_id": "9cdd3fb1-30bb-465f-aafa-e75d792bae90",
                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                "text": "Er zou die dag namelijk pas na 32 kilometer water te vinden zijn, waardoor ik zeven liter water boven op mijn basisuitrusting mee moest sjouwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7614eba0-926e-4b3c-876f-040bfa9abec3",
                        "source_entry_id": "349e51b0-0478-3de4-9e3a-ba2d53f58da5",
                        "source_sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                        "target_lang_word": "nämlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nämlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f42c25ce-df00-35b0-a7ee-6f590b0444a4",
                                        "entry_id": "5bd09a5a-e265-3a25-bbef-faa3c390f502",
                                        "glosses": [
                                            "der-, die-, dasselbe"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5f4b30-7851-48d1-9b6a-8808ffa399d2",
                                                "sense_id": "f42c25ce-df00-35b0-a7ee-6f590b0444a4",
                                                "text": "Die Zeitung kommt jeden Morgen zur nämlichen Zeit."
                                            },
                                            {
                                                "example_id": "32ad1e0f-8fb9-499a-9e5d-0be1b3443e03",
                                                "sense_id": "f42c25ce-df00-35b0-a7ee-6f590b0444a4",
                                                "text": "„Von da tauchen sie [die Flüsse] nun wieder unter die Erde und, teils längere und mehrere Gegenden durchziehend, teils wenigere und kürzere, ergießen sie sich alle wieder in den Tartaros, einige viel weiter unten, als wo sie ausgepumpt wurden, andere nicht so viel, aber unterhalb ihres Ausflusses fließen sie alle ein; und einige strömen wieder aus, gerade gegenüber der Stelle, wie sie eingeflossen sind, andere auf der nämlichen Seite.“"
                                            },
                                            {
                                                "example_id": "c72c793a-1b1a-4d94-b3ea-45945be8c65d",
                                                "sense_id": "f42c25ce-df00-35b0-a7ee-6f590b0444a4",
                                                "text": "„Mit demselben, etwas bunt zusammen gewürfelten Programm wie damals und am nämlichen Ort, natürlich in verjüngter Besetzung, feierten die Festwochen nun ihren Geburtstag – und wiesen dabei auch ungewollt nach, dass die Beschäftigung mit Alter Musik immer noch ein Abenteuer sein kann.“"
                                            },
                                            {
                                                "example_id": "00038021-03be-4fd1-bb99-d6bf0288e3f8",
                                                "sense_id": "f42c25ce-df00-35b0-a7ee-6f590b0444a4",
                                                "text": "„In der jetzigen Ausstellung am nämlichen Ort behandelt der Maler dieselben Motive - doch wie haben sie sich verändert: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "nämlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c064889-b2e4-3429-ad24-0b0dcfb4fcf0",
                                        "entry_id": "19a0a5cf-6652-3165-b684-911a9cd3c014",
                                        "glosses": [
                                            "Konjunktionaladverb:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78369ef6-d0c4-31a4-ab97-9b57e9b75b19",
                                        "entry_id": "19a0a5cf-6652-3165-b684-911a9cd3c014",
                                        "glosses": [
                                            "und zwar"
                                        ],
                                        "tags": [
                                            "als nähere Erläuterung einer Tatsache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098ec091-a38a-4033-ba4d-5399b09e7648",
                                                "sense_id": "78369ef6-d0c4-31a4-ab97-9b57e9b75b19",
                                                "text": "Es gibt vier Jahreszeiten, nämlich Frühling, Sommer, Herbst und Winter."
                                            },
                                            {
                                                "example_id": "067a7f6e-b662-4784-88be-56b1e803370f",
                                                "sense_id": "78369ef6-d0c4-31a4-ab97-9b57e9b75b19",
                                                "text": "„Tautologie und Kontradiktion sind die Grenzfälle der Zeichenverbindung, nämlich ihre Auflösung.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bd496c1-ac21-37d5-b395-ff6a8e1503c9",
                                        "entry_id": "19a0a5cf-6652-3165-b684-911a9cd3c014",
                                        "glosses": [
                                            "Kausale Konjunktion oder Adverb (vgl. Anmerkung):"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc7e10dd-ee77-3e12-a6c1-0ec31525e000",
                                        "entry_id": "19a0a5cf-6652-3165-b684-911a9cd3c014",
                                        "glosses": [
                                            "als betonendes Füllwort: tatsächlich; bekanntlich"
                                        ],
                                        "tags": [
                                            "als nachgestellte Begründung für eine Aussage",
                                            "die dem Zuhörer bereits bekannt ist"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44776dd6-a321-4aa7-8cf6-df4e9fdfa49a",
                                                "sense_id": "bc7e10dd-ee77-3e12-a6c1-0ec31525e000",
                                                "text": "„Tautologie und Kontradiktion sind die Grenzfälle der Zeichenverbindung, nämlich ihre Auflösung.\""
                                            },
                                            {
                                                "example_id": "8a098b04-55ea-4c82-a054-c6c2465e6f2d",
                                                "sense_id": "bc7e10dd-ee77-3e12-a6c1-0ec31525e000",
                                                "text": "Wir können jetzt keinen Spargel essen. Den gibt es nämlich nur im Frühsommer."
                                            },
                                            {
                                                "example_id": "bf0e1d58-414f-4b50-8bcd-3cf055d89a37",
                                                "sense_id": "bc7e10dd-ee77-3e12-a6c1-0ec31525e000",
                                                "text": "„Ich hatte nämlich bereits als Kind meine feste Vorstellung von Braunschweig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "349adad2-462f-4764-a1ff-2954515107d3",
                        "source_entry_id": "349e51b0-0478-3de4-9e3a-ba2d53f58da5",
                        "source_sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                        "target_lang_word": "namely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                        "entry_id": "b55cbb72-25fd-30df-bd05-5e16d01dece0",
                                        "glosses": [
                                            "Specifically; that is to say."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ff4b06-e13c-4e36-a2f7-f4f9df423511",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "Some of the students — namely Paul, Alice and Jake — seem to have trouble with geometry."
                                            },
                                            {
                                                "example_id": "9daca0a9-68f9-43bb-8c35-8b6078b59fd4",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "There are three ways to do it, namely the right way, the wrong way and the Army way."
                                            },
                                            {
                                                "example_id": "cb702b38-eb90-4230-b87f-6dc92dc4dec1",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached ; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1051f77a-d4e3-3579-8f54-4237fb34779c",
                                        "entry_id": "b55cbb72-25fd-30df-bd05-5e16d01dece0",
                                        "glosses": [
                                            "Especially, above all."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95823bf1-8353-45dd-b250-8ebef2f89d6f",
                                                "sense_id": "1051f77a-d4e3-3579-8f54-4237fb34779c",
                                                "text": "THus was sir Tramtryst longe there wel cherysshed / with the kynge and the quene / and namely with la beale Isoud / So vpon a daye / the quene and la beale Isoud made a bayne for syre Tramtryst / And whan he was in his bayne / the quene and Isoud her doughter romed vp & doune in the chamber"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "namely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "181720d5-4045-3be6-a69b-4ba37d3381e1",
                                        "entry_id": "8d980857-0711-3064-88fc-74acc4081e0f",
                                        "glosses": [
                                            "Notable, distinguished; famous, renowned; well-known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d479afe1-4b49-4f78-a25a-b335d263de36",
                                                "sense_id": "181720d5-4045-3be6-a69b-4ba37d3381e1",
                                                "text": "[…] and certainly there was no namelier king in Scotland for building churches and developing the communities of the land into free towns or burghs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d069d85-7d20-44ba-8ef5-22f62702b973",
                        "source_entry_id": "349e51b0-0478-3de4-9e3a-ba2d53f58da5",
                        "source_sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                        "target_lang_word": "à savoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à savoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8009a0f5-3c97-3bf3-89e8-9e70d37e458a",
                                        "entry_id": "8141bd65-a01f-3c94-b052-eec2292adc50",
                                        "glosses": [
                                            "C’est-à-dire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "note": "Il est alors suivi de la conjonction de subordination que",
                                        "examples": [
                                            {
                                                "example_id": "da6f8060-da0d-4286-aeef-87436e3cceb8",
                                                "sense_id": "8009a0f5-3c97-3bf3-89e8-9e70d37e458a",
                                                "text": "À toutes ces expériences, la physiologie positive gagna deux grandes vérités, à savoir que certains animaux peuvent, comme les plantes, se reproduire par boutures et par bourgeons."
                                            },
                                            {
                                                "example_id": "bd9b419e-c170-4892-bafd-fcfac2d5a3ec",
                                                "sense_id": "8009a0f5-3c97-3bf3-89e8-9e70d37e458a",
                                                "text": "Cette particularité semble confirmer nettement l'interprétation que donne l'éminent phytosociologue de Zurich, à savoir que le fauchage est défavorable aux Thérophytes."
                                            },
                                            {
                                                "example_id": "ad0d6d60-08db-4949-98e5-d797ab4fcd92",
                                                "sense_id": "8009a0f5-3c97-3bf3-89e8-9e70d37e458a",
                                                "text": "Le terme de \"petite-bourgeoisie\" a longtemps fonctionné comme notion stigmatisante, à savoir une accusation portée sur un groupe social qui dans son mode de vie tendait beaucoup à copier le mode de vie \"bourgeois\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3c1415-6f79-3336-96d1-15357457b690",
                                        "entry_id": "8141bd65-a01f-3c94-b052-eec2292adc50",
                                        "glosses": [
                                            "Locution dont on se sert pour spécifier les choses dont il s’agit et est suivie d’une énumération."
                                        ],
                                        "tags": [],
                                        "note": "S'il s'agit d'une longue énumération, la locution est alors suivie d'un deux-points (:",
                                        "examples": [
                                            {
                                                "example_id": "a9b6b620-1ff0-4959-a811-e74f656d2bdb",
                                                "sense_id": "3d3c1415-6f79-3336-96d1-15357457b690",
                                                "text": "On a vendu pour dix mille francs de meubles ; à savoir : deux tapisseries pour cinq mille francs et le reste pour la même somme, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cc0d56-2527-3c78-a689-816fac5b8163",
                                        "entry_id": "8141bd65-a01f-3c94-b052-eec2292adc50",
                                        "glosses": [
                                            "On s’en sert aussi pour marquer qu’on doute de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6485283e-f5d8-4a8f-b4cc-3f5f97480428",
                                                "sense_id": "e3cc0d56-2527-3c78-a689-816fac5b8163",
                                                "text": "Vous me dites qu’ils contribueront tous également à cette affaire, à savoir si vous en serez approuvé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
