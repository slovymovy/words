                                "sense_id": "b398f1a6-aec5-3737-bedc-44c1d2d0053b",
                                "text": "La compression des esprits."
                            },
                            {
                                "example_id": "86b9c6a3-4347-41fe-a511-013d8cadae1f",
                                "sense_id": "b398f1a6-aec5-3737-bedc-44c1d2d0053b",
                                "text": "Une compression rigoureuse succéda à une liberté excessive."
