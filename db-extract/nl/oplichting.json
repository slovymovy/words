                                "target_senses": [
                                    {
                                        "sense_id": "833caad6-1730-347e-abc7-7fcbd42edbf0",
                                        "entry_id": "ab999ca5-679f-33ab-99e5-098976c37548",
                                        "glosses": [
                                            "Action d’escroquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac5c2a0-621b-48cc-9124-a7e5d4c9e4b1",
                                                "sense_id": "833caad6-1730-347e-abc7-7fcbd42edbf0",
                                                "text": "Il était au courant de toutes les escroqueries classiques."
                                            },
                                            {
                                                "example_id": "a34999d1-08f4-4a17-89ac-b75efa0a6d2f",
                                                "sense_id": "833caad6-1730-347e-abc7-7fcbd42edbf0",
                                                "text": "« Honnêtement, ça relève du Ponzi », a lâché Gabriel Attal en référence au schéma d’escroquerie des pyramides de Ponzi."
                                            },
                                            {
                                                "example_id": "73236050-a3ad-4772-9729-deb4a9542513",
                                                "sense_id": "833caad6-1730-347e-abc7-7fcbd42edbf0",
                                                "text": "Acheter une semaine d’occupation par an dans une belle résidence au bord de la mer, pendant 99 ans ? C’est le principe du « timeshare » (immobilier en jouissance à temps partagé), qui a donné lieu à de nombreuses escroqueries."
                                            },
                                            {
                                                "example_id": "1fda88ed-6870-45d9-a7ca-ada69a2a63c4",
                                                "sense_id": "833caad6-1730-347e-abc7-7fcbd42edbf0",
                                                "text": "« Son mari n’est pas revenu » et Masha a intenté un procès pour escroquerie à la voyante pour récupérer son argent. Mais lors de l’audience, elle avoue au juge ne pas avoir accompli le rituel correctement faute de godemichet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811ba71d-3ffc-3934-94a2-a8d737a4221d",
                                        "entry_id": "ab999ca5-679f-33ab-99e5-098976c37548",
                                        "glosses": [
                                            "Vol commis par des moyens frauduleux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f66e617-756c-4f3c-8a33-1201957e3fe3",
                                                "sense_id": "811ba71d-3ffc-3934-94a2-a8d737a4221d",
                                                "text": "C'est dans un café là-bas que l’agent Rainblot prétend avoir entendu les deux youps qui causaient de l’affaire d’escroquerie... cette femme Wasserman qui remontait de Lyon..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
