                ],
                "senses": [
                    {
                        "sense_id": "91fdabdc-89a1-33f9-aa3f-38d388e93bac",
                        "entry_id": "1331f303-444f-32cd-b2f4-0eee0b668034",
                        "glosses": [
                            "Atome d’hydrogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04b3ddc-7b99-460d-bc73-b62dac8f4a1c",
                                "sense_id": "91fdabdc-89a1-33f9-aa3f-38d388e93bac",
                                "text": "Gewöhnliches Wasser besteht aus zwei Wasserstoffatomen und einem Atom Sauerstoff; in schwerem Wasser tritt an die Stelle des Wasserstoffs dessen Isotop Deuterium.",
                                "translation": "L’eau ordinaire est composée de deux atomes d’hydrogène et d’un atome d’oxygène ; dans l’eau lourde, l’hydrogène est remplacé par son isotope, le deutérium."
                            },
                            {
                                "example_id": "82e895ba-f667-442f-a27b-bcd5da72e36c",
                                "sense_id": "91fdabdc-89a1-33f9-aa3f-38d388e93bac",
                                "text": "Das Wasserstoffatom ist das einfachste mögliche Atom: Es besteht aus einem einfach geladenen Kern und einem einzelnen Elektron.",
                                "translation": "L’atome d’hydrogène est l’atome le plus simple qu’il existe : il est composé d’un noyau à charge unique et d’un seul électron."
                            }
                        ]
                    }
                ],
