                "senses": [
                    {
                        "sense_id": "05d23604-2efa-3233-bdec-d734b438a0e7",
                        "entry_id": "caa66008-7546-3515-92f1-265b7ba2c0f4",
                        "glosses": [
                            "Überprüfungsmethode (Test), die bei allen/vielen Personen/Produkten/Datensätzen einer Gesamtheit durchgeführt wird"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "a09e586d-0956-4105-a541-cb07000fada8",
                                "sense_id": "05d23604-2efa-3233-bdec-d734b438a0e7",
                                "text": "„Im Kampf gegen die Corona-Pandemie haben in Moskau neue Massentests auf Antikörper begonnen. Damit will Europas größte Metropole einen besseren Überblick über den Verlauf des Ausbruchs bekommen.“"
                            },
                            {
                                "example_id": "f4e5102f-7c98-4214-94d5-a4b61194f75e",
                                "sense_id": "05d23604-2efa-3233-bdec-d734b438a0e7",
                                "text": "„Mit diesem Pendelschlagwerk können gegenüber der bisher üblichen Methode Massentests mit ausreichender Genauigkeit und in dem für die praktische Pflanzenzüchtung notwendigen Umfang durchgeführt werden.“"
                            },
                            {
                                "example_id": "030cdab4-901c-4da4-8322-7594aa6badf0",
                                "sense_id": "05d23604-2efa-3233-bdec-d734b438a0e7",
                                "text": "„Problem: Aufgrund der Komplexität der Stammdatenstrukturen war es nicht möglich kritische Prozesse (Zahlungsprozesse; Rechnungsdatenübernahme) mit Massentests im Testsystem zu testen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
