                    {
                        "translation_id": "93e29b43-e98d-48e8-9e60-d6c46fb845c8",
                        "source_entry_id": "a9207368-2782-3883-94b5-21ccff42d3b7",
                        "source_sense_id": "775d08d1-72c9-3d99-ad0d-a8a276671d20",
                        "source_sense_description": "abwertend: unbedeutende Zeitung mit kleiner Auflage und vermutlich geringer Qualität",
                        "target_lang_word": "feuille de chou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuille de chou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe0c438d-062c-302e-bec6-02e599207cf7",
                                        "entry_id": "4f10db42-ea2f-36b9-af10-6e8f6720a85a",
                                        "glosses": [
                                            "Journal, souvent de mauvaise qualité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742dd71c-eafe-4208-9609-7337aeda67b0",
                                                "sense_id": "fe0c438d-062c-302e-bec6-02e599207cf7",
                                                "text": "Le monstre du Loch Ness ne faisant plus recette\nDurant les moments creux dans certaines gazettes,\nSystématiquement, les nécrologues jouent\nA me mettre au linceul sous des feuilles de chou."
                                            },
                                            {
                                                "example_id": "ea7cf310-8490-4c95-93a1-fcd002684767",
                                                "sense_id": "fe0c438d-062c-302e-bec6-02e599207cf7",
                                                "text": "À l'ouverture de la salle, une petite feuille de chou intitulée Qu’est-ce que c’est ? est donc imprimée et distribuée gratuitement dans la ville."
                                            },
                                            {
                                                "example_id": "dd04067c-4a77-47ba-89af-9e0c7fcc2da1",
                                                "sense_id": "fe0c438d-062c-302e-bec6-02e599207cf7",
                                                "text": "Un bonhomme qui a commencé dans une feuille de chou, à Saint-Étienne."
                                            },
                                            {
                                                "example_id": "c6d04d2b-892a-437e-a2aa-10e4a4f26f56",
                                                "sense_id": "fe0c438d-062c-302e-bec6-02e599207cf7",
                                                "text": "Ou qu'il passe la frontière, n'est-ce pas? C'est alors que les feuilles de choux s'en donneront à cœur joie..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
