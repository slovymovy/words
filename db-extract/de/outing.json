                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                        "entry_id": "6be0aa13-8033-3db0-bac9-84751ede5742",
                                        "glosses": [
                                            "Fait de révéler l’orientation sexuelle et/ou l’identité de genre d’une personne sans ou contre son avis."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ba07e9-2cad-47a3-aa69-37e1df38fd34",
                                                "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                                "text": "Act-up avait menacé d'outing (révélation contre son gré de son homosexualité) un député d'opposition ayant participé à la manifestation organisée contre le Pacs du 31 janvier à Paris, estimant que ce rassemblement avait «été le théâtre d'une haine antihomosexuelle d'une rare violence»."
                                            },
                                            {
                                                "example_id": "f92e9be6-80da-4825-b19a-be9463978607",
                                                "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                                "text": "« On retrouve également des personnes de la communauté LGBT+, qui ont souvent été victimes d’outing [le fait de révéler l’orientation sexuelle de quelqu’un sans son consentement] », ajoute Juliette Sanchez-Lambert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "870e8fc1-d3ad-45da-a90a-776733a79944",
                        "source_entry_id": "a49f7afc-240c-3415-a66a-4693c8fb66b0",
                        "source_sense_id": "e3216859-0234-3f98-b8c9-ece081b71674",
                        "source_sense_description": "Fremdenthüllung (insbesondere der Homosexualität)",
                        "target_lang_word": "outing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "227083f4-90d2-39e3-be45-13f6a5e2d77e",
                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "A pleasure trip or excursion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1ebb3c-86ab-4def-bfde-84c9d04cf34e",
                                                "sense_id": "227083f4-90d2-39e3-be45-13f6a5e2d77e",
                                                "text": "This was a fine day's outing for anybody who had been cooped up in the shops for a few months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "A performance in public, for example in a drama, film, on a musical album, as a sports contestant etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a8e216-900d-4ebe-b721-50bf52211c23",
                                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                                "text": "The role is the latest dramatic outing for Radcliffe since the end of the successful Potter franchise."
                                            },
                                            {
                                                "example_id": "3c349553-2181-4623-a661-7fd8acd61663",
                                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                                "text": "Other erstwhile stalwarts are also wavering. Southampton had two of the best full-backs in the league last season but Ryan Bertrand has been below par this season and Cédric Soares made an uncharacteristic lapse that led to Stoke’s winning goal in Southampton’s last outing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7d6a1c-525e-3631-8027-2366287cdc90",
                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "The act of publicly revealing that a person is homosexual or transgender without that person's consent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e2121b-7f7c-4cb0-bdea-3c0345fe47ae",
                                                "sense_id": "9d7d6a1c-525e-3631-8027-2366287cdc90",
                                                "text": "Advocates for gay and lesbian issues suggest the increase in discharges reflects the hostility of the military towards homosexual soldiers and a growing number of \"forced outings\" of gay and lesbian troops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fae3da9-551b-3a1d-814e-ee6f248d1878",
                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "The act of revealing somebody as having a certain secret, such as a being a secret agent or undercover detective."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
