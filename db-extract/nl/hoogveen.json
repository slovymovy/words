                    {
                        "sense_id": "f960acf6-a772-33e7-bff2-ea537be4fce2",
                        "entry_id": "0f3e7256-2340-3725-8a5a-e40486a9225c",
                        "glosses": [
                            "boven de waterspiegels gevormd veen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3dd291a-9573-4c25-b8c2-a0e0b2493ebb",
                                "sense_id": "f960acf6-a772-33e7-bff2-ea537be4fce2",
                                "text": "De laatste resten hoogveen van Nederland bescherm je niet door dammen te slaan en daarmee te verhinderen dat regenwater wegstroomt uit het gebied. „Daarmee gaan veel natuurwaarden verloren”, zegt ecoloog Wilco Verberk van de Radboud Universiteit in Nijmegen en van Stichting Bargerveen, een kennisinstituut voor natuurherstel."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bcf37e5-eed4-33c7-b769-487c0be8a580",
                        "entry_id": "0f3e7256-2340-3725-8a5a-e40486a9225c",
                        "glosses": [
                            "gebied waar veel hoogveen aanwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1c17a5-c38e-43d8-a230-f57cb541f044",
                                "sense_id": "4bcf37e5-eed4-33c7-b769-487c0be8a580",
                                "text": "Het Fochteloërveen is een hoogveengebied van ongeveer tweeduizend hectare, waarvan het grootste deel zich in Drenthe bevindt. De rest (bijna even groot) is van Friesland. Het gebied is in 1939 aangekocht door de Vereniging Natuurmonumenten, die er sinds die tijd voor probeert te zorgen dat het hoogveen blijft leven. Dat wil zeggen dat het veenpakket, dat in de kern van het reservaat ongeveer twee meter dik is, kan aangroeien."
                            }
                        ]
                    }
