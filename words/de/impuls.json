                },
                {
                    "sense_id": "c7453801-7973-3b7a-b1a4-44e71d0559fb",
                    "sense_definition": "kurzzeitige zeitliche Änderung einer elektrischen Größe wie Spannung oder Stromstärke",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Sensor sendet bei jeder Bewegung einen kurzen elektrischen <w>Impuls</w> an die Zentrale."
                        },
                        {
                            "text": "Nervenzellen leiten eingehende <w>Impulse</w> mit hoher Geschwindigkeit an das Gehirn weiter."
