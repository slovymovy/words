                    {
                        "sense_id": "01ee304a-3619-3908-a882-046aed7a67ef",
                        "entry_id": "3696cff4-e9e7-3bd2-8cff-ad10a928957c",
                        "glosses": [
                            "The appearance of red or purple discolorations on the skin that do not blanch when pressure is applied, caused by subdermal bleeding."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
