                                "target_senses": [
                                    {
                                        "sense_id": "ec306bb7-aa29-344e-b67c-edfe02940c7e",
                                        "entry_id": "a5d796c4-6c29-3a67-93a6-f451713352c7",
                                        "glosses": [
                                            "kleines Nagetier, das mit den Meerschweinchen verwandt ist und in Mittel- und Südamerika vorkommt, Vertreter der Dasyproctidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e9e541-eb58-49b2-ba2c-57c54597042c",
                                                "sense_id": "ec306bb7-aa29-344e-b67c-edfe02940c7e",
                                                "text": "Das Aguti hat eisenstarke Zähne und kann Paranüsse knacken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
