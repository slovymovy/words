                        "refus",
                        "rejet",
                        "résistance"
                    ],
                    "antonyms": [
                        "adhésion",
                        "consentement"
                    ],
                    "common_phrases": [
                        "en révolte contre"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27f1f905-8ef0-3072-8dff-5005ce99fab4",
                    "sense_definition": "Troisième personne du singulier de l'indicatif présent de <w>révolter</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
