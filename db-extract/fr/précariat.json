        "fr-extract.jsonl": [
            {
                "entry_id": "492c2de0-3fa5-352d-87a4-7d60995d7b13",
                "word": "précariat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad62424d-41c8-4274-aa8a-67fc54ee2533",
                        "entry_id": "492c2de0-3fa5-352d-87a4-7d60995d7b13",
                        "tags": [
                            "plural"
                        ],
                        "form": "précariats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efb4aead-0dbe-3e48-bceb-254972326c59",
                        "entry_id": "492c2de0-3fa5-352d-87a4-7d60995d7b13",
                        "glosses": [
                            "Classe constitué de personnes en situation d’emploi instable, de sous-emploi ou de chômage, caractérisé par la précarité des conditions de travail et de vie, et parfois envisagé comme une nouvelle classe sociale distincte du prolétariat."
                        ],
                        "tags": [
                            "Sociologie du travail",
                            "Économie du travail"
                        ],
                        "examples": [
                            {
                                "example_id": "f80f6857-dab0-4c67-a133-18bf0d07dfb9",
                                "sense_id": "efb4aead-0dbe-3e48-bceb-254972326c59",
                                "text": "Alors que le chômage explose en Europe, en particulier chez les jeunes, la notion de précariat, contraction de précarité et de prolétariat, devient de plus en plus d’actualité."
                            },
                            {
                                "example_id": "1934b93b-05b5-423f-a162-428ba760d6f9",
                                "sense_id": "efb4aead-0dbe-3e48-bceb-254972326c59",
                                "text": "La différence est que là où dans les années 90 ce besoin de « nouveaux serviteurs » se traduisait par le développement d’emplois précaires, mais encore salariés, il débouche aujourd’hui sur la montée d’un précariat ubérisé sous la forme de ces « faux indépendants » livrés à la para-subordination des plateformes."
                            },
                            {
                                "example_id": "82e2f703-f736-4d03-9bb8-3ba2dbf8763d",
                                "sense_id": "efb4aead-0dbe-3e48-bceb-254972326c59",
                                "text": "Dès lors, la formation de la nouvelle classe du « précariat » n'a pas lieu. À ce jour, ni un potentiel d'action ni une conscience de classe n'ont mobilisé les masses. Il existe moins un précariat qu'une multitude de « précariats »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b69ce73-0bd2-40b1-ba6a-01127f67e48d",
                        "source_entry_id": "492c2de0-3fa5-352d-87a4-7d60995d7b13",
                        "source_sense_id": "efb4aead-0dbe-3e48-bceb-254972326c59",
                        "target_lang_word": "Prekariat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prekariat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf7aca7-0b35-333f-b7c0-b4aa843f5f8e",
                                        "entry_id": "16e91697-c96c-3c3b-9253-6fd1c7d8fb15",
                                        "glosses": [
                                            "Gesellschaftsschicht der Menschen mit prekären Lebensbedingungen, die also in ungesicherten Arbeitsverhältnissen leben und wenig Hoffnung in die Zukunft haben"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a8fca4-c1c7-4b94-94bc-0cdd8760f587",
                                                "sense_id": "bdf7aca7-0b35-333f-b7c0-b4aa843f5f8e",
                                                "text": "Immer mehr Menschen gehören zum Prekariat."
                                            },
                                            {
                                                "example_id": "f5489fd6-e123-4a44-8b32-55d3d02f9eeb",
                                                "sense_id": "bdf7aca7-0b35-333f-b7c0-b4aa843f5f8e",
                                                "text": "„Der sprichwörtliche Klempner kann in Deutschland reich werden, und jemand mit Abitur kann im »Prekariat« landen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
