                "senses": [
                    {
                        "sense_id": "6f2c3d85-17ae-3b4f-b7df-17b2199f9c2b",
                        "entry_id": "637f4d5f-ed01-3c39-93f9-730667c82029",
                        "glosses": [
                            "jemand, der eine Fabrik besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4438a611-5ad7-4341-b15d-b19651a13e58",
                                "sense_id": "6f2c3d85-17ae-3b4f-b7df-17b2199f9c2b",
                                "text": "Der Fabrikbesitzer verhandelte mit den Gewerkschaftsvertretern über die Lohnforderungen."
                            },
                            {
                                "example_id": "5f8011c2-fa73-4b83-a66b-5b3bb0728dce",
                                "sense_id": "6f2c3d85-17ae-3b4f-b7df-17b2199f9c2b",
                                "text": "„Sogar jüdische Fabrikbesitzer beschäftigten lieber gojische Arbeiterinnen.“"
                            },
                            {
                                "example_id": "536fbcaf-146e-49b7-8a58-f3eb484d4253",
                                "sense_id": "6f2c3d85-17ae-3b4f-b7df-17b2199f9c2b",
                                "text": "„Noch nie hatte der reiche Fabrikbesitzer das Heim des Richters betreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
