                "senses": [
                    {
                        "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                        "entry_id": "ce8d1f7e-084c-37ff-9384-c7f485d418d4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6f7297-afd3-4958-b9f1-b0a813c7d8d0",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Frau Schäferle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7303c888-5d67-4659-bebe-84df3545aab4",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Herr Schäferle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d0d1a25a-a808-4442-9b6d-6f8a2766b11d",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Die Schäferles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0b789e2c-16e6-4caa-8eeb-166d1e7f502b",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Der Schäferle trägt nie die Pullover, die die Schäferle ihm strickt."
                            },
                            {
                                "example_id": "ba3114a8-2285-4aeb-b45f-c7c0409f0c49",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schäferle kommt, geht der Herr Schäferle.“"
                            },
                            {
                                "example_id": "174e8ee0-b820-41c2-a0ed-3be468a8821a",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Schäferle kommt und geht."
                            },
                            {
                                "example_id": "f8efc22a-598b-4bee-9758-fd8c7eee0de3",
                                "sense_id": "59b8fe1b-6bd3-3556-9f42-82cce7f7eaba",
                                "text": "Schäferles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
