        "nl-extract.jsonl": [
            {
                "entry_id": "015d5401-dd25-3ac8-b357-6436c392c149",
                "word": "outcast",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b2bba604-85c7-403f-b61f-d34aba9f7b6c",
                        "entry_id": "015d5401-dd25-3ac8-b357-6436c392c149",
                        "tags": [
                            "plural"
                        ],
                        "form": "outcasts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cfacaf6-bd24-3cbe-8a2f-c83a5d7ff464",
                        "entry_id": "015d5401-dd25-3ac8-b357-6436c392c149",
                        "glosses": [
                            "iemand die uit de normale samenleving is gestoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10bc17e3-5806-42b2-a44c-f1f67b9da659",
                                "sense_id": "5cfacaf6-bd24-3cbe-8a2f-c83a5d7ff464",
                                "text": "Als er door mijn werk al een lijn loopt, is het de poging om in je medium steeds weer een outcast te worden.’"
                            },
                            {
                                "example_id": "bd76b728-6f8e-49b8-9818-1a78541afedc",
                                "sense_id": "5cfacaf6-bd24-3cbe-8a2f-c83a5d7ff464",
                                "text": "Je kunt meer, maar je past je aan. Netjes. Maar dat conformisme is tegenwoordig in het bedrijfsleven een scheldwoord. Ondernemingen zoeken outcasts, rebellen, authentieke ik-pas-mij-niet-aan types. Mensen die buiten de lijntjes durven kleuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0f33754-aec0-43ff-b90c-7413ea5af28e",
                        "source_entry_id": "015d5401-dd25-3ac8-b357-6436c392c149",
                        "source_sense_id": "5cfacaf6-bd24-3cbe-8a2f-c83a5d7ff464",
                        "source_sense_description": "iemand die uit de normale samenleving is gestoten",
                        "target_lang_word": "outcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                        "entry_id": "1922064f-fa7a-3145-b0ce-60ddefb41e6d",
                                        "glosses": [
                                            "To cast out; to banish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcdc0ce-0e24-4609-8e19-798cf0e13180",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "And her faire yellow locks behind her flew, / Looſely diſperſt with puff of euery blaſt: / All as a blazing ſtarre doth farre outcaſt / His hearie beames, and flaming lockes diſpredd, / At ſight whereof the people ſtand aghaſt: […]"
                                            },
                                            {
                                                "example_id": "f20995f4-f31f-4220-bb47-020e9b6f856c",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "It means equal ruin to me, as the world reckons it — outcasting, the loss of my appointment, the breaking off my life's work. I pay my price."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                        "entry_id": "3315f9dd-599f-36e7-a483-ae59f2e7d189",
                                        "glosses": [
                                            "That has been cast out; banished, ostracized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e33450-4b43-4f8e-8761-2b692b956bbc",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "O, horrible fate! Outcast, rejected, / As one with pestilence infected!"
                                            },
                                            {
                                                "example_id": "3757b719-0a4d-4a16-b9b2-2db71c31bf71",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "One that has been excluded from a society or system, a pariah, a leper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00859b53-870b-497c-9404-2dd23f9417d5",
                                                "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                                "text": "The other factions believe that those who are Factionless are nomads and outcasts. But they are actually a fully functioning community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "Synonym of outsider: someone who does not belong, a misfit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ad113e-870c-4173-b8f9-c0c527b8ef7d",
                                                "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                                "text": "Do you ever feel like an outcast?\nYou don't have to fit into the format\nOh, but it's okay to be different\n'Cause baby, so am I"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256ec6b3-1751-32c0-90e4-5bd8c8dd304e",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "A quarrel."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
