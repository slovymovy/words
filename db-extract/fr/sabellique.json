                        "entry_id": "4ac99565-5de0-3fe5-89bf-85f94600b000",
                        "glosses": [
                            "Relatif aux Sabelliens, peuplade antique qui a vécu dans l'Italie centrale aux côtés des Latins, des Étrusques, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c96899-b3ee-4b64-87b6-76dc5514251a",
                                "sense_id": "3be9c59c-0b7c-334d-9f06-f3f65b5173cc",
                                "text": "Les différents apports italiques, qu'ils soient latins, étrusques ou sabelliques."
                            },
                            {
                                "example_id": "c4c83fa0-f1d2-4ce0-999e-4d67300c3e55",
                                "sense_id": "3be9c59c-0b7c-334d-9f06-f3f65b5173cc",
                                "text": "Les Ombriens auraient reculé devant les peuples sabelliques et celtiques d'une part et devant les Étrusques d'autre part."
                            },
                            {
                                "example_id": "03ecfbac-03b9-4994-ace4-8cad889ca43c",
                                "sense_id": "3be9c59c-0b7c-334d-9f06-f3f65b5173cc",
                                "text": "On sera donc porté à voir en eux une population sabellique de l’Italie centrale."
                            }
                        ]
                    }
                ],
