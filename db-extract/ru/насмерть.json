        "ru-extract.jsonl": [
            {
                "entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                "word": "насмерть",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fad63726-f6f4-3f9f-8e6b-9603344891c3",
                        "entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                        "glosses": [
                            "так, что наступает смерть, со смертельным исходом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081291b0-c994-42c7-ba93-78696469b5ec",
                                "sense_id": "fad63726-f6f4-3f9f-8e6b-9603344891c3",
                                "text": "Сражён пулей насмерть."
                            },
                            {
                                "example_id": "7a3ecf93-1866-49c1-a96c-48f0070b4556",
                                "sense_id": "fad63726-f6f4-3f9f-8e6b-9603344891c3",
                                "text": "Несчастного старика-полицейского изувечил насмерть мчавшийся на экипаже кафе-шантанный антрепренер Тумпаков."
                            }
                        ]
                    },
                    {
                        "sense_id": "38f164ed-1a0b-3599-ac30-10acf20bef0e",
                        "entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                        "glosses": [
                            "не щадя жизни, до решительного исхода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344b3488-aaf1-4a10-a8cb-bb9dfeba16bb",
                                "sense_id": "38f164ed-1a0b-3599-ac30-10acf20bef0e",
                                "text": "Сражался насмерть за свою Родину."
                            },
                            {
                                "example_id": "ff0a0743-e0b7-46ef-8570-31b850614f25",
                                "sense_id": "38f164ed-1a0b-3599-ac30-10acf20bef0e",
                                "text": "― Позвольте! ― сказал я, ― ещё одно условие; так как мы будем драться насмерть, то мы обязаны сделать всё возможное, чтоб это осталось тайною."
                            }
                        ]
                    },
                    {
                        "sense_id": "72c4cb55-9b79-3af3-b737-a2752b0cd1e3",
                        "entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                        "glosses": [
                            "очень сильно, чрезвычайно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d10f29-b5b2-439b-ab49-fc713e5a0a5d",
                                "sense_id": "72c4cb55-9b79-3af3-b737-a2752b0cd1e3",
                                "text": "Перепугаться насмерть."
                            },
                            {
                                "example_id": "3aacc43c-89b7-4423-8883-9fee465938b1",
                                "sense_id": "72c4cb55-9b79-3af3-b737-a2752b0cd1e3",
                                "text": "Он стоит передо мною, весь закапанный кровью, со связанными за спиной руками, испуганный насмерть тем, что его ожидает."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45c449dd-924c-4361-967d-01b8d5dfc3a1",
                        "source_entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                        "source_sense_description": "со смертельным исходом",
                        "target_lang_word": "à mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfc298d-3fc6-3712-88b0-304d34c7bcc8",
                                        "entry_id": "8baea65f-7bac-3baa-a5fa-b6fcadfada8d",
                                        "glosses": [
                                            "À fond, jusqu'au bout de quelque chose, jusqu'à la fin de quelque chose, à l’extrême du possible."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1be0cf4-77fd-4d86-91fc-4f55ea6ad0e6",
                                                "sense_id": "0dfc298d-3fc6-3712-88b0-304d34c7bcc8",
                                                "text": "Voilà l’eau qui tombe à mort, vous n’avez quasi rien sur le corps, vous prendrez du mal."
                                            },
                                            {
                                                "example_id": "22f6ffe5-847d-43a7-8d87-289bf1517994",
                                                "sense_id": "0dfc298d-3fc6-3712-88b0-304d34c7bcc8",
                                                "text": "On l’a gardé par charité, dans la maison, pendant les vacances. Il en profite pour étudier à mort les philosophes grecs."
                                            },
                                            {
                                                "example_id": "06327c2b-84f9-4554-9c39-b07dacad512c",
                                                "sense_id": "0dfc298d-3fc6-3712-88b0-304d34c7bcc8",
                                                "text": "Pour baiser à mort, les back-rooms c'était le paradis. On y passait de la techno ou du vieux krautrock, Amon Düül II revenait à la mode. Fabio pouvait baiser des heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9f81bc2-2f7a-3895-8213-6eecbdebe85f",
                                        "entry_id": "8baea65f-7bac-3baa-a5fa-b6fcadfada8d",
                                        "glosses": [
                                            "De manière qu’on en meure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd5ebdb-da9f-4765-a1ce-db11eb8eb744",
                                                "sense_id": "b9f81bc2-2f7a-3895-8213-6eecbdebe85f",
                                                "text": "Être condamné à mort."
                                            },
                                            {
                                                "example_id": "4bfea70b-e55f-4af4-b2a9-c0ebaaa72a37",
                                                "sense_id": "b9f81bc2-2f7a-3895-8213-6eecbdebe85f",
                                                "text": "Combat, duel à mort, combat, duel qui ne doit se terminer que par la mort d’un des adversaires."
                                            },
                                            {
                                                "example_id": "ffc26852-80c3-4225-b974-f0ce3aef9022",
                                                "sense_id": "b9f81bc2-2f7a-3895-8213-6eecbdebe85f",
                                                "text": "– Il vit que c’était entre nous désormais une guerre à mort."
                                            },
                                            {
                                                "example_id": "fc0013f3-d6a8-43b7-97de-189e5c82fe10",
                                                "sense_id": "b9f81bc2-2f7a-3895-8213-6eecbdebe85f",
                                                "text": "On voyait à l’horizon fuir les bêtes épouvantées et au-dessus de nous, trompés par ce jeu qui avait toutes les apparences, tous les bruits d’une chasse à mort, les vols des vautours se rassemblaient dans le soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc788b22-e05b-3b36-93dd-8558d641ea30",
                                        "entry_id": "8baea65f-7bac-3baa-a5fa-b6fcadfada8d",
                                        "glosses": [
                                            "Locution utilisée pour souhaiter la mort d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93fa085-4e3f-44d5-bbf8-476fa4409798",
                                                "sense_id": "bc788b22-e05b-3b36-93dd-8558d641ea30",
                                                "text": "À mort les tyrans !"
                                            },
                                            {
                                                "example_id": "94dadfe6-8f77-40e3-8d17-cf7cbaddf6cb",
                                                "sense_id": "bc788b22-e05b-3b36-93dd-8558d641ea30",
                                                "text": "— … Les mots ont toujours tué, au contraire.\n— Depuis quand ?\n— Depuis que quelqu'un crie «À mort» et que la foule le pend. Depuis toujours."
                                            },
                                            {
                                                "example_id": "f42128e4-8414-49e4-b904-f5819d6d67c6",
                                                "sense_id": "bc788b22-e05b-3b36-93dd-8558d641ea30",
                                                "text": "être atteint d’une maladie dont les symptômes annoncent une mort certaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef90839f-2f8a-43ef-85d0-6902ccfee8dd",
                        "source_entry_id": "f60b41b5-2f89-37bc-94ec-8ee55515ff5d",
                        "source_sense_description": "со смертельным исходом",
                        "target_lang_word": "mortellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2023a584-75e0-3bbf-b8d2-6f1930c8ef2c",
                                        "entry_id": "d5711f7a-eb9d-356d-8cb9-e2e1e18cf5c8",
                                        "glosses": [
                                            "D’une manière qui cause la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f9be77-cd9b-4d28-adc2-0c01a7dbfa40",
                                                "sense_id": "2023a584-75e0-3bbf-b8d2-6f1930c8ef2c",
                                                "text": "Le chauffard qui a mortellement percuté une femme sur le parking d'un restaurant de Béziers (Hérault) dans la nuit de samedi à dimanche a été mis en examen pour assassinat et placé en détention provisoire"
                                            },
                                            {
                                                "example_id": "dff0a912-3da2-47ae-82b5-ab7fa76ae48e",
                                                "sense_id": "2023a584-75e0-3bbf-b8d2-6f1930c8ef2c",
                                                "text": "À Sétif (300 km au sud-est d’Alger), deux personnes ont été mortellement asphyxiées dans leur domicile par les fumées provenant d’un incendie qui s’est déclenché à proximité de leur village."
                                            },
                                            {
                                                "example_id": "c9893b8e-8509-4f29-bc74-ad651ca9f931",
                                                "sense_id": "2023a584-75e0-3bbf-b8d2-6f1930c8ef2c",
                                                "text": "Mortellement atteint d’une flèche empennée, Un oiseau déplorait sa triste destinée."
                                            },
                                            {
                                                "example_id": "5794fa0f-405b-4345-aef0-becd3c0042f5",
                                                "sense_id": "2023a584-75e0-3bbf-b8d2-6f1930c8ef2c",
                                                "text": "Une centaine d'hommes gisent sur le pavé ; les uns sont tués roides, d'autres atteints mortellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f759f70e-6368-385e-85eb-7da46825adf8",
                                        "entry_id": "d5711f7a-eb9d-356d-8cb9-e2e1e18cf5c8",
                                        "glosses": [
                                            "Douloureusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13bc5de4-004d-4252-bdab-c5fdf8d173ab",
                                                "sense_id": "f759f70e-6368-385e-85eb-7da46825adf8",
                                                "text": "Du bruit de son trépas mortellement frappés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10170bc-4637-3375-8757-c6480cc5707b",
                                        "entry_id": "d5711f7a-eb9d-356d-8cb9-e2e1e18cf5c8",
                                        "glosses": [
                                            "Excessivement, en parlant des sentiments de haine, de jalousie, ainsi que des offenses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5f912c-93f6-4ac3-ab00-3bcce553961d",
                                                "sense_id": "e10170bc-4637-3375-8757-c6480cc5707b",
                                                "text": "Les Pharisiens se tenaient mortellement offensés de ce qu’il découvrait leur hypocrisie."
                                            },
                                            {
                                                "example_id": "90f0fafa-5a2f-4bff-9b5b-4e90a652e6f9",
                                                "sense_id": "e10170bc-4637-3375-8757-c6480cc5707b",
                                                "text": "Cette aventure commence à réconcilier les jansénistes avec l’inquisition, qu’ils haïssaient jusqu'ici mortellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
