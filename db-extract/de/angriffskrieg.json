                    {
                        "form_id": "bf8118bb-1df6-4664-88a4-e0a0345a0019",
                        "entry_id": "bfe85515-38e5-3a54-9ea8-cc1c38d75c90",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Angriffskriege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                        "entry_id": "bfe85515-38e5-3a54-9ea8-cc1c38d75c90",
                        "glosses": [
                            "Überfall (überraschender, völkerrechtswidriger Angriff) auf einen anderen Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9088b1fc-0785-441b-ba77-f95d29e68e0d",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "Der Polenfeldzug war ein Angriffskrieg Hitlers."
                            },
                            {
                                "example_id": "d51402f6-6a8e-466e-9f9d-0fc1f1fb5296",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Am dritten Tag des russischen Angriffskriegs gegen die Ukraine erschütterten Straßenkämpfe und Artilleriefeuer die Hauptstadt Kiew und umliegende Gebiete.“"
                            },
                            {
                                "example_id": "b770b27d-dccc-46be-b3fb-48af181a4933",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "[In den Nürnberger Prozessen] „mussten sich ranghohe Vertreter des NS-Regimes wegen der Vorbereitung eines Angriffskriegs sowie Kriegs- und Menschheitsverbrechen verantworten.“"
                            },
                            {
                                "example_id": "8f29135f-4bc5-4c8b-a470-433bd88f38c2",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Seit 2018 ist der IStGH auch für das Verbrechen der „Aggression“, also des Angriffskriegs zuständig.“"
                            },
                            {
                                "example_id": "5ea3c3a7-5fb8-4c77-a010-27cd77b423a5",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Tokio erwägt präventive Raketenabwehr“ - […] „Solche Waffensysteme lassen sich jedoch auch für einen Angriffskrieg benutzen, so dass viele Verfassungsjuristen ihre Anschaffung und Anwendung für nicht erlaubt halten.“"
                            },
                            {
                                "example_id": "1c9ebfdf-7d85-4572-b0c8-0cfe9c6709ad",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Vor allem aber musste Ellwood dem Parlament erklären, warum Großbritannien in großem Stil Waffen an Saudi-Arabien verkauft - und zwar auch solche, die sich in einem Angriffskrieg einsetzen lassen.“"
                            },
                            {
                                "example_id": "c484d961-558b-4674-b381-16d5c4a67834",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Im Moment führt die Türkei mit Hilfe deutscher Waffen einen Angriffskrieg.“"
                            },
                            {
                                "example_id": "d497c510-f0ba-425d-a52a-b0328c9b8f82",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Die türkische Armee hat im Angriffskrieg gegen die Kurden die Außenbezirke der syrischen Stadt Afrin erreicht.“"
                            },
                            {
                                "example_id": "1ffba09f-7620-45a2-b32a-0538d32edf73",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "[Irak-Krieg der USA im Jahr 2003:] „Die desaströsen Folgen dieses völkerrechtswidrigen Angriffskrieges für die gesamte Region sind bekannt - und auch, dass die Vorwände für diesen Krieg auf Lügen beruhten.“"
                            },
                            {
                                "example_id": "9ad43d94-a679-4b1a-a03d-b9ceb0717bff",
                                "sense_id": "d84bfcf3-d26d-3bcd-bbc1-6b673eb62afc",
                                "text": "„Nordkoreas Atomwaffen verhindern nach Darstellung von Machthaber Kim Jong Un“ […] „für immer einen Angriffskrieg der USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "886b1a9f-fddb-4306-8362-6e6723b9df9c",
