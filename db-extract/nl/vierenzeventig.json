                        "examples": [
                            {
                                "example_id": "2548b8ab-0dce-457d-8e6d-4b2aac0473ea",
                                "sense_id": "68293154-923a-33bd-b56a-2c3b5382477b",
                                "text": "Het is weer de vierenzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "64140b59-c864-4a1c-ad4e-5a6779d9bac7",
                                "sense_id": "68293154-923a-33bd-b56a-2c3b5382477b",
                                "text": "Haar vijfenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vierenzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e084497-6dfb-3dd7-92e6-0dfb870762ff",
                        "entry_id": "2ddee382-d7b6-367b-8486-815dfd1bdf97",
                        "glosses": [
