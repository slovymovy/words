                                                "sense_id": "0304c6b1-cdd4-3f1a-95e1-4379e9af6d55",
                                                "text": "Am See wurden wir von Mücken zerbissen."
                                            },
                                            {
                                                "example_id": "b2b7fa3b-a0dd-4d3f-b456-e1517977d3cd",
                                                "sense_id": "0304c6b1-cdd4-3f1a-95e1-4379e9af6d55",
                                                "text": "Sie war völlig von Wanzen und Flöhen zerbissen."
                                            },
                                            {
                                                "example_id": "c8d8a7e9-d860-4f03-8256-a92a04d6d1a6",
                                                "sense_id": "0304c6b1-cdd4-3f1a-95e1-4379e9af6d55",
                                                "text": "Vor Ärger hat er sich die Unterlippe zerbissen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
