{
    "word_family": [
        "digest",
        "digestion",
        "digestibility",
        "digestible",
        "indigestible",
        "indigestion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b798b13-dab6-3389-8fa0-0504b9027582",
                    "sense_definition": "Of, relating to, or functioning in the process of digestion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "digestion_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The human <w>digestive</w> system is responsible for breaking down food into nutrients.",
                            "target_lang_translations": {
                                "ru": "Человеческая <w>пищеварительная</w> система отвечает за расщепление пищи на питательные вещества."
                            }
                        },
                        {
                            "text": "Some illnesses can severely affect the <w>digestive</w> tract and cause discomfort.",
                            "target_lang_translations": {
                                "ru": "Некоторые заболевания могут серьезно поражать <w>пищеварительный</w> тракт и вызывать дискомфорт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digestive system",
                        "digestive tract",
                        "digestive enzymes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к процессу пищеварения или участвующий в нем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пищеварительный",
                                "target_lang_sense_clarification": "относящийся к пищеварению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b23849b3-5fa8-3967-b698-44dcaec498f8",
                    "sense_definition": "Having the power to cause or promote digestion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digestion_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Herbal teas are often consumed after meals for their <w>digestive</w> properties.",
                            "target_lang_translations": {
                                "ru": "Травяные чаи часто пьют после еды из-за их свойств, <w>способствующих пищеварению</w>."
                            }
                        },
                        {
                            "text": "While the doctor and the natives were taking a <w>digestive</w> nap after dinner, I strolled forth to have a peep at the country.",
                            "target_lang_translations": {
                                "ru": "Пока доктор и местные жители дремали после обеда для <w>улучшения пищеварения</w>, я отправился прогуляться, чтобы взглянуть на окрестности."
                            }
                        }
                    ],
                    "synonyms": [
                        "peptic"
                    ],
                    "common_phrases": [
                        "digestive aid",
                        "digestive properties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий пищеварению или улучшающий его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способствующий пищеварению",
                                "target_lang_sense_clarification": "о свойствах продуктов или средств"
                            },
                            {
                                "target_lang_word": "пищеварительный",
                                "target_lang_sense_clarification": "облегчающий пищеварение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5f380fe-197b-39f9-be09-436824a347fb",
                    "sense_definition": "A round, semi-sweet biscuit made from wholemeal flour, popular in the UK.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digestive_biscuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a packet of chocolate <w>digestives</w> to enjoy with my afternoon tea.",
                            "target_lang_translations": {
                                "ru": "Я купил пачку шоколадного <w>печенья дайджестив</w>, чтобы насладиться им во время послеобеденного чая."
                            }
                        },
                        {
                            "text": "I made a mistake and bought plain <w>digestives</w> instead of chocolate ones.",
                            "target_lang_translations": {
                                "ru": "Я ошибся и купил обычное <w>печенье дайджестив</w> вместо шоколадного."
                            }
                        }
                    ],
                    "synonyms": [
                        "digestive biscuit"
                    ],
                    "common_phrases": [
                        "chocolate digestives",
                        "packet of digestives"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглое полусладкое печенье из цельнозерновой муки, популярное в Великобритании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овсяное печенье",
                                "target_lang_sense_clarification": "приблизительный аналог цельнозернового печенья"
                            },
                            {
                                "target_lang_word": "печенье дайджестив",
                                "target_lang_sense_clarification": "сорт цельнозернового печенья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c36e5aef-3520-3484-9340-26447c8b8cc8",
                    "sense_definition": "A substance, such as a medicine or drink, that aids digestion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digestion_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a natural <w>digestive</w> to help with his chronic bloating.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал натуральное <w>средство для пищеварения</w>, чтобы помочь справиться с хроническим вздутием живота."
                            }
                        },
                        {
                            "text": "After a heavy meal, a traditional herbal liqueur can serve as an effective <w>digestive</w>.",
                            "target_lang_translations": {
                                "ru": "После плотного обеда традиционный травяной ликер может послужить отличным <w>дижестивом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "digester",
                        "digestif"
                    ],
                    "common_phrases": [
                        "natural digestive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество (лекарство или напиток), способствующее пищеварению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дижестив",
                                "target_lang_sense_clarification": "напиток, подаваемый после еды"
                            },
                            {
                                "target_lang_word": "средство для улучшения пищеварения",
                                "target_lang_sense_clarification": "лекарство или добавка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}