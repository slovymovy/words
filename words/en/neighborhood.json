    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba7c9f73-e866-302c-b332-40293d49a9b9",
                    "sense_definition": "A district or community within a town or city, especially the residential area surrounding one's home.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lives in a quiet <w>neighborhood</w> just outside the city center.",
                            "target_lang_translations": {
                                "ru": "Он живет в тихом <w>районе</w> прямо за центром города.",
                                "pl": "Mieszka w spokojnej <w>dzielnicy</w> tuż poza centrum miasta.",
                                "zh": "他住在市中心外一个安静的<w>社区</w>。"
                            }
                        },
                        {
                            "text": "We took a walk around the <w>neighborhood</w> to see the holiday decorations.",
                            "target_lang_translations": {
                                "ru": "Мы прогулялись по <w>району</w>, чтобы посмотреть на праздничные украшения.",
                                "pl": "Przeszliśmy się po <w>okolicy</w>, żeby obejrzeć świąteczne dekoracje.",
                                "zh": "我们在<w>附近</w>散步，看看节日的装饰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quarter",
                        "area"
                    ],
                    "common_phrases": [
                        "quiet neighborhood",
                        "residential neighborhood",
                        "bad neighborhood",
                        "friendly neighborhood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Район или община в городе, особенно жилая зона вокруг чьего-либо дома.",
                        "pl": "Dzielnica lub społeczność w obrębie miasta, zwłaszcza obszar mieszkalny otaczający czyjś dom.",
                        "zh": "城镇或城市中的一个区域或社区，尤指住宅区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "часть города"
                            },
                            {
