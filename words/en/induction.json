{
    "word_family": [
        "induce",
        "inductive",
        "inductance",
        "inductor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e536404c-4f03-398a-8f50-f01c3d42ed3e",
                    "sense_definition": "The process of introducing a new employee to an organization, including training and showing them around.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "entry_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company provides a comprehensive <w>induction</w> for all new staff members.",
                            "target_lang_translations": {
                                "ru": "Компания проводит всесторонний <w>вводный курс</w> для всех новых сотрудников.",
                                "zh": "公司为所有新员工提供全面的<w>入职培训</w>。"
                            }
                        },
                        {
                            "text": "During her <w>induction</w>, she met the team and learned about safety procedures.",
                            "target_lang_translations": {
                                "ru": "Во время <w>введения в должность</w> она познакомилась с командой и узнала о технике безопасности.",
                                "zh": "在<w>入职培训</w>期间，她结识了团队成员并了解了安全规程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orientation",
                        "onboarding"
                    ],
                    "common_phrases": [
                        "induction course",
                        "induction period",
                        "staff induction",
                        "safety induction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс введения нового сотрудника в организацию, включающий обучение, инструктаж и ознакомление с рабочим местом.",
                        "zh": "指引导新员工进入组织的过程，包括培训和熟悉工作环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "введение в должность",
                                "target_lang_sense_clarification": "процесс адаптации сотрудника"
                            },
                            {
                                "target_lang_word": "вводный курс",
                                "target_lang_sense_clarification": "обучение новых сотрудников"
                            },
                            {
                                "target_lang_word": "инструктаж",
                                "target_lang_sense_clarification": "ознакомление с правилами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "入职培训",
                                "target_lang_sense_clarification": "针对新员工的培训过程"
                            },
                            {
                                "target_lang_word": "岗前培训",
                                "target_lang_sense_clarification": "上岗前的指导与介绍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c9ab259-aa9d-35ca-87cc-75e95995fcc3",
                    "sense_definition": "The generation of electricity or magnetism in an object caused by the presence of a magnetic field or electric current nearby; also used to describe cooking appliances using this principle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We learned about electromagnetic <w>induction</w> in our physics class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали электромагнитную <w>индукцию</w> на уроке физики.",
                                "zh": "我们在物理课上学习了电磁<w>感应</w>。"
                            }
                        },
                        {
                            "text": "You need special pans to cook on an <w>induction</w> hob.",
                            "target_lang_translations": {
                                "ru": "Для готовки на <w>индукционной</w> плите нужны специальные сковороды.",
                                "zh": "在<w>感应</w>灶上烹饪需要使用专用锅具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "electromagnetic induction",
                        "induction motor",
                        "induction hob",
                        "induction coil"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникновение электрического тока или магнитного поля в объекте под воздействием внешнего поля; также принцип работы некоторых кухонных плит.",
                        "zh": "指由磁场或电流引起的电磁感应现象；也用于描述使用该原理的烹饪设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индукция",
                                "target_lang_sense_clarification": "физическое явление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感应",
                                "target_lang_sense_clarification": "物理学中的电磁感应现象"
                            },
                            {
                                "target_lang_word": "电磁感应",
                                "target_lang_sense_clarification": "物理学专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94619a25-b929-314e-86af-babd2166a2d2",
                    "sense_definition": "A method of reasoning in which general principles are derived from specific observations or instances.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientific theories are often formed through <w>induction</w> after observing many experiments.",
                            "target_lang_translations": {
                                "ru": "Научные теории часто формируются посредством <w>индукции</w> после наблюдения множества экспериментов.",
                                "zh": "科学理论通常是在观察了大量实验后通过<w>归纳</w>形成的。"
                            }
                        },
                        {
                            "text": "Unlike deduction, <w>induction</w> does not guarantee that the conclusion is absolutely certain.",
                            "target_lang_translations": {
                                "ru": "В отличие от дедукции, <w>индукция</w> не гарантирует абсолютной достоверности вывода.",
                                "zh": "与演绎不同，<w>归纳</w>不能保证结论绝对正确。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reasoning"
                    ],
                    "antonyms": [
                        "deduction"
                    ],
                    "common_phrases": [
                        "logic and induction",
                        "problem of induction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод рассуждения, при котором общие выводы делаются на основе частных наблюдений или примеров.",
                        "zh": "一种从特定观察或实例中推导出一般原则的推理方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индукция",
                                "target_lang_sense_clarification": "логический метод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归纳",
                                "target_lang_sense_clarification": "逻辑学中的归纳推理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9abca402-c10a-393f-93b5-b5e5723af68e",
                    "sense_definition": "The medical process of artificially starting childbirth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended <w>induction</w> because the baby was two weeks overdue.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал <w>стимуляцию родов</w>, так как ребенок перенашивался уже две недели.",
                                "zh": "由于胎儿已过期两周，医生建议进行<w>催产</w>。"
                            }
                        },
                        {
                            "text": "She went to the hospital early in the morning for a scheduled <w>induction</w>.",
                            "target_lang_translations": {
                                "ru": "Она поехала в больницу рано утром на плановую <w>стимуляцию</w>.",
                                "zh": "她清晨前往医院进行预定的<w>催产</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "labor induction",
                        "induction of labor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская процедура искусственного начала родовой деятельности.",
                        "zh": "人工启动分娩过程的医疗手段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимуляция родов",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "вызывание родов",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "催产",
                                "target_lang_sense_clarification": "医学上人工诱导分娩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afa312d8-da59-3e68-984f-0a714d0ed2d1",
                    "sense_definition": "A formal ceremony or process of admitting someone into a position, organization, or military service.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "entry_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>induction</w> of the new members into the Hall of Fame was a grand event.",
                            "target_lang_translations": {
                                "ru": "<w>Введение</w> новых членов в Зал славы было грандиозным событием.",
                                "zh": "新成员入选名人堂的<w>就职</w>仪式是一场盛大的活动。"
                            }
                        },
                        {
                            "text": "He received a letter regarding his <w>induction</w> into the army during the conflict.",
                            "target_lang_translations": {
                                "ru": "Он получил письмо касательно его <w>призыва</w> в армию во время конфликта.",
                                "zh": "冲突期间，他收到了一封关于他<w>入伍</w>的信件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "installation",
                        "initiation",
                        "inauguration"
                    ],
                    "common_phrases": [
                        "induction ceremony",
                        "military induction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная церемония или процесс принятия кого-либо в должность, организацию или на военную службу.",
                        "zh": "正式接纳某人进入职位、组织或军队的仪式或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвящение",
                                "target_lang_sense_clarification": "церемония принятия"
                            },
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "в состав или должность"
                            },
                            {
                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "на военную службу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "就职",
                                "target_lang_sense_clarification": "正式担任职位"
                            },
                            {
                                "target_lang_word": "入伍",
                                "target_lang_sense_clarification": "加入军队"
                            },
                            {
                                "target_lang_word": "入会",
                                "target_lang_sense_clarification": "加入组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6590584-46b3-3fab-a561-5329c182c224",
                    "sense_definition": "A mathematical method of proof used to prove a statement for all natural numbers by verifying a base case and an inductive step.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor asked the students to prove the formula using mathematical <w>induction</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор попросил студентов доказать формулу, используя математическую <w>индукцию</w>.",
                                "zh": "教授要求学生使用<w>数学归纳法</w>来证明该公式。"
                            }
                        },
                        {
                            "text": "Proof by <w>induction</w> is a fundamental tool in number theory.",
                            "target_lang_translations": {
                                "ru": "Доказательство по <w>индукции</w> является фундаментальным инструментом в теории чисел.",
                                "zh": "<w>数学归纳法</w>证明是数论中的基础工具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mathematical induction",
                        "proof by induction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический метод доказательства утверждения для всех натуральных чисел.",
                        "zh": "一种通过验证基础情况和归纳步骤来证明所有自然数命题的数学证明方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индукция",
                                "target_lang_sense_clarification": "математический метод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数学归纳法",
                                "target_lang_sense_clarification": "数学证明方法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
