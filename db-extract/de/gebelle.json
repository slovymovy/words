                        "examples": [
                            {
                                "example_id": "43ada0b4-53b9-47b0-b6f7-19d906688bb6",
                                "sense_id": "5556a5ee-e0e8-3d98-9b6a-00e44cacb375",
                                "text": "„Das Gebelle hält sich in Grenzen. Arashi und Quick machen sehr schnell die Rangordnung untereinander aus, dann herrscht Ruhe im zufällig zusammengewürfelten Rudel.“"
                            },
                            {
                                "example_id": "bc2c5a5e-b452-4bc8-add3-bbf018b6fa83",
                                "sense_id": "5556a5ee-e0e8-3d98-9b6a-00e44cacb375",
                                "text": "„Das Gebelle ward zum dritten Male gehört.“"
                            }
                        ],
