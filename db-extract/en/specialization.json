                                    {
                                        "sense_id": "3011bb23-987a-3112-8e9d-d46fa5083ff0",
                                        "entry_id": "7ec6365e-7f8e-35e1-b752-f94325415db4",
                                        "glosses": [
                                            "Action de se spécialiser ; résultat de cette action."
