                                        "sense_id": "864de590-2267-30c2-9a9e-9490d32d0506",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "A monarch butterfly (Danaus plexippus) and others of genus Danaus, found primarily in North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca79651-30c6-4312-a01a-8e704057766d",
                                                "sense_id": "864de590-2267-30c2-9a9e-9490d32d0506",
                                                "text": "But I know the monarchs are close by, their orange-and-black wings folded, dusted, and baked by heat, ready to flee south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff3d8576-3a92-3cd1-843f-e743452bbbb7",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45112110-c49e-4d61-8003-9ee2117fc7c7",
                                                "sense_id": "ff3d8576-3a92-3cd1-843f-e743452bbbb7",
                                                "text": "‘Skippy gets off. An ya know the first thing e says to them monarch? E turns round on em an yelps, “An now ya can just gimme back that bottle.”’"
                                            }
                                        ]
                                    },
