                "entry_id": "89eecf9d-135a-38fb-8d41-6a3fe7122279",
                "word": "brigandine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5546f8ff-870e-4d50-8fcb-fa733c10ed0e",
                        "entry_id": "89eecf9d-135a-38fb-8d41-6a3fe7122279",
                        "tags": [
                            "plural"
                        ],
                        "form": "brigandines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58c4680f-61d2-35b0-8d90-0cd5a3567d6a",
                        "entry_id": "89eecf9d-135a-38fb-8d41-6a3fe7122279",
                        "glosses": [
                            "A coat of armor for the body, consisting of scales or plates, sometimes overlapping each other, generally of metal, sewn or riveted under or onto canvas or linen or other material."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9b3214-566f-49d2-a067-144dbf7ac749",
                                "sense_id": "58c4680f-61d2-35b0-8d90-0cd5a3567d6a",
                                "text": "Harness the horses; and get up, ye horsemen, and stand forth with your helmets; furbish the spears, and put on the brigandines."
                            },
                            {
                                "example_id": "6a62505d-dd21-4a21-9462-744814080ffd",
                                "sense_id": "58c4680f-61d2-35b0-8d90-0cd5a3567d6a",
                                "text": "The brigandine takes its name from the troops, by which it was first worn, who were called brigans, they were a kind of light armed irregular foot, much addicted to plunder, whence it is probable the appellation of brigands was given to other freebooters."
                            },
                            {
                                "example_id": "b00f8f9d-843f-4577-b8e8-e18a5280ccd3",
                                "sense_id": "58c4680f-61d2-35b0-8d90-0cd5a3567d6a",
                                "text": "Red-haired and freckled, he wore a studded brigantine, high boots, fingerless leather gloves, and a quiver on his back."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3636fb71-58fa-4e2c-a412-a707c66fba77",
