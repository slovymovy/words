                "senses": [
                    {
                        "sense_id": "a73c0971-2c2e-3090-ba28-0982127d8870",
                        "entry_id": "882a1f3d-996b-3c0d-aede-40e88e253f1d",
                        "glosses": [
                            "US-amerikanischer Fahrzeughersteller"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                        "entry_id": "882a1f3d-996b-3c0d-aede-40e88e253f1d",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99caecdf-d296-46c2-a68c-74218966dfb7",
                                "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                                "text": "„Er bevorzugte ältere Buicks, mittlere Baureihe, in Braun- oder Grautönen, war da aber durchaus offen.“"
                            },
                            {
                                "example_id": "468d8bbe-11a1-4497-b1a0-07a632086267",
                                "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                                "text": "„Wir brauchten nur noch den Buick zu holen und die Leiche einzuladen.“"
                            },
                            {
                                "example_id": "57ed7da0-8510-4fca-a86c-f7706db61378",
                                "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                                "text": "„Everett Yow fuhr einen schwarzen Buick mit einem De-Paul-University-Aufkleber auf dem Rückfenster.“"
                            },
                            {
                                "example_id": "c00bb863-e884-4ba8-8053-a040bf16937d",
                                "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                                "text": "„Zwischen ihnen kurvten Dolmus genannte Sammeltaxis herum, meist alte, mit viel Engagement am Leben erhaltene Buicks und Chevrolets mit farbenfrohen, am Innenspiegel hängenden Amuletten, die den bösen Blick abwehren sollten.“"
                            },
                            {
                                "example_id": "19ec20d7-7499-441a-993f-d8f3d8dee429",
                                "sense_id": "0ba5e8cd-0d0e-3a28-863b-20e7257e2c2b",
                                "text": "„Er wohnte in einem Apartment mit fünf Schlafzimmern, führte ein erfolgreiches Unternehmen und fuhr das Vorjahresmodell eines Buick.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
