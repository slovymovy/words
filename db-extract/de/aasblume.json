                "senses": [
                    {
                        "sense_id": "9a41a899-27c6-33ad-9b33-0d9f81c1cef3",
                        "entry_id": "0f183331-cdc0-30bd-b488-d5432d3e2fb3",
                        "glosses": [
                            "Pflanze, deren Blüten nach Aas riechen und die mit diesen Aas liebende Insekten, meist Aasfliegen, anzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d47b06a-9583-4afc-99c1-cc8c948c32bd",
                                "sense_id": "9a41a899-27c6-33ad-9b33-0d9f81c1cef3",
                                "text": "„Eines sieht man der Rafflesie bei aller Schönheit nicht an: Als Aasblume riecht sie nach verwesendem Fleisch, um Fliegen und Käfer anzulocken, die sie bestäuben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70f191ef-f4fc-3571-b7ae-ba83d20d5d1e",
                        "entry_id": "0f183331-cdc0-30bd-b488-d5432d3e2fb3",
                        "glosses": [
                            "eine zur Unterfamilie der Seidenpflanzengewächse (Asclepiadoideae) gehörende Pflanze, die beim Öffnen der Blüten einen penetranten, aasartigen Geruch verströmt, mit dessen Hilfe sie die der Bestäubung förderlichen Aasfliegen anlockt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "52b3df91-722e-4ffe-a6ab-cd4b5458d76f",
                                "sense_id": "70f191ef-f4fc-3571-b7ae-ba83d20d5d1e",
                                "text": "Die Aasblumen sind leicht zu pflegende Zimmerpflanzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
