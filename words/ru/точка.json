{
    "word_family": [
        "точечный",
        "точечка",
        "точность",
        "точный",
        "уточнить",
        "заточка",
        "заточить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6929241a-caad-3be7-8cf1-130c8261d542",
                    "sense_definition": "Знак препинания, который ставится в конце повествовательного предложения или при сокращении слов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mark_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В конце этого предложения стоит <w>точка</w>.",
                            "target_lang_translations": {
                                "en": "There is a <w>period</w> at the end of this sentence.",
                                "de": "Am Ende dieses Satzes steht ein <w>Punkt</w>."
                            }
                        },
                        {
                            "text": "Ученик забыл поставить <w>точку</w> и получил замечание.",
                            "target_lang_translations": {
                                "en": "The student forgot to put a <w>full stop</w> and received a reprimand.",
                                "de": "Der Schüler hat vergessen, einen <w>Punkt</w> zu setzen, und bekam eine Bemerkung."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поставить точку",
                        "точка с запятой"
                    ],
                    "target_lang_definitions": {
                        "en": "A punctuation mark used at the end of a sentence or to mark an abbreviation.",
                        "de": "Ein Satzzeichen am Ende eines Aussagesatzes oder bei Abkürzungen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "punctuation mark (US English)"
                            },
                            {
                                "target_lang_word": "full stop",
                                "target_lang_sense_clarification": "punctuation mark (UK English)"
                            },
                            {
                                "target_lang_word": "dot",
                                "target_lang_sense_clarification": "in email addresses or URLs"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "Satzzeichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f033610a-efa6-33d5-8eb9-fc52d23407c5",
                    "sense_definition": "Маленькое круглое пятно, крапинка или след от прикосновения чем-то острым.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mark_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На белой скатерти была маленькая красная <w>точка</w>.",
                            "target_lang_translations": {
                                "en": "There was a small red <w>dot</w> on the white tablecloth.",
                                "de": "Auf dem weißen Tischtuch war ein kleiner roter <w>Punkt</w>."
                            }
                        },
                        {
                            "text": "Божья коровка — это жук с чёрными <w>точками</w> на спине.",
                            "target_lang_translations": {
                                "en": "A ladybug is a beetle with black <w>dots</w> on its back.",
                                "de": "Ein Marienkäfer ist ein Käfer mit schwarzen <w>Punkten</w> auf dem Rücken."
                            }
                        }
                    ],
                    "synonyms": [
                        "пятнышко",
                        "крапинка"
                    ],
                    "common_phrases": [
                        "смотреть в одну точку"
                    ],
                    "target_lang_definitions": {
                        "en": "A small round mark, speck, or spot.",
                        "de": "Ein kleiner runder Fleck, Tupfen oder eine kleine Markierung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dot",
                                "target_lang_sense_clarification": "small round mark"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "small mark or stain"
                            },
                            {
                                "target_lang_word": "speck",
                                "target_lang_sense_clarification": "tiny particle or mark"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "kleiner Fleck oder Tupfen"
                            },
                            {
                                "target_lang_word": "Tupfen",
                                "target_lang_sense_clarification": "kleiner runder Fleck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae3219ce-9792-3274-9110-a6540daee509",
                    "sense_definition": "Определённое место, где что-то находится, происходит или осуществляется (часто о торговле или услугах).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У метро открылась новая торговая <w>точка</w> по продаже кофе.",
                            "target_lang_translations": {
                                "en": "A new coffee retail <w>outlet</w> opened near the subway.",
                                "de": "An der U-Bahn hat eine neue <w>Verkaufsstelle</w> für Kaffee eröffnet."
                            }
                        },
                        {
                            "text": "На карте была отмечена <w>точка</w> сбора для начала экскурсии.",
                            "target_lang_translations": {
                                "en": "The assembly <w>point</w> for the start of the tour was marked on the map.",
                                "de": "Auf der Karte war der <w>Treffpunkt</w> für den Beginn der Führung markiert."
                            }
                        }
                    ],
                    "synonyms": [
                        "пункт",
                        "позиция",
                        "гарнизон"
                    ],
                    "common_phrases": [
                        "торговая точка",
                        "горячая точка",
                        "огневая точка",
                        "точка опоры"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific place or location where something happens, often related to business or services.",
                        "de": "Ein bestimmter Ort, an dem etwas stattfindet oder angeboten wird (z. B. Handel oder Dienstleistungen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "point",
                                "target_lang_sense_clarification": "specific location (e.g., assembly point)"
                            },
                            {
                                "target_lang_word": "outlet",
                                "target_lang_sense_clarification": "retail location"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "particular place"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "bestimmter Ort oder Treffpunkt"
                            },
                            {
                                "target_lang_word": "Standort",
                                "target_lang_sense_clarification": "Verkaufs- oder Geschäftsstelle"
                            },
                            {
                                "target_lang_word": "Verkaufsstelle",
                                "target_lang_sense_clarification": "Handelspunkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e86e61d-7cd8-3b15-a249-bc64d3bb6d34",
                    "sense_definition": "Определённый момент, стадия процесса или параметр состояния, при котором происходят изменения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вода достигла <w>точки</w> кипения и начала превращаться в пар.",
                            "target_lang_translations": {
                                "en": "The water reached the boiling <w>point</w> and started turning into steam.",
                                "de": "Das Wasser erreichte den <w>Siedepunkt</w> und begann sich in Dampf zu verwandeln."
                            }
                        },
                        {
                            "text": "Переговоры зашли в тупик и достигли мёртвой <w>точки</w>.",
                            "target_lang_translations": {
                                "en": "The negotiations hit a dead end and reached a dead <w>point</w>.",
                                "de": "Die Verhandlungen gerieten in eine Sackgasse und erreichten einen <w>Toten Punkt</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "точка зрения",
                        "точка кипения",
                        "мёртвая точка",
                        "точка невозврата"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment, stage, or degree in a process or condition.",
                        "de": "Ein bestimmter Moment, eine Phase oder ein Grenzwert in einem Prozess."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "point",
                                "target_lang_sense_clarification": "stage or degree (e.g., boiling point)"
                            },
                            {
                                "target_lang_word": "stage",
                                "target_lang_sense_clarification": "phase of a process"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "Zustand, Phase oder Messwert (z. B. Siedepunkt)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b29463-add1-30f4-b33a-76af2294670f",
                    "sense_definition": "Основное понятие в геометрии, объект без размеров, указывающий положение в пространстве.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mark_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Через две <w>точки</w> можно провести только одну прямую линию.",
                            "target_lang_translations": {
                                "en": "Only one straight line can be drawn through two <w>points</w>.",
                                "de": "Durch zwei <w>Punkte</w> kann man nur eine gerade Linie ziehen."
                            }
                        },
                        {
                            "text": "Учитель отметил на графике <w>точку</w> пересечения осей.",
                            "target_lang_translations": {
                                "en": "The teacher marked the intersection <w>point</w> of the axes on the graph.",
                                "de": "Der Lehrer markierte auf dem Diagramm den <w>Schnittpunkt</w> der Achsen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "точка пересечения",
                        "точка отсчёта"
                    ],
                    "target_lang_definitions": {
                        "en": "A geometric element that has position but no extension.",
                        "de": "Grundbegriff der Geometrie; ein ausdehnungsloses Gebilde im Raum."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "point",
                                "target_lang_sense_clarification": "geometric concept"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "geometrischer Begriff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f18673b-611e-385e-8573-028a3b6aaec9",
                    "sense_definition": "Мельчайший элемент цифрового изображения на экране или при печати.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mark_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Качество печати зависит от количества <w>точек</w> на дюйм.",
                            "target_lang_translations": {
                                "en": "Print quality depends on the number of <w>dots</w> per inch.",
                                "de": "Die Druckqualität hängt von der Anzahl der <w>Punkte</w> pro Zoll ab."
                            }
                        },
                        {
                            "text": "При сильном увеличении на экране видны отдельные цветные <w>точки</w>.",
                            "target_lang_translations": {
                                "en": "At high magnification, individual colored <w>dots</w> are visible on the screen.",
                                "de": "Bei starker Vergrößerung sind auf dem Bildschirm einzelne farbige <w>Pixel</w> zu sehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "пи́ксель",
                        "пиксел"
                    ],
                    "common_phrases": [
                        "точек на дюйм"
                    ],
                    "target_lang_definitions": {
                        "en": "The smallest element of a digital image or print.",
                        "de": "Kleinste Einheit eines digitalen Bildes auf dem Bildschirm oder beim Drucken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dot",
                                "target_lang_sense_clarification": "printing resolution (DPI)"
                            },
                            {
                                "target_lang_word": "pixel",
                                "target_lang_sense_clarification": "screen element"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Punkt",
                                "target_lang_sense_clarification": "Druckauflösung (DPI)"
                            },
                            {
                                "target_lang_word": "Pixel",
                                "target_lang_sense_clarification": "Bildschirmelement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be825ab-7cc1-35b6-8c49-40165dd08a59",
                    "sense_definition": "Процесс заострения режущих инструментов или механической обработки материалов.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Профессиональная <w>точка</w> ножей требует специального оборудования.",
                            "target_lang_translations": {
                                "en": "Professional knife <w>sharpening</w> requires special equipment.",
                                "de": "Professionelles <w>Schleifen</w> von Messern erfordert spezielle Ausrüstung."
                            }
                        },
                        {
                            "text": "В мастерской производится <w>точка</w> коньков для фигурного катания.",
                            "target_lang_translations": {
                                "en": "The workshop performs figure skate <w>sharpening</w>.",
                                "de": "In der Werkstatt wird das <w>Schleifen</w> von Schlittschuhen für Eiskunstlauf durchgeführt."
                            }
                        }
                    ],
                    "synonyms": [
                        "заострение",
                        "заточка",
                        "вытачивание"
                    ],
                    "antonyms": [
                        "тупление"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of making a blade or tool sharp.",
                        "de": "Das Schärfen oder Bearbeiten von Schneidwerkzeugen und Klingen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sharpening",
                                "target_lang_sense_clarification": "action of making sharp"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schleifen",
                                "target_lang_sense_clarification": "Bearbeitung von Werkzeugen/Klingen"
                            },
                            {
                                "target_lang_word": "Schärfen",
                                "target_lang_sense_clarification": "Vorgang des Schärfens"
                            },
                            {
                                "target_lang_word": "Anspitzen",
                                "target_lang_sense_clarification": "Spitzmachen von Stiften oder Werkzeugen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8f1e7a05-056c-3956-bfdf-86d1fd3c411f",
                    "sense_definition": "Возглас, означающий категорическое требование прекратить что-либо; конец разговора.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interjection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не пойду туда, и <w>точка</w>!",
                            "target_lang_translations": {
                                "en": "I am not going there, <w>period</w>!",
                                "de": "Ich gehe nicht dorthin, und <w>Schluss</w>!"
                            }
                        },
                        {
                            "text": "Хватит спорить, решение принято, <w>точка</w>!",
                            "target_lang_translations": {
                                "en": "Stop arguing, the decision is made, <w>full stop</w>!",
                                "de": "Hört auf zu streiten, die Entscheidung ist getroffen, <w>Punktum</w>!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "и точка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to end a dispute firmly"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation used to emphasize that a decision is final and no further discussion is allowed.",
                        "de": "Ausruf zur nachdrücklichen Beendigung einer Diskussion oder Entscheidung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "US English, emphatic end of discussion"
                            },
                            {
                                "target_lang_word": "full stop",
                                "target_lang_sense_clarification": "UK English, emphatic end of discussion"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aus",
                                "target_lang_sense_clarification": "Beendigung, Schluss"
                            },
                            {
                                "target_lang_word": "Schluss",
                                "target_lang_sense_clarification": "Ende der Diskussion"
                            },
                            {
                                "target_lang_word": "Punktum",
                                "target_lang_sense_clarification": "umgangssprachlicher Nachdruck"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}