{
    "word_family": [
        "fold"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6456d615-1c7e-387a-b103-721b5bd4b09a",
                    "sense_definition": "To hold someone lovingly or protectively in one's arms; embrace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped forward to <w>enfold</w> his daughter in a warm, welcoming embrace.",
                            "target_lang_translations": {
                                "de": "Er trat vor, um seine Tochter in eine herzliche, liebevolle Umarmung zu <w>schließen</w>."
                            }
                        },
                        {
                            "text": "She leaned against him as he <w>enfolded</w> her gently in his arms.",
                            "target_lang_translations": {
                                "de": "Sie lehnte sich an ihn, während er sie sanft in seine Arme <w>schloss</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "embrace",
                        "hug",
                        "clasp"
                    ],
                    "common_phrases": [
                        "enfold in arms",
                        "enfold in an embrace"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden liebevoll oder schützend in die Arme schließen; umarmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umarmen",
                                "target_lang_sense_clarification": "in die Arme schließen"
                            },
                            {
                                "target_lang_word": "in die Arme schließen",
                                "target_lang_sense_clarification": "liebevoll umschlingen"
                            },
                            {
                                "target_lang_word": "umfangen",
                                "target_lang_sense_clarification": "gehoben für umarmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd6ceae-c4fb-33fa-b7a3-c3da415ac1fd",
                    "sense_definition": "To envelop, surround, or wrap up completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick blanket of fog began to <w>enfold</w> the quiet valley as night fell.",
                            "target_lang_translations": {
                                "de": "Als die Nacht hereinbrach, begann eine dichte Nebeldecke das ruhige Tal <w>einzuhüllen</w>."
                            }
                        },
                        {
                            "text": "The darkness seemed to <w>enfold</w> the old house in mystery.",
                            "target_lang_translations": {
                                "de": "Die Dunkelheit schien das alte Haus in Geheimnisse zu <w>hüllen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop",
                        "wrap",
                        "shroud",
                        "cloak"
                    ],
                    "antonyms": [
                        "unfold",
                        "unravel",
                        "unwrap"
                    ],
                    "common_phrases": [
                        "enfold in mist",
                        "enfold in darkness"
                    ],
                    "target_lang_definitions": {
                        "de": "Vollständig einhüllen, umgeben oder einpacken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einhüllen",
                                "target_lang_sense_clarification": "vollständig umgeben oder bedecken"
                            },
                            {
                                "target_lang_word": "umhüllen",
                                "target_lang_sense_clarification": "von allen Seiten umgeben"
                            },
                            {
                                "target_lang_word": "umfangen",
                                "target_lang_sense_clarification": "gehoben für umgeben, einhüllen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}