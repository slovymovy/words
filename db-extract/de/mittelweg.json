                    }
                ],
                "senses": [
                    {
                        "sense_id": "1faa771e-a2c4-30e2-ab2a-595bf000296f",
                        "entry_id": "f272a269-6650-30d4-87bb-6445ebfb89fb",
                        "glosses": [
                            "ein mittlerer von mehreren Wegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1100b006-19e9-4154-90d7-a6e133a3cf9a",
                                "sense_id": "1faa771e-a2c4-30e2-ab2a-595bf000296f",
                                "text": "„Das Riesenrad kreiste über dem Mittelweg, eine Windmühle aus Licht, rundherum, rundherum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52a87b75-1d2b-346c-9d8b-517619420764",
                        "entry_id": "f272a269-6650-30d4-87bb-6445ebfb89fb",
                        "glosses": [
                            "eine Entscheidung/Einigung, die inhaltlich zwischen extremeren Positionen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db20939a-5094-4fa9-9870-5cbdf940dfa4",
                                "sense_id": "52a87b75-1d2b-346c-9d8b-517619420764",
                                "text": "„Alkohol ist überall im Norden ein Reizthema, zwischen magnetischer Anziehung und Verteufelung gibt es hier selten einen vernünftigen Mittelweg.“"
                            },
                            {
                                "example_id": "566a3a05-28d6-41f9-b15b-20788e275f24",
                                "sense_id": "52a87b75-1d2b-346c-9d8b-517619420764",
                                "text": "„Man einigte sich auf einen Mittelweg, und wieder geschah, was geschehen musste: ein kleines Detachement wurde nach Fominskoje geschickt, um Broussier anzugreifen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
