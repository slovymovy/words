                "senses": [
                    {
                        "sense_id": "d1c54d9a-9847-3175-9b52-c1d7b642db0d",
                        "entry_id": "34aab853-84a0-31d3-bd86-f85e33264745",
                        "glosses": [
                            "Dienstleister, der bestellte Produkte (meist Speisen) zum Kunden transportiert, beziehungsweise diese Dienstleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0109eb60-47c6-4790-a427-3e68fbd2c7a2",
                                "sense_id": "d1c54d9a-9847-3175-9b52-c1d7b642db0d",
                                "text": "„Vor einer halben Stunde hatte sie vor der Tür gestanden, und nach einer Führung durch das Apartment hatte uns der Lieferdienst auch schon unser Essen gebracht, das ich kurz zuvor bestellt hatte.“"
                            },
                            {
                                "example_id": "f26fed35-818d-4917-8d2c-d6c924087f48",
                                "sense_id": "d1c54d9a-9847-3175-9b52-c1d7b642db0d",
                                "text": "„Viele beziehen ihr Essen vom Lieferdienst, da Restaurants ebenfalls geschlossen sind und somit reduziert sich selbst der Weg ins Restaurant oder ins Café.“"
                            },
                            {
                                "example_id": "8312b523-9ee1-44b5-857f-f1f39694333e",
                                "sense_id": "d1c54d9a-9847-3175-9b52-c1d7b642db0d",
                                "text": "„In vielen Gaststätten waren schon vor der Pandemie viele Tische leer, der Wettbewerb war ruinös, der zusätzliche Lieferdienst mit Fahrradkurieren, von Lieferando und deliveroo, hilft zu überleben und ist zum Vorteil des Kunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
