                        "cross_references": [
                            {
                                "target_word": "œnologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30bcf5bd-3fec-3c06-9507-8cf637569753",
                                        "entry_id": "934287a9-b221-380c-b8a2-a498c010b4d8",
                                        "glosses": [
                                            "Science qui s’occupe du vin depuis sa culture jusqu’à sa consommation : sa récolte, sa vinification, son assemblage, son élevage, sa conservation et sa dégustation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36989e63-a20b-4f40-9b10-7b93fbeea9b7",
                                                "sense_id": "30bcf5bd-3fec-3c06-9507-8cf637569753",
                                                "text": "Il n'est point acquis en bonne œnologie que l'on doive cuver aussi long-temps, et les principes à cet égard peuvent et doivent varier avec la qualité du raisin, et ce que l'on se propose d'en faire."
                                            },
                                            {
                                                "example_id": "6ac046d4-16a0-4788-a67d-9e7d4074bae5",
                                                "sense_id": "30bcf5bd-3fec-3c06-9507-8cf637569753",
                                                "text": "Nous ne tarderons pas à reconnaître que, dans tout ce qui regarde la fabrication du vin, on ne peut pas avoir une ligne de conduite bien déterminée et pour ainsi dire se faire d'avance un programme invariable ; l’œnologie ne commencera à devenir une science que lorsqu'on se sera bien pénétré de cette idée, qu'il est impossible de tracer une règle fixe pour chaque opération."
                                            }
                                        ]
                                    }
                                ]
                            }
