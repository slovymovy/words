                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007668eb-c68b-4c2f-b44b-a63de4a12e84",
                                "sense_id": "ae5e9f1c-7bea-37e8-b285-f7f6047cf918",
                                "text": "„Der Komiker versucht sich als Nächstes an einer Wildwest-Komödie.“"
                            },
                            {
                                "example_id": "3eb6c6bd-28ab-4e8c-8e24-110d96927f60",
                                "sense_id": "ae5e9f1c-7bea-37e8-b285-f7f6047cf918",
                                "text": "„Mit der Wildwest-Komödie ‚Die Western-Schwestern‘ von Bernd Kietzke gelang es der Theatergruppe, ein Stück Wilden Westen direkt nach Franken zu bringen.“"
                            },
                            {
                                "example_id": "2ab2e4a4-1e20-40e1-ab26-fe30a9da2fc7",
                                "sense_id": "ae5e9f1c-7bea-37e8-b285-f7f6047cf918",
                                "text": "„Villazón verlegt die Opern-Farce kurzerhand an ein Filmset, in eine Wildwest-Komödie: […].“"
                            },
                            {
                                "example_id": "e7f3a5a8-7044-4fae-9c26-f293146d4980",
                                "sense_id": "ae5e9f1c-7bea-37e8-b285-f7f6047cf918",
                                "text": "„Da blieb bei den witzigen Dialogen in der Wildwest-Komödie kein Auge trocken.“"
                            }
                        ],
