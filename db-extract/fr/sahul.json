                                "target_senses": [
                                    {
                                        "sense_id": "80f893a4-0163-3c15-ad8d-45e95dbd2099",
                                        "entry_id": "90649e85-ba46-333f-95ae-64211183d624",
                                        "glosses": [
                                            "Landmasse während der letzten Eiszeit, die aus dem heutigen Australien und angrenzenden Inseln bestand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47521221-4562-4e21-83f2-d8558ba0b95d",
                                                "sense_id": "80f893a4-0163-3c15-ad8d-45e95dbd2099",
                                                "text": "Dieser „Sahul“ getaufte Kontinentteil könnte vor rund 65.000 Jahren eine entscheidende Rolle für die erste Besiedlung Australiens gespielt haben."
                                            },
                                            {
                                                "example_id": "3f6225c0-0ddd-46be-b790-3bbff1e49955",
                                                "sense_id": "80f893a4-0163-3c15-ad8d-45e95dbd2099",
                                                "text": "Die früheste Besiedlungsphase Sahuls wird vor 50.000 bis 60.000 Jahren angesetzt."
                                            },
                                            {
                                                "example_id": "18a161c4-597f-4206-ba53-cb9d645e1744",
                                                "sense_id": "80f893a4-0163-3c15-ad8d-45e95dbd2099",
                                                "text": "Doch nach Ende der Eiszeit stiegen die Meeresspiegel erneut an. Als Folge versank Sahul in zwei Schritten – erst vor rund 14.000 Jahren, dann endgültig vor rund 9.000 Jahren – in den Fluten."
                                            },
                                            {
                                                "example_id": "5561fb41-8276-4461-86bc-4b344ba49f38",
                                                "sense_id": "80f893a4-0163-3c15-ad8d-45e95dbd2099",
                                                "text": "Neuguinea und die nördlichen Molukken gehören zum Sahul-Schelf, der nördlichen Fortsetzung Australiens."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
