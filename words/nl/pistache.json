                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pistache_smaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twee bollen vanille en één <w>pistache</w>, graag.",
                            "target_lang_translations": {
                                "en": "Two scoops of vanilla and one <w>pistachio</w>, please."
                            }
                        },
                        {
                            "text": "Dit ijsje met de smaak van <w>pistache</w> is erg verfrissend op een warme dag.",
                            "target_lang_translations": {
                                "en": "This ice cream with <w>pistachio</w> flavor is very refreshing on a hot day."
                            }
