                                                "sense_id": "31ea8ef0-b2da-398d-acb3-e4c76c1f7079",
                                                "text": "Der Alkohol machte ihre Augen schwerfällig."
                                            },
                                            {
                                                "example_id": "91adfaaf-7e57-4a41-8625-9c166ac8978b",
                                                "sense_id": "31ea8ef0-b2da-398d-acb3-e4c76c1f7079",
                                                "text": "Der Sachbearbeiter trottete so schwerfällig zu seinem Schreibtisch, wie man es von einem Beamten erwarten würde."
                                            },
                                            {
                                                "example_id": "c09ae2da-1679-48e1-8557-1ba57e1428a0",
                                                "sense_id": "31ea8ef0-b2da-398d-acb3-e4c76c1f7079",
                                                "text": "Wären die meisten Menschen nicht so schwerfällig im Denken, wären alternative Lebensformen längst akzeptiert."
                                            },
                                            {
                                                "example_id": "99119359-2aff-4c41-bd78-aa3cc1f197fa",
                                                "sense_id": "31ea8ef0-b2da-398d-acb3-e4c76c1f7079",
                                                "text": "„Neben einer ausgeprägten Rechenschwäche zeigt sich das in einem verlangsamten Denkablauf, wodurch sie auch im situativen Erfassen und im Anpassungsverhalten schwerfällig und verlangsamt ist sowie wiederholt entscheidungsunsicher und einfach im emotionalen Erleben reagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
