                        "glosses": [
                            "A man who operates a saw, especially to cut timber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ebe380d-a03a-4e2c-af4b-c066ef89f02e",
                                "sense_id": "8c663601-6449-3ae7-af21-c98b92f0cd9e",
                                "text": "[…] In the very furthest part\nA clearing, lately cut, circled a sawmill,\nA little shack that buzzed until it shook,\nAnd breathed rankly of elm. I walked around;\nThe other side was open, whence I watched\nThe fat back of the sawman as he fed."
                            },
                            {
                                "example_id": "4ce9785e-1e7b-4415-96f6-39e99db68a20",
                                "sense_id": "8c663601-6449-3ae7-af21-c98b92f0cd9e",
                                "text": "Early in the century, Momma […] sold lunches to the sawmen in the lumberyard […] and the seedmen at the cotton gin […]"
                            },
                            {
                                "example_id": "6fba709b-61cc-4f4e-a17a-91285c0e3e94",
                                "sense_id": "8c663601-6449-3ae7-af21-c98b92f0cd9e",
                                "text": "A good sawman can take out eight cords a day, but Frank, driven by the knot of Jackson anger and wildness that drove all his people, could do more."
                            }
                        ]
                    }
