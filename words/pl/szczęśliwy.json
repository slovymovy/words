    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9477274d-3b91-375a-8f51-91a574ff4b5a",
                    "sense_definition": "Odczuwający głębokie zadowolenie, radość i satysfakcję z życia lub danej chwili; także wyrażający ten stan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jestem bardzo <w>szczęśliwy</w>, że mogłem cię dzisiaj spotkać.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>счастлив</w>, что смог встретить тебя сегодня.",
                                "en": "I am very <w>happy</w> that I could meet you today."
                            }
                        },
                        {
                            "text": "Ona zawsze ma <w>szczęśliwy</w> wyraz twarzy, gdy bawi się ze swoim psem.",
                            "target_lang_translations": {
                                "ru": "У неё всегда <w>счастливое</w> выражение лица, когда она играет со своей собакой.",
                                "en": "She always has a <w>happy</w> expression on her face when she plays with her dog."
                            }
                        }
                    ],
                    "synonyms": [
                        "radosny",
                        "pogodny",
                        "zadowolony",
                        "uradowany"
                    ],
                    "antonyms": [
                        "nieszczęśliwy"
                    ],
                    "common_phrases": [
                        "szczęśliwy człowiek",
                        "szczęśliwa rodzina",
                        "szczęśliwe dzieciństwo",
                        "szczęśliwy uśmiech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий глубокое удовлетворение, радость и довольство жизнью; также выражающий это состояние",
                        "en": "Feeling deep satisfaction, joy, and contentment with life or a given moment; also expressing this state."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счастливый",
                                "target_lang_sense_clarification": "испытывающий счастье"
                            },
                            {
                                "target_lang_word": "радостный",
                                "target_lang_sense_clarification": "полный радости"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "happy",
                                "target_lang_sense_clarification": "experiencing joy or contentment"
                            },
                            {
                                "target_lang_word": "joyful",
                                "target_lang_sense_clarification": "full of happiness and delight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e19d18-74ac-38ee-bbd6-60d5e9066484",
                    "sense_definition": "Pomyślny, udany; taki, który przebiegł bez problemów lub wydarzył się dzięki sprzyjającemu zbiegowi okoliczności",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "luck_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To był <w>szczęśliwy</w> traf, że akurat przechodziliśmy obok i mogliśmy pomóc.",
                            "target_lang_translations": {
                                "ru": "Это был <w>счастливый</w> случай, что мы как раз проходили мимо и могли помочь.",
                                "en": "It was a <w>lucky</w> coincidence that we were just passing by and could help."
                            }
                        },
                        {
                            "text": "Każda bajka dla dzieci powinna mieć <w>szczęśliwe</w> zakończenie.",
                            "target_lang_translations": {
                                "ru": "У каждой детской сказки должен быть <w>счастливый</w> конец.",
                                "en": "Every children's fairy tale should have a <w>happy</w> ending."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortunny"
                    ],
                    "antonyms": [
                        "niefortunny",
                        "pechowy",
                        "feralny",
                        "nieszczęśliwy"
                    ],
                    "common_phrases": [
                        "szczęśliwy traf",
                        "szczęśliwe zakończenie",
                        "szczęśliwy koniec",
                        "szczęśliwy zbieg okoliczności"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удачный, успешный; такой, который прошел без проблем или произошел благодаря удачному стечению обстоятельств",
                        "en": "Successful, fortunate; something that happened without problems or occurred due to a favorable turn of events."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удачный",
                                "target_lang_sense_clarification": "успешный"
                            },
                            {
                                "target_lang_word": "счастливый",
                                "target_lang_sense_clarification": "благополучный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lucky",
                                "target_lang_sense_clarification": "resulting from good fortune"
                            },
                            {
                                "target_lang_word": "fortunate",
                                "target_lang_sense_clarification": "happening by good chance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23b02104-31db-38b8-97dc-709a065ea488",
                    "sense_definition": "Przynoszący powodzenie lub uważany za taki, który zapewnia sukces",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "luck_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja <w>szczęśliwa</w> liczba to siedem, więc zawsze ją wybieram w loterii.",
                            "target_lang_translations": {
                                "ru": "Моё <w>счастливое</w> число — семь, поэтому я всегда выбираю его в лотерее.",
                                "en": "My <w>lucky</w> number is seven, so I always choose it in the lottery."
                            }
                        },
                        {
                            "text": "Zabieram na egzamin mój <w>szczęśliwy</w> długopis, żeby przyniósł mi powodzenie.",
                            "target_lang_translations": {
                                "ru": "Я беру на экзамен свою <w>счастливую</w> ручку, чтобы она принесла мне удачу.",
                                "en": "I am taking my <w>lucky</w> pen to the exam so it brings me good fortune."
                            }
                        }
                    ],
                    "synonyms": [
                        "fartowny",
                        "pomyślny",
                        "fuksiarski"
                    ],
                    "antonyms": [
                        "pechowy",
                        "feralny"
                    ],
                    "common_phrases": [
                        "szczęśliwa liczba",
                        "szczęśliwy los",
                        "szczęśliwa gwiazda"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий удачу или считающийся обеспечивающим успех",
                        "en": "Bringing good luck or considered to ensure success."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счастливый",
                                "target_lang_sense_clarification": "приносящий удачу"
                            },
                            {
                                "target_lang_word": "фартовый",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lucky",
                                "target_lang_sense_clarification": "believed to bring good fortune"
                            },
                            {
                                "target_lang_word": "auspicious",
                                "target_lang_sense_clarification": "suggesting future success"
                            }
                        ]
                    }
                }
            ]
        }
