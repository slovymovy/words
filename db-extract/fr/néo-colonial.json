                    {
                        "sense_id": "5459996d-938c-3a65-8352-61097388b04f",
                        "entry_id": "b9aff432-d183-3b3f-a7a2-16a59af0ee84",
                        "glosses": [
                            "Qui relève du néo-colonialisme, qui exploite sans avoir recours au colonialisme tel qu'il a été mis en place par les grandes puissances européennes de la Renaissance au milieu du vingtième siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e8fd23-f4be-4458-ba30-5600a525b9b6",
                                "sense_id": "5459996d-938c-3a65-8352-61097388b04f",
                                "text": "L’impérialisme occidental instrumentalise toujours les rivalités entre états-nations du Sud Global : la politique néo-coloniale de Macron et sa diplomatie bancale, contribuent à l’instabilité du continent tout entier."
                            }
                        ]
                    }
                ],
