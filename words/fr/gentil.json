                    "frequency": "Middle",
                    "semantic_group_id": "desapprobation_ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est bien <w>gentil</w> tout ça, mais qui va payer la note ?"
                        },
                        {
                            "text": "Ton idée est bien <w>gentille</w>, mais elle ne règle pas le problème."
                        }
                    ],
                    "common_phrases": [
