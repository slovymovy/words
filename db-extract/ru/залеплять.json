                    },
                    {
                        "form_id": "3032e615-e579-4978-ad9e-32c3cd80f836",
                        "entry_id": "e52be667-11db-3466-8a8f-77be41899ef7",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "залепля́вши"
                    },
                    {
                        "form_id": "de0e15cb-d3a8-4f03-ba95-e972872742ba",
                        "entry_id": "e52be667-11db-3466-8a8f-77be41899ef7",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… залепля́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0c95117-c327-3378-b254-4ff939a3fd8b",
                        "entry_id": "e52be667-11db-3466-8a8f-77be41899ef7",
                        "glosses": [
                            "замазывать, заделывать чем-либо липким, вязким"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6a9564-7c44-4384-a4fc-6a28616ac08c",
                                "sense_id": "e0c95117-c327-3378-b254-4ff939a3fd8b",
                                "text": "А за окном, залепляя всё вокруг глухотой белизны и тишины, простирается беспредельная зима."
                            },
                            {
                                "example_id": "3d5feaf7-4944-4040-964d-cbe0bcc64806",
                                "sense_id": "e0c95117-c327-3378-b254-4ff939a3fd8b",
                                "text": "― С нами все святые! ― присовокупила скотница, удваивая старания, ― долго ли до беды… ишь ветер какой, так с ног вот и ломит… да и снег-то глаза залепляет… пожалуйте сюда-с… здесь будет посуше…"
                            }
                        ]
                    },
                    {
                        "sense_id": "01359b40-b928-37d7-8b5a-3f6b521ba206",
                        "entry_id": "e52be667-11db-3466-8a8f-77be41899ef7",
                        "glosses": [
                            "заклеивать чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdf002c-1469-4351-a646-e68af9e820b5",
                                "sense_id": "01359b40-b928-37d7-8b5a-3f6b521ba206",
                                "text": "Ни одна суздальская картина не залепляла чистых бревенчатых стен; в углу, перед тяжёлым образом в серебряном окладе, теплилась лампадка; липовый стол недавно был выскоблен и вымыт; между брёвнами и по косякам окон не скиталось резвых прусаков, не скрывалось задумчивых тараканов."
                            },
                            {
                                "example_id": "874747b8-aea5-4e3e-8bc9-518b0cf4519f",
                                "sense_id": "01359b40-b928-37d7-8b5a-3f6b521ba206",
                                "text": "Со всех подозрительных посланий снимали копии, а без спросу распечатанный конверт снова искусно залепляли сургучом и отсылали адресату так, что тот ни о чём не догадывался."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
