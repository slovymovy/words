                                "sense_id": "da32fd23-3cee-3ff8-9e0a-50ad4ceef679",
                                "text": "Myrtle Hazard Lindsay walked up to the bust, and kissed its marble forehead, saying, \"This is the face of my Guardian Angel!\""
                            },
                            {
                                "example_id": "d0c02c97-8adf-47e3-a308-c68c2bc0d031",
                                "sense_id": "da32fd23-3cee-3ff8-9e0a-50ad4ceef679",
                                "text": "\"My husband used to say that girls with flower names fade fast.\" It was Myrtle who said this one day, out of the blue, and for some reason it made them all go weak with laughter."
                            }
                        ]
                    }
