                "senses": [
                    {
                        "sense_id": "3ba52be1-c715-3ad7-8cd7-691f7f0bd212",
                        "entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "glosses": [
                            "A nightjar, especially Caprimulgus europaeus (Eurasian nightjar)."
                        ],
                        "tags": [
                            "UK",
                            "regional"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8d0fadd4-b60a-3cb2-827c-4b595f73d8d1",
                        "entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "glosses": [
                            "A New World nightjar of the genus Chordeiles, especially Chordeiles minor."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "8d4e03ab-25d6-46be-8acc-6f1a2b45c728",
                                "sense_id": "8d0fadd4-b60a-3cb2-827c-4b595f73d8d1",
                                "text": "The swallows circled around and I watched them and the night-hawks flying above the roofs and drank the Cinzano."
                            }
                        ]
                    },
                    {
                        "sense_id": "1766be29-aa94-3086-9212-857ef1e80542",
                        "entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "glosses": [
                            "A person whose preference or custom is to remain awake and active during the night and the early morning hours."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88c6ab06-66ba-33a9-ade5-72e9efa0b733",
                        "entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "glosses": [
                            "A nighthawker (metal detectorist who works illegally at night)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "99037bd7-337a-3238-93c8-566701c42bcb",
                        "entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "glosses": [
                            "An unlicensed prostitute who worked the roadsides at night."
                        ],
                        "tags": [
                            "Japan",
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a40156c-7a15-4c20-8030-0019a304982a",
                        "source_entry_id": "d1dd89fe-0444-3edf-8e07-ef0f4075c947",
                        "source_sense_description": "Caprimulgus europaeus",
                        "target_lang_word": "engoulevent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engoulevent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                        "entry_id": "217e327a-c725-32c1-b2d4-b1207aea616f",
                                        "glosses": [
                                            "Passereau insectivore qui vole le bec largement ouvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b13a81-dc51-4fe7-9bd5-bf6b2b02f2c7",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "C'est un engoulevent, répondit Bénédict. Il est caché dans le tronc pourri de cet arbre."
                                            },
                                            {
                                                "example_id": "7da591ce-c65a-4f09-aa99-b82aaf502958",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "À trois reprises, devant Anne, rasant le sol, le bizarre oiseau qu’on nomme l’engoulevent passa. Il annonce toujours la nuit."
                                            },
                                            {
                                                "example_id": "6ccd6560-d207-4737-bb54-289c79ea7329",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Les heures de la nuit vinrent, chantées par deux loups amoureux, et par le mélancolique « Bois pourri ! Bois pourri ! » d’un engoulevent."
                                            },
                                            {
                                                "example_id": "004d5ec5-8506-4f65-86bb-d876b08f8b15",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Les enfants, ardents à terminer une partie de marelle, mêlaient leurs cris aux premiers coups de flûte de l'engoulevent."
                                            },
                                            {
                                                "example_id": "808cbd57-3d6e-40c7-ae6d-1e4c16f9cc95",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Découragé, l’engoulevent se met à redescendre en chancelant, et puis il tourne encore quatre fois dans le ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
