                        "entry_id": "377c852f-0ec2-3bae-9d2f-d498d3da7929",
                        "glosses": [
                            "Werkstoff oder ein Produkt, das aus zwei oder mehreren flächig miteinander verklebten Schichten besteht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb58cf5-fcd6-44d4-813d-2ff00f25b81a",
                                "sense_id": "6dddf526-47c8-346c-9496-efb6bc94da41",
                                "text": "Fertigparkett oder Laminat - wo liegen da die überhaupt die Unterschiede?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cef41fb6-c5b7-464a-a2e7-ecb501494d62",
