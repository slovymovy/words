{
    "word_family": [
        "abdication",
        "abdicator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "862ae5ac-8398-3f14-9045-f56bbd01ec45",
                    "sense_definition": "To formally give up or renounce a high office, throne, authority, or major responsibility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renounce_office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aging king decided to <w>abdicate</w> the throne in favor of his eldest daughter.",
                            "target_lang_translations": {
                                "zh": "年迈的国王决定将王位<w>退位</w>给他的长女。"
                            }
                        },
                        {
                            "text": "Leaders should not <w>abdicate</w> responsibility when a major crisis occurs.",
                            "target_lang_translations": {
                                "zh": "当重大危机发生时，领导者不应<w>放弃</w>责任。"
                            }
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "relinquish",
                        "resign",
                        "surrender",
                        "give up"
                    ],
                    "antonyms": [
                        "claim",
                        "retain",
                        "maintain",
                        "occupy"
                    ],
                    "common_phrases": [
                        "abdicate the throne",
                        "abdicate responsibility"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式放弃高位、王位、权力或重大责任。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "退位",
                                "target_lang_sense_clarification": "指君主放弃王位。"
                            },
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "指放弃责任或权力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eb29a54-1159-3013-858a-41550549206b",
                    "sense_definition": "To formally step down from a throne or high office (used intransitively).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renounce_office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under immense public pressure, the emperor chose to <w>abdicate</w> rather than face a revolution.",
                            "target_lang_translations": {
                                "zh": "在巨大的公众压力下，皇帝选择了<w>退位</w>，而不是面对革命。"
                            }
                        },
                        {
                            "text": "The prime minister refused to <w>abdicate</w> despite the growing political scandal.",
                            "target_lang_translations": {
                                "zh": "尽管政治丑闻不断发酵，首相仍拒绝<w>辞职</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resign",
                        "retire",
                        "stand down"
                    ],
                    "antonyms": [
                        "usurp",
                        "seize"
                    ],
                    "common_phrases": [
                        "choose to abdicate",
                        "refuse to abdicate"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式从王位或高位上退下（不及物用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "退位",
                                "target_lang_sense_clarification": "指君主或高层领导人辞职或下台。"
                            },
                            {
                                "target_lang_word": "辞职",
                                "target_lang_sense_clarification": "指官员或领导人辞去职务。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ca87ca-e5f7-30a4-8f47-fb7e18ccefa1",
                    "sense_definition": "To disown, disinherit, or expel a family member, especially a child.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disown_family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, a father had the legal right to <w>abdicate</w> his son for dishonorable behavior.",
                            "target_lang_translations": {
                                "zh": "在古代，父亲有权因儿子行为不端而与其<w>断绝关系</w>。"
                            }
                        },
                        {
                            "text": "The wealthy merchant threatened to <w>abdicate</w> his heir if he married without permission.",
                            "target_lang_translations": {
                                "zh": "那位富商威胁说，如果继承人未经许可就结婚，就将<w>剥夺</w>他的继承权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disown",
                        "disinherit",
                        "cast off"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of disowning a family member is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "断绝与家庭成员（尤其是子女）的关系，或剥夺其继承权。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "断绝关系",
                                "target_lang_sense_clarification": "指与家人断绝往来。"
                            },
                            {
                                "target_lang_word": "剥夺继承权",
                                "target_lang_sense_clarification": "指取消某人的继承资格。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}