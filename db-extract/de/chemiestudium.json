                        "examples": [
                            {
                                "example_id": "2994e508-8d8e-40c2-a95a-5be9d869ce01",
                                "sense_id": "bf9d2782-b8bf-35c1-8dcc-e9f8fa1f75d4",
                                "text": "„Während des Chemiestudiums wandte Tom seine umfangreichen EDV-Kenntnisse auch im Fachbereich der Uni an, indem er die dortige EDV als Administrator auf dem neuesten Stand hielt, soweit das den Vorschriften entsprechend möglich war.“"
                            },
                            {
                                "example_id": "ac607031-7206-4bad-9a2d-d128295b6a3e",
                                "sense_id": "bf9d2782-b8bf-35c1-8dcc-e9f8fa1f75d4",
                                "text": "„Wegen starker Kurzsichtigkeit von der Bundeswehr befreit, hatte er die Hälfte seines Chemiestudiums schon hinter sich und war seinen Studienkollegen weit voraus, eben weil er seine Freizeit kaum anders als in der Universität verbrachte.“"
                            },
                            {
                                "example_id": "24f53592-7ab3-4aae-b10a-86c7899c5104",
                                "sense_id": "bf9d2782-b8bf-35c1-8dcc-e9f8fa1f75d4",
                                "text": "„Vielleicht aber spielte im Unterbewussten auch der Gedanke mit, dass das Chemiestudium ein Umweg zur Medizin hätte sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
