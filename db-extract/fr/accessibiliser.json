                ],
                "senses": [
                    {
                        "sense_id": "6961c1a8-8138-367a-86cc-7c21d09b4ddc",
                        "entry_id": "4340c03a-947d-3c8b-b0c3-6866cf8f69e7",
                        "glosses": [
                            "Rendre accessible, ou plus accessible à tous, y compris aux handicapés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a3cb37-4c36-44ba-a0ef-fc5fbd26f2e6",
                                "sense_id": "6961c1a8-8138-367a-86cc-7c21d09b4ddc",
                                "text": "Ne pas passer une journée à tenter d'accessibiliser deux-trois tableaux hallucinants, pour un gain trop faible."
                            },
                            {
                                "example_id": "eaba6b0b-fca7-43df-bf22-545087cc5209",
                                "sense_id": "6961c1a8-8138-367a-86cc-7c21d09b4ddc",
                                "text": "Il aura droit à la sincère gratitude de ses compatriotes, montagnards aussi bien que touristes, s’il parvient à accessibiliser les récentes et étonnantes trouvailles de sa région, sans tomber dans les excès défiguratifs des funiculaires alpestres et des routes soi-disant nationales, qui ont saccagé les gorges du Tarn et les rivages de l’Estérel."
                            },
                            {
                                "example_id": "90a9555f-b67c-4966-b1f8-c10b35560f91",
                                "sense_id": "6961c1a8-8138-367a-86cc-7c21d09b4ddc",
                                "text": "Accessibiliser l'Internet... oui, mais pas à moitié!"
                            },
                            {
                                "example_id": "80640a29-cf48-4405-a544-b9fd0e92c51c",
                                "sense_id": "6961c1a8-8138-367a-86cc-7c21d09b4ddc",
                                "text": "Accessibiliser les pratiques sportives"
                            }
                        ]
                    }
                ],
