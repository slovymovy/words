                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43e2a9ad-8510-4a12-9509-65ea7e29633b",
                        "source_entry_id": "9a748378-4782-3eec-9b5f-31385897c169",
                        "source_sense_description": "извержение вулкана",
                        "target_lang_word": "Eruption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eruption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "885e1312-8b01-3a0d-bcfc-7011b367f63d",
                                        "entry_id": "78c702e2-30d5-3026-af6e-c8dbb9ec7230",
                                        "glosses": [
                                            "vulkanischer Ausstoß von Lava, Gestein und Asche"
                                        ],
                                        "tags": [
                                            "Vulkanologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba143dcc-5631-4752-8f67-29b49aa242d7",
                                                "sense_id": "885e1312-8b01-3a0d-bcfc-7011b367f63d",
                                                "text": "Die letzte Eruption des Ätna fand 2008 statt."
                                            },
                                            {
                                                "example_id": "cbbde96a-8dbe-43f9-8562-ff969896b746",
                                                "sense_id": "885e1312-8b01-3a0d-bcfc-7011b367f63d",
                                                "text": "„Die letzte Aktivität war die Eruption, die zur Bildung des Ulmener Maares vor rund 9.500 Jahren geführt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4577e47f-867f-392c-9714-545a34f5f50d",
                                        "entry_id": "78c702e2-30d5-3026-af6e-c8dbb9ec7230",
                                        "glosses": [
                                            "(großer) explosivartiger Ausbruch bei der Sonne und anderen Sternen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ef5f32-7999-4204-8158-e8b5080a919e",
                                                "sense_id": "4577e47f-867f-392c-9714-545a34f5f50d",
                                                "text": "„Aber bereits bei weniger starken Eruptionen können Satellitenbahnen gestört werden, was zu falschen GPS-Signalen führt; oder es werden Flugzeugstrecken, die über Pole laufen, umgeleitet, um die Passagiere vor erhöhter Teilchenstrahlung zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d2e2499-1c0e-41db-bc57-f2c2ebe02b0f",
                        "source_entry_id": "9a748378-4782-3eec-9b5f-31385897c169",
                        "source_sense_description": "извержение вулкана",
                        "target_lang_word": "Flare",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flare",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb91e6d-cd6b-3f81-a10a-1e0cef71c786",
                                        "entry_id": "eecde664-cdef-340a-a8af-fa17d4fda882",
                                        "glosses": [
                                            "Eruption aus der Chromosphäre der Sonne oder anderer Sterne, die durch Emission von Protonen, Elektronen und Ionen, sowie von Strahlung im ultravioletten und Röntgenspektrum charakterisiert ist. Flares treten hauptsächlich in Regionen mit Sonnenflecken und Sonnenfackeln auf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c021ae-609e-43ce-a1d9-f5be3e921815",
                                                "sense_id": "7cb91e6d-cd6b-3f81-a10a-1e0cef71c786",
                                                "text": "„Größere Flares können bis zu 1 ‰ der Sonnenoberfläche oder das zehnfache der Erdoberfläche einnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1fba309-06e2-39df-84ae-80a0b40b4b4b",
                                        "entry_id": "eecde664-cdef-340a-a8af-fa17d4fda882",
                                        "glosses": [
                                            "Lichterscheinung, die durch Reflexion und Streuung im Linsensystem eines Objektivs entsteht"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90659be-c25f-41ea-a0e1-1994b0761af5",
                                                "sense_id": "e1fba309-06e2-39df-84ae-80a0b40b4b4b",
                                                "text": "„Spielen Sie mit der Anzahl der Flares und mit der FlareSeed-Einstellung, bis Sie etwas gefunden haben, das ihrem Auge gefällt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba8879b0-4999-4eaf-8762-afb422e14404",
                        "source_entry_id": "9a748378-4782-3eec-9b5f-31385897c169",
                        "source_sense_description": "извержение вулкана",
                        "target_lang_word": "éruption",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éruption",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement de matières expulsées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1056af9-28cd-4ea5-afb4-79b42a037a16",
                                                "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                                "text": "Je voyageois en Italie : arrivé à Naples, je m’empressai de visiter ce fameux Vésuve, dont la première éruption éclata, selon quelques auteurs, sous l’empereur Titus, l’an soixante-dix-neuf de notre ère, et coûta la vie au célèbre Pline."
                                            },
                                            {
                                                "example_id": "fae1b465-dd89-4074-b83d-02772eebf4e7",
                                                "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                                "text": "Un fracas effroyable, accompagné d'une éruption de poussière et de fumée, annonça qu'une des autres façades venait de s’effondrer, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24660e4-d3bc-3a70-a163-8b0f573e0fcf",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement de matières expulsées.",
                                            "Jaillissement soudain et violent d’un puits en cours de forage."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière",
                                            "Forage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48885be9-4a8c-4c1f-8ae9-bb36d6309a7e",
                                                "sense_id": "e24660e4-d3bc-3a70-a163-8b0f573e0fcf",
                                                "text": "L’éruption du puits en cours de forage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Poussée de taches, de pustules, de boutons qui paraissent à la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b016828f-8d9e-4b7d-bd8c-4a8667227acc",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "Une éruption caractéristique couvrit le corps du bébé. C’était une scarlatine d’espèce maligne, qui devait nécessairement amener une inflammation interne."
                                            },
                                            {
                                                "example_id": "ff1cc9f5-b358-44e9-a6fc-6a07191f8a6f",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "Elle en avait contracté l’eczéma de la face, une éruption suintante qui la dévorait de sa brûlure atroce."
                                            },
                                            {
                                                "example_id": "634f0bef-fd3e-4df5-88e6-66897b9060e2",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "La fièvre aphteuse (cocotte), grave chez les bovidés, peut être transmise à l'espèce humaine. Elle donne lieu alors à une stomatite caractérisée par la fièvre et une éruption de grosses vésicules qui ont pour siège d’élection la face dorsale de la langue."
                                            },
                                            {
                                                "example_id": "9f0ed548-4ba9-41fa-9bd5-aaa5c6ff055f",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "La scarlatine est une angine streptococcique accompagnée d’une éruption cutanée due à la sécrétion de toxine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1914db7-5fd2-3cfe-8b44-1e2136287a10",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement d’une force, d’une énergie, d’une réalité intérieure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655b7272-6a39-4816-b517-596383cb3628",
                                                "sense_id": "d1914db7-5fd2-3cfe-8b44-1e2136287a10",
                                                "text": "Mousse entre chez les fous. Y règne un chaos en pièces détachées. Des hommes, des femmes, sortis d’eux-mêmes, en éruption spontanée. Aucun ne se contient, à chacun sa sève. Certains chantent, d’autres pleurent, d’autres hurlent ou crient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5817da7e-b267-473b-b0a8-de53cc4296f7",
                        "source_entry_id": "9a748378-4782-3eec-9b5f-31385897c169",
                        "source_sense_description": "вспышка на Солнце",
                        "target_lang_word": "Sonneneruption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonneneruption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                        "entry_id": "019a8116-00b3-3e2e-8af7-c06ab66e4d1c",
                                        "glosses": [
                                            "innerhalb der Chromosphäre der Sonne plötzlich auftretender Strahlungsausbruch, wenn die bogenförmig geschlossenen magnetischen Feldlinien aufbrechen"
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092ed8df-49be-469a-8c57-d13361e0d2b0",
                                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                                "text": "Thomas Berger … weist auf die Hauptgefahren hin: „Bei starken Sonneneruptionen werden viele hochenergetische Protonen ins All geschleudert. Und die Dosis kann auf einen Schlag so hoch sein, dass es bei Astronauten zur Strahlenkrankheit kommt.“"
                                            },
                                            {
                                                "example_id": "d2f11f0c-436d-462c-a9bf-c58b2e0d5145",
                                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                                "text": "Einen Vorgeschmack auf die Gefahren einer Sonneneruption bekam die Erde erst vor ein paar Jahren: 1989 war Kanada von massiven Stromausfällen und Störungen der Gasversorgung betroffen, nachdem ein Sonnensturm das Land getroffen hatte."
                                            },
                                            {
                                                "example_id": "d60846d8-5af3-4fc7-b626-d89f017fa3a4",
                                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                                "text": "Eine typische Sonneneruption setzt nach Angaben der Forscher die Energie von rund 100 Millionen Megatonnen TNT frei."
                                            },
                                            {
                                                "example_id": "44ec50f9-5c4c-4236-8993-4d3740bb3638",
                                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                                "text": "Er [Richard Carrington] entdeckte Anfang September 1859 eine Sonneneruption, von der man heute schätzt, dass dabei eine Energie von zehn Milliarden Hiroshima-Atombomben freigesetzt wurde."
                                            },
                                            {
                                                "example_id": "50821866-0b2e-40a5-9283-c32ac6185a00",
                                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                                "text": "Auch in Stromnetzen können Sonnenstürme Störungen verursachen. So führte 1973 eine Sonneneruption zu einem Stromausfall in der kanadischen Provinz Québec - sechs Millionen Menschen saßen damals im Dunkeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5400b26-01fb-46a4-b868-7ca0eda4786c",
                        "source_entry_id": "9a748378-4782-3eec-9b5f-31385897c169",
                        "source_sense_description": "вспышка на Солнце",
                        "target_lang_word": "éruption",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éruption",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement de matières expulsées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1056af9-28cd-4ea5-afb4-79b42a037a16",
                                                "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                                "text": "Je voyageois en Italie : arrivé à Naples, je m’empressai de visiter ce fameux Vésuve, dont la première éruption éclata, selon quelques auteurs, sous l’empereur Titus, l’an soixante-dix-neuf de notre ère, et coûta la vie au célèbre Pline."
                                            },
                                            {
                                                "example_id": "fae1b465-dd89-4074-b83d-02772eebf4e7",
                                                "sense_id": "cb4e8505-eb88-301e-a767-e3436e40d2d7",
                                                "text": "Un fracas effroyable, accompagné d'une éruption de poussière et de fumée, annonça qu'une des autres façades venait de s’effondrer, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24660e4-d3bc-3a70-a163-8b0f573e0fcf",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement de matières expulsées.",
                                            "Jaillissement soudain et violent d’un puits en cours de forage."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière",
                                            "Forage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48885be9-4a8c-4c1f-8ae9-bb36d6309a7e",
                                                "sense_id": "e24660e4-d3bc-3a70-a163-8b0f573e0fcf",
                                                "text": "L’éruption du puits en cours de forage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Poussée de taches, de pustules, de boutons qui paraissent à la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b016828f-8d9e-4b7d-bd8c-4a8667227acc",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "Une éruption caractéristique couvrit le corps du bébé. C’était une scarlatine d’espèce maligne, qui devait nécessairement amener une inflammation interne."
                                            },
                                            {
                                                "example_id": "ff1cc9f5-b358-44e9-a6fc-6a07191f8a6f",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "Elle en avait contracté l’eczéma de la face, une éruption suintante qui la dévorait de sa brûlure atroce."
                                            },
                                            {
                                                "example_id": "634f0bef-fd3e-4df5-88e6-66897b9060e2",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "La fièvre aphteuse (cocotte), grave chez les bovidés, peut être transmise à l'espèce humaine. Elle donne lieu alors à une stomatite caractérisée par la fièvre et une éruption de grosses vésicules qui ont pour siège d’élection la face dorsale de la langue."
                                            },
                                            {
                                                "example_id": "9f0ed548-4ba9-41fa-9bd5-aaa5c6ff055f",
                                                "sense_id": "aec6c26e-691b-3a7f-bf4d-932f1eb168d0",
                                                "text": "La scarlatine est une angine streptococcique accompagnée d’une éruption cutanée due à la sécrétion de toxine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1914db7-5fd2-3cfe-8b44-1e2136287a10",
                                        "entry_id": "171ce380-f95a-35a1-9756-5c818eb061ce",
                                        "glosses": [
                                            "Jaillissement d’une force, d’une énergie, d’une réalité intérieure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655b7272-6a39-4816-b517-596383cb3628",
                                                "sense_id": "d1914db7-5fd2-3cfe-8b44-1e2136287a10",
                                                "text": "Mousse entre chez les fous. Y règne un chaos en pièces détachées. Des hommes, des femmes, sortis d’eux-mêmes, en éruption spontanée. Aucun ne se contient, à chacun sa sève. Certains chantent, d’autres pleurent, d’autres hurlent ou crient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
