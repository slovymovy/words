                "senses": [
                    {
                        "sense_id": "87472c41-4c1f-3240-a7a1-af13fc37faf1",
                        "entry_id": "503c50bb-c36b-375a-a396-61cf4d60506e",
                        "glosses": [
                            "Alternative form of danna: shit."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "alternative",
                            "obsolete",
                            "slang"
