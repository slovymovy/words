                                                "sense_id": "875e9c93-d987-3794-9f8c-af4caf5c399a",
                                                "text": "Beim Fassanstich muss der Zapfen in das Fass geschlagen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "60d56fe6-c866-3444-a3f4-30c53ddd1aa1",
                                        "entry_id": "46ff4719-5709-37d7-8fbc-b8bf70443383",
