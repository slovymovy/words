        "fr-extract.jsonl": [
            {
                "entry_id": "43cfbbd7-d109-3ad7-a12d-83b8358fa10d",
                "word": "hypnotiseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2eb84bf2-bab7-4b95-bb5a-235bef708893",
                        "entry_id": "43cfbbd7-d109-3ad7-a12d-83b8358fa10d",
                        "tags": [
