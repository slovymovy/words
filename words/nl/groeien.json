            "senses": [
                {
                    "sense_id": "832f307f-6471-3032-a34f-4358444fe039",
                    "sense_definition": "Fysiek groter worden van levende organismen zoals mensen, dieren of planten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kinderen <w>groeien</w> erg snel in hun eerste levensjaar.",
                            "target_lang_translations": {
                                "en": "Children <w>grow</w> very quickly in their first year of life."
                            }
                        },
                        {
                            "text": "De planten in de tuin <w>groeien</w> goed door de regen van gisteren.",
                            "target_lang_translations": {
                                "en": "The plants in the garden are <w>growing</w> well thanks to yesterday's rain."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontwikkelen"
                    ],
                    "antonyms": [
                        "krimpen"
                    ],
                    "common_phrases": [
                        "hard groeien",
                        "uit de kleren groeien"
                    ],
                    "target_lang_definitions": {
                        "en": "Physical enlargement of living organisms such as humans, animals, or plants."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "to become physically larger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d5cc05c-0d13-323e-ae65-4b0eb0fcb97e",
                    "sense_definition": "Toenemen in aantal, omvang, waarde of intensiteit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economie is de laatste tijd weer een beetje <w>gegroeid</w>.",
                            "target_lang_translations": {
                                "en": "The economy has <w>grown</w> a little bit again lately."
                            }
                        },
                        {
                            "text": "Het aantal inwoners van de stad blijft elk jaar <w>groeien</w>.",
                            "target_lang_translations": {
                                "en": "The number of inhabitants in the city continues to <w>grow</w> every year."
                            }
                        }
                    ],
                    "synonyms": [
                        "toenemen",
                        "stijgen",
                        "vermeerderen"
                    ],
                    "antonyms": [
                        "krimpen"
                    ],
                    "common_phrases": [
                        "in aantal groeien",
                        "snel groeien"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in number, size, value, or intensity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "to increase in magnitude or quantity"
                            },
                            {
                                "target_lang_word": "increase",
                                "target_lang_sense_clarification": "to become greater in size or amount"
                            },
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "to become larger in scope or area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8777c77-4fd4-3bfa-b0f8-8d4f85363669",
                    "sense_definition": "Zich mentaal of emotioneel ontwikkelen of sterker worden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langzaam maar zeker <w>groeide</w> mijn zelfvertrouwen in de nieuwe baan.",
                            "target_lang_translations": {
                                "en": "Slowly but surely, my self-confidence <w>grew</w> in the new job."
                            }
                        },
                        {
                            "text": "Het is mooi om te zien hoe zij als persoon is <w>gegroeid</w>.",
                            "target_lang_translations": {
                                "en": "It is beautiful to see how she has <w>grown</w> as a person."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontwikkelen",
                        "ontplooien"
                    ],
                    "common_phrases": [
                        "zien groeien",
                        "geestelijk groeien"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop mentally or emotionally or to become stronger as a person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "to mature or develop personally"
                            },
                            {
                                "target_lang_word": "develop",
                                "target_lang_sense_clarification": "to progress or evolve mentally"
                            },
                            {
                                "target_lang_word": "mature",
                                "target_lang_sense_clarification": "to reach a more advanced stage of development"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "031fdc75-fb34-3223-a8f1-734c2786ce43",
                    "sense_definition": "Iets kunstmatig laten ontstaan of laten toenemen in een gecontroleerde omgeving.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technisch proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het laboratorium wordt een groot kristal van silicium <w>gegroeid</w>.",
                            "target_lang_translations": {
                                "en": "A large silicon crystal is being <w>grown</w> in the laboratory."
                            }
                        },
                        {
                            "text": "Wetenschappers proberen menselijk weefsel te <w>groeien</w> voor medisch onderzoek.",
                            "target_lang_translations": {
                                "en": "Scientists are trying to <w>grow</w> human tissue for medical research."
                            }
                        }
                    ],
                    "synonyms": [
                        "kweken",
                        "produceren"
                    ],
                    "common_phrases": [
                        "kristallen groeien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "overgankelijk gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cause something to be created or to increase artificially in a controlled environment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "to cultivate or produce in a lab or controlled setting"
                            },
                            {
                                "target_lang_word": "cultivate",
                                "target_lang_sense_clarification": "to foster the growth of biological material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
