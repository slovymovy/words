                                "target_senses": [
                                    {
                                        "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                        "entry_id": "ef831678-7c7b-3274-bae1-31b1ecb7bba5",
                                        "glosses": [
                                            "alkoholisches Getränk, das aus Gerste oder Malz durch Fermentierung und Destillation gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "274da876-22ee-416c-9677-d019c6447563",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "Ein Glas Whisky, bitte!"
                                            },
                                            {
                                                "example_id": "7efbb84c-5330-4d42-8060-2a0bf08b5909",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "„Lady Death bekam ihren Whisky, kippte ihn und wandte sich an Céline.“"
                                            },
                                            {
                                                "example_id": "51ac2d4a-8476-4ce7-94aa-e619031a7443",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "„Der eine trank Whisky, der andere aß Eis mit Schlagsahne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f99503a6-d14a-4986-a7fb-92c5169e33a5",
                        "source_entry_id": "28d754b1-3f2f-395b-b772-3363ad754408",
                        "source_sense_id": "0a575080-cc68-3e02-86da-99e4cffde796",
                        "source_sense_description": "een sterke drank die uit gerst of uit maïs en rogge gestookt is",
                        "target_lang_word": "whisky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whisky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da73c213-729a-3564-aa5b-8683c9d55db5",
                                        "entry_id": "cb3be114-099f-3924-9aa3-3973c3bc2502",
                                        "glosses": [
                                            "Alternative form of whiskey, an alcoholic liquor distilled from fermented grain, usually aged in oak barrels, (particularly) Scotch; a drink of this liquor."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Scotland",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3777a36b-0300-47b5-b661-edc4d82849c6",
                                                "sense_id": "da73c213-729a-3564-aa5b-8683c9d55db5",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whisky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bce43af-b2ab-36b0-8283-874ab1ad7021",
                                        "entry_id": "0e6c639b-d4c0-3086-bcc6-98d92d0e4d0a",
                                        "glosses": [
                                            "Alternative form of whiskey (“a light gig or carriage”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edea1a8f-52cc-4b61-820c-1d3d39d25976",
                                                "sense_id": "1bce43af-b2ab-36b0-8283-874ab1ad7021",
                                                "text": "1768, Ignatius Sancho, letter to Mr. M—, in Letters of the Late Ignatius Sancho, London: J. Nichols, 3rd edition, 1784, pp. 7-8,\nLook into old age, you will see avarice joined to poverty—letchery, gout, impotency, like three monkeys, or London bucks, in a one-horse whisky, driving to the Devil."
                                            },
                                            {
                                                "example_id": "ced62396-ab5b-4b51-b48a-9ab17245e2ac",
                                                "sense_id": "1bce43af-b2ab-36b0-8283-874ab1ad7021",
                                                "text": "At the appointed time Mr. Kettering’s one-horse chaise, or rather whisky, drove up to the door; for, as it was principally intended for him to visit his patients, when disinclined to mount his horse, it was built in the lightest manner, and without a head, that it might move with the greater expedition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e503a34-fb22-4a0b-9f9e-7a871f7f41ae",
                        "source_entry_id": "28d754b1-3f2f-395b-b772-3363ad754408",
                        "source_sense_id": "0a575080-cc68-3e02-86da-99e4cffde796",
                        "source_sense_description": "een sterke drank die uit gerst of uit maïs en rogge gestookt is",
                        "target_lang_word": "whisky",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whisky",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a575917c-10a4-39ca-a821-ce486cb56e69",
                                        "entry_id": "59e967ff-a3f6-3241-8525-60f3a45339bb",
                                        "glosses": [
                                            "Eau-de-vie d’orge malté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771cad66-1143-48d5-8c7b-4d0172700d2e",
                                                "sense_id": "a575917c-10a4-39ca-a821-ce486cb56e69",
                                                "text": "On l’apercevait chez Weber, mince et moqueur, penché sur son verre de whisky and soda avec un étincelant œil de biais, observant l’existence, tripotant sa barbiche et crispant ses mains fines, comme s’il allait s’étirer."
                                            },
                                            {
                                                "example_id": "b0603086-9486-40bf-bad0-bc7d6922d0b7",
                                                "sense_id": "a575917c-10a4-39ca-a821-ce486cb56e69",
                                                "text": "La décoration également, raffinée et l’atmosphère y est conviviale autour de cocktails connus et reconnus comme un dry Martini, un daïquiri, une margarita, un bloody-mary, un cuba-libre, une piña-colada…, mais aussi des cocktails sans alcool, un apéritif classique avec une très intéressante carte de whiskies et de champagnes."
                                            },
                                            {
                                                "example_id": "63a80a3e-1d42-40d9-9f06-856e28e26bd6",
                                                "sense_id": "a575917c-10a4-39ca-a821-ce486cb56e69",
                                                "text": "Le whisky n’était pas du bourbon mais du scotch, du White Horse, du bon, pour Gérard du moins : les Yankees buvaient du rye, ils aiment le goût de brillantine."
                                            },
                                            {
                                                "example_id": "6f3b4d4d-0827-4351-969b-30a558768c26",
                                                "sense_id": "a575917c-10a4-39ca-a821-ce486cb56e69",
                                                "text": "En solo, c’est plus âpre mais sans aucun doute ses textes prennent tout leur relief devant un auditoire qui ne suce pas que des glaçons : « Le whisky ne fait pas des menteurs, il fabrique des imbéciles », chante-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68642e3c-5a4c-376a-91e4-74d047cabdf7",
                                        "entry_id": "59e967ff-a3f6-3241-8525-60f3a45339bb",
                                        "glosses": [
                                            "Verre de whisky."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3f0f4ff-3765-409d-bcdb-01b3e8b1044f",
                                                "sense_id": "68642e3c-5a4c-376a-91e4-74d047cabdf7",
                                                "text": "Je voudrais commander deux whiskys s'il vous plaît."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
