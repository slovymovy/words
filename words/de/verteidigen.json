            "pos": "verb",
            "senses": [
                {
                    "sense_id": "118a82a9-f386-35c8-9300-d41b6e3c22ab",
                    "sense_definition": "Jemanden oder etwas gegen einen physischen oder militärischen Angriff schützen und diesen abwehren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abwehr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Soldaten mussten die Stadt gegen die feindlichen Truppen <w>verteidigen</w>."
                        },
                        {
                            "text": "Im Notfall hat jeder Bürger das Recht, sich selbst zu <w>verteidigen</w>."
                        }
                    ],
                    "antonyms": [
                        "angreifen"
                    ],
                    "common_phrases": [
                        "sein Land verteidigen",
                        "sich selbst verteidigen"
                    ]
                },
                {
                    "sense_id": "61164972-6abd-3772-ae5d-42c6c8590a34",
                    "sense_definition": "Eine Meinung, Entscheidung oder ein Verhalten mit Argumenten gegen Einwände und Kritik stützen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtfertigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Politiker musste seinen Standpunkt vor den kritischen Journalisten mutig <w>verteidigen</w>."
                        },
                        {
                            "text": "Sie <w>verteidigte</w> ihre Entscheidung mit guten Argumenten gegen alle Vorwürfe der Kollegen."
                        }
                    ],
                    "common_phrases": [
                        "seine Meinung verteidigen",
                        "seinen Standpunkt verteidigen"
                    ],
                    "synonyms": [
                        "rechtfertigen"
                    ]
                },
                {
                    "sense_id": "920499f2-8142-3331-95e6-47fe05479d3d",
                    "sense_definition": "Als Anwalt die rechtlichen Interessen einer beschuldigten Person vor Gericht vertreten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die erfahrene Anwältin wird den Angeklagten im kommenden Strafprozess vor Gericht <w>verteidigen</w>."
                        },
                        {
                            "text": "Der Beschuldigte entschied sich dafür, sich vor Gericht selbst zu <w>verteidigen</w>."
                        }
                    ],
                    "antonyms": [
                        "anklagen"
                    ],
                    "common_phrases": [
                        "einen Angeklagten verteidigen",
                        "sich vor Gericht verteidigen"
                    ]
                }
            ]
        },
