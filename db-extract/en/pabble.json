                        "entry_id": "96a0b5b5-8b46-3bde-b9e5-7b5d8eb7ffec",
                        "glosses": [
                            "To make the sound like liquid or porridge makes when bubbling under heat, on a stove."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cd3efd0e-6ca0-4287-b94a-e71491ac0cac",
                                "sense_id": "2532022d-4c3c-32cb-826a-ebced1e67c3c",
                                "text": "[…] and also to blear your een, at the same time makin' the room so insufferably hot that water would pabble in a dish […]"
                            },
                            {
                                "example_id": "3ed3ae34-c595-49c4-9072-00799748a08a",
                                "sense_id": "2532022d-4c3c-32cb-826a-ebced1e67c3c",
                                "text": "The hissing, and the fizzing, and the pabbling of the great pan in which the basted trouts are writhing."
                            },
                            {
                                "example_id": "ce40963a-9575-4272-b230-1d15a392ef88",
                                "sense_id": "2532022d-4c3c-32cb-826a-ebced1e67c3c",
                                "text": "We hear them pabbling in the pan, as the landlady turns them lightly over with her knife in the buttered meal […]"
                            }
                        ]
                    }
