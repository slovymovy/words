                    },
                    {
                        "translation_id": "f4cb44b7-9232-4db1-8643-e2883113c812",
                        "source_entry_id": "1182e5fc-ec99-3498-be69-9a2fd8603012",
                        "source_sense_description": "река в Германии",
                        "target_lang_word": "Main",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Main",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "680b3591-472e-311d-9d15-c87e132c54e7",
                                        "entry_id": "5b7369a0-6bd4-3cb2-9f8b-59e518b7bfb5",
                                        "glosses": [
                                            "ein bedeutender rechtsrheinischer Nebenfluss, welcher im Fichtelgebirge entspringt, ausschließlich Deutschland durchfließt und der östlich von Wiesbaden und Mainz in den Rhein mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b6d9e3-4fd0-4a56-92d4-1632eb4a2e70",
                                                "sense_id": "680b3591-472e-311d-9d15-c87e132c54e7",
                                                "text": "Es führt über den Main / Eine Brücke von Stein / Wer darüber will gehn / Muss im Tanze sich drehn - (Volkslied)"
                                            },
                                            {
                                                "example_id": "92ab56d6-83ce-4046-999a-b1b96ddf5c8c",
                                                "sense_id": "680b3591-472e-311d-9d15-c87e132c54e7",
                                                "text": "Am Main entlang geht es weiter gen Würzburg mit seiner barocken Residenz."
                                            },
                                            {
                                                "example_id": "b332a181-6293-4613-b3e8-b0cfbd2191fe",
                                                "sense_id": "680b3591-472e-311d-9d15-c87e132c54e7",
                                                "text": "„Die Regnitz und die Altmühl, die Nebenflüsse des Mains und der Donau, sollten durch einen schiffbaren Graben miteinander verbunden werden.“"
                                            },
                                            {
                                                "example_id": "133291b8-e5ec-4090-84d3-2c6c2e2b06cc",
                                                "sense_id": "680b3591-472e-311d-9d15-c87e132c54e7",
                                                "text": "„Im Folgejahr war der Winter dagegen kalt und trocken, der Main fror von Mitte Januar bis Anfang März zu, und Vater Rhein rührte sich im Februar bei Köln vor Frost nicht mehr von der Stelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09ed1b02-1d18-4738-95a7-046719c912a9",
                        "source_entry_id": "1182e5fc-ec99-3498-be69-9a2fd8603012",
                        "source_sense_description": "река в Германии",
                        "target_lang_word": "Main",
