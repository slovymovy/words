                                "target_senses": [
                                    {
                                        "sense_id": "9ca3b246-f106-381f-864f-f6770f040a47",
                                        "entry_id": "d103be00-2892-3557-b7a3-dba9d98eca09",
                                        "glosses": [
                                            "Mats, a collection of ground coverings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "801b58ee-fabb-4108-bea2-51e38bc7836f",
                                                "sense_id": "9ca3b246-f106-381f-864f-f6770f040a47",
                                                "text": "His departure oppressed me with melancholy, and, re-entering the dwelling, I threw myself almost in despair upon the matting of the floor."
                                            },
                                            {
                                                "example_id": "0ae799a7-dca3-4b2a-bba8-d69ed876d8c6",
                                                "sense_id": "9ca3b246-f106-381f-864f-f6770f040a47",
                                                "text": "The doorways had a transverse mat well with a 1½in thick floor mat. In service it was discovered that the matting absorbed moisture which eventually resulted in corrosion of the steel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6c6d45-3d6a-3238-9c34-33f89e936539",
                                        "entry_id": "d103be00-2892-3557-b7a3-dba9d98eca09",
                                        "glosses": [
                                            "Coarse fabric, of the kind used to make mats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1c14b5-efcc-4f37-9273-7ad5c0588d3a",
                                                "sense_id": "0f6c6d45-3d6a-3238-9c34-33f89e936539",
                                                "text": "... the sails are of Matting and are made narrow at the head and Square at the foot,...\nBesides Cloth they [Tahitians] make several different sorts of matting, both better and finer than any we have in Europe; the stuff they make it on is the Produce of the Palm tree."
                                            }
                                        ]
