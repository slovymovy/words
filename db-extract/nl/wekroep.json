                        "source_entry_id": "3cf870a5-fe5e-3946-add6-22e5de662c86",
                        "source_sense_id": "e59f793d-a720-3b37-a3bb-42b1dcfd737e",
                        "source_sense_description": "dringende oproep",
                        "target_lang_word": "exhortation",
