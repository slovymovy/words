                                "example_id": "952ad67d-9b70-41ed-b6d5-59e5383570ca",
                                "sense_id": "704f00d7-fa32-3ab0-a876-3648de6e883d",
                                "text": "„Das gesamte Steuerwesen unserer Republik ist darauf angelegt, die Reichsten der Reichen zu schonen.“"
                            }
