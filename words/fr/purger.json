    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a42f1f3a-380d-3b36-a0d2-301c9c9542ee",
                    "sense_definition": "Accomplir une peine de prison ou exécuter une sanction judiciaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le détenu espère être libéré plus tôt après avoir <w>purgé</w> la moitié de sa condamnation."
                        },
                        {
                            "text": "L'accusé devra <w>purger</w> sa peine dans un établissement pénitentiaire de haute sécurité."
                        }
                    ],
                    "common_phrases": [
                        "purger sa peine",
                        "purger une peine"
                    ]
                },
                {
                    "sense_id": "5490d5f8-5aca-324f-9a04-2ca4a53b7bcf",
                    "sense_definition": "Évacuer l'air, l'eau ou les impuretés contenus dans une tuyauterie ou un mécanisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant le début de l'hiver, il est conseillé de <w>purger</w> chaque radiateur de la maison."
                        },
                        {
                            "text": "Le garagiste a pris le temps de <w>purger</w> le circuit de freinage pour chasser l'air."
                        }
                    ],
                    "common_phrases": [
                        "purger un radiateur",
                        "purger le circuit"
                    ]
                },
                {
                    "sense_id": "52d91059-05af-314e-83e1-a6a565058b32",
                    "sense_definition": "Nettoyer ou vider un système informatique en supprimant les données inutiles ou périmées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pensez à <w>purger</w> le cache de votre navigateur internet afin d'actualiser la page."
                        },
                        {
                            "text": "L'administrateur système a décidé de <w>purger</w> les anciens fichiers volumineux du serveur."
                        }
                    ],
                    "common_phrases": [
                        "purger le cache",
                        "purger les données"
                    ]
                },
                {
                    "sense_id": "75acc501-e7ce-38da-93fe-0ef209d84cc8",
                    "sense_definition": "Éliminer de manière brutale les opposants ou les personnes indésirables au sein d'une organisation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dictateur a décidé de <w>purger</w> l'armée de tous les officiers soupçonnés de trahison."
                        },
                        {
                            "text": "Après la crise interne, le parti politique a cherché à <w>purger</w> ses membres dissidents."
                        }
                    ],
                    "common_phrases": [
                        "purger les rangs",
                        "purger un parti"
                    ]
                },
                {
                    "sense_id": "e475fd22-d5d6-34c5-ab0c-28fb6b01e4c2",
                    "sense_definition": "Nettoyer le système digestif en provoquant l'évacuation des selles à l'aide d'un remède.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a recommandé de se <w>purger</w> avant de passer cet examen radiologique."
                        },
                        {
                            "text": "Dans le temps, on utilisait des tisanes amères pour <w>purger</w> les enfants au printemps."
                        }
                    ],
                    "common_phrases": [
                        "se purger"
                    ]
                },
                {
                    "sense_id": "9c767770-2d73-3d89-9168-a91940f4b064",
