                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e3d7e4f-5479-341b-b54d-a507228c4c50",
                        "entry_id": "744a42a7-5af2-3161-8f07-4f8f4fce536d",
                        "glosses": [
                            "Narcissus jonquilla, gatunek narcyza o charakterystycznych żółtych kwiatach"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9b61e32d-df97-45fa-9fff-d3e8561a10fb",
                                "sense_id": "4e3d7e4f-5479-341b-b54d-a507228c4c50",
                                "text": "Kiedy ją znaleziono w żółtym podartym prochowcu, wyglądała jak żonkil zapatrzony w nieboskłon"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "81f0f27e-5289-3847-8fa3-d9e99a25df80",
                        "entry_id": "744a42a7-5af2-3161-8f07-4f8f4fce536d",
                        "glosses": [
                            "kwiat żonkila (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f4e0fb-a104-46d8-9668-1e0ef6a819a7",
                                "sense_id": "81f0f27e-5289-3847-8fa3-d9e99a25df80",
                                "text": "Mysz leżała bez drgnienia wśród pięknej porcelany i apetycznych kawałków tortu orzechowego, a żonkile w kobaltowym wazonie skłaniały nad nią żałobnie swe anemiczne główki"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27bcc84c-8fe3-46c5-9566-e486909744eb",
                        "source_entry_id": "744a42a7-5af2-3161-8f07-4f8f4fce536d",
                        "source_sense_id": "4e3d7e4f-5479-341b-b54d-a507228c4c50",
                        "target_lang_word": "jonquil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jonquil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4581091-aed5-3639-99d6-c23e2003ca92",
                                        "entry_id": "c5db98e5-1ff5-3fe3-bb9f-d92676d24419",
                                        "glosses": [
                                            "A fragrant bulb flower (Narcissus jonquilla), a species of daffodil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "876d7670-f537-355c-9fa6-380a818415ff",
                                        "entry_id": "c5db98e5-1ff5-3fe3-bb9f-d92676d24419",
                                        "glosses": [
                                            "A shade of yellow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5373fd1e-c31a-4c9d-99d3-82b73ffcb760",
                                                "sense_id": "876d7670-f537-355c-9fa6-380a818415ff",
                                                "text": "She had a jonquil silk pelisse, a bonnet of the same colour, with a bird of paradise plume, looking very much like an illuminated butterfly."
                                            },
                                            {
                                                "example_id": "8ea2bded-2651-432c-b750-8f5bc6062ed8",
                                                "sense_id": "876d7670-f537-355c-9fa6-380a818415ff",
                                                "text": "At sunset dusky ghosts of sampans, laden with families living up the river, glide homeward against a jonquil sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "767588a8-f79b-422b-9f80-701b179cc879",
                        "source_entry_id": "744a42a7-5af2-3161-8f07-4f8f4fce536d",
                        "source_sense_id": "4e3d7e4f-5479-341b-b54d-a507228c4c50",
                        "target_lang_word": "daffodil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daffodil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                                        "entry_id": "a1f69d87-d8cc-3052-828e-11c56b5558c7",
                                        "glosses": [
                                            "A bulbous plant of the genus Narcissus, with yellow flowers and a trumpet shaped corona, especially Narcissus pseudonarcissus, the national flower of Wales."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8917fa6-1eee-4d3d-918c-a041afc3ddae",
                                                "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                                                "text": "When daffadils begin to peere, / With heigh the Doxy ouer the dale, / Why then comes in the ſweet o’ the yeere, / For the red blood raigns in yͤ winters pale."
                                            },
                                            {
                                                "example_id": "e64bd392-06a1-4138-83c7-8e21db063c23",
                                                "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                                                "text": "I wandered lonely as a Cloud / That floats on high o’er Vales and Hills, / When all at once I saw a crowd / A host of dancing Daffodills; / Along the Lake, beneath the trees, / Ten thousand dancing in the breeze."
                                            },
                                            {
                                                "example_id": "a31c6a45-143f-4af5-b940-66143f2d8941",
                                                "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                                                "text": "Was there ever a more beautiful name in the world than daffodil? Say it over to yourself, and then say “agapanthus” or “chrysanthemum,” or anything else you please, and tell me if the daffodils do not have it."
                                            },
                                            {
                                                "example_id": "05828140-a546-4369-a26a-e2d6755b7fd5",
                                                "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                                                "text": "As us fairy folks sweep from the hill\n Never caught us and never will\n Pulling roses and daffodils\n Mayhem in the high degree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7968ec97-6989-3195-a77a-8ed66d5003a9",
                                        "entry_id": "a1f69d87-d8cc-3052-828e-11c56b5558c7",
                                        "glosses": [
                                            "A brilliant yellow color, like that of a daffodil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57257aad-b3ef-482a-9e82-673a4594e9a4",
                                                "sense_id": "7968ec97-6989-3195-a77a-8ed66d5003a9",
                                                "text": "Where ships of purple gently toss / On seas of daffodil, / Fantastic sailors mingle, / And then—the wharf is still."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daffodil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26823465-5001-3357-9bef-c1e00ad23b4b",
                                        "entry_id": "335be6c8-ece9-3187-9d8a-b577a3820781",
                                        "glosses": [
                                            "Of a brilliant yellow color, like that of a daffodil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33c3a33b-6b5d-4551-ab2a-7c7d8dd2466f",
                        "source_entry_id": "744a42a7-5af2-3161-8f07-4f8f4fce536d",
                        "source_sense_id": "4e3d7e4f-5479-341b-b54d-a507228c4c50",
                        "target_lang_word": "jonquille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jonquille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8208dc5-89ac-3da8-bade-fe44ad8d1b82",
                                        "entry_id": "01cb9d51-588f-372a-a386-bd44bca69a3f",
                                        "glosses": [
                                            "Qualifie cette couleur."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2545f1e-df1b-4b95-be4d-6a5ad9510ab5",
                                                "sense_id": "f8208dc5-89ac-3da8-bade-fe44ad8d1b82",
                                                "text": "Ils manœuvraient sous la surveillance d’un caporal équipé comme eux, mais dont la coiffure portait en outre deux galons de laine jonquille, insigne de son grade."
                                            },
                                            {
                                                "example_id": "8e2dc593-057e-49a2-9853-1812a3688871",
                                                "sense_id": "f8208dc5-89ac-3da8-bade-fe44ad8d1b82",
                                                "text": "Le 9e a des passe-poils jaune jonquille… cela est plus gai… oui, mais c’est moins noble, moins sévère, moins militaire…"
                                            },
                                            {
                                                "example_id": "cf8e1383-cce3-419f-bdff-f90dc1bd2ead",
                                                "sense_id": "f8208dc5-89ac-3da8-bade-fe44ad8d1b82",
                                                "text": "Elle était si jolie avec son bonnet rond et son ruban rose, son déshabillé de cirsakas et ses petits souliers jonquille, que mon oncle s'arrêta un instant pour la regarder."
                                            },
                                            {
                                                "example_id": "60b18c64-7b1d-446f-b040-5367a5cf8cb4",
                                                "sense_id": "f8208dc5-89ac-3da8-bade-fe44ad8d1b82",
                                                "text": "Le garde-chiourme parlait à une voisine. Son képi à visière carrée, son ceinturon, son dolman noir et son pantalon bleu, à passepoil jonquille, provoquaient dans la rue une grandissante curiosité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jonquille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0312db2f-ce77-3cca-94f2-e17ed1f66432",
                                        "entry_id": "1617a159-fc0d-3bcc-99d4-2987d875aec0",
                                        "glosses": [
                                            "Plante du genre des narcisses (Narcissus jonquilla L., 1753), spontanée en Europe, que l’on cultive aussi dans les jardins pour son élégance et son parfum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af352c4-ef53-428c-91a0-ef01f750d6ac",
                                                "sense_id": "0312db2f-ce77-3cca-94f2-e17ed1f66432",
                                                "text": "À chaque escale à Amsterdam, je filais au marché aux fleurs du Singel ou chez un vieil horticulteur de Schoorl pour lui rapporter des oignons de jonquilles, de jacinthes, de muscaris, d'amaryllis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d14a56-162f-3b99-a08f-7334e4ae0e6e",
                                        "entry_id": "1617a159-fc0d-3bcc-99d4-2987d875aec0",
                                        "glosses": [
                                            "Fleur de cette plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab886a0-845f-4b3b-9c8a-f0d0919de308",
                                                "sense_id": "b1d14a56-162f-3b99-a08f-7334e4ae0e6e",
                                                "text": "Jonquille simple, double. Odeur de jonquille. Essence de jonquille."
                                            },
                                            {
                                                "example_id": "fa8c976e-5988-4cbc-814b-b97cbd5ffaa4",
                                                "sense_id": "b1d14a56-162f-3b99-a08f-7334e4ae0e6e",
                                                "text": "J’expédiai en même temps dans la campagne trois enfants chargés de me rapporter des branches de verdure, et des gerbes, de pleins paniers de narcisses et de jonquilles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jonquille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18f5378f-c2e8-3087-9386-c5940dbae117",
                                        "entry_id": "f83858f2-d3a0-3d6d-b472-3f2bdae965a7",
                                        "glosses": [
                                            "Couleur secondaire composée avec du blanc et du jaune."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e01ea1-37c4-491e-bf53-3d0a137b9bd7",
                                                "sense_id": "18f5378f-c2e8-3087-9386-c5940dbae117",
                                                "text": "Le rousset doré. Ch. D'abord d'un beau jonquille mêlé de pourpre; ensuite brouillé d'un rouge indécis entre le pourpre et l’écarlate et d'un jaune jonquille plus ou moins foncé; […]."
                                            },
                                            {
                                                "example_id": "fd544260-6b13-46c4-9eee-6080ad38d66e",
                                                "sense_id": "18f5378f-c2e8-3087-9386-c5940dbae117",
                                                "text": "La Moire olivâtre, de même forme que les précédentes, & non dépouillée, non plus que les suivantes, mais à robe d'un jonquille sale nué de vert-olivâtre dans la direction des crûes, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
