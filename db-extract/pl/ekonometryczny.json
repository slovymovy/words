                                "target_senses": [
                                    {
                                        "sense_id": "e2b31757-b329-3071-8a23-8ec5cec7760c",
                                        "entry_id": "003ac24d-70be-3fe4-af0c-bc1517e1004f",
                                        "glosses": [
                                            "die Ökonometrie betreffend, auf der Ökonometrie beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c57f4a-b1c0-4f0a-a6cc-90ab1e4a68fd",
                                                "sense_id": "e2b31757-b329-3071-8a23-8ec5cec7760c",
                                                "text": "„Als ginge es um das Geschlecht der Engel, streiten Wirtschaftwissenschaftler seit gut einem Jahrzehnt darüber, ob es ökonometrisch nachweisbar ist, daß Militärausgaben das Wachstum hemmen.“"
                                            }
                                        ],
