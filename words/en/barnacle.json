{
    "word_family": [
        "barnacled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71bf3f46-e5fe-3e46-80de-55e944047dbf",
                    "sense_definition": "A marine crustacean of the subclass Cirripedia that attaches itself to submerged surfaces such as tidal rocks or the bottoms of ships.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marine_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bottom of the old wooden boat was completely covered in <w>barnacles</w>.",
                            "target_lang_translations": {
                                "ru": "Дно старой деревянной лодки было полностью покрыто <w>морскими желудями</w>."
                            }
                        },
                        {
                            "text": "We scraped the sharp <w>barnacles</w> off the rocks before letting the children swim.",
                            "target_lang_translations": {
                                "ru": "Мы соскребли острые <w>балянусы</w> с камней, прежде чем разрешить детям купаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "covered in barnacles",
                        "scrape off barnacles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морское усоногое ракообразное, прикрепляющееся к погруженным в воду поверхностям, таким как приливные скалы или днища кораблей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской жёлудь",
                                "target_lang_sense_clarification": "усоногий рак"
                            },
                            {
                                "target_lang_word": "морская уточка",
                                "target_lang_sense_clarification": "усоногий рак"
                            },
                            {
                                "target_lang_word": "балянус",
                                "target_lang_sense_clarification": "научное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd1794a9-841d-3b7a-9895-a7f8f142e536",
                    "sense_definition": "The barnacle goose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A flock of <w>barnacles</w> migrated south for the winter season.",
                            "target_lang_translations": {
                                "ru": "Стая <w>белощёких казарок</w> улетела на юг на зимний сезон."
                            }
                        },
                        {
                            "text": "The naturalist spent hours photographing the nesting habits of the wild <w>barnacle</w>.",
                            "target_lang_translations": {
                                "ru": "Натуралист часами фотографировал особенности гнездования дикой <w>казарки</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Белощекая казарка (птица)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белощёкая казарка",
                                "target_lang_sense_clarification": "вид дикого гуся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1fe9d58-6406-3bec-97f6-69e42e3ab592",
                    "sense_definition": "A deprecated or obsolete file, image or other artifact that remains with a project even though it is no longer needed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "software_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to clean up the repository and delete every old <w>barnacle</w> left from the previous version.",
                            "target_lang_translations": {
                                "ru": "Нам нужно навести порядок в репозитории и удалить весь старый <w>хлам</w>, оставшийся от предыдущей версии."
                            }
                        },
                        {
                            "text": "That unused image asset is just a <w>barnacle</w> slowing down our build process.",
                            "target_lang_translations": {
                                "ru": "Этот неиспользуемый графический ресурс — просто <w>мусор</w>, замедляющий процесс сборки."
                            }
                        }
                    ],
                    "synonyms": [
                        "cruft"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "programming jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревший или ненужный файл, изображение или другой артефакт, который остается в проекте, хотя в нем больше нет необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "устаревшие файлы в проекте"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные артефакты кода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c59af6-29db-3857-adba-0b0dd32f46ed",
                    "sense_definition": "A worldly sailor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>barnacle</w> sat by the docks, telling stories of his voyages across the Pacific.",
                            "target_lang_translations": {
                                "ru": "Старый <w>морской волк</w> сидел у причала, рассказывая истории о своих плаваниях по Тихому океану."
                            }
                        },
                        {
                            "text": "No young sailor could match the experience of that seasoned <w>barnacle</w>.",
                            "target_lang_translations": {
                                "ru": "Ни один молодой матрос не мог сравниться опытом с этим бывалым <w>морским волком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shellback"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "nautical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывалый, опытный моряк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской волк",
                                "target_lang_sense_clarification": "опытный моряк"
                            },
                            {
                                "target_lang_word": "старый морской волк",
                                "target_lang_sense_clarification": "бывалый матрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65744d7b-b874-3609-9845-85ac1d067b8f",
                    "sense_definition": "An instrument like a pair of pincers, to fix on the nose of a vicious horse while shoeing so as to make it more tractable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith used a <w>barnacle</w> to keep the wild stallion calm during shoeing.",
                            "target_lang_translations": {
                                "ru": "Кузнец использовал <w>закрутку</w>, чтобы успокоить дикого жеребца во время ковки."
                            }
                        },
                        {
                            "text": "He reached for the heavy iron <w>barnacle</w> when the horse began to kick.",
                            "target_lang_translations": {
                                "ru": "Он потянулся за тяжелой железной <w>закруткой</w>, когда лошадь начала брыкаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "twitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент наподобие щипцов, надеваемый на нос строптивой лошади во время ковки, чтобы сделать её более послушной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрутка",
                                "target_lang_sense_clarification": "для усмирения лошадей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afb7a531-74d5-3e0c-bc01-e7ab620842fd",
                    "sense_definition": "A pair of spectacles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He adjusted the heavy <w>barnacles</w> on his nose before reading the letter.",
                            "target_lang_translations": {
                                "ru": "Он поправил тяжелые <w>окуляры</w> на носу, прежде чем прочесть письмо."
                            }
                        },
                        {
                            "text": "She peered through her dusty <w>barnacles</w> at the tiny print.",
                            "target_lang_translations": {
                                "ru": "Она вглядывалась в мелкий шрифт через свои пыльные <w>очки</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or old-fashioned slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окуляры",
                                "target_lang_sense_clarification": "шутливое или устаревшее обозначение очков"
                            },
                            {
                                "target_lang_word": "очки",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "454ab59f-77af-3291-b100-673fa52d49c8",
                    "sense_definition": "In electrical engineering, a change made to a product on the manufacturing floor that was not part of the original product design.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician added a quick <w>barnacle</w> to the circuit board to fix the voltage drop.",
                            "target_lang_translations": {
                                "ru": "Техник быстро добавил <w>костыль</w> на плату, чтобы устранить падение напряжения."
                            }
                        },
                        {
                            "text": "This undocumented <w>barnacle</w> makes it very difficult to replicate the device.",
                            "target_lang_translations": {
                                "ru": "Эта недокументированная <w>доработка</w> сильно затрудняет копирование устройства."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "engineering jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В электротехнике: изменение, внесенное в изделие непосредственно на производстве, которое не входило в первоначальный проект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доработка на коленке",
                                "target_lang_sense_clarification": "незапланированное изменение"
                            },
                            {
                                "target_lang_word": "костыль",
                                "target_lang_sense_clarification": "технический сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6cc36b0-19f9-36ea-882e-74f8e7cda516",
                    "sense_definition": "On printed circuit boards, a change such as soldering a wire in order to connect two points, or addition such as an added resistor or capacitor, subassembly or daughterboard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He soldered a tiny wire as a <w>barnacle</w> to bypass the broken trace on the board.",
                            "target_lang_translations": {
                                "ru": "Он припаял крошечный провод в качестве <w>перемычки</w>, чтобы обойти поврежденную дорожку на плате."
                            }
                        },
                        {
                            "text": "The prototype was full of <w>barnacles</w> before we finalized the new layout.",
                            "target_lang_translations": {
                                "ru": "Прототип был полон <w>навесного монтажа</w>, пока мы не утвердили новую разводку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "electronics jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "На печатных платах: изменение конструкции, такое как припаивание провода для соединения двух точек, или добавление резистора, конденсатора или дочерней платы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навесной монтаж",
                                "target_lang_sense_clarification": "дополнительное соединение"
                            },
                            {
                                "target_lang_word": "перемычка",
                                "target_lang_sense_clarification": "припаянный провод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40522782-b3fe-33aa-93e1-7b9b383fe9ea",
                    "sense_definition": "A good job, or snack easily obtained.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "benefits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to land a real <w>barnacle</w> of a job with great pay and short hours.",
                            "target_lang_translations": {
                                "ru": "Ему удалось заполучить настоящую <w>халявную</w> работу с отличной оплатой и коротким рабочим днем."
                            }
                        },
                        {
                            "text": "Finding that free buffet was a lucky <w>barnacle</w> for the hungry students.",
                            "target_lang_translations": {
                                "ru": "Бесплатный шведский стол оказался настоящей <w>халявой</w> для голодных студентов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "extremely rare or regional slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошая, непыльная работа или легко доставшееся угощение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "халява",
                                "target_lang_sense_clarification": "легкая добыча или работа"
                            },
                            {
                                "target_lang_word": "тепленькое местечко",
                                "target_lang_sense_clarification": "о хорошей работе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32753b4a-e939-3cd2-b9d7-aaae753b7c30",
                    "sense_definition": "To connect with or attach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over the years, many myths and legends have <w>barnacled</w> onto the historical facts of the king's life.",
                            "target_lang_translations": {
                                "ru": "За долгие годы исторические факты о жизни короля <w>обросли</w> множеством мифов и легенд."
                            }
                        },
                        {
                            "text": "He let his old habits <w>barnacle</w> to his daily routine until they were impossible to break.",
                            "target_lang_translations": {
                                "ru": "Он позволил старым привычкам намертво <w>прилипнуть</w> к своей повседневной рутине, пока от них стало невозможно избавиться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "barnacle onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрепляться, намертво приставать или соединяться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипать",
                                "target_lang_sense_clarification": "крепко присоединяться"
                            },
                            {
                                "target_lang_word": "обрастать",
                                "target_lang_sense_clarification": "покрываться чем-то со временем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac8c3b04-9971-3e81-9a59-06e3c4cac6e7",
                    "sense_definition": "To press close against something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened children <w>barnacled</w> themselves to their mother's side during the storm.",
                            "target_lang_translations": {
                                "ru": "Испуганные дети во время грозы плотно <w>прижались</w> к матери."
                            }
                        },
                        {
                            "text": "We found the two lovers <w>barnacled</w> together in a quiet corner of the library.",
                            "target_lang_translations": {
                                "ru": "Мы нашли влюбленных, которые <w>прильнули</w> друг к другу в тихом уголке библиотеки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "barnacled together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прижиматься к кому-то или чему-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прильнуть",
                                "target_lang_sense_clarification": "плотно прижаться"
                            },
                            {
                                "target_lang_word": "прилепиться",
                                "target_lang_sense_clarification": "крепко прижаться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "271c851c-aa06-3c5e-8454-9b90600ce73e",
                    "sense_definition": "A village in Shilton and Barnacle parish, Rugby borough, Warwickshire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to take a weekend drive through the quiet countryside near <w>Barnacle</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили совершить поездку на выходных по тихой сельской местности недалеко от <w>Барнакла</w>."
                            }
                        },
                        {
                            "text": "He was born in a small cottage located in the historic village of <w>Barnacle</w>.",
                            "target_lang_translations": {
                                "ru": "Он родился в небольшом коттедже в исторической деревне <w>Барнакл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Warwickshire, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в приходе Шилтон и Барнакл, район Рагби, Уорикшир, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Барнакл",
                                "target_lang_sense_clarification": "название деревни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f12ff033-4291-38d9-8819-959377a2ce8b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Barnacle</w> to speak at our local history society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Барнакла</w> выступить на заседании нашего местного исторического общества."
                            }
                        },
                        {
                            "text": "The old records show that the <w>Barnacle</w> family has lived in this county for generations.",
                            "target_lang_translations": {
                                "ru": "Старые записи показывают, что семья <w>Барнакл</w> жила в этом округе на протяжении поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Барнакл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}