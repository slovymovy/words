                    ]
                },
                {
                    "sense_id": "14e9abba-a28c-31d0-8f01-953b32d67422",
                    "sense_definition": "Mouvement d'agitation, de trouble ou d'instabilité au sein d'un groupe ou d'un événement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marchés financiers ont dû traverser la <w>houle</w> des incertitudes économiques."
                        },
                        {
                            "text": "Le ministre a su garder son calme malgré la <w>houle</w> des protestations citoyennes."
                        }
                    ],
                    "synonyms": [
                        "agitation",
                        "remous",
                        "tourmente"
                    ],
