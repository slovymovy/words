                        "glosses": [
                            "Flatter un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2075b36-7e39-4381-8bc8-c24c3e2001f1",
                                "sense_id": "f93b508b-3b84-367f-9921-65419a080e86",
                                "text": "Mais vous avez vraiment un humour de m... ou vous vous forcez juste pour les flattouiller ?"
                            },
                            {
                                "example_id": "f0520c7e-bd03-4f63-82a6-4bccf043bab0",
                                "sense_id": "f93b508b-3b84-367f-9921-65419a080e86",
                                "text": "Je rassure tout le monde, RatDog étant le GameDesigner, on est bien obligé de le flattouiller un peu pour être dans ses petits papiers !"
                            },
                            {
                                "example_id": "b9958dec-b0b3-4c5e-af59-140d830e0996",
                                "sense_id": "f93b508b-3b84-367f-9921-65419a080e86",
                                "text": "Elles sont douces, adorent les bons légumes, elles nous jasent beaucoup et ronronnent quand on les flattouille."
                            }
                        ]
                    }
