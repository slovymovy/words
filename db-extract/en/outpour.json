                        "sense_id": "fa69548b-179a-33f6-adb5-1c283cf73ffe",
                        "entry_id": "891b15d2-b8f2-3155-a5ee-3d51aea2cc7a",
                        "glosses": [
                            "To pour out."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c085e6d7-fd84-4aaa-af86-ad4e0528fb4c",
                                "sense_id": "fa69548b-179a-33f6-adb5-1c283cf73ffe",
                                "text": "But the raven, sitting lonely on the placid bust, spoke only / That one word, as if his soul in that one word he did outpour."
                            },
                            {
                                "example_id": "c10585e3-6cec-435e-8d3b-4d000a1980c1",
                                "sense_id": "fa69548b-179a-33f6-adb5-1c283cf73ffe",
                                "text": "I unsealed the vial mystical, / I outpoured the liquid thing, / And while the smoke came wreathing out, / I stood unshuddering."
                            }
                        ]
                    }
                ],
