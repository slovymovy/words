                        "glosses": [
                            "ein- bis mehrzelliger Eukaryot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a7e3e1-ccd8-485e-af06-ea8d4a3ffddf",
                                "sense_id": "9c6f5701-7a30-366b-9063-94d498fa53cd",
                                "text": "Die Protisten (Protista) sind eukaryotische, ein- bis wenigzellige Lebewesen, die aber nicht näher miteinander verwandt sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02c5fc03-acd3-4dc6-a3cd-855818e57998",
                        "source_entry_id": "f7c0967c-eb1f-38b5-8d41-24b2b60e84e6",
                        "source_sense_id": "9c6f5701-7a30-366b-9063-94d498fa53cd",
                        "source_sense_description": "Biologie: ein- bis mehrzelliger Eukaryot",
                        "target_lang_word": "protist",
