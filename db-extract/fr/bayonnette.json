                "senses": [
                    {
                        "sense_id": "f6a03627-4fea-3717-bc27-4bce97b88bd5",
                        "entry_id": "614f6eb4-5704-3083-a301-f593bbdf32af",
                        "glosses": [
                            "Variante de baïonnette."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a6dd84e5-304b-4ef1-8e43-a052c74e85a0",
                                "sense_id": "f6a03627-4fea-3717-bc27-4bce97b88bd5",
                                "text": "Alors nous nous réunîmes, nous croisâmes la bayonnette, et nous déclarâmes que nous emploierions même la force pour empêcher qu'on se dépourvût ainsi entièrement de cartouches, sans résultat; nous étions peu écoutés et peu obéis; […]."
                            },
                            {
                                "example_id": "8fd16ed3-911f-4116-a9b3-eaaee9d1fe7f",
                                "sense_id": "f6a03627-4fea-3717-bc27-4bce97b88bd5",
                                "text": "L’attaque à la bayonnette ne peut être paralysée que par une contre attaque à la bayonnette, car un ennemi hardi ne cédera jamais devant un feu quelque meurtrier qu’il soit."
                            },
                            {
                                "example_id": "4a3d00bc-449e-468b-a7cb-435df34bf778",
                                "sense_id": "f6a03627-4fea-3717-bc27-4bce97b88bd5",
                                "text": "J’ajouterai que les nouvelles milices ont été amenées à faire l’exercice en commun, à s’aligner, à garder, leurs rangs, à manier le fusil et la bayonnette à peu près comme nos soldats"
                            }
                        ]
                    }
                ],
