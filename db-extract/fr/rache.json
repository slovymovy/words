                        "entry_id": "24e083db-95b6-3955-ab7c-c42145e91a5e",
                        "glosses": [
                            "Maladie éruptive de la tête, teigne."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "04c647a8-a32d-4aef-b2a2-3eb72d74b119",
                                "sense_id": "acc53f65-0261-3544-8e4d-a3a20bbd9df0",
                                "text": "La rache: nom sous lequel on désignait autrefois les diverses maladies éruptives de la tête, et, en particulier, la teigne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e5f6bcb-8c02-48b8-9e1a-f87ee8ccedc8",
                        "source_entry_id": "24e083db-95b6-3955-ab7c-c42145e91a5e",
                        "source_sense_id": "acc53f65-0261-3544-8e4d-a3a20bbd9df0",
                        "target_lang_word": "rash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff535910-3d33-3aa6-8861-65413c2b70fd",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To forcefully move or push (someone or something) in a certain direction."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6b29ee-c229-4868-8025-907f02e4afe8",
                                                "sense_id": "ff535910-3d33-3aa6-8861-65413c2b70fd",
                                                "text": "Reg[an]. VVherefore to Douer ſir? / Gloſt[er, i.e., Gloucester]. Becauſe I vvould not ſee thy cruell nayles / Pluck out his poore old eyes, nor thy fierce ſiſter / In his aurynted fleſh raſh boriſh phangs, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c0701a-71af-3789-81ad-c578f703e17d",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To break (something) forcefully; to smash."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b631f7-fa72-4c21-b85a-ba36430da550",
                                                "sense_id": "72c0701a-71af-3789-81ad-c578f703e17d",
                                                "text": "Fair lordes sayd syre Launcelot leue your noyse and your rassyng and I shalle sette open this dore and thenne may ye doo with me what it lyketh yow.\n\"Fair lords, said Sir Launcelot, leave your noise and your rashing, and I shall set open this door, and then may ye do with me what it liketh you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd3a01c-66ad-3eed-8154-276632e55f92",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To emit or issue (something) hastily."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f94860d7-0e4c-3a47-8afb-7e1f77a58065",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "Usually followed by up: to prepare (something) with haste; to cobble together, to improvise."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f0c76b-74ae-4e3b-bbf6-bc37cd617c5a",
                                                "sense_id": "f94860d7-0e4c-3a47-8afb-7e1f77a58065",
                                                "text": "Retur[n]e to the places of Peter, the one in his firſt epiſtle, the other in the latter: and ſo be you contented with this preſent anſvver raſhed up in haſte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0252fb9-38f0-3b9e-80ea-1e6f926e0b19",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To move forcefully, hastily, or suddenly; to dash, to rush."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68c288ce-41ca-3003-af58-01b19b40dbd2",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To fall heavily; to dash down."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1140e070-94fc-4dfe-be70-f8bdb6145d5d",
                                                "sense_id": "68c288ce-41ca-3003-af58-01b19b40dbd2",
                                                "text": "[…] the rain rashed down - the road was battered, As with the force of billows shattered; […]"
                                            },
                                            {
                                                "example_id": "f3974f42-30a9-442f-b21b-6481c98f0a89",
                                                "sense_id": "68c288ce-41ca-3003-af58-01b19b40dbd2",
                                                "text": "... rain rashed down. The sound was as of a deluge, and all the parched lips of earth seemed to be drinking in the delicious moisture."
                                            },
                                            {
                                                "example_id": "b45c3f6f-d870-4569-acee-00083d99f423",
                                                "sense_id": "68c288ce-41ca-3003-af58-01b19b40dbd2",
                                                "text": "Thunder rumbled and a light rain rashed down as Bella shoveled the pile of loose dirt back into the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430a73be-1aa8-3e62-b0b0-fd88b6c76247",
                                        "entry_id": "f5b45f74-b154-3a72-a4b8-576b9a3bc52a",
                                        "glosses": [
                                            "To collide or hit."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                        "entry_id": "a8adaba5-d9c2-3945-b862-921d20e37574",
                                        "glosses": [
                                            "Acting too quickly without considering the consequences and risks; not careful; hasty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6c5bf8-7bd1-48db-8f9e-e2649db4ed8d",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "rash words spoken in the heat of debate"
                                            },
                                            {
                                                "example_id": "c471bb84-5e77-4f9b-8050-262eef268e9c",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "[…] Eusebius doth report that Ireneus dyd reprooue Victor byshop of Rome for his rash sentēce in excōmunicating the Churches of Grece, concerning the obseruation of the feast of Easter."
                                            },
                                            {
                                                "example_id": "15102869-16c6-48fe-ac9d-6d5a5fcfcbaf",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "For ſitting in his [Marcus Junius Brutus's] tent, penſive and troubled vvith the horrour of his raſh act, it vvas not hard for him, ſlumbering in the cold, to dream of that vvhich moſt affrighted him; […]"
                                            },
                                            {
                                                "example_id": "e8a773c8-8486-4bc2-b33a-23a84d9223c9",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "[T]hrough the raſh adventure and fool-hardineſs of ſome fevv, an overture only made, and ſome advantage got of performing a great piece of ſervice and vvorthy exploit."
                                            },
                                            {
                                                "example_id": "350e8486-2fe1-4dc3-8f9f-fb0158c0bbc9",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "I vvas a fool, too raſh, and quite miſtaken / In vvhat I thought vvould have ſucceeded beſt."
                                            },
                                            {
                                                "example_id": "f6551d27-2079-450d-97bd-7c8ac0a1d42f",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "He will tell you in how few moments ſhe repented of the raſh meſſage ſhe had ſent you— […]"
                                            },
                                            {
                                                "example_id": "8437db9a-cd93-43f9-bb9e-fe7871e94bf1",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "So ſhould an ideot vvhile at large he ſtrays, / Find the ſvveet lyre on vvhich an artiſt plays, / VVith raſh and aukvvard force the chords he ſhakes, / And grins vvith vvonder at the jar he makes; […]"
                                            },
                                            {
                                                "example_id": "e53a5df1-d917-4141-8aaa-15740d927174",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "Take then no vow at random: ta'en, with faith / Preserve it; yet not bent, as Jephthah once, / Blindly to execute a rash resolve, / Whom better it had suited to exclaim, / 'I have done ill,' than to redeem his pledge / By doing worse: […]"
                                            },
                                            {
                                                "example_id": "2a1f7551-c55c-46f7-9aef-4556b4306dac",
                                                "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                                                "text": "She did a rash thing. She sent a letter to Ivy Bolton, enclosing a note to the keeper, and asking Mrs Bolton to give it to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5059813-14bc-32fc-a345-57e0b9f59acd",
                                        "entry_id": "a8adaba5-d9c2-3945-b862-921d20e37574",
                                        "glosses": [
                                            "Of corn or other grains: so dry as to fall out of the ear with handling."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e320b378-5b67-36fd-8015-da3ce74138c7",
                                        "entry_id": "a8adaba5-d9c2-3945-b862-921d20e37574",
                                        "glosses": [
                                            "Requiring swift action; pressing; urgent."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e7b6ac-f252-4887-a418-394c43eabe4d",
                                                "sense_id": "e320b378-5b67-36fd-8015-da3ce74138c7",
                                                "text": "My Lord, I ſcarce haue leiſure to ſalute you, / My matter is ſo raſh: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274704a2-05c6-307a-9f9f-c8621f192609",
                                        "entry_id": "a8adaba5-d9c2-3945-b862-921d20e37574",
                                        "glosses": [
                                            "Taking effect quickly and strongly; fast-acting."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0865f1d-d795-4002-99aa-6274025dc8aa",
                                                "sense_id": "274704a2-05c6-307a-9f9f-c8621f192609",
                                                "text": "[T]he vnited veſſel of their bloud, / […] / Shall neuer leake, though it doe vvorke as ſtrong, / As Aconitum, or raſh gunpovvder."
                                            },
                                            {
                                                "example_id": "fec5839e-4a0d-41f3-8cc3-84a231d59add",
                                                "sense_id": "274704a2-05c6-307a-9f9f-c8621f192609",
                                                "text": "Sir (my Lord) / I could doe this, and that vvith no raſh Potion, / But with a lingring Dram, that ſhould not vvorke / Maliciouſly, like Poyſon."
                                            },
                                            {
                                                "example_id": "c8b4aca7-da66-479f-8707-f09d01dca462",
                                                "sense_id": "274704a2-05c6-307a-9f9f-c8621f192609",
                                                "text": "[T]he inboard seas run swirling and hawling; / The rash smart sloggering brine / Blinds her; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab16c1bf-a0e5-3482-bdc2-a1c2279e47ba",
                                        "entry_id": "1c80f438-967e-3144-a3d0-37fc8d8aa842",
                                        "glosses": [
                                            "Synonym of rashly (“in a rash manner; hastily or without due consideration”)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08094d0b-2597-41f3-863c-fc8afe61749e",
                                                "sense_id": "ab16c1bf-a0e5-3482-bdc2-a1c2279e47ba",
                                                "text": "Soft Gooddie Sheepe (then ſaid the Foxe) not ſoe: / Vnto the King ſo raſh ye may not goe, / He is vvith greater matter buſied, / Than a Lambe, or the Lambes ovvne mothers hed."
                                            },
                                            {
                                                "example_id": "d7d30caf-9d03-4eb1-b648-8690739363b0",
                                                "sense_id": "ab16c1bf-a0e5-3482-bdc2-a1c2279e47ba",
                                                "text": "VVhy do you ſpeake ſo ſtartingly and raſh?"
                                            },
                                            {
                                                "example_id": "b4aa0d8d-c235-4bff-83fe-71251fdb32e1",
                                                "sense_id": "ab16c1bf-a0e5-3482-bdc2-a1c2279e47ba",
                                                "text": "But the right thing 'ud be for Tulliver to go and make it up with her himself, and say he was sorry for speaking so rash."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe9a797-c12a-398f-8263-6e05780ac6ee",
                                        "entry_id": "89610b4f-ea37-326e-98cf-f32e2d446ce1",
                                        "glosses": [
                                            "An area of inflamed and irritated skin characterized by reddened spots that may be filled with fluid or pus. Also, preceded by a descriptive word (rare or obsolete), an illness characterized by a type of rash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71890e7a-040b-4926-b416-8a25cca6ab2b",
                                                "sense_id": "dfe9a797-c12a-398f-8263-6e05780ac6ee",
                                                "text": "He came out in a rash because of an allergy."
                                            },
                                            {
                                                "example_id": "8d4253c1-d110-4a88-a11a-c33cd827be75",
                                                "sense_id": "dfe9a797-c12a-398f-8263-6e05780ac6ee",
                                                "text": "She applied rash cream on herself to reduce the irritation."
                                            },
                                            {
                                                "example_id": "d9be13d3-a0a6-4ea7-a917-1b2353342b0f",
                                                "sense_id": "dfe9a797-c12a-398f-8263-6e05780ac6ee",
                                                "text": "A wet cloth should help with the rash on your arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62eafa37-6cc5-3b7f-8cd5-6e9ee8ebcb02",
                                        "entry_id": "89610b4f-ea37-326e-98cf-f32e2d446ce1",
                                        "glosses": [
                                            "An irregular distribution or sprinkling of objects resembling a rash (sense 1)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                                        "entry_id": "89610b4f-ea37-326e-98cf-f32e2d446ce1",
                                        "glosses": [
                                            "An outbreak or surge in problems; a spate, string, or trend."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14126f68-888a-49dd-8ec4-c671ae6cafd5",
                                                "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                                                "text": "There has been a rash of vandalism lately."
                                            },
                                            {
                                                "example_id": "14bba221-2d89-4384-8d6f-86229f9cf710",
                                                "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                                                "text": "Wet through and through: with her feet squelching and squashing in her shoes whenever she moved; with a rash of rain upon her classical visage; […]"
                                            },
                                            {
                                                "example_id": "ca010c65-b57f-4768-8c5a-11018dc1ffcb",
                                                "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                                                "text": "Until the recent rash of North London line maps appeared on station billboards in the London area of BR, the service undoubtedly suffered from meagre and ineffectual publicity."
                                            },
                                            {
                                                "example_id": "991d13e4-8a77-4b83-b443-5af05051ac05",
                                                "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                                                "text": "Science has tried and failed to come to a consensus about the hygienic superiority of one product over the other. Even so, the paper towel industry has funded or promoted a rash of studies claiming that hand dryers turn bathrooms into mosh pits of pathogens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057bf000-c414-3d55-94a8-50488ff05d19",
                                        "entry_id": "53f72a53-3d34-3bf0-b2b2-7c765ef5ef18",
                                        "glosses": [
                                            "Chiefly preceded by a descriptive word: a fabric with a smooth texture woven from silk, worsted, or a mixture of the two, intended as an inferior substitute for silk."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620bd1a5-aee1-4ee6-99a1-0fa4f795d679",
                                                "sense_id": "057bf000-c414-3d55-94a8-50488ff05d19",
                                                "text": "cloth rash    silk rash"
                                            },
                                            {
                                                "example_id": "0419b280-e242-4932-beb1-135a684384c4",
                                                "sense_id": "057bf000-c414-3d55-94a8-50488ff05d19",
                                                "text": "Sleeveleſſe his jerkin vvas, and it had beene / Velvet, but 'tvvas novv (ſo much ground vvas ſeene) / Become Tufftaffatie; and our children ſhall / See it plaine Raſhe avvhile, or nought at all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94b5f759-ddf0-38b6-9cc5-550467ab5db0",
                                        "entry_id": "6a21bc03-2831-3707-9144-43b6a5d0443b",
                                        "glosses": [
                                            "A soft crackling or rustling sound."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beadf92c-5b33-4750-8afd-062f7b533aeb",
                                                "sense_id": "94b5f759-ddf0-38b6-9cc5-550467ab5db0",
                                                "text": "Look on thoſe grave plodding fellovvs, […] I'll undertake three parts of four are going to their Courtezans. I tell thee, Jack, the vvhiſking of a Silk-Govvn, and the raſh of a Tabby-Pettycoat, are as comfortable ſounds to one of theſe rich Citizens, as the chink of their Pieces of Eight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9519047-ae92-3388-9add-c74945cbaef3",
                                        "entry_id": "9650c088-5969-3883-9a79-45a890dc99e4",
                                        "glosses": [
                                            "Chiefly followed by away, down, off, out, etc.: to pluck, pull, or rip (something) violently."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05485a85-5591-402c-a430-ad8629c21e23",
                                                "sense_id": "a9519047-ae92-3388-9add-c74945cbaef3",
                                                "text": "There Marinell great deeds of armes did ſhevv; / And through the thickeſt like a Lyon flevv, / Raſhing off helmes, and ryuing plates a ſonder, / That euery one his daunger did eſchevv."
                                            },
                                            {
                                                "example_id": "7a097d6c-e953-4048-8345-00ce65c04e0a",
                                                "sense_id": "a9519047-ae92-3388-9add-c74945cbaef3",
                                                "text": "His Creſt is raſh'd away; his ample Shield / Is falſify'd and round with Jav'lins fill'd."
                                            }
                                        ]
                                    }
                                ]
                            },
