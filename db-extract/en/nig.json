                    {
                        "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                        "entry_id": "5c3123af-adc5-38ab-b87a-ad64f7bb51bc",
                        "glosses": [
                            "黑人，黑鬼，黑奴"
                        ],
                        "tags": [
                            "offensive",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "bc720227-0066-437c-be24-c900d5ddd89b",
                                "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                                "text": "Cotton-eyed Joe, Cotton-eyed Joe,\nHe was de nig dat sarved me so,…"
                            },
                            {
                                "example_id": "25541308-4a4c-49c4-883e-f07ad74001d3",
                                "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                                "text": "‘When a few wild nigs come in he must ‘educate’ the most intelligent looking; they will come in handy.’"
                            },
                            {
                                "example_id": "424bcf6f-c303-4b9e-8b45-0ea1a3cffe80",
                                "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                                "text": "He always thought one step ahead of the nigs."
                            },
                            {
                                "example_id": "95850774-a958-4455-a04f-81822b6cb3c6",
                                "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                                "text": "In a field near the house was a nigger working a poor old broken-down mule and another nigger sowing wheat. When we came up, both nigs quit work and stared at us.",
                                "translation": "房子附近的田里，一个黑人正在赶着一头破旧的骡子，另一个黑人正在播种小麦。我们走近时，那两个黑人都停下干活，盯着我们看。"
                            },
                            {
                                "example_id": "149e8686-c953-40b5-9fec-498466ec4804",
                                "sense_id": "575dad4e-2767-3d29-ac2c-a9031358d9fd",
                                "text": "What part did she play in your marrying a nig — a black man — nig, nig — Negro?",
                                "translation": "她在你嫁给一个黑鬼——一个黑人——黑鬼，黑鬼——黑人这件事上扮演了什么角色？"
                            }
                        ]
                    },
                    {
                        "sense_id": "5eae2962-9eb4-35db-b9e0-47779a39d0f4",
                        "entry_id": "5c3123af-adc5-38ab-b87a-ad64f7bb51bc",
                        "glosses": [
                            "nigga (“黑人兄弟，黑人夥計”) 的截斷形式"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "84e88ec0-86f7-4b66-bc82-b8a5487ce97d",
                                "sense_id": "5eae2962-9eb4-35db-b9e0-47779a39d0f4",
                                "text": "Take Blow, my room dawg and fraternity brother from back in the college days. He's a real smoove nig, curly haired handsome, and got mad chick appeal.",
                                "translation": "就拿Blow来说吧，他是我大学时代的室友兼兄弟会兄弟。他是个很会撩妹的家伙，一头卷发，长得帅，特别受女生欢迎。"
                            }
                        ]
                    }
