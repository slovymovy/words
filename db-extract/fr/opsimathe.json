                                "target_senses": [
                                    {
                                        "sense_id": "de139b8e-6796-385b-8795-44d42dbd2900",
                                        "entry_id": "1194b64f-0b77-3faf-b02d-692ccc97e825",
                                        "glosses": [
                                            "A person who learns late in life."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6afb2bd-1d88-4e0a-8498-71440e011a76",
                                                "sense_id": "de139b8e-6796-385b-8795-44d42dbd2900",
                                                "text": "But with reference to the latter, I may be permitted to say, that from the dissipation and idleness of his earlier years, Mr. Fox in Greek and Roman Literature was necessarily an Opsimath."
                                            },
                                            {
                                                "example_id": "d7cafa3d-16fe-4da2-884d-69264e3cd35d",
                                                "sense_id": "de139b8e-6796-385b-8795-44d42dbd2900",
                                                "text": "The truth is that Zola was an opsimath, who had read Stendhal, Flaubert, Balzac, the Goncourts and Taine late in life."
                                            },
                                            {
                                                "example_id": "2ac5a990-51aa-459d-951d-b8624824a693",
                                                "sense_id": "de139b8e-6796-385b-8795-44d42dbd2900",
                                                "text": "I consider myself something of an opsimath, one who has been blessed with remarkable teachers and friends to assist my slow journey towards the experiences and understanding I was so keen to realize."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
