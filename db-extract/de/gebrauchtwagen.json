                "senses": [
                    {
                        "sense_id": "45f64cdc-bf6b-3bd2-a448-a0ccc881bee5",
                        "entry_id": "f021e3af-a997-3f93-9e5a-f349705594d4",
                        "glosses": [
                            "Ein gebrauchtes Automobil, das zum Kauf (bzw. zum Verkauf) ansteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32118c9f-8165-48a7-9d81-1d5762ecb443",
                                "sense_id": "45f64cdc-bf6b-3bd2-a448-a0ccc881bee5",
                                "text": "„Doch Betzelt, der früher Gebrauchtwagen verkauft hat, bockt die Autos nicht einmal hoch.“"
                            },
                            {
                                "example_id": "484dd4d1-7f03-473d-b825-b9f46c9df3c6",
                                "sense_id": "45f64cdc-bf6b-3bd2-a448-a0ccc881bee5",
                                "text": "„Einmal fuhr Papa am Samstag nach dem Frühstück weg, um einen neuen Gebrauchtwagen zu kaufen, weil der Käfer so viele Macken hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
