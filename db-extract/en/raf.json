                        "examples": [
                            {
                                "example_id": "7768c8f9-9952-45a8-bb72-e917e39a6f70",
                                "sense_id": "78e55696-bf44-3fb6-9212-3c706790b8b5",
                                "text": "The RAF is the air force branch of the British Armed Forces."
                            }
