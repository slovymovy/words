{
    "word_family": [
        "meat",
        "meatiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd8c2846-b005-3556-9aa8-e4c64de5ae86",
                    "sense_definition": "Containing or consisting of meat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meaty</w> stew was filled with chunks of beef and vegetables.",
                            "target_lang_translations": {
                                "nl": "De <w>vlezige</w> stoofpot zat vol met stukken rundvlees en groenten."
                            }
                        },
                        {
                            "text": "He prefers a <w>meaty</w> sauce for his pasta dishes.",
                            "target_lang_translations": {
                                "nl": "Hij geeft de voorkeur aan een <w>vlezige</w> saus bij zijn pastagerechten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meaty stew",
                        "meaty sauce"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bevattend of bestaand uit vlees."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlezig",
                                "target_lang_sense_clarification": "met veel vlees erin"
                            },
                            {
                                "target_lang_word": "met vlees",
                                "target_lang_sense_clarification": "bevat vlees als ingrediënt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cabd4378-c20f-3697-85d7-035b95a2fc35",
                    "sense_definition": "Having a flavor or smell similar to meat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This mushroom has a surprisingly <w>meaty</w> flavor when grilled.",
                            "target_lang_translations": {
                                "nl": "Deze paddenstoel heeft een verrassend <w>vlezige</w> smaak wanneer hij gegrild wordt."
                            }
                        },
                        {
                            "text": "The soup had a rich and <w>meaty</w> aroma that filled the kitchen.",
                            "target_lang_translations": {
                                "nl": "De soep had een rijk en <w>vlezig</w> aroma dat de keuken vulde."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleshy"
                    ],
                    "common_phrases": [
                        "meaty flavor",
                        "meaty aroma"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een smaak of geur die lijkt op vlees."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlezig",
                                "target_lang_sense_clarification": "met een smaak of textuur die aan vlees doet denken"
                            },
                            {
                                "target_lang_word": "hartig",
                                "target_lang_sense_clarification": "met een volle, vlezige smaak (vaak gebruikt voor umami)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b105dab5-5c75-37f4-a9bb-eeb445d49863",
                    "sense_definition": "Large, solid, and thick in physical appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical-size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler used his <w>meaty</w> hands to grab his opponent.",
                            "target_lang_translations": {
                                "nl": "De worstelaar gebruikte zijn <w>vlezige</w> handen om zijn tegenstander vast te grijpen."
                            }
                        },
                        {
                            "text": "He had <w>meaty</w> shoulders that made him look very strong.",
                            "target_lang_translations": {
                                "nl": "Hij had <w>vlezige</w> schouders waardoor hij er erg sterk uitzag."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulky",
                        "chunky",
                        "muscular",
                        "solid",
                        "stocky"
                    ],
                    "common_phrases": [
                        "meaty hands"
                    ],
                    "target_lang_definitions": {
                        "nl": "Groot, stevig en dik van fysiek uiterlijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlezig",
                                "target_lang_sense_clarification": "dik en gespierd (van lichaamsdelen)"
                            },
                            {
                                "target_lang_word": "fors",
                                "target_lang_sense_clarification": "groot en stevig gebouwd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66106ffe-73f6-386d-9905-094977ad05bb",
                    "sense_definition": "Significant, substantial, or full of important content.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "substantial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was happy to get such a <w>meaty</w> role in the new play.",
                            "target_lang_translations": {
                                "nl": "De acteur was blij dat hij zo'n <w>inhoudsrijke</w> rol kreeg in het nieuwe toneelstuk."
                            }
                        },
                        {
                            "text": "The report provided a <w>meaty</w> analysis of the current economic situation.",
                            "target_lang_translations": {
                                "nl": "Het rapport bood een <w>substantiële</w> analyse van de huidige economische situatie."
                            }
                        }
                    ],
                    "synonyms": [
                        "substantial"
                    ],
                    "common_phrases": [
                        "meaty role"
                    ],
                    "target_lang_definitions": {
                        "nl": "Belangrijk, substantieel of vol met inhoud."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "substantieel",
                                "target_lang_sense_clarification": "inhoudelijk rijk en belangrijk"
                            },
                            {
                                "target_lang_word": "inhoudsrijk",
                                "target_lang_sense_clarification": "vol met belangrijke informatie of uitdaging"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}