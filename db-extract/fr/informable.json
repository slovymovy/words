                "senses": [
                    {
                        "sense_id": "5bc01b61-fc7c-3b72-95da-0cd3eb786b5a",
                        "entry_id": "e0e7839a-b180-3e67-b0f5-fd060fb80288",
                        "glosses": [
                            "Qui peut être informé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4aab9a2-38b8-4eef-bb52-53e9ee5c5a1a",
                                "sense_id": "5bc01b61-fc7c-3b72-95da-0cd3eb786b5a",
                                "text": "Une opinion fausse peut fort bien ne témoigner, chez qui s’y attache, que d’un esprit borné, fortement marqué par son enfance, non seulement mal informé, mais mal informable, sans qu’il soit nécessaire de l’assortir d’une âme perverse."
                            },
                            {
                                "example_id": "f8cf1455-410e-4b4c-90da-1b44c2aba726",
                                "sense_id": "5bc01b61-fc7c-3b72-95da-0cd3eb786b5a",
                                "text": "Trouvez quelqu’un de bien informé et de bien informable, et faites lancer votre nom."
                            },
                            {
                                "example_id": "117d846c-f151-43f5-b667-6c5882aeb191",
                                "sense_id": "5bc01b61-fc7c-3b72-95da-0cd3eb786b5a",
                                "text": "Comment voulez-vous qu’elles puissent informer, alors qu’elles sont implantées dans une certaine zone géographique, des touristes qui viennent de l’autre bout du pays ? C’est impossible, donc on a une partie des gens qui sont informables, et d’autres non."
                            }
                        ]
                    }
