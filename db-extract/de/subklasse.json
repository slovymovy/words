                "translations": [
                    {
                        "translation_id": "3c8e376b-c29f-43dc-8b3a-07d12e2a87ac",
                        "source_entry_id": "39db2410-29e8-3f9b-bfde-f35a90847a1b",
                        "source_sense_id": "384e50e9-7397-314c-b89c-a18d110f9c78",
                        "source_sense_description": "objektorientierte Programmierung: Unterklasse",
                        "target_lang_word": "subclass",
