                "senses": [
                    {
                        "sense_id": "57192ddd-c72b-35f3-a9ef-a29ceccde091",
                        "entry_id": "c893e284-d6a3-3106-8508-27882d7a384b",
                        "glosses": [
                            "Stadt, die sich in direkter Nähe einer Oase befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e3d766-7f9c-41bb-90d2-fbde2e327b85",
                                "sense_id": "57192ddd-c72b-35f3-a9ef-a29ceccde091",
                                "text": "„Die Oasenstadt El Charga ist der letzte Außenposten der Zivilisation.“"
                            },
                            {
                                "example_id": "001d62be-80bb-4f9d-bda7-a8a73dc3e885",
                                "sense_id": "57192ddd-c72b-35f3-a9ef-a29ceccde091",
                                "text": "„Die wahre Action würde nach Djanet beginnen, wenn wir die Wüste nach Westen in Richtung der uralten Oasenstadt Tamanrasset durchquerten.“"
                            },
                            {
                                "example_id": "e7230dde-7243-47cd-b263-53f0cb1b0925",
                                "sense_id": "57192ddd-c72b-35f3-a9ef-a29ceccde091",
                                "text": "„Unter diesen Dynastien gewannen Oasenstädte wie Balkh, Herat, Ghazni und Kandahar als Stationen an der Seidenstraße große Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
