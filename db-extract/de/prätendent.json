                "translations": [
                    {
                        "translation_id": "12189f47-25b8-4a16-9619-12d005b0ea3a",
                        "source_entry_id": "b0c58d56-557c-3018-ac84-55bac4a9b72e",
                        "source_sense_id": "9af6b2e5-d773-3fdf-ae42-33f5ffdfcfc7",
                        "source_sense_description": "Anwärter auf ein Amt; jemand, der Anspruch auf ein Amt erhebt",
                        "target_lang_word": "pretender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5124e397-8393-381c-878f-81453b21e638",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "One who intends or purposes."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e7e3cf-364a-48e5-89f8-48453ce0e68e",
                                                "sense_id": "5124e397-8393-381c-878f-81453b21e638",
                                                "text": "Pretensor, a pretender, he that purposeth."
                                            },
                                            {
                                                "example_id": "dbfb63e4-fc26-4cd1-a04c-c849e5eff13b",
                                                "sense_id": "5124e397-8393-381c-878f-81453b21e638",
                                                "text": "Pretendente, a pretendent, a pretender, an intender, a meaner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "One who puts forth a claim, or who aspires to or aims at something; a claimant, candidate, or aspirant; now, one who makes baseless pretensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a27b2d-63ec-4b84-a2b4-19284809fda4",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "By how straight a Rule […] must that Pretender carry himselfe, who is to saile thorow the sea of this world, hoping for a fortune from another mans hand?"
                                            },
                                            {
                                                "example_id": "f7cc82b2-3c6d-4c70-9438-fab4042320bf",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "[…]; to consider the direct purposes of God against his enemies, rather than the sinister supplantations of pretenders to places in court; […]"
                                            },
                                            {
                                                "example_id": "e54b3513-fcac-41fa-bbb6-fe96160b82c7",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "Every one is a pretender and a runner; but few carry the prize."
                                            },
                                            {
                                                "example_id": "99e44626-ec86-4ad3-864e-012cb2b455ab",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "The issue of the eldest son excludes all other pretenders, as the son himself (if living) would have done."
                                            },
                                            {
                                                "example_id": "7e4137c7-f3ab-4466-9c6a-bc84782b4854",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "A candidate for a school at Brewood in Staffordshire; to which, I think, there are seventeen pretenders."
                                            },
                                            {
                                                "example_id": "2e6e8c3b-7feb-487d-a3dc-83f8a617c101",
                                                "sense_id": "40560b86-1c46-3fa5-b67c-f06ec2d22a85",
                                                "text": "I would sooner gain five thousand pounds by restoring you to your rights, than fifty thousand in establishing any of these pretenders in their base assumptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107e63f0-0fff-3b4f-970b-4044c0b70a91",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "One who puts forth a claim, or who aspires to or aims at something; a claimant, candidate, or aspirant; now, one who makes baseless pretensions.",
                                            "One who aspires to the hand of a woman in marriage; a suitor, a wooer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427e8d09-38d4-475a-a250-bc167a410c4f",
                                                "sense_id": "107e63f0-0fff-3b4f-970b-4044c0b70a91",
                                                "text": "He, of the two pretenders, that best loves me."
                                            },
                                            {
                                                "example_id": "48356a3a-8a0c-4a95-873e-7c9ad7a8585c",
                                                "sense_id": "107e63f0-0fff-3b4f-970b-4044c0b70a91",
                                                "text": "An Earles daughter, […] whose mother not allowing him to come as a pretender shee made apointmentt with him and mett him att her cousin’s howse."
                                            },
                                            {
                                                "example_id": "17505ad8-788c-48e8-b27f-f0cdee9be462",
                                                "sense_id": "107e63f0-0fff-3b4f-970b-4044c0b70a91",
                                                "text": "It is not my design to dispose of Irene to the most noble, but most wealthy of the Pretenders to her Love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "One who puts forth a claim, or who aspires to or aims at something; a claimant, candidate, or aspirant; now, one who makes baseless pretensions.",
                                            "A claimant to a throne or the office of a ruler; originally in a neutral sense, but now always applied to a claimant who is held to have no just title."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e475fa-85ab-44f7-9443-567cad1e9745",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "If inteſtine Broils allarm the Hive, / (For two Pretenders oft for Empire ſtrive)"
                                            },
                                            {
                                                "example_id": "b9040230-14c4-4b3c-8741-1bac33bbba79",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "I Think it necessary to acquaint you, that I have received Advices this Morning from Ostend, that the French Fleet sailed from Dunkirk, Tuesday at three in the Morning, Northward, with the Pretender on board; as also, that Sir George Byng had notice of it the same Day at ten: And he being very much superior to the Enemy both in Number and Strength, I make no question, but, by God’s Blessing, he will soon be able to give a good Account of them."
                                            },
                                            {
                                                "example_id": "262aceff-6622-44ae-9ffa-23152f540148",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "She [Q. Anne] also fixed a new Designation on the Pretended Prince of Wales, and called him the Pretender; he was so called in a new Set of Addresses […] upon this occasion […] made to the Queen."
                                            },
                                            {
                                                "example_id": "8ebd133f-26d6-4805-bf23-7497e7bb84f3",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "the provost’s enemies at the council-table of the burgh used to observe that he uttered there many a bold harangue against the Pretender, and in favour of King George and government, of which he dared not have pronounced a syllable in his own bedchamber"
                                            },
                                            {
                                                "example_id": "9f816acd-e93a-4fbd-a520-5dac031edfc1",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "The pretender […] had friends in the tory government more sincere probably and zealous than [the earl of] Oxford."
                                            },
                                            {
                                                "example_id": "12329adb-cefd-481e-88fb-c8f8f2259dfc",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "Wullenweber […] turned to the nearest protestant pretender, Duke Christian, and offered him his assistance to obtain the crown."
                                            },
                                            {
                                                "example_id": "55935907-f9d3-4533-a4a0-92d4df745e4a",
                                                "sense_id": "4281aea9-8d5c-359e-9fe5-5d17fde77e66",
                                                "text": "Every province […] had its own Augustus. All these pretenders could not be rightful Emperors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "One who pretends or lays claim to something; one who makes a profession, show, or assertion, especially without adequate grounds, falsely, or with intent to deceive; a dissembler, deceiver, charlatan, hypocrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de8e833d-46e4-4ebe-84bb-9a62d3e2a2ff",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "A pretender / To the art, I truely honor, and ſubſcribe / To your maieſties opinion."
                                            },
                                            {
                                                "example_id": "fee1d3f1-c147-4019-8d97-e69f3d75130a",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "Make it a feast, and perfit your great injustice / In the surrendringe up this false pretender / To the correction of the law, […]"
                                            },
                                            {
                                                "example_id": "b457b58f-845c-4b92-9cf9-2288bdf690c8",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "But this pretence of Covenant with God, is so evident a lye, even in the pretenders own consciences, that it is not onely an act of an unjust, but also a vile, and unmanly disposition."
                                            },
                                            {
                                                "example_id": "911df855-d213-4f7f-abfb-9b9f124e5322",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "[…]But, I answer; that it is not so easy an Acquirement as a few ignorant Pretenders may imagine."
                                            },
                                            {
                                                "example_id": "6e10bfa4-7a55-4609-ac45-8a6b99e29956",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "That honour has been long The boast of mere pretenders to the name."
                                            },
                                            {
                                                "example_id": "2fedef18-7f91-492a-ae52-0ca8a6e516ef",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "I presume that there is no gentleman in Europe that has not heard of the house of Barry of Barryogue, of the kingdom of Ireland, than which a more famous name is not to be found in Gwillim or D’Hozier; and though, as a man of the world, I have learned to despise heartily the claims of some pretenders to high birth who have no more genealogy than the lacquey who cleans my boots, […]"
                                            },
                                            {
                                                "example_id": "e0c7912e-e0af-4f8a-ba72-0860e7c134fb",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "Simon, a Samaritan, a pretender to divine authority and supernatural powers."
                                            },
                                            {
                                                "example_id": "35c6c0be-8aed-4998-944e-40e5c6d62be3",
                                                "sense_id": "e67e50ad-7130-3a49-850d-005c126a8ff4",
                                                "text": "Neither will he be able to distinguish the pretender in medicine from the true physician, nor between any other true and false professor of knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f151926e-89e6-3f2f-95c3-819f331f3995",
                                        "entry_id": "4a66c26f-147b-3528-ae9a-3dd99668e7d7",
                                        "glosses": [
                                            "A person who professes beliefs and opinions that they do not hold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pretender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                        "entry_id": "76058388-8e9f-3ea5-9c59-ac72ff8f52d7",
                                        "glosses": [
                                            "To tender (a bid, etc.) in advance."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f7fac7-bd63-4596-a350-9f96ebc9e0ba",
                                                "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                                "text": "The LPM coordinates closely with the EPM and the case attorney throughout the pretendering period. The Licensing Assistant (LA) in the assigned project branch requests that a project number be assigned by the Records Facilities[…]"
                                            },
                                            {
                                                "example_id": "a99c11b7-73c7-4407-a16a-bef0c08fe8e6",
                                                "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                                "text": "Long-term delivery items were pretendered and purchased by the Government of the Northwest Territories in early 1975. Pretendered items included the polyethylene pipe and Victaulic couplings, a portable gasoline engine driven pump[…]"
                                            },
                                            {
                                                "example_id": "b00c94ee-74a1-400f-a6d7-e750c04c5f64",
                                                "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                                "text": "The prime contractor is then required to incorporate this pretendered work into his project schedule. In a similar fashion, the owner may want direct control over special materials needed on his project."
                                            },
                                            {
                                                "example_id": "e192e477-f511-4ce9-b1c4-23b75b0596cf",
                                                "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                                "text": "These included pretendered \"direct call-off\" contracts covering over 50,000 products and services; the \"Pathfinder\" service for larger or more complex procurements; and direct sales and spot buying, where TBA coordinates volume[…]"
                                            },
                                            {
                                                "example_id": "368b514f-aadf-47e2-846e-90f8438ae98c",
                                                "sense_id": "5703b839-53d7-3dd7-9c4d-341ef379c0cf",
                                                "text": "The expanded pretendering activities will be initiated about 9 months prior to the proposed tendering of an application and will be designed to provide additional guidance and direction to the applicant during the preparation of its[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da833add-f14d-4d9a-8053-05c9077b75fd",
                        "source_entry_id": "b0c58d56-557c-3018-ac84-55bac4a9b72e",
                        "source_sense_id": "9af6b2e5-d773-3fdf-ae42-33f5ffdfcfc7",
                        "source_sense_description": "Anwärter auf ein Amt; jemand, der Anspruch auf ein Amt erhebt",
                        "target_lang_word": "prétendent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prétendent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "854a2d31-b86c-3013-b39d-8896198d7ce7",
                                        "entry_id": "30e45cff-1270-3274-ba64-dfbfc62589f2",
                                        "glosses": [
                                            "Troisième personne du pluriel du présent de l’indicatif de prétendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e77828-e875-4944-908a-a524d4e948fd",
                                                "sense_id": "854a2d31-b86c-3013-b39d-8896198d7ce7",
                                                "text": "Les ’'Beaunois’' prétendent, comme les Dijonnais, que la ville doit son origine à Marc-Aurèle."
                                            },
                                            {
                                                "example_id": "e3be0be8-299d-4b0d-8fa5-704d21179059",
                                                "sense_id": "854a2d31-b86c-3013-b39d-8896198d7ce7",
                                                "text": "Le moindre cacographe est membre d’une société savante, et ceux qui ne savent rien ou ne peuvent pas écrire comptent les fontaines de Paris, examinent les couleurs des numéros que le préfet impose aux maisons, et se prétendent occupés de statistique ; car la statistique est devenue à la mode, et c’est une position que de statistiquer."
                                            },
                                            {
                                                "example_id": "2bd3228d-136e-4257-a716-ed34847677e8",
                                                "sense_id": "854a2d31-b86c-3013-b39d-8896198d7ce7",
                                                "text": "Les opposants au concept de genre prétendent souvent avancer des arguments relevant des sciences biologiques pour appuyer leurs propos. Ils construisent leur discours sur une supposée différence essentielle entre hommes et femmes, qui viendrait fonder un ordre décrit comme « naturel ». Les éléments de biologie sur lesquels ils s'appuient sont cependant, dans la plupart des cas, sortis de leur contexte et indûment généralisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c1fbb8-a002-3d82-968f-2b08c91b141e",
                                        "entry_id": "30e45cff-1270-3274-ba64-dfbfc62589f2",
                                        "glosses": [
                                            "Troisième personne du pluriel du présent du subjonctif de prétendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
