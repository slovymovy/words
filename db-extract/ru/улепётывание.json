                                        "entry_id": "b16c6412-89cc-3cb2-b775-248a780cb688",
                                        "glosses": [
                                            "To throw or kick something so as to send it flying with more loft or airtime than usual."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3858405-2388-4d9d-857b-191c9e692f7f",
                                                "sense_id": "321f1384-8b09-3302-997a-e39fd4ee3b05",
                                                "text": "Riyad Mahrez flighted the free-kick that followed to the far post and Morgan, with not much finesse but plenty of desire, bundled the ball over the line. Cue pandemonium in the stands."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flight",
                                "target_lang_code": "en",
                                "target_senses": [
