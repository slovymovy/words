                                    {
                                        "sense_id": "ccbb2459-aa5a-3385-9bb4-794c4883da1e",
                                        "entry_id": "eb2e9265-a667-3119-828f-a906e65531de",
                                        "glosses": [
                                            "napój alkoholowy powstały poprzez destylację wina"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5de131-a11d-484f-92ed-c0cb905addd0",
                                                "sense_id": "ccbb2459-aa5a-3385-9bb4-794c4883da1e",
                                                "text": "(…) służba poustawiała składane krzesła płócienne, a dla starszych panów przygotowała syfony z wodą sodową i brandy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
