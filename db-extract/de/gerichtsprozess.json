                        "examples": [
                            {
                                "example_id": "551bf018-d458-4fde-a72d-7b991ff1ef64",
                                "sense_id": "84f4093b-671d-3b5a-9e47-13707d4b3ca5",
                                "text": "Den letzten Gerichtsprozess haben wir verloren."
                            },
                            {
                                "example_id": "4b2d868f-ce08-468e-a2cd-20fb6320e15c",
                                "sense_id": "84f4093b-671d-3b5a-9e47-13707d4b3ca5",
                                "text": "Jetzt gibt es keinen Gerichtsprozess mehr. Die Menschen werden einfach hingerichtet."
                            },
                            {
                                "example_id": "aafeb984-3e04-4d0e-8071-7828f0cc1cf7",
                                "sense_id": "84f4093b-671d-3b5a-9e47-13707d4b3ca5",
                                "text": "„Von dem Gerichtsprozess und der Exekution weiß ich nur vom Hörensagen, doch die Spuckprobe habe ich mit eigenen Augen gesehen, und es war offensichtlich, dass die Laskaren sie sehr ernst nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
