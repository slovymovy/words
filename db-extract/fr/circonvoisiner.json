                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576f309b-7083-493b-8d17-e16fe4f309c0",
                                "sense_id": "247ff211-8b68-3ad7-9d1e-1837be90eb76",
                                "text": "Le Congrès Singulier établi un camp de base, qui permet, de faire des explorations journalières intra et extra campement, de circuler, de circonvoisiner, de circumdéambuler."
                            },
                            {
                                "example_id": "d6c066b4-09f8-437e-91cf-95daaa11a216",
                                "sense_id": "247ff211-8b68-3ad7-9d1e-1837be90eb76",
                                "text": "Les partis et les associations ne s'ébranlent sur ce territoire que pour « circonvoisiner » les urnes lors des échéances électorales."
                            }
                        ]
                    }
