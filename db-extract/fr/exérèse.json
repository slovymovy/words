                        "entry_id": "c910a4db-d42a-3092-86b6-d53e1c6c768d",
                        "glosses": [
                            "Toute opération qui consiste à extraire ou à retrancher du corps humain ce qui est étranger, nuisible ou superflu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fc95d1-13cd-433e-8a78-d66820381ace",
                                "sense_id": "3536ea03-a9cd-3168-898d-da34e3bd320e",
                                "text": "En outre, la distinction opérable / inopérable se complique, certains cancers inopérables peuvent devenir accessibles à l’exérèse si celle-ci est couplée à la radiothérapie."
                            },
                            {
                                "example_id": "1b47ad75-4e44-47f4-be92-be400be82a7e",
                                "sense_id": "3536ea03-a9cd-3168-898d-da34e3bd320e",
                                "text": "Longtemps, le diagnostic de l’endométriose n’a reposé que sur l’exérèse chirurgicale de lésions."
                            }
                        ]
                    }
                ],
