                "senses": [
                    {
                        "sense_id": "c56b2379-a194-3355-b0ba-11b7868d51ce",
                        "entry_id": "b0cf8793-c669-37b3-9295-bd0664bbc801",
                        "glosses": [
                            "Courant catholique libéral italien du début du XIXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4538f4f1-33ba-4555-93c7-bebfe34f5dea",
                                "sense_id": "c56b2379-a194-3355-b0ba-11b7868d51ce",
                                "text": "Le néo-guelfisme fut théorisé par Vincenzo Gioberti (1801-1852). Ce prêtre patriote était favorable à la création d’un État italien fédéré autour du pape."
                            },
                            {
                                "example_id": "ca2f4a6d-53b5-41b6-afaf-d1a4281e74b5",
                                "sense_id": "c56b2379-a194-3355-b0ba-11b7868d51ce",
                                "text": "Les hommes sérieux, les hommes pratiques de l’Italie ne sont pas assez naïfs pour donner de l’importance aux poétiques illusions du néo-guelfisme piémontais."
                            },
                            {
                                "example_id": "897df8d9-b301-4402-9c5f-f4fb841dbd07",
                                "sense_id": "c56b2379-a194-3355-b0ba-11b7868d51ce",
                                "text": "Le néo-guelfisme giobertien faisait figure de doctrine révolutionnaire sur le plan philosophique et surtout sur le plan politique, car être giobertien c’était aussi être libéral."
                            }
                        ]
                    }
                ],
