                    },
                    {
                        "translation_id": "4c46a6ac-f9a0-49a9-bab8-8548e5ee06a8",
                        "source_entry_id": "50433f51-53ef-3dc6-acbe-1bb30a2a980b",
                        "source_sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                        "target_lang_word": "afkeuring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afkeuring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                        "entry_id": "b8859241-fb84-3cb7-b244-594dcd881127",
                                        "glosses": [
                                            "het uitspreken van een negatief oordeel over iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ab6799-1218-450e-ba0a-3c5b88c703d4",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De zieke man was helemaal niet blij met de afkeuring voor zijn werk dat hij altijd met plezier had gedaan."
                                            },
                                            {
                                                "example_id": "a5236d96-a9b1-4778-bd2c-09907f70afde",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De afkeuring van de oude volledig doorgeroeste auto kwam niet als een verrassing."
                                            },
                                            {
                                                "example_id": "e5ce8964-faf6-4865-9fb6-81ec4293389a",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "'Het is een lang verhaal,' zei hij in reactie op de afkeuring die hij in mijn woorden had bespeurd."
                                            },
                                            {
                                                "example_id": "e22a81ef-a961-43d9-a255-30f71f4d16e6",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "Naast het feit dat er zeker een kern van waarheid in hun reactie zat, verbaasde ik me vooral over de felle toon van hun afkeuring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
