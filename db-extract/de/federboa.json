                "senses": [
                    {
                        "sense_id": "fddaec14-8fa7-3c2f-8cf8-1aa0aa09ee9a",
                        "entry_id": "2bb5b161-a900-3438-b8df-d35dc9e79231",
                        "glosses": [
                            "aus Federn gefertigtes, schalartiges Kleidungsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37aac78-8060-4f2d-ba37-b760a78c66de",
                                "sense_id": "fddaec14-8fa7-3c2f-8cf8-1aa0aa09ee9a",
                                "text": "„Eine Spielerei war besonders erfolgreich: ein Schal, der am Hals ein bißchen aussieht wie eine Federboa aus den zwanziger Jahren.“"
                            },
                            {
                                "example_id": "15c9fa35-79df-42af-8f05-521b4974c893",
                                "sense_id": "fddaec14-8fa7-3c2f-8cf8-1aa0aa09ee9a",
                                "text": "„Die Contessa trug zu ihrem altmodischen, hochgeschlossenen Spitzenkleid heute eine Federboa.“"
                            },
                            {
                                "example_id": "13c9d26f-1b8c-4d62-b027-1b43b7bc27ff",
                                "sense_id": "fddaec14-8fa7-3c2f-8cf8-1aa0aa09ee9a",
                                "text": "„Sie waren im Le Monocle, Margarets und Janes Lieblingsbar, und Jane trug, wie viele von den ausschließlich weiblichen Gästen, einen Anzug mit Weste, während Margaret mit einer Federboa und einem perlenbestickten Stirnband geschmückt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
