                "forms": [
                    {
                        "form_id": "12c84abb-5d06-41a1-8134-4d2b6d8d82ab",
                        "entry_id": "8988c9b4-d250-3030-81be-3a7ab6882a0b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "étalagistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca2a940a-7920-3667-9809-7f8d56cdedad",
                        "entry_id": "8988c9b4-d250-3030-81be-3a7ab6882a0b",
                        "glosses": [
                            "Celui, celle qui expose sa marchandise en vente dans les rues, sur les places, dans les marchés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb88bcb7-ecc5-4f96-9493-f6bda1d6bd6d",
                                "sense_id": "ca2a940a-7920-3667-9809-7f8d56cdedad",
                                "text": "Les boutiques de librairie en regorgent ; on en voit des milliers suspendues pêle-mêle au milieu des romances et des légendes versifiées des étalagistes en plein vent."
                            },
                            {
                                "example_id": "44e73b26-73cc-462f-9a29-dfb1b2748d45",
                                "sense_id": "ca2a940a-7920-3667-9809-7f8d56cdedad",
                                "text": "Ce qui n’était pas renfermé dans la balle assujettie par de fortes bretelles sur ses épaules, lui pendait au cou et à la ceinture : un véritable brelandinier, quelque chose comme un étalagiste ambulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a20a494-2ac6-3b1f-add4-580e5cd9d42a",
                        "entry_id": "8988c9b4-d250-3030-81be-3a7ab6882a0b",
                        "glosses": [
                            "Celui, celle qui, dans les magasins, dispose l’étalage à la devanture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f177bcb-314a-4047-aede-48eb9fb770a8",
                                "sense_id": "5a20a494-2ac6-3b1f-add4-580e5cd9d42a",
                                "text": "Tous en convenaient, le patron était le premier étalagiste de Paris, un étalagiste révolutionnaire à la vérité, qui avait fondé l’école du brutal et du colossal dans la science de l’étalage."
                            },
                            {
                                "example_id": "4034d081-8569-4ed2-ad76-e385117c5fa8",
                                "sense_id": "5a20a494-2ac6-3b1f-add4-580e5cd9d42a",
                                "text": "Ensuite ce furent les armoires où elle rangea son linge, le mien, avec un soin méticuleux, des raffinements compliqués, l’adresse d’une étalagiste consommée."
                            }
                        ]
                    }
                ],
