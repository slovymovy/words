                                    {
                                        "sense_id": "a32ad672-171b-3aea-9cdc-40811b32e16b",
                                        "entry_id": "4a69718f-47e5-3f89-91b8-84dc68162576",
                                        "glosses": [
                                            "deelneemster die na het afvallen van andere deelnemers in de voorronden mee mag doen aan de laatste fase waarin de uiteindelijke winnares wordt bepaald",
                                            "vrouwelijke deelnemer aan de eindstrijd die de winnaar van een competitie of toernooi aanwijst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc0b525-dafa-4d28-a4fc-b1f2decc9c8a",
                                                "sense_id": "a32ad672-171b-3aea-9cdc-40811b32e16b",
                                                "text": "Het was voor de zwemster toch een teleurstelling dat zij als finaliste geen medaille wist te behalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ad0533-6da3-3da6-9783-49fc2eb1ec95",
                                        "entry_id": "4a69718f-47e5-3f89-91b8-84dc68162576",
                                        "glosses": [
                                            "deelneemster die na het afvallen van andere deelnemers in de voorronden mee mag doen aan de laatste fase waarin de uiteindelijke winnares wordt bepaald",
                                            "vrouwelijke deelnemer aan de eindronde van een concours"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460d92dc-fa2d-42db-b462-d2c32bf32884",
                                                "sense_id": "26ad0533-6da3-3da6-9783-49fc2eb1ec95",
                                                "text": "In de voorronden waren de uit te voeren werken allemaal voorgeschreven, maar als finaliste mocht zij ook een zelf gekozen muziekstuk spelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "366d47a6-8cfd-4536-ae13-e775479d6336",
                        "source_entry_id": "405a4340-b898-3ac0-b521-a6e5bc7a549f",
                        "source_sense_description": "participant in final",
                        "target_lang_word": "finaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca3b52d0-3ec5-32a6-b984-deb66c9f4766",
                                        "entry_id": "0fd44956-e3ae-3ce9-aae8-f3a663034081",
                                        "glosses": [
                                            "Qui est qualifié pour la finale, qui participe ou a participé à la finale, dans des tournois par élimination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6caa0e6b-497c-3deb-90a1-5482cd5a9de4",
                                        "entry_id": "0fd44956-e3ae-3ce9-aae8-f3a663034081",
                                        "glosses": [
                                            "Dans certaines compétitions, tels les Jeux Olympiques, qui se classe parmi les huit premiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "926ba509-7c19-3cf8-9631-81e4fe666467",
                                        "entry_id": "0fd44956-e3ae-3ce9-aae8-f3a663034081",
                                        "glosses": [
                                            "Qui a participé à la finale en ayant perdu ou, selon le type de compétition, sans avoir terminé sur le podium ou qui s'est classé entre la quatrième et la huitième place."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c80554b-5086-4395-a5ad-0e441acf5231",
                                                "sense_id": "926ba509-7c19-3cf8-9631-81e4fe666467",
                                                "text": "Sa carrière était dense, quart de finaliste sur toutes les surfaces des tournois du Grand Chelem, demi–finaliste à Roland-Garros, finaliste de Wimbledon en 2007 à 22 ans, 7 tournois gagnés, mais lui manquait ce qu'elle recherchait de façon récurrente, son rêve : gagner un tournoi du Grand Chelem."
                                            },
                                            {
                                                "example_id": "18c65c49-f95c-46bc-a25f-942387694845",
                                                "sense_id": "926ba509-7c19-3cf8-9631-81e4fe666467",
                                                "text": "La coupe reste les meilleurs exploits du club, finaliste de la Joillet-Rousseau en 1986, demi finaliste à trois reprises, quart de finaliste en 1982 de la coupe du District, après avoir éliminé trois équipes de Première Division."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea514eb-e45e-3a46-814c-ba659182a9c5",
                                        "entry_id": "0fd44956-e3ae-3ce9-aae8-f3a663034081",
                                        "glosses": [
                                            "Relatif au finalisme, à la téléologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10ac05a-0207-4226-be56-982e58492d1d",
                                                "sense_id": "cea514eb-e45e-3a46-814c-ba659182a9c5",
                                                "text": "Il ne faut pas être finaliste. Il n’est vraiment guère scientifique de se demander à quoi sert telle ou telle chose, et c’est la preuve d’une mentalité peu avancée de se demander, comme Voltaire, « à quoi sert la précession des équinoxes. »"
                                            },
                                            {
                                                "example_id": "a0e9ee53-1d6e-4fed-8473-22eb998ab289",
                                                "sense_id": "cea514eb-e45e-3a46-814c-ba659182a9c5",
                                                "text": "René Jeannel est un cas de lamarckiste finaliste, partisan d’une thèse orthogénétique de l’évolution, par laquelle les organes se compliquent de plus en plus : les spécialisations progressives, par ajustement de plus en plus fin aux conditions de milieu, deviennent héréditaires […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "finaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "135a6305-8e27-3f4e-b61d-891374a7846d",
                                        "entry_id": "b57ab2a0-dd0e-3b1f-9b60-8e03ce7738ee",
                                        "glosses": [
                                            "Qualifié pour la finale, participant à la finale, dans des tournois par élimination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1888d1f-bc8d-4c38-86c6-87ff8caa08f6",
                                                "sense_id": "135a6305-8e27-3f4e-b61d-891374a7846d",
                                                "text": "Je l’ai repéré lors d’un tournoi de tennis de table que les moniteurs de sport ont organisé à l’attention des détenus et où, excellent pongiste, il a rencontré et battu le finaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a95c2c0-0a06-35dd-aa17-19ec77e71176",
                                        "entry_id": "b57ab2a0-dd0e-3b1f-9b60-8e03ce7738ee",
                                        "glosses": [
                                            "Dans certaines compétitions, tels les Jeux Olympiques, classé parmi les huit premiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39e3bd15-4d88-346e-aad4-69abd03b3c4c",
                                        "entry_id": "b57ab2a0-dd0e-3b1f-9b60-8e03ce7738ee",
                                        "glosses": [
                                            "Perdant d’une finale ou, selon le type de compétition, classé entre la quatrième et la huitième place."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "finaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79bee9ca-e4f3-36f0-b70d-c223eb1648da",
                                        "entry_id": "7b505543-b8be-3de2-ab2b-6fe75ecf24c8",
                                        "glosses": [
                                            "Tenant ou tenante du finalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9800b6f3-7459-4a31-a542-42d675bdf06f",
                                                "sense_id": "79bee9ca-e4f3-36f0-b70d-c223eb1648da",
                                                "text": "Ainsi, raisonnent les finalistes, le nez est merveilleusement adapté au port de lunettes et il est extraordinaire que les fruits comblent nos besoins en sucre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
