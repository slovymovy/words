                    },
                    {
                        "translation_id": "04396f07-b4e2-496b-82e2-bae6683fd2e7",
                        "source_entry_id": "9df1a4b6-23a8-31ec-a5be-a05e93288131",
                        "source_sense_description": "a condition in which the head is abnormally large",
                        "target_lang_word": "macrocéphalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macrocéphalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "694848ca-ddc7-308d-813a-e095750af458",
                                        "entry_id": "59fb3c8d-f8e3-3e80-b4bc-b6203284ee58",
                                        "glosses": [
                                            "Augmentation du volume du crâne, généralement due à une accumulation de liquide dans les cavités du cerveau (hydrocéphalie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68825f67-fe2f-42ce-ab9f-5ba2bbf8b325",
                                                "sense_id": "694848ca-ddc7-308d-813a-e095750af458",
                                                "text": "Aussi appelé syndrome de Sotos, le gigantisme cérébral est caractérisé par une macrocéphalie."
                                            },
                                            {
                                                "example_id": "0882fefd-3940-43e7-b561-382c7bd59e3f",
                                                "sense_id": "694848ca-ddc7-308d-813a-e095750af458",
                                                "text": "À l’examen échographique, on observe par ailleurs une macrocéphalie avec une bosse frontale et parfois une hydrocéphalie ou un hypertelorisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8091ea67-e70e-3aa3-8b0b-42913303aace",
                                        "entry_id": "59fb3c8d-f8e3-3e80-b4bc-b6203284ee58",
                                        "glosses": [
                                            "Configuration d’un espace largement dominé par un pôle unique concentrant population, activités et fonctions au point de freiner voire d’empêcher l’affirmation de pôles secondaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec0d862-3109-4801-a3f5-74fc40474a3a",
                                                "sense_id": "8091ea67-e70e-3aa3-8b0b-42913303aace",
                                                "text": "Héritage de politiques étatiques pluriséculaires de centralisation, l’armature urbaine française se distingue par sa macrocéphalie. Paris concentre et polarise bien plus que n’importe quelle ville en Europe"
                                            },
                                            {
                                                "example_id": "824ad70e-789d-4dba-9e6e-26a13e8d34f0",
                                                "sense_id": "8091ea67-e70e-3aa3-8b0b-42913303aace",
                                                "text": "Le sommet de la hiérarchie urbaine selon l’emploi accentue la macrocéphalie parisienne."
                                            },
                                            {
                                                "example_id": "e6eda0fa-0165-40b9-95ff-ad79c2c77c66",
                                                "sense_id": "8091ea67-e70e-3aa3-8b0b-42913303aace",
                                                "text": "Une tendance de l’armature urbaine du Mexique à la macrocéphalie apparaît donc puisque, en 2005, Mexico est 4,5 fois plus peuplée que la deuxième agglomération, Guadalajara, mais cette tendance est nettement moindre que dans nombre de pays d’Amérique latine, comme en Argentine avec Buenos Aires ou au Chili avec Santiago, deux capitales qui concentrent le tiers de la population de leur pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
