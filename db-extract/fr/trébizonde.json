                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2fa736e-0c79-3b63-acb3-473444534674",
                        "entry_id": "59e52646-7ddd-357e-b5cd-1091d4904992",
                        "glosses": [
                            "Ancien nom de la ville turque de Trabzon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c691f74-eaed-486d-a1c2-2d2591ae55c1",
                                "sense_id": "d2fa736e-0c79-3b63-acb3-473444534674",
                                "text": "Le lézard se traîne où se promenait jadis la belle Geneviève songeant à son amant parti en Trébizonde combattre les géants."
                            },
                            {
                                "example_id": "4dbf04ef-f1ae-48b9-bc81-8fea7a5b2014",
                                "sense_id": "d2fa736e-0c79-3b63-acb3-473444534674",
                                "text": "Les Russes viennent d’emporter Erzeroum. Bientôt Trébizonde sera en leur pouvoir. C’est toute une politique de la mer Noire qui va être à envisager."
                            },
                            {
                                "example_id": "d9d5c4d2-3763-4033-adc0-620ef80ba9e6",
                                "sense_id": "d2fa736e-0c79-3b63-acb3-473444534674",
                                "text": "En voilier jusqu’à Trébizonde, la mer Noire est calme, trop calme, le vent souffle peu, on contemple pendant des heures le même point de côte, le même rocher, le même bosquet anatolien."
                            }
                        ]
                    }
