                    {
                        "translation_id": "a6bfad9f-520b-4d96-a875-7eb7d5f5c8bf",
                        "source_entry_id": "2b25e82a-a49e-3f75-a916-8b5c4495674e",
                        "source_sense_description": "condition",
                        "target_lang_word": "pied plat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pied plat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d105018-2683-374f-ab65-6c1d3ea87b01",
                                        "entry_id": "a9c541e8-f51a-33b9-8cac-7feebfd4e8e7",
                                        "glosses": [
                                            "Pied large et comme aplati, en parlant surtout des chevaux qui ont ce vice de conformation, mais aussi des humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be643bb-903e-408f-96ba-74023e9b5fb3",
                                                "sense_id": "8d105018-2683-374f-ab65-6c1d3ea87b01",
                                                "text": "M. Bergeret n’était pas vain de son pied. Mais il avait lu un jour que M. de Lamartine montrait avec orgueil son pied nu, hautement coudé et portant sur le sol en arche de pont. Et M. Bergeret s’autorisait de cet exemple pour goûter quelque plaisir à n’avoir pas le pied plat."
                                            },
                                            {
                                                "example_id": "bfd85de5-d3b6-4a96-a2b4-c550d3746e06",
                                                "sense_id": "8d105018-2683-374f-ab65-6c1d3ea87b01",
                                                "text": "Y avait que son grand-père qui comptait. Un Tartarin !… Un feignant qui n’avait même pas fait la guerre… Réformé pour ses pieds plats…"
                                            },
                                            {
                                                "example_id": "82d4c37a-3684-4f15-b195-038439ec2d91",
                                                "sense_id": "8d105018-2683-374f-ab65-6c1d3ea87b01",
                                                "text": "Il avait plus de quarante ans, de grands pieds plats, et son menton qui rebiquait vers le ciel rejoignait presque ses épaisses moustaches noires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6a5dcf-74cd-35f9-8757-efc915ffd44c",
                                        "entry_id": "a9c541e8-f51a-33b9-8cac-7feebfd4e8e7",
                                        "glosses": [
                                            "Homme vil, sans dignité, sans caractère, pleutre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2924a510-8fc0-4aaf-bac6-be437421620f",
                                                "sense_id": "9f6a5dcf-74cd-35f9-8757-efc915ffd44c",
                                                "text": "C’est un pied plat qu’aucune humiliation ne rebute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b64346-26cb-31d0-9531-cf70396cd1db",
                                        "entry_id": "a9c541e8-f51a-33b9-8cac-7feebfd4e8e7",
                                        "glosses": [
                                            "Policier, dans l’argot des gendarmes"
                                        ],
                                        "tags": [
                                            "Par dérision"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82c18705-a3e7-3d27-bdc8-e4c33ae734e9",
                                        "entry_id": "a9c541e8-f51a-33b9-8cac-7feebfd4e8e7",
                                        "glosses": [
                                            "Goujat"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8756cd57-c7a6-4947-82e8-1ac974e15f97",
                        "source_entry_id": "2b25e82a-a49e-3f75-a916-8b5c4495674e",
                        "source_sense_description": "condition",
                        "target_lang_word": "Plattfuß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plattfuß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7e4f4b6-427f-3fc2-8f26-d52f93aaf57e",
                                        "entry_id": "e3a43ddb-08f3-3bee-b58a-85349a2f1128",
                                        "glosses": [
                                            "Fuß mit abgesenkter Wölbung zwischen Ballen und Ferse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4111ca10-3b24-41a8-8005-4c7e6a5e1099",
                                                "sense_id": "d7e4f4b6-427f-3fc2-8f26-d52f93aaf57e",
                                                "text": "„Mit seinen Plattfüßen schien er sich ausgesöhnt zu haben, da das Gebrechen ihn doch vor allerlei körperlichen Arbeiten bewahrte, wie etwa dem gefürchteten Transport von Kohle, Koks oder Briketts aus dem Keller.“"
                                            },
                                            {
                                                "example_id": "d6e67028-9d9b-4701-8d4d-de867b46c616",
                                                "sense_id": "d7e4f4b6-427f-3fc2-8f26-d52f93aaf57e",
                                                "text": "„Ende Dezember 1948 wurde ich wegen meiner Plattfüße zum Nachschub versetzt.“"
                                            },
                                            {
                                                "example_id": "a0a3965f-17ff-4457-a54e-f237e1d03951",
                                                "sense_id": "d7e4f4b6-427f-3fc2-8f26-d52f93aaf57e",
                                                "text": "„Ein Kellner, der vier Schritte entfernt auf Plattfüßen an uns vorüberwatschelt, ist plötzlich taub.“"
                                            },
                                            {
                                                "example_id": "eacebdb2-54de-4956-8f1d-f5134ff4f4f3",
                                                "sense_id": "d7e4f4b6-427f-3fc2-8f26-d52f93aaf57e",
                                                "text": "„Er legte seine Kleidung ab, um die Ausdünstung nicht zu beinträchtigen; dann verharrte er auf dem Waagebrett völlig nackt und ließ, trotz seiner Schamhaftigkeit, seinen langen zylinderförmigen Rumpf, seine kurzen Beine, seine Plattfüße und seine braune Haut sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ab7561c-a545-33b6-8461-a33609917fb0",
                                        "entry_id": "e3a43ddb-08f3-3bee-b58a-85349a2f1128",
                                        "glosses": [
                                            "umgangssprachlich: Reifen ohne genug Luft darin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c82ff6-8a1a-4ef2-96b4-55e935c2a383",
                                                "sense_id": "1ab7561c-a545-33b6-8461-a33609917fb0",
                                                "text": "Mit diesem Plattfuß können wir nicht weiterfahren."
                                            },
                                            {
                                                "example_id": "fee3dcc9-40b7-4c1d-a185-30230540f853",
                                                "sense_id": "1ab7561c-a545-33b6-8461-a33609917fb0",
                                                "text": "„Es gab nicht viel, wobei man noch belemmerter aussah, als wenn man ein Rad mit Plattfuß zu schieben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
