                        ],
                        "examples": [
                            {
                                "example_id": "c9eba5e8-bdd9-4136-94dd-b933e69f4e8e",
                                "sense_id": "b158a246-7817-35c4-bd8b-76fa5290350f",
                                "text": "Domestizierung der Haustiere 1\nca. 25'000 v.Chr.\nHund\nca. 8'000 v.Chr.\nAuerrind\nSchaf\nZiege\nca. 7'000 v.Chr.\nKatze\nSchwein\nZeburind",
                                "translation": "Domestication of pets 1\nabout 25'000 BC\nDog\nabout 8'000 BC\nAurochs\nSheep\nGoat\nabout 7'000 BC\nCat\nPig\nZebu bull",
                                "english": "Domestication of pets 1\nabout 25'000 BC\nDog\nabout 8'000 BC\nAurochs\nSheep\nGoat\nabout 7'000 BC\nCat\nPig\nZebu bull"
                            }
                        ]
                    }
