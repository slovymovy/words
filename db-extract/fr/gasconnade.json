        "fr-extract.jsonl": [
            {
                "entry_id": "ac947f61-032b-3ccd-9b0a-24f5b97b283a",
                "word": "gasconnade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e6eb563b-0817-47f6-9baf-dec67f21c8ed",
                        "entry_id": "ac947f61-032b-3ccd-9b0a-24f5b97b283a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gasconnades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21c80890-a986-3054-930a-163c3bf80f9d",
                        "entry_id": "ac947f61-032b-3ccd-9b0a-24f5b97b283a",
                        "glosses": [
                            "Hâblerie de Gascon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9062cea0-471d-493c-a4de-44e9283cc610",
                                "sense_id": "21c80890-a986-3054-930a-163c3bf80f9d",
                                "text": "Vous verrez que celle de d’Artois est écrite avec beaucoup de finesse et d’effervescence ; mais, en rabattant les gasconnades de la nation, au fond nous pensons de même."
                            },
                            {
                                "example_id": "ab937a7d-9028-4c97-b96c-453cc8abef22",
                                "sense_id": "21c80890-a986-3054-930a-163c3bf80f9d",
                                "text": "Il prétend être fort riche, c’est pure gasconnade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "168b06ab-a153-49df-ab41-6f753c06aee1",
                        "source_entry_id": "ac947f61-032b-3ccd-9b0a-24f5b97b283a",
                        "source_sense_id": "21c80890-a986-3054-930a-163c3bf80f9d",
                        "target_lang_word": "Gascognade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e09fa3dd-3a5e-477a-89aa-62a4898b2956",
                        "source_entry_id": "ac947f61-032b-3ccd-9b0a-24f5b97b283a",
                        "source_sense_id": "21c80890-a986-3054-930a-163c3bf80f9d",
                        "target_lang_word": "gasconade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gasconade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                        "entry_id": "62bfde74-e8f9-33e6-bbbc-1e55c1e0509b",
                                        "glosses": [
                                            "Boastful talk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c8c98e-e086-4173-a1a7-f85a9c4b8b3d",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "[…] the Gasconads of France, Rodomontads of Spain, Fanfaronads of Italy, and Bragadochio brags of all other countries, could no more astonish his invincible heart, then would the cheeping of a mouse a bear robbed of her whelps."
                                            },
                                            {
                                                "example_id": "321e0af8-fbdf-4a77-a85b-9c2c3c6f28d6",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "If the Author was Jesuite enough to say this to himself, before he wrote it, he may come off. If not, it will prove a most unconscionable Gasconade. Pate ᵃ was never Bishop of Rochester, but of Worcester; he was not Banish'd, but Fed; and this not in King Edward's time, but in King Henry's."
                                            },
                                            {
                                                "example_id": "b4ca2fdc-6f8f-4c96-bc57-1eedfc6dc12d",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "\"This Gasconade surprised Le Maitre — 'You'll see,' said he, whispering to me, 'that he does not know a single note.'\"",
                                                "translation": "W. Cunningham Mallory",
                                                "english": "W. Cunningham Mallory"
                                            },
                                            {
                                                "example_id": "3425521c-d4cd-4e8c-9d8d-315568625501",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "\"Just now... a cry from the opposite party who are content when they have enough, and like to look on and enjoy in the meanwhile, savours a little of bravado and gasconade.\""
                                            },
                                            {
                                                "example_id": "6ce0a3df-6ddd-4b43-ac12-d7f7691961a8",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "\" The tricks, the Gasconnades, the buffooneries had gone.\""
                                            },
                                            {
                                                "example_id": "495abcf8-7da6-4b61-b04a-2ac6a06d69b9",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "Nor was the president's talk of abundant and inexhaustible resources mere gasconade."
                                            },
                                            {
                                                "example_id": "ba175a13-4f20-4594-beb8-da3168feb56c",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "The message is a gamer's gasconade: We cheat, we steal, we eat your lunch."
                                            },
                                            {
                                                "example_id": "876752c1-18cd-4e6e-9ab5-a962d99e40d0",
                                                "sense_id": "9aa741ff-3642-33cb-b0b9-dbea50b47d99",
                                                "text": "When it comes to the Middle East, presidents can’t resist indulging in a gasconade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gasconade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69d85a52-9721-3b33-9744-f3280a443397",
                                        "entry_id": "a90abe6a-5aa7-334d-bc9c-c97e256c1b9b",
                                        "glosses": [
                                            "Of or pertaining to exaggeration or extravagant boasting; bombastic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1050a4-d829-4eb7-908c-87cb4e09a055",
                                                "sense_id": "69d85a52-9721-3b33-9744-f3280a443397",
                                                "text": "But Poetry and her sister arts are now in the decline; since the Gasconade style is out of date they seem quite at a stand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gasconade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                        "entry_id": "d03339fd-e848-38c4-983a-f678c5667989",
                                        "glosses": [
                                            "To talk boastfully."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5cb50f-7346-4c73-8b82-200657241b70",
                                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                                "text": "The Frenchman, not being able to bring the precise number, received only, as the first month's pay, 2,000 rupees. He demanded an audience, talked loud, and gasconaded."
                                            },
                                            {
                                                "example_id": "b8a8eb5d-37e7-46cf-a3b9-5cef485ab516",
                                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                                "text": "[…]he gasconaded on the theme of his personal exploits in the Seven Years' War of France in Spain, as if he had been as prime a sword-player as Murat[…]"
                                            },
                                            {
                                                "example_id": "6d66fa21-d380-46e0-89f2-a76ebd49f74d",
                                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                                "text": "For two hours, [Khrushchev] gasconaded about the tenfold revaluation of the ruble and the abolition of the Soviet income tax by 1965."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
