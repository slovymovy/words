                            {
                                "example_id": "e5a3b194-6713-4073-8021-0e5d641e6e37",
                                "sense_id": "8545f6b6-61e5-3180-9ce3-c4bba9f0952d",
                                "text": "„Zulässig ist die Seeraumüberwachung, wie sie bereits im Rahmen der Operation ‚Allied Provider‘ durchgeführt wurde.“"
                            },
                            {
                                "example_id": "01de74e1-d8e4-4f1c-9f59-b670ff4bf60c",
                                "sense_id": "8545f6b6-61e5-3180-9ce3-c4bba9f0952d",
                                "text": "„Im Laufe der Nacht entdeckte das Kriegsschiff während der Seeraumüberwachung mehrere ‚Speedboote‘, welche die ‚Star Clipper‘ umkreisten und sich bis auf einige Seemeilen näherten.“"
                            }
                        ],
