    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8901c74a-55c8-3f25-aadf-e0c27dddb663",
                    "sense_definition": "Iemand formeel of beleefd vragen om iets te doen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verzoek</w> u vriendelijk om even te wachten.",
                            "target_lang_translations": {
                                "en": "I kindly <w>request</w> you to wait a moment.",
                                "ru": "Я вежливо <w>прошу</w> вас немного подождать.",
                                "it": "La <w>prego</w> cortesemente di attendere un momento."
                            }
                        },
                        {
                            "text": "De passagiers werd <w>verzocht</w> hun veiligheidsgordels aan te doen.",
                            "target_lang_translations": {
                                "en": "Passengers were <w>requested</w> to fasten their seatbelts.",
                                "ru": "Пассажиров <w>попросили</w> пристегнуть ремни безопасности.",
                                "it": "Ai passeggeri è stato <w>richiesto</w> di allacciare le cinture di sicurezza."
                            }
                        },
                        {
                            "text": "Wij <w>verzoeken</w> iedereen om stil te zijn tijdens de voorstelling.",
                            "target_lang_translations": {
                                "en": "We <w>request</w> everyone to be quiet during the performance.",
                                "ru": "Мы <w>просим</w> всех соблюдать тишину во время представления.",
                                "it": "<w>Preghiamo</w> tutti di fare silenzio durante lo spettacolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "vragen"
                    ],
                    "antonyms": [
                        "bevelen",
                        "verbieden"
                    ],
                    "common_phrases": [
                        "vriendelijk verzoeken",
                        "dringend verzoeken",
                        "iemand verzoeken te"
                    ],
                    "target_lang_definitions": {
                        "en": "To ask someone formally or politely to do something",
                        "ru": "Официально или вежливо просить кого-либо сделать что-либо",
                        "it": "Chiedere formalmente o cortesemente a qualcuno di fare qualcosa"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "request",
                                "target_lang_sense_clarification": "formal"
                            },
                            {
                                "target_lang_word": "ask",
                                "target_lang_sense_clarification": "general"
                            }
                        ],
                        "ru": [
                            {
