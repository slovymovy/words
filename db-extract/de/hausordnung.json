                    {
                        "sense_id": "277d7918-f1cd-30fc-b7f9-0cbb13fa819b",
                        "entry_id": "a28c5315-8b6f-3057-9313-db968bc61e41",
                        "glosses": [
                            "Vorschriften über das Verhalten und die Pflichten innerhalb eines (Privat-)Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9189e30-4df6-4cea-86a4-43f2dba32cac",
                                "sense_id": "277d7918-f1cd-30fc-b7f9-0cbb13fa819b",
                                "text": "Die Hausordnung untersagt die Haltung von Tieren jeglicher Art."
                            },
                            {
                                "example_id": "9e623615-db8e-48fc-a261-66b9f34d661e",
                                "sense_id": "277d7918-f1cd-30fc-b7f9-0cbb13fa819b",
                                "text": "Die Hausordnung ist in jedem Falle zu befolgen."
                            },
                            {
                                "example_id": "c52198b2-6872-4a20-8c8c-53405a4f349a",
                                "sense_id": "277d7918-f1cd-30fc-b7f9-0cbb13fa819b",
                                "text": "„Die Hausordnung ist drakonisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
