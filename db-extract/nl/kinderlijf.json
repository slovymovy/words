                        "examples": [
                            {
                                "example_id": "09eb2bfc-94fd-46c0-af00-4215eefa1def",
                                "sense_id": "9beb27ef-19f7-3b11-98e6-42db9f0a9601",
                                "text": "Ze slaat haar armen om het warme kinderlijfje en drukt het tegen zich aan."
                            },
                            {
                                "example_id": "5ecafcc9-bd84-491a-9850-c4aaa7969ad8",
                                "sense_id": "9beb27ef-19f7-3b11-98e6-42db9f0a9601",
                                "text": "Diede is geboren met de ziekte van Pompe, een erfelijke spierziekte die bij 1 op de 100.000 mensen voorkomt. Nadat de ziekte is geconstateerd, krijgt het meisje een medicijn om de ziekte waarbij alle spieren in het lichaam steeds verder verslappen, af te remmen. Maar inmiddels heeft Diede teveel antistoffen opgebouwd tegen het medicijn. Het gevolg is rampzalig: het middel kan de afvalstoffen niet meer goed opruimen en de spiercellen in het kinderlijf worden in hoog tempo aangetast."
                            }
                        ]
