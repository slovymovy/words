{
    "word_family": [
        "relapser",
        "relapsing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47f5ee80-e988-3c0e-a3ba-6a62e9b87884",
                    "sense_definition": "A deterioration in someone's state of health after a temporary improvement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered a severe <w>relapse</w> and had to return to the hospital.",
                            "target_lang_translations": {
                                "ru": "У пациента случился тяжелый <w>рецидив</w>, и ему пришлось вернуться в больницу.",
                                "zh": "病人病情严重<w>复发</w>，不得不回到医院。"
                            }
                        },
                        {
                            "text": "Doctors are monitoring him closely to ensure he does not have a <w>relapse</w>.",
                            "target_lang_translations": {
                                "ru": "Врачи внимательно наблюдают за ним, чтобы убедиться, что у него не будет <w>рецидива</w>.",
                                "zh": "医生正在密切观察他，以确保病情不会<w>复发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recurrence",
                        "setback",
                        "deterioration"
                    ],
                    "antonyms": [
                        "recovery",
                        "remission",
                        "improvement"
                    ],
                    "common_phrases": [
                        "suffer a relapse",
                        "have a relapse",
                        "prevent a relapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухудшение состояния здоровья после временного улучшения.",
                        "zh": "指病情在好转后再次恶化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецидив",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "обострение",
                                "target_lang_sense_clarification": "ухудшение симптомов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复发",
                                "target_lang_sense_clarification": "医学术语，指疾病再次出现"
                            },
                            {
                                "target_lang_word": "病情恶化",
                                "target_lang_sense_clarification": "指健康状况变差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8b2feed-b98b-37db-819c-afaad8e41052",
                    "sense_definition": "A return to a former bad state or practice, especially the use of drugs or alcohol after a period of abstinence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavioral_relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After three years of sobriety, he experienced a brief <w>relapse</w>.",
                            "target_lang_translations": {
                                "ru": "После трех лет трезвости у него произошел кратковременный <w>срыв</w>.",
                                "zh": "在戒酒三年后，他经历了一次短暂的<w>破戒</w>。"
                            }
                        },
                        {
                            "text": "Stress is a common trigger for a drug <w>relapse</w>.",
                            "target_lang_translations": {
                                "ru": "Стресс является частым провокатором <w>срыва</w> при наркозависимости.",
                                "zh": "压力是导致毒瘾<w>复发</w>的常见诱因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backsliding",
                        "regression"
                    ],
                    "antonyms": [
                        "rehabilitation",
                        "reform"
                    ],
                    "common_phrases": [
                        "drug relapse",
                        "risk of relapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возврат к прежнему плохому состоянию или привычке, особенно к употреблению наркотиков или алкоголя.",
                        "zh": "指重新陷入某种不良状态或恶习，尤指戒毒或戒酒后再次使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срыв",
                                "target_lang_sense_clarification": "разговорное, о зависимостях"
                            },
                            {
                                "target_lang_word": "рецидив",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复发",
                                "target_lang_sense_clarification": "指行为或习惯的反复"
                            },
                            {
                                "target_lang_word": "破戒",
                                "target_lang_sense_clarification": "指打破戒律或停止戒除某种行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                    "sense_definition": "To return to a worse state or bad habit after a period of improvement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavioral_relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to quit smoking for months but <w>relapsed</w> when work became stressful.",
                            "target_lang_translations": {
                                "ru": "Ей удавалось не курить несколько месяцев, но она <w>сорвалась</w>, когда на работе начался стресс.",
                                "zh": "她成功戒烟几个月了，但工作压力大时又<w>复发</w>了。"
                            }
                        },
                        {
                            "text": "Without a strong support system, it is easy to <w>relapse</w> into old habits.",
                            "target_lang_translations": {
                                "ru": "Без сильной системы поддержки легко <w>вернуться</w> к старым привычкам.",
                                "zh": "如果没有强大的支持系统，很容易<w>重蹈覆辙</w>，回到旧习惯中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backslide",
                        "regress",
                        "revert"
                    ],
                    "antonyms": [
                        "improve",
                        "reform"
                    ],
                    "common_phrases": [
                        "relapse into habits",
                        "relapse into silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться к худшему состоянию или вредной привычке после периода улучшения.",
                        "zh": "指在好转一段时间后，又重新回到糟糕的状态或恶习中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорваться",
                                "target_lang_sense_clarification": "о привычках или зависимости"
                            },
                            {
                                "target_lang_word": "вернуться к старому",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重蹈覆辙",
                                "target_lang_sense_clarification": "指重犯以前的错误"
                            },
                            {
                                "target_lang_word": "复发",
                                "target_lang_sense_clarification": "指习惯或行为的反复"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "675d63fd-dcda-33dd-90ce-5c6503ab5ec6",
                    "sense_definition": "To become ill again after a period of apparent recovery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_relapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infection seemed to clear up, but the patient <w>relapsed</w> a week later.",
                            "target_lang_translations": {
                                "ru": "Казалось, инфекция прошла, но неделю спустя у пациента <w>случился рецидив</w>.",
                                "zh": "感染似乎已经治愈，但一周后病人病情又<w>复发</w>了。"
                            }
                        },
                        {
                            "text": "If you stop taking the antibiotics too early, you might <w>relapse</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы прекратите прием антибиотиков слишком рано, может <w>случиться рецидив</w>.",
                                "zh": "如果你过早停用抗生素，病情可能会<w>复发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worsen",
                        "deteriorate"
                    ],
                    "antonyms": [
                        "recover",
                        "heal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заболеть снова после периода кажущегося выздоровления.",
                        "zh": "指在看似康复后再次患病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецидивировать",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "обостряться",
                                "target_lang_sense_clarification": "о болезни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复发",
                                "target_lang_sense_clarification": "指疾病再次发作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95248385-1dd6-3dd0-a3a3-72a3f084b111",
                    "sense_definition": "To slip or slide back physically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber lost his footing and <w>relapsed</w> down the slope.",
                            "target_lang_translations": {
                                "ru": "Альпинист потерял опору и <w>соскользнул</w> вниз по склону.",
                                "zh": "登山者脚下一滑，顺着斜坡<w>滑落</w>了下去。"
                            }
                        },
                        {
                            "text": "He tried to stand but <w>relapsed</w> onto the couch in exhaustion.",
                            "target_lang_translations": {
                                "ru": "Он попытался встать, но в изнеможении <w>опустился обратно</w> на диван.",
                                "zh": "他试图站起来，但因精疲力竭又<w>跌回</w>了沙发上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slip",
                        "slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соскользнуть или сползти назад физически.",
                        "zh": "指身体向后滑落或跌落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соскользнуть",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "опуститься обратно",
                                "target_lang_sense_clarification": "на сиденье или кровать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑落",
                                "target_lang_sense_clarification": "指物理上的向下滑动"
                            },
                            {
                                "target_lang_word": "跌回",
                                "target_lang_sense_clarification": "指身体无力地倒回某处"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}