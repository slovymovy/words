{
    "word_family": [
        "disaster",
        "disastrously",
        "disastrousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36f98f6c-8256-396b-961b-99487434a3b2",
                    "sense_definition": "Causing great damage, loss, or misfortune; calamitous.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "calamitous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rains had a <w>disastrous</w> effect on the local farmers' crops this year.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди оказали <w>катастрофическое</w> влияние на урожай местных фермеров в этом году."
                            }
                        },
                        {
                            "text": "The company's decision to ignore the warnings led to a <w>disastrous</w> financial failure.",
                            "target_lang_translations": {
                                "ru": "Решение компании проигнорировать предупреждения привело к <w>плачевному</w> финансовому краху."
                            }
                        }
                    ],
                    "synonyms": [
                        "catastrophic",
                        "calamitous",
                        "ruinous",
                        "devastating"
                    ],
                    "antonyms": [
                        "fortunate"
                    ],
                    "common_phrases": [
                        "disastrous effect",
                        "disastrous consequences",
                        "disastrous failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причиняющий большой ущерб, потери или несчастья; имеющий характер катастрофы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катастрофический",
                                "target_lang_sense_clarification": "приводящий к катастрофе"
                            },
                            {
                                "target_lang_word": "бедственный",
                                "target_lang_sense_clarification": "связанный с бедствием"
                            },
                            {
                                "target_lang_word": "гибельный",
                                "target_lang_sense_clarification": "ведущий к гибели или краху"
                            },
                            {
                                "target_lang_word": "плачевный",
                                "target_lang_sense_clarification": "о крайне неудачном результате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9b3b43d-8c13-3f3e-b82b-8536bdfecab2",
                    "sense_definition": "Suggesting that a disaster is about to happen; ill-omened or foreboding.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "foreboding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor looked at the <w>disastrous</w> stars, fearing the storm that was surely coming.",
                            "target_lang_translations": {
                                "ru": "Моряк смотрел на <w>зловещие</w> звезды, опасаясь шторма, который неминуемо приближался."
                            }
                        },
                        {
                            "text": "There was a <w>disastrous</w> silence in the room before the bad news was finally delivered.",
                            "target_lang_translations": {
                                "ru": "В комнате воцарилась <w>зловещая</w> тишина, прежде чем плохие новости были наконец объявлены."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominous",
                        "ill-omened",
                        "inauspicious",
                        "portentous"
                    ],
                    "antonyms": [
                        "auspicious"
                    ],
                    "common_phrases": [
                        "disastrous omen",
                        "disastrous sign"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a literary or historical context to mean ill-omened"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предвещающий беду или катастрофу; зловещий или предвещающий дурное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "предвещающий несчастье"
                            },
                            {
                                "target_lang_word": "пагубный",
                                "target_lang_sense_clarification": "несущий вред или разрушение"
                            },
                            {
                                "target_lang_word": "недобрый",
                                "target_lang_sense_clarification": "предвещающий плохое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}