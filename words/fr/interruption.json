{
    "word_family": [
        "interrompre",
        "interrupteur",
        "interruptif"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "508fd735-bc3f-3ffd-81d9-a0e2fd794eb4",
                    "sense_definition": "Action d'interrompre ou état de ce qui est interrompu ; arrêt temporaire ou définitif d'un processus continu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers travaillent depuis le matin sans la moindre <w>interruption</w>."
                        },
                        {
                            "text": "Une soudaine <w>interruption</w> de courant a plongé tout le quartier dans le noir."
                        }
                    ],
                    "synonyms": [
                        "arrêt",
                        "coupure",
                        "suspension",
                        "pause",
                        "rupture"
                    ],
                    "antonyms": [
                        "continuité",
                        "poursuite"
                    ],
                    "common_phrases": [
                        "sans interruption",
                        "interruption de service",
                        "interruption temporaire"
                    ]
                },
                {
                    "sense_id": "1440d8d3-f6e2-3469-a809-e232daae0570",
                    "sense_definition": "Fait de couper la parole à une personne qui s'exprime.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a continué son exposé malgré les nombreuses <w>interruptions</w> du public."
                        },
                        {
                            "text": "Veuillez m'excuser pour cette <w>interruption</w>, mais une annonce importante doit être faite."
                        }
                    ]
                },
                {
                    "sense_id": "3ed44e23-f448-3e06-8b32-41f596891fa6",
                    "sense_definition": "En informatique, signal envoyé au processeur suspendant temporairement l'exécution du programme en cours.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>interruption</w> matérielle permet au clavier de signaler immédiatement une frappe de touche."
                        },
                        {
                            "text": "Le processeur traite cette <w>interruption</w> prioritaire avant de reprendre la tâche principale."
                        }
                    ],
                    "common_phrases": [
                        "interruption matérielle",
                        "interruption logicielle"
                    ]
                },
                {
                    "sense_id": "357acff6-5219-30d8-83ba-e6acdecb4706",
                    "sense_definition": "En rhétorique, figure consistant à suspendre ou briser le fil de son discours pour marquer une émotion vive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a utilisé une habile <w>interruption</w> pour émouvoir et captiver son auditoire."
                        },
                        {
                            "text": "Cette soudaine <w>interruption</w> dans son plaidoyer traduisait un profond trouble feint."
                        }
                    ],
                    "synonyms": [
                        "aposiopèse",
                        "réticence"
                    ]
                }
            ]
        }
    ]
}