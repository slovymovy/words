                    {
                        "translation_id": "a18c88e5-9576-4558-a320-5af459699f6c",
                        "source_entry_id": "ed539da9-5898-3cb5-850d-0decb998034b",
                        "target_lang_word": "Atonalität",
                        "target_lang_code": "de",
