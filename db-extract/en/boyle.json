                        "examples": [
                            {
                                "example_id": "edf9e1fc-7051-47f5-890b-ff19304e25e7",
                                "sense_id": "59e661f7-4fce-38bf-b75d-3e8d17b230f4",
                                "text": "... a boyle or impostume comen forthe & broken"
                            },
                            {
                                "example_id": "b6400094-cd42-43e2-9b6c-972ceab5c328",
                                "sense_id": "59e661f7-4fce-38bf-b75d-3e8d17b230f4",
                                "text": "And they toke it, and layed it on the boyle, and he recouered."
                            },
                            {
                                "example_id": "ce53efbb-b60b-41b1-9dc8-bf16f4caf21a",
                                "sense_id": "59e661f7-4fce-38bf-b75d-3e8d17b230f4",
                                "text": "And they took ashes of the fornace, and stoode before Pharaoh , and Moses sprinkled it toward heauen: and it became a boyle breaking forth with blaynes, upon man, and upon beast."
                            }
                        ]
                    }
