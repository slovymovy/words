                "forms": [
                    {
                        "form_id": "972f02d0-c647-46e9-99e0-b62138a4a190",
                        "entry_id": "1619b5ad-ae3d-3e11-a78d-967c82d74ce6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more energized"
                    },
                    {
                        "form_id": "b4d1e718-0ce7-40ff-ac5c-667cb2a68421",
                        "entry_id": "1619b5ad-ae3d-3e11-a78d-967c82d74ce6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most energized"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7054ef4b-ec67-3f90-8f70-188e88022fa6",
                        "entry_id": "1619b5ad-ae3d-3e11-a78d-967c82d74ce6",
                        "glosses": [
                            "Electrically charged; live."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ea044a-cedc-4fb6-9840-765dd274c38b",
                                "sense_id": "7054ef4b-ec67-3f90-8f70-188e88022fa6",
                                "text": "Because of the high level of hazard, work on energized equipment shall be strenuously avoided."
                            },
                            {
                                "example_id": "1e4510aa-afad-4d78-b651-a7b1ede1769a",
                                "sense_id": "7054ef4b-ec67-3f90-8f70-188e88022fa6",
                                "text": "No work should be performed near energized conductors until danger of contact with those conductors has been effectively guarded against."
                            },
                            {
                                "example_id": "c1edd234-d67d-4dc7-b636-8c9b98083872",
                                "sense_id": "7054ef4b-ec67-3f90-8f70-188e88022fa6",
                                "text": "There are multiple ways to work on energized power lines safely; insulated bucket trucks, the use of fiber glass non-conductive hot sticks and bare hand live line maintenance are the more common means."
                            }
                        ]
                    },
                    {
                        "sense_id": "a48b37fe-b163-3126-b93e-4bd6f9c4c219",
                        "entry_id": "1619b5ad-ae3d-3e11-a78d-967c82d74ce6",
                        "glosses": [
                            "Full of energy, vitality, or enthusiasm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a604e849-e2cb-4b94-9d7d-02cc66439541",
                                "sense_id": "a48b37fe-b163-3126-b93e-4bd6f9c4c219",
                                "text": "Who are the people around you with whom you feel most energized?"
                            },
                            {
                                "example_id": "e753d420-823f-49b5-99cb-13b6ced14ca7",
                                "sense_id": "a48b37fe-b163-3126-b93e-4bd6f9c4c219",
                                "text": "He always cambe back very energized with this contact with ordinary working people who were progressive and on a revolutionary path."
                            },
                            {
                                "example_id": "f6306ced-850b-401f-b7ab-168d673479f4",
                                "sense_id": "a48b37fe-b163-3126-b93e-4bd6f9c4c219",
                                "text": "But mostly, I'd argue, it's because we will be more capable for longer, with more energized, active minds and bodies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
