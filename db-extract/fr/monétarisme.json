                ],
                "senses": [
                    {
                        "sense_id": "3d76f828-5090-302b-bd07-259d75eabab6",
                        "entry_id": "43da3e99-45c2-307f-b830-80e45e66fba2",
                        "glosses": [
                            "Doctrine économique pour laquelle l’action de l’État en matière monétaire est inutile voire nuisible et prônant l’indépendance absolue des banques centrales de l’État."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "8e5f2f9d-662b-4415-86a1-65d9f6a63724",
                                "sense_id": "3d76f828-5090-302b-bd07-259d75eabab6",
                                "text": "Déjà en couronnant Sen, puis Stiglitz, puis Krugman, le jury du Nobel d’économie avait montré qu’il tenait pour non pertinents les paradigmes et axiomes de Milton Friedman et du monétarisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b1e6f1f-9a89-4a49-a748-6586a299c93d",
                        "source_entry_id": "43da3e99-45c2-307f-b830-80e45e66fba2",
                        "source_sense_id": "3d76f828-5090-302b-bd07-259d75eabab6",
                        "target_lang_word": "monetarism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monetarism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b36ace5-d145-3dea-9adf-ddbb0f09190d",
                                        "entry_id": "d8185b0e-5839-3444-bb55-2b16927b8722",
                                        "glosses": [
                                            "The doctrine that economic systems are controlled by variations in the supply of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7b1e3c5-5fa1-3c6d-baf3-2fce27700213",
                                        "entry_id": "d8185b0e-5839-3444-bb55-2b16927b8722",
                                        "glosses": [
                                            "The political doctrine that a nation's economy (in particular inflation) can be controlled by regulating the money supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de052c6-21fc-4f24-9686-e8847c685aff",
                                                "sense_id": "d7b1e3c5-5fa1-3c6d-baf3-2fce27700213",
                                                "text": "Monetarism, you see, has two components. The first is that the central bank should try to control the money supply. In light of the Bank's report that part of the monetarist doctrine is now a dinosaur fit only to be displayed in the museum of failed economic ideas. […] Indeed, this second component of monetarism is one of the primary culprits behind the economic crisis that we have been living through for the past five years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
