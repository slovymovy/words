                        "examples": [
                            {
                                "example_id": "123ea287-08df-456f-8186-7f182ac41c63",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "Een chirurg heeft enkele tientallen patiënten besmet met hepatitis B."
                            },
                            {
                                "example_id": "bb373d1c-bfae-4c81-94b8-9d9fb2c7d27e",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "Niet iedereen die besmet wordt met de bacterie, wordt daadwerkelijk ziek."
                            },
                            {
                                "example_id": "b5142055-9dc6-46bd-84bc-0896cfadffeb",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "De kans dat er meer mensen worden besmet is erg klein."
                            },
                            {
                                "example_id": "c514701e-0c22-456d-95b7-b45bf62d98fb",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "Je kunt besmet raken door vlees rauw of onvoldoende verhit te eten."
                            },
                            {
                                "example_id": "2f3183fc-a0de-4358-9565-005d5fed6c12",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "De met H1N1 besmette studenten kregen te horen dat ze beter maar thuis konden blijven, omdat ze anders iedereen zouden aansteken."
                            },
                            {
                                "example_id": "51375aca-38b0-4228-8fc1-6003afc20b45",
                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                "text": "Hij is besmet met hiv."
                            }
                        ]
