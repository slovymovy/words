                "senses": [
                    {
                        "sense_id": "afe446b4-ceb9-3db0-aa73-3a46b951e7f9",
                        "entry_id": "97f05e4d-839d-38a4-bf23-10e2ef521f33",
                        "glosses": [
                            "мед., техн. аппарат для коагуляции тканей, применяемый при хирургических операциях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a38c90cc-5f1f-4e30-8631-477ba3df4453",
                                "sense_id": "afe446b4-ceb9-3db0-aa73-3a46b951e7f9",
                                "text": "Коагулятор офтальмологический предназначен для проведения лазеркоагуляции при лечении заболеваний глаза."
                            },
                            {
                                "example_id": "7d514af8-aa74-467d-a884-22fe60448f3e",
                                "sense_id": "afe446b4-ceb9-3db0-aa73-3a46b951e7f9",
                                "text": "Сварочный электрохирургический коагулятор предназначен для коагуляции (перекрытия) и резания (резекции) мягких тканей и кровеносных сосудов организма током высокой частоты при проведении операций в условиях больниц."
                            }
                        ]
                    }
