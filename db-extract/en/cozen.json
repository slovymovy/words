                                                "sense_id": "cedd5c11-59f2-3218-abd1-2bf32016911e",
                                                "text": "De handelaar bedroog zijn klanten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3bad866-8d81-3a54-8d18-1e56270f7a74",
                                        "entry_id": "6f44030b-2cd2-37e1-952a-f2b1ca46c434",
                                        "glosses": [
                                            "ontrouw zijn aan"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2342cbb9-316e-4b27-b558-5269792cef9b",
                                                "sense_id": "f3bad866-8d81-3a54-8d18-1e56270f7a74",
                                                "text": "De ontrouwe man bedroog zijn echtgenote."
                                            },
                                            {
                                                "example_id": "52b61691-07ce-47f5-9ec2-0baea2bdbcaa",
                                                "sense_id": "f3bad866-8d81-3a54-8d18-1e56270f7a74",
                                                "text": "Hij heeft me bedrogen, Chantal! Die smeerlap heeft me bedrogen met zijn secretaresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
