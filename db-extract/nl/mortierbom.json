                                "example_id": "44b1fc61-e535-49b4-ba72-624d28c7b34c",
                                "sense_id": "aedbd838-b1a8-3e83-adf1-e6a4503650c7",
                                "text": "Een man van 21 uit Zierikzee is ook aangeklaagd voor poging tot doodslag. Hij zou een mortierbom naar een Romeinse agent hebben gegooid."
                            },
                            {
                                "example_id": "e6df1d31-216d-4b1e-bb7a-fd47e6d84e26",
                                "sense_id": "aedbd838-b1a8-3e83-adf1-e6a4503650c7",
                                "text": "Vuurwerkexpert Ad Nieuwdorp van de Nationale Politie zegt dat een illegale mortierbom met 165 gram kruit, die hij wel tegenkomt, de kracht heeft van drie handgranaten."
                            }
                        ]
