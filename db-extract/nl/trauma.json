                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668baa05-a0f7-4f02-acc4-4e2c006613a9",
                                                "sense_id": "8603e9d8-70e3-3047-8d5b-04be7a4aa1e6",
                                                "text": "Shanks c'est un psychopathe avec un mode opératoire bien précis : il trauma des enfants dans des bars, les rends alcoolique et se casse"
                                            },
                                            {
                                                "example_id": "29c9d720-2e6e-4edf-9ed1-ec4eeae73921",
                                                "sense_id": "8603e9d8-70e3-3047-8d5b-04be7a4aa1e6",
                                                "text": "Je trauma le serveur en solo c trop grave"
                                            },
                                            {
                                                "example_id": "9226bdf6-6ad7-4140-b088-a04711560d01",
