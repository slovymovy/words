                ],
                "senses": [
                    {
                        "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                        "entry_id": "3bfa68b1-5bbe-3492-ad1d-0bf773d745ad",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a816b3-5ee6-4227-baf4-130a0b82b26e",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Frau Kriegbaum ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0e66ca77-de55-49c7-b71f-6034d450a98d",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Herr Kriegbaum wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a358535c-8f44-46d7-8e71-7b5203750093",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Die Kriegbaums fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cd19607e-9f5a-435f-a747-b5f61bc1b750",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Der Kriegbaum trägt nie die Schals, die die Kriegbaum ihm strickt."
                            },
                            {
                                "example_id": "3a059e4a-a95d-4886-81ea-f725a7958c13",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kriegbaum kommt, geht der Herr Kriegbaum.“"
                            },
                            {
                                "example_id": "78e7f71c-1a5f-4a5c-9140-b77f34884e66",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Kriegbaum kommt und geht."
                            },
                            {
                                "example_id": "b608824e-6214-40bf-8f6b-d95cfdbe8ee5",
                                "sense_id": "c593f691-c64d-34ea-b90b-b719b91a3573",
                                "text": "Kriegbaums kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
