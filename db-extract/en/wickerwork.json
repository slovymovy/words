                    },
                    {
                        "translation_id": "876d3096-8fd7-4d96-b37d-476c68a1d814",
                        "source_entry_id": "168d9ddc-1412-3f72-8a3c-865c66d24820",
                        "source_sense_description": "things made of wicker",
                        "target_lang_word": "vannerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vannerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b235750d-98c6-32ff-a3c4-5f01d37d7b01",
                                        "entry_id": "9c5ac9f5-a915-3baf-91b6-135d0c0921c6",
                                        "glosses": [
                                            "Art du vannier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a6c1f11-6d91-4582-abfe-9de1c0a25182",
                                                "sense_id": "b235750d-98c6-32ff-a3c4-5f01d37d7b01",
                                                "text": "N'oublions pas de mentionner ici l’osier qui croit dans quelques parties du centre et du sud-est du département ; […]. On l'utilise dans le pays de Vouziers pour la vannerie."
                                            },
                                            {
                                                "example_id": "b180a688-d765-4609-ab92-9eed575cf437",
                                                "sense_id": "b235750d-98c6-32ff-a3c4-5f01d37d7b01",
                                                "text": "Il a posé sur ses genoux un panier d’un très beau travail de vannerie qui contient des œufs durs, porte des sandales de paille et des braies de paysans toutes reprisées auxquelles les lessives ont donné une belle teinte aubergine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef010a3-65de-365f-8ca7-bda548a30105",
                                        "entry_id": "9c5ac9f5-a915-3baf-91b6-135d0c0921c6",
                                        "glosses": [
                                            "Matériau utilisé par le vannier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fc7e668-83a2-3e59-abbb-5239b1225afc",
                                        "entry_id": "9c5ac9f5-a915-3baf-91b6-135d0c0921c6",
                                        "glosses": [
                                            "Marchandise fabriquée par le vannier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda3e816-eae6-4072-9bb8-b7e5092b2500",
                                                "sense_id": "5fc7e668-83a2-3e59-abbb-5239b1225afc",
                                                "text": "Les roseaux furent exploités jusque vers 1960, pour les confections de vannerie. Appelés « glageots » en patois local ils permettaient de fabriquer les « banses » ou paniers utilisés pour le ramassage des pommes de terre à la Verte Rue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
