                "senses": [
                    {
                        "sense_id": "56496456-83a9-3c7a-8115-cb51d4bd15e2",
                        "entry_id": "252c4d62-e099-3ee0-97b3-b9462d1f026d",
                        "glosses": [
                            "een zeer grote en uitgebreide brand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b795d96-91ef-4428-b676-eb6906a509b8",
                                "sense_id": "56496456-83a9-3c7a-8115-cb51d4bd15e2",
                                "text": "Het vliegtuig dat maandag neerstortte in Colombia had te weinig brandstof aan boord. Dat blijkt volgens persbureau AP uit geluidsopnames die in de zwarte dozen van het toestel zijn teruggevonden. Bij de ramp kwamen 71 mensen om het leven, onder wie bijna een heel Braziliaans voetbalteam. De piloot waarschuwde luchtverkeersleiders kort voor de crash voor een tekort aan brandstof. Hij vroeg herhaaldelijk toestemming om te landen vanwege een „volledige elektrische storing” en een brandstoftekort. Op de geluidsband is ook een vrouwelijke luchtverkeersleider te horen die instructies geeft aan de piloot. Toen had het vliegtuig al veel snelheid verloren. De opnames bevestigen het verslag van een overlevende. Ook verklaart een gebrek aan brandstof het uitblijven van een vuurzee na de crash. (NRC)"
                            },
                            {
                                "example_id": "3002639f-1566-4798-a7ab-f2a3d1e5197a",
                                "sense_id": "56496456-83a9-3c7a-8115-cb51d4bd15e2",
                                "text": "Tijdens het eten van mijn pastaprutje transformeerde de lucht tot een oranje vuurzee door de ondergaande zon."
                            }
                        ]
                    }
