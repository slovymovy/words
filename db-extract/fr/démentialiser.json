                "senses": [
                    {
                        "sense_id": "748b01b4-7f81-33d1-8c4f-7b8a84217505",
                        "entry_id": "6cc48668-9cc3-31d8-a460-cef654cdc307",
                        "glosses": [
                            "Donner un caractère démentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0edc2bff-7b5e-4030-9b22-afe944777328",
                                "sense_id": "748b01b4-7f81-33d1-8c4f-7b8a84217505",
                                "text": "Le troisième ensemble de signes est une inhibition de la pensée, et l’on pourrait supposer, dans un certain nombre de cas, que la personne en face de soi est débilisée, voire démentialisée."
                            },
                            {
                                "example_id": "5e5ddf14-b1c7-41ba-bbee-404b19a0c560",
                                "sense_id": "748b01b4-7f81-33d1-8c4f-7b8a84217505",
                                "text": "Ca y est, tu t'es décidé à démentialiser ta Supernova ?"
                            },
                            {
                                "example_id": "39f0fbcb-c543-4b87-8b6a-1a3e4eee360a",
                                "sense_id": "748b01b4-7f81-33d1-8c4f-7b8a84217505",
                                "text": "P. CHANOIT transforma le pavillon des malades grabataires démentialisés, qu'on appelait « la communauté » en souvenir des anciennes religieuses hospitalières, en un pavillon de malades entrants éthyliques, utilisant en particulier à leur égard des techniques thérapeutiques fondées sur la dynamique de groupe."
                            }
                        ]
                    }
