                                "example_id": "fd04307f-f40c-4147-a640-58d577700bb6",
                                "sense_id": "6b93103f-347c-3832-abb9-36a2bdd5f791",
                                "text": "J’ai cru ne jamais pouvoir réapercevoir ne serait-ce qu’un petit bout de tes photos si spéciales !"
                            },
