                            {
                                "example_id": "4b7051db-23b4-42f1-98ac-3c7093acf9e7",
                                "sense_id": "d6cfbc20-7830-3ac4-9f1c-bf18fb4d91bd",
                                "text": "He is making megabucks with his business venture."
                            },
                            {
                                "example_id": "9d175c68-1fb1-4448-ab72-c3c89d9d3801",
                                "sense_id": "d6cfbc20-7830-3ac4-9f1c-bf18fb4d91bd",
                                "text": "Years later I went to see The Wall; it was a great show with megabucks spent on the production, but it didn't have that basic essence, there was a lack of theatre."
                            },
                            {
                                "example_id": "6607fa72-fbf4-4aac-8acd-7665aa89d101",
                                "sense_id": "d6cfbc20-7830-3ac4-9f1c-bf18fb4d91bd",
                                "text": "To anyone observing the state of cinema in 2023, it should be a point of utmost clarity that the might of these megabucks companies can do nothing but crush the smaller people."
                            }
                        ]
