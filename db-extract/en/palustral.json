                "senses": [
                    {
                        "sense_id": "a4370794-cc44-3c64-ae02-0fc540e8d5d6",
                        "entry_id": "974c3ace-665a-31ff-9bcc-e8573cafe3d0",
                        "glosses": [
                            "Pertaining to or located in marshes; marshy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fae07eb-b13e-45db-bdf6-21397ab82bbc",
                                "sense_id": "a4370794-cc44-3c64-ae02-0fc540e8d5d6",
                                "text": "The insects are scant, skinny. / In these palustral homes we only / Croak and wither."
                            },
                            {
                                "example_id": "4643f7d2-21a7-43bf-ab5b-86a990c0c25d",
                                "sense_id": "a4370794-cc44-3c64-ae02-0fc540e8d5d6",
                                "text": "Its archaic handsomeness, nemoral and chthonic, is the palustral involution of the vagina folded out and distended, cave become tower, as elegant a morphology as the spreading of the conifer leaf into oak and elm."
                            }
                        ]
                    },
                    {
                        "sense_id": "74d48060-ca85-3238-8c86-66c24703d751",
                        "entry_id": "974c3ace-665a-31ff-9bcc-e8573cafe3d0",
                        "glosses": [
                            "That requires a marshy habitat."
                        ],
                        "tags": [
                            "of a plant"
                        ],
                        "examples": [
                            {
                                "example_id": "4cf4ff7d-0b7d-4516-a2da-fcc28ac3c1ce",
                                "sense_id": "74d48060-ca85-3238-8c86-66c24703d751",
                                "text": "Telebasis salva is found in shallow waters containing palustral vegetation."
                            }
                        ]
                    }
                ],
                "translations": [
