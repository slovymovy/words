                "senses": [
                    {
                        "sense_id": "50acbfbc-ecd2-3a41-a8e0-aee0bd7c98ad",
                        "entry_id": "bcf46cec-1991-38d4-8ceb-dc69cdedd18d",
                        "glosses": [
                            "Uhr in der Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7408ad8-3d51-4337-8315-199a1c4e227d",
                                "sense_id": "50acbfbc-ecd2-3a41-a8e0-aee0bd7c98ad",
                                "text": "„‚Sie werden bald zurück sein‘, wusste sie und schielte voller Furcht zur Küchenuhr.“"
                            },
                            {
                                "example_id": "0d46d9cb-84b9-48d3-b6ae-1395358a7144",
                                "sense_id": "50acbfbc-ecd2-3a41-a8e0-aee0bd7c98ad",
                                "text": "„Langsam schlichen die Stunden dahin und wie im Schlafe nur rückte der Zeiger vor auf dem schadhaften Zifferblatte der Küchenuhr.“"
                            },
                            {
                                "example_id": "4ba32c8b-c99b-4267-be67-8a4ae2eaa9e9",
                                "sense_id": "50acbfbc-ecd2-3a41-a8e0-aee0bd7c98ad",
                                "text": "„Die alte Küchenuhr scheint nie einen Fleck zu kennen; die Tische, Stühle und das verschiedene Küchengerät scheinen nie außer Ordnung zu sein, obgleich 3 und manchmal 4 Mahlzeiten des Tages hier bereitet werden, obgleich das Waschen und Plätten der Familie hier verrichtet wird, und obgleich viele Pfunde Butter und Käse hier in einer stillen und geheimnisvollen Weise bereitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
