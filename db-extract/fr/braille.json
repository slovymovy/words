                                "example_id": "4c424f74-c924-4988-a556-23bcad4f1ae1",
                                "sense_id": "08ab7b83-9295-3b4f-b68b-29bcc7218afa",
                                "text": "Contrairement aux écritures visuelles, le braille se lit avec les doigts."
                            },
                            {
                                "example_id": "b4d244a1-13c8-4d9f-8fe0-a2d418be3556",
                                "sense_id": "08ab7b83-9295-3b4f-b68b-29bcc7218afa",
                                "text": "Il est à regretter également le retard pris dans la connaissance et la diffusion du braille pour les personnes non voyantes ou mal voyantes."
                            }
                        ]
