                                        "sense_id": "7a0bce4b-6398-3ba1-a0df-ce1382927e24",
                                        "entry_id": "6d6799e5-5976-37b8-acc2-3d17d68ab898",
                                        "glosses": [
                                            "In a cheeky or impudent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72e97e85-ecb7-4abe-94f3-7c1242bf20e7",
                                                "sense_id": "7a0bce4b-6398-3ba1-a0df-ce1382927e24",
                                                "text": "The time passed. The two mice, careering wildly, scampered cheekily over his slippers. He had not moved a muscle."
                                            },
                                            {
                                                "example_id": "5a116426-bd97-4e33-9a71-a4e6b3820a3b",
                                                "sense_id": "7a0bce4b-6398-3ba1-a0df-ce1382927e24",
                                                "text": "Now, Vimeo user Alejandro Prullansky has compiled a super cut of Anderson's slo-mo shots from across the director's filmography, charmingly – and maybe a tad cheekily – set to The Shins' \"New Slang.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59b66df7-69a6-44c6-8d8f-109fa723c78c",
