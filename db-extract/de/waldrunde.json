                "senses": [
                    {
                        "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                        "entry_id": "3db9ad9f-3954-3214-b03f-f5f69767d4cc",
                        "glosses": [
                            "Rundweg, der im oder durch den Wald führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c401554-f788-426f-9b2f-1d4d53aae8ce",
                                "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                                "text": "„Bei den gleichalterigen Jungs gingen 23 Läufer auf die zwei Waldrunden.“"
                            },
                            {
                                "example_id": "19da9e20-3c0d-4ef4-b554-178e00125079",
                                "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                                "text": "„Auf gut ausgebautem Forstweg dreht man dann eine große Waldrunde durch das Bocksiek.“"
                            },
                            {
                                "example_id": "a49bc5f9-087e-4019-9cb1-52acda13be2a",
                                "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                                "text": "„Die Waldrunde (7,3 km, mit grünem Punkt markiert) verläuft von Johannisberg im Elsterbachtal zum Kloster Marienthal und von dort durch Wald und Weinberge nach Johannisberg zurück.“"
                            },
                            {
                                "example_id": "9bdcceaa-fd3c-4543-882c-9ebee8d09c71",
                                "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                                "text": "„Wir gingen wieder die lange Waldrunde spazieren.“"
                            },
                            {
                                "example_id": "f4f3a6a6-c04a-4604-8e3b-cb4cc7f5eb27",
                                "sense_id": "d45fa384-e340-3032-8bf1-b0790fdc55f0",
                                "text": "„Die Waldrunde führte uns am Jugendwaldheim vorbei in Richtung der Wald-Kita Eulennest und dann ging es in einem grossen Bogen weiter in den Wald hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
