                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5719fdef-43e7-4bd4-877e-fe7072ba03d1",
                                "sense_id": "629d1609-c6e6-330b-a0ac-1f782499d839",
                                "text": "\"A latent print on the palmar surface of our hands and the plantar surfaces of our foot is a scan that is entirely different from the scan on the rest of our bodies."
                            }
                        ]
                    },
                    {
                        "sense_id": "004e4741-e965-36f6-a4eb-8495f8809bdf",
