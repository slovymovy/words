                "senses": [
                    {
                        "sense_id": "07524d9f-fc19-336e-9f8f-ca6408c546d7",
                        "entry_id": "9393f71e-b38c-30ea-a0d4-7f886a371ccb",
                        "glosses": [
                            "Glas für Martini"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0d588b-a67e-4a83-aa54-8ae9bd7ec35e",
                                "sense_id": "07524d9f-fc19-336e-9f8f-ca6408c546d7",
                                "text": "„Er ließ sein Martiniglas fallen.“"
                            },
                            {
                                "example_id": "f69fbbf3-d602-4b49-bbeb-edac8fe27613",
                                "sense_id": "07524d9f-fc19-336e-9f8f-ca6408c546d7",
                                "text": "„In der einen Hand hatte er ein Martiniglas und mit der anderen winkte er, als wolle er ein Taxi rufen.“"
                            },
                            {
                                "example_id": "aba9f833-4832-4031-a6dd-2f5eae0d8ca9",
                                "sense_id": "07524d9f-fc19-336e-9f8f-ca6408c546d7",
                                "text": "„Die Schuhe hat sie auf den heruntergeklappten Toilettendeckel gestellt, neben ihr Martiniglas mit Grenadine, zerstoßenem Eis, Puderzucker und weißem Rum.“"
                            },
                            {
                                "example_id": "0466c2b8-8e18-4495-ab5a-f5b2e5e0e9bb",
                                "sense_id": "07524d9f-fc19-336e-9f8f-ca6408c546d7",
                                "text": "„In der einen Hand hielt sie den Türgriff, in der anderen ein halbvolles, konisches Martiniglas mit einer Olive darin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
