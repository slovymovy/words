                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80f46af-566d-4899-a6e2-2e0e5c8d657a",
                                                "sense_id": "4aa8f61e-b883-3ac7-a7cd-b639f3e4e345",
                                                "text": "Stop linking those unfunny comics all the time!"
