        "fr-extract.jsonl": [
            {
                "entry_id": "f0c31f3a-e359-396f-8f26-599a3ad670b2",
                "word": "solvant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f73c2e4-b8e9-4e09-92d6-13072bf963dd",
                        "entry_id": "f0c31f3a-e359-396f-8f26-599a3ad670b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "solvants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4d21ca3-8a32-3a1a-bd75-e75bb78abf1d",
                        "entry_id": "f0c31f3a-e359-396f-8f26-599a3ad670b2",
                        "glosses": [
                            "Liquide ou agent qui a la propriété de dissoudre et de diluer d'autres substances (solides, liquides ou gazeuses), c'est-à-dire former une phase homogène avec ce même solvant, sans les modifier chimiquement et sans lui-même se modifier ; l’ensemble formant une solution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c26a5f56-7c1f-4071-9e07-67e9fafa86ca",
                                "sense_id": "b4d21ca3-8a32-3a1a-bd75-e75bb78abf1d",
                                "text": "L'eau est un solvant très utilisé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46cd6b14-9535-4838-851e-26d132a32309",
                        "source_entry_id": "f0c31f3a-e359-396f-8f26-599a3ad670b2",
                        "source_sense_id": "b4d21ca3-8a32-3a1a-bd75-e75bb78abf1d",
                        "target_lang_word": "Lösungsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lösungsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                        "entry_id": "f95401cf-6a17-3a96-a440-32c670c6a61f",
                                        "glosses": [
                                            "organische oder anorganische Flüssigkeit, in der ein Stoff aufgelöst wird oder die einen Stoff auflösen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e15ee4d-77b7-4cdc-a13d-5422c24aa6b7",
                                                "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                                "text": "Eine Brechstange ist manchmal eine profanes Lösungsmittel, jedoch hat es mit dem eigentlich Wortsinn nichts gemein."
                                            },
                                            {
                                                "example_id": "3922fd6c-d034-4149-89f7-7c16bd85f529",
                                                "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                                "text": "„Als Lösungsmittel bezeichnet man Flüssigkeiten, die andere Stoffe lösen können, ohne sie chemisch zu verändern.“"
                                            },
                                            {
                                                "example_id": "e24c800d-c572-4f40-be84-67e96b556653",
                                                "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                                "text": "„Lösungsmittel können ohne chemische Reaktion Gase, Flüssigkeiten oder Feststoffe lösen.“"
                                            },
                                            {
                                                "example_id": "25e6d11b-1138-40bc-93cb-f07c10f26a34",
                                                "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                                "text": "„Die ionische Struktur der Zwischenstufe bzw. die partielle Ladungstrennung im Übergangszustand sind durch polare und protische Lösungsmittel gut stabilisiert.“"
                                            },
                                            {
                                                "example_id": "a43ded89-cdb3-4997-aca7-a323a4784d77",
                                                "sense_id": "478c7f42-7daf-3a7d-aacb-beb9bdc469d6",
                                                "text": "„Vermeiden Sie alle Zündquellen bei der Arbeit, denn Lösungsmittel sind meist brennbar oder sogar explosiv!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e70e161c-0bf6-49ba-843f-6eba6bbb5218",
                        "source_entry_id": "f0c31f3a-e359-396f-8f26-599a3ad670b2",
                        "source_sense_id": "b4d21ca3-8a32-3a1a-bd75-e75bb78abf1d",
                        "target_lang_word": "Lösemittel",
