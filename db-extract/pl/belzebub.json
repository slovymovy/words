                    {
                        "sense_id": "a5471af1-0aa4-302d-a3fc-3c5053356c4a",
                        "entry_id": "aa076d1a-4f70-30a8-ad3d-8e4a72106099",
                        "glosses": [
                            "w chrześcijaństwie: demon, władca piekieł i złych duchów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8ce1e9-7f4d-4745-a8c0-5db860adb285",
                                "sense_id": "a5471af1-0aa4-302d-a3fc-3c5053356c4a",
                                "text": "Lecz niektórzy z nich rzekli: «Przez Belzebuba, władcę złych duchów, wyrzuca złe duchy»."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
