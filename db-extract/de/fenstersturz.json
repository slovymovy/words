                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbde3228-fae4-42e3-b3cb-bc335620d8ba",
                                "sense_id": "e3fd4f68-e588-3c17-b7ca-9859db91116e",
                                "text": "\"Ein Sturz wird je nach Maueröffnung als Türsturz oder Fenstersturz bezeichnet.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "395602dd-6d76-3f7f-81cc-6eb086683f77",
                        "entry_id": "45af5143-cb17-3f04-a298-a0b611ca0e1b",
                        "glosses": [
                            "Herabfallen eines Körpers aus dem Fenster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f07ab65-1e1f-4491-b75a-e12527a84000",
                                "sense_id": "395602dd-6d76-3f7f-81cc-6eb086683f77",
                                "text": "Der Zweite Prager Fenstersturz ereignete sich am 23. Mai 1618, wo zwei königlich-habsburgische Statthalter aus einem Fenster der Prager Burg geworfen wurden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
