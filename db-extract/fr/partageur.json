                        ]
                    },
                    {
                        "sense_id": "c0a4f456-33fd-32c4-a014-b11656271893",
                        "entry_id": "f6f662a4-8281-3132-84d1-93d67bec4901",
                        "glosses": [
                            "Partisan du partage des terres, de la communauté des biens, partageux."
                        ],
                        "tags": [],
