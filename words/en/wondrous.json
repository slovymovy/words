    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e0302df-61f2-3c05-9ce1-6306a1775ec1",
                    "sense_definition": "Wonderful; amazing, inspiring awe; marvelous.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "amazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all stared open-mouthed at the <w>wondrous</w> sight.",
                            "target_lang_translations": {
                                "nl": "We staarden allemaal met open mond naar het <w>wonderbaarlijke</w> schouwspel."
                            }
                        },
                        {
                            "text": "The travelers witnessed a <w>wondrous</w> sunset over the mountains.",
                            "target_lang_translations": {
                                "nl": "De reizigers waren getuige van een <w>prachtige</w> zonsondergang boven de bergen."
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome"
                    ],
                    "common_phrases": [
                        "wondrous sight",
                        "wondrous beauty"
                    ],
                    "target_lang_definitions": {
                        "nl": "Prachtig, verbazingwekkend; ontzag inboezemend; wonderbaarlijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wonderbaarlijk",
                                "target_lang_sense_clarification": "Iets dat zo mooi of bijzonder is dat het bijna als een wonder voelt."
                            },
                            {
                                "target_lang_word": "prachtig",
                                "target_lang_sense_clarification": "Algemeen woord voor iets dat zeer mooi of indrukwekkend is."
                            },
                            {
                                "target_lang_word": "schitterend",
                                "target_lang_sense_clarification": "Iets dat uitblinkt in schoonheid of kwaliteit."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9a378715-c4a3-304f-b8e2-2a7d3e2b2745",
                    "sense_definition": "In a wonderful degree; remarkably.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was <w>wondrous</w> wise for his age.",
                            "target_lang_translations": {
                                "nl": "De oude man was <w>wonderbaarlijk</w> wijs voor zijn leeftijd."
                            }
                        },
                        {
                            "text": "She felt <w>wondrous</w> happy after hearing the good news.",
                            "target_lang_translations": {
                                "nl": "Ze voelde zich <w>buitengewoon</w> gelukkig na het horen van het goede nieuws."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wondrous wise",
                        "wondrous happy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "In een wonderbaarlijke mate; opmerkelijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wonderbaarlijk",
                                "target_lang_sense_clarification": "Op een manier die verbazing wekt door de mate waarin iets aanwezig is."
                            },
                            {
                                "target_lang_word": "buitengewoon",
                                "target_lang_sense_clarification": "Op een manier die ver boven het normale uitstijgt."
                            }
                        ]
                    }
                }
            ]
        }
    ]
