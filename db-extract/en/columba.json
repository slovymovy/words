                                    }
                                ]
                            },
                            {
                                "target_word": "Colombe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f46eb98-bed0-3d27-8e1f-dbd8a2095635",
                                        "entry_id": "0b2ac356-3dca-3e9b-b2e2-f162b2042b58",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0eae45-293e-4cb7-afbd-e49dbe9e5f37",
                                                "sense_id": "2f46eb98-bed0-3d27-8e1f-dbd8a2095635",
                                                "text": "Colombe a supposé que c’était ainsi que se dansait le kazatchok."
                                            },
                                            {
                                                "example_id": "563a922e-8c2d-45fd-bebb-ea89b9365a87",
                                                "sense_id": "2f46eb98-bed0-3d27-8e1f-dbd8a2095635",
                                                "text": "Colombe comprit tout de suite qu’elle s’entendrait avec le duc d’Aumale."
                                            },
                                            {
                                                "example_id": "f8accadc-113f-4e04-b742-bdc5adc90ff7",
                                                "sense_id": "2f46eb98-bed0-3d27-8e1f-dbd8a2095635",
                                                "text": "La collaboration avec le designeur « s’est très bien passée », se félicite Colombe Brossel, adjointe chargée de la propreté de l’espace public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85f64c1e-5a58-4614-9535-230069e81f91",
                        "source_entry_id": "90ed0084-4a15-3981-a1aa-0d0080017695",
