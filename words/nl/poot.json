                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tafel wiebelt omdat één <w>poot</w> korter is dan de andere.",
                            "target_lang_translations": {
                                "en": "The table wobbles because one <w>leg</w> is shorter than the others.",
                                "ru": "Стол шатается, потому что одна <w>ножка</w> короче других.",
                                "pl": "Stół się chwieje, ponieważ jedna <w>noga</w> jest krótsza od pozostałych.",
                                "de": "Der Tisch wackelt, weil ein <w>Bein</w> kürzer ist als die anderen.",
                                "fr": "La table vacille parce qu'un <w>pied</w> est plus court que les autres.",
                                "it": "Il tavolo traballa perché una <w>gamba</w> è più corta delle altre.",
                                "cs": "Stůl se kýve, protože jedna <w>noha</w> je kratší než ostatní.",
                                "tr": "Masa sallanıyor çünkü bir <w>ayağı</w> diğerlerinden daha kısa.",
                                "es": "La mesa se tambalea porque una <w>pata</w> es más corta que las otras.",
                                "zh": "桌子晃动是因为其中一条<w>腿</w>比其他的短。"
                            }
                        },
                        {
                            "text": "Hij lijmde de afgebroken <w>poot</w> weer aan de stoel.",
                            "target_lang_translations": {
                                "en": "He glued the broken <w>leg</w> back onto the chair.",
                                "ru": "Он приклеил сломанную <w>ножку</w> обратно к стулу.",
                                "pl": "Przykleił złamaną <w>nóżkę</w> z powrotem do krzesła.",
                                "de": "Er klebte das abgebrochene <w>Bein</w> wieder an den Stuhl.",
                                "fr": "Il a recollé le <w>pied</w> cassé à la chaise.",
                                "it": "Ha riattaccato con la colla la <w>gamba</w> rotta alla sedia.",
                                "cs": "Přilepil zlomenou <w>nohu</w> zpátky ke židli.",
                                "tr": "Kırılan <w>ayağı</w> tekrar sandalyeye yapıştırdı.",
                                "es": "Pegó la <w>pata</w> rota de nuevo a la silla.",
                                "zh": "他把断掉的椅子<w>腿</w>重新粘了回去。"
                            }
