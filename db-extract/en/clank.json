                                    {
                                        "sense_id": "c21f8d59-6340-36d0-b8a3-ad70b48e2c72",
                                        "entry_id": "0ae356c1-19a1-3717-bd2e-84f055bd5bea",
                                        "glosses": [
                                            "Produire un cliquetis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff85d225-affe-4c66-b1fc-91d5e0cd4ba7",
                                                "sense_id": "c21f8d59-6340-36d0-b8a3-ad70b48e2c72",
                                                "text": "Toute cette avalanche descendait avec une vitesse croissante sur le talus de la montagne, cliquetant comme de la grêle sur un toit."
                                            },
                                            {
                                                "example_id": "634d1988-f8f6-4292-bf4f-e8a16d9a83bf",
                                                "sense_id": "c21f8d59-6340-36d0-b8a3-ad70b48e2c72",
                                                "text": "Toutes les clés de la maison, des armoires et des coffres, cliquetaient autour de sa taille en un trousseau noué à sa ceinture."
                                            },
                                            {
                                                "example_id": "528925f3-dff2-42e8-9d64-929e6387a5c8",
                                                "sense_id": "c21f8d59-6340-36d0-b8a3-ad70b48e2c72",
                                                "text": "Ses ciseaux cliquetaient férocement."
                                            },
                                            {
                                                "example_id": "c1e9220e-76f2-414d-8dc2-9cc221e5f704",
                                                "sense_id": "c21f8d59-6340-36d0-b8a3-ad70b48e2c72",
                                                "text": "Il n’y avait pas alors de traitement de texte et les machines à écrire cliquetaient avec entrain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
