                "senses": [
                    {
                        "sense_id": "91dd2dc3-a55f-39eb-8884-caeed41e2881",
                        "entry_id": "4a9a9b19-abee-35cd-9584-8f6b377c49c6",
                        "glosses": [
                            "D’après les procédés de la typographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b8c9f3-c4c3-4349-9038-2ca6d6785891",
                                "sense_id": "91dd2dc3-a55f-39eb-8884-caeed41e2881",
                                "text": "Dès 1490, la musique fut imprimée typographiquement, ainsi qu’on le voit par le Psautier imprimé à Mayence en 1490, où deux sortes de plain-chant, grand et petit, ont les notes imprimées en noir, et les portées ou lignes, en rouge, au moyen d’un second tirage."
                            },
                            {
                                "example_id": "c06d5ed9-07d2-4c33-9543-2891924bf764",
                                "sense_id": "91dd2dc3-a55f-39eb-8884-caeed41e2881",
                                "text": "Chez d'autres, le manque d'habitude de lire typographiquement produit le même résultat; des fautes évidentes leur échappent sur trois épreuves, et ils les taxent de fautes typographiques."
                            }
                        ]
                    }
                ],
