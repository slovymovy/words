                    {
                        "translation_id": "cb2e1ecc-9ada-4c7f-8929-65e5571f5276",
                        "source_entry_id": "91270d79-f789-3390-9e60-43d24b6e9124",
                        "source_sense_id": "cd3ff323-52b3-330a-a132-86cf815040b2",
                        "target_lang_word": "airline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airline",
