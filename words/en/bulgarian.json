                {
                    "sense_id": "7c8e08e7-3b15-3718-bb2c-f4a228d21645",
                    "sense_definition": "The South Slavic language spoken primarily in Bulgaria.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning <w>Bulgarian</w> because she plans to move to Sofia next year.",
                            "target_lang_translations": {
                                "ru": "Она учит <w>болгарский</w>, потому что планирует переехать в Софию в следующем году.",
                                "zh": "她正在学习<w>保加利亚语</w>，因为她计划明年搬到索非亚。"
                            }
                        },
                        {
                            "text": "The <w>Bulgarian</w> language uses the Cyrillic alphabet which can be challenging for beginners.",
                            "target_lang_translations": {
                                "ru": "<w>Болгарский</w> язык использует кириллицу, что может быть непросто для начинающих.",
                                "zh": "<w>保加利亚语</w>使用西里尔字母，这对初学者来说可能很有挑战性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Bulgarian",
                        "fluent Bulgarian",
                        "learn Bulgarian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Южнославянский язык, на котором говорят преимущественно в Болгарии.",
                        "zh": "主要在保加利亚使用的南斯拉夫语支语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болгарский язык",
                                "target_lang_sense_clarification": "название языка"
