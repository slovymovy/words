                        "glosses": [
                            "Jean Piaget (1896–1980), Swiss developmental psychologist and philosopher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c5b295-43e7-49f5-95ab-1be42062b599",
                                "sense_id": "f3f63d64-0b19-349c-b2d8-9843b8b18f45",
                                "text": "Piaget² has conducted many careful studies on the evolution of games during childhood, and has suggested that moral behavior consists in a system of rules, and the essence of all morality is to be sought for in the respect which the individual acquires for these rules.³ Piaget thus equates morality, or ethical feeling and conduct, with the individual's attitude toward and practice of various rules. This perspective provides a rational basis for the analysis of moral schemes as games, and of moral behavior as the players’ actual conduct."
                            }
                        ]
