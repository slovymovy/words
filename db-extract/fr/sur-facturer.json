                "senses": [
                    {
                        "sense_id": "45e9000c-860d-3ad1-a566-e62c0873163a",
                        "entry_id": "d1692a0c-73db-37d6-b6dd-83945a04ca30",
                        "glosses": [
                            "Variante orthographique (nettement plus rare) de surfacturer (facturer à un prix supérieur au prix normal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a1fb73-6b14-40ea-8673-985237987063",
                                "sense_id": "45e9000c-860d-3ad1-a566-e62c0873163a",
                                "text": "Le problème est qu’il y a incitation à sur-facturer pour recevoir une subvention plus élevée (il y a aussi incitation à sous-facturer pour réduire le droit de douane)."
                            },
                            {
                                "example_id": "7d028a81-c62e-45d4-9786-ede80032c551",
                                "sense_id": "45e9000c-860d-3ad1-a566-e62c0873163a",
                                "text": "En effet, une partie importante du commerce est un commerce captif ; en d'autres termes, à l’intérieur d’un même groupe il suffit de sous-facturer les exportations ou de sur-facturer les importations afin de rapatrier des capitaux."
                            }
                        ]
                    }
