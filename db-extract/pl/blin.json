                "senses": [
                    {
                        "sense_id": "cc9156c9-d24e-3f92-9468-0947db55f199",
                        "entry_id": "0fe28337-e9ca-38d0-b853-c2ec894ca690",
                        "glosses": [
                            "podobne do naleśnika, typowe dla kuchni rosyjskiej, białoruskiej i ukraińskiej danie, smażone z ciasta z dodatkiem mąki gryczanej oraz drożdży"
