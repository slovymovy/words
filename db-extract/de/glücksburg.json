                        "examples": [
                            {
                                "example_id": "65c00aeb-acbd-4752-bc2a-c7e2aab7837e",
                                "sense_id": "5777781d-eb60-36b7-be20-1d5fbd130a39",
                                "text": "In Glücksburg findet alljährlich ein Triathlon statt."
                            },
                            {
                                "example_id": "8799bb42-730f-4e28-87f8-03b6c2a7d87d",
                                "sense_id": "5777781d-eb60-36b7-be20-1d5fbd130a39",
                                "text": "An das Glücksburg des 18. Jahrhunderts erinnert nicht mehr sehr viel."
                            },
                            {
                                "example_id": "6b9a6eea-bb03-4f8a-aa5c-1f3c469df74e",
                                "sense_id": "5777781d-eb60-36b7-be20-1d5fbd130a39",
                                "text": "Ich bin in Glücksburg geboren."
                            },
                            {
                                "example_id": "b11e3655-d8d8-4184-ac55-d24c15c9c6f9",
                                "sense_id": "5777781d-eb60-36b7-be20-1d5fbd130a39",
                                "text": "Ich habe in Glücksburg meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "81aa15b6-040a-454f-a337-1c796058c57f",
                                "sense_id": "5777781d-eb60-36b7-be20-1d5fbd130a39",
                                "text": "Nach Glücksburg führen viele Wege."
                            }
                        ],
