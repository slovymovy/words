                    "antonyms": [
                        "relatief"
                    ],
                    "common_phrases": [
                        "absolute waarde",
                        "absolute temperatuur"
                    ],
                    "target_lang_definitions": {
                        "en": "standing on its own, not compared with or dependent on something else",
                        "ru": "самостоятельный, не сравниваемый и не зависящий от чего-либо другого"
