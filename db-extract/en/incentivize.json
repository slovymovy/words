                        "source_sense_description": "to provide incentives for (a behavior or action)",
                        "target_lang_word": "begünstigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begünstigen",
