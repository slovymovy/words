                "senses": [
                    {
                        "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                        "entry_id": "21c0d7c2-711b-3ffd-94b8-2abde4cb762e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15087230-d86c-40c1-a0e6-324fe7125fb6",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Frau Merzenich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "82ded141-3b4a-49ac-b7ae-3eff1d145741",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Herr Merzenich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e9053ea1-57f5-4cb4-a81a-7ddc233b7458",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Die Merzenichs fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1e4c282b-0117-4e99-90b7-a0a8fbc489c3",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Der Merzenich trägt nie die Pullover, die die Merzenich ihm strickt."
                            },
                            {
                                "example_id": "edf82023-e9fa-49d4-b55a-64d397b82eae",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Merzenich kommt, geht der Herr Merzenich.“"
                            },
                            {
                                "example_id": "877fa0c3-8fb3-4e84-9786-2b62be7a7293",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Merzenich kommt und geht."
                            },
                            {
                                "example_id": "2ffe9cfa-dbb5-472d-a970-45f2840bb4c4",
                                "sense_id": "86374ce1-5137-3070-962e-82a855dda75f",
                                "text": "Merzenichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
