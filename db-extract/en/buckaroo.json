                "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                "word": "buckaroo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "afd8f29f-705e-4cbf-8877-59419dbfe919",
                        "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                        "tags": [
                            "plural"
                        ],
                        "form": "buckaroos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd9faeda-6116-3bf3-81ec-92f2b4e8ae3d",
                        "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                        "glosses": [
                            "A cowboy; specifically, a working cowboy who generally does not participate in rodeos."
                        ],
                        "tags": [
                            "US",
                            "also",
                            "attributive"
                        ],
                        "examples": [
                            {
                                "example_id": "884e7479-f8fd-4e5b-8b95-8e746a3a43c9",
                                "sense_id": "cd9faeda-6116-3bf3-81ec-92f2b4e8ae3d",
                                "text": "No thanks, cowboy. If I was to let every rodeo hand I pulled a bull off of buy me liquor, I'd have been an alcoholic long ago. Pullin' bulls off of you buckaroos is just my job. So save your money for your next entry fee, cowboy."
                            }
                        ]
                    },
                    {
                        "sense_id": "3450ed6a-0493-35c8-b72e-4b781f8406ca",
                        "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                        "glosses": [
                            "One who adopts a distinctive style of cowboy attire and heritage."
                        ],
                        "tags": [
                            "US",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e863376c-8d24-4e8c-86ab-410471d0dae4",
                                "sense_id": "3450ed6a-0493-35c8-b72e-4b781f8406ca",
                                "text": "Many cowboy poets have a buckaroo look and feel about them."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfa26723-979e-340f-b219-429debc7e71a",
                        "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                        "glosses": [
                            "A style of cowboy boot with a high heel tapered at the back."
                        ],
                        "tags": [
                            "US",
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3fb76c1e-84bb-38f5-a3c7-ac4d43b1d360",
                        "entry_id": "2be3d9c2-d828-33c3-b387-f006cd41cdb6",
                        "glosses": [
                            "A headstrong, reckless person; a hothead."
                        ],
                        "tags": [
                            "US",
                            "Western",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "78501749-0b4b-41e4-ba95-5ecca832aba1",
                                "sense_id": "3fb76c1e-84bb-38f5-a3c7-ac4d43b1d360",
                                "text": "Don’t run in looking for a fight like some kind of buckaroo."
                            }
                        ]
                    }
                ],
