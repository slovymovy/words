                    {
                        "translation_id": "4234b977-408c-45f0-8ba9-bc0e005207c8",
                        "source_entry_id": "0cf54833-7eda-37d0-a38b-58a4a327d817",
                        "source_sense_description": "city",
                        "target_lang_word": "Πειραιάς",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Πειραιάς",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "6268dd66-ebff-35b7-9331-05b647e34698",
                                        "entry_id": "69b7b9b5-6be2-3c86-8428-685148993acb",
                                        "glosses": [
                                            "επίνειο της Αθήνας, ιδρύθηκε στην αρχαία Ελλάδα ως λιμάνι της Αθήνας και αναδείχθηκε στο μεγαλύτερο λιμάνι της χώρας και ένα από τα σημαντικότερα της Μεσογείου"
                                        ],
                                        "tags": [
                                            "πόλη και λιμάνι"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43b9abe-18ba-4ef8-b76f-b78d1483fd92",
                                                "sense_id": "6268dd66-ebff-35b7-9331-05b647e34698",
                                                "text": "※ Πώς ήθελα να είχα ένα και δύο\nκαι τρία και τέσσερα παιδιά\nπου σαν θα μεγαλώσουν όλα\nνα γίνουν λεβέντες για χάρη του Πειραιά\nΌσο κι αν ψάξω, δεν βρίσκω άλλο λιμάνι\nτρελή να με ‘χει κάνει, όσο τον Πειραιά",
                                                "translation": "απόσπασμα του τραγουδιού «Τα παιδιά του Πειραιά» (Όσκαρ τραγουδιού για το 1960), στην ταινία «Ποτέ την Κυριακή» Μουσική, στίχοι: Μάνος Χατζιδάκις, ερμηνεία: Μελίνα Μερκούρη @youtube"
                                            },
                                            {
                                                "example_id": "fb8de203-8f96-4928-a018-61939fdb79c1",
                                                "sense_id": "6268dd66-ebff-35b7-9331-05b647e34698",
                                                "text": "※ Μα αν η δική σου η καρδιά / παίζει σαν θεατρίνα, / θα κλάψουνε τα μάτια μου, / κι η θάλασσα του Πειραιά / θα πνίξει την Αθήνα.",
                                                "translation": "τραγούδι Ο Πειραιώτης, στίχοι: Πυθαγόρας, σύνθεση: Γιώργος Κατσαρός, ερμηνεία: Τόλης Βοσκόπουλος, 1972"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
