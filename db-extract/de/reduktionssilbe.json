                "senses": [
                    {
                        "sense_id": "a34d7c15-38b1-357b-b4dc-554b3af2dfac",
                        "entry_id": "40434f76-3cc4-3cdd-8b30-96e91da4ee94",
                        "glosses": [
                            "eine unbetonte Nebensilbe, deren Gipfel ein Murmelvokal/Reduktionsvokal oder ein Sonant - aber kein Vollvokal - ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450993f7-5568-4ff7-a048-7e4b8736abd3",
                                "sense_id": "a34d7c15-38b1-357b-b4dc-554b3af2dfac",
                                "text": "„Zwar sind sie wie im Kernwortschatz überwiegend trochäisch, aber ohne die für den Kernwortschatz typische Reduktionssilbe als Ultima kommt offenbar eine flexionsmorphologisch vollständige Integration nicht in Gang.“"
                            },
                            {
                                "example_id": "682f0ce1-0be6-4f63-b6a2-8bd036131717",
                                "sense_id": "a34d7c15-38b1-357b-b4dc-554b3af2dfac",
                                "text": "„Vollsilben können den Wortakzent tragen, Reduktionssilben nicht. Da Wörter betonbar sein müssen, folgt, dass ein Wort aus mindestens einer Vollsilbe bestehen muss.“"
                            },
                            {
                                "example_id": "8153ecba-aa5d-45a1-b78d-83edacaa7e0f",
                                "sense_id": "a34d7c15-38b1-357b-b4dc-554b3af2dfac",
                                "text": "„Im Zuge der Synkopierungen ändert sich die prosodische Struktur der meisten mittelhochdeutschen Wörter derart, dass sie aus einer Folge von einer betonten Vollsilbe und einer unbetonten Reduktionssilbe bestehen.“"
                            },
                            {
                                "example_id": "46ab33ab-23d1-48e9-a7bd-09522be32d06",
                                "sense_id": "a34d7c15-38b1-357b-b4dc-554b3af2dfac",
                                "text": "„Langvokale kommen nur in Vollsilben, nie in Reduktionssilben vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
