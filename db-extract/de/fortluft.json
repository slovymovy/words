                ],
                "senses": [
                    {
                        "sense_id": "7d402e5d-f6d9-30b6-bb84-3087fae1fc15",
                        "entry_id": "ed19cf23-3664-3025-b26f-adf8a3793f28",
                        "glosses": [
                            "Luftstrom, der nach außen (in die Umgebung) geleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a9c82a-e8f1-471b-8a3b-75c1fb177df8",
                                "sense_id": "7d402e5d-f6d9-30b6-bb84-3087fae1fc15",
                                "text": "Die warme Abluft aus dem Gebäude wird durch einen Wärmetauscher geführt und dann als kühlere Fortluft in die Umgebung abgeleitet."
                            },
                            {
                                "example_id": "dfdaf796-eef6-49ba-b25a-1bea4f304133",
                                "sense_id": "7d402e5d-f6d9-30b6-bb84-3087fae1fc15",
                                "text": "„In KWL-Anlagen wird die Luft aus dem Bad, WC und der Küche abgesaugt und strömt durch eine Fortluft-Dachdurchführung nach außen.“"
                            },
                            {
                                "example_id": "ec6a3c11-4be9-4fb1-9924-25d2750fa4c1",
                                "sense_id": "7d402e5d-f6d9-30b6-bb84-3087fae1fc15",
                                "text": "„… der Abluftstrom, der nicht als Umluft in den Raum zurückgeführt, sondern direkt ins Freie geleitet wird. Geht keine Umluftmenge an das Lüftungszentralgerät zurück, wird die gesamte Abluftmenge zur Fortluft.“"
                            },
                            {
                                "example_id": "05d449de-0a93-474a-8fd1-449a17b2125f",
                                "sense_id": "7d402e5d-f6d9-30b6-bb84-3087fae1fc15",
                                "text": "„Es erfolgte keine radiologisch relevante Freisetzung von Tritium in die Raumluft, Fortluft und in das Abwasser (HT, HTO).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
