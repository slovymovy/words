                                        "sense_id": "95c603f0-05db-39f7-aab7-64cfd8b9a31a",
                                        "entry_id": "02c1957e-b7f6-3bea-bf30-ad2fecf3c46d",
                                        "glosses": [
                                            "Ensemble des textes législatifs et réglementaires d’un pays, d’un État, d’une nation ou d’un peuple qui traitent des crimes et des délits, et des peines infligées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e33db861-e41b-4b89-b9a9-b592766082aa",
                                                "sense_id": "95c603f0-05db-39f7-aab7-64cfd8b9a31a",
                                                "text": "Le jeune homme se dirigea donc vers le parc de Valfeuillu, distant de quelques pas seulement, et, peu soucieux de l’article 394 du Code pénal, il franchit le large fossé qui entoure la propriété de M. de Trémorel."
                                            },
                                            {
                                                "example_id": "bd6e7396-ac79-46cf-ba8b-f2d0c71bbbfd",
                                                "sense_id": "95c603f0-05db-39f7-aab7-64cfd8b9a31a",
                                                "text": "La Révolution abolit la peine du pilori que, quelques années plus tard, le Code pénal remplaça par celle de l’exposition."
                                            }
                                        ]
