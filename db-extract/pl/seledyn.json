                ],
                "senses": [
                    {
                        "sense_id": "6b8ea58d-3bae-3f08-9274-64b26cca62d3",
                        "entry_id": "bcfded8d-821f-3de9-b6b8-164873229f39",
                        "glosses": [
                            "blada, delikatna zieleń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d48239b-90da-48d1-9a57-7b2d09ddcf9a",
                                "sense_id": "6b8ea58d-3bae-3f08-9274-64b26cca62d3",
                                "text": "Mam do łazienki kafelki w dwóch różnych seledynach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c8b0a891-91f8-37dd-bcd3-c37a501e87e8",
                        "entry_id": "bcfded8d-821f-3de9-b6b8-164873229f39",
                        "glosses": [
                            "coś w kolorze seledynowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66a1a3ec-d3d8-4d5f-bd42-b9b7d6f62a01",
                                "sense_id": "c8b0a891-91f8-37dd-bcd3-c37a501e87e8",
                                "text": "Jak będziesz kupował farby, to weź któryś z seledynów."
                            },
                            {
                                "example_id": "6f696f55-8c0f-4656-a3f7-008300632ee1",
                                "sense_id": "c8b0a891-91f8-37dd-bcd3-c37a501e87e8",
                                "text": "Kasiu, nie koloruj listków różowym mazakiem, masz przecież seledyn."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
