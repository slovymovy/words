                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The present participle of 'vrijstaan', used to describe something standing freely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freestanding",
                                "target_lang_sense_clarification": "standing independently"
                            },
