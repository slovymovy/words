                "senses": [
                    {
                        "sense_id": "499d90b0-19a4-36e7-986b-809961f0e378",
                        "entry_id": "2d88fb28-3a23-359d-b69c-ed00b09b00b5",
                        "glosses": [
                            "Séparer des feuilles qui sont reliées entre elles et pliées en accordéon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80bac637-c01e-4ab7-90a0-845ab84a2757",
                                "sense_id": "499d90b0-19a4-36e7-986b-809961f0e378",
                                "text": "Pour les prestations de routage, l’administration privilégiera les entreprises de routage dont la capacité à rupter et à mettre sous pli sera d’au moins 200 000 enveloppes par jour."
                            },
                            {
                                "example_id": "1c8a6b0f-a88f-4e97-b940-511f3826c0e0",
                                "sense_id": "499d90b0-19a4-36e7-986b-809961f0e378",
                                "text": "Concrètement, pour certains mailings, il s’agira par exemple de transformer en feuilles des documents imprimés sur une bobine, de découper, de rupter et de « décaroller » – retirer la bande Caroll qui sert à maintenir le papier sur la chaîne de façonnage."
                            },
                            {
                                "example_id": "3445894d-8388-479e-bb28-216ae765276a",
                                "sense_id": "499d90b0-19a4-36e7-986b-809961f0e378",
                                "text": "Machines à rupter et à déliasser"
                            }
                        ]
                    },
                    {
                        "sense_id": "a56fe9de-674c-3bc0-aea0-c08cf21d43ed",
                        "entry_id": "2d88fb28-3a23-359d-b69c-ed00b09b00b5",
                        "glosses": [
                            "Rompre un contrat de travail ou d'apprentissage quel que soit le motif et la partie initiatrice (démission, licenciement, rupture à l'amiable ou rupture conventionnelle)."
                        ],
