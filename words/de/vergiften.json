                        "die Umwelt vergiften",
                        "das Trinkwasser vergiften"
                    ]
                },
                {
                    "sense_id": "2b840270-9692-3b32-8006-d6723b85baa2",
                    "sense_definition": "Eine zwischenmenschliche Beziehung, eine Stimmung oder das gesellschaftliche Klima nachhaltig zerstören.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ständige Lügen und Misstrauen können jede glückliche Beziehung auf Dauer <w>vergiften</w>."
                        },
                        {
                            "text": "Der Streit zwischen den beiden Kollegen <w>vergiftete</w> die Arbeitsatmosphäre im gesamten Büro."
