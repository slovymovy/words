                "senses": [
                    {
                        "sense_id": "72107126-e6c9-37ab-bf53-4fbb7e51705d",
                        "entry_id": "3e8c6c03-c910-3ea0-9f05-a91db4dc0e91",
                        "glosses": [
                            "die kontrollierte Vermehrung und Aufzucht von Hühnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbbee4b5-34eb-4987-a2ce-3e57d2d2db6b",
                                "sense_id": "72107126-e6c9-37ab-bf53-4fbb7e51705d",
                                "text": "„Als im 19. Jahrhundert die Hühnerzucht einen Aufschwung erfuhr und die schweren Hühnerrassen der Asiaten und Rassezüchtungen anderer Länder nach Deutschland kamen, wurde die Zucht neuer Rassen angestrebt.“"
                            },
                            {
                                "example_id": "1f2f23e8-f23f-405e-ae5a-18d421a91efe",
                                "sense_id": "72107126-e6c9-37ab-bf53-4fbb7e51705d",
                                "text": "„Erstaunt konnte der Reisende große Vögel beobachten, die zwischen den Häusern herumliefen und Körner aufpickten: Auf der Heuneburg wurde erstmals nördlich der Alpen Hühnerzucht betrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
