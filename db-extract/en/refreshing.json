                        "entry_id": "ad1b1826-e796-3080-bc56-fe7de0d3e3d8",
                        "glosses": [
                            "That refreshes someone; pleasantly fresh and different; granting vitality and energy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dfc3f9d-7084-4951-b014-dcb8daea3a87",
                                "sense_id": "db451310-396c-3490-b61e-c1b2e9d770ad",
                                "text": "The pond was another favourite place to visit. Moorhens strutted from the neighbouring bushes, and a bevy of Muscovy ducks, a study in black, white and red, waddled from the farmyard hard by to enjoy a refreshing splash."
                            },
                            {
                                "example_id": "d3211bce-81db-42e1-ab63-725b6bc419b1",
                                "sense_id": "db451310-396c-3490-b61e-c1b2e9d770ad",
                                "text": "Every forecast or guess has one refreshing quality: one will be right and the rest will be wrong."
                            }
                        ]
                    },
                    {
                        "sense_id": "86370c88-39f7-378f-9c99-2c745073286a",
                        "entry_id": "ad1b1826-e796-3080-bc56-fe7de0d3e3d8",
                        "glosses": [
                            "Serving to refresh, particularly with respect to an electronic screen, or a browser window or similar computer application."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b1abf9a-7b55-46f8-8e08-bd85f614cd6e",
                                "sense_id": "86370c88-39f7-378f-9c99-2c745073286a",
                                "text": "The polarization system has a refreshing rate that is twice the refreshing rate of the corresponding shutter system."
                            }
                        ]
