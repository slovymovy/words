                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5f2001-9c39-44b4-8ad3-34b655162d30",
                                                "sense_id": "f3446a9f-3ff8-362e-832f-9df481f55fb2",
                                                "text": "The approximately 1000 different cuneiform signs form a complex script system in which practically every symbol is polyvalent, i.e., having multiple phonemic and/or semantic realizations."
