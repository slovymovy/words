                ],
                "senses": [
                    {
                        "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                        "entry_id": "7903c77e-9f17-3857-ab3a-e1727d695dcb",
                        "glosses": [
                            "standardisierte Wettkampfdistanz eines Marathons (42,195 Kilometer)"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b821b9f8-b32b-4199-95a5-b7df5df63b3f",
                                "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                                "text": "„Gleich sieben Topläufer aus Kenia, Äthiopien und Marokko haben aktuelle Bestzeiten um die 2:09:28 Stunden über die Marathondistanz, der derzeit bestehende Streckenrekord von Justus Kiprotich aus dem Jahre 2018.“"
                            },
                            {
                                "example_id": "96893a19-8167-421e-b97c-259b60624216",
                                "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                                "text": "„Einige wenige Ultramarathon-Läufe haben als Laufdistanz ein ganzzahliges Vielfaches der Marathondistanz, so z.B. der Mt. Everest Treppen-Doppelmarathon in Radebeul.“"
                            },
                            {
                                "example_id": "8c390d1b-7270-48fe-bf6c-180db4af873b",
                                "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                                "text": "„1970 siegte er beim Paderborner Osterlauf und lief dann bei seinem Debüt auf der Marathondistanz am 25. April in Werther (Westf.) mit 2:15:23 h einen DLV-Rekord.“"
                            },
                            {
                                "example_id": "352e6bf2-9a80-411d-9b93-7b3651cdff7c",
                                "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                                "text": "„Bei optimalen äußeren Bedingungen gingen eine Frauenstaffel auf die Halbmarathondistanz, sowie eine Männerstaffel auf die Marathondistanz.“"
                            },
                            {
                                "example_id": "9b9a901d-2f98-4b8e-9a10-cbf6f6fa7dcd",
                                "sense_id": "ddc8152b-8b69-3ed0-9c5d-4c7f60608a47",
                                "text": "Um die klassische Marathondistanz von 42,195 km zu laufen, müssen 120 Runden (die Erste verkürzt) absolviert werden – selbst für erfahrene Marathonis eine monotone Grenzerfahrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                        "entry_id": "7903c77e-9f17-3857-ab3a-e1727d695dcb",
                        "glosses": [
                            "besonders lange Wettkampfdistanz oder Ausdauerstrecke"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1a130f71-5eeb-4f8c-b76f-4a00ff525ace",
                                "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                                "text": "„Highlight des Tages ist der Große Preis von meravis, ein Listenrennen für dreijährige und ältere Pferde über die Marathondistanz von 3.000 Metern, das mit 25.000 Euro dotiert ist.“"
                            },
                            {
                                "example_id": "396a89a4-a923-414f-945f-33132a5ac79d",
                                "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                                "text": "„Ich bin noch nie mehr als 100 Kilometer am Stück gefahren, ist die Marathondistanz von 210 km realistisch?“"
                            },
                            {
                                "example_id": "89dff8c4-5a78-4da3-be8e-f5f7ca238fac",
                                "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                                "text": "„Bei der legendären Salzkammergut Trophy werden sich am Samstag an die 4.000 Biker auf sieben Marathondistanzen messen und von 15.000 Zuseher angefeuert werden.“"
                            },
                            {
                                "example_id": "f79bd73f-3e56-4a35-8fe7-06799ca7360f",
                                "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                                "text": "„Etwas später finden dann auch noch vom 8. bis 10. September 2023 die World Games of Mountainbiking auf vier Marathondistanzen statt.“"
                            },
                            {
                                "example_id": "169ecabe-c0a2-4d79-aa99-8ac4a842c57a",
                                "sense_id": "802b37b5-9499-3541-8534-f847ac8cd43a",
                                "text": "„Insgesamt stehen bei der Trophy wieder sieben Marathondistanzen zur Auswahl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
