            {
                "entry_id": "bba213ca-feab-38bd-bdd3-6cca63169739",
                "word": "classage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6eca6228-7f8a-4d53-ac3e-8bafeb83d8eb",
                        "entry_id": "bba213ca-feab-38bd-bdd3-6cca63169739",
                        "tags": [
                            "plural"
                        ],
                        "form": "classages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12fc3326-3d4d-3d62-af49-5fdc79ff267a",
                        "entry_id": "bba213ca-feab-38bd-bdd3-6cca63169739",
                        "glosses": [
                            "Activité de tri des chiffons usagés, ou (anciennement) des déchets de laine ou de coton et du papier, à des fins de recyclage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94366bf5-9f29-41c0-abea-702a2ed3db88",
                                "sense_id": "12fc3326-3d4d-3d62-af49-5fdc79ff267a",
                                "text": "Dans l’atelier de classage, elles [les trieuses] assortissent ies nuances et les finesses des chiffons, de drap, etc. Chaque catégorie a son atelier."
                            },
                            {
                                "example_id": "2131362b-c7f7-4f25-86d7-40a9c28aa99e",
                                "sense_id": "12fc3326-3d4d-3d62-af49-5fdc79ff267a",
                                "text": "La maison Verdier-Dufour 251, rue de Crimée, a obtenu la Médaille d’or pour sa spécialité de triage et classage des chiffons de toile et de coton, du papier neuf et vieux pour papeterie et cartonnerie."
                            },
                            {
                                "example_id": "ac105adb-1439-4117-aab6-56e175647e70",
                                "sense_id": "12fc3326-3d4d-3d62-af49-5fdc79ff267a",
                                "text": "Créée en 1984 à Bruay-en-Artois à partir d’une communauté Emmaus, cette entreprise d’insertion a essaimé pour mettre en place des collectes sélectives, des centres de classage, ainsi que des boutiques de vente de fripe."
                            }
                        ]
                    },
                    {
                        "sense_id": "201e8042-893b-35d1-bd29-d38c36392e0c",
                        "entry_id": "bba213ca-feab-38bd-bdd3-6cca63169739",
                        "glosses": [
                            "Étape de fabrication de la pâte à papier consistant à séparer les éléments indésirables du papier collecté pour recyclage (colle, agrafes, encre etc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fcbbbb-d5ac-40c4-873d-1ae4b91f816f",
                                "sense_id": "201e8042-893b-35d1-bd29-d38c36392e0c",
                                "text": "Cette séparation nécessaire à la valorisation du papier via la fabrication d’une nouvelle pâte à papier peut s’opérer par classage. Les fibres diluées de plus en plus fortement traverseront des tamis de plus en plus fins."
                            },
                            {
                                "example_id": "a3f1b73f-ef71-4a7a-a06b-57df4f73c740",
                                "sense_id": "201e8042-893b-35d1-bd29-d38c36392e0c",
                                "text": "Le classage est une étape qui consiste a envoyer le mélange d’eau et de fibres à travers différents tamis (sous pression pour augmenter les vitesses de passage et donc les capacités de traitement des équipements) pour éliminer tous les amas non défibrés (ou bûchettes)."
                            }
                        ]
                    },
                    {
                        "sense_id": "069cfab3-ec24-34c7-9f0a-d3c792146253",
                        "entry_id": "bba213ca-feab-38bd-bdd3-6cca63169739",
                        "glosses": [
                            "Tri par criblage du minerai extrait d’une mine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f25872f1-3a84-4c81-8a41-f05319efcf86",
                                "sense_id": "069cfab3-ec24-34c7-9f0a-d3c792146253",
                                "text": "Le classage du charbon se fait partout, aujourd’hui, automatiquement. Dans les installalions bien étudiées les minerais autres que le charbon, c’est-à-dire les schistes et les pierres, sont rigoureusement éliminés par des appareils dont la régularité infaillible défie certainement le travail de l’ouvrier le plus attentif et le plus exercé."
                            },
                            {
                                "example_id": "93582ed1-efb4-43ea-b491-df776cdec888",
                                "sense_id": "069cfab3-ec24-34c7-9f0a-d3c792146253",
                                "text": "Le coke est criblé dans un atelier de classage pouvant traiter 2 000 tonnes par jour ; il peut être stocké dans un parc analogue à celui du charbon et desservi, comme lui, par deux ponts roulants de 120 mètres de portée."
                            }
                        ]
                    }
