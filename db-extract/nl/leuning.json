                        "translation_id": "80b7c461-324a-4626-8e05-4d6fd2cef753",
                        "source_entry_id": "45c3d380-7c1e-306d-981b-c7507dc4754f",
                        "source_sense_id": "cacbcf42-8dc0-3689-bc4a-0941716d8468",
                        "source_sense_description": "de achterkant van een stoel",
                        "target_lang_word": "Stuhllehne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stuhllehne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22b1bbdd-411e-3144-89da-9d397fee87e6",
                                        "entry_id": "455fe666-06f2-3ba5-8693-1be923e18b6d",
                                        "glosses": [
                                            "rückwärtige erhöhte Fläche eines Stuhles, die zum Anlehnen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb7af98-2892-45e2-a957-3308ff185a9b",
                                                "sense_id": "22b1bbdd-411e-3144-89da-9d397fee87e6",
                                                "text": "„Über der Stuhllehne an dem Tisch, an dem sie gesessen hatten, lag der Stoff.“"
                                            },
                                            {
                                                "example_id": "e7622c03-58f6-494a-b89c-bf293088d754",
                                                "sense_id": "22b1bbdd-411e-3144-89da-9d397fee87e6",
                                                "text": "„Der Lack der geschwungenen Stuhllehnen ist stumpf geworden.“"
                                            },
                                            {
                                                "example_id": "f6b878ed-06da-42c6-af5a-0f22d7a21d4c",
                                                "sense_id": "22b1bbdd-411e-3144-89da-9d397fee87e6",
                                                "text": "„Ihre Jacke hing über der Stuhllehne.“"
                                            },
                                            {
                                                "example_id": "4e606dc9-882a-49f0-ba33-15dfcf1c17a7",
                                                "sense_id": "22b1bbdd-411e-3144-89da-9d397fee87e6",
                                                "text": "„Eine Weile blickten sie sich über die Stuhllehne hinweg an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
