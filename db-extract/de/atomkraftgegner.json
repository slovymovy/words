                    {
                        "translation_id": "0cb5d944-2e6c-4d67-8ada-7e4cb8dcb302",
                        "source_entry_id": "51f4f83e-e829-35c9-ab0c-74424afffaa6",
                        "source_sense_id": "ff5fd67d-170e-3f8d-81b6-49c320c3de3f",
                        "source_sense_description": "Person, die die Gewinnung und Nutzung von Kernenergie kategorisch ablehnt",
                        "target_lang_word": "opposant au nucléaire",
                        "target_lang_code": "fr",
