                    }
                ],
                "senses": [
                    {
                        "sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                        "entry_id": "8271854d-6888-3730-a013-913d4c2d772f",
                        "glosses": [
                            "van grote omvang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d46a14d8-708a-43fc-aa62-515dfe5a032a",
                                "sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                                "text": "Daarover is een omvangrijke literatuur."
                            },
                            {
                                "example_id": "3a71851f-1bfc-4e6d-a6fc-1e954618a288",
                                "sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                                "text": "Ik zou hem beschrijven als omvangrijk en uitbundig, met expansieve gebaren die een gevaar vormen voor het glaswerk, en een dik hoofd dat speciaal is gemaakt om ruimte te bieden aan zijn brede lach."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d24d5ca3-1e95-48fe-a867-c13cd710afbe",
                        "source_entry_id": "8271854d-6888-3730-a013-913d4c2d772f",
                        "source_sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                        "target_lang_word": "ample",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ample",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                        "entry_id": "2bccce52-8465-34a5-96fe-3dc2f649aad7",
                                        "glosses": [
                                            "A fully sufficient or abundant quantity of; enough or more than enough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf664e5f-0c03-4f39-9807-d7f49234b583",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "We have ample time to finish the task."
                                            },
                                            {
                                                "example_id": "a0e8fa9b-dbe0-4c4e-b034-b6139ba7289c",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "It is a large house with ample space for all of us."
                                            },
                                            {
                                                "example_id": "24a237ce-1e2e-45b2-95a9-dd49638e6f04",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "…a broad and ample road, whose dust is gold…"
                                            },
                                            {
                                                "example_id": "616208e9-0c25-4eb3-b8da-de149e0fe7c6",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "…a line of wooden troughs supplies ample water for irrigation."
                                            },
                                            {
                                                "example_id": "2b9c3ead-3a82-481b-940a-43b6c7a3ec36",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "…possesses an ample supply of water-power for industrial purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbdebf28-6e3d-3a5b-80ea-27b068fd4634",
                                        "entry_id": "2bccce52-8465-34a5-96fe-3dc2f649aad7",
                                        "glosses": [
                                            "A quantity (of something) that is fully sufficient; plenty."
                                        ],
                                        "tags": [
                                            "as pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af70c6c1-0b17-4021-8a2f-7b156d6dbb3e",
                                                "sense_id": "dbdebf28-6e3d-3a5b-80ea-27b068fd4634",
                                                "text": "We don't need any more. We already have ample."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ample",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1de9bc0-83f3-30cd-8449-e9be26a9bc07",
                                        "entry_id": "46401823-914f-3f19-90bc-b245100bfc8c",
                                        "glosses": [
                                            "Large; great in size, extent, capacity, or bulk; for example spacious, roomy or widely extended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22843c74-5a8c-4402-91b4-36e7b7281b40",
                                                "sense_id": "d1de9bc0-83f3-30cd-8449-e9be26a9bc07",
                                                "text": "We have an ample supply of water"
                                            },
                                            {
                                                "example_id": "f74dc393-f3a7-46b4-a928-924e23aaa35d",
                                                "sense_id": "d1de9bc0-83f3-30cd-8449-e9be26a9bc07",
                                                "text": "She has a very ample bosom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1ee2c9a-6eb8-3e62-b1cd-e7f7d7df80a9",
                                        "entry_id": "46401823-914f-3f19-90bc-b245100bfc8c",
                                        "glosses": [
                                            "Not contracted or brief; not concise; extended; diffusive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c371f0bc-4523-4d4d-948f-f8ed4ff9225b",
                                                "sense_id": "e1ee2c9a-6eb8-3e62-b1cd-e7f7d7df80a9",
                                                "text": "an ample story"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c3e5ba8-a5bf-40dd-87c1-344b84eb6e53",
                        "source_entry_id": "8271854d-6888-3730-a013-913d4c2d772f",
                        "source_sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                        "target_lang_word": "bulky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Being large in size, mass, or volume; big, fat or muscular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759d36c6-9126-45cc-b8ca-4658eee345e0",
                                                "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                                "text": "Action such as this, filmed under great difficulty with a bulky, hand-cranked camera, revealed the possibilities of the movies and was quite startling in those early days."
                                            },
                                            {
                                                "example_id": "6be60671-e3f3-4da2-876f-a71ed637ecae",
                                                "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                                "text": "Needless to say, one's seat must be booked in advance and a platoon of urbane officials, one to each door of the train, awaits passengers to usher them to their seats and relieve them of their bulkier baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaef20d9-c097-33c5-8c81-474b79707727",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Unwieldy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c884a8-7b57-372d-8b31-5e39f1dfa235",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Having excess body mass, especially muscle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f352bc3-1379-4d24-91a6-7a70fd1ea67e",
                        "source_entry_id": "8271854d-6888-3730-a013-913d4c2d772f",
                        "source_sense_id": "1faf063b-8529-3778-959f-15852ffc54f5",
                        "target_lang_word": "extensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00ea8aae-7539-366d-a94d-3206e4d3adeb",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Having a great extent; covering a large area; vast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b759c0e-c6e6-4454-81c3-3859779ad70c",
                                                "sense_id": "00ea8aae-7539-366d-a94d-3206e4d3adeb",
                                                "text": "In the second century of the Christian era, the Empire of Rome comprehended the fairest part of the earth, and the most civilised portion of mankind. The frontiers of that extensive monarchy were guarded by ancient renown and disciplined valour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b093ec7-25e5-32d9-b5bd-98ddad78341c",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Considerable in amount."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98eae79-c35a-4473-9229-60e44e5121dd",
                                                "sense_id": "8b093ec7-25e5-32d9-b5bd-98ddad78341c",
                                                "text": "I have done extensive research on the subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4d6802-d564-3be6-a89a-2b1f4b86f90a",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Serving to extend or lengthen; characterized by extension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b4084a-8600-49e7-9616-cc40d00255ec",
                                                "sense_id": "cc4d6802-d564-3be6-a89a-2b1f4b86f90a",
                                                "text": "For station is properly no rest, but one kind of motion, relating unto that which physicians (from Galen) do name extensive or tonical; that is, an extension of the muscles and organs of motion, maintaining the body at length, or in its proper figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a87b82-4855-3beb-be15-e8b093955f96",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Having a combined system entropy that equals the sum of the entropies of the independent systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2bd2ad-3f6a-4962-bb86-58b7c57ec118",
                                                "sense_id": "b1a87b82-4855-3beb-be15-e8b093955f96",
                                                "text": "According to Tsallis (1988), the entropy was extensive for T = 1, superextensive for t < 1 and subextensive for t > 1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
