                                "example_id": "14650d1c-e032-4659-8776-b09eb626b78b",
                                "sense_id": "c7b692fb-9490-3755-9466-28b8631e0447",
                                "text": "„Ein Gebäude jedoch stach hervor. Ein weiß-grüner eingeschossiger Bau mit frischem Anstrich. Er befand sich in Ufernähe und wurde von einem Parkplatz umgeben, auf dem diverse eher schlichte Autos standen.“"
                            },
                            {
                                "example_id": "dde6b458-7392-4bd4-9032-11020255cdf5",
                                "sense_id": "c7b692fb-9490-3755-9466-28b8631e0447",
                                "text": "„Die Pferde wurden ausgespannt, damit sie in der Ufernähe Schilf fressen konnten.“"
                            }
                        ],
