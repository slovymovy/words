                "senses": [
                    {
                        "sense_id": "6ac615ee-853e-313e-b2e2-7495b372de91",
                        "entry_id": "4565c143-caf3-3400-8907-809cd5bb18c1",
                        "glosses": [
                            "Créer (en commun avec quelqu’un d’autre ou avec d’autres)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780a9673-d85f-46c4-b9fb-4479c64c1307",
                                "sense_id": "6ac615ee-853e-313e-b2e2-7495b372de91",
                                "text": "Nick admet aujourd'hui que, s'il avait pris le temps de cocréer une histoire en collaboration avec ses employés, il y aurait eu moins d'accidents de parcours et, qu'ainsi, la route vers la rentabilité aurait été plus rapide."
                            },
                            {
                                "example_id": "8f2c6252-c422-4edc-8f22-9b71351ed19d",
                                "sense_id": "6ac615ee-853e-313e-b2e2-7495b372de91",
                                "text": "Cocréé par l’équipe du Cube d’Issy-les-Moulineaux, l’équipement comprendra un théâtre, un cinéma, un auditorium, une médiathèque et des expositions."
                            }
                        ]
                    }
