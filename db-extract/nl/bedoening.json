                "senses": [
                    {
                        "sense_id": "26f30631-0c0b-33ce-b2f7-78967feef2be",
                        "entry_id": "8f267b76-4fe8-3c74-aa95-535ed3d5fe9f",
                        "glosses": [
                            "druk gedoe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01976e9-b8d0-4acb-9ba2-424215e84c7c",
                                "sense_id": "26f30631-0c0b-33ce-b2f7-78967feef2be",
                                "text": "Gekidnapt in Jemen: vroeger 'all-inclusive-paradijs', nu levensgevaarlijke bedoening."
                            },
                            {
                                "example_id": "41649f78-cecf-485f-952b-3a0313444e6c",
                                "sense_id": "26f30631-0c0b-33ce-b2f7-78967feef2be",
                                "text": "Bij aankomst was het een wilde bedoening: te veel mensen, te veel drank en te veel drama’s. Ik speelde al een tijdje met de gedachte om alleen verder te lopen en voelde dat dat moment nabij was."
                            },
                            {
                                "example_id": "a739776f-e78a-40a3-a9fd-4cb787edcde7",
                                "sense_id": "26f30631-0c0b-33ce-b2f7-78967feef2be",
                                "text": "Afijn, zoals gebruikelijk zat ik daar een beetje te genieten van die baldadige bedoening totdat het weer rustig werd en Hind bij me kwam zitten."
                            }
                        ]
                    },
                    {
                        "sense_id": "7993858e-cb4b-34a8-8753-14bd12d1ac2e",
                        "entry_id": "8f267b76-4fe8-3c74-aa95-535ed3d5fe9f",
                        "glosses": [
                            "inrichting"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3281a8ac-eca3-4550-9b5a-8c04867a1b29",
                        "source_entry_id": "8f267b76-4fe8-3c74-aa95-535ed3d5fe9f",
                        "target_lang_word": "fuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "Excessive activity, worry, bother, or talk about something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676b296a-8496-48cf-84a5-fe234e6e5ff4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "They made a big fuss about the wedding plans."
                                            },
                                            {
                                                "example_id": "02b41447-ebaa-46d8-85f9-afc5e82bd71d",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "What's all the fuss about?"
                                            },
                                            {
                                                "example_id": "a1419121-d9ca-4b22-a059-ac83f79bf8e4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "Sickness did not last above a ten days; my poor wife zealously assiduous, and with a minimum of fuss or noise."
                                            },
                                            {
                                                "example_id": "b3fcd38e-98fb-4572-ab17-82aed8b3656e",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "“Anthea hasn't a notion in her head but to vamp a lot of silly mugwumps. She's set her heart on that tennis bloke[…]whom the papers are making such a fuss about.”"
                                            },
                                            {
                                                "example_id": "0564d516-79ea-4755-a82e-3b7e0b4761a8",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "But in the reader comments section beneath the FT piece, many couldn’t understand what all the fuss was about. “I’m surprised to see the FT reporting this sort of thing,” one person wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "A complaint or noise; a scene."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b060867-8f98-4bef-a8b4-e16d5ed6ab82",
                                                "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                                "text": "If you make enough of a fuss about the problem, maybe they'll fix it for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "An exhibition of affection or admiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af648191-e585-47cb-aefc-8f50f707fa5e",
                                                "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                                "text": "They made a great fuss over the new baby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To be very worried or excited about something, often too much."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7855fbb-09d3-4e02-9016-9cb7d6e48424",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "His grandmother will never quit fussing over his vegetarianism."
                                            },
                                            {
                                                "example_id": "108d311a-8c7d-4e1b-9371-2ae4e6caf13b",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "Dear reader, spare me. I don't hate men, I love them; I eat 'em for breakfast. But it seems to me that fussing about masculinity is intimately related to homophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To fiddle; fidget; wiggle, or adjust"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f238fdd1-17a2-4573-874c-55b094e7f28d",
                                                "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                                "text": "Quit fussing with your hair. It looks fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b22380d-0ff2-32e8-876a-5ca60064428a",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To disturb (a person)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1edbf749-f840-3c79-bd53-e489b8344a51",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To cry or be ill-humoured."
                                        ],
                                        "tags": [
                                            "US",
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d072b864-e8ca-3c61-b489-47aabb3d3587",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To show affection for, especially animals."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d6a9f07-37b0-38b6-a8aa-5380d0f0d420",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To pet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dec1747-3971-4fa6-b4a5-0b019b78a969",
                                                "sense_id": "3d6a9f07-37b0-38b6-a8aa-5380d0f0d420",
                                                "text": "He fussed the cat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768aadaf-54f9-4da3-ba44-b25331b7aa55",
                        "source_entry_id": "8f267b76-4fe8-3c74-aa95-535ed3d5fe9f",
                        "target_lang_word": "to-do",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "to-do",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                                        "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                                        "glosses": [
                                            "A fuss made over something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bfca096-7c71-45e8-b6e6-4f41c65a79ea",
                                                "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                                                "text": "I was embarrassed that they made such a big to-do out of my birthday."
                                            },
                                            {
                                                "example_id": "f5d02b32-9f42-4ec3-8098-f5f57bd12ebc",
                                                "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                                                "text": "Last year, Russell Brand caused another to-do. This time he wasn’t playing nasty jokes on Andrew Sachs, or boasting about the millions of people he’d slept with; he wasn’t calling George Bush a “retard”, or giving a Nazi salute at the GQ awards, or turning up to work dressed as Osama bin Laden […] No, this time he simply made a political statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                                        "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                                        "glosses": [
                                            "A task that has been noted as one that must be completed, especially on a list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b56a7a4-692c-4580-a942-9e696fa876ba",
                                                "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                                                "text": "My to-do list has been growing longer every day."
                                            },
                                            {
                                                "example_id": "7962f2d0-7ba8-4cbe-beab-1965265c9866",
                                                "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                                                "text": "I have so many to-dos, I don't know where to start."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
