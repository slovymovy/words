                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb4491a-ad2c-4f3e-924d-c98c575efa4a",
                                                "sense_id": "8ad72907-9556-3bd3-877d-6d96e6c3b5c5",
                                                "text": "The reduction in the ship's size naturally reduced her stowage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14bb3aab-cf1d-3533-a953-70824da738c7",
                                        "entry_id": "c4039df8-3081-346e-b020-1a2c2a16955d",
                                        "glosses": [
                                            "A charge for stowing and storage."
                                        ],
                                        "tags": [
