                                    {
                                        "sense_id": "fd6c38d3-0eca-3b40-8403-66531833b370",
                                        "entry_id": "3abb44a5-44f6-3dd7-9035-edbc5f1e1bd4",
                                        "glosses": [
                                            "Capable of functioning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64756ba2-d3ba-4cdc-ac13-442eb786a4a5",
                                                "sense_id": "fd6c38d3-0eca-3b40-8403-66531833b370",
                                                "text": "They came up with a workable solution, until they could think of something better."
                                            },
                                            {
                                                "example_id": "b4194b04-28d6-4282-8183-6f3c5e2314aa",
                                                "sense_id": "fd6c38d3-0eca-3b40-8403-66531833b370",
                                                "text": "Penrhyn Quarry vertical-boilered 0-4-0 locomotive \"George Henry,\" built by De Winton & Company in 1877. It is the last survivor of its class, and is still in workable condition."
                                            },
                                            {
                                                "example_id": "159444c4-edf7-48fc-921d-8c5cdabfec73",
                                                "sense_id": "fd6c38d3-0eca-3b40-8403-66531833b370",
                                                "text": "The point was also made that the size and diversity of GWR's network and the number of services that are not capable of having reservations (Thames Valley, many branch lines, and so on) has meant a mandatory reservation system is not a workable system for them."
                                            }
                                        ]
                                    },
