                                                "sense_id": "fac483b0-1ee9-3b4f-a4fb-0a35b80a7ffe",
                                                "text": "She's a little strange, but nice enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42bb7356-0f40-3db1-b51b-ec3f56ce7907",
                                        "entry_id": "f41ab9cc-6491-3baf-b6a8-de40f750d70b",
                                        "glosses": [
                                            "Very."
