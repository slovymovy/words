                "senses": [
                    {
                        "sense_id": "4b0d3c2d-af66-31fd-9cd2-119171396221",
                        "entry_id": "822fd0fb-e094-3e56-8178-8da9fc323201",
                        "glosses": [
                            "fiktive, von der Realität abweichende Welt, die den eigenen Wünschen entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a067d74e-52a2-4c05-815a-c21735b44204",
                                "sense_id": "4b0d3c2d-af66-31fd-9cd2-119171396221",
                                "text": "„Wenn die reale Welt oft sehr trist ist, erscheint uns die Wunschwelt im Konjunktiv II dagegen sehr rosig.“"
                            },
                            {
                                "example_id": "ad70feed-bf25-44de-8d3a-9cee9a963557",
                                "sense_id": "4b0d3c2d-af66-31fd-9cd2-119171396221",
                                "text": "„Die kindliche Wunschwelt, die verdrängt wird und den Kern des dynamischen Unbewussten ausmacht, ist demnach vor allem eine sexuelle.“"
                            },
                            {
                                "example_id": "eba86496-1a2f-4b79-a951-18fc20e3df3a",
                                "sense_id": "4b0d3c2d-af66-31fd-9cd2-119171396221",
                                "text": "„Hingegen ist unser Lied nicht gegen die Gefahr eines reinen gefühligen Konsumierens, eines Aufgehens in einer Wunschwelt geschützt.“"
                            },
                            {
                                "example_id": "e359ac80-cb16-4832-bd38-fc94ac6c3e17",
                                "sense_id": "4b0d3c2d-af66-31fd-9cd2-119171396221",
                                "text": "„ Die Wunschwelt ist eine parallele Welt, wo der Gewinner nur Dinge erlebt, die er oder sie erleben will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
