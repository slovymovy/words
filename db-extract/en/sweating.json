            {
                "entry_id": "abc2effb-d762-3c4e-bb0c-65166280703d",
                "word": "sweating",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "18c3e1fe-5101-4eb8-a796-c04c0a9b6aae",
