                                "target_senses": [
                                    {
                                        "sense_id": "05aaf249-a400-3a22-8aac-3630643dd9bf",
                                        "entry_id": "6a65874e-d191-315c-a555-8ce9915dcc3c",
                                        "glosses": [
                                            "Accidente nervioso repentino, de índole histérica, caracterizado por la suspensión de las sensaciones y la inmovilidad del cuerpo en cualquier postura en que se le coloque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd077012-1960-47cb-b9a7-ffcd489fac78",
                                                "sense_id": "05aaf249-a400-3a22-8aac-3630643dd9bf",
                                                "text": "«Estefanía Gutiérrez Lázaro entraba así en un estado de coma que a las pocas horas se convirtió en una catalepsia severa»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
