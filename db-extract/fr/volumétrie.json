                        "examples": [
                            {
                                "example_id": "b251d511-dbb0-4646-b2b7-56fecee10e04",
                                "sense_id": "c47bc6d7-82c3-34ea-ad72-e1844fbbc7e8",
                                "text": "La volumétrie du système a été analysée sur trois ans pour prévoir les besoins de stockage futurs."
