                        "sense_id": "a846dc6c-a164-3c99-bdd1-63605cb88229",
                        "entry_id": "fb69d531-84ef-3cb9-a409-f2f54aa91224",
                        "glosses": [
                            "de zak waarin de stofzuiger het stof verzamelt"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "59f93607-8028-4d8d-9eb2-388a9db56b87",
                                "sense_id": "a846dc6c-a164-3c99-bdd1-63605cb88229",
                                "text": "Een vrouw uit Chicago bood de stofzak te koop aan. Zij had die in 2015 voor minder dan 1000 dollar op een veiling van overheidsspullen gekocht en liet hem op echtheid controleren door NASA. De ruimtevaartorganisatie herkende de zak en probeerde die tevergeefs terug te krijgen, omdat die „aan het Amerikaanse volk toebehoorde”."
                            },
                            {
                                "example_id": "15b2663c-f44e-43f8-90bd-1734dd1e29c7",
                                "sense_id": "a846dc6c-a164-3c99-bdd1-63605cb88229",
                                "text": "Veel dieren waren er slecht aan toe. Eén schildpad was al dood en twee andere overleden op het vliegveld. Sommige slangen waren in panty's gewikkeld. Hagedissen zaten in stofzakken in dozen."
                            }
                        ]
                    }
