                                "target_senses": [
                                    {
                                        "sense_id": "3f440849-68f3-34ca-9825-8796bcc31be6",
                                        "entry_id": "a3f73476-3eeb-302d-93dd-f589ff255298",
                                        "glosses": [
                                            "související s hrtanem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12dc8e8-d8be-4118-ba6d-0e804b56082b",
                                                "sense_id": "3f440849-68f3-34ca-9825-8796bcc31be6",
                                                "text": "Při polykání bývá jednak působením svalstva a jednak následkem procházejícího sousta skloněna tak, že úplně zavírá vchod hrtanový."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
