                "senses": [
                    {
                        "sense_id": "670dfedb-4091-3676-8bb1-72d3ad5bae50",
                        "entry_id": "59064cb6-e28f-3ace-a54d-15c83dd4bd97",
                        "glosses": [
                            "Person, welche Werke anderer Künstler unter schlechter Absicht nachahmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223b25a3-799c-4583-8359-4c3116d3bb93",
                                "sense_id": "670dfedb-4091-3676-8bb1-72d3ad5bae50",
                                "text": "Der Kunstfälscher machte keine Fehler."
                            },
                            {
                                "example_id": "251eeb65-fa25-40f1-9491-d2f51aaf3903",
                                "sense_id": "670dfedb-4091-3676-8bb1-72d3ad5bae50",
                                "text": "„Jener zu sechs Jahren Haft verurteilte deutsche Kunstfälscher namens Wolfgang Beltracchi, der in diesen Wochen ein Selbstvermarktungs-Feuerwerk nach dem anderen zündet und seine grauen Locken auf einigen Titelseiten zeigen durfte, ist nicht der Parvenü, als der er sich in der Öffentlichkeit geriert.“"
                            },
                            {
                                "example_id": "23e33bd4-80a4-432c-bbd4-a4262f242f77",
                                "sense_id": "670dfedb-4091-3676-8bb1-72d3ad5bae50",
                                "text": "„Ein Kunstfälscher, der für sich nie einer war, trifft auf einen Talkmaster, der keiner mehr ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
