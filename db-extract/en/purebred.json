                                        "entry_id": "2b77debb-b9ab-34cf-a579-e917ca90b0c8",
                                        "glosses": [
                                            "nicht gekreuzt; von Eltern abstammend, die derselben Rasse angehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e15e2b-6226-4f32-9844-892e8320564f",
                                                "sense_id": "709c90cd-e0e7-363f-a8af-90e23a2e0200",
                                                "text": "„Bekannt ist, dass es in der Vergangenheit zu Paarungen zwischen wildlebenden Wölfen und Haushunden in Italien gekommen ist, jedoch konnte nachgewiesen werden, dass die Italienischen Wölfe bislang reinrassig geblieben sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
