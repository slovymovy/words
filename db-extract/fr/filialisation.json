                "senses": [
                    {
                        "sense_id": "15f2daf8-3bdf-3b13-b40c-a2f5740ea3e3",
                        "entry_id": "87589de0-ac70-36ca-9c12-a1d92d55366c",
                        "glosses": [
                            "Fait ou action de filialiser, de diviser une compagnie en filiales légalement distinctes mais financièrement liées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a902cb-fdf7-4d2f-83c3-f4ebe9e00f29",
                                "sense_id": "15f2daf8-3bdf-3b13-b40c-a2f5740ea3e3",
                                "text": "Ce projet porte en lui le risque d’une cession de ces activités et la suppression des emplois filialisés, c’est-à-dire une filialisation qui prépare à des licenciements après avoir imposé aux salariés un changement de contrat social moins favorable."
                            },
                            {
                                "example_id": "ceec3a93-e892-4545-bda7-0cb3ac35f92e",
                                "sense_id": "15f2daf8-3bdf-3b13-b40c-a2f5740ea3e3",
                                "text": "Le syndicat socialiste CGSP-Cheminots a confirmé lundi, à l’issue d’un bureau national, son rejet de la proposition de plan social de la direction dans le cadre de la filialisation de SNCB Logistics."
                            },
                            {
                                "example_id": "0e4a4c34-c3a9-47e3-bdff-d790dabec8c4",
                                "sense_id": "15f2daf8-3bdf-3b13-b40c-a2f5740ea3e3",
                                "text": "«Pour la direction, la première étape c’est la réorganisation de l’entreprise en trois tranches puis la filialisation des trois sociétés, les licenciements et la vente par appartements», a dénoncé Jean-Pierre Ottavi."
                            }
                        ]
                    }
