                "senses": [
                    {
                        "sense_id": "fd2080d7-abc8-34e6-a4eb-fd74caeeaf01",
                        "entry_id": "bc40fb55-bb7c-38e0-99d3-fa5526e65cfe",
                        "glosses": [
                            "one's adopted home or country"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "804fee8f-2628-4e12-9e7b-f1d5788908f2",
                                "sense_id": "fd2080d7-abc8-34e6-a4eb-fd74caeeaf01",
                                "text": "Sie hatte eine gehabt: eine Wahlheimat, die Schritt für Schritt zu erobern gewesen war: ihre Kunst. Und auch aus der war sie verstoßen; denn die Branzilla saß in der Nervenheilanstalt."
                            },
                            {
                                "example_id": "d349ac61-ce00-4c92-b8fa-60e6df6839ff",
                                "sense_id": "fd2080d7-abc8-34e6-a4eb-fd74caeeaf01",
                                "text": "Neuseeland war meine Wahlheimat geworden. Ich hatte Schönes erlebt und war durch einige Tiefs gegangen. Nach einem Jahr in einer WG kaufte ich das Haus in Wellington."
                            }
                        ]
                    }
                ],
