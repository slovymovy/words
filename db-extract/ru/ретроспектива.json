                                                "sense_id": "0cc221e4-5c06-36c2-b650-32ebcb40d66e",
                                                "text": "„Er ahnte, dass er diesen Abend womöglich irgendwann aus der Retrospektive als etwas ganz Besonderes in Erinnerung haben würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
