                                        "glosses": [
                                            "A video creator on YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c88303-8afb-449e-a1d8-4f5fdbf774d1",
                                                "sense_id": "63bee397-cb77-36c5-ab2f-1a483fd95d04",
                                                "text": "YouTuber and sister traditionalist Lacey Lynn commented on this video, extolling Faucheux and Collett because they had “red pilled me and I owe yall so much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbf754df-204c-4a8e-86c8-c73772e6c0dc",
                        "source_entry_id": "8da601c0-2844-34e1-b6f3-65d2dc689da4",
                        "source_sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
                        "source_sense_description": "Person, die auf der Internetseite »YouTube« Videos veröffentlicht",
                        "target_lang_word": "youtubeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youtubeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa338630-d755-318e-9ae1-58982ed907a6",
                                        "entry_id": "aaf5dac1-d5a8-3236-9b24-d5842c62ac76",
                                        "glosses": [
                                            "Internaute utilisateur du site web YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9b6234a-c7d5-374a-ac12-2e0d1802c739",
                                        "entry_id": "aaf5dac1-d5a8-3236-9b24-d5842c62ac76",
                                        "glosses": [
                                            "Utilisateur qui publie des vidéos sur YouTube."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "093dbf6e-13fd-4919-99b9-7aec933e9809",
                                                "sense_id": "b9b6234a-c7d5-374a-ac12-2e0d1802c739",
                                                "text": "Youtubeurs, influenceurs, blogueurs récoltent de coquettes sommes pour promouvoir leurs conseils beauté ou mode."
                                            },
                                            {
                                                "example_id": "7b35258a-7f0f-40f4-ab6c-c5d6b80d86fb",
                                                "sense_id": "b9b6234a-c7d5-374a-ac12-2e0d1802c739",
                                                "text": "Le verdict est sans appel, son fameux slogan glorifiant l’anonymat a été efficace : Rémi Gaillard est le youtubeur français le plus populaire du pays."
                                            },
                                            {
                                                "example_id": "7bdf2df7-72fb-4e12-bbcb-f01c5cb8b72a",
                                                "sense_id": "b9b6234a-c7d5-374a-ac12-2e0d1802c739",
                                                "text": "Certains « youtubeurs » concluent un ou des partenariats commerciaux avec une entreprise en se faisant parrainer ou en valorisant un ou plusieurs de leurs produits…"
                                            },
                                            {
                                                "example_id": "dfe06d48-01cf-47a6-8000-931d03140d0a",
                                                "sense_id": "b9b6234a-c7d5-374a-ac12-2e0d1802c739",
                                                "text": "Le youtubeur complotiste Silvano Trotta a ainsi critiqué les médias qui n’ont « rien montré de la fraude »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dbbe2be-a93d-4c3a-81b7-f294346854c4",
                        "source_entry_id": "8da601c0-2844-34e1-b6f3-65d2dc689da4",
                        "source_sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
