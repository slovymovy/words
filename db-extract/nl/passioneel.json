                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22d7af4d-d5fe-4174-9153-cd3676117937",
                                                "sense_id": "1d426621-5b11-3444-a6cc-118526ae2cd8",
                                                "text": "1957: the promise of a release in her passional self — Lawrence Durrell, Justine, p.71 (Faber)"
                                            }
