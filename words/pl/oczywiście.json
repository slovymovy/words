                {
                    "sense_id": "80f9f231-a037-3e9c-8d5c-1298c220a71d",
                    "sense_definition": "Wykrzyknik wyrażający zdecydowaną zgodę, potwierdzenie lub aprobatę dla czyjejś wypowiedzi lub propozycji.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "– Czy mogę pożyczyć twój telefon? – <w>Oczywiście</w>!",
                            "target_lang_translations": {
                                "ru": "– Могу я одолжить твой телефон? – <w>Конечно</w>!",
                                "en": "– Can I borrow your phone? – <w>Of course</w>!",
                                "nl": "– Mag ik je telefoon lenen? – <w>Natuurlijk</w>!",
                                "de": "– Kann ich dein Telefon leihen? – <w>Natürlich</w>!",
                                "fr": "– Puis-je emprunter ton téléphone ? – <w>Bien sûr</w> !",
                                "it": "– Posso prendere in prestito il tuo telefono? – <w>Certo</w>!",
                                "cs": "– Můžu si půjčit tvůj telefon? – <w>Samozřejmě</w>!",
                                "tr": "– Telefonunu ödünç alabilir miyim? – <w>Elbette</w>!",
                                "es": "– ¿Puedo pedir prestado tu teléfono? – ¡<w>Claro</w>!",
                                "zh": "——我可以借用一下你的手机吗？——<w>当然</w>可以！"
                            }
                        },
                        {
                            "text": "– Pójdziesz z nami do kina? – <w>Oczywiście</w>, bardzo chętnie.",
                            "target_lang_translations": {
                                "ru": "– Ты пойдешь с нами в кино? – <w>Конечно</w>, с большим удовольствием.",
                                "en": "– Will you come to the cinema with us? – <w>Of course</w>, I'd love to.",
                                "nl": "– Ga je met ons mee naar de bioscoop? – <w>Natuurlijk</w>, heel graag.",
                                "de": "– Kommst du mit uns ins Kino? – <w>Selbstverständlich</w>, sehr gerne.",
                                "fr": "– Tu viens au cinéma avec nous ? – <w>Bien sûr</w>, avec grand plaisir.",
                                "it": "– Verrai al cinema con noi? – <w>Certamente</w>, molto volentieri.",
                                "cs": "– Půjdeš s námi do kina? – <w>Samozřejmě</w>, velmi ráda.",
                                "tr": "– Bizimle sinemaya gelir misin? – <w>Tabii ki</w>, seve seve.",
                                "es": "– ¿Irás con nosotros al cine? – <w>Por supuesto</w>, con mucho gusto.",
                                "zh": "——你跟我们一起去看电影吗？——<w>当然</w>，我很乐意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jasne",
                        "pewnie",
                        "naturalnie",
                        "tak",
                        "jak najbardziej",
                        "mowa",
                        "a jak",
                        "ma się rozumieć",
