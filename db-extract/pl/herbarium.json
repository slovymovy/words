                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27146b9c-31d8-3c84-bdca-8f09bd051336",
                                        "entry_id": "ed5ca2bf-5ab6-3590-a743-7646c760a4aa",
                                        "glosses": [
                                            "Sammlung von Pflanzen beziehungsweise Pflanzenteilen, die durch Pressen und Trocknen konserviert wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb4399aa-eb59-4492-87fd-9c526764ac8c",
                                                "sense_id": "27146b9c-31d8-3c84-bdca-8f09bd051336",
                                                "text": "Zur Erkundung der heimischen Flora kann man zum Beispiel ein Herbarium anlegen."
                                            },
                                            {
                                                "example_id": "89fd1f7b-6610-4efb-8126-c386314b3295",
                                                "sense_id": "27146b9c-31d8-3c84-bdca-8f09bd051336",
                                                "text": "„In der Zwischenzeit füllt Johann Georg Tinius seine silbrne Dose mit neuen Kräutern aus seinem Herbarium auf.“"
                                            },
                                            {
                                                "example_id": "e3cabd70-1e09-4c4a-a2f5-6bac68b33ac4",
                                                "sense_id": "27146b9c-31d8-3c84-bdca-8f09bd051336",
                                                "text": "„Die Proben für die genetischen Analysen stammten dabei vor allem aus unterschiedlichen wissenschaftlichen Pflanzensammlungen und Herbarien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
