                "senses": [
                    {
                        "sense_id": "96479c48-6dd2-3868-810d-18006c9ca92e",
                        "entry_id": "5751f2ed-d5dd-3426-a4dc-9d5c739edf3f",
                        "glosses": [
                            "повышенная требовательность к сохранению чистоты, строгости стиля в языке, искусстве, литературе и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0bbe54-0bf7-4761-a5e2-5bf40d39a430",
                                "sense_id": "96479c48-6dd2-3868-810d-18006c9ca92e",
                                "text": "Пуризм заключается в стремлении сохранить в неприкосновенности нормы языка, в борьбе против неологизмов, варваризмов и разных стилистических новшеств."
                            }
                        ]
                    },
