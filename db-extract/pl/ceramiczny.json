                                "text": "Nowa dachówka ceramiczna, plastikowe okna i elegancka elewacja współgrają z otoczeniem"
                            },
                            {
                                "example_id": "205b6151-3cbc-455d-8bb0-e9539d11ad5b",
                                "sense_id": "3572590f-3d2e-3029-8eb7-fdfbe291e30c",
                                "text": "Przywiozłam stamtąd ceramiczny moździerz, w którym najlepiej udaje się doskonale pasujący do ryby sos pietruszkowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f3e6eda2-3d2e-3755-963d-ecb1001244f7",
                        "entry_id": "36250997-c633-3155-b6a5-4971552a37c8",
                        "glosses": [
                            "związany z ceramiką, dotyczący ceramiki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e3201a-92bd-4240-8aa3-4da27e508d6d",
                                "sense_id": "f3e6eda2-3d2e-3755-963d-ecb1001244f7",
                                "text": "Doskonałym surowcem dla przemysłu ceramicznego są iły trzeciorzędowe, lodowcowe i rzeczne."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e63e5286-2a44-4856-80b7-55c7a84b90c3",
                        "source_entry_id": "36250997-c633-3155-b6a5-4971552a37c8",
                        "source_sense_id": "3572590f-3d2e-3029-8eb7-fdfbe291e30c",
                        "target_lang_word": "ceramic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceramic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60bcf8a0-f81b-3bbe-9964-4a110645b705",
                                        "entry_id": "dd562b51-3143-346b-933d-bb9a8713d3a2",
                                        "glosses": [
                                            "Made of material produced by the high-temperature firing of inorganic, nonmetallic rocks and minerals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2476c1e9-c7d2-40d4-a54a-75d90b978608",
                                                "sense_id": "60bcf8a0-f81b-3bbe-9964-4a110645b705",
                                                "text": "A ceramic vase stood on the table."
                                            },
                                            {
                                                "example_id": "4d790907-e0af-4d71-8655-4cb568dfb5e2",
                                                "sense_id": "60bcf8a0-f81b-3bbe-9964-4a110645b705",
                                                "text": "And over the past year, a new crop of collaborations between designers and artists has turned a spotlight on ceramic sculptures characterized by organic and biomorphic forms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ceramic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "337fbd3c-d746-37ec-9499-ff79c19512a2",
                                        "entry_id": "9e816639-3087-3fc3-a307-14e684b4f1f8",
                                        "glosses": [
                                            "A hard, brittle, inorganic, nonmetallic material, usually made from a material, such as clay, then firing it at a high temperature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "626e9751-4b78-43a9-8044-a941e55bb300",
                                                "sense_id": "337fbd3c-d746-37ec-9499-ff79c19512a2",
                                                "text": "Joan made the dish from ceramic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c0ccd9-9cac-3c14-a3cc-3f34944f5bd3",
                                        "entry_id": "9e816639-3087-3fc3-a307-14e684b4f1f8",
                                        "glosses": [
                                            "An object made of this material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f3246f4-8409-4226-aec7-73e7f35a2c3e",
                                                "sense_id": "f1c0ccd9-9cac-3c14-a3cc-3f34944f5bd3",
                                                "text": "Joe had dozens of ceramics in his apartment."
                                            },
                                            {
                                                "example_id": "b582b82d-841e-4fab-b51f-40a0c3a7a142",
                                                "sense_id": "f1c0ccd9-9cac-3c14-a3cc-3f34944f5bd3",
                                                "text": "Photographed by Juergen Teller, the project included a series of JW Anderson women’s wear looks, still-life images and sketches of Ms. Odundo and Ms. Corbett’s ceramics, as well as their portraits, and blankets designed as part of the collaboration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
