                                "example_id": "b14c3f23-8ab9-46fd-b466-855e1c4fd611",
                                "sense_id": "4c6b8177-1776-32d6-86db-bff27771202a",
                                "text": "a hall stood; o’er whose roof\nFair clinging weeds with ivy pale did grow,\nClasping its gray rents with a verdurous woof,\nA hanging dome of leaves, a canopy moon-proof."
                            }
