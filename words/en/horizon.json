{
    "word_family": [
        "horizontal",
        "horizontally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dab68cb6-6c83-3268-a342-898f99c5199b",
                    "sense_definition": "The visible line where the sky appears to meet the earth or the sea.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun slowly began to sink below the <w>horizon</w> as evening approached.",
                            "target_lang_translations": {
                                "ru": "Солнце начало медленно опускаться за <w>горизонт</w> с приближением вечера.",
                                "zh": "随着傍晚临近，太阳慢慢开始落到<w>地平线</w>以下。"
                            }
                        },
                        {
                            "text": "A tall building was visible on the whole sweep of the <w>horizon</w>.",
                            "target_lang_translations": {
                                "ru": "Высокое здание было видно на всем протяжении <w>горизонта</w>.",
                                "zh": "在整个<w>地平线</w>的弧线上都能看到一栋高楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skyline"
                    ],
                    "common_phrases": [
                        "on the horizon",
                        "below the horizon",
                        "disappear over the horizon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимая линия, где небо кажется сходящимся с землей или морем.",
                        "zh": "天空与大地或海洋交汇的可见线条。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горизонт",
                                "target_lang_sense_clarification": "линия раздела неба и земли"
                            },
                            {
                                "target_lang_word": "небосклон",
                                "target_lang_sense_clarification": "часть неба над линией горизонта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地平线",
                                "target_lang_sense_clarification": "天空与大地交汇的线"
                            },
                            {
                                "target_lang_word": "天际",
                                "target_lang_sense_clarification": "天空与地平线交汇处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                    "sense_definition": "The limit of a person's knowledge, experience, or interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traveling to different countries is a great way to broaden your <w>horizons</w>.",
                            "target_lang_translations": {
                                "ru": "Путешествия в разные страны — отличный способ расширить свой <w>кругозор</w>."
                            }
                        },
                        {
                            "text": "Some students take a gap year after finishing high school to broaden their <w>horizons</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые студенты берут академический отпуск после школы, чтобы расширить свои <w>горизонты</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broaden your horizons",
                        "expand your horizons",
                        "new horizons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что, вероятно, произойдет или появится в ближайшем будущем.",
                        "zh": "即将在不久的将来发生或出现的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на горизонте",
                                "target_lang_sense_clarification": "о событиях в ближайшем будущем"
                            },
                            {
                                "target_lang_word": "в перспективе",
                                "target_lang_sense_clarification": "в будущем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在望",
                                "target_lang_sense_clarification": "指事情即将发生"
                            },
                            {
                                "target_lang_word": "即将到来",
                                "target_lang_sense_clarification": "指未来趋势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                    "sense_definition": "Something that is likely to happen or exist in the near future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With clinical researchers hard at work, a new treatment is on the <w>horizon</w>.",
                            "target_lang_translations": {
                                "ru": "Благодаря упорной работе исследователей, на <w>горизонте</w> появилось новое лекарство.",
                                "zh": "随着临床研究人员的努力工作，一种新的治疗方法已<w>在望</w>。"
                            }
                        },
                        {
                            "text": "Economists warn that a major financial crisis might be on the <w>horizon</w>.",
                            "target_lang_translations": {
                                "ru": "Экономисты предупреждают, что на <w>горизонте</w> может маячить крупный финансовый кризис.",
                                "zh": "经济学家警告说，一场重大的金融危机可能<w>在望</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the horizon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что, вероятно, произойдет или появится в ближайшем будущем.",
                        "zh": "即将在不久的将来发生或出现的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на горизонте",
                                "target_lang_sense_clarification": "о событиях в ближайшем будущем"
                            },
                            {
                                "target_lang_word": "в перспективе",
                                "target_lang_sense_clarification": "в будущем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在望",
                                "target_lang_sense_clarification": "指事情即将发生"
                            },
                            {
                                "target_lang_word": "即将到来",
                                "target_lang_sense_clarification": "指未来趋势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aa78fd1-d0f5-34b9-97d7-391ee1422b18",
                    "sense_definition": "A specific layer of soil or rock with particular characteristics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist identified a distinct dark <w>horizon</w> in the cliff face.",
                            "target_lang_translations": {
                                "ru": "Геолог обнаружил отчетливый темный <w>горизонт</w> в срезе скалы.",
                                "zh": "地质学家在悬崖面上识别出了一个明显的深色<w>层</w>。"
                            }
                        },
                        {
                            "text": "Each soil <w>horizon</w> tells a story about the environmental history of the region.",
                            "target_lang_translations": {
                                "ru": "Каждый почвенный <w>горизонт</w> повествует об экологической истории региона.",
                                "zh": "每一层土壤<w>层</w>都讲述着该地区环境历史的故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "soil horizon"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический слой почвы или горной породы с определенными характеристиками.",
                        "zh": "具有特定特征的土壤或岩石的特定层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горизонт",
                                "target_lang_sense_clarification": "геологический или почвенный слой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "层",
                                "target_lang_sense_clarification": "地质或土壤分层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9860d0f-f9d8-3133-b43e-50d7acd34166",
                    "sense_definition": "A cultural sub-period or level within a larger archaeological time period.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expansion of the empire created a uniform cultural <w>horizon</w> across the continent.",
                            "target_lang_translations": {
                                "ru": "Расширение империи создало единый культурный <w>горизонт</w> на всем континенте.",
                                "zh": "帝国的扩张在整个大陆上创造了一个统一的<w>文化层</w>。"
                            }
                        },
                        {
                            "text": "Archaeologists found pottery styles that define this specific chronological <w>horizon</w>.",
                            "target_lang_translations": {
                                "ru": "Археологи нашли стили керамики, которые определяют этот конкретный хронологический <w>горизонт</w>.",
                                "zh": "考古学家发现了定义这一特定年代<w>文化层</w>的陶器风格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cultural horizon"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Культурный подпериод или уровень в рамках более широкого археологического периода.",
                        "zh": "较大考古时期内的文化子时期或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горизонт",
                                "target_lang_sense_clarification": "археологический слой или период"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文化层",
                                "target_lang_sense_clarification": "考古学中的文化时期"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}