                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74303e01-f8b0-4d01-8add-40d3023ff397",
                                                "sense_id": "98d3ee28-1b8a-3536-9e04-d7c53a73e484",
                                                "text": "Les élèves de 4ᵉ et de 3ᵉ du collège Gounod ont assisté à une séance de planétarium à l’intérieur d’une structure gonflable amenée par Gilles Rémy, enseignant à l’Université de Cergy."
                                            },
                                            {
                                                "example_id": "5ba0ed3f-483b-47d0-a9e6-53c002619d35",
                                                "sense_id": "98d3ee28-1b8a-3536-9e04-d7c53a73e484",
                                                "text": "Plateaux, festifoot, jeux gonflables, ateliers ludiques (défi bâche, « chamboule tout », footgolf, labyrinthe, baby-foot…) ont rythmé le programme de cette journée de fin de saison consacrée à la promotion de notre merveilleux sport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28babf37-24e9-4bff-972d-9cffc2c640de",
                        "source_entry_id": "3412f16a-3740-3b9a-b85e-64069aa4efcc",
                        "source_sense_id": "100a1010-9e71-308d-b26e-4f271a65563e",
                        "source_sense_description": "able to be inflated",
                        "target_lang_word": "pneumatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pneumatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6cd64d-dad0-3220-9a21-1978b89f70c0",
                                        "entry_id": "dfc84c91-ae20-3f52-8610-150d688796bf",
                                        "glosses": [
                                            "Relatif à l’air."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2901fe5-c2ce-38d6-bc11-4f372d31d08f",
                                        "entry_id": "dfc84c91-ae20-3f52-8610-150d688796bf",
                                        "glosses": [
                                            "Qui utilise de l’air sous pression ou sous dépression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfacd6fa-7a7f-4466-a9bd-54c9f70056f0",
                                                "sense_id": "b2901fe5-c2ce-38d6-bc11-4f372d31d08f",
                                                "text": "Les dépoussiéreurs pneumatiques offrent l’inconvénient de dépoussiérer moins efficacement que les tamis vibrants, — […] — et de consommer une quantité importante d’air, c’est à dire de force motrice."
                                            },
                                            {
                                                "example_id": "fc561495-f16d-4b33-b23c-4cdc03b13394",
                                                "sense_id": "b2901fe5-c2ce-38d6-bc11-4f372d31d08f",
                                                "text": "Pour les épandeurs centrifuges à 2 disques et les épandeurs pneumatiques il est préférable, lorsque cela est possible, de vérifier le débit des 2 côtés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5ac6a4-0c23-34ff-ab03-543e829cfaab",
                                        "entry_id": "dfc84c91-ae20-3f52-8610-150d688796bf",
                                        "glosses": [
                                            "Qualifie le système de transport de petites masses, sur de courtes distances, par des tubes sous pression d’air."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82bfb630-6498-43e7-8bb7-91e26c557ae7",
                                                "sense_id": "eb5ac6a4-0c23-34ff-ab03-543e829cfaab",
                                                "text": "À la vue de la carte pneumatique, la crainte du fantôme de son mari s’est évanouie chez Hélène."
                                            },
                                            {
                                                "example_id": "65739626-64f2-4bb8-86f0-b3ccb5ab981d",
                                                "sense_id": "eb5ac6a4-0c23-34ff-ab03-543e829cfaab",
                                                "text": "Tube pneumatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pneumatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9aaa1f79-2468-386c-a21e-f438e97d48a4",
                                        "entry_id": "53a99875-2950-3e10-b5a8-bec5159e2230",
                                        "glosses": [
                                            "Tube de caoutchouc, gonflé d’air ou d’un gaz comprimé, et qui est fixé à la jante d’une roue pour amortir les chocs, inventé en 1888."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a892cb7-8d64-42a3-a259-a038c4446a4b",
                                                "sense_id": "9aaa1f79-2468-386c-a21e-f438e97d48a4",
                                                "text": "Sans me presser je mets mes souliers et gonfle mes pneumatiques."
                                            },
                                            {
                                                "example_id": "83184e86-b6fd-4714-8faf-66c4e2bef59f",
                                                "sense_id": "9aaa1f79-2468-386c-a21e-f438e97d48a4",
                                                "text": "Brevet de quinze ans, 30 septembre 1913; Destriez (J.) & Duthilleul (E.), représentés par Smits, rue Colbrant, n° 23, à Lille (Nord). — Tube à air increvable et inéclatable remplaçant la chambre à air des pneumatiques pour automobiles."
                                            },
                                            {
                                                "example_id": "414df33d-7f3e-4517-8e3d-a5ec0f9f9133",
                                                "sense_id": "9aaa1f79-2468-386c-a21e-f438e97d48a4",
                                                "text": "La roue en bois avec cerclage en fer, utilisée notamment en Afrique du Nord, en Égypte et à Madagascar, équipait autrefois tous les chariots avant l’emploi des pneumatiques."
                                            },
                                            {
                                                "example_id": "62db9ac9-9470-47ae-a218-d2a4dfbd9ef8",
                                                "sense_id": "9aaa1f79-2468-386c-a21e-f438e97d48a4",
                                                "text": "Le tracteur e107 V Vario est doté de série de pneumatiques 280/70R16 à l’avant et 380/70R24 à l’arrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f1328b-1656-3358-a9ac-16d48872a81b",
                                        "entry_id": "53a99875-2950-3e10-b5a8-bec5159e2230",
                                        "glosses": [
                                            "Tube rigide où l’on fait le vide par le moyen de machines pneumatiques et dont on se servait pour envoyer les dépêches, et aujourd’hui pour faire circuler de la monnaie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27bb5161-a67d-42d5-a155-b50d30506583",
                                                "sense_id": "e4f1328b-1656-3358-a9ac-16d48872a81b",
                                                "text": "9 décembre 42 – C’est étonnant l’habitude que nous avons tous de procéder par pneumatiques ! On n’a pas le courage d’attendre plus de deux heures qu’une lettre soit reçue et lue ! Je me demande si les autres jeunesses étaient comme cela ? Il est évident que pour nous, tout se passe par lettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af8cf7b5-18d2-3850-8ff1-73e044051819",
                                        "entry_id": "53a99875-2950-3e10-b5a8-bec5159e2230",
                                        "glosses": [
                                            "Dépêche envoyée par ce moyen."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb602f19-792e-44f7-83e2-d546f596b08c",
                                                "sense_id": "af8cf7b5-18d2-3850-8ff1-73e044051819",
                                                "text": "C’était un garçon de bureau qui lui apportait un pneumatique que Bellegarde s’empressa de décacheter."
                                            },
                                            {
                                                "example_id": "e082e8ca-f3fe-4aba-ab35-283c94cad55e",
                                                "sense_id": "af8cf7b5-18d2-3850-8ff1-73e044051819",
                                                "text": "Vers cinq heures elle se résigna à retourner chez elle, où elle ouvrit les tiroirs d’un bureau, d’une commode. Elle retrouva, bien cachés, deux ou trois pneumatiques qu’elle détruisit avec une froide négligence : « Il y avait là de quoi faire de la peine à Michel, s’il les avait trouvés…"
                                            },
                                            {
                                                "example_id": "cf79809c-43e1-45c4-9186-1aa83aaeac80",
                                                "sense_id": "af8cf7b5-18d2-3850-8ff1-73e044051819",
                                                "text": "De temps en temps, il envoyait à ma sœur un pneumatique où il s’excusait d’avoir été de mauvaise humeur."
                                            },
                                            {
                                                "example_id": "53091936-cdc4-488c-b330-827f5bdf6948",
                                                "sense_id": "af8cf7b5-18d2-3850-8ff1-73e044051819",
                                                "text": "Comment Lucie avait-elle pu se laisser aller à convoquer sa fille par pneumatique, de toute urgence, sans explication ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7367a62a-82aa-33f5-8d61-5981ecfa09f8",
                                        "entry_id": "53a99875-2950-3e10-b5a8-bec5159e2230",
                                        "glosses": [
                                            "Sorte d’obus qui circulait dans ce tube."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e365ab-94bc-44d4-99eb-cce6d8faa06c",
                                                "sense_id": "7367a62a-82aa-33f5-8d61-5981ecfa09f8",
                                                "text": "Expédier un pneumatique. (Voir aussi pneu)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pneumatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75740761-6138-3c20-81b5-f1f91ea7adca",
                                        "entry_id": "1925705a-df9b-373b-ba77-00bba0b14e78",
                                        "glosses": [
                                            "Branche de la science et de la technique qui a trait à l’étude et l’utilisation de l’air, notamment l’air comprimé et, par extension, des autres gaz."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a5eb41-db51-4978-90ca-3f780e458861",
                                                "sense_id": "75740761-6138-3c20-81b5-f1f91ea7adca",
                                                "text": "Les actionneurs pneumatiques industriels, largements répendus, représentent une application importante de la pneumatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da72ca0b-1c6b-33ca-ac33-59fd167e27df",
                                        "entry_id": "1925705a-df9b-373b-ba77-00bba0b14e78",
                                        "glosses": [
                                            "Philosophie de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
