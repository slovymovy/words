        "nl-extract.jsonl": [
            {
                "entry_id": "9306c0ef-305d-3c4f-b948-19bff857288e",
                "word": "uitrafelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a10f3bf7-c9e5-35cb-a3fa-652bc2c7875f",
                        "entry_id": "9306c0ef-305d-3c4f-b948-19bff857288e",
                        "glosses": [
                            "vanaf de randen van een weefsel uit elkaar halen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d32420c-8faf-4177-a0bd-9bb77bab7f0c",
                                "sense_id": "a10f3bf7-c9e5-35cb-a3fa-652bc2c7875f",
                                "text": "Ook weer zo larmoyant: als de nood aan de man zou komen, wil Dirkie nog wel een keertje het Oranjeshirt aantrekken. Die bijna pathetische serviliteit, aan de rand van zelfverloochening wordt mij iets te veel pose. Een voetballer met zijn status en charisma laat zich niet uitrafelen tot noodverband."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4ceca90-cb50-34c6-b49c-77000a5f5283",
                        "entry_id": "9306c0ef-305d-3c4f-b948-19bff857288e",
                        "glosses": [
                            "vanaf de randen uit elkaar vallen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "740df52b-a3b7-4510-b459-c8717fd62d1f",
                                "sense_id": "d4ceca90-cb50-34c6-b49c-77000a5f5283",
                                "text": "Inmiddels heeft de reisindustrie het voor elkaar gekregen dat alle eenheid zoek is: de chartervliegtuigen en de vakantiehuisjes moeten nu eenmaal tot de nok gevuld zijn. Het onderwijs is onder het juk van Center Parcs en Martin Air doorgegaan in de ijdele hoop het uitrafelen van het schooljaar tegen te gaan: het is moeilijk weerstand bieden aan ouders die voordelig een paar dagen eerder weg willen gaan."
                            },
                            {
                                "example_id": "af55e613-5e18-4794-895c-62973757cfe2",
                                "sense_id": "d4ceca90-cb50-34c6-b49c-77000a5f5283",
                                "text": "De ervaring van Samsung laat zien hoe snel ook hechte banden met de regering kunnen uitrafelen. “Samsung is er heel goed in geslaagd de steun van de regering te verwerven”, zo zegt een ambtenaar bij het ministerie van Financiën. “Toen kwamen de uitlatingen van Peking en daarmee veranderde het beeld volkomen. Opeens was Samsung een vreemde onderneming die de regels had geschonden die er bestaan tussen zakenleven en regering.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aea9365e-cd56-4531-bf29-2883d8e3dca9",
                        "source_entry_id": "9306c0ef-305d-3c4f-b948-19bff857288e",
                        "source_sense_id": "a10f3bf7-c9e5-35cb-a3fa-652bc2c7875f",
                        "target_lang_word": "disentwine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disentwine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a0889f-45b5-3ec7-b7be-bf9be820b6ab",
                                        "entry_id": "5de6b0d2-f474-306b-932c-71f9a8839a7d",
                                        "glosses": [
                                            "To free (someone or something) from being entwined or twisted; to untwine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f27ab4-de72-44c7-afa7-7c7acf303127",
                                                "sense_id": "30a0889f-45b5-3ec7-b7be-bf9be820b6ab",
                                                "text": "To disentwine the tangled skein of thought which was thus presented, was her task by day and night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9487d197-da78-3273-bc9c-a86b221f0600",
                                        "entry_id": "5de6b0d2-f474-306b-932c-71f9a8839a7d",
                                        "glosses": [
                                            "to unfree from something complicated"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dd0f4b8-5ced-4dbd-a506-6b613a5997a0",
                        "source_entry_id": "9306c0ef-305d-3c4f-b948-19bff857288e",
                        "source_sense_id": "a10f3bf7-c9e5-35cb-a3fa-652bc2c7875f",
                        "target_lang_word": "tearing up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tearing up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6879cd-8338-3d55-952b-50b40e6dd58d",
