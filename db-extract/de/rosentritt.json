                ],
                "senses": [
                    {
                        "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                        "entry_id": "aaa64699-e4eb-3d3c-b75f-d167402b8f8a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc45484-414f-4e96-80a8-9560262a3f8d",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Frau Rosentritt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dea2621b-1a90-4642-89ad-e44faf6db9ae",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Herr Rosentritt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f680aade-fb04-48d7-b36e-0090aadb7162",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Die Rosentritts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0f1b56c0-4bfc-48fd-abf5-b227d01a3fcd",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Der Rosentritt trägt nie die Schals, die die Rosentritt ihm strickt."
                            },
                            {
                                "example_id": "78e6ccae-9975-41d5-8259-09eea66452c6",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rosentritt kommt, geht der Herr Rosentritt.“"
                            },
                            {
                                "example_id": "5877f8d0-5c00-4926-a26d-2a7a65e05f11",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Rosentritt kommt und geht."
                            },
                            {
                                "example_id": "2a4b5b10-0beb-463b-882e-58c2feb32d1a",
                                "sense_id": "4f0ceb72-0c83-3512-8687-54a9bb38dd8f",
                                "text": "Rosentritts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
