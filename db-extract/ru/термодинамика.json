                                "target_senses": [
                                    {
                                        "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                        "entry_id": "d232f483-ab21-3ff0-9bce-f9c0b988b8af",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Wirkung von Wärme beschäftigt; die Lehre der thermischen Energie, ihre Erscheinungsformen und nutzbaren Fähigkeiten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a28e0b1-298e-4d08-b981-7e73328b1787",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Wir wollen damit beginnen, die Thermodynamik in den Rest der Physik einzuordnen.“"
                                            },
                                            {
                                                "example_id": "a30472a5-84af-441b-8880-8ffc3de9d4ef",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Thermodynamik ist die allgemeine Theorie energie- und stoffumwandelnder Prozesse.“"
                                            },
                                            {
                                                "example_id": "53845eba-a05d-4e4e-8607-6a8217b5e071",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die Thermodynamik sagt aus, dass eine Reaktion dann „freiwillig“ ablaufen kann, wenn die Differenz der freien Enthalpie zwischen Ausgangs- und Endzustand negativ ist (0<∆G).“"
                                            },
                                            {
                                                "example_id": "373d7945-9bd0-47b0-9068-9548adc1c0b9",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die folgende Phase war gekennzeichnet durch das Bestreben, die wissenschaftlichen Erkenntnisse der Thermodynamik praktisch zu nutzen und so spielen vor allem Ingenieure eine herausragende Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
