                "senses": [
                    {
                        "sense_id": "07e6a154-b5c3-3da7-9e34-6e1772f2e572",
                        "entry_id": "758d5849-f062-39f4-bafa-66f3ae91c480",
                        "glosses": [
                            "Aufbewahrungsraum für Sitzgelegenheiten zur Nutzung bei Veranstaltungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a024a66-8590-434f-90ac-139d2eea6c97",
                                "sense_id": "07e6a154-b5c3-3da7-9e34-6e1772f2e572",
                                "text": "„Im Jahre 1999 wurde das Bürgerhaus um zwei Klubräume und ein Stuhllager für über eine Million DM erweitert, da die Kapazitäten nicht mehr ausreichten.“"
                            },
                            {
                                "example_id": "307c125a-f475-4fc5-9e6d-fc0eea28b075",
                                "sense_id": "07e6a154-b5c3-3da7-9e34-6e1772f2e572",
                                "text": "„Ab 2001 wurden die Klöße dann im Umkleideraum der Tischtennis-Spieler gekocht, bevor 2013 das Stuhllager fertiggestellt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
