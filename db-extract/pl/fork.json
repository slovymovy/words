                                    {
                                        "sense_id": "998bdab6-ee0b-3145-b45c-dc97ff5a831e",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To divide into two or more branches or copies.",
                                            "To spawn a new child process by duplicating the existing process."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa947677-3859-483b-8826-bb4c4f6974bf",
                                                "sense_id": "998bdab6-ee0b-3145-b45c-dc97ff5a831e",
                                                "text": "A parent process forks a child process, which in turn can fork other processes."
                                            },
                                            {
                                                "example_id": "e39060fa-6b5b-4bb6-8917-f522ce342947",
                                                "sense_id": "998bdab6-ee0b-3145-b45c-dc97ff5a831e",
                                                "text": "It appears that the shell forks a copy of itself and that this copy then forks to make each of the previous processes in the pipeline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960db64d-1208-3abb-b945-ab5c375e920d",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To divide into two or more branches or copies.",
                                            "To launch a separate software development effort based upon a modified copy of an existing software project, especially in free and open-source software."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0cdc54f-ebf4-473d-8d64-ba98f55ef5df",
                                                "sense_id": "960db64d-1208-3abb-b945-ab5c375e920d",
                                                "text": "For various reasons, McCool's server project subsequently forked, leading to the development of the Apache Web Server."
                                            },
                                            {
                                                "example_id": "03597a32-858f-43d3-94d3-dc0d6b1ee3ee",
                                                "sense_id": "960db64d-1208-3abb-b945-ab5c375e920d",
                                                "text": "Google forked WebKit to create the Blink project in April 2013 because they wanted to make larger-scale changes to WebKit to fit their own needs that did not align well with the WebKit project itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554cb385-df0a-3cb0-bd42-21de7b668212",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To divide into two or more branches or copies.",
                                            "To create a copy of a distributed version control repository."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba613cf-af58-442e-9126-249cae1fcc63",
                                                "sense_id": "554cb385-df0a-3cb0-bd42-21de7b668212",
                                                "text": "In this model, anyone can fork an existing repository and push changes to their personal fork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a346fb4-2689-33ec-a468-e394370667dc",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To move with a fork (as hay or food)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69e7ebf-694d-4f17-805c-59fb142a9b54",
                                                "sense_id": "8a346fb4-2689-33ec-a468-e394370667dc",
                                                "text": "forking the sheaves on the high-laden cart"
                                            },
                                            {
                                                "example_id": "5f3ee0f1-5241-4841-bd7c-75b0c26f92df",
                                                "sense_id": "8a346fb4-2689-33ec-a468-e394370667dc",
                                                "text": "Brianna curbed her pang of envy as she forked her plain, low-fat, crouton-free salad niçoise into her mouth and shook her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b1169d-62b7-329c-8903-e875f1485368",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To kick someone in the crotch."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aea383d0-217d-3db2-bad5-7ae39cd19650",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To shoot into blades, as corn does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7310c17-354f-43df-a1b6-d6335b0dd409",
                                                "sense_id": "aea383d0-217d-3db2-bad5-7ae39cd19650",
                                                "text": "I have known them couched up a Yard thick cover’d with an Hair-cloth and ſtirred only once a day, the Maltſer being always careful to throw the frozen outſides into the middle till the Corn begin to fork and warm in the Couch; after which time if it be not laid too thin, it will not eaſily freeze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26b553e-29ce-3901-bd9a-de3a182b4672",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "To simultaneously attack two opposing pieces with a single attacking piece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8a8b513-0902-326e-a0b7-b0f057c4d20f",
                                        "entry_id": "624fe6ef-0811-31e1-a1a2-40700cb6fd73",
                                        "glosses": [
                                            "Euphemistic form of fuck."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "form-of",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ee27a9-7d5c-4ad8-96fe-313ad86a1681",
                                                "sense_id": "a8a8b513-0902-326e-a0b7-b0f057c4d20f",
                                                "text": "They were forking each other in the back room."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
