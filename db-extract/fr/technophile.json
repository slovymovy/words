                ],
                "senses": [
                    {
                        "sense_id": "5ff4bc4d-787b-359e-a157-58bdc5afa34d",
                        "entry_id": "21fce387-3964-352c-8676-19e8f7748d88",
                        "glosses": [
                            "Qui aime la technologie, qui croit à ses bienfaits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1a0453-cac2-400b-87f4-b6241a4d9e94",
                                "sense_id": "5ff4bc4d-787b-359e-a157-58bdc5afa34d",
                                "text": "Technophile, Mikel Dufrenne croit que l'automatisation des tâches ira vers une libération de la classe ouvrière qui ne sera plus contrainte de travailler à des postes humiliants et dégradants."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4872c72-965b-3efa-82e9-ad7a0cd9422f",
                        "entry_id": "21fce387-3964-352c-8676-19e8f7748d88",
                        "glosses": [
                            "Qui est amateur de technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff688b0-405b-4470-933e-ed1aae665649",
                                "sense_id": "b4872c72-965b-3efa-82e9-ad7a0cd9422f",
                                "text": "Seuls quelques élus pourront assister ce soir en direct à la conférence d’Apple. Mais l’événement –c’en est un en tout cas pour le monde technophile– sera évidemment largement diffusé sur la toile."
                            },
                            {
                                "example_id": "b634b858-5900-49a8-994f-318de54c0387",
                                "sense_id": "b4872c72-965b-3efa-82e9-ad7a0cd9422f",
                                "text": "« Le grand lecteur de livres est sensiblement moins jeune et moins technophile » que le consommateur de musique et de films sur support numérique, relève le centre."
                            },
                            {
                                "example_id": "8fffb546-b299-4d47-842b-c4d9a987dd2e",
                                "sense_id": "b4872c72-965b-3efa-82e9-ad7a0cd9422f",
                                "text": "Elle peut certes être interprétée de façon intéressée, permettant à d’aucuns conseils, en permanence connectés à Wall Street, de servir une soupe technophile et délicieusement dérégulée à leurs multinationales clientes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54cb3ff6-8fd5-47fc-a501-5b91a27242c0",
                        "source_entry_id": "21fce387-3964-352c-8676-19e8f7748d88",
