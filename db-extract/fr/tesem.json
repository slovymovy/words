                "senses": [
                    {
                        "sense_id": "a7fc3d43-78a6-3be9-82ac-2bf72100f6c3",
                        "entry_id": "59736b94-66bb-351f-8280-05406187b162",
                        "glosses": [
                            "Ancienne race de chien de chasse type lévrier, originaire d’Égypte, représentée les oreilles droites et la queue enroulée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857db481-c871-4151-9bea-20974ed83867",
                                "sense_id": "a7fc3d43-78a6-3be9-82ac-2bf72100f6c3",
                                "text": "Le lévrier tesem était un chien de chasse africain, aujourd’hui disparu."
                            },
                            {
                                "example_id": "dc99cc5e-9587-4fb6-aac1-e04c3b1f95cd",
                                "sense_id": "a7fc3d43-78a6-3be9-82ac-2bf72100f6c3",
                                "text": "Il descend du Tesem, chien des pharaons, dont des statues ont été retrouvées dans les pyramides et qui personnifia Anubis, le Dieu des morts."
                            },
                            {
                                "example_id": "4e4be002-f6e5-4898-901c-ec8beb0ecdf8",
                                "sense_id": "a7fc3d43-78a6-3be9-82ac-2bf72100f6c3",
                                "text": "Le tesem est reconnu pour être à l'origine des races de lévriers."
                            }
                        ]
                    }
                ],
