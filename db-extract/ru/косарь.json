                "senses": [
                    {
                        "sense_id": "f5f9c1ee-5c48-3893-8276-217f50a2c9fd",
                        "entry_id": "69453252-7fd6-3a96-b9e1-87a6a78a4089",
                        "glosses": [
                            "жарг. тысяча денежных единиц (рублей, долларов и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c884ba-f46e-49e9-8e57-2febfe09cb37",
                                "sense_id": "f5f9c1ee-5c48-3893-8276-217f50a2c9fd",
                                "text": "Низко живёшь ― попал на «косарь» (тысяча долларов)."
                            },
                            {
                                "example_id": "6d9841dd-d3fa-460c-80e8-8f35b0464260",
                                "sense_id": "f5f9c1ee-5c48-3893-8276-217f50a2c9fd",
                                "text": "За фирму замуж выйти ― это четыре косаря зелёных."
                            },
                            {
                                "example_id": "921126aa-03eb-4689-a9bf-8c36c12a9e5f",
                                "sense_id": "f5f9c1ee-5c48-3893-8276-217f50a2c9fd",
                                "text": "— Два косаря — это две тысячи рублей, так? — уточнил Сергей. — Ну да… Доллары у нас не водятся…"
                            }
                        ]
                    }
                ],
