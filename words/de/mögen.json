    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "961b77bd-2f63-31bf-ae9c-3e3d3751cb44",
                    "sense_definition": "Sympathie oder Gefallen für jemanden oder etwas empfinden; gernhaben",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sympathie_vorliebe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>mag</w> frisches Obst und trinke morgens gerne Orangensaft."
                        },
                        {
                            "text": "Meine Schwester <w>mag</w> Hunde, aber vor großen Pferden hat sie Angst."
                        }
                    ],
                    "synonyms": [
                        "gernhaben"
                    ],
                    "antonyms": [
                        "hassen",
                        "verabscheuen"
                    ],
                    "common_phrases": [
                        "nicht leiden mögen",
                        "gern mögen",
                        "leiden mögen"
                    ]
                },
                {
                    "sense_id": "0cd36141-dfe9-3b00-84ee-1cf5a5ec33e8",
                    "sense_definition": "einen Wunsch oder ein Verlangen haben (häufig im Konjunktiv II: möchte)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wunsch_absicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>möchte</w> bitte eine Tasse Kaffee mit Milch bestellen."
                        },
                        {
                            "text": "Was <w>möchtest</w> du heute Abend mit deinen Freunden machen?"
                        }
                    ],
                    "synonyms": [
                        "wollen"
                    ],
                    "common_phrases": [
                        "haben möchten",
                        "wissen möchten"
                    ]
                },
                {
                    "sense_id": "0f454ddf-88be-31cb-8d34-483ee93d96fd",
                    "sense_definition": "drückt eine Möglichkeit oder eine Vermutung aus; vielleicht zutreffen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moeglichkeit_vermutung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das <w>mag</w> sein, aber ich habe bisher noch keine Bestätigung bekommen."
                        },
                        {
                            "text": "Es <w>mochten</w> wohl zwanzig Personen in dem kleinen Raum gewesen sein."
                        }
                    ],
                    "synonyms": [
                        "können"
                    ],
                    "common_phrases": [
                        "mag sein",
                        "wie dem auch sein mag"
                    ]
                },
                {
                    "sense_id": "dda24179-c84e-31ef-98b7-36e6681fb093",
                    "sense_definition": "drückt eine Einräumung (Konzession) aus; etwas zugeben, das einem anderen Umstand nicht widerspricht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konzession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>mag</w> noch so viel trainieren, gegen den Favoriten hat er keine Chance."
                        },
                        {
                            "text": "Der Vorschlag <w>mag</w> gut klingen, doch in der Praxis ist er kaum durchführbar."
                        }
                    ],
                    "common_phrases": [
                        "mag stimmen"
                    ]
                },
                {
                    "sense_id": "625dbf1a-e940-3f0b-a050-38f1c367a762",
                    "sense_definition": "leitet einen Wunsch, eine Hoffnung oder eine feierliche Aufforderung ein (oft im Konjunktiv I)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "optativ_aufforderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Möge</w> dieses neue Jahr dir viel Gesundheit und Freude bringen."
                        },
                        {
                            "text": "Wer Fragen zu dem Thema hat, der <w>möge</w> sich an den Leiter wenden."
                        }
                    ],
                    "common_phrases": []
                }
            ]
        }
    ]
}