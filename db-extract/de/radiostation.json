                        "target_lang_word": "radiostacja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiostacja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9fd23c-2b24-34f6-94eb-535c0d48a320",
                                        "entry_id": "145871b0-700d-3a17-a228-94e0b6d5b36c",
                                        "glosses": [
                                            "urządzenie radiowe do nadawania, odbioru lub obu tych funkcji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b4d701e-1327-4560-9347-8aaff9bdd6b6",
                                                "sense_id": "5a9fd23c-2b24-34f6-94eb-535c0d48a320",
                                                "text": "Od pięciu tygodni radiostacja nadaje fałszywe meldunki. Rozumiesz? Trzeba oczyścić siatkę, wyeliminować tego, kto zdradził."
                                            },
                                            {
                                                "example_id": "03ad2247-a5c4-4f1d-9f2f-6e76f41c748b",
                                                "sense_id": "5a9fd23c-2b24-34f6-94eb-535c0d48a320",
                                                "text": "Chodzenie w kółko z ciężką radiostacją na plecach to skuteczny sposób na nauczenie się stopni wojskowych, a bicie po twarzy pomaga utrzymać dyscyplinę na zbiórce - wyjaśnili oskarżeni."
                                            },
                                            {
                                                "example_id": "531fc8f2-df84-4350-86c8-04857669e100",
                                                "sense_id": "5a9fd23c-2b24-34f6-94eb-535c0d48a320",
                                                "text": "Gdyby „Nord” miała radiostację, to po awarii akumulatorów i popsuciu się wszystkiego, co mogłoby nawalić, szukano by nas już od miesiąca."
                                            },
                                            {
                                                "example_id": "18bc45e7-2c2a-48f3-abf4-8df93b865358",
                                                "sense_id": "5a9fd23c-2b24-34f6-94eb-535c0d48a320",
                                                "text": "Na trzeciorzędne odcinki posyła się trzeciorzędne oddziały, wyposażone w zdezelowane samochody, rakietnice jako substytut radiostacji i butelki z benzyną w zastępstwie granatników."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
