                        "examples": [
                            {
                                "example_id": "c6a871bc-f1d5-41c2-8668-0eb83598853c",
                                "sense_id": "4d18f2e5-03e5-3622-899a-5ad074442610",
                                "text": "„Für viele Mittelgebirge ist der Baumbestand ein wesentliches Charakteristikum.“"
                            },
                            {
                                "example_id": "f2de1186-4b71-4f5e-a48f-5a2553762d37",
                                "sense_id": "4d18f2e5-03e5-3622-899a-5ad074442610",
                                "text": "„Der Steinkauz ist eine der Vogelarten, der auf die lichten Baumbestände der Streuobstwiesen angewiesen ist.“"
                            }
                        ],
