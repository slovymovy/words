                "senses": [
                    {
                        "sense_id": "fb94108b-c5db-3cba-b196-42192a7a8306",
                        "entry_id": "cd62e5a7-9839-3bed-942b-b184f0233fb3",
                        "glosses": [
                            "противозачаточное средство, мужской презерватив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0d4978-3bf5-4f89-ac78-332fe6989ebc",
                                "sense_id": "fb94108b-c5db-3cba-b196-42192a7a8306",
                                "text": "Опустил немедля начавший коробиться, сделавшийся похожим на линялую шкурку змеи-недомерка кондом в мусорник."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d618f22e-21dd-425e-b1c0-a31ca8557b7c",
                        "source_entry_id": "cd62e5a7-9839-3bed-942b-b184f0233fb3",
                        "source_sense_id": "fb94108b-c5db-3cba-b196-42192a7a8306",
                        "source_sense_description": "список переводов",
                        "target_lang_word": "condom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                        "entry_id": "fcbafb18-2890-3d36-9b90-bf16bd7e7be8",
                                        "glosses": [
                                            "A flexible sleeve made of latex or other impermeable material such as polyurethane or sheepskin, worn over an erect penis during sexual intercourse as a contraceptive or as a way to prevent the spread of STIs during PIV, anal, or oral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abac19e8-c2ef-4390-8ab4-262e02033e55",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "buy a pack of condoms"
                                            },
                                            {
                                                "example_id": "1f7fc4c6-ca6a-4d8d-b2c1-dbac1709d94a",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "flavoured condom"
                                            },
                                            {
                                                "example_id": "6af69a9c-9921-49a6-bb61-39713d8efad2",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "ribbed condoms"
                                            },
                                            {
                                                "example_id": "cf395383-6d98-42ba-aa1c-f455de0c6768",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "However, substantial proportions of participants preferred the nonlatex condom or reported that they would recommend its use to others."
                                            },
                                            {
                                                "example_id": "41e5125e-6d6b-4f1c-8f59-3a7a56de51da",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "We're in the small percentage of cases in which condoms are ineffective. Looks as if you have some sort of supersperm. You must be very proud."
                                            },
                                            {
                                                "example_id": "0dc9de6f-61ab-4d92-bc0e-e0a410b7be62",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "I remember that one time I went to the kiosk next door to buy condoms, it was raining, she appeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa7cbb4-4800-3468-93cc-02a27a5896c3",
                                        "entry_id": "fcbafb18-2890-3d36-9b90-bf16bd7e7be8",
                                        "glosses": [
                                            "Any of various forms of flexible sleeve or barrier, variously shaped for either penetrative or receptive body parts, made of latex or other impermeable material such as polyurethane or sheepskin, worn (by anyone with ) during sexual activity to prevent pregnancy or the spread of STIs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d94db71-8b9c-4e2a-8932-3db3550f9cef",
                        "source_entry_id": "cd62e5a7-9839-3bed-942b-b184f0233fb3",
                        "source_sense_id": "fb94108b-c5db-3cba-b196-42192a7a8306",
                        "source_sense_description": "список переводов",
                        "target_lang_word": "Kondom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kondom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                        "entry_id": "63e869ef-9e33-3231-865e-7c8b6f91d423",
                                        "glosses": [
                                            "eine meist aus Latex bestehende Hülle, die vor dem Geschlechtsverkehr über das männliche Glied gestreift wird, um vor Schwangerschaften und sexuell übertragbaren Krankheiten zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce62c10-b324-4a51-afc3-dea0453bf3ad",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "Die Verwendung von Kondomen wird trotz ihrer Vorteile oft abgelehnt."
                                            },
                                            {
                                                "example_id": "90a1b25e-424e-4936-ab7a-9c950a5059dd",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "Die ersten Kondome bestanden aus Textilien und waren daher sehr unwirksam."
                                            },
                                            {
                                                "example_id": "1b3e5f98-895c-4795-807f-f7061f4ffa47",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "Wegen Latex-Allergien können manche Männer keine Kondome benutzen."
                                            },
                                            {
                                                "example_id": "14c601a0-b8b1-49dc-b2a8-c770be0b7e23",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "Hätte er ein Kondom benutzt, so wäre ihm die Infektion mit HIV womöglich erspart geblieben."
                                            },
                                            {
                                                "example_id": "5212f497-fd44-4c81-abac-4c8e735aee35",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "Kondome können durch Öle oder Fette rissig und dadurch unbrauchbar werden."
                                            },
                                            {
                                                "example_id": "a2eb90a9-d229-4ce8-bd39-73e172020adc",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "„Ich fühle mich so wie als ich zum ersten Mal Kondome kaufen ging.“"
                                            },
                                            {
                                                "example_id": "df16dbd2-19d2-48a4-b2f2-01c683f22447",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "„Vielleicht liegt es daran, dass es in Island Kondome für acht Euro gibt.“"
                                            },
                                            {
                                                "example_id": "08902bcc-1be8-463f-a50c-b3b6444e3dd4",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "„Das Kondom ist wieder da.“"
                                            },
                                            {
                                                "example_id": "131213c4-a518-4f01-bac5-600b1f4c275f",
                                                "sense_id": "d79d50d1-84f9-338a-afd4-880c1c757a8a",
                                                "text": "„Dildos stehen in den Regalen, Kondome liegen in Gläsern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
