                "forms": [
                    {
                        "form_id": "ab087702-75d9-41cc-acac-73674124b888",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "tags": [
                            "plural"
                        ],
                        "form": "patriarchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94af7361-9c1f-33dc-8ed4-fb2247c1abef",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "glosses": [
                            "kerkelijk leider, een belangrijke bisschop"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "42095073-ac5e-340e-8581-9df752f61743",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "glosses": [
                            "de leider van een van de oosterse christelijke kerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b941f035-fa5e-4b0e-9394-ea315045f114",
                                "sense_id": "42095073-ac5e-340e-8581-9df752f61743",
                                "text": "Het nieuws via National Geographic komt op een ongelukkig moment. Het verzakkinggevaar is al langer een reden van zorg voor de drie kerken die de plek beheren. Onenigheid en een gebrek aan financiële middelen hielden een grondige renovatie lange tijd tegen. De Israëlische autoriteiten sloten de graftombe al eens kort in 2015 om veiligheidsredenen, maar in maart 2016 wisten de de oecumenisch patriarch van Constantinopel Bartholomaios I, de Grieks-orthodoxe patriarch Theophilos III en de franciscaanse custos Francesco Patton toch een overeenkomst te sluiten die het herstel moest inleiden."
                            },
                            {
                                "example_id": "259108d9-9391-4d78-80fc-6381c88da9c3",
                                "sense_id": "42095073-ac5e-340e-8581-9df752f61743",
                                "text": "De zondagmis van de Syrisch-orthodoxe patriach Ignatius Aphrem II werd zondag in het Twentse centrum van de geloofsgemeenschap in het klooster St. Ephrem de Syriër in Glane door meer dan 4000 mensen bezocht."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f258559-cf8f-3ffa-bd9e-461a31f83714",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "glosses": [
                            "een van de aartsvaders uit het Oude Testament (Abraham, Isaak, Jacob)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "94323596-c82e-3f38-9249-be8d17619270",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "glosses": [
                            "mannelijk hoofd van de familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f286fea3-851d-4fe4-8c70-ff9309120312",
                                "sense_id": "94323596-c82e-3f38-9249-be8d17619270",
                                "text": "Maar ondanks zijn homo-erotische aanleg hield de Tovenaar wel degelijk van zijn vrouw. En een liefdeloze patriarch kun je hem onmogelijk noemen - zie de zorgzame brieven aan z'n kinderen. In 1946 typeerde zoon Golo hem als 'mijn in vele opzichten lieve, maar in andere weer zeer vervelende vader'. Zoals alle vaders, zou ik bijna zeggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5626f24-b057-3083-9d09-8bb04dc98541",
                        "entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "glosses": [
                            "wijze oude man in het algemeen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a60111a3-8620-4af2-824f-ce0ecedbc848",
                        "source_entry_id": "2dcb51c5-a57e-3d5d-b3f4-f563c7add430",
                        "source_sense_id": "94af7361-9c1f-33dc-8ed4-fb2247c1abef",
                        "source_sense_description": "(religie) kerkelijk leider, een belangrijke bisschop",
                        "target_lang_word": "patriarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f557d17-33d2-3eb9-9400-940ffc9485df",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The highest form of bishop, in the ancient world having authority over other bishops in the province but now generally as an honorary title; in Roman Catholicism, considered a bishop second only to the Pope in rank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a09803b5-6baf-319a-8620-212ad2dea2f9",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "A male leader of a family, tribe or ethnic group, especially one of the twelve sons of Jacob (considered to have created the twelve tribes of Israel) or (in plural) Abraham, Isaac and Jacob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a9823c-2303-4b35-acb0-6f7d127e17fa",
                                                "sense_id": "a09803b5-6baf-319a-8620-212ad2dea2f9",
                                                "text": "Men and brethren / lett me frely ſpeake vnto you of the patriarke David: For he is both deed and buryed / and his ſepulcre remayneth with vs vnto this daye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c42bfd-07aa-3944-811f-096dbba54bc1",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "A founder of a political or religious movement, an organization or an enterprise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "An old leader of a village or community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06aa6563-90d2-4c7c-a60e-9d9b0b5514b1",
                                                "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                                "text": "The opinions of this junto were completely controlled by Nicholas Vedder, a patriarch of the village, and landlord of the inn, at the door of which he took his seat from morning till night, just moving sufficiently to […] keep in the shade of a large tree; […]"
                                            },
                                            {
                                                "example_id": "f607ec51-23f0-422f-a950-27fb10f06150",
                                                "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                                "text": "Fictional male antiheroes like television’s crime patriarchs Tony Soprano and Walter White have reigned for some time, but the antiheroine has only more recently had the opportunity to rise up – and become the cause of her own downfall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa8bda7c-2613-37d1-891f-c09efd4ea362",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The male progenitor of a genetic or tribal line, or of a clan or extended family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a32f3af8-412c-335f-bcf4-afdc43aab1c2",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The male head of a household or nuclear family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f9dd64-e313-4b19-b391-c5c3b7c01953",
                                                "sense_id": "a32f3af8-412c-335f-bcf4-afdc43aab1c2",
                                                "text": "The popular Duck Dynasty television show and Duck Commander products took center stage in a controversy over comments made by Phil Robertson. As patriarch of the family and founder of the company, he stars in the A&E reality show based on his Louisiana life and company."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
