                ],
                "senses": [
                    {
                        "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                        "entry_id": "6adc4f16-cd48-3580-9d94-ac83d6c2a604",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecec2600-1d15-4831-8dc0-82807d6054e8",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Frau Kindle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1e7fcd9f-1fb9-44e6-af10-195d36bd43ca",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Herr Kindle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5cf44489-16b8-4c62-9930-3402acd435df",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Die Kindles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "bf647ed9-f8b3-40db-a2be-de6a8cb0ba4e",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Der Kindle trägt nie die Pullover, die die Kindle ihm strickt."
                            },
                            {
                                "example_id": "3d0616fc-834e-49d0-8606-54772547fa28",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kindle kommt, geht der Herr Kindle.“"
                            },
                            {
                                "example_id": "96eda150-7070-4d22-8792-ddd933429bb5",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Kindle kommt und geht."
                            },
                            {
                                "example_id": "3f59959f-184e-4b2a-9506-5fb358e7eb5d",
                                "sense_id": "2e745562-3b34-35c0-9b45-45bcf4fa9f7d",
                                "text": "Kindles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
