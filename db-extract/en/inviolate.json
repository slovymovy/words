                        "entry_id": "3f03cd9e-ae66-3162-b039-c60a0ce1b47d",
                        "glosses": [
                            "Not violated; free from violation or hurt of any kind; secure against violation or impairment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86a608f-9b9c-45e4-8831-0a75cd9b45b3",
                                "sense_id": "a66c2abe-b5be-3bb2-8426-c27082a0cd91",
                                "text": "His fortune of arms was still inviolate."
                            },
                            {
                                "example_id": "85529aeb-1a4e-465c-a8f2-3bf4e4f42fef",
                                "sense_id": "a66c2abe-b5be-3bb2-8426-c27082a0cd91",
                                "text": "A partner can also, hopefully, be trusted more fully than any other person in our lives. Our courts recognize this by refusing to allow a person to testify against his or her spouse. The sanctity of the home, by which they mean the couple, is inviolate."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d4a42a0-82dd-3ec7-86a8-af6f0f0c42e7",
                        "entry_id": "3f03cd9e-ae66-3162-b039-c60a0ce1b47d",
                        "glosses": [
                            "Incorruptible."
                        ],
                        "tags": [],
                        "examples": [
                            {
