                        {
                            "text": "She spoke in an almost <w>inaudible</w> whisper so nobody else in the room could hear.",
                            "target_lang_translations": {
                                "nl": "Ze sprak op een bijna <w>onhoorbaar</w> fluistertoon, zodat niemand anders in de kamer het kon horen."
                            }
                        }
                    ],
