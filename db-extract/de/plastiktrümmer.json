                        "examples": [
                            {
                                "example_id": "0df7826e-e291-4a8f-81f3-4c8f9f214362",
                                "sense_id": "8e983c55-deaa-32bd-b056-620feb9dfd20",
                                "text": "„Kann er auf seinem Scheißskateboard stehenbleiben, während er mit hundert Stundenkilometern über die plattgewalzten Plastiktrümmer eines Kinderfahrrads gezogen wird?“"
                            },
                            {
                                "example_id": "15c06562-3ec5-4cc2-bd8d-8ae8c11db85b",
                                "sense_id": "8e983c55-deaa-32bd-b056-620feb9dfd20",
                                "text": "Glassplitter, Plastiktrümmer und ein Absperrband. Das explodierte Klo in Fürth hat viel Durcheinander hinterlassen."
                            },
                            {
                                "example_id": "c9a4f9e1-ff5a-43a7-a13f-5965e38dca89",
                                "sense_id": "8e983c55-deaa-32bd-b056-620feb9dfd20",
                                "text": "Den Helfern bietet sich ein grauenvolles Bild: Die Sitzreihen des Regionalzugs sind bis zum vierten Fenster zermalmt, Metall- und Plastiktrümmer ragen aus den Waggons."
                            },
                            {
                                "example_id": "d4bad347-1690-4f32-8a08-efa41b04029f",
                                "sense_id": "8e983c55-deaa-32bd-b056-620feb9dfd20",
                                "text": "Die sind weißblau, luftig, aus Stoffersatz und geräuschärmer als die alten Plastiktrümmer."
                            }
                        ],
