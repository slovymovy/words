                ],
                "senses": [
                    {
                        "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                        "entry_id": "9b1d987b-6812-3448-aa9e-4d230f1a2f79",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236b94ed-fda3-4ff8-bf88-32e784a05908",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gedeon kommt, geht der Herr Gedeon.“"
                            },
                            {
                                "example_id": "28b92449-eef0-457d-985f-fce2e00db195",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Gedeon kommt und geht."
                            },
                            {
                                "example_id": "f6e186a8-762a-4755-a049-c322472af108",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Gedeons kamen, sahen und siegten."
                            },
                            {
                                "example_id": "db030579-bad0-4a52-beb4-3005747a6223",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Frau Gedeon ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eae361a7-906b-4a4f-bae7-ac50a91c7aa8",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Herr Gedeon wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "46ff595b-8fb0-4d44-8602-66633bad0a34",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Die Gedeons fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4b48fe61-4916-4a60-b454-6b94aee3fc5a",
                                "sense_id": "137040f2-96aa-3ea0-914b-fbe1efc284fd",
                                "text": "Der Gedeon trägt nie die Schals, die die Gedeon ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
