                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "人数计数"
                            },
                            {
                                "target_lang_word": "位",
                                "target_lang_sense_clarification": "客人数的礼貌量词"
                            },
                            {
                                "target_lang_word": "客人",
                                "target_lang_sense_clarification": "宾客"
                            }
                        ]
                    }
                },
                {
