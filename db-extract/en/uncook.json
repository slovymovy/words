                "senses": [
                    {
                        "sense_id": "268ca497-579d-360d-94be-10c4881a9222",
                        "entry_id": "3822a7d4-528f-396e-90aa-9befdda5ec32",
                        "glosses": [
                            "To undo the act of cooking."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e5ade4ec-9de2-49a3-bc33-b4a7e58d6da9",
                                "sense_id": "268ca497-579d-360d-94be-10c4881a9222",
                                "text": "You can't uncultivate anything, in the same way you can't uncook your food."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a4a924b-1fb5-3c76-9ddf-b312a002b0d6",
                        "entry_id": "3822a7d4-528f-396e-90aa-9befdda5ec32",
                        "glosses": [
                            "To repair (an MP3 audio file) that has been damaged (\\\"cooked\\\") by being converted through a text format and having line breaks applied to it."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c859252-6887-4e23-ab0f-04102ffdcab8",
                                "sense_id": "1a4a924b-1fb5-3c76-9ddf-b312a002b0d6",
                                "text": "Hi all! I have developed a freeware utility to uncook MP3's..."
                            },
                            {
                                "example_id": "5c26660f-4e2d-4b62-b10e-1d2502ca30a0",
                                "sense_id": "1a4a924b-1fb5-3c76-9ddf-b312a002b0d6",
                                "text": "If you \"uncook\" a file that isn't \"cooked\" you will just mess it up (and I don't know of any way to fix it then) - so uncooking should be used with caution (I'd suggest never over-writing the original file)."
                            }
                        ]
                    }
