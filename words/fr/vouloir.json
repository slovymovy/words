{
    "word_family": [
        "volonté",
        "volontaire",
        "volontiers",
        "involontaire",
        "bénévole",
        "bénévolat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eefa0874-2bc6-3151-9049-5a586912f057",
                    "sense_definition": "Désirer vivement, souhaiter obtenir ou faire quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>veux</w> un verre d'eau fraîche, s'il vous plaît."
                        },
                        {
                            "text": "Les enfants <w>veulent</w> aller au parc pour jouer ensemble."
                        }
                    ],
                    "synonyms": [
                        "désirer",
                        "souhaiter"
                    ],
                    "common_phrases": [
                        "vouloir dire",
                        "en vouloir"
                    ]
                },
                {
                    "sense_id": "375f0a2d-ac47-3e46-9bbc-4e68ee1a8dd6",
                    "sense_definition": "Avoir l'intention résolue de faire quelque chose, s'y déterminer fermement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "determination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>veut</w> réussir ses examens et étudie tous les soirs."
                        },
                        {
                            "text": "Quand on <w>veut</w> vraiment progresser, on trouve toujours du temps."
                        }
                    ],
                    "synonyms": [
                        "décider",
                        "résoudre"
                    ],
                    "common_phrases": [
                        "vouloir c'est pouvoir"
                    ]
                },
                {
                    "sense_id": "f0273dcf-55d6-319a-ba95-0942e5bc485c",
                    "sense_definition": "Accepter une proposition ou consentir avec bienveillance à faire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous le <w>voulez</w> bien, nous commencerons la réunion tout de suite."
                        },
                        {
                            "text": "Mon ami a bien <w>voulu</w> me prêter son vélo pour le week-end."
                        }
                    ],
                    "synonyms": [
                        "consentir",
                        "accepter"
                    ],
                    "common_phrases": [
                        "vouloir bien",
                        "si vous voulez bien"
                    ]
                },
                {
                    "sense_id": "927e2148-f597-3ff5-bbe5-2ba24397fd3f",
                    "sense_definition": "Exiger impérativement, commander en vertu d'une autorité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur <w>veut</w> que le rapport soit terminé avant midi."
                        },
                        {
                            "text": "La loi <w>veut</w> que chaque conducteur respecte la vitesse maximale autorisée."
                        }
                    ],
                    "synonyms": [
                        "exiger",
                        "ordonner"
                    ]
                },
                {
                    "sense_id": "46923a54-66fa-3906-9e10-47d37396159f",
                    "sense_definition": "Refuser de fonctionner ou de céder sous l'action humaine, en parlant d'une chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moteur ne <w>veut</w> pas démarrer malgré plusieurs tentatives ce matin."
                        },
                        {
                            "text": "Cette vieille porte en bois ne <w>veut</w> plus s'ouvrir correctement."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré en tournure négative"
                        }
                    ]
                },
                {
                    "sense_id": "cb04d1cf-ecf9-3cc2-ba32-2196f3019930",
                    "sense_definition": "Nécessiter des soins, des conditions ou des mesures spécifiques pour réussir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "necessity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante rare <w>veut</w> une exposition modérée au soleil pour bien grandir."
                        },
                        {
                            "text": "Une négociation aussi délicate <w>veut</w> beaucoup de patience et de tact."
                        }
                    ],
                    "synonyms": [
                        "nécessiter",
                        "demander"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cf5b8b5-6e73-3854-9112-4ecd9dd977cc",
                    "sense_definition": "Faculté de se déterminer et d'agir, force de la volonté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "willpower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré sa fatigue extrême, l'athlète puise dans son propre <w>vouloir</w> pour continuer."
                        },
                        {
                            "text": "Elle a fait preuve d'un <w>vouloir</w> inébranlable tout au long de sa carrière."
                        }
                    ],
                    "synonyms": [
                        "volonté"
                    ],
                    "antonyms": [
                        "aboulie"
                    ],
                    "common_phrases": [
                        "bon vouloir",
                        "mauvais vouloir"
                    ]
                }
            ]
        }
    ]
}