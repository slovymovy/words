                "senses": [
                    {
                        "sense_id": "dea2a4b3-6c82-377d-8b52-04d2dd7f380e",
                        "entry_id": "cbc9cda2-8882-3b91-9198-598c31465298",
                        "glosses": [
                            "een zeer grote zee tussen verschillende werelddelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d53e8a-339c-4121-acd9-afe8509d701b",
                                "sense_id": "dea2a4b3-6c82-377d-8b52-04d2dd7f380e",
                                "text": "Koraalriffen zijn van levensbelang voor het leven in de oceanen en daardoor ook voor de mensheid. 25 procent van het zeeleven leeft in en rond koraalriffen. Ze zijn van belang voor de visserij, toerisme en bescherming van kustlijnen tegen erosie en stormen. Het is nog onduidelijk of en wanneer het huidige proces van verbleking stopt."
                            },
                            {
                                "example_id": "ff68fb90-881d-4796-8afe-c4e215df0666",
                                "sense_id": "dea2a4b3-6c82-377d-8b52-04d2dd7f380e",
                                "text": "Ze reageerde altijd verontwaardigd ‘Waarom ik altijd? Mijn zusje kan ook ontsporen hoor!’ Maar zolang alles goed en gezond bleef aan beide kanten van de oceaan kon ik met een gerust hart doorlopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb52760f-14b5-4331-823a-08318e2d0319",
                        "source_entry_id": "cbc9cda2-8882-3b91-9198-598c31465298",
                        "source_sense_id": "dea2a4b3-6c82-377d-8b52-04d2dd7f380e",
                        "source_sense_description": "een zeer grote zee tussen verschillende werelddelen",
                        "target_lang_word": "Ozean",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ozean",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                        "entry_id": "b407583a-f9b1-34fd-9434-6b0c702257e8",
                                        "glosses": [
                                            "großes zusammenhängendes Gewässer der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c891cc08-cb62-4e34-b87c-7ca239e9fada",
                                                "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                                "text": "In Hamburg an der Elbe, gleich hinter dem Ozean."
                                            },
                                            {
                                                "example_id": "1cc479ae-1112-4a79-9fa9-dae01ab1124d",
                                                "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                                "text": "„Forscher aus Deutschland und der Schweiz konnten nun anhand von Computersimulationen Veränderungen bei der Plattentektonik nachweisen, die letztlich zu den heutigen Landmassen, Ozeanen und womöglich auch zu unserer Atmosphäre geführt haben.“"
                                            },
                                            {
                                                "example_id": "a410c1cb-79e8-46ab-8939-6c96e5c5eb7d",
                                                "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                                "text": "„Es handelt sich um eines jener Gebiete der Ozeane, deren Wasser praktisch sauerstofffrei ist und die deshalb Todeszonen genannt werden.“"
                                            },
                                            {
                                                "example_id": "2a6a8f00-c525-4960-8cc0-90fd1425a5a9",
                                                "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                                "text": "„Er hatte dem Ozean den Rücken zugekehrt und versuchte sich eine Zigarette anzuzünden.“"
                                            },
                                            {
                                                "example_id": "fa36b040-4deb-46b3-811a-0099d0b8b1d2",
                                                "sense_id": "a2f40941-fe7a-3c46-8973-3204388a26ae",
                                                "text": "„Zwischen den 1950er und 80er Jahren wurde nuklearer Abfall als günstige und einfache Lösung im Ozean verklappt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99aa75d1-8a10-4398-8227-af1859df6b04",
                        "source_entry_id": "cbc9cda2-8882-3b91-9198-598c31465298",
