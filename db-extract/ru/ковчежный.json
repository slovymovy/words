                                ]
                            },
                            {
                                "target_word": "arc",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c35053-4ef1-3a73-97b5-5d06fed9ab14",
                                        "entry_id": "8a1427c9-4903-3643-9094-cb940b9b2279",
                                        "glosses": [
                                            "To move following a curved path."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fb642c2-9dae-4238-942e-3d842e047c64",
                                                "sense_id": "a6c35053-4ef1-3a73-97b5-5d06fed9ab14",
                                                "text": "A warring bloodhunter detected it and skillfully arced his sword through its spinal column before it could return to follow through with its attack."
                                            },
                                            {
                                                "example_id": "934f5393-62db-437f-b9d7-3cd011c563f9",
                                                "sense_id": "a6c35053-4ef1-3a73-97b5-5d06fed9ab14",
                                                "text": "Gatland's side got back to within striking distance when fly-half Jones's clever pass sent centre Jonathan Davies arcing round Shontayne Hape."
                                            },
                                            {
                                                "example_id": "2b673fa7-ccb8-4834-90cb-e712a90d3e46",
                                                "sense_id": "a6c35053-4ef1-3a73-97b5-5d06fed9ab14",
                                                "text": "The big wheel in the sky\nHe arcs o'er miles and miles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c718179b-56d2-3d20-a681-e3364775fa7a",
                                        "entry_id": "8a1427c9-4903-3643-9094-cb940b9b2279",
                                        "glosses": [
                                            "To shape into an arc; to hold in the form of an arc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdeb0b6-be52-43e3-ab92-fea898bd0676",
                                                "sense_id": "c718179b-56d2-3d20-a681-e3364775fa7a",
                                                "text": "His mother, her eyes raised to heaven, hands arked before her, moving, made real for John that patience, that endurance, that long suffering, which he had read in the Bible and found so hard to image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde80e3f-6817-33fa-80aa-614fe00f49c5",
