                {
                    "sense_id": "999a37ed-b568-3492-97b0-50df06e6c248",
                    "sense_definition": "Clean, tidy, and organized; free from dirt or clutter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "orderly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My room is <w>neat</w> because I tidied it this morning.",
