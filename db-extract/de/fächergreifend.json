                ],
                "senses": [
                    {
                        "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                        "entry_id": "b8819097-6865-3a43-9dfe-9fbb9b6f0887",
                        "glosses": [
                            "mehrere Fächer/Themen/Disziplinen betreffend, in mehreren Fächern zu behandeln"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "897329b4-ebb3-4f43-adc9-72f904e939f7",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Welche weiteren Inhaltsfelder und Ziele müssen an hessischen Schulen als Querschnittsaufgaben bzw. fächergreifend vermittelt werden?“"
                            },
                            {
                                "example_id": "3f67b3a3-d9eb-45c4-9344-677401b8747f",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Gesellschaftsorientierte, fächergreifende Problemstellungen sollen Priorität vor den fachspezifischen haben.“"
                            },
                            {
                                "example_id": "a7b6206a-ea46-4249-aafe-5545e8e2ccec",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Als es im Unterricht hieß, sich fächergreifend in den Klassen 8 und 9 für ein Projekt einzutragen, entschieden sich die fünf Schülerinnen der Förderschule, regelmäßig alte und pflegebedürftige Menschen im Haus Heimberg zu besuchen.“"
                            },
                            {
                                "example_id": "f2630a9e-aa83-4c7e-8203-c4219f9f3452",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Diese könnte man dann tatsächlich als fächergreifend gelten lassen.“"
                            },
                            {
                                "example_id": "7d147ccc-23a0-41c0-bb3b-1aef5ecfb2e6",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Diese fächergreifenden Themen stehen auf der To-do-Liste aller Lehrkräfte für alle Altersstufen und über alle Schultypen hinweg.“"
                            },
                            {
                                "example_id": "fc47a9d5-8dac-49c2-ab7b-de98704c9cb7",
                                "sense_id": "e0233827-e608-3cdc-b058-185b7d4cd0dc",
                                "text": "„Das fächergreifende, innovative Querdenken ist gefragt, allerdings kombiniert mit profunden Kenntnissen des Datenverarbeitens und mit den Kenntnissen der Grundlagen der Ingenieurwissenschaften – der Biologie sowieso –, die dem biologisch orientierten Bioniker den Umgang mit anderen Naturwissenschaftlern, Ingenieuren und Technikern ermöglicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
