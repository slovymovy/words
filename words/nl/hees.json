                    "frequency": "Middle",
                    "semantic_group_id": "stemgeluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat heb je toch een <w>hese</w> stem vandaag!",
                            "target_lang_translations": {
