            "senses": [
                {
                    "sense_id": "a4240ab8-0c75-39e6-a0a4-a38e499af002",
                    "sense_definition": "Describing a person who is unfaithful to their romantic partner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjective_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to leave her <w>cheating</w> husband after discovering the truth.",
                            "target_lang_translations": {
                                "ru": "Она решила уйти от своего <w>неверного</w> мужа, узнав правду.",
                                "tr": "Gerçeği öğrendikten sonra kendisini <w>aldatan</w> kocasını terk etmeye karar verdi."
                            }
