                "senses": [
                    {
                        "sense_id": "8205ebe2-e891-35ca-8349-19b992084cc6",
                        "entry_id": "1db7aeec-d0a5-3758-8657-d58a071b428b",
                        "glosses": [
                            "жидкое или газообразное вещество, применяемое для передачи тепловой энергии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9aa5dbf-5a8e-448a-924c-fbe2abb30624",
                                "sense_id": "8205ebe2-e891-35ca-8349-19b992084cc6",
                                "text": "В качестве теплоносителя используется этиленгликоль, что позволило избавиться от огромного количества ремонтных работ систем отопления."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "803641e6-e6ce-42a4-b0b2-295a2bc331ee",
                        "source_entry_id": "1db7aeec-d0a5-3758-8657-d58a071b428b",
                        "source_sense_id": "8205ebe2-e891-35ca-8349-19b992084cc6",
                        "target_lang_word": "coolant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                        "entry_id": "029bb350-e5e0-37c2-b0e7-e59bf6de9640",
                                        "glosses": [
                                            "A medium, usually fluid, used to draw heat from an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d636eb25-3c91-43c6-8c15-3e190c3832af",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Coolant is used in car engines and industrial processes, where excess heat could cause machine damage."
                                            },
                                            {
                                                "example_id": "b97c4eb3-45cc-4cf9-9f5e-02102b1eb0d8",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Anti-freeze has not been found necessary, even in the most severe conditions, since the water is drained out if a locomotive spends any appreciable time out of service and in normal working conditions the coolant is always warm."
                                            }
                                        ]
                                    }
                                ]
                            }
