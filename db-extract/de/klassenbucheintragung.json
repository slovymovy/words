                "senses": [
                    {
                        "sense_id": "3d02e934-6d00-3d98-9727-e307d72e6f9e",
                        "entry_id": "0b745e40-8c11-3b36-a725-99f91d81cb1f",
                        "glosses": [
                            "Vermerk im Klassenbuch über ein Fehlverhalten eines Schülers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e32d806-955d-4411-9e8b-92de4efccaed",
                                "sense_id": "3d02e934-6d00-3d98-9727-e307d72e6f9e",
                                "text": "„Bei diesem Gespräch wurde auf zahlreiche Beschwerden von Lehrern über das Verhalten des Beschwerdeführers sowie auf zwei Klassenbucheintragungen hingewiesen.“"
                            },
                            {
                                "example_id": "0538ae78-e0fa-4486-99d1-bc962207fc70",
                                "sense_id": "3d02e934-6d00-3d98-9727-e307d72e6f9e",
                                "text": "„Auch Klassenbucheintragungen sowie zusätzliche Übungsaufgaben sind die Regel.“"
                            },
                            {
                                "example_id": "68127e2f-0f47-48d2-a0fc-875e9fa782ee",
                                "sense_id": "3d02e934-6d00-3d98-9727-e307d72e6f9e",
                                "text": "„Nur daß alles vom Gewicht der Letztmaligkeit beschwert sein würde: Vorbereiten und Prüfen und Fehlen und Schwänzen und Schularbeiten und Klassenbucheintragungen und Sehrgut und Nichtgenügend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
