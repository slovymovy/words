                    {
                        "form_id": "ea29703e-7424-44d4-ab6f-185c8935a90f",
                        "entry_id": "be06778d-f6f3-3402-b4d2-86f6608d7233",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fallzahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d7f315d-1800-36e8-84db-102d69bfeb89",
                        "entry_id": "be06778d-f6f3-3402-b4d2-86f6608d7233",
                        "glosses": [
                            "Summe der Fälle (der eingetretenen Ereignisse, die man beobachtet)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "1a69100a-ff74-4d17-83a1-61dd48d56c4a",
                                "sense_id": "9d7f315d-1800-36e8-84db-102d69bfeb89",
                                "text": "„Die Politisch Motivierte Kriminalität (PMK) stellt eine der größten Herausforderungen für die Sicherheitsbehörden in Deutschland dar. Die Fallzahlen für das Jahr 2018 wurden von Bundesinnenminister Horst Seehofer gemeinsam mit dem Präsidenten des Bundeskriminalamtes, Holger Münch, am 14. Mai 2019 in Berlin vorgestellt.“"
                            },
                            {
                                "example_id": "3f8b77ed-74b9-45b7-abc7-a28ef0e8dda2",
                                "sense_id": "9d7f315d-1800-36e8-84db-102d69bfeb89",
                                "text": "„Die Fallzahl wird anhand des Patientenzu- und -abgangs ermittelt. In der Krankenhausstatistik wird zwischen einrichtungs- und fachabteilungsbezogener Fallzahl unterschieden.“"
                            },
                            {
                                "example_id": "92fc66cc-6c43-484c-9e54-acb7b47e17e4",
                                "sense_id": "9d7f315d-1800-36e8-84db-102d69bfeb89",
                                "text": "„Aus Gründen der Transparenz wurden hier in der vergangenen Woche sowohl die Fallzahlen dargestellt, die das Landeszentrum Gesundheit (LZG NRW) für Nordrhein-Westfalen gemäß § 11 Infektionsschutzgesetz (IfSG) erfasst und dem Robert Koch-Institut (RKI) in Berlin meldet, als auch die Fallzahlen, die dem Ministerium direkt von den kommunalen Krisenstäben übermittelt wurden.“"
                            },
                            {
                                "example_id": "3463102d-8fa9-48d2-971a-fb2fcfa869aa",
                                "sense_id": "9d7f315d-1800-36e8-84db-102d69bfeb89",
                                "text": "„Die Fallzahl bezeichnet die Anzahl der Personen (oder Untersuchungselemente), die in einer Stichprobe enthalten sind. Die Fallzahlen bilden die Basis für Hochrechnungen und Prozentuierungen sowie für die Berechnung der statistischen Schwankungsbreite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fffd41a0-d114-3d80-8005-18fcea87e75d",
                        "entry_id": "be06778d-f6f3-3402-b4d2-86f6608d7233",
                        "glosses": [
                            "Zeit, die ein Stab benötigt, um durch ein Mehl-Wasser-Gemisch zu fallen"
                        ],
                        "tags": [
                            "Messmethode",
                            "für Getreidemehl"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb2d395-f625-4adb-b319-00b5f3739afc",
                                "sense_id": "fffd41a0-d114-3d80-8005-18fcea87e75d",
                                "text": "Die Fallzahl für Roggenmehl muss höher als 75 s liegen, um daraus ein qualitativ gutes Brot backen zu können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
