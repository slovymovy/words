                "senses": [
                    {
                        "sense_id": "eb970654-85b6-3fe1-8711-9289f5faf0c0",
                        "entry_id": "836359e6-062f-3c23-a96e-fc5964a2181f",
                        "glosses": [
                            "житель Галисии"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e8dc26f2-47ba-32e6-8388-7b64b76477ca",
                        "entry_id": "836359e6-062f-3c23-a96e-fc5964a2181f",
                        "glosses": [
                            "этнолог. представитель народа, исторически населяющего Галисию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798db7cc-177a-4c03-87c6-5842f6e01c34",
                                "sense_id": "e8dc26f2-47ba-32e6-8388-7b64b76477ca",
                                "text": "А Испания ― да, многонациональна, там кроме собственно испанцев (кастильцев) живут еще каталонцы, баски, галисийцы ну и по мелочи арагонцы и некоторые другие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62f02819-98f6-416e-8384-137fd6347838",
                        "source_entry_id": "836359e6-062f-3c23-a96e-fc5964a2181f",
                        "source_sense_description": "житель Галисии",
                        "target_lang_word": "Galician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8aee29-2d9c-362c-8b26-c16d7ab52f4b",
                                        "entry_id": "dc9d339a-ba0c-3e14-b5f5-3734ea6133ee",
                                        "glosses": [
                                            "Of, from or relating to Galicia, Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6489a41e-7d39-40eb-9781-37b38dd7c30d",
                                                "sense_id": "6f8aee29-2d9c-362c-8b26-c16d7ab52f4b",
                                                "text": "The subsequent oil slicks that reached the coast resulted in severe ecological and economic consequences for the Galician coast and the Bay of Biscay."
                                            },
                                            {
                                                "example_id": "03d01f4d-be22-4068-8e99-6945eb9ac90d",
                                                "sense_id": "6f8aee29-2d9c-362c-8b26-c16d7ab52f4b",
                                                "text": "\"I have been asked over by Dr. Maupuis of the Institut Métapsychique to see some of the experiments which he is conducting upon a Galician medium.\""
                                            },
                                            {
                                                "example_id": "439f4551-0ded-4fe4-8756-1eebb326e488",
                                                "sense_id": "6f8aee29-2d9c-362c-8b26-c16d7ab52f4b",
                                                "text": "The \"entierro de la sardina,\" the burial of the sardine, is a Galician custom popular in many villages on Ash Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce54b1cd-60c9-3a20-85c6-d44fdd03b485",
                                        "entry_id": "dc9d339a-ba0c-3e14-b5f5-3734ea6133ee",
                                        "glosses": [
                                            "Of or pertaining to the Galician language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f10e294-5df3-4e7d-930c-328338036ca2",
                                                "sense_id": "ce54b1cd-60c9-3a20-85c6-d44fdd03b485",
                                                "text": "This vowel is similar to the Catalan sound in the words Jordi or sola and to the Galician sound in the words ola or po."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Galician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a526e193-e1c3-3919-be4d-559ad6e1134f",
                                        "entry_id": "e39056e8-0d03-307c-80ab-9619542e19ba",
                                        "glosses": [
                                            "A native or inhabitant of Galicia, Spain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10813bb-18e1-423e-a0a8-77fc7fc0395f",
                                                "sense_id": "a526e193-e1c3-3919-be4d-559ad6e1134f",
                                                "text": "The little Galician was sitting nibbling a biscuit with a glass of red wine before him."
                                            },
                                            {
                                                "example_id": "85bdef14-3dcb-4ab6-ba5c-859130cbe77d",
                                                "sense_id": "a526e193-e1c3-3919-be4d-559ad6e1134f",
                                                "text": "In Argentina, too, there is a community of Welsh-speakers. Similarly some Galicians, Catalans and Basques have retained their mother tongues in ways that had they remained, respectively in the United Kingdom or Spain, might have been more difficult to do."
                                            },
                                            {
                                                "example_id": "52373d78-22f1-410f-a0b1-7dcef553368f",
                                                "sense_id": "a526e193-e1c3-3919-be4d-559ad6e1134f",
                                                "text": "The Portuguese claim that a Galician would never be generous, as a Portuguese would. On their side, the Galicians tell the story of the Portuguese who invites some Galicians to dinner and then gives his guests very little to eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66544cea-832c-32b9-b633-64fe6fc62223",
                                        "entry_id": "e39056e8-0d03-307c-80ab-9619542e19ba",
                                        "glosses": [
                                            "The language of Galicia; a Romance language spoken in the northwestern corner of the Iberian peninsula."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7af5df-9427-43a2-844b-361291707e9e",
                                                "sense_id": "66544cea-832c-32b9-b633-64fe6fc62223",
                                                "text": "Rosalia de Castro became a crucial element in this early nationalist cultural campaign: she spoke Galician as her first language and she was literate, educated, and sympathetic to the group's progressive aims."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Galician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f907fd5a-6cc1-337a-a3d8-802befba8014",
                                        "entry_id": "0734ad5c-9b7a-3475-a89a-a9c9cd6e753b",
                                        "glosses": [
                                            "Of, from or relating to Galicia, a geographic region in Poland and Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a8050a-0ff1-4d92-af71-a3e907627805",
                                                "sense_id": "f907fd5a-6cc1-337a-a3d8-802befba8014",
                                                "text": "Victor Adler was born in a small Moravian town on the Galician border."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Galician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78aa5294-daa5-3d2c-8579-656880c4f76f",
                                        "entry_id": "d7c9daac-7809-3ff6-aa92-d1ac9b0692ef",
                                        "glosses": [
                                            "A native or inhabitant of Galicia, a geographic region in Poland and Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9991eb-ce60-45f6-a9fc-cec58108f7ea",
                                                "sense_id": "78aa5294-daa5-3d2c-8579-656880c4f76f",
                                                "text": "According to Manuilsky, some Galicians idealized the Austro-Hungarian past for the empire's promotion of national autonomy, yet the Habsburgs had discouraged Eastern Galicia's economic development, whereas the Soviet power would 'turn Lviv into one of the biggest industrial centres of Soviet Ukraine.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
