                                "sense_id": "fa21fd4f-8350-3aa0-87e4-8a3343a376de",
                                "text": "„Tatsächlich war die Stellung Ostrumeliens nicht allzusehr von der des Fürstentums Bulgarien verschieden.“"
                            },
                            {
                                "example_id": "9ecba2b9-8e3f-48be-a96c-9aa5845c3f4f",
                                "sense_id": "fa21fd4f-8350-3aa0-87e4-8a3343a376de",
                                "text": "„Nach einem Vorschlag der Briten erhielt das Land den Namen Ostrumelien.“"
                            }
