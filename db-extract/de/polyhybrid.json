                    {
                        "form_id": "18a32226-8fe8-4559-93e6-08dcf71c3822",
                        "entry_id": "6f5a29e6-a508-3ae0-a762-5572f91ab25f",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind polyhybrid"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                        "entry_id": "6f5a29e6-a508-3ae0-a762-5572f91ab25f",
                        "glosses": [
                            "verschiedene (und nicht nur ein unterschiedliches) Erbmerkmale aufweisend, die von den Eltern auf die Kinder übertragen werden"
                        ],
                        "tags": [
                            "Genetik",
                            "Pflanzenzucht",
                            "Tierzucht"
                        ],
                        "examples": [
                            {
                                "example_id": "6dfd5709-66cc-4f7d-b4fd-dc78ac436d34",
                                "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                                "text": "„Die Kartoffel ist hochgradig polyhybrid und wird deshalb nur vegetativ vermehrt.“"
                            },
                            {
                                "example_id": "402bea76-15eb-4ed8-b85c-6af31e272b82",
                                "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                                "text": "„Man kann reine Linien miteinander kreuzen, die sich nur in einem Allelenpaar voneinander unterscheiden. Dann erhält man eine monohybride Kreuzung. Wenn sich zwei miteinander gekreuzte reine Linien in zwei oder mehr Merkmalspaaren unterscheiden, ist die Kreuzung dihybrid, trihybrid .... polyhybrid.“"
                            },
                            {
                                "example_id": "3629605c-2dc6-447b-8b03-dbc835e573bc",
                                "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                                "text": "„Bei einem dihybriden oder polyhybriden Erbgang (polyhybrid) spalten die einzelnen Genorte (d.h. die Allelenpaare der Genorte) und damit auch die jeweils bedingten Merkmale in der F2 unabhängig voneinander auf, d.h., sie werden unabhängig voneinander vererbt und sind frei miteinander kombinierbar.“"
                            },
                            {
                                "example_id": "b6e556e8-7a60-4a08-a646-aca4f0f667ed",
                                "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                                "text": "„Der Erbgang der Anomalie soll nach Roch ein polyhybrid rezessiver sein, indessen erklärt dies nicht, warum etwa siebenmal häufiger das weibliche als das männliche Geschlecht betroffen wird.“"
                            },
                            {
                                "example_id": "5d8ba4be-2f1d-4f23-b1ef-9ec9f42817ca",
                                "sense_id": "3a63d363-8fe5-3598-9551-3c9d35446de9",
                                "text": "[Der Biologe] „ist sogar imstande,“ […] „die Zahl der möglichen Kombinationen von zwei Idioplasmen. je nachdem sie sich voneinander in einem, in zwei, drei oder mehr Erbfaktoren unterscheiden, also mono-, di-, tri- bis polyhybrid sind, im voraus zu berechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
