                "senses": [
                    {
                        "sense_id": "e23a3e50-d627-34cf-a271-3c474cbc4715",
                        "entry_id": "63fc4dc1-d17c-322f-95cd-a013b194c682",
                        "glosses": [
                            "Enlever son apparence brumeuse à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f122fc-be82-4276-8002-becb07a6ff3e",
                                "sense_id": "e23a3e50-d627-34cf-a271-3c474cbc4715",
                                "text": "Trois échéances qui devraient « débrumiser », si l’on ose dire, un paysage politique plutôt confus, plutôt attristant."
                            }
                        ]
                    },
                    {
                        "sense_id": "2af2a785-ce95-3f17-b305-4d4ce3d51e1b",
                        "entry_id": "63fc4dc1-d17c-322f-95cd-a013b194c682",
                        "glosses": [
                            "Faire s'évaporer la condensation qui se forme sur les vitres, les pare-brises, les glaces, etc."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b2928fba-fd31-4f71-96f7-fb97161f2260",
                                "sense_id": "2af2a785-ce95-3f17-b305-4d4ce3d51e1b",
                                "text": "Il est idéal pour décongeler ou débrumiser les vitres et les pare-brise."
                            },
                            {
                                "example_id": "fdca29b6-2fc4-43b1-81bf-ac5555ea16b9",
                                "sense_id": "2af2a785-ce95-3f17-b305-4d4ce3d51e1b",
                                "text": "Multifonction : convient pour dégivrer ou débrumiser les fenêtres et les pare-brise."
                            }
                        ]
                    }
