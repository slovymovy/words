                "senses": [
                    {
                        "sense_id": "259fc13b-f066-3f27-b71d-4cc1c08595d4",
                        "entry_id": "810d11c7-d3fb-30a0-a63a-c00ffbb3d38f",
                        "glosses": [
                            "Grand vêtement composé d’un voile et d’un manteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7482fac9-1df2-42b8-a0b8-cbfdf770fd2d",
                                "sense_id": "259fc13b-f066-3f27-b71d-4cc1c08595d4",
                                "text": "La Mère tient l’Enfant assis sur les genoux, l’un et l’autre portant leur regard dans l’axe. Le voile-manteau cache en partie de la robe. Au dos, une cavité creusée dans le bois était destinée à abriter des reliques."
                            },
                            {
                                "example_id": "a12ab029-34a6-46a4-8eb3-7b17b43a49f2",
                                "sense_id": "259fc13b-f066-3f27-b71d-4cc1c08595d4",
                                "text": "La Vierge est vêtue d’une robe et d’une guimpe ornée d’un feston brodé. Le voile-manteau qui lui recouvre les épaules retombes en lourds plis cassés. Un voile court encadre son visage aux traits doux et juvéniles."
                            },
                            {
                                "example_id": "158e91e3-fb0d-402b-934e-ca3b5026f53b",
                                "sense_id": "259fc13b-f066-3f27-b71d-4cc1c08595d4",
                                "text": "Son vêtement est identique à celui de la Vierge de Bayonne, un voile-manteau posé en arrière sur la chevelure, protégé ici par une résille portée sur le haut du crâne, et dont les pans retombant sur les épaules se croisent au niveau de la poitrine, dessinant un grand drapé transversal avant de retomber en cascade de plis tuyautés, sur le bras gauche et sous la main droite."
                            }
                        ]
                    }
