                        "cross_references": [
                            {
                                "target_word": "epizeuxis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "031e0e32-df93-31fb-946c-e259089199df",
                                        "entry_id": "e50bf779-4d52-31f0-b367-ffd9e1041285",
                                        "glosses": [
                                            "The repetition of words in immediate succession for emphasis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c916e3-69a0-4477-95c2-f9112f365a4e",
                                                "sense_id": "031e0e32-df93-31fb-946c-e259089199df",
                                                "text": "An Epizeuxis twice a word repeats,\nAnd graces thus the theme on which it treats."
                                            },
                                            {
                                                "example_id": "69549a68-6544-4f43-8094-275649de3048",
                                                "sense_id": "031e0e32-df93-31fb-946c-e259089199df",
                                                "text": "Wikipedia weds this ranging interest to the kind of pertinence where Larry David's “Pretty, pretty good!” is given as an example of rhetorical epizeuxis."
                                            },
                                            {
                                                "example_id": "d297325c-62a7-488c-96a4-f940fe44c9c5",
                                                "sense_id": "031e0e32-df93-31fb-946c-e259089199df",
                                                "text": "'O horror, horror, horror', Macduff cries, his epizeuxis reflecting a lack in the symbolic order itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
