                                        "entry_id": "45afe1b5-eda0-39e2-b5a0-9539b6006a86",
                                        "glosses": [
                                            "разг. уничиж. тупой человек, глупец, дурак"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ffe5cc-64e2-47e3-9098-846305440a43",
                                                "sense_id": "44cad26e-2860-3da4-b4e6-cd2795225c71",
                                                "text": "Он такой тупица! Не хочу разговаривать с тупицами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bdcf6b4-8d8c-4637-9c85-097120e8dc75",
                        "source_entry_id": "499d490d-c1ab-3925-a562-23c1b71d557d",
                        "source_sense_description": "piece of feces",
                        "target_lang_word": "Klabusterbeere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klabusterbeere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3486e220-c26c-3a9b-809c-aef4354bf005",
                                        "entry_id": "f7a36af8-8fc4-3cc5-895c-1794f1299aac",
                                        "glosses": [
                                            "an den Haaren um den Afterbereich klebende, aus Kot bestehende Kügelchen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd962935-dc32-43f2-b0d7-95ebfda9e994",
                                                "sense_id": "3486e220-c26c-3a9b-809c-aef4354bf005",
                                                "text": "„Du kannst dir meine Klabusterbeeren vom Arsch pflücken und behalten!“"
                                            },
                                            {
                                                "example_id": "5974ed09-974f-4bfc-b05f-aacc9a241814",
                                                "sense_id": "3486e220-c26c-3a9b-809c-aef4354bf005",
                                                "text": "„Frau Wirtin hatt' auch einen Arsch, | der stank mitunter ganz barbar'sch. | Er trug Klabusterbeeren, | dran fraßen sich die Filzläus' satt. | Einjeder muss sich nähren!“"
                                            },
                                            {
                                                "example_id": "110f92e0-f894-44be-80a7-7f9836ee3dcb",
                                                "sense_id": "3486e220-c26c-3a9b-809c-aef4354bf005",
                                                "text": "„Wer vögelt, daß die Scheiße spritzt | Daß die Klabusterbeeren rasseln | Die Eier aneinanderprasseln, | Dem sei dies volle Glas geweiht!“"
                                            },
                                            {
                                                "example_id": "6fade6c2-fb37-4869-a61a-a4449adf1937",
                                                "sense_id": "3486e220-c26c-3a9b-809c-aef4354bf005",
                                                "text": "„Weil es zufällig Ihrer Klabusterbeere von Gehirn genügt, in der Zeit, wo Sie sich nicht fortpflanzen, Statistik über Kotsteine zu betreiben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c978d502-945c-32b3-a8ad-bff0e0f250d5",
                                        "entry_id": "f7a36af8-8fc4-3cc5-895c-1794f1299aac",
                                        "glosses": [
                                            "„knotenförmig hervortretende Erweiterung der Mastdarmvenen um den After herum“"
