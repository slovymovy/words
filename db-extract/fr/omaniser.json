                "senses": [
                    {
                        "sense_id": "68b815db-51f7-30dd-a0db-5c69e0d3abd6",
                        "entry_id": "5fc8bba7-5112-364d-a17e-83fd03971c07",
                        "glosses": [
                            "Donner un caractère omanais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55fbd628-bf8c-4cf0-9925-8422f13a7c51",
                                "sense_id": "68b815db-51f7-30dd-a0db-5c69e0d3abd6",
                                "text": "Le sultanat est décidé à « omaniser » son marché du travail."
                            },
                            {
                                "example_id": "a606a429-6fec-4d9c-a5a4-dff3381b2ae8",
                                "sense_id": "68b815db-51f7-30dd-a0db-5c69e0d3abd6",
                                "text": "Au cours des années, les autorités ont fait adopter une législation visant à « omaniser » un certain nombre d'emplois et ont offert au secteur privé des avantages fiscaux pour favoriser l’embauche de nationaux."
                            },
                            {
                                "example_id": "00bcbde8-c08a-424d-a60c-00f94a996f87",
                                "sense_id": "68b815db-51f7-30dd-a0db-5c69e0d3abd6",
                                "text": "Les voies de la transition peuvent se résumer en trois impératifs : diversifier, privatiser et « omaniser »."
                            }
                        ]
                    }
