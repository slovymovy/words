                    {
                        "translation_id": "dbc23c2d-4c02-4195-a360-02abbd706d16",
                        "source_entry_id": "b2e3d4be-dc63-33fb-b12a-3d6f1ebc8f26",
                        "source_sense_id": "b4800c71-4343-39f3-8639-ca16cae3f299",
