                "senses": [
                    {
                        "sense_id": "04a569b3-9747-37e7-aa2e-88fbf9edfffc",
                        "entry_id": "d2b22b24-9ca8-3183-8519-2593abac9733",
                        "glosses": [
                            "eine Stelle, ein Ort, wo etwas abgebrochen ist (wurde, wird), ein Abbruch stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e356c348-ef1a-4833-8b53-4c12036559d0",
                                "sense_id": "04a569b3-9747-37e7-aa2e-88fbf9edfffc",
                                "text": "„An der Abbruchstelle an der Nordwestküste Grönlands war bereits seit 2001 ein Riss sichtbar, teilte die US-Raumfahrtbehörde mit.“"
                            },
                            {
                                "example_id": "34db1594-cc56-4915-ac32-98671d473870",
                                "sense_id": "04a569b3-9747-37e7-aa2e-88fbf9edfffc",
                                "text": "„Zwölf Stunden am Tag sitzt er in der gläsernen Kabine eines riesigen Muldenkippers und fährt Eisenerz von der Abbruchstelle zum Brecher, wo die großen roten Brocken zerkleinert werden.“"
                            },
                            {
                                "example_id": "5e849329-e5cc-478a-a514-17042680c825",
                                "sense_id": "04a569b3-9747-37e7-aa2e-88fbf9edfffc",
                                "text": "„Touristen hatten ein Donnern gehört, die Polizei alarmiert und vermutet, dass sich Spaziergänger unterhalb der Abbruchstelle befanden. Daraufhin wurde eine Suche eingeleitet, die erfolglos blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
