                                            {
                                                "example_id": "5daed05a-1b86-4ec8-a2c7-db07e582f490",
                                                "sense_id": "f85b6303-862a-3fd0-a7d2-07f928dcfc7f",
                                                "text": "Malgré la présence de Gabriel un léger caillou vola, inquiétant un moineau qui s’épuçait dans un nid de poussière."
                                            }
