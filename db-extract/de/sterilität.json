                "senses": [
                    {
                        "sense_id": "15cb90f5-eaf7-345a-b8a1-4367e6378511",
                        "entry_id": "89cf4b83-dd88-3783-9f6b-ec3bae58ffc0",
                        "glosses": [
                            "Eigenschaft, nicht fruchtbar, sondern zeugungsunfähig (steril) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f211ba44-762f-4059-ade9-dc637913deea",
                                "sense_id": "15cb90f5-eaf7-345a-b8a1-4367e6378511",
                                "text": "„Von Sterilität wird dann gesprochen, wenn es innerhalb eines Jahres bei regelmäßigem Koitus eines Paares ohne Kontrazeption nicht zu einer Schwangerschaft kommt. Es wird differenziert zwischen primärer und sekundärer Sterilität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6f24297-95ed-3abc-b882-1249692bc26e",
                        "entry_id": "89cf4b83-dd88-3783-9f6b-ec3bae58ffc0",
                        "glosses": [
                            "Eigenschaft, frei von Keimen/Bakterien zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "422a852b-758c-4216-8e6f-5a52f629fbd0",
                                "sense_id": "a6f24297-95ed-3abc-b882-1249692bc26e",
                                "text": "„Die Durchsetzung der In-Prozeß-Kontrollen und der mikrobiologischen Anforderungen kann die Sterilität des Endproduktes sicherstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
