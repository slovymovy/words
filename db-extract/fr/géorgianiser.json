                "senses": [
                    {
                        "sense_id": "738dc5db-fe57-3d7c-81b2-19cc2002282d",
                        "entry_id": "80e861ed-cd85-3933-a034-38015f18d3d1",
                        "glosses": [
                            "Donner un caractère géorgien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6208318-fbb3-4344-ae09-a57ab2f76530",
                                "sense_id": "738dc5db-fe57-3d7c-81b2-19cc2002282d",
                                "text": "D’abord, il y a la volonté de la minorité arménienne qui accuse Tbilissi de vouloir « géorgianiser » le pays."
                            },
                            {
                                "example_id": "fcc7a388-ac4a-4c72-bb70-f6b9c89aeac4",
                                "sense_id": "738dc5db-fe57-3d7c-81b2-19cc2002282d",
                                "text": "Dans la phase post-soviétique, leur mouvement constitue une réaction au nationalisme croissant des Géorgiens qui a pris pour cibles ses minorités nationales (près du tiers de la population, souvent inassimilables) et prétend « géorgianiser » la république."
                            }
                        ]
                    }
