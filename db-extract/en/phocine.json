                        "glosses": [
                            "Pertaining to a seal (or similar pinnipeds); seallike."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b918c316-5723-44e4-8d05-c5618bc4365c",
                                "sense_id": "a249a74c-b083-312f-9620-0745fb4bbdd0",
                                "text": "He telegraphed to the whaling ports of New England, and sent messages to San Francisco and Alaska, to know if a group of sea lions and other specimens of the phocine tribe could be secured."
                            },
                            {
                                "example_id": "6ab01b72-3d4a-4dc4-9a75-bafcb32e6b22",
                                "sense_id": "a249a74c-b083-312f-9620-0745fb4bbdd0",
                                "text": "[…] she had already yanked out of me the coveted section [of the newspaper] and retreated to her mat near her phocine mamma."
                            },
                            {
                                "example_id": "b8b8656b-548d-49e7-b105-875643030d57",
                                "sense_id": "a249a74c-b083-312f-9620-0745fb4bbdd0",
                                "text": "She walked over towards me with an odd elegance, big strides, like a champion girl swimmer, say; muscled but lean, with a phocine grace."
                            }
                        ]
                    }
                ],
