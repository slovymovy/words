{
    "word_family": [
        "hydration",
        "hydrator",
        "dehydrate",
        "dehydration",
        "rehydrate",
        "rehydration",
        "carbohydrate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cd7e91a-f6f7-342f-9fe2-fa5ae772cb52",
                    "sense_definition": "To drink water or absorb fluids in order to maintain a healthy balance of bodily moisture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Athletes must <w>hydrate</w> properly before running a marathon in the summer heat.",
                            "target_lang_translations": {
                                "zh": "运动员在酷暑中跑马拉松前，必须充分<w>补充水分</w>。"
                            }
                        },
                        {
                            "text": "You should remember to <w>hydrate</w> frequently while working outdoors.",
                            "target_lang_translations": {
                                "zh": "在户外工作时，你应该记得经常<w>补水</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dehydrate"
                    ],
                    "common_phrases": [
                        "hydrate properly",
                        "hydrate regularly"
                    ],
                    "target_lang_definitions": {
                        "zh": "（通过饮水等）补充水分"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "补充水分",
                                "target_lang_sense_clarification": "指摄入水分以维持体内水盐平衡"
                            },
                            {
                                "target_lang_word": "补水",
                                "target_lang_sense_clarification": "口语或日常简缩表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2912125a-7b5c-3b6a-8991-5b0907adf574",
                    "sense_definition": "To supply moisture to something, such as skin or tissues, or to combine chemically with water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "water_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Applying this lotion will help <w>hydrate</w> dry skin during cold winter months.",
                            "target_lang_translations": {
                                "zh": "涂抹这款乳液有助于在寒冷的冬季<w>滋润</w>干燥的皮肤。"
                            }
                        },
                        {
                            "text": "The facial cream claims to deeply <w>hydrate</w> your face overnight.",
                            "target_lang_translations": {
                                "zh": "这款面霜声称可以在夜间为脸部深度<w>补水</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bewater"
                    ],
                    "antonyms": [
                        "dehydrate"
                    ],
                    "common_phrases": [
                        "hydrate the skin",
                        "hydrate dry skin"
                    ],
                    "target_lang_definitions": {
                        "zh": "使湿润；使（皮肤、组织等）保持水分；（化学）水化"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滋润",
                                "target_lang_sense_clarification": "使皮肤等保持水分和光泽"
                            },
                            {
                                "target_lang_word": "补水",
                                "target_lang_sense_clarification": "给皮肤等外部组织补充水分"
                            },
                            {
                                "target_lang_word": "水化",
                                "target_lang_sense_clarification": "化学上与水发生结合反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690d8f13-6434-3e90-9e71-3e1394f66d2f",
                    "sense_definition": "To populate an in-memory object or data structure with data loaded from a database or external source.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The framework will automatically <w>hydrate</w> the user profile object using records retrieved from the database.",
                            "target_lang_translations": {
                                "zh": "该框架将自动利用从数据库检索到的记录来<w>水合</w>用户资料对象。"
                            }
                        },
                        {
                            "text": "It takes several milliseconds to <w>hydrate</w> all objects after fetching the raw data.",
                            "target_lang_translations": {
                                "zh": "获取原始数据后，需要几毫秒来<w>填充</w>所有对象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hydrate an object"
                    ],
                    "target_lang_definitions": {
                        "zh": "（计算机）用水合填充；用数据填充（内存对象或数据结构）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水合",
                                "target_lang_sense_clarification": "计算机编程中将数据注入对象或组件的过程"
                            },
                            {
                                "target_lang_word": "填充",
                                "target_lang_sense_clarification": "将检索到的数据载入数据结构中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ef0ff85-5cf1-3f5c-ba29-2e094506e7f2",
                    "sense_definition": "A chemical compound that contains water molecules chemically bound to another substance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Copper sulfate forms a blue <w>hydrate</w> when crystallized from an aqueous solution.",
                            "target_lang_translations": {
                                "zh": "硫酸铜从水溶液中结晶出来时会形成一种蓝色的<w>水合物</w>。"
                            }
                        },
                        {
                            "text": "Heating the crystalline <w>hydrate</w> causes it to lose its bound water molecules.",
                            "target_lang_translations": {
                                "zh": "加热结晶<w>水合物</w>会使其失去结合的水分子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crystalline hydrate",
                        "gas hydrate"
                    ],
                    "target_lang_definitions": {
                        "zh": "（化学）水合物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水合物",
                                "target_lang_sense_clarification": "含有以化学方式结合的水分子的化合物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33f1bfec-1a84-33de-ac9a-0714a6d67826",
                    "sense_definition": "Water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary traveler searched desperately for any source of refreshing <w>hydrate</w> in the desert.",
                            "target_lang_translations": {
                                "zh": "疲惫的旅人在沙漠中拼命寻找任何能够解渴的<w>水</w>源。"
                            }
                        },
                        {
                            "text": "The bottle was filled with pure <w>hydrate</w> to sustain him through the long hike.",
                            "target_lang_translations": {
                                "zh": "瓶子里装满了纯净的<w>水</w>，以支撑他完成漫长的徒步旅行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "humorous or unconventional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "水（俚语或幽默用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水",
                                "target_lang_sense_clarification": "指饮用水，用于诙谐或不常见的语境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}