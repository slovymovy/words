    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c9ccb8f-d5c2-3d59-9116-aa3e6f965020",
                    "sense_definition": "Een persoon die een activiteit, zoals sport of kunst, beoefent voor zijn plezier en niet als beroep.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hobbyist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>amateurs</w> mochten op zondag voetballen terwijl de profs op zaterdag speelden.",
                            "target_lang_translations": {
                                "en": "The <w>amateurs</w> were allowed to play football on Sunday while the pros played on Saturday."
                            }
                        },
                        {
                            "text": "Hoewel hij een getalenteerde <w>amateur</w> is, droomt hij ervan om ooit professioneel te worden.",
                            "target_lang_translations": {
                                "en": "Although he is a talented <w>amateur</w>, he dreams of turning professional one day."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefhebber",
                        "dilettant"
                    ],
                    "antonyms": [
                        "professional",
                        "beroeps"
                    ],
                    "common_phrases": [
                        "enthousiaste amateur",
                        "amateur bij de club"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who engages in an activity, such as sports or art, for pleasure rather than as a profession."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amateur",
                                "target_lang_sense_clarification": "non-professional"
                            },
                            {
                                "target_lang_word": "hobbyist",
                                "target_lang_sense_clarification": "someone who does something for fun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4277b8bc-90ce-3fb8-bddb-e4c5b0003960",
                    "sense_definition": "Iemand die onhandig of onervaren te werk gaat; een prutser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onervaren persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lijkt wel een <w>amateur</w> met al dat geknoei aan de motor.",
                            "target_lang_translations": {
                                "en": "You look like an <w>amateur</w> with all that messing around with the engine."
                            }
                        },
                        {
                            "text": "De dief gedroeg zich als een <w>amateur</w> en liet overal vingerafdrukken achter.",
                            "target_lang_translations": {
                                "en": "The thief behaved like an <w>amateur</w> and left fingerprints everywhere."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilettant"
                    ],
                    "antonyms": [
                        "expert",
                        "vakman"
                    ],
                    "common_phrases": [
                        "gedragen als een amateur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who works in a clumsy or inexperienced manner; a bungler or dabbler."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amateur",
                                "target_lang_sense_clarification": "unskilled or unprofessional person"
                            },
                            {
                                "target_lang_word": "bungler",
                                "target_lang_sense_clarification": "someone who does things poorly"
                            },
                            {
                                "target_lang_word": "dabbler",
                                "target_lang_sense_clarification": "someone not serious or expert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25ac027e-cd04-31f1-9ccb-d502ae387b98",
                    "sense_definition": "Iemand die een grote liefde of passie voor iets of iemand koestert.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liefhebber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als <w>amateur</w> van de klassieke kunsten bezoekt hij elk weekend een museum.",
                            "target_lang_translations": {
                                "en": "As an <w>amateur</w> of the classical arts, he visits a museum every weekend."
                            }
                        },
                        {
                            "text": "Zij is een ware <w>amateur</w> van de Franse keuken en kookt elke dag uitgebreid.",
                            "target_lang_translations": {
                                "en": "She is a true <w>lover</w> of French cuisine and cooks extensively every day."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefhebber"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "in de betekenis van minnaar of hartstochtelijk liefhebber"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who has a great love or passion for something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amateur",
                                "target_lang_sense_clarification": "a lover or devotee of something, often archaic"
                            },
                            {
                                "target_lang_word": "lover",
                                "target_lang_sense_clarification": "an enthusiast of a particular thing"
                            },
                            {
                                "target_lang_word": "aficionado",
                                "target_lang_sense_clarification": "a person who is very knowledgeable and enthusiastic about an activity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}