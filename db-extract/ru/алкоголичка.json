                    {
                        "translation_id": "7e3d680c-e263-41df-abb5-be59b0058fb7",
                        "source_entry_id": "618783bc-a432-321f-b8a3-62f2b810317e",
                        "source_sense_description": "женщина",
                        "target_lang_word": "Alkoholikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkoholikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc6dfcc6-9ce3-3050-b90a-215a0eecf586",
                                        "entry_id": "74ac93ba-b8c3-39c1-802d-7688448f238a",
                                        "glosses": [
                                            "weibliche Person, die alkoholabhängig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e68daab-2634-46ef-b858-4b468bf21a40",
                                                "sense_id": "bc6dfcc6-9ce3-3050-b90a-215a0eecf586",
                                                "text": "Die Mutter der Kinder ist Alkoholikerin und ohne Schulabschluss."
                                            },
                                            {
                                                "example_id": "87200b15-f815-43e7-b00f-daaa9078d3e3",
                                                "sense_id": "bc6dfcc6-9ce3-3050-b90a-215a0eecf586",
                                                "text": "„Ein jüngst veröffentlichtes Video zeigte die Londonerin beim Crack-Konsum, sie gilt als Alkoholikerin, litt unter Magersucht und Bulimie.“"
                                            },
                                            {
                                                "example_id": "4527f4f2-d8c8-4566-ac21-3fa0daaaa31a",
                                                "sense_id": "bc6dfcc6-9ce3-3050-b90a-215a0eecf586",
                                                "text": "„Wie Roth bald erfahren würde, hatte sie das Sorgerecht für ihre Kinder verloren, weil sie Alkoholikerin war und man sie mehrfach wegen Trunkenheit am Steuer verurteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
