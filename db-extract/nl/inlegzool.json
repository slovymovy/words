                "senses": [
                    {
                        "sense_id": "c8a78b7a-8299-34b5-ac38-5bc35b5dda33",
                        "entry_id": "4082d7cc-6e1e-39ab-a3a0-bcfed50f6137",
                        "glosses": [
                            "een zool die men in een schoen kan leggen, zodat de schoen beter past of de voeten minder stinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e35a84d-7f21-4243-8e72-3bb998df8022",
                                "sense_id": "c8a78b7a-8299-34b5-ac38-5bc35b5dda33",
                                "text": "Macintosh heeft al enkele maatregelen aangekondigd. Zo gaat het zich alleen nog richten op de kleding- en schoenenmarkt in de Benelux. De Britse schoenenketen die het onder zich had, Fashion UK , wordt dit jaar in de verkoop gedaan, net als Nea International, groothandelaar in onder andere inlegzolen."
                            },
                            {
                                "example_id": "d6233109-9141-4eea-9c60-49ab8743c218",
                                "sense_id": "c8a78b7a-8299-34b5-ac38-5bc35b5dda33",
                                "text": "Het Leuvense bedrijf investeerde in eigen productielijnen en in softwaretools die derden toelaten om een eigen productielijn uit te bouwen. En zo kwam Materialise wel bij de consument terecht. Bijvoorbeeld via zijn productielijnen voor inlegzolen en brilmonturen op maat. ‘We willen niet alles zelf vervaardigen’, zegt Vancraen. ‘De meeste toegevoegde waarde voor ons zit in de softwaretools.’"
                            }
                        ]
                    }
