                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным Лакедемон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059a6f34-337b-4e1b-a44b-0bf5127b14c5",
                                                "sense_id": "e0a6525b-b06a-3457-b8cc-0dd89e327b39",
                                                "text": "Лакедемонский строй, который основывается на честолюбии, Платон называет тимократией (или тимархией)."
                                            }
