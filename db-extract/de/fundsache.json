                                        "entry_id": "0a99dc65-a171-3eaf-86fc-ec853c9b2e36",
                                        "glosses": [
                                            "A help desk or department in a store, mall, or other such facility where customers who have lost an item can inquire as to whether it has been found and turned in; a lost and found."
                                        ],
                                        "tags": [
                                            "British",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6298fff7-5e2f-4918-bff2-86668f5c07ec",
                                                "sense_id": "0d50fe50-d7a4-3f4c-84d1-b3a00c03a183",
                                                "text": "Lockwood is the junction for the picturesque branch to Meltham, where an old lost-property book recorded the finding of a \"bow with two arrows\" in a train, in 1873."
                                            },
                                            {
                                                "example_id": "f6a17cbf-67b0-482b-811c-e70da5f906bd",
                                                "sense_id": "0d50fe50-d7a4-3f4c-84d1-b3a00c03a183",
                                                "text": "So far this year, SWR's lost property team has been looking after 19 soft toys (and counting) at London Waterloo station. The operator shared images and details of the toys on social media."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de5081b-57d4-3f43-ac59-ae0d2b865f26",
                                        "entry_id": "0a99dc65-a171-3eaf-86fc-ec853c9b2e36",
                                        "glosses": [
                                            "Property that is found in such a state as to make it likely that the original owner unintentionally ceased to be in possession of the property, and would be unable to locate the property."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
