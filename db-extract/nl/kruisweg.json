                "senses": [
                    {
                        "sense_id": "239f02d1-7b1d-371d-9f60-9002495f05a0",
                        "entry_id": "2f09d735-b305-3312-951a-70373cc9e65b",
                        "glosses": [
                            "the Passion of Jesus"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "e4ffab7d-e30e-4d00-9ad4-782a4368b1fe",
                                "sense_id": "239f02d1-7b1d-371d-9f60-9002495f05a0",
                                "text": "De kruisweg van Jezus is een belangrijk verhaal in de Bijbel.",
                                "translation": "The Passion of Jesus is an important story in the Bible.",
                                "english": "The Passion of Jesus is an important story in the Bible."
                            },
                            {
                                "example_id": "e0a417f6-2768-4c65-ba5a-ad3143bb89ab",
                                "sense_id": "239f02d1-7b1d-371d-9f60-9002495f05a0",
                                "text": "Tijdens de vastentijd herdenken veel christenen de kruisweg van Jezus.",
                                "translation": "During Lent, many Christians commemorate the Passion of Jesus.",
                                "english": "During Lent, many Christians commemorate the Passion of Jesus."
                            },
                            {
                                "example_id": "a0822af1-cdf8-4b82-9e07-f2b8541ada16",
                                "sense_id": "239f02d1-7b1d-371d-9f60-9002495f05a0",
                                "text": "De kruisweg herinnert gelovigen aan het lijden en offer van Christus.",
                                "translation": "The Passion reminds believers of the suffering and sacrifice of Christ.",
                                "english": "The Passion reminds believers of the suffering and sacrifice of Christ."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5b003af-4896-3770-b5c0-ea2647e3273f",
                        "entry_id": "2f09d735-b305-3312-951a-70373cc9e65b",
                        "glosses": [
                            "Way of the Cross (stations depicting the Passion)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9026fc11-b90c-426f-8c63-e6e579671d24",
                                "sense_id": "a5b003af-4896-3770-b5c0-ea2647e3273f",
                                "text": "De kerk heeft veertien stations van de kruisweg langs de muren.",
                                "translation": "The church has fourteen stations of the Way of the Cross along the walls.",
                                "english": "The church has fourteen stations of the Way of the Cross along the walls."
                            },
                            {
                                "example_id": "f81fbeec-6ea2-4e21-a6bf-2ddc520d66ee",
                                "sense_id": "a5b003af-4896-3770-b5c0-ea2647e3273f",
                                "text": "De kruisweg-stations vertellen het verhaal van Jezus' laatste uren.",
                                "translation": "The Way of the Cross stations tell the story of Jesus' final hours.",
                                "english": "The Way of the Cross stations tell the story of Jesus' final hours."
                            },
                            {
                                "example_id": "24614da3-4c7c-41d3-9efe-06a3b72cfb71",
                                "sense_id": "a5b003af-4896-3770-b5c0-ea2647e3273f",
                                "text": "Elk jaar lopen veel pelgrims de kruisweg in Jeruzalem.",
                                "translation": "Every year, many pilgrims walk the Way of the Cross in Jerusalem.",
                                "english": "Every year, many pilgrims walk the Way of the Cross in Jerusalem."
                            }
                        ]
                    },
                    {
                        "sense_id": "81540f3d-3a62-3574-a520-d6fcae105aa7",
                        "entry_id": "2f09d735-b305-3312-951a-70373cc9e65b",
                        "glosses": [
                            "Way of the Cross (religious devotion)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "2a9dcb6d-51c7-4775-9f6f-9b7185f3f007",
                                "sense_id": "81540f3d-3a62-3574-a520-d6fcae105aa7",
                                "text": "Tijdens de kruisweg mediteren gelovigen over het lijden van Jezus.",
                                "translation": "During the Way of the Cross, believers meditate on the suffering of Jesus.",
                                "english": "During the Way of the Cross, believers meditate on the suffering of Jesus."
                            },
                            {
                                "example_id": "573daa6d-35c7-4a79-98ae-d9bc533347c9",
                                "sense_id": "81540f3d-3a62-3574-a520-d6fcae105aa7",
                                "text": "De kruisweg is een diepe spirituele oefening voor veel christenen.",
                                "translation": "The Way of the Cross is a profound spiritual practice for many Christians.",
                                "english": "The Way of the Cross is a profound spiritual practice for many Christians."
                            },
                            {
                                "example_id": "be47115e-6257-44ec-b600-b1a139d8ac4a",
                                "sense_id": "81540f3d-3a62-3574-a520-d6fcae105aa7",
                                "text": "Op Goede Vrijdag nemen veel kerken deel aan de kruisweg-devotie.",
                                "translation": "On Good Friday, many churches partake in the Way of the Cross devotion.",
                                "english": "On Good Friday, many churches partake in the Way of the Cross devotion."
                            }
                        ]
                    },
