                    },
                    {
                        "translation_id": "c25214bb-5819-4a3b-9d16-b52994d357ac",
                        "source_entry_id": "839859df-d9be-3471-9b78-929132c5ff2f",
                        "source_sense_id": "e7f6afb8-6809-3a87-9740-119807938154",
                        "target_lang_word": "trafika",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trafika",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1e986dcf-280a-321d-820a-ee9e34eb973c",
                                        "entry_id": "481877be-3c94-3b69-8506-5091119338ed",
                                        "glosses": [
                                            "prodejna tiskovin, tabákových výrobků, a poštovních cenin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6c3c11-b83a-41c4-a895-bddb52c41601",
                                                "sense_id": "1e986dcf-280a-321d-820a-ee9e34eb973c",
                                                "text": "Pracoval pilně od rána do večera, a když bylo před večeří a starý Kučera vyšel, aby si koupil v trafice čerstvý šňupec na noc, obrátil se Toník k matce"
                                            },
                                            {
                                                "example_id": "8e0903b3-71b5-456e-bce5-105cb07c8bc5",
                                                "sense_id": "1e986dcf-280a-321d-820a-ee9e34eb973c",
                                                "text": "Holárek s Klusáčkem šli domů, kdežto ostatní zůstali na ulici pohromadě, bručíce melodicky krásné naše písně. Šli pak od trafiky k trafice a rvali se zdi rakouské orly všech jakostí, veliké i malé"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27690b1e-3e13-31cf-9be6-fbe7886b42d0",
                                        "entry_id": "481877be-3c94-3b69-8506-5091119338ed",
                                        "glosses": [
                                            "(často v sousloví politická trafika"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6a23dd0-1a93-432b-a9b2-7713d61d5325",
                                                "sense_id": "27690b1e-3e13-31cf-9be6-fbe7886b42d0",
                                                "text": "Když dosluhující český premiér Petr Nečas po vypuknutí aféry ohledně podezření z uplácení bývalých poslanců ODS obhajoval přidělování „trafik“, řada politiků na Slovensku s tímto jeho postojem v duchu patrně souhlasila."
                                            },
                                            {
                                                "example_id": "36d41d01-09e5-48a0-9f0d-8b968e365c23",
                                                "sense_id": "27690b1e-3e13-31cf-9be6-fbe7886b42d0",
                                                "text": "Bojí se pádu vlády? Jak jinak si lze vysvětlit přidělování „trafik“ ve velkém členům ODS! Další supervýhodné teplé místečko dostal poslanec Václav Baštýř"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
