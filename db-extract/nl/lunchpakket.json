                    {
                        "sense_id": "7c2d3e1b-45d8-39bf-bf85-6305cdd8721d",
                        "entry_id": "64ee0ccd-63f6-3223-8451-c8048dc94707",
                        "glosses": [
                            "een van tevoren bereide en verpakte koude maaltijd, die meegenomen kan worden naar school, of naar de werkplek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67cd4e3-b6f5-4af3-b42a-9d9b42b2ba22",
                                "sense_id": "7c2d3e1b-45d8-39bf-bf85-6305cdd8721d",
                                "text": "Gebruikte broodzakken schud je eens uit (buiten, voor de vogels), strijk je glad en kun je dan gebruiken voor nieuw brood, voor lunchpakketten of om groenten in te bewaren."
                            },
                            {
                                "example_id": "bc6f3d5e-3da0-478d-ba8b-c7b88ebce571",
                                "sense_id": "7c2d3e1b-45d8-39bf-bf85-6305cdd8721d",
                                "text": "Een berger van bergingsbedrijf A.Barendregt heeft maandagmorgen het leven van een zwaan gered op de A15 bij Hoogvliet. Hij offerde er zijn eigen lunchpakket voor op, meldt het bedrijf op Twitter. De zwaan liep op A15 en vormde daar een gevaar voor zijn eigen leven en voor het langsrazende verkeer. Reden voor de berger om in te grijpen. Hij lokte de zwaan met een broodje uit zijn lunchtrommel naar zich toe, zodat hij het dier kon vangen."
                            },
                            {
                                "example_id": "d2b203ee-113b-4394-b9ad-fc032ce8062d",
                                "sense_id": "7c2d3e1b-45d8-39bf-bf85-6305cdd8721d",
                                "text": "Soms maakte Frau Gisela een lunchpakket voor mij en Acke en gingen we naar Trovill, waar iedereen zich ophield."
                            }
                        ]
                    }
                ],
