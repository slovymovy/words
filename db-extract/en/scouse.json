                        "sense_id": "950016af-3295-3b2f-b563-1ebf958257d5",
                        "entry_id": "7da2e498-ab2e-3317-9b9d-83365b94c5b4",
                        "glosses": [
                            "A stew associated with the Liverpool area, usually containing (at least) meat, onions, carrots and potatoes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70b34d06-fb86-48d2-84ec-236f6dff2f5d",
                                "sense_id": "950016af-3295-3b2f-b563-1ebf958257d5",
                                "text": "Unsurprisingly, given the geography of the area, Liverpool’s scouse isn’t dissimilar to Irish stew or Lancashire hotpot, either, and, like those noble dishes, is eminently practical, easy to make in a small kitchen, or indeed a galley, and to adapt to current circumstances – there’s even a vegetarian variant, blind scouse, for when you can’t, or won’t, run to meat."
                            }
                        ]
                    }
