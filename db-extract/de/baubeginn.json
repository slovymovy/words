                "senses": [
                    {
                        "sense_id": "232576fd-416b-3729-9e55-fffe05c7e5ef",
                        "entry_id": "613c2435-9bdf-3784-aa77-4e2ef8d9f13a",
                        "glosses": [
                            "Startzeitpunkt (Tag) für die Bauarbeiten an einem Bauvorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d2a91b-e0c9-4939-936a-2173e61e14c8",
                                "sense_id": "232576fd-416b-3729-9e55-fffe05c7e5ef",
                                "text": "„Baubeginn ist der Tag, an dem mit den Erd- oder Bauarbeiten, die der Herstellung der baulichen Anlage dienen, begonnen wird.“"
                            },
                            {
                                "example_id": "87dc1b09-2d86-4ff4-a5b2-0b5091153b62",
                                "sense_id": "232576fd-416b-3729-9e55-fffe05c7e5ef",
                                "text": "„Eine provisorische Fahrbahnverbreiterung wird bereits zum Baubeginn der ZUE hergestellt.“"
                            },
                            {
                                "example_id": "1647fc51-d219-4a32-a52e-a4cd685b73b5",
                                "sense_id": "232576fd-416b-3729-9e55-fffe05c7e5ef",
                                "text": "„Der Baubeginn wäre erst nach einer positiven Umweltverträglichkeitsprüfung möglich.“"
                            },
                            {
                                "example_id": "ce2bb955-fea2-4a7b-ac96-56474d8f4d05",
                                "sense_id": "232576fd-416b-3729-9e55-fffe05c7e5ef",
                                "text": "„Die Vereinigten Staaten hatten sich eingemischt, weil sie fürchteten, die Unruhen könnten den Baubeginn des Panamakanals verzögern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
