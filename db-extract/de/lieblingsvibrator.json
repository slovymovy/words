                            {
                                "example_id": "4c1613f2-15b4-4ed5-bb71-08526d1607d6",
                                "sense_id": "6e0ac3cb-9daf-393b-bf6a-ac849493d1dc",
                                "text": "„Wo ist mein Lieblingsvibrator, der weiße Multi-Flex von Orion?“"
                            },
                            {
                                "example_id": "2a19766c-8ddc-4d91-b53a-ab4e0b3add67",
                                "sense_id": "6e0ac3cb-9daf-393b-bf6a-ac849493d1dc",
                                "text": "„Nichts hat mir beim Schlafen geholfen. Nicht Kamillentee, nicht Whisky, nicht mein pinkfarbener Lieblingsvibrator, nicht das öffentlich-rechtliche Fernsehen.“"
                            },
                            {
                                "example_id": "62a6a2d4-7af5-4eb7-bcc2-5ba8a9ae1293",
                                "sense_id": "6e0ac3cb-9daf-393b-bf6a-ac849493d1dc",
                                "text": "„Anita Bryant, die sich mit ihrem Lieblingsvibrator in ihrem babyrosa Badezimmer eingeschlossen hatte, wurde plötzlich von einem widerlichen Ding angegriffen.“"
                            },
                            {
                                "example_id": "ef6b5b57-a71c-4d2f-b57c-d053baa2b251",
                                "sense_id": "6e0ac3cb-9daf-393b-bf6a-ac849493d1dc",
                                "text": "„Ich schwöre beim heiligen Duracell-Hasen, Rex ist besser gebaut als mein Lieblingsvibrator.“"
                            }
                        ],
