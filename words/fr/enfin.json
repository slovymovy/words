{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a5049800-68fb-393a-a025-16090e851e38",
                    "sense_definition": "À la fin, après une longue attente ou une suite d'événements.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de marche, nous sommes <w>enfin</w> arrivés au sommet de la montagne."
                        },
                        {
                            "text": "Le train que nous attendions depuis ce matin est <w>enfin</w> entré en gare."
                        }
                    ],
                    "synonyms": [
                        "finalement",
                        "à la fin"
                    ],
                    "common_phrases": [
                        "enfin arrivés"
                    ]
                },
                {
                    "sense_id": "292e0120-e68a-3229-b541-38e326e1563f",
                    "sense_definition": "Sert à corriger, préciser ou nuancer ce qui vient d'être dit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rectification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je viendrai chez toi demain à huit heures, <w>enfin</w> si je termine mon travail à temps."
                        },
                        {
                            "text": "Tout s'est très bien passé pendant la réunion, <w>enfin</w> presque tout le monde était d'accord."
                        }
                    ],
                    "common_phrases": [
                        "enfin presque"
                    ]
                },
                {
                    "sense_id": "3b364593-33b1-32bc-b881-d1f51b4349e4",
                    "sense_definition": "À la fin d'une énumération, pour résumer ou abréger un propos.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recapitulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fleurs, les arbres, la rivière, tout <w>enfin</w> semblait paisible dans ce magnifique jardin."
                        },
                        {
                            "text": "Elle a parlé de ses projets, de ses voyages, <w>enfin</w> elle nous a raconté toute sa vie."
                        }
                    ],
                    "synonyms": [
                        "bref"
                    ],
                    "common_phrases": [
                        "enfin bref"
                    ]
                },
                {
                    "sense_id": "32f95a3b-2394-3b14-aec5-faa8553a417b",
                    "sense_definition": "Marque une conclusion empreinte de résignation ou d'acceptation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons perdu ce match important, mais <w>enfin</w>, nous ferons mieux la prochaine fois."
                        },
                        {
                            "text": "Le restaurant était déjà complet ce soir, <w>enfin</w>, ce n'est pas très grave."
                        }
                    ]
                },
                {
                    "sense_id": "af4d750c-8575-3f2d-ab6b-4114c6403072",
                    "sense_definition": "Souligne une question, une remarque ou marque une insistance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mais <w>enfin</w>, pourquoi refusez-vous d'écouter les explications qu'il essaie de vous donner ?"
                        },
                        {
                            "text": "<w>Enfin</w>, comment avez-vous pu oublier un rendez-vous aussi important ?"
                        }
                    ],
                    "common_phrases": [
                        "mais enfin"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "606ab2f3-6271-353a-819f-582f6f592bb4",
                    "sense_definition": "Exprime le soulagement ou la satisfaction après une longue attente.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Enfin</w> ! Te voilà revenu après tout ce temps passé sur la route."
                        },
                        {
                            "text": "<w>Enfin</w> ! Nous avons réussi notre examen après des mois de révisions."
                        }
                    ],
                    "synonyms": [
                        "pas trop tôt !"
                    ]
                },
                {
                    "sense_id": "a665c646-3a78-342d-a15e-9cde426907fc",
                    "sense_definition": "Exprime l'impatience, l'agacement ou l'exaspération.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Enfin</w>, faites attention quand vous traversez la rue sans regarder !"
                        },
                        {
                            "text": "Arrêtez de faire tout ce bruit inutile dans le couloir, <w>enfin</w> !"
                        }
                    ]
                }
            ]
        }
    ]
}