        "fr-extract.jsonl": [
            {
                "entry_id": "ab370b62-29a6-3448-b939-668c1484814b",
                "word": "tausendmal",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4091ed5-7f7e-329a-8cf3-f0d78043205a",
                        "entry_id": "ab370b62-29a6-3448-b939-668c1484814b",
                        "glosses": [
                            "Mille fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd38ef66-0c63-4868-9aea-3cb2f3a4eaaf",
                                "sense_id": "e4091ed5-7f7e-329a-8cf3-f0d78043205a",
                                "text": "Ich hörte Pawel und seinen Freunden zu, wie sie (...) mit dem Argument die Macht verteidigten, dass erstens die Dinge tausendmal schlimmer stehen könnten und dass sich zweitens die Russen damit abfänden – in wessen Namen sollte man sie also schulmeistern?",
                                "translation": "J’écoutais Pavel et ses amis (...) défendre le pouvoir en disant que premièrement les choses pourraient être mille fois pires, deuxièmement que les Russes s’en contentent – alors au nom de quoi leur faire la leçon ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8eaf4825-b973-3dc0-9785-02a5a42a5562",
                        "entry_id": "ab370b62-29a6-3448-b939-668c1484814b",
                        "glosses": [
                            "Souvent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a122b4-21a5-45d2-a6b9-de4976d76192",
                                "sense_id": "8eaf4825-b973-3dc0-9785-02a5a42a5562",
                                "text": "Erinnern Sie sich an Ihren ersten Zungenkuss? An diesen lange herbeigesehnten und tausendmal vorgestellten Moment, in dem Sie sich mit wild hämmerndem Herzen und geschlossenen Augen in einen fremden Mund vorgetastet und zum ersten Mal einen anderen Menschen geschmeckt haben?",
                                "translation": "Vous souvenez-vous de votre premier baiser colombin ? De ce moment tant attendu et mille fois imaginé où, le cœur battant à tout rompre et les yeux fermés, vous vous êtes aventuré dans la bouche inconnue et avez goûté pour la première fois à un autre être humain ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "e1c944f7-4753-37ed-9fcc-d9791665c98b",
                "word": "tausendmal",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2f997518-62c9-3ed5-bfd0-c6dc5c151dde",
                        "entry_id": "e1c944f7-4753-37ed-9fcc-d9791665c98b",
                        "glosses": [
                            "tausend Male"
                        ],
                        "tags": [
                            "bestimmtes Wiederholungszahlwort (Angabe",
                            "wie oft etwas wiederkehrt)"
                        ],
                        "examples": [
                            {
                                "example_id": "bab33673-bde5-43de-a312-78ba614fd314",
                                "sense_id": "2f997518-62c9-3ed5-bfd0-c6dc5c151dde",
                                "text": "„Durch seinen starken Sternwind verliert er pro Zeitintervall mehr als tausendmal so viel Masse wie die Sonne.“"
                            },
                            {
                                "example_id": "4dd24668-549c-4532-981b-71f241a5ccf6",
                                "sense_id": "2f997518-62c9-3ed5-bfd0-c6dc5c151dde",
                                "text": "„Eine Ausnahme könnte es darstellen, wenn Sie ein Programm schreiben, das als CGI-Skript ausgeführt wird, das mehrere hundert- oder tausendmal pro Minute aufgerufen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "640437a2-292d-39bd-ba83-5469ce679444",
                        "entry_id": "e1c944f7-4753-37ed-9fcc-d9791665c98b",
                        "glosses": [
                            "häufige, viele Male"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f2ec9c99-86e5-4d3e-aa53-8a039f09dd16",
                                "sense_id": "640437a2-292d-39bd-ba83-5469ce679444",
                                "text": "„In Wahrheit ist die Toskana noch tausendmal schöner als in den Reiseberichten der deutschen Dichter.“"
                            },
                            {
                                "example_id": "537ae17a-0239-4de8-b591-a2eb96583df9",
                                "sense_id": "640437a2-292d-39bd-ba83-5469ce679444",
                                "text": "„Seit diesen Schlachten, seit jener Zeit sind viele tausendmal 300 ebenso tapfer gestorben.“"
                            },
                            {
                                "example_id": "77ff19a9-dda5-4c97-a977-da7139653a56",
                                "sense_id": "640437a2-292d-39bd-ba83-5469ce679444",
                                "text": "„Da antwortete der Spiegel: ‚Frau Königin, Ihr seid die Schönste hier, aber Sneewittchen über den Bergen bei den sieben Zwergen ist noch tausendmal schöner als Ihr.‘ “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55f46c7d-9a51-4166-a643-df368b80d21f",
                        "source_entry_id": "e1c944f7-4753-37ed-9fcc-d9791665c98b",
                        "source_sense_id": "2f997518-62c9-3ed5-bfd0-c6dc5c151dde",
