                                        "sense_id": "ab011cd6-430c-3240-9aa2-a8aa1a45d4f1",
                                        "entry_id": "235ca02b-1757-3bc5-9938-3746f70b9497",
                                        "glosses": [
                                            "Rumex hymenosepalus : espèce végétale de la famille des Polygonacées, originaire du sud des États-Unis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb43b182-84d6-4901-9514-70d4747bd95b",
                                                "sense_id": "ab011cd6-430c-3240-9aa2-a8aa1a45d4f1",
                                                "text": "Nous n’avons pas besoin de dire maintenant que la racine est la partie essentielle de la canaigre, la seule que recherche l’industrie."
                                            }
                                        ]
                                    }
