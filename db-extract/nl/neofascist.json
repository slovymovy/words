                        "examples": [
                            {
                                "example_id": "e081cf14-e77e-4919-bb15-d4896a5e4bc8",
                                "sense_id": "8b309068-77bb-35cc-9935-cd67ef126be5",
                                "text": "De 22 februari verdreven Janoekovitsj noemde de nieuwe machthebbers in Kiev dinsdag „ultranationalisten en neofascisten die een burgeroorlog willen ontketenen”. Hij noemde de voor 25 mei geplande verkiezingen in Oekraïne illegaal."
                            },
                            {
                                "example_id": "b620f72a-0dfa-4bf2-a0b1-2932dd90dd10",
                                "sense_id": "8b309068-77bb-35cc-9935-cd67ef126be5",
                                "text": "Twee neofascisten waren in cassatie gegaan tegen hun veroordeling. Zij beriepen zich op de „internationale normen van vrijheid van meningsuiting”. Ook wezen zij erop dat veel tijd is verstreken sinds de dood van dictator Benito Mussolini in 1945. Maar volgens de rechters is het fascistische gedachtegoed nog steeds gevaarlijk in Italië, gelet op recente incidenten met onverdraagzaamheid jegens etnische of religieuze minderheden, aldus de krant la Repubblica vrijdag."
                            }
                        ]
                    }
