                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na niedzielny obiad kupiłem świeżą <w>wieprzowinę</w> w lokalnym sklepie mięsnym.",
                            "target_lang_translations": {
                                "ru": "К воскресному обеду я купил свежую <w>свинину</w> в местном мясном магазине."
                            }
                        },
                        {
                            "text": "W wielu krajach <w>wieprzowina</w> jest najczęściej spożywanym rodzajem mięsa.",
                            "target_lang_translations": {
                                "ru": "Во многих странах <w>свинина</w> — самый популярный вид мяса."
                            }
