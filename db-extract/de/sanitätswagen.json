                "senses": [
                    {
                        "sense_id": "3e57616b-34a4-3891-942a-09089be00249",
                        "entry_id": "998a6f1f-2950-3d2f-8fd7-0b83f7be4c13",
                        "glosses": [
                            "Fahrzeug, das der Versorgung und dem Transport von Kranken oder Verletzten dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595248c0-c0e5-48cd-9b00-7032a050fa8b",
                                "sense_id": "3e57616b-34a4-3891-942a-09089be00249",
                                "text": "„Die Milizleute trugen den Fürsten Andrej zum Walde, wo die Sanitätswagen standen und der Verbandplatz sich befand.“"
                            },
                            {
                                "example_id": "b691fd22-6e26-4fc2-86f5-e002cca78e2e",
                                "sense_id": "3e57616b-34a4-3891-942a-09089be00249",
                                "text": "„Er fand Platz auf einem Sanitätswagen.“"
                            },
                            {
                                "example_id": "a1b38d1d-e717-4685-9470-13ff3c2399ab",
                                "sense_id": "3e57616b-34a4-3891-942a-09089be00249",
                                "text": "„Ein Sanitätswagen hielt vor dem Tor, und als ich hinaustrat, packten sie einen auf ihre Bahre und schleppten ihn ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
