                                        "entry_id": "fe673915-ab92-32ce-8bed-b949b17eab21",
                                        "glosses": [
                                            "Persona que tiene la inclinación, gusto o prurito de exhibirse, de hacerse ver en público deliberadamente para atraer atención o admiración."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf805ac-df2a-41eb-93cc-831842ff5fa1",
                                                "sense_id": "edec9db2-324a-3bdb-a3cb-b537f128981e",
                                                "text": "(sustantivo): \"los huéspedes tienen la posibilidad de … charlar con nosotros, a la vez que observan cómo procedemos. Y yo, exhibicionista innato, me siento halagado\"."
                                            },
                                            {
                                                "example_id": "f98087d6-96fd-4c3a-bcb1-326c8b0810f3",
                                                "sense_id": "edec9db2-324a-3bdb-a3cb-b537f128981e",
                                                "text": "(adjetivo): \"El placer de ver experimentado por el público encuentra su contrapartida en el placer exhibicionista que experimenta el comediante\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51cd18db-3c4d-3868-9b18-ad6706191e2d",
                                        "entry_id": "fe673915-ab92-32ce-8bed-b949b17eab21",
                                        "glosses": [
                                            "Individuo que tiene la compulsión, manía o afán patológico de mostrar a otras personas órganos que se consideran íntimos, tales como los genitales, glúteos, torso y pechos."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f360cd35-4d93-47d5-bd57-aea7795050f4",
                                                "sense_id": "51cd18db-3c4d-3868-9b18-ad6706191e2d",
                                                "text": "(sustantivo): \"Mientras al nudista se le ven sus genitales, el exhibicionista los hace ver\"."
                                            },
                                            {
                                                "example_id": "dfe8bcf0-a1cf-4f34-9fee-8111858935c8",
                                                "sense_id": "51cd18db-3c4d-3868-9b18-ad6706191e2d",
                                                "text": "(adjetivo): \"En cualquier caso, la conducta exhibicionista ha de evidenciar una cierta finalidad provocadora\"."
