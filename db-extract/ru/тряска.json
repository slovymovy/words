                        "source_sense_id": "05a7e72e-1a85-3457-ae4f-ccf59b4c1884",
                        "target_lang_word": "jolt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2715641b-9efc-3430-a188-9c51e85cf598",
                                        "entry_id": "76245bca-820d-389c-aac4-0a3af572c3a1",
                                        "glosses": [
                                            "To push or shake abruptly and roughly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe519cdf-e9d7-4d66-833c-6e07c8e42d99",
                                                "sense_id": "2715641b-9efc-3430-a188-9c51e85cf598",
                                                "text": "The bus jolted its passengers at every turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df326477-f3c1-3397-aa5c-9322fe760a8c",
                                        "entry_id": "76245bca-820d-389c-aac4-0a3af572c3a1",
                                        "glosses": [
                                            "To knock sharply"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dfa94bc-07da-3c84-9a2e-871ed48d610f",
                                        "entry_id": "76245bca-820d-389c-aac4-0a3af572c3a1",
                                        "glosses": [
                                            "To shock (someone) into taking action or being alert"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01b176b-9c8e-46a0-b304-544bdcb0f271",
                                                "sense_id": "9dfa94bc-07da-3c84-9a2e-871ed48d610f",
                                                "text": "I jolted her out of complacency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a12a4c85-a28b-3217-b6d7-a9c0819eb0bb",
                                        "entry_id": "76245bca-820d-389c-aac4-0a3af572c3a1",
                                        "glosses": [
                                            "To shock emotionally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc966dcf-6594-4912-919c-62b6e6a4d5a6",
                                                "sense_id": "a12a4c85-a28b-3217-b6d7-a9c0819eb0bb",
                                                "text": "Her untimely death jolted us all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2017fd-a81c-3280-86bb-64bcb3c4cc41",
                                        "entry_id": "76245bca-820d-389c-aac4-0a3af572c3a1",
                                        "glosses": [
                                            "To shake; to move with a series of jerks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4755fb-23b1-4d0d-b566-ff30a59fbf65",
                                                "sense_id": "8d2017fd-a81c-3280-86bb-64bcb3c4cc41",
                                                "text": "The car jolted along the stony path."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb57a37-0ad3-3400-b5cd-6eb53b8be65b",
                                        "entry_id": "4039a4cf-1d9c-3e3c-a1f4-9fb99ce4708d",
                                        "glosses": [
                                            "An act of jolting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5095fcc-f55b-471a-ae92-e702c7adc584",
                                                "sense_id": "9bb57a37-0ad3-3400-b5cd-6eb53b8be65b",
                                                "text": "Timing your first coffee for mid-morning allows the caffeine to work its magic right as your body’s natural energy starts to wane. Instead of a jolt, you get a smooth, effective lift that carries you through the late morning and into the afternoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb42cc4-b5ee-3587-9994-605b3a5e5159",
                                        "entry_id": "4039a4cf-1d9c-3e3c-a1f4-9fb99ce4708d",
                                        "glosses": [
                                            "A surprise or shock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                                        "entry_id": "4039a4cf-1d9c-3e3c-a1f4-9fb99ce4708d",
                                        "glosses": [
                                            "A long prison sentence."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27576d14-d764-42a0-ad72-ad04d1d5c160",
                                                "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                                                "text": "Just sit down and look around for a while. Notice your cell, John. Take a good look at it, because it is going to be your home for the next ten years. Sure! You have just gotten a ten-year \"jolt,\" John; so settle down and be a good prisoner."
                                            },
                                            {
                                                "example_id": "fe4dc61f-7914-4621-9f0e-7bbe75fd14d1",
                                                "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                                                "text": "But blow wise to this, buddy, blow wise to this: Never play cards with a man called Doc. Never eat at a place called Mom's. Never sleep with a woman whose troubles are worse than your own. Never let nobody talk you into shaking another man's jolt. And never you cop another man's plea. I've tried 'em all and I know. They don't work."
                                            },
                                            {
                                                "example_id": "f05b2fa3-6677-454f-97fb-5edfcefcd4ed",
                                                "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                                                "text": "After three \"jolts\" in prison, three separate periods of incarceration, Braly decided to try his hand at writing."
                                            },
                                            {
                                                "example_id": "0feb9117-1667-485a-b415-a1064e4ef0f4",
                                                "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                                                "text": "\"How long did she do after I left the joint\" / \"About a year or so. They wanted to parole her. […]\" Mae wrinkled her forehead. “It's hard to figure out, sometimes.” Again she frowned heavily. “I don't give a damn myself—I'm a thief, and nothing they can ever do will hurt me. But Mrs. Loring, now, she was different. That jolt did hurt her bad. […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350c4ca6-41e6-382c-a8bf-87113c54a713",
                                        "entry_id": "4039a4cf-1d9c-3e3c-a1f4-9fb99ce4708d",
                                        "glosses": [
                                            "A narcotic injection."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
