                    "sense_definition": "Aan de zijkant van iemand of iets; in de directe nabijheid.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zit in de klas altijd <w>naast</w> mijn beste vriend.",
                            "target_lang_translations": {
                                "ru": "В классе я всегда сижу <w>рядом с</w> моим лучшим другом.",
                                "en": "In class, I always sit <w>next to</w> my best friend.",
                                "pl": "W klasie zawsze siedzę <w>obok</w> mojego najlepszego przyjaciela.",
                                "de": "In der Klasse sitze ich immer <w>neben</w> meinem besten Freund.",
                                "fr": "En classe, je suis toujours assis <w>à côté de</w> mon meilleur ami.",
                                "it": "In classe mi siedo sempre <w>accanto a</w> mio fratello o al mio migliore amico.",
                                "cs": "Ve třídě sedím vždycky <w>vedle</w> svého nejlepšího kamaráda.",
                                "tr": "Sınıfta her zaman en iyi arkadaşımın <w>yanında</w> otururum.",
                                "es": "En clase siempre me siento <w>al lado de</w> mi mejor amigo."
                            }
                        },
                        {
                            "text": "Het postkantoor bevindt zich direct <w>naast</w> de supermarkt.",
                            "target_lang_translations": {
                                "ru": "Почтовое отделение находится прямо <w>возле</w> супермаркета.",
                                "en": "The post office is located right <w>next to</w> the supermarket.",
                                "pl": "Poczta znajduje się bezpośrednio <w>obok</w> supermarketu.",
                                "de": "Das Postamt befindet sich direkt <w>neben</w> dem Supermarkt.",
                                "fr": "Le bureau de poste se trouve juste <w>à côté du</w> supermarché.",
                                "it": "L'ufficio postale si trova proprio <w>accanto al</w> supermercato.",
                                "cs": "Pošta se nachází přímo <w>vedle</w> supermarketu.",
                                "tr": "Postane süpermarketin hemen <w>yanında</w> bulunuyor.",
                                "es": "La oficina de correos se encuentra justo <w>al lado del</w> supermercado."
                            }
                        }
