                    "frequency": "High",
                    "semantic_group_id": "tierjagd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Herbst <w>jagen</w> die Jäger oft Rehe und Wildschweine im dichten Wald."
                        },
                        {
