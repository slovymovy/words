                "senses": [
                    {
                        "sense_id": "3c1c3b30-fc3a-37c0-af0f-2dfdb427e4a4",
                        "entry_id": "abb84e87-921b-348d-b50e-8f496ea547dc",
                        "glosses": [
                            "legendenhaftes Wesen mit riesigen Füßen, einer beträchtlichen Größe und starker Fellbehaarung, welches sich in Nordamerika befinden soll"
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "cf6533a3-36d4-4140-9b49-c43652449475",
                                "sense_id": "3c1c3b30-fc3a-37c0-af0f-2dfdb427e4a4",
                                "text": "„Im Juli 1884 meldete sogar eine Zeitung in British Columbia, dass ein Sasquatch gefangen genommen und an einen Zirkus verkauft worden sei.“"
                            },
                            {
                                "example_id": "4d0c4357-58d9-4c82-bb19-914b4b08053d",
                                "sense_id": "3c1c3b30-fc3a-37c0-af0f-2dfdb427e4a4",
                                "text": "„Die meisten haben sich gedacht, dass Wölfe oder Wildhunde sie auf dem Gewissen haben. Andere tippen auf ’n Sasquash oder so was in der Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
