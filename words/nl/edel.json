    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d47e661-79ff-316b-a86c-591fe2b4392c",
                    "sense_definition": "behorend tot de stand van de adel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij komt uit een <w>edele</w> familie die al eeuwenlang in dit kasteel woont.",
                            "target_lang_translations": {
                                "en": "She comes from a <w>noble</w> family that has lived in this castle for centuries."
                            }
                        },
                        {
                            "text": "In de middeleeuwen hadden <w>edele</w> heren veel macht over het land.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, <w>noble</w> lords had a lot of power over the land."
                            }
                        }
                    ],
                    "synonyms": [
                        "adellijk"
                    ],
                    "common_phrases": [
                        "edele heren",
                        "edele familie"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to the social class of the nobility"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noble",
                                "target_lang_sense_clarification": "relating to the aristocracy"
                            },
                            {
                                "target_lang_word": "of noble birth",
                                "target_lang_sense_clarification": "born into the nobility"
                            },
                            {
                                "target_lang_word": "aristocratic",
                                "target_lang_sense_clarification": "belonging to the upper class"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61444173-4483-359a-9789-9f55cfe03578",
                    "sense_definition": "beschikkend over zeer goede morele eigenschappen of een verheven karakter",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een <w>edel</w> karakter en helpt altijd mensen in nood.",
                            "target_lang_translations": {
                                "en": "He has a <w>noble</w> character and always helps people in need."
                            }
                        },
                        {
                            "text": "Het was een <w>edel</w> streven om alle daklozen in de stad te helpen.",
                            "target_lang_translations": {
                                "en": "It was a <w>noble</w> endeavor to help all the homeless people in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "nobel",
                        "verheven",
                        "grootsmoedig"
                    ],
                    "antonyms": [
                        "onedel"
                    ],
                    "common_phrases": [
                        "edel karakter",
                        "edel streven"
                    ],
                    "target_lang_definitions": {
                        "en": "possessing very good moral qualities or an elevated character"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noble",
                                "target_lang_sense_clarification": "having high moral principles"
                            },
                            {
                                "target_lang_word": "magnanimous",
                                "target_lang_sense_clarification": "generous or forgiving"
                            },
                            {
                                "target_lang_word": "honorable",
                                "target_lang_sense_clarification": "worthy of respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6ca40d1-dbe7-35ac-86d2-3c934434246c",
                    "sense_definition": "van hoge kwaliteit of waarde, vaak gebruikt voor metalen of stenen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goud en zilver zijn voorbeelden van een <w>edel</w> metaal.",
                            "target_lang_translations": {
                                "en": "Gold and silver are examples of a <w>noble</w> metal."
                            }
                        },
                        {
                            "text": "Zij draagt een ring met een zeer <w>edele</w> steen erin verwerkt.",
                            "target_lang_translations": {
                                "en": "She is wearing a ring with a very <w>precious</w> stone set in it."
                            }
                        }
                    ],
                    "synonyms": [
                        "kostbaar",
                        "waardevol"
                    ],
                    "antonyms": [
                        "onedel"
                    ],
                    "common_phrases": [
                        "edel metaal",
                        "edele delen"
                    ],
                    "target_lang_definitions": {
                        "en": "of high quality or value, often used for metals or stones"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noble",
                                "target_lang_sense_clarification": "chemically unreactive, as in metals"
                            },
                            {
                                "target_lang_word": "precious",
                                "target_lang_sense_clarification": "of great value, like gems"
                            },
                            {
                                "target_lang_word": "valuable",
                                "target_lang_sense_clarification": "worth a lot of money"
                            }
                        ]
                    }
                }
