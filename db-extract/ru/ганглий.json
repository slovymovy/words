                                        "sense_id": "d5734ba3-a933-3259-9859-efc007bb5978",
                                        "entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                                        "glosses": [
                                            "A benign cystic tumour on a tendon sheath or joint capsule."
                                        ],
