                {
                    "sense_id": "d3395661-adc9-390e-ae65-df60e861e55b",
                    "sense_definition": "Qui manifeste, exprime ou évoque la force, la vivacité ou la détermination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vitalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a refusé la proposition d'un geste <w>énergique</w> de la tête devant ses collègues.",
                            "target_lang_translations": {
                                "en": "He turned down the suggestion with a <w>forceful</w> shake of the head in front of his colleagues.",
                                "ru": "На глазах у коллег он отверг предложение <w>энергичным</w> движением головы.",
                                "nl": "Voor het oog van zijn collega's weigerde hij het voorstel met een <w>krachtig</w> hoofdschudden.",
                                "de": "Er lehnte den Vorschlag vor seinen Kollegen mit einem <w>entschiedenen</w> Kopfschütteln ab.",
                                "pl": "Przed kolegami odrzucił propozycję <w>energicznym</w> ruchem głowy.",
                                "it": "Ha rifiutato la proposta con un gesto <w>energico</w> della testa davanti ai colleghi.",
                                "cs": "Před kolegy odmítl návrh <w>energickým</w> zavrtěním hlavy.",
                                "tr": "Meslektaşlarının önünde öneriyi başının <w>güçlü</w> bir hareketiyle reddetti.",
                                "es": "Rechazó la propuesta con un gesto <w>enérgico</w> de la cabeza delante de sus colegas.",
                                "zh": "他当着同事的面<w>有力</w>地摇了摇头，拒绝了这个提议。"
                            }
                        },
                        {
                            "text": "Le groupe a joué un morceau <w>énergique</w> pour réveiller le public dans la salle.",
                            "target_lang_translations": {
                                "en": "The band played a <w>lively</w> piece to wake up the audience in the hall.",
                                "ru": "Группа исполнила <w>энергичную</w> композицию, чтобы расшевелить публику в зале.",
                                "nl": "De groep speelde een <w>levendig</w> muziekstuk om het publiek in de zaal wakker te schudden.",
                                "de": "Die Band spielte ein <w>lebhaftes</w> Stück, um das Publikum im Saal wachzurütteln.",
                                "pl": "Zespół zagrał <w>żywiołowy</w> utwór, by obudzić publiczność na sali.",
                                "it": "Il gruppo ha suonato un brano <w>energico</w> per svegliare il pubblico in sala.",
                                "cs": "Skupina zahrála <w>živou</w> skladbu, aby probudila publikum v sále.",
                                "tr": "Grup, salondaki izleyicileri uyandırmak için <w>canlı</w> bir parça çaldı.",
                                "es": "El grupo tocó una pieza <w>enérgica</w> para despertar al público en la sala.",
                                "zh": "乐队演奏了一首<w>激昂</w>的乐曲，让现场的观众振奋起来。"
                            }
                        }
