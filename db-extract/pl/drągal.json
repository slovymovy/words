                            {
                                "example_id": "5f86fd26-f8ee-4431-ad13-e964e653ba60",
                                "sense_id": "890e0052-896d-3aa4-b1b9-aaff45d8ee69",
                                "text": "Przed drzwiami do harcówki stał drągal z plecakiem i gitarą."
