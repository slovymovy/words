                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur aime <w>assaisonner</w> son discours de traits d'esprit percutants pour captiver son auditoire."
                        },
                        {
                            "text": "Elle <w>assaisonne</w> toujours ses anecdotes d'une pointe d'ironie mordante."
