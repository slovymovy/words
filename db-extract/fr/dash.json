                                                "example_id": "b8931f15-00d4-4903-9ea0-ac3bd41a2caa",
                                                "sense_id": "51264c44-86eb-3d00-b3c5-edd78b4b45d6",
                                                "text": "The oar squeaks,\na dash sound like\nmoon-hustle on the river:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184c85f9-218a-3a6d-9e42-65f25e936f62",
                                        "entry_id": "34c6f81c-1f93-31ef-9d3c-389582a40109",
                                        "glosses": [
                                            "Violent strike; a whack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e86a0e-320d-4e98-99db-198ab2d40001",
                                                "sense_id": "184c85f9-218a-3a6d-9e42-65f25e936f62",
                                                "text": "They say that I’m way too cold, I never get tired of rappin\nMy word is bang where I come from\nWatch be one work is magic\nDo it and dash it\nSmile on MAT\nNo way this peng one acting\nWho got whacked and who got slapped\nAnd who got spared by dashes"
                                            }
