                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7cd720-4eed-4d9d-b8d2-f4c349a10ffb",
                                                "sense_id": "c4c9533e-557f-309b-8e62-16006bbbfbe1",
                                                "text": "Load profiles are a standard analysis tool showing passenger activity (boardings, alightings) and passenger load at each stop along a route in a single direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8cc550c-ff37-304e-970b-8c9c79eb1566",
                                        "entry_id": "48010e1f-ae80-32db-afb8-d0a3d9b429c1",
                                        "glosses": [
                                            "The act of a sailor or boarding party attacking an enemy ship by boarding it."
                                        ],
