                    {
                        "translation_id": "732f399c-1c68-4ada-bb76-7efe88725540",
                        "source_entry_id": "d79b2ff2-c52c-35db-aeee-ef64f34c30bb",
                        "source_sense_id": "a7c2a601-259b-3b4d-b983-ad3c5a13d252",
                        "source_sense_description": "umgangssprachlich: Menge von Menschen, die sich versammelt haben oder zusammen laufen; Menschenmenge",
                        "target_lang_word": "Menschenmenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenmenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                        "entry_id": "6daf9fb7-d188-32ae-8238-c0cceb0ebad9",
                                        "glosses": [
                                            "größere Ansammlung von Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e0550b-14ce-498a-9e84-8fbcb9cd6a2a",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "Zur Kundgebung fand sich eine große Menschenmenge ein."
                                            },
                                            {
                                                "example_id": "812de76e-e2a0-4b6e-a32a-0fcb50692ce5",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Plötzlich wurde das Bolzenschloß des Gittertors, das in die Zelle führte, aufgesperrt und wir befanden uns im Innern, wurden von der Menschenmenge verschluckt.“"
                                            },
                                            {
                                                "example_id": "5c699a40-1159-477c-b3e6-b4ef474aa0e2",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Offenen Mundes bestaunte er die schönen Häuser und Kirchen von Nantes wie auch die Menschenmenge und die Kleider der Damen.“"
                                            },
                                            {
                                                "example_id": "056c9c58-b086-4d34-8e8b-e76741b08779",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Noch ein letzter Blick, ein Winken, und die Vohryzeks verschwinden in der Menschenmenge.“"
                                            },
                                            {
                                                "example_id": "3e0dd094-cab5-43f6-9c1e-8dc69ab335b9",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Eine große Menschenmenge drängte in die Kirche.“"
                                            },
                                            {
                                                "example_id": "2f50dfcc-e7f1-42b0-82b7-ea1811377486",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Die Menschenmenge schwoll auf etwa 30 000 an, von denen sich 7000 zu einem Protestmarsch formierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
