{
    "word_family": [
        "cabbaging",
        "cabbaged",
        "cabbagy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0b0e37b-562d-35a7-8ef0-a6eea94a8ca4",
                    "sense_definition": "The leaves of the cabbage plant eaten as a vegetable.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fresh <w>cabbage</w> is good for you and contains many vitamins.",
                            "target_lang_translations": {
                                "ru": "Свежая <w>капуста</w> полезна для здоровья и содержит много витаминов."
                            }
                        },
                        {
                            "text": "I usually make a <w>cabbage</w> salad to serve with dinner.",
                            "target_lang_translations": {
                                "ru": "Обычно я готовлю салат из <w>капусты</w> на ужин."
                            }
                        }
                    ],
                    "synonyms": [
                        "greens"
                    ],
                    "common_phrases": [
                        "cabbage salad",
                        "red cabbage",
                        "boiled cabbage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Листья капусты, употребляемые в пищу как овощ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "овощ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae10960c-d51a-384e-aa53-85d13e908c9d",
                    "sense_definition": "An edible plant having a round head of green or purple leaves.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer is growing a large <w>cabbage</w> in his garden this year.",
                            "target_lang_translations": {
                                "ru": "В этом году фермер выращивает в своем саду большой кочан <w>капусты</w>."
                            }
                        },
                        {
                            "text": "In aphrodisiac preparation, wild <w>cabbage</w> was frequently an ingredient.",
                            "target_lang_translations": {
                                "ru": "При приготовлении афродизиаков часто использовалась дикая <w>капуста</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cabbage plant",
                        "cole"
                    ],
                    "common_phrases": [
                        "wild cabbage",
                        "head of cabbage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобное растение с круглой головкой из зеленых или фиолетовых листьев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "кочанная капуста",
                                "target_lang_sense_clarification": "вид растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79bb9fd2-835f-3103-882d-2a5bd9d12275",
                    "sense_definition": "Used as a term of endearment for someone you love.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "endearment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kissed her on the cheek and said, \"My little <w>cabbage</w>, I missed you.\"",
                            "target_lang_translations": {
                                "ru": "Он поцеловал ее в щеку и сказал: «Моя <w>радость</w>, я скучал по тебе»."
                            }
                        },
                        {
                            "text": "The old couple often called each other <w>cabbage</w> as a sweet nickname.",
                            "target_lang_translations": {
                                "ru": "Пожилые супруги часто называли друг друга ласковыми <w>прозвищами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "little cabbage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a translation of the French 'mon chou'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к любимому человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моя радость",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "голубчик",
                                "target_lang_sense_clarification": "устаревшее ласковое обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af6c2108-fb35-3de3-abc8-3b239729f19e",
                    "sense_definition": "A person with severely reduced mental capacities due to brain damage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the terrible car crash, he unfortunately became a <w>cabbage</w>.",
                            "target_lang_translations": {
                                "ru": "После ужасной автокатастрофы он, к сожалению, стал <w>овощем</w>."
                            }
                        },
                        {
                            "text": "It is very sad to see a brilliant mind reduced to a <w>cabbage</w>.",
                            "target_lang_translations": {
                                "ru": "Очень грустно видеть, как блестящий ум превращается в <w>овощ</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "can be considered offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с серьезно ограниченными умственными способностями из-за повреждения мозга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овощ",
                                "target_lang_sense_clarification": "человек в вегетативном состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b3af7ba-c6ca-38ff-8276-d04adc67488f",
                    "sense_definition": "A slang term for paper money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the store with a pocket full of <w>cabbage</w>.",
                            "target_lang_translations": {
                                "ru": "Он зашел в магазин с полным карманом <w>капусты</w>."
                            }
                        },
                        {
                            "text": "You need a lot of <w>cabbage</w> if you want to buy that car.",
                            "target_lang_translations": {
                                "ru": "Тебе понадобится много <w>бабок</w>, если хочешь купить ту машину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "referring to the green color of US banknotes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название бумажных денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "деньги, обычно доллары"
                            },
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f976d5e0-4e86-39c0-b7d4-666ea5452d28",
                    "sense_definition": "Scraps of cloth left over after a garment has been cut out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor kept the <w>cabbage</w> from the expensive silk to make small pouches.",
                            "target_lang_translations": {
                                "ru": "Портной оставил <w>обрезки</w> дорогого шелка, чтобы сделать маленькие мешочки."
                            }
                        },
                        {
                            "text": "Traditionally, tailors were allowed to keep the <w>cabbage</w> as a perk of the job.",
                            "target_lang_translations": {
                                "ru": "Традиционно портным разрешалось оставлять <w>лоскуты</w> себе в качестве бонуса к работе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "specifically used in the tailoring trade"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрезки ткани, оставшиеся после раскроя одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрезки",
                                "target_lang_sense_clarification": "остатки ткани"
                            },
                            {
                                "target_lang_word": "лоскуты",
                                "target_lang_sense_clarification": "кусочки ткани"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfac6963-b93c-36a4-befb-45803284a2fa",
                    "sense_definition": "To do nothing; to idle or spend time in a lazy way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "idling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On Sundays, I just like <w>cabbaging</w> in front of the TV all day.",
                            "target_lang_translations": {
                                "ru": "По воскресеньям мне нравится просто <w>киснуть</w> перед телевизором весь день."
                            }
                        },
                        {
                            "text": "Instead of studying, the students were <w>cabbaging</w> in the lounge.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы учиться, студенты <w>бездельничали</w> в холле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cabbaging in front of the TV"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "similar to 'veg out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ничего не делать; бездельничать или проводить время лениво."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киснуть",
                                "target_lang_sense_clarification": "лениво проводить время"
                            },
                            {
                                "target_lang_word": "овощевать",
                                "target_lang_sense_clarification": "бездельничать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9a04f56-0853-38a1-9491-145211951e0c",
                    "sense_definition": "To steal, pilfer, or embezzle small amounts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest clerk managed to <w>cabbage</w> a few dollars from the register every week.",
                            "target_lang_translations": {
                                "ru": "Нечестному клерку удавалось каждую неделю <w>подтибривать</w> несколько долларов из кассы."
                            }
                        },
                        {
                            "text": "He had <w>cabbaged</w> the best chair in the room before anyone else arrived.",
                            "target_lang_translations": {
                                "ru": "Он <w>занял</w> лучший стул в комнате до того, как пришли остальные."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "originally referring to tailors stealing cloth scraps"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красть, подворовывать или присваивать небольшие суммы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтибрить",
                                "target_lang_sense_clarification": "украсть по мелочи"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "украсть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}