        "fr-extract.jsonl": [
            {
                "entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                "word": "sublimation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c883f5c-7782-4599-abff-f443736f1e52",
                        "entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                        "tags": [
                            "plural"
                        ],
                        "form": "sublimations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5c2bffb-a9b0-3f22-b0ef-6dd9836ec8da",
                        "entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                        "glosses": [
                            "Changement d’état : action de sublimer, passage direct de l’état solide à l’état gazeux."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "8acbc6d7-307f-4851-aa18-48d49ca6eb65",
                                "sense_id": "f5c2bffb-a9b0-3f22-b0ef-6dd9836ec8da",
                                "text": "Le plomb est le plus vitrescible de tous les métaux, et l’étain l’est le moins : le mercure est le plus volatil de tous, et cependant il ne diffère de l’or, qui est le plus fixe de tous, que par le degré de feu que leur sublimation exige ; car l’or ainsi que tous les autres métaux peuvent également être volatilisés par une plus ou moins grande chaleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "0436dfa0-391f-338e-926a-66da9b569967",
                        "entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                        "glosses": [
                            "Action de transformer en élevant, exaltation, purification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1ff63f2-10b0-44ab-b1be-b68425f22c40",
                                "sense_id": "0436dfa0-391f-338e-926a-66da9b569967",
                                "text": "Le martyre est une sublimation, sublimation corrosive."
                            }
                        ]
                    },
                    {
                        "sense_id": "00097965-396e-32a1-9e71-c6c33dc90e1b",
                        "entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                        "glosses": [
                            "Dérivation de but de la pulsion sexuelle ou agressive, par exemple dans une création artistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae5547b-df87-4b6a-9903-92e053342fa5",
                                "sense_id": "00097965-396e-32a1-9e71-c6c33dc90e1b",
                                "text": "La sublimation érotique est fréquente dans les vocations d'artistes."
                            },
                            {
                                "example_id": "b9266686-ad02-4033-a6d0-097850ca7f0b",
                                "sense_id": "00097965-396e-32a1-9e71-c6c33dc90e1b",
                                "text": "Le polar noir est bien plus qu’un prétexte à une critique sociale : sans fard, il nous donne accès à la pulsion de destruction, dont la sublimation rend possible la civilisation, comme l’a montré Freud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e72f54b-d8bd-4884-8e2c-e7fda909056d",
                        "source_entry_id": "feae8f60-b336-3b88-b7ba-fa022fc42708",
                        "source_sense_id": "f5c2bffb-a9b0-3f22-b0ef-6dd9836ec8da",
