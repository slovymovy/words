                                        "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                                        "entry_id": "8cef2467-ac5d-37cd-a4f7-20ec42da3c1b",
                                        "glosses": [
                                            "The activation of something previously inactive or inactivated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0adf02f2-9a50-439d-8048-7518e1fffd5c",
                                                "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                                                "text": "Perhaps most alarming, reports arrive each hour of reawakened Precursor artifacts, including orbital ribbons, star roads, planetary fortresses, and citadels. Combined defense forces are inadequate to investigate and confirm all instances of these reactivations. They appear to be galaxy-wide."
                                            },
                                            {
                                                "example_id": "2ce22744-ca0c-4591-8c00-233b3b45c619",
                                                "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                                                "text": "The link also requires reactivation between South Acton Junction and Old Kew Junction (Kew Bridge). Both currently have occasional empty stock workings and excursion traffic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
