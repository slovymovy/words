                        "examples": [
                            {
                                "example_id": "a13e8c37-fd0d-4189-9037-066893206cb3",
                                "sense_id": "5b502191-1e9a-355c-972d-bb27cec272c1",
                                "text": "„Kaum war er außer Sichtweite, ließ Hudson das Gepäck des unliebsamen Mannes zum Themseufer schaffen und den Anker lichten.“"
                            },
                            {
                                "example_id": "4d6d6e70-8d18-4afd-872f-636753bf6b4e",
                                "sense_id": "5b502191-1e9a-355c-972d-bb27cec272c1",
                                "text": "„Aufrecht auf dem Streitwagen stehend, den Speer in der Rechten, verkörpert die Keltenführerin am linken Themeseufer bis heute den Freiheitsdrang der Briten – und die Verklärung der keltischen Frauen.“"
                            }
                        ],
