                "senses": [
                    {
                        "sense_id": "c9ecbf36-04e3-3ef3-b3bd-f7c5d48b11b3",
                        "entry_id": "385b393b-7d40-3784-96f2-72b30243416a",
                        "glosses": [
                            "jeweils typisch für ein Geschlecht (die Eigenschaft männlich oder weiblich zu sein); auf das jeweilige Geschlecht zugeschnitten/bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2355e904-2d53-454d-a00d-291121913b28",
                                "sense_id": "c9ecbf36-04e3-3ef3-b3bd-f7c5d48b11b3",
                                "text": "Die Frage danach, wer wieviel der Hausarbeit erledigt, wird immer noch geschlechterspezifisch beantwortet."
                            },
                            {
                                "example_id": "e5b7c67d-8a7d-4a86-a4cf-7a3c30b2f6ea",
                                "sense_id": "c9ecbf36-04e3-3ef3-b3bd-f7c5d48b11b3",
                                "text": "Die Statistiken sind in einem zweiten Schritt geschlechterspezifisch zu differenzieren."
                            },
                            {
                                "example_id": "ea41e694-fa23-4279-aef4-d2e5a4fbdafe",
