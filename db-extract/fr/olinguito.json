                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cc73a53-6ad2-4811-8b0d-9af4290878a2",
                        "entry_id": "d5aab2b8-ec59-30b4-a0d0-66a35f75a76a",
