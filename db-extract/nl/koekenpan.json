                                "target_senses": [
                                    {
                                        "sense_id": "953924c7-e59a-3e2e-9b54-39f6ca176024",
                                        "entry_id": "c4955983-364c-359e-a04e-d9b22971ef0b",
                                        "glosses": [
                                            "A long-handled, shallow pan used for frying food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0b8f98-f266-4ae4-a150-079d18fc51af",
                                                "sense_id": "953924c7-e59a-3e2e-9b54-39f6ca176024",
                                                "text": "And if thy oblation be a meate offering baken in the frying pan,it ſhalbe made of fine flowꝛe with oyle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f0e4af-b551-4a56-9bb5-b9849ee8f51c",
                        "source_entry_id": "5208d327-41be-388c-9fe6-7ff60649bc1a",
                        "source_sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
                        "source_sense_description": "een platte pan met een lang handvat",
                        "target_lang_word": "poêle à frire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poêle à frire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9689c0c0-0200-3cc5-a23d-24461eba5a78",
                                        "entry_id": "ad4cc358-8a88-3822-820b-46b0cb52b025",
                                        "glosses": [
                                            "Ustensile (plat) pour frire les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985d9735-05dd-4605-968a-89350a2766d5",
                                                "sense_id": "9689c0c0-0200-3cc5-a23d-24461eba5a78",
                                                "text": "Chauffez la quasi-totalité de l’huile d'olive dans une grande poêle à frire, à feu vif."
                                            },
                                            {
                                                "example_id": "a1e6e737-7db7-4365-a7f9-3e632fee7f52",
                                                "sense_id": "9689c0c0-0200-3cc5-a23d-24461eba5a78",
                                                "text": "Les riches n’imagineraient pas la simplicité de la batterie de cuisine qui consistait en une cuisinière, un chaudron, un gril, une casserole, deux ou trois marabouts, et une poêle à frire."
                                            },
                                            {
                                                "example_id": "363393de-e03d-4b1e-bf31-1418594aef39",
                                                "sense_id": "9689c0c0-0200-3cc5-a23d-24461eba5a78",
                                                "text": "Le Curé, en mourant, devait laisser à son successeur, un lit garni, un pot de cuivre , un crémail, quelques petits meubles de bois et une poêle à frire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2b1dcf3-b661-3ce7-bbd6-f08896a7d61e",
                                        "entry_id": "ad4cc358-8a88-3822-820b-46b0cb52b025",
                                        "glosses": [
                                            "Détecteur de métaux."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af42ddb-cc4a-4d43-93c0-8984f5925398",
                                                "sense_id": "f2b1dcf3-b661-3ce7-bbd6-f08896a7d61e",
                                                "text": "Concentrons-nous plutôt sur celui qui pratique la dénommée « détection de loisir », moyennant l’achat d’un détecteur de métal – la poêle à frire – pour quelques centaines d’euros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
