                    {
                        "form_id": "63a1d9eb-fcd2-43d7-8f17-3ab7d996ff8f",
                        "entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "respectueuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                        "entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                        "glosses": [
                            "Qui témoigne du respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a378e12-081a-40cc-8936-dbc14051eb12",
                                "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                                "text": "Le vent respectueux, parmi leurs tresses sombres,\nSur leur nuque de marbre errait en frémissant,\nTandis que les parois des rocs couleur de sang,\nComme de grands miroirs suspendus dans les ombres,\nDe la pourpre du soir baignaient leur dos puissant."
                            },
                            {
                                "example_id": "8040e8a9-3633-4161-a090-da46e4a30adf",
                                "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                                "text": "Sous la IIIᵉ république, les techniques d’élevage fabriquent en série de petits robots, respectueux des autorités, sexuellement refoulés, bon soldats, excellents travailleurs, anxieux, très portés au suicide. Mais les Français ont alors le droit compensatoire de faire des plaisanteries « gauloises » alors que les Allemands acceptent officiellement leur puritanisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                        "entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                        "glosses": [
                            "Qui marque du respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d7ba2d-6354-4e4b-bfe0-0acd33f9ccf5",
                                "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                                "text": "Je craignais que vous ne vinssiez jamais, répondit Popinot d’un air respectueux."
                            },
                            {
                                "example_id": "2427cb51-5b68-457c-a899-44f43652479f",
                                "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                                "text": "Puis il se releva, croisa les bras sur sa poitrine, et, avec une contenance plutôt respectueuse que craintive, il attendit la réponse de son roi, comme un homme qui sent qu’il peut avoir commis une faute, mais qui se repose sur la droiture de son intention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "633e7f14-03d8-4986-8c93-193ee84b04dd",
                        "source_entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                        "target_lang_word": "ehrerbietig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehrerbietig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c258e26-3d0d-3969-8369-15e2f59aad85",
                                        "entry_id": "fe5d4fd9-331a-3461-89ec-0b939b99c827",
                                        "glosses": [
                                            "großen Respekt, Ehrfurcht und/oder Wertschätzung vor jemandem oder etwas zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1b68ac-2144-4526-8470-217b555046ad",
                                                "sense_id": "8c258e26-3d0d-3969-8369-15e2f59aad85",
                                                "text": "„Er meinte […] den Anhauch von Orten zu spüren, an denen man, den Hut in der Hand, in eine gewisse, ehrerbietig vorwärts wiegende Gangart ohne Benutzung der Stiefelabsätze verfällt; […].“"
                                            },
                                            {
                                                "example_id": "631afcc9-a2be-4b91-8317-d6ee55fbad18",
                                                "sense_id": "8c258e26-3d0d-3969-8369-15e2f59aad85",
                                                "text": "„Eine ehrerbietige Gemeinschaft ist selbst dann, wenn ihre niedrigsten Klassen unintelligent sind, mehr für eine Kabinettsregierung geeignet als ein demokratisches Land, gleich welcher Art, weil es mehr Sinn für politische Exzellenz hat.“"
                                            },
                                            {
                                                "example_id": "18fe4b16-0647-4010-87cb-3b30150f41a5",
                                                "sense_id": "8c258e26-3d0d-3969-8369-15e2f59aad85",
                                                "text": "„Nur das ehrerbietige, fast furchtsame Verhalten aller Anwesenden ließ auf seine Bedeutung schließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4ebc079-e88a-421b-96c4-9d2b22a10341",
                        "source_entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                        "target_lang_word": "respektvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respektvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53652533-cf88-3855-8099-7d32770d2992",
                                        "entry_id": "a352066c-7dd9-3ab4-8141-b6af29bae879",
                                        "glosses": [
                                            "Respekt zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caa2075a-d491-4e72-8ae4-df9677aee958",
                                                "sense_id": "53652533-cf88-3855-8099-7d32770d2992",
                                                "text": "Ein bisschen respektvoller bitte!"
                                            },
                                            {
                                                "example_id": "d8f13609-0112-4211-9455-09bbfe108115",
                                                "sense_id": "53652533-cf88-3855-8099-7d32770d2992",
                                                "text": "Wir legen viel Wert auf einen respektvollen Umgang mit den jugendlichen Klienten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e6fecc5-8c23-4813-8920-ed08d67261ee",
                        "source_entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
