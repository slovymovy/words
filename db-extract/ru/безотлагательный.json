                        "entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "безотлага́тельнее"
                    },
                    {
                        "form_id": "da6b72e6-e0bf-45c4-b062-0794179ed1db",
                        "entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "безотлага́тельней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                        "entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "glosses": [
                            "не терпящий отлагательства, промедления, отсрочек на более поздний срок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "930ac7bb-cfaf-4130-8d07-8a227baec137",
                                "sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                                "text": "Но, с другой стороны, тут же рядом возникает вопрос, требующий безотлагательного объяснения."
                            },
                            {
                                "example_id": "9eb3f653-f90f-4788-b5a8-3eff622ba3a4",
                                "sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                                "text": "Потугин тоже сел, но тотчас же поднялся и, сказав, что у него есть безотлагательное дело и что он зайдет после обеда, стал раскланиваться."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd31f5a-7593-462d-ae40-88b119d8f10c",
                        "source_entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "source_sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                        "target_lang_word": "urgent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f34de082-e798-3e9f-8a73-a44be3db77a7",
                                        "entry_id": "abcc9cfd-82aa-38e5-9798-54bb2dcf9840",
                                        "glosses": [
                                            "Requiring immediate attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f2fd34-a52d-4842-ac7a-a18d697829cb",
                                                "sense_id": "f34de082-e798-3e9f-8a73-a44be3db77a7",
                                                "text": "An urgent appeal was sent out for assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                        "entry_id": "abcc9cfd-82aa-38e5-9798-54bb2dcf9840",
                                        "glosses": [
                                            "Of people: insistent, solicitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbbba72-4a30-475f-a460-1b9c467675db",
                                                "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                                "text": "The Egyptians were vrgent vpon the people that they might send them out of the land in haste."
                                            },
                                            {
                                                "example_id": "6defaee7-3f82-4968-92d2-fb4e1723a288",
                                                "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                                "text": "My kind friends here are most affectionately urgent with me to prolong my stay […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb0145a3-6ac3-401b-abc4-81cd11934c85",
                        "source_entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "source_sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                        "target_lang_word": "urgent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                        "entry_id": "ed53d443-4d76-3c6c-8d61-25f5571e7eaa",
                                        "glosses": [
                                            "Qui est pressant, qui ne souffre aucun retard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2314f0b-aaf3-43f7-98f2-296fe1d15c1b",
                                                "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                                            },
                                            {
                                                "example_id": "57140d26-84dd-4032-88ea-0bd3724b1fc1",
                                                "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                                "text": "Dans ce contexte, il n'est pas étonnant de constater que quatre Français sur cinq (80 %, +4 points depuis octobre) estiment désormais « qu'il est urgent de réduire la dette publique en France »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "urgent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3cc41b-24e3-305e-9203-067c8b912220",
                                        "entry_id": "fdd5ac23-98c3-34e2-b06c-88b7c0a94498",
                                        "glosses": [
                                            "Troisième personne du pluriel du présent de l’indicatif de urger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "521cc39e-5e15-36d7-a1d0-39178a55ee4f",
                                        "entry_id": "fdd5ac23-98c3-34e2-b06c-88b7c0a94498",
                                        "glosses": [
                                            "Troisième personne du pluriel du présent du subjonctif de urger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c33a04d-0f41-4c4d-9c2f-b1f7341fca56",
                        "source_entry_id": "d5e68730-6be6-3e0c-b4da-1bdcf7ce09e9",
                        "source_sense_id": "3c811829-d763-3f22-9f36-f150a2f00b82",
                        "target_lang_word": "immédiat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immédiat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4835d1-9ce0-37ab-a330-b5ed1cf66cd9",
                                        "entry_id": "82090c90-ead8-3223-bfcb-ec0f234445aa",
                                        "glosses": [
                                            "Qui agit, qui est produit sans intermédiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cc40c1-e461-4e6a-8cf4-19d4c526796d",
                                                "sense_id": "8f4835d1-9ce0-37ab-a330-b5ed1cf66cd9",
                                                "text": "Une statistique anglaise constate qu'à Londres quatre vols sur cinq ont pour cause immédiate la faim."
                                            },
                                            {
                                                "example_id": "5c22805b-c047-487d-94a7-ecfe0cab5c5e",
                                                "sense_id": "8f4835d1-9ce0-37ab-a330-b5ed1cf66cd9",
                                                "text": "Depuis longtemps, la lettre de change avait été comprise par lui dans toutes ses conséquences immédiates et médiates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5c3b0a2-8d87-3f9d-a05a-f4ec6cdb9051",
                                        "entry_id": "82090c90-ead8-3223-bfcb-ec0f234445aa",
                                        "glosses": [
                                            "Qualifie une connaissance acquise par l’esprit directement et sans intermédiaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21f0fd2-f066-4553-817e-07735fcd920c",
                                                "sense_id": "d5c3b0a2-8d87-3f9d-a05a-f4ec6cdb9051",
                                                "text": "La distinction des pensées ou connoissances, en médiates & immédiates prouve encore moins la prétendue imperceptibilité des pensées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b821e0-92bc-38c4-a525-1223970a2b40",
                                        "entry_id": "82090c90-ead8-3223-bfcb-ec0f234445aa",
                                        "glosses": [
                                            "Qui suit ou précède sans intervalle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5eb90d-7ad4-4f1f-b9dc-7f0fb9e28021",
                                                "sense_id": "b6b821e0-92bc-38c4-a525-1223970a2b40",
                                                "text": "Cette supposition n’a rien d’improbable, car les vues ambitieuses des rois franks n’allaient guère au-delà de la perspective d’un gain immédiat et personnel."
                                            },
                                            {
                                                "example_id": "f1830a2e-8eef-459f-96b0-c605f6e1d24c",
                                                "sense_id": "b6b821e0-92bc-38c4-a525-1223970a2b40",
                                                "text": "Ainsi, seules les manifestations perméabilisantes objectivées par le Bleu sont supprimées par l’action immédiate des rutosides."
                                            },
                                            {
                                                "example_id": "ccc36123-d18a-4d2a-81e0-ff25dc0f1fb4",
                                                "sense_id": "b6b821e0-92bc-38c4-a525-1223970a2b40",
                                                "text": "La mise en sécurité de l’enfant doit être immédiate (fiabilité des adultes)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
