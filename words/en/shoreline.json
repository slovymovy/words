    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea15825f-259b-3ecc-bf22-c59194e7cd30",
                    "sense_definition": "The edge or boundary where a body of water meets the land.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shoreline_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a peaceful evening walk along the sandy <w>shoreline</w> to watch the sunset.",
                            "target_lang_translations": {
                                "ru": "Мы совершили спокойную вечернюю прогулку по песчаной <w>береговой линии</w>, чтобы полюбоваться закатом."
                            }
                        },
                        {
                            "text": "The local community organized a massive <w>shoreline</w> cleanup to remove plastic waste from the beach.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество организовало масштабную уборку <w>побережья</w>, чтобы убрать пластиковый мусор с пляжа."
                            }
                        }
                    ],
                    "synonyms": [
                        "coastline",
                        "shore",
                        "waterline"
                    ],
                    "common_phrases": [
                        "rocky shoreline",
                        "sandy shoreline",
                        "shoreline cleanup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Край или граница, где водоем встречается с сушей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "береговая линия",
                                "target_lang_sense_clarification": "граница между водой и сушей"
                            },
                            {
                                "target_lang_word": "побережье",
                                "target_lang_sense_clarification": "прилегающая к воде полоса земли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb8586c3-89b0-3e7a-87e3-4e27829dd10c",
                    "sense_definition": "The line drawn on a map representing the boundary between land and water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shoreline_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cartographer carefully traced the jagged <w>shoreline</w> on the new navigation chart.",
                            "target_lang_translations": {
                                "ru": "Картограф тщательно вычертил изрезанную <w>береговую линию</w> на новой навигационной карте."
                            }
                        },
                        {
                            "text": "Due to rising sea levels, the official map's <w>shoreline</w> no longer matches the actual coast.",
                            "target_lang_translations": {
                                "ru": "Из-за повышения уровня моря <w>береговая линия</w> на официальной карте больше не совпадает с фактическим побережьем."
                            }
                        }
                    ],
                    "synonyms": [
                        "coastline"
                    ],
                    "common_phrases": [
                        "map shoreline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия, нанесенная на карту и представляющая границу между сушей и водой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "береговая линия",
                                "target_lang_sense_clarification": "обозначение границы на карте"
                            },
                            {
                                "target_lang_word": "линия берега",
                                "target_lang_sense_clarification": "картографическое очертание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
