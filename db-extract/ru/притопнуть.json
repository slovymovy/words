                "senses": [
                    {
                        "sense_id": "1db9f583-fa23-315a-bcb6-32b81f8e94db",
                        "entry_id": "23693236-7859-3c27-b963-6e0a662534e0",
                        "glosses": [
                            "топнуть слегка или в такт чему-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd8888c-dcc3-4d2d-bd02-a805b9ff85ff",
                                "sense_id": "1db9f583-fa23-315a-bcb6-32b81f8e94db",
                                "text": "― Эх! ― крикнул Пантелей и притопнул ногами."
                            },
                            {
                                "example_id": "ad84050c-0d18-44fe-8a57-e37359b54944",
                                "sense_id": "1db9f583-fa23-315a-bcb6-32b81f8e94db",
                                "text": "Подойдя, он притопнул лаптями и затряс портки."
                            },
                            {
                                "example_id": "6132bba6-3afd-4930-9f9d-102feb250e0d",
                                "sense_id": "1db9f583-fa23-315a-bcb6-32b81f8e94db",
                                "text": "Старейший цыган Федор Соколов повёл седым усом, сверкнул глазами, притопнул ногой, звякнул струной гитары, и грянул цыганский хор."
                            }
                        ]
                    }
