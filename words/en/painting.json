                            {
                                "target_lang_word": "покраска",
                                "target_lang_sense_clarification": "герундий (окрашивание поверхностей)"
                            },
                            {
                                "target_lang_word": "красящий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "zh": [
