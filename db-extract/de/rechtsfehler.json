                        "sense_id": "62db8c48-1095-32fc-8130-034a2447d989",
                        "entry_id": "a5e6f0b4-c394-3774-b700-b62b038f1591",
                        "glosses": [
                            "Fehler, der gegen geltendes Recht verstößt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80fc37bb-fc70-4074-be47-1e0dd3f2c2f4",
                                "sense_id": "62db8c48-1095-32fc-8130-034a2447d989",
                                "text": "„Bei richtiger Belehrung kann der Kunde den Vertrag nur innerhalb von zwei Wochen nach Erhalt widerrufen. Rechtsfehler haben dagegen zur Folge, dass die Frist nicht anläuft und Verträge grundsätzlich rückabgewickelt werden können.“"
                            },
                            {
                                "example_id": "13aae368-74d1-45d3-b2b3-bf6ae8e2d219",
                                "sense_id": "62db8c48-1095-32fc-8130-034a2447d989",
                                "text": "„Die Todesurteile gegen B. waren wegen Rechtsfehlern zweimal aufgehoben worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
