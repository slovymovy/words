                "senses": [
                    {
                        "sense_id": "ea1efcb0-351a-3472-bc5b-74da22639708",
                        "entry_id": "9b3f11a1-3ba6-3e44-9f66-2a1bb94b3c0b",
                        "glosses": [
                            "(kalter) Wind, der im Winter weht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4caa59-f94a-4691-98d6-3984f5c6e3da",
                                "sense_id": "ea1efcb0-351a-3472-bc5b-74da22639708",
                                "text": "„Es ist fast so, als würde ein nordskandinavischer Winterwind blasen, der beim Einatmen sofort zu Gehirnfrost führt.“"
                            },
                            {
                                "example_id": "7615885c-15dc-4a2e-85b1-42427c03d819",
                                "sense_id": "ea1efcb0-351a-3472-bc5b-74da22639708",
                                "text": "„Irgendwann in den nächsten Wochen wird sich endlich der Frühling gegen den grimmigen Winterwind, der immer noch über die Stadt fegt, durchsetzen.“"
                            },
                            {
                                "example_id": "a43973c8-23d1-420f-9e68-0c690530daad",
                                "sense_id": "ea1efcb0-351a-3472-bc5b-74da22639708",
                                "text": "„Die Bäume waren schön ohne ihr Laub, wenn du dich mit ihnen ausgesöhnt hattest, und der Winterwind blies über die Teiche, und die Fontänen stiegen in das helle Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
