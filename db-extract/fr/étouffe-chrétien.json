            {
                "entry_id": "930f45be-6560-3cfb-b052-1ada2f91d15c",
                "word": "étouffe-chrétien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2a5bcba-46b2-4616-8dc8-dce87417e6a1",
                        "entry_id": "930f45be-6560-3cfb-b052-1ada2f91d15c",
                        "tags": [
                            "plural"
