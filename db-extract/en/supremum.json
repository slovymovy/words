                        "form": "supremums"
                    },
                    {
                        "form_id": "c673500f-2db0-4ac2-981d-d30b6667d22d",
                        "entry_id": "cce2602d-5f60-328c-81de-161dd6b63dee",
                        "tags": [
                            "plural"
                        ],
                        "form": "suprema"
