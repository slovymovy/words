                "senses": [
                    {
                        "sense_id": "68c7d7eb-cd4c-3f79-a3ba-8dc58f6bb36c",
                        "entry_id": "b9c7017e-6895-3f47-9e1e-0c2dfc1e17fc",
                        "glosses": [
                            "mit Harz vollgesogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad377b4f-9083-47da-8793-2777b6fde2f1",
                                "sense_id": "68c7d7eb-cd4c-3f79-a3ba-8dc58f6bb36c",
                                "text": "„Er hatte eine Packung harzgetränkte Cannabis-Kaugummis aus der Tasche gezogen und dem Fahrer einen Streifen angeboten.“"
                            },
                            {
                                "example_id": "6bdaf058-027a-407e-94c4-21c8fb92feff",
                                "sense_id": "68c7d7eb-cd4c-3f79-a3ba-8dc58f6bb36c",
                                "text": "„Kurz darauf brannte eine Wand, die hohe Flamme fraß sich durch die harzgetränkten Planken.“"
