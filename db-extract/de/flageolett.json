                ],
                "senses": [
                    {
                        "sense_id": "e80df1de-599d-3de2-8dcd-76bbc24bad65",
                        "entry_id": "701a92ee-af76-34b1-b614-85de65073cd7",
                        "glosses": [
                            "altes Holzblasinstrument in sehr hoher Tonlage aus der Gruppe der Schnabelflöten, das mit der Blockflöte verwandt ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d3ea0d64-b2d0-4f34-8f06-b391bf84e61c",
                                "sense_id": "e80df1de-599d-3de2-8dcd-76bbc24bad65",
                                "text": "Im 19. Jahrhundert wurden Flageoletts in den Orchestern zunehmend von der Pikkoloflöte verdrängt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43e527ac-4368-3fd2-98ce-8c5f2c739c33",
                        "entry_id": "701a92ee-af76-34b1-b614-85de65073cd7",
                        "glosses": [
                            "sehr hohe flötenartige Töne der Saiteninstrumente von geheimnisvoll zartem Klangcharakter, die bei leichtem Berühren der gedämpften Saiten an den Schwingungsknotenpunkten entstehen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "c9ec8223-8c52-4a10-9652-41241af4fd54",
                                "sense_id": "43e527ac-4368-3fd2-98ce-8c5f2c739c33",
                                "text": "„Das Flageolett wird seit Mitte des 18. Jh. angewendet. Durch Paganini wurde es virtuos entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3c407e13-3141-3d56-8c6e-ca06d5f87a87",
                        "entry_id": "701a92ee-af76-34b1-b614-85de65073cd7",
