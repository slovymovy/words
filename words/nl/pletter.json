{
    "word_family": [
        "pletten",
        "verpletten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "133834a5-673b-364c-a1c7-0cda903d2256",
                    "sense_definition": "Iemand die iets platdrukt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>pletter</w> in de fabriek zorgt ervoor dat het metaal de juiste dikte krijgt.",
                            "target_lang_translations": {
                                "fr": "Le <w>presseur</w> dans l'usine veille à ce que le métal obtienne la bonne épaisseur."
                            }
                        },
                        {
                            "text": "Als ervaren <w>pletter</w> weet hij precies hoeveel kracht hij moet gebruiken.",
                            "target_lang_translations": {
                                "fr": "En tant que <w>presseur</w> expérimenté, il sait exactement quelle force il doit utiliser."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui écrase quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "presseur",
                                "target_lang_sense_clarification": "opérateur d'une machine à presser"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e01cf991-5e05-3885-97ed-3b784bcdab2b",
                    "sense_definition": "Voorwerp of machine waarmee men kan pletten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze zware <w>pletter</w> wordt gebruikt om afval tot kleine blokken te persen.",
                            "target_lang_translations": {
                                "fr": "Cette lourde <w>presse</w> est utilisée pour compacter les déchets en petits blocs."
                            }
                        },
                        {
                            "text": "De oude <w>pletter</w> in de werkplaats werkt nog steeds uitstekend.",
                            "target_lang_translations": {
                                "fr": "La vieille <w>presse</w> de l'atelier fonctionne encore parfaitement."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Objet ou machine utilisé pour écraser ou presser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "presse",
                                "target_lang_sense_clarification": "machine à écraser"
                            },
                            {
                                "target_lang_word": "aplatisseur",
                                "target_lang_sense_clarification": "outil ou machine pour aplatir"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd10d744-b5e3-3cd7-bc9a-7d387ee33bf8",
                    "sense_definition": "Iets dat volledig kapot is gevallen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het glas viel op de grond en viel <w>te</w> <w>pletter</w>.",
                            "target_lang_translations": {
                                "fr": "Le verre est tombé par terre et s'est brisé <w>en mille morceaux</w>."
                            }
                        },
                        {
                            "text": "De vaas viel van de tafel en viel <w>te</w> <w>pletter</w> op de harde vloer.",
                            "target_lang_translations": {
                                "fr": "Le vase est tombé de la table et s'est brisé <w>en mille morceaux</w> sur le sol dur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "te pletter vallen"
                    ],
                    "target_lang_definitions": {
                        "fr": "État de quelque chose qui s'est brisé en tombant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "en mille morceaux",
                                "target_lang_sense_clarification": "se dit d'un objet qui se brise violemment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58662329-4120-3f67-8b49-69be5f310258",
                    "sense_definition": "Een toestand van extreme verveling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen vervelen zich <w>te</w> <w>pletter</w> tijdens de lange autorit.",
                            "target_lang_translations": {
                                "fr": "Les enfants <w>s'ennuient à mourir</w> pendant le long trajet en voiture."
                            }
                        },
                        {
                            "text": "Zonder internet op vakantie vervelen we ons <w>te</w> <w>pletter</w>.",
                            "target_lang_translations": {
                                "fr": "Sans internet en vacances, nous <w>nous ennuyons à mourir</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich te pletter vervelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "État d'ennui extrême."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'ennuyer à mourir",
                                "target_lang_sense_clarification": "expression idiomatique pour un ennui profond"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c83045d3-ce95-32cf-b7ac-a6e805c897fd",
                    "sense_definition": "Een toestand van hevige schrik of emotie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik schrok me <w>te</w> <w>pletter</w> toen de deur plotseling openvloog.",
                            "target_lang_translations": {
                                "fr": "J'ai <w>sursauté de peur</w> quand la porte s'est ouverte brusquement."
                            }
                        },
                        {
                            "text": "Ze schrok zich <w>te</w> <w>pletter</w> door het harde geluid van de knal.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>sursauté de peur</w> à cause du bruit fort de la détonation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich te pletter schrikken"
                    ],
                    "target_lang_definitions": {
                        "fr": "État de peur ou d'émotion intense."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sursauter de peur",
                                "target_lang_sense_clarification": "avoir une réaction de peur soudaine"
                            },
                            {
                                "target_lang_word": "être mort de peur",
                                "target_lang_sense_clarification": "avoir très peur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e7b252b-62d2-3691-908e-3e048d3e7e61",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>pletteren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>pletter</w> het metaal met deze machine.",
                            "target_lang_translations": {
                                "fr": "<w>J'aplatis</w> le métal avec cette machine."
                            }
                        },
                        {
                            "text": "Elke dag <w>pletter</w> ik de blikjes voor de recycling.",
                            "target_lang_translations": {
                                "fr": "Chaque jour, <w>j'aplatis</w> les canettes pour le recyclage."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord pletteren."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe aplatir."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "j'aplatis",
                                "target_lang_sense_clarification": "forme conjuguée du verbe aplatir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47c079e3-dd17-3380-a4fe-560d65ffc483",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>pletteren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pletter</w> jij het materiaal voor het project?",
                            "target_lang_translations": {
                                "fr": "<w>Aplaties-tu</w> le matériau pour le projet ?"
                            }
                        },
                        {
                            "text": "Waarom <w>pletter</w> jij die dozen zo snel?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>aplatis-tu</w> ces cartons si rapidement ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord pletteren."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe aplatir."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tu aplatis",
                                "target_lang_sense_clarification": "forme conjuguée du verbe aplatir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "862a4315-9a3e-3bac-b6f1-d6119566df78",
                    "sense_definition": "Gebiedende wijs van <w>pletteren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pletter</w> nu het metaal in de juiste vorm!",
                            "target_lang_translations": {
                                "fr": "<w>Aplaties</w> maintenant le métal dans la bonne forme !"
                            }
                        },
                        {
                            "text": "<w>Pletter</w> die blikjes direct in de container.",
                            "target_lang_translations": {
                                "fr": "<w>Aplaties</w> ces canettes directement dans le conteneur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord pletteren."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe aplatir."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aplatis",
                                "target_lang_sense_clarification": "forme impérative du verbe aplatir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}