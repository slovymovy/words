                                                "example_id": "0ff44cc7-5d8e-4ee9-b2af-09b0fc2796c8",
                                                "sense_id": "8e6beee6-b9f9-35c1-8c2f-ad0cc1a62143",
                                                "text": "Новый блокбастер с заделом на будущую франшизу…"
                                            }
                                        ]
                                    }
                                ]
                            }
