                                            {
                                                "example_id": "acfe5c1e-f23b-4bac-9453-9f525efbae32",
                                                "sense_id": "76811aaa-d50c-340b-a6be-114d3c8b22ea",
                                                "text": "Ich finde mehrfarbige Häuser interessant."
                                            },
                                            {
                                                "example_id": "3a282035-f2c7-4929-90d5-a2f298979eaf",
                                                "sense_id": "76811aaa-d50c-340b-a6be-114d3c8b22ea",
                                                "text": "„Ohne Zweifel hatte die Druckerei Krebs einen guten Ruf, aber sie war nicht Spezialist für mehrfarbige Drucktechnik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
