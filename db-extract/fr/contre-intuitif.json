                ],
                "senses": [
                    {
                        "sense_id": "e6ee63ae-bfec-3776-82b1-d2b7a9ee5622",
                        "entry_id": "abde9978-46c9-3d2f-a475-0a069d883d7d",
                        "glosses": [
                            "Qui n’est pas intuitif ; qui va à l’encontre de l’intuition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b3ce64-09dd-4a46-b7be-20187c4f473c",
                                "sense_id": "e6ee63ae-bfec-3776-82b1-d2b7a9ee5622",
                                "text": "Cela semble contre-intuitif, mais c’est le fait."
                            },
                            {
                                "example_id": "37ce5367-9edf-4dc4-9b1d-dfc10b4ddefd",
                                "sense_id": "e6ee63ae-bfec-3776-82b1-d2b7a9ee5622",
                                "text": "Cette idée contre-intuitive d'une « Terre primitive froide » a d’abord été la conséquence des calculs thermodynamiques : bien que la température des océans primitifs de magma ait dépassé 1 000 °C, une croûte a pu se former par refroidissement en dix millions d’années seulement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "344a17ad-3dd7-45ed-85d9-38d2e6ad0bb8",
                        "source_entry_id": "abde9978-46c9-3d2f-a475-0a069d883d7d",
                        "source_sense_id": "e6ee63ae-bfec-3776-82b1-d2b7a9ee5622",
                        "target_lang_word": "erwartungswidrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dd834721-df26-4573-b006-9e2c50d463fc",
                        "source_entry_id": "abde9978-46c9-3d2f-a475-0a069d883d7d",
                        "source_sense_id": "e6ee63ae-bfec-3776-82b1-d2b7a9ee5622",
                        "target_lang_word": "kontraintuitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kontraintuitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                        "entry_id": "04d7ce27-a843-321b-b421-c853d2f1b69f",
                                        "glosses": [
                                            "entgegen der Intuition oder dem gesunden Menschenverstand; der Intuition widersprechend; schwer zu verstehen, nicht eingängig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3ced24-045f-4cc3-bcb2-0429f2ea5755",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Die Vorgehensweise wirkt zunächst kontraintuitiv, erweist sich jedoch als äußerst effizient und durchdacht."
                                            },
                                            {
                                                "example_id": "1a275ebe-8aba-40fd-8046-621c1d67342d",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Diese Fälle werden vielfach als kontraintuitiv empfunden und werden daher oft Paradoxien der materialen Implikation genannt."
                                            },
                                            {
                                                "example_id": "01c78db2-7808-4757-92b3-d68be7659fe8",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Ein Gedanke kann auf zwei Arten kontraintuitiv sein: Entweder widerspricht er intuitiven Schlussfolgerungen, oder er überträgt Schlussfolgerungen der einen Kategorie auf eine andere Kategorie, die diese Schlüsse normalerweise nicht zulässt."
                                            },
                                            {
                                                "example_id": "1d73c8c8-8dac-4186-90ce-0e8a3c5eb2cd",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "So besehen, stellt die Idee der kritischen Prüfung durchaus eine kontraintuitive Idee dar, kontraintuitiv im Licht der meisten Alltagsüberzeugungen.\""
                                            },
                                            {
                                                "example_id": "1138f457-d237-4cd2-abe2-828fde33cf28",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Diese Bedeutung ist umso höher einzuschätzen vor dem Hintergrund ihres kontraintuitiven Charakters in unserem Alltagsdenken."
                                            },
                                            {
                                                "example_id": "0909fb2e-fe88-41ce-8d21-d2e0e7e932b5",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Bourdieus kontraintuitive Idee der ökonomischen Verfremdung ist letztlich nicht kontraintuitiv."
                                            },
                                            {
                                                "example_id": "dec1693a-8d6d-4424-bac7-13cd28617daf",
                                                "sense_id": "876fbd64-8d92-3412-adca-e00d28677516",
                                                "text": "Darüber hinaus ist jede Form von (Sozial-)Konstruktivismus notwendigerweise kontraintuitiv."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
