                ],
                "senses": [
                    {
                        "sense_id": "3471cfd5-2809-34f3-a6cd-7d1f095e13fa",
                        "entry_id": "938adfa6-3fe9-3122-802b-4e7590efe4b5",
                        "glosses": [
                            "flaches Gebäck, bei dem der Teig direkt auf einem eingefetteten Backblech gebacken und mit einem süßen oder pikanten Belag versehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e4440a-913a-4693-b93f-9bd8df6ab53a",
                                "sense_id": "3471cfd5-2809-34f3-a6cd-7d1f095e13fa",
                                "text": "Ein Blechkuchen ist einfach lecker, schnell gemacht und gelingt auch Kochanfängern."
                            },
                            {
                                "example_id": "b47986ad-fade-464a-b864-1874bbcb1424",
                                "sense_id": "3471cfd5-2809-34f3-a6cd-7d1f095e13fa",
                                "text": "„Im November vergangenen Jahres sperrte anstelle einer Wok-und-Sushi-Bude in der Burggasse ein Laden namens \"Soup & Sin\" auf, der sich dank guter Suppen und noch besserer Torten und Blechkuchen schnell eine Fangemeinde aufgebaut hat.“"
                            },
                            {
                                "example_id": "f690bd92-8e00-46b3-adce-ac7862fbed61",
                                "sense_id": "3471cfd5-2809-34f3-a6cd-7d1f095e13fa",
                                "text": "„Zu den 122 in Weimar produzierten Artikeln gehören neben den 15 Blechkuchen auch 32 Brotartikel.“"
                            },
                            {
                                "example_id": "2ca7529e-f8f7-4e8f-9848-0291f2645ca9",
                                "sense_id": "3471cfd5-2809-34f3-a6cd-7d1f095e13fa",
                                "text": "„Darauf stellte sie Teller mit Fladenbrot, Butter, geräuchertem Lammfleisch, vier Stück Blechkuchen, zwei Weingläser und eine Flasche Rotwein, die sie mich zu öffnen bat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
