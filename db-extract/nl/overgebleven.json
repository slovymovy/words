                "senses": [
                    {
                        "sense_id": "20b3b65b-5eb6-38c3-8377-266ff38713bb",
                        "entry_id": "4e33e4a5-953b-3456-be53-daad971bc5c7",
                        "glosses": [
                            "iets of iemand die nog niet verdwenen of verslagen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f65ca147-407f-43ae-940b-194418f8f704",
                                "sense_id": "20b3b65b-5eb6-38c3-8377-266ff38713bb",
                                "text": "Het was niet goed, het was zenuwslopend, maar FC Twente is terug in de eredivisie. Omdat de enige overgebleven concurrent Sparta onderuit ging bij Jong PSV, was een punt tegen Jong AZ voldoende. De mooiste 0-0 van het seizoen voelde als de meest glorieuze zege. De ultieme bevrijding."
                            },
                            {
                                "example_id": "817ff40b-2cc9-4e7e-b5ae-877e4f6dd2a5",
                                "sense_id": "20b3b65b-5eb6-38c3-8377-266ff38713bb",
                                "text": "Bijna vijf jaar lang genoten ze zichtbaar van elkaars gezelschap, en wij, hun overgebleven kinderen, keken verrast en vertederd toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "7622de31-203c-350d-b29c-aafa171c119e",
                        "entry_id": "4e33e4a5-953b-3456-be53-daad971bc5c7",
                        "glosses": [
                            "van iets dat het nog niet is gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71060158-47a6-4d28-8865-6f7452b9df10",
                                "sense_id": "7622de31-203c-350d-b29c-aafa171c119e",
                                "text": "Ze doet een beroep op haar overgebleven kalmte."
                            },
                            {
                                "example_id": "f9da5e98-23a2-4421-a372-b09043a0f871",
                                "sense_id": "7622de31-203c-350d-b29c-aafa171c119e",
                                "text": "Ik nam het overgebleven eten mee in een doggy-bag, stak de snelweg over en boekte een kamer in het gedateerde Best Western Motel."
                            }
                        ]
                    }
