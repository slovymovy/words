                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a60af215-168a-37ca-a3d2-70b940a4b6f7",
                                        "entry_id": "fc304141-2988-3b9a-bced-a7cea0ae6f88",
                                        "glosses": [
                                            "The obtuse angle of the lower end of a rafter set sloping."
