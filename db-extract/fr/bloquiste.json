                    }
                ],
                "senses": [
                    {
                        "sense_id": "8886e47e-fe07-30b4-9830-3c7842d46d20",
                        "entry_id": "7606f507-4a66-3511-bf3e-36c3233c5538",
                        "glosses": [
                            "Membre ou partisan du Bloc québécois."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "ceffbecf-9566-4b4a-b052-c7fce895d304",
                                "sense_id": "8886e47e-fe07-30b4-9830-3c7842d46d20",
                                "text": "C'est cette image qui permet aux bloquistes d'aller chercher des appuis au-delà des rangs souverainistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b982ae07-8529-3f02-b630-00a23723acbc",
                        "entry_id": "7606f507-4a66-3511-bf3e-36c3233c5538",
                        "glosses": [
                            "Député du Bloc québécois."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3a503c83-a6ea-441c-9056-491ff80abad3",
                                "sense_id": "b982ae07-8529-3f02-b630-00a23723acbc",
                                "text": "Candidat libéral dans Louis-Saint-Laurent, à Québec, M. Fragasso s'était alors incliné devant le bloquiste Bernard Cleary."
                            },
                            {
                                "example_id": "4341138f-f358-4026-b7e0-5e0619ba3dbc",
                                "sense_id": "b982ae07-8529-3f02-b630-00a23723acbc",
                                "text": "Le dernier projet de loi en ce sens a été déposé en novembre dernier par les bloquistes. L'un des objectifs est de désigner les retraités comme créanciers prioritaires en cas de faillite."
                            }
                        ]
                    },
                    {
                        "sense_id": "faadfa16-ff89-3979-8647-34d46fad369f",
                        "entry_id": "7606f507-4a66-3511-bf3e-36c3233c5538",
                        "glosses": [
                            "Membre ou partisan d’un autre parti appelé Bloc."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7d5480ed-c106-4f88-bdcb-fa91f601d8ef",
                                "sense_id": "faadfa16-ff89-3979-8647-34d46fad369f",
                                "text": "Les bloquistes ne comptent pas sur les élections, bien entendu, pour faire la révolution, mais ils voudraient avoir un représentant aux Cortes, parce qu’elles sont utiles comme tribune."
                            }
                        ]
                    }
