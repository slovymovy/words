                    {
                        "translation_id": "d62eff05-246d-40c3-8c38-c4ed19d1ca35",
                        "source_entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
                        "source_sense_description": "to further process textile fabrics",
                        "target_lang_word": "veredeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veredeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac04e6c2-6c2a-3928-a179-e4787444b199",
                                        "entry_id": "4d5fd363-13f3-358b-bffa-881dd734b8d2",
                                        "glosses": [
                                            "etwas qualitativ verbessern, wertvoller (edler) machen, als es ehemals war"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cc7615-1e10-4869-931d-9e727fc603b9",
                                                "sense_id": "ac04e6c2-6c2a-3928-a179-e4787444b199",
                                                "text": "Die Firma veredelt ihr Mineralwasser mit einem Hauch Frucht sowie Vitaminen und Mineralien."
                                            },
                                            {
                                                "example_id": "4c0e465a-5249-4a4f-b161-533800ae5f58",
                                                "sense_id": "ac04e6c2-6c2a-3928-a179-e4787444b199",
                                                "text": "„Die mittelalterliche Feuervergoldung gilt noch heute als das anspruchsvollste Verfahren, um die Oberfläche zu veredeln.“"
                                            },
                                            {
                                                "example_id": "b5581a61-be9b-45fa-9293-aefc21f1c45e",
                                                "sense_id": "ac04e6c2-6c2a-3928-a179-e4787444b199",
                                                "text": "„So viele Mittel der Musik und Poesie regten in ihrer Unschuld, besser als die künstlichste Schulordnung vermocht hätte, zur geistigen Uebung und Empfänglichkeit für rhythmisches Gesetz an, und veredelten den gewohnten Lebensgang durch die Schätze der Erfahrung.“ (1836)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42c21129-74fb-3f8a-a902-1bd3f45a2f8d",
                                        "entry_id": "4d5fd363-13f3-358b-bffa-881dd734b8d2",
                                        "glosses": [
                                            "eine Pflanze durch das Aufsetzen eines Pfropfes einer Edelsorte verändern/verbessern"
                                        ],
                                        "tags": [
                                            "Gärtnerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64b9bad-f5ae-4f3a-ac6f-4f24bab37d00",
                                                "sense_id": "42c21129-74fb-3f8a-a902-1bd3f45a2f8d",
                                                "text": "Es gibt Situationen, in denen man Rebstöcke veredeln sollte, indem man eine andere, bessere Sorte auf den vorhandenen Stock okuliert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
