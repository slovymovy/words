                "senses": [
                    {
                        "sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                        "entry_id": "f1c0564e-e578-3edf-992b-96c709c4f543",
                        "glosses": [
                            "in der Tat, wirklich"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "160918bf-fff7-425a-9d3f-b909309f7026",
                                "sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                                "text": "Fürwahr, Daniel beherrscht die Klarinette sehr."
                            },
                            {
                                "example_id": "d780e922-449f-41be-b6c3-49a2ab6d5a92",
                                "sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                                "text": "Den Doktor?",
                                "translation": "Fürwahr! er dient Euch auf besondre Weise."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a0b58dd-4c5e-4619-954d-a8e82cc85c3e",
                        "source_entry_id": "f1c0564e-e578-3edf-992b-96c709c4f543",
                        "source_sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                        "source_sense_description": "gehoben, veraltend: in der Tat, wirklich",
                        "target_lang_word": "forsooth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forsooth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                        "entry_id": "329c9982-f240-3176-9874-3b6622bd6827",
                                        "glosses": [
                                            "Used as an intensifier, often ironic: indeed, really, truthfully."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4de5177-b9ec-403c-a8d7-ad92f8d341de",
                                                "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                                "text": "A fit man, forsooth, to governe a realme!"
                                            },
                                            {
                                                "example_id": "c6dc771b-41de-4ad9-9c4b-46026d7971b3",
                                                "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                                "text": "[F]or certes, ſayes he, / I haue already choſen my officer, and what was he? / Forſooth, a great Arithmeticion, [...]"
                                            },
                                            {
                                                "example_id": "624a7960-953e-46df-9a2c-ddcf007f335d",
                                                "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                                "text": "‘Saint forsooth!’ said ill-natured Mrs. Brady."
                                            },
                                            {
                                                "example_id": "ffd6f0b2-89a7-4ab4-9832-4579c721151f",
                                                "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                                "text": "The four boys pumped up their hate to hissing steam. Harmless, quotha. Innocent, forsooth."
                                            },
                                            {
                                                "example_id": "e27ad2f9-c66c-4b0c-b5d1-7426e2256a58",
                                                "sense_id": "41755fa6-959c-3759-8ac8-66ea552b934f",
                                                "text": "Her eyes widened. She squeaked a bit. \"Don't tell me she caught you bending again?\" \"Bending is right. I was half-way under the dressing-table. You and your singing,\" I said, and I'm not sure I didn't add the word \"Forsooth!\" Her eyes widened a bit further, and she squeaked another squeak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6335aa9-7aa2-4db7-b840-372dd0a9bf81",
                        "source_entry_id": "f1c0564e-e578-3edf-992b-96c709c4f543",
                        "source_sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                        "source_sense_description": "gehoben, veraltend: in der Tat, wirklich",
                        "target_lang_word": "in truth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b936ca3-c418-35d2-a937-aed9a5bb7b34",
                                        "entry_id": "879ffd1d-3b37-38c0-800d-626b134cda22",
                                        "glosses": [
                                            "Truthfully, to tell the truth, in fact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f09934-2cda-43ac-8d4d-f777bcf4de95",
                                                "sense_id": "6b936ca3-c418-35d2-a937-aed9a5bb7b34",
                                                "text": "I swear in all truth that I never knew about her crimes."
                                            },
                                            {
                                                "example_id": "154a949d-ba42-4f25-a1c4-6c1adc900c24",
                                                "sense_id": "6b936ca3-c418-35d2-a937-aed9a5bb7b34",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "1510778d-c241-41fe-b731-3bb8a35346d6",
                                                "sense_id": "6b936ca3-c418-35d2-a937-aed9a5bb7b34",
                                                "text": "In truth, Tottenham never really looked like taking all three points and this defeat means they face a battle to reach the knockout stages -with their next home game against PAOK Salonika on 30 November likely to prove decisive."
                                            },
                                            {
                                                "example_id": "c0a41ead-e2d2-423b-94a9-630471db8e64",
                                                "sense_id": "6b936ca3-c418-35d2-a937-aed9a5bb7b34",
                                                "text": "In truth, I suspect it will take more than the first term of a Labour government to address the shortcomings of the railway system in the North."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda831ea-ba67-42f6-b830-4a07f2c57d2b",
                        "source_entry_id": "f1c0564e-e578-3edf-992b-96c709c4f543",
                        "source_sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                        "source_sense_description": "gehoben, veraltend: in der Tat, wirklich",
                        "target_lang_word": "en vérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en vérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                        "entry_id": "1922b872-bb3c-321b-8cc0-6a18698ba5dc",
                                        "glosses": [
                                            "Selon la vérité ; vraiment ; assurément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1100648b-48fb-4f31-8f03-131e3ab06a45",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "— En vérité du bon Dieu ! s’exclama-t-elle… Puisque je vous dis que Madame n’est pas rentrée, monsieur Mintié !…"
                                            },
                                            {
                                                "example_id": "bd63a8f5-37a0-42c5-b0f4-73f068d181c4",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "Ribadier. — Eh ! Monsieur, je ne sais ce que vous voulez dire ! Si madame votre femme a un amant, ce n’est pas moi ! Vous vous serez trompé de piste dans la rue.\nSavinet. — En vérité ! Alors, monsieur, comment se fait-il que vous ayez mon chapeau, tandis que j’ai le vôtre ?"
                                            },
                                            {
                                                "example_id": "9b916871-d497-413f-b283-04ae9576cab0",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "En vérité, je ne crois pas qu’il existât dans toute la vallée un individu sain.\nL’éléphantiasis, la tuberculose et la lymphangite avaient fait là d’incroyables ravages."
                                            },
                                            {
                                                "example_id": "12dd7ec8-0e8b-4f5d-8892-5810b478c1bc",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "Intérieurement, le prêtre se réjouissait : il allait regrouper ses ouailles pas tellement impies, en vérité."
                                            },
                                            {
                                                "example_id": "9ddc350b-4785-47b9-b578-64b84dcee273",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "— En vérité, il peut monter sur les tapis les plus riches. Il a les pieds plus propres que nous.\n— En vérité, en vérité, dit Toursène très doucement."
                                            },
                                            {
                                                "example_id": "f243ca1d-4602-4f52-98c0-be1f00975b23",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "[…], je vénère Faulkner et je ne peux oublier qu’en vérité c’est un pochetron, un pochetron honteux qui se cachait sous des façons collet monté."
                                            },
                                            {
                                                "example_id": "2b3367c8-ab56-4281-855e-18e2df15ce72",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "Si l’on m’avait refusé ce Noir, mon destin en eût-il été changé ? Je ne crois pas en vérité."
                                            },
                                            {
                                                "example_id": "32176d8d-9219-4821-87e8-eac85df4949c",
                                                "sense_id": "ced70e4a-e5c9-3b1c-9d38-44d5aeeda020",
                                                "text": "En vérité, les chefs zoulous ne pouvaient refuser une telle offre, car la guerre ayant fait fuir tout le gibier, et le cheptel diminuant comme peau de chagrin, la famine menaçait les tribus. Parfois, il fallait savoir s’accommoder du Diable pour survivre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11089376-bcd7-49ec-b0ad-325991eddbd8",
                        "source_entry_id": "f1c0564e-e578-3edf-992b-96c709c4f543",
                        "source_sense_id": "135cf9e5-3d71-392c-a3ca-128ff9ec521c",
                        "source_sense_description": "gehoben, veraltend: in der Tat, wirklich",
                        "target_lang_word": "à dire vrai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à dire vrai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c862b6-820d-3266-9983-26b94cce00da",
                                        "entry_id": "f180e8be-6d7f-3bcf-b9d7-ec2aa5b58066",
                                        "glosses": [
                                            "Variante de à vrai dire."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b727fc5c-bd43-4b73-96b7-6dbb5ad02a57",
                                                "sense_id": "a3c862b6-820d-3266-9983-26b94cce00da",
                                                "text": "Il a accepté votre proposition, mais, à dire vrai, sans enthousiasme."
                                            },
                                            {
                                                "example_id": "ab9bda39-48fc-4358-902c-c729418dba37",
                                                "sense_id": "a3c862b6-820d-3266-9983-26b94cce00da",
                                                "text": "À dire vrai, ces peintres n’avaient pas bonne réputation sur la place de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
