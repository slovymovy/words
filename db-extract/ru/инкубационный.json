                        "form": "инкубацио́нна"
                    },
                    {
                        "form_id": "a90b8fe3-c6fe-4c54-8e7e-c97ffde169b7",
                        "entry_id": "97abdfbd-6fd4-3cff-8e27-fee7a0be7bbb",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "инкубацио́нны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0ec662e-049c-3695-8659-550abf2d069c",
                        "entry_id": "97abdfbd-6fd4-3cff-8e27-fee7a0be7bbb",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным инкубация; характеризующийся инкубацией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31bf6975-93c2-47a8-b71b-339a158ec522",
                                "sense_id": "e0ec662e-049c-3695-8659-550abf2d069c",
                                "text": "Кружки самообразования, никогда не переводившиеся в русских высших учебных заведениях и особенно распространенные в 70-71 годах, когда социализм и революция находились в своем теоретическом, можно сказать инкубационном периоде, разумеется, стали заводиться и здесь."
                            },
                            {
                                "example_id": "5939d7f5-c87d-4634-8d4d-365af1a7fd35",
                                "sense_id": "e0ec662e-049c-3695-8659-550abf2d069c",
                                "text": "Инкубационный период чумы ― так нам офицеры сказали ― две недели〈…〉"
                            }
                        ]
                    },
                    {
                        "sense_id": "1200bab2-4f61-3d52-8044-4e4d8c3135ee",
                        "entry_id": "97abdfbd-6fd4-3cff-8e27-fee7a0be7bbb",
                        "glosses": [
                            "спец. предназначенный для инкубации, инкубирования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11788dd6-106d-4b35-b6a7-7397b2336aff",
                                "sense_id": "1200bab2-4f61-3d52-8044-4e4d8c3135ee",
                                "text": "Внедряет заводской способ воспроизводства рыб (включая авторский надзор за строительством полевых инкубационных цехов)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32994df7-8660-461a-a95a-143e924410ba",
                        "source_entry_id": "97abdfbd-6fd4-3cff-8e27-fee7a0be7bbb",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным инкубация",
                        "target_lang_word": "incubatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incubatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27c20db0-abca-306d-8e17-c778359cc150",
                                        "entry_id": "2068a10f-3219-3adc-bbf6-965b3577f4f3",
                                        "glosses": [
                                            "Serving for or pertaining to incubation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9cd475-c3e4-4c33-9916-de428e1e6024",
                                                "sense_id": "27c20db0-abca-306d-8e17-c778359cc150",
                                                "text": "The measurement investigations show furthermore that some of the wintered gammarid females commenced to get eggs in their incubatory pouches at about the end of January."
                                            },
                                            {
                                                "example_id": "707364c8-6ddd-4b19-99ec-2abcc10740e7",
                                                "sense_id": "27c20db0-abca-306d-8e17-c778359cc150",
                                                "text": "Two incubatory pockets in the body wall also occur in Cucumaria coatsi."
                                            },
                                            {
                                                "example_id": "f06a821b-dadd-4b50-af25-dbfc755d692c",
                                                "sense_id": "27c20db0-abca-306d-8e17-c778359cc150",
                                                "text": "Incubatory medicine was popular in the Greco-Roman world, the most famous example being the sanctuary of Asclepius at Epidauros in southern Greece, which attracted many pilgrims seeking healing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incubatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b44f5144-c4e3-3430-9861-368cf59b2676",
                                        "entry_id": "487cc594-1d90-3167-a2b7-a8f869a58696",
                                        "glosses": [
                                            "A building where eggs are incubated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c319ac-527d-4bb2-82b7-e71aa44b897f",
                                                "sense_id": "b44f5144-c4e3-3430-9861-368cf59b2676",
                                                "text": "As already stated, the incubatory is constructed of sun-dried bricks, mortar and earth."
                                            },
                                            {
                                                "example_id": "7c3d4c16-4008-44c2-8b65-4c9aa1b23014",
                                                "sense_id": "b44f5144-c4e3-3430-9861-368cf59b2676",
                                                "text": "Eggs are bought for the incubatory at never exceeding 5 cents per dozen, and chicks just from the shell are sold at less than 15 cents per dozen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
