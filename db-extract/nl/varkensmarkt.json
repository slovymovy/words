                        "examples": [
                            {
                                "example_id": "3dfc16bc-d4b9-4a0f-9082-65b94b1126de",
                                "sense_id": "6d3b94e2-e2ad-3e44-975b-109759198514",
                                "text": "Provimi had in het eerste half jaar te lijden onder de vogelpest en ongunstige koersen van de Poolse zloty en de dollar. Dat leidde ertoe dat de nettowinst van de wereldleider in diervoeding inzakte tot 1,8 miljoen euro. (…) In de VS daalde de omzet door ongunstige wisselkoersen en een zwakke varkensmarkt."
                            }
                        ]
