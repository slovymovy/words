                "senses": [
                    {
                        "sense_id": "c73d0182-7414-3884-93f2-70fd4a8cccaa",
                        "entry_id": "5088e7ef-d18d-3063-a411-34f769ec7b1a",
                        "glosses": [
                            "Compétition internationale, organisée sur le modèle des Jeux olympiques, mais réservée au sport universitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b6e4a5-9ad2-4ab3-82c1-15d3bc420a91",
                                "sense_id": "c73d0182-7414-3884-93f2-70fd4a8cccaa",
                                "text": "Lorsque je rejoins le club de l’En Avant Guingamp (EAG), je retrouve Clarisse Le Bihan et Aminata Diallo, avec qui j’ai partagé les joies des Universiades en Corée du Sud."
                            },
                            {
                                "example_id": "fd463051-5adb-4967-a670-e9239f458853",
                                "sense_id": "c73d0182-7414-3884-93f2-70fd4a8cccaa",
                                "text": "J’ai eu la chance de vivre de l’intérieur les Jeux olympiques en 1992 et en 1988 avec l’équipe de France d’Athlétisme et puis j’ai eu la chance de participer à quatre Universiades."
                            },
                            {
                                "example_id": "79f8b31a-d6c9-4a1f-8218-81f043945789",
                                "sense_id": "c73d0182-7414-3884-93f2-70fd4a8cccaa",
                                "text": "Le Président du C.E. de l’Universiade de Turin, le Dr. Primo Nebiolo (au centre), un personnage qui va conduire la FISU vers les plus hautes sphères du sport international."
                            }
                        ]
                    }
                ],
