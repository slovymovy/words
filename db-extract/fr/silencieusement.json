                                    },
                                    {
                                        "sense_id": "451fd701-8976-33a2-8772-42e7c6dbc160",
                                        "entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                                        "glosses": [
                                            "перен. не протестуя, безропотно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3342f6-c8bd-423b-83e3-7021b4567eac",
                                                "sense_id": "451fd701-8976-33a2-8772-42e7c6dbc160",
                                                "text": "Вообрази: я здесь одна, Никто меня не понимает, Рассудок мой изнемогает, И молча гибнуть я должна."
