                    {
                        "sense_id": "db324dbd-ceba-383d-b595-4e746e1aeb45",
                        "entry_id": "9fb08425-2c3b-342c-a646-db6a6b2c389a",
                        "glosses": [
                            "A certain stone with spangles of gold color in it, known to Pliny, perhaps golden mica or yellow mica schist."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c102f52-cb01-4d2f-991d-ed31923c0d4e",
                                "sense_id": "db324dbd-ceba-383d-b595-4e746e1aeb45",
                                "text": "Nearly everything was glass in the frontage of this fairy mart, and its contents glittered like the hammochrysos stone."
                            },
                            {
                                "example_id": "d25d21ef-44c9-41f2-9817-bcdb56532b89",
                                "sense_id": "db324dbd-ceba-383d-b595-4e746e1aeb45",
                                "text": "A splendid curtain, silver-sewn,\nSpangled like hammochrysos stone\nStood in a crypt that dripped delight,\nHis ear-drums pulsing with that sound\nThe sheeted waters in their might\nFlung to the crags, to mock their thrall."
                            },
                            {
                                "example_id": "406dffe5-1a50-458f-9fb9-6574a0fa4641",
                                "sense_id": "db324dbd-ceba-383d-b595-4e746e1aeb45",
                                "text": "Hammochrysos resembles sand in appearance, but sand mixed with gold."
                            }
                        ]
                    }
