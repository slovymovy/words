                "senses": [
                    {
                        "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                        "entry_id": "d46de78a-b058-339a-852c-f96f2a219a7c",
                        "glosses": [
                            "Orthographe ancienne de dévouement."
                        ],
                        "tags": [
                            "Archaïque",
                            "orthographe d’avant 1835"
                        ],
                        "examples": [
                            {
                                "example_id": "bce34e7f-6726-4762-8405-22fe62d71cb9",
                                "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                                "text": "Oh ! monsieur, les dévoûments de la femme sont sublimes !"
                            },
                            {
                                "example_id": "edfb53c4-52d2-4dca-8c44-ee16e3f67f5b",
                                "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                                "text": "Le dévoûment est rare, surtout sans solde, sans espérance, comme le concevait Modeste."
                            },
                            {
                                "example_id": "eb2721e2-e9af-4a5d-bde6-c8475a87ac51",
                                "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                                "text": "— Tenez, je vous crois ; vous avez l’air d’un brave jeune homme. D’ailleurs votre fortune est peut-être au bout de votre dévoûment."
                            },
                            {
                                "example_id": "91f02350-4bce-4f5a-9478-75ece01a3c10",
                                "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                                "text": "On ne peut pas demander à un gendre le dévoûment qu’on est en droit d’attendre d’un fils."
                            },
                            {
                                "example_id": "5a94b06d-9029-4465-b02e-34592bf0d6d9",
                                "sense_id": "22ed49ba-9681-3fc6-b0f9-00373d95175c",
                                "text": "Il en est un pur et calmant,\nC’est le frisson du dévoûment\nPar qui l’âme est secrètement\nRécompensée ; […]"
                            }
                        ]
                    }
                ],
