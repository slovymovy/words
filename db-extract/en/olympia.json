                    {
                        "translation_id": "4b048085-b527-4b72-bb5a-fd38ad21a6d5",
                        "source_entry_id": "4c7c39ee-a54b-3009-9127-b17c69a253a3",
                        "source_sense_description": "ancient city in Greece",
                        "target_lang_word": "Olimpia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olimpia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d666b2-f2be-3a4c-8ba4-d46cdedee288",
                                        "entry_id": "f70a10a2-fbc6-3975-8da9-3afa6f237c10",
                                        "glosses": [
                                            "Ciudad de la antigua Grecia, situada al nordeste de la península del Peloponeso. Poseía el santuario de Zeus, el más importante de las polis griegas, donde a partir del año 776 antes de Cristo (a.C.) comenzaron a celebrarse juegos atléticos cada cuatro años, enviando cada polis atletas que las representaran en sus competencias."
                                        ],
                                        "tags": [],
                                        "examples": [],
