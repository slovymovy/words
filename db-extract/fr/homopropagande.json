                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1705b73-f287-46ca-8ff3-fb928a684db9",
                                                "sense_id": "f935feb3-a49d-3710-9467-55298884407b",
                                                "text": "[…] with posts on Uued Uudised, the news portal affiliated with EKRE, often deriding \"homopropaganda\" both in Estonia and abroad. They have claimed that same-sex marriage is a danger to the nation, where heterosexual marriage and children are the one thing that will ensure that it survives."
                                            },
                                            {
                                                "example_id": "d84f51fb-2597-4c50-900f-d859a7975917",
                                                "sense_id": "f935feb3-a49d-3710-9467-55298884407b",
                                                "text": "In December 2011, Mr. Milonov's initiative appeared to ban homopropaganda in Saint Petersburg and the Leningrad region."
                                            }
