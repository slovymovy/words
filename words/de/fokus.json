                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Linguistik bildet der <w>Fokus</w> den wichtigsten Informationsanteil eines Satzes."
                        },
                        {
                            "text": "Durch die veränderte Betonung verschiebt sich der <w>Fokus</w> auf das Satzende."
