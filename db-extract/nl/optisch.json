                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8b6ce7-ff12-3c6f-809c-5864b828cff8",
                                        "entry_id": "72f8b73d-f283-37c0-a258-6ec73948ca73",
                                        "glosses": [
                                            "Of, or relating to the eye or to vision."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71535706-b975-4feb-9a51-a9b213542917",
                                                "sense_id": "7a8b6ce7-ff12-3c6f-809c-5864b828cff8",
                                                "text": "The moon, whose orb / Through optic glass the Tuscan artist views."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0b4530-7a8c-3033-84f5-34e5afe3d744",
                                        "entry_id": "72f8b73d-f283-37c0-a258-6ec73948ca73",
                                        "glosses": [
                                            "Of, or relating to optics or optical instruments."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "optic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89b72d95-3ff4-3a5e-8617-7736d19d75fb",
                                        "entry_id": "e4cb8b25-9cd9-33ce-b3c2-03379f6f379d",
                                        "glosses": [
                                            "An eye."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99c2b919-a295-42e6-b7f8-81d6c961a8f7",
                                                "sense_id": "89b72d95-3ff4-3a5e-8617-7736d19d75fb",
                                                "text": "The difference is as great between / The optics seeing, as the object seen."
                                            },
                                            {
                                                "example_id": "546834d2-467a-49df-9d16-f051c311a0de",
                                                "sense_id": "89b72d95-3ff4-3a5e-8617-7736d19d75fb",
                                                "text": "how they, / Who saw those figures on the margin kiss all, / Could turn their optics to the text and pray, / Is more than I know[…]"
                                            },
                                            {
                                                "example_id": "041d6ecb-1004-4c02-8cf3-3f58fcd1c44d",
                                                "sense_id": "89b72d95-3ff4-3a5e-8617-7736d19d75fb",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42193e29-a330-3a3a-882c-cc2d05920488",
                                        "entry_id": "e4cb8b25-9cd9-33ce-b3c2-03379f6f379d",
                                        "glosses": [
                                            "A lens or other part of an optical instrument that interacts with light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8581b35-4286-40cf-bae8-b2ad2ffdf274",
                                                "sense_id": "42193e29-a330-3a3a-882c-cc2d05920488",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe80ebac-ad62-316e-a839-0e727ae57ddb",
                                        "entry_id": "e4cb8b25-9cd9-33ce-b3c2-03379f6f379d",
                                        "glosses": [
                                            "A measuring device with a small window, attached to an upside-down bottle, used to dispense alcoholic drinks in a bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11932ab5-70f0-4f62-b16c-a58d0dd0c752",
                                                "sense_id": "fe80ebac-ad62-316e-a839-0e727ae57ddb",
                                                "text": "They were neatly lined up on three shelves between the optics of martini, vodka, whisky and gin."
                                            },
                                            {
                                                "example_id": "1dc4a654-e5f9-4fd2-a87d-2a8d9ad32998",
                                                "sense_id": "fe80ebac-ad62-316e-a839-0e727ae57ddb",
                                                "text": "They pulled up two bar stools and looked around the room as the barman relieved the whisky optic of its contents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
