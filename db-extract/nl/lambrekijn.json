                        "sense_id": "105aa903-c9ad-3bb1-b53b-932bb4470e26",
                        "entry_id": "f45eb034-d25f-30c7-8590-65b1c7515185",
                        "glosses": [
                            "versiering van een horizontale rand met geschulpt afhangend textiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d4f80-e925-402a-82a8-98495938d3d5",
                                "sense_id": "105aa903-c9ad-3bb1-b53b-932bb4470e26",
                                "text": "Rondom hingen gordijnen, waarvan de bevestiging aan de hemel schuilging onder een lambrekijn; de zomen waren afgezet met passementen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6118f466-0462-3ba3-932e-9b1a9182ab94",
                        "entry_id": "f45eb034-d25f-30c7-8590-65b1c7515185",
                        "glosses": [
                            "versiering die vanaf het helmteken om een wapenschild afhangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a0f082-3f91-443a-80b2-1649a226d6e1",
                                "sense_id": "6118f466-0462-3ba3-932e-9b1a9182ab94",
                                "text": "Het wapen van dat dorp, een ossehoofd keel op veld argent, met helm en lambrekijn, verscheen in huis op menig voorwerp aangebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc45b27-453c-3c44-999a-7a20f1d295d5",
                        "entry_id": "f45eb034-d25f-30c7-8590-65b1c7515185",
                        "glosses": [
                            "versiering van een horizontale rand met in steen of gips nagebootst geschulpt afhangend textiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b5ee44f-8113-44fa-81ef-2744c10ddf91",
                                "sense_id": "9bc45b27-453c-3c44-999a-7a20f1d295d5",
                                "text": "Hier heeft het zolderraam een geschulpte bovenrand en een lambrekijn, zoals ook te zien is bij Nieuwestad 156 (1756)."
                            }
                        ]
                    }
