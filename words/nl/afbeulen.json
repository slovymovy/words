        "gebeul"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db8c3935-0a42-3aff-8031-72e78ec359c6",
                    "sense_definition": "Iemand heel hard laten werken of trainen tot hij of zij volledig uitgeput is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitputten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De strenge trainer wilde zijn spelers tijdens de training volledig <w>afbeulen</w>.",
                            "target_lang_translations": {
                                "en": "The strict coach wanted to completely <w>exhaust</w> his players during the training session."
                            }
                        },
                        {
                            "text": "Je moet jezelf niet zo <w>afbeulen</w> voor een simpel examen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>work yourself to death</w> like that for a simple exam."
                            }
                        }
                    ],
                    "synonyms": [
                        "afmatten",
                        "uitputten",
                        "afpeigeren",
                        "vermoeien"
                    ],
                    "common_phrases": [
                        "jezelf afbeulen",
                        "een speler afbeulen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele of sportgerelateerde contexten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone work or train extremely hard until they are completely exhausted."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exhaust",
                                "target_lang_sense_clarification": "to wear out completely"
                            },
                            {
                                "target_lang_word": "run ragged",
                                "target_lang_sense_clarification": "to exhaust someone by making them work hard"
                            },
                            {
                                "target_lang_word": "work to death",
                                "target_lang_sense_clarification": "to make someone work excessively hard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae11df0-6c77-3b87-abc7-c6e772aae976",
                    "sense_definition": "Zelf heel hard en zwaar werken of zwoegen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zwoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na urenlang <w>afbeulen</w> op het land was de boer doodop.",
                            "target_lang_translations": {
                                "en": "After <w>toiling</w> on the land for hours, the farmer was exhausted."
                            }
                        },
                        {
                            "text": "Zij moesten de hele dag <w>afbeulen</w> om de deadline te halen.",
                            "target_lang_translations": {
                                "en": "They had to <w>slave away</w> all day to meet the deadline."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwoegen",
                        "aanpoten",
                        "buffelen",
                        "pezen",
                        "ploeteren",
                        "sloven"
                    ],
                    "common_phrases": [
                        "de hele dag afbeulen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt om zware fysieke of mentale arbeid te beschrijven."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To work or toil extremely hard and heavily yourself."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "toil",
                                "target_lang_sense_clarification": "to work extremely hard"
                            },
                            {
                                "target_lang_word": "slave away",
                                "target_lang_sense_clarification": "to work very hard like a slave"
                            },
                            {
                                "target_lang_word": "slog",
                                "target_lang_sense_clarification": "to work hard over a period of time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb9b012-1f12-38b1-aa5d-252fcdd524e4",
                    "sense_definition": "Iemand fysiek of mentaal pijnigen of kwellen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kwellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangenen werden door de bewakers genadeloos <w>afgebeuld</w>.",
                            "target_lang_translations": {
                                "en": "The prisoners were mercilessly <w>abused</w> by the guards."
                            }
                        },
                        {
                            "text": "Het is onmenselijk om dieren op die manier te <w>afbeulen</w>.",
                            "target_lang_translations": {
                                "en": "It is inhumane to <w>maltreat</w> animals in that way."
                            }
                        }
                    ],
                    "synonyms": [
                        "afpijnigen",
                        "beulen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In deze betekenis minder gebruikelijk in het moderne Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To torment or torture someone physically or mentally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "torment",
                                "target_lang_sense_clarification": "to cause severe physical or mental suffering"
                            },
                            {
                                "target_lang_word": "maltreat",
                                "target_lang_sense_clarification": "to treat cruelly or violently"
                            },
                            {
                                "target_lang_word": "abuse",
                                "target_lang_sense_clarification": "to treat with cruelty or violence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
