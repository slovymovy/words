                            {
                                "target_lang_word": "первоначальный",
                                "target_lang_sense_clarification": "исходный, имевшийся в начале"
                            },
                            {
                                "target_lang_word": "первичный",
                                "target_lang_sense_clarification": "исходный, служащий первопричиной"
                            },
                            {
                                "target_lang_word": "исходный",
                                "target_lang_sense_clarification": "начальный"
                            }
                        ]
