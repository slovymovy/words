                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epidermis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6b6f66f-4bea-3639-bd16-e9578bc4df27",
                                        "entry_id": "20c52d32-84cd-3f1f-b21a-0d19950dbad6",
                                        "glosses": [
                                            "Oberhaut der Wirbeltiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e932a074-ac0c-4e9d-9d28-154f9bad7a07",
                                                "sense_id": "a6b6f66f-4bea-3639-bd16-e9578bc4df27",
                                                "text": "Als Epidermis bezeichnet man die Oberhaut bei Wirbeltieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7518b71-dc8e-3455-91f6-4610daef4248",
                                        "entry_id": "20c52d32-84cd-3f1f-b21a-0d19950dbad6",
                                        "glosses": [
                                            "äußerste Zellschicht bei Wirbellosen und Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd6f6ed-b41a-49a1-adf2-c7d5ddaa0e72",
                                                "sense_id": "a7518b71-dc8e-3455-91f6-4610daef4248",
                                                "text": "Als Epidermis bezeichnet man ein primäres Abschlussgewebe von Sprossachse und Blättern bei höheren Pflanzen."
                                            },
                                            {
                                                "example_id": "73e37fca-6817-484a-acd1-cc92ee399c0c",
                                                "sense_id": "a7518b71-dc8e-3455-91f6-4610daef4248",
                                                "text": "„Oft fressen sie nur die obersten Schichten der Weinblätter ab und lassen die untere Epidermis als durchsichtiges Häutchen stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c16b58d-e6db-44bd-bb22-bfff67147f6e",
                        "source_entry_id": "0de80e36-b012-399d-979c-207d7a665474",
                        "source_sense_id": "3199bfd5-d427-37a7-bb85-6a9c2745baa6",
                        "target_lang_word": "epidermis",
