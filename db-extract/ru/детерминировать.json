                "senses": [
                    {
                        "sense_id": "2d9f992a-bfbd-30e1-b115-53e0a4f45ecc",
                        "entry_id": "8e929d0e-3a54-387a-9414-b0b796d16f24",
                        "glosses": [
                            "книжн. обусловливать, предопределять, задавать характер и направление какого-либо процесса и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c4b8b82-661d-4c38-8f98-436eed26ccdd",
                                "sense_id": "2d9f992a-bfbd-30e1-b115-53e0a4f45ecc",
                                "text": "Это, конечно, не означает, что сама болезнь как биологический фактор детерминирует перестройку иерархии мотивов и самосознания."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a8fdaf7-d4c7-47b9-ba71-3394cbf61bc6",
                        "source_entry_id": "8e929d0e-3a54-387a-9414-b0b796d16f24",
                        "source_sense_id": "2d9f992a-bfbd-30e1-b115-53e0a4f45ecc",
                        "target_lang_word": "determine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "determine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a93213a-0441-3219-b2ed-7277c9163b50",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To set the boundaries or limits of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab2768f6-3617-444a-b911-df0dff689d97",
                                                "sense_id": "1a93213a-0441-3219-b2ed-7277c9163b50",
                                                "text": "[God] hath determined the times before appointed."
                                            },
                                            {
                                                "example_id": "470692f2-d495-447c-a8b0-5bb20942bbb3",
                                                "sense_id": "1a93213a-0441-3219-b2ed-7277c9163b50",
                                                "text": "The knowledge of men hitherto hath been determined by the view or sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211ed3f3-6ccc-363d-8fca-59a0fe06232f",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To ascertain definitely; to figure out, find out, or conclude by analyzing, calculating, or investigating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1efe6e-3928-4b5c-8e1c-f935a501645c",
                                                "sense_id": "211ed3f3-6ccc-363d-8fca-59a0fe06232f",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690d80ee-5768-309e-8cfa-a4c8b251f34c",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To fix the form or character of; to shape; to prescribe imperatively; to regulate; to settle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0767ff9-68fe-44e9-938d-aece7d9369e1",
                                                "sense_id": "690d80ee-5768-309e-8cfa-a4c8b251f34c",
                                                "text": "The character of the soul is determined by the character of its God."
                                            },
                                            {
                                                "example_id": "aec3ce76-5fd0-4ec2-b336-0e8911b3549a",
                                                "sense_id": "690d80ee-5768-309e-8cfa-a4c8b251f34c",
                                                "text": "something divinely beautiful […] that at some time or other might influence or even determine her course of life"
                                            },
                                            {
                                                "example_id": "51cb4a35-0f4c-43f5-83d4-060fd34ce6af",
                                                "sense_id": "690d80ee-5768-309e-8cfa-a4c8b251f34c",
                                                "text": "These dramas may appear purely internal but they are perhaps economically determined … when people think they are being so subtly inventive or creative they merely reflect society's general need for economic growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370a6541-1dcc-3b01-9ba4-63dc0ee2537e",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To fix the course of; to impel and direct; with a remoter object preceded by to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94f7c92-491a-414d-b4ea-aa62c2bf3b90",
                                                "sense_id": "370a6541-1dcc-3b01-9ba4-63dc0ee2537e",
                                                "text": "The news of his father's illness determined him to depart immediately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a18c9f-07fd-35f1-a418-b36852716fed",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To bring to a conclusion, as a question or controversy; to settle authoritative or judicial sentence; to decide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdd7da5-19e9-4b07-b1e1-60cb35320fc6",
                                                "sense_id": "15a18c9f-07fd-35f1-a418-b36852716fed",
                                                "text": "The court has determined the cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b671be3e-6700-3e78-b7d2-2b679595ee2c",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To resolve (to do something); to establish a fixed intention; to cause (something) to come to a conclusion or decision; to lead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a853fc-b413-4267-a9f4-210ffe8ca8eb",
                                                "sense_id": "b671be3e-6700-3e78-b7d2-2b679595ee2c",
                                                "text": "I determined to go home at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a45666-f00e-3fe1-b6e0-a70bffef17e2",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To define or limit by adding a differentia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                                        "entry_id": "e19133fe-ca72-3e3b-9d61-cbc445a91362",
                                        "glosses": [
                                            "To bring to an end, finish; to come to an end, stop, end."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4786190-6b7c-455f-a849-fe0c5d8d671b",
                                                "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                                                "text": "Novv, vvhere is hee, that vvill not ſtay ſo long\nTill his Friend ſickneſſe hath determin'd me?"
                                            },
                                            {
                                                "example_id": "a12ebeb4-80b7-47df-bb24-84f60a7086a1",
                                                "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                                                "text": "[…] whose assemblies are continued […] for the space of seven moons, after which their authority determines, and writs are issued for new elections."
                                            },
                                            {
                                                "example_id": "17b5e317-36de-4bd3-9c90-da59104eed2b",
                                                "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                                                "text": "The statutes for the general government of the new universities ... shall be made in the first instance ... by the Dublin Commissioners appointed under this Act, and ... by the Belfast Commissioners appointed under this Act, and, after the powers of these commissioners determine, by the governing bodies of the universities and colleges."
                                            },
                                            {
                                                "example_id": "a87a9a5e-f901-4142-9fca-60cf9215be3f",
                                                "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                                                "text": "If a lease is determined by notice, forfeiture or frustration, all incumbrances will normally end automatically with the determination of the lease and can therefore be ignored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
