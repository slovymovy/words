                "senses": [
                    {
                        "sense_id": "2841e5ba-7356-336e-b667-806505ac04e0",
                        "entry_id": "22ff01f1-66e4-3e3f-b1ef-6a86c3c41e95",
                        "glosses": [
                            "Rassembler des choses éparses, du bois, du foin, des objets, etc."
                        ],
                        "tags": [
                            "Centre-Ouest"
                        ],
                        "examples": [
                            {
                                "example_id": "21424b33-7266-4541-9516-a06f56021f7d",
                                "sense_id": "2841e5ba-7356-336e-b667-806505ac04e0",
                                "text": "On rapilotait le foin en randes et on en faisait également des pilots qui étaient des débuts de braguenaies."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d38c738-f34f-39c5-9ea0-fc8687d9c68d",
                        "entry_id": "22ff01f1-66e4-3e3f-b1ef-6a86c3c41e95",
                        "glosses": [
                            "Se resserrer, se tasser sur soi même."
                        ],
                        "tags": [
                            "analogy",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d04436-79ea-4277-8224-aa603713cba8",
                                "sense_id": "3d38c738-f34f-39c5-9ea0-fc8687d9c68d",
                                "text": "On conçoit maintenant pourquoi la susdite Bigourne, avant de fondre sur le dos des passants se capissait et se rapilotait dans l’ombre."
                            }
                        ]
                    }
