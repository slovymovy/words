{
    "word_family": [
        "confidence",
        "confident",
        "confidential",
        "confidant",
        "confidante"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91535254-8fbd-3dd8-8cc9-3ae61c719d1b",
                    "sense_definition": "To share secrets or private matters with someone you trust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confide_secrets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needed someone to <w>confide</w> in after a very difficult week at work.",
                            "target_lang_translations": {
                                "ru": "Ей нужно было кому-то <w>довериться</w> после очень тяжелой недели на работе."
                            }
                        },
                        {
                            "text": "It is important to have a close friend you can <w>confide</w> in during tough times.",
                            "target_lang_translations": {
                                "ru": "Важно иметь близкого друга, которому можно <w>довериться</w> в трудные времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "trust"
                    ],
                    "common_phrases": [
                        "confide in a friend",
                        "confide in someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делиться секретами или личными переживаниями с тем, кому вы доверяете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довериться",
                                "target_lang_sense_clarification": "поделиться сокровенным с кем-либо, испытывая доверие"
                            },
                            {
                                "target_lang_word": "откровенничать",
                                "target_lang_sense_clarification": "быть искренним, открыто рассказывать о личном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "483ee1bb-9149-3ff1-81b1-d86d67b93446",
                    "sense_definition": "To tell something secret or personal to someone in confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confide_secrets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>confided</w> her deepest fears to her sister during their long walk.",
                            "target_lang_translations": {
                                "ru": "Во время долгой прогулки она <w>доверила</w> сестре свои самые глубокие страхи."
                            }
                        },
                        {
                            "text": "He <w>confided</w> that he was planning to leave the company next month.",
                            "target_lang_translations": {
                                "ru": "Он <w>доверительно</w> сообщил, что планирует уйти из компании в следующем месяце."
                            }
                        }
                    ],
                    "synonyms": [
                        "reveal",
                        "disclose"
                    ],
                    "antonyms": [
                        "conceal",
                        "hide"
                    ],
                    "common_phrases": [
                        "confide a secret",
                        "confide one's fears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщать что-то секретное или личное кому-либо в доверительной форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверить",
                                "target_lang_sense_clarification": "сообщить кому-либо тайну или сокровенное"
                            },
                            {
                                "target_lang_word": "поведать",
                                "target_lang_sense_clarification": "рассказать что-то важное или тайное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22ecb075-e179-3642-bb33-2b91217187a4",
                    "sense_definition": "To place trust or have faith in someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trust_faith",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>confide</w> in his ability to lead us through this crisis.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>довериться</w> его способности провести нас через этот кризис."
                            }
                        },
                        {
                            "text": "In times of uncertainty, they <w>confide</w> in the wisdom of their elders.",
                            "target_lang_translations": {
                                "ru": "Во времена неопределенности они <w>полагаются</w> на мудрость своих старейшин."
                            }
                        }
                    ],
                    "synonyms": [
                        "trust",
                        "rely"
                    ],
                    "antonyms": [
                        "distrust",
                        "mistrust"
                    ],
                    "common_phrases": [
                        "confide in someone's judgment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense of trusting or having faith in is less common in modern English than sharing secrets."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возлагать надежды или иметь веру в кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверяться",
                                "target_lang_sense_clarification": "полагаться на кого-либо, испытывая доверие"
                            },
                            {
                                "target_lang_word": "полагаться",
                                "target_lang_sense_clarification": "рассчитывать на чью-то помощь или суждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "310b8941-4917-33d0-9965-f3e192006651",
                    "sense_definition": "To entrust a task, duty, or object to the care of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>confide</w> the important project to his most reliable employee.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>доверить</w> важный проект своему самому надежному сотруднику."
                            }
                        },
                        {
                            "text": "Before leaving the country, she <w>confided</w> her estate to a trusted lawyer.",
                            "target_lang_translations": {
                                "ru": "Перед отъездом из страны она <w>доверила</w> свое имущество надежному адвокату."
                            }
                        }
                    ],
                    "synonyms": [
                        "entrust",
                        "commit",
                        "consign"
                    ],
                    "common_phrases": [
                        "confide a task to"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Entrust is much more commonly used in modern English for this meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поручать выполнение задачи, обязанности или заботу о чем-либо кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверить",
                                "target_lang_sense_clarification": "поручить что-либо кому-либо, передать в распоряжение"
                            },
                            {
                                "target_lang_word": "поручить",
                                "target_lang_sense_clarification": "возложить на кого-либо выполнение дела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}