                                        "sense_id": "1a797246-7b30-3b5e-b46d-0ee400a830e9",
                                        "entry_id": "032d3a49-d04b-31e2-81af-8d1f90020c36",
                                        "glosses": [
                                            "sich hinsichtlich der räumlichen Lage/Position nicht verändern lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5695dce8-6e4b-47b5-976f-b10fbe08ca4f",
                                                "sense_id": "1a797246-7b30-3b5e-b46d-0ee400a830e9",
                                                "text": "Dieser Schrank ist wahnsinnig schwer; er ist unverrückbar."
                                            },
                                            {
                                                "example_id": "3a182a77-ab4f-46ef-8ae7-6327dd9f0016",
                                                "sense_id": "1a797246-7b30-3b5e-b46d-0ee400a830e9",
                                                "text": "„Den großen Schreibtisch aus ihrem Büro musste sie allerdings zurücklassen - er ist unverrückbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14520a48-edf6-38b3-b308-2d9aa3d8428c",
                                        "entry_id": "032d3a49-d04b-31e2-81af-8d1f90020c36",
                                        "glosses": [
                                            "sich durch nichts abbringen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a246065a-5483-4500-bd97-769f09666940",
                                                "sense_id": "14520a48-edf6-38b3-b308-2d9aa3d8428c",
                                                "text": "„Die Ziele selbst und der Zeitpunkt, bis wann sie erreicht sein müssen, sollten jedoch unverrückbar sein.“"
                                            },
                                            {
                                                "example_id": "2edad3f4-0e93-478d-a94b-a02ea961e4b5",
                                                "sense_id": "14520a48-edf6-38b3-b308-2d9aa3d8428c",
                                                "text": "„Dem großen Verfechter von Multikulturalität und Pluralismus ist deshalb auch nichts heilig – schließlich steht das Heilige für einen unverrückbaren Wahrheitsanspruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
