                ],
                "senses": [
                    {
                        "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                        "entry_id": "387bbd7a-c668-3b4f-8032-b9edc9bca0a4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9b7ca2-74eb-40b3-9d5c-e96702ca56ac",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Frau Rosenberger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4cb5fdcb-2856-49a8-9d94-e8946f359f66",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Herr Rosenberger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "96761e89-7c57-40ff-82e0-fafb57746a4f",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Die Rosenbergers fahren heute nach Amsterdam."
                            },
                            {
                                "example_id": "ff212eca-9912-4e85-adb0-90ee7b0cf480",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Der Rosenberger trägt nie die Pullover, die die Rosenberger ihm strickt."
                            },
                            {
                                "example_id": "de142840-08fb-4a8c-a534-dc840b0ee810",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rosenberger kommt, geht der Herr Rosenberger.“"
                            },
                            {
                                "example_id": "d368857b-c95c-40d4-9938-9f1b3e137b32",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Rosenberger kommt und geht."
                            },
                            {
                                "example_id": "0113b406-1d99-4586-908a-56f0f0b1c2a1",
                                "sense_id": "21b98fcf-8deb-3852-b90d-38e18f430e0b",
                                "text": "Rosenbergers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
