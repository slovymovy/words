                "senses": [
                    {
                        "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                        "entry_id": "6e6909f4-3e48-3336-ba8e-e0aa485b0ff1",
                        "glosses": [
                            "Satisfied, pleased, contented."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "ba9cef44-6ff6-42fb-951b-58a3376d31e6",
                                "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                                "text": "He spoke with a certain what-is-it in his voice, and I could see that, if not actually disgruntled, he was far from being gruntled."
                            },
                            {
                                "example_id": "3564d52e-a0a2-46bc-a085-8da91d4bfb44",
                                "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                                "text": "It had been a rough day, so when I walked into the party I was very chalant, despite my efforts to appear gruntled and consolate."
                            },
                            {
                                "example_id": "513f1267-24d5-4aa8-8423-7f025358e2bc",
                                "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                                "text": "After all, a number of players were disgruntled, and a few more were gruntled."
                            },
                            {
                                "example_id": "077af7a3-58b1-4fcc-8eed-5ed7f1ad62a7",
                                "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                                "text": "[S]he was rumoured to be rather less than gruntled when The Soup's Joel McHale said: \"Here's Ryan Seacrest and Tyra Banks playing Lady and the Tramp ... You figure out which is which.\""
                            },
                            {
                                "example_id": "d9f45089-65f7-4599-818a-4a5ab8f8ab48",
                                "sense_id": "220527f5-8aad-346d-85e7-cfa96c375397",
                                "text": "Gruntled employees are happy employees. Gruntled employees like their coworkers. … gruntled employees like their employers. … So how do you keep your employees gruntled?"
                            }
                        ]
                    }
