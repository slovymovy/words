                    {
                        "translation_id": "6fd40d57-2a7a-436b-ac22-8176428aad71",
                        "source_entry_id": "117b4e8d-8884-39ee-b7e5-0e1edcfd39f7",
                        "source_sense_description": "to publish personal information (of an individual) on the Internet",
                        "target_lang_word": "doxen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doxen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                        "entry_id": "dba6497b-d97d-30d0-9aea-66b02f7d093e",
                                        "glosses": [
                                            "(üblicherweise mit bösartigen, rachsüchtigen Absichten) jemandes personenbezogene Daten zusammentragen und, ohne Zustimmung des Betroffenen, unerlaubterweise im Internet veröffentlichen"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8496b09-c0d1-41ec-84e2-ceaf4fad1953",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Im Netz heißt es: ‚Wenn Ihr nicht aufhört mit der Scheiße, werden wir Euch doxen, doxen, doxen‘, also immer mehr Daten veröffentlichen.“"
                                            },
                                            {
                                                "example_id": "0ac4f2c3-28e3-4ab6-8834-4e2f283023d9",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Am Ende aber drohen der oder die Autoren: ‚Das war Teil 1. Wenn ihr nicht mit diesem Scheiß aufhört, werden wir weiter doxen.‘ Als ‚doxen‘ wird im Netz das Mobbing durch die Veröffentlichung persönlicher Daten bezeichnet.“"
                                            },
                                            {
                                                "example_id": "4aef110d-388b-4853-bedf-289bbd160406",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Alle Zeitungen haben es veröffentlicht, aber offen gestanden, mich hat keiner gedoxt; andere Autoren, die auch auf der Liste standen, und die ich gefragt habe, wurden auch nicht gedoxt.“"
                                            },
                                            {
                                                "example_id": "a5627e1e-2a8f-44ea-92eb-3935bd048c8f",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Das hielt Leute, die im Namen von Anonymous agieren, nicht davon ab, weitere Personen zu ‚doxen‘, wie sie das Enttarnen nennen.“"
                                            },
                                            {
                                                "example_id": "af9b9554-4933-41c8-ade6-53d16eab775b",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Nicht zuletzt haben wir unser Vokabular erweitert: Vor einem Jahr wussten wir weder, was ‚Social Justice Warriors‘ sein könnten, noch was es bedeutet, wenn jemand ‚gedoxt‘ wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
