                "senses": [
                    {
                        "sense_id": "d65f5786-e394-3d06-8143-f335e138129d",
                        "entry_id": "b25e14ea-23c0-38b0-aa44-23e01450fa63",
                        "glosses": [
                            "puerpera; woman in childbed"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d98003f7-393d-484f-9aca-bb40b0b909e2",
                                "sense_id": "d65f5786-e394-3d06-8143-f335e138129d",
                                "text": "Man muß Erinnerungen haben an viele Liebesnächte, von denen keine der andern glich, an Schreie von Kreißenden und an leichte, weiße, schlafende Wöchnerinnen, die sich schließen.",
                                "translation": "The Notebooks of Malte Laurids Brigge",
                                "english": "The Notebooks of Malte Laurids Brigge"
                            },
                            {
                                "example_id": "397f9a3b-4938-49f3-9067-38524eedc488",
                                "sense_id": "d65f5786-e394-3d06-8143-f335e138129d",
                                "text": "Unmöglich konnte man sie anders als skandalös bezeichnen, die Merkmale und Einzelheiten dieser animierten Wochenstube im Rotlicht, sowohl was die jungfräuliche Person der Wöchnerin in ihrem fließenden Schlafrock und mit ihren bloßen Ärmchen, […]",
                                "translation": "It was impossible to describe it otherwise than as scandalous, the features and details of this animated nursery in the red-light, both the virgin person of the woman recently given birth in her flowing dressing gown and with her bare arms, […]",
                                "english": "It was impossible to describe it otherwise than as scandalous, the features and details of this animated nursery in the red-light, both the virgin person of the woman recently given birth in her flowing dressing gown and with her bare arms, […]"
                            }
                        ]
                    }
