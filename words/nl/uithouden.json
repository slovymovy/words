{
    "word_family": [
        "uithoudingsvermogen",
        "uithouding",
        "vasthouden",
        "volhouden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5645281c-04cc-3d0b-855d-268dedd2b07e",
                    "sense_definition": "iets vervelends of moeilijks verdragen zonder op te geven",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verdragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan de hitte in deze kamer niet langer <w>uithouden</w>.",
                            "target_lang_translations": {
                                "en": "I can't <w>stand</w> the heat in this room any longer."
                            }
                        },
                        {
                            "text": "Hoe lang kun jij je adem onder water <w>uithouden</w>?",
                            "target_lang_translations": {
                                "en": "How long can you <w>hold</w> your breath underwater?"
                            }
                        }
                    ],
                    "synonyms": [
                        "verdragen",
                        "uitstaan",
                        "velen",
                        "harden"
                    ],
                    "antonyms": [
                        "opgeven",
                        "bezwijken"
                    ],
                    "common_phrases": [
                        "niet meer uithouden",
                        "het ergens uithouden",
                        "adem uithouden"
                    ],
                    "target_lang_definitions": {
                        "en": "To tolerate or withstand something unpleasant or difficult without giving up."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to tolerate something unpleasant"
                            },
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "to tolerate or endure"
                            },
                            {
                                "target_lang_word": "endure",
                                "target_lang_sense_clarification": "to suffer through something patiently"
                            },
                            {
                                "target_lang_word": "hold out",
                                "target_lang_sense_clarification": "to last or continue in a difficult situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76276daf-9c24-397a-ab88-18d8708b5b74",
                    "sense_definition": "het vermogen om gedurende een lange tijd te blijven functioneren onder belasting",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn auto heeft het daarna niet zo lang meer <w>uitgehouden</w>.",
                            "target_lang_translations": {
                                "en": "My car didn't <w>last</w> very long after that."
                            }
                        },
                        {
                            "text": "De batterij van mijn telefoon kan het een hele dag <w>uithouden</w>.",
                            "target_lang_translations": {
                                "en": "My phone's battery can <w>last</w> a whole day."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondergaan",
                        "harden"
                    ],
                    "antonyms": [
                        "kapotgaan"
                    ],
                    "common_phrases": [
                        "lang uithouden"
                    ],
                    "target_lang_definitions": {
                        "en": "The ability to continue functioning over a long period under pressure or load."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "to continue to function or exist"
                            },
                            {
                                "target_lang_word": "endure",
                                "target_lang_sense_clarification": "to remain firm under trial or load"
                            },
                            {
                                "target_lang_word": "hold out",
                                "target_lang_sense_clarification": "to remain usable or functional"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97cee38-ad1c-3f63-93a0-ad42033ac770",
                    "sense_definition": "iets of iemand op een afstand houden of ergens vandaan houden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weghouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie probeerde de nieuwsgierige menigte <w>uit</w> te <w>houden</w> bij het ongeval.",
                            "target_lang_translations": {
                                "en": "The police tried to <w>keep</w> the curious crowd <w>out</w> of the accident scene."
                            }
                        },
                        {
                            "text": "Je moet die hond echt uit de keuken <w>uithouden</w> als je kookt.",
                            "target_lang_translations": {
                                "en": "You really need to <w>keep</w> that dog <w>out</w> of the kitchen when you are cooking."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdragen",
                        "verdragen"
                    ],
                    "antonyms": [
                        "toelaten",
                        "binnenlaten"
                    ],
                    "common_phrases": [
                        "iemand ergens uithouden"
                    ],
                    "target_lang_definitions": {
                        "en": "To keep something or someone at a distance or away from a specific place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep out",
                                "target_lang_sense_clarification": "to prevent from entering"
                            },
                            {
                                "target_lang_word": "keep away",
                                "target_lang_sense_clarification": "to maintain a distance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}