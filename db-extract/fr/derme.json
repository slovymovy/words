                "entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                "word": "derme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b07d9f6-956b-4586-81ee-def7f06cb571",
                        "entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                        "tags": [
                            "plural"
                        ],
                        "form": "dermes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12379e0d-47f4-39d2-829a-921b9af71b2a",
                        "entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                        "glosses": [
                            "Tissu qui forme la partie la plus épaisse de la peau entre l’épiderme et l'hypoderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5675743-a4fe-4ecc-9953-d1ee673a9fa8",
                                "sense_id": "12379e0d-47f4-39d2-829a-921b9af71b2a",
                                "text": "La peau est composée de trois couches (épiderme, derme et hypoderme) dont la composition et les fonctions sont spécifiques à chacune."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156990ac-cbd0-41de-8d99-806b580fbdbe",
                        "source_entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                        "source_sense_id": "12379e0d-47f4-39d2-829a-921b9af71b2a",
                        "target_lang_word": "Lederhaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lederhaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6844f6b-c168-3f94-8afe-59ba478bd900",
                                        "entry_id": "dc141cb9-66f1-36d3-80d1-858a8f45fec9",
                                        "glosses": [
                                            "die bei Menschen und Wirbeltieren unter der Epidermis liegende, zähe, elastische Hautschicht"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ceeb2ca-e422-44ed-9eac-4ac25e6abb33",
                                                "sense_id": "f6844f6b-c168-3f94-8afe-59ba478bd900",
                                                "text": "Das nicht durchblutete Hautstück liegt mit der Innenseite nach oben; deutlich sichtbar sind die Verästelungen des in der sogenannten Lederhaut verlaufenden Nervs."
                                            },
                                            {
                                                "example_id": "b2eac2f3-a332-4e16-94ee-5ebb13c8344f",
                                                "sense_id": "f6844f6b-c168-3f94-8afe-59ba478bd900",
                                                "text": "Vor allem das Netzwerk aus Kollagen- und Elastinfasern in der Lederhaut, das der Haut ihre Reißfestigkeit und Elastizität verleiht, gerät dann mehr in Mitleidenschaft."
                                            },
                                            {
                                                "example_id": "35325942-9723-44ae-891d-0f715ae94ab0",
                                                "sense_id": "f6844f6b-c168-3f94-8afe-59ba478bd900",
                                                "text": "Polypeptide dringen bis zur Lederhaut vor und geben dort den kollagenbildenden Zellen ein Signal, mehr Kollagen und Elastin zu produzieren - die Lederhaut wird dicker, fester, weicher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35eac178-e4c8-3b92-b574-d1172f388410",
                                        "entry_id": "dc141cb9-66f1-36d3-80d1-858a8f45fec9",
                                        "glosses": [
                                            "den Augapfel umgebende Haut"
                                        ],
                                        "tags": [
                                            "Ophthalmologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a278026-a14c-4360-bf29-624174b9793f",
                                                "sense_id": "35eac178-e4c8-3b92-b574-d1172f388410",
                                                "text": "Die Lederhaut schützt das Auge vor Verletzungen."
                                            },
                                            {
                                                "example_id": "7d810a94-bf7a-4c44-95a2-f69a75b74909",
                                                "sense_id": "35eac178-e4c8-3b92-b574-d1172f388410",
                                                "text": "Im Innern des Augapfels, der nach vorn durch die Hornhaut, von etwa der Mitte ab durch die Lederhaut abgeschlossen wird, befindet sich außer dem gallertartigen Glaskörper und der Linse eine eiweißhaltige Flüssigkeit, …"
                                            },
                                            {
                                                "example_id": "b414ad0a-8237-4a79-8c49-0c570d4bb8f3",
                                                "sense_id": "35eac178-e4c8-3b92-b574-d1172f388410",
                                                "text": "Für die Tarnung des Blicks würden Affen wertvolle Stoffwechselenergie aufwenden, um die Lederhaut rings um die Iris zu trüben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "490742fb-ec0c-46e3-855d-092c8a627f15",
                        "source_entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                        "source_sense_id": "12379e0d-47f4-39d2-829a-921b9af71b2a",
                        "target_lang_word": "dermis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dermis",
