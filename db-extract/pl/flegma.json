                    {
                        "sense_id": "ae907667-42b1-38c9-9975-b5cf27911a1f",
                        "entry_id": "09b4c953-6c41-35d1-9a60-1fef8a339c38",
                        "glosses": [
                            "temperament, któremu właściwy jest brak gwałtownych emocji i poważna powolność działania"
                        ],
                        "tags": [
                            "psychology"
