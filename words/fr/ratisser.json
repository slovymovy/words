            "senses": [
                {
                    "sense_id": "aaffadcd-4a91-38a0-aa15-4d62c1929032",
                    "sense_definition": "Nettoyer ou aplanir un terrain à l'aide d'un râteau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jardinage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En automne, mon grand-père passe son temps à <w>ratisser</w> les feuilles mortes dans le jardin."
                        },
                        {
                            "text": "Le jardinier doit <w>ratisser</w> les allées de gravier avant l'arrivée des invités."
                        }
                    ],
                    "common_phrases": [
                        "ratisser les feuilles",
                        "ratisser les allées"
                    ]
                },
                {
                    "sense_id": "e66a4df9-5390-3c2d-9cd8-394d494f3a14",
                    "sense_definition": "Fouiller ou quadriller minutieusement un espace pour retrouver une personne ou un indice.",
