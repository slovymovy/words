                                        "sense_id": "69b1c11f-7964-31de-92d8-6aa8f4025281",
                                        "entry_id": "10be1103-664b-3e89-b466-c80eda2cd04b",
                                        "glosses": [
                                            "hlavní představitel někdejší Benátské nebo Janovské republiky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d74af2d-bc63-462b-8af7-160a38f89de4",
                                                "sense_id": "69b1c11f-7964-31de-92d8-6aa8f4025281",
                                                "text": "Benátský dóže sídlil v Dóžecím paláci na Náměstí sv. Marka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09699f84-e47a-4748-aafd-3690de8cdf39",
                        "source_entry_id": "c08f65d5-1aa3-361f-ba3d-4ede127888fb",
                        "source_sense_id": "08a44fef-94b9-3b82-a355-5752e80c16ed",
                        "target_lang_word": "doge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5afcce26-35bc-3b78-a131-0dbafde6da29",
                                        "entry_id": "6cee040a-18de-3b8d-b628-c5e81cc17336",
                                        "glosses": [
                                            "Nom de la dignité du chef des anciennes républiques de Venise et de Gênes, élu parmi les familles aristocratiques de la ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b48357e-fa38-41cd-92ef-b3cb22a17d01",
                                                "sense_id": "5afcce26-35bc-3b78-a131-0dbafde6da29",
                                                "text": "Le palais des Doges."
                                            },
                                            {
                                                "example_id": "f347d7d2-bbe3-4130-8605-179ff20fea74",
                                                "sense_id": "5afcce26-35bc-3b78-a131-0dbafde6da29",
                                                "text": "Non pas, non pas, cria-t-on de tous côtés ; il y a encore Venise. — Venise la reine des mers ! — Le lion de Saint-Marc ! — Le Bucentaure ! — Le doge ! — Quel homme qu’un doge !…"
                                            },
                                            {
                                                "example_id": "93eb7d72-dac1-43a2-9121-5b668148308b",
                                                "sense_id": "5afcce26-35bc-3b78-a131-0dbafde6da29",
                                                "text": "J'ai vu ce nain autrefois à la cour du Doge de Venise..."
                                            },
                                            {
                                                "example_id": "29190a50-f5e7-4991-badc-ecdcb7ac6e81",
                                                "sense_id": "5afcce26-35bc-3b78-a131-0dbafde6da29",
                                                "text": "Le grand sortit, fier comme un doge, en faisant sonner son argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82c2af60-a712-4258-a721-b23dd55d910b",
                        "source_entry_id": "c08f65d5-1aa3-361f-ba3d-4ede127888fb",
                        "source_sense_id": "08a44fef-94b9-3b82-a355-5752e80c16ed",
