                                    {
                                        "sense_id": "0e186e85-b676-3f8e-93b1-402e1142a895",
                                        "entry_id": "a7ad1831-f261-3d0a-a40b-dc5d8e343116",
                                        "glosses": [
                                            "Zeitangabe: der Tag nach morgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6717ae1-3bfb-4dcf-9f6b-35fde9d4cd92",
                                                "sense_id": "0e186e85-b676-3f8e-93b1-402e1142a895",
                                                "text": "Übermorgen werden wir in Urlaub fahren."
                                            },
                                            {
                                                "example_id": "67059d5e-ee53-4ac4-9b31-c78c53718781",
                                                "sense_id": "0e186e85-b676-3f8e-93b1-402e1142a895",
                                                "text": "Die Entscheidung über das Erreichen der Runde der besten Vier fällt übermorgen, wenn Deutschland gegen Neuseeland antritt."
                                            },
                                            {
                                                "example_id": "09914133-efb6-42fb-9449-378dd51cb11a",
                                                "sense_id": "0e186e85-b676-3f8e-93b1-402e1142a895",
                                                "text": "Dann schnitt sie den Leuten Gesichter im Rücken und trieb voll Übermut allerhand Ungezogenheiten, bis er zuletzt versprechen mußte, noch heute und morgen und übermorgen zu bleiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddbec6ac-5baa-4536-9c52-896ef6a6a873",
