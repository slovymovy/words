                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dbcfd3b7-351b-49d6-a1cc-3010c1b3e751",
                                "sense_id": "2510f377-9466-39e8-9fee-a97f642c005e",
                                "text": "C’est ze cadeau de Noël."
                            },
                            {
                                "example_id": "a494c29a-20cd-444a-8015-4742f970a3ce",
                                "sense_id": "2510f377-9466-39e8-9fee-a97f642c005e",
                                "text": "Un Mac, c’était ze machine pour un graphiste, quoi."
                            },
                            {
                                "example_id": "e6f6cbd9-7797-4935-a532-92543e544205",
                                "sense_id": "2510f377-9466-39e8-9fee-a97f642c005e",
                                "text": "Aïe ! Alors ça, c’est justement ze bêtise qu’il fallait pas faire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5496154a-f237-34d6-8a20-67a4f5871f13",
                        "entry_id": "26cb9f89-ff25-3615-9945-afbca130db96",
                        "glosses": [
                            "Permet de mettre en emphase la personne dont on parle. Parfois complété de big."
