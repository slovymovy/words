                "senses": [
                    {
                        "sense_id": "f10a4498-9083-3500-9353-0aec4dbf3d95",
                        "entry_id": "24077a40-91fa-318e-9a32-859346b5ffcb",
                        "glosses": [
                            "werk dat door gevangenen onder dwang gedaan moet worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f1a576-841d-44ad-8efc-4c1a297621fa",
                                "sense_id": "f10a4498-9083-3500-9353-0aec4dbf3d95",
                                "text": "Gelukkig komt dwangarbeid steeds minder voor. (behalve natuurlijk in landen als Noord-Korea)"
                            },
                            {
                                "example_id": "0b12992a-79ed-4744-b01e-cb1f71c0ed54",
                                "sense_id": "f10a4498-9083-3500-9353-0aec4dbf3d95",
                                "text": "Bij de productie van zonnepanelen in de Chinese regio Xinjiang verricht de Oeigoerse minderheid dwangarbeid, concludeert de Britse Sheffield Hallam University in een onderzoek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b84b436f-2d70-4e64-835d-6ed32833c9e5",
                        "source_entry_id": "24077a40-91fa-318e-9a32-859346b5ffcb",
                        "source_sense_id": "f10a4498-9083-3500-9353-0aec4dbf3d95",
                        "source_sense_description": "werk dat onder dwang gedaan moet worden",
                        "target_lang_word": "Zwangsarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwangsarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                        "entry_id": "0451c78c-d906-389a-bfd4-0e24f8c3687d",
                                        "glosses": [
                                            "Arbeit, zu der man von jemandem unter Strafandrohung gezwungen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45dac6a2-a266-474d-b9bb-58fe275ac100",
                                                "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                                "text": "Die Gefangenen wurden zur Zwangsarbeit gezwungen."
                                            },
                                            {
                                                "example_id": "dc5835e4-5cc3-4a1c-bb3d-c34250fb38f5",
                                                "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                                "text": "„Insgesamt wurden mehrere Hunderttausende deutsche Siedler aus den Ostgebieten nach dem Krieg in Lagern inhaftiert oder mussten - teilweise jahrelang - Zwangsarbeit leisten.“"
                                            },
                                            {
                                                "example_id": "aa16229f-9e9b-49ef-b035-ccf912d85512",
                                                "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                                "text": "„Die zweite große Welle der Rückwanderer kam aus dem Westen: aus deutschen Arbeits-, Konzentrations- und Gefangenenlagern, oft nach jahrelanger Zwangsarbeit.“"
                                            },
                                            {
                                                "example_id": "555047ed-2644-4783-bb74-f23f458dc868",
                                                "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                                "text": "„Beide wurden von einem russischen Militärgericht zu fünfundzwanzig Jahren Zwangsarbeit verurteilt, die im Zuchthaus Bautzen verbüßt werden musste.“"
                                            },
                                            {
                                                "example_id": "2e4173e7-4e6b-457b-b6a7-bef9a6f3d0b2",
                                                "sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                                                "text": "„Wenn die Nazis uns auch noch hier überfallen, dann werden sie mich vielleicht mit den Söhnen der Familie Zwangsarbeit machen lassen oder irgendwohin deportieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
