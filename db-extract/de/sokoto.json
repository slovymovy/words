                                        "sense_id": "859e293d-096d-328b-a3df-488e1772eae1",
                                        "entry_id": "6d256682-b507-36c2-b860-8533940df715",
                                        "glosses": [
                                            "A state of Nigeria in the North West geopolitical zone. Capital and largest city: Sokoto City."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190a020c-22b0-4bed-a1f5-e95f8c089791",
                                                "sense_id": "859e293d-096d-328b-a3df-488e1772eae1",
                                                "text": "It rains almost everywhere, even in Sokoto, where you can practically smell the Sahara."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf8c2d5-bdaf-3659-ac12-8d3534afba92",
                                        "entry_id": "6d256682-b507-36c2-b860-8533940df715",
                                        "glosses": [
                                            "A city, the state capital of Sokoto State, Nigeria."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20d43b56-10be-36be-9bf2-f1d45278b534",
                                        "entry_id": "6d256682-b507-36c2-b860-8533940df715",
                                        "glosses": [
                                            "A former caliphate in West Africa centred on the city of Sokoto; extant from 1804 to 1903."
                                        ],
