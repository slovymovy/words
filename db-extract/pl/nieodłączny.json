        "pl-extract.jsonl": [
            {
                "entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                "word": "nieodłączny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "glosses": [
                            "taki, który zawsze towarzyszy komuś lub czemuś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd76a48-e454-4137-a7c5-b10771c995a5",
                                "sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                                "text": "Strach – ten nieodłączny towarzysz małpy w laboratorium, strach – ten nieodłączny towarzysz wiejskiego psa"
                            },
                            {
                                "example_id": "158d8e77-fcda-48f3-ba39-399359fe7773",
                                "sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                                "text": "Istota człowieczeństwa jest nieodłączna od Boga"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38348b14-54ad-4ea7-9c5c-f7096c69c781",
                        "source_entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "source_sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "target_lang_word": "inseparable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inseparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd06e5e0-dc23-3095-8431-882bad0f0764",
                                        "entry_id": "c5129c67-1ec7-3bce-9129-cf023a0a84eb",
                                        "glosses": [
                                            "Unable to be separated; bound together permanently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e084cb35-027a-4f9a-9196-a6bcf747da63",
                                                "sense_id": "bd06e5e0-dc23-3095-8431-882bad0f0764",
                                                "text": "People of unalterable ideas still insisted upon calling him \"Sergeant\" when they met him, which was in some degree owing to his having still retained the well-shaped moustache of his military days, and the soldierly bearing inseparable from his form."
                                            },
                                            {
                                                "example_id": "847d2e1f-f96c-4ad5-920a-51b29cf47eac",
                                                "sense_id": "bd06e5e0-dc23-3095-8431-882bad0f0764",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […] and therefore my lack of detection of his promise may in some degree be pardoned. But he had then none of the oddities and mannerisms which I hold to be inseparable from genius, and which struck my attention in after days when I came in contact with the Celebrity."
                                            },
                                            {
                                                "example_id": "6587697e-6835-47b3-9b26-b5c17200c241",
                                                "sense_id": "bd06e5e0-dc23-3095-8431-882bad0f0764",
                                                "text": "=This detail is one of the reasons which made a single, modern signalbox and the marshalling yard inseparable features in the modernisation of the Perth facilities. A central control point rather than 13 individual boxes, was essential to integrate with other movements the greatly increased flow of freight traffic through the station area."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inseparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0df4b88-8429-3253-bf87-a419d9541800",
                                        "entry_id": "45bdb9c4-45a0-36f2-8ebe-4ba16dcecbca",
                                        "glosses": [
                                            "Something that cannot be separated from something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533c05bb-65ee-4822-9f11-a63796a19b89",
                                                "sense_id": "e0df4b88-8429-3253-bf87-a419d9541800",
                                                "text": "Jayanta does so in answering an opponent who declares that the very idea of a relation between two inseparables is self-contradictory. How can inseparability and relation be reconciled?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd97270a-1a9e-4c73-98d2-430f946447be",
                        "source_entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "source_sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "target_lang_word": "inherent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inherent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                        "entry_id": "8ef6209a-2ab5-3a25-b8fb-6eeccf666c39",
                                        "glosses": [
                                            "Naturally as part or consequence of something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7333d2d-c7e9-4e1a-a0cf-afe1ec794bdb",
                                                "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                                "text": "There is a stern melancholy in his dark features, inherent and engrossing, which rivets the attention."
                                            },
                                            {
                                                "example_id": "f0a867ee-7c6b-4837-9c75-a2a0d0e684aa",
                                                "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ada41aad-89b8-4ac4-a0ee-86ab44c2f3d1",
                        "source_entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "source_sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "target_lang_word": "indissociable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indissociable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                        "entry_id": "57be4005-de67-3022-8097-1ed563d20cde",
                                        "glosses": [
                                            "Que l’on ne peut pas dissocier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053d4fbc-3e33-4a68-a910-0d98d3f324e3",
                                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                                "text": "Méthodique, ce connaisseur des métiers d'art, ne s’intéressait pas moins à l’architecture qu'au mobilier domestique, indissociable de celle-ci, et dont il avait commencé une étude inachevée."
                                            },
                                            {
                                                "example_id": "3575eca8-8e64-46a2-941a-3866c247e0c6",
                                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                                "text": "Le but du socialisme, c’est la recherche du progrès et la concrétisation de l’aspiration égalitaire dont les composantes - égalité juridique, égalité politique et égalité sociale - sont indissociables et inopposables."
                                            },
                                            {
                                                "example_id": "9fb32085-83b9-4175-aabc-1e843329d0b6",
                                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                                "text": "La partie qui s'use le plus rapidement est souvent le silentbloc. Il peut être possible de remplacer ce dernier sans changer le triangle de suspension, sauf lorsque les deux sont indissociables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b666be09-7dc5-4c8a-84fd-7c064f87eac2",
                        "source_entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "source_sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "target_lang_word": "inhérent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhérent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cafd563-db82-3188-838d-e9143e502bf2",
                                        "entry_id": "d844dc3a-a9a8-3a4e-976b-e4de6ee054ad",
                                        "glosses": [
                                            "Nécessaire et inséparable d’un autre objet ou d'un autre sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6997cc2-da8b-4f03-aff8-1c7baeb969e2",
                                                "sense_id": "9cafd563-db82-3188-838d-e9143e502bf2",
                                                "text": "Pour ne pas se griser, malgré les nombreuses libations inhérentes à des fêtes de ce genre, on garnissait de lierre, bouteilles, lampes et meubles !"
                                            },
                                            {
                                                "example_id": "e3dcd05f-0a3a-4a7e-a82d-f5546e35152f",
                                                "sense_id": "9cafd563-db82-3188-838d-e9143e502bf2",
                                                "text": "Une étude attentive de l'histoire de l'humanité révèle que cette assertion que la guerre est inhérente à la nature humaine - et par conséquent éternelle - est superficielle et fallacieuse. La guerre est loin d'être inexplicable ou inévitable,..."
                                            },
                                            {
                                                "example_id": "80c53d11-77da-423e-ba6f-d33e450efaac",
                                                "sense_id": "9cafd563-db82-3188-838d-e9143e502bf2",
                                                "text": "Son grand corps est long, encore mince bien que la sédentarité inhérente à son métier l’ait quelque peu empâté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84eb9b82-adc0-4547-bef9-cfb9eef78ecf",
                        "source_entry_id": "c29dcbc7-882c-38fa-9c6c-e66031c6dc03",
                        "source_sense_id": "658aa335-9bb5-3648-b659-4e3bd88b893a",
                        "target_lang_word": "неразделимый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неразделимый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4583d802-70c7-3124-beeb-3cb8244cab0f",
                                        "entry_id": "abef0221-ea4e-3b47-b19b-7fa680e1c6d7",
                                        "glosses": [
                                            "такой, который трудно или невозможно разделить на части"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ef8da9-1ada-4315-94a2-98c4e2ed6277",
                                                "sense_id": "4583d802-70c7-3124-beeb-3cb8244cab0f",
                                                "text": "Чти православно Бога Отца Вседержителя, Иисуса Христа Сына Его, и Духа Святаго единаго живаго и истиннаго Бога, Святую Троицу неразделимую."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fdf820e-2466-3298-bfe9-b9651e92d58e",
                                        "entry_id": "abef0221-ea4e-3b47-b19b-7fa680e1c6d7",
                                        "glosses": [
                                            "составляющий единое целое с кем-либо, чем-либо; неразрывно связанный с кем-либо, чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b843d10c-f1fd-4f43-937c-dfa8d030a852",
                                                "sense_id": "5fdf820e-2466-3298-bfe9-b9651e92d58e",
                                                "text": "Однако же любовь к царю и любовь к православию к России не потому только должны составлять одно, что русский простолюдин до сих пор не умеет их разделить, но потому, что они в сущности своей неразделимы так же как любовь к царю неразделима с любовью к законности ⟨…⟩."
                                            },
                                            {
                                                "example_id": "a1146144-9799-4a4f-8ce1-231956524e7a",
                                                "sense_id": "5fdf820e-2466-3298-bfe9-b9651e92d58e",
                                                "text": "Затем мысли делались беспорядочными, реальность и галлюцинации становились неразделимы, всякая ориентация утрачивалась."
                                            },
                                            {
                                                "example_id": "1be8248d-9a5a-47a3-aac6-9a8f2f593235",
                                                "sense_id": "5fdf820e-2466-3298-bfe9-b9651e92d58e",
                                                "text": "На тамбовской земле иначе и быть не могло ― ведь сирень и Рахманинов неразделимы в нашем представлении."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
