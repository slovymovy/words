                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condenser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5327df0-dc83-3d87-9b4e-2596e4bd6447",
                                        "entry_id": "93c7e6a4-35d2-39bd-889f-6c6afc49ac64",
                                        "glosses": [
                                            "Resserrer dans un moindre espace, réduire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e932b9-1f37-4667-8dae-5bebf4399650",
                                                "sense_id": "d5327df0-dc83-3d87-9b4e-2596e4bd6447",
                                                "text": "Le froid condense les corps."
                                            },
                                            {
                                                "example_id": "22e41bab-b057-41e4-8a79-d98af964526c",
                                                "sense_id": "d5327df0-dc83-3d87-9b4e-2596e4bd6447",
                                                "text": "Quand je vais camper, je prends avec moi du lait condensé pour le café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b27eb2-7851-3a7e-83d6-b01a206c5325",
                                        "entry_id": "93c7e6a4-35d2-39bd-889f-6c6afc49ac64",
                                        "glosses": [
                                            "Faire passer (ou passer, pronominal) de l'état gazeux à l'état liquide ou solide, « matière condensée »."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85052ebd-83ac-4449-b71f-a68f9a3a5840",
                                                "sense_id": "c5b27eb2-7851-3a7e-83d6-b01a206c5325",
                                                "text": "La pelouse était couverte de faibles vapeurs condensées, qui déroulaient leurs blancs flocons sur la pointe des herbes."
                                            },
                                            {
                                                "example_id": "b1947d78-9ff0-4cec-b475-920fe4780503",
                                                "sense_id": "c5b27eb2-7851-3a7e-83d6-b01a206c5325",
                                                "text": "Dans l’air rafraîchi où une impalpable brume se condensait en rosée, les bêtes levèrent leur mufle humide […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4e9ce2-d1a2-3beb-8807-ed774e5376ec",
                                        "entry_id": "93c7e6a4-35d2-39bd-889f-6c6afc49ac64",
                                        "glosses": [
                                            "Lier des molécules (ou se lier, pronominal) par réaction chimique par une réaction de condensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd4d873b-65d4-4fd4-a576-093e64a8df1d",
                                                "sense_id": "1b4e9ce2-d1a2-3beb-8807-ed774e5376ec",
                                                "text": "Concernant le mécanisme réactionnel, les groupes alkoxysilyle s'hydrolysent et les groupes silanol formés se condensent entre eux. Un polysiloxane est obtenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5dfae8e-6379-3c7d-9554-ce9856ff4256",
                                        "entry_id": "93c7e6a4-35d2-39bd-889f-6c6afc49ac64",
                                        "glosses": [
                                            "Resserrer, résumer, compacter un discours un raisonnement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66713ab-4d10-4586-a559-50d8765d0ed2",
                                                "sense_id": "d5dfae8e-6379-3c7d-9554-ce9856ff4256",
                                                "text": "Condenser sa pensée, l’exprimer en peu de mots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
