                            }
                        },
                        {
                            "text": "Żołnierz założył mundur <w>galowy</w> z okazji święta państwowego.",
                            "target_lang_translations": {
                                "ru": "Солдат надел <w>парадный</w> мундир по случаю государственного праздника."
