                "senses": [
                    {
                        "sense_id": "fd9745f2-76fd-3f5a-bbc7-6d1435231162",
                        "entry_id": "26b9a932-5fa5-3245-af00-8e5c0d27a44e",
                        "glosses": [
                            "Relatif aux Sicules, communauté magyarophone de Transylvanie et de Bucovine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda50185-94c4-4390-8deb-faded18e0b38",
                                "sense_id": "fd9745f2-76fd-3f5a-bbc7-6d1435231162",
                                "text": "Pour avoir levé et organisé une immense armée de paysans et de bergers hongrois, sicules, saxons, roumains, serbes et slovaques, György Dózsa, lui-même paysan sicule, meurt en 1514, la tête ceinte d’une couronne de fer rouge."
                            },
                            {
                                "example_id": "088ad7b9-b408-433b-9bed-aee76b1b7c1b",
                                "sense_id": "fd9745f2-76fd-3f5a-bbc7-6d1435231162",
                                "text": "À l’intérieur, il devait respecter les droits des « trois Nations » : hongroise, saxonne et sicule."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "aa4d439b-aae4-3e18-9e0a-9928333c778d",
