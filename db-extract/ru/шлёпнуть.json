                                                "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                                                "text": "She slapped him in response to the insult."
                                            },
                                            {
                                                "example_id": "2ba7472e-bb99-4f50-bd05-e681af018497",
                                                "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                                                "text": "Mrs. Flanders rose, slapped her coat this side and that to get the sand off, and picked up her black parasol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ab5b64-5470-368e-a813-4ac94945c27a",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To cause something to strike soundly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f2c03c-7a4e-403c-87f8-86dac9c7c54f",
                                                "sense_id": "40ab5b64-5470-368e-a813-4ac94945c27a",
                                                "text": "He slapped the reins against the horse's back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0034eb-5049-3de5-a92a-5f936a3d3089",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To strike soundly against something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e33a91-a27e-4c36-99ee-cd9388412dc2",
                                                "sense_id": "cc0034eb-5049-3de5-a92a-5f936a3d3089",
                                                "text": "The rain slapped against the window-panes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To be excellent, especially when relating to music."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75dd3091-760e-4301-a6be-080d2de525b0",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "The band's new single slaps."
                                            },
                                            {
                                                "example_id": "1feb65b0-7eac-465c-98d0-c5385028d117",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "There are some cinematic elements, but at the end of the day, the album fucking slaps."
                                            },
                                            {
                                                "example_id": "c138a47c-f7b6-4f41-8828-ee02b551060b",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "Also I will never get tired of the song \"Motion Sickness\" by Phoebe Bridgers. Shit slaps."
                                            },
                                            {
                                                "example_id": "e290b73f-6c72-4f62-a7c1-a5a0d83773da",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "2016's 'Girls Like Me' still slaps to this day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To place, to put carelessly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89da4b65-8dcb-4c9e-9ccf-238358a84c29",
                                                "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                                "text": "We'd better slap some fresh paint on that wall."
                                            },
                                            {
                                                "example_id": "9630d542-8f7c-4527-bc97-7c948043e81d",
                                                "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                                "text": "Louise Belcher: \"On Monday there was supposed to be some big schoolboard inspection or something, so instead of cleaning the place up, what does the principal do? He panics. He and the janitor and the janitor's brother slap a wall where the door used to be.\"\nGene Belcher: \"Wall slap.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b83751c-a861-33eb-9aa6-80fb22ccb681",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To impose a penalty, etc. on (someone)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624f1786-2b72-4b82-85c2-1366417434a4",
                                                "sense_id": "7b83751c-a861-33eb-9aa6-80fb22ccb681",
                                                "text": "I was slapped with a parking fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236e9c3d-60fd-35ca-9067-c9f53abef999",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To play slap bass on (an instrument)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c8e2eb-1253-4124-a937-11fad7dab5a8",
                                                "sense_id": "236e9c3d-60fd-35ca-9067-c9f53abef999",
                                                "text": "With no drums, Black began slapping his bass to keep time while Moore's guitar leaped in and out of the melody line."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2a37c-7ab7-39a1-95a3-f9e0626b0b36",
                                        "entry_id": "650df732-ad21-33a1-ae0c-042b040e98cf",
                                        "glosses": [
                                            "Exactly, precisely"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a0d7845-059b-485a-9b9e-0d198830baa4",
                                                "sense_id": "ede2a37c-7ab7-39a1-95a3-f9e0626b0b36",
                                                "text": "He tossed the file down slap in the middle of the table."
                                            },
                                            {
                                                "example_id": "56337adf-a485-4bb3-9923-5c99c59647aa",
                                                "sense_id": "ede2a37c-7ab7-39a1-95a3-f9e0626b0b36",
                                                "text": "You just take my orders, Cap’n Hawkins, and we’ll sail slap in and be done with it."
                                            },
                                            {
                                                "example_id": "70bb9502-dc0b-449a-bc3f-bbc43248abe4",
                                                "sense_id": "ede2a37c-7ab7-39a1-95a3-f9e0626b0b36",
                                                "text": "They called the tom-cat to the trap, / Who molrowed as he smelt at the door, O— / Opened his mouth and swallowed him slap, / All the while most profanely he swore, O!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10ae537c-849a-3715-a5b1-5f74408bea6a",
                                        "entry_id": "4959a76c-687a-35c8-a9cb-154503232327",
                                        "glosses": [
                                            "Very good, excellent, amazing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee8713a-9f0f-412a-bf46-2e372130940a",
                                                "sense_id": "10ae537c-849a-3715-a5b1-5f74408bea6a",
                                                "text": "These cookies are slap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
