                    },
                    {
                        "translation_id": "ccb418d8-f884-45b6-aa5e-ca87187c3a4b",
                        "source_entry_id": "fcf2454e-c2ea-3421-8283-7bc2bc9ad0a4",
                        "source_sense_id": "2ea3fce6-2349-304c-a7ed-0644fe2cc26c",
                        "target_lang_word": "philosémitisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philosémitisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2926b7fe-f861-39dd-bb10-864b9a507e3b",
                                        "entry_id": "8640f4e8-8946-32e4-9686-22628e1351d6",
                                        "glosses": [
                                            "Attitude favorable envers les Juifs, en raison de leur religion, de qualités attribuées collectivement aux Juifs, et de leur statut de peuple élu de Dieu, selon les différentes religions issues de la Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b72f3cb-0a62-4e4e-b617-6785affa0dbc",
                                                "sense_id": "2926b7fe-f861-39dd-bb10-864b9a507e3b",
                                                "text": "À ce philosémitisme qui dans quelques cas extrêmes conduit à la supercherie, nous opposerons la sagesse du Juif autrichien Albert Drach: « L’antisémitisme ne sera pas surmonté par le philosémitisme, mais par un réalisme général qui prend en compte le particulier parce que le particulier témoigne du général."
                                            },
                                            {
                                                "example_id": "6968ab37-10ce-4ed4-90a8-c3f210b13f24",
                                                "sense_id": "2926b7fe-f861-39dd-bb10-864b9a507e3b",
                                                "text": "Depuis une dizaine d’années, il affichait son philosémitisme en humiliant sa femme par ses nombreux voyages au vu de tous avec sa maîtresse – juive, mariée – dans les plus belles villes d’Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dcd7ef9-61fb-456b-993d-63bcc1f4002c",
                        "source_entry_id": "fcf2454e-c2ea-3421-8283-7bc2bc9ad0a4",
                        "source_sense_id": "2ea3fce6-2349-304c-a7ed-0644fe2cc26c",
                        "target_lang_word": "filosemitismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c69c9d78-613c-4e30-8c72-552538a5d05e",
                        "source_entry_id": "fcf2454e-c2ea-3421-8283-7bc2bc9ad0a4",
                        "source_sense_id": "2ea3fce6-2349-304c-a7ed-0644fe2cc26c",
                        "target_lang_word": "Philosemitismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philosemitismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a36e85ca-9231-3b95-8514-5401fb69aeb0",
                                        "entry_id": "f997de44-172e-3471-be80-efa7045a666e",
                                        "glosses": [
                                            "gewogene Haltung und Einstellung gegenüber den Juden und dem Judentum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d902b2a7-7afd-4e4a-a0cb-03fa1a6c209a",
                                                "sense_id": "a36e85ca-9231-3b95-8514-5401fb69aeb0",
                                                "text": "„Die recht kleine Bewegung des christlichen Zionismus unterschied sich seit ihrer Entstehung von den übrigen apokalyptischen Lehren pietistischer Couleur […] durch ihren klaren Philosemitismus, während die anderen Endzeitchristen mehr vom traditionellen christlichen Antijudaismus geprägt waren.“"
                                            },
                                            {
                                                "example_id": "e005fa28-5b1a-4597-ac14-eb9cb26d0cda",
                                                "sense_id": "a36e85ca-9231-3b95-8514-5401fb69aeb0",
                                                "text": "„Die Behauptung, ein Jude könne kein Faschist sein, ist reiner Antisemitismus! Oder Philosemitismus. Philosemitismus und Antisemitismus sind ja nicht so weit voneinander entfernt.“"
                                            },
                                            {
                                                "example_id": "e9b6d30b-b4e5-4542-aa72-87e6107a9555",
                                                "sense_id": "a36e85ca-9231-3b95-8514-5401fb69aeb0",
                                                "text": "„Nach dem Zweiten Weltkrieg ging als Reaktion auf gewisse unschöne Ereignisse eine Welle von Philosemitismus durch unsere Kultur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
