                        "sense_id": "5651178b-a7b7-339e-a522-12dca1d311b3",
                        "entry_id": "65ca1057-e662-35a4-aadc-a4e4d33cf9c6",
                        "glosses": [
                            "зоол. вид этого рода"
                        ],
                        "tags": [],
                        "examples": []
                    }
