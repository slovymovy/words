                    "frequency": "Middle",
                    "semantic_group_id": "state_of_settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke with a therapist to cope with her <w>unresolved</w> childhood trauma.",
                            "target_lang_translations": {
                                "ru": "Она обратилась к психотерапевту, чтобы справиться со своей <w>непроработанной</w> детской травмой."
                            }
                        },
                        {
                            "text": "Years of <w>unresolved</w> grief caused him significant emotional distress.",
                            "target_lang_translations": {
                                "ru": "Годы <w>непережитого</w> горя причиняли ему глубокие душевные страдания."
                            }
                        }
                    ],
                    "antonyms": [
                        "healed",
                        "resolved"
                    ],
                    "common_phrases": [
                        "unresolved trauma",
                        "unresolved grief",
                        "unresolved conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "эмоционально не проработанный, не пережитый или не исцелённый"
