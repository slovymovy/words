                ],
                "senses": [
                    {
                        "sense_id": "856100c7-0632-39b4-9356-456badb563fd",
                        "entry_id": "51273ae5-447d-31c4-a16f-13efeb66bf4e",
                        "glosses": [
                            "устар., книжн., поэт. — источаться, изливаться, вытекать, течь откуда-либо, обычно медленно, по капле"
                        ],
                        "tags": [
                            "о жидкости"
                        ],
                        "examples": [
                            {
                                "example_id": "8a69609d-b7f2-45cd-8a83-2ad07eb70c38",
                                "sense_id": "856100c7-0632-39b4-9356-456badb563fd",
                                "text": "Глубокая еще дымилась рана, // По капле кровь точилася моя."
                            },
                            {
                                "example_id": "2d81a99b-2781-470f-895b-52ca9a977e02",
                                "sense_id": "856100c7-0632-39b4-9356-456badb563fd",
                                "text": "Слезы у нее не точились, а бежали быстрыми, нарастающими капельками и, как на поднос, падали на неестественно выдвинутую грудь."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d3be543-a5fb-3623-a08c-2b5dba03b1f2",
                        "entry_id": "51273ae5-447d-31c4-a16f-13efeb66bf4e",
                        "glosses": [
                            "перен. — понемногу проникать"
                        ],
                        "tags": [
                            "о запахах, свете, дыме и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "aefa3487-6020-4561-b23f-5074b2fb5762",
                                "sense_id": "3d3be543-a5fb-3623-a08c-2b5dba03b1f2",
                                "text": "В запушенные изморозью окна точился розовый сумеречный свет."
                            },
                            {
                                "example_id": "7cfdfde0-a3da-485f-8923-c2607f2d6603",
                                "sense_id": "3d3be543-a5fb-3623-a08c-2b5dba03b1f2",
                                "text": "Точился дым потому, что в сарайном жилье на уложенном прямо по земле дощатом полу, возле небольшой столпообразной печки, к которой и прислониться некуда, стоял на коленях высокий человек в большом пальто и дул в топку."
                            }
                        ]
                    }
                ],
