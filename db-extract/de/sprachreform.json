                "senses": [
                    {
                        "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                        "entry_id": "32eb54bc-3375-3e39-a818-39ac4c828b12",
                        "glosses": [
                            "(meist gewollte) Umgestaltung einer Sprache durch eine einflussreiche Person oder Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d403b5df-8a25-4afa-84e1-5f2a4a0cc487",
                                "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                                "text": "Martin Luther hat mit seiner Bibel-Übersetzung einen Anteil an einer Sprachreform des Deutschen."
                            },
                            {
                                "example_id": "24d9a470-436a-4cbe-a351-787e173fab7e",
                                "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                                "text": "Sprachreformen sollen der Modernisierung und/oder Vereinheitlichung von Sprachen dienen."
                            },
                            {
                                "example_id": "08ec69cd-19c8-4fa0-828e-0cbc5e5aee47",
                                "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                                "text": "Crystal behandelt ausführlich die chinesische Sprachreform und spricht dabei sogar von einer Sprachrevolution."
                            },
                            {
                                "example_id": "08ae1a8b-92ae-42d3-825a-69523f65b5cd",
                                "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                                "text": "„Die türkische Sprachreform war, wie der englische Turkologe Geoffrey Lewis in einem sehr lesenswerten Vortrag meint, „a catastrophic success“ (große pdf-Datei, englisch).“"
                            },
                            {
                                "example_id": "13739d5f-a2eb-42eb-99ea-eb725f4702a3",
                                "sense_id": "d77885b4-2be9-35f2-b98e-f616e9bc9e3d",
                                "text": "„Sie führten auch neue Satzzeichen ein, verwarfen sie wieder und drängten auf eine Sprachreform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
