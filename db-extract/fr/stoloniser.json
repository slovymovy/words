                "senses": [
                    {
                        "sense_id": "e6e8e214-cbef-3c62-8abf-3e5d194cba15",
                        "entry_id": "ee2b42ee-54ca-3697-8f4c-59127d983ff6",
                        "glosses": [
                            "Produire des stolons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784d30da-d76a-4a74-826f-40f3b7672265",
                                "sense_id": "e6e8e214-cbef-3c62-8abf-3e5d194cba15",
                                "text": "Comme je n'y connaissais rien, j'ai suivi les consignes débiles du vendeur de la tour à patates, qui n'y connaissait pas plus que ceux qui ne savent rien, et je les ai plantées à 20cm du fond, du coup elles ont dépensé leur énergie à grimper au lieu de stoloniser tranquille."
                            }
                        ]
                    },
                    {
                        "sense_id": "08d269e6-1b9c-31d7-beca-ef5e6210de8b",
                        "entry_id": "ee2b42ee-54ca-3697-8f4c-59127d983ff6",
                        "glosses": [
                            "Peupler grâce à des stolons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315ffe24-1380-4059-9a71-f05ea92a0bca",
                                "sense_id": "08d269e6-1b9c-31d7-beca-ef5e6210de8b",
                                "text": "Elles sont si nombreuses aussi car voilà enfin une plante que je laisse stoloniser le jardin !"
                            },
                            {
                                "example_id": "0e30775b-3e69-4062-9701-181f52b846e8",
                                "sense_id": "08d269e6-1b9c-31d7-beca-ef5e6210de8b",
                                "text": "L'idéal serait de stoloniser le jour successif à la récolte des stolons dans la pépinière."
                            }
                        ]
                    }
