                            {
                                "target_lang_word": "анализировать",
                                "target_lang_sense_clarification": "подвергать критическому разбору"
                            },
                            {
                                "target_lang_word": "исследовать",
                                "target_lang_sense_clarification": "изучать скрытые смыслы"
                            },
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "критически осмыслять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa45b42e-8466-327b-8bc3-651b650e1b17",
                    "sense_definition": "to request or retrieve data from a computer system, database, or electronic device",
                    "learner_level": "C1",
