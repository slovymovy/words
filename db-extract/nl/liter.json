                                        "entry_id": "6cc35034-dea4-3bb0-94a4-37bbfeb9d023",
                                        "glosses": [
                                            "The metric unit of fluid measure, equal to one cubic decimetre. Symbol: L, l, or ℓ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f58b1a-221c-4c3c-9f4e-39f029c58eea",
                                                "sense_id": "58572394-a14e-3412-81d8-73713e6ca0cf",
                                                "text": "You should be able to fill four cups with one litre of water."
                                            },
                                            {
                                                "example_id": "721d8b55-e756-4790-9873-8c453107df9d",
                                                "sense_id": "58572394-a14e-3412-81d8-73713e6ca0cf",
                                                "text": "Holonyms: kilolitre < megalitre < gigalitre"
                                            },
                                            {
                                                "example_id": "f37be491-1469-4f1e-8dff-67b6b2e5bff6",
                                                "sense_id": "58572394-a14e-3412-81d8-73713e6ca0cf",
                                                "text": "Meronyms: picolitre < nanolitre < microlitre < millilitre"
                                            }
