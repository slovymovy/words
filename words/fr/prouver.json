                {
                    "sense_id": "727af78f-ae7f-384b-8622-393667f0b30b",
                    "sense_definition": "Montrer ou manifester clairement un sentiment, une disposition ou une qualité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa réaction calme <w>prouve</w> sa bonne foi dans cette affaire complexe.",
                            "target_lang_translations": {
                                "en": "His calm reaction <w>shows</w> his good faith in this complicated matter.",
                                "ru": "Его спокойная реакция <w>показывает</w> его добросовестность в этом сложном деле.",
                                "nl": "Zijn kalme reactie <w>toont</w> zijn goede trouw in deze ingewikkelde zaak.",
                                "de": "Seine ruhige Reaktion <w>zeigt</w> seine Redlichkeit in dieser komplizierten Angelegenheit.",
                                "pl": "Jego spokojna reakcja <w>świadczy</w> o jego dobrej wierze w tej skomplikowanej sprawie.",
                                "it": "La sua reazione calma <w>dimostra</w> la sua buona fede in questa complicata vicenda.",
                                "cs": "Jeho klidná reakce <w>dokazuje</w> jeho dobrou víru v této složité záležitosti.",
                                "tr": "Sakin tepkisi, bu karmaşık davadaki iyi niyetini <w>gösteriyor</w>.",
                                "es": "Su reacción tranquila <w>demuestra</w> su buena fe en este asunto complejo.",
                                "zh": "他冷静的反应<w>显示</w>出他在这起复杂案件中的诚意。"
                            }
                        },
                        {
                            "text": "Par ce geste généreux, il a voulu <w>prouver</w> son attachement sincère à son équipe.",
                            "target_lang_translations": {
                                "en": "With this generous gesture, he wanted to <w>show</w> his sincere devotion to his team.",
                                "ru": "Этим щедрым жестом он хотел <w>проявить</w> свою искреннюю привязанность к команде.",
                                "nl": "Met dit genereuze gebaar wilde hij zijn oprechte genegenheid voor zijn team <w>tonen</w>.",
                                "de": "Mit dieser großzügigen Geste wollte er seine aufrichtige Verbundenheit mit seinem Team <w>zeigen</w>.",
                                "pl": "Tym hojnym gestem chciał <w>okazać</w> szczere przywiązanie do swojej drużyny.",
                                "it": "Con questo gesto generoso ha voluto <w>dimostrare</w> il suo sincero attaccamento alla sua squadra.",
                                "cs": "Tímto štědrým gestem chtěl <w>projevit</w> svou upřímnou oddanost svému týmu.",
                                "tr": "Bu cömert hareketiyle takımına duyduğu samimi bağlılığını <w>göstermek</w> istedi.",
                                "es": "Con este gesto generoso quiso <w>demostrar</w> su sincero apego a su equipo.",
                                "zh": "他用这个慷慨的举动，想<w>表达</w>自己对团队的真挚感情。"
                            }
                        }
                    ],
