                                        "sense_id": "eae25109-c8bb-328e-b3b2-d15eb173b2ef",
                                        "entry_id": "b3dff8d7-57a4-3f41-8a66-fc42180a0bce",
                                        "glosses": [
                                            "To compel (a person or persons) to leave."
                                        ],
                                        "tags": [
                                            "transitive"
