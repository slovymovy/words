                                        "entry_id": "1c8e6108-0476-3f18-86c9-d9dc9acd00a1",
                                        "glosses": [
                                            "strak uitgerekt, gereed om met kracht in een eerdere toestand terug te keren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783e6aac-c548-461f-9384-978ab40af2a4",
                                                "sense_id": "8659243d-cb20-3cc0-9d0d-8bc35e98fe04",
                                                "text": "Het gespannen prikkeldraad houdt de koeien in de wei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a88cfcb-015e-33ef-b639-9a99d687b183",
                                        "entry_id": "1c8e6108-0476-3f18-86c9-d9dc9acd00a1",
                                        "glosses": [
                                            "in hoge mate werkzaam - (naar analogie van betekenis 1 bij trekdieren, aandrijfkettingen of tentdoeken)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76b8e76-3b3e-4ff0-8d54-6401679e306f",
                                                "sense_id": "9a88cfcb-015e-33ef-b639-9a99d687b183",
                                                "text": "De kinderen keken met gespannen aandacht naar de film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e421357-e7f8-3061-b3f7-16e2d0efb1e0",
                                        "entry_id": "1c8e6108-0476-3f18-86c9-d9dc9acd00a1",
                                        "glosses": [
                                            "ongemakkelijk, blijk gevend van stress, het punt van (uit-)barsten naderend - (naar analogie van betekenis 1 bij boogpezen of ballonnen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf4d5ab-76df-46a6-91dd-1083ca4b32e0",
                                                "sense_id": "6e421357-e7f8-3061-b3f7-16e2d0efb1e0",
                                                "text": "De gespannen situatie is ontstaan door een reeks beledigingen."
                                            },
                                            {
                                                "example_id": "da99903b-f8b7-460c-be1f-40e7a6571250",
                                                "sense_id": "6e421357-e7f8-3061-b3f7-16e2d0efb1e0",
                                                "text": "Frans loopt met een gespannen blik naar binnen."
                                            },
                                            {
                                                "example_id": "56f2c404-2577-4cef-8146-40a49668e36c",
                                                "sense_id": "6e421357-e7f8-3061-b3f7-16e2d0efb1e0",
                                                "text": "Opperste concentratie in de coulissen van De Bond. Gespannen staan de leerlingen uit groep 8C van de basisschool Drie-eenheid maandagmorgen naar hun klasgenoten te kijken die op dat moment in de schijnwerpers staan. Als er al wat wordt gezegd, gebeurt dat op een fluistertoon die op de bühne niet te horen is."
                                            },
                                            {
                                                "example_id": "1aadac37-aad3-4af9-8c13-2abe499ccbd0",
                                                "sense_id": "6e421357-e7f8-3061-b3f7-16e2d0efb1e0",
                                                "text": "'Verrukkelijk,' zegt ze met een gespannen lachje."
                                            }
                                        ]
                                    }
                                ]
                            },
