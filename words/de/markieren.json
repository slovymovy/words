    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0f5204c-c47a-3b2d-9ef2-3160c530f74a",
                    "sense_definition": "Etwas durch ein sichtbares Zeichen kenntlich machen oder im Text hervorheben.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kennzeichnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat die wichtigsten Wörter im Text mit einem Stift <w>markiert</w>."
                        },
                        {
                            "text": "Auf der Landkarte müssen wir unseren aktuellen Standort deutlich <w>markieren</w>."
                        }
                    ],
                    "synonyms": [
                        "kennzeichnen",
                        "anstreichen",
                        "hervorheben"
                    ],
                    "common_phrases": [
                        "einen Text markieren",
                        "wichtige Stellen markieren"
                    ]
                },
                {
                    "sense_id": "17f49b86-d99f-3c60-8070-aa8937fdbea9",
                    "sense_definition": "Eine Person in einem Beitrag oder auf einem Bild in sozialen Netzwerken namentlich verlinken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kannst du mich bitte auf diesem Foto aus dem Urlaub <w>markieren</w>?"
                        },
                        {
                            "text": "Sie hat ihre besten Freunde unter dem lustigen Video <w>markiert</w>."
                        }
                    ],
                    "synonyms": [
                        "verlinken",
                        "taggen"
                    ],
                    "common_phrases": [
                        "jemanden auf einem Foto markieren"
                    ]
                },
                {
                    "sense_id": "714521a5-f346-38cc-80d9-c1e79d0dd8cd",
                    "sense_definition": "Einen zeitlichen Einschnitt, Beginn oder wichtigen Wendepunkt darstellen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bedeuten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieser Vertrag <w>markiert</w> den Beginn einer neuen Ära der Zusammenarbeit."
                        },
                        {
                            "text": "Die Entdeckung des Penicillins <w>markierte</w> einen Meilenstein in der Geschichte der Medizin."
                        }
                    ],
                    "synonyms": [
                        "darstellen",
                        "einleiten",
                        "kennzeichnen"
                    ],
                    "common_phrases": [
                        "einen Wendepunkt markieren",
                        "einen Meilenstein markieren"
                    ]
                },
                {
                    "sense_id": "e5e19549-36ad-3def-8d1c-f71c0b3c3b13",
                    "sense_definition": "Ein bestimmtes Verhalten oder einen Zustand nur vortäuschen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vortäuschen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ist gar nicht krank, er <w>markiert</w> bloß, um zu Hause zu bleiben."
                        },
                        {
                            "text": "Du musst hier vor den Kollegen nicht den großen Helden <w>markieren</w>."
                        }
                    ],
                    "synonyms": [
                        "vortäuschen",
                        "vorspielen",
                        "heucheln"
                    ],
                    "common_phrases": [
                        "den Helden markieren",
                        "krank markieren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                },
                {
                    "sense_id": "5817fc15-7191-39d5-b13f-01eac884d135",
                    "sense_definition": "Bei einer Theater- oder Opernprobe die Stimme schonen und den Gesangspart lediglich sprechen oder leise andeuten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Da die Sopranistin heiser war, <w>markierte</w> sie während der Kostümprobe nur ihre Arien."
                        },
                        {
                            "text": "Der Sänger beschloss, bei der Probe am Nachmittag vorsichtshalber nur zu <w>markieren</w>."
                        }
                    ],
                    "synonyms": [
                        "andeuten"
                    ]
                }
            ]
        }
    ]
