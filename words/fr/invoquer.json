{
    "word_family": [
        "invocation",
        "invocatoire",
        "invocable",
        "invocateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "409ae0c2-43ff-3aa9-8050-f3d0b6dcaf00",
                    "sense_definition": "Citer ou faire valoir une loi, une règle, un précédent ou un argument pour appuyer une demande ou justifier une position.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "justification_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a décidé d'<w>invoquer</w> un vice de procédure pour faire annuler le jugement."
                        },
                        {
                            "text": "Le pays a choisi d'<w>invoquer</w> le droit international afin de garantir sa souveraineté."
                        }
                    ],
                    "synonyms": [
                        "alléguer",
                        "faire valoir"
                    ],
                    "common_phrases": [
                        "invoquer une loi",
                        "invoquer un droit",
                        "invoquer un principe"
                    ]
                },
                {
                    "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                    "sense_definition": "Appeler à son aide ou à son secours par la prière, en particulier une divinité ou une puissance surnaturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appel_spirituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les moments difficiles, les fidèles <w>invoquent</w> la protection divine pour trouver le courage."
                        },
                        {
                            "text": "Au début de son poème épique, l'auteur <w>invoque</w> la muse pour nourrir son inspiration."
                        }
                    ],
                    "synonyms": [
                        "implorer",
                        "prier"
                    ],
                    "common_phrases": [
                        "invoquer les dieux",
                        "invoquer la clémence",
                        "invoquer le secours"
                    ]
                },
                {
                    "sense_id": "1d4f1b10-9ac1-33f4-813a-a4c41b21e29b",
                    "sense_definition": "Mettre en avant un motif ou un prétexte pour tenter d'expliquer ou d'excuser un échec.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justification_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa défaite surprenante, l'athlète a préféré <w>invoquer</w> la fatigue plutôt que d'admettre ses erreurs."
                        },
                        {
                            "text": "Pour justifier les mauvais résultats de son entreprise, le directeur <w>invoque</w> une conjoncture économique défavorable."
                        }
                    ],
                    "synonyms": [
                        "prétexter"
                    ],
                    "common_phrases": [
                        "invoquer la fatigue",
                        "invoquer la malchance"
                    ]
                }
            ]
        }
    ]
}