                                        "entry_id": "8f5795b7-ea8c-3692-a09e-353b4e73ddab",
                                        "glosses": [
                                            "charakteristischer Wohn- oder Standort, den eine Pflanzen- oder Tierart besiedelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8e1b50-466c-4d93-8c6c-e9d3f3b795f1",
                                                "sense_id": "6a4f4d44-d6fa-3e8c-b2ff-4df1385f0eca",
                                                "text": "Als Megafauna bezeichnet man den Anteil der Tiere, der in einem Habitat die körperlich größten Organismen stellt."
                                            },
                                            {
                                                "example_id": "45938a3d-afa5-456b-a795-9591d662cba8",
                                                "sense_id": "6a4f4d44-d6fa-3e8c-b2ff-4df1385f0eca",
                                                "text": "„Der Loreley-Dickkopffalter, der Habitate mit ausgeprägt trocken-heißem Mikroklima bevorzugt, kommt in Deutschland nur hier vor.“"
                                            },
                                            {
                                                "example_id": "e36c88e2-fe89-4ee5-b2c2-63540a10bdaa",
                                                "sense_id": "6a4f4d44-d6fa-3e8c-b2ff-4df1385f0eca",
                                                "text": "„Was sollte ihm die für dieses Habitat übliche Zugvogelpopulation mit ihrem raschen, fast rhythmischen Wechsel noch an Neuem bieten?“"
                                            },
                                            {
                                                "example_id": "3cdbb35d-e51f-45f7-8fa1-724007ce829c",
                                                "sense_id": "6a4f4d44-d6fa-3e8c-b2ff-4df1385f0eca",
                                                "text": "„Durch intensive Landwirtschaft, Urbanisierung, Pestizide und den Klimawandel verschwinden Habitate für unsere Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
