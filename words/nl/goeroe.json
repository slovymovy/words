                    "sense_id": "30fb2da2-d62c-3cf2-838c-d2b4d5986bfb",
                    "sense_definition": "iemand die wordt beschouwd als een grote autoriteit of expert op een specifiek vakgebied",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expert",
                    "name_type": "no",
