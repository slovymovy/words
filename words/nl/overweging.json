{
    "word_family": [
        "overwegen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19b320de-d6e0-3de8-9969-642c30ffcaed",
                    "sense_definition": "Het zorgvuldig nadenken over de voor- en nadelen van iets om tot een besluit te komen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij zullen uw voorstel serieus in <w>overweging</w> nemen.",
                            "target_lang_translations": {
                                "en": "We will take your proposal into serious <w>consideration</w>.",
                                "ru": "Мы серьезно примем ваше предложение к <w>рассмотрению</w>.",
                                "zh": "我们会认真<w>考虑</w>您的提议。"
                            }
                        },
                        {
                            "text": "Na enige <w>overweging</w> besloot hij om toch mee te gaan.",
                            "target_lang_translations": {
                                "en": "After some <w>consideration</w>, he decided to go along anyway.",
                                "ru": "После некоторого <w>размышления</w> он решил все же пойти.",
                                "zh": "经过一番<w>考虑</w>后，他还是决定一起去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beraad",
                        "overpeinzing",
                        "deliberatie"
                    ],
                    "common_phrases": [
                        "in overweging nemen",
                        "in overweging geven"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of thinking carefully about the pros and cons of something to reach a decision.",
                        "ru": "Тщательное обдумывание плюсов и минусов чего-либо для принятия решения.",
                        "zh": "为了做出决定而仔细权衡某事的利弊的过程；考虑、审议。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consideration",
                                "target_lang_sense_clarification": "careful thought"
                            },
                            {
                                "target_lang_word": "deliberation",
                                "target_lang_sense_clarification": "formal discussion or thought"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рассмотрение",
                                "target_lang_sense_clarification": "процесс анализа и оценки"
                            },
                            {
                                "target_lang_word": "обдумывание",
                                "target_lang_sense_clarification": "мыслительный процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考虑",
                                "target_lang_sense_clarification": "仔细思索、权衡"
                            },
                            {
                                "target_lang_word": "斟酌",
                                "target_lang_sense_clarification": "反复考虑、推敲"
                            },
                            {
                                "target_lang_word": "审议",
                                "target_lang_sense_clarification": "正式仔细审查考虑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8976ddaf-70fa-3b41-88d5-97cae6311280",
                    "sense_definition": "Een argument, reden of omstandigheid die meetelt bij het nemen van een beslissing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Financiële <w>overwegingen</w> speelden een grote rol bij deze keuze.",
                            "target_lang_translations": {
                                "en": "Financial <w>considerations</w> played a major role in this choice.",
                                "ru": "Финансовые <w>соображения</w> сыграли большую роль в этом выборе.",
                                "zh": "财务方面的<w>考量</w>在这个选择中起到了重要作用。"
                            }
                        },
                        {
                            "text": "Uit praktische <w>overwegingen</w> hebben we de vergadering verplaatst.",
                            "target_lang_translations": {
                                "en": "We moved the meeting due to practical <w>considerations</w>.",
                                "ru": "Из практических <w>соображений</w> мы перенесли собрание.",
                                "zh": "出于实际的<w>考虑</w>，我们将会议改期了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argument",
                        "beweegreden",
                        "motief"
                    ],
                    "common_phrases": [
                        "praktische overwegingen",
                        "ethische overwegingen",
                        "politieke overwegingen"
                    ],
                    "target_lang_definitions": {
                        "en": "An argument, reason, or circumstance that counts towards making a decision.",
                        "ru": "Аргумент, причина или обстоятельство, учитываемые при принятии решения.",
                        "zh": "在做出决定时需要计入的理由、论据、因素或考量。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consideration",
                                "target_lang_sense_clarification": "factor to consider"
                            },
                            {
                                "target_lang_word": "factor",
                                "target_lang_sense_clarification": "element contributing to a result"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "соображение",
                                "target_lang_sense_clarification": "мотив, причина или довод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考量",
                                "target_lang_sense_clarification": "考虑的因素或角度"
                            },
                            {
                                "target_lang_word": "考虑",
                                "target_lang_sense_clarification": "做决定时的由由或因素"
                            },
                            {
                                "target_lang_word": "因素",
                                "target_lang_sense_clarification": "起决定作用的情由"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ae8d8f-bf62-30c4-ac5f-f99e54fcc714",
                    "sense_definition": "Een korte, beschouwende tekst of toespraak, vaak met een religieuze of filosofische inhoud.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De priester begon de dienst met een persoonlijke <w>overweging</w>.",
                            "target_lang_translations": {
                                "en": "The priest began the service with a personal <w>reflection</w>.",
                                "ru": "Священник начал службу с личного <w>размышления</w>.",
                                "zh": "牧师以一段个人的<w>省思</w>开始了礼拜。"
                            }
                        },
                        {
                            "text": "In zijn dagelijkse <w>overweging</w> sprak hij over het belang van vrede.",
                            "target_lang_translations": {
                                "en": "In his daily <w>reflection</w>, he spoke about the importance of peace.",
                                "ru": "В своем ежедневном <w>размышлении</w> он говорил о важности мира.",
                                "zh": "在每日的<w>默想</w>分享中，他谈到了和平的重要性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beschouwing",
                        "overdenking"
                    ],
                    "common_phrases": [
                        "een korte overweging"
                    ],
                    "target_lang_definitions": {
                        "en": "A short, contemplative text or speech, often with religious or philosophical content.",
                        "ru": "Краткий созерцательный текст или речь, часто религиозного или философского содержания.",
                        "zh": "简短的沉思性文本或讲话，通常具有宗教或哲学内涵。"
                    },
                    "translations": {
