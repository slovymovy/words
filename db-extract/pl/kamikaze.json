                    {
                        "translation_id": "b72ccc1d-2f4a-462b-bdd5-4638e4a353a4",
                        "source_entry_id": "222f2da4-36a8-3f5c-9544-c028eaa0944a",
                        "source_sense_id": "81b35c0c-5238-35e2-897a-c48b6f7f3fbf",
