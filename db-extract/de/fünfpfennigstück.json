                "senses": [
                    {
                        "sense_id": "4a85738b-9916-3ed6-891b-221757096a1c",
                        "entry_id": "40989abd-cc37-35a1-adea-4fec91ffa229",
                        "glosses": [
                            "Münze mit dem Wert von fünf Pfennig"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "63db98e4-43bc-4c48-be12-01e89041f45a",
                                "sense_id": "4a85738b-9916-3ed6-891b-221757096a1c",
                                "text": "„Am besten wäre es, einen Groschen und ein paar Fünfpfennigstücke in den Hut reinzulegen.“"
                            },
                            {
                                "example_id": "630a5bb7-4a08-49a8-a5f5-f15c49b100bb",
                                "sense_id": "4a85738b-9916-3ed6-891b-221757096a1c",
                                "text": "„Das Geruchsorgan liegt am Anfang der Atemwege und nimmt ein jeweils Fünfpfennigstück großes Gebiet an der oberen Nasenmuschel (Concha nasalis superior) und dem benachbarten Nasenseptum ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
