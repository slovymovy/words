                                        "sense_id": "4838e11c-e04a-36fd-a9dc-b9bf335c6da9",
                                        "entry_id": "7b96c119-daa9-3540-a59e-38fff3235e7f",
                                        "glosses": [
                                            "A collection containing a variety of miscellaneous things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955faec0-bff9-4e66-97c3-42cd4273f237",
                                                "sense_id": "4838e11c-e04a-36fd-a9dc-b9bf335c6da9",
                                                "text": "His latest sculpture is a hodgepodge of kitchen clutter and scrap glued together."
                                            },
                                            {
                                                "example_id": "36c39b32-9c9e-4d22-b105-56cec0a0dc2d",
                                                "sense_id": "4838e11c-e04a-36fd-a9dc-b9bf335c6da9",
                                                "text": "MAn's life is but vain, for tis ſubject to pain, / and ſorrow, and ſhort as a buble; / 'tis a hodge podge of buſineſs, and mony and care, / and care, and mony, and trouble."
                                            },
                                            {
                                                "example_id": "99cba29d-5dee-4ef3-a729-a5b8ea3bd390",
                                                "sense_id": "4838e11c-e04a-36fd-a9dc-b9bf335c6da9",
                                                "text": "The entire section is a hodgepodge of ill-absorbed and ill-digested bits of information lifted in a haphazard fashion from the sources used with apparently no other goal in mind than to accumulate a list of items with some degree of resemblance to forms from Manding and Dravidian […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc186165-efdd-3ff9-94ad-f552b6c40822",
                                        "entry_id": "7b96c119-daa9-3540-a59e-38fff3235e7f",
                                        "glosses": [
                                            "A confused mass of ingredients shaken or mixed together in the same pot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hodgepodge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae715ed3-6c90-365b-a790-4fb5a546c21e",
                                        "entry_id": "d49c4d56-e50b-3cf7-aa24-dc2157d45095",
                                        "glosses": [
                                            "To move or position in an erratic, disorganized manner."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4d8b318-d433-405f-888d-e77614c09058",
                        "source_entry_id": "ddaa2227-0868-3e1b-8285-07e2a6e26796",
                        "source_sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                        "source_sense_description": "ungeordnetes Durcheinander, unsystematische Sammlung",
                        "target_lang_word": "inventaire à la Prévert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventaire à la Prévert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dd020d9-d38e-3d11-a506-b7b93dcb5d73",
                                        "entry_id": "94c1ae3f-92cb-399f-9de0-89fe73b18eef",
                                        "glosses": [
                                            "Liste, énumération hétéroclite, inventaire qui n’a apparemment ni queue ni tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e36a5c4-373c-4656-be89-bdd184b69666",
                                                "sense_id": "5dd020d9-d38e-3d11-a506-b7b93dcb5d73",
                                                "text": "Destiné à pousser les lecteurs vers ce formidable laboratoire que constitue la nature, le catalogue de La Hulotte ressemble à un inventaire à la Prévert. On y découvre le quotidien des animaux les plus familiers, comme la pie, le hérisson ou la taupe, mais aussi celui de ces petites bêtes inconnues dont les seuls noms suffisent à attiser la curiosité, tels le sphinx colibri, la chrysope ou encore le tarin des aulnes."
                                            },
                                            {
                                                "example_id": "ebd30a9a-335b-4dcc-b2bc-4a46e0bf5ca7",
                                                "sense_id": "5dd020d9-d38e-3d11-a506-b7b93dcb5d73",
                                                "text": "Le nombre de fonctionnaires partant à la retraite en 2008 a été calculé sur la base d’un « inventaire à la Prévert » et résulte de « nombreuses approximations », selon une note de l’Inspection générale des Finances (IGF) citée par le Canard Enchaîné mercredi 12 décembre."
                                            },
                                            {
                                                "example_id": "e0230c8e-5fbf-4de7-a9d3-2f43f4ae700e",
                                                "sense_id": "5dd020d9-d38e-3d11-a506-b7b93dcb5d73",
                                                "text": "Le législateur ne peut pas aller dans le détail et établir un inventaire à la Prévert de tous les troubles imaginables parce que c’est infini."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c99d1721-1a4a-41ce-9df0-5e1bf1289358",
                        "source_entry_id": "ddaa2227-0868-3e1b-8285-07e2a6e26796",
