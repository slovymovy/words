                    {
                        "translation_id": "3bea752a-a0b2-4176-bd05-d3ddf37e6c0b",
                        "source_entry_id": "f786b9bf-1237-300f-a75e-ee7e3ec6eb08",
                        "target_lang_word": "Kollaborationist",
                        "target_lang_code": "de",
