                "senses": [
                    {
                        "sense_id": "99a76f02-bafe-3e90-bb26-1991f2ad04d0",
                        "entry_id": "2bbfa659-14db-337c-b6c4-6e27bc4a4246",
                        "glosses": [
                            "im Internet, mit Internetquellen durchgeführte Recherche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb3b45a-9ff7-4235-9b38-07251f218a6a",
                                "sense_id": "99a76f02-bafe-3e90-bb26-1991f2ad04d0",
                                "text": "„Über eine Internetrecherche stellte man fest, dass ein Dennis Rader als Präsident des Kirchenrats aufgeführt war.“"
                            },
                            {
                                "example_id": "5f0753d8-58fc-44aa-b18f-a879dc2684e8",
                                "sense_id": "99a76f02-bafe-3e90-bb26-1991f2ad04d0",
                                "text": "„Zwar hatte er sich durch Internetrecherchen davon überzeugt, dass diese MobileCrypt-App eine saubere Sache war, dass er es also riskieren konnte, sie zu benutzen, wenn ihm das Informationen über die Townsend-Leute brachte, die ihm auf den Fersen waren. Doch Court war eben ein vorsichtiger Mann.“"
                            },
                            {
                                "example_id": "b2e2fead-f3db-4be0-8d65-6a45fca93c51",
                                "sense_id": "99a76f02-bafe-3e90-bb26-1991f2ad04d0",
                                "text": "„Es war beinahe 17:00 Uhr, als sie mit den Internetrecherchen und Benachrichtigungen für heute fertig war.“"
                            },
                            {
                                "example_id": "8220e26d-cfe9-46d3-9c3d-af8a2a8197a3",
                                "sense_id": "99a76f02-bafe-3e90-bb26-1991f2ad04d0",
                                "text": "„In den acht Wochen seither hatte ich viel Gitarre gespielt, während mein Körper langsam heilte, aber ich hatte auch viel Zeit mit Internetrecherchen verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
