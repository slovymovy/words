                "senses": [
                    {
                        "sense_id": "986ebdcc-1351-3f8b-9e9d-27554581a601",
                        "entry_id": "13e94ba4-923f-31de-a139-20b3edabf4df",
                        "glosses": [
                            "имеющий три хвоста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a30e23-3532-4abb-a473-4d7e57925642",
                                "sense_id": "986ebdcc-1351-3f8b-9e9d-27554581a601",
                                "text": "Каких только я не увидел сказочных драконов, грифонов, кентавров, треххвостых львов, странных птиц."
                            }
                        ]
                    },
                    {
                        "sense_id": "87665175-063d-33af-81c4-301231b96967",
                        "entry_id": "13e94ba4-923f-31de-a139-20b3edabf4df",
                        "glosses": [
                            "имеющий разделенный натрое конец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f4ab54-8810-424f-8a09-fbed77944605",
                                "sense_id": "87665175-063d-33af-81c4-301231b96967",
                                "text": "Когда мы перешли на последний курс, последовала в русской уголовной практике реформа: четыреххвостный кнут был заменен трёххвостною плетью."
                            }
                        ]
                    }
