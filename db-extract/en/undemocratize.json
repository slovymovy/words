                            {
                                "example_id": "613a668e-e9b5-483a-8a16-a17c7b95a153",
                                "sense_id": "67c44bc6-a4a5-3d34-95e3-cb54b97f6e86",
                                "text": "But there is still a very wide difference between the willing and persistent, and the accidental and unwilling, holding of slaves, in respect to the influence which slave-holding exerts to undemocratize the master."
                            },
                            {
                                "example_id": "7b7a930c-da71-4aa0-8aca-dd69a4773c1f",
                                "sense_id": "67c44bc6-a4a5-3d34-95e3-cb54b97f6e86",
                                "text": "because of the various attempts to undemocratize the government."
                            },
                            {
                                "example_id": "55bb7111-4a77-4788-9c39-607c090115c6",
                                "sense_id": "67c44bc6-a4a5-3d34-95e3-cb54b97f6e86",
                                "text": "CEOs and American big business have blanketed United States public education officials with their influence and, as Emery and Ohanian prove, their fifteen-year drive to undemocratize public education has yielded a many-tentacled private-public monster."
                            }
                        ]
