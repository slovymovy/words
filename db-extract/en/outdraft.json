                        "glosses": [
                            "An outward current, often specifically a river current pulling toward a downstream dam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec48268-8c82-4222-9663-dc161283fbc7",
                                "sense_id": "8fb2c3e8-0246-3993-8835-4a4854c51933",
                                "text": "The outdraft is like a funnel, pulling the boat and tow out into the river, away from the lock and toward the dam."
                            },
