                "senses": [
                    {
                        "sense_id": "8f0a6434-0240-3e29-9e44-fa57c033e3d7",
                        "entry_id": "17d1169c-eb95-32fc-969e-dfa7335e10eb",
                        "glosses": [
                            "Participer à une partouze."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a6475731-cc99-485b-9d4b-8cb2a2d3c011",
                                "sense_id": "8f0a6434-0240-3e29-9e44-fa57c033e3d7",
                                "text": "J’ai cessé d’être vierge à l’âge de dix-huit ans – ce qui n’est pas spécialement tôt – mais j’ai partouzé pour la première fois dans les semaines qui ont suivi ma défloration."
                            },
                            {
                                "example_id": "c1879ab3-f0db-489c-ae13-dac4c5139646",
                                "sense_id": "8f0a6434-0240-3e29-9e44-fa57c033e3d7",
                                "text": "Donc la petite Allemande avait des liaisons multiples, et plus encore, elle partouzait."
                            }
                        ]
                    }
