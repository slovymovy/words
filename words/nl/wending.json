                    "sense_id": "6eb613d5-3a41-38f4-b919-4b00a8e83c18",
                    "sense_definition": "Een verandering in het verloop van gebeurtenissen of omstandigheden, vaak onverwacht.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verhaal nam een onverwachte <w>wending</w> toen de hoofdpersoon plotseling verdween.",
                            "target_lang_translations": {
                                "en": "The story took an unexpected <w>turn</w> when the protagonist suddenly disappeared.",
                                "ru": "История приняла неожиданный <w>поворот</w>, когда главный герой внезапно исчез.",
                                "fr": "L'histoire a pris un <w>tournant</w> inattendu lorsque le protagoniste a soudainement disparu."
                            }
                        },
                        {
                            "text": "Door de economische crisis kreeg zijn carrière een heel andere <w>wending</w>.",
                            "target_lang_translations": {
                                "en": "Due to the economic crisis, his career took a very different <w>turn</w>.",
                                "ru": "Из-за экономического кризиса его карьера приняла совершенно иной <w>оборот</w>.",
                                "fr": "En raison de la crise économique, sa carrière a pris un <w>tournant</w> très différent."
                            }
                        }
                    ],
                    "synonyms": [
                        "ommekeer",
                        "verandering",
                        "draai"
                    ],
                    "common_phrases": [
                        "onverwachte wending",
                        "een wending nemen",
                        "verrassende wending",
                        "nieuwe wending"
                    ],
                    "target_lang_definitions": {
