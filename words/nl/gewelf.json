{
    "word_family": [
        "welven",
        "gewelfd",
        "overwelven"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fdcfb4d-4c58-34d4-9149-8328f93a4a07",
                    "sense_definition": "een holgebogen stenen zoldering of overspanning in een gebouw",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vooral in oude kerken zijn veel prachtige <w>gewelven</w> te vinden.",
                            "target_lang_translations": {
                                "en": "Many beautiful <w>vaults</w> can be found, especially in old churches."
                            }
                        },
                        {
                            "text": "Het gotische <w>gewelf</w> van de kathedraal is indrukwekkend hoog.",
                            "target_lang_translations": {
                                "en": "The cathedral's Gothic <w>vault</w> is impressively high."
                            }
                        }
                    ],
                    "synonyms": [
                        "boog",
                        "overspanning"
                    ],
                    "common_phrases": [
                        "gotisch gewelf",
                        "stenen gewelf"
                    ],
                    "target_lang_definitions": {
                        "en": "a curved masonry structure forming a ceiling or roof of a building"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vault",
                                "target_lang_sense_clarification": "an arched masonry structure forming a ceiling"
                            },
                            {
                                "target_lang_word": "vaulted ceiling",
                                "target_lang_sense_clarification": "an architectural ceiling with an arched shape"
                            },
                            {
                                "target_lang_word": "arch",
                                "target_lang_sense_clarification": "an architectural element in the shape of a curve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c6332d1-a661-3667-a591-514b67cf6971",
                    "sense_definition": "een ondergrondse ruimte of kelder die door een boogvormig plafond is overdekt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wijn wordt bewaard in een koel ondergronds <w>gewelf</w>.",
                            "target_lang_translations": {
                                "en": "The wine is kept in a cool underground <w>vault</w>."
                            }
                        },
                        {
                            "text": "Die oude ruimte onder het kasteel is tevens een <w>gewelf</w>.",
                            "target_lang_translations": {
                                "en": "That old space beneath the castle is also a <w>vault</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kelder",
                        "crypte"
                    ],
                    "common_phrases": [
                        "ondergronds gewelf"
                    ],
                    "target_lang_definitions": {
                        "en": "an underground room or cellar covered by an arched ceiling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vault",
                                "target_lang_sense_clarification": "an underground room or burial chamber"
                            },
                            {
                                "target_lang_word": "crypt",
                                "target_lang_sense_clarification": "an underground room under a church"
                            },
                            {
                                "target_lang_word": "cellar",
                                "target_lang_sense_clarification": "an underground storage room"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}