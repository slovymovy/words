                                        "entry_id": "6d7839c9-dbde-3d2a-ad93-ba798f72d7b7",
                                        "glosses": [
                                            "etwas Zerstörtes (häufig ein Bauwerk) erneut errichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2de5a4-ecb1-4949-840b-7e44e0d06564",
                                                "sense_id": "0b225003-507c-3155-b27a-cf4c0f2df9f8",
                                                "text": "Sie haben die Trümmer beiseitegeräumt und die Stadt wiederaufgebaut."
