                ],
                "senses": [
                    {
                        "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                        "entry_id": "d4e1902c-4e04-3fef-b7dc-a4fb52bf9c61",
                        "glosses": [
                            "organisatorische Einheit (meistens innerhalb eines Sportvereins) für den Laufsport und laufbezogene Aktivitäten"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f866eee7-d74a-4083-b0b2-17d3d8e03d15",
                                "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                                "text": "„Bereits zum 42. Mal veranstaltet die Laufabteilung des MTV Kronberg ihren Altkönig-Lauf.“"
                            },
                            {
                                "example_id": "34218f21-ee8e-4176-a41f-9a974e0130c0",
                                "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                                "text": "„Die Laufabteilung des TSV, die Zabelstein Runners veranstalten jedes Jahr am 3.Oktober einen Lauf mit über 100 Läufern aus ganz Deutschland.“"
                            },
                            {
                                "example_id": "80960e43-e973-461b-8c2c-67826ae3bdb1",
                                "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                                "text": "„Der Verein unterhält neben der Abteilung \"Schießsport\" noch eine weitere Laufabteilung, welche Mitglied im Hessichen Leichtathletikverband ist.“"
                            },
                            {
                                "example_id": "94be702b-eb28-4dd0-b187-4d70529cd91b",
                                "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                                "text": "„Anfang des Jahres 2021 hatten einige Laufbegeisterte die Idee, das Sportangebot von Grün-Weiß Gelmer um eine Laufabteilung zu erweitern.“"
                            },
                            {
                                "example_id": "0df69f71-00a3-42e6-8294-b6faaafc42ae",
                                "sense_id": "c574c05b-4bfd-35d9-8a44-b33b3503b0bf",
                                "text": "„Mit dem Tempo- und Koordinationstraining möchte die Laufabteilung des TV Friesen Telgte aber auch gezielt Läufer ansprechen, die nicht im Verein organisiert sind und für Wettkämpfe wie den Citylauf trainieren möchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
