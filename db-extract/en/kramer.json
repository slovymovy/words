                ],
                "senses": [
                    {
                        "sense_id": "5db5e79f-d551-3b83-8f9d-5af2d882beec",
                        "entry_id": "cb8e3b4b-deb3-3c06-ab30-76e63f14561c",
                        "glosses": [
                            "To suddenly enter or go through somewhere unexpectedly and suddenly."
                        ],
                        "tags": [
                            "colloquial",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48b5d4c0-b263-4078-a6bf-64e5c04adea8",
                                "sense_id": "5db5e79f-d551-3b83-8f9d-5af2d882beec",
                                "text": "I fell at work yesterday. A floor had just been mopped and there was no sign up about the floor being wet. I \"Kramered\" through, and slipped and wrenched my left knee."
                            },
                            {
                                "example_id": "1f5cdb15-0045-4670-a53c-e631d55dd945",
                                "sense_id": "5db5e79f-d551-3b83-8f9d-5af2d882beec",
                                "text": "I showed him how to open doors by fully turning the handle before you start to push it open instead of just Kramering through like usual, and he took it to heart!"
                            },
                            {
                                "example_id": "e365d728-963e-476e-9237-a5d55dac5b2a",
                                "sense_id": "5db5e79f-d551-3b83-8f9d-5af2d882beec",
                                "text": "When a man comes Kramering into a thread to say \"But not me!\" that's annoying, because the topic was on rape in general, and the guy came in there and made it about him."
                            }
                        ]
                    }
                ],
