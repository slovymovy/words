                    }
                ],
                "senses": [
                    {
                        "sense_id": "68b64685-04a9-3fc1-a96f-8eaa0539c58c",
                        "entry_id": "4a3d60c8-e03d-3fc7-896e-d53b19d11633",
                        "glosses": [
                            "Fait de rendre anonyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e194a8f6-7f38-4f4a-a763-f1625176c27c",
                                "sense_id": "68b64685-04a9-3fc1-a96f-8eaa0539c58c",
                                "text": "L’intérêt en tout cas de l’algorithme mis au point par les chercheurs, est de permettre d’aller plus loin qu’une fausse anonymisation des données et de montrer que la science prend le problème au sérieux."
                            },
                            {
                                "example_id": "7a6f7253-d88c-4c2e-8a05-0ad8d8689119",
                                "sense_id": "68b64685-04a9-3fc1-a96f-8eaa0539c58c",
                                "text": "A l’occasion de la journée Sécurité des Systèmes d'Information organisée par l’OSSIR sur le thème « Anonymat, vie privée et gestion d’identité », l'AFCDP publie le premier référentiel des outils d’anonymisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ec8e1b6-5a17-4a6a-a3b0-ad9141824b5b",
                        "source_entry_id": "4a3d60c8-e03d-3fc7-896e-d53b19d11633",
                        "source_sense_id": "68b64685-04a9-3fc1-a96f-8eaa0539c58c",
                        "source_sense_description": "fait de rendre anonyme",
                        "target_lang_word": "Anonymisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anonymisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "980deefb-4068-3f91-ad8b-4ff664868bd0",
                                        "entry_id": "22915e8d-4904-3c87-8424-3215bcc77715",
                                        "glosses": [
                                            "Verschlüsselung/Entfernung persönlicher Daten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d1b80c-146a-4a2b-88cd-d72d3c2183ae",
                                                "sense_id": "980deefb-4068-3f91-ad8b-4ff664868bd0",
                                                "text": "Bei absoluter Anonymisierung ist eine Re-Identifizierung wirklich unmöglich. Normalerweise ist eine Anonymisierung aber mit wenn auch unverhältnismäßig viel Aufwand wieder rückgängig zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aa24640-9d7c-4d61-9633-b2012bb497ad",
                        "source_entry_id": "4a3d60c8-e03d-3fc7-896e-d53b19d11633",
                        "source_sense_id": "68b64685-04a9-3fc1-a96f-8eaa0539c58c",
                        "source_sense_description": "fait de rendre anonyme",
                        "target_lang_word": "anonymization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anonymization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ed49cec-c5a8-3e2d-99dc-7967a5eaf0e8",
                                        "entry_id": "31609c2b-a11a-33c4-a286-f74b44c6d62c",
                                        "glosses": [
                                            "The act or process of making anonymous, of hiding or disguising identity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c720a799-e0de-4f95-8de5-bb476e4af2e2",
                                                "sense_id": "2ed49cec-c5a8-3e2d-99dc-7967a5eaf0e8",
                                                "text": "This anonymization site is supposed to keep emails from being tracked back to you."
                                            },
                                            {
                                                "example_id": "7f0dd1f4-5044-412e-971d-9b12b82a1a66",
                                                "sense_id": "2ed49cec-c5a8-3e2d-99dc-7967a5eaf0e8",
                                                "text": "This institutional and research caution is partly due to the fact that oral data is harder to anonymise than written data, and partly in recognition of the fact that in the future anonymisation will become increasingly harder as the application of AI to speech recognition continues to improve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
