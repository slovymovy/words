                        "glosses": [
                            "To deprive (something) of an edge; to render blunt; to blunt or dull."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3b1e65a4-a4ed-40e7-87f8-431e77fb30d7",
                                "sense_id": "df2de87b-81b8-3994-a968-eca27cf04d34",
                                "text": "[T]he pain she had / To keep them in the wild ways of the wood, / Two sets of three laden with jingling arms, / Together, served a little to disedge / The sharpness of that pain about her heart: […]"
                            }
                        ]
                    },
