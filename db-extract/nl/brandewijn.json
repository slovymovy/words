                    {
                        "translation_id": "59f1989f-6538-4134-807c-ccf620a4e60c",
                        "source_entry_id": "4ad1a9c7-08f8-3332-84bd-95d93649f042",
                        "source_sense_id": "6799ad00-fa4e-35f7-bcbb-7c4c10c5faa3",
                        "source_sense_description": "een soort sterke drank",
                        "target_lang_word": "Brandy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brandy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                                        "entry_id": "e8662893-4664-33d7-940b-a59f9cbeecc8",
                                        "glosses": [
                                            "Branntwein"
                                        ],
                                        "tags": [
                                            "andere Bezeichnung für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0766b9fd-c1cb-4507-8d33-6ae17a72402a",
                                                "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                                                "text": "„Er setzte sich und nahm wieder seinen Brandy, völlig niedergeschmettert von der Enttäuschung.“"
                                            },
                                            {
                                                "example_id": "66880d25-8c32-40de-a57c-1694ade07d1c",
                                                "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                                                "text": "„Und so hatten sie und Adrienne und Sylvia und Cyprian, die Taschen voll Lakritz und Brandy, im dunklen Kino gesessen und sich zunehmend beschwipster in das Melodram gestürzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89c5f2b0-90ba-4699-ade5-b46af47aa2d7",
                        "source_entry_id": "4ad1a9c7-08f8-3332-84bd-95d93649f042",
                        "source_sense_id": "6799ad00-fa4e-35f7-bcbb-7c4c10c5faa3",
                        "source_sense_description": "een soort sterke drank",
                        "target_lang_word": "Weinbrand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinbrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                        "entry_id": "c4f81e82-2d2b-3e2d-85a8-5a23fe5f89a0",
                                        "glosses": [
                                            "ein aus Wein durch Destillation hergestellter Branntwein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0826d82b-5b24-4e7d-a9b2-65139fd424c8",
                                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                                "text": "Weinbrand ist etwas für Genießer."
                                            },
                                            {
                                                "example_id": "21cfac52-cdd3-41e2-ac1e-2bb5c1fb5329",
                                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                                "text": "„Den Weinbrand hat Janosch zu Hause ausgetrunken und sich sofort an die Arbeit gemacht.“"
                                            },
                                            {
                                                "example_id": "61583794-ff33-4d24-ae50-eb6bd887d297",
                                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                                "text": "„Früher war es wohl eine große Villa mit Fabrikhof, heute ist der Betrieb ein weltweit bekanntes Unternehmen nicht nur für Weinbrand und Schnapspralinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef30c54d-9330-4f90-832a-53592881eb60",
                        "source_entry_id": "4ad1a9c7-08f8-3332-84bd-95d93649f042",
                        "source_sense_id": "6799ad00-fa4e-35f7-bcbb-7c4c10c5faa3",
                        "source_sense_description": "een soort sterke drank",
                        "target_lang_word": "Branntwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Branntwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                        "entry_id": "d47bf944-5c2e-3ad8-a011-4c6a514ea935",
                                        "glosses": [
                                            "ein ursprünglich nur aus Wein, später aber auch aus anderen vergorenen Flüssigkeiten durch Destillation hergestelltes Getränk mit hohem Alkoholgehalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2500ac-5ac1-4ca0-8176-128fba077ded",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "Du sollst nicht immer so viel Branntwein trinken!"
                                            },
                                            {
                                                "example_id": "a4f41a4a-3bc9-4ed0-8878-1908892fa554",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "Mit Fortfall dieser Bestimmung ab 1942 hat sich der Verbrauch von Branntwein zu gewerblichen Zwecken dem für Trinkzwecke wieder genähert."
                                            },
                                            {
                                                "example_id": "e90568fb-2c6f-4da4-ba4e-293322974f3a",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "In einer Privatbrennerei durfte man nur eine bestimmte Menge Branntwein für den Hausbedarf brennen."
                                            },
                                            {
                                                "example_id": "e6ec9647-cfed-4fc9-b741-42b62026ec0b",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "„Dann verteilt er Branntwein und gibt den Häuptlingen Bedenkzeit.“"
                                            },
                                            {
                                                "example_id": "73da1632-aa92-4604-95ee-d7e795ac5343",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "„Wie so viele andere Färinger in der zweiten Hälfte des 19. Jahrhunderts hatte ihn der Branntwein zugrunde gerichtet.“"
                                            },
                                            {
                                                "example_id": "a16208f7-934f-408e-8512-27973882a2c6",
                                                "sense_id": "67975430-4f87-3c4a-954a-22d4cad685ab",
                                                "text": "„Die Russen bestehen darauf, daß sie ständig in Betrieb bleibt, um Spiritus oder besser gesagt Branntwein herzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
