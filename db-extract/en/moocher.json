                    {
                        "sense_id": "017f5fa4-71ea-3862-82b3-e45e634e7c5d",
                        "entry_id": "361a25dc-2b17-3106-8cf4-7a4d422f224d",
                        "glosses": [
                            "A person having a tendency to take advantage of the help of others, especially if making little effort to help themselves."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "fb3b7db9-a450-43c9-a54f-d810b306d0e5",
                                "sense_id": "017f5fa4-71ea-3862-82b3-e45e634e7c5d",
                                "text": "When Mitt Romney says that 47% of Americans are moochers, or Barack Obama says that entrepreneurs didn’t build their own businesses, partisan viewers crave a partisan response."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f7361a0-2e6d-3b94-8562-d0f8a9ecba3b",
                        "entry_id": "361a25dc-2b17-3106-8cf4-7a4d422f224d",
                        "glosses": [
                            "A person who mooches about."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2521132-1ac9-4917-bedb-8cd533ce3e49",
                                "sense_id": "4f7361a0-2e6d-3b94-8562-d0f8a9ecba3b",
                                "text": "The whole area is a network of nature reserves among estuaries and marshes, and a paradise for a moocher like me."
                            }
                        ]
                    }
