                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zginanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna w skupieniu <w>złożył</w> ręce do modlitwy i zamknął oczy.",
                            "target_lang_translations": {
                                "ru": "Мужчина сосредоточенно <w>сложил</w> руки для молитвы и закрыл глаза."
                            }
                        },
                        {
                            "text": "Uczeń grzecznie <w>złożył</w> dłonie na ławce i czekał na nauczyciela.",
                            "target_lang_translations": {
                                "ru": "Ученик вежливо <w>сложил</w> руки на парте и ждал учителя."
                            }
