                                        "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                        "entry_id": "de48141e-a39c-3079-b562-6ea08a8c3f7c",
                                        "glosses": [
                                            "cecha tego, co pożądliwe; cecha tych, którzy są pożądliwi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0221ec5-053a-4b70-8abe-bdbf48d4d9e3",
                                                "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                                "text": "Świat zaś przemija, a z nim jego pożądliwość; kto zaś wypełnia wolę Bożą, ten trwa na wieki."
                                            },
                                            {
                                                "example_id": "b73583f3-4f98-476e-b0b5-ef0bb0f1e6d8",
                                                "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                                "text": "Patrzył jak ból pożądliwości, niezaspokojonej pożądliwości rozrywa mnie wprost na strzępy, kawałkuje, rozdziera."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b39e43c-acbc-4211-ab7b-6848546eb320",
                        "source_entry_id": "0f86c3e5-9b2c-3e16-9e47-8aabbf896f8e",
                        "source_sense_description": "Ardent desire",
                        "target_lang_word": "вожделе́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вожделе́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30cfb660-7cf0-381d-8d96-f49fa4735ef7",
                                        "entry_id": "1a460dd7-8851-342b-bbb6-24d960b60851",
                                        "glosses": [
                                            "страстное желание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee687ff-875e-4ebe-a659-31f02a2a780a",
                                                "sense_id": "30cfb660-7cf0-381d-8d96-f49fa4735ef7",
                                                "text": "Про́сите, и не получаете, потому что просите не на добро, а чтобы употребить для ваших вожделений."
                                            },
                                            {
                                                "example_id": "6cdb76c0-a3e4-4b60-b459-296276df23a4",
                                                "sense_id": "30cfb660-7cf0-381d-8d96-f49fa4735ef7",
                                                "text": "Он был, так сказать, продуктом местных нечистот; об них одних болело его сердце; к ним одним стремились его вожделения, и никаких иных навозных куч он не желал, кроме тех, которыми окружено было его счастливое детство."
                                            },
                                            {
                                                "example_id": "112f28d3-5d3c-4bbe-96c3-432b88b9cbd7",
                                                "sense_id": "30cfb660-7cf0-381d-8d96-f49fa4735ef7",
                                                "text": "Только когда внезапный ветер откидывает на его лбу седую прядь, когда на мгновенье открывается роковой знак мстительного Бога, он сурово хмурится и, вспоминая незабываемое, с вожделением думает о смерти."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d301c109-0b12-3e50-8c4a-f398680cbbb3",
                                        "entry_id": "1a460dd7-8851-342b-bbb6-24d960b60851",
                                        "glosses": [
                                            "сильное чувственное влечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91e9d3c-2c13-435c-a27a-91ad8a91f6a6",
                                                "sense_id": "d301c109-0b12-3e50-8c4a-f398680cbbb3",
                                                "text": "А Я говорю вам, что всякий, кто смотрит на женщину с вожделением, уже прелюбодействовал с нею в сердце своем."
                                            },
                                            {
                                                "example_id": "945e4af4-8f1d-4f06-af94-54b5aaed2d69",
                                                "sense_id": "d301c109-0b12-3e50-8c4a-f398680cbbb3",
                                                "text": "Он стоял, глядя на задумчивое, мучимое внутренней работой лицо Катюши, и ему было жалко её, но, странное дело, эта жалость только усиливала вожделение к ней. Вожделение обладало им всем."
                                            },
                                            {
                                                "example_id": "1199ce76-e39b-4655-abe7-0548ad7ef092",
                                                "sense_id": "d301c109-0b12-3e50-8c4a-f398680cbbb3",
                                                "text": "И опять-таки самое стояние у моста есть только следствие того, что на мост погнало; а гнало его вожделение; самые страстные чувства переживались им как-то не так, воспламенялся не так он, не по-хорошему, холодно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
