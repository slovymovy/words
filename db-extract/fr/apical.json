                                        "entry_id": "2d6914c6-a62f-382f-a4b5-b87c2aecad33",
                                        "glosses": [
                                            "Dicho de un fonema, que se articula con el ápice de la lengua tocando la cara interior de los dientes superiores o el alveolo del paladar."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
