                "senses": [
                    {
                        "sense_id": "861bede1-fe15-352a-aea5-62e15abc5dd7",
                        "entry_id": "7cb806dc-5399-3cda-9694-3e110ee7fbea",
                        "glosses": [
                            "Biologie, Geologie: Fossiler Einschluss von kleinen Tieren oder Pflanzenteilen in Bernstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63218edc-7be3-4063-9853-1a357cf0459a",
                                "sense_id": "861bede1-fe15-352a-aea5-62e15abc5dd7",
                                "text": "Im baltischen Bernstein finden sich häufig Inklusen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1577fa62-8458-3258-913f-e0e324b00023",
                        "entry_id": "7cb806dc-5399-3cda-9694-3e110ee7fbea",
                        "glosses": [
                            "Männer oder Frauen, die sich längere Zeit oder auf Lebenszeit in eine Zelle (Inklusorium) einschließen oder einmauern ließen, um im Gebet und Buße Gott zu dienen."
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7c283fa7-ab51-4760-8bbc-03801332e031",
                                "sense_id": "1577fa62-8458-3258-913f-e0e324b00023",
                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                            },
                            {
                                "example_id": "efcbf164-6b9b-4f6e-b696-1a340c7cd991",
                                "sense_id": "1577fa62-8458-3258-913f-e0e324b00023",
                                "text": "\"Wegen Mißbräuchen verlangte die 2. Trullan. Synode (692), dass man erst nach 3 Klosterjahren Inkluse werden u. die Zelle danach nicht mehr verlassen dürfe …\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
