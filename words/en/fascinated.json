                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровал",
                                "target_lang_sense_clarification": "прошедшее время, мужской род"
                            },
                            {
                                "target_lang_word": "заворожил",
                                "target_lang_sense_clarification": "прошедшее время, мужской род"
                            },
                            {
                                "target_lang_word": "восхитил",
