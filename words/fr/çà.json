                    "sense_id": "51fe0bd2-54e4-385b-93dc-ee2386318b9b",
                    "sense_definition": "Ici, marquant un lieu indéterminé ou dispersé ; s'emploie principalement dans la locution « çà et là ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En nous promenant dans la forêt, nous avons aperçu quelques champignons poussant <w>çà</w> et là."
                        },
                        {
                            "text": "Des feuilles mortes étaient éparpillées <w>çà</w> et là dans toute la cour de récréation."
                        }
                    ],
                    "synonyms": [
                        "ici"
                    ],
                    "common_phrases": [
                        "çà et là"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "35aea7ef-09d7-38e0-ad5c-ff2806851320",
                    "sense_definition": "Exclamation servant à marquer une vive surprise, une émotion soudaine ou une exhortation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah <w>çà</w> ! Me direz-vous enfin ce qui vous tracasse depuis ce matin ?"
                        },
                        {
                            "text": "<w>Çà</w>, mes braves amis, reprenons courage et terminons ce travail avant la tombée de la nuit !"
                        }
                    ],
                    "common_phrases": [
                        "ah çà"
                    ],
                    "traits": [
