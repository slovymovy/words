                "senses": [
                    {
                        "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                        "entry_id": "e918d34b-a082-3edf-a4ce-94d241a601a2",
                        "glosses": [
                            "Eigenschaft einer Investition/eines Projekts nicht durch laufende Einnahmen oder Eigenmittel, sondern durch Fremdmittel/Kredite (= Schulden) finanziert zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754f1093-e36d-4a2c-90ad-4afa42d1ed4d",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Bundestag und Bundesrat hatten in der vergangenen Woche das schuldenfinanzierte Investitionsprogramm von Union und SPD verabschiedet.“"
                            },
                            {
                                "example_id": "bea01024-18f8-47d3-a88a-e85d1c15bc6a",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„[…] der Bundesverband der Deutschen Industrie kann sich unter bestimmten Bedingungen schuldenfinanzierte Investitionen vorstellen.“"
                            },
                            {
                                "example_id": "51f289a8-9d42-4809-b42d-e2fd4c85b88b",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Das schuldenfinanzierte Finanzpaket von Union und SPD für Verteidigung und Infrastruktur hat die letzte parlamentarische Hürde genommen. Im Bundesrat kam die für das Vorhaben notwendige Zweidrittelmehrheit zusammen.“"
                            },
                            {
                                "example_id": "ca4f94e4-1124-4a52-ba9d-d89b27c95f0f",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Ein schuldenfinanziertes Milliardenpaket für Militär und Infrastruktur: Viele Ökonomen loben diesen Schritt, andere sehen ihn kritisch.“"
                            },
                            {
                                "example_id": "a48db534-12a1-4ced-977f-fdd43cdc25f4",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Schuldenfinanzierte Ausgaben unter anderem für Infrastruktur könnten […] für weiteres Wachstum sorgen.“"
                            },
                            {
                                "example_id": "87f7e759-e35f-454d-aa75-28c99a8100c9",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Die Regierung Brüning lehnte schuldenfinanzierte Krisenausgaben ab und konzentrierte sich darauf, den Haushalt auszugleichen.“"
                            },
                            {
                                "example_id": "e59d9c4d-83f7-46be-8622-506cc528fb5f",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Hieß es über Jahre von bürgerlicher Seite, Mehrausgaben zur Sanierung von Schienen, Brücken und Schulen im Land dürfe man wegen der Schuldenbremse und künftiger Generationen nicht über Kredite finanzieren, so sind schuldenfinanzierte Mehrausgaben plötzlich richtig und unproblematisch und das Grundgesetz kann gar nicht schnell genug dafür geändert werden.“"
                            },
                            {
                                "example_id": "eb47b99f-4019-4e81-a199-f3addb91831c",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Notorische Defizitländer wie Italien dagegen stehen vor einem doppelten Risiko: Bricht die Wirtschaft ein, sind sie kaum in der Lage, neue schuldenfinanzierte Ausgabenprogramme zu starten.“"
                            },
                            {
                                "example_id": "c153642d-2963-48c2-b3da-7757a14bb977",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Viele Staaten würden ihre Zahlungsfähigkeit riskieren, wenn sie in massive schuldenfinanzierte Ausgabenprogrammen [sic!] einsteigen.“"
                            },
                            {
                                "example_id": "92f18324-9e8a-4c01-bf8c-6f63394781a2",
                                "sense_id": "ba51ed33-da47-31f3-bc44-ec4f5e3fabad",
                                "text": "„Der schuldenfinanzierte Corona-Wiederaufbaufonds muss im Zeitraum von 2028 bis 2058 zurückgezahlt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
