                ],
                "senses": [
                    {
                        "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                        "entry_id": "5ab3058d-c871-3b17-8a25-2092cf0cfd1c",
                        "glosses": [
                            "Einwurf, der so weit reicht, dass der Ball in die Nähe oder in den Torraum kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9543fd-1b53-4230-919a-f574c04019ce",
                                "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                                "text": "„Nach einer Einwurfflanke von Luca Leib drückte David Klimek das Leder zum mittlerweile verdienten 2:2 über die Linie (64.).“"
                            },
                            {
                                "example_id": "a03f4fd4-06d6-4903-bad9-db421e3de924",
                                "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                                "text": "„Die Wohlder unterstrichen ihre Ambitionen schon nach drei Minuten mit einem Flugkopfball von Adam Moryl nach einer Einwurfflanke von Jens-Uwe Lorenzen.“"
                            },
                            {
                                "example_id": "ffd3fb69-cc13-4ff4-9969-aa033b6d1a8c",
                                "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                                "text": "„Zunächst warf sich Telsemeyer in eine Einwurfflanke von Maik Klostermann, der Ball landete am Pfosten, trudelte über die Linie oder war auch ein Stück dahinter.“"
                            },
                            {
                                "example_id": "16d6190e-43f7-4abf-be18-c021f5411c10",
                                "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                                "text": "„Vier Minuten vor dem Abpfiff feuerte ein gewisser Ashton Götz eine Einwurfflanke in den Bremer Strafraum, Verteidiger Assani Lukimya verlängerte den Ball mit dem Hinterkopf zu Stürmer Artjoms Rudnevs, der zum 1:0 für Hamburg eingrätschte und dabei Torwart Raphael Wolf am Knie verletzte.“"
                            },
                            {
                                "example_id": "5f983368-8f7c-42a9-9e94-fb9e8edcb088",
                                "sense_id": "3d6b811c-4fbd-3823-8157-a3f3923a8395",
                                "text": "„Eine Einwurfflanke von Tobias Lepka konnte in der 10. Minute Eugen Rerich nicht per Kopfball im Tor von Jan Büttner unterbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
