                                                "example_id": "e218b86d-e97b-490b-a2a0-69ca8a09f6f5",
                                                "sense_id": "b64797b0-159a-3c51-b078-c4e89b67a7fb",
                                                "text": "Jeden tablet może być obsługiwany za pomocą całego zestawu rysików pełniących różne funkcje."
                                            }
