                                        "entry_id": "b5a62077-3554-3c3c-b3bb-43fbfcd8fbd3",
                                        "glosses": [
                                            "A device used to measure a dose of ionizing radiation."
                                        ],
                                        "tags": [],
                                        "examples": [
