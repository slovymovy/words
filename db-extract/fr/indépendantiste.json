            {
                "entry_id": "ab988a9f-0d2b-3bab-b65f-c91fd72433c8",
                "word": "indépendantiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "096c8410-4e04-4162-8a7d-6cf68fe2f763",
                        "entry_id": "ab988a9f-0d2b-3bab-b65f-c91fd72433c8",
                        "tags": [
