                        "examples": [
                            {
                                "example_id": "2ef01647-cd26-4a4c-8994-512fb314f674",
                                "sense_id": "bb47c1b4-e693-39bb-a775-3c7c29dd5b95",
                                "text": "SEPTIFORME, septiformis (septum, cloison, forma, forme) ; qui a la forme d’une cloison. Mirbel donne cette épithète au placentaire, lorsqu’il est élargi en cloison (ex. Crucifères). On l’applique à la columelle des coquilles univalves, toutes les fois que, par sa saillie, elle semble produire une cloison ou un diaphragme (ex. Navicelle)."
                            },
                            {
                                "example_id": "af3cbdd0-080a-46f4-a82c-7ee865e91727",
                                "sense_id": "bb47c1b4-e693-39bb-a775-3c7c29dd5b95",
                                "text": "Les valves du péricarpe sont quelquefois septiformes."
                            }
                        ]
                    }
