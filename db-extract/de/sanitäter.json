                        "form": "den Sanitäter"
                    },
                    {
                        "form_id": "81a20b97-bb31-4fae-b622-593bfc565981",
                        "entry_id": "b4a9629d-361a-30cd-8be5-7605d728317a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sanitäter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                        "entry_id": "b4a9629d-361a-30cd-8be5-7605d728317a",
                        "glosses": [
                            "Person mit entsprechender Ausbildung, die Kranken oder Verletzten Erste Hilfe leistet oder sie wenn nötig zur weiteren Behandlung transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6440e46-1f29-4280-80ee-83124383a186",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "Die Sanitäter, die zuerst am Unfallort waren, hatten schon den Eindruck, dass er wohl nicht überleben würde."
                            },
                            {
                                "example_id": "7696e8fb-6ee5-4a7a-b11f-ecbde123f9cb",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Sani!, Sani!“ schrien die von Granatsplittern Getroffenen auf dem Schlachtfeld, aber es kam kein Sanitäter."
                            },
                            {
                                "example_id": "2c85da57-be66-4a8a-8c04-179da171c204",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "Im Katastrophenfall kommen auch freiwillige Sanitäter zum Einsatz."
                            },
                            {
                                "example_id": "048119bb-772b-499d-aeb5-d147289fc5d8",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Kurz vor Kriegsende hatte man es dem Sanitäter Wendelin Tippelt verliehen für die Rettung Verwundeter aus dem Geschützfeuer.“"
                            },
                            {
                                "example_id": "b0d385e8-d0ab-4314-a14b-42d5adf3f254",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Zwei Sanitäter sprangen herzu und trugen ihn weg.“"
                            },
                            {
                                "example_id": "ae01b991-48ac-4fbd-80c9-e7ff4b0e2911",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Einer unserer Sanitäter führte den Brand.“"
                            },
                            {
                                "example_id": "4ef661c8-9c50-4759-a7a5-1e014dbda50e",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Eine Zeitlang machte ich Dienst im Lazarett, weil einer der Saniäter krank war.“"
                            },
                            {
                                "example_id": "e3cc0fb7-56cd-4389-8eb6-233a27077257",
                                "sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                                "text": "„Der Rotkreuzwagen kommt ungewöhnlich schnell, auch Arzt und Sanitäter sind sofort am Ort des vermuteten Unfallgeschehens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
