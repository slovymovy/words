                        "sense_id": "7add8140-3734-38d3-99d0-bb2bd83c2426",
                        "entry_id": "ebfe144d-01e1-35b3-95e2-dcccb30ec4e1",
                        "glosses": [
                            "Un stérol cristallin synthétisé par des levures à partir de sucres ou dérivé de l’ergot de seigle et provitamine car il est transformé en ergocalciférol, une forme de vitamine D2, par exposition aux rayons ultraviolets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbd259d-c1dd-4dd6-b31b-e644b0bafa4b",
                                "sense_id": "7add8140-3734-38d3-99d0-bb2bd83c2426",
                                "text": "L’ergocalciférol est formé à partir de l’ergostérol transformé spontanément par la lumière ultraviolette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c86333e-a566-489c-beb6-9ed4e3c7b1ba",
                        "source_entry_id": "ebfe144d-01e1-35b3-95e2-dcccb30ec4e1",
