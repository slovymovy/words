            "senses": [
                {
                    "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                    "sense_definition": "Cri très fort, prolongé et perçant, poussé sous l'effet d'une vive émotion comme la douleur, la terreur ou la colère.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cris_vivants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>hurlement</w> de douleur a soudain retenti dans toute la maison."
                        },
                        {
                            "text": "Pris de panique, le jeune homme poussait des <w>hurlements</w> que personne ne pouvait calmer."
                        }
                    ],
                    "synonyms": [
                        "braillement",
                        "clameur",
                        "cri"
                    ],
                    "antonyms": [
                        "chuchotement",
                        "murmure",
                        "silence"
                    ],
                    "common_phrases": [
                        "hurlement de douleur",
                        "hurlement de terreur",
                        "pousser des hurlements"
                    ]
                },
                {
                    "sense_id": "aad305d7-2583-3bb7-a756-e0d316e8cc3a",
                    "sense_definition": "Cri prolongé et mélancolique caractéristique du loup ou de certains canidés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cris_vivants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la forêt enneigée, le <w>hurlement</w> d'un loup solitaire a réveillé les randonneurs."
                        },
                        {
                            "text": "Nous avons entendu des <w>hurlements</w> au loin pendant toute la nuit."
                        }
                    ],
                    "synonyms": [
                        "cri"
                    ],
                    "common_phrases": [
                        "hurlement du loup",
                        "hurlements à la lune"
                    ]
                },
                {
                    "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                    "sense_definition": "Bruit violent, continu et strident produit par des éléments naturels déchaînés ou par un mécanisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruits_inanimes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>hurlement</w> du vent contre les volets empêchait les enfants de trouver le sommeil."
                        },
                        {
                            "text": "Le <w>hurlement</w> strident de la sirène a immédiatement alerté tout le quartier."
                        }
                    ],
                    "synonyms": [
                        "mugissement",
                        "sifflement"
                    ],
                    "antonyms": [
                        "calme",
                        "silence"
                    ],
                    "common_phrases": [
                        "hurlement de la tempête",
                        "hurlement des sirènes",
                        "hurlement du vent"
                    ]
                }
            ]
        }
    ]
