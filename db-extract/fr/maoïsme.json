                ],
                "senses": [
                    {
                        "sense_id": "1beaf2aa-5d47-36a5-b050-205cad36dd5e",
                        "entry_id": "3c03eda4-9374-3c87-9fd6-a48e3cdebe29",
                        "glosses": [
                            "Idéologie communiste telle que professée par Mao Zedong ou ses adeptes."
                        ],
                        "tags": [
                            "Maoïsme"
                        ],
                        "examples": [
                            {
                                "example_id": "4489d2a9-d105-4ebd-a964-21595691e1c4",
                                "sense_id": "1beaf2aa-5d47-36a5-b050-205cad36dd5e",
                                "text": "La synthèse du sexe et du maoïsme est une invention bourgeoise à l’usage des esprits masturbables. Si l'on veut toucher à quelque chose de bourgeois, c’est à sa sobriété même qu'il faut s'en prendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b772e215-8561-4870-bb0e-8dd20dfd6758",
                        "source_entry_id": "3c03eda4-9374-3c87-9fd6-a48e3cdebe29",
                        "source_sense_id": "1beaf2aa-5d47-36a5-b050-205cad36dd5e",
                        "target_lang_word": "Maoism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maoism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e197f954-1868-3f8a-bfba-89d9853fb571",
                                        "entry_id": "4f5b219a-b79f-3205-91ff-9d5afc5694bf",
                                        "glosses": [
                                            "The philosophy espoused by Chinese leader Mao Zedong, a form of Marxism-Leninism that focuses on the peasantry as the revolutionary vanguard."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f20ac1ff-0afe-46c9-bdcb-ed16dcdee400",
                                                "sense_id": "e197f954-1868-3f8a-bfba-89d9853fb571",
                                                "text": "Some of the farmers were arrested in Wuhan parks where they allegedly spoke against Maoism and the Communist dictatorship, the report said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e982e90d-b2f9-4ee2-90c8-69a01bd18c8f",
                        "source_entry_id": "3c03eda4-9374-3c87-9fd6-a48e3cdebe29",
                        "source_sense_id": "1beaf2aa-5d47-36a5-b050-205cad36dd5e",
                        "target_lang_word": "Mao Zedong Thought",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mao Zedong Thought",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6653924f-f9a3-3cf5-bae4-caf7cf22cf5f",
                                        "entry_id": "02385d40-2c0f-31d2-9b68-4243c2ed7fa9",
                                        "glosses": [
                                            "Synonym of Maoism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71452af5-1e14-40c3-9015-db8588afca56",
                                                "sense_id": "6653924f-f9a3-3cf5-bae4-caf7cf22cf5f",
                                                "text": "In Tungkuan County, the Houchieh Brigade under Houchieh Commune, with the assistance of the Mao Tsetung Thought propaganda team, made[…]"
                                            },
                                            {
                                                "example_id": "bac7e8cb-cac2-471e-b90f-a83cbe5639ac",
                                                "sense_id": "6653924f-f9a3-3cf5-bae4-caf7cf22cf5f",
                                                "text": "A document circulating online purporting to detail a proposal by top Communist Party officials to remove Mao Zedong Thought from party work, documents and policies, has also sharpened debate.\nThe supposed Politburo document, No. 179, dated Dec. 28, 2010, is said to have been proposed by Xi Jinping, the man expected to become China’s next president, and Wu Bangguo, the head of the National People’s Congress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07b73ba3-734c-4b8a-8036-3506ec850e17",
                        "source_entry_id": "3c03eda4-9374-3c87-9fd6-a48e3cdebe29",
