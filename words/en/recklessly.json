{
    "word_family": [
        "reckless",
        "recklessness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                    "sense_definition": "In a rash or careless manner, without considering the potential negative consequences or risks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>recklessly</w> speeding through the busy city streets during rush hour.",
                            "target_lang_translations": {
                                "zh": "高峰时段，那名司机在繁忙的城市街道上<w>鲁莽地</w>超速行驶。"
                            }
                        },
                        {
                            "text": "He spent his entire savings <w>recklessly</w> on items he did not actually need.",
                            "target_lang_translations": {
                                "zh": "他把全部积蓄都<w>轻率地</w>花在了那些他根本不需要的东西上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "carelessly",
                        "rashly",
                        "irresponsibly"
                    ],
                    "antonyms": [
                        "cautiously",
                        "carefully"
                    ],
                    "common_phrases": [
                        "driving recklessly",
                        "spending recklessly"
                    ],
                    "target_lang_definitions": {
                        "zh": "以鲁莽或不计后果的方式，不考虑潜在的负面影响或风险。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鲁莽地",
                                "target_lang_sense_clarification": "形容行为冲动，不顾后果。"
                            },
                            {
                                "target_lang_word": "轻率地",
                                "target_lang_sense_clarification": "形容做事不慎重，缺乏考虑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa0d20ab-5f70-3289-8bbb-1dd5faa8b09f",
                    "sense_definition": "In a way that shows a lack of concern for the safety, rights, or well-being of other people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>recklessly</w> ignored safety warnings, putting all of its employees at risk.",
                            "target_lang_translations": {
                                "zh": "该公司<w>肆无忌惮地</w>无视安全警告，将所有员工置于危险之中。"
                            }
                        },
                        {
                            "text": "She <w>recklessly</w> shared private information about her colleagues without their permission.",
                            "target_lang_translations": {
                                "zh": "她<w>不负责任地</w>在未经许可的情况下分享了同事的私人信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "callously",
                        "heedlessly"
                    ],
                    "antonyms": [
                        "considerately"
                    ],
                    "target_lang_definitions": {
                        "zh": "以一种漠视他人安全、权利或福祉的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肆无忌惮地",
                                "target_lang_sense_clarification": "形容毫无顾忌，不顾他人感受。"
                            },
                            {
                                "target_lang_word": "不负责任地",
                                "target_lang_sense_clarification": "形容缺乏责任感，不顾及他人利益。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}