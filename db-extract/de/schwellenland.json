                ],
                "senses": [
                    {
                        "sense_id": "634aabb8-7fdd-3148-9e4f-abba91f6e729",
                        "entry_id": "5b3aedac-44ae-35e3-a1b2-b5d7cfc5a9dd",
                        "glosses": [
                            "Land, das sich im Übergang, an der Schwelle vom Entwicklungsland zum Industrieland befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664a0db3-40e2-46bd-bd8f-ca5a72859131",
                                "sense_id": "634aabb8-7fdd-3148-9e4f-abba91f6e729",
                                "text": "China gilt als Schwellenland."
                            },
                            {
                                "example_id": "bc91deab-6839-4aca-bd56-e5e85ec8d21e",
                                "sense_id": "634aabb8-7fdd-3148-9e4f-abba91f6e729",
                                "text": "„Das Wirtschaftswachstum, das 2010 mit 7,5 Prozent seinen Höhepunkt erreichte, ist fast zum Erliegen gekommen. Im zweitgrößten Schwellenland der Erde dürfte es dieses Jahr um magere zwei Prozent zulegen.“"
                            },
                            {
                                "example_id": "0e5e7cb2-1a79-43b6-8b40-e89bf8dc84f9",
                                "sense_id": "634aabb8-7fdd-3148-9e4f-abba91f6e729",
                                "text": "„So wird Griechenland zu einem Schwellenland: Der Elite geht es gut, unter ihr beginnt das Elend.“"
                            },
                            {
                                "example_id": "fdedfc14-9ae4-446a-a4a9-7371d1307af6",
                                "sense_id": "634aabb8-7fdd-3148-9e4f-abba91f6e729",
                                "text": "„Sein Glatzkopf ist ein Markenzeichen: Mark Mobius (81) ist Börsenguru, Pionier der Investments in Schwellenländern und ehemaliger Executive Chairman der Fondsgesellschaft Franklin Templeton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
