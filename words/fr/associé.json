    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7144e95-7ac1-3640-87fd-6b4c09139098",
                    "sense_definition": "Personne avec qui l'on partage la direction, le capital ou les bénéfices d'une entreprise ou d'une société.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "business_partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>associé</w> et moi avons décidé d'ouvrir une nouvelle agence à Lyon."
                        },
                        {
                            "text": "Ils cherchent un nouvel <w>associé</w> pour apporter des fonds supplémentaires au projet."
                        }
                    ],
                    "synonyms": [
                        "partenaire",
                        "collaborateur"
                    ],
                    "antonyms": [
                        "concurrent",
                        "rival"
                    ],
                    "common_phrases": [
                        "associé majoritaire",
                        "associé unique"
                    ]
                },
                {
                    "sense_id": "2509cf75-b412-3ef2-9ac5-d5fcf970685f",
                    "sense_definition": "Membre étranger ou honoraire d'une académie ou d'un corps savant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chercheur renommé a été élu comme <w>associé</w> étranger à l'Académie des sciences."
                        },
                        {
                            "text": "Plusieurs illustres <w>associés</w> participent aux conférences internationales de cette société savante."
                        }
                    ],
                    "synonyms": [
                        "correspondant"
                    ],
                    "common_phrases": [
                        "associé étranger"
                    ]
                }
            ]
        },
        {
