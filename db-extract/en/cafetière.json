                        "source_sense_id": "7df95436-5843-30f5-8204-cb5ac592fac6",
                        "source_sense_description": "cylindrical glass jug used to make coffee",
                        "target_lang_word": "cafetière à piston",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafetière à piston",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3c1711-8574-324a-9c42-f00aacb065e0",
                                        "entry_id": "2a1640d3-347a-3f00-8af5-87511d435d22",
                                        "glosses": [
                                            "Ustensile composé d’un cylindre de verre ou de métal dans lequel coulisse un piston métallique perforé, qui pousse et maintient au fond le café moulu après l’infusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7f016c-e7ee-4aa8-b503-a25aade56543",
                                                "sense_id": "7c3c1711-8574-324a-9c42-f00aacb065e0",
                                                "text": "Il remplissait les tasses, avec la vieille cafetière à piston qui lui venait de sa mère."
                                            },
                                            {
                                                "example_id": "2756994c-9c48-41ef-8e9a-9edcbe1ba3f5",
                                                "sense_id": "7c3c1711-8574-324a-9c42-f00aacb065e0",
                                                "text": "Maman verse l’eau chaude dans la cafetière à piston."
                                            },
                                            {
                                                "example_id": "6f8616fa-16cd-43d2-b4a9-842850806286",
                                                "sense_id": "7c3c1711-8574-324a-9c42-f00aacb065e0",
                                                "text": "La cafetière à piston (Bodum ou Mélior) est en verre, pourvue d’un piston que l’on presse pour retenir le marc; le café est infusé puis filtré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
