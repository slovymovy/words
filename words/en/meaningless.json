                        "meaningless sounds",
                        "meaningless symbols"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый смысла или значения; непонятный.",
                        "es": "Que carece de significado, sentido o definición; incomprensible."
                    },
                    "translations": {
