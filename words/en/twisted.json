                },
                {
                    "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                    "sense_definition": "Mentally or emotionally unsound; strange in an unpleasant or cruel way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain in the movie had a <w>twisted</w> plan to destroy the city.",
                            "target_lang_translations": {
                                "ru": "У злодея в фильме был <w>извращённый</w> план по уничтожению города.",
                                "fr": "Le méchant du film avait un plan <w>tordu</w> pour détruire la ville.",
                                "tr": "Filmindeki kötü adamın şehri yok etmek için <w>hastalıklı</w> bir planı vardı."
                            }
                        },
                        {
                            "text": "He has a <w>twisted</w> sense of humor that many people find offensive.",
                            "target_lang_translations": {
                                "ru": "У него <w>извращённое</w> чувство юмора, которое многие находят оскорбительным.",
                                "fr": "Il a un sens de l'humour <w>tordu</w> que beaucoup de gens trouvent offensant.",
                                "tr": "Pek çok insanın kırıcı bulduğu <w>çarpık</w> bir mizah anlayışı var."
                            }
                        }
