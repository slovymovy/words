                ],
                "senses": [
                    {
                        "sense_id": "6f972c19-f206-36db-8e00-c9e5ac9c36cd",
                        "entry_id": "4adbda5e-5acb-3cc3-bceb-3fbc706a9f35",
                        "glosses": [
                            "An organized group of inspectors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f32c8b94-af9f-406e-b519-5cfa43f96945",
                                "sense_id": "6f972c19-f206-36db-8e00-c9e5ac9c36cd",
                                "text": "What makes a great primary? Let's deal with this one straight away – it isn't what Ofsted says. All the inspectorate has cared about in the past few years is data progression in maths and literacy."
                            },
                            {
                                "example_id": "e188993c-514b-4277-bfbc-67ecaaaa4b11",
                                "sense_id": "6f972c19-f206-36db-8e00-c9e5ac9c36cd",
                                "text": "Once the next stage of funding is agreed, EWR Co will submit the DCO [Development Consent Order] application to the Planning Inspectorate, which will examine the proposals (during which time the public can comment on the application)."
                            }
                        ]
                    },
                    {
                        "sense_id": "78df8588-af16-3e79-84e5-2a7d1018a8d8",
                        "entry_id": "4adbda5e-5acb-3cc3-bceb-3fbc706a9f35",
                        "glosses": [
                            "The office of an inspector."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0775a13-41f5-3a63-a960-a0cc6c9a5859",
                        "entry_id": "4adbda5e-5acb-3cc3-bceb-3fbc706a9f35",
