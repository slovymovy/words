                        "target_lang_word": "überziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00a127b7-da54-3a35-a447-774087249a64",
                                        "entry_id": "efc0535f-7f9c-3934-a767-11921767e71e",
                                        "glosses": [
                                            "etwas sich oder jemandem über den Körper oder einen Körperteil ziehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a641b6-08fc-46df-9fd1-23af10732c69",
                                                "sense_id": "00a127b7-da54-3a35-a447-774087249a64",
                                                "text": "Es ist so kalt, ich werde mir einen Mantel überziehen."
                                            },
                                            {
                                                "example_id": "467bd0ab-6f59-451b-ae86-ee754ad9ca5a",
                                                "sense_id": "00a127b7-da54-3a35-a447-774087249a64",
                                                "text": "„Weil ein moldauisches Gefängnis jenseits des Flusses liegt, müssen die Wärter jeden Morgen Tarnmäntel überziehen, um ihre Uniformen zu verbergen.“"
                                            },
                                            {
                                                "example_id": "e41f0cac-fca6-469c-9c33-8fec67ae5158",
                                                "sense_id": "00a127b7-da54-3a35-a447-774087249a64",
                                                "text": "„Dann wurden die Gebeine mit einer Lehmschicht überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e68a3bfd-2a85-347d-897b-546615146401",
                                        "entry_id": "efc0535f-7f9c-3934-a767-11921767e71e",
                                        "glosses": [
                                            "jemanden mit einem Gegenstand schlagen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fdd9e9c-3e63-4231-b917-5c6b2f751890",
                                                "sense_id": "e68a3bfd-2a85-347d-897b-546615146401",
                                                "text": "Ich zog ihm eins mit der Peitsche über."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0955fdd5-2799-336c-aff0-86a4d0711c23",
                                        "entry_id": "18dea67f-4736-363e-858f-155112a02e50",
                                        "glosses": [
                                            "etwas mit etwas bespannen, bedecken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb223bcc-263e-4e05-9408-c8b892276a59",
                                                "sense_id": "0955fdd5-2799-336c-aff0-86a4d0711c23",
                                                "text": "Der Kuchen ist mit Schokolade überzogen."
                                            },
                                            {
                                                "example_id": "aca27032-d5c2-476d-91ef-65919ecdc0d4",
                                                "sense_id": "0955fdd5-2799-336c-aff0-86a4d0711c23",
                                                "text": "Die Betten sind frisch überzogen."
                                            },
                                            {
                                                "example_id": "fefeae64-1303-42b4-8671-5766d469b671",
                                                "sense_id": "0955fdd5-2799-336c-aff0-86a4d0711c23",
                                                "text": "„Er erließ an alle Getreuen des Reiches den Befehl, Friedrichen, seine Lande und Anhänger feindselig zu überziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f76cd1b2-9731-3177-ace2-f13ca6095160",
                                        "entry_id": "18dea67f-4736-363e-858f-155112a02e50",
                                        "glosses": [
                                            "etwas über das Maß ausreizen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46b3ef1-000b-40ac-a488-d4eba7589afa",
                                                "sense_id": "f76cd1b2-9731-3177-ace2-f13ca6095160",
                                                "text": "Der Kunde hat sein Bankkonto überzogen."
                                            },
                                            {
                                                "example_id": "5d2fd1de-26d8-4ccf-b2a8-c4170b30cad7",
                                                "sense_id": "f76cd1b2-9731-3177-ace2-f13ca6095160",
                                                "text": "Unser Lehrer überzieht jedes Mal die Unterrichtszeit."
                                            },
                                            {
                                                "example_id": "65ebb8ff-0469-40f8-a394-eef89cd91d2a",
                                                "sense_id": "f76cd1b2-9731-3177-ace2-f13ca6095160",
                                                "text": "„Augie kannte so etwas aus Kinos und aus der Bank, bei der er derzeit sein Konto überzogen hatte, und begriff den Zweck: möglichst viele Leute auf möglichst kleinem Raum unterzubringen..“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ac56a75-009b-37de-ae5a-7600dc92e94b",
                                        "entry_id": "18dea67f-4736-363e-858f-155112a02e50",
                                        "glosses": [
                                            "eine Sache durchschauen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af67a58c-c62b-44a4-97c8-c4f00bd5ead6",
                                                "sense_id": "8ac56a75-009b-37de-ae5a-7600dc92e94b",
                                                "text": "So leicht lässt er sich nicht täuschen, er hat den Trick sofort überzogen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
