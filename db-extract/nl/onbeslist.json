                                            {
                                                "example_id": "1de53c2f-3c4a-4696-a625-7f00642371fe",
                                                "sense_id": "8e4babc1-c476-3aaa-ab8a-fd93e8d13cd3",
                                                "text": "Seiner Meinung nach trägt die Polizei durch ihr zögerliches Eingreifen eine Mitschuld."
                                            }
