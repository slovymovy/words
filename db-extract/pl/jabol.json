                ],
                "senses": [
                    {
                        "sense_id": "3d925293-f2d8-302e-a809-ee4a95b2a0ea",
                        "entry_id": "1126476a-5a96-3f78-a1bd-0c81b150a7a6",
                        "glosses": [
                            "tanie, bardzo niskiej jakości wino owocowe, zwykle wytwarzane z jabłek"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "282aba77-7585-4a03-b0cd-ce17b015c336",
                                "sense_id": "3d925293-f2d8-302e-a809-ee4a95b2a0ea",
                                "text": "Złożyliśmy się na jabola i obaliliśmy go w parku."
                            },
                            {
                                "example_id": "43dc8c26-d853-4481-b891-7eb579cf5d4b",
                                "sense_id": "3d925293-f2d8-302e-a809-ee4a95b2a0ea",
                                "text": "Jabol, bo tak powszechnie nazywano wino produkowane ze sfermentowanych jabłek i spirytusu z ziemniaków, był ulubionym napojem całych rzesz pijaków. Jego niewątpliwą i najważniejszą zaletę stanowiła niska cena, bo o walorach smakowych lepiej było nie mówić. Litrowa butelka kosztowała nieco mniej niż dwa piwa poznańskie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
