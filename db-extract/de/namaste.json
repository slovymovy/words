                        ]
                    },
                    {
                        "translation_id": "000db928-a891-40ce-9176-0c35194f613d",
                        "source_entry_id": "4ed6f537-0486-3250-b03c-5a7425259c54",
                        "source_sense_id": "81fbe510-4054-3c79-aa6d-a623f5c48f04",
                        "source_sense_description": "überwiegend in Indien verbreitete Grußformel",
                        "target_lang_word": "namasté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namasté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57bdd7d7-7517-373d-ba80-11281b1747bc",
                                        "entry_id": "80ce0b79-a979-33b1-86c2-9229b263ca80",
                                        "glosses": [
                                            "Parole de salutation traditionnelle en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82f22ca-67c6-4f12-93aa-8f5cdd46f4eb",
                                                "sense_id": "57bdd7d7-7517-373d-ba80-11281b1747bc",
                                                "text": "On crie « Namasté ! » Répond, au loin, « Namasté », qui balaie un jardin minuscule de ramures de saule ou épouille un enfant. « Namasté », qui récolte précieusement diverses défécations dans une clisse de bois pâle."
                                            },
                                            {
                                                "example_id": "e6e8c0fa-1c93-4447-88c1-13a976260141",
                                                "sense_id": "57bdd7d7-7517-373d-ba80-11281b1747bc",
                                                "text": "« Acceptez de moi cette nourriture comme une salutation envers Vous. Namasté ! » J'entonne pour être à l'unisson : « Namasté ! » La vache est très digne et mange rapidement tout ce que nous lui offrons."
                                            },
                                            {
                                                "example_id": "c6703456-adda-44ba-a0ad-3acf30596de5",
                                                "sense_id": "57bdd7d7-7517-373d-ba80-11281b1747bc",
                                                "text": "Namasté ne veut pas dire merci."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "namasté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb139a05-48e0-3ad9-8517-0550b67967cc",
                                        "entry_id": "9545922f-8235-328c-adc3-4f84de148f3d",
                                        "glosses": [
                                            "Geste de salutation traditionnel en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854ca7ce-5a17-43f4-911b-302733efb9d5",
                                                "sense_id": "cb139a05-48e0-3ad9-8517-0550b67967cc",
                                                "text": "Le « namasté » s'exécute avec les mains jointes à plat au-dessus de la tête, pour saluer Dieu, avec les mains devant le visage, on salue le guide spirituel ou Guru et avec les mains devant la poitrine, on salue ses semblables."
                                            },
                                            {
                                                "example_id": "3bb94b4a-6a34-400b-ac90-0a8c99ad17bc",
                                                "sense_id": "cb139a05-48e0-3ad9-8517-0550b67967cc",
                                                "text": "Mon père dit que pour renaître heureux et dans la bonne caste, il faut être un bon fils, un bon mari, un bon dévot. Il a été tout cela, mon vieux père et, désormais, il attend sa mort et sa renaissance dans une caste où on lui fera des namastés en se courbant bien bas."
                                            },
                                            {
                                                "example_id": "50478133-e19e-4b79-8d51-288dbecb10ea",
                                                "sense_id": "cb139a05-48e0-3ad9-8517-0550b67967cc",
                                                "text": "Qui ne se souvient des onze heures où arrivait Jaglall, ascétique, asiatique et pervers, qui ayant fait ses namastés, s'en allait posément, de pierre en pierre, jusqu'à la pointe des roches sous nos regards nonchalants et sceptiques ?"
                                            },
                                            {
                                                "example_id": "98e60914-8c87-4d0c-939f-08bfbfd52f28",
                                                "sense_id": "cb139a05-48e0-3ad9-8517-0550b67967cc",
                                                "text": "[…] ou l'obséquieux valet personnel en kurta tabac qui semblait glisser sur des vérins hydrauliques et se courbait en de respectueux namastés dès qu'il le croisait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
