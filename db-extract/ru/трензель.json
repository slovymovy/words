                        ],
                        "form": "тре́нзеле"
                    },
                    {
                        "form_id": "4257c0e0-a83d-4674-860d-40f77e485ed1",
                        "entry_id": "7ab32322-8e79-3018-ab45-f7ffbce5e8d3",
                        "tags": [
                            "plural",
