                        "source_sense_id": "bfa91a6e-49e7-38e6-a6e5-8d365a2ac11d",
                        "target_lang_word": "pianistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
