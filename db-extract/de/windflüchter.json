                ],
                "senses": [
                    {
                        "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                        "entry_id": "974bd20c-e925-3e2f-a738-79a9e6d4cd73",
                        "glosses": [
                            "Baum, dessen Wuchs durch den überwiegend aus einer Himmelsrichtung wehenden Wind beeinflusst wird und sich deshalb im Laufe der Zeit einseitig verformt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30a3bda4-df9b-479b-bd27-58fb37f179ab",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "An den Küsten kann man am häufigsten Windflüchter sehen, weil dort beständig der Wind aus einer Richtung weht."
                            },
                            {
                                "example_id": "1bd5b621-ff78-4ea5-b420-26737f24731f",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Die Landschaft des Darßes ist herb und verschlossen. Aus Himmel, Land und Meer, aus Wind, Wellen und Licht fügt sie sich zu jenem eigenartigen Reiz, den die Windflüchter am Weststrand, die geduckten, strohbedachten Häuser, das kaum wahrnehmbare Übergehen des Himmels in das Meer am Horizont und der sich nach oben öffnende Raum des Waldes bestimmen.“"
                            },
                            {
                                "example_id": "9710580c-9c40-4f5e-85ab-1017d6059b0d",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Immer wieder stürzen direkt am Meer unterspülte Bäume um, die durch den ständigen Wind zum Teil bizarre Formen angenommen haben. Man nennt sie ‚Windflüchter‘.“"
                            },
                            {
                                "example_id": "eefc9cdf-9cfb-4dbb-8520-37f26a6b37e9",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Hier sahen wir auch die ersten ‚Windflüchter‘, d. h. tief gebeugte und bizarr geformte Bäume, denen der Sturm die seeseitigen Äste und Blätter genommen hat.“"
                            },
                            {
                                "example_id": "904fe0b8-3682-4d3c-9ee4-4d85129eb9f7",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Nur der Wind bläst fast immer, zur Freude der Surfer und Drachenliebhaber, und formt bizarr gebogene Bäume, sogenannte ‚Windflüchter‘.“"
                            },
                            {
                                "example_id": "793b234a-096c-4adc-8b8b-a932bf85ffb5",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Aus dem Wald tretend, werden wir wieder in Blau getaucht und sind fasziniert von den Windflüchtern, die typisch sind für diese Küstenlandschaft.“"
                            },
                            {
                                "example_id": "045a18f3-2141-4be0-924d-e801297e8d74",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Gleich am ersten Tag musste ich mir Begriffe erklären lassen, die hier zum Grundwortschatz gehören, aber einem im Süden so gut wie nie begegnen: Bodden, Windflüchter, Buhnen.“"
                            },
                            {
                                "example_id": "15fa543e-b983-4e1b-a02f-52593a6c1842",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Da drauf stehen Bäume, Windflüchter, die typisch für diesen Strand sind.“"
                            },
                            {
                                "example_id": "6c17924b-1990-4b17-bded-1e17fb995d7f",
                                "sense_id": "bb705e8e-ce91-348d-955e-3df2a5bb0330",
                                "text": "„Berühmt sind die Windflüchter am Darßer Westrand, das sind die wegen der vorherrschenden Weststürme einseitig wachsenden Buchen, die allerdings heute fast alle der Uferabrasion zum Opfer gefallen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
