                    },
                    {
                        "form_id": "5becf758-6014-4d6d-b4d7-5f1be57fec54",
                        "entry_id": "738a4763-78bf-3897-8ba1-310e2f86db26",
                        "tags": [
                            "masculine"
                        ],
                        "form": "fugueur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab3912dc-bf7f-372a-b75c-34c414c99c43",
                        "entry_id": "738a4763-78bf-3897-8ba1-310e2f86db26",
                        "glosses": [
                            "Personne qui a tendance à fuguer, en particulier en parlant d’une enfant ou d’une adolescente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a366cf1a-500f-49a6-8eeb-e4a156584d66",
                                "sense_id": "ab3912dc-bf7f-372a-b75c-34c414c99c43",
                                "text": "En réalité, la fugueuse s’était réfugiée à Paris, chez son oncle Prosper Malbranche, chef de rayon à la Place Clichy (grand magasin)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5651bb5-e430-34e4-8a56-52059d88c05e",
                        "entry_id": "738a4763-78bf-3897-8ba1-310e2f86db26",
                        "glosses": [
                            "Coureuse qui s’est échappée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb00e53-fc62-4d6b-b301-ea83e134c3bc",
                                "sense_id": "c5651bb5-e430-34e4-8a56-52059d88c05e",
                                "text": "Dernière rescapée des quatorze fugueuses dont faisait partie la Costarmoricaine Audrey Cordon Ragot, la Morbihannaise Marie Le Net a été reprise dans la descente vers Rosheim à 4 km de l'arrivée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe90fe1-b3d3-4e29-9319-7fcd85288cc8",
                        "source_entry_id": "738a4763-78bf-3897-8ba1-310e2f86db26",
                        "target_lang_word": "runaway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "runaway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3303a77f-93fa-3745-8412-74304f923be4",
                                        "entry_id": "d425949e-a11b-3e1c-86e5-11820c35d757",
                                        "glosses": [
                                            "A person or animal that runs away or has run away; a person, animal, or organization that escapes captivity or restrictions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec090db7-aead-4782-9a73-7f6af65fcdc9",
                                                "sense_id": "3303a77f-93fa-3745-8412-74304f923be4",
                                                "text": "Runaways are vulnerable to criminal exploitation."
                                            },
                                            {
                                                "example_id": "b2ffa4ae-64d5-4c27-8343-fe0d6ef61ace",
                                                "sense_id": "3303a77f-93fa-3745-8412-74304f923be4",
                                                "text": "Thou runaway, thou coward, art thou fled?"
                                            },
                                            {
                                                "example_id": "c47c8b36-5162-4dfa-8ec0-2d6206181a10",
                                                "sense_id": "3303a77f-93fa-3745-8412-74304f923be4",
                                                "text": "If any man of his owne heade and without leaue, walke out of his precint and boundes, taken without the princes letters, he is broughte againe for a fugitiue or a runaway with great shame and rebuke, and is sharpely punished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                        "entry_id": "d425949e-a11b-3e1c-86e5-11820c35d757",
                                        "glosses": [
                                            "A vehicle (especially, a train) that is out of control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95fc5de-b808-4c44-9985-0d80f9d6db7e",
                                                "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                                "text": "Just south of Wamphray Station, they overtook the runaway. The dim figure of Mitchell could be seen sitting huddled behind the stormboard. They shouted and whistled. He paid no attention."
                                            },
                                            {
                                                "example_id": "33a1bc53-ed89-497a-976a-1da5ea3bedb3",
                                                "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                                "text": "On New Year's Day, 1850, a catastrophe, which it is fearful to contemplate, was averted by the aid of the telegraph. A collision had occurred to an empty train at Gravesend; and the driver having leaped from his engine, the latter started alone at full speed to London. Notice was immediately given by telegraph to London and other stations; and while the line was kept clear, an engine and other arrangements were prepared as a buttress to receive the runaway."
                                            },
                                            {
                                                "example_id": "dc9c3a79-d168-4c4f-8041-459c1ad36725",
                                                "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                                "text": "Runaways are rendered impossible, as the machine can be instantly stopped by means of a double brake connected with the driver's seat"
                                            },
                                            {
                                                "example_id": "eb1de3a6-18cf-4f8e-b0a6-45d9940e40c4",
                                                "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                                "text": "We hear many ideas advanced as to the cause of engines running away, more especially in electric stations, while the wonder is that the runaways are so few."
                                            },
                                            {
                                                "example_id": "8a49cca6-6168-47ea-867f-1b90334f2430",
                                                "sense_id": "c2a09098-01a1-3e28-9a82-d54e7d3fa45f",
                                                "text": "The former Midland main lines out of Bristol were blocked for more than 18hr after a freight train runaway soon after midnight on February 7. \"Jubilee\" No. 45615 on the 4.20 p.m. Burton-Bristol freight, which conveyed a quantity of beer, lost control of its train on the 1 in 67 Fishponds incline and ran into the rear of empty stock [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94a4a989-5c39-363a-b0f7-42ef160957d8",
                                        "entry_id": "d425949e-a11b-3e1c-86e5-11820c35d757",
                                        "glosses": [
                                            "An object or process that is out of control or out of equilibrium."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb90da15-c498-4029-9dfd-3568f5d8b255",
                                                "sense_id": "94a4a989-5c39-363a-b0f7-42ef160957d8",
                                                "text": "On the chart, the start of a runaway is marked by a box"
                                            },
                                            {
                                                "example_id": "11c0453f-be29-4e6d-90d9-30b2cad1eed5",
                                                "sense_id": "94a4a989-5c39-363a-b0f7-42ef160957d8",
                                                "text": "An IS executive's worst nightmare, such runaways are a fact of life. Practically all large companies and organizations have experienced a runaway or are wrestling with a seriously botched project."
                                            },
                                            {
                                                "example_id": "87b10f27-c592-40d2-9f73-05e2e4aacd40",
                                                "sense_id": "94a4a989-5c39-363a-b0f7-42ef160957d8",
                                                "text": "The standard X-ray binary Cyg Xl, with a massive BH candidate, is a runaway, This could suggest that a SN explosion occurred. Cluster ejection to make a runaway can not be excluded although in the case of Cyg Xl, the progenitor runaway must have been a binary"
                                            },
                                            {
                                                "example_id": "6f1b3dc4-91b1-4698-91db-9ec4de46703e",
                                                "sense_id": "94a4a989-5c39-363a-b0f7-42ef160957d8",
                                                "text": "Where practicable, this passive measure reduces the consequences of a runaway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a171a746-41f8-3be5-8f2a-c70fd7fc97ab",
                                        "entry_id": "d425949e-a11b-3e1c-86e5-11820c35d757",
                                        "glosses": [
                                            "The act of running away, especially of a horse or teams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37dd462-4fb3-4f38-9aa3-7cd75e3beb7b",
                                                "sense_id": "a171a746-41f8-3be5-8f2a-c70fd7fc97ab",
                                                "text": "The drivers were generally boys […] They would stop the team when other boats passed and at locks while waiting for the water to rise or fall. They could also be useful in preventing or stopping runaways. Horses were easily startled and might bolt off the tow path or into the canal itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adeb0ef1-78e2-34e4-ab16-dcc7f85e4eb4",
                                        "entry_id": "d425949e-a11b-3e1c-86e5-11820c35d757",
                                        "glosses": [
                                            "An overwhelming victory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585b4a28-f015-4b6f-a56e-8d5afc34482b",
                                                "sense_id": "adeb0ef1-78e2-34e4-ab16-dcc7f85e4eb4",
                                                "text": "The home side won in a runaway."
                                            }
                                        ]
                                    }
                                ]
                            },
