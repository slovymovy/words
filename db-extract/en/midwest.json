                            "without 'the'"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb924e6-d8d5-4e76-ae1c-50e53d10c5fc",
                        "source_entry_id": "489ff8e4-ca42-3fc7-9a80-0f2acf7a64ae",
