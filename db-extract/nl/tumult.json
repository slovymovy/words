                                    {
                                        "sense_id": "d677ffbd-a280-3210-a5aa-c815cd6047a2",
                                        "entry_id": "ebf32cb4-1abd-3f21-a253-c7bb74a0994c",
                                        "glosses": [
                                            "A loud protest, controversy, or outrage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2986cac-35ad-41f4-9704-6c4ee1663bff",
                                                "sense_id": "d677ffbd-a280-3210-a5aa-c815cd6047a2",
                                                "text": "This highly-aggressive approach had results, but briefly caused a major uproar in parts of the United States, which was mitigated by the Webster–Ashburton Treaty in 1842, which formalised the U.S. Navy's contribution to the antislavery efforts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uproar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7473b95-cbc8-3cd0-87a8-92cd6e23c67c",
                                        "entry_id": "863b5779-1f87-325a-a180-90e281c37da9",
                                        "glosses": [
                                            "To throw into uproar or confusion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c6d92b-525b-41e2-8879-959bcc85cf57",
                                                "sense_id": "a7473b95-cbc8-3cd0-87a8-92cd6e23c67c",
                                                "text": "[…] had I power, I should\nPour the sweet milk of concord into hell,\nUproar the universal peace, confound\nAll unity on earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                        "entry_id": "863b5779-1f87-325a-a180-90e281c37da9",
                                        "glosses": [
                                            "To make an uproar."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf0b9bfa-fabb-441d-82bf-55ae79f01d5d",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "[…] through their Tumultuous Uproaring have they caused the peaceable and harmless to suffer […]"
                                            },
                                            {
                                                "example_id": "b92aa29d-11b9-4a25-a0b9-ec1e9af0b468",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "[…] the landlady entering at this very time with news that his wife had been delivered of a dead child, he yielded to the most furious ebullitions; while, in accordance with him, all howled and shrieked, and bellowed and uproared, with double vigor."
                                            },
                                            {
                                                "example_id": "4ec39246-3b6e-4edd-a485-c17805d590cf",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "When red-mouth’d cannons to the clouds uproar,\nAnd gasping hosts sleep shrouded in their gore,"
                                            },
                                            {
                                                "example_id": "bf958830-fa46-4dca-a792-bef263864250",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "Officers, as well as men, now mingle in the uproaring strife, and snatching the weapons of the slain, swell the horrid carnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78da7e1d-f607-4c71-bcd1-437bd2fa75c5",
                        "source_entry_id": "b4e90740-13c3-35d4-83da-1fdbc69a44f0",
                        "source_sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                        "target_lang_word": "turmoil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turmoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                        "entry_id": "53203a96-1a21-3529-bc12-87fad885b379",
                                        "glosses": [
                                            "A state of great disorder or uncertainty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a227c4d-ddbe-484b-9919-f270ce0498f3",
                                                "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                                "text": "Oleg Blokhin's side lost the talismanic Andriy Shevchenko to the substitutes' bench because of a knee injury but still showed enough to put England through real turmoil in spells."
                                            },
                                            {
                                                "example_id": "e27292ea-6663-4205-b7fe-30708f120e61",
                                                "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                                "text": "The Taoists developed their philosophy during an extended era of turmoil known as the Warring States period of Chinese history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                        "entry_id": "53203a96-1a21-3529-bc12-87fad885b379",
                                        "glosses": [
                                            "Harassing labor; trouble; disturbance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7daf3cc3-8ce4-47c1-91fa-50d8483d76cf",
                                                "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                                "text": "And there I'll rest, as after much turmoil, / A blessed soul doth in Elysium."
                                            },
                                            {
                                                "example_id": "f686e38a-b5e0-466b-920c-666fcd6ef91a",
                                                "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turmoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20d5ddc4-8db9-3068-86e9-4d854ae67b7f",
                                        "entry_id": "c9accff3-71ca-3546-8bc8-6e5e26ac78c2",
                                        "glosses": [
                                            "To be disquieted or confused; to be in commotion."
