                                "sense_id": "7edfc0f2-c6ba-3569-8220-e2adc6f39b7e",
                                "text": "Hij is op een persoonlijke kruistocht tegen corruptie.",
                                "translation": "He is on a personal crusade against corruption.",
                                "english": "He is on a personal crusade against corruption."
                            }
                        ]
