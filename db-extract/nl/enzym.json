                        "sense_id": "8a2ed62f-bb9a-3bdc-b92a-5ebe086b4881",
                        "entry_id": "256d679f-96d1-3310-a8cc-50f26869766d",
                        "glosses": [
                            "een organisch molecuul dat biologische reacties mogelijk maakt of versnelt zonder daarbij zelf verbruikt te worden of van samenstelling te veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3256a67d-1389-4289-92d4-91d6fc19128c",
                                "sense_id": "8a2ed62f-bb9a-3bdc-b92a-5ebe086b4881",
                                "text": "In feite zijn enzymen biologische katalysatoren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c78bac0d-8e55-4b50-8583-6a22f294ee95",
                        "source_entry_id": "256d679f-96d1-3310-a8cc-50f26869766d",
                        "source_sense_id": "8a2ed62f-bb9a-3bdc-b92a-5ebe086b4881",
                        "source_sense_description": "een organische molecuul dat biologische reacties mogelijk maakt of versnelt zonder daarbij zelf...",
                        "target_lang_word": "Enzym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enzym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                        "entry_id": "f2db8abd-3814-3fc6-a789-433cde82ddeb",
                                        "glosses": [
                                            "ein Protein, das als Katalysator fungiert, also chemische Reaktionen beschleunigt oder überhaupt erst ermöglicht"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c07065a-d119-48e4-85a3-3978d67c83eb",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "Das Enzym Pepsin ist für die Spaltung von mit der Nahrung aufgenommenen Eiweißen verantwortlich."
                                            },
                                            {
                                                "example_id": "c38256fe-6a7d-415e-99af-4af74c61e484",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Hofmeister, obwohl im kleinen Kreis kommunikativ und lieberal im Labor … suchte eher die Einsamkeit und betrachtete die menschliche Gesellschaft skeptisch ja verachtend, nur selten ließ er sich auf Tagungen blicken. So wird sein wissenschaftlicher Beitrag eher unterschätzt, und es ist wohl nicht verfehlt, hier hervorzuheben, daß Hofmeister der erste war, der – im Gegensatz zu Fischer Proteine als verschiedenartige, chemisch genau definierte Substanzen betrachtete und ihre entscheidende Funktion als Enzyme wenigstens ahnte. So prophezeite er, daß alle biochemischen Reaktionen der Zelle durch jeweils für sie spezifische Enzyme kontrolliert würden. “"
                                            },
                                            {
                                                "example_id": "23817135-eb6e-4829-b3c3-cc7431f5d16f",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "89674ab4-82ec-430b-a89a-6e2918e3775d",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Mein Vater extrahierte Enzyme aus Pflanzen, und meine Mutter vergiftete Frösche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
