                "senses": [
                    {
                        "sense_id": "1f64a4ef-40f6-3554-b2b5-9cf1ca9f35e3",
                        "entry_id": "b8d7083d-d0dc-32ff-8a88-79d4fd0a4885",
                        "glosses": [
                            "illegale Beeinflussung von Zinssätzen (um dadurch finanzielle Vorteile zu erreichen); besonders im Zusammenhang mit dem Libor-Skandal, bei dem Banken der Meldestelle falsche Auskünfte erteilten, um die Zinsbildung zu beeinflussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba487878-66fe-47e5-b7ca-12ae7dfc707c",
                                "sense_id": "1f64a4ef-40f6-3554-b2b5-9cf1ca9f35e3",
                                "text": "„Dann geriet er im Zuge des Libor-Zinsskandals ins Visier der Ermittler, 2015 wurde er zusammen mit anderen Bankern wegen Zinsmanipulation angeklagt.“"
                            },
                            {
                                "example_id": "5d0ca7d1-ce30-4248-844b-65a7210b87e3",
                                "sense_id": "1f64a4ef-40f6-3554-b2b5-9cf1ca9f35e3",
                                "text": "„Bei dieser seit Januar 2016 laufenden Untersuchung ging es um eine heikle Frage: War Achleitner mitverantwortlich dafür, dass die Bank rund 100 Millionen Pfund mehr an die britische Finanzaufsicht zahlen musste als ursprünglich avisiert, weil sie bei der Aufklärung der Zinsmanipulation nicht gut kooperiert hatte?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
