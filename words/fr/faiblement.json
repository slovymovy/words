                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bougie allumée dans le coin de la pièce éclairait <w>faiblement</w> le couloir obscur."
                        },
                        {
                            "text": "Dans le silence de la nuit, une cloche lointaine résonnait encore <w>faiblement</w>."
                        }
                    ],
                    "synonyms": [
