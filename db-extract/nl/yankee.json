                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yankee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7afb7da5-3f6a-3091-87b3-dbb93e519b04",
                                        "entry_id": "15f8ad49-56bf-3b96-9b88-d6a9f758bd25",
                                        "glosses": [
                                            "Staatsbürger der USA"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "086dbcd4-e49a-43f1-bfbe-0249a588dcf0",
                                                "sense_id": "7afb7da5-3f6a-3091-87b3-dbb93e519b04",
                                                "text": "Revanche für Maduros \"Yankees go home!\" … Kelly Keiderling und weitere US-Diplomaten sollten Venezuela binnen 48 Stunden verlassen."
                                            },
                                            {
                                                "example_id": "81c65447-83f4-4436-b8f6-7d20d9cff117",
                                                "sense_id": "7afb7da5-3f6a-3091-87b3-dbb93e519b04",
                                                "text": "Lyndon Johnson, mächtiger Senator aus Texas, wurde 1960 als \"Running mate\" John F. Kennedys zum Schlüssel des Sieges eines klassischen \"Yankees\"."
                                            },
                                            {
                                                "example_id": "7f57c524-1fbe-4eaf-b035-242378513840",
                                                "sense_id": "7afb7da5-3f6a-3091-87b3-dbb93e519b04",
                                                "text": "In Miami ließen sie sich nieder, wo Yankees wenig und die Kubaner viel zu sagen haben."
                                            },
                                            {
                                                "example_id": "e8bdcda5-a130-4137-9a85-db1befa42e68",
                                                "sense_id": "7afb7da5-3f6a-3091-87b3-dbb93e519b04",
                                                "text": "„War es einem solchen Menschen nicht natürlich, ihn in der Stille aus dem Wege zu räumen, und ließ es sich erwarten, daß der von bitterem Hasse gegen die Weißen beseelte Indianer, der ihn noch dazu für einen Yankee halten mußte, zu seinen Gunsten Einsprache tun würde?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Yankee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                        "entry_id": "2c29ee7a-df4b-3785-8693-0c29ea20283f",
                                        "glosses": [
                                            "Staatsbürgerin der USA"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f29834c-e3e2-456e-a157-9b66877ebb9e",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„›Warum sollte sie das tun?‹ ›Weil sie eine Yankee ist – eine Yankee aus Maine, und das sind die schlimmsten.‹“"
                                            },
                                            {
                                                "example_id": "baa5be2a-17a1-43b4-bc86-ba3c46c0caf1",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„›Du bist eine Yankee‹, sagt Blondie. Ironisch, denn er hat nicht viel vom südlichen Schneid in der Stimme. Diese eiskalten Augen wandern über ihren ganzen Körper. ›Eine ziemlich freche Yankee.‹ Miriam massiert sich die Schläfen.“"
                                            },
                                            {
                                                "example_id": "564d7562-1be0-418e-9efe-7c451e7c1c29",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„›Eine Yankee!‹, kreischte Tante Lulu. ›Mich laust der Affe, eine Yankee!‹ ›Nur zur Hälfte‹, erklärte Tucker hastig. ›Sie ist Miss Ediths Enkelin.‹“"
                                            },
                                            {
                                                "example_id": "fae5a80f-f825-4562-ad95-4f7cb0922294",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„‚Ich habe immer geglaubt, Jerome Bonaparte, nicht Joseph, habe eine Yankee geheirathet,‘ sagte Lord Middlemore, ein dummes Gesicht dazu machend.“"
                                            },
                                            {
                                                "example_id": "3b81ab50-1134-43f7-bad2-4999c9afabe7",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„Sie sprechen wie eine Yankee, nicht wie eine Britin.“"
                                            },
                                            {
                                                "example_id": "7810a7a6-1415-4ef9-a024-e63dd13025a8",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„Eine Yankee, unerschrocken und dickköpfig und dumm, dachte er mit einer Verachtung, in der ein Anflug von Bewunderung mitschwang.“"
                                            },
                                            {
                                                "example_id": "d3718103-bd22-469c-8858-b1f3ab3d52d1",
                                                "sense_id": "668abe70-65a6-335c-8f0c-49046a789f1b",
                                                "text": "„›Bist du eine Yankee?‹ ›Nicht von Geburt. Aber ich bin oft drüben.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
