                                        "sense_id": "c7d8124f-6534-36b9-bf6f-499af8624b8c",
                                        "entry_id": "58f0a886-3216-3381-8158-9b15cc5dc35d",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
