                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f40d2fb-ae8b-36c0-9432-734a621c0566",
                        "entry_id": "18f022d3-125b-3271-a3a6-9f7df05bdac2",
                        "glosses": [
                            "volgens een bepaalde richting van het christendom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c42a38-f3d2-4847-bfe6-52ac8c735176",
                                "sense_id": "0f40d2fb-ae8b-36c0-9432-734a621c0566",
                                "text": "Zo kwam ik bij de vraag: geloof ik in God? Hoewel ik protestant ben opgevoed en mijn hele leven als religieuze pelgrim op zoek naar God van kerk naar kerk zwierf ben ik nooit een grote fan van predikanten geweest."
                            }
                        ]
                    }
                ],
