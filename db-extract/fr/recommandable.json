                "entry_id": "b31c340d-9430-3ee2-b34c-e8e1d6d9f56f",
                "word": "recommandable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2019354a-703c-4405-b8f9-f2b3f5ba6a15",
                        "entry_id": "b31c340d-9430-3ee2-b34c-e8e1d6d9f56f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "recommandables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                        "entry_id": "b31c340d-9430-3ee2-b34c-e8e1d6d9f56f",
                        "glosses": [
                            "Qui est estimable ; qui mérite d’être considéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de09cb7b-b472-489d-86d3-2d0a12453121",
                                "sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                                "text": "Celui-ci pensa qu’un homme aussi recommandable devait faire l’ornement de sa cour, et il lui lit demander s’il y accepterait volontiers un emploi."
                            },
                            {
                                "example_id": "035c0e51-a4d8-47bd-a1e4-3dbbe58fc711",
                                "sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                                "text": "Je m'explique : tout croisement a pour objet de transformer une race imparfaite en une autre plus recommandable qu'elle , ou de créer une sous-race , participant en proportions diverses aux qualités de celles qui ont concouru à sa formation."
                            },
                            {
                                "example_id": "b5a1df6e-b4b2-4785-b7d0-657ffebec3da",
                                "sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l'engraissement. Il est aussi le plus répandu."
                            },
                            {
                                "example_id": "f394bbde-7d82-44a5-9e7c-bc1bee230857",
                                "sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                                "text": "David Harbour, connu pour son rôle dans Stranger Night, incarne un père Noël pas très recommandable dans cette comédie aussi sombre que brutale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a217ade9-6b60-4af2-a006-65e64b2ceb80",
                        "source_entry_id": "b31c340d-9430-3ee2-b34c-e8e1d6d9f56f",
                        "source_sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                        "target_lang_word": "empfehlenswert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empfehlenswert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b09994c-efc8-353a-aaf0-41ae05691498",
                                        "entry_id": "2b823161-75b7-3bb4-bfa8-6c0ce8f7c122",
                                        "glosses": [
                                            "jemand/etwas ist nötig, erforderlich/wird gebraucht; optimal zum weiterempfehlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4284418b-1060-4b20-b50a-00120c156d70",
                                                "sense_id": "5b09994c-efc8-353a-aaf0-41ae05691498",
                                                "text": "Regenjacke und Gummistiefel sind bei Regen empfehlenswert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "204d823d-55d8-4e0a-bd56-01aab689f6a4",
                        "source_entry_id": "b31c340d-9430-3ee2-b34c-e8e1d6d9f56f",
                        "source_sense_id": "d580b43c-b93a-3a5d-b742-2092c5b4af31",
                        "target_lang_word": "ratsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                        "entry_id": "213c138a-f540-3cb3-9a39-6d5dac39530b",
                                        "glosses": [
                                            "einem Ratschlag oder der eigenen Einsicht entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11898ea4-a06c-4684-bcdd-d8817caf9646",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Es ist ratsam, sich auf eine Prüfung gut vorzubereiten."
                                            },
                                            {
                                                "example_id": "cbdb7056-98dd-4006-a06c-9c2a8af6e1a7",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Frühes Reservieren ist ratsam, denn beliebte Ziele sind schnell ausgebucht."
                                            },
                                            {
                                                "example_id": "c1d4bfe4-09ec-408e-a480-438cc4c51cc4",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Die meisten Unternehmen haben spezielle Onlineportale für Bewerbungen. Es ist aber ratsam, schon vor der Bewerbung um die erste Stelle über ein Praktikum Kontakte zu knüpfen."
                                            },
                                            {
                                                "example_id": "1c6ac9ee-d905-4113-9d4a-3d8c6efe6211",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "\"Der Punkt, dass du bekannt bist, als \"derjenige, der so ist\", unabhängig vom Beruf, halte ich für keinen ratsamen Weg\", sagte Tommasi."
                                            },
                                            {
                                                "example_id": "184419e5-340a-41e9-962a-a109c52d406d",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Niedrige Zinsen, die Gefahr steigender Preise und dann noch Weihnachten: Geld auszugeben erscheint vielen Menschen derzeit ratsamer, als es anzulegen."
                                            },
                                            {
                                                "example_id": "b46e53e1-b2bf-41ea-b781-fc820463fd3b",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "„Der besiegte Großmogul bot den Briten nun erneut die «Diwani» von Bengalen an, und Clive übernahm sie schließlich im Namen der Ostindiengesellschaft, da Pitt weiterhin eine Übernahme durch die Krone für nicht ratsam hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
