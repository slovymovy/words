                                        "sense_id": "769565b2-24b4-34d3-84a6-bfb72fc21744",
                                        "entry_id": "2d1248d1-2056-340d-9728-0ba7d2cdd7ee",
                                        "glosses": [
                                            "The sewing of the edges of single leaves in sections by overcasting the thread."
                                        ],
