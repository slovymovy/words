                ],
                "translations": [
                    {
                        "translation_id": "8f993145-c880-4735-80e4-62c51cfa630a",
                        "source_entry_id": "e1d94565-e0a0-3607-b93b-802c47325dab",
                        "source_sense_id": "a9526aeb-d52b-3eb8-8c90-d7e4224262cc",
                        "source_sense_description": "in de klassieke zeilvaart de onderste, grootste zeil aan de grote mast",
                        "target_lang_word": "Großsegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großsegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34b602ee-f6e0-3392-a1c0-02ee10e68cf1",
                                        "entry_id": "ad73caac-5b5d-3246-8365-7c23d8ef8f10",
                                        "glosses": [
                                            "Segeltyp, der als eine Weiterentwicklung des Lateinersegels und eine vereinfachte Gaffelbesegelung angesehen werden kann"
                                        ],
                                        "tags": [
                                            "Segeln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71928660-b017-41bd-93b2-290f1cbc0d93",
                                                "sense_id": "34b602ee-f6e0-3392-a1c0-02ee10e68cf1",
                                                "text": "Vor dem Wind muss man das Großsegel auffieren für maximale Geschwindigkeit."
                                            },
                                            {
                                                "example_id": "af7389c0-9417-4f08-b151-772c7a23b65d",
                                                "sense_id": "34b602ee-f6e0-3392-a1c0-02ee10e68cf1",
                                                "text": "In aller Eile galt es, die beiden Vorsegel zu bergen und vor der Wut des Sturmes zu bewahren. Für das Großsegel kam jede Rettung zu spät; es hing bereits zerfetzt in den Wanten."
                                            },
                                            {
                                                "example_id": "9964981a-42cc-4214-b524-c7da89462457",
                                                "sense_id": "34b602ee-f6e0-3392-a1c0-02ee10e68cf1",
                                                "text": "Das Geld wurde im ganzen Land und bei vielen Sponsoren zusammengesammelt: Toyota, Telecom New Zealand und Lotto sind darunter. Dichtgedrängt stehen ihre Namen auf dem Großsegel und der Yacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c41a7ecc-541f-401b-b7cb-927bb7681e14",
                        "source_entry_id": "e1d94565-e0a0-3607-b93b-802c47325dab",
                        "source_sense_id": "a9526aeb-d52b-3eb8-8c90-d7e4224262cc",
                        "source_sense_description": "in de klassieke zeilvaart de onderste, grootste zeil aan de grote mast",
                        "target_lang_word": "Hauptsegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "83dd09e9-69b4-4f48-9118-10e0ce9982db",
                        "source_entry_id": "e1d94565-e0a0-3607-b93b-802c47325dab",
                        "source_sense_id": "a9526aeb-d52b-3eb8-8c90-d7e4224262cc",
                        "source_sense_description": "in de klassieke zeilvaart de onderste, grootste zeil aan de grote mast",
                        "target_lang_word": "mainsail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mainsail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50682e85-b2ec-3fb9-bc44-18062586497b",
                                        "entry_id": "87c0565a-66c7-38b1-84c5-98af3ea8f647",
                                        "glosses": [
                                            "The largest (or only) sail on a sailing vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3647015-8f2a-4453-bd6d-f7df3055c999",
                                                "sense_id": "50682e85-b2ec-3fb9-bc44-18062586497b",
                                                "text": "The mainsail was \"scandalised\" - a nautical mode of describing a sail reefed at both ends[.]"
                                            },
                                            {
                                                "example_id": "3fd585bb-cd87-490d-8812-3cf494e27a91",
                                                "sense_id": "50682e85-b2ec-3fb9-bc44-18062586497b",
                                                "text": "Now stow the mainsail as follows, preferably with the sail still lying in the starboard cockpit: beginning at the head, fold the upper section so that the upper two battens are aligned together; then tightly roll the sail from the head down to the foot. Reinsert the sail into its bag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a6c5eb6-dfc1-42da-a91c-a86e60ba8321",
                        "source_entry_id": "e1d94565-e0a0-3607-b93b-802c47325dab",
                        "source_sense_id": "a9526aeb-d52b-3eb8-8c90-d7e4224262cc",
                        "source_sense_description": "in de klassieke zeilvaart de onderste, grootste zeil aan de grote mast",
                        "target_lang_word": "main course",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
