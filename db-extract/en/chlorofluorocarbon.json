                ],
                "senses": [
                    {
                        "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                        "entry_id": "6a65cd30-0b59-3db4-a110-6afe3ac74657",
                        "glosses": [
                            "Any of a class of organic compounds in which the hydrogen atoms of a hydrocarbon are replaced with those of chlorine and fluorine; formerly used as refrigerants and aerosol can propellants but withdrawn due to causing damage to the ozone layer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f539c74f-b757-4fe4-9d1f-c5f9aa9da03c",
                                "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                                "text": "The proposed replacement for CFC-11, a chlorofluorocarbon used to make plastic foam and in central air-conditioning systems, is a compound called HCFC-22. This is a chlorofluorocarbon already in use in home air-conditioners, but it is more expensive than CFC-11 and its potential applications are limited by its inferior characteristics."
                            },
                            {
                                "example_id": "881269e4-0d6f-4f27-bf38-7c140f0728d4",
                                "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                                "text": "The Renew is also free of polyvinyl chloride, asbestos, chlorofluorocarbons and halons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1387c3b9-b5f5-4537-8e27-879c39870c17",
                        "source_entry_id": "6a65cd30-0b59-3db4-a110-6afe3ac74657",
                        "source_sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                        "source_sense_description": "an organic compound with halogens in place of hydrogen",
                        "target_lang_word": "chloorfluorkoolwaterstof",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloorfluorkoolwaterstof",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6da64cd4-3abb-38bb-9202-36f725c5dc68",
                                        "entry_id": "c2eb9e01-48f7-3bc6-9076-8e5d982cd18b",
                                        "glosses": [
                                            "een koolwaterstofverbinding waarvan waterstofatomen zijn vervangen door chloor- en/of fluoratomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a50e94-56ae-4561-a8d8-7d150bdf103f",
                                                "sense_id": "6da64cd4-3abb-38bb-9202-36f725c5dc68",
                                                "text": "Cfk's. Wie de afkorting nog kent, weet dat deze chloorfluorkoolwaterstoffen de ozonlaag schaden. Dat probleem werd aan het einde van de jaren tachtig ontdekt, waarna internationaal snel werd samengewerkt: cfk's werden geweerd uit spuitbussen en koelkasten. Net op tijd, omdat cfk's lang in de atmosfeer blijven. Als internationale samenwerking was uitgebleven, zouden ozongaten ook boven bewoond gebied zijn gevormd - met grote gevolgen. Inmiddels is de ozonlaag iets aan het herstellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "000e3f1b-e112-4666-a37b-c399440aed46",
                        "source_entry_id": "6a65cd30-0b59-3db4-a110-6afe3ac74657",
                        "source_sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                        "source_sense_description": "an organic compound with halogens in place of hydrogen",
                        "target_lang_word": "chlorofluorocarbure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorofluorocarbure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d896dad4-2420-3318-8c4e-e037a5240306",
                                        "entry_id": "0ac6d0f6-89fc-3b97-a44b-640359ab818d",
                                        "glosses": [
                                            "Composé organique constitué exclusivement de carbone, de chlore et de fluor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d64024-fd96-4173-b86f-bbf9d0763580",
                                                "sense_id": "d896dad4-2420-3318-8c4e-e037a5240306",
                                                "text": "Le responsable est identifié : il s’agit d’une catégorie de molécules complexes, les chlorofluorocarbures (CFC), utilisées dans les bombes aérosols et les liquides réfrigérants."
                                            },
                                            {
                                                "example_id": "6ba36daf-c768-43a6-928a-be1563125d46",
                                                "sense_id": "d896dad4-2420-3318-8c4e-e037a5240306",
                                                "text": "Enfin, il faut renforcer la réglementation portant sur les fluides frigorigènes, utilisés depuis une trentaine d'années. L'utilisation de la première génération de gaz (chlorofluorocarbure ou CFC) a été interdite en 1987 dans le cadre du Protocole de Montréal, en raison de leur effet destructeur pour la couche d'ozone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
