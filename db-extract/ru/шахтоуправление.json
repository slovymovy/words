                                            "To damage (a vehicle or ship) with a mine (an explosive device)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca648298-d625-3c30-858f-caa5f604ea1d",
                                        "entry_id": "3c4a7584-654b-33e0-bc55-3bcdfe59fc0c",
