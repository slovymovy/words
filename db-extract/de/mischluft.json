                ],
                "senses": [
                    {
                        "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                        "entry_id": "d02b657f-4a29-37c4-8889-2769dc4f4bb2",
                        "glosses": [
                            "Umluft, die der Außenluft beigemischt wird und dem Raum als Zuluft/Mischluft erneut zugeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b9c8d8-754c-4621-a4c9-5784dd9f4d13",
                                "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                                "text": "In manch einem Lüftungsgerät wird im Winter die kalte Außenluft in einer Mischluftkammer (Umluftkammer), mit der dosiert zuströmenden warmen Umluft, vermischt und erneut eingeblasen."
                            },
                            {
                                "example_id": "b2ed529c-ed1c-4a61-9eb4-4b0e4a3743cd",
                                "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                                "text": "„Als Mischluft wird im Sinne der DIN EN 12792:2003 diejenige Luft bezeichnet, die sich aus zwei oder mehr Luftströmen zusammensetzt.“"
                            },
                            {
                                "example_id": "6748b67c-c065-4f7e-8c1a-143cb82100ce",
                                "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                                "text": "„Die Mischluft wird mit einem Direktverdampfer (mittlere Oberflächentemperatur tₘₒ=12°C) abgekühlt.“"
                            },
                            {
                                "example_id": "7b8a5481-2840-41f6-afc7-247f8684bbcb",
                                "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                                "text": "„Der Mischluft-Betrieb mischt die kühlere Außenluft mit der warmen Umluft.“"
                            },
                            {
                                "example_id": "dd7b9b9e-7ff5-45d9-ba1d-9e2e970f6b55",
                                "sense_id": "d4fe9556-1d92-3059-b179-e66fca9a5814",
                                "text": "„Bei Frischluftvolumenströmen von 250 m³/h, 500 m³/h und 1000 m³/h betragen die Ausblasgeschwindigkeiten der Mischluft 5,3 m/s, 6,3 m/s und 6,9m/s (siehe Bild 1).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
