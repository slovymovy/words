                "senses": [
                    {
                        "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                        "entry_id": "7e4178bd-0551-3a22-bce3-8fa4d6480701",
                        "glosses": [
                            "Lebensmittelzusatzstoff zum Färben von Lebensmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae85dc5-e8d1-455f-9cf4-3c9141fd4f9f",
                                "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                                "text": "Karmin, das als Lebensmittelfarbstoff das Kürzel E 120 hat, wird ansonsten vor allem für Lippenstifte verwendet."
                            },
                            {
                                "example_id": "18320eea-881a-4173-b0a6-1fb8d5cc8226",
                                "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                                "text": "Sie können die Beläge aber auch zuhause mit Plaque-Färbetabletten aus der Apotheke sichtbar machen. Der Lebensmittelfarbstoff Erythrosin färbt im Mund alle Stellen rot-violett, an denen sich Plaque gebildet hat."
                            },
                            {
                                "example_id": "ee067583-e851-4d47-b14f-4eeace2fc463",
                                "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                                "text": "Schon seit Längerem wissen Forscher, dass die in dem Lebensmittelfarbstoff Ammoniak-Zuckercouleur enthaltene Substanz Tetrahydroxybutyl-Imidazol (THI) das Immunsystem schwächt."
                            },
                            {
                                "example_id": "9bfd6728-97ea-4630-a44b-c68a346ef2e2",
                                "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                                "text": "Ein 15-Jähriger stirbt nach dem Genuss des Energydrinks Vitanale an einem allergischen Schock. Das Fitnessgetränk war mit einer Überdosis Lebensmittelfarbstoff versehen."
                            },
                            {
                                "example_id": "bb4ca5e4-5a4a-4b05-b0b2-b5c8cd83c67d",
                                "sense_id": "971c3882-1605-3809-87c3-9d63599d1116",
                                "text": "Die Kommission, die eng mit der Deutschen Forschungsgemeinschaft verbunden ist, legte die Forderungen fest, die man an Lebensmittelfarbstoffe stellen muß, damit sie als unbedenklich gelten können, und arbeitete die Testverfahren aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
