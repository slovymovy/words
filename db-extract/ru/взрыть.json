                ],
                "translations": [
                    {
                        "translation_id": "029859d9-e74a-4288-aa98-0c3398f9d62a",
                        "source_entry_id": "8368c732-3f1f-3770-84ce-a2ca9484301d",
                        "target_lang_word": "explode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b77040-e9fa-3288-9a29-2bc368cb0b46",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To destroy with an explosion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1920af-87dd-4ada-b9ce-1892f3db6d7e",
                                                "sense_id": "e2b77040-e9fa-3288-9a29-2bc368cb0b46",
                                                "text": "The assassin exploded the car by means of a car bomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1144f7df-e536-352c-8064-80718ef3171d",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To destroy violently or abruptly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0801b06-4099-4a29-87f3-34e2772b90be",
                                                "sense_id": "1144f7df-e536-352c-8064-80718ef3171d",
                                                "text": "They sought to explode the myth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6972f3e-bd9a-35c0-84b4-07437fb1db59",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To create an exploded view of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25046cc7-475d-48c2-bbc3-b745823ee5e8",
                                                "sense_id": "f6972f3e-bd9a-35c0-84b4-07437fb1db59",
                                                "text": "Explode the assembly drawing so that all the fasteners are visible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7a7992-d434-3cb3-b402-a56dc8e612bd",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To disprove or debunk."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c5c38b-36a5-487c-9521-e8e80d21d8cb",
                                                "sense_id": "df7a7992-d434-3cb3-b402-a56dc8e612bd",
                                                "text": "Astrology is required by many famous physicians […] doubted of, and exploded by others."
                                            },
                                            {
                                                "example_id": "d048fe6e-4b25-42a7-9012-b37b67b6195d",
                                                "sense_id": "df7a7992-d434-3cb3-b402-a56dc8e612bd",
                                                "text": "[W]henever the person who is possessed of [natural goodness] doth what is right, no ravished or friendly spectator is so eager or so loud in his applause: on the contrary, when he doth wrong, no critic is so apt to hiss and explode him."
                                            },
                                            {
                                                "example_id": "85a355eb-bea2-46a6-bf78-68f84de9f429",
                                                "sense_id": "df7a7992-d434-3cb3-b402-a56dc8e612bd",
                                                "text": "Another instance of the like nature is, that the old opinion, that Turks and infidels are perpetually to be considered as alien enemies, has been long exploded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2db8da8-f3c8-3906-b7d0-53ecbeaf25c9",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To fly apart with sudden violent force; to blow up, to burst, to detonate, to go off."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bc2a7cd-9ffb-44a6-9b28-e64a3a9cf87e",
                                                "sense_id": "e2db8da8-f3c8-3906-b7d0-53ecbeaf25c9",
                                                "text": "The bomb explodes."
                                            },
                                            {
                                                "example_id": "e7bebb0f-6fcd-4fa1-8d1c-9e7aea9827bd",
                                                "sense_id": "e2db8da8-f3c8-3906-b7d0-53ecbeaf25c9",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f4f1f2-1df3-3204-b45a-35a134a4f2d0",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To make a violent or emotional outburst; to suddenly give expression to powerful and often negative or unpleasant emotion, especially anger."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2d807a-32e7-4d95-8a1a-69e544939ec1",
                                                "sense_id": "a7f4f1f2-1df3-3204-b45a-35a134a4f2d0",
                                                "text": "She exploded when I criticised her hat."
                                            },
                                            {
                                                "example_id": "16af6442-fa8f-4de2-b75f-f01f623db04d",
                                                "sense_id": "a7f4f1f2-1df3-3204-b45a-35a134a4f2d0",
                                                "text": "Dobbin […] fell back in the crowd, crowing and sputtering until he reached a safe distance, when he exploded amongst the astonished market-people with shrieks of yelling laughter."
                                            },
                                            {
                                                "example_id": "bec5913b-81db-4f2a-8ee6-3c31c8d7870c",
                                                "sense_id": "a7f4f1f2-1df3-3204-b45a-35a134a4f2d0",
                                                "text": "“Nonsense!” Jack exploded at me. “Why Miss Bertram here knocked that theory into a cocked hat coming over on the train.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e9d5ec-e304-3143-9b07-28df339adc41",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To increase suddenly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e41a8c-a324-4920-9c68-9c4fff235118",
                                                "sense_id": "38e9d5ec-e304-3143-9b07-28df339adc41",
                                                "text": "When pigeons can come to a spot day in and day out for a guaranteed meal, their populations explode."
                                            },
                                            {
                                                "example_id": "6bb491a4-01c6-4d14-8006-5cdf4a949996",
                                                "sense_id": "38e9d5ec-e304-3143-9b07-28df339adc41",
                                                "text": "Despite these products typically costing more, the market for organic food has exploded over the last couple of decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19070d6b-5205-3942-bff1-1e630de9933b",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To increase arbitrarily or boundlessly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700d756f-ca0a-460f-8a82-3c362c610256",
                                                "sense_id": "19070d6b-5205-3942-bff1-1e630de9933b",
                                                "text": "The function f(x) = 1/x explodes around x = 0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b9f51e-5aee-3035-a2eb-064f683574d6",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To emerge suddenly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "413e4058-14f9-4f73-8e1a-225af852c92e",
                                                "sense_id": "74b9f51e-5aee-3035-a2eb-064f683574d6",
                                                "text": "to explode into the mainstream; to explode onto the scene"
                                            },
                                            {
                                                "example_id": "dad6647a-6222-47f6-aa32-ddffab9f3c2d",
                                                "sense_id": "74b9f51e-5aee-3035-a2eb-064f683574d6",
                                                "text": "In recent years, words and ideas used to describe discrimination against members of historically marginalized and disadvantaged groups have seemingly exploded into the lexicon: systemic inequality, privilege, white supremacy, the patriarchy, etc."
                                            },
                                            {
                                                "example_id": "17c28f9a-e502-498c-b5e3-b383173457dd",
                                                "sense_id": "74b9f51e-5aee-3035-a2eb-064f683574d6",
                                                "text": "A.I. text-to-image generators such as Stable Diffusion, Midjourney and DALL-E exploded onto the scene this year and in mere months have become widely used to create all sorts of images, ranging from digital art pieces to character designs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84170bac-9449-3259-afd6-6d0b7fdd3acf",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To ejaculate."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa428926-bb52-30ba-af70-4b4e49090954",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To break (a delimited string of text) into several smaller strings by removing the separators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9aaaa8d-ecf8-4741-a050-2b1a0dbcb9ac",
                                                "sense_id": "aa428926-bb52-30ba-af70-4b4e49090954",
                                                "text": "The third check uses the exploded data stored in the array $parts and the function checkdate() to test if the date is a valid calendar date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16ca7f6-71a4-3596-ae1c-9fb21d2d8121",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To decompress (data) that was previously imploded."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313588cf-66ee-480c-8411-bd993bfd22db",
                                                "sense_id": "e16ca7f6-71a4-3596-ae1c-9fb21d2d8121",
                                                "text": "I'm looking for some code that will implode data using the PKZIP method.. and explode it. PKWare sells an object that you can link with that does the job, and we have licensed this, but we are now writing 32 bit code for MS-DOS and the PKWare stuff won't work […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd4d451-5ae2-31c6-8713-9fa7408e2752",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "To open all doors and hatches on an automobile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c34696c-667f-3dc2-b781-b68380cb0d72",
                                        "entry_id": "d03f150b-4652-354f-a7b7-ba044c756fa8",
                                        "glosses": [
                                            "Of a die, to produce the highest face result and consequently reroll."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
