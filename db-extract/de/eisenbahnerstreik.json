                        "glosses": [
                            "Streik, an dem ausschließlich Eisenbahnbedienstete beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd8d7b9-585b-4181-9048-4b0ccd55264c",
                                "sense_id": "111fac0d-625e-35e7-8ac4-09085ed04ef6",
                                "text": "„Der Eisenbahnerstreik in Ungarn beeinträchtigt auch den Reiseverkehr in Rumänien.“"
                            },
                            {
                                "example_id": "2d271206-0ccc-464a-b279-5e509f7bbe03",
                                "sense_id": "111fac0d-625e-35e7-8ac4-09085ed04ef6",
                                "text": "„Für die Franzosen bedeutet dies, wie jeder Eisenbahnerstreik, ein Wechselbad der Gefühle.“"
                            }
                        ],
