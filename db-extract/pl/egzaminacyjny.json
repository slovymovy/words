                "senses": [
                    {
                        "sense_id": "ebd50192-731a-3568-b63b-dc3d78011cb4",
                        "entry_id": "324ece00-088c-3cf0-a9fa-1d45ccbd8c6c",
                        "glosses": [
                            "związany z egzaminem, dotyczący egzaminu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de436aa6-28fa-4dc7-ae79-67cfca6ab2c5",
                                "sense_id": "ebd50192-731a-3568-b63b-dc3d78011cb4",
                                "text": "Budynek egzaminacyjny uniwersytetu w Oksfordzie zamieniono w szpital wojskowy"
                            },
                            {
                                "example_id": "91d0de2b-6211-484d-af36-0ac57001de7d",
                                "sense_id": "ebd50192-731a-3568-b63b-dc3d78011cb4",
                                "text": "Każdy samochód egzaminacyjny wyposażony jest w szereg kamer wideo rejestrujących przebieg egzaminu państwowego na prawo jazdy"
                            },
                            {
                                "example_id": "74c991c7-6765-4153-b233-09727280f233",
                                "sense_id": "ebd50192-731a-3568-b63b-dc3d78011cb4",
                                "text": "Na tegorocznej maturze pojawiło się do wyboru kilka nowych przedmiotów egzaminacyjnych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
