                    },
                    {
                        "translation_id": "7c0b5e23-7e19-4042-bbff-6c7403a5bad8",
                        "source_entry_id": "d4dfbf2e-223d-3dc0-a547-fa2cdcae25d2",
                        "source_sense_id": "d10b7649-16eb-399b-942d-5044efb95dcc",
