                "senses": [
                    {
                        "sense_id": "98db9f3d-d77d-3882-a3a3-c2c32fb941d3",
                        "entry_id": "50d2c892-5b2f-39c2-9d8d-f1f77a0095b2",
                        "glosses": [
                            "depressief stemmend, niet op te vrolijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f858be-7ab9-462f-9128-218e6ee9071f",
                                "sense_id": "98db9f3d-d77d-3882-a3a3-c2c32fb941d3",
                                "text": "- Een desolater, mistroostiger aanblik kan ik mij niet voorstellen."
                            },
                            {
                                "example_id": "3c25788f-09e9-4812-aaa3-91394cb9d116",
                                "sense_id": "98db9f3d-d77d-3882-a3a3-c2c32fb941d3",
                                "text": "- Was de dokter iets kwijtgeraakt op die mistroostige kust? Kon ik van dienst zijn?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b567d10f-65d8-481b-9fb9-75b038ff3483",
                        "source_entry_id": "50d2c892-5b2f-39c2-9d8d-f1f77a0095b2",
                        "source_sense_id": "98db9f3d-d77d-3882-a3a3-c2c32fb941d3",
                        "source_sense_description": "depressief stemmend, niet op te vrolijken",
                        "target_lang_word": "desolate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "453275cb-8890-3705-bb25-9fe6a69f0b07",
                                        "entry_id": "04c50cbc-6751-3f97-adbd-b93d5f570b45",
                                        "glosses": [
                                            "To deprive of inhabitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc72ac3a-4420-49c9-9950-1504a815cd39",
                                                "sense_id": "453275cb-8890-3705-bb25-9fe6a69f0b07",
                                                "text": "If you consider well of the People of the West-Indies, it is very probable, that they are a newer or younger People, than the People of the old World. And it is much more likely, that the destruction that hath heretofore been there, was not by Earthquakes, […] but rather, it was Desolated by a particular Deluge: For Earthquakes are seldom in those Parts."
                                            },
                                            {
                                                "example_id": "3234399c-a93b-45fc-b38b-c51f74615ef6",
                                                "sense_id": "453275cb-8890-3705-bb25-9fe6a69f0b07",
                                                "text": "O Righteous Themis, if the Pow’rs above\nBy Pray’rs are bent to pity, and to love;\nIf humane Miseries can move their Mind;\nIf yet they can forgive, and yet be kind;\nTell how we may restore, by second birth,\nMankind, and people desolated Earth."
                                            },
                                            {
                                                "example_id": "027c39bf-6f4e-4dd7-b8c7-caeee8be9ee3",
                                                "sense_id": "453275cb-8890-3705-bb25-9fe6a69f0b07",
                                                "text": "York was so desolated just before the survey that it is not easy to estimate its ordinary population […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0163d19-b152-3387-a744-7538c9288534",
                                        "entry_id": "04c50cbc-6751-3f97-adbd-b93d5f570b45",
                                        "glosses": [
                                            "To devastate or lay waste somewhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf523dcd-fe43-484b-ac07-8fa58e83f1d4",
                                                "sense_id": "d0163d19-b152-3387-a744-7538c9288534",
                                                "text": "Then Moath pointed where a cloud\nOf Locusts, from the desolated fields\nOf Syria, wing’d their way."
                                            },
                                            {
                                                "example_id": "d166e5de-801e-4585-8f11-5bfe64adff46",
                                                "sense_id": "d0163d19-b152-3387-a744-7538c9288534",
                                                "text": "But in Utopia there will be wide stretches of cheerless or unhealthy or toilsome or dangerous land with never a household; there will be regions of mining and smelting, black with the smoke of furnaces and gashed and desolated by mines, with a sort of weird inhospitable grandeur of industrial desolation, and the men will come thither and work for a spell and return to civilisation again, washing and changing their attire in the swift gliding train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f8e1c0c-b442-35e1-be62-b086b95147a8",
                                        "entry_id": "04c50cbc-6751-3f97-adbd-b93d5f570b45",
                                        "glosses": [
                                            "To abandon or forsake something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8aad88d-8ff7-4f8c-b799-804a03cdd4fd",
                                                "sense_id": "6f8e1c0c-b442-35e1-be62-b086b95147a8",
                                                "text": "It is not to be supposed that when Cush left Armenia, he left it desolate, and that a rich and long settled country was abandoned altogether; for it would be an absurd way of founding an universal empire, to desolate one country in order to people another."
                                            },
                                            {
                                                "example_id": "6130bcd6-f8b6-4c63-9102-d1db4d1cb763",
                                                "sense_id": "6f8e1c0c-b442-35e1-be62-b086b95147a8",
                                                "text": "This completion of the Temple and attack upon Christians is the event that marks the apostasy that causes desolation, the detestable act that causes God to desolate (abandon) and destroy the Temple for the last time."
                                            },
                                            {
                                                "example_id": "78a2c8d6-e7e9-4674-9137-b93b4ca3fe4e",
                                                "sense_id": "6f8e1c0c-b442-35e1-be62-b086b95147a8",
                                                "text": "Combining widowed, separated, and divorced elders into a single group (\"desolated\"), the data indicated that desolated elders were slightly more lonely than either married or never-married older people (although this trend was not statistically significant at the conventional .05 level)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b270236b-cc9d-3e72-990d-35a02089e964",
                                        "entry_id": "04c50cbc-6751-3f97-adbd-b93d5f570b45",
                                        "glosses": [
                                            "To make someone sad, forlorn and hopeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6036c4-581c-4b50-8044-16b7c427fb66",
                                                "sense_id": "b270236b-cc9d-3e72-990d-35a02089e964",
                                                "text": "It is not altogether uncommon to hear a reader whose heart has been desolated by the poignancy of a narrative complain that the writer is unemotional."
                                            },
                                            {
                                                "example_id": "ecffc5db-31e3-4879-813e-2391f52fe237",
                                                "sense_id": "b270236b-cc9d-3e72-990d-35a02089e964",
                                                "text": "Kumalo stood shocked at the frightening and desolating words."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "desolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f80c8d-20ed-3ab8-bfed-288e5a6c4018",
                                        "entry_id": "956b70b8-8517-3c7b-a208-14da70ed2807",
                                        "glosses": [
                                            "Deserted and devoid of inhabitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2711520e-83b3-422b-966e-3f431140d906",
                                                "sense_id": "c5f80c8d-20ed-3ab8-bfed-288e5a6c4018",
                                                "text": "a desolate isle; a desolate wilderness; a desolate house"
                                            },
                                            {
                                                "example_id": "8c148382-421e-44ff-b265-e7cc353d3bfa",
                                                "sense_id": "c5f80c8d-20ed-3ab8-bfed-288e5a6c4018",
                                                "text": "I will make Jerusalem […] a den of dragons, and I will make the cities of Judah desolate, without an inhabitant."
                                            },
                                            {
                                                "example_id": "c3b9c847-8ddb-4e5b-84ad-48bd8c312c15",
                                                "sense_id": "c5f80c8d-20ed-3ab8-bfed-288e5a6c4018",
                                                "text": "And the silvery marish flowers that throng / The desolate creeks and pools among."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e004e3-53b5-325d-a642-7bd32fcdb3ab",
                                        "entry_id": "956b70b8-8517-3c7b-a208-14da70ed2807",
                                        "glosses": [
                                            "Barren and lifeless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2655a91-311e-31d5-8042-c7de973e300c",
                                        "entry_id": "956b70b8-8517-3c7b-a208-14da70ed2807",
                                        "glosses": [
                                            "Made unfit for habitation or use because of neglect, destruction etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863f70e8-1242-4a3b-9422-fc952638121c",
                                                "sense_id": "b2655a91-311e-31d5-8042-c7de973e300c",
                                                "text": "desolate altars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fdfd03-25be-3879-99e1-ee336bb9d807",
                                        "entry_id": "956b70b8-8517-3c7b-a208-14da70ed2807",
                                        "glosses": [
                                            "Dismal or dreary."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4efce10-2eb0-30ab-8ddf-cadff3dfebeb",
                                        "entry_id": "956b70b8-8517-3c7b-a208-14da70ed2807",
                                        "glosses": [
                                            "Sad, forlorn and hopeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15f76642-34c9-41e1-9451-da45eba2e07a",
                                                "sense_id": "f4efce10-2eb0-30ab-8ddf-cadff3dfebeb",
                                                "text": "He was left desolate by the early death of his wife."
                                            },
                                            {
                                                "example_id": "6efd2faf-88fd-4466-a27a-de72e286ef63",
                                                "sense_id": "f4efce10-2eb0-30ab-8ddf-cadff3dfebeb",
                                                "text": "voice of the poor and desolate"
                                            },
                                            {
                                                "example_id": "966dc399-5a87-4495-a169-aee1b0f31124",
                                                "sense_id": "f4efce10-2eb0-30ab-8ddf-cadff3dfebeb",
                                                "text": "Any help and suggestions from our gay brothers and sisters would be appreciated from this isolated camp. We need some contacts: lawyers, organizations, or people who are concerned enough to help. We are two desolate, suppressed lesbians! We are seeking help from anyone who will help us fight for our rights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
