{
    "word_family": [
        "lump",
        "lumpish",
        "lumpiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5b7ff678-f0c0-3bc1-b99b-1695dcf34c44",
                    "sense_definition": "Full of lumps, not smooth, uneven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uneven_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not know which was worse, the <w>lumpy</w> soup or the hard bed.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, что было хуже: суп <w>с комками</w> или жесткая постель."
                            }
                        },
                        {
                            "text": "She tried to stir the sauce to get rid of the <w>lumpy</w> texture.",
                            "target_lang_translations": {
                                "ru": "Она попыталась помешать соус, чтобы избавиться от <w>комковатой</w> текстуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "bumpy",
                        "uneven",
                        "clumpy"
                    ],
                    "antonyms": [
                        "smooth",
                        "even"
                    ],
                    "common_phrases": [
                        "lumpy gravy",
                        "lumpy mattress",
                        "lumpy texture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный комков, не гладкий, неровный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с комками",
                                "target_lang_sense_clarification": "о еде, соусе, тесте"
                            },
                            {
                                "target_lang_word": "комковатый",
                                "target_lang_sense_clarification": "о текстуре, порошке, почве"
                            },
                            {
                                "target_lang_word": "бугристый",
                                "target_lang_sense_clarification": "о поверхности, матрасе, дороге"
                            },
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "о поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f3a82b-e7fa-362c-be92-feadf46f1af1",
                    "sense_definition": "Of a water surface: covered in many small waves as a result of wind; choppy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rough_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind made the sea very <w>lumpy</w> and difficult to navigate.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер сделал море очень <w>неспокойным</w>, и по нему было трудно ориентироваться."
                            }
                        },
                        {
                            "text": "We had a rough ride across the bay because of the <w>lumpy</w> water.",
                            "target_lang_translations": {
                                "ru": "Поездка через залив была тяжелой из-за <w>бурной</w> воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "choppy",
                        "rough"
                    ],
                    "antonyms": [
                        "calm",
                        "flat"
                    ],
                    "common_phrases": [
                        "lumpy sea",
                        "lumpy water"
                    ],
                    "target_lang_definitions": {
                        "ru": "О водной поверхности: покрытый множеством мелких волн в результате ветра; неспокойный, бурный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспокойный",
                                "target_lang_sense_clarification": "о море или воде с мелкой рябью и волнами"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "о водной поверхности"
                            },
                            {
                                "target_lang_word": "взволнованный",
                                "target_lang_sense_clarification": "о море"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}