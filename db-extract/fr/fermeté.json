                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "141392b2-30c7-3f23-9d3c-1fab8d652f5e",
                                        "entry_id": "2053c498-ac94-39e2-9ffa-1b357b7ce078",
                                        "glosses": [
                                            "die Unbeirrbarkeit im Festhalten an einer Meinung, an einem Standpunkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df3e625-4165-4266-9bbd-8654a7b5b0e3",
                                                "sense_id": "141392b2-30c7-3f23-9d3c-1fab8d652f5e",
                                                "text": "Seine Festigkeit im Glauben war bewundernswert."
                                            },
                                            {
                                                "example_id": "893459fa-64ba-4979-b955-f21971a471d6",
                                                "sense_id": "141392b2-30c7-3f23-9d3c-1fab8d652f5e",
                                                "text": "„Es schien, als ob eine übernatürliche Festigkeit sie beseelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2858b5cc-0026-426b-a1aa-6962e2218363",
                        "source_entry_id": "fdc5f033-7617-31d9-a9cb-892d34ea4ded",
                        "source_sense_description": "État de ce qui est ferme, difficile à ébranler, de ce qui ne chancelle point.",
                        "target_lang_word": "Geschlossenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschlossenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf6f4cf-46ca-342c-8aea-0ec7842632f7",
                                        "entry_id": "a7a2d624-1449-3a4b-aade-ad449b2462e3",
                                        "glosses": [
                                            "enger Zusammenhalt einer Gemeinschaft, vor allem gegenüber Außenstehenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9048cb6-3d6e-4f9e-891c-7731780c5f0e",
                                                "sense_id": "5bf6f4cf-46ca-342c-8aea-0ec7842632f7",
                                                "text": "„Sogar in Merkels engerer Umgebung geben sie offen zu, dass Geschlossenheit nicht eben zu den Paradedisziplinen gehört.“"
                                            },
                                            {
                                                "example_id": "686e4ca4-662a-4f35-b1c1-70360671ab88",
                                                "sense_id": "5bf6f4cf-46ca-342c-8aea-0ec7842632f7",
                                                "text": "„Es hat in germanischer Zeit keine Städte gegeben, da die Stämme es ablehnten, in der Geschlossenheit einer Siedlung zu wohnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865ada36-9129-4f56-9e35-0736f2a4cfa9",
                        "source_entry_id": "fdc5f033-7617-31d9-a9cb-892d34ea4ded",
                        "source_sense_description": "État de ce qui est ferme, difficile à ébranler, de ce qui ne chancelle point.",
                        "target_lang_word": "Entschlossenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entschlossenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                        "entry_id": "d4c5517d-5349-373f-9716-6bc2fde5cb6d",
                                        "glosses": [
                                            "Handlungsweise, mit der man willensstark und sicher (fest entschlossen) auf das ausgemachte Ziel zugeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d47f27-e2f6-4917-9938-de61b53f5457",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Damit hatte ich nun schon meine dritte Chance vertan und bekam Angst. Mir fehlte es an Entschlossenheit, ich hatte keinen klaren Kopf.“"
                                            },
                                            {
                                                "example_id": "82f9ba42-e216-4ade-8241-23f1552e05f3",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Cato war ein Mann von großer Entschlossenheit und republikanischer Tugend und stammte aus einem vornehmen Geschlechte.“"
                                            },
                                            {
                                                "example_id": "f9b67e9d-aa05-42e2-b5d4-8d5f5665f08c",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Mit wilder Entschlossenheit stößt er rückwärts in eine Parklücke.“"
                                            },
                                            {
                                                "example_id": "2dacfcfd-fce7-413d-9bd0-0b494951e6c2",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Die Selbstschwächung Europas in seinem vierzigjährigen Bruderkrieg beschleunigte indessen den letztlich unaufhaltsamen Prozess, indem sie allenthalben die Entschlossenheit und den Mut der Freiheitskämpfer beflügelte.“"
                                            },
                                            {
                                                "example_id": "c96a1f9c-cfc7-4820-a432-f530103adea9",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Aber er war ein kräftiges Kind mit breiten Schultern und trotziger Entschlossenheit. Nach sieben Monaten hatte er es geschafft, den Bettrahmen aufzubiegen, die Kette herauszuziehen und Reißaus zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76e405d2-1a20-48d7-bc4a-59ec3aa2f7d5",
                        "source_entry_id": "fdc5f033-7617-31d9-a9cb-892d34ea4ded",
                        "source_sense_description": "État de ce qui est ferme, difficile à ébranler, de ce qui ne chancelle point.",
                        "target_lang_word": "firmness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed6acb92-d354-3ebe-8b72-36f1d75814a4",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "security; steadfastness; good grip"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "strictness; mental strength"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f91b0-f6af-4c1b-a18b-7ff2a8580269",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "But many a man who would have stood within a home dismantled, strong in his passion and design of vengeance, has had the firmness of his nature conquered by the razing of an air–built castle."
                                            },
                                            {
                                                "example_id": "94e09148-1546-482f-9a7e-4e27affbba98",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "France, for the first time since the death of Charlemagne, was governed by a prince of great firmness and ability."
                                            }
                                        ]
