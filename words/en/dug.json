                            },
                            {
                                "target_lang_word": "Euter",
                                "target_lang_sense_clarification": "Gesamtheit der Milchdrüsen bei Nutztieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e27068-052e-3167-aa2f-b1d11261efb6",
