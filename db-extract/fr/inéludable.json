                "senses": [
                    {
                        "sense_id": "9498bb2f-f476-3e12-bb86-7c6edd739acc",
                        "entry_id": "c5f17151-dbbe-34a7-80f6-d408b57c45e6",
                        "glosses": [
                            "Qu’on ne peut éluder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e90b1a7f-01e6-411f-bc23-9a6cd4e9bf26",
                                "sense_id": "9498bb2f-f476-3e12-bb86-7c6edd739acc",
                                "text": "Les grands corps de l’État, les grandes communautés, ont quelquefois des besoins impérieux, urgents, inéludables, auxquels il faut faire face, coûte que coûte"
                            }
                        ]
                    },
                    {
                        "sense_id": "e5623e25-2ce0-3a9a-b8ff-d66525282162",
                        "entry_id": "c5f17151-dbbe-34a7-80f6-d408b57c45e6",
                        "glosses": [
                            "Qualifie une dépense qui ne disparaît pas lorsque cesse l’activité à laquelle elle est liée."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "648c8dba-730e-4e0d-9eb9-8cfe55ce4ce0",
                                "sense_id": "e5623e25-2ce0-3a9a-b8ff-d66525282162",
                                "text": "On distingue les charges éludables, qui disparaissent dès que l’agent quitte l’entreprise (par exemple, le salaire brut et les congés payés) et les charges inéludables, ou éludables à terme, qui ne disparaîtront qu’après un délai plus ou moins long (par exemple, le logement et la formation professionnelle)."
                            },
                            {
                                "example_id": "67a70399-4e37-4f8c-8276-7743adea735b",
                                "sense_id": "e5623e25-2ce0-3a9a-b8ff-d66525282162",
                                "text": "Les dépenses inéludables concernent les frais de surveillance de la mine car, même une fois fermée et inondée, la mine entraîne certains frais d’entretien du site."
                            }
                        ]
                    }
                ],
