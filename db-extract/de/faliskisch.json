                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a467e2-1dff-4d5f-9522-a6b5b520d011",
                                "sense_id": "a0d67477-b5c0-325a-827b-98a541804a32",
                                "text": "„Faliskisch wurde in der Antike vom Stamm der Falisker im nördlichen Latium gesprochen.“"
                            },
                            {
                                "example_id": "571e6725-3d7a-43b7-95e6-95d18fe740d5",
                                "sense_id": "a0d67477-b5c0-325a-827b-98a541804a32",
                                "text": "„Den latinischen Dialekten sehr nahe steht das Faliskische, die Sprache von knapp 150 Inschriften aus dem Gebiet von Falerii (Cività Castellana) nördlich von Rom in etruskischer Umgebung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
