                        "glosses": [
                            "Kraftfahrzeug mit dem Fahrersitz vor oder über der Vorderachse und dem Motor unter dem Boden oder im Heck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec4cadb-d865-4ad5-8a24-80dc62070494",
                                "sense_id": "e9e0facd-6a41-3e57-bfee-90877d0ecdf7",
                                "text": "„Auf den schlechten Straßen schaukelt der Fahrer bei diesem Typ nicht wie beim Frontlenker vor der Vorderachse auf und ab, als führe er Achterbahn.“"
                            },
                            {
                                "example_id": "34514168-a5ad-46ea-91d1-127c31ccee06",
                                "sense_id": "e9e0facd-6a41-3e57-bfee-90877d0ecdf7",
                                "text": "Diese Motoren können in blatt- oder luftgefederte Fahrgestelle mit unterschiedlichen Radständen als Frontlenker- oder Hauben-Version eingebaut werden."
                            },
                            {
                                "example_id": "c25a71b5-8930-4630-a91f-3bbc613e6b38",
                                "sense_id": "e9e0facd-6a41-3e57-bfee-90877d0ecdf7",
                                "text": "Fast alle Baureihen der MAN-Frontlenker kann man bis heute antreffen."
                            }
