                "senses": [
                    {
                        "sense_id": "61c7d205-e799-3cee-8112-a9b0de732032",
                        "entry_id": "a4d6dad9-0d38-32f1-a1a8-b94d525acddf",
                        "glosses": [
                            "Gesetze und Verordnungen, die auf die Binnenschifffahrt und Schifffahrt in internationalen Gewässern zutreffen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fdd9e899-26e2-4bd3-9b54-af4eeb1ef8b0",
                                "sense_id": "61c7d205-e799-3cee-8112-a9b0de732032",
                                "text": "„Längst ist das Seerecht kein bloßes Schifffahrtsrecht mehr. Die Meere werden vielfältig genutzt. Neben Seeverkehr und Fischerei als traditionellen Nutzungsformen geht es zunehmend um die Förderung mineralischer Rohstoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "523fa156-897e-34e2-81ed-38e794e735b6",
                        "entry_id": "a4d6dad9-0d38-32f1-a1a8-b94d525acddf",
                        "glosses": [
                            "eines der die Schifffahrt betreffenden Rechte, das jemandem zusteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0f6f58-6cec-4edc-b252-a303830081c5",
                                "sense_id": "523fa156-897e-34e2-81ed-38e794e735b6",
                                "text": "„Am 23. März 1824 erfolgte die endliche Vereinbarung mit der Schifferschaft in Friedrichshafen über deren Abfindung hinsichtlich ihrer alten Schifffahrtsrechte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
