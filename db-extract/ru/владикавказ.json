                                "target_senses": [
                                    {
                                        "sense_id": "9477502a-542a-3ccd-9712-fddf137ba01b",
                                        "entry_id": "2bab8462-8cd2-3dd2-ae1b-022ba171a7ab",
                                        "glosses": [
                                            "Capitale de l’Ossétie-du-Nord-Alanie, en Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eace80-9ff4-4974-800b-635dc0ed432c",
                                                "sense_id": "9477502a-542a-3ccd-9712-fddf137ba01b",
                                                "text": "Entré dans la Grande-Tchetchenia, et coupant la chaîne en diagonale jusqu’à’son milieu, où s’élève la forteresse de Vladikavkaz, et jusqu’au défilé de Dariel (Caucasiæ Pylæ), il atteignit Tiflis, devenue la capitale florissante de la Transcaucasie. Quelques pas de plus vers le sud le conduisirent au couvent d’Edchmiadzïn, l’antique sanctuaire de la nation arménienne."
                                            }
                                        ]
                                    }
                                ]
                            }
