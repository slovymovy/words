                ],
                "translations": [
                    {
                        "translation_id": "f7cde09a-0cac-43d3-a8ae-89032f272844",
                        "source_entry_id": "a76090b3-8a39-3f5b-af71-092e65d51399",
                        "source_sense_id": "f7f67f86-2729-304c-8320-4d35034056f1",
                        "source_sense_description": "überdachte Bushaltestelle, Bushäuschen, Wartehäuschen",
                        "target_lang_word": "Bushaltestelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bushaltestelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                        "entry_id": "2cf9176e-77b4-3eff-ba1c-13cda232694d",
                                        "glosses": [
                                            "offizieller Ort, an dem Busse (normalerweise als öffentliches Verkehrsmittel) halten, damit Passagiere ein- und aussteigen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ade6526-92fb-4ce6-8e4e-01707a50cd63",
                                                "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                                "text": "Viele Menschen quetschten sich unter den Regenschutz der kleinen Bushaltestelle."
                                            },
                                            {
                                                "example_id": "2247263a-f7dd-4da9-beb7-b2a6cf82d380",
                                                "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                                "text": "„Astrid wohnte ein paar Bushaltestellen vom Gymnasium entfernt.“"
                                            },
                                            {
                                                "example_id": "cec42b3a-c04a-48d3-9360-a9dc2aee5327",
                                                "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                                "text": "„Auf Initiative der Stiftung Niedersachsen in Verbindung mit dem örtlichen Verkehrsbetrieb Üstra (»Überlandwerke und Straßenbahnen Hannover AG«) wurden neun bekannte Designer damit beauftragt, Bushaltestellen mit Dach zu gestalten.“"
                                            },
                                            {
                                                "example_id": "6386d9ba-1c6a-4fcb-9b04-90c77abf4ce3",
                                                "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                                "text": "„Und so waren es die Füße, die den Weg zur Bushaltestelle fanden.“"
                                            },
                                            {
                                                "example_id": "7d8677ae-e536-4040-9eb8-65d437f913e9",
                                                "sense_id": "f205c4df-3d41-34c5-ba03-b43b8a635f4b",
                                                "text": "„An der Bushaltestelle sieht sie immer wieder auf ihre Armbanduhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "846a635a-7b88-4be7-a0da-cbe26c43a377",
