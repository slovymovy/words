                        "tags": [
                            "comparative"
                        ],
                        "form": "комплимента́рнее"
                    },
                    {
                        "form_id": "64d6446d-e70e-49ef-8740-3a9b1e084602",
                        "entry_id": "e93d6665-d920-359d-ad86-609db2e71775",
                        "tags": [
                            "comparative"
                        ],
