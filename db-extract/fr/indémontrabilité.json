                "senses": [
                    {
                        "sense_id": "f3b9e997-2b6b-3d8f-a65e-6946c67114aa",
                        "entry_id": "be1d726f-7e14-3f1b-97ad-e86d41b92d27",
                        "glosses": [
                            "Qualité de ce qui ne peut pas être démontré ; nature de ce qui est indémontrable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8938a2f1-ca9e-4ccf-913c-20737b704881",
                                "sense_id": "f3b9e997-2b6b-3d8f-a65e-6946c67114aa",
                                "text": "Si Bolzano a établi qu'il ne peut être démontré, du moins son indémontrabilité peut-elle l'être, par une opération à laquelle nous avons donné le nom de Deductio."
                            },
                            {
                                "example_id": "1d81d9fe-34a3-4b97-99cb-e0292ff03af0",
                                "sense_id": "f3b9e997-2b6b-3d8f-a65e-6946c67114aa",
                                "text": "Évidemment aussi, en raison même de cette indémontrabilité, la certitude inverse n'est pas davantage démontrable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
