                        "glosses": [
                            "kaffeeähnliches Getränk, das durch Aufbrühen gemahlener, gerösteter Gerste hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe003ad2-0be7-4c8b-8745-9a0d49d88c12",
                                "sense_id": "29fcce82-f9ae-3a7a-81a3-bde901c192c0",
                                "text": "„Wir essen still unsere Schinkenschnitten und trinken Malzkaffee, der in unserer Familie Muckefuck heißt.“"
                            },
                            {
                                "example_id": "c87d16f6-5c4c-4bf5-a8a1-0e9eef7fa58e",
                                "sense_id": "29fcce82-f9ae-3a7a-81a3-bde901c192c0",
                                "text": "„Hackendahl schnuppert, natürlich ist es der für den Alltag verbotene Bohnenkaffee, statt des angeordneten Malzkaffees!“"
                            }
                        ],
