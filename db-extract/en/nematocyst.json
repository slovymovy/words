                        "entry_id": "fbad29ad-096d-3ef1-8185-75add2698abc",
                        "glosses": [
                            "A capsule, in certain cnidarians, containing a barbed, threadlike tube that delivers a paralyzing sting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be4a8e2-6284-4990-bc1e-6b2cc8b1b738",
                                "sense_id": "d17c5095-54c4-39d4-ac7b-5b88279a2f2b",
                                "text": "Often one sees, on surface view, a distinctly rounded vacuole, occupying a position in the cell occupied in others by a large nematocyst."
                            },
                            {
                                "example_id": "ec6d2f00-2f1f-41df-a591-9876def78836",
                                "sense_id": "d17c5095-54c4-39d4-ac7b-5b88279a2f2b",
                                "text": "The young nematocyst decreases in size and becomes coarsely granular, the granules arranging themselves in a spiral line close under the external membrane."
                            },
                            {
                                "example_id": "b155b17a-a422-42f2-b86a-f68459363d46",
                                "sense_id": "d17c5095-54c4-39d4-ac7b-5b88279a2f2b",
                                "text": "Nematocyst discharge is another example of the Rubicon principle – it either fires or it does not."
                            }
                        ]
                    }
                ],
