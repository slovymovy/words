                        "examples": [
                            {
                                "example_id": "be7cee46-3912-4505-ad06-66a88339635e",
                                "sense_id": "5dbb0162-2931-38c5-92bc-92557f625ccd",
                                "text": "Dass es noch Millionen von Menschen gibt, die potenzielle Zeitzeugen sind. Das kann man nicht ignorieren, deshalb nehmen die Erinnerungen von Zeitzeugen bei mir einen großen Raum ein. Ich habe viele Gespräche mit ehemaligen DDR-Bürgern geführt und stelle ihre Biografien neben die historischen Darstellungen."
                            }
                        ]
                    }
