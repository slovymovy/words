                    {
                        "sense_id": "27db9fb1-d9d1-39ab-a176-a870a2be0371",
                        "entry_id": "612a2199-05d6-3255-8c41-49dbfa3b6a50",
                        "glosses": [
                            "punkt lub bramka, po których zdobyciu w rozgrywkach następuje remis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a634d0-a322-42dd-8c0e-99aecd8a08b8",
                                "sense_id": "27db9fb1-d9d1-39ab-a176-a870a2be0371",
