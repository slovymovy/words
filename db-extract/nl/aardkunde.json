                                        "entry_id": "60d5021b-c5ac-3f8b-98c3-f5867d98d16a",
                                        "glosses": [
                                            "Wissenschaft von der Entwicklung, vom Aufbau und von der Veränderung der Erde einschließlich der diese bewohnenden Lebewesen in der Erdgeschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9c54c8-2618-460c-813e-e8c5ad495f9d",
                                                "sense_id": "2a3d0f48-3f00-3c1e-9f25-2100f4f18760",
                                                "text": "Ich interessiere mich sehr für Geologie."
                                            },
                                            {
                                                "example_id": "dc0b70bb-9746-420c-a571-a2034bac57ba",
                                                "sense_id": "2a3d0f48-3f00-3c1e-9f25-2100f4f18760",
                                                "text": "„Die Geologie bildet die Grundlage der Wissenschaften von der Erde.“"
                                            },
                                            {
                                                "example_id": "dcf2310c-c3f7-4099-aa66-a38f6fd4dffb",
                                                "sense_id": "2a3d0f48-3f00-3c1e-9f25-2100f4f18760",
                                                "text": "„Die Geologie ist demnach eine beschreibend-erklärende, im wesentlichen jedoch eine historische Wissenschaft, die folgendermaßen gegliedert werden kann: 1) allgemeine oder dynamische Geologie […] 2) Tektonik […] 3) historische Geologie […] 4) Paläogeographie […] 5) Paläoklimatologie […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "937a4e75-6c02-3499-87b2-7b46587717f5",
                                        "entry_id": "60d5021b-c5ac-3f8b-98c3-f5867d98d16a",
                                        "glosses": [
                                            "die in den Bereich von ^([1]) fallenden Eigenschaften eines Landstrichs; geologischer Aufbau von Kontinenten, Ozeanen und deren Teile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544c4f3e-393d-452f-9025-cca5186530e9",
                                                "sense_id": "937a4e75-6c02-3499-87b2-7b46587717f5",
                                                "text": "Die Geologie dieses Berges ist sehr außergewöhnlich."
