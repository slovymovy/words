                                    {
                                        "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "mehrere Seiten habend, aus mehreren Teilen bestehend, sodass ein relativ weites Gebiet abgedeckt wird oder eine gewisse Diversität gegeben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cc4eb9-1727-4ee6-b1a2-5276dd34642b",
                                                "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                                "text": "Er achtet darauf, sich vielseitig zu ernähren."
                                            },
                                            {
                                                "example_id": "16ef2ab8-e053-4091-8414-0a4e05024e06",
                                                "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                                "text": "Sie ist sehr vielseitig: Sie spricht drei Sprachen, betreibt mehrere Sportarten, spielt Geige und interessiert sich für Archäologie und Altertumsforschung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "aus vielen Seiten bestehend"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36821ed5-7033-44a6-b10c-d9c20d4a69f7",
                                                "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                                "text": "Der Stein war zu einem vielseitigen Polyeder geschliffen."
                                            },
                                            {
                                                "example_id": "6069de63-142c-4685-aa3d-5ace38a938ca",
                                                "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                                "text": "„Für die vorliegende Arbeit werden daher vielseitige Prismen verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "286cccfe-fba8-3b0e-ba6d-fa5043894d1c",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "mehrere Partnern/alle Beziehungen betreffend; mehrseitig, gegenseitig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be2412f-a1dd-47f0-98d1-38e58ab4ec9b",
                                                "sense_id": "286cccfe-fba8-3b0e-ba6d-fa5043894d1c",
                                                "text": "Sie schlossen ein vielseitiges Abkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "viele Seiten umfassend"
                                        ],
                                        "tags": [
                                            "von Büchern oder Schriftstücken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170e1590-60f7-4d18-8fe8-638755b16133",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "Das Familienministerium bringt eine vielseitige Broschüre heraus, in der die Unterstützungsmöglichkeiten für junge Mütter ausführlich erläutert werden."
                                            },
                                            {
                                                "example_id": "7fb90f0d-2602-4f29-af6a-9caf045f2b9f",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "Das vielseitige Begleitheft kann nicht geheftet werden. Es muss geklebt werden."
                                            },
                                            {
                                                "example_id": "27f46435-bab2-4a9a-8d75-d5669766734b",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "„Allein nur ihre Abbildungen zu zeigen und ihre Eigenschaften zu beschreiben, würde ein weiteres vielseitiges Buch füllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
