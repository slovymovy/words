                    "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                    "sense_definition": "Action de se nourrir ou ensemble des aliments consommés par un être vivant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bonne <w>alimentation</w> est essentielle pour rester en bonne santé.",
                            "target_lang_translations": {
                                "en": "A good <w>diet</w> is essential for staying healthy.",
                                "ru": "Хорошее <w>питание</w> необходимо для сохранения здоровья.",
                                "de": "Eine gute <w>Ernährung</w> ist unerlässlich, um gesund zu bleiben.",
                                "es": "Una buena <w>alimentación</w> es esencial para mantenerse sano.",
                                "zh": "良好的<w>饮食</w>对保持健康至关重要。"
                            }
                        },
                        {
                            "text": "Les médecins conseillent d'adopter une <w>alimentation</w> équilibrée dès le plus jeune âge.",
                            "target_lang_translations": {
                                "en": "Doctors advise adopting a balanced <w>diet</w> from a very young age.",
                                "ru": "Врачи советуют с самого раннего возраста придерживаться сбалансированного <w>питания</w>.",
                                "de": "Ärzte raten, schon im frühesten Kindesalter auf eine ausgewogene <w>Ernährung</w> zu achten.",
                                "es": "Los médicos aconsejan adoptar una <w>alimentación</w> equilibrada desde la más tierna infancia.",
                                "zh": "医生建议从幼年起就保持均衡的<w>饮食</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alimentation saine",
                        "alimentation équilibrée"
                    ],
                    "target_lang_definitions": {
