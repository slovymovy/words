{
    "word_family": [
        "puszkowy",
        "puszkarz",
        "puszkować",
        "puszeczka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b12307d-61c2-311f-a660-f5f2bc037019",
                    "sense_definition": "Metalowy, szczelnie zamykany pojemnik służący do przechowywania żywności, napojów, farb lub innych substancji.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eugenia kupiła dwie <w>puszki</w> karmy dla kotów.",
                            "target_lang_translations": {
                                "ru": "Евгения купила две <w>банки</w> кошачьего корма.",
                                "en": "Eugenia bought two <w>cans</w> of cat food."
                            }
                        },
                        {
                            "text": "Po wypiciu napoju zgnieć <w>puszkę</w> i wyrzuć ją do odpowiedniego pojemnika.",
                            "target_lang_translations": {
                                "ru": "Выпив напиток, сомните <w>банку</w> и выбросьте её в соответствующий контейнер.",
                                "en": "After drinking the beverage, crush the <w>can</w> and throw it into the appropriate bin."
                            }
                        }
                    ],
                    "synonyms": [
                        "blaszanka"
                    ],
                    "common_phrases": [
                        "puszka coli",
                        "puszka farby",
                        "puszka tuńczyka",
                        "puszka Pandory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический, герметично закрываемый контейнер для хранения продуктов, напитков, краски или других веществ.",
                        "en": "A metal, tightly sealed container used for storing food, drinks, paint, or other substances."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "контейнер"
                            },
                            {
                                "target_lang_word": "жестянка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "can",
                                "target_lang_sense_clarification": "metal container for food, drinks, or paint"
                            },
                            {
                                "target_lang_word": "tin",
                                "target_lang_sense_clarification": "metal container, especially British English"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25997fed-b057-3efa-9792-e90641033435",
                    "sense_definition": "Potoczne określenie piwa sprzedawanego w metalowym pojemniku.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beer_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Idę do sklepu po parę <w>puszek</w> na wieczór z kolegami.",
                            "target_lang_translations": {
                                "ru": "Иду в магазин за парой <w>банок</w> на вечер с друзьями.",
                                "en": "I'm heading to the store for a couple of <w>cans</w> for an evening with my friends."
                            }
                        },
                        {
                            "text": "Wypiliśmy po jednej zimnej <w>puszce</w>, oglądając mecz w telewizji.",
                            "target_lang_translations": {
                                "ru": "Мы выпили по одной холодной <w>банке</w>, смотря матч по телевизору.",
                                "en": "We each drank a cold <w>can</w> while watching the match on TV."
                            }
                        }
                    ],
                    "synonyms": [
                        "browar",
                        "piana"
                    ],
                    "common_phrases": [
                        "zimna puszka",
                        "otworzyć puszkę",
                        "wypić puszkę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название пива, продаваемого в металлической таре.",
                        "en": "Colloquial term for a can of beer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "пивная"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "can",
                                "target_lang_sense_clarification": "can of beer"
                            },
                            {
                                "target_lang_word": "tinnie",
                                "target_lang_sense_clarification": "informal, especially Australian"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dfa72bc-4cbc-399c-a0de-76fc88676e83",
                    "sense_definition": "Forma gramatyczna (dopełniacz liczby pojedynczej) rzeczownika <w>puszek</w> oznaczającego miękkie pióra lub włosy.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "form_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kurtka jest wypełniona naturalnym <w>puszkiem</w> gęsim, więc jest bardzo ciepła.",
                            "target_lang_translations": {
                                "ru": "Куртка наполнена натуральным гусиным <w>пухом</w>, поэтому она очень теплая.",
                                "en": "The jacket is filled with natural goose <w>down</w>, so it is very warm."
                            }
                        },
                        {
                            "text": "Dotknęła delikatnego <w>puszku</w> na głowie małego dziecka.",
                            "target_lang_translations": {
                                "ru": "Она коснулась нежного <w>пушка</w> на голове маленького ребенка.",
                                "en": "She touched the soft <w>fuzz</w> on the baby's head."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "dopełniacz liczby pojedynczej słowa 'puszek'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическая форма (родительный падеж единственного числа) существительного «puszek», означающего мягкие перья или волосы.",
                        "en": "Grammatical form (genitive singular) of the noun 'puszek', meaning soft down, fluff, or fuzz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушок",
                                "target_lang_sense_clarification": "пух"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "down",
                                "target_lang_sense_clarification": "soft fine feathers"
                            },
                            {
                                "target_lang_word": "fluff",
                                "target_lang_sense_clarification": "soft fibrous material or hair"
                            },
                            {
                                "target_lang_word": "fuzz",
                                "target_lang_sense_clarification": "short fine hair or down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "469840b9-5784-38f9-ae07-55f00eff4795",
                    "sense_definition": "Potoczne określenie zakładu karnego lub aresztu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prison_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej trafił do <w>puszki</w> na trzy lata za kradzież samochodu.",
                            "target_lang_translations": {
                                "ru": "Вор попал в <w>тюрягу</w> на три года за кражу автомобиля.",
                                "en": "The thief landed in <w>the can</w> for three years for stealing a car."
                            }
                        },
                        {
                            "text": "Nie chcę znowu wylądować w <w>puszce</w> za swoje błędy młodości.",
                            "target_lang_translations": {
                                "ru": "Я не хочу снова оказаться в <w>кутузке</w> за ошибки молодости.",
                                "en": "I don't want to end up in <w>the clink</w> again for the mistakes of my youth."
                            }
                        }
                    ],
                    "synonyms": [
                        "więzienie",
                        "ciupa",
                        "kić",
                        "pudło"
                    ],
                    "common_phrases": [
                        "trafić do puszki",
                        "siedzieć w puszce"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название исправительного учреждения или следственного изолятора.",
                        "en": "Colloquial or slang term for a prison or jail."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюряга",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "кутузка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "обезьянник",
                                "target_lang_sense_clarification": "камера предварительного заключения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "can",
                                "target_lang_sense_clarification": "slang for jail or prison"
                            },
                            {
                                "target_lang_word": "clink",
