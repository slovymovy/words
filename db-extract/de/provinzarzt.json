                "senses": [
                    {
                        "sense_id": "dd135893-2254-3bd3-9f80-bca132eed363",
                        "entry_id": "8c7b218d-fc07-36e0-91f1-f1c1ddb33f74",
                        "glosses": [
                            "in der Provinz arbeitender Mediziner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "986a8ee4-7476-4be3-99b3-4ded242bdeed",
                                "sense_id": "dd135893-2254-3bd3-9f80-bca132eed363",
                                "text": "„Schnell erwirbt sich der Provinzarzt [Josef Issels] weit über die Stadtgrenzen hinaus den Ruf eines Krebsspezialisten.“"
                            },
                            {
                                "example_id": "6e1f7b09-5134-4e3c-bc2c-b29d4cd1cc9d",
                                "sense_id": "dd135893-2254-3bd3-9f80-bca132eed363",
                                "text": "„Gutmeinende Kollegen warnten den deutschen Provinzarzt [Werner Forßmann] aus Eberswalde, er könne wegen seiner Experimente durchaus eine Karriere im Zuchthaus beginnen.“"
                            },
                            {
                                "example_id": "3f251090-d863-465d-91fe-0dcd62556fb1",
                                "sense_id": "dd135893-2254-3bd3-9f80-bca132eed363",
                                "text": "„Hassan Abdi, Provinzarzt in Nordostkenia, hält eine besondere Form von Malaria für die mögliche Ursache der Seuche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
