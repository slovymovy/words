{
    "word_family": [
        "onafhankelijkheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ce0c936-c8f0-3cc9-abf1-d4f33559f811",
                    "sense_definition": "Niet onder invloed of gezag van anderen staand; zelfstandig.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het land werd in 1990 eindelijk <w>onafhankelijk</w>.",
                            "target_lang_translations": {
                                "en": "The country finally became <w>independent</w> in 1990.",
                                "ru": "Страна наконец стала <w>независимой</w> в 1990 году.",
                                "fr": "Le pays est enfin devenu <w>indépendant</w> en 1990."
                            }
                        },
                        {
                            "text": "Zij wil financieel <w>onafhankelijk</w> zijn van haar ouders.",
                            "target_lang_translations": {
                                "en": "She wants to be financially <w>independent</w> of her parents.",
                                "ru": "Она хочет быть финансово <w>независимой</w> от своих родителей.",
                                "fr": "Elle veut être financièrement <w>indépendante</w> de ses parents."
                            }
                        }
                    ],
                    "synonyms": [
                        "zelfstandig",
                        "autonoom"
                    ],
                    "antonyms": [
                        "afhankelijk"
                    ],
                    "common_phrases": [
                        "financieel onafhankelijk",
                        "onafhankelijk worden"
                    ],
                    "target_lang_definitions": {
                        "en": "Not under the influence or authority of others; self-reliant.",
                        "ru": "Не находящийся под влиянием или властью других; самостоятельный.",
                        "fr": "Qui n'est pas soumis à l'influence ou à l'autorité d'autrui ; autonome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "not subject to authority or control"
                            },
                            {
                                "target_lang_word": "autonomous",
                                "target_lang_sense_clarification": "self-governing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "политически или финансово"
                            },
                            {
                                "target_lang_word": "самостоятельный",
                                "target_lang_sense_clarification": "лично"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "indépendant",
                                "target_lang_sense_clarification": "qui ne dépend pas d'autrui ou d'un pouvoir"
                            },
                            {
                                "target_lang_word": "autonome",
                                "target_lang_sense_clarification": "qui a son autonomie propre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66b4477f-1916-3e48-b669-e99c2b946d41",
                    "sense_definition": "Geen verbinding hebbend met iets anders; losstaand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De linker en rechter vering is <w>onafhankelijk</w> van elkaar te verstellen.",
                            "target_lang_translations": {
                                "en": "The left and right suspension can be adjusted <w>independently</w> of each other.",
                                "ru": "Левую и правую подвеску можно регулировать <w>независимо</w> друг от друга.",
                                "fr": "Les suspensions gauche et droite peuvent être réglées <w>indépendamment</w> l'une de l'autre."
                            }
                        },
                        {
                            "text": "Dit systeem werkt volledig <w>onafhankelijk</w> van het internet.",
                            "target_lang_translations": {
                                "en": "This system works completely <w>independently</w> of the internet.",
                                "ru": "Эта система работает полностью <w>независимо</w> от интернета.",
                                "fr": "Ce système fonctionne de manière totalement <w>indépendante</w> d'Internet."
                            }
                        }
                    ],
                    "synonyms": [
                        "losstaand"
                    ],
                    "antonyms": [
                        "afhankelijk"
                    ],
                    "common_phrases": [
                        "onafhankelijk van elkaar"
                    ],
                    "target_lang_definitions": {
                        "en": "Having no connection with something else; separate.",
                        "ru": "Не имеющий связи с чем-либо другим; отдельный.",
                        "fr": "Sans lien ni dépendance avec autre chose ; séparé ou autonome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "separate; not connected to other parts"
                            },
                            {
                                "target_lang_word": "separate",
                                "target_lang_sense_clarification": "disconnected or distinct"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "отдельный, несвязанный"
                            },
                            {
                                "target_lang_word": "автономный",
                                "target_lang_sense_clarification": "технически"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "indépendant",
                                "target_lang_sense_clarification": "séparé, sans connexion"
                            },
                            {
                                "target_lang_word": "indépendamment",
                                "target_lang_sense_clarification": "de façon séparée ou distincte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01f37cde-32cb-38fb-bfab-a54727f681dc",
                    "sense_definition": "Zonder rekening te houden met specifieke omstandigheden; ongeacht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen is welkom, <w>onafhankelijk</w> van leeftijd of afkomst.",
                            "target_lang_translations": {
                                "en": "Everyone is welcome, <w>regardless</w> of age or background.",
                                "ru": "Приветствуются все, <w>независимо</w> от возраста или происхождения.",
                                "fr": "Tout le monde est bienvenu, <w>indépendamment</w> de l'âge ou de l'origine."
                            }
                        },
                        {
                            "text": "De beslissing wordt genomen <w>onafhankelijk</w> van de kosten.",
                            "target_lang_translations": {
                                "en": "The decision is made <w>irrespective</w> of the costs.",
                                "ru": "Решение принимается <w>независимо</w> от расходов.",
                                "fr": "La décision est prise <w>indépendamment</w> des coûts."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongeacht"
                    ],
                    "antonyms": [
                        "afhankelijk"
                    ],
                    "common_phrases": [
                        "onafhankelijk van"
                    ],
                    "target_lang_definitions": {
                        "en": "Without taking specific circumstances into account; regardless.",
                        "ru": "Не принимая во внимание конкретные обстоятельства; невзирая на.",
                        "fr": "Sans tenir compte de circonstances particulières ; quel que soit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regardless",
                                "target_lang_sense_clarification": "without considering specific conditions"
                            },
                            {
                                "target_lang_word": "irrespective",
                                "target_lang_sense_clarification": "not taking into account"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "независимо",
                                "target_lang_sense_clarification": "в сочетании 'независимо от'"
                            },
                            {
                                "target_lang_word": "вне зависимости",
                                "target_lang_sense_clarification": "фразовый предлог"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "indépendamment de",
                                "target_lang_sense_clarification": "sans égard à, sans tenir compte de"
                            },
                            {
                                "target_lang_word": "peu importe",
                                "target_lang_sense_clarification": "quel que soit, sans considération de"
                            }
                        ]
                    }
                }
            ]
        },
        {
