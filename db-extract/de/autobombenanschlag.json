                "senses": [
                    {
                        "sense_id": "c8e4e342-76b9-3371-9069-89827e528705",
                        "entry_id": "af930e1f-3d64-3f97-8bc5-21492561cf29",
                        "glosses": [
                            "Attentat mit in einem Fahrzeug befindlichen Sprengsatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71807e50-a5e0-48b2-b484-87f9dd28fdef",
                                "sense_id": "c8e4e342-76b9-3371-9069-89827e528705",
                                "text": "„Eines der Ziele des Anschlags war General Miguel Maza, der den Autobombenanschlag im Mai wie durch ein Wunder überlebt hatte.“"
                            },
                            {
                                "example_id": "9e250266-b7da-445c-ae71-2650fb02ff56",
                                "sense_id": "c8e4e342-76b9-3371-9069-89827e528705",
                                "text": "„Im Juli 1972 wurde Kanafani zusammen mit seiner siebzehnjährigen Nichte Lamis Najm durch einen Autobombenanschlag des Mossad ermordet.“"
                            },
                            {
                                "example_id": "09638063-d757-44d2-b26e-70b495195862",
                                "sense_id": "c8e4e342-76b9-3371-9069-89827e528705",
                                "text": "„Bereits im März wurden Wohnquartiere der Revolutionsgardisten im Stadtzentrum von Baalbek Ziel eines Autobombenanschlags mit 200 Kilogramm Sprengstoff, wobei jedoch kaum Schaden entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
