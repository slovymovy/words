                        ],
                        "form": "alambiquée"
                    },
                    {
                        "form_id": "dbf93f23-3728-4a70-935f-1733697ed793",
                        "entry_id": "d6807dc7-d3de-3f73-a84c-13e821def0f3",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "alambiquées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a804444-1f5d-322c-93bd-2f2f9926be57",
                        "entry_id": "d6807dc7-d3de-3f73-a84c-13e821def0f3",
                        "glosses": [
                            "Trop subtil, trop raffiné."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9dc117dd-1a48-4a48-913b-289b5611a7fa",
                                "sense_id": "4a804444-1f5d-322c-93bd-2f2f9926be57",
                                "text": "Le langage de l’Anglais dénote une connaissance approfondie du cœur et de la vie ; celui du Français brille d’un éclat léger, pimpant, éphémère ; l’Allemand rumine longtemps une phrase alambiquée dont le sens échappe à bien des gens ; […]."
                            },
                            {
                                "example_id": "26247523-a071-4594-bd4f-4efa12f8753e",
                                "sense_id": "4a804444-1f5d-322c-93bd-2f2f9926be57",
                                "text": "[…] Sébastien Chambot […] qui récolte des paquets de billets de mille avec des romans alambiqués et voluptueux, où il n’est question que de tortillements de la viande humaine saturée de cantharide."
                            }
                        ]
                    },
                    {
                        "sense_id": "629d2939-f13f-311a-9f2e-317194e12546",
                        "entry_id": "d6807dc7-d3de-3f73-a84c-13e821def0f3",
                        "glosses": [
                            "Tortueux, plein de contorsions."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "405c69c9-9dec-4b22-b989-0ca0dc0b066e",
                                "sense_id": "629d2939-f13f-311a-9f2e-317194e12546",
                                "text": "La narration, pour limpide qu'elle soit dans certaines pages superbes, vagabonde souvent dans des méandres où elle risque de perdre bien des lecteurs – d'autant plus que le style, empli de poésie, tend parfois à devenir alambiqué et exige une attention particulièrement vigilante."
                            },
                            {
                                "example_id": "71faa841-d674-45b4-b2f7-da385d3ba86c",
                                "sense_id": "629d2939-f13f-311a-9f2e-317194e12546",
                                "text": "Il chercha la page des jeux, plus précisément celle où se trouvaient les mots fléchés qu'il préférait aux mots croisés, ces derniers comportaient parfois des définitions alambiquées, voire tarabiscotées et qui ne tenaient qu'à un fil."
                            },
                            {
                                "example_id": "0c71e895-e2de-42a3-b442-74e979db1d45",
                                "sense_id": "629d2939-f13f-311a-9f2e-317194e12546",
                                "text": "Elle-même défend une formule alambiquée de « partenariat douanier » dans lequel le Royaume-Uni percevrait les droits de douane pour le compte de l’UE, mais verserait une ristourne lorsque les biens demeurent sur le sol britannique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13301585-0c74-46f2-b86a-24057ec2c843",
                        "source_entry_id": "d6807dc7-d3de-3f73-a84c-13e821def0f3",
                        "target_lang_word": "ingewikkeld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingewikkeld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4062e8-b49a-3c4f-b645-b769776bbba4",
                                        "entry_id": "73d029ac-8b3d-3ddf-8c17-fca7b59bfe53",
                                        "glosses": [
                                            "niet eenvoudig; uit veel verschillende onderdelen bestaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437d9ee7-8ea7-4f88-8446-d1c2ace7345b",
                                                "sense_id": "7c4062e8-b49a-3c4f-b645-b769776bbba4",
                                                "text": "De ingewikkeldste restauraties vinden in de oudere gedeeltes van het paleis plaats."
                                            },
                                            {
                                                "example_id": "c90c3a4a-a40c-4d24-9f1d-a4d55716242f",
                                                "sense_id": "7c4062e8-b49a-3c4f-b645-b769776bbba4",
                                                "text": "Dit ingewikkelde, logistieke gebeuren werd resupply genoemd. Zo zat er in elke doos ontbijt, lunch en avondeten, maar ook al mijn snacks, repen en noten voor onderweg en papieren landkaarten voor de volgende etappe, nieuw wc-papier en om de 700 kilometer een paar nieuwe schoenen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2bc6641-8e40-3563-8e1f-834f48fb16b4",
                                        "entry_id": "73d029ac-8b3d-3ddf-8c17-fca7b59bfe53",
                                        "glosses": [
                                            "moeilijk te begrijpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579dfc49-5844-4948-80aa-10b045c6ebf8",
                                                "sense_id": "b2bc6641-8e40-3563-8e1f-834f48fb16b4",
                                                "text": "De eerste vijf maanden waren probleemloos voorbijgevlogen, maar nu mijn thuiskomst naderde was hij er wel klaar mee, papa moest naar huis komen. Ik had hem ook gemist en verlangde ernaar hem weer in mijn armen vast te houden. Misschien nog ingewikkelder was het toen het uitging met mijn oudste dochter en haar vriendje."
                                            },
                                            {
                                                "example_id": "90378cb9-fd7d-49b2-8d96-d10df0de811a",
                                                "sense_id": "b2bc6641-8e40-3563-8e1f-834f48fb16b4",
                                                "text": "Niemand sprak Martina tegen en het vervolg van de discussie werd zowel ingetogener als ingewikkelder, zoals toen ze de verschillen begonnen uit te spitten tussen objectieve en subjectieve redenen voor een Sovjetpoging om de hervormingspolitiek met geweld te stoppen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ingewikkeld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e5a66f-1a69-337e-ba5b-e075e27cfcd5",
                                        "entry_id": "7149c1c3-167a-3c9c-94fd-b92c373ced3f",
                                        "glosses": [
                                            "voltooid deelwoord van inwikkelen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0a4d2d-6432-4ac4-a6fe-3103476ec70d",
                                                "sense_id": "d8e5a66f-1a69-337e-ba5b-e075e27cfcd5",
                                                "text": "In het begin werden de lijken in linnen ingewikkeld en in een rieten of houten doodskist gelegd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
