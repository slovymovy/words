                ],
                "senses": [
                    {
                        "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                        "entry_id": "75b37d1e-b350-314e-a011-ce2d3c382126",
                        "glosses": [
                            "kleine Uhr, die in einer Tasche der Kleidung (Westentasche) getragen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4356fd2-5156-47e5-b4d7-44772c29b55f",
                                "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                                "text": "Taschenuhren hängen meist an einer Kette und waren schon früher bekannt."
                            },
                            {
                                "example_id": "9d4e12e3-2314-463c-aa63-e497295752e0",
                                "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                                "text": "„Smoaks zog seine Taschenuhr hervor.“"
                            },
                            {
                                "example_id": "1da5a2c4-8689-4c57-8294-37a207373c0e",
                                "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                                "text": "„Auch wir beschlossen, das unsere zu verstecken, obwohl es nur aus meines Vaters goldener Taschenuhr und 5000 Zł bestand.“"
                            },
                            {
                                "example_id": "1cbd74b0-1b7d-4870-951a-50a0f3005544",
                                "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                                "text": "„Nach der Mahlzeit besah sich der Ingenieur den Sonnenstand und stellte seine Taschenuhr danach ein.“"
                            },
                            {
                                "example_id": "f9bea082-5ca1-46f2-a029-5a22001b775e",
                                "sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
                                "text": "„Die Spieluhr entstand im ersten Jahrzehnt des 16. Jahrhunderts, in einer Epoche, als Nürnberg das deutsche und europäische Zentrum der Feinmechanik war und Peter Henlein seine Taschenuhren montierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5f11e67-d9ae-4f64-bd6f-00e3486d5860",
                        "source_entry_id": "75b37d1e-b350-314e-a011-ce2d3c382126",
                        "source_sense_id": "8e810f4b-e457-316c-b4b7-d594d32c9993",
