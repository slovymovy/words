                        "entry_id": "009d3fd3-0322-34e5-b2bd-cfd0851cf992",
                        "glosses": [
                            "The property of being rare; rarity"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad2689c-aa62-4ef9-a843-882b32d204a4",
                                "sense_id": "d426d5bb-0257-32ed-a9f0-5e68057a926c",
                                "text": "We discussed the rareness of the coin and decided it was actually pretty common."
                            },
                            {
                                "example_id": "c177d0fe-7488-4bb0-9451-729f9f7cb4f3",
                                "sense_id": "d426d5bb-0257-32ed-a9f0-5e68057a926c",
                                "text": "The patron sent back the steak because he objected to its rareness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30843c3a-3f21-4de5-9b48-f90cf9252173",
