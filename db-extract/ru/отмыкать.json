                "senses": [
                    {
                        "sense_id": "fe8557fb-4310-341c-9c1f-36045d17a03d",
                        "entry_id": "0d7c871f-ec33-3633-bee3-8677d30e3e45",
                        "glosses": [
                            "прост. открывать что-либо, запертое"
