                        "entry_id": "7e5d0f22-dad7-312c-9787-c89d8a7dee5f",
                        "glosses": [
                            "A whip."
                        ],
                        "tags": [
                            "colloquial",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "1fe49722-300a-476f-9703-ffa0b38ed826",
                                "sense_id": "871e3236-0ef4-3cdf-98f9-7fcc3a1b2fad",
                                "text": "Whup (hwup). Negro for whip."
                            },
                            {
                                "example_id": "11e99b2c-e62c-40ea-b746-662c578f7217",
                                "sense_id": "871e3236-0ef4-3cdf-98f9-7fcc3a1b2fad",
                                "text": "“You jus’ min’ your business, mister,” Ma said fiercely. “You’ll git a whup yourself. Now leggo, Ruthie.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
