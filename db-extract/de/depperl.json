                    {
                        "sense_id": "ac92c749-ec2d-30a8-89e0-edda406cc19b",
                        "entry_id": "7832277c-7c24-333c-9f20-201464b1ab5c",
                        "glosses": [
                            "unwissende, ungeschickte Person"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "5113f8e1-3cf0-44dc-9c29-9c9fff17500d",
                                "sense_id": "ac92c749-ec2d-30a8-89e0-edda406cc19b",
                                "text": "Es ist zu einfach, alle Kinder als Depperln zu bezeichnen, die in der Schule nicht mitkommen – vielleicht sollte an den Lehrkonzepten gearbeitet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1010e22a-acb5-3d0e-a7ef-c8820e5e04f2",
                        "entry_id": "7832277c-7c24-333c-9f20-201464b1ab5c",
                        "glosses": [
                            "leicht geistig Behinderter; Person, die geistig etwas zurückgeblieben ist"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "aba409e3-65ec-4293-a0f1-0d895b12c831",
                                "sense_id": "1010e22a-acb5-3d0e-a7ef-c8820e5e04f2",
                                "text": "Ihr Kind ist zwar ein Depperl, aber sie würde es für kein Geld der Welt hergeben wollen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
