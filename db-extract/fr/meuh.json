                                                "sense_id": "2f776eb7-891d-358f-b45c-8594b5eb6ab1",
                                                "text": "De toegangsdeur der boe zit dus ter zijde en wel dicht bij het woninggedeelte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc9ddc64-0b47-390b-b3c2-d0a041df8ac2",
                                        "entry_id": "a911f50c-655d-347f-a7b1-b35bd8e9cab0",
                                        "glosses": [
                                            "aanspreekvorm voor oudere of zorgzame Indonesische vrouw als lid van de huishouding"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f01f93e-0343-4da7-9bd8-d6bf1dba2026",
                                                "sense_id": "bc9ddc64-0b47-390b-b3c2-d0a041df8ac2",
                                                "text": "In 1917 werd een variant van Hoogeveens leesplankje voor Nederlands-Indië uitgegeven. Hierop verscheen (weer van Jetses' hand, maar nu in een meer tropische sfeer) onder meer een ‘oom’ met tropenpak en -hoed, een huis met een grote veranda en een lieve Indonesische ‘boe’ (baboe)."
                                            }
                                        ]
                                    }
                                ]
