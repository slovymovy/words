                                        "sense_id": "a200d5b7-af62-3e03-a55f-58b5f771faad",
                                        "entry_id": "c187693e-f1c8-30fe-ad9f-207286496be1",
                                        "glosses": [
                                            "To plan or achieve (a goal) by contrivance or guile; to finagle, to wangle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
