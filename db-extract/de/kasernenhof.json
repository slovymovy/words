                        "examples": [
                            {
                                "example_id": "6f2dfa7e-1815-4423-9c45-15e2a4270d48",
                                "sense_id": "cb8cc4f8-dd7e-32b6-87a2-b292587fc48b",
                                "text": "„Auf den Kasernenhöfen riefen sie ein rebellisches, wildes Begehren hervor, da waren sie noch mit uns verbunden, wir gehörten zu ihnen und sie zu uns, wenn wir auch getrennt waren.“"
                            },
                            {
                                "example_id": "fa0e8ff3-4df0-45ed-9e20-e6c0b6ad3ba7",
                                "sense_id": "cb8cc4f8-dd7e-32b6-87a2-b292587fc48b",
                                "text": "„Wir gingen auf den Kasernenhof hinaus.“"
                            },
                            {
                                "example_id": "fa113456-4188-40b5-aa95-7a0360cf1045",
                                "sense_id": "cb8cc4f8-dd7e-32b6-87a2-b292587fc48b",
                                "text": "„Graeber blickte durch das Fenster auf den Kasernenhof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
