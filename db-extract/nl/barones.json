                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27610c71-0293-4a15-ad05-f5ff91f7163b",
                                "sense_id": "30d666dd-8926-3fd4-9cde-3d58ed7aa79a",
                                "text": "Een barones is lager in rang dan een gravin."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f443c36-4a9a-3309-9d98-57d8bcc9da9c",
                        "entry_id": "06796dc1-eb44-331e-ad05-6a6109b85f1b",
                        "glosses": [
