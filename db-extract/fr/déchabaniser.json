                "senses": [
                    {
                        "sense_id": "458df228-b377-32fa-93f3-b84eee45ef0a",
                        "entry_id": "46c3f22e-b7e7-34b7-a797-e1d8f91d58fe",
                        "glosses": [
                            "Faire perdre son caractère rappelant Jacques Chaban-Delmas à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab7d34a-5cf7-4c50-8a88-31085ac30202",
                                "sense_id": "458df228-b377-32fa-93f3-b84eee45ef0a",
                                "text": "Un petit purgatoire pour le « déchabaniser »."
                            },
                            {
                                "example_id": "8313cebe-6011-4f06-8229-05047bac027d",
                                "sense_id": "458df228-b377-32fa-93f3-b84eee45ef0a",
                                "text": "Il est vrai qu’en poussant à son terme une chasse à l’homme engagée de longue date, tant par le Front national que par une fraction de la gauche bordelaise, il trouvait là l’opportunité de « déchabaniser » à bon compte sa politique culturelle et de rassasier un populisme latent."
                            }
                        ]
                    }
