                                "target_lang_sense_clarification": "perform an action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "297fedb7-3372-37da-ac4a-9988f009605d",
                    "sense_definition": "postępować w określony sposób, działać etycznie lub moralnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "działanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta fundacja od wielu lat bezinteresownie <w>czyni</w> dobro potrzebującym.",
                            "target_lang_translations": {
                                "en": "For many years, this foundation has selflessly been <w>doing</w> good for those in need."
                            }
                        },
                        {
                            "text": "Dlaczego <w>czynisz</w> zło ludziom, którzy zawsze byli wobec ciebie życzliwi?",
                            "target_lang_translations": {
                                "en": "Why do you <w>do</w> evil to people who have always been kind to you?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "czynić dobro",
                        "czynić zło"
                    ],
                    "target_lang_definitions": {
                        "en": "to act in a moral or ethical manner; to do good or evil"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "good or evil"
                            },
                            {
                                "target_lang_word": "commit",
                                "target_lang_sense_clarification": "evil, wrongs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a00c279-e549-33fc-8d18-e6f823c1381f",
                    "sense_definition": "powodować, sprawiać, że ktoś lub coś staje się jakieś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skutek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Codzienny uśmiech i życzliwość <w>czynią</w> życie znacznie przyjemniejszym.",
                            "target_lang_translations": {
