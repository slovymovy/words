                                                "sense_id": "b712383d-eea6-30b8-a882-dd250407ead3",
                                                "text": "Cette crème a un effet tenseur et raffermissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e33dfe1-1edf-3339-9f1b-6adf80092531",
                                        "entry_id": "a5d5f528-5b09-3a0d-9b2e-9f0bc576f51e",
                                        "glosses": [
                                            "Muscle qui produit la tension d’une structure anatomique. → voir extenseur"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3109e8-0a95-4496-8796-b18ad6c38c4a",
                                                "sense_id": "6e33dfe1-1edf-3339-9f1b-6adf80092531",
                                                "text": "Le muscle tenseur du voile du palais en assure la mobilité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tenseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d26e2e4c-7cda-362c-9cdb-0604dc97c892",
                                        "entry_id": "0a2e4e13-7580-3752-a42c-05f874713ca4",
                                        "glosses": [
                                            "Élément de l’algèbre tensorielle d’un espace vectoriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4050214b-65d8-418d-a570-4416970a2b7d",
                                                "sense_id": "d26e2e4c-7cda-362c-9cdb-0604dc97c892",
                                                "text": "En géométrie différentielle, une métrique riemannienne, parfois appelée tenseur métrique, est un tenseur de rang 2 utilisé pour la mesure des distances et des angles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1edafd1-37c4-3619-b701-46f2f95cabe4",
                                        "entry_id": "0a2e4e13-7580-3752-a42c-05f874713ca4",
                                        "glosses": [
                                            "Représentation de l’état de contrainte et de déformation que subit un solide lorsqu’il est soumis à des forces et des moments : → voir tenseur des contraintes et tenseur des déformations."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0bf1e6c-ac38-4315-a417-d6f6abe47ea5",
                                                "sense_id": "a1edafd1-37c4-3619-b701-46f2f95cabe4",
                                                "text": "Le tenseur des contraintes est une représentation utilisée en mécanique des milieux continus pour représenter les forces surfaciques (efforts) mises en jeu au sein d’une portion déformée du milieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
