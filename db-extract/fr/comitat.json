                                "target_senses": [
                                    {
                                        "sense_id": "92eb45f7-a472-3a9c-904c-fe6e2f118041",
                                        "entry_id": "3bfabd79-4eca-3659-8f50-377cc8610191",
                                        "glosses": [
                                            "The land ruled by a count or a countess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35477c3a-067e-4401-954a-cf185dbb4452",
                                                "sense_id": "92eb45f7-a472-3a9c-904c-fe6e2f118041",
                                                "text": "The first of the principalities of the Low Countries to take clear shape was the county of Flanders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f732ca2c-7eec-31c3-923e-0a8a6f6a5cf2",
                                        "entry_id": "3bfabd79-4eca-3659-8f50-377cc8610191",
                                        "glosses": [
                                            "An administrative or geographical region of various countries, including Bhutan, Canada, China, Croatia, Ireland, Japan, New Zealand, Norway, Poland, Romania, South Korea, Sweden, the United Kingdom, and 47 of the 50 United States (excluding Alaska, Connecticut, and Louisiana)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d515da8-5e5b-4b40-b73f-635d2070c5a7",
                                                "sense_id": "f732ca2c-7eec-31c3-923e-0a8a6f6a5cf2",
                                                "text": "Entire states such as California, Illinois and New York are now sanctuaries, as well as major cities and counties such as Fairfax, Montgomery and Prince George’s counties and the District of Columbia in the capital region, according to the list. […] FAIR says the county is a sanctuary because it tells police not to ask about immigration status even during an arrest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bfb78d-f31a-3876-85a6-dd3a1b563e73",
                                        "entry_id": "3bfabd79-4eca-3659-8f50-377cc8610191",
                                        "glosses": [
                                            "A definitive geographic region, without direct administrative functions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c9b42c-963a-4c70-8211-0b55987589b4",
                                                "sense_id": "d7bfb78d-f31a-3876-85a6-dd3a1b563e73",
                                                "text": "traditional county"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af2ba010-0b52-3662-8c5d-c72667ffad03",
                                        "entry_id": "3bfabd79-4eca-3659-8f50-377cc8610191",
                                        "glosses": [
                                            "A jail operated by a county government."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85a7b67-8933-4c9a-961b-e86d8b778da3",
                                                "sense_id": "af2ba010-0b52-3662-8c5d-c72667ffad03",
                                                "text": "He can't come; he's up in the county for agg assault."
                                            },
                                            {
                                                "example_id": "21bf85fc-4bab-4ddc-b9ab-51e803a1f38c",
                                                "sense_id": "af2ba010-0b52-3662-8c5d-c72667ffad03",
                                                "text": "Okay gentlemen, you've both been to county before, I'm sure. Here it comes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "county",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                                        "entry_id": "1f07e889-22bc-3ac6-be49-890ccbb13845",
                                        "glosses": [
                                            "Characteristic of a ‘county family’; representative of the gentry or aristocracy of a county."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22de72e7-283c-463d-89f6-1e78bc78746f",
                                                "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                                                "text": "Now, in the district around Chipping Carby, the County Families are very County indeed, few more so."
                                            },
                                            {
                                                "example_id": "ea7ae549-4557-429d-8ce9-338e933f9849",
                                                "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                                                "text": "She was a tall girl and county, with Hilary's walk: she seemed to topple even when she sat."
                                            },
                                            {
                                                "example_id": "2b5d58c8-aa0e-4703-95a3-e53e41e0e682",
                                                "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                                                "text": "The other two, like many of her characters, have fallen on harder times: Joan's family has recently lost her father, a small flour-mill owner -- described by a supporter as more \"county\" than the upstart newcomers who covet their property ..."
                                            },
                                            {
                                                "example_id": "50bcad16-d006-4f56-a474-badc3837b60a",
                                                "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                                                "text": "Susan Dean realises that her secretary, Eleanor Grantly, is much more county than she ever will be, because Eleanor knows all the Barsetshire family connections and is connected herself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
