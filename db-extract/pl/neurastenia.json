                            {
                                "target_word": "neurasthénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79e3501b-1226-363e-951b-eade2f91f594",
                                        "entry_id": "e8e7377c-928b-3985-a45d-d8998b7d16f8",
                                        "glosses": [
                                            "Trouble plus ou moins durable du système nerveux, qui se manifeste soit par de la dépression, soit par de la surexcitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56a5068-44f2-422d-ad1e-7ee91dd32096",
                                                "sense_id": "79e3501b-1226-363e-951b-eade2f91f594",
                                                "text": "Balzac ne s’est pas reposé le septième jour. Quel exemple pour nos chétives neurasthénies ! Et il n’a vécu que cinquante et un ans !…"
                                            },
                                            {
                                                "example_id": "efe01383-cf48-429c-91d3-69a710ab9223",
                                                "sense_id": "79e3501b-1226-363e-951b-eade2f91f594",
                                                "text": "Les ennuis d’argent et les difficultés professionnelles achevèrent de ruiner la santé du docteur, le plongeant dans un état voisin de la neurasthénie."
                                            },
                                            {
                                                "example_id": "4020b8de-9f68-4057-983c-b7254cbea686",
                                                "sense_id": "79e3501b-1226-363e-951b-eade2f91f594",
                                                "text": "La neurasthénie est un état de dépression non déclarée, une dépression sans crise de dépression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a28700-7596-3bd1-b574-f581265ecacb",
                                        "entry_id": "e8e7377c-928b-3985-a45d-d8998b7d16f8",
                                        "glosses": [
                                            "Inactivité, endormissement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ed7ee1-2517-4d70-8b8e-1b975cf3a2d0",
                                                "sense_id": "b9a28700-7596-3bd1-b574-f581265ecacb",
                                                "text": "En cela le Musulman métaphysique à la fois nourrit et résorbe la neurasthénie européenne."
                                            },
                                            {
                                                "example_id": "b0167149-a717-4bd4-8cc8-97a6398f7dcd",
                                                "sense_id": "b9a28700-7596-3bd1-b574-f581265ecacb",
                                                "text": "Ces derniers temps, néanmoins, Ondriane souffrait d’une certaine forme de neurasthénie qui faisait pâlir son doux visage et privait les siens de son sourire."
                                            },
                                            {
                                                "example_id": "367ed357-95f2-4c96-bd46-0948e5f4fff0",
                                                "sense_id": "b9a28700-7596-3bd1-b574-f581265ecacb",
                                                "text": "Les mères étouffaient leur douleur sous le masque blanc de la neurasthénie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
