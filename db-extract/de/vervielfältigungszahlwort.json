                "senses": [
                    {
                        "sense_id": "916dceed-cbca-3c8e-832a-4bc12d4c4e55",
                        "entry_id": "9b5e28e6-902d-3a81-a778-91edcb0db04e",
                        "glosses": [
                            "ein Zahlwort, das mit Adverbsuffix -fach und -mal angibt, wie häufig etwas vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e0593c1-a1fd-45e0-92c1-9c45228dad28",
                                "sense_id": "916dceed-cbca-3c8e-832a-4bc12d4c4e55",
                                "text": "„Die bestimmten Vervielfältigungszahlwörter werden aus der Kardinalzahl mit der Nachsilbe ›-fach‹ gebildet: ›dreifach‹, ›hundertfach‹, ›tausendfach‹.“"
                            },
                            {
                                "example_id": "086ad6a9-944f-4f4e-a369-11df91717ab0",
                                "sense_id": "916dceed-cbca-3c8e-832a-4bc12d4c4e55",
                                "text": "„Das Suffix -ple findet sich in Vervielfältigungszahlwörtern wieder, die Anzahl der Bildungen ist jedoch gering und die Unregelmäßigkeiten sind zahlreich[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
