                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men <w>beide</w> zijn tijd in geduld tot er betere tijden aanbreken.",
                            "target_lang_translations": {
                                "ru": "Пусть <w>ждет</w> своего часа в терпении, пока не наступят лучшие времена.",
                                "en": "Let one <w>bide</w> his time in patience until better times arrive.",
                                "pl": "Niechaj człowiek w cierpliwości <w>czeka</w> na swój czas, aż nadejdą lepsze dni.",
                                "de": "Man <w>harre</w> seiner Zeit in Geduld, bis bessere Zeiten anbrechen.",
                                "fr": "Qu'on <w>attende</w> son heure avec patience jusqu'à ce que des temps meilleurs arrivent.",
                                "it": "Che si <w>aspetti</w> il proprio momento con pazienza finché non arriveranno tempi migliori.",
                                "cs": "Nechť člověk v trpělivosti <w>vyčká</w> svého času, dokud nenastanou lepší časy.",
                                "tr": "Kişi, daha iyi günler gelene kadar sabırla vaktini <w>beklesin</w>.",
                                "es": "Que uno <w>aguarde</w> su momento con paciencia hasta que lleguen tiempos mejores."
                            }
                        },
                        {
                            "text": "Hij <w>beide</w> het juiste moment af alvorens te spreken.",
                            "target_lang_translations": {
                                "ru": "Он <w>выжидал</w> подходящего момента, прежде чем заговорить.",
                                "en": "He <w>awaited</w> the right moment before speaking.",
                                "pl": "On <w>wyczekiwał</w> odpowiedniego momentu, zanim zaczął mówić.",
                                "de": "Er <w>wartete</w> den richtigen Moment ab, bevor er sprach.",
                                "fr": "Il <w>attendait</w> le bon moment avant de parler.",
                                "it": "Egli <w>attese</w> il momento giusto prima di parlare.",
                                "cs": "Předtím než promluvil, <w>vyčkával</w> na správný okamžik.",
                                "tr": "Konuşmadan önce doğru anı <w>bekledi</w>.",
