                                                "sense_id": "226bb006-7b5b-3a60-8d9b-d6e4fefcdfc8",
                                                "text": "We hebben makaken gezien in de dierentuin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "746fa9d6-b5e4-3552-a699-033a4104b400",
