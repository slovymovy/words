                        ],
                        "examples": [
                            {
                                "example_id": "4c5e77ae-29ba-4a20-a58e-979111b6ba40",
                                "sense_id": "03735079-2585-3057-87f9-d374bd5e847e",
                                "text": "In den Verhandlungen kamen Dinge zur Sprache, die mir bewiesen, daß Charles nichts war, als ein gewissenloser Erbschleicher, der mit Hilfe der spiritistischen Sitzungen und des von ihm bestochenen Mediums meine Mutter seinen Wünschen gefügig gemacht hatte.",
                                "translation": "During the negotiations, things came up that proved to me that Charles was nothing but an unscrupulous legacy hunter who, with the help of the spiritualistic sessions and the medium he had bribed, had made my mother submissive to his wishes.",
                                "english": "During the negotiations, things came up that proved to me that Charles was nothing but an unscrupulous legacy hunter who, with the help of the spiritualistic sessions and the medium he had bribed, had made my mother submissive to his wishes."
                            }
                        ]
                    }
