                                        "entry_id": "978616a1-1aef-35d6-82d0-e93348cc9587",
                                        "glosses": [
                                            "To behave submissively."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ef72d4-f666-4722-a519-d92e2566bc30",
                                                "sense_id": "6a266654-d1b9-31d3-915d-b242d55285f6",
                                                "text": "\"They were wimping along and I was accomplished,\" she asserts with some pride and a touch of arrogance."
                                            }
                                        ]
