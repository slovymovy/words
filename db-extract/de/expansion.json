                                "example_id": "cf9acb74-3569-408a-8db4-04591d5fbcf8",
                                "sense_id": "3f3c3024-8289-3555-b005-f72e76ac25b3",
                                "text": "„Expansion. Substantivische Phraseolexeme aus Adjektiv + Substantiv (…) lassen eine adjektivisch-attributive Erweiterung zu…“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "da258d14-48c6-3178-b122-0e90fd786811",
                        "entry_id": "209c7866-486f-3360-af6a-f38075574821",
