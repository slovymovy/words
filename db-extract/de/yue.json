                "senses": [
                    {
                        "sense_id": "a280b303-bded-392a-9319-90029e826f7c",
                        "entry_id": "c6ce0d41-3bf7-34f5-92c1-6d79997f2020",
                        "glosses": [
                            "im Süden Chinas gesprochene Sprache; die kantonesische Sprache"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb227e6-75a5-4834-8172-472f11baeef2",
                                "sense_id": "a280b303-bded-392a-9319-90029e826f7c",
                                "text": "„Verschiedene Dialekte des Yue unterscheiden sich in einigen Eigenschaften des Tonsystems.“"
                            },
                            {
                                "example_id": "8729a4aa-bd54-4ee7-8fa7-2658644f8125",
                                "sense_id": "a280b303-bded-392a-9319-90029e826f7c",
                                "text": "„Immerhin dient auch in anderen chinesischen Dialekten wie etwa im Taiwanesischen, Hakka oder Yue das Lexem ‚geben‘ zur Passivierung[.]“"
                            },
                            {
                                "example_id": "734fb941-5e58-4c07-bc9d-04c605216901",
                                "sense_id": "a280b303-bded-392a-9319-90029e826f7c",
                                "text": "„Das Hochchinesische hat fünf Töne, der Schanghai-Dialekt (Wu) nur zwei ausgeprägte Töne, Kantonesisch (Yue, gesprochen in Guangdong und Hong Kong) hat sechs Töne, Min Nan hat sogar acht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
