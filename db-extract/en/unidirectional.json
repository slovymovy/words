                        "cross_references": [
                            {
                                "target_word": "unidirectionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                        "entry_id": "89889e9f-aa1b-318e-b466-b0b849fe6b89",
                                        "glosses": [
                                            "Qui n’exerce une action que dans un sens, dans une direction."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d3b2cf-b638-4224-b3c0-4d2b4a12bee7",
                                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                                "text": "Les orages multicellulaires sont ainsi associés à un cisaillement de vent unidirectionnel (la force du vent varie avec l'altitude, mais pas sa direction) alors que les supercellules ne peuvent se développer qu'en présence d'un cisaillement tournant (le vent varie à la fois en direction et en intensité avec l'altitude)."
                                            },
                                            {
                                                "example_id": "d985ea49-7da7-4695-815b-5b7d7c031d7d",
                                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l'axone."
                                            },
                                            {
                                                "example_id": "87396a3c-0362-41ef-95a4-32326e4d9ded",
                                                "sense_id": "fbb932ea-d6ea-3d5f-a799-8529c046ae89",
                                                "text": "Cette forme de communication unidirectionnelle et peu encline à la discussion et au débat n’est pas commune au sein du gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
