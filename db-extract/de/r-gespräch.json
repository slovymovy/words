                        "form": "das R-Gespräch"
                    },
                    {
                        "form_id": "c81b94f0-6fb3-4ebb-88b4-847b0e1de1ab",
                        "entry_id": "bdcd8c85-af00-3edb-9f64-a8a2d254a842",
                        "tags": [
                            "accusative",
                            "plural"
