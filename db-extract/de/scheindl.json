                "senses": [
                    {
                        "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                        "entry_id": "b081ec50-61d4-300f-9ef7-8258ae743020",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514ecb7b-09cd-452d-be70-5537b3103e49",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Frau Scheindl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a4bfa95d-d6e6-4108-b432-97c9f56e5ad4",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Herr Scheindl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c16d89d7-bbfe-4f9e-a339-a53227882563",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Die Scheindls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "98a331d3-bffd-4719-a267-b5bf6d5bda0f",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Der Scheindl trägt nie die Schals, die die Scheindl ihm strickt."
                            },
                            {
                                "example_id": "3ff97ad6-1c3f-468a-acac-05f2fd2a4881",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheindl kommt, geht der Herr Scheindl.“"
                            },
                            {
                                "example_id": "3c2c3862-2a4d-4491-b099-d086a125d17e",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Scheindl kommt und geht."
                            },
                            {
                                "example_id": "32905b5b-8286-48f5-9f6a-1e93010b8a9e",
                                "sense_id": "a90634f3-c3e1-3b1c-bf1f-768236d8efe7",
                                "text": "Scheindls kamen, sahen und siegten."
                            }
                        ],
