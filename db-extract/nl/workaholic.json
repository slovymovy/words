                                    {
                                        "sense_id": "ef7a8122-ffcb-3d9e-b73d-d4407c57c751",
                                        "entry_id": "397ad51d-488e-3946-8737-bc57fe50668d",
                                        "glosses": [
                                            "A person who feels compelled to work excessively, including while at home."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3bb9e5-2d2f-479a-a96e-395408f79139",
                                                "sense_id": "ef7a8122-ffcb-3d9e-b73d-d4407c57c751",
                                                "text": "All workaholics should move to Hong Kong, where working hours average over 50 per week."
                                            },
                                            {
                                                "example_id": "40d516f7-0cab-4ea5-8a93-7f5823644b9c",
                                                "sense_id": "ef7a8122-ffcb-3d9e-b73d-d4407c57c751",
                                                "text": "We're not looking to become workaholics who don't know how to rest or vacation, or who never hang it up long enough to go to a movie."
                                            }
                                        ]
                                    }
                                ]
                            },
