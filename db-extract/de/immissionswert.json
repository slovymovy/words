                "senses": [
                    {
                        "sense_id": "6955e1bc-33df-3788-9a3c-8f066b871b98",
                        "entry_id": "fd74b18b-55d1-3914-8d24-0ca044246e41",
                        "glosses": [
                            "amtlich festgelegter Grenzwert, bis zu dem luftfremde oder gesundheitsschädliche Stoffe in die Atmosphäre abgegeben werden dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b98b64a-e17e-4707-ab16-e17249be4bbc",
                                "sense_id": "6955e1bc-33df-3788-9a3c-8f066b871b98",
                                "text": "„Die 18. BImSchV geht bezüglich der Beurteilung nach Immissionswerten von der gesonderten Berücksichtigung definierter Ruhezeiten bzw. von Zeitblöcken aus.“"
                            },
                            {
                                "example_id": "c6acc29c-7158-4605-a0fb-5cbbd5c32e36",
                                "sense_id": "6955e1bc-33df-3788-9a3c-8f066b871b98",
                                "text": "„Der Immissionswert der Zeile \"Dorfgebiete\" gilt nur für Geruchsimmissionen, die durch Tierhaltungsanlagen verursacht sind.“"
                            },
                            {
                                "example_id": "c33bf3d2-b02b-48d1-87a8-65805bc96f96",
                                "sense_id": "6955e1bc-33df-3788-9a3c-8f066b871b98",
                                "text": "„Grenz-, Richt-, Leit-, Immissionswerte für die Immission von Schadstoffen in der Luft.“"
                            },
                            {
                                "example_id": "52aa6ec5-2a67-4135-a097-6b6b32b4c17e",
                                "sense_id": "6955e1bc-33df-3788-9a3c-8f066b871b98",
                                "text": "„Die nachfolgende Tabelle bietet einen Überblick über Immissionswerte zum Gesundheitsschutz, die zur Beurteilung der Luftqualität in verschiedenen Vorschriften und Richtlinien festgelegt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
