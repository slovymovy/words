            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ef0f4eb-491a-38a6-a640-c1335b1ab30b",
                    "sense_definition": "Een vriendelijke uitdrukking op het gezicht waarbij de mondhoeken omhoog krullen, meestal zonder geluid te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij begroette mij met een warme <w>glimlach</w>.",
                            "target_lang_translations": {
                                "ru": "Она поприветствовала меня теплой <w>улыбкой</w>.",
                                "en": "She greeted me with a warm <w>smile</w>.",
                                "pl": "Przywitała mnie ciepłym <w>uśmiechem</w>.",
                                "de": "Sie begrüßte mich mit einem herzlichen <w>Lächeln</w>.",
                                "fr": "Elle m'a accueilli avec un chaleureux <w>sourire</w>.",
                                "it": "Mi ha salutato con un caldo <w>sorriso</w>.",
                                "cs": "Přivítala mě s vřelým <w>úsměvem</w>.",
                                "tr": "Beni sıcak bir <w>gülümsemeyle</w> karşıladı.",
                                "es": "Ella me saludó con una cálida <w>sonrisa</w>."
                            }
                        },
                        {
                            "text": "Er verscheen een kleine <w>glimlach</w> op zijn gezicht toen hij het nieuws hoorde.",
                            "target_lang_translations": {
                                "ru": "На его лице появилась легкая <w>улыбка</w>, когда он услышал новости.",
                                "en": "A small <w>smile</w> appeared on his face when he heard the news.",
                                "pl": "Na jego twarzy pojawił się lekki <w>uśmiech</w>, kiedy usłyszał te wieści.",
                                "de": "Ein kleines <w>Lächeln</w> erschien auf seinem Gesicht, als er die Neuigkeiten hörte.",
                                "fr": "Un léger <w>sourire</w> est apparu sur son visage lorsqu'il a appris la nouvelle.",
                                "it": "Un piccolo <w>sorriso</w> è apparso sul suo viso quando ha sentito la notizia.",
                                "cs": "Když uslyšel tu zprávu, na tváři se mu objevil lehký <w>úsměv</w>.",
                                "tr": "Haberleri duyduğunda yüzünde küçük bir <w>gülümseme</w> belirdi.",
                                "es": "Una pequeña <w>sonrisa</w> apareció en su rostro cuando escuchó la noticia."
                            }
                        }
                    ],
                    "synonyms": [
                        "lach"
                    ],
                    "antonyms": [
                        "frons"
                    ],
                    "common_phrases": [
                        "een brede glimlach",
                        "met een glimlach",
                        "een flauwe glimlach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружелюбное выражение лица, при котором уголки рта приподнимаются, обычно без звука.",
                        "en": "A friendly expression on the face where the corners of the mouth curl up, usually without making a sound.",
                        "pl": "Przyjazny wyraz twarzy, w którym kąciki ust unoszą się do góry, zazwyczaj bez wydawania dźwięku.",
                        "de": "Ein freundlicher Gesichtsausdruck, bei dem sich die Mundwinkel nach oben wölben, meist ohne ein Geräusch zu machen.",
                        "fr": "Une expression amicale sur le visage où les coins de la bouche se courbent vers le haut, généralement sans faire de bruit.",
                        "it": "Un'espressione amichevole del viso in cui gli angoli della bocca si piegano verso l'alto, di solito senza emettere alcun suono.",
                        "cs": "Přátelský výraz tváře, při kterém se koutky úst zvedají nahoru, obvykle bez vydání zvuku.",
                        "tr": "Ağız kenarlarının yukarı kıvrılmasıyla oluşan, genellikle sessiz, dostça bir yüz ifadesi.",
                        "es": "Una expresión facial amistosa en la que las comisuras de los labios se curvan hacia arriba, generalmente sin emitir sonido."
                    },
