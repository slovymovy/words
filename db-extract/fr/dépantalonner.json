                ],
                "senses": [
                    {
                        "sense_id": "63c8e980-2f68-37e9-b525-95c56a173e51",
                        "entry_id": "e1a24b62-4016-3640-8875-7860c1708cc2",
                        "glosses": [
                            "Enlever son pantalon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e228c887-2086-4201-a452-75a09235c2dc",
                                "sense_id": "63c8e980-2f68-37e9-b525-95c56a173e51",
                                "text": "Et la femme-matador de te projeter sur un matelas fétide, de te dépantalonner à la vitement-pressé, comme si tu étais un gamin, de vérifier la propreté de ton prépuce avant de s’empaler en toi."
                            },
                            {
                                "example_id": "f28fc713-385a-4119-b94a-a1c96c644251",
                                "sense_id": "63c8e980-2f68-37e9-b525-95c56a173e51",
                                "text": "Vous étiez d’abord apprehendé, ensuite fouillé, déboursé, puis de la tête aux pieds deshabillé, C’est à sçavoir, débonneté, décapuchonné, décaloté, décasaqué, désoutané, décamisolé, dépantalonné, déchemisé, débragué, décalsonné, débâté, enfin meurtri, contusionné, navré, occis, & en cet état votre ennemi vent coulis pouvant vous souffler au derriere en toute liberté."
                            },
                            {
                                "example_id": "050ef468-0f17-4f56-b8f2-0580f37d6d81",
                                "sense_id": "63c8e980-2f68-37e9-b525-95c56a173e51",
                                "text": "Il entra pour se dépantalonner quand brusquement il les aperçut, se rhabilla en catastrophe et redescendit précipitamment."
                            }
                        ]
                    }
                ],
