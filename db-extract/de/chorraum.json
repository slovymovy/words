                    {
                        "translation_id": "fad3868a-ac98-4713-8fe1-e0db3935b0f7",
                        "source_entry_id": "ba25722e-4f73-365a-b0d8-55701722031c",
                        "source_sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                        "source_sense_description": "Altarraum in einer Kirche",
                        "target_lang_word": "chœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f287a01-a526-3afc-bd27-5828fd3a266d",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Troupe de gens qui chantent ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dc586e-8adb-4498-91a4-003e5bbc9582",
                                                "sense_id": "0f287a01-a526-3afc-bd27-5828fd3a266d",
                                                "text": "Un excellent chœur de musique."
                                            },
                                            {
                                                "example_id": "d39388a1-4f4d-421b-915d-5ff7018f4809",
                                                "sense_id": "0f287a01-a526-3afc-bd27-5828fd3a266d",
                                                "text": "La messe fut chantée à quatre chœurs de musique."
                                            },
                                            {
                                                "example_id": "d56d5d64-472c-4ee6-8897-b80f7fd72ef1",
                                                "sense_id": "0f287a01-a526-3afc-bd27-5828fd3a266d",
                                                "text": "Répéter en chœur."
                                            },
                                            {
                                                "example_id": "7ab14a5e-9755-4847-8ae2-450046608ace",
                                                "sense_id": "0f287a01-a526-3afc-bd27-5828fd3a266d",
                                                "text": "Ils nous ont tous répondu en chœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b46ce0d1-42a6-393e-9f79-04a60677d5e1",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Morceau de musique à plusieurs parties qui est chanté par le chœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa6594a-f60c-4b61-a6a2-37365138d3a9",
                                                "sense_id": "b46ce0d1-42a6-393e-9f79-04a60677d5e1",
                                                "text": "Vers neuf heures et demie, une bande beaucoup plus considérable, […], parut sur les boulevards, […], se dirigeant vers la Madeleine en chantant des chœurs patriotiques."
                                            },
                                            {
                                                "example_id": "aaf26140-c3ad-4ae5-bc3b-3db500371134",
                                                "sense_id": "b46ce0d1-42a6-393e-9f79-04a60677d5e1",
                                                "text": "Il y a deux beaux chœurs dans cet opéra. — Le premier chœur est excellent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e94255-d05b-3c3b-8e67-5b9d2f1287f1",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Partie de l’église, séparée de la nef, où l’on chante la messe et qui abrite l’autel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0adb86f9-3df0-410d-a7af-efa39739996e",
                                                "sense_id": "e8e94255-d05b-3c3b-8e67-5b9d2f1287f1",
                                                "text": "Elle ne reprit possession d'elle que dans le chœur de l'église pendant l'office."
                                            },
                                            {
                                                "example_id": "a00faccc-bdbc-41c9-ab82-b1fa3b641a18",
                                                "sense_id": "e8e94255-d05b-3c3b-8e67-5b9d2f1287f1",
                                                "text": "Celles-ci, nouvelles amazones, placèrent des sentinelles sur le clocher et se barricadèrent dans le chœur de l'église."
                                            },
                                            {
                                                "example_id": "546c727a-89dd-462b-b165-d471de293d2f",
                                                "sense_id": "e8e94255-d05b-3c3b-8e67-5b9d2f1287f1",
                                                "text": "Le chancel est destiné à isoler le chœur ou sanctuaire de la nef. Le chœur est réservé aux clercs, la nef aux fidèles. Ces derniers ne peuvent pénétrer dans le chœur et doivent suivre les offices à travers la clôture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254fc97e-354e-3ca2-8deb-790c84382273",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Ensemble des chantres qui sont dans le chœur."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a2260e-511d-4fba-a779-1add5df8443e",
                                                "sense_id": "254fc97e-354e-3ca2-8deb-790c84382273",
                                                "text": "Après que le célébrant a fini, le chœur répond."
                                            },
                                            {
                                                "example_id": "2436b36d-d021-401e-b2ca-fb123fafe415",
                                                "sense_id": "254fc97e-354e-3ca2-8deb-790c84382273",
                                                "text": "Enfants de chœur, enfants qui chantent au chœur, qui répondent à la Messe, qui aident le prêtre dans les cérémonies."
                                            },
                                            {
                                                "example_id": "d888a7ff-d533-44eb-895d-20f2f8263b4a",
                                                "sense_id": "254fc97e-354e-3ca2-8deb-790c84382273",
                                                "text": "Religieuses du chœur, dames du chœur, religieuses qui sont astreintes à la récitation de l’office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9a1754-f9fc-35ad-a9c2-50a72df7df25",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Ensemble de personnages qui chantent, soit dans le cours de la pièce, soit dans les intervalles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe7af37-51e8-445a-8494-3121875549ef",
                                                "sense_id": "4f9a1754-f9fc-35ad-a9c2-50a72df7df25",
                                                "text": "Les chœurs d’Esther, d’Athalie."
                                            },
                                            {
                                                "example_id": "51c99d8b-349b-4c30-9a8f-819a3d7aeee5",
                                                "sense_id": "4f9a1754-f9fc-35ad-a9c2-50a72df7df25",
                                                "text": "Le chef du chœur ou Coryphée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5067d01-f98b-3950-957b-ebb41ce1848d",
                                        "entry_id": "c3bc57d7-f402-3990-973d-24e67db20b68",
                                        "glosses": [
                                            "Ce que chante un chœur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014344c9-1a93-4c85-b66e-7e6a8f214687",
                                                "sense_id": "c5067d01-f98b-3950-957b-ebb41ce1848d",
                                                "text": "Les chœurs d’Eschyle."
                                            },
                                            {
                                                "example_id": "89ee0198-2ee5-45c7-90a5-7a2b4d246517",
                                                "sense_id": "c5067d01-f98b-3950-957b-ebb41ce1848d",
                                                "text": "Il y a dans les chœurs de cette tragédie des passages très obscurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
