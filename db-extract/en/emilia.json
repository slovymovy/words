                "entry_id": "0423f9e9-dcc5-3725-9ff1-b23374df3a23",
                "word": "Emilia",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a32316a-03d7-32dd-8c31-73065eeca059",
                        "entry_id": "0423f9e9-dcc5-3725-9ff1-b23374df3a23",
                        "glosses": [
                            "A female given name from Latin, a rare latinized variant of Emily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3315911-8779-4591-becd-a24b0f07986d",
                                "sense_id": "2a32316a-03d7-32dd-8c31-73065eeca059",
                                "text": "\"Emily\" was preserved and erased, reduced to the sexless cypher \"E.\", and then came to denote not the shared and ordinary name \"Emily\" but a new, exotic, self-begotten \"Emilia\". No longer masculine Francis but feminine-with-a-difference Emilia, vaguely Latin or Italian or French but in any case foreign, not domestic; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4c35b0c7-2b43-3b91-94f7-224916f38e6d",
                        "entry_id": "0423f9e9-dcc5-3725-9ff1-b23374df3a23",
                        "glosses": [
                            "A historical region of Italy, approximately coterminous with modern Emilia-Romagna."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eabec7d5-9e37-44b0-85e6-5995da84a797",
                        "source_entry_id": "0423f9e9-dcc5-3725-9ff1-b23374df3a23",
                        "source_sense_description": "historical region of Italy",
                        "target_lang_word": "Émilie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Émilie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                        "entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18fc941b-e2d4-49f6-8b7c-9d11672293e7",
                                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                                "text": "Hakim Belaroussi (institut Capeline), Nelly El Shafey (Hypsome), Capucine Huguet (Capucine H), Émilie Geissler (restauration de tableaux), Marie-Cécile Kfouri (restauration et conservation de peintures) et Ève Mallet-Mire (architecture de design d’intérieur) viennent rejoindre les précédents lauréats."
                                            },
                                            {
                                                "example_id": "f5dd29ff-ebc1-477c-855c-fcae9468e1d4",
                                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                                "text": "Le duo formé d’Émilie Satt et Jean-Karl Lucas, en couple à la ville, sort ce vendredi son troisième album studio"
                                            },
                                            {
                                                "example_id": "e3b8e886-5d46-4572-b92d-5f45cca2c692",
                                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                                "text": "Les enseignantes ont également participé à ces remises. À savoir : Élisa Petit, Emmie Bourrel, Émilie Chastagner, Flora Guyonnet, Aurélie Decarre, Karine Narsou et de la directrice Catherine Munoz."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Émilie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa4863a-1172-3b38-b0f2-684b5d6e7ce3",
                                        "entry_id": "29c23f4f-1314-39c9-9061-2be47073614e",
                                        "glosses": [
                                            "Région d’Italie."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25754d36-e458-4487-897b-2ab6b0eb075f",
                                                "sense_id": "eaa4863a-1172-3b38-b0f2-684b5d6e7ce3",
                                                "text": "Son père et sa mère décédés, Jacques resta à Bologne tant il se sentait attaché par tout son passé à la capitale de l’Émilie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
