                            "target_lang_translations": {
                                "en": "The owner of the old house has severely <w>neglected</w> the garden for years."
                            }
                        },
                        {
                            "text": "Je mag je huiswerk niet <w>verwaarlozen</w> als je goede cijfers wilt halen.",
