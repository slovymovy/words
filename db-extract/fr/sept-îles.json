                        "examples": [
                            {
                                "example_id": "5ae1107c-0769-4311-9c2d-ae7db3139e6a",
                                "sense_id": "b2cce33e-8214-3ac9-a337-516bd41eb5a5",
                                "text": "L’épave d’un hydravion qui a coulé dans un lac situé à 50 kilomètres au nord de Sept-Îles, il y près de 100 ans, a été découverte au cours des dernières semaines."
                            },
                            {
                                "example_id": "56ea854f-1506-486b-9d8f-0993e511f7b9",
                                "sense_id": "b2cce33e-8214-3ac9-a337-516bd41eb5a5",
                                "text": "Une femme de Sept-Îles a été témoin d'une rare visite d’un phoque barbu dans le Saint-Laurent."
                            },
                            {
                                "example_id": "f9cff143-ad29-4294-ab3e-c49f831ae75a",
                                "sense_id": "b2cce33e-8214-3ac9-a337-516bd41eb5a5",
                                "text": "La tempête affectera également Gatineau, l’Abitibi, le Bas-Saint-Laurent, Saguenay, la Gaspésie et Sept-Îles, où la bordée laissera jusqu’à 30 cm de neige."
                            }
                        ]
