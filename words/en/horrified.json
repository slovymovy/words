{
    "word_family": [
        "horror",
        "horrify",
        "horrific",
        "horrifying",
        "horrendous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa146ef4-cfe9-3342-a741-20a2a947ab31",
                    "sense_definition": "Feeling or showing great shock, fear, or disgust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood there with a <w>horrified</w> expression on her face after witnessing the terrible accident.",
                            "target_lang_translations": {
                                "ru": "Она стояла с <w>ужаснувшимся</w> выражением лица после того, как стала свидетелем ужасной аварии."
                            }
                        },
                        {
                            "text": "The public was <w>horrified</w> by the news of the corruption scandal involving the local government.",
                            "target_lang_translations": {
                                "ru": "Общественность была <w>в ужасе</w> от новостей о коррупционном скандале с участием местного правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "appalled",
                        "shocked",
                        "terrified",
                        "dismayed"
                    ],
                    "antonyms": [
                        "delighted",
                        "pleased",
                        "unmoved"
                    ],
                    "common_phrases": [
                        "horrified expression",
                        "absolutely horrified",
                        "horrified look",
                        "horrified by the news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство или проявление сильного шока, страха или отвращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в ужасе",
                                "target_lang_sense_clarification": "состояние крайнего испуга или шока"
                            },
                            {
                                "target_lang_word": "шокированный",
                                "target_lang_sense_clarification": "сильно потрясенный чем-то неприятным"
                            },
                            {
                                "target_lang_word": "объятый ужасом",
                                "target_lang_sense_clarification": "полностью охваченный чувством страха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9159e26f-7e40-39ce-8872-1c4b4b595692",
                    "sense_definition": "Past tense and past participle of <w>horrify</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violent scenes in the movie <w>horrified</w> many viewers who were not expecting such gore.",
                            "target_lang_translations": {
                                "ru": "Сцены насилия в фильме <w>ужаснули</w> многих зрителей, которые не ожидали такого количества крови."
                            }
                        },
                        {
                            "text": "The thought of losing his job <w>horrified</w> him because he had a large family to support.",
                            "target_lang_translations": {
                                "ru": "Мысль о потере работы <w>приводила его в ужас</w>, так как ему нужно было содержать большую семью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «ужасать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужаснул",
                                "target_lang_sense_clarification": "вызвал чувство сильного страха или отвращения"
                            },
                            {
                                "target_lang_word": "потряс",
                                "target_lang_sense_clarification": "вызвал глубокое потрясение"
                            },
                            {
                                "target_lang_word": "привел в ужас",
                                "target_lang_sense_clarification": "заставил кого-либо почувствовать сильный испуг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}