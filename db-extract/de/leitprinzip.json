                        "source_entry_id": "a6f3101c-7a8a-30f2-a1e6-d7e2cf7cd862",
                        "source_sense_id": "a4c818c3-ff44-3ef8-988d-6c5444ff5cd3",
                        "source_sense_description": "Prinzip, von dem man sich leiten lässt/das man befolgt",
                        "target_lang_word": "fil conducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fil conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84619631-b0a1-3944-9198-46aef81eea56",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Fil permettant de conduire l'impulsion électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Axe principal d'un scénario, d'une histoire ou d'un raisonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ee210e-a966-4243-b00a-4faa87d4ddcb",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Le fil conducteur de toutes les interventions était le rôle joué par les jeunes comme vecteurs potentiels du changement."
                                            },
                                            {
                                                "example_id": "fd4ff521-5676-4734-a304-6465c28342ff",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Quel fil conducteur permettrait de relier ces thèmes?"
                                            },
                                            {
                                                "example_id": "81c57151-f89c-4959-8fe0-c97ca055f9a3",
                                                "sense_id": "6f2e020d-7fb9-3cc3-b811-3cba3747e3e2",
                                                "text": "Elle n’avait pas marché sûrement de déduction en déduction ; mais s’égarant tantôt d’un côté, tantôt de l’autre, elle s’était souvent perdue dans des profondeurs pour elle insondables, et elle avait eu grande peine à retrouver un fil conducteur au milieu de ces détours de conscience qui se révélaient à elle pour la première fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cdd2967-2127-3790-94ba-6ebb8b5e55b3",
                                        "entry_id": "8d8e0947-563e-3da4-bd00-019ad38124e5",
                                        "glosses": [
                                            "Idée, thème principal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1285aa7f-af72-4de9-8fb8-533bacccd298",
                                                "sense_id": "9cdd2967-2127-3790-94ba-6ebb8b5e55b3",
                                                "text": "A posteriori, en vue des entretiens, j’ai reconstruit un fil conducteur dans mon orientation, pour garder la face devant les recruteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
