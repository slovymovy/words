                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3dbc0fc7-a150-4761-9cbd-1e07f8847cb0",
                                "sense_id": "47dd00ca-ab66-3dfa-9c0c-24cdbf68e41f",
                                "text": "I would go to school, and practise, and housekeep, and club; all in their proper proportions⁠——"
                            },
                            {
                                "example_id": "a48a8ad2-3d90-464d-abf2-c8d4abe6b126",
                                "sense_id": "47dd00ca-ab66-3dfa-9c0c-24cdbf68e41f",
                                "text": "\"I knew our week at this hotel was out to-morrow,\" she continued, \"and we've about used up this place, anyway, and the new village that I've b'en to is the prettiest place we've seen yet; it's got an up-and-down hill to it, just like home, and the house I've partly rented is opposite a fair green, where there's a market every week, and Wednesday's the day; and we'll save money, for I shan't cost you so much when we can housekeep.\""
                            }
                        ]
