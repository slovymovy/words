                        "source_sense_id": "0e03064e-7131-3d9b-a577-01c05b91e7aa",
                        "target_lang_word": "waterproof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waterproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7ad2a7-e753-3a75-9dcd-20849e78449d",
                                        "entry_id": "5fca1528-38f2-35ec-8a35-ec25e43bebcf",
                                        "glosses": [
                                            "Resistant to the effects of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4355131b-a779-3812-9ec3-5145e9fb658a",
                                        "entry_id": "5fca1528-38f2-35ec-8a35-ec25e43bebcf",
                                        "glosses": [
                                            "Made of or covered with material that doesn't allow water in."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "206e80fb-0771-3500-adc4-4494a3515be7",
                                        "entry_id": "5fca1528-38f2-35ec-8a35-ec25e43bebcf",
                                        "glosses": [
                                            "Incapable of failing; unassailable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f282882f-c646-4cda-a9a4-b9b6c0e8e60e",
                                                "sense_id": "206e80fb-0771-3500-adc4-4494a3515be7",
                                                "text": "The only waterproof plan and the one increasingly adopted by leading trades is the consolidation of the interests of all parties in a scheme of amalgamation."
                                            },
                                            {
                                                "example_id": "0f030873-b5bd-4e58-a40b-7c23214509e3",
                                                "sense_id": "206e80fb-0771-3500-adc4-4494a3515be7",
                                                "text": "Especially within an international framework, guarding this process is of the utmost importance. The eyes of the world are focussed on the action at hand and demand a waterproof plan and execution."
                                            },
                                            {
                                                "example_id": "180385f3-0738-4723-84b6-636c5e1af4c7",
                                                "sense_id": "206e80fb-0771-3500-adc4-4494a3515be7",
                                                "text": "Unless you have a 100 percent waterproof plan to defraud insurance companies, I would suggest you don't do it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waterproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "380aaebe-855f-3eab-803f-cb1ece110184",
                                        "entry_id": "ef2cce12-79d3-3ea1-ba10-de8bb899d343",
                                        "glosses": [
                                            "To make waterproof or water-resistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761038fa-0536-4778-af8a-2bb836caad56",
                                                "sense_id": "380aaebe-855f-3eab-803f-cb1ece110184",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waterproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8b71ce-01a9-35e7-a200-9b41c039ab94",
                                        "entry_id": "619570bf-032f-384a-939a-faf5d74e2eaf",
                                        "glosses": [
                                            "A substance or preparation for rendering cloth, leather, etc., impervious to water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fc6eced-5f75-3721-8305-e612c3a1edda",
                                        "entry_id": "619570bf-032f-384a-939a-faf5d74e2eaf",
                                        "glosses": [
                                            "Cloth made waterproof, or any article made of such cloth, or of other waterproof material, as rubber; especially, an outer garment made of such material."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2507e665-4902-4bdf-9f22-37049b3bfe1a",
                        "source_entry_id": "4d7c7cd8-fb62-3a2e-9a82-288d056e80a3",
                        "source_sense_id": "0e03064e-7131-3d9b-a577-01c05b91e7aa",
                        "target_lang_word": "impervious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impervious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6262f597-4674-39ae-a1cf-78357ff39970",
                                        "entry_id": "41a61da1-9dba-3c36-8587-7b9d506988f3",
                                        "glosses": [
                                            "Unaffected or unable to be affected by something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0460113-42fa-4efc-800c-28b63b2de08b",
                                                "sense_id": "6262f597-4674-39ae-a1cf-78357ff39970",
                                                "text": "The man was completely impervious to the deception we were trying."
                                            },
                                            {
                                                "example_id": "8db28022-0ad2-4947-942e-3757c786c8cb",
                                                "sense_id": "6262f597-4674-39ae-a1cf-78357ff39970",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "db868802-116c-4388-a3ab-e715e7d87e28",
                                                "sense_id": "6262f597-4674-39ae-a1cf-78357ff39970",
                                                "text": "For the past decade there were two more or less universally acknowledged truths about digital advertising. First, the rapidly growing industry was largely impervious to the business cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f81642-344e-3269-94cb-b72ac84a5eed",
                                        "entry_id": "41a61da1-9dba-3c36-8587-7b9d506988f3",
                                        "glosses": [
                                            "Preventive of any penetration; impenetrable, impermeable, particularly of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6c34ecf-431a-4cc3-a388-cd45f7d5f246",
                                                "sense_id": "e9f81642-344e-3269-94cb-b72ac84a5eed",
                                                "text": "Although patchworked and sagging, the roof proved impervious to the weather."
                                            },
                                            {
                                                "example_id": "cf17ce23-644d-4299-b21f-48209641f568",
                                                "sense_id": "e9f81642-344e-3269-94cb-b72ac84a5eed",
                                                "text": "The white faience façade, the glazed Doultonware Carrera marble, was made locally. And being glazed, it was impervious to London's sooty atmosphere, enabling easier cleaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1999988a-ab18-336d-b358-f44bb05eff57",
                                        "entry_id": "41a61da1-9dba-3c36-8587-7b9d506988f3",
                                        "glosses": [
                                            "Immune to damage or effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45699837-57b1-4967-bdd1-bba22f250be5",
                                                "sense_id": "1999988a-ab18-336d-b358-f44bb05eff57",
                                                "text": "The old car seemed to be impervious to the wear and tear of age."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
