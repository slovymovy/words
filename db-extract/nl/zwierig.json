                        "examples": [
                            {
                                "example_id": "ac0fc615-ef5f-49fc-82a2-35977c2f67db",
                                "sense_id": "e65e8ae3-39ca-3890-8290-cd4288c8eeeb",
                                "text": "Een zwierige dame, gebruikt als bn."
                            },
                            {
                                "example_id": "8835dcc0-b166-4024-a4c3-5f36e0082af8",
                                "sense_id": "e65e8ae3-39ca-3890-8290-cd4288c8eeeb",
                                "text": "Een zwierig mooie dame, gebruikt als bw."
                            },
                            {
                                "example_id": "678d3bbe-bb8e-4bd5-bcda-fd91fb8b04db",
                                "sense_id": "e65e8ae3-39ca-3890-8290-cd4288c8eeeb",
                                "text": "In plaats daarvan haalde Amy een fles witte wijn uit de koelkast en schonk met een zwierig gebaar twee niet bij elkaar horende glazen vol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e161a12-8232-458c-9746-7dfd7d1a330d",
                        "source_entry_id": "9541c0e8-f9cb-38c4-b470-7ee3de596fc9",
                        "source_sense_id": "e65e8ae3-39ca-3890-8290-cd4288c8eeeb",
