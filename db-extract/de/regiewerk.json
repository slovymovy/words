                "senses": [
                    {
                        "sense_id": "535adc88-ad31-3dbd-8724-f57af0c79149",
                        "entry_id": "a0e81c22-5a94-3af5-af50-ecd474fdaa6d",
                        "glosses": [
                            "Gesamtheit der Klaviatur, des Manuals und des Pedals der Orgel"
                        ],
                        "tags": [
                            "Orgel"
                        ],
                        "examples": [
                            {
                                "example_id": "9d8d3412-0ec9-4d91-8f6b-b85bfb8aae76",
                                "sense_id": "535adc88-ad31-3dbd-8724-f57af0c79149",
                                "text": "„Die Orgel […], das größte und volltönendste Tonwerkzeug, zugleich Tasten- und Blasinstrument, hauptsächlich beim christl.[ichen] Gottesdienst verwendet, besteht aus dem Windwerk (Bälge, Kanäle, Windkasten, Pfeifenstöcke und Kanzellen), dem Regierwerk (Klaviatur, Manual und Pedal) und dem Pfeifwerk (Labial- und Zungenpfeifen).“"
                            },
                            {
                                "example_id": "ab8022f5-98eb-4fb1-9465-bf8d5da778fa",
                                "sense_id": "535adc88-ad31-3dbd-8724-f57af0c79149",
                                "text": "„Traktur und Regierwerk können mech.[anisch], pneumatisch oder elektr.[isch] ausgeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
