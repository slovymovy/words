                    {
                        "translation_id": "8087fb73-3e1b-4192-967e-0ac1cad535bc",
                        "source_entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "source_sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                        "source_sense_description": "Arbuste du genre botanique Rosa, qui porte des roses.",
                        "target_lang_word": "刺客",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "刺客",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "b5547df4-8757-3fe1-a851-e37bd6dab494",
                                        "entry_id": "bbfd64eb-d9f9-3a7b-9974-fbf35c455d38",
                                        "glosses": [
                                            "暗殺別人的人"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cb6123-1e5b-42b5-b612-afc091519782",
                                                "sense_id": "b5547df4-8757-3fe1-a851-e37bd6dab494",
                                                "text": "張奎仗刀逕入，楊任一時著急，將雲霞獸一磕，至三層圈子內，擊雲板，大呼曰：「有刺客進營！各哨仔細！」"
                                            },
                                            {
                                                "example_id": "531590ea-f460-4515-9ebe-74d4baa14aa2",
                                                "sense_id": "b5547df4-8757-3fe1-a851-e37bd6dab494",
                                                "text": "张奎仗刀迳入，杨任一时着急，将云霞兽一磕，至三层圈子内，击云板，大呼曰：「有刺客进营！各哨仔细！」"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                        "entry_id": "bbfd64eb-d9f9-3a7b-9974-fbf35c455d38",
                                        "glosses": [
                                            "玫瑰"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72427386-d988-4e9e-b9ef-75fd44beeb98",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "若方刺客應神似，奇絕人間聶隱娘。"
                                            },
                                            {
                                                "example_id": "26752329-831a-42a8-afc5-fad7fdc35d02",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "若方刺客应神似，奇绝人间聂隐娘。"
                                            },
                                            {
                                                "example_id": "ba485140-f520-4d50-abe9-ae1cde513fae",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "玫瑰，一個使人瘋狂的使者，一名刺客，不知俘獲了多少人的心。"
                                            },
                                            {
                                                "example_id": "80f58750-77a0-4220-a392-d0f894d8f792",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "玫瑰，一个使人疯狂的使者，一名刺客，不知俘获了多少人的心。"
                                            },
                                            {
                                                "example_id": "fd366570-e348-46b1-aa99-4c3e9477878c",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "旭日顧陽臺，盆中刺客栽。"
                                            },
                                            {
                                                "example_id": "b38369c1-0a5e-4045-8b9d-34e819868c55",
                                                "sense_id": "8ba899ec-9af9-37e2-a1e2-89759f10bcec",
                                                "text": "旭日顾阳台，盆中刺客栽。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
