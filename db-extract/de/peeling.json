                                        "sense_id": "efc5d1e5-ed10-345e-b980-b2f2a1a8d972",
                                        "entry_id": "679abf34-37f0-32d1-9a35-f77106b018d3",
                                        "glosses": [
                                            "Action de gommer ou résultat de cette action. (Gommer dans le sens d'effacer avec une gomme et aussi gommer dans le sens d'enduire de gomme arabique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b882fc5-e8bc-4f4e-afee-c9f0dad552b0",
                                                "sense_id": "efc5d1e5-ed10-345e-b980-b2f2a1a8d972",
                                                "text": "Le gommage des timbres."
                                            },
                                            {
                                                "example_id": "f1573732-2d33-4a8e-8048-c34d93dbb095",
                                                "sense_id": "efc5d1e5-ed10-345e-b980-b2f2a1a8d972",
                                                "text": "Le gommage des enveloppes, des tissus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3266edc7-0c8b-302b-a9ec-1f777ca4cc95",
                                        "entry_id": "679abf34-37f0-32d1-9a35-f77106b018d3",
                                        "glosses": [
                                            "Produit servant à éliminer les cellules mortes de l’épiderme."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcb48bc-9c68-42ea-8280-dd8ac60c4882",
                                                "sense_id": "3266edc7-0c8b-302b-a9ec-1f777ca4cc95",
                                                "text": "Pour confectionner un exfoliant maison, mélangez de l'huile d'olive et une poignée de sel de mer. Utilisez cette préparation comme gommage pour le corps."
                                            },
                                            {
                                                "example_id": "0355c5b5-ef56-441c-8577-29187e14861a",
                                                "sense_id": "3266edc7-0c8b-302b-a9ec-1f777ca4cc95",
                                                "text": "J’ai laissé mes yeux traîner sur les étagères. Crèmes de jour, de nuit, masques hydratants, purifiants, gommages, sérums antifatigue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc299240-3a5d-3108-ad42-cae673413f9f",
                                        "entry_id": "679abf34-37f0-32d1-9a35-f77106b018d3",
                                        "glosses": [
                                            "Adhérence défectueuse des fils de soie entre eux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f89876c-b441-3c9d-9d5e-20cebe28f25e",
                                        "entry_id": "679abf34-37f0-32d1-9a35-f77106b018d3",
                                        "glosses": [
                                            "Adhérence qui se produit dans un moteur à explosion n'ayant pas été utilisé pendant longtemps, ou exposé au froid, ou à de trop fortes températures. Il est dû à la transformation du lubrifiant en une gomme épaisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459ec824-9640-4287-95b7-fc60c11b92c5",
                                                "sense_id": "6f89876c-b441-3c9d-9d5e-20cebe28f25e",
                                                "text": "Le gommage des segments provoque leur rupture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
