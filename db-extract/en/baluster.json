    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1a7e8a15-4863-3268-8817-5e5404add57e",
                "word": "baluster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "edc90967-8870-4a24-9a9b-d7155d2ddd96",
                        "entry_id": "1a7e8a15-4863-3268-8817-5e5404add57e",
                        "tags": [
                            "plural"
                        ],
                        "form": "balusters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "910f25b0-17d0-3457-bf46-fa4faba07c02",
                        "entry_id": "1a7e8a15-4863-3268-8817-5e5404add57e",
                        "glosses": [
                            "A short column used in a group to support a rail, as commonly found on the side of a stairway or around a balcony; a banister."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923a1893-997a-45af-8a56-2ce872533e5c",
                                "sense_id": "910f25b0-17d0-3457-bf46-fa4faba07c02",
                                "text": "The two Posternes were answerable to those of others set downe before: and were cut out of the two round Towers which riz vp in proportionable measures, from the ground on the foreside with battlements and Ballisters round enclosing the tops, containing in all their heights — foote:"
                            },
                            {
                                "example_id": "42271a37-cbe3-4210-81c8-9fe944696915",
                                "sense_id": "910f25b0-17d0-3457-bf46-fa4faba07c02",
                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                            },
                            {
                                "example_id": "8403c619-fa22-4d55-a222-35956dd105f8",
                                "sense_id": "910f25b0-17d0-3457-bf46-fa4faba07c02",
                                "text": "Nick looked at the floor, and at the rhythm of the black-and-gilt S-shaped balusters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf973d31-ebe7-47d4-b6d3-7b39c4ec4357",
                        "source_entry_id": "1a7e8a15-4863-3268-8817-5e5404add57e",
