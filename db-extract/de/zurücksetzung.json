                ],
                "senses": [
                    {
                        "sense_id": "a5daa06c-154d-37d9-b4a8-80153ad33ba0",
                        "entry_id": "695b2973-1baf-3005-b148-697d6765811a",
                        "glosses": [
                            "Vorgang des Zurücksetzens in einer seiner vielfachen (zum Beispiel örtlichen und zeitlichen) Bedeutungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7539f279-2c0b-4d9b-a504-ecb6331d8d44",
                                "sense_id": "a5daa06c-154d-37d9-b4a8-80153ad33ba0",
                                "text": "„[Die Degradierung] ist die Zurücksetzung auf einen niedrigeren Dienstgrad, den der Bestrafte zu einem früheren Zeitpunkt bereits geführt hat, und kann bis zum Dienstgrad Rekrut verfügt werden.“"
                            },
                            {
                                "example_id": "92565897-6f1c-4950-aa1b-8f99389c9fcf",
                                "sense_id": "a5daa06c-154d-37d9-b4a8-80153ad33ba0",
                                "text": "„Aber Achtung: Nach Aktivieren der Zurücksetzung [des Geräts] steht etwas Aufräumarbeit an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53d01e5a-9ca8-36ab-b4cc-d803a6fe105f",
                        "entry_id": "695b2973-1baf-3005-b148-697d6765811a",
                        "glosses": [
                            "schroffe oder ungerechte Behandlung einer anderen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e6053b-ebb7-4fc4-8b19-84e11aafc18f",
                                "sense_id": "53d01e5a-9ca8-36ab-b4cc-d803a6fe105f",
                                "text": "„Sie füttert das Gefühl der Zurücksetzung, zehrt davon, obwohl es dem Land so gut geht wie nie seit der Wende.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
