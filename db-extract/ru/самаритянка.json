                "senses": [
                    {
                        "sense_id": "564f960a-660a-3e0e-b578-3dd0ed7a1292",
                        "entry_id": "0d802788-631f-3882-9db2-495ed3ba315a",
                        "glosses": [
                            "истор. женск. к самаритя́нин; жительница или уроженка Самарии — города и области в Палестине"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d12dbf5-63a0-42e1-8945-fafdd1578312",
                                "sense_id": "564f960a-660a-3e0e-b578-3dd0ed7a1292",
                                "text": "Возможно, в этом кроется причина того, что до сих пор ни один еврейский мужчина не женился на самаритянке."
                            }
                        ]
                    },
                    {
                        "sense_id": "f395d4bf-cd31-31e8-acbd-b0d53f08d8b3",
                        "entry_id": "0d802788-631f-3882-9db2-495ed3ba315a",
                        "glosses": [
                            "перен. добрая, отзывчивая девушка или женщина, помогающая нуждающимся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e1b1f25-894c-416d-8769-00cec3dd35a0",
                                "sense_id": "f395d4bf-cd31-31e8-acbd-b0d53f08d8b3",
                                "text": "Больной посмотрел на свою самаритянку искренне благодарными глазами."
                            },
                            {
                                "example_id": "d76cf8c5-140e-47de-b639-9cc1b78a0db9",
                                "sense_id": "f395d4bf-cd31-31e8-acbd-b0d53f08d8b3",
                                "text": "Бахирев отложил книгу и всё внимательнее смотрел на маленькую самаритянку, врачевавшую своего худенького, скуластого и азартного брата…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f1443cb-6dcc-4ad1-a288-4ed1a7189ae7",
                        "source_entry_id": "0d802788-631f-3882-9db2-495ed3ba315a",
                        "target_lang_word": "Samaritan",
                        "target_lang_code": "en",
