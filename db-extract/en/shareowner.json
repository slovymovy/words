                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cfaf958-0492-419f-a5a1-40877f935c9e",
                        "source_entry_id": "02fed096-3e22-3ff0-a2d1-2d1a496e66ae",
                        "source_sense_id": "3aab8914-281c-3add-8558-49d6143cb91b",
                        "source_sense_description": "Wirtschaft: Aktionär, Anteilseigner",
                        "target_lang_word": "Aktionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                        "entry_id": "93f4c9ec-36e5-3a48-aac9-f81c0835f31b",
                                        "glosses": [
                                            "Inhaber von Aktien, und damit Miteigentümer einer Aktiengesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fb28b9-e8d0-4780-80e8-d4008897511b",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "Nach § 53a des deutschen Aktiengesetzes sind Aktionäre unter gleichen Voraussetzungen gleich zu behandeln."
                                            },
                                            {
                                                "example_id": "a3850fcb-aed5-4882-a1c1-eadadffd5216",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Der Aktionär hat zweierlei wichtige Rechte: er ist der, wo das Geld gibt, und er darf bei der Generalversammlung in die Opposition gehen und etwas zu Protokoll geben, woraus sich der Vorstand einen sog. Sonnabend macht.“"
                                            },
                                            {
                                                "example_id": "5e3ad21c-7608-4f03-829e-603136c9a592",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Als sie in See stach, waren alle vierzehn Aktionäre mit an Bord.“"
                                            },
                                            {
                                                "example_id": "9f38ff11-0759-4875-9169-4c6619940a48",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Francis Baring, dessen 1762 in London gegründete Bank im Jahr 1995 spektakulär pleiteging, fungierte bereits um 1750 als Aktionär der Company of Merchants Trading to Africa und profitierte vom Sklavenhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc196765-ab11-43a3-8acb-15b6bb38bc66",
                        "source_entry_id": "02fed096-3e22-3ff0-a2d1-2d1a496e66ae",
