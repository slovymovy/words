                        "cross_references": [
                            {
                                "target_word": "miser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who hoards money rather than spending it; one who is cheap or extremely parsimonious."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822ca7c1-2233-43c6-b926-ba32d3eb82e0",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "Scrooge was a typical miser: spending nothing he could save, nor enjoying his wealth."
                                            },
                                            {
                                                "example_id": "c8cef956-1b71-4309-9b58-15d22c55db0e",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "[…] foꝛ it was many times notoꝛious vnto al mẽ, yͭ he did eate in his houſe no other fleſh by the ſpace of iii. dayes, but on Hare, whiche was ſent him. He was ſuch a miſer to ſpend, ⁊ ſo deſirous to hooꝛd and lay vp money, yͭ had it not béene foꝛ ſome dayes of ſacrifices, oꝛ his bidden gueſts, not a moꝛsel of fleſh was eaten in his houſe: but only fed of his pꝛouiſion from his garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who is wretched or despicable; a wretch."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea836c9-a3a7-4657-988d-934f44bcb219",
                                                "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                                "text": "[…] a poore virgin ſir, an il-fauor’d thing ſir, but mine owne, a poore humour of mine ſir, to take that that no man elſe will: rich honeſtie dwels like a miſer ſir, in a poore houſe, as your Pearle in your foule oyſter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e32750-4847-395e-aa4a-abf1e8921556",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A kind of earth auger, typically large-bored and often hand-operated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1836bb50-7932-4ff6-bca1-baf4b4033a41",
                        "source_entry_id": "734c72c4-a102-37a3-bef8-bdab005cb6e4",
                        "source_sense_id": "a0c5e6df-aee7-3b92-a5c5-ba422f0e3e29",
                        "target_lang_word": "niggard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "634b38b1-57c0-38bd-b15b-b1c5a0ff7dfe",
                                        "entry_id": "602f344f-583f-358f-afa7-28b0af23a466",
                                        "glosses": [
                                            "Sparing; stinting; parsimonious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2100862-0f4e-389e-a6d2-a88ece0f09ec",
                                        "entry_id": "602f344f-583f-358f-afa7-28b0af23a466",
                                        "glosses": [
                                            "Miserly or stingy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2836793-1e32-411e-9268-06f18dd07d67",
                                                "sense_id": "b2100862-0f4e-389e-a6d2-a88ece0f09ec",
                                                "text": "It was, however, the pleasure of his niggard and unhappy fortune, that in seeking a place proper for his accommodation, he and Dapple tumbled into a deep and very dark pit, among a number of old buildings."
                                            },
                                            {
                                                "example_id": "d32b5450-765a-4892-a4b0-4de1f3c3eb05",
                                                "sense_id": "b2100862-0f4e-389e-a6d2-a88ece0f09ec",
                                                "text": "[H]is heart swelled within him, as he sat at the head of his own table, on the occasion of the house-warming, dispensing with no niggard hand the gratuitous viands and unlimited beer, which were at once to symbolise and inaugurate the hospitality of his mansion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "niggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d422495f-a8a3-3f47-94d6-a74e932b4806",
                                        "entry_id": "3c655c2d-c17c-3440-ac47-b527fb3eecf0",
                                        "glosses": [
                                            "A miser or stingy person; a skinflint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25208911-25ce-4d4a-81c7-f3749e2449d3",
                                                "sense_id": "d422495f-a8a3-3f47-94d6-a74e932b4806",
                                                "text": "Then beautious nigard why dooſt thou abuſe / The bountious largeſſe giuen thee to giue?"
                                            },
                                            {
                                                "example_id": "e7b8dbab-d29a-4bc8-ab0b-121fcc36eb64",
                                                "sense_id": "d422495f-a8a3-3f47-94d6-a74e932b4806",
                                                "text": "All his pleasures were social; and while health and fortune smiled upon him, he was no niggard either of his time or talents to those who needed them."
                                            },
                                            {
                                                "example_id": "bfd84308-7cec-4f05-8073-60e555709038",
                                                "sense_id": "d422495f-a8a3-3f47-94d6-a74e932b4806",
                                                "text": "‘No niggard are you, Éomer,’ said Aragorn, ‘to give thus to Gondor the fairest thing in your realm!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bffa8df5-d106-391a-91e2-1f60b63d3a2e",
                                        "entry_id": "3c655c2d-c17c-3440-ac47-b527fb3eecf0",
                                        "glosses": [
                                            "A false bottom in a grate, used for saving fuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a9a9d7-8039-454f-b69e-cbf5d46d1978",
                                                "sense_id": "bffa8df5-d106-391a-91e2-1f60b63d3a2e",
                                                "text": "1833, Edward Bulwer Lytton, Godolphin\nIt was evening: he ordered a fire and lights; and, leaning his face on his hand as he contemplated the fitful and dusky upbreakings of the flame through the bars of the niggard and contracted grate […]"
                                            },
                                            {
                                                "example_id": "70b83261-fdc0-4c3f-9433-69a5579a7f57",
                                                "sense_id": "bffa8df5-d106-391a-91e2-1f60b63d3a2e",
                                                "text": "1851, From a catalog of the Great Exhibition\nCooking apparatus, adapted for an opening eight feet wide, by five feet high, and containing an open-fire roasting range, with sliding spit-racks and winding cheek or niggard;"
                                            },
                                            {
                                                "example_id": "fb272dad-ead9-46b4-8025-7202ec17eeda",
                                                "sense_id": "bffa8df5-d106-391a-91e2-1f60b63d3a2e",
                                                "text": "Neither this nor the Brompton house have a kitchen-range (that is, Grate like the Miles's), but only a grate with moveable niggards etc."
                                            },
                                            {
                                                "example_id": "4b9358cf-80fb-4909-a7fc-a207e1609d83",
                                                "sense_id": "bffa8df5-d106-391a-91e2-1f60b63d3a2e",
                                                "text": "A niggard was a movable side to the kitchen grate which could be wound up with a handle so as to make the fire […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "niggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b01465fb-5634-336d-94a3-68a8e0c7c262",
                                        "entry_id": "1c16e8f0-7cba-3a34-91ac-fa11a4e91c02",
                                        "glosses": [
                                            "To hoard; to act stingily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b290d73-4dca-4dc5-9f08-d5ae11dfc5d2",
                                                "sense_id": "b01465fb-5634-336d-94a3-68a8e0c7c262",
                                                "text": "Within thine owne bud burieſt thy content, / And tender chorle makſt waſt in niggarding: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f117a97-7916-4780-924f-d4145060beda",
                        "source_entry_id": "734c72c4-a102-37a3-bef8-bdab005cb6e4",
                        "source_sense_id": "a0c5e6df-aee7-3b92-a5c5-ba422f0e3e29",
