                    {
                        "sense_id": "e29c5a01-ddb8-3442-a448-ff7195021a88",
                        "entry_id": "ee6ca4b1-f45a-362d-8cb8-2a2cbc7cf3bb",
                        "glosses": [
                            "een puree van zeer fijn gemaakte, met melk aangemengde aardappels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aadee9f-601b-448b-adc7-8e1a9d4aea7e",
                                "sense_id": "e29c5a01-ddb8-3442-a448-ff7195021a88",
                                "text": "Op de tafel stond onder andere aardappelpuree."
                            },
                            {
                                "example_id": "e1a24108-126c-484d-9f52-f84db769067c",
                                "sense_id": "e29c5a01-ddb8-3442-a448-ff7195021a88",
                                "text": "Tijdens het koken zat iedereen elkaar continu te stangen alsof we elkaar al jaren kenden. Barbie werd uitgelachen dat hij al drie weken lang alleen maar ‘ramen bomb’ at (een pakje noedels met een pakje aardappelpuree en een blik tonijn door elkaar)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49f1fff4-85a2-42bb-b6f2-7623a2822bf7",
                        "source_entry_id": "ee6ca4b1-f45a-362d-8cb8-2a2cbc7cf3bb",
                        "source_sense_id": "e29c5a01-ddb8-3442-a448-ff7195021a88",
                        "source_sense_description": "een puree van zeer fijn gemaakte, met melk aangemengde aardappels",
                        "target_lang_word": "Kartoffelpüree",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartoffelpüree",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "993fed7e-8afc-3a70-92b1-787608695309",
                                        "entry_id": "76c0550c-2a34-33d2-bf49-4031ad89febd",
                                        "glosses": [
                                            "ein Brei aus zerstampften oder durchgepressten Salzkartoffeln, der mit Milch oder Sahne, Butter und Gewürzen (Salz, Pfeffer, Muskat) verrührt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef974294-b6f7-491c-a2b9-f661d5bf061c",
                                                "sense_id": "993fed7e-8afc-3a70-92b1-787608695309",
                                                "text": "Für ein wohlschmeckendes Kartoffelpüree sollte man großzügig Butter unter die zerstampften Kartoffeln geben."
                                            },
                                            {
                                                "example_id": "c2885148-8baa-4452-a181-50417c7ceee2",
                                                "sense_id": "993fed7e-8afc-3a70-92b1-787608695309",
                                                "text": "„Ich trug eine Scheibe Braten und Kartoffelpüree an unseren Tisch, und Papa trug einen Erbseneintopf mit Speck und Würstchen an unseren Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
