                ],
                "senses": [
                    {
                        "sense_id": "a18f29f9-3aa9-3e9b-87d4-05fcdd7bfa6c",
                        "entry_id": "0e10230d-77e5-3498-b404-8179942892fb",
                        "glosses": [
                            "Nebenstelle einer Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4c497e-6bb6-4621-a98e-1ea08e91b9b7",
                                "sense_id": "a18f29f9-3aa9-3e9b-87d4-05fcdd7bfa6c",
                                "text": "„Die Zweigstelle des Außenministeriums war ein Schloss, das aussah, als stünde es schon seit Urzeiten dort, erbaut, bevor es menschliches Leben gab.“"
                            },
                            {
                                "example_id": "7c33c748-a532-4b5e-aed1-7462714b991e",
                                "sense_id": "a18f29f9-3aa9-3e9b-87d4-05fcdd7bfa6c",
                                "text": "„Im vergangenen Jahr machten Banken tausende Zweigstellen dicht, wie die Bankstellenstatistik der Bundesbank zeigt. In die Bresche springen sollen das Onlinebanking oder Busse als mobile Zweigstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9852f24d-2cb2-4aae-a00f-6ae28c0207c2",
                        "source_entry_id": "0e10230d-77e5-3498-b404-8179942892fb",
                        "source_sense_id": "a18f29f9-3aa9-3e9b-87d4-05fcdd7bfa6c",
                        "source_sense_description": "Nebenstelle einer Institution",
                        "target_lang_word": "succursale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succursale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0294bd7f-b131-3669-b524-9b10d561e41e",
                                        "entry_id": "a679037b-1231-3a2f-8d59-83e295d1038a",
                                        "glosses": [
                                            "Qui supplée."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b508fd6-0fd7-3ed3-99cd-ca47a7523499",
                                        "entry_id": "a679037b-1231-3a2f-8d59-83e295d1038a",
                                        "glosses": [
                                            "Qualifie l’église qui supplée à l’insuffisance de l’église paroissiale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "succursale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                        "entry_id": "81e9eb0d-1f3b-36a7-b03b-d2b52cc6339e",
                                        "glosses": [
                                            "Tout établissement subordonné à un autre et créé pour le seconder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19fe0bc8-b656-4a5d-9e50-76d83832854e",
                                                "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                                "text": "Une à une les succursales des magasins de luxe parisiens, londoniens ou berlinois fermaient, devant rouvrir, l'été, dans les stations chic : Chamonix, Royat, ou Aix-les-Bains."
                                            },
                                            {
                                                "example_id": "80a5aeb4-54be-4a0b-84d9-164a31b40bf4",
                                                "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                                "text": "Toutes sortes de firmes, par le moyen de leurs succursales, lancent vers lui, ou plutôt vers son escarcelle, leurs tentacules émoustillants, titillants et aspirants."
                                            },
                                            {
                                                "example_id": "30e448d4-2268-44fa-a1cb-8c33a4842f24",
                                                "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                                "text": "Toute personne morale demandant son immatriculation au registre du commerce et des sociétés doit justifier de la jouissance du ou des locaux où elle installe, seule ou avec d'autres, le siège de l'entreprise, ou, lorsque celui-ci est situé à l'étranger, l'agence, la succursale ou la représentation établie sur le territoire français."
                                            },
                                            {
                                                "example_id": "3ab2e0b8-64ec-465d-9410-557c687aec80",
                                                "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                                "text": "La réalité est que le couple qui tenait la succursale du Primistère, amusé et surpris de notre démarche, n'avait pu tenir sa langue."
                                            },
                                            {
                                                "example_id": "d141e4da-1ac5-470c-80b7-5a0a72129664",
                                                "sense_id": "e7e842f8-dd7a-3f48-9bc0-e7afe9971bc8",
                                                "text": "Les maisons anglaises et allemandes installées au Chili ne sont le plus souvent que des comptoirs de puissantes maisons métropolitaines ; l'argent et les moyens d'action ne leur manquent donc pas. Jamais un négociant de France n'enverra fonder à l'étranger une succursale ; les Français établis là-bas ont créé eux-mêmes leur commerce, et ne peuvent rivaliser avec les gros capitaux de leurs concurrents"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0abf155-44ed-30c6-a9ef-9104e93fbfd2",
                                        "entry_id": "81e9eb0d-1f3b-36a7-b03b-d2b52cc6339e",
                                        "glosses": [
                                            "Église et paroisse secondaires rattachées à une paroisse principale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bce4bf7-197a-4788-b2ae-a75ac7a0e0ff",
                                                "sense_id": "f0abf155-44ed-30c6-a9ef-9104e93fbfd2",
                                                "text": "Il vicaria à la campagne jusqu'au mois de Janvier 1692, époque où il fut pourvu de la cure d’Étrépigny et de But, sa succursale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb25f2d6-834d-4140-9509-c6d86be08a22",
                        "source_entry_id": "0e10230d-77e5-3498-b404-8179942892fb",
                        "source_sense_id": "a18f29f9-3aa9-3e9b-87d4-05fcdd7bfa6c",
                        "source_sense_description": "Nebenstelle einer Institution",
                        "target_lang_word": "bureau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "834b3485-deee-3c38-bbd6-f85632f95208",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Meuble à tiroirs et à tablettes où l’on enferme des papiers et sur lequel on écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50fbe58-5c2d-4225-a5f1-1600bb50a2c7",
                                                "sense_id": "834b3485-deee-3c38-bbd6-f85632f95208",
                                                "text": "L’ameublement était sommaire : un bureau, un fauteuil de cuir, des classeurs métalliques, deux petites tables dont l’une supportait une presse à copier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "726209e5-f7c4-342a-a7c4-67d4649cb26b",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Table destinée au travail."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5437b30-5b33-44b3-ae67-9a8af1977715",
                                                "sense_id": "726209e5-f7c4-342a-a7c4-67d4649cb26b",
                                                "text": "J’ai mis ces papiers sur mon bureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd8af47-fb7b-3e48-bfeb-b8e49641304a",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Tout endroit où travaillent habituellement des employés, des commis, des gens d’affaires, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c7c02ef-0326-4b95-ba86-89e0d456caa1",
                                                "sense_id": "3bd8af47-fb7b-3e48-bfeb-b8e49641304a",
                                                "text": "C'est plutôt le contraire qui est vrai ou qui du moins renferme la plus forte part de vérité : maintes fois l'aristocratie mérita le nom de « kakistocratie », dit-il, qu'il soit empereur ou chef de bureau, dont Léopold de Ranke se sert dans son histoire."
                                            },
                                            {
                                                "example_id": "2e9b7382-494e-457f-a2f1-814c3c3212a8",
                                                "sense_id": "3bd8af47-fb7b-3e48-bfeb-b8e49641304a",
                                                "text": "Depuis l’âge de seize ans, il avait été condamné à passer toute la journée dans une sorte de prison, et il n’avait cessé de maudire son sort. « Oh ! quelques années entre le bureau et la tombe ! gémissait-il. Un homme appelle son temps le temps dont il peut disposer comme il veut. Quand donc aurai-je du temps à moi ? »\nEt maintenant qu’il avait ce temps, il ne savait qu’en faire."
                                            },
                                            {
                                                "example_id": "967b726e-5b00-4b3a-b56e-907a357cffdd",
                                                "sense_id": "3bd8af47-fb7b-3e48-bfeb-b8e49641304a",
                                                "text": "Le Père Directeur, qui était venu me rejoindre dans mon bureau de l’hôpital, ne me répondit rien et continua à tirer silencieusement sur son long fume-cigare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e4f5d8-cebf-35ff-ba70-8d122718c88c",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Établissement ou succursale où des employés effectuent un travail plutôt intellectuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f8c4e4-5928-4a6d-af86-69eef247ea4f",
                                                "sense_id": "96e4f5d8-cebf-35ff-ba70-8d122718c88c",
                                                "text": "Le bureau d’Halifax de Atlas Shipping était chargé de noliser les bateaux par vingt ou quarante à la fois. La contrebande était transportée, sur ces navires, de Saint-Pierre au Canada et aux États-Unis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e4099c-ed7d-35f0-bf9c-d756b81c64c3",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Étoffe de bure."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb3bf2f-bf32-43d9-973b-51df51d246b0",
                                                "sense_id": "b2e4099c-ed7d-35f0-bf9c-d756b81c64c3",
                                                "text": "Ils (les vilains) étaient vêtus de surcottes de gros bureau, tombant à mi-jambes, et portaient un chapeau clabaud garni d’une Notre-Dame de plomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885010ae-87be-38f3-a20c-27aaa43763af",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Lieu où se distribuent les billets d’entrée pour un spectacle ou pour tout autre lieu dans lequel on n’est admis qu’en payant. On dit aujourd'hui « guichet »."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c634a14-aa12-4f13-adb2-1d8eb4abed25",
                                                "sense_id": "885010ae-87be-38f3-a20c-27aaa43763af",
                                                "text": "Jouer à bureaux fermés. Prendre un billet au bureau. La foule assiégeait les bureaux. Bureau de location, bureau des suppléments, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9975e6f-4628-3bb6-8818-6c0cc353eaf5",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "L'ensemble des employés eux-mêmes qui travaillent dans un bureau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ec4879-1acc-41ac-958f-a75b3ca5b2ac",
                                                "sense_id": "f9975e6f-4628-3bb6-8818-6c0cc353eaf5",
                                                "text": "Chaque bureau est composé d’un chef, d’un sous-chef, etc. Chef de bureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d52b57-2bf9-3eae-94f1-9f24297f9de9",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Établissements qui dépendent, la plupart, de l’administration publique, qui sont destinés à quelque service public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6280529f-84fe-43e2-be80-6464b65fe0ee",
                                                "sense_id": "c6d52b57-2bf9-3eae-94f1-9f24297f9de9",
                                                "text": "Ce volume, petit in-32, semblable à un Annuaire du Bureau des Longitudes, est recouvert de drap pelucheux comme un bréviaire de chanoine, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377811f0-b65e-39a1-a91a-378e1ddba32a",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Certain nombre de personnes tirées d’une assemblée pour s’occuper spécialement d’une ou de plusieurs affaires dont elles doivent ensuite rendre compte à l’assemblée générale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "999c95f5-c6cc-4249-a905-9c1e13b598d0",
                                                "sense_id": "377811f0-b65e-39a1-a91a-378e1ddba32a",
                                                "text": "L’assemblée fut partagée, divisée en tant de bureaux. Procéder à la formation des bureaux. Les membres de chaque bureau."
                                            },
                                            {
                                                "example_id": "146bd990-65bd-4eee-9d24-a3c50db32127",
                                                "sense_id": "377811f0-b65e-39a1-a91a-378e1ddba32a",
                                                "text": "Le président, le secrétaire d’un bureau. Cette proposition fut renvoyée à l’examen des bureaux. Le rapporteur du premier bureau, du deuxième bureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a9e4ec-36b7-32f5-82d1-5a337725beca",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Réunion du président, des vice-présidents, des secrétaires et aussi, dans certains cas, du trésorier, en parlant des assemblées législatives ou électorales, d’une académie, du comité, d’une société, d’un syndicat, d’une association, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de3cb05-5812-43c7-a35d-c8bd4aec1a87",
                                                "sense_id": "f8a9e4ec-36b7-32f5-82d1-5a337725beca",
                                                "text": "Il appartient au ministère principalement intéressé de préparer le projet de loi de ratification afin qu’il puisse être soumis au Conseil d’État puis inscrit à l’ordre du jour du conseil des ministres et enfin déposé sur le bureau de l’Assemblée nationale ou du Sénat dans le délai fixé par la loi d’habilitation."
                                            },
                                            {
                                                "example_id": "f14128b9-f1ea-42a0-b73d-a59f07424cb5",
                                                "sense_id": "f8a9e4ec-36b7-32f5-82d1-5a337725beca",
                                                "text": "Les rouges étaient aux cent coups. Ils s'étaient réunis en comité restreint dans la cuisine du cafetier. Autour de la toile cirée, le bureau de la Libre-Pensée cogitait ferme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d64e73f-3811-313d-8115-a4d9f2dfe46f",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Surface de travail des environnements graphiques, permettant d’accéder aux différentes ressources de l'appareil (logiciels, fichiers, périphériques...), et sur laquelle s’ouvrent les fenêtres des applications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bb5e1c0-92ea-48c4-8840-4e26c59103dd",
                                                "sense_id": "5d64e73f-3811-313d-8115-a4d9f2dfe46f",
                                                "text": "La disposition au sein du bureau des différentes icônes, raccourcis ou volets peut être gérée par le système d'exploitation ou bien prise en charge par l'utilisateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e147ce-2f28-34c5-9a28-b2507a91659e",
                                        "entry_id": "65048491-ed5c-3685-a8f3-3cca48ceb4dc",
                                        "glosses": [
                                            "Délégation décentralisée d’une agence de presse, d’un journal ou d’un organisme de radiodiffusion ou de télévision."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bureau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a196978-62d7-3ceb-8631-0c0c07884198",
                                        "entry_id": "59218be5-9385-39b6-a19e-2abdf9ebb23f",
                                        "glosses": [
                                            "Petite meule."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bdf7073-feb3-44de-9aad-f9b83bf48101",
                                                "sense_id": "6a196978-62d7-3ceb-8631-0c0c07884198",
                                                "text": "Lorsque le foin était sec, on le ramassait en petites meules hémisphériques, les \"bureaux\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d7be7c-5481-3cda-80bc-60c606ddd077",
                                        "entry_id": "59218be5-9385-39b6-a19e-2abdf9ebb23f",
                                        "glosses": [
                                            "Hutte, cabane."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820d49cc-7342-462a-bf76-2ea1026515d1",
                                                "sense_id": "d7d7be7c-5481-3cda-80bc-60c606ddd077",
                                                "text": "Lorsque le ver est prêt à donner sa soie, son appétit s'arrête. C'est l'instant de la montée. L'éleveur doit alors s'occuper à « cabaner », opération qui consiste à disposer en forme de bureaux ou cabanes, dans les intervalles compris entre les claies, des branches de genêts et de bruyères, dans lesquels les insectes montent et choisissent leur place pour commencer à filer leur cocon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bureau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5efea02-63bc-3411-987c-f4867d08dba0",
                                        "entry_id": "4ccd70e3-5232-354c-bcaa-e246c3cec65d",
                                        "glosses": [
                                            "De la couleur de la bure, marron foncé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b484ef-c638-4f51-a761-8468fac42b09",
                                                "sense_id": "c5efea02-63bc-3411-987c-f4867d08dba0",
                                                "text": "Allons ! dit-elle d’un air tout fier et tout content, retourne de ce pas au bord de la rivière ; descends-la jusqu’à ce que tu entendes bêler ; et où tu verras un agneau bureau, tu verras aussitôt ton frère : si cela n’arrive pas comme je te le dis, je te tiens quitte de ta parole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
