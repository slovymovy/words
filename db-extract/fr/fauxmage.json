                        "examples": [
                            {
                                "example_id": "a186231f-b659-477b-8f2e-f935c07647e4",
                                "sense_id": "b0b1c949-8a95-37d6-8e9c-0103b764bd29",
                                "text": "Essayez cette recette toute simple de fondue au fauxmage, et vous verrez que manger sans produits laitiers ne veut pas dire renoncer à un tel petit péché !"
                            },
