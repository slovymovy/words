                "senses": [
                    {
                        "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                        "entry_id": "db9a6c13-65a5-3e97-8b92-972642b92531",
                        "glosses": [
                            "Dynastie romaine du IIᵉ siècle. — Note d’usage : Ce terme est généralement utilisé au pluriel."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "46f1e279-7243-48ca-a4e0-d1cb306f983a",
                                "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                                "text": "Le vrai, c’est qu’une foule énorme s’étageait, s’écrasait sur les gradins brûlés du vieil amphithéâtre, comme au beau temps des Antonins, et que la fête des comices n’était pour rien dans ce débordement de peuple."
                            },
                            {
                                "example_id": "943ae9cf-dd48-4319-aa36-b6cb2fec299d",
                                "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                                "text": "Comparé à la libéralité et au confort de la vie ordinaire de l’époque, l’ordre de l’Empire romain, sous les Antonins, apparaît local et limité."
                            }
                        ]
                    },
                    {
                        "sense_id": "19889cc0-87c5-36db-8a1f-f16646bc4a8d",
                        "entry_id": "db9a6c13-65a5-3e97-8b92-972642b92531",
                        "glosses": [
                            "Habitant de Saint-Antoine-l’Abbaye, commune française située dans le département de l’Isère."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
