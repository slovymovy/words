                "forms": [
                    {
                        "form_id": "74ca50e4-bc45-4dc4-9729-72049f2698de",
                        "entry_id": "49ae4a10-e8a9-3557-b7fb-122bdaaab9a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "mandes"
