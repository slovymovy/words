                                        "examples": [
                                            {
                                                "example_id": "a11421b9-e684-4853-a865-878772c1d329",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "Lorsqu'il fut à La-Val-Dieu, il s'approcha d'une verrerie dont les ouvreaux flamboyaient de rouges lueurs et dans la grande cour de laquelle il aperçut deux ouvriers."
                                            },
                                            {
                                                "example_id": "23c08c32-5bdb-403d-9ab3-dd97b8d3b346",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "La verrerie de Nancy est de fondation récente, puisqu’elle date de 1875 seulement."
                                            },
                                            {
                                                "example_id": "98833e15-d0b6-4025-819f-825ae130a9a0",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "En France, les premières grandes verreries chauffées au charbon ouvrent leurs portes dans les régions de Bordeaux et de Rouen autour de 1725."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb0da6cb-8bda-306f-883f-08e1302806e2",
                                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
