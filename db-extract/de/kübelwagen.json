                "senses": [
                    {
                        "sense_id": "6a288114-160c-3836-a6ee-9803379532db",
                        "entry_id": "a26bae31-0bae-36c9-b900-c0ebc2b913e2",
                        "glosses": [
                            "offener Geländewagen, vor allem für militärische Zwecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67677ae6-8289-428d-9bb1-c9f48b53a2a1",
                                "sense_id": "6a288114-160c-3836-a6ee-9803379532db",
                                "text": "„Die Fabriken wurden zur Rüstungsproduktion zweckentfremdet, für Panzerketten, Minen und einen Geländewagen, der als Kübelwagen bekannt wurde.“"
                            },
                            {
                                "example_id": "2aa28848-b257-4151-9538-beec7a840bb3",
                                "sense_id": "6a288114-160c-3836-a6ee-9803379532db",
                                "text": "„Sie bat Wassili in seiner Kommandantur um Hilfe, und der fuhr uns mit seinem Kübelwagen eigenhändig ins ehemalige Jüdische Krankenhaus…“"
                            },
                            {
                                "example_id": "b157963d-bd94-4e7e-92b9-4465b9cc0005",
                                "sense_id": "6a288114-160c-3836-a6ee-9803379532db",
                                "text": "„Sie hatten vereinbart, sich erst spät in der Nacht zu treffen, nach der Rückkehr Dincklages von einer seiner nächtlichen Linien-Inspektionen, und Käthe ließ, nachdem das Geräusch des sich entfernenden Kübelwagens verhallt war, noch einige Zeit verstreichen, ehe sie das Haus gegenüber betrat.“"
                            },
                            {
                                "example_id": "60e05146-ff5c-4b23-9caa-48c460820100",
                                "sense_id": "6a288114-160c-3836-a6ee-9803379532db",
                                "text": "„Mit diesen Worten sprang der braune Mensch in einen bereitstehenden Kübelwagen, verschwand in jene Richtung, in der die Rettung liegen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
