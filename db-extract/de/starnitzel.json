                "senses": [
                    {
                        "sense_id": "8fecc2cf-2e58-31da-bce2-ccf683f13913",
                        "entry_id": "3aef133c-c254-3732-b8a4-d526658d4d2f",
                        "glosses": [
                            "trichterförmiger Behälter aus zumeist (zusammengedrehtem) Papier (besonders für Lebensmittel)"
                        ],
                        "tags": [
                            "Bavarian",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "3eef18b8-bd6c-481a-b5b8-0ab399e49a83",
                                "sense_id": "8fecc2cf-2e58-31da-bce2-ccf683f13913",
                                "text": "„Spinatpalatschinken und Starnitzel gefüllt mit Schlag und Beeren der Saison verführen ebenfalls zu einer Einkehr beim Ladinig.“"
                            },
                            {
                                "example_id": "822dc960-ed3d-4939-9d1e-7140ec09e438",
                                "sense_id": "8fecc2cf-2e58-31da-bce2-ccf683f13913",
                                "text": "„Ein paar lukullische Raffinessen hat er sich schon ausgedacht. So soll es zur Eröffnung Tartar vom fränkischen Weideochsen mit Merrettichmousse im Starnitzel geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b27fb79-73a6-3cda-81cc-a48ae6de4af2",
                        "entry_id": "3aef133c-c254-3732-b8a4-d526658d4d2f",
                        "glosses": [
                            "trichterförmige Waffel, in die kleine Portionen Speiseeis gefüllt werden"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "43469a4e-9ffa-4993-bc68-f0cb692da1e7",
                                "sense_id": "5b27fb79-73a6-3cda-81cc-a48ae6de4af2",
                                "text": "„Nach dem Mittagessen und am Nachmittag gibt es ‚Misssi-Eis‘ mit hausgemachten Starnitzel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
