                    {
                        "sense_id": "1204ff68-290d-3673-a109-377225f33b5f",
                        "entry_id": "47a07c99-09cb-34f4-be53-f398f0792ca0",
                        "glosses": [
                            "weibliche Person, die berufsmäßig nach Krabben fischt, Krabbenfischerei betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2bd3bd-d3a6-4ca3-a567-4b582348bfc1",
                                "sense_id": "1204ff68-290d-3673-a109-377225f33b5f",
                                "text": "„Diese Krabbenfischerin mochte siebenzehn oder achtzehn Jahre alt sein. Sie war groß und so schmächtig, daß sich ihre Taille unter der geringsten Anstrengung biegen zu müssen schien. Doch hat diese übermäßige »Schmuckheit« keineswegs eine nervige Stärke ausgeschlossen, die jener der Stahlklinge ähnlich war, welche sich biegt und wieder aufrichtet, ohne jemals zu brechen. [1860]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
