                        ],
                        "examples": [
                            {
                                "example_id": "96db7fd0-e8c7-41c1-adb3-f33a546596a0",
                                "sense_id": "f1bb91ae-8d2a-3e45-8117-49705896de5d",
                                "text": "La chair du concombre est usitée connue aliment; on en prépare, avec le suc exprimé et de la graisse de veau, un liparolé qui est d’un usage général comme cosmétique."
                            },
                            {
                                "example_id": "c720b59a-6b52-4a43-885a-9091648a66a3",
                                "sense_id": "f1bb91ae-8d2a-3e45-8117-49705896de5d",
                                "text": "On trouve dans les pharmacies divers mélanges de graisse et de poudre de cantharides, sous le titre de liparolées, ou sous celui de rétinolées quand la matière est méléé à une certaine quantité de résine."
                            },
                            {
                                "example_id": "97c8fbf4-2e0c-4cc1-aaa0-927f6e212595",
                                "sense_id": "f1bb91ae-8d2a-3e45-8117-49705896de5d",
                                "text": "Il existe différents types de pommades : Les cérats qui sont préparés à la cire, les liparolés avec de la graisse, les glycérats avec de la glycérine et les vaselés à la vaseline."
                            }
                        ]
                    }
