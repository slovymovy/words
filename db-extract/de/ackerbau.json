                    }
                ],
                "senses": [
                    {
                        "sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                        "entry_id": "1269224e-5785-3a1b-8398-2d45b570b301",
                        "glosses": [
                            "Form der Bodennutzung, die auf dem Prinzip regelmäßiger Bearbeitung und nachfolgender pflanzlicher Produktion beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9256e2ed-c754-4245-a294-e02751abbc3d",
                                "sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                                "text": "Nomaden betreiben keinen Ackerbau."
                            },
                            {
                                "example_id": "41478ece-7d84-45b5-9146-3ce0940f18bc",
                                "sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                                "text": "„Die aufgrund von Ackerbau und Viehzucht agrarisch geprägte Gesellschaft der Kelten war streng hierarchisch gegliedert.“"
                            },
                            {
                                "example_id": "c38e25a7-9be0-4c08-a8f9-5ff33c21287a",
                                "sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                                "text": "„Agrarökosysteme sind Landschaften, die vom Menschen urbar gemacht wurden, um Ackerbau und Viehzucht zu betreiben“"
                            },
                            {
                                "example_id": "c9b83e8c-7fc7-4ed6-a529-70fc7fcf8ffa",
                                "sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                                "text": "„Da sie sich auf die Gärtnerei verstanden, mußte ihnen auch der Ackerbau gelingen – und der Ehrgeiz packte sie, ihren Pachthof zu bestellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b41828fd-4489-4099-be16-fde90b810a6b",
                        "source_entry_id": "1269224e-5785-3a1b-8398-2d45b570b301",
                        "source_sense_id": "a373f370-bec8-3dc0-9064-5be03237f0ab",
                        "source_sense_description": "regelmäßige Bearbeitung des Bodens zur Pflanzenproduktion",
                        "target_lang_word": "farming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                                        "entry_id": "1883ec18-24bc-3880-a7ac-db1385f873ac",
                                        "glosses": [
                                            "The business of cultivating land, raising stock, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d159c9d-0155-4533-b09d-65dfc1e711f2",
                                                "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                                                "text": "Gardening, then, is a sort of refined farming upon a limited scale."
                                            },
                                            {
                                                "example_id": "f7b4645c-8f33-42d8-a2ae-3949ca04522a",
                                                "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                                                "text": "Farming was among the earliest of civilized man's occupations, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                        "entry_id": "1883ec18-24bc-3880-a7ac-db1385f873ac",
                                        "glosses": [
                                            "A farming operation; a farm, or instance of farming on a piece of land."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "badb6e75-71b9-41b8-8fcf-4283c69b83a2",
                                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                                "text": "We discharge them also of all Farmings of Benefices, and Church Lands, or Goods, of which they were spoiled by those who Commanded under their General."
                                            },
                                            {
                                                "example_id": "3e2f91c5-a1a6-4506-9a29-829acebd58b8",
                                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                                "text": "After Agricultural Foundation Law was enacted in 1961, the expansion of scale of farm business, the improvement of agricultural foundation, the spread of diversified farming with livestock, the mechanization and the rationalization of farming have accelerated viable farmings."
                                            },
                                            {
                                                "example_id": "f07790d7-ede0-4cde-a574-5036b8b92585",
                                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                                "text": "The problem has been enhanced more so because more agricultural farmings are spreading out leaving but slight margins for cattle farming and fears are expressed by farmers upon the possible cattle intrusion into the farmings ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "farming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "296f9ea0-b7d9-3523-b1b7-df275aee202d",
