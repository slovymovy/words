                                                "text": "Meneer!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc442403-2cf8-3fc5-9112-55ad452f70ed",
                                        "entry_id": "35678a91-6028-33a5-a1db-4dc86da1927b",
