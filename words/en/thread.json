                    "common_phrases": [
                        "threaded with gray",
                        "threaded with silver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переплетать или смешивать, создавая эффект прожилок или вкраплений."
                    },
                    "translations": {
