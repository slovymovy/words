                        "entry_id": "1b6bc278-dab1-3c07-b034-78daec3c8023",
                        "glosses": [
                            "Action d’affermir ou résultat de cette action. Peu usité au propre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76168ed9-ba97-4602-b562-5a99b07782e0",
                                "sense_id": "1b442dd2-2d81-322f-971e-be4d23f85415",
                                "text": "L’affermissement des gencives."
                            }
                        ]
                    },
                    {
                        "sense_id": "e127ecd3-473a-3cb2-b6fe-5e1b4eaeb779",
                        "entry_id": "1b6bc278-dab1-3c07-b034-78daec3c8023",
                        "glosses": [
                            "Action d’affermir ou résultat de cette action. Peu usité au propre.",
                            "Début du durcissement du béton ou de tout autre mortier hydraulique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "bdb3e72a-5702-445b-8378-9ae29154f288",
                                "sense_id": "e127ecd3-473a-3cb2-b6fe-5e1b4eaeb779",
                                "text": "L'influence de la composition du ciment sur la durée d'affermissement d'un béton qui renferme un mélange retardant la prise."
                            }
                        ]
                    },
                    {
                        "sense_id": "22a2df05-e5bb-3d97-b827-940bee0c82ee",
                        "entry_id": "1b6bc278-dab1-3c07-b034-78daec3c8023",
                        "glosses": [
                            "Action d’améliorer un état qui commence à être satisfaisant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0db4b61e-0c41-4483-a7f0-b77e81811163",
                                "sense_id": "22a2df05-e5bb-3d97-b827-940bee0c82ee",
                                "text": "La belle saison contribuera à l’affermissement de sa santé."
                            },
                            {
                                "example_id": "1bf8710c-38d4-4bd8-b0a3-c34f6b8d0185",
                                "sense_id": "22a2df05-e5bb-3d97-b827-940bee0c82ee",
                                "text": "L’affermissement de l’État, du Trône, des lois, de la religion, du crédit public."
                            },
                            {
                                "example_id": "4edf452f-bbc6-4f82-a8b2-3c953a7fd9f1",
                                "sense_id": "22a2df05-e5bb-3d97-b827-940bee0c82ee",
                                "text": "Ce prince dut à l’amour des peuples l’affermissement de son autorité."
                            },
                            {
                                "example_id": "d76b71a2-5efe-43c5-a340-651bb5117038",
                                "sense_id": "22a2df05-e5bb-3d97-b827-940bee0c82ee",
                                "text": "L'un est en relation avec l'histoire antérieure que nous avons décrite et la prolonge en quelque sorte : c'est celui de l'affermissement des usages et des droits, affermissement qui n'est pas exempt d'une certaine évolution, ni sans rapport avec l'ancien phénomène."
                            }
                        ]
                    }
                ],
