                        "translation_id": "bc68866d-c5d0-4e8a-99df-2cef660b9f3f",
                        "source_entry_id": "d85e3f2d-dc34-32ef-b404-d0ce93255b7b",
                        "source_sense_id": "b493dd8c-2ebe-3b34-8c2d-bd603a6cb3d5",
