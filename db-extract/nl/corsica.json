                                    {
                                        "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                        "entry_id": "27f6e493-a0d5-3ea6-a3b7-798b341e6788",
                                        "glosses": [
                                            "Insel im Mittelmeerraum, eine Region Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8c31a9-6def-4f63-9979-e406b74cd906",
                                                "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                                "text": "Korsika liegt im Mittelmeer."
                                            },
                                            {
                                                "example_id": "1f51f158-923a-475d-9477-878fd090ea9e",
                                                "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                                "text": "Das Lagerfeuer auf Korsika erlosch erst am frühen Morgen."
                                            },
                                            {
                                                "example_id": "2aadb114-125f-40ca-a5a0-cb6954684d53",
                                                "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                                "text": "Anna, wir fahren nach Korsika!"
                                            },
                                            {
                                                "example_id": "d58e9fde-aaa8-4a2a-a688-6b90c8e3ecbf",
                                                "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                                "text": "Das Korsika des 18. Jahrhunderts war ein romantisches Fleckchen Erde."
                                            },
                                            {
                                                "example_id": "58121289-4261-46c0-a3e5-1c48c794a1ce",
                                                "sense_id": "e6cc2055-b3ad-3e20-b5f3-b56a82741534",
                                                "text": "Unseren letzten Urlaub verbrachten wir auf Korsika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ea1f918-fe16-4d33-a96e-3487aa1e8105",
