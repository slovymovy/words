                                                "example_id": "09d4ed00-aa86-40f1-83c1-4f05679f6451",
                                                "sense_id": "06b8bbcf-3001-3292-87ba-a458610d2137",
                                                "text": "Der FC Bayern darf sich mit dem Titel „Rekordmeister“ schmücken."
                                            },
