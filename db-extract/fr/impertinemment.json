        "fr-extract.jsonl": [
            {
                "entry_id": "37f71bba-bcd9-3126-900f-7bf9c0a65900",
                "word": "impertinemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ef85a723-a73f-3f44-8305-68680e1a3d3a",
                        "entry_id": "37f71bba-bcd9-3126-900f-7bf9c0a65900",
                        "glosses": [
                            "Mal à propos, d’une manière sotte, extravagante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857c5990-ed4b-48a3-83f5-cfaf0911d769",
                                "sense_id": "ef85a723-a73f-3f44-8305-68680e1a3d3a",
                                "text": "Je ne m’arrête pas à réfuter les lieux où vous me faites parler impertinemment, parce qu’il me suffit d’avoir une fois averti le lecteur que vous ne gardez pas toute la fidélité qui est due au rapport des paroles d’autrui."
                            },
                            {
                                "example_id": "0c222f7d-358a-4bdf-be30-c70ab9b3ddbe",
                                "sense_id": "ef85a723-a73f-3f44-8305-68680e1a3d3a",
                                "text": "Au lieu de faire paroistre un Ange dans un grand ciel dont l’ouverture eût fait celle du theatre, ils l’ont fait venir quelques fois à pied, et quelques fois dans une machine impertinemment faite et impertinemment conduite : au lieu de faire voir dans le renfondrement et en perspective, l’image de la Pucelle au milieu d’un feu allumé et environné d’un grand peuple, comme on leur en avoit enseigné le moyen, ils firent peindre un méchant tableau sans art, sans raison et tout contraire au subjet […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8d6cec7-1b40-32f4-b126-89f38462ca65",
                        "entry_id": "37f71bba-bcd9-3126-900f-7bf9c0a65900",
                        "glosses": [
                            "Avec impertinence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0376c7-e0e6-4ab2-a332-38da469e0759",
                                "sense_id": "f8d6cec7-1b40-32f4-b126-89f38462ca65",
                                "text": "Il a répondu impertinemment."
                            },
                            {
                                "example_id": "699e49bf-3ae3-4521-9d3a-c2be5707d53a",
                                "sense_id": "f8d6cec7-1b40-32f4-b126-89f38462ca65",
                                "text": "Le sanglier mal morigéné s’est impertinemment détourné contre nous."
                            },
                            {
                                "example_id": "18f91484-2299-488e-9b0d-6279784fde8b",
                                "sense_id": "f8d6cec7-1b40-32f4-b126-89f38462ca65",
                                "text": "Vous donnez sottement vos qualités aux autres. - Fort impertinemment vous me jetez les vôtres."
                            }
                        ]
                    }
                ],
