                "senses": [
                    {
                        "sense_id": "0210ed82-3218-39ca-94c4-17011a6d12c9",
                        "entry_id": "6a2b75e4-144c-35d0-b6df-fdfdf91d5e2a",
                        "glosses": [
                            "zonder dat men doet alsof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9197aea2-498e-4d06-92b8-f254f4b20994",
                                "sense_id": "0210ed82-3218-39ca-94c4-17011a6d12c9",
                                "text": "Quispel zou en moest haar nog een keer met zijn ogen bezitten, zeker nu hij had gemerkt hoe ongeveinsd haar genot was."
                            },
                            {
                                "example_id": "6be6b1f5-02f1-41b7-b7f1-66eac54e92c5",
                                "sense_id": "0210ed82-3218-39ca-94c4-17011a6d12c9",
                                "text": "Ik had er tot dusver zó nog nooit bij stilgestaan. Maar nu bedenk ik: zou Hij soms ook dit bedoeld hebben? Te worden als zo’n kind. Niet alleen: zo onbevangen als een kind. En niet alleen: zo vertrouwend als een kind. Maar ook: zo verontwaardigd als een kind. Zo oprecht verontwaardigd zoals alleen een kind kan zijn. Met echt en ongeveinsd verdriet. Omdat het aangetast is in zijn of haar prille en pure godsbesef."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e12b6a9-6642-4736-a990-e3c5d8eae5df",
                        "source_entry_id": "6a2b75e4-144c-35d0-b6df-fdfdf91d5e2a",
                        "source_sense_id": "0210ed82-3218-39ca-94c4-17011a6d12c9",
                        "source_sense_description": "zonder dat men doet alsof",
                        "target_lang_word": "heartfelt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartfelt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                        "entry_id": "4d38fbdd-b9c6-3091-811a-91df5470122c",
                                        "glosses": [
                                            "Believed or felt deeply and sincerely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7a3bc0-f890-49cf-9578-4c96841ca65c",
                                                "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                                "text": "She expressed her heartfelt sympathies at the death of his mother."
                                            },
                                            {
                                                "example_id": "debb4312-5130-48a7-8da3-ae0d635ec542",
                                                "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                                "text": "a heartfelt apology"
                                            },
                                            {
                                                "example_id": "63ca9e1f-9844-4a1d-9e37-d5d4a4a50524",
                                                "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                                "text": "[T]hey were not the spoiled children of affectation and refinement, but a bold, vigorous, independent race of thinkers, with prodigious strength and energy, with none but natural grace, and heartfelt unobtrusive delicacy."
                                            },
                                            {
                                                "example_id": "32bf274a-79cd-44b3-84aa-799182507b21",
                                                "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                                "text": "Infused with family warmth, but with a knowing adult eye on the loss of innocence, it is one of the year's most genuinely heartfelt films."
                                            },
                                            {
                                                "example_id": "84f54435-b80b-4f90-8323-1f30c58c64b0",
                                                "sense_id": "88ec7023-1df7-32f7-af61-34a5409de3fb",
                                                "text": "He fell flat on his back before Sinner trudged around the net for a warm, heartfelt embrace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d00a5483-2816-4753-bfc7-a4c05444ad37",
                        "source_entry_id": "6a2b75e4-144c-35d0-b6df-fdfdf91d5e2a",
                        "source_sense_id": "0210ed82-3218-39ca-94c4-17011a6d12c9",
                        "source_sense_description": "zonder dat men doet alsof",
                        "target_lang_word": "sincere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sincere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "Genuine; meaning what one says or does; heartfelt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76219fc4-baa4-4577-bda1-da5f55e20a7c",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "I believe he is sincere in his offer to help."
                                            },
                                            {
                                                "example_id": "7230d0e2-a073-40c4-b732-efa97db4099b",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "Tumid blustering, with more or less of sincerity, which need not be entirely sincere, yet the sincerer the better, is like to go far."
                                            },
                                            {
                                                "example_id": "2aa27c6c-8f04-4e4d-9c5d-9a8219846561",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "My sincerest apologies to Brother Ron Smith in the December ish."
                                            },
                                            {
                                                "example_id": "58bfafab-c385-4d58-8ef0-8dc284705263",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "If you choose to pull the trigger, should your drama prove sincere\nDo it somewhere far away from here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "Meant truly or earnestly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef05df3d-1155-46e2-a7cc-72fddd31bddd",
                                                "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                                "text": "She gave it a sincere if misguided effort."
                                            },
                                            {
                                                "example_id": "ab86c110-3c8d-4bd9-90f7-144014e5cb17",
                                                "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                                "text": "The message that through sincere teshuvah and resolution, light and gladness can be achieved by all, is most fitting for the opening of the Yom Kippur service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683b4beb-5d15-3c83-adb1-efbcda24269b",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "clean; pure"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
