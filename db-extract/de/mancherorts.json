        "de-extract.jsonl": [
            {
                "entry_id": "d5c67a92-a124-3166-b66d-76d157896259",
                "word": "mancherorts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "787181a6-078c-30d8-a9cb-9bc93e0a73b8",
                        "entry_id": "d5c67a92-a124-3166-b66d-76d157896259",
                        "glosses": [
                            "an manchen Orten, an einigen Stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231ed7f0-9d57-4679-aeb8-16fc96993bca",
                                "sense_id": "787181a6-078c-30d8-a9cb-9bc93e0a73b8",
                                "text": "Mancherorts ist es üblich, jeden Sonntag in die Kirche zu gehen."
                            },
                            {
                                "example_id": "a5b21471-9970-4007-ad59-e440106248bf",
                                "sense_id": "787181a6-078c-30d8-a9cb-9bc93e0a73b8",
                                "text": "„Mit den schweren Granitfelsen, die mancherorts zu Wellenbrechern aufgetürmt sind, hat der Tsunami gespielt wie mit Bocciakugeln.“"
                            },
                            {
                                "example_id": "d60e6174-039f-48a4-a72a-2dfee09c5680",
                                "sense_id": "787181a6-078c-30d8-a9cb-9bc93e0a73b8",
                                "text": "„Gleich dahinter begrenzten Vulkane mit ihren roten, mancherorts fast violetten Hängen die Sicht.“"
                            },
                            {
                                "example_id": "c2c7090f-cd1c-401f-9f01-2fa039999ac0",
                                "sense_id": "787181a6-078c-30d8-a9cb-9bc93e0a73b8",
                                "text": "„Junge Frauen verlassen Ostdeutschland in Scharen. […] Mancherorts beträgt der Männerüberschuss 25 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
