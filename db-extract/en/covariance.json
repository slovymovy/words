                    },
                    {
                        "translation_id": "4311b5e0-755a-4fc9-abd0-213fa45288cd",
                        "source_entry_id": "f6e82419-146b-321a-b4d9-0e4803ddda0f",
                        "source_sense_description": "statistical measure",
                        "target_lang_word": "covariantie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
