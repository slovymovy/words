                    {
                        "sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
                        "entry_id": "911b16c4-dac2-35ec-b27f-8d04bf999fb5",
                        "glosses": [
                            "Better than some other option; preferred."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06eba912-5e0a-496e-973f-75e01ff0b9d2",
                                "sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
                                "text": "This work has been the care and ſtudy of ſome years; as far as health, and other affairs, would permit. For, this appeared, to the author, of as much greater importance, than any other hiſtory whatever; as morality and religion are more excellent, than any temporal affairs; and the hiſtory of true religion, præferrable to that of impoſtures and deluſions."
                            },
                            {
                                "example_id": "5893b223-f834-4052-9f97-5c7c204ef244",
                                "sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
                                "text": "It is not to the point that an inequality of material goods, at high levels, may not be preferable to an equality of material goods at a lower level, precisely for such reasons as self-respect."
                            },
                            {
                                "example_id": "90289261-d1ba-43d3-8bf7-4f216f22b66c",
                                "sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
                                "text": "While adopting the pronoun as a nonbinary description is vastly preferable for some, Merriam-Webster says, there has also been some debate that it is ungrammatical."
                            },
                            {
                                "example_id": "3fa0c3a2-2213-4a2e-96c3-6997deedefbb",
                                "sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
                                "text": "If you’re looking for the most breathable mask, Lukovics says, “Cotton is preferable, mainly for absorbing moisture/sweat.” She says multiple layers may be more protective but will also impact breathability."
                            }
                        ]
                    }
