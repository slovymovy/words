                "senses": [
                    {
                        "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                        "entry_id": "e1df3607-617b-347a-83bf-0b4d558fc996",
                        "glosses": [
                            "Zahl, die angibt, in welcher Reihenfolge die Teilnehmer eines Wettbewerbs an den Start gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8705231c-5339-441f-92eb-db6a4da8826b",
                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                "text": "„Österreichs Vertreterin Zoë startet dabei mit Startnummer 24 und somit als Drittletzte in den Bewerb.“"
                            },
                            {
                                "example_id": "eb205ee9-0b41-4792-88e6-c00455979d2a",
                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                "text": "„Dass er mit der hohen Startnummer 15 ins Rennen gegangen war, wirkte sich nicht nachteilig aus; die Qualität des Eises liess kaum nach.“"
                            },
                            {
                                "example_id": "f199207d-33e8-40ea-903b-269c9b6f2ae5",
                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                "text": "„In der kommenden Saison gehen die Formel-1-Piloten erstmals mit einer festvergebenen Startnummer ins Rennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
