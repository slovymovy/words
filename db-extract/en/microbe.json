    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0f836c5c-6f77-3485-a675-8ff2e5d394a2",
                "word": "microbe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0fe64c79-e4f4-4a74-b058-920890cfb6a8",
                        "entry_id": "0f836c5c-6f77-3485-a675-8ff2e5d394a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "microbes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                        "entry_id": "0f836c5c-6f77-3485-a675-8ff2e5d394a2",
                        "glosses": [
                            "Any microorganism; (loosely, nonscientifically) especially, a harmful bacterium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c22f87a-8c3a-4ba5-b30f-1f04e35db345",
                                "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                                "text": "We humans and other complex animals are full of microbes, gajillions of them. People have so many that microbe cells living in our bodies outnumber our own vastly."
                            },
                            {
                                "example_id": "8dc7f278-c5d6-44c3-b700-d37bf762684a",
                                "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                                "text": "Yes, there are microbes everywhere and most are just fine for us, perhaps even beneficial to our microbiomes and immune systems. We don’t care about those."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd7cb338-5911-45ba-b2a0-6f9e8179c287",
                        "source_entry_id": "0f836c5c-6f77-3485-a675-8ff2e5d394a2",
                        "source_sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
