        "ru-extract.jsonl": [
            {
                "entry_id": "ba8f6ba1-b80c-3f38-9545-00dc4c0b6923",
                "word": "мигом",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                        "entry_id": "ba8f6ba1-b80c-3f38-9545-00dc4c0b6923",
                        "glosses": [
                            "разг. очень быстро, сразу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc26a58a-0407-453a-8a84-9ef800d10edf",
                                "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                                "text": "Городовой мигом все понял и сообразил."
                            },
                            {
                                "example_id": "b089e7b0-8a1d-4cff-9727-9527f49e840a",
                                "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                                "text": "В ней мигом проснулась капризно-своенравная, избалованная натура."
                            },
                            {
                                "example_id": "ee6bcec6-edba-4942-8604-84867d875375",
                                "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                                "text": "Настасья Филипповна даже вздрогнула от гнева и пристально поглядела на Фердыщенка; тот мигом струсил и примолк, чуть не похолодев от испуга: слишком далеко уж зашел."
                            },
                            {
                                "example_id": "aa5ea3c5-c8c5-466a-8b5d-13cdc7d878e6",
                                "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                                "text": "Она мигом вскочила и набросила на себя свою чёрную шаль."
                            },
                            {
                                "example_id": "80274ffd-fe43-46d7-8315-5c3c5c0aa033",
                                "sense_id": "c86735a3-e41e-3b54-94ed-3d50b763c07f",
                                "text": "Он те шею свернет — мигом!"
                            }
                        ]
                    }
                ],
