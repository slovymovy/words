        "nl-extract.jsonl": [
            {
                "entry_id": "044ac158-6eb1-3d80-9169-6be9c1049aa1",
                "word": "bankgeld",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "423c8c2f-73e4-3def-8ec9-0bc51af31bdd",
                        "entry_id": "044ac158-6eb1-3d80-9169-6be9c1049aa1",
                        "glosses": [
                            "giraal tegoed dat op een bankrekening staat zonder dat daar contant geld of edelmetaal tegenover staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d61224-edac-4245-845a-31804939ae38",
                                "sense_id": "423c8c2f-73e4-3def-8ec9-0bc51af31bdd",
                                "text": "Cryptoverslaving is verslaving aan cryptovaluta. Dat zijn munten die je niet in je portemonnee hebt, maar op internet. Ze lijken op aandelen, die je kunt kopen en verkopen, maar alles is virtueel. Wat een aandeel waard is, hangt af van wat we met z’n allen vinden dat het waard is. Dat geldt in zekere zin ook wel voor bankgeld, waarvan de koersen kunnen veranderen, maar daar bestaat toch een duidelijker relatie met banken die voor een bepaalde waarde garant staan."
                            },
                            {
                                "example_id": "74d0d89c-69ad-40bc-91dc-8cf23329bf47",
                                "sense_id": "423c8c2f-73e4-3def-8ec9-0bc51af31bdd",
                                "text": "Het beroemdste Belgische oplichtingsgeval waarin met \"bankgeld\" \"gesjoemeld\" werd, kwam twee jaar geleden aan het licht. Niet de bankklanten bleken het slachtoffer, wel de bank zelf. Daisy Ragolle, een kaderlid van Crédit Lyonnais in Gent, bleek haar bank (huidig Deutsche Bank) te hebben getild voor liefst 3,6 miljard frank. De opbrengst van de fraude werd doorgepompt naar de \"affaires\" van haar echtgenoot, de omstreden zakenman Laurent Demey, ex-SV Waregem voorzitter."
                            },
                            {
                                "example_id": "71eaa381-53fb-48b7-aa51-a169f92d1d91",
                                "sense_id": "423c8c2f-73e4-3def-8ec9-0bc51af31bdd",
                                "text": "Bankiers namen toch te veel risico’s met bankgeld, om hoge bonussen te krijgen?"
                            },
                            {
                                "example_id": "1cdcb169-c1b7-4158-a8ba-7a814b0a04d7",
                                "sense_id": "423c8c2f-73e4-3def-8ec9-0bc51af31bdd",
                                "text": "Bankbazen blijken door hun kuddementaliteit al geen vaardige kapiteins, maar de combinatie van bankgeld en politiek aandeelhouderschap is een recept voor kredietverlening tegen de klippen op. Kredietgroei is voor een politicus economische groei. Hoe meer, hoe beter. Stroppen zijn van later zorg."
                            }
                        ]
                    }
