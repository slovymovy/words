{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23723bbb-9042-30a0-884f-676e7fc72fb8",
                    "sense_definition": "Assorted miscellaneous objects, gadgets, or clutter, especially of little value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "miscellaneous_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My desk drawer is completely full of odd cables and other useless <w>gubbins</w>.",
                            "target_lang_translations": {
                                "tr": "Çalışma masamın çekmecesi tuhaf kablolar ve diğer işe yaramaz <w>ıvır zıvırla</w> dopdolu."
                            }
                        },
                        {
                            "text": "Before we move to the new flat, we need to throw out all this old <w>gubbins</w>.",
                            "target_lang_translations": {
                                "tr": "Yeni daireye taşınmadan önce bu eski püskü <w>döküntülerin</w> hepsini atmamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "junk",
                        "stuff",
                        "odds and ends",
                        "bric-a-brac"
                    ],
                    "common_phrases": [
                        "extra gubbins",
                        "useless gubbins"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal British English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle az değerli, karmaşık veya önemsiz çeşitli aletler, ıvır zıvır veya eşyalar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ıvır zıvır",
                                "target_lang_sense_clarification": "önemsiz, ufak tefek eşyalar"
                            },
                            {
                                "target_lang_word": "döküntü",
                                "target_lang_sense_clarification": "değersiz veya kalabalık yapan eşya"
                            },
                            {
                                "target_lang_word": "ıvır zıvır şeyler",
                                "target_lang_sense_clarification": "çeşitli küçük alet edevat ve kalabalık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d41329a3-69d7-3a6b-ab23-cc9403ada388",
                    "sense_definition": "A silly or foolish person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foolish_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a silly <w>gubbins</w> and put your coat on before going out.",
                            "target_lang_translations": {
                                "tr": "Böyle <w>şapşallık</w> yapma da dışarı çıkmadan önce montunu giy."
                            }
                        },
                        {
                            "text": "He felt like a complete <w>gubbins</w> after forgetting his own house keys again.",
                            "target_lang_translations": {
                                "tr": "Kendi evinin anahtarlarını yine unuttuktan sonra kendini tam bir <w>sersem</w> gibi hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool"
                    ],
                    "common_phrases": [
                        "silly gubbins"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Affectionate or informal insult"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Aptal, sersem veya saf kişi (genellikle şaka yollu veya sevecen bir sitemle söylenir)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şapşal",
                                "target_lang_sense_clarification": "sevimli veya zararsız aptal"
                            },
                            {
                                "target_lang_word": "sersem",
                                "target_lang_sense_clarification": "düşüncesizce hareket eden kimse"
                            },
                            {
                                "target_lang_word": "budala",
                                "target_lang_sense_clarification": "aptalca davranan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21803fa2-ff0a-334d-b447-13f09d9b06f9",
                    "sense_definition": "Fragments, parings, or refuse, especially scrap pieces of fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_scraps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishmonger tossed the remaining <w>gubbins</w> to the stray cats waiting outside.",
                            "target_lang_translations": {
                                "tr": "Balıkçı, kalan <w>artıkları</w> dışarıda bekleyen sokak kedilerine fırlattı."
                            }
                        },
                        {
                            "text": "A foul smell rose from the bucket of fish <w>gubbins</w> left under the midday sun.",
                            "target_lang_translations": {
                                "tr": "Öğle güneşinin altında bırakılan balık <w>sakatatı</w> kovasından pis bir koku yükseldi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage for scraps and offal"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kırıntılar, artıklar; özellikle balık artıkları veya sakatat parçaları."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "artıklar",
                                "target_lang_sense_clarification": "özellikle balık vb. temizleme atıkları"
                            },
                            {
                                "target_lang_word": "sakatat",
                                "target_lang_sense_clarification": "balık veya hayvanın yenmeyen kısımları"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "148318fa-e472-332d-834c-d3b6d18ae0ff",
                    "sense_definition": "A surname originating as a patronymic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We scheduled a meeting with Mr. <w>Gubbins</w> to discuss the project timeline.",
                            "target_lang_translations": {
                                "tr": "Proje takvimini görüşmek için Bay <w>Gubbins</w> ile bir toplantı ayarladık."
                            }
                        },
                        {
                            "text": "Several families named <w>Gubbins</w> have lived in this county for generations.",
                            "target_lang_translations": {
                                "tr": "<w>Gubbins</w> soyadını taşıyan birkaç aile, nesillerdir bu vilayette yaşamaktadır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Patronymic family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir İngiliz soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Gubbins",
                                "target_lang_sense_clarification": "özel soyadı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4169a6d7-ef57-3ee2-81bd-17e462a6cfe1",
                    "sense_definition": "A legendary group or race of outlaws and barbarians historically said to inhabit Devonshire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "Old folklore described the <w>Gubbins</w> as wild inhabitants dwelling near Dartmoor.",
                            "target_lang_translations": {
                                "tr": "Eski halk anlatıları, <w>Gubbinsleri</w> Dartmoor yakınlarında ikamet eden vahşi sakinler olarak tasvir ederdi."
                            }
                        },
                        {
                            "text": "The poet wrote of the unruly <w>Gubbins</w> living outside ordinary civil law.",
                            "target_lang_translations": {
                                "tr": "Şair, olağan medeni kanunların dışında yaşayan kuralsız <w>Gubbinsler</w> hakkında yazdı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Devon folklore"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Historical folklore"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tarihsel olarak Devonshire bölgesinde yaşadığı rivayet edilen efsanevi bir kanun kaçağı veya barbar topluluk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Gubbinsler",
                                "target_lang_sense_clarification": "efsanevi topluluk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}