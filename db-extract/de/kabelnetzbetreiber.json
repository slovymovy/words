                                "example_id": "451f9d40-c706-4b13-a643-7085fb723644",
                                "sense_id": "e88e6923-62ca-3d56-aed4-66e222e23126",
                                "text": "„Die Kabelnetzbetreiber speisen die Programme aller öffentlich-rechtlichen Sender auf der Grundlage der im Rundfunkstaatsvertrag festgeschriebenen \"Must Carry\"-Regel ein.“"
                            },
                            {
                                "example_id": "05b3aead-7876-4efc-8c3c-9593dc7db818",
                                "sense_id": "e88e6923-62ca-3d56-aed4-66e222e23126",
                                "text": "„Extreme Geschwindigkeit beim Surfen und Herunterladen im Netz - was der Kabelnetzbetreiber Kabel Deutschland seinen Kunden verspricht, klingt gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
