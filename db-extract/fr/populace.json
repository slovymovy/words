                "entry_id": "3c09b3da-bc1f-33c3-8d37-23155cee037a",
                "word": "populace",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02886409-0ada-4982-8375-d6e0262a4e67",
                        "entry_id": "3c09b3da-bc1f-33c3-8d37-23155cee037a",
                        "tags": [
