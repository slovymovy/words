                "senses": [
                    {
                        "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                        "entry_id": "41df8700-e1df-3868-9557-d08307ca2cec",
                        "glosses": [
                            "spezielles Bauelement für Gebäude und Räume, durch den gezielt Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0835ebe1-00f9-4be0-b83f-d8207e0d7950",
                                "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                                "text": "„DieLüftungssteine sind aus organischen Intumiszensmaterial gefertigt, das bei Hitzeeinwirkung aufschäumt, Öffnungen, Schlitze und Fugen verschließt und damit einen Durchtritt von Feuer und Rauch oberhalb von seiner Reaktionstemperatur verhindert“"
                            },
                            {
                                "example_id": "0f3b5a86-d40d-42d3-bb96-ec22806b0086",
                                "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                                "text": "„Ein bis zwei Lüftungssteine pro Raum sind – abhängig von der Raumgröße – ausreichend.“"
                            },
                            {
                                "example_id": "b1e70ac2-67d8-4c6a-83d1-6deb7a8a405e",
                                "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                                "text": "„Der HE-LÜ Lüftungsstein stellt den neuesten Stand der Technik dar und wird von Schornsteinfegern und Kamin/Ofen-Herstellern empfohlen.“"
                            },
                            {
                                "example_id": "ec4cb190-211b-4915-92b8-f8a58cf49640",
                                "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                                "text": "„Der Eignungsnachweis über den Einbau von Lüftungssteinen in brandschutztechnisch klassifizierten Bauteilen wird in \"Allgemeinen bauaufsichtlichen Zulassungen\" geregelt und nicht mehr in \"Allgemein bauaufsichtlichen Prüfzeugnissen\".“"
                            },
                            {
                                "example_id": "908c04f6-8135-4e64-af3a-63b588ffaa24",
                                "sense_id": "dd78f48e-43f1-3e64-82b8-71ede0cdc9e2",
                                "text": "„Anstelle von Lüftungssteinen darf auch eine äquivalente Anzahl offener Stoßfugen treten (vgl. hinterlüftete Wetterschutzschale). “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
