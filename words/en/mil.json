{
    "word_family": [
        "million",
        "millimeter",
        "milliliter",
        "military"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff00f730-f705-383f-96b7-3ba0d13ea37d",
                    "sense_definition": "A clipping of <w>million</w>, often used when referring to sums of money.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tech startup was sold for a cool ten <w>mil</w> last week.",
                            "target_lang_translations": {
                                "ru": "Технологический стартап был продан на прошлой неделе за кругленькие десять <w>лямов</w>."
                            }
                        },
                        {
                            "text": "You can do a lot with a couple of <w>mil</w> in the bank.",
                            "target_lang_translations": {
                                "ru": "Можно много чего сделать, имея пару <w>миллионов</w> в банке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "couple of mil",
                        "ten mil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от миллиона, часто используемое при упоминании денежных сумм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лям",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "миллион",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1719d372-9b10-3276-800b-d3ed706fa176",
                    "sense_definition": "A clipping of <w>milliliter</w>, a unit of liquid volume.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told her to give the child ten <w>mils</w> of cough syrup.",
                            "target_lang_translations": {
                                "ru": "Врач велел ей дать ребенку десять <w>миллилитров</w> сиропа от кашля."
                            }
                        },
                        {
                            "text": "You need to measure exactly five <w>mils</w> for the recipe to work.",
                            "target_lang_translations": {
                                "ru": "Нужно отмерить ровно пять <w>мл</w>, чтобы рецепт получился."
                            }
                        }
                    ],
                    "synonyms": [
                        "ml",
                        "cc"
                    ],
                    "common_phrases": [
                        "ten mils"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in medical or cooking contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от миллилитра, единицы объема жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мл",
                                "target_lang_sense_clarification": "стандартное сокращение"
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "в медицине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b401b04-807a-3f68-9596-de8a31518655",
                    "sense_definition": "A clipping of <w>millimeter</w>, a unit of length.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was carrying a nine <w>mil</w> handgun when he was caught.",
                            "target_lang_translations": {
                                "ru": "При задержании у подозреваемого был девяти<w>миллиметровый</w> пистолет."
                            }
                        },
                        {
                            "text": "These plastic bars are about ten <w>mils</w> in diameter.",
                            "target_lang_translations": {
                                "ru": "Эти пластиковые стержни имеют диаметр около десяти <w>миллиметров</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mm"
                    ],
                    "common_phrases": [
                        "nine mil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "frequently used regarding firearm calibers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от миллиметра, единицы длины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мм",
                                "target_lang_sense_clarification": "стандартное сокращение"
                            },
                            {
                                "target_lang_word": "миллиметр",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16e47f07-a9e2-3cae-bed3-b4c6af941520",
                    "sense_definition": "An initialism of <w>mother-in-law</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>MIL</w> is coming over for dinner this Sunday.",
                            "target_lang_translations": {
                                "ru": "Моя <w>свекровь</w> придет к нам на ужин в это воскресенье."
                            }
                        },
                        {
                            "text": "She has a great relationship with her <w>MIL</w> and father-in-law.",
                            "target_lang_translations": {
                                "ru": "У нее прекрасные отношения со своей <w>тещей</w> и тестем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in internet forums and texting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для обозначения свекрови или тещи (mother-in-law)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свекровь",
                                "target_lang_sense_clarification": "мать мужа"
                            },
                            {
                                "target_lang_word": "теща",
                                "target_lang_sense_clarification": "мать жены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "755664cf-1023-301c-a24b-052ce5793126",
                    "sense_definition": "A unit of measurement equal to one thousandth of an inch, used for the thickness of materials.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For this task, I prefer the plastic sheeting that is ten <w>mils</w> thick.",
                            "target_lang_translations": {
                                "ru": "Для этой задачи я предпочитаю пластиковую пленку толщиной в десять <w>милов</w>."
                            }
                        },
                        {
                            "text": "The coating must be at least one <w>mil</w> to provide protection.",
                            "target_lang_translations": {
                                "ru": "Покрытие должно быть толщиной не менее одного <w>мила</w> для обеспечения защиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "thou"
                    ],
                    "common_phrases": [
                        "mils thick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения, равная одной тысячной дюйма, используемая для измерения толщины материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мил",
                                "target_lang_sense_clarification": "1/1000 дюйма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b1867f9-197b-3e84-bad8-c2c2fddfe13d",
                    "sense_definition": "An angular unit of measurement used in artillery and navigation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier adjusted the sight by one <w>mil</w> to hit the target.",
                            "target_lang_translations": {
                                "ru": "Солдат поправил прицел на одну <w>тысячную</w>, чтобы поразить цель."
                            }
                        },
                        {
                            "text": "A dot in a <w>mil</w>-dot reticle represents a specific angular distance.",
                            "target_lang_translations": {
                                "ru": "Точка в сетке <w>mil</w>-dot соответствует определенному угловому расстоянию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mil-dot reticle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "usage varies by country"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угловая единица измерения, используемая в артиллерии и навигации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мил",
                                "target_lang_sense_clarification": "угловая единица"
                            },
                            {
                                "target_lang_word": "тысячная",
                                "target_lang_sense_clarification": "в артиллерии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d354b41-95eb-33b7-8e93-18e386650a26",
                    "sense_definition": "A clipping of <w>military</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was wearing a <w>mil</w>-spec jacket that he bought at the surplus store.",
                            "target_lang_translations": {
                                "ru": "На нем была куртка <w>армейского</w> образца, которую он купил в магазине военного снаряжения."
                            }
                        },
                        {
                            "text": "The equipment was built to <w>mil</w> standards for durability.",
                            "target_lang_translations": {
                                "ru": "Оборудование было изготовлено по <w>военным</w> стандартам прочности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mil-spec"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in technical or surplus contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова «военный» (military)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "военный",
                                "target_lang_sense_clarification": "армейский"
                            },
                            {
                                "target_lang_word": "милитари",
                                "target_lang_sense_clarification": "стиль или стандарт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "19e428cb-5d0f-3997-b650-fc9215b7a1cb",
                    "sense_definition": "A clipping of <w>Milwaukee</w>, the largest city in Wisconsin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We are heading up to <w>Mil</w> for the baseball game this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы едем в <w>Милуоки</w> на бейсбольный матч."
                            }
                        },
                        {
                            "text": "He grew up in <w>Mil</w> before moving to Chicago.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Милуоки</w>, прежде чем переехать в Чикаго."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in the United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название города Милуоки, штат Висконсин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Милуоки",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}