                "senses": [
                    {
                        "sense_id": "cb972346-bf69-3f70-af3a-e2608c89a3ed",
                        "entry_id": "0f310315-ac44-3db8-b43e-007eac1e8b69",
                        "glosses": [
                            "Prüfung, ob eine Speise innen schon fertig gebacken, gebraten oder gekocht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906129dd-23db-4386-b9c5-40ade27182df",
                                "sense_id": "cb972346-bf69-3f70-af3a-e2608c89a3ed",
                                "text": "„Nach etwa 45 Minuten die erste Garprobe machen. Dafür einen Holzspieß in die Mitte des Kuchens stecken. Haftet nach dem Herausziehen kein Teig mehr daran, ist der Kuchen fertig.“"
                            },
                            {
                                "example_id": "1ef3c29b-d377-4062-8b74-d601fcec7938",
                                "sense_id": "cb972346-bf69-3f70-af3a-e2608c89a3ed",
                                "text": "„Machen Sie nach etwa 30 Minuten die Garprobe: Wenn sich die Rückenflosse leicht herausziehen läßt, ist der Fisch gar.“"
                            },
                            {
                                "example_id": "7c51e269-bad4-4aef-95a0-b50b36cf828a",
                                "sense_id": "cb972346-bf69-3f70-af3a-e2608c89a3ed",
                                "text": "„Die Garprobe geht so: Mit einer Fleischgabel einstechen – wenn das Fleisch leicht von der Gabel rutscht, ist es fertig.“"
                            },
                            {
                                "example_id": "29b8884e-5ad5-4bb1-bce8-409a937a868c",
                                "sense_id": "cb972346-bf69-3f70-af3a-e2608c89a3ed",
                                "text": "„Garprobe machen: Die Creme sollte sich elastisch anfühlen, aber nicht mehr fließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
