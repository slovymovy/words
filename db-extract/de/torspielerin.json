                "senses": [
                    {
                        "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                        "entry_id": "247ada5f-4899-3d38-910c-0c47661b1aac",
                        "glosses": [
                            "weibliche Person im Tor"
                        ],
                        "tags": [
                            "Ballsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2e420609-ee5b-459b-95d4-29e374108824",
                                "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                                "text": "„Hast Du Spaß am Fußball, kannst gut spielen und möchtest bei der Sportvg Feuerbach mitspielen?? Die Sportvg sucht eine Torspielerin.“"
                            },
                            {
                                "example_id": "1dcf008e-2ea8-4043-8cee-709e6247556b",
                                "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                                "text": "„Für die Saison 17/18 suchen wir dringend eine Torspielerin. Wenn du Lust und Interesse hast melde dich einfach.“"
                            },
                            {
                                "example_id": "8e885596-b602-4954-9e7b-be5555c8afcb",
                                "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                                "text": "„Die Abwehr und vor allem die Torspielerin der TSG hielten das Team weiterhin im Rennen.“"
                            },
                            {
                                "example_id": "3d79472c-a051-45da-8a06-18317b0b88d5",
                                "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                                "text": "„Trotz der großen Tore landeten alle Schüsse entweder neben dem Tor, darüber oder direkt in den Armen der Torspielerinnen.“"
                            },
                            {
                                "example_id": "2850ad40-4da2-469a-9047-695ecb40d7f0",
                                "sense_id": "18bfb856-8886-33cd-a736-6ac65fe30644",
                                "text": "„Im Tor spielte dieses Mal Jil Schneider, die im Pokal immer beweisen darf, dass Crailsheim mit ihr und Nadine Steiner zwei gute Torspielerinnen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
