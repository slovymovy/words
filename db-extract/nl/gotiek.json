                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gothic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adfe2c3d-2100-32c7-a08d-8ea5b23ffab6",
