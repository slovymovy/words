                                            {
                                                "example_id": "2130e97d-1ca2-48ce-9fcc-c498f1998dd1",
                                                "sense_id": "d86f0785-f5a8-38d2-b7ac-26a14dd52e44",
                                                "text": "\"Mil coisas!\" era o bordão daquele meu amigo, encaixava em qualquer frase que cabia."
