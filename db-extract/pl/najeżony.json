                "senses": [
                    {
                        "sense_id": "8a1e443b-f203-3d34-9da0-63e1b014b17c",
                        "entry_id": "16011db4-a207-37ec-8d60-72baf829aaed",
                        "glosses": [
                            "pokryty czymś ostrym, sterczącym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe49645-026c-48dc-b978-c4de9570d6b0",
                                "sense_id": "8a1e443b-f203-3d34-9da0-63e1b014b17c",
                                "text": "Zwykle sterczące wąsiki ułożyły mu się poziomo; za to włosy miał bardziej najeżone"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "08056fdf-404a-3e35-a689-4a233e8c06d0",
                        "entry_id": "16011db4-a207-37ec-8d60-72baf829aaed",
                        "glosses": [
                            "mający groźny, nieprzystępny wygląd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17ebf54e-a35f-432a-a18d-fb59bf30eaef",
                                "sense_id": "08056fdf-404a-3e35-a689-4a233e8c06d0",
                                "text": "Wojciech, mędrzec ponury, łapie młodzież żywą, A najeżony miną poważnie żarliwą"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9c6f7f4b-442b-3210-b45c-242f1123c41f",
                        "entry_id": "16011db4-a207-37ec-8d60-72baf829aaed",
                        "glosses": [
                            "przepełniony czymś trudnym do przezwyciężenia, rozwiązania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5123e5aa-422d-4744-93e5-37c5e89588ef",
                                "sense_id": "9c6f7f4b-442b-3210-b45c-242f1123c41f",
                                "text": "W każdym razie noc przepadła, zaświtał dzień biały, tak bardzo najeżony niebezpieczeństwy, że się koniecznie dobrze ukryć trzeba"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
