                "senses": [
                    {
                        "sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                        "entry_id": "bfe5652b-d5bb-3f94-98a4-083f3f297fc7",
                        "glosses": [
                            "der tiefste Punkt des Himmelsgewölbes senkrecht unter dem Betrachter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243cbe21-56b2-45a8-8bca-b04cfc690439",
                                "sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                                "text": "Der Blick auf den Nadir ist für einen Beobachter auf der Erde durch den Erdkörper stets verwehrt."
                            },
                            {
                                "example_id": "0aae24f1-806b-4c01-a3d7-4c33f287e58c",
                                "sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                                "text": "„Vom Zenit bis zum Nadir erstreckte sich ein unübersehbarer Ring von Sternenstaub, jene Milchstraße, in deren Mitte unsere Sonne nur als Stern vierter Größe gilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95b2cad5-b47b-4124-a900-e96f54a89dec",
                        "source_entry_id": "bfe5652b-d5bb-3f94-98a4-083f3f297fc7",
                        "source_sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                        "source_sense_description": "Astronomie: der tiefste Punkt des Himmelsgewölbes senkrecht unter dem Betrachter",
                        "target_lang_word": "nadir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nadir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1fc39be-b0f6-365d-9e47-37cdc98c99d9",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The point of the celestial sphere, directly opposite the zenith; inferior pole of the horizon; point of the celestial sphere directly under the place of observation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2955f782-bae9-4b55-8265-47979530700e",
                                                "sense_id": "a1fc39be-b0f6-365d-9e47-37cdc98c99d9",
                                                "text": "[…] when we are Nadyr to the Sunne, we have no ſhadow […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The lowest point; time of greatest depression."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72e2654-1bfd-4906-8928-aa998a4cdcb9",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "Near-synonym: dead"
                                            },
                                            {
                                                "example_id": "27a61637-5e2c-4c3b-a521-fc053857ef64",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "[…] the seventh century is the nadir of the human mind in Europe […]"
                                            },
                                            {
                                                "example_id": "37810354-f6a3-4c2d-a3af-34ff009155f6",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "In this nadir of poetic repute, when the only verse that most people read from one year’s end to the next is what appears on greetings cards, it is well for us to stop and consider our poets."
                                            },
                                            {
                                                "example_id": "344e9c3b-bdf5-4a1f-80f1-2b48b7c460c7",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "The myth describes the dangerous moment of the nadir, the dead of winter, the moment when it is not known whether the world will be re-created and another cycle will bring on another spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "551370a3-bc3f-3fa4-831d-4f04adde7016",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The axis of a projected conical shadow; the direction of the force of gravity at a location; down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42da3c48-7451-4ee2-b441-2f697518577e",
                                                "sense_id": "551370a3-bc3f-3fa4-831d-4f04adde7016",
                                                "text": "The nadir of the sun is the axis of the shadow projected by the Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19380e00-61ce-3208-8be7-557e6945bf29",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "An empty box added beneath a full one in a beehive to give the colony more room to expand or store honey."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nadir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6cf3c15-44cf-33c6-b7ca-13d7ee9cb656",
                                        "entry_id": "286f0641-b08a-3e8d-b581-321620600fe6",
                                        "glosses": [
                                            "To extend (a beehive) by adding an empty box at the base."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153d3e31-870b-410c-aeb3-2cb86102e724",
                        "source_entry_id": "bfe5652b-d5bb-3f94-98a4-083f3f297fc7",
                        "source_sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                        "source_sense_description": "Astronomie: der tiefste Punkt des Himmelsgewölbes senkrecht unter dem Betrachter",
                        "target_lang_word": "nadir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nadir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "448de135-010f-3070-9629-fc66b3288400",
                                        "entry_id": "ccccb2fc-21df-38d4-a0ab-0272d46dad5f",
                                        "glosses": [
                                            "Point situé sous l’observateur en suivant la verticale tirée du point où il se tient et passant par le centre de la Terre, ou dirigée dans le sens de la gravitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f322e56-6e64-40e3-90ba-6a939a486399",
                                                "sense_id": "448de135-010f-3070-9629-fc66b3288400",
                                                "text": "En deux points du globe, ayant respectivement la lune au zénith et au nadir, la surface des océans a tendance à monter créant une pleine-mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1423d67f-ffcd-31a3-bc8f-6c37b53ef720",
                                        "entry_id": "ccccb2fc-21df-38d4-a0ab-0272d46dad5f",
                                        "glosses": [
                                            "Valeur la plus basse dans une série."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b65782-64ad-42af-a40c-764ad29ab1c0",
                                                "sense_id": "1423d67f-ffcd-31a3-bc8f-6c37b53ef720",
                                                "text": "La livre sterling, déjà fortement dévaluée depuis le référendum sur le Brexit du 23 juin 2016, a réagi, en approchant de son nadir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e3f979-2c71-3213-9d76-38a9814b5f05",
                                        "entry_id": "ccccb2fc-21df-38d4-a0ab-0272d46dad5f",
                                        "glosses": [
                                            "Pire moment ; moment où il y a le moins d’espoir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a4a334-107a-4adc-8c50-75f7042ec9c1",
                                                "sense_id": "c4e3f979-2c71-3213-9d76-38a9814b5f05",
                                                "text": "Dans les existences les plus illustres comme dans les plus obscures, n’y a-t-il pas pour l’animal comme pour les secrétaires généraux un zénith et un nadir, une période où le pelage est magnifique, où la fortune rayonne de tout son éclat."
                                            },
                                            {
                                                "example_id": "8cb21c24-0e8b-401c-871d-4a89e592a603",
                                                "sense_id": "c4e3f979-2c71-3213-9d76-38a9814b5f05",
                                                "text": "En quelques jours, les relations diplomatiques et économiques entre l’Ukraine et la Pologne, pourtant un des plus proches alliés de Kiev depuis le début de l’invasion russe, ont atteint leur nadir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
