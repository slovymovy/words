                "translations": [
                    {
                        "translation_id": "90414a91-80a4-4f23-aee0-0a8444bc899b",
                        "source_entry_id": "fb9b35a2-58cf-31ca-9cdc-4bd6aac35656",
                        "source_sense_id": "eb470ce9-d912-371d-974c-8d928732288c",
                        "target_lang_word": "Süppchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Süppchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bc9d7e-22bf-3a83-9c7b-944dba1d8db0",
                                        "entry_id": "64798e36-1095-3d77-9ba2-918ac808032d",
                                        "glosses": [
                                            "kleine Suppe; ein wenig Suppe (als einzelne Speise)"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd02c0a-fafb-4a1f-a284-c7231b1212b1",
                                                "sense_id": "d7bc9d7e-22bf-3a83-9c7b-944dba1d8db0",
                                                "text": "Zum Mittag gab es ein Süppchen."
                                            },
                                            {
                                                "example_id": "874ae2c8-d00e-42a6-9169-91a31b6210e5",
                                                "sense_id": "d7bc9d7e-22bf-3a83-9c7b-944dba1d8db0",
                                                "text": "„Horst Kumpel rutschte behende hin und her, machte Feuer im Kanonenofen, kochte ein Süppchen für uns beide, zauberte eine Schnapsflasche hervor.“"
                                            },
                                            {
                                                "example_id": "dc7fe46a-dd65-4471-9877-1eb0aa850f73",
                                                "sense_id": "d7bc9d7e-22bf-3a83-9c7b-944dba1d8db0",
                                                "text": "„Zwischendurch, wenn für Stunden kein Zug aus dem Süden zu erwarten war, würde ich zu Sabine Emonds hinausradeln und mein Süppchen essen.“"
                                            },
                                            {
                                                "example_id": "854f7c50-f278-4223-82ce-3f3611ac7748",
                                                "sense_id": "d7bc9d7e-22bf-3a83-9c7b-944dba1d8db0",
                                                "text": "„Thomas wanderte in die Küche zurück, um nach seinem Süppchen zu sehen, schnitt das Entenfleisch in Stücke und wanderte zurück ins Labor, um nach seinen Barren zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
