                                            {
                                                "example_id": "b866f83a-40c0-44a1-af48-1e21c8e531aa",
                                                "sense_id": "ab20a70b-6928-3225-8d2c-f189ba954aba",
                                                "text": "Un quadruplet de nombres premiers est un groupe de quatre nombres premiers, constitué de deux paires de nombres premiers jumeaux séparés par trois nombres composés consécutifs."
                                            },
                                            {
                                                "example_id": "d03e09f0-501a-4da7-b772-0bbc3835d89f",
                                                "sense_id": "ab20a70b-6928-3225-8d2c-f189ba954aba",
                                                "text": "La hiérarchisation de ce quadruplet peut s’exprimer par un ordre de complexification."
                                            }
