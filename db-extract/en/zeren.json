                "senses": [
                    {
                        "sense_id": "324b4869-0adf-3311-a700-d594adb20fb7",
                        "entry_id": "4d50111a-d9bd-34e9-a9fd-117d8e19f155",
                        "glosses": [
                            "The Mongolian gazelle, Procapra gutturosa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec2be91-7c12-4cd1-8118-0d3464d3e344",
                                "sense_id": "324b4869-0adf-3311-a700-d594adb20fb7",
                                "text": "Only one is strictly Asiatic, Procapra (2), of which one species, P. gutturosa, the zeren, is the type host of Pallas' (1777) Lipoptena antilopes, a ked not seen again for the past 150 years."
                            },
                            {
                                "example_id": "e4239ec3-c047-4819-b750-b2c68d16420d",
                                "sense_id": "324b4869-0adf-3311-a700-d594adb20fb7",
                                "text": "1993, Lauren S. Bahr, Bernard Johnston, Goat Gazelle, entry in Collier's Encyclopedia, Volume 2, page 285,\nThere are two species of goat gazelles: the goa, or Tibetan, gazelle, Procapra picticandata, and the zeren, or Mongolian, gazelle, P. gutturosa."
                            },
                            {
                                "example_id": "a3724cca-c301-4d8d-837b-4495afe0078f",
                                "sense_id": "324b4869-0adf-3311-a700-d594adb20fb7",
                                "text": "Saigas share part of their home range with the zeren (Procapra gutturosa). These Mongolian antelopes lack the distended nose that characterizes the saiga, but males do develop a similarly curious enlarged throat sac during the mating season."
                            }
                        ]
                    }
