                "senses": [
                    {
                        "sense_id": "560c9d5c-f79c-33b6-9fa9-899920981894",
                        "entry_id": "f7d418db-5052-3d6f-a648-0dd6d397f201",
                        "glosses": [
                            "Donner un caractère bacchique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa73a707-2d9e-4e07-9dd7-b96d0443b63e",
                                "sense_id": "560c9d5c-f79c-33b6-9fa9-899920981894",
                                "text": "Après avoir pris le café à l'arabe et bacchisé le vénérable cheik, nous rejoignîmes le campement de la caravane."
                            },
                            {
                                "example_id": "5f0b06e8-7853-4f23-8ae7-b48cd64fa6b3",
                                "sense_id": "560c9d5c-f79c-33b6-9fa9-899920981894",
                                "text": "Les croyances dionysiaques avaient pris une telle que d’autres divinités attirées dans leur sphère ont été « bacchisées », si j’ose m’exprimer ainsi."
                            },
                            {
                                "example_id": "1dda51d4-c0d7-46a3-b34f-7a0eb462ec25",
                                "sense_id": "560c9d5c-f79c-33b6-9fa9-899920981894",
                                "text": "Satyres et Priapes, veuillez bacchiser son esprit de mille caresses orgiaques et possédées !"
                            }
                        ]
                    }
