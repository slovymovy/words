                                            {
                                                "example_id": "2c6dc638-fa11-4d9c-9740-c8ac5456b1c7",
                                                "sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                                                "text": "Souvent deux familles prennent une ferme indivise, et les bénéfices sont partagés proportionnellement au nombre d'enfants et aux services qu'ils rendent."
                                            },
                                            {
                                                "example_id": "73f4f5a8-9139-412e-89ad-f165d20918a2",
                                                "sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                                                "text": "Réduire proportionnellement un grand plan, un grand dessin à un petit."
                                            }
                                        ]
