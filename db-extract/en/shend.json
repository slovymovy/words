                "senses": [
                    {
                        "sense_id": "560d4204-c9c2-39a9-9314-638322a6ff15",
                        "entry_id": "2aaac9d2-2031-39b4-ac08-74b361a957d1",
                        "glosses": [
                            "To disgrace or put to shame."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7cae4b58-9607-4197-a62e-416a52d82117",
                                "sense_id": "560d4204-c9c2-39a9-9314-638322a6ff15",
                                "text": "Her fawning love with foule disdainefull spight\nHe would not shend"
                            },
                            {
                                "example_id": "1f3a7e1d-ed6b-498f-bf4a-eb91f5413aee",
                                "sense_id": "560d4204-c9c2-39a9-9314-638322a6ff15",
                                "text": "Do you hear how we are shent for keeping your greatness back?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2337c9b-4bc7-3580-b4b7-3de3c0eb34a8",
                        "entry_id": "2aaac9d2-2031-39b4-ac08-74b361a957d1",
                        "glosses": [
                            "To blame."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3231b035-7223-3b83-abee-416e669b3076",
                        "entry_id": "2aaac9d2-2031-39b4-ac08-74b361a957d1",
                        "glosses": [
                            "To destroy; to spoil."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6d531480-4e00-4e06-9b8c-1738b7a306ee",
                                "sense_id": "3231b035-7223-3b83-abee-416e669b3076",
                                "text": "Go see their fleet and arms, their manner view / of moulded metal, ready all to shend[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9183406e-fdb9-34a1-8b2a-a624690c5ffd",
                        "entry_id": "2aaac9d2-2031-39b4-ac08-74b361a957d1",
                        "glosses": [
                            "To overpower; to surpass."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "16ba2d24-d1bb-4e0f-a433-ebaf36796823",
                                "sense_id": "9183406e-fdb9-34a1-8b2a-a624690c5ffd",
                                "text": "Since sware the Parcæ unto me, their friend, / they shall adore my name, my favour prize; / and, as their feats of armèd prowess shend / all feats of rival Rome, I lief devise / some mode of aidance in what things I may, / far as our force o'er man extendeth sway."
                            },
                            {
                                "example_id": "50e4cf34-8745-4d23-9280-30a99c03761f",
                                "sense_id": "9183406e-fdb9-34a1-8b2a-a624690c5ffd",
                                "text": "Not since I backed a horse have I been perssed so hard; peril of life, jeopardy of land and livelihood, and to sum up, all these losels in the wood to hunt me down. But I be not yet shent. Some of my lads will pick me their way home."
                            }
                        ]
                    }
