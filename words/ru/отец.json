                                "target_lang_word": "父亲",
                                "target_lang_sense_clarification": "正式称呼"
                            },
                            {
                                "target_lang_word": "爸爸",
                                "target_lang_sense_clarification": "口语称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e311506-83dd-3ca5-9d2b-27f7fd28a009",
                    "sense_definition": "Дружеское или почтительное обращение к пожилому мужчине.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Подскажи, <w>отец</w>, как пройти к вокзалу?",
                            "target_lang_translations": {
                                "en": "Tell me, <w>father</w>, how do I get to the station?",
                                "zh": "请问<w>老人家</w>，去火车站怎么走？"
                            }
                        },
                        {
                            "text": "Спасибо тебе, <w>отец</w>, за добрый совет.",
                            "target_lang_translations": {
                                "en": "Thank you, <w>father</w>, for the kind advice.",
                                "zh": "谢谢你的好建议，<w>大叔</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
