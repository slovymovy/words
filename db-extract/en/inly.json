                        "sense_id": "af921401-03cf-3798-a1a0-a0a856c945d3",
                        "entry_id": "f551dcf1-e899-33ca-852e-9e05e1f788a0",
                        "glosses": [
                            "Inward; interior; secret."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6f6c181e-4475-4964-8f3f-6fc8901f399d",
                                "sense_id": "af921401-03cf-3798-a1a0-a0a856c945d3",
                                "text": "Didst thou but know the inly touch of love\n Thou wouldst as soon go kindle fire with snow\n As seek to quench the fire of love with words."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
