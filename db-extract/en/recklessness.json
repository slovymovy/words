    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                "word": "recklessness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "00499efc-27e1-4d29-9e67-614ba676cbd7",
                        "entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                        "tags": [
                            "plural"
                        ],
                        "form": "recklessnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                        "entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                        "glosses": [
                            "The state or quality of being reckless or heedless, of taking unnecessary risks."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c3d70bf0-b3b5-4d92-b80d-e653ab342be5",
                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                "text": "His recklessness repeatedly put him in danger."
                            },
                            {
                                "example_id": "55e8fe8e-76b6-46e7-aa8d-73af6f8302f4",
                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                "text": "At such times, how we marvel at our usual recklessness, and pause, as it were, shrinking from the busy and inevitable current which is hurrying us on to eternity!"
                            },
                            {
                                "example_id": "5d032659-b287-40e0-8a39-6f3581246fb9",
                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                "text": "Partly because of the heavy burden of government debt built up during his stewardship, and the uncurbed recklessness of the country’s banks, Britain’s recession is already the harshest in Western Europe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9f485a9-f869-4fc1-b770-05bb8182d20c",
                        "source_entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                        "source_sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                        "source_sense_description": "being reckless",
                        "target_lang_word": "Leichtsinnigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtsinnigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                                        "entry_id": "1536fbff-b8dd-3571-90af-914b55e691a6",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße mit Risiken verbunden ist und von wenig Verantwortungsübernahme zeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed95b653-8079-4a18-9bf8-23179f084895",
                                                "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                                                "text": "Oft geht Unerfahrenheit mit Leichtsinnigkeit einher, wer die Gefahren nicht kennt, scheut das Risiko weniger als andere."
                                            },
                                            {
                                                "example_id": "1dbefa7d-e9bb-432c-a6de-83b7594f42c9",
                                                "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                                                "text": "Ihren kleinen Bruder musste sie häufig vor Leichtsinnigkeiten bewahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24343214-51ca-4390-8bd4-577578688b07",
                        "source_entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                        "source_sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
