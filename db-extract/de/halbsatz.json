                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99358b1-817c-4ade-8c4d-c2899864bfaa",
                                "sense_id": "8312fac7-5b89-31b2-a8ff-d94dae28aa7e",
                                "text": "„Mit einem Halbsatz entschuldigt er sich für die knapp 45-minütige Verspätung.“"
                            },
                            {
                                "example_id": "889824fc-757f-44cb-a326-978609b5ad78",
                                "sense_id": "8312fac7-5b89-31b2-a8ff-d94dae28aa7e",
                                "text": "„Langsam, Halbsatz für Halbsatz, gab der Text nach und offenbarte seinen Sinn.“"
                            },
                            {
                                "example_id": "897fe3b4-69af-4ea6-a023-a7272672c02d",
                                "sense_id": "8312fac7-5b89-31b2-a8ff-d94dae28aa7e",
                                "text": "„Dem Halbsatz kann man immerhin entnehmen, daß man sich in deutschen Literatenkreisen schon in den zwanziger Jahren mit dem Phänomen der Prager deutschen Literatur beschäftigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
