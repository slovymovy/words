                        "glosses": [
                            "een gebied met een beperkt zelfbestuur binnen Zuid-Afrika dat als woongebied voor de Bantoes aangewezen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ec3da6-086e-46a6-b5c7-453094055091",
