                        "target_lang_word": "orator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2a0355-99c5-36f9-ab78-5782f89aed13",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "Someone who orates or delivers an oration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "A skilled and eloquent public speaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec90e0a-f75c-44af-b96b-1cdf210f6a38",
                                                "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                                "text": "Tam[burlaine]. Then ſhall we fight couragiouſlye with them?\nOr looke you, I ſhould play the Orator?\nTech[elles]. No: cowards and faint-hearted runawaies,\nLooke for orations when the foe is neere.\nOur ſwordes shall play the Orators for vs."
                                            },
                                            {
                                                "example_id": "b3b49544-fbd3-4ca3-96c8-d0b3d3203f3c",
                                                "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                                "text": "[…] when it becomes obvious that I have not the slightest skill as a speaker – unless, of course, by skilful speaker they mean one who speaks the truth. If that is what they mean, I would agree that I am an orator, though not after their pattern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b852169d-9f1c-3ecd-8d4e-6e9e76a07422",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "Someone sent to speak for someone else; an envoy, a messenger."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51d2a415-a492-3523-b2c4-7528964b082e",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "A petitioner, a supplicant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edef4e3a-3132-464e-a2da-c4639cc1a810",
                        "source_entry_id": "6df09bbc-16b1-33ea-9a2d-6680f341993b",
                        "source_sense_id": "02767dbd-8dac-3e02-899c-cd058414da92",
                        "source_sense_description": "redenaar",
                        "target_lang_word": "orateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                        "entry_id": "bc2dc0af-588f-3c5d-880e-44e5c167addd",
                                        "glosses": [
                                            "Celui qui compose, qui prononce des discours ou des ouvrages d’éloquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a229d9d7-2484-43e5-a04a-8078fd8f9eb6",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "— Il est creux, il est sonore, c’est plutôt un artiste en paroles qu’un orateur. Enfin c’est un bel instrument, mais ce n’est pas la musique."
                                            },
                                            {
                                                "example_id": "70f6c359-9e4e-4898-989d-e16c16e9aa22",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "Lorsque l’orateur descendit de la tribune, la majorité lui fit une ovation complète, indescriptible ; les députés, en masse, quittèrent leurs places, s'élancèrent vers lui, l'entourèrent, lui serrèrent les mains ; il s'en fallut de peu qu'ils ne le portassent en triomphe."
                                            },
                                            {
                                                "example_id": "b2365dd7-246f-440d-ba16-b511e7e764ab",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "Les apostrophes injurieuses, les interpellations violentes des réactionnaires, interrompirent cent fois les discours des orateurs des gauches."
                                            },
                                            {
                                                "example_id": "db1556a7-f402-4744-aa81-4df9fe9b5ae5",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "Ainsi le comprenait l’orateur qui flétrissait, il y a trois ans, dans un premier discours, ceux qu'on appelle des vendus, et qui s'annonçait déjà comme l’exécuteur des épurations nécessaires."
                                            },
                                            {
                                                "example_id": "02997e8b-9fcc-424c-885a-ce6231b4ccbd",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "Pyrrhon aimait que l’orateur Démosthène injuriât si bien Philippe; il n’eût pas détesté que Philippe injuriât aussi bien l’orateur Démosthène."
                                            },
                                            {
                                                "example_id": "218c180e-d8be-4c90-9b08-9a9c74c6f86b",
                                                "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                                                "text": "Il n’est pas orateur, Il s’exprime bien mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a54f00f1-c151-3472-ae41-7334c69b2461",
                                        "entry_id": "bc2dc0af-588f-3c5d-880e-44e5c167addd",
                                        "glosses": [
                                            "Auteur de sermons, d’oraisons funèbres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae74eac1-22b5-434d-be5a-dba0ffe0ba98",
                                                "sense_id": "a54f00f1-c151-3472-ae41-7334c69b2461",
                                                "text": "C’était un orateur de talent, dont la tournée de conférences, faite dans le Midi et en Espagne, est restée célèbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8bf2966-adcd-3716-b122-4215b0b65c75",
                                        "entry_id": "bc2dc0af-588f-3c5d-880e-44e5c167addd",
                                        "glosses": [
                                            "Celui qui prend la parole au nom d’une troupe de comédiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c589970-7c72-4238-b2cb-e0ece590be5a",
                                                "sense_id": "b8bf2966-adcd-3716-b122-4215b0b65c75",
                                                "text": "Molière fut longtemps l’orateur de sa troupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc7fbcc5-5f58-3c5b-887b-1798876b0a94",
                                        "entry_id": "bc2dc0af-588f-3c5d-880e-44e5c167addd",
                                        "glosses": [
                                            "Officier qui, dans une loge, veille à la stricte application des règlements"
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "540b42e3-56c0-41ec-88f4-3138a3ee87ac",
                                                "sense_id": "cc7fbcc5-5f58-3c5b-887b-1798876b0a94",
                                                "text": "En cas de nécessité, l’orateur peut reprendre le vénérable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4fa77b-bec6-335f-b857-864daf2ab05a",
                                        "entry_id": "bc2dc0af-588f-3c5d-880e-44e5c167addd",
                                        "glosses": [
                                            "Président de la Chambre des Communes ou d'une assemblée législative provinciale (calque de l'anglais speaker)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
