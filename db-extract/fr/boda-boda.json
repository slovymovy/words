                        ],
                        "examples": [
                            {
                                "example_id": "16b849f6-9889-4660-b083-87c57e2cff4f",
                                "sense_id": "236b8b97-c4ce-38cc-830c-960728db5892",
                                "text": "Les vélotaxis sont eux-mêmes aujourd'hui menacés par les mototaxis qui portent le même nom de boda-boda, une africanisation de border-border (frontière-frontière)."
                            },
                            {
                                "example_id": "42c9a863-b6b8-4b0e-aa1f-d5cfa002ef76",
                                "sense_id": "236b8b97-c4ce-38cc-830c-960728db5892",
                                "text": "Incontournables, les boda-bodas constituent un moyen de transport pittoresque, économique et bien pratique pour éviter la densité du trafic, surtout à Kampala. Les chauffeurs de boda-boda sont particulièrement sympathiques."
                            }
                        ]
