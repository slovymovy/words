                "senses": [
                    {
                        "sense_id": "ffbd1a9a-0f0a-3850-a552-0d9c27c4a70c",
                        "entry_id": "5e03b342-91e6-3094-bc21-5c63e80a025f",
                        "glosses": [
                            "Donner un caractère virginal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41de3b5-54b5-4e20-8016-db1420ce7e39",
                                "sense_id": "ffbd1a9a-0f0a-3850-a552-0d9c27c4a70c",
                                "text": "Mais, virginaliser les viveurs à pétrifier les vivants, voilà qui dépasse les plus symphoniques imaginations !"
                            },
                            {
                                "example_id": "fab4eb14-4045-4560-af25-cf91f69f3bd6",
                                "sense_id": "ffbd1a9a-0f0a-3850-a552-0d9c27c4a70c",
                                "text": "C’est particulièrement vrai auprès d’Élina Labourdette (Agnès), jeune femme dont la candeur est prête à effacer, à virginaliser, son statut d’entraîneuse : elle est « réangélisable »."
                            }
                        ]
                    }
