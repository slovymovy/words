                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f990545-0132-4867-aade-bd284686aaff",
                                "sense_id": "10ba527a-9588-387c-8304-8a40664a2b51",
                                "text": "Zijn grootvader droeg nog een oogglas aan een kettinkje."
