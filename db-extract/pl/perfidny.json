                "senses": [
                    {
                        "sense_id": "3c1ead2d-6537-33b8-844e-5324556582e2",
                        "entry_id": "2f81396f-382e-3e74-b8b6-87ec57caca5c",
                        "glosses": [
                            "przewrotny, podstępny, chytry i złośliwy, przebiegły"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b6f8e6a-290f-4a2d-a38a-2c582519d2e6",
                        "source_entry_id": "2f81396f-382e-3e74-b8b6-87ec57caca5c",
                        "source_sense_id": "3c1ead2d-6537-33b8-844e-5324556582e2",
                        "target_lang_word": "perfide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                                        "glosses": [
                                            "Qui est déloyal, qui manque à sa foi, à sa parole, ou à la confiance qu’on a mise en lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bf5176-391d-4f3a-a72d-2c8ba6f3d592",
                                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                                "text": "Un homme perfide."
                                            },
                                            {
                                                "example_id": "3ea7f281-ed14-4c6d-97b2-da507a1029dd",
                                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                                "text": "Une nation perfide."
                                            },
                                            {
                                                "example_id": "a19bbeb2-07cb-410e-a63f-af6ea6e5292d",
                                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                                "text": "Amant perfide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                                        "glosses": [
                                            "Sans foi, incrédule, dissident, hérétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec0b7d83-a9e5-4052-9b6b-fb30d989924a",
                                                "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                                                "text": "L’Angleterre, ah, la perfide Angleterre, que le rempart de ses mers rendait inaccessible aux Romains, la foi du Sauveur y est abordée."
                                            },
                                            {
                                                "example_id": "646fce76-efff-49d3-8423-0c1c5b5103d8",
                                                "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                                                "text": "Le roi et la reine d’Angleterre sont bien mieux à Saint-Germain que dans leur perfide royaume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                                        "glosses": [
                                            "Choses où il y a de la perfidie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13dddd2-6dcb-4614-a6a3-461f05f05116",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Une araignée tisse sa toile auprès de moi, sa toile au fil de brume, couleur de rêve et couleur d’eau.\nCette dentelle souple en roue blanche qui luit, c’est un piège perfide où la mort se balance."
                                            },
                                            {
                                                "example_id": "8e4d9874-ca04-4517-abf8-38e747263c30",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Connaissant de l’intérieur ce milieu souvent perfide, je comprends leurs craintes."
                                            },
                                            {
                                                "example_id": "43fd3f19-4e32-4a6c-8f97-9ec46ef012df",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Il lui a fait un tour bien perfide."
                                            },
                                            {
                                                "example_id": "cc6f297d-9454-4b18-9d2a-cd3223c8f35d",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Voilà une action bien perfide."
                                            },
                                            {
                                                "example_id": "cf34c8ed-d4e7-4785-b641-acc19b90e9dc",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Après tant de perfides serments."
                                            },
                                            {
                                                "example_id": "899371a1-b416-489a-bc06-76da9c863b19",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Des caresses, des louanges perfides."
                                            },
                                            {
                                                "example_id": "15865392-1a14-4a5c-a583-85405df7ae0c",
                                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                                "text": "Un sourire perfide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perfide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd86cbf0-8c9b-3d3d-8924-ec128b4fdc08",
                                        "entry_id": "8b5737ba-d4aa-3afc-9161-a48ee5558355",
                                        "glosses": [
                                            "Personne perfide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e41454-4618-4ec9-bee8-8239ff8c061a",
                                                "sense_id": "dd86cbf0-8c9b-3d3d-8924-ec128b4fdc08",
                                                "text": "C’est un perfide."
                                            },
                                            {
                                                "example_id": "b84e22db-0821-414f-8df5-758de24d1870",
                                                "sense_id": "dd86cbf0-8c9b-3d3d-8924-ec128b4fdc08",
                                                "text": "Le perfide m’a trahi."
                                            },
                                            {
                                                "example_id": "86b46837-ef49-4d61-9aee-378a1fd1c924",
                                                "sense_id": "dd86cbf0-8c9b-3d3d-8924-ec128b4fdc08",
                                                "text": "Je tâche donc de le calmer ma jolie pleureuse, qui s’écrie que je suis un monstre, un perfide, un petit traître; que je lui fais déjà des infidélités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cea3f30-41f1-4042-9239-df50fd6ef10d",
                        "source_entry_id": "2f81396f-382e-3e74-b8b6-87ec57caca5c",
                        "source_sense_id": "3c1ead2d-6537-33b8-844e-5324556582e2",
                        "target_lang_word": "pérfido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pérfido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                        "entry_id": "82e739d3-b2e5-3da2-82ac-b416c066932d",
                                        "glosses": [
                                            "Que falta a la fidelidad o lealtad que debe; traidor."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c282c8-897a-4399-97fb-35328b39a7df",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "¿Pues qué diremos aun, vitoriosísimo Príncipe, sino que Dios es con vos, y en virtud vuestra e de la serenísima princesa Doña Isabel, Reina e Señora nuestra, quiere destruir e desolar la pérfida mahomética seta?"
                                            },
                                            {
                                                "example_id": "95bdfe49-fbaa-4871-bb0b-0ef4ad04ed49",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "y después viene a matarle\nla espada infiel de la maldad autora,\nal Rey y amigos pérfida y traidora."
                                            },
                                            {
                                                "example_id": "afb17fd3-246e-4d2d-9989-ff4da51042a0",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "Se trataba de dar satisfacción a los judíos, pero sin soliviantar la ira de los árabes, aunque tampoco lord Balfour debía conceder demasiada importancia a los árabes, y así transparecen en el documento los pérfidos burladeros diplomáticos para escapar, llegado el caso, del compromiso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
