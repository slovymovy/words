                    {
                        "sense_id": "4a6148f8-40a6-3434-9063-f9ac243347b9",
                        "entry_id": "3bf851ea-08e5-3129-8438-4bace0ee9e2e",
                        "glosses": [
                            "Qui se soumet à une règle ; qui fait preuve de discipline"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef3b7225-d58d-4597-8e97-15a935434225",
                                "sense_id": "4a6148f8-40a6-3434-9063-f9ac243347b9",
                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                            },
                            {
                                "example_id": "e1526a60-0168-4bd3-a1ab-4a9930fd33cf",
                                "sense_id": "4a6148f8-40a6-3434-9063-f9ac243347b9",
                                "text": "Aux colons, il préférait évidemment des « soldats-laboureurs » travailleurs et disciplinés."
                            }
                        ]
                    },
                    {
                        "sense_id": "70a1d7c6-f6db-3fa0-90e5-a2e3b4a07d5d",
