                "senses": [
                    {
                        "sense_id": "c94c5e56-499b-315a-aadb-d369c6b06888",
                        "entry_id": "1a44f6e8-1d86-3f6b-96fa-139517244d53",
                        "glosses": [
                            "behördliche Genehmigung, Fahrschüler ausbilden zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ecbcee2-4f09-4b0c-8d31-fd40c79e7fa5",
                                "sense_id": "c94c5e56-499b-315a-aadb-d369c6b06888",
                                "text": "„Im Präsidialamt ist man sich da keiner Schuld bewusst. Denn die Aufgabe des Bundespräsidenten ist es nicht, nach falschen Fahrlehrerlaubnissen zu fahnden.“"
                            },
                            {
                                "example_id": "ce8ebafc-6a2b-470f-8422-fa852fd6eaee",
                                "sense_id": "c94c5e56-499b-315a-aadb-d369c6b06888",
                                "text": "„‚Seit dem Unfall am Karfreitag darf dieser Fahrlehrer nicht mehr schulen und lehren‘, bezieht Helmut Deschler von der Fahrerlaubnisbehörde eindeutig Stellung. Die Fahrlehrerlaubnis und die Lizenz zum Betreiben der Fahrschule würden solange ruhen, bis von den Justizbehörden ein Urteil vorliege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
