                    "sense_id": "27962c69-0abb-30fb-a2ef-c1c7cfa6306e",
                    "sense_definition": "het menselijk vermogen om logisch te denken en te begrijpen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mens onderscheidt zich van de dieren door het gebruik van de <w>rede</w>.",
                            "target_lang_translations": {
                                "en": "Man distinguishes himself from animals through the use of <w>reason</w>."
                            }
                        },
                        {
                            "text": "In tijden van crisis is het belangrijk om de <w>rede</w> te laten zegevieren boven emotie.",
                            "target_lang_translations": {
                                "en": "In times of crisis, it is important to let <w>reason</w> prevail over emotion."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstand",
                        "ratio",
                        "intellect"
                    ],
                    "antonyms": [
                        "waanzin"
                    ],
                    "common_phrases": [
                        "de menselijke rede",
                        "met de rede strijdig"
                    ],
                    "target_lang_definitions": {
                        "en": "the human capacity for logical thought and understanding"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reason",
                                "target_lang_sense_clarification": "the power of the mind to think and understand in a logical way"
                            },
                            {
                                "target_lang_word": "intellect",
                                "target_lang_sense_clarification": "the faculty of reasoning and understanding objectively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a31ecb5a-6a76-3140-ad28-a21efc05f4ef",
                    "sense_definition": "een formele toespraak gehouden voor een publiek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toespraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn <w>rede</w> maakte hij gewag van grote vorderingen in zijn onderzoek.",
                            "target_lang_translations": {
                                "en": "In his <w>speech</w>, he mentioned great progress in his research."
                            }
                        },
                        {
                            "text": "De koning hield een indrukwekkende <w>rede</w> tijdens de opening van het parlement.",
                            "target_lang_translations": {
                                "en": "The king gave an impressive <w>address</w> during the opening of parliament."
                            }
                        }
                    ],
                    "synonyms": [
                        "toespraak",
                        "redevoering",
                        "discours",
                        "lezing"
                    ],
                    "common_phrases": [
                        "een rede houden",
                        "een vlammende rede"
                    ],
                    "target_lang_definitions": {
                        "en": "a formal speech delivered to an audience"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "speech",
                                "target_lang_sense_clarification": "a formal address delivered to an audience"
                            },
                            {
                                "target_lang_word": "address",
                                "target_lang_sense_clarification": "a formal discourse or speech"
                            },
                            {
                                "target_lang_word": "oration",
                                "target_lang_sense_clarification": "a formal speech, especially one given on a ceremonial occasion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f5cdb8b-d7af-3903-b114-2fe58d9e866a",
                    "sense_definition": "een veilige ankerplaats voor schepen buiten een haven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip moest zich terugtrekken en voor anker gaan liggen op de <w>rede</w>.",
                            "target_lang_translations": {
                                "en": "The ship had to withdraw and lie at anchor in the <w>roadstead</w>."
                            }
                        },
                        {
                            "text": "Goeree is genoemd naar de goede <w>rede</w> die er voor de kust te vinden was.",
                            "target_lang_translations": {
                                "en": "Goeree is named after the good <w>anchorage</w> that could be found off the coast."
                            }
                        }
                    ],
                    "synonyms": [
                        "ankerplaats",
                        "ligplaats"
                    ],
                    "common_phrases": [
                        "op de rede liggen",
                        "een veilige rede"
                    ],
                    "target_lang_definitions": {
                        "en": "a safe place for ships to anchor outside of a harbor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roadstead",
                                "target_lang_sense_clarification": "a partly sheltered anchorage outside a harbor"
                            },
                            {
                                "target_lang_word": "anchorage",
                                "target_lang_sense_clarification": "a place where a ship can be anchored"
                            },
                            {
                                "target_lang_word": "roads",
                                "target_lang_sense_clarification": "a sheltered area of water where ships may ride at anchor"
                            }
                        ]
                    }
                }
            ]
        },
        {
