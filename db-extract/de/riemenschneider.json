                "senses": [
                    {
                        "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                        "entry_id": "9e57eff2-ffd9-39d6-b8fb-13a2ccbcef05",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911bccb6-3b4c-4559-be57-c948d3613a76",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Frau Riemenschneider ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e9846a9-63ba-4e1b-ae3c-1bcca55fd465",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Herr Riemenschneider wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d300e5a4-cab1-4b94-8364-9c7037c26856",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Die Riemenschneiders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "17e126f2-f686-4ac3-a37d-f00f676cf51c",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Der Riemenschneider trägt nie die Schals, die die Riemenschneider ihm strickt."
                            },
                            {
                                "example_id": "3142f828-b0bd-4fd6-a396-68884c265ac9",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Riemenschneider kommt, geht der Herr Riemenschneider.“"
                            },
                            {
                                "example_id": "db333c2b-5f4a-42a9-8407-8c594a447935",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Riemenschneider kommt und geht."
                            },
                            {
                                "example_id": "41ee0f87-24fd-4c8b-9bec-a61c35fe43a0",
                                "sense_id": "0028a976-339e-3424-af77-f987a13b2d4a",
                                "text": "Riemenschneiders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
