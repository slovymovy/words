                    {
                        "translation_id": "d47b95b7-365c-49b6-87c8-84366cfa43b3",
                        "source_entry_id": "51b53dad-5a78-370c-aaae-8d18b1c59c37",
                        "source_sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
                        "source_sense_description": "buiten beschouwing latend",
                        "target_lang_word": "besides",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besides",
