                        "glosses": [
                            "Having a tendency to play tricks on people or tease people by making silly jokes about them; mischievous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0ef72c-1234-457c-88bc-827dff36fcc2",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "She has a puckish attitude."
                            },
                            {
                                "example_id": "d3d75f89-93d1-4073-be93-7184255dd1e8",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "He has a puckish grin."
                            },
                            {
                                "example_id": "666b0787-cd6e-4e79-9f53-03e42353aa6b",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "They are so puckish for their love of practical jokes."
                            },
                            {
                                "example_id": "8be80e29-5007-4fff-8b4a-830831e6e68f",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "Wolfowitz spoke softly to Yasa, who evidently had no idea who he was but responded with a puckish smile."
                            },
                            {
                                "example_id": "2003f343-0679-4fff-a0d0-ca7455bdfd37",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "He has a puckish sense of humor."
                            },
                            {
                                "example_id": "bf761828-aa0d-41c3-b0c4-8f93c0f40698",
                                "sense_id": "95f018a1-9093-3a69-9aab-47a10653deb2",
                                "text": "“Chandler Bing,” wrote Matthew Perry in his puckish, self-mocking memoir, “changed the way that America spoke”."
                            }
                        ]
