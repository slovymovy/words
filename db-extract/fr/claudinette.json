                "senses": [
                    {
                        "sense_id": "7f75d861-a065-37ca-ac5d-8b1503f217e4",
                        "entry_id": "21c7afc8-7ffb-31a4-8ecb-dfb1ab88d5b1",
                        "glosses": [
                            "Nom vernaculaire de la nivéole."
                        ],
                        "tags": [
                            "Ardennes"
                        ],
                        "examples": [
                            {
                                "example_id": "d10a50de-2799-4e11-bd84-5dcdb05d69b3",
                                "sense_id": "7f75d861-a065-37ca-ac5d-8b1503f217e4",
                                "text": "Il se renseignait auprès d'eux sur le jardinage mais ils attirèrent d'abord son attention sur des claudinettes, sorte de perce-neige, puis des pas-d'âne d'un jaune éclatant. Barbara cueillait ces brimborions et les lui mettait dans la main."
                            }
                        ]
                    },
                    {
                        "sense_id": "92673778-119f-3bdb-8d9a-0862cd81aae3",
                        "entry_id": "21c7afc8-7ffb-31a4-8ecb-dfb1ab88d5b1",
                        "glosses": [
                            "Nom vernaculaire de la jonquille."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "4d8d7695-29ca-4157-9fbb-229c95035132",
                                "sense_id": "92673778-119f-3bdb-8d9a-0862cd81aae3",
                                "text": "Mais bientôt le bruit se répandit que les forêts voisines étaient hantées. Quelques femmes et fillettes étant allées aux bois, chercher des claudinettes, des coucous, ou plus tard des fraises, avaient entendu dans les fourrés des bruits étranges […]."
                            },
                            {
                                "example_id": "09c18e1e-629b-489f-8f4c-7db0060b62da",
                                "sense_id": "92673778-119f-3bdb-8d9a-0862cd81aae3",
                                "text": "Lucrèce travaillait seule à son pupitre ; à côté d'elle, dans un vase bleu, un gros bouquet de ces narcisses jaunes, qu'on nomme dans le pays des claudinettes, répandait une molle odeur printanière et jetait une note gaie dans le sombre greffe enfumé."
                            },
                            {
                                "example_id": "d1aa3fd5-a279-4fe7-8ff9-9a37fd2cf9fd",
                                "sense_id": "92673778-119f-3bdb-8d9a-0862cd81aae3",
                                "text": "La vieille laissait ses regards errer sur les jardins, qui se paraient de leur robe neuve, semée de jacinthes et de claudinettes, sur les jeunes seigles qui remuaient avec un frissonnement très doux sur le ventre nu de la terre."
                            },
                            {
                                "example_id": "c361897d-3fa9-4721-a3d6-0cc35d48747a",
                                "sense_id": "92673778-119f-3bdb-8d9a-0862cd81aae3",
                                "text": "A. Pierrot, dans son remarquable ouvrage : « Les Fées », rappelle une gracieuse légende savoyarde et se demande si les « claudinettes » de Gérardmer n'auraient pas même origine que leurs sœurs des Alpes."
                            }
                        ]
                    }
