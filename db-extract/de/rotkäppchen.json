                                        "examples": [
                                            {
                                                "example_id": "96b21e1f-de4d-46b4-9781-3a667ffffdb0",
                                                "sense_id": "70bef778-88dc-3ca6-9b2b-f8b403079792",
                                                "text": "Вы, как Красная Шапочка, доверчиво разговорились с Серым Волком…"
                                            },
                                            {
                                                "example_id": "754906be-3989-4faa-8bbe-0686d51eec01",
                                                "sense_id": "70bef778-88dc-3ca6-9b2b-f8b403079792",
                                                "text": "Красная Шапочка дёрнула за верёвочку, и дверь отворилась."
                                            },
                                            {
                                                "example_id": "0458aa6d-9d25-48db-a92d-21c4feadb785",
                                                "sense_id": "70bef778-88dc-3ca6-9b2b-f8b403079792",
                                                "text": "Моя четырёхлетняя дочь, как и все дети её возраста, очень любила слушать сказки и всё время просила повторять некоторые из них, особенно любимые. Такой была сказочка о Красной Шапочке и Сером Волке."
                                            }
                                        ]
                                    }
                                ]
                            }
