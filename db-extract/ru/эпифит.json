                                        "sense_id": "d6dea503-df3b-345b-9a24-11f5742f8e84",
                                        "entry_id": "46481213-a21f-358f-b8d8-1749d3118103",
                                        "glosses": [
                                            "roślina nie będąca pasożytem, która rośnie na innej roślinie służącej jej jako podpora"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "404e223a-b517-4d0e-b25e-9decc1f70b99",
                                                "sense_id": "d6dea503-df3b-345b-9a24-11f5742f8e84",
                                                "text": "By ułatwić rozwój na podporze i nie ulec spłukaniu, diaspory epifitów cechują się zwykle szybkim rozwojem korzeni, ewentualnie posiadają urządzenia czepne lub wydzielają lepki śluz."
                                            }
