                        {
                            "text": "A <w>radical</w> change in the vowel sound altered the meaning of the word.",
                            "target_lang_translations": {
                                "ru": "<w>Коренное</w> изменение гласного звука изменило значение слова.",
                                "zh": "元音的<w>根本性</w>变化改变了这个词的意思。"
                            }
