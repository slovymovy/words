                "senses": [
                    {
                        "sense_id": "47775223-2afd-3624-9291-d78e61ad3a6b",
                        "entry_id": "42ba9510-82a8-347f-946b-ecd6226dacaa",
                        "glosses": [
                            "Zahlung, mit der angerichteter Schaden oder zugefügtes Leid behoben werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49343d7c-d8f9-4927-8933-49deb6a531fb",
                                "sense_id": "47775223-2afd-3624-9291-d78e61ad3a6b",
                                "text": "„Riruako hatte 2006 einen wegweisenden Antrag zum »ersten Genozid in Afrika« und zu Entschädigungszahlungen im namibischen Parlament eingebracht, der einstimmig angenommen wurde.“"
                            },
                            {
                                "example_id": "6960ba2d-ef81-41f4-92ee-f765bcb6f5e7",
                                "sense_id": "47775223-2afd-3624-9291-d78e61ad3a6b",
                                "text": "„Mugabes Regierung erweiterte den von Ian Smith erlassenen Victims of Terrorism (Compensation) Act von 1973, wodurch nun auch die schwarzen Kriegsveteranen in den Genuss von Entschädigungszahlungen kommen sollten.“"
                            }
                        ],
