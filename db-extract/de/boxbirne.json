                    {
                        "sense_id": "27d65073-5a11-350f-a723-8a4c4ed89036",
                        "entry_id": "19a580ef-6080-3e4a-9080-f9c82a6fef19",
                        "glosses": [
                            "Sportgerät für Kampfsportler wie Boxer zur Verbesserung der Ausdauer und Schnelligkeit ihrer Schläge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc62d12-6954-40e7-ad7f-a21c567cc97e",
                                "sense_id": "27d65073-5a11-350f-a723-8a4c4ed89036",
                                "text": "„Diesmal ist der Gegner ein Rußlanddeutscher; einer, der täglich mit seinem Vater zwei Stunden im Keller des Wohnheims trainiert; einer, der immer wieder die Boxbirne mit 180 Beats pro Minute malträtiert, bis die Fingerknöchel wund sind und das Ego gesund ist.“"
                            },
                            {
                                "example_id": "61b0187c-03d3-46e4-9975-84d26a159296",
                                "sense_id": "27d65073-5a11-350f-a723-8a4c4ed89036",
                                "text": "„Özbek taucht ein-, zweimal unter der Boxbirne weg und klopft ein bisschen auf den Sandsack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
