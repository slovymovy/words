                                "target_lang_word": "soften",
                                "target_lang_sense_clarification": "tone, criticism, or harsh sanctions"
                            },
                            {
                                "target_lang_word": "temper",
                                "target_lang_sense_clarification": "moderating severity or strictness"
                            },
                            {
                                "target_lang_word": "mollify",
                                "target_lang_sense_clarification": "calming anger or irritation"
                            }
                        ],
