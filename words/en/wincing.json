{
    "word_family": [
        "wince"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a537df4b-eec7-30a2-980b-dd670cbe3ecc",
                    "sense_definition": "present participle and gerund of <w>wince</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>wincing</w> in pain after she twisted her ankle on the stairs.",
                            "target_lang_translations": {
                                "cs": "Poté, co si na schodech zvrtla kotník, <w>cukala bolestí</w>."
                            }
                        },
                        {
                            "text": "The constant <w>wincing</w> showed how much the loud noise bothered him.",
                            "target_lang_translations": {
                                "cs": "To neustálé <w>šklebení se</w> ukazovalo, jak moc ho ten hlasitý hluk obtěžuje."
                            }
                        }
                    ],
                    "synonyms": [
                        "flinching",
                        "grimacing"
                    ],
                    "common_phrases": [
                        "wincing in pain"
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa cuknout, trhnout sebou nebo zašklebit se bolestí"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cukání",
                                "target_lang_sense_clarification": "vyjádření fyzické reakce na bolest nebo nepohodlí"
                            },
                            {
                                "target_lang_word": "šklebení se",
                                "target_lang_sense_clarification": "vyjádření bolestivého výrazu v obličeji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "061b1bab-254e-3ec8-8bde-d6a72ce58c89",
                    "sense_definition": "The act of making a slight involuntary shrinking or jerking movement of the body out of pain or distress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>wincing</w> was barely noticeable to anyone but his closest friends.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>trhnutí</w> si nikdo kromě jeho nejbližších přátel sotva všiml."
                            }
                        },
                        {
                            "text": "The sudden <w>wincing</w> revealed that the injury was still quite fresh.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>zašklebení</w> odhalilo, že zranění je stále ještě docela čerstvé."
                            }
                        }
                    ],
                    "synonyms": [
                        "flinch",
                        "grimace"
                    ],
                    "target_lang_definitions": {
                        "cs": "neúmyslný, krátký pohyb těla nebo obličeje způsobený bolestí, strachem nebo nepříjemným pocitem"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trhnutí",
                                "target_lang_sense_clarification": "náhlý pohyb těla v reakci na bolest"
                            },
                            {
                                "target_lang_word": "zašklebení",
                                "target_lang_sense_clarification": "výraz obličeje vyjadřující bolest či odpor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}