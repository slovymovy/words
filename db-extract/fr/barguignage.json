                ],
                "senses": [
                    {
                        "sense_id": "4be080c9-3f8a-3e73-9f44-c9a80ef499e2",
                        "entry_id": "1992ac4a-717d-36f2-9c08-f3d705b1b07c",
                        "glosses": [
                            "Action de barguigner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "88bd6413-21a9-46db-8ebb-27a7af056a01",
                                "sense_id": "4be080c9-3f8a-3e73-9f44-c9a80ef499e2",
                                "text": "Point tant de barguignage."
                            },
                            {
                                "example_id": "14ad737a-af13-442b-9d99-c986bfcb45c8",
                                "sense_id": "4be080c9-3f8a-3e73-9f44-c9a80ef499e2",
                                "text": "Encore qu’elle se prolonge au-delà de toute mesure, elle menace de durer : la patience chinoise, dans la palabre et le barguignage, est sans bornes."
                            },
                            {
                                "example_id": "8812fcb4-355a-4ecb-8291-f8a91af4ab95",
                                "sense_id": "4be080c9-3f8a-3e73-9f44-c9a80ef499e2",
                                "text": "Deux idiots, qui ne comprenaient rien à son état d’âme, le considéraient comme une curiosité mais l’eussent dénoncé sans barguignage, s’il s’était enfui."
                            }
                        ]
                    }
                ],
