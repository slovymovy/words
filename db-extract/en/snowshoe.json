                        "source_entry_id": "3ed850ce-6477-3f4f-beac-0477cfcf096b",
                        "source_sense_description": "flat footwear worn to facilitate walking in deep snow",
                        "target_lang_word": "Schneeschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneeschuh",
