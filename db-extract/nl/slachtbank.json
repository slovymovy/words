                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c5acdc4c-9378-451e-9685-45c811f7f179",
                                "sense_id": "d0018030-0164-3617-8f3b-c184c465de31",
                                "text": "`Ten tweede omdat ik, als je wel zou gaan, elke persoon van de mannelijke kunne tussen de twaalf en de negentig jaar die het zou wagen je aan te spreken, plus nog de nodige lesbiennes, zou moeten neerknallen. Dat wil zeggen zo'n 75 procent van de cliëntèle van Le Croc. Ik zie de krantenkoppen al voor me: \"Bloedbad in de Alpen\" en \"Lamb voert gasten naar slachtbank\"."
                            },
                            {
                                "example_id": "67646d09-fde9-4393-a917-951876e0df06",
                                "sense_id": "d0018030-0164-3617-8f3b-c184c465de31",
                                "text": "`Ze zullen toch niet die jongens ten tonele laten verschijnen? Dan kunnen ze hen beter direct naar de slachtbank voeren."
                            }
                        ]
                    }
                ],
