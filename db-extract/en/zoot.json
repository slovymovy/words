                "senses": [
                    {
                        "sense_id": "0b139ffd-1239-397e-a744-993fe778379e",
                        "entry_id": "b47660da-f964-3754-a133-7a25a5a1ed37",
                        "glosses": [
                            "A zoot suit."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b341129a-b0a3-424e-94c7-e21f0f70cd7c",
                                "sense_id": "0b139ffd-1239-397e-a744-993fe778379e",
                                "text": "I couldn't wait for eight o'clock to get home to eat out of those soul-food pots of Ella's, then get dressed in my zoot and head for some of my friends' places in town, to lindy-hop and get high, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "72f81547-db4d-3cdc-a473-89a9b4a60bb6",
                        "entry_id": "b47660da-f964-3754-a133-7a25a5a1ed37",
                        "glosses": [
                            "A fursuit."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "04d95d30-38aa-4b43-a4b9-cd0a686b6f12",
                                "sense_id": "72f81547-db4d-3cdc-a473-89a9b4a60bb6",
                                "text": "I also told him about a fur meet in which we 'squicked a bunch of mundanes' by running around in a shopping mall in zoots, etc."
                            },
                            {
                                "example_id": "234ecada-ef47-431e-9d70-93fc986f791b",
                                "sense_id": "72f81547-db4d-3cdc-a473-89a9b4a60bb6",
                                "text": "It seems some Furries like zoots because they're the closest thing to a live anthro they can find."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
