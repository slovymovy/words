                                        "glosses": [
                                            "To have a connection."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7339547a-ea6d-49d1-aafd-8df0d1344ca0",
                                                "sense_id": "25806ebc-0312-353e-9fc5-271b3fc1b382",
                                                "text": "The patterns on the screen relate to the pitch and volume of the music being played."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da01732-3269-388e-9566-abdff01f12f1",
                                        "entry_id": "ba8b4985-3083-36f1-8fd3-905aaaaf8978",
                                        "glosses": [
                                            "To interact."
                                        ],
                                        "tags": [
