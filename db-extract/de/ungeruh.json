                ],
                "senses": [
                    {
                        "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                        "entry_id": "5cd468f6-b804-3978-95c2-f985c70bedfe",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03db29c7-54b3-45e4-9817-387ef0c49b5e",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Frau Ungeruh ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52586f90-d457-43b9-9705-3ccfec8002d0",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Herr Ungeruh wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7017f9e6-a180-4633-a7ed-be6c2a17718d",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Die Ungeruhs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "91e255fa-3868-4be7-833d-b61f87e75ad4",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Der Ungeruh trägt nie die Schals, die die Ungeruh ihm strickt."
                            },
                            {
                                "example_id": "dde50854-4ec9-4304-a557-c8ce27df5e33",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ungeruh kommt, geht der Herr Ungeruh.“"
                            },
                            {
                                "example_id": "3a2429f5-28a9-487b-831a-7461560643f6",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Ungeruh kommt und geht."
                            },
                            {
                                "example_id": "8efe222c-fce9-495e-8ea2-6ea5184e2881",
                                "sense_id": "ab3faa38-8109-3a82-a3e4-4116369310df",
                                "text": "Ungeruhs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
