                        ],
                        "examples": [
                            {
                                "example_id": "45af8362-f571-4912-bdfc-7569619cd154",
                                "sense_id": "3e422451-a969-3551-bcd6-4c42d6e6d8f4",
                                "text": "The ancient poetess singeth, that Hesperus all things bringeth, / Smoothing the wearied mind: bring me my love, Rosalind."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
