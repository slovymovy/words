                "senses": [
                    {
                        "sense_id": "de20792d-32ed-3727-a467-16d8ba50da2d",
                        "entry_id": "9b5482c3-d049-30eb-b994-395be28b1e37",
                        "glosses": [
                            "Donner un caractère anodin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26b281c-5004-415b-a18e-7e01464e1c9f",
                                "sense_id": "de20792d-32ed-3727-a467-16d8ba50da2d",
                                "text": "Aux yeux de l'homme de loi, il faut se garder «d'anodiniser» le phénomène."
                            },
                            {
                                "example_id": "2215ceb9-ac58-45ac-91dd-1c77db32ec29",
                                "sense_id": "de20792d-32ed-3727-a467-16d8ba50da2d",
                                "text": "le terme (beschônigen) signifie littéralement « présenter quelque chose comme plus innocent et plus favorable que cela n’est» et donc l’anodiniser, en minimiser l’importance."
                            },
                            {
                                "example_id": "a526dec5-fd9e-4a04-8357-df863382ce1a",
                                "sense_id": "de20792d-32ed-3727-a467-16d8ba50da2d",
                                "text": "Prenez garde au MacBook Air, qui pourrait s'«anodiniser» avec un bleu oeuf de rouge-gorge, et attendez-vous à ce que l'iPad 3 sorte en vert citron."
                            }
                        ]
                    }
