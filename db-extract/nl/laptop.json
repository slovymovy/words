                                        "glosses": [
                                            "Ordinateur d'une taille réduite, disposant d'un écran et d'un clavier intégrés ainsi que d'une certaine autonomie sur batterie, conçu pour être facilement transportable et utilisable en différents endroits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4724127a-0118-48f3-8efb-d1b09650673c",
                                                "sense_id": "018d8818-7d53-3d20-b9cf-4c92e332802a",
                                                "text": "Un ordinateur de bureau est généralement plus puissant, mieux équipé en cartes d’entrées-sorties et en espace disque qu’un ordinateur portable, et son écran est plus grand."
                                            },
                                            {
                                                "example_id": "8bf4c71f-0629-4cb0-a12a-466ee6c0580d",
                                                "sense_id": "018d8818-7d53-3d20-b9cf-4c92e332802a",
                                                "text": "Un ordinateur portable aux couleurs acidulées était posé sur ses genoux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
