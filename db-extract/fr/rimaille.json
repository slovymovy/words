                    {
                        "sense_id": "2c7fdcfb-44da-34ab-b8cc-96a709f08517",
                        "entry_id": "32283895-99c5-3d4b-9902-5b98f592f44e",
                        "glosses": [
                            "Mauvaise poésie ; mauvais vers."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ca15f927-b1c2-4d84-9733-d8a4e9e15d44",
                                "sense_id": "2c7fdcfb-44da-34ab-b8cc-96a709f08517",
                                "text": "Bien des feuillets absorbent la rimaille d’un trouvère perdu en son siècle."
                            },
                            {
                                "example_id": "1f4cc7f0-aee8-4f7f-a891-c4fb5eb51939",
                                "sense_id": "2c7fdcfb-44da-34ab-b8cc-96a709f08517",
                                "text": "Si les pièces qu’on y insère n’ont pas toutes le même mérite, au moins est-on sûr de n’y jamais rencontrer de ces fades et plattes rimailles qui, tant de fois ont servi de prétexte à calomnier la Poésie."
                            }
                        ]
                    }
                ],
