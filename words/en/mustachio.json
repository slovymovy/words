                    "sense_definition": "A mustache, especially one that is notably large, elaborate, or bushy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain twirled his elaborate <w>mustachio</w> while laughing at the hero.",
                            "target_lang_translations": {
                                "de": "Der Bösewicht zwirbelte seinen kunstvollen <w>Schnurrbart</w>, während er den Helden auslachte."
                            }
                        },
                        {
                            "text": "He spent years grooming an impressive handlebar <w>mustachio</w>.",
                            "target_lang_translations": {
                                "de": "Er verbrachte Jahre damit, sich einen beeindruckenden <w>Zwirbelbart</w> wachsen zu lassen und zu pflegen."
                            }
                        }
                    ],
                    "synonyms": [
