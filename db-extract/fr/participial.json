                "translations": [
                    {
                        "translation_id": "0a984668-cac7-4d35-94d3-2a868170d443",
                        "source_entry_id": "5380d408-29b2-3fd6-a56e-025488ff6ede",
                        "source_sense_id": "80abcf3a-d508-39cd-b3f5-c28d94804f60",
                        "target_lang_word": "partizipial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partizipial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                        "entry_id": "643f9f60-e3fa-371b-8b71-65671d01ea25",
                                        "glosses": [
                                            "das Partizip betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e657524f-d6f7-44e1-becf-89f9d56cbe1f",
                                                "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                                "text": "Die Verwendung partizipialer Ausdrücke erspart eine Menge von Nebensätzen."
                                            },
                                            {
                                                "example_id": "98bd4f51-e872-4884-be29-842e6e3921e1",
                                                "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                                "text": "Deshalb hätte man gern das partizipiale Substantiv Geflüchteter, das man ohne Aufhebens gendern kann."
                                            },
                                            {
                                                "example_id": "64f7154c-5299-4991-b4aa-1daad386511a",
                                                "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                                "text": "Da spiegelt die partizipial verkrampfte Ersetzung eines unschuldigen Wortes den wohl noch aus der zweiten deutschen Nachkriegszeit ererbten Verdrängungswunsch gegenüber Flüchtlingsschicksalen."
                                            },
                                            {
                                                "example_id": "0925bd4f-688a-4353-a774-46182f62fcfb",
                                                "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                                "text": "Offensichtlich war es aber früher weiter verbreitet, hat aber dann wohl, wie andere Adjektive auch (vgl. etwa petrea, calcea) der zugehörigen partizialen Form Platz machen müssen."
                                            },
                                            {
                                                "example_id": "fbea340e-b9d9-4e33-87ad-5b9ff30d5468",
                                                "sense_id": "0a1e40d0-efa3-3b24-9b4e-27aae7b1736d",
                                                "text": "Das Hurritische kennt partizipiale Nominalisierungen und einen Infinitiv."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a49dc653-6f2e-4cfb-abfb-9dc7e743af11",
                        "source_entry_id": "5380d408-29b2-3fd6-a56e-025488ff6ede",
                        "source_sense_id": "80abcf3a-d508-39cd-b3f5-c28d94804f60",
                        "target_lang_word": "причастный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "причастный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec613f9-0ecb-38c4-880a-37c508eaa61c",
                                        "entry_id": "32a818d9-31f9-3ec7-a009-3388f12835a1",
                                        "glosses": [
                                            "устар. имеющий непосредственное отношение, касательство к чему-либо"
                                        ],
                                        "tags": [
                                            "к чему",
                                            "чему"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f2d9679-dd70-4668-ac26-81ef4d6071ed",
                                                "sense_id": "4ec613f9-0ecb-38c4-880a-37c508eaa61c",
                                                "text": "В 1904 году была образована особая комиссия — с целью выдавать ссуды и пособия нуждающимся артистам, писателям, художникам, музыкантам и вообще лицам, причастным к искусству"
                                            },
                                            {
                                                "example_id": "b1412ffa-294b-4aa9-a62e-799eb2be8ed3",
                                                "sense_id": "4ec613f9-0ecb-38c4-880a-37c508eaa61c",
                                                "text": "Я тому греху не причастен, я ошибкой осуждён…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fddb842-e1f6-395f-9a8a-fafabfdcd508",
                                        "entry_id": "32a818d9-31f9-3ec7-a009-3388f12835a1",
                                        "glosses": [
                                            "лингв. прил. к причастие; выраженный с помощью причастия, имеющий в своём составе причастие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfcdd686-e097-417b-9caa-d6d49f850fb2",
                                                "sense_id": "6fddb842-e1f6-395f-9a8a-fafabfdcd508",
                                                "text": "Не от того ли глагол выражается в инфинитивной, причастной или вопросительной формах, что сам смысл выражается в предложении глаголом…"
                                            },
                                            {
                                                "example_id": "625f5609-2d8e-4417-890a-6f30314052b3",
                                                "sense_id": "6fddb842-e1f6-395f-9a8a-fafabfdcd508",
                                                "text": "Он оценивает эффект отдельного нюанса, того или иного изречения, удачно употреблённого причастного оборота, но впечатление они произведут на других."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
