            {
                "entry_id": "6cb6c8ae-4267-3260-8124-854db4693cb6",
                "word": "ebben",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "978e17e5-537a-3c6f-8fc2-f8870ae2b2b6",
                        "entry_id": "6cb6c8ae-4267-3260-8124-854db4693cb6",
                        "glosses": [
                            "het zwarte en zware hout van een ebbenboom, behorende tot één uit een aantal tropische soorten uit het geslacht Diospyros (familie Ebenaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f121ac-c5a0-4723-93b9-ede0400486b8",
                                "sense_id": "978e17e5-537a-3c6f-8fc2-f8870ae2b2b6",
                                "text": "Het gebruik van ebben is vanwege de kostbaarheid van het hout erg beperkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87ab7edf-3f97-482d-bdd1-27bbd71a2b29",
                        "source_entry_id": "6cb6c8ae-4267-3260-8124-854db4693cb6",
                        "source_sense_id": "978e17e5-537a-3c6f-8fc2-f8870ae2b2b6",
                        "source_sense_description": "1, edele houtsoort",
                        "target_lang_word": "ebony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ebony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a48ba9-33d6-3a5f-984d-1d2dc8c274da",
                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "A hard, dense, deep black wood from various subtropical and tropical trees, especially of the genus Diospyros."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf1f68aa-05e2-3bd6-9e90-b009cc90773f",
                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "A tree that yields such wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3803f519-7054-4d1a-8023-8c7744c772b8",
                                                "sense_id": "cf1f68aa-05e2-3bd6-9e90-b009cc90773f",
                                                "text": "“You live up the road past the ebony tree, right?” he asked, looking past me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09b82e80-123b-32e2-a40a-a0300fb3f4ec",
                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "A deep, dark black colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbe9d3b5-696c-3ac5-b1ac-e54734420acb",
                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "Dark skin colour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a25e280e-6916-45fe-805c-dc8f555319d7",
                                                "sense_id": "dbe9d3b5-696c-3ac5-b1ac-e54734420acb",
                                                "text": "At dawn the hunters were off. There were fifty sleek, black warriors, and in their midst, lithe and active as a young forest god, strode Tarzan of the Apes, his brown skin contrasting oddly with the ebony of his companions. Except for color he was one of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "970b7ce1-613c-39f0-80e2-e213bdff5e72",
                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "A black key on a piano or other keyboard instrument (as opposed to ivory)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d394db-a570-4457-9a4e-531ddee01a52",
                                                "sense_id": "970b7ce1-613c-39f0-80e2-e213bdff5e72",
                                                "text": "Ebony and ivory / Live together in perfect harmony / Side by side on my piano keyboard / Oh lord, why don't we?"
                                            },
                                            {
                                                "example_id": "dabfb0a6-9cd0-49e2-bd46-69f8787d7b92",
                                                "sense_id": "970b7ce1-613c-39f0-80e2-e213bdff5e72",
                                                "text": "Tony had gone into the storage room and gotten two more standing lamps, one placed near the ebonies and ivories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ebony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e61ac74-29ec-3c50-bb40-e4eb06129e32",
                                        "entry_id": "9244f9b0-b581-31cf-90fc-ffc202f91533",
                                        "glosses": [
                                            "Made of ebony wood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ad34d19-0e26-3f2d-8327-eebe62245e56",
                                        "entry_id": "9244f9b0-b581-31cf-90fc-ffc202f91533",
                                        "glosses": [
                                            "A deep, dark black colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99908638-3d50-4c25-9ab5-1b7d104f39ac",
                                                "sense_id": "0ad34d19-0e26-3f2d-8327-eebe62245e56",
                                                "text": "Seats are trimmed in a grey and blue moquette and tables are finished with grey Vyanide tops, gilt edging and ebony legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfe2254-585d-3129-b1e3-a393bf9a9bc3",
                                        "entry_id": "9244f9b0-b581-31cf-90fc-ffc202f91533",
                                        "glosses": [
                                            "Dark-skinned; black; especially in reference to African-Americans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb27dae-4d04-4b5d-982f-4eba34b8a5ac",
                                                "sense_id": "ecfe2254-585d-3129-b1e3-a393bf9a9bc3",
                                                "text": "He called the ebony mistress of the establishment to him, and speaking to her kindly and winningly, as any dutiful husband should, told her to make the change, which she did."
                                            },
                                            {
                                                "example_id": "2f64ca10-d08d-45e5-bf74-8f077c81f77d",
                                                "sense_id": "ecfe2254-585d-3129-b1e3-a393bf9a9bc3",
                                                "text": "No attempt was made in her new home to discontinue or even to conceal the presence of an ebony mistress and a thriving family of little mulattoes..."
                                            },
                                            {
                                                "example_id": "22d6237f-bdcb-4db9-bba3-4a8c0fa0e3c2",
                                                "sense_id": "ecfe2254-585d-3129-b1e3-a393bf9a9bc3",
                                                "text": "Want to watch my gorgeous ebony friend, Almond Joy, naked and online 24/7? She recently ended a long-term relationship and is now fully enjoying being a 25 year-old single gal in Beverly Hills."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b9bb38e-1eea-4b01-9b0b-a44b5e51ab83",
                        "source_entry_id": "6cb6c8ae-4267-3260-8124-854db4693cb6",
                        "source_sense_id": "978e17e5-537a-3c6f-8fc2-f8870ae2b2b6",
                        "source_sense_description": "1, edele houtsoort",
                        "target_lang_word": "ébène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ébène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdd1d7a-84b2-37dc-9d5f-e14e48d16cf2",
                                        "entry_id": "ab3eff12-5599-3616-b42f-69c06c0cc443",
                                        "glosses": [
                                            "Nom habituellement donné au bois de divers arbres de la famille des Ebenaceae (Ébénacées) du genre Diospyros nommés ébénier et certains plaqueminiers au bois sombre. On trouve aussi un arbre de la famille des Fabaceae (Fabacées) le Dalbergia melanoxylon ou ébène du Mozambique. Ce sont des bois gris foncé, sombres, noirs, parfois veinés , d’un grain fin et d’une grande dureté, aujourd'hui principalement utilisés dans la fabrication d'objets décoratifs ou usuels de petite dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e95bcb-a8a5-4e34-9d7d-f0a7a5336851",
                                                "sense_id": "ecdd1d7a-84b2-37dc-9d5f-e14e48d16cf2",
                                                "text": "« Miroir magique au mur, qui a beauté parfaite et pure ?\n— Célèbre est ta beauté Majesté. Pourtant, une jeune fille en loques dont les haillons ne peuvent dissimuler la grâce, est hélas encore plus belle que toi.\n— Décris-la moi. Apprends-moi son nom.\n— Lèvres rouges comme la rose. Cheveux noirs comme l’ébène. Teint blanc comme la neige.\n— Blanche-Neige ! »"
                                            },
                                            {
                                                "example_id": "3b74865a-acd3-4dff-a2b9-db84a7e77043",
                                                "sense_id": "ecdd1d7a-84b2-37dc-9d5f-e14e48d16cf2",
                                                "text": "Ce bureau en chêne, ébène et bronze, est l’œuvre du décorateur et architecte Armand-Albert Rateau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ébène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad14dc2-df56-3f31-945a-e4f1b12d8dbe",
                                        "entry_id": "075fdf44-fa81-3d38-8554-e2b0c0a79ae1",
                                        "glosses": [
                                            "De couleur noire pure. #000000"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9286e640-ddd7-4ec7-9284-b419c76648d9",
                                                "sense_id": "2ad14dc2-df56-3f31-945a-e4f1b12d8dbe",
                                                "text": "Nous sommes plusieurs avec une peau d’ébène à abonder dans le même sens dans l’ombre. Parce que ces concepts sont synonymes d’accusation envers la « majorité blanche »."
                                            }
                                        ]
                                    }
                                ]
                            },
