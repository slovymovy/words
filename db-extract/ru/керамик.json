                "senses": [
                    {
                        "sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "glosses": [
                            "тот, кто занимается керамикой, создаёт изделия из обожжённой глины"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5682b0c-923f-4eea-9026-37afbf1946ef",
                        "source_entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "source_sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "target_lang_word": "ceramist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceramist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                        "entry_id": "efe2947b-5ee7-3dee-a1cc-4839f637f9b9",
                                        "glosses": [
                                            "A person who makes ceramics objects; a potter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b1e68c-5436-4c29-a0b4-0abb53e31918",
                                                "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                                "text": "Wilson is part of a group of female ceramists from all over the globe who are meditating on the beauty of imperfection, age and artlessness, borrowing ideas from the past, including the Zen Buddhist philosophy of wabi-sabi."
                                            },
                                            {
                                                "example_id": "d37c4575-14a6-4b46-97ce-7444816ff521",
                                                "sense_id": "9e6762df-f08e-3453-8a93-3cce8c55f142",
                                                "text": "The Corfu, Greece-born, London-based ceramist Agalis Manessi, 69, creates her animals — recumbent hounds, alert hares — from lumps of terra-cotta clay that she squeezes and manipulates “until a figure emerges.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5d5b4de-78e8-4adf-aa8a-eb3a4cb459b3",
                        "source_entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "source_sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "target_lang_word": "ceramicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceramicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                        "entry_id": "48de37d1-bdac-31c8-adf7-3a96e8aba978",
                                        "glosses": [
                                            "A person who makes ceramics, such as pottery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0266fe-3eb1-4497-9734-4432e25eddff",
                                                "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                                "text": "Otto Natzler, a ceramicist best known for inventing glazes resembling geologic textures and colors that he applied to forms created by his wife Gertrud in a famous collaboration of more than three decades, died on April 7 in Los Angeles."
                                            },
                                            {
                                                "example_id": "f8696d8e-d1b2-4966-83f2-0e3b83714454",
                                                "sense_id": "3365a2a1-edca-3b1f-a46b-9e157e2080b2",
                                                "text": "While the work of the contemporary artists in the show is avant-garde, it does not overwhelm the colorful faience made by the Faucon family, seven generations of ceramicists who operated a factory in Apt, a town in the Luberon Valley, from 1890 until 2002."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc15a43-bf66-45e9-8e4e-ce99d25bc562",
                        "source_entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "source_sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "target_lang_word": "ceramista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6edb210f-2c47-4c25-bd10-296479595339",
                        "source_entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "source_sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "target_lang_word": "maiolicaio",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6a338b45-7b2e-494b-890a-b8edaca3398a",
                        "source_entry_id": "bed29685-1889-3034-b44b-0e688b8f80cd",
                        "source_sense_id": "5fea3464-b6af-32ed-be14-aedf1be1ecf7",
                        "target_lang_word": "céramiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "céramiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68d850c5-9e3c-3293-9b07-3103d7577e79",
                                        "entry_id": "979a6683-7a38-3093-a839-92d5a10519d2",
                                        "glosses": [
                                            "Celui ou celle qui fabrique des vases de terre, des briques, etc."
                                        ],
                                        "tags": [
                                            "Céramique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e65d4917-958b-4700-af0d-f24b14e115ba",
                                                "sense_id": "68d850c5-9e3c-3293-9b07-3103d7577e79",
                                                "text": "Le visiteur découvre les multiples talents de Mathurin Méheut, à la fois peintre, décorateur, illustrateur, céramiste et sculpteur."
                                            },
                                            {
                                                "example_id": "0af53d26-d45e-4da5-a828-001df264ab99",
                                                "sense_id": "68d850c5-9e3c-3293-9b07-3103d7577e79",
                                                "text": "Une céramiste montréalaise le démontre en offrant des ateliers où ses élèves (tous adultes évidemment) fabriquent leurs propres jouets sexuels."
                                            },
                                            {
                                                "example_id": "412d1c27-81ff-47c6-8ba2-517d25c49acc",
                                                "sense_id": "68d850c5-9e3c-3293-9b07-3103d7577e79",
                                                "text": "Installé à Saint-Paul de Vence puis à Vallauris, il travaille en collaboration avec des céramistes de renom tels Roger Capron, Jean Marais, le maître verrier Jean-Claude Novaro…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c384311-88c2-350d-b8a3-71b56aaad5eb",
                                        "entry_id": "979a6683-7a38-3093-a839-92d5a10519d2",
                                        "glosses": [
                                            "Fabricant, fabricante ou vendeur, vendeuse de carrelage."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "240e8a30-ae27-4f87-b8b8-d5da9320b72e",
                                                "sense_id": "4c384311-88c2-350d-b8a3-71b56aaad5eb",
                                                "text": "Résultat : le céramiste s’apprête à céder à un autre groupe transalpin ses deux usines de Châteauroux (Indre) et Forbach (Moselle), sur les trois qu’il compte en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
