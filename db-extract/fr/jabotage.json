                        "examples": [
                            {
                                "example_id": "702078c8-baa7-4e81-a331-64573cb52785",
                                "sense_id": "0bc3b147-d846-3e80-88e0-25d094d3f81d",
                                "text": "Pépiement des moineaux, trilles des serins, jabotage des perruches, roucoulement des colombes, babillage des perroquets, margotage des cailles et braillement des paons, tous les sons de la nature s’y mêlent !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ecf14f4-9e16-347b-b2e6-5094b183b248",
                        "entry_id": "3b1f42ce-f4fc-3efd-b239-48675f7791f3",
                        "glosses": [
                            "Caquetage, bavardage."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "10b042c9-d542-4e48-9cbb-18093b3cd4d3",
                                "sense_id": "5ecf14f4-9e16-347b-b2e6-5094b183b248",
                                "text": "J'ai hâte d'entendre sortir de votre bouche des choses raisonnables, et non des bavardages et des jabotages."
                            }
                        ]
                    }
