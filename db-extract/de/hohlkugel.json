                "senses": [
                    {
                        "sense_id": "18819b4f-8454-3541-81e5-7df5cd09acc5",
                        "entry_id": "eb3dcb92-5595-397a-a5e7-7075cb94366c",
                        "glosses": [
                            "Kugel, deren Inneres leer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b72b5d-9cf9-42d2-97c7-8cccd91c2ece",
                                "sense_id": "18819b4f-8454-3541-81e5-7df5cd09acc5",
                                "text": "„Bei einem Überschuss an elektrischer Leistung wird das Wasser wieder teils oder ganz aus der Hohlkugel gepumpt.“"
                            },
                            {
                                "example_id": "e1ff1e95-a29b-4e93-93ba-887285ef79ef",
                                "sense_id": "18819b4f-8454-3541-81e5-7df5cd09acc5",
                                "text": "„Nur dank einer älteren Untersuchung aus den sechziger Jahren, bei der der Globus demontiert worden war, wussten die Konstrukteure, dass die 70 Kilogramm schwere Hohlkugel aus einer Schale aus Holzschindeln besteht, auf die ein Mantel aus Papiermaché aufgebracht wurde, der mit einer Kreideschicht überzogen wurde, die als Malgrund diente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
