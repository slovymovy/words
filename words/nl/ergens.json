                    "sense_id": "3e3b831f-38d7-3342-8a6a-8b2179aa185b",
                    "sense_definition": "Op een plaats die niet precies genoemd wordt of niet bekend is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb mijn sleutels <w>ergens</w> in de keuken laten liggen.",
                            "target_lang_translations": {
                                "en": "I left my keys <w>somewhere</w> in the kitchen.",
                                "ru": "Я оставил свои ключи <w>где-то</w> на кухне.",
                                "de": "Ich habe meine Schlüssel <w>irgendwo</w> in der Küche liegen lassen.",
                                "it": "Ho lasciato le mie chiavi <w>da qualche parte</w> in cucina.",
                                "pl": "Zostawiłem klucze <w>gdzieś</w> w kuchni.",
                                "fr": "J'ai laissé mes clés <w>quelque part</w> dans la cuisine.",
                                "cs": "Nechal jsem své klíče <w>někde</w> v kuchyni.",
                                "tr": "Anahtarlarımı mutfakta <w>bir yerde</w> unutmuşum.",
                                "es": "He dejado mis llaves <w>en algún lugar</w> de la cocina.",
                                "zh": "我把钥匙<w>在某处</w>落在了厨房里。"
                            }
                        },
                        {
                            "text": "Zullen we <w>ergens</w> anders een kopje koffie gaan drinken?",
                            "target_lang_translations": {
                                "en": "Shall we go have a cup of coffee <w>somewhere</w> else?",
                                "ru": "Может, выпьем кофе <w>где-нибудь</w> в другом месте?",
                                "de": "Sollen wir <w>woanders</w> einen Kaffee trinken gehen?",
                                "it": "Andiamo a bere un caffè <w>da qualche altra parte</w>?",
                                "pl": "Pójdziemy wypić kawę <w>gdzieś</w> indziej?",
                                "fr": "Est-ce qu'on va boire un café <w>quelque part</w> ailleurs ?",
                                "cs": "Půjdeme si dát šálek kávy <w>někam</w> jinam?",
                                "tr": "Başka <w>bir yerde</w> bir fincan kahve içmeye gidelim mi?",
                                "es": "¿Vamos a tomar un café <w>en otro lugar</w>?",
                                "zh": "我们要不要去<w>别处</w>喝杯咖啡？"
                            }
                        }
