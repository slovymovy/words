                "senses": [
                    {
                        "sense_id": "90f212b8-6df5-38f6-a8d7-95109a182ac4",
                        "entry_id": "2645241f-603a-3219-8e4a-f7e5993b059d",
                        "glosses": [
                            "A visit by a provider of some service, such as a massage therapist or a prostitute, to a client."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0df65c-920d-48f8-8a22-89ab5c049346",
                                "sense_id": "90f212b8-6df5-38f6-a8d7-95109a182ac4",
                                "text": "Some massage therapists only provide incall services because of the travel and setup times required for outcalls. A few massage therapists only provide outcalls because they do not have an office. When setting your rates, […]"
                            },
                            {
                                "example_id": "340f6338-269e-420c-b4f5-5087f38d28f9",
                                "sense_id": "90f212b8-6df5-38f6-a8d7-95109a182ac4",
                                "text": "I know this sounds stupid, but have a massage table. And enough sheets and oil. I had someone apply for an outcall therapist position that I was trying to fill and halfway through the phone call they informed that they didn't have a car...or a table."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2812d72-117e-3c1a-81b5-24cc59682cbc",
                        "entry_id": "2645241f-603a-3219-8e4a-f7e5993b059d",
                        "glosses": [
                            "An outgoing telephone call."
                        ],
                        "tags": [
                            "nonstandard",
                            "possibly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd16a05b-89ca-4010-aca0-72584d1bf704",
                                "sense_id": "f2812d72-117e-3c1a-81b5-24cc59682cbc",
                                "text": "They charge for business telephones $25 and 2 cents per outcall. Let us see what that means. I do not suppose that any man who uses a telephone in his business makes less than five calls a day; that is 10 cents a day or $30 a year."
                            },
                            {
                                "example_id": "d6231c28-c5d8-4508-9c7d-bba36b30cd16",
                                "sense_id": "f2812d72-117e-3c1a-81b5-24cc59682cbc",
                                "text": "\"Does the state (or the prison) get stuck with any telephone calls which somehow do not get billed collect?\" Folsom: According to Pacific Bell, […] located within the institution. This coding is designated through the outcall phone numbers."
                            }
                        ]
                    }
                ],
