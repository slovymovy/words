                    },
                    {
                        "sense_id": "d379ddab-dfc0-3799-b15e-8b837f7f3039",
                        "entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "glosses": [
                            "unanständig"
                        ],
                        "tags": [
                            "in Bezug auf Erotik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b994065-753f-448c-a7c1-45d9228b663e",
                        "source_entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "source_sense_id": "4bdca9e3-a4fc-3c7a-8550-a2a604a02895",
                        "source_sense_description": "unartig, ungezogen, ungehörig, frech",
                        "target_lang_word": "unartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                        "entry_id": "d82ffa9e-d7b1-3fed-9063-bd586ce80288",
                                        "glosses": [
                                            "nicht folgsam, nicht gehorchend"
                                        ],
                                        "tags": [
                                            "heute meist nur noch das Verhalten von Kindern beschreibend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d373b2df-bd89-4be1-90fd-e34bebd660d0",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "Was machen Eltern mit unartigen Kindern? Hoffentlich in die Arme nehmen und – sanft – drücken."
                                            },
                                            {
                                                "example_id": "946fcafe-7f26-4886-b5ed-dddef368297a",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "Bettina ist das unartigste Mädchen, das ich kenne."
                                            },
                                            {
                                                "example_id": "9475a52a-20a7-45c9-9db0-9d9b69385869",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "„Ich nahm also den dicken, kleinen Kerl auf den Schoß und sagte ihm in ernster Weise, daß er sehr unartig gewesen war, erstens, weil er seinen kleinen Bruder geschlagen, und zweitens, weil er seiner Mutter Kummer bereitet hatte.“"
                                            },
                                            {
                                                "example_id": "26a9393f-e2e4-456c-b411-4fe653917984",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "„Im letzten Jahr haben sich die Kinder meiner Cousine bei meiner Geburtstagsfeier wahnsinnig unartig verhalten. Sie haben nur rumgetobt, meine frisch gestrichene Terrassenwand mit dunklen Fußabtritten malträtiert und dann auch noch im Vorbeirennen einige Gläser zertrümmert.“"
                                            },
                                            {
                                                "example_id": "c4995df5-18fe-4cb4-9d3c-9d2723e24793",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "[Michel aus Lönneberga:] „Frau Petrell wollte wahrhaftig auch Michels Holzgewehr kaufen und es an einen kleinen unartigen Jungen verschenken, den sie kannte, aber auch daraus wurde nichts.“"
                                            },
                                            {
                                                "example_id": "e3e5c2e3-b8a8-4eb9-af58-e014f5d39f5c",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "„In der Kita Plaggenmoor des Deutschen Roten Kreuzes (DRK) in Neugraben sollen Kinder von Mitarbeitern angeschrien und bestraft worden sein. Eine Anderthalbjährige soll vor einem leeren Teller gesessen haben, weil sie unartig war.“"
                                            },
                                            {
                                                "example_id": "cb409ab8-29ac-438d-91ef-77b7882654c3",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "„»Ihr sollt keine Prügel haben,« beruhigte ihn Frau Burton; »aber ihr müßt lernen, daß ihr ohne Erlaubnis nichts anrühren dürft. Ich glaube, wenn ihr euer Mittagessen nicht kriegt, so werdet ihr schon besser begreifen, wie unartig ihr gewesen seid.«“"
                                            },
                                            {
                                                "example_id": "b772e35e-7ae2-4b02-97bf-fe8a6101f256",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "[Österreich:] „Die Schreckgestalt Krampus ist in der Vorweihnachtszeit als Begleiter des Nikolaus unterwegs und soll unartige Kinder bestrafen.“"
                                            },
                                            {
                                                "example_id": "30b860ea-6e21-4eae-a512-04873eab09aa",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "[Nikolaus:] „Und seither kommt er Jahr für Jahr am 6. Dezember […] und steckt den braven Kindern Nüsse und Schokolade, den unartigen aber eine Rute in die Stiefel.“"
                                            },
                                            {
                                                "example_id": "a417f4a5-c9cd-4a0d-a29c-b7edd58095cb",
                                                "sense_id": "ec8092e1-1151-3b18-9088-c3d9bb0b6f15",
                                                "text": "„Dann ist da noch Frau Holle. Das ist nicht die Frau Holle aus den Märchen der Brüder Grimm, sondern eine gottesähnliche Gestalt, die im Wald in den Bergen wohnt und unartige Kinder zu sich holt, um sie zu erziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07e826e3-336f-4f14-93bd-85a11ddf1e66",
                        "source_entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "source_sense_id": "4bdca9e3-a4fc-3c7a-8550-a2a604a02895",
                        "source_sense_description": "unartig, ungezogen, ungehörig, frech",
                        "target_lang_word": "ungezogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungezogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "175465df-0233-37d9-9c21-bb8e34b42f5a",
                                        "entry_id": "d414a112-732a-3614-a430-be88d2b0b9f5",
                                        "glosses": [
                                            "nicht gut erzogen, Fehlverhalten zeigend"
                                        ],
                                        "tags": [
                                            "von Kindern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bdbc524-2ff4-47d1-aa73-65787ac69a80",
                                                "sense_id": "175465df-0233-37d9-9c21-bb8e34b42f5a",
                                                "text": "Dieses ungezogene Kind streckt mir immer die Zunge heraus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5befff53-fb63-3f9c-87f0-9e60100ac226",
                                        "entry_id": "d414a112-732a-3614-a430-be88d2b0b9f5",
                                        "glosses": [
                                            "den erwarteten Umgangsformen zuwiderlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a655ad9-32de-4877-b893-e5b0163ffbc0",
                                                "sense_id": "5befff53-fb63-3f9c-87f0-9e60100ac226",
                                                "text": "Das ungezogene Verhalten des Kindes muss bestraft werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e29c3464-37a9-49db-bd40-8bc6fa94d5f0",
                        "source_entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "source_sense_id": "4bdca9e3-a4fc-3c7a-8550-a2a604a02895",
