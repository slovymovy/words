                                "target_senses": [
                                    {
                                        "sense_id": "979e0971-ac94-3f9f-af2a-5d76affa66d1",
                                        "entry_id": "ad8abbbe-369a-3d90-b371-afe9eaee22fb",
                                        "glosses": [
                                            "Resembling curare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac3f432-a521-4a7d-a09f-bef483309b94",
                                                "sense_id": "979e0971-ac94-3f9f-af2a-5d76affa66d1",
                                                "text": "With extremely large doses, the action of edrophonium becomes curariform and capable of potentiating rather than antagonizing the peripheral paralytic effect of curare."
                                            }
                                        ]
