        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                    "sense_definition": "The basic unit of length in the International System of Units, equal to 100 centimetres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric is sold by the <w>metre</w> at this local shop.",
                            "target_lang_translations": {
                                "ru": "В этом местном магазине ткань продается на <w>метры</w>.",
                                "zh": "这家当地商店的布料是按<w>米</w>出售的。",
                                "es": "La tela se vende por <w>metros</w> en esta tienda local."
                            }
                        },
                        {
                            "text": "He is nearly one <w>metre</w> eighty tall.",
                            "target_lang_translations": {
                                "ru": "Его рост почти один <w>метр</w> восемьдесят.",
                                "zh": "他身高将近一<w>米</w>八。",
                                "es": "Mide casi un <w>metro</w> ochenta de altura."
                            }
                        },
                        {
                            "text": "A square <w>metre</w> of this carpet costs fifty pounds.",
                            "target_lang_translations": {
                                "ru": "Квадратный <w>метр</w> этого ковра стоит пятьдесят фунтов.",
                                "zh": "这种地毯每平方<w>米</w>售价五十英镑。",
                                "es": "Un <w>metro</w> cuadrado de esta alfombra cuesta cincuenta libras."
                            }
                        }
                    ],
                    "synonyms": [
                        "m"
                    ],
                    "common_phrases": [
                        "square metre",
                        "cubic metre",
                        "per metre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная единица длины в Международной системе единиц (СИ), равная 100 сантиметрам.",
                        "zh": "国际单位制中的基本长度单位，等于100厘米。",
                        "es": "La unidad básica de longitud en el Sistema Internacional de Unidades, equivalente a 100 centímetros."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метр",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "米",
                                "target_lang_sense_clarification": "长度单位"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "metro",
                                "target_lang_sense_clarification": "unidad de medida de longitud"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd460266-ac84-3bc1-b76d-6a7fa7813060",
                    "sense_definition": "The rhythmic structure or measure in poetry or music.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used a strict <w>metre</w> to create a sense of urgency.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал строгий <w>метр</w>, чтобы создать ощущение безотлагательности.",
                                "zh": "诗人运用了严谨的<w>格律</w>来营造一种紧迫感。",
                                "es": "El poeta utilizó un <w>metro</w> estricto para crear una sensación de urgencia."
                            }
                        },
                        {
                            "text": "The poetic <w>metre</w> of the sonnet is iambic pentameter.",
                            "target_lang_translations": {
                                "ru": "Поэтический <w>размер</w> сонета — ямбический пентаметр.",
                                "zh": "这首十四行诗的诗体<w>格律</w>是抑扬格五音步。",
                                "es": "El <w>metro</w> poético del soneto es el pentámetro yámbico."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poetic metre",
                        "common metre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритмическая структура или размер в поэзии или музыке.",
                        "zh": "诗歌或音乐中的节奏结构或格律。",
                        "es": "La estructura rítmica o medida en la poesía o la música."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метр",
                                "target_lang_sense_clarification": "стихотворный или музыкальный размер"
                            },
                            {
                                "target_lang_word": "размер",
                                "target_lang_sense_clarification": "в поэзии и музыке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格律",
                                "target_lang_sense_clarification": "诗歌的节奏规则"
                            },
                            {
                                "target_lang_word": "节拍",
                                "target_lang_sense_clarification": "音乐中的节奏单位"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "metro",
                                "target_lang_sense_clarification": "medida de un verso o ritmo musical"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "626e65f9-1de4-366b-a530-44d9a5667ad4",
                    "sense_definition": "Alternative spelling of <w>meter</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician will <w>metre</w> the flow of water through the pipes.",
                            "target_lang_translations": {
                                "ru": "Техник будет <w>измерять</w> поток воды в трубах с помощью прибора.",
                                "zh": "技术员将用仪表<w>计量</w>管道中的水流量。",
                                "es": "El técnico <w>medirá</w> el flujo de agua a través de las tuberías."
                            }
                        },
                        {
                            "text": "The electricity usage is <w>metred</w> automatically every month.",
                            "target_lang_translations": {
                                "ru": "Потребление электроэнергии <w>учитывается</w> автоматически каждый месяц.",
                                "zh": "用电量每月会自动进行<w>计量</w>。",
                                "es": "El consumo de electricidad se <w>contabiliza</w> automáticamente cada mes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерять что-либо с помощью прибора (счетчика) или устанавливать счетчик.",
                        "zh": "用仪表测量或通过计量装置记录。",
                        "es": "Medir algo mediante un instrumento o contador, o instalar un contador."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерять",
                                "target_lang_sense_clarification": "с помощью счетчика"
                            },
                            {
                                "target_lang_word": "вести учет",
                                "target_lang_sense_clarification": "по показаниям прибора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计量",
                                "target_lang_sense_clarification": "用仪器测量"
                            },
                            {
                                "target_lang_word": "测量",
                                "target_lang_sense_clarification": "测定数值"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "medir",
                                "target_lang_sense_clarification": "determinar una cantidad con un instrumento"
                            },
                            {
                                "target_lang_word": "contabilizar",
                                "target_lang_sense_clarification": "registrar el consumo mediante un contador"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c64abc0-f8e9-34e1-a8be-9c3dc6af917f",
                    "sense_definition": "To arrange or compose text in a metrical form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author attempted to <w>metre</w> the prose to give it a lyrical quality.",
                            "target_lang_translations": {
                                "ru": "Автор попытался <w>размерить</w> прозу, чтобы придать ей лирическое звучание.",
                                "zh": "作者试图为这段散文<w>押韵</w>，以赋予其抒情色彩。",
                                "es": "El autor intentó dar <w>métrica</w> a la prosa para darle una cualidad lírica."
                            }
                        },
                        {
                            "text": "It is difficult to <w>metre</w> a translation while keeping the original meaning.",
                            "target_lang_translations": {
                                "ru": "Трудно соблюсти <w>размер</w> при переводе, сохранив при этом оригинальный смысл.",
                                "zh": "在保持原意的同时为译文<w>押韵</w>非常困难。",
                                "es": "Es difícil <w>versificar</w> una traducción manteniendo el significado original."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать тексту стихотворный размер или метрическую форму.",
                        "zh": "使文字具有诗歌的格律或节奏。",
                        "es": "Organizar o componer un texto en forma métrica."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размерять",
                                "target_lang_sense_clarification": "придавать ритмическую форму"
                            },
                            {
                                "target_lang_word": "слагать",
                                "target_lang_sense_clarification": "в определенном размере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "押韵",
                                "target_lang_sense_clarification": "使文字符合格律"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "métrica",
                                "target_lang_sense_clarification": "dar forma métrica a un texto"
                            },
                            {
                                "target_lang_word": "versificar",
                                "target_lang_sense_clarification": "componer versos con una estructura rítmica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}