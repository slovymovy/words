                "senses": [
                    {
                        "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                        "entry_id": "de4c5467-9163-3a36-8c17-2b5bf76fdc9a",
                        "glosses": [
                            "Schnelligkeit eines sich fortbewegenden Fahrzeuges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5609006-d3d5-4ec3-84d9-59c9b1369a8b",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Bei 138 Stundenkilometern Fahrgeschwindigkeit hatte ihn beim Abschlusstraining auf der Streif in Kitzbühel eine Bodenwelle aus dem Gleichgewicht gebracht.“"
                            },
                            {
                                "example_id": "07d55699-54ee-4c3c-98ee-9b5b99e589d2",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Wegen der Fahrgeschwindigkeit bestehe gegen einen 31-jährigen Mann sowie gegen einen 23 Jahre alten Autofahrer auf der Nebenfahrbahn der Verdacht eines illegalen Rennens, hieß es von der Polizei am Sonntagmorgen.“"
                            },
                            {
                                "example_id": "4056d303-3136-4d68-b77c-3cca33d7daaf",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Über einen Bedienhebel am Holm kann die Fahrgeschwindigkeit stufenlos reguliert werden.“"
                            },
                            {
                                "example_id": "5969cc73-f4fe-428b-9506-2f27980a8582",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Die maximale Steigung ist 25 Prozent, die Fahrzeit beträgt dreieinhalb Minuten, und die durchschnittliche Fahrgeschwindigkeit liegt bei 7,5 km/h, der Höhenunterschied ist 83 Meter.“"
                            },
                            {
                                "example_id": "579d4456-13d3-43bd-95c1-9b6b28e9dead",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Die Fahrgeschwindigkeit beträgt zwölf Meter je Sekunde, zur Stützenüberfahrt wird automatisch auf 7 m/s heruntergebremst.“"
                            },
                            {
                                "example_id": "e43d0b4a-00bc-4764-a904-546f137c36c1",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Achten Sie jedoch auch auf Schilder zu den Fahrgeschwindigkeiten.“"
                            },
                            {
                                "example_id": "f82f857c-b61f-46b3-841f-60c94a145ae8",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Wegen der zu erwartenden höheren Fahrgeschwindigkeiten der Fahrzeuge auf der künftig breit ausgebauten Kreisstraße seien auch Querungshilfen für Fußgänger und Radler dringend geboten, macht BI-Sprecher Huber auf ein erhöhtes Unfallrisiko aufmerksam.“"
                            },
                            {
                                "example_id": "bb5cdbfe-5443-4a59-9aa1-af1db6b9e4e8",
                                "sense_id": "0bf752b1-517d-36ab-8dd7-c0aa362d7d4f",
                                "text": "„Bei Fahrgeschwindigkeiten unter 30 km/h erkennt ein Laser mögliche Hindernisse und verringert mit einer frühzeitig eingeleiteten Notbremsung die Unfallfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
