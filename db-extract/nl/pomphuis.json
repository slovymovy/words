                "senses": [
                    {
                        "sense_id": "75a51c0f-2e25-3c2e-97c9-31ad9cfeb74c",
                        "entry_id": "43488be5-ad69-3e1f-ae22-fca49a7ae7fc",
                        "glosses": [
                            "gebouw waarin een pomp staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cbd2cb-b95d-44a8-9139-27dd1784a61d",
                                "sense_id": "75a51c0f-2e25-3c2e-97c9-31ad9cfeb74c",
                                "text": "Voor de kelder staat een ouder pompgebouw. Hieronder is een berging waarin nog 100.000 liter water is opgeslagen. Bij kelder en pomphuis horen 5,2 hectare bos en dik 2 hectare cultuurgrond: samen 7,5 hectare."
                            },
                            {
                                "example_id": "c4476b73-178f-4a9b-9732-023dd7d7269d",
                                "sense_id": "75a51c0f-2e25-3c2e-97c9-31ad9cfeb74c",
                                "text": "Het pomphuis met gasflessen en diesel op het terrein ontploft. Boiso vindt een vluchtroute over stenen naar beneden. Hij struikelt en valt. Zijn Portugese vriend is aan de andere kant van het terrein en belandt in de vlammenzee. “De vuurstorm raasde er in vijf minuten overheen.” Vrienden houden de gewonde Portugees met natte doeken in leven. “Het duurde vijf uur voordat er een ambulance kon komen, want het hele gebied was afgesloten. Het was een chaos.”"
                            },
                            {
                                "example_id": "ae4ece0c-bdcc-4b2d-aeb9-a5fdfe8b1eb1",
                                "sense_id": "75a51c0f-2e25-3c2e-97c9-31ad9cfeb74c",
                                "text": "De brand ontstond tijdens het verwijderen van petroleumproducten uit een pijpleiding tussen een naftatank en een pomphuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9fa23f8-4077-3ad2-9f70-1a99bfb0d79f",
