                "senses": [
                    {
                        "sense_id": "26f8aea9-7d64-3167-ae9b-f36f054d41a1",
                        "entry_id": "6669c6d4-c1ef-3f55-b7fe-43a9954cba61",
                        "glosses": [
                            "der Nennwert einer Geldmünze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da8ee7c-ae16-4902-aaba-599aa905acd3",
                                "sense_id": "26f8aea9-7d64-3167-ae9b-f36f054d41a1",
                                "text": "„Allein der Wert der Kurantmünze Englands war damals, wie wir von [William] Lowndes erfahren, mehr als 25% unter seinem Münzwerte.“"
                            },
                            {
                                "example_id": "30dbea03-a8ad-48dd-8a40-9fb9c78d20be",
                                "sense_id": "26f8aea9-7d64-3167-ae9b-f36f054d41a1",
                                "text": "„Auf den kleinsten Münzwerten sind ein modernes Tankschiff (5 Cent), eine Korvette (2 Cent) und ein Modell einer Athener Trireme aus den Zeiten Kimons (1 Cent) abgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
