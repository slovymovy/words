                ],
                "senses": [
                    {
                        "sense_id": "7ac1c5e6-7b7c-31c3-a77e-3da8ed033e3a",
                        "entry_id": "65735bea-f6a1-3a59-9b24-b9c243a448e1",
                        "glosses": [
                            "Regeltyp der generativen Grammatik (Chomsky, Aspekte-Modell 1964), der dafür sorgt, dass Ausdrücke, die im Satz wegen ihrer Bedeutung nicht miteinander vorkommen können, ausgeschlossen werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938ae1e9-bb78-422a-b1a6-a1c3b9736642",
                                "sense_id": "7ac1c5e6-7b7c-31c3-a77e-3da8ed033e3a",
                                "text": "Die Selektionsbeschränkung müsste z.B. verhindern, dass ein Satz wie: \"Ein Hase erschießt einen Baum\" zustande kommt, da das Verb erschießen einen Menschen als Subjekt und ein Tier oder einen Menschen als Objekt fordert; beide Bedingungen sind hier verletzt."
                            },
                            {
                                "example_id": "62345cee-b9ff-49a8-b170-4f8a8296d0dc",
                                "sense_id": "7ac1c5e6-7b7c-31c3-a77e-3da8ed033e3a",
                                "text": "„Der Regeltyp, der hier die richtige Umgebung für das Verb garantiert, wird als Selektionsbeschränkung bezeichnet.“"
                            },
                            {
                                "example_id": "f0a45f10-2d44-4139-a3c8-f23656e31ac7",
                                "sense_id": "7ac1c5e6-7b7c-31c3-a77e-3da8ed033e3a",
                                "text": "„Dies sind solche Eigenschaften eines Wortes, die seine syntaktische Kombinierbarkeit mit anderen Wörtern einschränken, sogenannte syntaktische Selektionsbeschränkungen, beispielsweise das grammatische Genus, die Wortklasse und Subkategorisierungseigenschaften, das heißt Angaben zu syntaktisch notwendigen Ergänzungen.“"
                            },
                            {
                                "example_id": "69f6848c-5003-48d6-94f8-c727d7c75dc3",
                                "sense_id": "7ac1c5e6-7b7c-31c3-a77e-3da8ed033e3a",
                                "text": "„Das Merkmal (+ Menge) in der Selektionsbeschränkung bedarf der Erläuterung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
