                "senses": [
                    {
                        "sense_id": "88b6ab4d-7e99-3e50-82f3-2ee88c2bb0a6",
                        "entry_id": "586d1371-2a91-3850-8a1d-ced8326a039b",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным летопись"
                        ],
                        "tags": [],
