                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e109324f-a764-4bba-868f-f27f71c13b15",
                                "sense_id": "bd25f938-245f-3c19-86ef-3d23153df543",
                                "text": "Ook Marc Bessems werkt al geruime tijd bij de NOS. Sinds 2002 werkt hij als buitenlandredacteur en camjo-verslaggever bij NOS Nieuws. Zijn specialisatie is Latijns-Amerika en Spanje. De basis daarvoor vormde zijn studie geschiedenis aan de Rijksuniversiteit Groningen met als specialisatie Spaanse contemporaine geschiedenis."
                            },
                            {
                                "example_id": "71c62089-6b16-4a0b-b1e7-8bd642b34eef",
                                "sense_id": "bd25f938-245f-3c19-86ef-3d23153df543",
                                "text": "De Stan Storimans Prijs is voor het eerst gewonnen door een camerajournalist, een camjo. Jeroen Kelderman van RTV Drenthe won de prijs voor zijn reportage over het werk van de luchtmobiele brigade uit Assen in Kunduz, Afghanistan."
                            },
                            {
                                "example_id": "81247687-61bb-40b3-b60c-f624e648f939",
                                "sense_id": "bd25f938-245f-3c19-86ef-3d23153df543",
                                "text": "Vorig jaar werd de prijs voor het eerst gewonnen door een camjo. Dat is een journalist die zelf filmt en dus zonder cameraman werkt. Jeroen Kelderman van RTV Drenthe kreeg de prijs voor zijn reportage over het werk van de luchtmobiele brigade uit Assen in Afghanistan."
                            }
                        ]
                    }
