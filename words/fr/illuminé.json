    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "48a47194-e557-34e1-b376-b90df73f1f5b",
                    "sense_definition": "Qui est vivement éclairé ou décoré de lumières pour une célébration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eclaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les fêtes de fin d'année toute la ville est magnifiquement <w>illuminée</w>."
                        },
                        {
                            "text": "Nous admirions le vieux monument <w>illuminé</w> qui se dressait au cœur de la capitale."
                        }
                    ],
                    "synonyms": [
                        "éclairé"
                    ],
                    "antonyms": [
                        "sombre",
                        "obscur"
                    ],
                    "common_phrases": [
                        "monument illuminé",
                        "sapin illuminé"
                    ]
                },
                {
                    "sense_id": "a0642a12-0a7a-3a2b-8db1-8cf35c4136f7",
                    "sense_definition": "Qui rayonne d'un sentiment intense de joie ou de bonheur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rayonnant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'est tournée vers nous avec un visage <w>illuminé</w> par la joie."
                        },
                        {
                            "text": "Le petit garçon contemplait ses cadeaux avec un regard <w>illuminé</w> et plein d'émerveillement."
