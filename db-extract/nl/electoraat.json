                ],
                "senses": [
                    {
                        "sense_id": "7358188e-071a-30e7-a346-cc63abf7a2d0",
                        "entry_id": "f276d003-3198-3273-8893-650ec4faf52d",
                        "glosses": [
                            "electorate (totality of voters or those with the right to vote in a polity)"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "e5a819d3-3827-49bf-9454-b73d1132b209",
                                "sense_id": "7358188e-071a-30e7-a346-cc63abf7a2d0",
                                "text": "De politieke partijen richten zich op het winnen van het electoraat voor de komende verkiezingen.",
                                "translation": "The political parties are focused on winning the electorate for the upcoming elections.",
                                "english": "The political parties are focused on winning the electorate for the upcoming elections."
                            },
                            {
                                "example_id": "c32b0d05-b690-4c25-9958-d44fa72c8478",
                                "sense_id": "7358188e-071a-30e7-a346-cc63abf7a2d0",
                                "text": "Het electoraat heeft de mogelijkheid om hun stem uit te brengen en de toekomst van het land te bepalen.",
                                "translation": "The electorate has the opportunity to cast their vote and determine the future of the country.",
                                "english": "The electorate has the opportunity to cast their vote and determine the future of the country."
                            },
                            {
                                "example_id": "319ee8f1-c607-467d-92d7-6772d45cb3c0",
                                "sense_id": "7358188e-071a-30e7-a346-cc63abf7a2d0",
                                "text": "Het is belangrijk voor elke politieke partij om steun te krijgen van het electoraat om aan de macht te komen.",
                                "translation": "It is essential for every political party to gain support from the electorate to come into power.",
                                "english": "It is essential for every political party to gain support from the electorate to come into power."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc1b10e-01dd-338f-86be-74a7e3034cdb",
                        "entry_id": "f276d003-3198-3273-8893-650ec4faf52d",
                        "glosses": [
                            "electorate (electoral base)"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "0f8ad8ab-7dca-4c18-bd90-840b259dfc10",
                                "sense_id": "6bc1b10e-01dd-338f-86be-74a7e3034cdb",
                                "text": "De politicus probeert zijn standpunten af te stemmen op de behoeften van het electoraat om hun steun te winnen.",
                                "translation": "The politician tries to align his positions with the needs of the electorate to win their support.",
                                "english": "The politician tries to align his positions with the needs of the electorate to win their support."
                            },
                            {
                                "example_id": "c32a2741-ae87-4132-be6b-b94842e50fca",
                                "sense_id": "6bc1b10e-01dd-338f-86be-74a7e3034cdb",
                                "text": "De partijleider richtte zich tot het partijcongres en bedankte het electoraat voor hun vertrouwen.",
                                "translation": "The party leader addressed the party congress and thanked the electorate for their trust.",
                                "english": "The party leader addressed the party congress and thanked the electorate for their trust."
                            },
                            {
                                "example_id": "21ff4d1b-75c7-4e93-a490-6bb462966458",
                                "sense_id": "6bc1b10e-01dd-338f-86be-74a7e3034cdb",
                                "text": "De partij voert een campagne om het electoraat te bereiken en hun standpunten over te brengen.",
                                "translation": "The party is campaigning to reach the electorate and convey their positions.",
                                "english": "The party is campaigning to reach the electorate and convey their positions."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fba3cf3-3aad-3ad0-84fc-dcaf86026eb5",
                        "entry_id": "f276d003-3198-3273-8893-650ec4faf52d",
