                        "examples": [
                            {
                                "example_id": "dc310e67-0f13-4884-b05a-f2e7e9804f2c",
                                "sense_id": "68296897-6dc8-3cfb-92a9-0ce486de1720",
                                "text": "Ze kocht een nieuwe bloes voor haar sollicitatiegesprek.",
                                "translation": "She bought a new blouse for her job interview.",
                                "english": "She bought a new blouse for her job interview."
                            },
                            {
                                "example_id": "e7273510-b2be-46a2-81fe-5da8b9392d31",
                                "sense_id": "68296897-6dc8-3cfb-92a9-0ce486de1720",
                                "text": "De bloezen in die winkel zijn van goede kwaliteit.",
                                "translation": "The blouses in that store are of good quality.",
                                "english": "The blouses in that store are of good quality."
                            },
                            {
                                "example_id": "c1859b7c-a741-4002-a892-9ae9f1a8efdc",
                                "sense_id": "68296897-6dc8-3cfb-92a9-0ce486de1720",
                                "text": "Kun je het bloesje met de bloemenprint passen?",
                                "translation": "Can you try on the blouse with the floral print?",
                                "english": "Can you try on the blouse with the floral print?"
