                        "examples": [
                            {
                                "example_id": "bd5c5450-e257-43b8-9272-10d34ddeb097",
                                "sense_id": "3b7bc317-ab2a-3936-8fd4-2d2dd0f64f34",
                                "text": "Я стара́лась идти́ о́чень осторо́жно, так что́бы не провали́ться в сугро́б.",
