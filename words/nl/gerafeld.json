                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "postrzępiony",
                                "target_lang_sense_clarification": "z wystrzępionymi brzegami, niszczejący na krawędziach"
                            },
                            {
                                "target_lang_word": "wystrzępiony",
                                "target_lang_sense_clarification": "z wychodzącymi nitkami"
                            },
                            {
                                "target_lang_word": "poszarpany",
                                "target_lang_sense_clarification": "o nierównych brzegach"
                            }
                        ]
                    }
                }
            ]
        },
        {
