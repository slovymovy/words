                ],
                "senses": [
                    {
                        "sense_id": "07907235-3301-37da-a765-c37cb2b7947d",
                        "entry_id": "c43c2639-61fd-3850-9917-df3a4e064b11",
                        "glosses": [
                            "kobieta wnosząca pozew do sądu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc4c86c1-9a52-4e81-81ac-fad2bb762f29",
                                "sense_id": "07907235-3301-37da-a765-c37cb2b7947d",
                                "text": "Pozwany zeznał, że powódka umyślnie go sprowokowała."
                            },
                            {
                                "example_id": "194679fd-0006-4448-a61c-0e3d9d9b37d9",
                                "sense_id": "07907235-3301-37da-a765-c37cb2b7947d",
                                "text": "Wystudiowany szloch powódki ani przez chwilę nie zwiódł doświadczonej sędziny."
                            },
                            {
                                "example_id": "137d0543-d156-4f4e-94d7-33c649b4df81",
                                "sense_id": "07907235-3301-37da-a765-c37cb2b7947d",
                                "text": "Zeznająca powódka bez zahamowań wypluła z siebie całą frustrację, rozczarowanie i złość."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
