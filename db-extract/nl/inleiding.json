                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71fc799-d957-4d4d-99ff-973696259b51",
                                                "sense_id": "1c674851-dbd7-3693-9e63-5c0d28127a38",
                                                "text": "Das Orchester hat gerade mit der Einleitung des Stücks begonnen."
                                            },
                                            {
                                                "example_id": "6855dc90-5972-4abe-ac6f-4c1698efd6fc",
                                                "sense_id": "1c674851-dbd7-3693-9e63-5c0d28127a38",
                                                "text": "Schon in der Einleitung wird der Leser mit Fachbegriffen konfrontiert."
                                            },
                                            {
                                                "example_id": "95ddfeeb-1f2e-4f0f-8787-3853cf7e640d",
                                                "sense_id": "1c674851-dbd7-3693-9e63-5c0d28127a38",
                                                "text": "„Es ist jener Text, mit dem die Einleitung zu dieser Biographie beginnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4d02511-47ed-3c48-9494-9ac0e12d9cd8",
                                        "entry_id": "973a7667-84e5-33fe-ab16-1006d39c2fb7",
                                        "glosses": [
