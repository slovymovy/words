                    "sense_definition": "De gebiedende wijs van <w>chagrijnen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Chagrijn</w> toch niet zo de hele dag!",
                            "target_lang_translations": {
                                "en": "Don't <w>be so grumpy</w> all day long!",
                                "de": "<w>Schmoll</w> doch nicht den ganzen Tag so!"
                            }
                        },
                        {
                            "text": "Kom op, wees vrolijk en <w>chagrijn</w> niet zo!",
                            "target_lang_translations": {
                                "en": "Come on, be cheerful and don't <w>fret</w> so much!",
                                "de": "Komm schon, sei fröhlich und <w>sei</w> nicht so <w>mürrisch</w>!"
                            }
                        }
