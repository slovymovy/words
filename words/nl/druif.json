        "wijndruif"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "094fb640-83a1-36a6-9c6a-316a8e7b401a",
                    "sense_definition": "De kleine, ronde of ovale vrucht van een wijnstok die vaak in trossen groeit en gegeten wordt of gebruikt wordt om wijn te maken.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet elke ochtend een tros <w>druiven</w> bij mijn ontbijt.",
                            "target_lang_translations": {
                                "en": "I eat a bunch of <w>grapes</w> with my breakfast every morning."
                            }
                        },
                        {
                            "text": "Deze <w>druif</w> is erg zoet en heeft geen pitjes.",
                            "target_lang_translations": {
                                "en": "This <w>grape</w> is very sweet and has no seeds."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tros druiven",
                        "zoete druif",
                        "blauwe druif",
                        "witte druif"
                    ],
                    "target_lang_definitions": {
                        "en": "The small, round or oval fruit of a grapevine that often grows in clusters and is eaten or used to make wine."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grape",
                                "target_lang_sense_clarification": "the edible fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76836999-2022-3a7b-b696-5c7d86dec9f3",
                    "sense_definition": "De plantensoort Vitis vinifera die de vruchten voortbrengt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze regio wordt de <w>druif</w> al eeuwenlang verbouwd voor de wijnproductie.",
                            "target_lang_translations": {
                                "en": "In this region, the <w>grape</w> has been cultivated for wine production for centuries."
                            }
                        },
                        {
                            "text": "De <w>wijnstok</w> is een ander woord voor de plant die we de <w>druif</w> noemen.",
                            "target_lang_translations": {
                                "en": "The <w>grapevine</w> is another word for the plant we call the <w>grape</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wijnstok"
                    ],
                    "common_phrases": [
                        "wilde druif"
                    ],
                    "target_lang_definitions": {
                        "en": "The plant species Vitis vinifera that produces the fruit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grapevine",
                                "target_lang_sense_clarification": "the plant itself"
                            },
                            {
                                "target_lang_word": "vine",
                                "target_lang_sense_clarification": "the plant itself"
                            },
                            {
                                "target_lang_word": "grape",
                                "target_lang_sense_clarification": "referring to the plant type"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c32a5cb1-875e-3e72-bb99-3be0b0195662",
                    "sense_definition": "Een persoon die zich een beetje dom, suf of verward gedraagt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tsjonge, wat ben jij een <w>druif</w> zeg!",
                            "target_lang_translations": {
                                "en": "Boy, you really are a <w>silly person</w>!"
                            }
                        },
                        {
                            "text": "Hij vergat zijn sleutels weer, het is ook zo'n <w>druif</w>.",
                            "target_lang_translations": {
                                "en": "He forgot his keys again, he's such a <w>goofball</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik om iemand vriendelijk te bespotten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who behaves in a slightly silly, dull, or confused manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silly person",
                                "target_lang_sense_clarification": "informal, mild mockery"
                            },
                            {
                                "target_lang_word": "goofball",
                                "target_lang_sense_clarification": "informal, playful"
                            },
                            {
                                "target_lang_word": "dope",
                                "target_lang_sense_clarification": "informal, slightly insulting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf1cbe84-14ed-313d-b250-0ddfc641691f",
                    "sense_definition": "Een type munitie bestaande uit meerdere kleine ballen die tegelijkertijd uit een kanon worden afgevuurd.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "munitie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip werd bestookt met een <w>druif</w> om de bemanning uit te schakelen.",
                            "target_lang_translations": {
                                "en": "The ship was bombarded with <w>grapeshot</w> to disable the crew."
                            }
                        },
                        {
                            "text": "In het museum liggen oude kanonskogels en een zeldzame <w>druif</w>.",
                            "target_lang_translations": {
                                "en": "The museum contains old cannonballs and a rare piece of <w>grapeshot</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "voornamelijk historisch militair gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A type of ammunition consisting of several small balls fired simultaneously from a cannon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grapeshot",
                                "target_lang_sense_clarification": "historical military ammunition"
                            },
                            {
                                "target_lang_word": "grape",
                                "target_lang_sense_clarification": "clipping of grapeshot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2611149d-9ab3-360c-b126-c3d3e6e74156",
                    "sense_definition": "De ronde knop aan de achterzijde van een kanon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kanon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De artillerist hield de <w>druif</w> vast om het kanon te richten.",
                            "target_lang_translations": {
                                "en": "The artilleryman held the <w>cascable</w> to aim the cannon."
                            }
                        },
                        {
                            "text": "De <w>druif</w> van dit antieke kanon is versierd met een reliëf.",
                            "target_lang_translations": {
                                "en": "The <w>button</w> of this antique cannon is decorated with a relief."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specifieke term uit de historische artillerie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The round knob at the rear of a cannon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cascable",
                                "target_lang_sense_clarification": "the knob at the end of a cannon"
                            },
                            {
                                "target_lang_word": "button",
                                "target_lang_sense_clarification": "the knob at the end of a cannon"
                            }
                        ]
                    }
                }
            ]
        }
    ]
