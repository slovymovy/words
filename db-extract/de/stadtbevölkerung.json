                ],
                "senses": [
                    {
                        "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                        "entry_id": "f1b639ce-f4e4-39fa-924a-92534685ace9",
                        "glosses": [
                            "Personen, die in einer Stadt wohnen; eine Stadt bevölkern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6b17ee-4fbd-43a6-8cda-3efcbfb8a53f",
                                "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                                "text": "Heutzutage gibt es mehr Stadtbevölkerung als zum Beispiel noch vor 100 Jahren."
                            },
                            {
                                "example_id": "73cb76d4-2772-42ac-bfb4-a9490bb6d720",
                                "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                                "text": "„Im Gegensatz zu den Bewohnern von ländlichen Siedlungen ist die Mehrheit der Stadtbevölkerung nicht in der Landwirtschaft, sondern im produzierenden Gewerbe und im Dienstleistungsbereich beschäftigt.“"
                            },
                            {
                                "example_id": "43977990-6792-440e-abb1-947cbe7cfdf1",
                                "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                                "text": "„Um wenigstens massenhaftes Verhungern der Stadtbevölkerung zu verhindern, wurden immer mehr öffentliche Küchen eingerichtet.“"
                            },
                            {
                                "example_id": "d93709b2-e25f-412d-b884-f6441defe03b",
                                "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                                "text": "„Die Stadt versorgt die Rinderfarmen, die Wildfarmen und die kleine Stadtbevölkerung.“"
                            },
                            {
                                "example_id": "fb24b89b-0c8c-4c56-9594-5df037a68787",
                                "sense_id": "2ba7a3f3-f1d0-3c31-8218-fde023a734c5",
                                "text": "„Die Initiative war von der Stadtbevölkerung in Tripolis ausgegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
