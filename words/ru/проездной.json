            "senses": [
                {
                    "sense_id": "6b4bbf47-dbb4-36f3-b9bc-dab6e7a76881",
                    "sense_definition": "предназначенный для проезда в общественном транспорте",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пассажир купил <w>проездной</w> билет на месяц.",
                            "target_lang_translations": {
                                "en": "The passenger bought a monthly <w>travel pass</w>."
                            }
                        },
                        {
                            "text": "Нужно приложить <w>проездной</w> к валидатору при входе в автобус.",
                            "target_lang_translations": {
                                "en": "You need to tap your <w>transit pass</w> on the validator when boarding the bus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "проездной билет"
                    ],
                    "target_lang_definitions": {
                        "en": "A ticket or pass intended for travel on public transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "travel pass",
                                "target_lang_sense_clarification": "A general term for a pass used for public transport."
                            },
                            {
                                "target_lang_word": "transit pass",
                                "target_lang_sense_clarification": "Common in North American English for public transport tickets."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fb949df-8967-3968-ac3a-e7777db3ba23",
                    "sense_definition": "документ для многократного проезда в общественном транспорте",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я забыл свой <w>проездной</w> дома и пришлось платить за билет.",
                            "target_lang_translations": {
                                "en": "I forgot my <w>travel pass</w> at home and had to pay for a ticket."
                            }
                        },
                        {
                            "text": "Студенческий <w>проездной</w> стоит значительно дешевле обычного.",
                            "target_lang_translations": {
                                "en": "A student <w>transit pass</w> costs significantly less than a regular one."
                            }
                        }
                    ],
                    "synonyms": [
                        "карточка"
                    ],
                    "target_lang_definitions": {
                        "en": "A document or card allowing multiple trips on public transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monthly pass",
                                "target_lang_sense_clarification": "Specifically referring to a pass valid for a set period."
                            },
                            {
                                "target_lang_word": "commuter pass",
                                "target_lang_sense_clarification": "A pass used by people who travel regularly to work or school."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66748f72-9017-384c-a54c-540eb2a8775b",
                    "sense_definition": "относящийся к проезду или предназначенный для него",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был специальный <w>проездной</w> документ для иностранных делегаций.",
                            "target_lang_translations": {
                                "en": "It was a special <w>travel</w> document for foreign delegations."
                            }
                        },
                        {
                            "text": "Нам выдали <w>проездной</w> талон на весь маршрут следования.",
                            "target_lang_translations": {
