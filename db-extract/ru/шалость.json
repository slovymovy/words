                "translations": [
                    {
                        "translation_id": "3109cbba-36c4-47f3-94dd-3151ba3ace21",
                        "source_entry_id": "abe9aaf8-acef-343c-983c-f7b7d416b98f",
                        "target_lang_word": "mischief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mischief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d7d651-5fbc-3dcd-b5a1-4318a92271db",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "Conduct that playfully causes petty annoyance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e5470b-c34f-487e-b367-6e9102dd04dc",
                                                "sense_id": "d4d7d651-5fbc-3dcd-b5a1-4318a92271db",
                                                "text": "Drink led to mischief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816b2a5d-50d3-3916-86da-9c648f9a0c39",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "A playfully annoying action."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684a6908-b467-429c-9030-733c80e227b3",
                                                "sense_id": "816b2a5d-50d3-3916-86da-9c648f9a0c39",
                                                "text": "John's mischief, tying his shoelaces together, irked George at first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01eeb273-15ad-345e-8f8c-95946664d490",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "A group or a pack of rats."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86b12426-7ed8-4460-8723-98776e24f4e7",
                                                "sense_id": "01eeb273-15ad-345e-8f8c-95946664d490",
                                                "text": "Kirac, the leader of the rats under his charge, speaks to the major through his telepathic abilities that manifested after the alien virus infected him and his mischief of rats."
                                            },
                                            {
                                                "example_id": "9ff6fb21-bcc9-49e2-b975-fb24926ee206",
                                                "sense_id": "01eeb273-15ad-345e-8f8c-95946664d490",
                                                "text": "A group of rats is not a herd or a gaggle, but a pack or a mischief of rats. Rats in general are omnivorous, meaning they will eat almost anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "Harm or injury:",
                                            "Harm or trouble caused by an agent or brought about by a particular cause."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5807e001-013e-4d44-a062-ac6dc322c355",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "She had mischief in her heart."
                                            },
                                            {
                                                "example_id": "69a4573c-5703-4334-8239-810bc4d89daa",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "Sooner or later he'll succeed in doing some serious mischief."
                                            },
                                            {
                                                "example_id": "899cc8db-4d46-462b-aaac-81cb2fb6489d",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "Was I the Cauſe of Miſchief, or the Man / Whoſe lawlesſ Luſt the bloody War began?"
                                            },
                                            {
                                                "example_id": "17bd9713-1fb1-4b59-bcc4-553a07c8f0b3",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "I have been tired in history with the perpetual folly of those states, who call in foreigners to assist them against a common enemy: but the mischief was, these allies would never be brought to allow, that the common enemy was quite subdued. And they had reason; for it proved at last, that one part of the common enemy was those who called them in, and so the allies became at length the masters."
                                            },
                                            {
                                                "example_id": "4c13041d-b38e-4f72-8913-32aa5b47d603",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "Vanity working on a weak head, produces every sort of mischief."
                                            },
                                            {
                                                "example_id": "26c295aa-56d9-4be9-8a79-60133eb313c8",
                                                "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                                                "text": "I fear this means that there is some mischief afoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a55714-6a09-3fbf-b783-11f0c5ac140d",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "Harm or injury:",
                                            "An injury or an instance of harm or trouble caused by a person or other agent or cause."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bbd0632-e02e-4e5b-8520-09d0c2f95fb9",
                                                "sense_id": "55a55714-6a09-3fbf-b783-11f0c5ac140d",
                                                "text": "It may end in her doing a great mischief to herself—and perhaps to others too."
                                            },
                                            {
                                                "example_id": "75084e28-644e-4d58-b039-de1653a4e746",
                                                "sense_id": "55a55714-6a09-3fbf-b783-11f0c5ac140d",
                                                "text": "[R]eligion / Hides many mischiefs from suspicion."
                                            },
                                            {
                                                "example_id": "b0a63648-fb57-48b2-a43e-4455ef50f1d3",
                                                "sense_id": "55a55714-6a09-3fbf-b783-11f0c5ac140d",
                                                "text": "I will heape mischiefes vpon them, I will spend mine arrowes vpon them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc937e91-62ed-3801-9042-9fb8e1dee875",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "A criminal offence defined in various ways in various jurisdictions, sometimes including causing damage to another's property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c9fcea9-4fa6-3075-bb4c-a53d86cdb831",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "A cause or agent of annoyance, harm or injury, especially a person who causes mischief."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e20c819-4ba0-485f-88d6-5808df161944",
                                                "sense_id": "1c9fcea9-4fa6-3075-bb4c-a53d86cdb831",
                                                "text": "To die like a man of honour, Sir Hargrave, you must have lived like one. You should be sure of your cause. But these pistols are too ready a mischief. Were I to meet you in your own way, Sir Hargrave, I should not expect, that a man so enraged would fire his over my head, as I should be willing to do mine over his. Life I would not put upon the perhaps involuntary twitch of a finger."
                                            },
                                            {
                                                "example_id": "ca7316e0-88c6-4fbd-9a6a-c7bcfa4d60a7",
                                                "sense_id": "1c9fcea9-4fa6-3075-bb4c-a53d86cdb831",
                                                "text": "Epimetheus was scatter-brained and a mischief to men for having taken the woman [Pandora] that Zeus had formed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432ce3d5-5c5d-3b80-a460-45a07cc7c24e",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "The Devil; used as an expletive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "725699a4-b5aa-423b-955f-0ad68fc31d54",
                                                "sense_id": "432ce3d5-5c5d-3b80-a460-45a07cc7c24e",
                                                "text": "What the mischief are you? and how the mischief did you get here, and where in thunder did you come from?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d342eb-2324-3c13-9508-5002ed702dc1",
                                        "entry_id": "438b2134-921c-376e-86d3-8db48e32569b",
                                        "glosses": [
                                            "Casual and/or flirtatious sexual acts."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mischief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a94cce2-ec82-3da1-9edf-a8f97d2286e7",
                                        "entry_id": "69924b72-3e71-3242-aa26-69214fe58027",
                                        "glosses": [
                                            "To do a mischief to; to harm."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae6b68f-93b3-4868-931d-945e4000904b",
                                                "sense_id": "0a94cce2-ec82-3da1-9edf-a8f97d2286e7",
                                                "text": "\"Not now, Smee,\" Hook said darkly. \"He is only one, and I want to mischief all the seven. Scatter and look for them.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf528947-baf3-3e2f-898d-77b023dc7265",
                                        "entry_id": "69924b72-3e71-3242-aa26-69214fe58027",
                                        "glosses": [
                                            "To slander."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bbb23b5-3b2a-4391-90db-7ff0e01e3ee5",
                                                "sense_id": "cf528947-baf3-3e2f-898d-77b023dc7265",
                                                "text": "And so it hath been divers times; Men mischiefing the Jews to excuse their own Wickedness: as to instance one Precedent in the time of a certain King of Portugal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d8b58a7-5610-46f3-8c1d-d2b5e0ee7cf5",
                        "source_entry_id": "abe9aaf8-acef-343c-983c-f7b7d416b98f",
                        "target_lang_word": "espièglerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espièglerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a732a10-511a-3157-8658-f003bb832f8f",
                                        "entry_id": "281fb0ba-de0c-358b-9271-ddd65b3f0441",
                                        "glosses": [
                                            "Petite malice, facétie que fait un enfant espiègle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54e44d6-a6fc-4724-99bf-3c7522101233",
                                                "sense_id": "6a732a10-511a-3157-8658-f003bb832f8f",
                                                "text": "Je vis une petite fille d'environ quatorze ans qui jouait au volant avec une de ses camarades, et dont les rires et les espiègleries amusaient les voisins."
                                            },
                                            {
                                                "example_id": "d1d438dc-e497-488b-ab7a-9007071f0c5d",
                                                "sense_id": "6a732a10-511a-3157-8658-f003bb832f8f",
                                                "text": "Ahmed Abdou souffrait en silence de ces espiègleries. Il était jaloux de ces jeux auxquels il n’avait point part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "882fd680-693c-322d-91d6-56c4f55db48d",
                                        "entry_id": "281fb0ba-de0c-358b-9271-ddd65b3f0441",
                                        "glosses": [
                                            "Caractère espiègle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9797e853-b1e0-4610-8fc6-c8cadfe42939",
                                                "sense_id": "882fd680-693c-322d-91d6-56c4f55db48d",
                                                "text": "Avec Ceci est mon corps, Agathe Charnet explore la question des violences sexistes et sexuelles, mais aussi les questionnements d’une trentenaire, ses désirs et ses joies, avec humour et espièglerie."
                                            },
                                            {
                                                "example_id": "b2a5b91a-5acd-4461-b545-dd89f5b62823",
                                                "sense_id": "882fd680-693c-322d-91d6-56c4f55db48d",
                                                "text": "Mais, naturellement, il a réagi en enfant, et l’homme mûr ne gardera de telle minute décisive, solennelle, que le souvenir d’un drame enfantin, d’une apparente espièglerie dont le véritable sens lui échappera, et dont il parlera jusqu’à la fin avec ce sourire attendri, trop luisant, presque lubrique, des vieux…"
                                            },
                                            {
                                                "example_id": "d7d21886-8ad3-4a22-b48a-f1cc67e1c713",
                                                "sense_id": "882fd680-693c-322d-91d6-56c4f55db48d",
                                                "text": "Simulait-elle l’espièglerie, la naïveté pour mieux le captiver, le capturer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3230e52-c0ba-42a7-b7c4-0fb25ce1a191",
                        "source_entry_id": "abe9aaf8-acef-343c-983c-f7b7d416b98f",
                        "target_lang_word": "gaminerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaminerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "676997af-1e8e-3b8f-8171-029eeadda8d6",
                                        "entry_id": "fa090d51-5407-3cff-92ba-bf11aca8aeb6",
                                        "glosses": [
                                            "Action ou parole de gamin, d’enfant espiègle ou mal élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddb1243-d95e-4fdd-8102-a3b95604180a",
                                                "sense_id": "676997af-1e8e-3b8f-8171-029eeadda8d6",
                                                "text": "Soyez indulgent, ce n’est qu’une gaminerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2deec5dd-c146-38ac-8aac-e89a5b063699",
                                        "entry_id": "fa090d51-5407-3cff-92ba-bf11aca8aeb6",
                                        "glosses": [
                                            "Comportement de gamin chez un adulte."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9543edfe-47c3-4c2d-a390-1f8b6e01256f",
                                                "sense_id": "2deec5dd-c146-38ac-8aac-e89a5b063699",
                                                "text": "Ses vingt-cinq ans, à vrai dire, avaient épargné sa gaminerie naturelle. Il avait gardé, du bébé, le bon rire, la mobilité d'esprit hannetonnière, l'oubli facile des petits embêtements de la vie."
                                            },
                                            {
                                                "example_id": "eaefc75f-256b-4016-8714-b814e0e11d62",
                                                "sense_id": "2deec5dd-c146-38ac-8aac-e89a5b063699",
                                                "text": "Lupin plaisantait toujours, et Isidore ne se lassait pas de le regarder et de l’entendre, émerveillé par la verve de cet homme, sa gaieté, sa gaminerie, son insouciance ironique, sa joie de vivre."
                                            },
                                            {
                                                "example_id": "ccdcdedf-ef4e-480b-90a7-10cacff11d88",
                                                "sense_id": "2deec5dd-c146-38ac-8aac-e89a5b063699",
                                                "text": "Il la coquait sans arrêt comme s'il avait hâte de rattraper des années d’abstinence forcée et elle s'amusait plus de ce qu'elle tenait pour des gamineries de bougre trop savant, qu'elle ne jouissait vraiment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b415f3f5-9e86-4d80-8cf5-e5e1618a26f5",
                        "source_entry_id": "abe9aaf8-acef-343c-983c-f7b7d416b98f",
                        "target_lang_word": "frasque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frasque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                        "entry_id": "9eb10fa6-df48-3a3d-9da8-8a9accee6174",
                                        "glosses": [
                                            "Action extravagante, imprévue, soudain écart de conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba87c076-1621-49bf-a906-fb5126150b7d",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "On se pardonne, lui dirent-ils, ces petites frasques entre parents, sans quoi il faudrait passer sa vie dans d’éternelles querelles."
                                            },
                                            {
                                                "example_id": "f37330e6-ab7a-44ff-82e6-8acbb35744a4",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "Cette simple réflexion vous expliquera pourquoi il me fut impossible d’aimer longtemps la Checchina, et comment il me fut impossible aussi de ne pas l’estimer toujours, en dépit de ses frasques insolentes et de son ambition démesurée."
                                            },
                                            {
                                                "example_id": "272d61a7-9341-48b5-8d67-c0e9518d3267",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "Après une frasque plus exorbitante que les précédentes —et Dieu sait si parmi les précédentes il s’en trouvait d’un joli calibre !— le jeune vicomte Guy de La Hurlotte fut invité par son père à contracter un engagement de cinq ans dans l’infanterie française."
                                            },
                                            {
                                                "example_id": "8323e510-aaf6-4752-9891-fafddddb0b30",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "Puis il trouva une raison pour s’excuser : après tout, ces frasques étaient permises aux garçons de son âge et il serait bien sot de ne pas profiter de l’aubaine."
                                            },
                                            {
                                                "example_id": "0dfd4cfd-443c-4398-8bbe-87822db97459",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "Ses frasques l’avaient mis au pilori de l’opinion publique."
                                            },
                                            {
                                                "example_id": "2f9e6bce-4343-440d-a75e-aeaaaf8cf2eb",
                                                "sense_id": "27d43a87-46d5-304c-ac3d-a595941cc464",
                                                "text": "Il doit convaincre qu’au-delà de ses frasques des menaces judiciaires qui pèsent sur lui, des dysfonctionnements de son administration, il a su installer une croissance solide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
