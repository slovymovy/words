                            {
                                "example_id": "a5e6c278-0a20-49aa-b275-1ad152d7db2b",
                                "sense_id": "308eed7f-65be-303a-98ee-0708405115f7",
                                "text": "Les eaux de Pougues sont claires & limpides, elles bouillonnent & pétillent à leur source, elles laissent déposer une terre ocreuse très-fine […]"
                            }
                        ]
                    },
                    {
