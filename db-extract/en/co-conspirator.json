                                        "examples": [
                                            {
                                                "example_id": "67335493-30b7-42b4-a9a8-70175edf1fac",
                                                "sense_id": "1938c8fb-80be-381f-a10a-cd830f59b964",
                                                "text": "„Seine beiden Mitverschwörer nickten, und Hoffman fuhr fort.“"
                                            },
                                            {
                                                "example_id": "e2b8847e-a93c-4db7-8791-93096b19d013",
                                                "sense_id": "1938c8fb-80be-381f-a10a-cd830f59b964",
                                                "text": "„Die Mörder Cäsars und ihre Mitverschwörer sind frei dank einem von Marcus Antonius abgesegneten Senatserlass.“"
                                            },
                                            {
                                                "example_id": "38e0bcf0-2666-4d53-a4ce-e012dd860d5b",
                                                "sense_id": "1938c8fb-80be-381f-a10a-cd830f59b964",
                                                "text": "„Der Richter des Hohen Gerichts fragte Don Martín nach den Namen von Mitverschwörern beim Komplott gegen Seine Majestät den König.“"
                                            },
                                            {
                                                "example_id": "b05a9e28-c1ed-4cc7-b418-1dac831c2ac6",
                                                "sense_id": "1938c8fb-80be-381f-a10a-cd830f59b964",
                                                "text": "„Jede Abwesenheit Ribbentrops nutzte von Lehndorff, um Mitverschwörer wie Henning von Tresckow und Helmuth James Graf von Moltke zu empfangen, mit denen er auf Kutschfahrten und Spaziergängen den Anschlag auf den Diktator und den Sturz des Regimes plante.“"
                                            }
