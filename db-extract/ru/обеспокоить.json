                                "target_senses": [
                                    {
                                        "sense_id": "32af62e4-9f1c-3c53-9dee-fd8e18d34be2",
                                        "entry_id": "6d8175e1-d4f7-3bb3-bb4d-e3d369cacc4f",
                                        "glosses": [
                                            "to confuse a quiet, constant state or a calm, continuous flow, in particular: thoughts, actions or liquids."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7dcb52b-dba7-4e21-ae39-3b80b62cb9d6",
                                                "sense_id": "32af62e4-9f1c-3c53-9dee-fd8e18d34be2",
                                                "text": "The noisy ventilation disturbed me during the exam."
                                            },
                                            {
                                                "example_id": "f85d2cdf-7952-4623-bc36-3ceafad48733",
                                                "sense_id": "32af62e4-9f1c-3c53-9dee-fd8e18d34be2",
                                                "text": "The performance was disturbed twice by a ringing mobile phone."
                                            },
                                            {
                                                "example_id": "25cea875-1f4f-4b92-9c84-30147422ab9d",
                                                "sense_id": "32af62e4-9f1c-3c53-9dee-fd8e18d34be2",
                                                "text": "A school of fish disturbed the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27e7897-abfb-3fb7-9571-397058b7134c",
                                        "entry_id": "6d8175e1-d4f7-3bb3-bb4d-e3d369cacc4f",
                                        "glosses": [
                                            "to divert, redirect, or alter by disturbing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8654b29e-7ec0-4457-aa79-9a53953142a5",
                                                "sense_id": "e27e7897-abfb-3fb7-9571-397058b7134c",
                                                "text": "A mudslide disturbed the course of the river."
                                            },
                                            {
                                                "example_id": "62a37dff-402c-43c3-8d70-d1661d0665ea",
                                                "sense_id": "e27e7897-abfb-3fb7-9571-397058b7134c",
                                                "text": "The trauma disturbed his mind."
                                            },
                                            {
                                                "example_id": "d9be247e-1523-4f88-8017-1fb60901d4c8",
                                                "sense_id": "e27e7897-abfb-3fb7-9571-397058b7134c",
                                                "text": "disturb his inmost counsels from their destined aim"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe65aad4-9341-3e75-9cbd-378c5c1df669",
                                        "entry_id": "6d8175e1-d4f7-3bb3-bb4d-e3d369cacc4f",
                                        "glosses": [
                                            "to have a negative emotional impact; to cause emotional distress or confusion."
                                        ],
                                        "tags": [
