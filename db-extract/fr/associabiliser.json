                "senses": [
                    {
                        "sense_id": "d6436f3f-172a-395f-a5b6-87891081c9bf",
                        "entry_id": "cf06b9f8-ef76-3540-939a-991d96923224",
                        "glosses": [
                            "Asocialiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a9faba2-83ce-48d0-b32c-de064cdae64d",
                                "sense_id": "d6436f3f-172a-395f-a5b6-87891081c9bf",
                                "text": "Je ne pense pas que Yan fasse exprès d'associabiliser Shou, et de l'écarter de ses amis."
                            },
                            {
                                "example_id": "c2edfc9a-597b-4f7a-ae37-f23ce55319ae",
                                "sense_id": "d6436f3f-172a-395f-a5b6-87891081c9bf",
                                "text": "Le bijou est donc devenu thérapeutique dans la pratique et également un moyen de ne pas s'associabiliser totalement."
                            },
                            {
                                "example_id": "1cc4a3cd-a57e-4c27-98fd-069e7f71a485",
                                "sense_id": "d6436f3f-172a-395f-a5b6-87891081c9bf",
                                "text": "Laissez-moi donc m'associabiliser plus que je ne le suis déjà tranquillement, parbleu!"
                            }
                        ]
                    }
                ],
