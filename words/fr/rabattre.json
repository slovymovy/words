{
    "word_family": [
        "rabat",
        "rabattement",
        "rabatteur",
        "rabatteuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfaec658-9575-3d65-8b84-92fc8b506032",
                    "sense_definition": "Rabaisser quelque chose ou replier un élément vers le bas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique_mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a pensé à <w>rabattre</w> le couvercle de la boîte avant de la ranger."
                        },
                        {
                            "text": "En sortant sous la pluie, elle préfère <w>rabattre</w> sa capuche sur son visage."
                        }
                    ],
                    "synonyms": [
                        "abaisser",
                        "replier"
                    ],
                    "antonyms": [
                        "redresser",
                        "relever"
                    ],
                    "common_phrases": [
                        "rabattre le couvercle",
                        "rabattre son col"
                    ]
                },
                {
                    "sense_id": "3b4e18dd-0bd1-3014-bca3-0b98d3c8597b",
                    "sense_definition": "Se replacer sur une autre voie de circulation, notamment après un dépassement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement_circulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir dépassé le camion, n'oublie pas de te <w>rabattre</w> à droite avec précaution."
                        },
                        {
                            "text": "La voiture a failli causer un accident en se <w>rabattant</w> trop brusquement devant nous."
                        }
                    ],
                    "synonyms": [
                        "se ranger"
                    ],
                    "antonyms": [
                        "déboîter"
                    ],
                    "common_phrases": [
                        "se rabattre à droite"
                    ]
                },
                {
                    "sense_id": "10328c52-5d90-3015-8056-92bafe1d26dd",
                    "sense_definition": "Se résigner à un choix par défaut ou se contenter d'une solution de substitution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choix_repli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme le restaurant était complet, nous avons dû nous <w>rabattre</w> sur une simple pizzeria."
                        },
                        {
                            "text": "Faute de train direct ce matin, elle se <w>rabat</w> sur un trajet en autocar."
                        }
                    ],
                    "synonyms": [
                        "se replier"
                    ],
                    "common_phrases": [
                        "se rabattre sur"
                    ]
                },
                {
                    "sense_id": "3327e956-9d31-3586-90ae-b5b7cc80d406",
                    "sense_definition": "Diminuer ses exigences, son orgueil ou réduire une somme demandée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution_orgueil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux critiques du groupe, il a enfin accepté d'en <w>rabattre</w> un peu sur ses prétentions."
                        },
                        {
                            "text": "Le vendeur a refusé de <w>rabattre</w> son prix malgré nos demandes répétées."
                        }
                    ],
                    "synonyms": [
                        "diminuer",
                        "réduire"
                    ],
                    "antonyms": [
                        "augmenter",
                        "hausser"
                    ],
                    "common_phrases": [
                        "en rabattre"
                    ]
                },
                {
                    "sense_id": "321499bd-82d2-3ccf-8395-cb3bb7e5f6b9",
                    "sense_definition": "Pousser le gibier vers les chasseurs ou vers des filets en faisant du bruit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chiens et les pisteurs avancent dans le bois pour <w>rabattre</w> le gibier vers les tireurs."
                        },
                        {
                            "text": "Dès l'aube, toute l'équipe tente de <w>rabattre</w> les sangliers vers la lisière de la forêt."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "traquer"
                    ],
                    "common_phrases": [
                        "rabattre le gibier"
                    ]
                },
                {
                    "sense_id": "e913633f-d164-3274-93fe-dccab39821ad",
                    "sense_definition": "Tailler sévèrement des végétaux pour limiter leur hauteur ou stimuler leur repousse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jardinage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier conseille de <w>rabattre</w> une haie à la fin de l'hiver pour favoriser sa repousse."
                        },
                        {
                            "text": "Avant les premières gelées, il faut <w>rabattre</w> les tiges des rosiers afin de fortifier les racines."
                        }
                    ],
                    "synonyms": [
                        "élaguer",
                        "tailler"
                    ],
                    "common_phrases": [
                        "rabattre une haie"
                    ]
                }
            ]
        }
    ]
}