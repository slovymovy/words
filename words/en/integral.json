    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "72b779ba-24d5-39a0-b880-bdc7f27b60b6",
                    "sense_definition": "Constituting a whole together with other parts or factors; necessary for completeness and not removable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "essential_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trust is an <w>integral</w> part of any successful relationship.",
                            "target_lang_translations": {
                                "ru": "Доверие — это <w>неотъемлемая</w> часть любых успешных отношений.",
                                "zh": "信任是任何成功关系中<w>不可或缺</w>的一部分。"
                            }
                        },
                        {
                            "text": "Vegetables play an <w>integral</w> role in a balanced and healthy diet.",
                            "target_lang_translations": {
                                "ru": "Овощи играют <w>существенную</w> роль в сбалансированном и здоровом питании.",
                                "zh": "蔬菜在均衡健康的饮食中起着<w>必不可少</w>的作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "essential",
                        "necessary",
                        "inherent",
                        "intrinsic",
                        "built-in"
                    ],
                    "common_phrases": [
                        "integral part",
                        "integral role",
                        "integral component"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составляющий единое целое с другими частями; необходимый для полноты и неразрывный с чем-либо.",
                        "zh": "构成整体所必需的；不可或缺的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неотъемлемый",
                                "target_lang_sense_clarification": "не подлежащий изъятию, обязательный"
                            },
                            {
                                "target_lang_word": "существенный",
                                "target_lang_sense_clarification": "важный, значительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可或缺",
                                "target_lang_sense_clarification": "形容非常重要，不能缺少"
                            },
                            {
                                "target_lang_word": "必不可少",
                                "target_lang_sense_clarification": "形容非常重要，不能缺少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "612117be-ff5f-370d-ad2e-463cbbd81e2a",
                    "sense_definition": "Relating to or being an integer (a whole number).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician looked for an <w>integral</w> solution to the complex equation.",
                            "target_lang_translations": {
                                "ru": "Математик искал <w>целочисленное</w> решение сложного уравнения.",
                                "zh": "数学家正在为这个复杂的方程寻找<w>整数</w>解。"
                            }
                        },
                        {
                            "text": "This function is defined only for <w>integral</w> values of x.",
                            "target_lang_translations": {
                                "ru": "Эта функция определена только для <w>целочисленных</w> значений x.",
                                "zh": "该函数仅在 x 为<w>整数</w>时有定义。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к целым числам; состоящий из целых единиц.",
                        "zh": "与整数相关的或属于整数的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целочисленный",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "о числах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整数",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5406619f-b485-3330-aa9d-705d964ea094",
                    "sense_definition": "A fundamental concept in calculus used to calculate areas, volumes, and other quantities resulting from the accumulation of infinitesimal changes.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calculus_operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We calculated the <w>integral</w> of the function to find the area under the curve.",
                            "target_lang_translations": {
                                "ru": "Мы вычислили <w>интеграл</w> функции, чтобы найти площадь под кривой.",
                                "zh": "我们计算了该函数的<w>积分</w>以求出曲线下的面积。"
                            }
                        },
                        {
                            "text": "Solving a definite <w>integral</w> results in a specific numerical value.",
                            "target_lang_translations": {
                                "ru": "Вычисление определенного <w>интеграла</w> дает конкретное числовое значение.",
                                "zh": "求解定<w>积分</w>会得到一个具体的数值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antiderivative",
                        "indefinite integral"
                    ],
                    "antonyms": [
                        "derivative"
                    ],
                    "common_phrases": [
                        "definite integral",
                        "calculate the integral",
                        "line integral"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальное понятие математического анализа, используемое для вычисления площадей, объемов и других величин.",
                        "zh": "微积分中的一个基本概念，用于计算面积、体积等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интеграл",
                                "target_lang_sense_clarification": "математическое понятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积分",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        },
