        "nl-extract.jsonl": [
            {
                "entry_id": "f4e07f08-f4bd-37b0-a8cc-7f897741154c",
                "word": "openhalen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d8a5d8b-90df-388a-8f49-2d5842c2d77c",
                        "entry_id": "f4e07f08-f4bd-37b0-a8cc-7f897741154c",
                        "glosses": [
                            "openmaken door scheuren; ergens een gat in maken; met name van de huid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d54c3f-bcfe-400a-9be7-16c0677e4f3b",
                                "sense_id": "5d8a5d8b-90df-388a-8f49-2d5842c2d77c",
                                "text": "\"Ik ben het gehannes met scheermesjes en het openhalen van mijn benen meer dan beu. Toch voel ik druk van buitenaf om als vrouw haarloos en zo glad mogelijk voor de dag te komen. Het is een verwachting van de maatschappij en je moet erg zelfverzekerd zijn als je daar lak aan hebt. Voor nu blijf ik mezelf ontharen en hoop ik op een herleving van de jaren 70.\""
                            },
                            {
                                "example_id": "656bfc2b-6498-4d48-9f50-fd83cb14d50f",
                                "sense_id": "5d8a5d8b-90df-388a-8f49-2d5842c2d77c",
                                "text": "Een onderzoek door de VACO, de brancheorganisatie van autobanden, heeft uiteindelijk alleen maar meer verwarring gesticht. De korrels, gemaakt van vermalen autobanden, zijn nodig zodat voetballers zich bij een sliding niet openhalen aan het kunstgras."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "723a835e-07e7-4e72-a335-17244a88c664",
                        "source_entry_id": "f4e07f08-f4bd-37b0-a8cc-7f897741154c",
                        "source_sense_id": "5d8a5d8b-90df-388a-8f49-2d5842c2d77c",
                        "target_lang_word": "slice open",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ec40176e-9338-4496-a33a-7bb9d0e542e3",
                        "source_entry_id": "f4e07f08-f4bd-37b0-a8cc-7f897741154c",
                        "source_sense_id": "5d8a5d8b-90df-388a-8f49-2d5842c2d77c",
                        "target_lang_word": "gash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "654b55f0-d6f0-34ac-b437-d518db599a8f",
                                        "entry_id": "542c1150-3d11-3afb-a732-be1a3b5a3760",
                                        "glosses": [
                                            "A deep cut."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52063acf-e716-427d-800b-c8c9010364c3",
                                                "sense_id": "654b55f0-d6f0-34ac-b437-d518db599a8f",
                                                "text": "The victim of the attack, Russell Mills, suffered a head gash, a broken knee cap and a broken wrist."
                                            },
                                            {
                                                "example_id": "3828fd27-65fe-4e86-a53d-71dd916bdfd6",
                                                "sense_id": "654b55f0-d6f0-34ac-b437-d518db599a8f",
                                                "text": "Unwittingly I slashed a gushing gash in my hand with a switchblade."
                                            },
                                            {
                                                "example_id": "264aa549-8b46-40a6-b657-50f0eabd1036",
                                                "sense_id": "654b55f0-d6f0-34ac-b437-d518db599a8f",
                                                "text": "Then Beowulf too rallied. With his whetted dagger he slit a gash in the serpent's middle."
                                            },
                                            {
                                                "example_id": "7a6bf815-caf3-4d02-83e9-e9e8d6cc689c",
                                                "sense_id": "654b55f0-d6f0-34ac-b437-d518db599a8f",
                                                "text": "Vowing that he was “never going to forget the lessons of that day,” President Bush paid tribute last night to the victims of the Sept. 11, 2001, terrorist attack, laying wreaths at ground zero, attending a prayer service at St. Paul’s Chapel and making a surprise stop at a firehouse and a memorial museum overlooking the vast gash in the ground where the twin towers once stood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6af5335-dc38-3d17-abe2-ed66f9048107",
                                        "entry_id": "542c1150-3d11-3afb-a732-be1a3b5a3760",
                                        "glosses": [
                                            "A vulva."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad0255d7-cae4-410e-a86d-d179eccde72a",
                                                "sense_id": "d6af5335-dc38-3d17-abe2-ed66f9048107",
                                                "text": "“Oh Gertie it’s true. It’s all true. They’ve got a horrid gash instead of a thrilling thing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "973177cf-e54a-3f8a-a0de-1529cda483a8",
                                        "entry_id": "542c1150-3d11-3afb-a732-be1a3b5a3760",
                                        "glosses": [
                                            "A woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a21486-78e9-41e4-bd99-ab156763d5aa",
                                                "sense_id": "973177cf-e54a-3f8a-a0de-1529cda483a8",
                                                "text": "\"Will you bastards quit singing the blues? You're young, and there's plenty of gash in the world, and the supply of moon goes on forever,\" Simonsky said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36513142-19c1-3ba2-8be3-88ceefa965a7",
                                        "entry_id": "80646913-3e6b-358e-ab79-a50b0f24ef89",
                                        "glosses": [
                                            "To make a deep, long cut; to slash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725cccc4-c7e7-4d69-b551-198432057a8d",
                                                "sense_id": "36513142-19c1-3ba2-8be3-88ceefa965a7",
                                                "text": "My leg got gashed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b040092-8964-3014-bfa5-9e0df9335b06",
                                        "entry_id": "73d9ee46-ae65-36de-9278-f100da90963f",
                                        "glosses": [
                                            "Rubbish, particularly on board a ship or aircraft."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2301d1a-ea02-4dd1-a4e1-97b65bf2d745",
                                                "sense_id": "7b040092-8964-3014-bfa5-9e0df9335b06",
                                                "text": "[…] each man was on 'gash duty' about once in eighteen days."
                                            },
                                            {
                                                "example_id": "c1f2dc6e-7f72-426f-951b-45c9f0622f5a",
                                                "sense_id": "7b040092-8964-3014-bfa5-9e0df9335b06",
                                                "text": "You will learn flight safety, aircraft duties, uniform, SEP, oxyCrew, gash cart, safety card, bar seals, life jacket, diagram, uplift, C209, plonky kit, Crew lounge!"
                                            },
                                            {
                                                "example_id": "69c07b3b-c261-4498-8087-188b95dc9e62",
                                                "sense_id": "7b040092-8964-3014-bfa5-9e0df9335b06",
                                                "text": "After scradge and another mug of tea I washed up, tipping the slops into the gash tin […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c05dbf-5ab5-3793-bd47-7d815cf22771",
                                        "entry_id": "73d9ee46-ae65-36de-9278-f100da90963f",
                                        "glosses": [
                                            "Nonsense."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0ca242c-a0e6-4ed1-a65c-f4c1433461c1",
                                                "sense_id": "b1c05dbf-5ab5-3793-bd47-7d815cf22771",
                                                "text": "I hope you don't mind, but instead of “a load of gash” in this paragraph, could we say, “completely without merit”?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5296cdfa-0c45-3021-941a-64bc45285a0d",
                                        "entry_id": "73d9ee46-ae65-36de-9278-f100da90963f",
                                        "glosses": [
                                            "Something low quality."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1d7e2a-97ed-4b34-9864-fefbdacef537",
                                                "sense_id": "5296cdfa-0c45-3021-941a-64bc45285a0d",
                                                "text": "This new one he's got for free off a friend (I think), but it's absolute gash. It's huge and doesn't fit in with the deco of the room, but because he's got it for nowt he's not arsed about that."
                                            },
                                            {
                                                "example_id": "2351d894-bd7b-488f-ab77-6cbc95b2e71f",
                                                "sense_id": "5296cdfa-0c45-3021-941a-64bc45285a0d",
                                                "text": "When you load up the game, the first thing you notice is that it looks like complete and utter gash. Everything is made up of ugly blocks."
                                            },
                                            {
                                                "example_id": "7ccb1965-1782-45dd-afde-a8c6e9b86fb9",
                                                "sense_id": "5296cdfa-0c45-3021-941a-64bc45285a0d",
                                                "text": "Well, this chap's obviously just cooked a pile of rancid old gash, no?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb2c49c-d1d5-3a54-b19d-a28be541ec40",
