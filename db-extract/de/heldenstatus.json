                "senses": [
                    {
                        "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                        "entry_id": "69af6a5e-eeac-3edf-a7ab-97e8ddda39f1",
                        "glosses": [
                            "durch besondere Leistung erreichte herausragende Stellung in einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14283bfc-a7cf-4cb2-a4fd-f82bd2fd80ba",
                                "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                                "text": "„Während der jüngsten Intifada tauchten erstmals bei palästinensischen Demonstrationen die gelben Flaggen der Hisbollah auf, deren Kämpfer Heldenstatus erlangt haben.“"
                            },
                            {
                                "example_id": "68182269-fec4-46b2-9b30-3cc76cc51609",
                                "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                                "text": "„Simon Ammann ist der erste Goldmedaillengewinner in Vancouver: Mit seinem dritten Olympiasieg hat der Schweizer endgültig Heldenstatus in seiner Sportart erlangt.“"
                            },
                            {
                                "example_id": "de876675-0f17-46f4-83fa-abe1a8d4eb96",
                                "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                                "text": "„Dem ‚von der Politik am meisten vereinnahmten Boxkampf der Geschichte‘, wie die englische Zeitung ‚The Guardian‘ im Nachruf zum Tod Schmelings 2005 schrieb, verdankte Louis seinen Heldenstatus in einer von Rassismus zerrissenen US-Gesellschaft.“"
                            },
                            {
                                "example_id": "b1f69210-dfd2-46ec-939c-29984b359a89",
                                "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                                "text": "„Drei Tore gegen die Bayern, und das in nur sieben Minuten: Wem ein solches Kunststück gelingt, dem sollte der Heldenstatus für alle Zeiten gewiss sein.“"
                            },
                            {
                                "example_id": "cafc5fbe-4688-49cf-82ba-6da1ec5557f4",
                                "sense_id": "a77b1bf8-eaa0-3e2c-8107-66f28a101e99",
                                "text": "„Diesbezüglich stellt auch die Tehrik-e-Insaf (Bewegung der Gerechtigkeit) keine Ausnahme dar. Diese ist auf die Person von Imran Khan zugeschnitten, der als ehemaliger Kapitän des pakistanischen Cricket-Teams, das den World Cup 1992 gewann, in Pakistan Heldenstatus genießt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
