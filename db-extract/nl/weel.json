                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ae18ce94-d26b-3717-8a87-2dd2a91676f7",
                        "entry_id": "e714f9d3-34c3-30ae-b0bf-38dbf44771ee",
                        "glosses": [
                            "diepe plas die door het kolkend water van een dijkdoorbraak is ontstaan en waar de vervangende dijk in een boog omheen is aangelegd"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "34da92c8-804c-4d8d-a36b-8d042a31074d",
                                "sense_id": "ae18ce94-d26b-3717-8a87-2dd2a91676f7",
                                "text": "Als een dijk doorbrak ontstond door het krachtig binnenstromende Scheldewater een weel of uitkolkingsgat."
                            },
                            {
                                "example_id": "9f1ba281-18f9-49c1-8b41-118cc4e7c154",
                                "sense_id": "ae18ce94-d26b-3717-8a87-2dd2a91676f7",
                                "text": "In het mooi geïllustreerde boek over Van den vos Reynaerde, uitgegeven bij het Davidsfonds in 1991 staan op pagina 207 drie foto's van binnenwateren: de Grote Geule bij Kieldrecht, een weel bij het Nederlandse Clinge (nabij fort Bedmar) en een uitloper van de vroegere Grote Geule, het Sint-Jacobsgat nabij de gemeentegrenzen van Meerdonk en De Klinge (in de buurt van de huidige Krekeldijk)."
                            }
                        ]
                    }
