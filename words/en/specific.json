                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, quinine was considered a <w>specific</w> for malaria.",
                            "target_lang_translations": {
                                "ru": "В прошлом хинин считался <w>специфическим средством</w> от малярии."
                            }
                        },
                        {
                            "text": "There is no known <w>specific</w> for this viral infection yet.",
                            "target_lang_translations": {
                                "ru": "Для этой вирусной инфекции пока нет известного <w>лекарства</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство или лекарство, используемое при конкретном заболевании или состоянии."
