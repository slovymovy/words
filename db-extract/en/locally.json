                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "83882f00-be3e-4a2c-a6a6-9eaafbd35402",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more locally"
                    },
                    {
                        "form_id": "68b4f8f1-3472-4407-826c-28f385834741",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most locally"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30b0e0d5-ee0c-3370-955a-6cd23734c125",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "glosses": [
                            "With respect to place; in place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68abcc9a-6e62-413b-9201-2c6258148ef2",
                                "sense_id": "30b0e0d5-ee0c-3370-955a-6cd23734c125",
                                "text": "These things are locally separated."
                            }
                        ]
                    },
                    {
                        "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "glosses": [
                            "In or from the local area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd8fa8c-b902-4d3e-a835-426b1295b32e",
                                "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                                "text": "We live locally."
                            },
                            {
                                "example_id": "55a6e6a7-73b6-492a-9cb9-97682dddbd28",
                                "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                                "text": "In this shop we only sell products farmed locally."
                            },
                            {
                                "example_id": "5d0611fc-ed2f-466f-bbb9-6d87c06bd32b",
                                "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                                "text": "She became disrespectfully referred to locally as the \"Crab\" on account of her extraordinary manoeuvrability."
                            },
                            {
                                "example_id": "1eeff375-e641-4ceb-8c9e-07a9155adc08",
                                "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                                "text": "“Temu’s pricing for U.S. consumers remains unchanged as the platform transitions to a local fulfillment model,” the company said in a statement. “All sales in the U.S. are now handled by locally based sellers, with orders fulfilled from within the country.”"
                            },
                            {
                                "example_id": "cd3c1a2a-99f0-417e-b573-7e1a1eaef4c9",
                                "sense_id": "e51475bd-bd70-3d73-a40c-cdcef71c6ff5",
                                "text": "The spending in and around local stations is creating micro-economies that are benefiting Great Britain's high streets, independent businesses and economic growth, both locally and on a national level."
                            }
                        ]
                    },
                    {
                        "sense_id": "a38c7180-28e9-341e-a81f-50bf8154c33f",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "glosses": [
                            "In a restricted part of the body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8841329c-50b0-41d7-a1e8-3deb30c1e25e",
                                "sense_id": "a38c7180-28e9-341e-a81f-50bf8154c33f",
                                "text": "To be applied locally"
                            },
                            {
                                "example_id": "3142ad18-13dc-4e0c-8c5d-2e8d3c5493b2",
                                "sense_id": "a38c7180-28e9-341e-a81f-50bf8154c33f",
                                "text": "Puri et al demonstrated that intravesically administered apaziquone is well tolerated locally and systemically, and it has ablative activity for superficial bladder cancer marker lesions."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fec3a65-e5fb-3923-85ad-c344142d5797",
                        "entry_id": "e2ae9f81-1b2a-32b1-aa98-7bd67b82e86e",
                        "glosses": [
                            "Within a sufficiently small sphere (or circle or interval) around a given point (sometimes, around any point)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1186e8f-7776-4e2b-9459-8a6131712861",
                                "sense_id": "6fec3a65-e5fb-3923-85ad-c344142d5797",
                                "text": "locally Euclidean"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39b5eaa6-32c4-48de-8fb7-c2c6206c9016",
