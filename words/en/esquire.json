{
    "word_family": [
        "squire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c10d0403-98db-38de-9904-77ad23dd4363",
                    "sense_definition": "An honorific title placed after a man's name, often used in formal correspondence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter was addressed to John Smith, <w>Esquire</w>, at his office in London.",
                            "target_lang_translations": {
                                "pl": "List był zaadresowany do Johna Smitha, <w>Esquire</w>, w jego biurze w Londynie."
                            }
                        },
                        {
                            "text": "Please ensure the invitation is sent to Mr. Robert Brown, <w>Esquire</w>.",
                            "target_lang_translations": {
                                "pl": "Proszę upewnić się, że zaproszenie zostało wysłane do pana Roberta Browna, <w>Esquire</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "addressed as esquire"
                    ],
                    "target_lang_definitions": {
                        "pl": "Honorowy tytuł umieszczany po nazwisku mężczyzny, używany głównie w formalnej korespondencji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Esquire",
                                "target_lang_sense_clarification": "pozostawione w oryginale jako angielski tytuł honorowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47ff8148-e651-35c2-b785-f97daf6c5efa",
                    "sense_definition": "A lawyer, particularly in the United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>esquire</w> reviewed the legal documents before the trial began.",
                            "target_lang_translations": {
                                "pl": "<w>Mecenas</w> przejrzał dokumenty prawne przed rozpoczęciem procesu."
                            }
                        },
                        {
                            "text": "She hired a local <w>esquire</w> to handle her business contracts.",
                            "target_lang_translations": {
                                "pl": "Wynajęła lokalnego <w>adwokata</w> do obsługi swoich kontraktów biznesowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "lawyer",
                        "attorney"
                    ],
                    "target_lang_definitions": {
                        "pl": "Prawnik, adwokat (szczególnie w USA)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "mecenas",
                                "target_lang_sense_clarification": "potoczne określenie adwokata lub radcy prawnego"
                            },
                            {
                                "target_lang_word": "adwokat",
                                "target_lang_sense_clarification": "prawnik reprezentujący klienta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52075ca3-badc-3308-b70d-e9f0e136e713",
                    "sense_definition": "A young man serving a knight as an attendant while training to become a knight himself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>esquire</w> polished his master's armor every morning.",
                            "target_lang_translations": {
                                "pl": "Młody <w>giermek</w> polerował zbroję swojego pana każdego ranka."
                            }
                        },
                        {
                            "text": "A loyal <w>esquire</w> followed the knight into the heat of battle.",
                            "target_lang_translations": {
                                "pl": "Lojalny <w>giermek</w> podążył za rycerzem w sam środek bitwy."
                            }
                        }
                    ],
                    "synonyms": [
                        "squire"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical social role."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Młody mężczyzna służący rycerzowi jako pomocnik podczas szkolenia rycerskiego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "giermek",
                                "target_lang_sense_clarification": "historyczny pomocnik rycerza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75ca66ef-da62-3953-addd-816056cb423a",
                    "sense_definition": "A man belonging to the gentry class, ranking below a knight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>esquire</w> owned much of the land in the village.",
                            "target_lang_translations": {
                                "pl": "Lokalny <w>ziemianin</w> posiadał znaczną część ziemi we wsi."
                            }
                        },
                        {
                            "text": "He was a wealthy <w>esquire</w> who served as a justice of the peace.",
                            "target_lang_translations": {
                                "pl": "Był zamożnym <w>szlachcicem</w>, który pełnił funkcję sędziego pokoju."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical social class."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Członek szlachty o randze niższej niż rycerz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szlachcic",
                                "target_lang_sense_clarification": "ogólne określenie członka stanu szlacheckiego"
                            },
                            {
                                "target_lang_word": "ziemianin",
                                "target_lang_sense_clarification": "właściciel ziemski wywodzący się ze szlachty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7ad5f7-3ac4-3d1c-abde-82323b196a66",
                    "sense_definition": "A gentleman who escorts a lady in public.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She arrived at the ball with a charming <w>esquire</w> by her side.",
                            "target_lang_translations": {
                                "pl": "Przybyła na bal z czarującym <w>kawalerem</w> u boku."
                            }
                        },
                        {
                            "text": "The lady was grateful to have such a polite <w>esquire</w> to accompany her.",
                            "target_lang_translations": {
                                "pl": "Dama była wdzięczna, że ma tak uprzejmego <w>towarzysza</w> do eskortowania jej."
                            }
                        }
                    ],
                    "synonyms": [
                        "escort"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a traditional social custom."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dżentelmen towarzyszący damie w miejscach publicznych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kawaler",
                                "target_lang_sense_clarification": "mężczyzna towarzyszący kobiecie"
                            },
                            {
                                "target_lang_word": "towarzysz",
                                "target_lang_sense_clarification": "osoba towarzysząca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab1428f3-e38c-3f43-a482-ca09875f0453",
                    "sense_definition": "An attendant or servant, specifically one who carries a shield or performs household duties for a noble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>esquire</w> stood ready to serve the meal to the guests.",
                            "target_lang_translations": {
                                "pl": "<w>Służący</w> był gotowy, by podać posiłek gościom."
                            }
                        },
                        {
                            "text": "He served as an <w>esquire</w> in the royal household for many years.",
                            "target_lang_translations": {
                                "pl": "Przez wiele lat służył jako <w>giermek</w> na dworze królewskim."
                            }
                        }
                    ],
                    "synonyms": [
                        "attendant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical occupation."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Służący lub pomocnik wykonujący obowiązki domowe dla szlachcica."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "giermek",
                                "target_lang_sense_clarification": "historyczny pomocnik dworski"
                            },
                            {
                                "target_lang_word": "służący",
                                "target_lang_sense_clarification": "osoba wykonująca prace domowe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc9caf1c-5a6c-337b-b658-f2d035548876",
                    "sense_definition": "A specific geometric shape used in heraldry, resembling a triangle or a division of a square.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms features two <w>esquires</w> on the shield.",
                            "target_lang_translations": {
                                "pl": "Herb przedstawia dwie <w>figury heraldyczne</w> na tarczy."
                            }
                        },
                        {
                            "text": "The heraldic design includes an <w>esquire</w> placed near the base.",
                            "target_lang_translations": {
                                "pl": "Projekt heraldyczny zawiera <w>figurę</w> umieszczoną blisko podstawy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Figura heraldyczna przypominająca trójkąt lub podział kwadratu."
                    },
                    "translations": {
                        "pl": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22605cd9-fffd-3985-af48-f99656a6d2d0",
                    "sense_definition": "To accompany or escort someone, typically a lady, in a formal or polite manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to <w>esquire</w> her to the theater for the evening performance.",
                            "target_lang_translations": {
                                "pl": "Zaoferował, że <w>odprowadzi</w> ją do teatru na wieczorny spektakl."
                            }
                        },
                        {
                            "text": "It was his duty to <w>esquire</w> the guests to their seats at the banquet.",
                            "target_lang_translations": {
                                "pl": "Jego obowiązkiem było <w>eskortowanie</w> gości do ich miejsc na bankiecie."
                            }
                        }
                    ],
                    "synonyms": [
                        "escort",
                        "accompany"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a formal social action."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Towarzyszyć lub eskortować kogoś, zazwyczaj damę, w formalny sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "eskortować",
                                "target_lang_sense_clarification": "towarzyszyć komuś w drodze"
                            },
                            {
                                "target_lang_word": "odprowadzać",
                                "target_lang_sense_clarification": "towarzyszyć komuś do miejsca docelowego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}