                ],
                "senses": [
                    {
                        "sense_id": "40d1d4b0-bae5-3df8-96c3-6d1fa9f51a18",
                        "entry_id": "04728f08-447d-3b39-80c9-eab922cdf70a",
                        "glosses": [
                            "Gesamtheit der Entscheidungen/Überlegungen dazu, wie man sein Leben gestalten möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e99e756-4c29-47fb-8fbc-aa38c74dada2",
                                "sense_id": "40d1d4b0-bae5-3df8-96c3-6d1fa9f51a18",
                                "text": "„Die Geburtenrate wird aber erst dann steigen, wenn Eltern in ihrer Lebensplanung ein Gefühl von Sicherheit haben.“"
                            },
                            {
                                "example_id": "58cac62b-4b17-47b4-85e5-422676dbacc4",
                                "sense_id": "40d1d4b0-bae5-3df8-96c3-6d1fa9f51a18",
                                "text": "„Es bedeutet allerdings ebenfalls, ohne Zukunftsorientierung einer traditionellen Lebensweise verhaftet zu bleiben, die weitreichende Lebensplanungen nicht kennt.“"
                            },
                            {
                                "example_id": "592fb224-c3a2-4ff0-928f-4fc6d7dec8f9",
                                "sense_id": "40d1d4b0-bae5-3df8-96c3-6d1fa9f51a18",
                                "text": "„In meine Lebensplanung hatten Kinder bisher nicht hineingepasst.“"
                            },
                            {
                                "example_id": "47e1874e-6bd4-4cff-b40e-99cbe10c1424",
                                "sense_id": "40d1d4b0-bae5-3df8-96c3-6d1fa9f51a18",
                                "text": "„Er ist es, und aus seinen Lebensplanungen ist sie nicht ganz verschwunden, jedenfalls gibt er das vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
