                    {
                        "translation_id": "e9640f9d-0040-48d0-9063-e1a89b555458",
                        "source_entry_id": "764fef20-e03b-3cc2-a8d5-8e59a9a8d407",
                        "source_sense_id": "ecfe313c-39d2-369a-a732-3eb304655fdb",
                        "source_sense_description": "zusätzliches Zeichen zu den Buchstaben, um Akzente oder die genaue Aussprache anzuzeigen",
                        "target_lang_word": "capucha",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capucha",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bd9c5c8c-e97c-3b24-808b-4329db98a53e",
                                        "entry_id": "210878ac-c7d7-3b0a-9e88-35330381bd8c",
                                        "glosses": [
                                            "Gorro amplio y flexible que cubre la cabeza, el cuello y parte de la cara, generalmente integrado a una prenda de vestir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad52160b-3353-419f-b254-eb8d2476725b",
                                                "sense_id": "bd9c5c8c-e97c-3b24-808b-4329db98a53e",
                                                "text": "Conque, ¡ni las mitras son para cabezas escondidas en las capuchas, ni las cabezas escondidas en las capuchas son para las mitras!"
                                            },
                                            {
                                                "example_id": "de66624d-f4e3-469e-8530-500b03dc52a2",
                                                "sense_id": "bd9c5c8c-e97c-3b24-808b-4329db98a53e",
                                                "text": "Una capucha le cubría la cabeza y le bajaba hasta los hombros."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7526cbc1-e252-366a-9545-4b3068688911",
                                        "entry_id": "210878ac-c7d7-3b0a-9e88-35330381bd8c",
                                        "glosses": [
                                            "Prenda con capucha₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0999a5d5-c13b-4eac-8faf-fd9f0cd2f8f4",
                                                "sense_id": "7526cbc1-e252-366a-9545-4b3068688911",
                                                "text": "El religioso metido\nen su capucha, se queda\nde mármol, cruza los brazos,\ny con fervor mudo, reza."
                                            },
                                            {
                                                "example_id": "f1afb798-38ab-4cd5-9118-610f650aa633",
                                                "sense_id": "7526cbc1-e252-366a-9545-4b3068688911",
                                                "text": "El capataz sonreía viendo que el amo y sus acompañantes de sotana o de capucha mostraban gran placer en oírle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1fdf4e12-d591-3580-a501-70c10930b0bc",
                                        "entry_id": "210878ac-c7d7-3b0a-9e88-35330381bd8c",
                                        "glosses": [
                                            "Por extensión, objeto cualquiera cuya forma o función recuerda a la de una capucha₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e47b63e-4421-4b25-8734-d93a9f1d5d1b",
                                                "sense_id": "1fdf4e12-d591-3580-a501-70c10930b0bc",
                                                "text": "traía un trajecillo claro, rozado en las bocamangas, y un lapicero amarillo con capucha le asomaba en el bolsillo superior."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5b41d1b3-7a2f-304e-a175-790fb3f02d9a",
                                        "entry_id": "210878ac-c7d7-3b0a-9e88-35330381bd8c",
                                        "glosses": [
                                            "Por extensión, corona de plumas que caracteriza algunas especies de aves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b4a8ea-7680-4c9c-8795-9aea4e426fec",
                                                "sense_id": "5b41d1b3-7a2f-304e-a175-790fb3f02d9a",
                                                "text": "A él, dijo, las que le gustaban más eran las que tenían un poco de capucha de plumas detrás de la cabeza y todo el cuello morado y verde, de tornasol."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "aa804576-b9f5-38b1-a778-149d28c844ed",
                                        "entry_id": "210878ac-c7d7-3b0a-9e88-35330381bd8c",
                                        "glosses": [
                                            "Diacrítico en forma de cuña con el vértice hacia arriba, empleado en la ortografía de numerosos idiomas para indicar la longitud, acento o altura de algunas vocales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c467fd5-a8e4-4331-a5ba-bdaa04f2d636",
                                                "sense_id": "aa804576-b9f5-38b1-a778-149d28c844ed",
                                                "text": "suprimió la ch cuando tenía el valor de k, como en christiano, chimera, sustituyéndole, según los diferentes casos, c o q, y excusando la capucha o acento circunflejo, que por vía de distinción solía ponerse sobre la vocal siguiente."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
