                        "sense_id": "524be349-973f-384d-ae9a-3447a8641e8d",
                        "entry_id": "180486c8-f898-310f-8232-2b6ea5b02c04",
                        "glosses": [
                            "georganiseerde tocht die men samen met anderen voor zijn plezier maakt"
