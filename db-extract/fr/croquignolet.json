                                        "entry_id": "e442f3d5-179e-35d9-b5ae-d652ede0f0ac",
                                        "glosses": [
                                            "Tiny and cute; small and attractive."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ee0b3e-c345-4f81-8cab-3b9ffa372aa2",
                                                "sense_id": "77fa0865-7942-3146-954f-90a1fc4bbd66",
                                                "text": "How do you like my hat? That one you had on in church yesterday was real dinky."
                                            },
                                            {
                                                "example_id": "63514e92-b9e2-4012-bd8f-203ce088d6fd",
                                                "sense_id": "77fa0865-7942-3146-954f-90a1fc4bbd66",
                                                "text": "Rather should it be said that these ladies wore dress of military style, since there was nothing uniform about their outfits, one being in powder-blue with silver buttons and a forage-cap, the other in tan with gold buttons and the dinkiest of red-peaked kepis."
                                            },
                                            {
                                                "example_id": "92047e91-7839-48ed-9775-fc0abbe05b51",
                                                "sense_id": "77fa0865-7942-3146-954f-90a1fc4bbd66",
                                                "text": "I played in the dirt with a small dinky car as the garage held no fascination for a little girl of five."
                                            },
                                            {
                                                "example_id": "b13decf7-0e4e-4595-b6b4-40a87113cfcf",
                                                "sense_id": "77fa0865-7942-3146-954f-90a1fc4bbd66",
                                                "text": "“Ooh, well, he is a particularly pretty one. Look at his dinky little nose,” said Raj with a sweet smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38f5beb8-08f4-3f8a-b101-d3d8e5ce41f4",
                                        "entry_id": "e442f3d5-179e-35d9-b5ae-d652ede0f0ac",
                                        "glosses": [
                                            "Tiny and insignificant; small and undesirable."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a18ca9-09e5-441b-a6bc-b38f96425832",
                                                "sense_id": "38f5beb8-08f4-3f8a-b101-d3d8e5ce41f4",
                                                "text": "They stayed in a dinky hotel room, but they had a great trip."
                                            }
                                        ]
                                    }
                                ]
