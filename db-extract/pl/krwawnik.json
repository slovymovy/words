                                        "entry_id": "cfef7814-5999-384d-bcf7-4cc87f197081",
                                        "glosses": [
                                            "Any of several pungent Eurasian and North American herbs, of the genus Achillea, used in traditional herbal medicine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ef79bb-e5c0-4fa9-a254-40573609a4e3",
                                                "sense_id": "604a9ac7-9457-3050-9715-31d5ada93506",
                                                "text": "Yarrow is one of the aboriginal English plants, and from time immemorial it has been used in incantations and by witches. Country folk still regard it as one of our most valuable herbs, especially for rheumatism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df1865d-35ad-386b-88de-13687a24433b",
                                        "entry_id": "cfef7814-5999-384d-bcf7-4cc87f197081",
                                        "glosses": [
                                            "Common yarrow, Achillea millefolium, the type species of the genus."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8feb03a-2a40-400d-a5b2-f9eaca3fb60c",
                                                "sense_id": "2df1865d-35ad-386b-88de-13687a24433b",
                                                "text": "The Yarrow, where-with-all he stops the wound-made gore:"
                                            },
                                            {
                                                "example_id": "1fa5a117-4cee-41bc-a2ff-43ea43570ffc",
                                                "sense_id": "2df1865d-35ad-386b-88de-13687a24433b",
                                                "text": "“Oh, yarrow! This is it,” she said, extracting a single long stemmed ferny grass with clusters of small white flowers from the bouquet in her hand."
                                            }
                                        ]
                                    }
                                ]
                            },
