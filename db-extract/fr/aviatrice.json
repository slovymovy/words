                                        "sense_id": "94f369d7-a80c-3b61-a73e-929a7378df57",
                                        "entry_id": "9406c8d3-5459-3ca4-8285-c82e23c213f0",
                                        "glosses": [
                                            "Führerin eines Fluggerätes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f13f9e-2feb-49a8-a18b-c732d8934159",
                                                "sense_id": "94f369d7-a80c-3b61-a73e-929a7378df57",
                                                "text": "Die Fliegerin beging einen schweren Fehler, in dessen Folge das Flugzeug einen Strömungsabriss erlitt und dann abstürzte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cc731ef-7a00-4645-af72-0fee2d05b687",
                        "source_entry_id": "9b5ff325-592b-3b24-864d-786735738a10",
                        "source_sense_id": "295c3ab7-410f-3bab-9ecf-ed662b290fd6",
                        "source_sense_description": "Pilote d’aéronef",
                        "target_lang_word": "aviatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aviatrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                        "entry_id": "97c74446-72f7-3145-89c4-3245f0daaa01",
                                        "glosses": [
                                            "A female aviator."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f18633d-6fd6-422c-bfcb-2d8059202526",
                                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                                "text": "“... — Did you know that she was an aviatrix?” he interjected."
                                            },
                                            {
                                                "example_id": "ac518582-2c02-4b2c-8681-047cbed814b4",
                                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                                "text": "The Women Flyers: From Aviatrix to Astronaut"
                                            },
                                            {
                                                "example_id": "6cb8d664-08d6-4115-9a16-97ca4aa0b009",
                                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                                "text": "Hariet Quimby, a writer for Leslie's Weekly, in 1911 became the first American aviatrix and won international accalim in 1912 as the first woman to pilot a plan across the English Channel."
                                            },
                                            {
                                                "example_id": "384c5335-7334-4452-ae80-6434ce2446dc",
                                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                                "text": "In 1929 she turned an ide that she ‘stole’ from her son into a screenplay, Wings in the Dark, featuring a protagonist based on Ameria Earhart, the famous aviatrix with whom Shipman was acquainted..."
                                            },
                                            {
                                                "example_id": "9ba20480-5564-44ab-b7fa-a82f72c4190a",
                                                "sense_id": "0cd12dad-562f-3d1b-a5ae-8ffcb37caa23",
                                                "text": "2018 summary of 2009 film Amelia\nFrom the time she first sits in the pilot's seat, aviatrix Amelia Earhart (Hilary Swank) feels destined to achieve great things."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "480c1acf-15ed-453f-ad6d-c44fe3cab971",
                        "source_entry_id": "9b5ff325-592b-3b24-864d-786735738a10",
