                ],
                "translations": [
                    {
                        "translation_id": "824b3b82-a9c0-4cce-899e-f1174768e6a1",
                        "source_entry_id": "a990e383-300e-3568-a894-bd0fa929c76a",
                        "source_sense_id": "ba71eca2-136e-32c6-9b9c-3fcc259fda61",
                        "target_lang_word": "Welfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Welfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cda9a6d-f470-3066-90e3-e3051cc5680c",
                                        "entry_id": "bc8bd19d-0e8f-317f-9e8e-c8978a58b4cb",
                                        "glosses": [
                                            "Angehöriger eines bedeutsamen, fränkischen Adelsgeschlechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b97114-bffc-445e-a2da-36a9a92330c4",
                                                "sense_id": "4cda9a6d-f470-3066-90e3-e3051cc5680c",
                                                "text": "„Der Konflikt des neuen Königs mit dem Welfen Heinrich gen. der Stolze, dem das sächsische Herzogtum genommen wurde, brachte Albrecht an das von ihm und seiner Mutter höchst erwünschte Ziel, indem er nun die Belehnung mit dem Herzogtum empfing.“"
                                            },
                                            {
                                                "example_id": "45468dc0-ce25-46e9-ba99-e5d69977472a",
                                                "sense_id": "4cda9a6d-f470-3066-90e3-e3051cc5680c",
                                                "text": "„Der Welfe wurde vor den Reichstag zitiert, unter Reichsacht gestellt und verlor die Herzogtümer Sachsen und Bayern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee10f4de-8b6a-487a-8973-165da0358633",
                        "source_entry_id": "a990e383-300e-3568-a894-bd0fa929c76a",
                        "source_sense_id": "ba71eca2-136e-32c6-9b9c-3fcc259fda61",
                        "target_lang_word": "Guelph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guelph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d94bdfb-9b4f-3ecf-a284-486b398f6a9e",
                                        "entry_id": "b7ca564a-2a1a-3761-ae1d-c0bfde8c545f",
                                        "glosses": [
                                            "In the politics of medieval Italian city states, any member of a faction that supported the Pope in a long struggle against the Ghibellines and the Holy Roman Emperor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44c9997f-3bd5-4f5f-9166-b45aad1ae324",
                                                "sense_id": "0d94bdfb-9b4f-3ecf-a284-486b398f6a9e",
                                                "text": "1893, Oscar Browning, Guelphs and Ghibellines: A Short History of Mediaeval Italy from 1250-1409, Methuen & Co., page 13,\nThe parties of Guelph and Ghibelline raged as fiercely as if the lances of the German hosts were ever glimmering on the crest of the Alps, or as if the Lombard leagues were in constant watchfulness against an impending foe. […] Speaking generally, the Ghibellines were the party of the emperor, and the Guelphs the party of the Pope; the Ghibellines were on the side of authority, or sometimes of oppression, the Guelphs were on the side of liberty and self-government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd78555-969c-3b85-bf49-3800cb3a5ab0",
                                        "entry_id": "b7ca564a-2a1a-3761-ae1d-c0bfde8c545f",
                                        "glosses": [
                                            "Any member of the German-Hanoverian Party (1867–1933), a conservative federalist political party in the German Empire and the Weimar Republic founded in protest of the annexation of the Kingdom of Hanover by the Kingdom of Prussia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7716e493-cd5f-4180-881b-eb6d038d6546",
                                                "sense_id": "4dd78555-969c-3b85-bf49-3800cb3a5ab0",
                                                "text": "Bismarck was aware of the opportunity which the Reichstag afforded the Guelphs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guelph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2739fc05-f453-3243-bf4b-7a3b9398656a",
                                        "entry_id": "1423015d-7fdb-3cec-ad3b-d54df46fe7eb",
                                        "glosses": [
