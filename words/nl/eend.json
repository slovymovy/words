                    "sense_id": "a41548e7-1451-3b84-8cd8-20f941f87d88",
                    "sense_definition": "Een watervogel uit de familie van de eendachtigen (Anatidae).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zwemt een <w>eend</w> in de vijver.",
                            "target_lang_translations": {
                                "ru": "В пруду плавает <w>утка</w>.",
                                "en": "A <w>duck</w> is swimming in the pond.",
                                "pl": "W stawie pływa <w>kaczka</w>.",
                                "de": "Es schwimmt eine <w>Ente</w> im Teich.",
                                "fr": "Un <w>canard</w> nage dans l'étang.",
                                "it": "C'è un' <w>anatra</w> che nuota nello stagno.",
                                "cs": "V rybníku plave <w>kachna</w>.",
                                "tr": "Gölette bir <w>ördek</w> yüzüyor.",
                                "es": "Hay un <w>pato</w> nadando en el estanque."
                            }
                        },
                        {
                            "text": "Hij voelde zich een vreemde <w>eend</w> in de bijt toen hij niemand kende op het feest.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя белой <w>вороной</w>, так как никого не знал на вечеринке.",
                                "en": "He felt like an odd <w>duck</w> when he didn't know anyone at the party.",
                                "pl": "Czuł się jak czarna <w>owca</w>, kiedy nikogo nie znał na imprezie.",
                                "de": "Er fühlte sich wie ein bunter <w>Hund</w>, als er niemanden auf der Party kannte.",
                                "fr": "Il s'est senti comme un <w>cheveu</w> sur la soupe lorsqu'il n'a reconnu personne à la fête.",
                                "it": "Si sentiva come una <w>mosca bianca</w> dato che non conosceva nessuno alla festa.",
                                "cs": "Cítil se jako černá <w>ovce</w>, když na večírku nikoho neznal.",
                                "tr": "Partide kimseyi tanımadığı için kendini sudan çıkmış <w>balık</w> gibi hissetti.",
                                "es": "Se sintió como un <w>bicho</w> raro al no conocer a nadie en la fiesta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vreemde eend in de bijt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водоплавающая птица из семейства утиных (Anatidae).",
                        "en": "A waterbird from the family Anatidae.",
                        "pl": "Ptak wodny z rodziny kaczkowatych (Anatidae).",
                        "de": "Ein Wasservogel aus der Familie der Entenvögel (Anatidae).",
                        "fr": "Un oiseau aquatique de la famille des anatidés (Anatidae).",
                        "it": "Un uccello acquatico della famiglia degli Anatidi (Anatidae).",
                        "cs": "Vodní pták z čeledi kachnovitých (Anatidae).",
                        "tr": "Ördekgiller (Anatidae) familyasından bir su kuşu.",
                        "es": "Un ave acuática de la familia de los anátidos (Anatidae)."
                    },
