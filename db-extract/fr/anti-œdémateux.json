                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5006d77-3815-4b7d-9365-079dd74c6c85",
                                "sense_id": "a3c0143a-7b40-3f01-afd2-b412d0e05365",
                                "text": "On l’utilise localement en teinture pure ou incorporée dans une pommade ou encore en cataplasme, en raison de ses propriétés anti-œdémateuses en cas de contusions avec inflammation ou d’œdèmes congestifs."
                            },
                            {
                                "example_id": "4374d875-8930-4cb5-9fe3-2426648b3be7",
                                "sense_id": "a3c0143a-7b40-3f01-afd2-b412d0e05365",
                                "text": "L’activité anti-œdémateuse et anti-inflammatoire de la bromélaïne a été mise en évidence sur modèles animaux."
                            },
                            {
                                "example_id": "106c84ae-7999-431d-b5e5-552d3533c766",
                                "sense_id": "a3c0143a-7b40-3f01-afd2-b412d0e05365",
                                "text": "L’acide rosmarinique qu’il contient est aussi anti-œdémateux, ce qui peut se révéler utile lorsque les articulations sont gonflées."
                            }
                        ]
                    }
