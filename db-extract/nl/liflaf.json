                ],
                "senses": [
                    {
                        "sense_id": "4ef2d838-ce36-3457-877a-21646352ee44",
                        "entry_id": "147fbc1a-6763-3ee6-93ed-5da28b03f93b",
                        "glosses": [
                            "een smakelijk maar weinig voedzaam gerechtje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87bf515f-545e-4b6a-9277-1df875d4a31c",
                                "sense_id": "4ef2d838-ce36-3457-877a-21646352ee44",
                                "text": "Kerst is voor veel mensen de tijd van overdadig eten - dat is nu eenmaal de traditie. En omdat we hard op weg zijn naar de appelflappen en oliebollen, beperken sommige huishoudens zich momenteel tot kliekjes en liflafjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0af43ed-e9b8-3635-9a0b-711e6b1aee5b",
                        "entry_id": "147fbc1a-6763-3ee6-93ed-5da28b03f93b",
                        "glosses": [
                            "een aardig maar overbodig iets"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b4fa9e18-2eea-4bc2-a1d5-0868933444ac",
                                "sense_id": "c0af43ed-e9b8-3635-9a0b-711e6b1aee5b",
                                "text": "De musici brachten het er, na slechts een week repeteren, prima vanaf. Maar het programma was divers en ontbeerde artistieke eenheid: licht verteerbare klassieke liflafjes van Berlioz, Britten, Strauss en Stravinsky stonden naast nieuwe werken en een didgeridoo solo."
                            }
                        ]
                    }
