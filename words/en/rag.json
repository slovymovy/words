{
    "word_family": [
        "ragged",
        "raggedly",
        "raggedness",
        "ragman",
        "ragtime",
        "ragamuffin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1308e8f-a8ab-3e0a-b737-36d24f8c53fe",
                    "sense_definition": "Tattered or worn-out clothing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poor man had nothing to wear but his <w>rags</w>.",
                            "target_lang_translations": {
                                "ru": "Бедняку нечего было носить, кроме своих <w>лохмо́тьев</w>."
                            }
                        },
                        {
                            "text": "He went from <w>rags</w> to riches after his business became successful.",
                            "target_lang_translations": {
                                "ru": "Он прошел путь от <w>нищеты́</w> до богатства после того, как его бизнес стал успешным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in rags"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно изношенная, рваная одежда или лохмотья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лохмо́тья",
                                "target_lang_sense_clarification": "ветхая, изношенная одежда"
                            },
                            {
                                "target_lang_word": "тряпьё",
                                "target_lang_sense_clarification": "пренебрежительное название старой, рваной одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eecc3bff-9232-351b-b1ec-9a970ee39e5c",
                    "sense_definition": "A piece of old, torn cloth used for cleaning or wiping.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a clean <w>rag</w> to wipe the dust off the table.",
                            "target_lang_translations": {
                                "ru": "Используй чистую <w>тря́пку</w>, чтобы вытереть пыль со стола."
                            }
                        },
                        {
                            "text": "He cleaned the oil spill with an old <w>rag</w>.",
                            "target_lang_translations": {
                                "ru": "Он вытер пролитое масло старой <w>тря́пкой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cleaning rag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок старой ткани, используемый для уборки, мытья или вытирания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тря́пка",
                                "target_lang_sense_clarification": "кусок ткани для уборки или мытья"
                            },
                            {
                                "target_lang_word": "ве́тошь",
                                "target_lang_sense_clarification": "специальный термин для тряпок, используемых для протирки станков или поверхностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82efe5d2-a33d-3179-8604-eccc13d57fea",
                    "sense_definition": "A newspaper or magazine considered to be of poor quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not read that local <w>rag</w> because it is full of gossip.",
                            "target_lang_translations": {
                                "ru": "Я не читаю эту местную <w>газетёнку</w>, потому что она полна сплетен."
                            }
                        },
                        {
                            "text": "The tabloid is just a sensationalist <w>rag</w> with no real news.",
                            "target_lang_translations": {
                                "ru": "Этот таблоид — просто сенсационная <w>газетёнка</w> без реальных новостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "fish wrap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a derogatory way."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Газета или журнал низкого качества, часто с сомнительным содержанием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтая пре́сса",
                                "target_lang_sense_clarification": "пренебрежительное название бульварных изданий"
                            },
                            {
                                "target_lang_word": "газетёнка",
                                "target_lang_sense_clarification": "пренебрежительное название газеты низкого качества"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af791db3-13fa-3bfa-b7c8-6393bd8ccec0",
                    "sense_definition": "To tease, scold, or torment someone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "teasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older boys would often <w>rag</w> the new students.",
                            "target_lang_translations": {
                                "ru": "Старшеклассники часто <w>дразни́ли</w> новых учеников."
                            }
                        },
                        {
                            "text": "Stop <w>ragging</w> your brother about his new haircut.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>подка́лывать</w> брата из-за его новой стрижки."
                            }
                        }
                    ],
                    "synonyms": [
                        "beat#Verb",
                        "thrash#Verb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дразнить, подшучивать или изводить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразни́ть",
                                "target_lang_sense_clarification": "подшучивать над кем-то, вызывая раздражение"
                            },
                            {
                                "target_lang_word": "подка́лывать",
                                "target_lang_sense_clarification": "разговорное: иронично подшучивать над кем-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}