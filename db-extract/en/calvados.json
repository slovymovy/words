                    },
                    {
                        "translation_id": "91d800ce-3cf7-4877-95a3-6dad0ab8c668",
                        "source_entry_id": "d8eeb7d0-6db7-368d-8138-42bc18bfc4da",
                        "source_sense_description": "apple brandy from Normandy",
                        "target_lang_word": "calvados",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calvados",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                        "entry_id": "848327cd-855f-343c-99d0-766b8d7d0446",
                                        "glosses": [
                                            "Eau-de-vie de cidre fabriquée dans le Calvados, et plus généralement en Normandie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d94f69-e2e4-4fbb-9460-5253f937dd63",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "On trouvait le père et la mère [Prouane] en travers des portes, assommés par le calvados, la terrible eau-de-vie normande ; tandis que la petite les enjambait, pour égoutter leurs verres."
                                            },
                                            {
                                                "example_id": "17731411-831b-4264-8dbc-37e2b85b7f79",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "Jésus-la-Caille poussa la porte vitrée du bar. Il entra et, s’accoudant au comptoir, annonça qu’il boirait « un » calvados."
                                            },
                                            {
                                                "example_id": "18231eac-f1a9-48ec-a230-4dd111d49ab1",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "Le souvenir de l’énorme Mme Lebrasseur, qui mêlait aux biberons qu’elle préparait pour son dernier-né quelques gouttes de calvados, car « c’est bon pour la santé », demeure en moi indestructible. J’aime ces Normands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89e17881-c19f-4b7b-a2eb-6a484c708da1",
                        "source_entry_id": "d8eeb7d0-6db7-368d-8138-42bc18bfc4da",
                        "source_sense_description": "apple brandy from Normandy",
                        "target_lang_word": "Calvados",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Calvados",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                        "entry_id": "28cfb2b4-2d69-3698-86f2-0cd78f269d65",
                                        "glosses": [
                                            "französischer Apfelbranntwein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32040045-5491-4930-ad10-dda7c8671d1a",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Noch eine Champagnerflasche wird aufgemacht, und sogar der beste Calvados kommt auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "2861b0ed-d9f1-4a80-8865-85f1e4b1e310",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Er trank das Glas Calvados aus.“"
                                            },
                                            {
                                                "example_id": "d6a7dbe7-b3f9-44bb-a64e-65c097634d8f",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Sie tranken Calvados und spielten Schallpatten, und Chantal war in einer fast unglaublichen Weise anschmiegsam, sentimental und weich.“"
                                            },
                                            {
                                                "example_id": "ed3363fe-d7af-4310-8680-160655095907",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Dabei war er von einem halben Calvados so angeschickert, dass er bestimmt eher den Mond oder sich selbst getroffen hätte als den Laster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65014a30-9b73-40b5-b853-63e84b1cf6f0",
