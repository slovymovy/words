    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b800d02f-da19-3440-944b-b7c3dcc4a28e",
                    "sense_definition": "behoefte aan drinken, zoals water",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behoefte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling in de zon had ik enorme <w>dorst</w>.",
                            "target_lang_translations": {
                                "en": "After the long walk in the sun, I had a huge <w>thirst</w>.",
                                "ru": "После долгой прогулки на солнце у меня была ужасная <w>жажда</w>."
                            }
                        },
                        {
                            "text": "Je moet water drinken als je <w>dorst</w> hebben.",
                            "target_lang_translations": {
                                "en": "You should drink water if you are <w>thirsty</w>.",
                                "ru": "Тебе нужно пить воду, если ты <w>хочешь пить</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dorst hebben",
                        "lessen van dorst"
                    ],
                    "target_lang_definitions": {
                        "en": "the physical need or desire to drink, especially water",
                        "ru": "физическая потребность или желание пить, особенно воду"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thirst",
                                "target_lang_sense_clarification": "the physical sensation of needing to drink"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "физическое ощущение потребности в питье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85dc76da-9bd0-3a92-ab0d-08d239907a1c",
                    "sense_definition": "een groot verlangen naar iets, zoals geld, goud of succes",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>dorst</w> naar macht was uiteindelijk zijn ondergang.",
                            "target_lang_translations": {
                                "en": "His <w>thirst</w> for power was ultimately his downfall.",
                                "ru": "Его <w>жажда</w> власти в конечном итоге стала причиной его гибели."
                            }
                        },
                        {
                            "text": "De jonge student heeft een enorme <w>dorst</w> naar kennis.",
                            "target_lang_translations": {
                                "en": "The young student has an enormous <w>thirst</w> for knowledge.",
                                "ru": "У молодого студента огромная <w>жажда</w> знаний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dorst naar macht",
                        "dorst naar kennis"
                    ],
                    "target_lang_definitions": {
                        "en": "a strong desire or craving for something, such as power or knowledge",
                        "ru": "сильное желание или тяга к чему-либо, например к власти или знаниям"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thirst",
                                "target_lang_sense_clarification": "a strong figurative desire"
                            },
                            {
