                        {
                            "text": "В Великий <пост> многие люди отказываются от мяса.",
                            "target_lang_translations": {
                                "en": "During <Lent> many people give up meat.",
                                "zh": "在<w>大斋期</w>，很多人都不吃肉。"
                            }
                        }
