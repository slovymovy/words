            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e87eb87b-22be-3952-8809-979b9a2ee46a",
                    "sense_definition": "zich naar beneden bewegen of lager worden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het waterpeil in de rivier is na de droge periode enigszins <w>gedaald</w>.",
                            "target_lang_translations": {
                                "en": "The water level in the river has <w>dropped</w> slightly after the dry period.",
                                "ru": "Уровень воды в реке после засушливого периода немного <w>снизился</w>."
                            }
                        },
                        {
                            "text": "De wandelaars moesten voorzichtig de berg <w>dalen</w> om het dorp te bereiken.",
                            "target_lang_translations": {
                                "en": "The hikers had to carefully <w>descend</w> the mountain to reach the village.",
                                "ru": "Пешим туристам пришлось осторожно <w>спускаться</w> с горы, чтобы добраться до деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakken",
                        "omlaaggaan"
                    ],
                    "antonyms": [
                        "stijgen"
                    ],
                    "common_phrases": [
                        "klimmen en dalen",
                        "langzaam dalen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move downwards or to become lower",
                        "ru": "двигаться вниз или становиться ниже"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "to move from a higher to a lower position"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to fall or sink to a lower level"
                            },
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "to move downwards"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "двигаться сверху вниз"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "становиться ниже по уровню или высоте"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "перемещаться в более низкое положение"
                            }
                        ]
