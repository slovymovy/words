                                "sense_id": "90977dad-6772-32bc-b22e-75bcee47e8cc",
                                "text": "Lettres synodiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae1c9c4b-d3bc-3265-b356-aac65d5680a4",
                        "entry_id": "85ac9ace-02d1-3585-8295-15886f314147",
                        "glosses": [
                            "Qualifie le mouvement de la Lune depuis une nouvelle lune jusqu’à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "581236f8-0374-4ccc-a727-c247b3701bfc",
                                "sense_id": "ae1c9c4b-d3bc-3265-b356-aac65d5680a4",
                                "text": "Mouvement synodique, révolution synodique de la lune."
                            },
                            {
                                "example_id": "df47a8df-ddec-4cf4-9643-a951eee47e0b",
                                "sense_id": "ae1c9c4b-d3bc-3265-b356-aac65d5680a4",
                                "text": "D’ailleurs, la Lune est très compliquée. Elle est sujette à des froids glaciaux, des périodes synodiques et des chaleurs torrides, des quadratures, des conjonctions, des syzygies qui dépassent l’imagination."
                            }
                        ]
                    },
                    {
                        "sense_id": "4527a51c-1a4d-38fd-b457-f164c62e68bc",
                        "entry_id": "85ac9ace-02d1-3585-8295-15886f314147",
                        "glosses": [
                            "Qualifie le mois astronomique qui s’écoule entre deux nouvelles lunes consécutives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02bad9e4-11f9-4cca-9ec5-b8f1eb8a114e",
                                "sense_id": "4527a51c-1a4d-38fd-b457-f164c62e68bc",
                                "text": "Le mois synodique est plus court que le mois calendaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eff9277-2dd9-376e-9e78-47f3492fbe21",
                        "entry_id": "85ac9ace-02d1-3585-8295-15886f314147",
                        "glosses": [
                            "Qualifie l'année astronomique qui ramène la terre à une même longitude avec une planète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40ab2f6-3b6f-43ca-bb26-a199aa89fa94",
                                "sense_id": "3eff9277-2dd9-376e-9e78-47f3492fbe21",
                                "text": "Année synodique."
                            }
                        ]
                    }
                ],
