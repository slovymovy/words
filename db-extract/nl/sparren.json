                        "entry_id": "f890a5ad-9136-3d5c-9d49-98156253e9c8",
                        "glosses": [
                            "met een tegenstander oefenen (zonder door te stoten), trainen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "41b94a3e-15ca-4a8b-b605-f63732dfd948",
                                "sense_id": "19ec4cc2-b1c9-3160-83a7-816880100810",
                                "text": "Omdat ze ooit een beginnerscursus judo deed en de testosteronspiegel van de Hulk heeft vindt ze zichzelf onverwoestbaar en zo’n fictie is prima in stand te houden zolang je niet gaat sparren met iemand als haar bootcamptrainer, die al twintig jaar aan mixed martial arts doet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2546122c-10a8-3bf5-8f59-f21a35dfaa27",
                        "entry_id": "f890a5ad-9136-3d5c-9d49-98156253e9c8",
                        "glosses": [
                            "informeel met iemand overleggen over voors en tegens van mogelijke oplossingen"
                        ],
                        "tags": [
                            "figuratively",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "b70d6ac8-83de-4418-9fdf-76fcd534024b",
                                "sense_id": "2546122c-10a8-3bf5-8f59-f21a35dfaa27",
                                "text": "Docenten zijn vaak nog in de avonduren werk aan het nakijken, waarover ze misschien willen sparren met collega’s."
                            }
                        ]
                    }
