                    },
                    {
                        "form_id": "82daa118-aa43-4972-abbc-2a8440b3da23",
                        "entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "tags": [
                            "adverbial",
                            "participle",
                            "present"
                        ],
                        "form": "лосня́сь"
                    },
                    {
                        "form_id": "af60795e-80c7-4ce3-9d89-95f0ac8824fa",
                        "entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "лосни́вшись"
                    },
                    {
                        "form_id": "404a4ccd-ed4d-4cbe-b8cc-7833a5bb66bd",
                        "entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… лосни́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2620d9d-2765-3d28-9d67-267fec44f1a5",
                        "entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "glosses": [
                            "блестеть, отсвечивать"
                        ],
                        "tags": [
                            "о гладкой поверхности"
                        ],
                        "examples": [
                            {
                                "example_id": "a107003f-82b5-44a1-85ce-a64f3cd10aa0",
                                "sense_id": "b2620d9d-2765-3d28-9d67-267fec44f1a5",
                                "text": "Ржи были высоки, зыблились, лоснились, только кое-где синели васильки в них."
                            },
                            {
                                "example_id": "1cc9dcb0-b427-4dc4-a57c-35ec8b18353d",
                                "sense_id": "b2620d9d-2765-3d28-9d67-267fec44f1a5",
                                "text": "Он был высокого роста; редкие волосы покрывали его голову, коей обнажённое темя лоснилось…"
                            },
                            {
                                "example_id": "b34eb85b-ccd7-4c47-8116-bd292bda30e7",
                                "sense_id": "b2620d9d-2765-3d28-9d67-267fec44f1a5",
                                "text": "Шерсть на ней так и лоснилась: видно было, что её недавно вычесали."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d8a5c72-2544-31c9-959e-2b1879c8583c",
                        "entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "glosses": [
                            "становиться блестящим от долгого употребления, загрязнения чем-либо жирным, маслянистым"
                        ],
                        "tags": [
                            "об одежде"
                        ],
                        "examples": [
                            {
                                "example_id": "184a65d2-e2ad-4997-bb3e-3535176db624",
                                "sense_id": "2d8a5c72-2544-31c9-959e-2b1879c8583c",
                                "text": "Фрак у Ивана Яковлевича (Иван Яковлевич никогда не ходил в сюртуке) был пегий; то есть он был черный, но весь в коричнево-жёлтых и серых яблоках; воротник лоснился, а вместо трех пуговиц висели одни только ниточки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dd5467e-5664-44fe-bf6f-a1d5f0e8ee75",
                        "source_entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "target_lang_word": "glänzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glänzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95e8d580-ae66-39d3-b0db-0a7f8bd48104",
                                        "entry_id": "eca0ae44-45be-33f3-b50a-b6a862381296",
                                        "glosses": [
                                            "eine reflektierende Oberfläche haben, schimmern; schillern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c94df1-a7ef-445b-b09e-8c84f722ce05",
                                                "sense_id": "95e8d580-ae66-39d3-b0db-0a7f8bd48104",
                                                "text": "Ein Lack, der nicht glänzt, ist matt."
                                            },
                                            {
                                                "example_id": "1c2fee1c-0cc5-4869-acee-13da8c582e28",
                                                "sense_id": "95e8d580-ae66-39d3-b0db-0a7f8bd48104",
                                                "text": "Die goldenen Münzen glänzen in der Sonne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02d65902-3a04-3578-8e9f-af889b51ad38",
                                        "entry_id": "eca0ae44-45be-33f3-b50a-b6a862381296",
                                        "glosses": [
                                            "eine hervorragende Leistung erbringen, brillieren, sich durch etwas hervortun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963ad4e0-bd5c-4e86-8ade-9fe674884046",
                                                "sense_id": "02d65902-3a04-3578-8e9f-af889b51ad38",
                                                "text": "Statt sich an der Diskussion zu beteiligen, glänzte er durch seine Abwesenheit."
                                            },
                                            {
                                                "example_id": "c5d42c63-cece-408e-994a-5ca1e4957443",
                                                "sense_id": "02d65902-3a04-3578-8e9f-af889b51ad38",
                                                "text": "Mit dem Tor in der 22. Minute konnte die Mannschaft glänzen."
                                            },
                                            {
                                                "example_id": "57b8a82d-79b3-45ac-a4e4-ca37ac7a6568",
                                                "sense_id": "02d65902-3a04-3578-8e9f-af889b51ad38",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "e8a5b714-a748-42ca-8ab7-7e88a9e92363",
                                                "sense_id": "02d65902-3a04-3578-8e9f-af889b51ad38",
                                                "text": "Wenn ein Schachspieler matt ist, glänzt er nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
