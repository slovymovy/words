                "senses": [
                    {
                        "sense_id": "8c220935-e08d-36b1-8da9-57d8d1c95789",
                        "entry_id": "e33d3a83-e89f-39be-a783-c2c4639ec46c",
                        "glosses": [
                            "Plante de la famille des astéracées composé d’environ 200 espèces d’annuelles, de bisannuelles et de vivaces, poussant dans les prairies sèches et les zones montagneuses, particulièrement en Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb11af9-5c13-40e5-9986-c4df9527428b",
                                "sense_id": "8c220935-e08d-36b1-8da9-57d8d1c95789",
                                "text": "On revient, avec encore plus d’épervière, érigéron, gaillet, muguet, brassica."
                            },
                            {
                                "example_id": "72bef9f8-8175-4e01-ae01-8f8c8a475ee2",
                                "sense_id": "8c220935-e08d-36b1-8da9-57d8d1c95789",
                                "text": "Elle pousse en abondance, mêlée aux armoises, aux orties, aux chénopodes, aux amarantes et aux érigérons dans les terrains vagues, les jachères, les décharges publiques."
                            }
                        ]
                    }
