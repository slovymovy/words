                "senses": [
                    {
                        "sense_id": "5f995456-4d1b-39e9-b5b6-6f649cb3c1e0",
                        "entry_id": "7a9c9389-9226-3fbc-811b-bfe27750c7a0",
                        "glosses": [
                            "Bosser, travailler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67868b9-a3ad-4926-b205-bb6362708db3",
                                "sense_id": "5f995456-4d1b-39e9-b5b6-6f649cb3c1e0",
                                "text": "Je l’entraînai loin des oreilles indiscrètes et lui expliquai qu’elle pourrait rester ici, bossailler dans les spermes clapotants, répandre des boissons et des faux parfums, pour ses plus extraordinaires profits : « Certain qu’elle va te rapporter pendant au moins trois ans ! »"
                            },
                            {
                                "example_id": "8a4ed8fd-4b2e-4962-9281-515c21284631",
                                "sense_id": "5f995456-4d1b-39e9-b5b6-6f649cb3c1e0",
                                "text": "Bon yop, j’m’en vas bossailler moi"
                            },
                            {
                                "example_id": "227ebd56-8571-4589-9a78-5515dcf11449",
                                "sense_id": "5f995456-4d1b-39e9-b5b6-6f649cb3c1e0",
                                "text": "SVP faites-en une backing track et je la bossaille correct à l’accordéon sur votre interprétation deux grattes et une basse feraient l’affaire"
                            },
                            {
                                "example_id": "ccf967b1-092e-4883-9375-7c62ca64bd05",
                                "sense_id": "5f995456-4d1b-39e9-b5b6-6f649cb3c1e0",
                                "text": "Bonne nouvelle, pendant leurs vacances, les Français \"bossaillent un peu\"."
                            }
                        ]
                    }
                ],
