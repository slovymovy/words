{
    "word_family": [
        "floppen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd6e7fb1-410e-3d10-b6cf-2f3c66235211",
                    "sense_definition": "Een mislukking of iets dat niet volgens plan is verlopen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mislukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe film van de regisseur werd een enorme <w>flop</w> in de bioscopen.",
                            "target_lang_translations": {
                                "en": "The director's new film was a huge <w>flop</w> in cinemas."
                            }
                        },
                        {
                            "text": "Het evenement was helaas een grote <w>flop</w> door het slechte weer.",
                            "target_lang_translations": {
                                "en": "The event was unfortunately a big <w>flop</w> due to the bad weather."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiasco",
                        "mislukking",
                        "sof"
                    ],
                    "common_phrases": [
                        "complete flop",
                        "financiële flop"
                    ],
                    "target_lang_definitions": {
                        "en": "A failure or something that did not go according to plan."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flop",
                                "target_lang_sense_clarification": "a total failure, especially of a film or show"
                            },
                            {
                                "target_lang_word": "fiasco",
                                "target_lang_sense_clarification": "a complete and embarrassing failure"
                            },
                            {
                                "target_lang_word": "dud",
                                "target_lang_sense_clarification": "something that fails to work properly or is a failure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfcf512c-c34b-39e6-b715-d0a62c74163c",
                    "sense_definition": "Een verouderd opslagmedium voor computers, ook wel diskette genoemd.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger bewaarden we al onze bestanden op een <w>flop</w>.",
                            "target_lang_translations": {
                                "en": "We used to save all our files on a <w>floppy disk</w>."
                            }
                        },
                        {
                            "text": "Ik vond in de kast nog een oude <w>flop</w> met documenten uit de jaren negentig.",
                            "target_lang_translations": {
                                "en": "I found an old <w>floppy disk</w> in the cupboard with documents from the nineties."
                            }
                        }
                    ],
                    "synonyms": [
                        "diskette"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Verwijst naar verouderde computertechnologie."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An outdated computer storage medium, also known as a floppy disk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "floppy disk",
                                "target_lang_sense_clarification": "a flexible magnetic disk for storing computer data"
                            }
                        ]
                    }
                }
            ]
        },
        {
