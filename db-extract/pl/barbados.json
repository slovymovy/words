                                                "sense_id": "e0ab2114-0f51-35a8-be9b-4eec26386f71",
                                                "text": "Bridgetown ist die Hauptstadt von Barbados."
                                            },
                                            {
                                                "example_id": "b2e3c6b0-ac04-4c6c-b17b-3b16d198e619",
                                                "sense_id": "e0ab2114-0f51-35a8-be9b-4eec26386f71",
                                                "text": "„Das Klima von Barbados ist ganzjährig warm mit geringen Temperaturunterschieden und einem Jahresmittel von 26° Celsius.“"
                                            },
                                            {
                                                "example_id": "94b27b5e-446f-47e4-9659-ee0ddee686f6",
                                                "sense_id": "e0ab2114-0f51-35a8-be9b-4eec26386f71",
                                                "text": "Wenn man das Barbados der Einheimischen kennenlernen möchte, sollte man außerhalb der Städte suchen."
                                            },
                                            {
                                                "example_id": "63dbf18a-627e-48cb-930d-4b23d90d7cb6",
                                                "sense_id": "e0ab2114-0f51-35a8-be9b-4eec26386f71",
                                                "text": "„Er besaß zudem selbst eine Plantage auf Barbados und war an einer Londoner Zuckerraffinerie beteiligt.“"
                                            }
