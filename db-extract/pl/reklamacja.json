                                "target_senses": [
                                    {
                                        "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "The act of complaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7bbb8d-cb6c-41f8-b3a7-54949c2b5b35",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "customer complaints"
                                            },
                                            {
                                                "example_id": "39915696-1c7d-4a3e-a049-bb8c72bce35b",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "noise complaints"
                                            },
                                            {
                                                "example_id": "e32e11cf-072e-48bb-b5c9-674a6049f35d",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "file complaints"
                                            },
                                            {
                                                "example_id": "9502a581-463e-4db5-aac0-b810a841b18e",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "The company received numerous complaints about the product."
                                            },
                                            {
                                                "example_id": "ab871c97-3c9e-401d-83d6-889b37f18fc0",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "He filed complaints with the housing authority."
                                            },
                                            {
                                                "example_id": "b431d094-92b1-4566-a851-294c3b904fab",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "Complaints have risen in particular from passengers changing trains, who have observed little or no improvement in their ability to navigate between the station's 13 platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "A grievance, problem, difficulty, or concern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9945dc4c-16bc-46f8-aa7d-4544e8cb4ec0",
                                                "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                                "text": "I have no complaints about the quality of his work, but I don't enjoy his company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e463f31c-2b18-3adb-983b-f2dde912c82a",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "In a civil action, the first pleading of the plaintiff setting out the facts on which the claim is based."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e04f556-0304-3958-9e08-c01162ed4bfc",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "In criminal law, the preliminary charge or accusation made by one person against another to the appropriate court or officer, usually a magistrate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93892e42-f94d-3429-990d-52bb94eb728f",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "A bodily disorder or disease; the symptom of such a disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a9a44a-d6a9-418a-8a6a-a52d888f82a0",
                                                "sense_id": "93892e42-f94d-3429-990d-52bb94eb728f",
                                                "text": "Don't come too close; I've got this nasty complaint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "275171d0-371d-473a-841d-cc3ce58d6fa4",
                        "source_entry_id": "476902b0-4dd9-37c8-9d69-7848569942b3",
                        "source_sense_id": "a3eee4a2-03c2-3028-803d-966fa0c063f9",
