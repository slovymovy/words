                "senses": [
                    {
                        "sense_id": "74fce465-1fbc-370d-9539-6a0de65fd2ce",
                        "entry_id": "53c70b70-8db2-3dbe-b0cd-2c2508390e24",
                        "glosses": [
                            "Celui qui quête, qui cherche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b9c213-3a7f-4e7d-a9ef-a3957aca5122",
                                "sense_id": "74fce465-1fbc-370d-9539-6a0de65fd2ce",
                                "text": "Son chapeau, son manteau, sa robe, tous ses ajustements étaient d’une élégance délicate, intime, faite pour la joie d’un seul, pour la gaîté d’une maison solidement verrouillée, fermée aux quêteurs de proies impures…"
                            },
                            {
                                "example_id": "e5418aeb-e8d6-4796-bfd2-d81a80fbcd91",
                                "sense_id": "74fce465-1fbc-370d-9539-6a0de65fd2ce",
                                "text": "L’accès de l’immeuble est formellement interdit aux représentants, quêteurs et démonstrateurs."
                            },
                            {
                                "example_id": "18ce138b-7d68-45ce-94a1-37834e2f47a6",
                                "sense_id": "74fce465-1fbc-370d-9539-6a0de65fd2ce",
                                "text": "\"Aucun quêteur ne fait de vieux os\", c’était une phrase qu’on entendait souvent au Caveau. Comme toute formule, c’était une généralisation, mais en gros elle tapait dans le mille."
                            }
                        ]
                    }
                ],
