                        "entry_id": "2626e3e7-1271-3618-978d-fd664f0fd721",
                        "glosses": [
                            "Agent de la fonction publique ou du privé travaillant dans le milieu hospitalier, sanitaire et social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45352875-69b2-4d45-8d4b-164e3efa039f",
                                "sense_id": "7e45781e-9cbe-3e9a-917a-7171abf07d17",
                                "text": "L’ASH en milieu hospitalier exécute l’entretien courant des services de soins ainsi que les opérations de décontamination et de désinfection."
                            },
                            {
                                "example_id": "7400a0f9-0992-4c01-8b3a-7305fc2e9ec5",
                                "sense_id": "7e45781e-9cbe-3e9a-917a-7171abf07d17",
                                "text": "C’est le médecin urgentiste Wahid Mouhid qui dirige la structure : « On est quatre à travailler ici. Il y a une infirmière, une admissionniste, une ASH [agent de service hospitalier, NDLR] et moi-même. Le personnel tourne tout l’été avec de nouvelles équipes fréquemment. »"
                            }
                        ]
                    }
