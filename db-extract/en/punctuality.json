                                        "glosses": [
                                            "de eigenschap om afspraken nauwgezet na te komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "812ac594-d4b4-451f-a620-8c1737b5e80b",
                                                "sense_id": "a9480b95-70a4-3fe4-9ae7-cf7df85a7bb1",
                                                "text": "Zijn stiptheid is spreekwoordelijk."
