                "senses": [
                    {
                        "sense_id": "514b69b9-f0a7-30d1-a650-841b206efa60",
                        "entry_id": "383f8076-f543-3331-b392-f78ff88c7bc9",
                        "glosses": [
                            "To strip power from (someone or some group), as:",
                            "To remove morale or self-confidence from (someone or some group) to do something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc15258-8eb6-418c-bfdc-46f0eb1df78f",
                                "sense_id": "514b69b9-f0a7-30d1-a650-841b206efa60",
                                "text": "A powerful head can sometimes disempower the teaching staff, and create among them a sort of passivity that is close to inertia."
                            }
                        ]
                    },
                    {
                        "sense_id": "f33a1806-bca2-330a-b669-01e3af4fa295",
                        "entry_id": "383f8076-f543-3331-b392-f78ff88c7bc9",
                        "glosses": [
                            "To strip power from (someone or some group), as:",
                            "To remove authority or (official) confidence from (someone or some group) to do something (such as administer a state function), as by demoting, disestablishing, or unincorporating a group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d8dc35-b673-42e1-a914-2edb54a46fc5",
                                "sense_id": "f33a1806-bca2-330a-b669-01e3af4fa295",
                                "text": "The reformation disempowered the established church and thus roiled the aristocracy."
                            }
                        ]
                    }
                ],
