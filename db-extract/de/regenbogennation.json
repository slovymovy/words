                    {
                        "sense_id": "4dfbbf7d-04f4-35d8-8250-2a3f32cf43af",
                        "entry_id": "5b805762-5018-3c64-8c7f-c0373b3aa291",
                        "glosses": [
                            "nach dem Ende der Apartheid entstandener Beiname von Südafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e108e4c7-f948-49a8-95eb-5ad66df6a9e6",
                                "sense_id": "4dfbbf7d-04f4-35d8-8250-2a3f32cf43af",
                                "text": "„›Und wie glänzend Sie die Regenbogennation repräsentieren!‹, sagte Adair, der vergeblich versuchte, seine große Erleichterung hinter seinem nonchalanten Tonfall zu verbergen.“"
                            },
                            {
                                "example_id": "1605a802-dd52-4412-89b6-f8e39396b6b0",
                                "sense_id": "4dfbbf7d-04f4-35d8-8250-2a3f32cf43af",
                                "text": "„Der Fund, den sie präsentierten, war das Leiden der gesamten Bevölkerung, die kollektive Erfahrung, eine Deutung, die perfekt zum damals noch quicklebendigen Ideal einer südafrikanischen Regenbogennation passte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
