                "senses": [
                    {
                        "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                        "entry_id": "45d0ad59-afef-31d9-81d3-695a27c1abbb",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c93bcd-7202-4987-b70e-fcdf34ae4e90",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Frau Obermöller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "77c10333-149c-4310-81c2-5244659faa5d",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Herr Obermöller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b9b0adb0-eceb-4702-9512-99988ee5db4b",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Die Obermöllers fliegen heute nach London."
                            },
                            {
                                "example_id": "39d5ed58-3123-4f29-8b57-0ef0258e67d3",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Der Obermöller trägt nie die Pullover, die die Obermöller ihm strickt."
                            },
                            {
                                "example_id": "7d40e296-996e-49f6-85de-52fa5c071e37",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Obermöller kommt, geht der Herr Obermöller.“"
                            },
                            {
                                "example_id": "2597d1c9-4a81-4919-8696-15fdc9a6f103",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Obermöller kommt und geht."
                            },
                            {
                                "example_id": "8ba74c0a-5e6f-4e86-995a-e62a1ecf5c18",
                                "sense_id": "aa0fb9f3-d31a-3ea8-847f-d136a36be651",
                                "text": "Obermöllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
