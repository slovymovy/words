                "senses": [
                    {
                        "sense_id": "7868ad49-ca6f-32f7-96e7-2a304226b539",
                        "entry_id": "21576fd4-82b3-3679-aea0-7283b81447f6",
                        "glosses": [
                            "Liebe zu sich selbst; Liebe, die sich auf die eigene Person richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0ace3c-fc0b-4f63-bc0a-331bb048cd4e",
                                "sense_id": "7868ad49-ca6f-32f7-96e7-2a304226b539",
                                "text": "„Ihr Verhalten entsprang wohl nur ihrer Eigenliebe, die es nicht zuließ, daß sie meinen Sieg, der sie zu sehr demütigte, gelassen hinnahm.“"
                            },
                            {
                                "example_id": "cc24c6c9-3513-4263-b682-6a71d27ffdcd",
                                "sense_id": "7868ad49-ca6f-32f7-96e7-2a304226b539",
                                "text": "„Im Gegensatz zu den meisten nicht ganz gedankenlosen Menschen sind Selbstverachtung und Eigenliebe mir gleichermaßen fremd.“"
                            },
                            {
                                "example_id": "2dd39ce2-3d4e-4a1b-af82-b79bef88df0d",
                                "sense_id": "7868ad49-ca6f-32f7-96e7-2a304226b539",
                                "text": "„Es war dieselbe Eigenliebe für seine einmal angenommene Meinung, die seinen Mund verschloß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
