                "senses": [
                    {
                        "sense_id": "bbc96c32-54e9-3da4-9575-28509deedcfa",
                        "entry_id": "97594054-4059-3dcb-99df-53534f06c924",
                        "glosses": [
                            "donkere onweerswolken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf64f25-1438-4d5a-a85c-b14a6d2794f9",
                                "sense_id": "bbc96c32-54e9-3da4-9575-28509deedcfa",
                                "text": "Kijk omhoog en je ziet ze in allerlei soorten: witte donswolken, grijze sliertwolken, dreigende donderkoppen. Maar hoe ontstaan wolken? Dat onderzoek je in deze proef."
                            }
                        ]
                    },
                    {
                        "sense_id": "de999ef4-113b-38fb-be7a-f71960f5f0c3",
                        "entry_id": "97594054-4059-3dcb-99df-53534f06c924",
                        "glosses": [
                            "menselijk hoofd met een zeer kwade gezichtsuitdrukking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887f7287-f290-4a69-8cf4-9468b0efaa76",
                                "sense_id": "de999ef4-113b-38fb-be7a-f71960f5f0c3",
                                "text": "Mijn hoofd moet ogen als een heuse donderkop. En dat helpt."
                            },
                            {
                                "example_id": "dc418cb8-8c35-40da-a9bf-c7ebd0f998f2",
                                "sense_id": "de999ef4-113b-38fb-be7a-f71960f5f0c3",
                                "text": "Ook de vent Marsman was als een oudere broer. Op foto's bewonderde ik zijn heersersgelaat, dat in mijn verbeelding iets marmerachtigs had, nog geaccentueerd door het zwart-wit waarin het interbellum zich nu eenmaal afspeelde: hij had een blik die wetten scheen uit te vaardigen, onder een donderkop van haar."
                            }
                        ]
                    },
                    {
                        "sense_id": "03581bc3-7436-36f6-a142-7c955d753999",
                        "entry_id": "97594054-4059-3dcb-99df-53534f06c924",
                        "glosses": [
                            "larve van een pad"
                        ],
                        "tags": [
                            "hiervoor wordt meestal het verkleinwoord \\\"donderkopje\\\" gebruikt"
                        ],
                        "examples": [
                            {
                                "example_id": "d18515e3-81ad-4191-a2e9-c6a5b4009070",
                                "sense_id": "03581bc3-7436-36f6-a142-7c955d753999",
                                "text": "Bij de donderkop geeft de opdracht voor het zijwaarts bewegen van de staart ook een signaal naar de spieren in de oogkasjes, voor beweging tegen kopverschuiving in."
                            }
                        ]
                    }
                ],
