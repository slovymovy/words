                "senses": [
                    {
                        "sense_id": "2345c017-6f11-3af7-9074-58905cb96e82",
                        "entry_id": "593ac333-1a8e-31da-ae81-dcfe51e3f8ff",
                        "glosses": [
                            "przyrządzony z szynki, z dodatkiem szynki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2053fab-f174-4e8a-bde2-89faf55aab9f",
                                "sense_id": "2345c017-6f11-3af7-9074-58905cb96e82",
                                "text": "W jej przekroju widoczne są jasne kawałki mięsa szynkowego, otoczone ciemniejszym farszem mięsnym."
                            },
                            {
                                "example_id": "d07ee01b-5ebf-43ab-adf5-e9331f36535c",
                                "sense_id": "2345c017-6f11-3af7-9074-58905cb96e82",
                                "text": "Bardzo niemile widziane są za to aromaty takie jak warzywne, selerowe czy szynkowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fafc7ad7-cc60-3a84-8264-d7a8bf8526a5",
                        "entry_id": "593ac333-1a8e-31da-ae81-dcfe51e3f8ff",
                        "glosses": [
                            "odnoszący się do szynku, związany z szynkiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93210748-3410-45a1-9e43-fa707ee6e865",
                                "sense_id": "fafc7ad7-cc60-3a84-8264-d7a8bf8526a5",
                                "text": "Z sieni wchodziło się do kuchni, izby z kominkiem, izby szynkowej oraz do obszernej piwnicy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
