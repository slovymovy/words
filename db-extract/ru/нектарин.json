                                        "glosses": [
                                            "Variedad del melocotón. Tiene la piel lisa y sin pelusa. El árbol se llama el nectarino."
                                        ],
                                        "tags": [
                                            "Frutos"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c727f6-a9cf-4b67-9631-cc1bc1ceb151",
                                                "sense_id": "9e06244b-8f47-3e0b-9388-27943c364951",
                                                "text": "El sabor de la nectarina es muy parecido al melocotón."
                                            }
                                        ],
