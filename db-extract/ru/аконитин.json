                    {
                        "translation_id": "a11aa92e-b819-4a5f-b00d-38d187a35f29",
                        "source_entry_id": "aef7d971-0d6b-3eab-9e9c-a6155350914e",
                        "source_sense_id": "5aa6ef4d-1286-32cd-a2a6-f049896c8e01",
                        "target_lang_word": "aconitine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aconitine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "684ab871-be5e-3ace-8215-85d7b27008bf",
                                        "entry_id": "1a7ef942-5b20-317d-8946-79c097d1de6f",
                                        "glosses": [
                                            "Pseudo-alcaloïde neurotoxique trouvé chez plusieurs espèces du genre Aconitum, principalement l’aconit napel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97d7233-9239-4997-bf82-283b04f4f632",
                                                "sense_id": "684ab871-be5e-3ace-8215-85d7b27008bf",
                                                "text": "L'aconitine est facilement absorbée par les muqueuses et par contact cutané."
                                            },
                                            {
                                                "example_id": "364bf2ab-7f76-43f2-9444-919060709fff",
                                                "sense_id": "684ab871-be5e-3ace-8215-85d7b27008bf",
                                                "text": "J’avais conseillé à Costa de Beauregard, pendant que le vicomte bomberait le torse, une sournoise piqûre d’aconitine sous le sternum de soie ocellé. Il hésita devant un tel forfait, cependant si légitime, et préféra quitter ce monde terraqué."
                                            },
                                            {
                                                "example_id": "9617f938-f269-456d-bc87-56dcf75e68a9",
                                                "sense_id": "684ab871-be5e-3ace-8215-85d7b27008bf",
                                                "text": "Darquey, le pharmacien, lui avait montré deux de ses ordonnances falsifiées : à la première une main criminelle avait ajouté : Liqueur de Fowler ; sur l’autre figuraient d’assez fortes doses de chloroforme, de digitaline, d’aconitine."
                                            },
                                            {
                                                "example_id": "90706ebd-10e1-473d-8538-44a3b54dcff8",
                                                "sense_id": "684ab871-be5e-3ace-8215-85d7b27008bf",
                                                "text": "Tous les organes de la plante, mais surtout les racines et les graines, renferment des alcaloïdes diterpéniques dont le principal est l'aconitine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
