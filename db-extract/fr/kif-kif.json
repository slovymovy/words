                        "sense_id": "a7b5862f-a1e2-3bd7-bc0c-c341d32b9257",
                        "entry_id": "d17f8e33-1778-3e69-89d5-ed9268aec91a",
                        "glosses": [
                            "Pareil ; la même chose."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ddc2f673-3a28-46af-8cd7-96422e23c3a9",
                                "sense_id": "a7b5862f-a1e2-3bd7-bc0c-c341d32b9257",
                                "text": "— Bavarois ou Prussien, c’est kif-kif et je m’en bats la paupière avec une petite patte d’anguille."
                            },
                            {
                                "example_id": "56843b0c-751f-4f30-b4d3-de2cb379b42e",
                                "sense_id": "a7b5862f-a1e2-3bd7-bc0c-c341d32b9257",
                                "text": "– Bah, dit Marcelin, il faut ne s’être jamais battu dans la forêt de par ici pour ignorer que les mitrailleuses ou rien, c’est kif-kif."
                            },
                            {
                                "example_id": "a9af6343-b843-40a1-973f-02431cdf7663",
                                "sense_id": "a7b5862f-a1e2-3bd7-bc0c-c341d32b9257",
                                "text": "Pour breuvage, du thé ; kif-kif la cour d’Angleterre."
                            }
                        ]
                    }
                ],
