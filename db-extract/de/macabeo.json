                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c318c5f-4769-4358-ae42-019c02d5ee8a",
                                "sense_id": "97d60cdc-d6a8-3258-bd6b-d48e680b7c0c",
                                "text": "„Überall in den Supermärkten […] findet man Cava, Spaniens Antwort auf den Champagner. […] Der neutrale Macabeo beherrscht die meisten Cava-Mischungen; der späte Austrieb der Sorte verspricht gute Sicherheit gegen Spätfröste in den recht kühlen Weinbergen von Penedès.“"
                            }
                        ],
