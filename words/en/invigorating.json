                    "sense_id": "939f0100-7797-325a-8157-cbb5bbd9741a",
                    "sense_definition": "Making someone feel fresh, healthy, and full of energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A brisk walk in the cold morning air can be very <w>invigorating</w>.",
                            "target_lang_translations": {
                                "tr": "Soğuk sabah havasında yapılan tempolu bir yürüyüş çok <w>canlandırıcı</w> olabilir."
                            }
                        },
                        {
                            "text": "She took an <w>invigorating</w> shower to wake herself up before the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantıdan önce uyanmak için <w>canlandırıcı</w> bir duş aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "refreshing",
                        "stimulating",
                        "energizing"
                    ],
                    "antonyms": [
                        "tiring",
                        "draining",
                        "exhausting"
                    ],
                    "common_phrases": [
                        "invigorating walk",
                        "invigorating effect",
                        "invigorating breeze"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin kendini zinde, sağlıklı ve enerji dolu hissetmesini sağlayan; canlandırıcı."
                    },
                    "translations": {
