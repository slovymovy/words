                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e82fe7c-5f56-4d25-9ab3-c9e8317d9c86",
                        "source_entry_id": "e105dfa0-aad2-3533-a78c-6d841cb3cf48",
                        "source_sense_id": "48dc0d30-eeb0-3cda-a824-ed78e3083592",
                        "source_sense_description": "weibliche Person, die in einem Dorf lebt",
                        "target_lang_word": "villageoise",
