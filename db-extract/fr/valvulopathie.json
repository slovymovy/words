                "senses": [
                    {
                        "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                        "entry_id": "9f8adc99-2762-3951-9ac4-aab20a29aaf5",
                        "glosses": [
                            "Maladie des valves du cœur."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "adc5bb55-aa07-4f3e-bcf1-df72b0e45de8",
                                "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                                "text": "Valvulopathie mitrale, valvulopathie aortique."
                            },
                            {
                                "example_id": "e4a9dc3b-4d91-4405-ac08-e058721ece7d",
                                "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                                "text": "L'avocate de Servier, Nathalie Carrère, nous déclarait encore récemment qu'« aucun lien de causalité directe et certain n'a été démontré » entre la valvulopathie et le Mediator."
                            },
                            {
                                "example_id": "bd684313-7557-41b6-9ee3-af45388f767b",
                                "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                                "text": "« Jusqu'à 2008, aucun cas de décès par valvulopathie avec le Mediator n'était signalé », dit-il."
                            },
                            {
                                "example_id": "7dac34b3-05ff-4d67-9a07-9f7d88084a2f",
                                "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                                "text": "En 2007, l'un d'entre eux apprend, lors d'un congrès, qu'une pneumologue brestoise, Irène Frachon, travaille sur des cas de valvulopathie apparemment liés au Mediator."
                            },
                            {
                                "example_id": "41e2a8dd-f55a-41f9-8867-d06ea3cf9f04",
                                "sense_id": "7b59dd56-6a02-340b-84fc-e8c1deb5ce2c",
                                "text": "Pour les personnes présentant une valvulopathie et ayant pris Mediator (benfluorex), plusieurs possibilités de recours sont possibles, rappelle l'APM."
                            }
                        ]
                    }
                ],
