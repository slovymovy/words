                        "sense_id": "b4bad929-e87d-3c4c-98a4-1e68720c2dde",
                        "entry_id": "9138000d-4ed3-3b47-80b6-74d9e9eec092",
                        "glosses": [
                            "Nahrungsmittel aus Dörrfleisch und Fett, das bei den Indianern Nordamerikas vor allem als Reiseproviant verbreitet war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0f199e-6bf0-45bf-98d0-64739bbf67ae",
                                "sense_id": "b4bad929-e87d-3c4c-98a4-1e68720c2dde",
                                "text": "„Am Ufer fanden wir große Mengen wilder Zwiebeln, die unserem Pemmikan zwar einen besseren Geschmack geben konnten, aber auf unsere schwindenden Vorräte keinen erwähnenswerten Einfluß hatten.“"
                            },
                            {
                                "example_id": "e86e22be-8c40-43bd-8a33-4751ee0c1012",
                                "sense_id": "b4bad929-e87d-3c4c-98a4-1e68720c2dde",
                                "text": "„Blank verbrachte den Rest des Tages damit, Pemmikan herzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14cb7e1d-3d8e-4415-95ec-bbadcd8a3aa2",
