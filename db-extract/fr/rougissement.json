                                                "sense_id": "75cc82e0-f6fa-3143-86b6-83d3b395ca29",
                                                "text": "The cold weather caused some cheek reddening and some nose running."
                                            },
                                            {
                                                "example_id": "f90c914b-7b7a-4a62-94a4-4f9e2e7bb9b4",
                                                "sense_id": "75cc82e0-f6fa-3143-86b6-83d3b395ca29",
                                                "text": "There was some noticeable reddening in her cheeks when she had been drinking."
                                            }
