{
    "word_family": [
        "champion",
        "championship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "004bb567-f5d0-3ceb-bdd6-2ed992c33953",
                    "sense_definition": "A short form of <w>champion</w>, referring to a winner of a competition or a highly skilled person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "champion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reigning <w>champ</w> waved to the crowd after winning the match.",
                            "target_lang_translations": {
                                "ru": "Действующий <w>чемпион</w> помахал толпе после победы в матче.",
                                "zh": "比赛获胜后，这位卫冕<w>冠军</w>向观众挥手致意。",
                                "es": "El <w>campeón</w> vigente saludó a la multitud tras ganar el partido."
                            }
                        },
                        {
                            "text": "He is the undisputed world <w>champ</w> in heavyweight boxing.",
                            "target_lang_translations": {
                                "ru": "Он бесспорный <w>чемпион</w> мира по боксу в тяжелом весе.",
                                "zh": "他是重量级拳击界无可争议的世界<w>冠军</w>。",
                                "es": "Es el <w>campeón</w> mundial indiscutible de boxeo de peso pesado."
                            }
                        }
                    ],
                    "antonyms": [
                        "loser"
                    ],
                    "common_phrases": [
                        "world champ",
                        "defending champ"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of champion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"champion\" (чемпион), обозначающее победителя соревнования или высококвалифицированного человека.",
                        "zh": "“Champion”的缩写，指比赛的获胜者或非常擅长某事的人。",
                        "es": "Forma abreviada de \"campeón\", que se refiere al ganador de una competición o a una persona altamente cualificada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемпион",
                                "target_lang_sense_clarification": "победитель"
                            },
                            {
                                "target_lang_word": "чемп",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冠军",
                                "target_lang_sense_clarification": "比赛获胜者"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "campeón",
                                "target_lang_sense_clarification": "ganador de una competición"
                            },
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "persona muy hábil o talentosa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0824442c-197e-35d6-acaf-899962bb4604",
                    "sense_definition": "A friendly or sometimes patronizing term of address for a man or boy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "champion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>champ</w>, are you ready for your first day of school?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>чемпион</w>, ты готов к первому дню в школе?",
                                "zh": "嘿，<w>小伙子</w>，准备好迎接开学第一天了吗？",
                                "es": "Hola <w>campeón</w>, ¿estás listo para tu primer día de escuela?"
                            }
                        },
                        {
                            "text": "Don't worry about the mistake, <w>champ</w>, you will do better next time.",
                            "target_lang_translations": {
                                "ru": "Не переживай из-за ошибки, <w>чемпион</w>, в следующий раз получится лучше.",
                                "zh": "别为那个错误担心，<w>小伙子</w>，下次你会做得更好。",
                                "es": "No te preocupes por el error, <w>campeón</w>, lo harás mejor la próxima vez."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hey champ"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеское или иногда снисходительное обращение к мужчине или мальчику.",
                        "zh": "对男性或男孩的一种友好或有时带有屈尊意味的称呼。",
                        "es": "Término de dirección amistoso o a veces condescendiente hacia un hombre o un niño."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемпион",
                                "target_lang_sense_clarification": "обращение"
                            },
                            {
                                "target_lang_word": "дружище",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冠军",
                                "target_lang_sense_clarification": "对男性的称呼"
                            },
                            {
                                "target_lang_word": "小伙子",
                                "target_lang_sense_clarification": "对年轻男性的亲昵称呼"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "campeón",
                                "target_lang_sense_clarification": "término de cariño o ánimo"
                            },
                            {
                                "target_lang_word": "fiera",
                                "target_lang_sense_clarification": "término coloquial de ánimo"
                            },
                            {
                                "target_lang_word": "chaval",
                                "target_lang_sense_clarification": "término informal para dirigirse a un joven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f69119ef-5cb8-373f-addc-be1adc2819a9",
                    "sense_definition": "A short form of <w>championship</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "champion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team trained all season to make it to the state <w>champs</w>.",
                            "target_lang_translations": {
                                "ru": "Команда тренировалась весь сезон, чтобы попасть на <w>чемпионат</w> штата.",
                                "zh": "这支队伍整个赛季都在刻苦训练，只为打进州<w>锦标赛</w>。",
                                "es": "El equipo entrenó toda la temporada para llegar al <w>campeonato</w> estatal."
                            }
                        },
                        {
                            "text": "We are going to watch the swimming <w>champs</w> on television tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы будем смотреть <w>чемпионат</w> по плаванию по телевизору.",
                                "zh": "我们今晚要在电视上看游泳<w>锦标赛</w>。",
                                "es": "Vamos a ver el <w>campeonato</w> de natación por televisión esta noche."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of championship"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"championship\" (чемпионат).",
                        "zh": "“Championship”的缩写，指锦标赛或冠军赛。",
                        "es": "Forma abreviada de \"campeonato\"."
