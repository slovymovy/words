                        ]
                    },
                    {
                        "translation_id": "c18ec3c2-ad64-4f1e-a66b-26d132dd051d",
                        "source_entry_id": "169e3d0c-51c2-318b-b446-b0698736fbf4",
                        "source_sense_id": "0d8c9b33-72b8-3526-b668-a931ea59ec05",
