                    },
                    {
                        "translation_id": "c8a1891c-abe1-474e-a616-274028425aab",
                        "source_entry_id": "ad770faa-5824-3f0f-94f7-a080ad0eb353",
                        "source_sense_id": "17baddff-6fd3-3554-979c-e98f5cf9153c",
