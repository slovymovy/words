                "senses": [
                    {
                        "sense_id": "94aaba70-ab8a-3883-abd6-56bbe226b7f0",
                        "entry_id": "22445bc9-e7ac-3517-ae62-ac7e2595777b",
                        "glosses": [
                            "rzecz. odczas. od oddzielić"
                        ],
                        "tags": [],
