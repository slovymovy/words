                "translations": [
                    {
                        "translation_id": "125efcb8-1680-4927-aa21-1418f3e28cd9",
                        "source_entry_id": "4cf2de71-8b9c-3a4d-90cb-84ce8ca6eae6",
                        "source_sense_id": "eada21d5-ec23-301a-8ee6-bdcd51754d80",
                        "source_sense_description": "ohne frische Luft; stickig",
                        "target_lang_word": "stickig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stickig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                        "entry_id": "fbf53d4a-4a9f-3344-a9ab-c3a3fc3ace8a",
                                        "glosses": [
                                            "das Gefühl ersticken zu müssen gebend; von verbrauchter Luft erfüllt; mit geringem Sauerstoffgehalt"
                                        ],
                                        "tags": [
                                            "von Luft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5fe754-4dc6-4372-995d-f39e60c2f8af",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Die stickige Luft nahm ihm den Atem."
                                            },
                                            {
                                                "example_id": "ae3e16f7-9a92-4ca3-a7d8-1a2e67e16786",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Bitte öffne doch die Fenster, es ist so stickig hier."
                                            },
                                            {
                                                "example_id": "06d5c694-4898-4ec4-8e1e-5857e2c41b0e",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "In der Dachkammer war es stickig heiß."
                                            },
                                            {
                                                "example_id": "304744cd-501e-47a6-9024-35a6bd5d2cd9",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Sie schließen sich nächtelang in ihre stickigen Studierstuben ein."
                                            },
                                            {
                                                "example_id": "cbc8c120-1729-476f-a6e4-1fa3a1231e4a",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                                            },
                                            {
                                                "example_id": "07433409-d481-44de-ae64-f6cf2468c36a",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "„Meine Mutter hatte immer Angst, dass wir Kinder durch das Loch im Holzsitz rutschen und im schwarzen, stickigen Dunkel dieses Höllenpfuhls elendig ersaufen könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a433bff-7a2b-43cd-a66b-f74d102e7893",
                        "source_entry_id": "4cf2de71-8b9c-3a4d-90cb-84ce8ca6eae6",
