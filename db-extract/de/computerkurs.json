                "senses": [
                    {
                        "sense_id": "21eefd80-5914-343c-a3ba-31553b098b0a",
                        "entry_id": "7140e43b-e951-3d75-b96a-3e734f6b9d51",
                        "glosses": [
                            "Unterricht über einen bestimmten Zeitraum, der dem Aufbau oder der Verbesserung der Computerkenntnisse der Kursteilnehmer dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b6b2ae-7006-4271-9c16-f98611600891",
                                "sense_id": "21eefd80-5914-343c-a3ba-31553b098b0a",
                                "text": "„Es ist niemandem zu verdenken, sich von einem Computerkurs eine Verbesserung seiner oder ihrer Situation zu versprechen und das Lesen der „Brüder Karamasow“ einmal hintanzustellen.“"
                            },
                            {
                                "example_id": "bd8ed36c-b799-4ddf-b256-48dbda716041",
                                "sense_id": "21eefd80-5914-343c-a3ba-31553b098b0a",
                                "text": "„Bald schon begann er, sich hier zu engagieren und hielt beispielsweise einen Computerkurs ab.“"
                            }
                        ],
