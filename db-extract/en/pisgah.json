                "senses": [
                    {
                        "sense_id": "a5351cb9-f843-332a-af55-33bb1fdb962f",
                        "entry_id": "90b28074-d52d-3844-9c6d-2b7f6977f5b5",
                        "glosses": [
                            "The name of a mountain in the Bible. Usually refers to biblical Mount Pisgah or Mount Nebo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0eb6a4f-2449-4a5f-a15d-31bed2495f57",
                                "sense_id": "a5351cb9-f843-332a-af55-33bb1fdb962f",
                                "text": "—With swimming glance,\nLike him who erst from Pisgah's cliff descried\nThe unenter'd land of promise,—he survey'd\nThat emerald shore where slept in hallow'd graves\nHis ancestors, where rose in beauteous strength\nThe city of his joy,—"
                            },
                            {
                                "example_id": "34640585-5c0a-4338-bf77-86e1778cd8e6",
                                "sense_id": "a5351cb9-f843-332a-af55-33bb1fdb962f",
                                "text": "On Pisgah, Moses surveyed the whole land of Canaan, and although he was advantaged by the height of the place and the clearness of his eyes,[…] yet much of miracle must needs be admitted in so plain and far discovery."
                            }
                        ]
                    },
