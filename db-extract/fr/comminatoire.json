                                                "sense_id": "ae23dd05-d5a8-3d9c-b823-68293786b3c5",
                                                "text": "De dreigende houding van de man maakte iedereen bang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef6adcf4-f60c-30e7-9074-c590311fd364",
                                        "entry_id": "75ec0fc7-2492-3e3a-84c5-f6ff0cbe256c",
                                        "glosses": [
                                            "op het punt staan te gebeuren"
                                        ],
                                        "tags": [
                                            "van iets naars"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51447c0b-a378-4869-b62c-b05d56abc435",
                                                "sense_id": "ef6adcf4-f60c-30e7-9074-c590311fd364",
                                                "text": "Er is een dreigend tekort aan leraren."
                                            },
                                            {
                                                "example_id": "d0b8d337-6217-49ff-be0d-eb86c40c1f4c",
                                                "sense_id": "ef6adcf4-f60c-30e7-9074-c590311fd364",
                                                "text": "Hij waarschuwt voor een dreigend financieel debacle met de bouwplannen."
                                            },
                                            {
                                                "example_id": "5afa23d8-59cf-4070-9413-cc3817bac743",
                                                "sense_id": "ef6adcf4-f60c-30e7-9074-c590311fd364",
                                                "text": "Eerst nog met alleen felle windstoten die aan onze jassen rukten en ons lieten wiebelen op het steile pad, maar inmiddels is de lucht bijna zwart en lichten de kale bergen voor ons op onder felle lichtflitsen die vergezeld gaan van dreigend gedonder."
                                            }
                                        ]
