                "entry_id": "355535e5-e0a6-3bfd-9092-46ff9b537117",
                "word": "rivaliseren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e04a218-150e-3b14-acb9-46b902657fe6",
                        "entry_id": "355535e5-e0a6-3bfd-9092-46ff9b537117",
                        "glosses": [
                            "strijden om iets met een concurrent (rivaal)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e38733c-4b15-4ba1-a4dc-55c72a3021ea",
                                "sense_id": "0e04a218-150e-3b14-acb9-46b902657fe6",
                                "text": "Legergroepen loyaal aan Kiir en Machar rivaliseren met elkaar. Eerder deze maand kwam het tot heftige gevechten in de hoofdstad Juba en andere steden en er dreigde opnieuw een burgeroorlog uit te breken in het Afrikaanse land, dat vijf jaar geleden zelfstandig werd."
                            },
                            {
                                "example_id": "414434a3-1c85-458d-b574-0ed1ef61acc8",
                                "sense_id": "0e04a218-150e-3b14-acb9-46b902657fe6",
                                "text": "Volgens The Guardian zal het afscheid van Mandela met de begrafenis van paus Johannes Paulus II in 2005 rivaliseren als het gaat om bezoek. Deze trok vijf koningen, zes koninginnen, 70 presidenten en premiers en twee miljoen burgers. Naast president Obama en zijn vrouw zullen waarschijnlijk ook alle andere nog levende Amerikaanse oud-presidenten naar Zuid-Afrika afreizen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbb6ef20-3c21-4a5a-8b8b-8beff1504869",
                        "source_entry_id": "355535e5-e0a6-3bfd-9092-46ff9b537117",
                        "source_sense_id": "0e04a218-150e-3b14-acb9-46b902657fe6",
                        "target_lang_word": "rivaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                        "entry_id": "bcd397cf-7969-3c8c-a7e5-be41ca781b36",
                                        "glosses": [
                                            "Disputer de talent, de mérite, etc., avec quelqu’un, en approcher, l’égaler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8234684-c7c1-4d4c-8040-723fa69d1489",
                                                "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                                "text": "Cet homme n’est point fait pour rivaliser avec vous."
                                            },
                                            {
                                                "example_id": "89c48854-7315-4fc4-a5d5-0694acd68765",
                                                "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                                "text": "Ils ont rivalisé d’efforts, de courage."
                                            },
                                            {
                                                "example_id": "fbb3d3c7-8b04-44f7-a363-5aa8480e3c6a",
                                                "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                                "text": "Ces deux peuples rivalisent entre eux de gloire, d’industrie."
                                            },
                                            {
                                                "example_id": "775298e8-e8e8-4dc9-9cb8-1bb71849183f",
                                                "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                                "text": "L’un venait de révéler un talent neuf, et de rivaliser par son premier tableau avec les gloires de la peinture impériale."
                                            },
                                            {
                                                "example_id": "22db86e7-966c-47d5-8e68-2c75c8284837",
                                                "sense_id": "8b95dd81-4d0c-38e4-9eab-5628838c40be",
                                                "text": "Elle me paraissait si belle, et si bonne, et si douce, qu’aucune créature humaine n’eût pu rivaliser de beauté, de bonté et de douceur avec ce morceau de matière inerte et peinte qui me parlait un langage inconnu et délicieux, et d’où m’arrivait comme une odeur grisante d’encens et de myrrhe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
