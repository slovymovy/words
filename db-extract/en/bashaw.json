                "senses": [
                    {
                        "sense_id": "b10b29e5-5de7-3881-8a9e-6a51c2e6157c",
                        "entry_id": "f1a68b9e-ba10-36bb-a103-7d30b08fad44",
                        "glosses": [
                            "A pasha."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a383b1-1148-4753-b932-70fe8dcf7350",
                                "sense_id": "b10b29e5-5de7-3881-8a9e-6a51c2e6157c",
                                "text": "Radzivilius was much taken with the bassa’s palace in Cairo […]."
                            },
                            {
                                "example_id": "7bfce05b-792e-4117-9cbe-1f828b31a51c",
                                "sense_id": "b10b29e5-5de7-3881-8a9e-6a51c2e6157c",
                                "text": "The Bashaw notwithstanding drew together a partie of five hundred before his owne Pallace, where he intended to die […]."
                            },
                            {
                                "example_id": "529ca1c3-6b9b-402a-8578-cc2233d29c12",
                                "sense_id": "b10b29e5-5de7-3881-8a9e-6a51c2e6157c",
                                "text": "he fancies himself in company with beautiful women; he dreams that he is an emperor, or a bashaw, and that the world is at his nod."
                            },
                            {
                                "example_id": "b7cfaedc-1420-4078-b81e-be4ac268eb46",
                                "sense_id": "b10b29e5-5de7-3881-8a9e-6a51c2e6157c",
                                "text": "Insecure about his infirmity, the Bashaw decreed that all who desired to come into his presence must first submit to having their eyes put out."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e0f13d7-bbfe-3a1b-b829-6c73dae2f466",
                        "entry_id": "f1a68b9e-ba10-36bb-a103-7d30b08fad44",
                        "glosses": [
                            "A grandee."
                        ],
                        "tags": [
                            "archaic",
                            "broadly",
