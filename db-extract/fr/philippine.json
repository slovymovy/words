                                "example_id": "396fdb26-9c42-4f0b-b44b-563c2985361c",
                                "sense_id": "be230907-d51d-3b8a-a5bb-bfb1b74d1cfd",
                                "text": "À 59 ans, Philippine Leroy-Beaulieu est devenue l’icône du cool pour toute la jeune génération en incarnant Sylvie Grateau, la patronne bitchy d’Emily in Paris."
                            }
                        ]
