                "senses": [
                    {
                        "sense_id": "d485e867-7acb-3e4d-8fd4-f6a3f386e56f",
                        "entry_id": "6bab0117-4066-3885-a09d-b4d6d7f2d7a1",
                        "glosses": [
                            "To escape (someone or something)."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a6424850-4e09-4260-975a-11f37e54cdd1",
                                "sense_id": "d485e867-7acb-3e4d-8fd4-f6a3f386e56f",
                                "text": "No spring nor summer beauty hath such grace / As I have seen in one autumnal face. / Young beauties force our love, and that's a rape, / This doth but counsel, yet you cannot scape."
                            },
                            {
                                "example_id": "5d9f0416-9932-4e73-8578-450773d5e089",
                                "sense_id": "d485e867-7acb-3e4d-8fd4-f6a3f386e56f",
                                "text": "He (to beguile the ſimple) makes no bone / To ſvvear by God (for he beleeues ther's none); / His Svvord's his Title; and vvho ſcapes the ſame, / Shall haue a Piſtol, or a Poyſonie dram: […]"
                            },
                            {
                                "example_id": "e1c7663f-877d-4bff-a0c4-38ec3416e399",
                                "sense_id": "d485e867-7acb-3e4d-8fd4-f6a3f386e56f",
                                "text": "Hee will provide you keyes, and locks, to spie, / And scape spies, to good ends"
                            }
                        ]
                    }
                ],
