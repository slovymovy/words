                    }
                ],
                "senses": [
                    {
                        "sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                        "entry_id": "6cff0bcb-75a1-36fe-a20f-3ff086376705",
                        "glosses": [
                            "bardzo drobny, jednokomórkowy organizm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b631d312-d8f4-4070-93ae-65986c834af1",
                                "sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                                "text": "Nie całuj psa, bo ma na sierści zgraję mikrobów, pcheł i innych paskudztw!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "844cc8fa-ac79-4b9b-a3ee-8d57bb3eae5c",
                        "source_entry_id": "6cff0bcb-75a1-36fe-a20f-3ff086376705",
                        "source_sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                        "target_lang_word": "microbe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                                        "entry_id": "0f836c5c-6f77-3485-a675-8ff2e5d394a2",
                                        "glosses": [
                                            "Any microorganism; (loosely, nonscientifically) especially, a harmful bacterium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c22f87a-8c3a-4ba5-b30f-1f04e35db345",
                                                "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                                                "text": "We humans and other complex animals are full of microbes, gajillions of them. People have so many that microbe cells living in our bodies outnumber our own vastly."
                                            },
                                            {
                                                "example_id": "8dc7f278-c5d6-44c3-b700-d37bf762684a",
                                                "sense_id": "8d271810-9b97-3fe5-90cf-ce48e8e47efe",
                                                "text": "Yes, there are microbes everywhere and most are just fine for us, perhaps even beneficial to our microbiomes and immune systems. We don’t care about those."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd3c06ad-93f6-412c-8960-8750eb21a5df",
                        "source_entry_id": "6cff0bcb-75a1-36fe-a20f-3ff086376705",
                        "source_sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                        "target_lang_word": "microorganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microorganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                        "entry_id": "a1bab713-18af-30f7-9a6f-e54f382cdfeb",
                                        "glosses": [
                                            "An organism that is too small to be seen by the unaided eye; especially, a single-celled organism, such as a bacterium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d075b3-5b00-44ce-9f67-ec9300201499",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The cud is then reswallowed and further digested by specialized microorganisms that live in the rumen."
                                            },
                                            {
                                                "example_id": "8b9e8060-b94c-47cc-b626-a30e0aed0a76",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "Bacillus anthracis: from the first up to the sixth day, this microorganism was isolatable, or in other words still alive."
                                            },
                                            {
                                                "example_id": "b363dd4d-0cef-436f-a699-902bff3e63b8",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The differences in biofilm penetration patterns of both tested photosensitisers and the light source could have played an important role for the survival of microorganisms after the application of aPDT. In a recent own study, we showed that the deepest layers of the oral biofilm were not affected by the aPDT [4 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9973b0d-9d6e-40d1-961e-f57b4a79a5f3",
                        "source_entry_id": "6cff0bcb-75a1-36fe-a20f-3ff086376705",
                        "source_sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                        "target_lang_word": "microbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Organisme vivant qui ne peut être vu qu’en utilisant un microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da115474-9c8d-49e0-acc5-6999a4df35b5",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "Et l’air, mon Claudin, l’air reniflable, risquais-je avec rusticité? — Tu renifles ? Et les microbes ! Prends garde !"
                                            },
                                            {
                                                "example_id": "882ecd83-93fc-418f-8490-f714f8c9c5c0",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "On sait que le microbe de la peste est un cocco-bacille appartenant au genre Pasteurella, dont les différentes espèces produisent les septicémies hémorragiques des animaux."
                                            },
                                            {
                                                "example_id": "8a9dc4f8-f7f3-4f99-847b-9991b072a693",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "La pellicule … est composée de nanoparticules de céramique. Ce produit était déjà utilisé depuis une dizaine d’années dans la fabrication d’instruments chirurgicaux. Il a la caractéristique de détruire les microbes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Avorton, nain, personne de petite taille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2b7a2e-b557-4383-8345-d1688d9cda1f",
                                                "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                                "text": "Ça m’aurait étonné que tu ne sois pas là, microbe ! dit M. Heaume en me cueillant le poignet."
                                            },
                                            {
                                                "example_id": "554ff138-77d7-4a98-a48b-cba45b0cffa4",
                                                "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                                "text": "Holà, microbe! Tache^([sic]) de filer en vitesse sinon..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Tout agent pathogène, vecteur de transmission invisible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b67cbf4-0672-4626-89d6-f3c75fba4f2f",
                                                "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                                "text": "Il doit y avoir un microbe du rire."
                                            },
                                            {
                                                "example_id": "7543b427-ab7b-4d13-904e-f7971d12af8d",
                                                "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                                "text": "La tristesse […] C’est un poison, un microbe qu’on a tort de cultiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f828792-1729-39af-b971-35a8a433d3f2",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Personne méprisable, malfaisante, qui répand le mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3742a9f-1b83-41e4-b793-d01d2f1b9b45",
                                                "sense_id": "6f828792-1729-39af-b971-35a8a433d3f2",
                                                "text": "La délégation des gauches ! Ce seul nom évoque des palabres […] toute une faune de couloirs en marge de la vraie vie, une agitation de microbes au dedans d’un grand corps qu’ils n’ont pas conscience de détruire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5067e869-1d58-3fd3-a2d7-6332b5ea2831",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Enfant criminel, souvent issu de la rue."
                                        ],
                                        "tags": [
                                            "Côte d’Ivoire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7eb774d-a018-4e56-a05f-e6520952c92a",
                        "source_entry_id": "6cff0bcb-75a1-36fe-a20f-3ff086376705",
                        "source_sense_id": "eae0496e-7e2a-3765-a87c-cbb5eb5b2a29",
                        "target_lang_word": "microbio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e408294a-b295-39e3-b8fc-f0887275b6d3",
                                        "entry_id": "277d3f30-2949-3060-a74e-59012811b4a1",
                                        "glosses": [
                                            "Nombre genérico de cualquier organismo unicelular solo visible al microscopio, en especial los patógenos, como los virus, bacterias, hongos unicelulares."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae293ba5-8de9-3545-9f28-7120f2dfc56f",
                                        "entry_id": "277d3f30-2949-3060-a74e-59012811b4a1",
                                        "glosses": [
                                            "Algo que es muy pequeño."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
