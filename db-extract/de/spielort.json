                "senses": [
                    {
                        "sense_id": "da974843-e1e8-3fbe-a399-c5c60b0823ef",
                        "entry_id": "1c84fbc5-48e8-3a9a-8e25-4fd2863fb296",
                        "glosses": [
                            "Ort, in dem etwas gespielt wird (Fußball, Theater, …)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5942aab9-a25d-44da-ac75-4e40ba216398",
                                "sense_id": "da974843-e1e8-3fbe-a399-c5c60b0823ef",
                                "text": "„Allzuoft haben diese Spielorte eine Alibifunktion und tragen dazu bei, dass die sonstige Lebens- und Wohnumwelt bewegungs- und spielfeindlich gehalten werden kann.“"
                            },
                            {
                                "example_id": "4a86a2e9-0b82-407d-b530-8c282a6447f2",
                                "sense_id": "da974843-e1e8-3fbe-a399-c5c60b0823ef",
                                "text": "„Die Wahl und Organisation der Spielorte und Spielfelder erlaubt noch weitere, manchmal ungeahnte, überraschende Umgestaltungen des Spiels.“"
                            },
                            {
                                "example_id": "805ed3cb-e961-48be-bef7-874c8da38f3e",
                                "sense_id": "da974843-e1e8-3fbe-a399-c5c60b0823ef",
                                "text": "„Bei der Weltmeisterschaft 1974 zogen die Holländer mit Frauen und Bräuten durch die Spielorte.“"
                            },
                            {
                                "example_id": "17b34755-7502-46fe-8cb6-eda5685fe222",
                                "sense_id": "da974843-e1e8-3fbe-a399-c5c60b0823ef",
                                "text": "Als Spielort für das Finale wurde Mannheim ausgewählt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
