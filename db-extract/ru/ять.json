            {
                "entry_id": "15be0054-70d9-3243-9260-2ee4705641d5",
                "word": "Ять",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26f3d619-4c68-3c10-97a0-7c5152b2904a",
                        "entry_id": "15be0054-70d9-3243-9260-2ee4705641d5",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249ce25d-c137-4945-a768-967f0e7aed25",
                                "sense_id": "26f3d619-4c68-3c10-97a0-7c5152b2904a",
                                "text": "Ворочая камни, Ять ― как всегда, несвоевременно, ― вспомнил, что в Риме отцеубийц сбрасывали в Тибр, завязав в мешок с петухом, змеей и крысой."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
