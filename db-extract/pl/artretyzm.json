                    {
                        "translation_id": "6fb92b00-71a7-4630-aba8-47ede09ae663",
                        "source_entry_id": "ae7c184d-c441-3530-96c3-7352c87e2585",
                        "source_sense_id": "8d07b0a5-a768-3399-a621-975e53a1b078",
                        "target_lang_word": "arthritisme",
                        "target_lang_code": "fr",
