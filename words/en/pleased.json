                                "pl": "Niespodziewany prezent bardzo ją <w>ucieszył</w>.",
                                "de": "Das unerwartete Geschenk <w>erfreute</w> sie sehr.",
                                "fr": "Le cadeau inattendu lui a beaucoup <w>plu</w>.",
                                "it": "Il regalo inaspettato l'ha <w>resa molto felice</w>.",
                                "cs": "Ten nečekaný dárek jí velmi <w>potěšil</w>.",
                                "tr": "Beklenmedik hediye onu çok <w>sevindirdi</w>.",
                                "es": "El regalo inesperado la <w>complació</w> enormemente."
                            }
                        },
                        {
                            "text": "It <w>pleased</w> the committee to approve the plan.",
                            "target_lang_translations": {
                                "ru": "Комитету <w>было угодно</w> утвердить план.",
                                "zh": "委员会<w>乐于</w>批准这项计划。",
                                "nl": "Het <w>beviel</w> de commissie om het plan goed te keuren.",
                                "pl": "Komitet z <w>zadowoleniem</w> zatwierdził plan.",
                                "de": "Es <w>gefiel</w> dem Komitee, den Plan zu genehmigen.",
                                "fr": "Il a <w>plu</w> au comité d'approuver le plan.",
                                "it": "Al comitato ha <w>fatto piacere</w> approvare il piano.",
                                "cs": "Výbor s potěšením <w>schválil</w> tento plán.",
                                "tr": "Planı onaylamak komiteyi <w>memnun etti</w>.",
                                "es": "Al comité le <w>agradó</w> aprobar el plan."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола please.",
                        "zh": "使某人感到高兴或满足（please 的过去式和过去分词）。",
                        "nl": "De verleden tijd en voltooid deelwoord van 'please' (iemand een plezier doen of tevreden stellen).",
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'please' (sprawiać przyjemność, zadowalać).",
                        "de": "Vergangenheitsform von 'gefallen' oder 'erfreuen'.",
                        "fr": "Passé simple et participe passé du verbe plaire, signifiant causer du plaisir ou de la satisfaction à quelqu'un.",
                        "it": "Passato remoto e participio passato del verbo 'compiacere' o 'piacere', indicante l'aver dato soddisfazione o gioia a qualcuno.",
                        "cs": "Minulý čas a příčestí minulé od slovesa please (potěšit, udělat radost).",
                        "tr": "Please fiilinin geçmiş zaman ve geçmiş zaman ortacı hali; birini mutlu etmek veya memnun bırakmak.",
