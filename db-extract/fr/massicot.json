                    {
                        "translation_id": "88cf4ce8-5871-4c26-9ad5-90a8c01f24f6",
                        "source_entry_id": "861b2af2-2549-3efd-b9be-09ab1759d801",
                        "source_sense_id": "0627adb4-2102-3b65-8199-8df33f0c3e66",
                        "source_sense_description": "Appareil de découpage",
                        "target_lang_word": "guillotine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guillotine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a696bc2-1685-372c-bf37-b2799a01e0b0",
                                        "entry_id": "17323d11-510f-30cf-8c44-7c32b93ca01a",
                                        "glosses": [
                                            "A machine used for the application of capital punishment by decapitation, consisting of a tall upright frame from which is suspended a heavy diagonal-edged blade which is dropped onto the neck of the person to be executed; also, execution using this machine."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f38143d-802a-4a8a-89ff-07ca01ecb731",
                                                "sense_id": "4a696bc2-1685-372c-bf37-b2799a01e0b0",
                                                "text": "For two-and-twenty years he [Joseph-Ignace Guillotin], unguillotined, shall hear nothing but guillotine, see nothing but guillotine; then dying, shall through long centuries wander, as it were, a disconsolate ghost, on the wrong side of Styx and Lethe; his name like to outlive [Julius] Cæsar’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca67bef4-31b8-3dd3-910d-018a7872f6c4",
                                        "entry_id": "17323d11-510f-30cf-8c44-7c32b93ca01a",
                                        "glosses": [
                                            "A device or machine with a cutting blade.",
                                            "A device used for cutting the pages of books, stacks of paper, etc., to straight edges, usually by means of a hinged or sliding blade attached to a flat platform."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b59d76d-5f48-372f-a4f9-61a6467fa7ff",
                                        "entry_id": "17323d11-510f-30cf-8c44-7c32b93ca01a",
                                        "glosses": [
                                            "A device or machine with a cutting blade.",
                                            "An instrument with a sliding blade for cutting the tonsils, uvula, or other body parts."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e7cb5da-ba39-3b43-9138-2ff6fc5921c0",
                                        "entry_id": "17323d11-510f-30cf-8c44-7c32b93ca01a",
                                        "glosses": [
                                            "A parliamentary procedure for fixing the dates when various stages of discussion of a bill must end, to ensure that the enactment of the bill proceeds expeditiously."
                                        ],
                                        "tags": [
                                            "British",
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3760917-955a-46e3-a75e-fcf14edadc49",
                                                "sense_id": "2e7cb5da-ba39-3b43-9138-2ff6fc5921c0",
                                                "text": "The right hon. Gentleman is making a great stooshie about time in relation to this Bill, but was it not the case that, when the SNP [Scottish National Party] Scottish Government introduced their continuity Bill in the Scottish Parliament, they operated a ruthless guillotine to prevent proper scrutiny of it? That is the case; they ran a guillotine on that Bill, and there was a very limited amount of time allowed for debate and scrutiny, yet he complains about that happening here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b67f30-1db2-306d-80b2-5d96ab4ca7ff",
                                        "entry_id": "17323d11-510f-30cf-8c44-7c32b93ca01a",
                                        "glosses": [
                                            "A legislative motion that debate be ended and a vote taken; a cloture."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guillotine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "624ac4ae-1d97-3d6c-8725-08e8c7e2b72b",
                                        "entry_id": "62c38171-9f95-373f-a87a-2d0912b963f3",
                                        "glosses": [
                                            "To use a guillotine (on someone or something).",
                                            "To execute (someone) with a guillotine."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce95b210-ff82-45aa-a8ea-aa15832f2003",
                                                "sense_id": "624ac4ae-1d97-3d6c-8725-08e8c7e2b72b",
                                                "text": "Many counterrevolutionaries were guillotined during the French Revolution."
                                            },
                                            {
                                                "example_id": "e1de94f5-b22b-4588-8b6a-e86df127bef5",
                                                "sense_id": "624ac4ae-1d97-3d6c-8725-08e8c7e2b72b",
                                                "text": "Besides providing online courses to their own (generally fee-paying) students, universities have felt obliged to join the MOOC revolution to avoid being guillotined by it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9a9756-1b5e-34fc-aa6a-9f2f139018c1",
                                        "entry_id": "62c38171-9f95-373f-a87a-2d0912b963f3",
                                        "glosses": [
                                            "To use a guillotine (on someone or something).",
                                            "To cut or trim (a body part, a stack of paper, etc.) with a guillotine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab65102f-c2e1-32e2-9506-ea0baaa85bfc",
                                        "entry_id": "62c38171-9f95-373f-a87a-2d0912b963f3",
                                        "glosses": [
                                            "To end discussion (about a parliamentary bill or part of one) by invoking a guillotine procedure."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
