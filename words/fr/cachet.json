                    "frequency": "Low",
                    "semantic_group_id": "courrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le messager a brisé le <w>cachet</w> de cire rouge pour déplier la lettre royale."
                        },
                        {
                            "text": "Le notaire a immédiatement apposé son <w>cachet</w> au bas de cet acte officiel."
