                    "sense_definition": "A machine tool designed to finish precision bores.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sharpening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory installed a new <w>hone</w> to improve the accuracy of their engine parts.",
                            "target_lang_translations": {
                                "zh": "工厂安装了一台新的<w>珩磨机</w>，以提高发动机零件的精度。"
                            }
                        },
                        {
                            "text": "Using a precision <w>hone</w> is essential for high-performance automotive manufacturing.",
                            "target_lang_translations": {
                                "zh": "使用精密<w>珩磨机</w>对于高性能汽车制造至关重要。"
                            }
                        }
