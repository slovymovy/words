                                        "glosses": [
                                            "Person, die mit dem Fahrrad Sport treibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1419a7-ff2e-4dcb-8afe-ae7ad5dc3616",
                                                "sense_id": "45ba529e-5ecc-3ae6-b314-eefc60b8664a",
                                                "text": "„Zu diesem Zeitpunkt ist sich der Radsportler keiner Schuld bewusst.“"
                                            },
                                            {
                                                "example_id": "a312ba3f-07ee-42b4-8edc-b6ee5e31b13d",
                                                "sense_id": "45ba529e-5ecc-3ae6-b314-eefc60b8664a",
                                                "text": "„Die Radsportler waren müde, und die beiden Frauen störte der Geruch des im Kamin verbrennenden Torfs.“"
                                            }
