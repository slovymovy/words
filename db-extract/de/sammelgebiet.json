                "senses": [
                    {
                        "sense_id": "b0ac4b4c-e137-32b0-9ac0-7650606124ba",
                        "entry_id": "b04ef600-7041-353e-b33a-41d210b0157f",
                        "glosses": [
                            "thematisch bestimmte Art von Gegenständen, die jemand sammelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ac2e6b-f1e7-40ef-a9f5-b0e59dc54904",
                                "sense_id": "b0ac4b4c-e137-32b0-9ac0-7650606124ba",
                                "text": "„Kassettenpost ist ein überschaubares Sammelgebiet.“"
                            },
                            {
                                "example_id": "b0705916-d1dd-4b4a-88bf-40d7feeae0e1",
                                "sense_id": "b0ac4b4c-e137-32b0-9ac0-7650606124ba",
                                "text": "„Obwohl sich die Erforschung des Sammelgebiets Bayern in den letzten Jahrzehnten auf die Postgeschichte verlagert und der Stellenwert der einzelnen Marke unter der Bevorzugung des Briefs gelitten hat, gab und gibt es stets Mühlradstempelsammler.“"
                            },
                            {
                                "example_id": "dc9f22bf-4d1f-465e-b54d-6cbdf063f4ac",
                                "sense_id": "b0ac4b4c-e137-32b0-9ac0-7650606124ba",
                                "text": "„Innerhalb weniger Jahre entstand eine bunte Vielfalt, die heute im Sammelgebiet Altdeutschland vereint ist.“"
                            },
                            {
                                "example_id": "3bc65a4b-296e-4c7a-9046-1db1fc5ff3aa",
                                "sense_id": "b0ac4b4c-e137-32b0-9ac0-7650606124ba",
                                "text": "„Einschließlich dieser ersten Ausgabe umfasst das Sammengebiet Altdeutschland Baden acht Ausgaben mit 25 Marken, die bis 1868 erschienen und sehr gefragt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
