                "senses": [
                    {
                        "sense_id": "d582d31c-b2b1-3c33-8511-eb99f383e8a3",
                        "entry_id": "af9e77e4-c62a-3676-966b-71c1ca2bb6d2",
                        "glosses": [
                            "unkontrollierte Lüftung durch Druckunterschiede über Fugen und Schlitze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211be96d-5051-4909-ab0e-9961709e6234",
                                "sense_id": "d582d31c-b2b1-3c33-8511-eb99f383e8a3",
                                "text": "„Früher bereitete die Raumluftfeuchtigkeit aufgrund der Selbstlüftung über die undichte Gebäudehülle keine Probleme.“"
                            },
                            {
                                "example_id": "c16b852c-9167-405c-8eee-193cd6a3fef9",
                                "sense_id": "d582d31c-b2b1-3c33-8511-eb99f383e8a3",
                                "text": "„Um eine ausreichende Selbstlüftung zu erzeugen, müsste ständig der Wind durchs Haus pfeifen.“"
                            },
                            {
                                "example_id": "41338620-2552-4430-858e-ca146925aec7",
                                "sense_id": "d582d31c-b2b1-3c33-8511-eb99f383e8a3",
                                "text": "„ Vielmehr ist die Selbstlüftung im Winter im Durchschnitt viel zu hoch und im Sommer zu niedrig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
