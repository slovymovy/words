                                "target_word": "Jugendlicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                        "entry_id": "2a28e8ec-76d0-3e56-9afe-bebfd80025de",
                                        "glosses": [
                                            "junge männliche Person zwischen Kindheit und Erwachsensein, also etwa vom 13. bis zum 21., gegebenenfalls auch bis zum 25. Lebensjahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30b92e1-769d-4da3-b733-d9aa1083907f",
                                                "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                                "text": "„Und Jugendliche waren die unverständlichsten Exemplare ihrer Art.“"
                                            },
                                            {
                                                "example_id": "6dfa1955-b0e6-491b-8e57-2a6f7881cc86",
                                                "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                                "text": "Oma wurde schon wieder von Jugendlichen überfallen."
                                            },
                                            {
                                                "example_id": "874d6d88-4038-4ad1-aea6-dc0b93ab8aa2",
                                                "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                                "text": "Ein Jugendlicher wurde neulich für sein soziales Engagement geehrt."
                                            },
                                            {
                                                "example_id": "ecd3bd00-6b72-4965-bfd2-f17f36be7953",
                                                "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                                "text": "„In acht Gruppen bearbeiteten die Jugendlichen verschiedene Fragen, etwa wie türkisch-deutsche Familien ihre Mehrsprachigkeit erleben oder wie die eigene Sprache auf den Gesprächspartner wirkt.“"
                                            },
                                            {
                                                "example_id": "639e0482-0e47-446b-8d3e-1ed6cff5d59e",
                                                "sense_id": "b1f4e90d-1570-3e80-9e26-ad508dd45909",
                                                "text": "„Das habe so sein müssen, weil er von rechtsradikalen Jugendlichen aus dem mecklenburgischen Umland bedroht worden sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                        "entry_id": "2a28e8ec-76d0-3e56-9afe-bebfd80025de",
                                        "glosses": [
                                            "männliche Person, die zwischen 14 und 18 Jahre alt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a255754c-8d7a-4f72-95ff-6d84e673039f",
                                                "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                                "text": "Oma wurde schon wieder von Jugendlichen überfallen."
                                            },
                                            {
                                                "example_id": "dc0404c6-0873-4e1c-bdf3-85d6b96fd8d5",
                                                "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                                "text": "Ein Jugendlicher wurde neulich für sein soziales Engagement geehrt."
                                            },
                                            {
                                                "example_id": "fe1a083e-46f1-426b-9287-e0efd85b7d4f",
                                                "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                                "text": "„In acht Gruppen bearbeiteten die Jugendlichen verschiedene Fragen, etwa wie türkisch-deutsche Familien ihre Mehrsprachigkeit erleben oder wie die eigene Sprache auf den Gesprächspartner wirkt.“"
                                            },
                                            {
                                                "example_id": "e00ce8bd-b451-41c4-9f73-85c2e766c69e",
                                                "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                                "text": "„Das habe so sein müssen, weil er von rechtsradikalen Jugendlichen aus dem mecklenburgischen Umland bedroht worden sei.“"
                                            },
                                            {
                                                "example_id": "7a28827f-dc0f-4b95-b49a-4e80dd40bbf6",
                                                "sense_id": "d2fc5a97-92ba-348d-830b-df7962e44f20",
                                                "text": "„Im Sinne dieses Gesetzes […] sind Jugendliche Personen, die 14, aber noch nicht 18 Jahre alt sind […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
