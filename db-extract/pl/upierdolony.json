                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9cbdbcc6-5fcb-4ba6-870b-018a90919acf",
                                "sense_id": "9586eaa1-0ca9-38dc-a507-e2620be84931",
                                "text": "Teraz jestem upierdolony robotą. Może w weekend znajdę trochę czasu."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
