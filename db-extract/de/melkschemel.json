                "senses": [
                    {
                        "sense_id": "77e1b111-7e8d-39c5-9224-162435971cd7",
                        "entry_id": "8be65797-351e-3f9b-b227-f67102ba4145",
                        "glosses": [
                            "Sitzgelegenheit, die beim Melken verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9242e46-26fa-4512-92cc-c4ca03aef608",
                                "sense_id": "77e1b111-7e8d-39c5-9224-162435971cd7",
                                "text": "Der Melkschemel fiel laut klappernd zu Boden."
                            },
                            {
                                "example_id": "7284efca-853b-40d1-8bb7-a8ccdbb01c9e",
                                "sense_id": "77e1b111-7e8d-39c5-9224-162435971cd7",
                                "text": "„Ein Geheimnis ist sicherlich die Statik. Das ist ein sehr simples System, ein Dreibeinsystem. Das kennen wir aus der landwirtschaftlichen Frühgeschichte vom Melkschemel. Die meisten Melkschemel waren Dreibeiner.“"
                            },
                            {
                                "example_id": "3f67cd5c-ffc2-470b-9806-ec2bded38059",
                                "sense_id": "77e1b111-7e8d-39c5-9224-162435971cd7",
                                "text": "„Das Designmöbel, das die Freckenhorsterin Kathrin Siemann entworfen hat, ist zwar einem traditionellen Melkschemel nachempfunden, aber trotzdem ein trendiges Möbelstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
