                    {
                        "sense_id": "471db51d-dcd3-31f4-95f1-de968ff90424",
                        "entry_id": "8a30e18e-e806-3081-9860-9da775571d40",
                        "glosses": [
                            "kaart waarmee een werknemer op de kosten van de werkgever kan tanken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b424c05-bf27-493e-9d57-b02fdf3627f1",
                                "sense_id": "471db51d-dcd3-31f4-95f1-de968ff90424",
                                "text": "Hij leaste een privé-auto voor een spotprijs en gebruikte jaren achtereen tankpassen waarmee hij zijn tank volgooide. Ook liet hij zich geregeld op luxe reisjes trakteren, waarop hij vaak zijn vrouw meenam. Met werk hadden deze tripjes niet veel te maken, heeft de rechtbank vastgesteld."
                            },
                            {
                                "example_id": "1fa04e31-1b14-4349-9bfe-dec9ca27fba7",
                                "sense_id": "471db51d-dcd3-31f4-95f1-de968ff90424",
                                "text": "Ook liet de hoofdverdachte zijn woning verbouwen en zijn tuin inrichten op kosten van bedrijven aan wie hij opdrachten verstrekte. Verder hadden hij en zijn zoon een tankpas en ontvingen ze contant geld."
                            }
                        ]
                    }
