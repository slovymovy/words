                    "sense_id": "2d34f3b7-dce8-3b82-b845-b07b30e5646f",
                    "sense_definition": "Instytucja lub służba udzielająca natychmiastowej pomocy w nagłych wypadkach, zwłaszcza medycznych.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy zobaczyłem wypadek, natychmiast zadzwoniłem na <w>pogotowie</w>.",
                            "target_lang_translations": {
                                "ru": "Когда я увидел аварию, я немедленно позвонил в <w>скорую помощь</w>.",
                                "en": "When I saw the accident, I immediately called the <w>ambulance</w>.",
                                "nl": "Toen ik het ongeluk zag, heb ik meteen de <w>ambulance</w> gebeld.",
                                "de": "Als ich den Unfall sah, rief ich sofort den <w>Rettungsdienst</w>.",
                                "fr": "Quand j'ai vu l'accident, j'ai immédiatement appelé <w>les secours</w>.",
                                "it": "Quando ho visto l'incidente, ho chiamato immediatamente il <w>pronto soccorso</w>.",
                                "cs": "Když jsem uviděl nehodu, okamžitě jsem zavolal <w>záchranku</w>.",
                                "tr": "Kazayı gördüğümde hemen <w>ambulansı</w> aradım.",
                                "es": "Cuando vi el accidente, llamé inmediatamente a <w>urgencias</w>.",
                                "zh": "看到事故时，我立刻<w>拨打</w>了急救电话。"
                            }
                        },
                        {
                            "text": "<w>Pogotowie</w> zabrało rannego pasażera do najbliższego szpitala.",
                            "target_lang_translations": {
                                "ru": "<w>Скорая помощь</w> забрала раненого пассажира в ближайшую больницу.",
                                "en": "The <w>ambulance</w> took the injured passenger to the nearest hospital.",
                                "nl": "De <w>ziekenwagen</w> bracht de gewonde passagier naar het dichtstbijzijnde ziekenhuis.",
                                "de": "Der <w>Rettungsdienst</w> brachte den verletzten Passagier in das nächste Krankenhaus.",
                                "fr": "<w>L'ambulance</w> a emmené le passager blessé à l'hôpital le plus proche.",
                                "it": "L'<w>ambulanza</w> ha portato il passeggero ferito al più vicino ospedale.",
                                "cs": "<w>Sanitka</w> odvezla zraněného pasažéra do nejbližší nemocnice.",
                                "tr": "<w>Ambulans</w> yaralı yolcuyu en yakın hastaneye götürdü.",
                                "es": "La <w>ambulancia</w> llevó al pasajero herido al hospital más cercano.",
                                "zh": "<w>救护车</w>把受伤的乘客送到了最近的医院。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pogotowie ratunkowe"
                    ],
                    "common_phrases": [
                        "wezwać pogotowie",
                        "zadzwonić na pogotowie",
                        "pogotowie techniczne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учреждение или служба, оказывающая немедленную помощь в экстренных случаях, особенно медицинских.",
                        "en": "An institution or service providing immediate assistance in emergencies, especially medical ones.",
                        "nl": "Een instelling of dienst die onmiddellijke hulp verleent in noodgevallen, met name medische hulp.",
                        "de": "Eine Institution oder ein Dienst, der in Notfällen, insbesondere in medizinischen Notfällen, sofortige Hilfe leistet.",
                        "fr": "Institution ou service fournissant une assistance immédiate en cas d'urgence, en particulier médicale.",
                        "it": "Istituzione o servizio che fornisce assistenza immediata in caso di emergenza, in particolare medica.",
                        "cs": "Instituce nebo služba poskytující okamžitou pomoc v naléhavých případech, zejména lékařských.",
                        "tr": "Acil durumlarda, özellikle tıbbi vakalarda anında yardım sağlayan kurum veya servis.",
                        "es": "Institución o servicio que presta asistencia inmediata en casos de emergencia, especialmente médica.",
                        "zh": "提供紧急援助的机构或服务，尤指医疗急救。"
