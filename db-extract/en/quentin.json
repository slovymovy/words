                                    {
                                        "sense_id": "fdab8caa-4aee-3c82-badf-cb9d6571bcaf",
                                        "entry_id": "30fbb183-4bf5-3ed8-96c1-48d40d2a6cc9",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c76aa1-50d4-4a7c-bdf9-889df5fedc28",
                                                "sense_id": "fdab8caa-4aee-3c82-badf-cb9d6571bcaf",
                                                "text": "Ils sont rejoints par Romain Le Gall (« Centre excellence voile - Secours Populaire », bizuth issu du circuit Mini, mais aussi par deux autres nouveaux, le Nordiste Anthony Quentin (« Hace Alur ») et le Toulousain Laurent Givry (« Cap Horn »)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Quentin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56e210ca-cf8c-3052-86d1-4908576d83d3",
                                        "entry_id": "58c79753-4a40-3e48-81ab-809494c3809e",
                                        "glosses": [
                                            "Prénom français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e02095-8b06-446e-9466-a6756ba371b1",
                                                "sense_id": "56e210ca-cf8c-3052-86d1-4908576d83d3",
                                                "text": "Teddy Thomas, Quentin Lespiaucq, Georges-Henri Colombe Reazel et Thierry Paiva, eux, étaient encore présents au milieu de leurs nouveaux coéquipiers."
                                            },
                                            {
                                                "example_id": "9d7b765b-1336-4156-b13f-120728b702c4",
                                                "sense_id": "56e210ca-cf8c-3052-86d1-4908576d83d3",
                                                "text": "À Plymouth, où se déroule le 3ᵉ acte du circuit Sail GP, les Français, emmenés par le Vannetais Quentin Delapierre, ont bien démarré la première journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
