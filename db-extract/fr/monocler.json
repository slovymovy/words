                ],
                "senses": [
                    {
                        "sense_id": "a6d18d6f-ed22-3f49-96cb-5e2361c9f0e3",
                        "entry_id": "973e7961-39c9-3d5f-aac4-1acb57784786",
                        "glosses": [
                            "Doter d'un monocle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b4cf34-76c6-431f-9306-89a7881b1688",
                                "sense_id": "a6d18d6f-ed22-3f49-96cb-5e2361c9f0e3",
                                "text": "Des étudiants monoclés, vêtus comme des notaires, parcouraient parfois les rues en hurlant : « À bas le Boulangisme. » « Vive la Commode ! », répondaient les cousettes en caressant les naseaux des chevaux de fiacre."
                            },
                            {
                                "example_id": "8c5e2e16-d215-46a8-be40-dd66262ec3ef",
                                "sense_id": "a6d18d6f-ed22-3f49-96cb-5e2361c9f0e3",
                                "text": "Il chercha son monocle, le retrouva, se le ficha à l'œil ; ça le fit rire peut-être de se monocler étant à peine vêtu."
                            },
                            {
                                "example_id": "51a1b2d3-0f93-4910-b83d-d298e1c33171",
                                "sense_id": "a6d18d6f-ed22-3f49-96cb-5e2361c9f0e3",
                                "text": "Frangé de parme et d'orangé, un bleu lui monoclait l’œil droit."
                            },
                            {
                                "example_id": "c5a989fb-87ea-4bdf-93e9-292f37b21542",
                                "sense_id": "a6d18d6f-ed22-3f49-96cb-5e2361c9f0e3",
                                "text": "Monoclant un minimum sa tenue, il lissa l’accordéon de sa chemise tachée pour paraître civilisé lors du chemin de retour."
                            }
                        ]
                    }
                ],
