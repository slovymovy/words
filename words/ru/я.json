{
    "word_family": [
        "якать",
        "яканье"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "35204252-ad09-317d-849c-d85507318ef1",
                    "sense_definition": "Местоимение первого лица единственного числа, указывающее на того, кто говорит или пишет.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Я</w> очень люблю читать интересные книги.",
                            "target_lang_translations": {
                                "en": "<w>I</w> really love reading interesting books.",
                                "es": "<w>Yo</w> amo mucho leer libros interesantes.",
                                "nl": "<w>Ik</w> lees heel graag interessante boeken.",
                                "de": "<w>Ich</w> lese sehr gerne interessante Bücher."
                            }
                        },
                        {
                            "text": "Завтра <w>я</w> пойду в магазин за продуктами.",
                            "target_lang_translations": {
                                "en": "Tomorrow <w>I</w> will go to the store for groceries.",
                                "es": "Mañana <w>yo</w> iré a la tienda a comprar comida.",
                                "nl": "Morgen ga <w>ik</w> boodschappen doen in de winkel.",
                                "de": "Morgen gehe <w>ich</w> im Laden Lebensmittel einkaufen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "я думаю",
                        "я знаю",
                        "я хочу",
                        "я могу"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "относится к синониму «аз»"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "относится к синониму «мну»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular pronoun used by a speaker to refer to themselves.",
                        "es": "Pronombre personal de primera persona del singular utilizado por el hablante para referirse a sí mismo.",
                        "nl": "Het persoonlijk voornaamwoord van de eerste persoon enkelvoud, gebruikt door een spreker om naar zichzelf te verwijzen.",
                        "de": "Personalpronomen der ersten Person Singular, das vom Sprecher verwendet wird, um sich selbst zu bezeichnen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "I",
                                "target_lang_sense_clarification": "personal pronoun"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "yo",
                                "target_lang_sense_clarification": "pronombre personal de sujeto"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ik",
                                "target_lang_sense_clarification": "persoonlijk voornaamwoord"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "Personalpronomen der 1. Person Singular"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8085ec90-2ac1-3240-9542-eeb8dbdf5b08",
                    "sense_definition": "Тридцать третья и последняя буква русского алфавита.",
                    "learner_level": "A1",
                    "frequency": "Low",
                    "semantic_group_id": "letter_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Буква <w>я</w> стоит в самом конце алфавита.",
                            "target_lang_translations": {
                                "en": "The letter <w>ya</w> stands at the very end of the alphabet.",
                                "es": "La letra <w>ya</w> está al final del alfabeto.",
                                "nl": "De letter <w>ja</w> staat helemaal aan het einde van het alfabet.",
                                "de": "Der Buchstabe <w>Ja</w> steht ganz am Ende des Alphabets."
                            }
                        },
                        {
                            "text": "Он знает этот предмет от а до <w>я</w>.",
                            "target_lang_translations": {
                                "en": "He knows this subject from A to <w>Z</w>.",
                                "es": "Él conoce este tema de la a a la <w>z</w>.",
                                "nl": "Hij kent dit onderwerp van a tot <w>z</w>.",
                                "de": "Er kennt dieses Thema von A bis <w>Z</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "а",
                        "альфа"
                    ],
                    "common_phrases": [
                        "от а до я"
                    ],
                    "target_lang_definitions": {
                        "en": "The thirty-third and final letter of the Russian alphabet.",
                        "es": "La trigésima tercera y última letra del alfabeto ruso.",
                        "nl": "De drieëndertigste en laatste letter van het Russische alfabet.",
                        "de": "Der dreiunddreißigste und letzte Buchstabe des russischen Alphabets."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ya",
                                "target_lang_sense_clarification": "letter name"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ya",
                                "target_lang_sense_clarification": "nombre de la letra"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ja",
                                "target_lang_sense_clarification": "naam van de letter"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ja",
                                "target_lang_sense_clarification": "Name des russischen Buchstabens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "980f6700-5574-3967-915f-aed9b3d8ef9c",
                    "sense_definition": "Философское или психологическое понятие, обозначающее собственную личность, самосознание или эго.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ego_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его огромное <w>я</w> требует постоянного внимания окружающих.",
                            "target_lang_translations": {
                                "en": "His enormous <w>ego</w> demands constant attention from those around him.",
                                "es": "Su enorme <w>ego</w> exige la atención constante de los demás.",
                                "nl": "Zijn enorme <w>ego</w> eist voortdurend aandacht van de mensen om hem heen.",
                                "de": "Sein riesiges <w>Ego</w> verlangt ständige Aufmerksamkeit von seinen Mitmenschen."
                            }
                        },
                        {
                            "text": "В каждом человеке скрыто его истинное <w>я</w>.",
                            "target_lang_translations": {
                                "en": "Inside every person is hidden their true <w>self</w>.",
                                "es": "En cada persona se esconde su verdadero <w>yo</w>.",
                                "nl": "In ieder mens zit zijn ware <w>ik</w> verborgen.",
                                "de": "In jedem Menschen verbirgt sich sein wahres <w>Ich</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "эго",
                        "личность",
                        "индивид",
                        "индивидуум"
                    ],
                    "antonyms": [
                        "не-я",
                        "общество",
                        "социум",
                        "толпа"
                    ],
                    "common_phrases": [
                        "второе я",
                        "моё я"
                    ],
                    "target_lang_definitions": {
                        "en": "A philosophical or psychological concept referring to one's own personality, self-awareness, or ego.",
                        "es": "Concepto filosófico o psicológico que se refiere a la propia personalidad, autoconciencia o ego.",
                        "nl": "Een filosofisch of psychologisch concept dat verwijst naar iemands eigen persoonlijkheid, zelfbewustzijn of ego.",
                        "de": "Ein philosophisches oder psychologisches Konzept, das sich auf die eigene Persönlichkeit, das Selbstbewusstsein oder das Ego bezieht."
                    },
