                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818d081b-51b3-42e7-88cb-263b4ffda28d",
                                "sense_id": "2e63f8c2-4541-3f3a-865e-d31cc53a67c9",
                                "text": "„Die 31-jährige Weltmeisterin feierte am Samstag in Bad Kleinkirchheim ihren ersten Abfahrtssieg im Weltcup und beendete auf der ‚Franz Klammer‘-Piste die dreijährige Durststrecke der ÖSV-Damen in der Königsdisziplin.“"
                            },
                            {
                                "example_id": "7b207645-a206-44b3-a35e-e89ee6933399",
                                "sense_id": "2e63f8c2-4541-3f3a-865e-d31cc53a67c9",
                                "text": "„Thomas Dreßen sorgt in Kitzbühel für die Topsensation und holt sich den Abfahrtssieg.“"
                            }
                        ],
