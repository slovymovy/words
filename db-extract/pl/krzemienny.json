                                        ]
                                    },
                                    {
                                        "sense_id": "5246d448-81e6-3f88-80c5-506321a6d55f",
                                        "entry_id": "71dfd939-2d96-3dfd-9663-8cf1eb1eff26",
                                        "glosses": [
                                            "Showing a lack of emotion."
                                        ],
                                        "tags": [
                                            "figuratively"
