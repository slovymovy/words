                                        "sense_id": "ea5148be-6d99-394e-8972-5b82756f2f7b",
                                        "entry_id": "864ed798-bffe-3df6-8cf4-ddcb9a6d5626",
                                        "glosses": [
                                            "Located on or near a shore."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1e3ee6-3f3c-45c7-a116-def2dedf29a5",
                                                "sense_id": "ea5148be-6d99-394e-8972-5b82756f2f7b",
                                                "text": "The seamen, in view of the cold and the wind, had for the most part slunk ashore, and were now roaring and singing in the shoreside taverns."
                                            },
                                            {
                                                "example_id": "886c8474-c51d-482b-a2ca-a4b6961b3312",
                                                "sense_id": "ea5148be-6d99-394e-8972-5b82756f2f7b",
                                                "text": "On shore I could see the glow of the great campfire burning warmly through the shoreside trees."
                                            },
                                            {
                                                "example_id": "5cee3b6b-f9aa-45ea-8591-7521f53c47bf",
                                                "sense_id": "ea5148be-6d99-394e-8972-5b82756f2f7b",
                                                "text": "What were once shoreside amenities now stand forlornly in the middle of the desert, a 300-yard hike from the beach."
                                            }
