                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe85c251-468a-4c55-ae00-1550cb1991ce",
                                                "sense_id": "d5a013e2-e7be-369d-a8e8-a8539fa437a0",
                                                "text": "Die neue Auftragserfassungssoftware ist jetzt in Produktion."
                                            },
                                            {
                                                "example_id": "99b0dd2c-7530-4574-8715-d163e887bc68",
                                                "sense_id": "d5a013e2-e7be-369d-a8e8-a8539fa437a0",
                                                "text": "Die strikte Trennung von Entwicklung und Produktion, speziell der Verarbeitung von Testdaten und Echtdaten, muss gewährleistet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "70a39fca-6b05-3326-a41f-dc70c2963ace",
                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
                                            "Regel in einer formalen Grammatik, die eine zulässige Ersetzung in einer Satzform beschreibt"
                                        ],
                                        "tags": [
                                            "Formale Sprachen"
                                        ],
                                        "examples": [
