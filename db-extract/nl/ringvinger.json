                "translations": [
                    {
                        "translation_id": "befdde71-0562-457a-8176-bdecf008baa4",
                        "source_entry_id": "3b8af2fc-b3d2-3e5b-81cd-ea100422cc9d",
                        "source_sense_id": "9b54125d-75fa-35d5-b40b-f276d31e54c2",
                        "source_sense_description": "vierde vinger gerekend vanaf de duim",
                        "target_lang_word": "Ringfinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ringfinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                        "entry_id": "e2c3c78c-08ed-3e19-a10f-eca1e248c0ad",
                                        "glosses": [
                                            "der vierte Finger der Hand, der sich zwischen dem Mittelfinger und dem kleinen Finger befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79921832-e358-405e-8493-eb832f08ca1f",
                                                "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                                "text": "Sie trägt gar keinen Schmuck an ihrem Ringfinger."
                                            },
                                            {
                                                "example_id": "703f5b9e-fc49-4990-b93d-ce5fec07161c",
                                                "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                                "text": "„Fanny nahm den Tassenhenkel mit Daumen und Zeigefinger und spreizte den Mittelfinger, den Ringfinger und den kleinen Finger ab.“"
                                            },
                                            {
                                                "example_id": "4aeb6248-4fec-476d-a0a9-b4b3c3bfbe06",
                                                "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                                "text": "„Denn die alten Griechen glaubten, dass eine Vene vom linken Ringfinger direkt zum Herzen führt.“"
                                            },
                                            {
                                                "example_id": "c3e0d9ce-6142-4989-8410-ebfab9034113",
                                                "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                                "text": "„Eines Tages wagte ich ihm zu sagen, daß die Hand einer Hauptfigur auf einem seiner Gemälde mir verzeichnet erscheine, weil der Ringfinger kürzer sei als der Zeigefinger.“"
                                            },
                                            {
                                                "example_id": "3d2b02ee-a8a8-4c11-b337-0b4e80935134",
                                                "sense_id": "9077da88-2f17-3d2d-9bb3-ec49ee5c0efa",
                                                "text": "„Als sie eintreten durfte, war ihr Vater aufgestanden, hatte Schaftstiefel und einen dicken Mantel an, trug Perücke, am Ringfinger der rechten Hand den schweren Goldring.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa73eaf-db5b-4557-bae0-f6afe304fc35",
