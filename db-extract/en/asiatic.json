                        "entry_id": "a0b5e317-84e9-3b7b-8a4c-54c30c6acb3e",
                        "glosses": [
                            "An Asian."
                        ],
                        "tags": [
                            "dated",
                            "offensive",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "a2fd934d-fe0b-4c92-97d1-af1e4e67173f",
                                "sense_id": "ae4f566d-ee6e-3427-83eb-de29e48ecc4a",
                                "text": "[…] the Aryan races will not wholesomely amalgamate with the Africans or the Asiatics […] the cross of those races, like the cross of the dog and the fox, is not successful; it cannot be, and never will be."
                            }
                        ]
                    },
                    {
