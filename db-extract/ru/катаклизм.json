                    {
                        "translation_id": "4f430eea-fc85-48de-a68e-0b2ca211d443",
                        "source_entry_id": "6f3e02d6-d45f-31b0-a9fa-73114879f4f2",
                        "source_sense_id": "ee5d502d-72af-3b16-9210-f3261430d37c",
                        "target_lang_word": "Katastrophe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katastrophe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                        "entry_id": "c2649a2a-35b0-3477-8bcd-46a9639e0b94",
                                        "glosses": [
                                            "großes, schweres Unglück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98bb5cd-3911-4ea1-a7f8-da9b12208f4a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "Die sich anbahnende Katastrophe war nicht mehr zu verhindern."
                                            },
                                            {
                                                "example_id": "1106ec3f-25cd-41e1-a32b-b82b241751c2",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Die Reaktorkatastrophe sei ein desaströser Anlass, »doch zugleich auch eine Chance, von einem Pfad abzukommen, der Kollaps, Katastrophen und Kriege heraufbeschwört«, sagt er.“"
                                            },
                                            {
                                                "example_id": "7d25ed39-52b6-4322-857b-3062d469c33a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Die Folgen von kollektiven Katastrophen hatten in der Psychoanalyse kein Gewicht.“"
                                            },
                                            {
                                                "example_id": "c1237f95-3ee9-4180-8f59-4e5560e742e2",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Als wir fünf Jahre nach der Katastrophe durch New Orleans spazieren, ist das größte Chaos beseitigt.“"
                                            },
                                            {
                                                "example_id": "e1b8698d-4309-4f98-a449-6300009ed776",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Das Feuer auf dem Öltanker Annika ist gelöscht. Rettungskräfte verhinderten eine Katastrophe vor der Küste von Mecklenburg-Vorpommern.“"
                                            },
                                            {
                                                "example_id": "d2ba371e-8fa2-4ef1-b426-cc616116250f",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "„Niemand möchte Entscheidungen treffen und Befehle erteilen, die einem Eingeständnis der Katastrophe gleichkämen.“"
                                            },
                                            {
                                                "example_id": "7cf06397-fcf6-4694-8bf7-0d5941548d3a",
                                                "sense_id": "7c3523dc-5f4a-3d3f-a17a-db12b8b98d4f",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Sie betrachtete den Krieg als eine Katastrophe und versuchte, nicht an ihn zu denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a32913e-b499-37ad-8de5-0ec6b7eced8b",
                                        "entry_id": "c2649a2a-35b0-3477-8bcd-46a9639e0b94",
                                        "glosses": [
                                            "entscheidende Wende in einer Tragödie"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbc13fc-5893-4388-afa0-1589ffa17385",
                                                "sense_id": "0a32913e-b499-37ad-8de5-0ec6b7eced8b",
                                                "text": "„Ein Hollywood-Film folgt der Dramaturgie des griechischen Theaters, weil dieses die effizientesten Wirkungsregeln entwickelt und benannt hat: Exposition, Peripetie und Anagnorisis, Katastrophe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
