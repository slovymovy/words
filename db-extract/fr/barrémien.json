                "senses": [
                    {
                        "sense_id": "b98236c9-ee42-35ff-8cba-089c97b7ff4a",
                        "entry_id": "b0e23657-927f-338a-aa6a-bba1cab48b1f",
                        "glosses": [
                            "Quatrième étage du Crétacé inférieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5311198-85ce-4c00-acf7-f143b02a2860",
                                "sense_id": "b98236c9-ee42-35ff-8cba-089c97b7ff4a",
                                "text": "Cette disposition très favorable permet de reconnaître niveau par niveau –et sans ambiguïté– la répartition strati-graphique ^([sic]) des organismes, en particulier les fora-minifères ^([sic]) benthiques qui peuplaient les milieux peu profonds de cette plate-forme au Barrémien et à l’Aptien inférieur."
                            },
                            {
                                "example_id": "cd4c7560-32ec-4b6f-8180-f2455eb8d3b9",
                                "sense_id": "b98236c9-ee42-35ff-8cba-089c97b7ff4a",
                                "text": "Le litige concernant la limite supérieure de l'étage provient de l'identification des stratotypes de l'Hauterivien et du Barrémien, lithologiquement et paléontologiquement très différents."
                            }
                        ]
                    }
