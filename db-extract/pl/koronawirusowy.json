                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10719527-d615-419e-bad6-15788c7af9da",
                                "sense_id": "7770caaf-45e1-3b38-adb6-40671527b356",
                                "text": "Choroba koronawirusowa przenosi się głównie przez kontakt z zarażonymi osobami, które kichają lub kaszlą."
                            },
                            {
                                "example_id": "957c935b-cb0c-47c1-9a48-cd4f0c3ef689",
                                "sense_id": "7770caaf-45e1-3b38-adb6-40671527b356",
                                "text": "USA przygotowują się na „koronawirusowe Pearl Harbor”"
                            },
                            {
                                "example_id": "33dedc94-1275-43a0-956e-0e4068d03a2d",
                                "sense_id": "7770caaf-45e1-3b38-adb6-40671527b356",
                                "text": "Rodzice, którzy wezmą wolne, by opiekować się dzieckiem, mogą ubiegać się o dodatkowy zasiłek opiekuńczy, tzw. koronawirusowy"
                            }
                        ],
