                "senses": [
                    {
                        "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                        "entry_id": "f741d09b-daf6-3707-9f53-aaa46bb8be63",
                        "glosses": [
                            "Clipping of video."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ae97a0e4-a482-44db-b477-0abd1b48050e",
                                "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                                "text": "Check out the cool new vids on YouTube!"
                            },
                            {
                                "example_id": "df9c7025-a134-4599-97cf-3e2d0b57afd2",
                                "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                                "text": "Man, I was so pissed off at you. I got blind drunk that night, and it was a few days later before I got it together enough to check the news vids and saw that almost all those mercs had gotten killed by Archangel."
                            },
                            {
                                "example_id": "64c63295-bfa9-4cbd-81ef-3d4ce9565785",
                                "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                                "text": "As this vidder's website modestly states: \"I think of this vid as my proof of how slashy these shows are. […]"
                            },
                            {
                                "example_id": "55e55ba3-c1c6-4921-94d1-c5a88a33bb86",
                                "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                                "text": "The vids were kind of dumb but fun, not scary or gory, and there wasn’t much math to it, really, just some graphs with curvey lines, yeah, so the vids, not much help."
                            },
                            {
                                "example_id": "3495f22f-13dd-4519-8c4b-ad0f68b7bb8b",
                                "sense_id": "94af5334-0c21-34db-96a6-cdf604acf92f",
                                "text": "“Do you think when hamsters watch us eat, they think we're cute?” “How could they not? I tried to show this amazing vid to my mom. She just stared at me like I was cray. My mom and I don't have much in common anymore. It's, like, a bummer.”"
                            }
                        ]
                    },
