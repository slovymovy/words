                        ],
                        "form": "die Laubwälder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2bcff1e-9014-340e-b076-646bc2a458b5",
                        "entry_id": "865fb295-3c20-3148-a41d-6e206769225b",
                        "glosses": [
                            "ein Wald, der ausschließlich aus Laubbäumen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b02356fb-7a11-45d4-bcc4-bbef67f85069",
                                "sense_id": "e2bcff1e-9014-340e-b076-646bc2a458b5",
                                "text": "Laubwälder sind im Herbst besonders farbenfroh."
                            },
                            {
                                "example_id": "644ac514-b662-43fd-8f1a-b1fd9a6368bb",
                                "sense_id": "e2bcff1e-9014-340e-b076-646bc2a458b5",
                                "text": "„Kennzeichnend für diese einzigartige Naturlandschaft sind die zahlreichen Bäche, Flüsse, Stauseen sowie die großflächigen Laubwälder mit ihrer seltenen Flora und Fauna.“"
                            },
                            {
                                "example_id": "6eed301c-7a07-4181-8ac1-3458d9468168",
                                "sense_id": "e2bcff1e-9014-340e-b076-646bc2a458b5",
                                "text": "„In den ozeanisch geprägten Teilen der kühlgemäßigten Breiten sind sommergrüne Laubwälder weit verbreitet.“"
                            },
                            {
                                "example_id": "b78aac05-8ea3-4ca5-bd08-4a29a00c2b7a",
                                "sense_id": "e2bcff1e-9014-340e-b076-646bc2a458b5",
                                "text": "„In ihrer Eile nahmen sie die Größe der Landschaft kaum wahr, die von Laubwald bedeckten Bergrücken, die weiß leuchtenden Birken neben der Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
