                ],
                "senses": [
                    {
                        "sense_id": "403e4243-9a48-32cc-a182-010c9fe2d58b",
                        "entry_id": "9fc59c7f-7360-3ccf-bbf5-92117ab645d9",
                        "glosses": [
                            "Donner à une manifestation un caractère rappelant le mouvement de contestation français des gilets jaunes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22da51b6-bda8-4640-be54-e8b1e3ebebf0",
                                "sense_id": "403e4243-9a48-32cc-a182-010c9fe2d58b",
                                "text": "Gilet-jauner le mouvement social c'est d'une part maintenir la pression en soutenant des grèves ponctuelles sur le temps long mais également poursuivre l’investissement conflictuel du lieu de travail et tenter de convaincre les travailleurs de tous les secteurs et sous tous les statuts de mener des actions pour atteindre le fonctionnement normal de leur cadre professionnel, s’organiser dans leur sphère d’activité, organiser des lieux de débat et de décision, etc."
                            },
                            {
                                "example_id": "eb004932-d88c-44c5-9b2e-0c5a9eacada5",
                                "sense_id": "403e4243-9a48-32cc-a182-010c9fe2d58b",
                                "text": "Allons gilet-jauner nos festivals cet été !"
                            },
                            {
                                "example_id": "c2ae8d45-6c29-464c-a77e-c7467db89ad6",
                                "sense_id": "403e4243-9a48-32cc-a182-010c9fe2d58b",
                                "text": "Prenant acte de la tribune « Nous ne sommes pas dupes », et partant de notre envie de « gilet-jauner » le milieu de la culture, encore trop frileux face à ce mouvement, nous nous sommes présenté.e.s à vous, ce lundi 13 mai, au Théâtre des Folies Bergère."
                            }
                        ]
                    }
                ],
