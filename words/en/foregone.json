{
    "word_family": [
        "forego",
        "foregoer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "613234f4-c77b-3c7c-a31f-7985993df178",
                    "sense_definition": "Certain to happen or already decided before it occurs",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The result of the election was a <w>foregone</w> conclusion after the main opponent withdrew.",
                            "target_lang_translations": {
                                "de": "Das Wahlergebnis war nach dem Rückzug des Hauptgegners eine <w>ausgemachte Sache</w>."
                            }
                        },
                        {
                            "text": "It is not a <w>foregone</w> conclusion that the team will win the championship this year.",
                            "target_lang_translations": {
                                "de": "Es ist keine <w>ausgemachte Sache</w>, dass das Team dieses Jahr die Meisterschaft gewinnt."
                            }
                        }
                    ],
                    "synonyms": [
                        "inevitable"
                    ],
                    "common_phrases": [
                        "foregone conclusion"
                    ],
                    "target_lang_definitions": {
                        "de": "Sicher eintretend oder bereits vorab entschieden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unvermeidlich",
                                "target_lang_sense_clarification": "etwas, das nicht abgewendet werden kann"
                            },
                            {
                                "target_lang_word": "vorhersehbar",
                                "target_lang_sense_clarification": "etwas, dessen Ausgang bereits klar ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faeb37ff-5045-3781-8bc9-9bc6fa7d543c",
                    "sense_definition": "Existing or happening in the past",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>foregone</w> era of industrial growth left behind many abandoned factories.",
                            "target_lang_translations": {
                                "de": "Die <w>vergangene</w> Ära des industriellen Wachstums hinterließ viele verlassene Fabriken."
                            }
                        },
                        {
                            "text": "We must learn from our <w>foregone</w> mistakes to build a better future.",
                            "target_lang_translations": {
                                "de": "Wir müssen aus unseren <w>vergangenen</w> Fehlern lernen, um eine bessere Zukunft aufzubauen."
                            }
                        }
                    ],
                    "synonyms": [
                        "former",
                        "past"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or dated context"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In der Vergangenheit liegend oder existierend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vergangen",
                                "target_lang_sense_clarification": "nicht mehr aktuell, in der Vergangenheit liegend"
                            },
                            {
                                "target_lang_word": "ehemalig",
                                "target_lang_sense_clarification": "früher existierend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "938ba5ae-6fda-3c30-85f2-35db5d35689c",
                    "sense_definition": "Past participle of <w>forego</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has <w>foregone</w> its right to claim damages in this legal dispute.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen hat in diesem Rechtsstreit auf sein Recht auf Schadensersatz <w>verzichtet</w>."
                            }
                        },
                        {
                            "text": "Many families have <w>foregone</w> their annual vacation to save money for the future.",
                            "target_lang_translations": {
                                "de": "Viele Familien haben auf ihren Jahresurlaub <w>verzichtet</w>, um Geld für die Zukunft zu sparen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb forego"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Perfekt des Verbs 'forego' (verzichten auf)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verzichtet",
                                "target_lang_sense_clarification": "Partizip Perfekt des Verbs verzichten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}