                        "target_lang_word": "zoogeographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoogeographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5c80ace-00fd-3a7d-a9f7-14e25638704d",
                                        "entry_id": "5573596d-313e-3cf1-8565-c691732f4a36",
                                        "glosses": [
                                            "Of or relating to zoogeography; concerning the geographic distribution of animals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "151c5d5e-1d40-497a-8112-6687b63a2f4a",
                                                "sense_id": "d5c80ace-00fd-3a7d-a9f7-14e25638704d",
                                                "text": "An arm of the Tethys known as the Turgai Strait was an important zoogeographic barrier, cutting Asia off from Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c5cc316-1987-470b-9b92-acc0efe0c04f",
                        "source_entry_id": "39ae7c2b-fe43-3c61-b6de-c47e2b26c819",
                        "source_sense_id": "10d06d75-e665-3c0d-984f-2b7584799a93",
                        "target_lang_word": "zoogéographique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoogéographique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "258277a9-ce24-3976-980a-c918586f4871",
                                        "entry_id": "1ef54fe2-a155-3e0f-87b0-ae703cbe48f7",
                                        "glosses": [
                                            "Relatif à la zoogéographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d9df68-20a4-4f7a-8c5e-a5fccb381ba2",
                                                "sense_id": "258277a9-ce24-3976-980a-c918586f4871",
                                                "text": "Il est donc impossible de trouver un système général de divisions zoogéographiques qui convienne à toutes les espèces animales terrestres."
                                            },
                                            {
                                                "example_id": "32845dc3-c476-4c0e-a262-b0cb95e6904d",
                                                "sense_id": "258277a9-ce24-3976-980a-c918586f4871",
                                                "text": "La province zoogéographique était définie comme une vaste aire où est présente une faune caractéristique en raison d'une position géographique par rapport à des barrières (y compris climatiques), en excluant ainsi le faciès en tant que facteur de contrôle du provincialisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
