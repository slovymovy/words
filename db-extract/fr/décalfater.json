                        "sense_id": "56aa6fd9-14c4-3070-af30-3e052b6afcee",
                        "entry_id": "ba56cfcc-750d-37ef-ab67-efbf7abd40b2",
                        "glosses": [
                            "Enlever ce qui avait été mis dans les interstices lors du calfatage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815856ce-30a4-445c-ae8e-e4d0d02021b2",
                                "sense_id": "56aa6fd9-14c4-3070-af30-3e052b6afcee",
                                "text": "Au commencement, nous avons dû décalfater, une opération qui consiste à retirer le calfat (cordes de chanvre) coincé dans les jointures des bordages."
                            },
                            {
                                "example_id": "56736d1c-8d8d-4bbb-8afd-95f8fe46c15c",
                                "sense_id": "56aa6fd9-14c4-3070-af30-3e052b6afcee",
                                "text": "Pendant ce temps, Sara continue à tout décalfater."
                            },
                            {
                                "example_id": "977fe3f6-b609-44b7-aa7c-7ad2fb2aa07a",
                                "sense_id": "56aa6fd9-14c4-3070-af30-3e052b6afcee",
                                "text": "Anciens outils de charpentier de marine, destiné à décalfater et à calfater."
                            }
                        ]
                    }
