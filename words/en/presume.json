{
    "word_family": [
        "presumption",
        "presumptive",
        "presumptuous",
        "presumably"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ac09406-78fc-344e-a706-3048183a6750",
                    "sense_definition": "To assume or suggest to be true without proof; to take for granted or suppose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>presume</w> that you are tired after your long journey from the airport.",
                            "target_lang_translations": {
                                "ru": "Я <w>предполагаю</w>, что вы устали после долгой поездки из аэропорта."
                            }
                        },
                        {
                            "text": "Based on the evidence, we can safely <w>presume</w> that the meeting will be canceled.",
                            "target_lang_translations": {
                                "ru": "Основываясь на фактах, мы можем смело <w>предположить</w>, что встреча будет отменена."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppose"
                    ],
                    "antonyms": [
                        "know",
                        "prove"
                    ],
                    "common_phrases": [
                        "safely presume",
                        "presume to be",
                        "reasonable to presume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предполагать или допускать, что что-либо является правдой без доказательств; принимать как должное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "считать что-либо вероятным"
                            },
                            {
                                "target_lang_word": "полагать",
                                "target_lang_sense_clarification": "думать, основываясь на допущении"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "считать возможным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "304d3b22-86a8-3350-b523-3d163f1e5617",
                    "sense_definition": "To be so bold as to do something without proper authority or permission.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would never <w>presume</w> to tell you how to manage your own family affairs.",
                            "target_lang_translations": {
                                "ru": "Я бы никогда не <w>позволил себе</w> указывать вам, как вести ваши семейные дела."
                            }
                        },
                        {
                            "text": "He did not <w>presume</w> to ask for a promotion after only three months of work.",
                            "target_lang_translations": {
                                "ru": "Он не <w>осмелился</w> просить о повышении всего после трех месяцев работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "presume to ask",
                        "not presume to",
                        "presume to suggest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'to' and an infinitive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осмеливаться или иметь дерзость сделать что-либо без надлежащих полномочий или разрешения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмеливаться",
                                "target_lang_sense_clarification": "иметь смелость сделать что-то непозволительное"
                            },
                            {
                                "target_lang_word": "позволять себе",
                                "target_lang_sense_clarification": "делать что-то без разрешения"
                            },
                            {
                                "target_lang_word": "дерзать",
                                "target_lang_sense_clarification": "высокий стиль: отважиться на что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f155717-47e6-30c4-abb0-21601593c1d9",
                    "sense_definition": "To take advantage of or impose upon someone's kindness or a situation for one's own benefit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not wish to <w>presume</w> on your hospitality by staying another night.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>злоупотреблять</w> вашим гостеприимством, оставаясь еще на одну ночь."
                            }
                        },
                        {
                            "text": "It is rude to <w>presume</w> on the generosity of people you have just met.",
                            "target_lang_translations": {
                                "ru": "Грубо <w>пользоваться</w> щедростью людей, которых вы только что встретили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "presume on",
                        "presume upon",
                        "presume on friendship"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually followed by 'on' or 'upon'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злоупотреблять чьей-либо добротой или ситуацией в личных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотреблять",
                                "target_lang_sense_clarification": "использовать чью-то доброту слишком сильно"
                            },
                            {
                                "target_lang_word": "пользоваться",
                                "target_lang_sense_clarification": "эксплуатировать ситуацию или гостеприимство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}