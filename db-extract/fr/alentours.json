        "fr-extract.jsonl": [
            {
                "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                "word": "alentours",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                        "glosses": [
                            "Lieux circonvoisins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4908685-ce8f-4e6e-a010-7b564be15966",
                                "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                                "text": "De qui voulez-vous parler ? car il n’y a ni ours ni loups dans ces alentours, dit le chevalier."
                            },
                            {
                                "example_id": "ccd2ea31-0989-475d-a8a0-2552a4b99a8c",
                                "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                                "text": "En Charente-Maritime, deux spécialités locales subliment ce coquillage : la mouclade, avec une sauce au vin blanc, du pineau, du persil, de l’ail et, selon les recettes, du curry et du jaune d’œuf ; et l’éclade - ou églade -, où les moules sont disposées en spirale sur une planche en bois avant d’être recouvertes d’aiguilles de pin auxquelles on met le feu, ce qui donne un goût fumé à ce plat typique de l’île d’Oléron et des alentours de Royan."
                            }
                        ]
                    },
                    {
                        "sense_id": "854b378c-2648-3202-a25d-729e5d8affb6",
                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                        "glosses": [
                            "Entourage."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "79800592-4935-40fe-bf65-34fb22676032",
                                "sense_id": "854b378c-2648-3202-a25d-729e5d8affb6",
                                "text": "Si vous voulez réussir auprès de ce ministre, assurez-vous de ses alentours."
                            }
                        ]
                    },
                    {
                        "sense_id": "426cd626-c13a-329f-9a97-103bba186acf",
                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                        "glosses": [
                            "Ce qui entoure une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5a5e07-418b-4afa-9afa-11c5a0f288b5",
                                "sense_id": "426cd626-c13a-329f-9a97-103bba186acf",
                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74781584-097d-46df-aa5e-85a6b2ec263f",
                        "source_entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                        "target_lang_word": "Umgebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umgebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                        "entry_id": "c36e6ff0-754d-3e2c-8e1d-2b4e7f139b7f",
                                        "glosses": [
                                            "Bereich um einen Ort"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2768ff28-9355-450d-a397-1094d6504566",
                                                "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                                "text": "In der Umgebung von Göttingen gibt es viele Wälder."
                                            },
                                            {
                                                "example_id": "c1f189e2-2d8e-4cea-a56d-e5b6314f7147",
                                                "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                                "text": "„Auf der Suche nach meinem neuen Domizil begann ich, in die nähere Umgebung Jerichos zu fahren und dort, unter den einzelnen in die Landschaft gestreuten Häusern, Ausschau zu halten.“"
                                            },
                                            {
                                                "example_id": "dc492afe-b8f1-4f39-850e-e9aaa15e70a9",
                                                "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                                "text": "„Da wusste ich, dass er die Gegend von früher wiedererkannte und den Plan der Umgebung im Kopf hatte.“"
                                            },
                                            {
                                                "example_id": "7a6958f8-cbad-4397-9882-697ef59d4a2e",
                                                "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                                "text": "„Wir hatten die Wiener Umgebung hinter uns gelassen, und das Land sah leer aus.“"
                                            },
                                            {
                                                "example_id": "4fc7e36f-f6fa-46f9-b450-fd652e9541fe",
                                                "sense_id": "7b1b3f88-e761-36c9-8ac6-10b51cfa67d8",
                                                "text": "„Ihr Begleiter begann inzwischen eine mit dicken Strichen gezeichnete Karte zu studieren, die die Bahnlinien in der unmittelbaren Umgebung Berlins angab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f77057a1-9e2b-3c11-bc92-455db349f41f",
                                        "entry_id": "c36e6ff0-754d-3e2c-8e1d-2b4e7f139b7f",
                                        "glosses": [
                                            "Personen im Umkreis von jemandem"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca737e0-6215-43c9-9849-99fa9d4c8092",
                                                "sense_id": "f77057a1-9e2b-3c11-bc92-455db349f41f",
                                                "text": "Er hat etliche zwielichtige Gestalten in seiner Umgebung."
                                            },
                                            {
                                                "example_id": "1447bc8c-72a6-4d05-acac-baa34ef35b45",
                                                "sense_id": "f77057a1-9e2b-3c11-bc92-455db349f41f",
                                                "text": "„Charly hatte sich gewundert, von einem so tragischen Fall in seiner Umgebung zu hören, von dem er nichts wußte, er wußte doch sonst alles, was in der Altstadt vorging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "78dadd60-33c2-3d4f-8694-dce9dc917c28",
                                        "entry_id": "c36e6ff0-754d-3e2c-8e1d-2b4e7f139b7f",
                                        "glosses": [
                                            "kurz für Laufzeitumgebung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ce0cd894-bfb2-3a3a-aab8-bcce07bb12fc",
                                        "entry_id": "c36e6ff0-754d-3e2c-8e1d-2b4e7f139b7f",
                                        "glosses": [
                                            "kurz für Umgebungsprogramm"
                                        ],
                                        "tags": [],
