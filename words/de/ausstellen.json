                    "frequency": "Middle",
                    "semantic_group_id": "dokument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ärztin muss mir nach der Untersuchung ein Rezept <w>ausstellen</w>."
                        },
                        {
                            "text": "Das Bürgeramt <w>stellte</w> ihm gestern einen neuen Reisepass <w>aus</w>."
