                        "entry_id": "0efe8ae6-6e50-3914-940e-defaa6d238f7",
                        "glosses": [
                            "nerka zwierzęca"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "72e42349-e4d6-3efd-a63d-a788d8217303",
                        "entry_id": "0efe8ae6-6e50-3914-940e-defaa6d238f7",
