                            {
                                "example_id": "c7245b48-1cd4-45ca-be9a-b8ff7f8a1845",
                                "sense_id": "070227fc-b6e9-369f-b0d2-aab017906119",
                                "text": "Jaap had hetzelf in de middagdienst bijgewoond; hij was er van de bank voor opgerezen en op zijn teenen gaan staan toen hij uit-de-verte groomoe had herkend in het 'hekje', die Doortje ten doop hield; hij kon de witte 'sprei' zien, die aan haar armen was vastgespeld en haar schuine hoofd."
                            },
                            {
                                "example_id": "220f8ef8-dad9-4cfd-a00e-2c6f282ff33d",
                                "sense_id": "070227fc-b6e9-369f-b0d2-aab017906119",
                                "text": "De paus houdt zijn jaarlijkse middagdienst en zegen op Eerste Kerstdag binnen in plaats van buiten op het balkon, om te voorkomen dat op het plein voor de kerk een grote mensenmassa samenkomt."
                            }
