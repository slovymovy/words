                ],
                "senses": [
                    {
                        "sense_id": "170b76bb-2c88-3ed0-834e-b571e5f5f4fd",
                        "entry_id": "5a76d687-89ef-3d7d-b1cb-7f3989ea88b9",
                        "glosses": [
                            "Lieu permettant à une ou des compagnies d’autocars d’assurer un service centralisé aux voyageurs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "990e2dc4-3397-4689-8987-00854234fc72",
                                "sense_id": "170b76bb-2c88-3ed0-834e-b571e5f5f4fd",
                                "text": "À Bordeaux, ville d’une importance à peu près égale à Alger, il existe une autogare due à l’initiative de la Compagnie « Citram »."
                            },
                            {
                                "example_id": "5145bf5d-549c-4124-9040-1515fa1efa1a",
                                "sense_id": "170b76bb-2c88-3ed0-834e-b571e5f5f4fd",
                                "text": "MM. Boutet et Dautry ont inauguré, à Metz, le mois dernier, une autogare pourvue de toutes les commodités."
                            },
                            {
                                "example_id": "a6d2c420-4901-4c50-98f4-aea5ce8701fb",
                                "sense_id": "170b76bb-2c88-3ed0-834e-b571e5f5f4fd",
                                "text": "De nombreuses villes de France ont créé des autogares, dans le numéro de mars-avril de l’Ingénieur-Constructeur, Mr Lemay décrit les principales d’entre elles, ainsi qu’un projet d’autogare étudié pour la ville de Rennes."
                            },
                            {
                                "example_id": "47b3caa1-c793-4070-b835-05cc30ae1552",
                                "sense_id": "170b76bb-2c88-3ed0-834e-b571e5f5f4fd",
                                "text": "Ainsi sa fonction de transit a eu pour effet de développer une sorte de spécialisation mécanique et « voyagiste », et des quartiers entiers de la ville d’Agadez sont voués à cette activité, qu’il s’agisse du quartier de l’autogare, de la route d’Arlit […] ou même du centre-ville."
                            }
                        ]
                    }
