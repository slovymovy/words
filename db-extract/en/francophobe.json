                        "source_sense_id": "26ac32d4-ddd1-3c2f-9abb-b97d0b5b8126",
                        "source_sense_description": "one who dislikes France, the French or French culture",
                        "target_lang_word": "francophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "francophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e255589-97b1-3acb-956e-b096e3cd218d",
                                        "entry_id": "b1a81f8a-6080-3c51-b5bd-98d2c78dac17",
                                        "glosses": [
                                            "Qui hait les Français, la France et les choses de France ou ce qui s’y rapporte de près ou de loin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4057e0c1-e2b8-4418-8a2e-1e9ecd1a1f8e",
                                                "sense_id": "3e255589-97b1-3acb-956e-b096e3cd218d",
                                                "text": "D’autres encore affirmaient que son départ n’était qu’une manœuvre destinée à sauver la face, à faire croire à la population qu’il était le prisonnier de la France et à fomenter ainsi un mouvement francophobe."
                                            },
                                            {
                                                "example_id": "d932a22d-097a-4d3a-bd2f-172cdc88c3c8",
                                                "sense_id": "3e255589-97b1-3acb-956e-b096e3cd218d",
                                                "text": "L’opinion publique italienne ne fut pas informée de ces contacts, mais la presse transalpine publia dans les jours précédant l’entrée en guerre de nombreux articles très francophobes."
                                            },
                                            {
                                                "example_id": "6295fdca-71fa-42d0-9eba-66503f6d31a9",
                                                "sense_id": "3e255589-97b1-3acb-956e-b096e3cd218d",
                                                "text": "Ce phénomène est encore plus marqué au Canada français, qui est systématiquement montré du doigt dans le reste du pays au cours d'une campagne de presse aux forts relents francophobes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "francophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c0d800c-1a57-3e66-a72c-ac8bbadd691e",
                                        "entry_id": "04dc333c-79ab-3b8c-98b4-0198cae340e8",
                                        "glosses": [
                                            "Qui hait les Canadiens français, en parlant des Canadiens anglais."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "682b3079-af02-477d-9867-f29e1267068c",
                                                "sense_id": "8c0d800c-1a57-3e66-a72c-ac8bbadd691e",
                                                "text": "En 1924, Jules Tremblay, se faisant sans doute le porte-parole des traducteurs fédéraux qui côtoient des francophobes tant à l’intérieur qu’à l’extérieur de la fonction publique, exprime son point de vue lors d’une activité culturelle organisée par la Ligue de la Bonne entente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
