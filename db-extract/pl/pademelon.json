                        "cross_references": [
                            {
                                "target_word": "pademelon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f36e9bf6-9c9d-3775-aaea-ed6118172e91",
                                        "entry_id": "a989261b-08a0-3207-a9b2-0826c1a1ac6b",
                                        "glosses": [
                                            "Any wallaby of the genus Thylogale of small macropods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4966bd8b-0b49-439a-88c7-70f8a0d79abd",
                                                "sense_id": "f36e9bf6-9c9d-3775-aaea-ed6118172e91",
                                                "text": "Although Pademelons are solitary and territorial by nature, it is not uncommon to witness small groups feeding in close proximity to one another."
                                            },
                                            {
                                                "example_id": "b52fb278-bc13-49bf-9e50-75cb3a76d04c",
                                                "sense_id": "f36e9bf6-9c9d-3775-aaea-ed6118172e91",
                                                "text": "Kangaroos and their relatives that live in the rainforest include pademelons, wallabies, and tree kangaroos. Pademelons are small kangaroo-like marsupials that prefer solitary nocturnal life in the rainforest."
                                            },
                                            {
                                                "example_id": "01d7bed3-c279-4c10-b1c9-18e5b4eb2f39",
                                                "sense_id": "f36e9bf6-9c9d-3775-aaea-ed6118172e91",
                                                "text": "Pademelons are a distinct group of small wallabies, considerably smaller than both the giant kangaroos and the other, larger wallabies. When foraging slowly, pademelons usually move on all fours."
                                            }
                                        ]
                                    }
                                ]
                            },
