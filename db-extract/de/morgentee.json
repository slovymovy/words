                "senses": [
                    {
                        "sense_id": "d387d04c-b845-37a8-922c-da12c121691a",
                        "entry_id": "05e22e69-7350-35a1-a436-e0ac07608798",
                        "glosses": [
                            "Tee, der am Morgen getrunken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e69387-e605-490e-a0b1-c68e7621b420",
                                "sense_id": "d387d04c-b845-37a8-922c-da12c121691a",
                                "text": "„Der kalte graue Morgen und ein leichter, aber beharrlicher Graupelschauer, der mit spitzen Nadeln vom Himmel fiel, hielten ihn nicht davon ab, den Morgentee in seinem kargen Garten im Hausmantel einzunehmen.“"
                            },
                            {
                                "example_id": "bbe07c8f-6fe5-4417-84ec-692f8832b848",
                                "sense_id": "d387d04c-b845-37a8-922c-da12c121691a",
                                "text": "„Manche sind unterwegs, um Feuerholz für ihren Morgentee zu sammeln, andere fummeln fluchend an ihren nicht funktionierenden Gaskartuschen herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
