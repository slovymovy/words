                                "target_senses": [
                                    {
                                        "sense_id": "80293156-5fb3-3dd2-9062-11e700874db2",
                                        "entry_id": "b4a3bba6-00c1-3278-a4cc-4a8d534da545",
                                        "glosses": [
                                            "als Feind; wie ein Feind; ein Feind seiend; vom Feind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d05e08-012d-4914-8c75-21a1addcd928",
                                                "sense_id": "80293156-5fb3-3dd2-9062-11e700874db2",
                                                "text": "Feindliche Truppen bewegen sich auf allen Fronten vorwärts."
                                            },
                                            {
                                                "example_id": "6d008794-f5c6-48c2-8308-a42ed3af85a5",
                                                "sense_id": "80293156-5fb3-3dd2-9062-11e700874db2",
                                                "text": "Die Konservativen standen der neuen Regelung feindlich gegenüber."
                                            },
                                            {
                                                "example_id": "e7175484-1ee5-483f-bc18-6ccb949f2f9f",
                                                "sense_id": "80293156-5fb3-3dd2-9062-11e700874db2",
                                                "text": "Immigranten sehen sich oft feindlichen Äußerungen ausgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d686ae1-c313-4391-b60f-f02840f7b4ab",
                        "source_entry_id": "d63016d4-abf7-359d-a72c-f8088caaafc8",
                        "source_sense_description": "characteristic of, or in the manner of, an adversary",
                        "target_lang_word": "gegnerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gegnerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d3686c6-19e9-3ca6-afd4-12f0a95c914c",
                                        "entry_id": "517e7354-0b4f-398f-ba2c-d9ab9b75b472",
                                        "glosses": [
                                            "den Gegner betreffend, gehörend oder von ihm ausgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765cb8b5-88aa-498c-9479-93017b579c80",
                                                "sense_id": "3d3686c6-19e9-3ca6-afd4-12f0a95c914c",
                                                "text": "„In der Verhaltensbiologie verwendet man den Ausdruck Aggression für Auseinandersetzungen zwischen Artgenossen oder auch zwischen den Vertretern verschiedener Arten; Aggressivität ist die Bereitschaft zur gegnerischen Auseinandersetzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8af19ee-b03f-4a9b-9ca9-a6829555dabf",
                        "source_entry_id": "d63016d4-abf7-359d-a72c-f8088caaafc8",
                        "source_sense_description": "characteristic of, or in the manner of, an adversary",
                        "target_lang_word": "konfliktreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konfliktreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                        "entry_id": "31158733-3b60-33e5-91d8-aeacc1405292",
                                        "glosses": [
                                            "viel Streit habend, viele Konflikte habend/auslösend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "222dfbd1-6d3e-404b-bbb5-61604e6dacbe",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "Die Beziehung zu meinem Vater war sehr konfliktreich."
                                            },
                                            {
                                                "example_id": "86a17c0f-a44d-44b8-9a01-9a21a29a93ba",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "Die konfliktreichen Auseinandersetzungen meiner Eltern waren nicht zum Aushalten."
                                            },
                                            {
                                                "example_id": "1e1c6cea-6868-4159-aabf-6bf67374060a",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "Eine Scheidung ist selten einvernehmlich, fast immer konfliktreich."
                                            },
                                            {
                                                "example_id": "86b07bf8-a725-495a-a718-1c75ddc5f252",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "[Untersuchungen zeigen,] „dass Sexualität kaum befriedigend erlebt werden kann, wenn die Beziehung konfliktreich ist.“"
                                            },
                                            {
                                                "example_id": "c08bcabe-9f68-4808-9eee-542f35ec3a9d",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "[In Neapel] „wurde das Werk sogar eifrig einstudiert und stand kurz vor der Uraufführung, dann kam es während der Generalprobe zum Eklat. In einer konfliktreichen Schlüsselszene gerieten sich die beiden Sängerinnen, die Maria Stuart und deren Halbschwester, die englische Königin Elisabeth I, verkörperten, wirklich in die Haare.“"
                                            },
                                            {
                                                "example_id": "f77c7c60-88b9-4ac1-b49f-2d528897ed3c",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„Russland verbindet mit Afghanistan eine konfliktreiche Geschichte.“"
                                            },
                                            {
                                                "example_id": "e4fb5cce-21e3-49ea-bfef-82301e318e14",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„Die Transformation der ostdeutschen Agrarwirtschaft verlief konfliktreich. Denn ein Teil des Land und Bodens gehörte nicht den Bauern der LPG, sondern waren Volkseigentum und wurden von der Treuhand vermarket – nach der Devise: „privatisieren vor sanieren“.“"
                                            },
                                            {
                                                "example_id": "eed01e2b-d24b-4362-a3f8-feeb43886b7b",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„In der Stunde des Zusammenbruchs [Anmerkung: nach dem ersten Weltkrieg] fällt es der Nation schwer, sich eine neue Ordnung zu geben. Die Weimarer Verfassung ist ein Spiegelbild dieser konfliktreichen Situation.“"
                                            },
                                            {
                                                "example_id": "3d0cfe4a-1cf0-40a3-a6d3-51ef0b8b71ed",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„In politisch konfliktreichen Zeiten erlebt das kulturelle Leben eine besondere Blüte. Das war so auch in der Weimarer Republik, jenen eineinhalb Jahrzehnten zwischen dem Ende der Kaiserzeit und dem Beginn der Naziherrschaft.“"
                                            },
                                            {
                                                "example_id": "4d30e061-0064-499b-8135-1221414d87c6",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„Dieser Ausbruch [Anmerkung: der Krankheit Ebola] ist besonders schwer in den Griff zu bekommen, da in den konfliktreichen Provinzen Nord-Kivu und Ituri etliche Milizen aktiv sind.“"
                                            },
                                            {
                                                "example_id": "39547d14-6c5e-4962-a4e6-b505d2f7d3ed",
                                                "sense_id": "4f35a36f-2efa-38a2-ad11-b16087a0d8fe",
                                                "text": "„Gedränge, Umweltzerstörung, Krankheiten. Schon in prähistorischen Zeiten war das Zusammenleben in Städten konfliktreich, das zeigen jüngste archäologische Funde aus der Südtürkei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14c33a1f-d313-4e88-ab9e-b6f1e4212942",
