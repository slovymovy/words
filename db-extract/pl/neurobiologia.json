                    {
                        "sense_id": "7eb0ad51-2591-3aba-84a6-e09312397b90",
                        "entry_id": "7e2ee036-2e8e-3762-be75-b953ed24e276",
                        "glosses": [
                            "termin na określenie różnych dziedzin nauki, których przedmiotem badań jest układ nerwowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8b4f6e-9d03-4a1b-bb13-9fa43f03879e",
                                "sense_id": "7eb0ad51-2591-3aba-84a6-e09312397b90",
                                "text": "Głównymi dyscyplinami wchodzącymi w skład kognitywistyki są: neurobiologia, neuropsychologia, neurokognitywistyka, społeczna nauka poznawcza, psychologia poznawcza, informatyka, sztuczna inteligencja, robotyka kognitywna, językoznawstwo kognitywne, teoria obliczeń i teoria informacji, antropologia kulturowa, filozofia umysłu oraz wybrane działy logiki (zwłaszcza logika epistemiczna, doksastyczna, semantyka logiczna i teoria systemów dedukcyjnych z jej twierdzeniami limitacyjnymi)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23dd3d62-b8f6-4a7f-a951-fee068248b1d",
                        "source_entry_id": "7e2ee036-2e8e-3762-be75-b953ed24e276",
                        "source_sense_id": "7eb0ad51-2591-3aba-84a6-e09312397b90",
                        "target_lang_word": "neuroscience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neuroscience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                        "entry_id": "27d1a8e0-7229-37d1-bd5e-09e978e594f7",
                                        "glosses": [
                                            "The scientific study of the nervous system."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03da633c-eb13-4401-b5fb-c7d3bf073114",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Meronym: brain science"
                                            },
                                            {
                                                "example_id": "476ac1df-5bc1-4db7-b70f-cb715f6f64b0",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Near-synonym: neurobiology"
                                            },
                                            {
                                                "example_id": "a3bde6b4-6dae-4532-a7c6-60c755de290b",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f11c73-912c-4009-9dbf-eb5a61e5769f",
                        "source_entry_id": "7e2ee036-2e8e-3762-be75-b953ed24e276",
                        "source_sense_id": "7eb0ad51-2591-3aba-84a6-e09312397b90",
