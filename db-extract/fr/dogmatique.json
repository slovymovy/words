                "forms": [
                    {
                        "form_id": "53b3489e-ca1f-4fd0-979c-a239f62d66ba",
                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dogmatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "glosses": [
                            "Qui appartient au dogme ; qui concerne le dogme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bace0f79-d322-4185-98e3-d7a481bcce9b",
                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                "text": "Une autre source qui a fait couler tant de sang a été la fureur dogmatique ; elle a bouleversé plus d'un État, depuis les massacres des Albigeois au XIIIᵉ siècle, jusqu'à la petite guerre des Cévennes au commencement du XVIIIᵉ."
                            },
                            {
                                "example_id": "e6014822-09eb-4ebc-99d5-3e02b5697ea8",
                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                "text": "Telle est, par exemple, la théologie dogmatique, qui n'a pu déposer, au moyen-âge, son enveloppe, son écorce latine."
                            },
                            {
                                "example_id": "79efed2e-73e0-48fe-a26f-b17b2cff767a",
                                "sense_id": "4b201368-521c-3c62-a8e7-d66199549c96",
                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6412697-e943-3029-84df-25b6083e1dbe",
                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "glosses": [
                            "Qui est consacré, usité dans une école de pensée."
                        ],
                        "tags": [
                            "broadly",
                            "common"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                        "entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "glosses": [
                            "Qui dogmatise, qui exprime ses opinions d’une manière impérieuse et tranchante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328a38fe-fe18-4d27-af25-485f5703df21",
                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                "text": "C’est un esprit dogmatique."
                            },
                            {
                                "example_id": "16176464-3d7e-4077-8f04-6c65e78ee09d",
                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                "text": "Il est très dogmatique."
                            },
                            {
                                "example_id": "e4596502-9c22-44bb-b279-66141cb55d30",
                                "sense_id": "afb00ff3-9584-34e0-95d6-8697e9cde85d",
                                "text": "Ton dogmatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "849dd4e4-bc89-41fe-8d15-956a3371a789",
                        "source_entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "source_sense_description": "Adhérant des croyances non nécessairement prouvées (1):",
                        "target_lang_word": "dogmatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dogmatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "188352c9-6499-331a-83a7-4d5e4110680a",
                                        "entry_id": "71c19248-1c4d-3a2c-b03f-ed5164e2d76e",
                                        "glosses": [
                                            "den Anspruch auf Allgemeingültigkeit, Verbindlichkeit erhebend; reflektiert auf einem Dogma beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886c1953-30fa-42a9-9bf0-4ba48cdb48b8",
                                                "sense_id": "188352c9-6499-331a-83a7-4d5e4110680a",
                                                "text": "Die Kirche vertritt eine dogmatische Prinzipienlehre."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5b43c6d-ac41-3ac0-9bdc-fce2bceee3a0",
                                        "entry_id": "71c19248-1c4d-3a2c-b03f-ed5164e2d76e",
                                        "glosses": [
                                            "unkritisch, unreflektiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08dbdfd9-3219-4c34-ac36-6c898561d8fc",
                                                "sense_id": "d5b43c6d-ac41-3ac0-9bdc-fce2bceee3a0",
                                                "text": "„in der zeit, wo ich wesentliche sachen gemacht habe, waren wir sehr dogmatisch, die heutige zeit ist nicht mehr so dogmatisch, damals war es so: ein abstrakter maler hat mit einem gegenständlichen maler nicht mehr geredet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da1d95d7-3b39-4ab2-93b0-96ad30799599",
                        "source_entry_id": "3dec5d58-b2ed-32e8-a2d3-096ab667ff35",
                        "source_sense_description": "Adhérant des croyances non nécessairement prouvées (1):",
                        "target_lang_word": "dogmatic",
