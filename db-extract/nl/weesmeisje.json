                "senses": [
                    {
                        "sense_id": "29894caf-1f03-3e16-b238-a128abd2231d",
                        "entry_id": "64c55e9f-1f57-3e49-974c-f816309d2f49",
                        "glosses": [
                            "een meisje van wie beide ouders overleden zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69960613-d1b4-47b5-a341-0a1a8b483478",
                                "sense_id": "29894caf-1f03-3e16-b238-a128abd2231d",
                                "text": "Het weesmeisje werd in een pleeggezin opgenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dac899fb-374d-4ef8-8bba-f84abecea92d",
                        "source_entry_id": "64c55e9f-1f57-3e49-974c-f816309d2f49",
                        "source_sense_id": "29894caf-1f03-3e16-b238-a128abd2231d",
                        "source_sense_description": "een meisje van wie beide ouders overleden zijn",
                        "target_lang_word": "Vollwaise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vollwaise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                        "entry_id": "3a85ac5e-8b69-3272-b9e1-4cfea1c49eb3",
                                        "glosses": [
                                            "minderjährige Person, die beide Eltern (durch Tod) verloren hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88458418-51b9-43bb-b33d-9b9c38172cf1",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„Im Gegensatz zu der bisherigen Auffassung der Landesversicherungsanstalten hat das Bundessozialgericht festgestellt, uneheliche Kinder, deren Väter nicht bekannt sind, haben nach dem Tode der Mutter als Vollwaise zu gelten.“"
                                            },
                                            {
                                                "example_id": "04d4d233-f937-42c7-a194-1da2daa79406",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„Mutmaßliche Vollwaise warst du, standest hier, auf diesem Sand, der Saspe heißt, und hieltest eine leicht oxydierte Patronenhülse.“"
                                            },
                                            {
                                                "example_id": "bc0e67bc-34ac-469a-abd5-67dd7a67af5a",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„Meine Mutter war eine Vollwaise, mußte als Kind von Almosen leben.“"
                                            },
                                            {
                                                "example_id": "60ba8759-2cea-4168-8857-914bbcc66b1a",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„Er lag noch vier Monate im Koma, dann waren Mutti und Tante Bärbel Vollwaisen.“"
                                            },
                                            {
                                                "example_id": "99de9e1c-c97e-4ec2-9d60-4946336f8aad",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„1932 als Kind assimilierter jüdischer Eltern in Czernowitz geboren, durch den Holocaust zum Vollwaisen gemacht, im Krieg traumatisiert, 1946 nach Palästina verbracht und dem Vergessen unterstellt, hat Appelfeld das 20. Jahrhundert als grosse Verdüsterung erfahren.“"
                                            },
                                            {
                                                "example_id": "95fad683-03d9-4cd6-beb6-aa74bc8fcefd",
                                                "sense_id": "8e580190-4f52-3146-9c54-62c52339caa9",
                                                "text": "„Die Geschichte handelte von zwei siebenjährigen Kindern, Vollwaisen, die auf einem Schrotthaufen ein ausgesetztes Baby gefunden haben; sie spielte zu einer Zeit, in der viele Leute sich ihrer Kinder und Babys entledigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e05188c2-7eac-4dfa-ac4d-6b18327c628a",
                        "source_entry_id": "64c55e9f-1f57-3e49-974c-f816309d2f49",
