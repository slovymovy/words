                ],
                "senses": [
                    {
                        "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                        "entry_id": "36e8872b-4032-34c1-8dd7-1e1319bed2ca",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a5c8b6-63f7-4016-ace7-cd0399b72c40",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Frau Sauter ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "262ec5e6-d6a7-45ec-9372-5bb361f3285b",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Herr Sauter wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "73167627-879d-4e86-9ec0-3dd509f890f7",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Die Sauters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "052db47f-3e32-402f-9570-83c914ef9216",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Der Sauter trägt nie die Schals, die die Sauter ihm strickt."
                            },
                            {
                                "example_id": "78c7a954-26ff-4b50-90ca-108438cd9ae5",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sauter kommt, geht der Herr Sauter.“"
                            },
                            {
                                "example_id": "7561aaf4-115c-4f4a-9425-ab24e643725c",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Sauter kommt und geht."
                            },
                            {
                                "example_id": "bdf486d4-a0ad-4a35-b87d-c7166757576b",
                                "sense_id": "a264e9e5-3fe5-3ce3-ab15-234881f5cc20",
                                "text": "Sauters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
