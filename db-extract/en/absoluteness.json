                    {
                        "translation_id": "64904ede-6de6-4a71-8225-3b7675001d92",
                        "source_entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "source_sense_description": "the fact free from any conditions or other beings",
                        "target_lang_word": "絶対",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "絶対",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "d4947c91-cccc-3776-afea-f24572e3f5e8",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "条件に制約されないこと。無条件。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254bc61a-35bb-4684-861e-1527de3f20ad",
                                                "sense_id": "d4947c91-cccc-3776-afea-f24572e3f5e8",
                                                "text": "これが根本原理で、すなわち絶対というべきものである。この根本原理は静止的のものである、これがすなわち実在である。"
                                            },
                                            {
                                                "example_id": "5f9389fa-34e3-4298-93fa-55452b170c1b",
                                                "sense_id": "d4947c91-cccc-3776-afea-f24572e3f5e8",
                                                "text": "中央委員の命令は絶対だ。諸君はそれを実行すればよいのだ。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e49ff1-0e67-391e-b71b-19414d3d2416",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "永久不変の。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ee5bac-bd34-4a40-ac0e-bd4b86db7687",
                                                "sense_id": "54e49ff1-0e67-391e-b71b-19414d3d2416",
                                                "text": "太宰は小説が書けなくなったと遺書を残しているが、小説が書けない、というのは一時的なもので、絶対のものではない。こういう一時的なメランコリを絶対のメランコリにおきかえてはいけない。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3662e038-ecd6-362a-9583-8ceb24bcca70",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "比べるものや対立するものが無いこと。無比。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b54003-195d-46a0-b5a8-79538b7d3f45",
                                                "sense_id": "3662e038-ecd6-362a-9583-8ceb24bcca70",
                                                "text": "世の中に悪い書物といふものも無いでは無い。が、書物には限らず、総てのものが皆絶対に善いものも無い代りに絶対に悪いものも無い。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411a207b-abc1-3e82-9ec0-1dcb18a7b995",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "他の選択の余地を許さず。かならず。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa92dbde-55ae-41e9-8352-54668438b9b5",
                                                "sense_id": "411a207b-abc1-3e82-9ec0-1dcb18a7b995",
                                                "text": "しかし他の縄張りを絶対に荒らしてはならないというほどの窮屈な規則も約束もない。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a255d6a8-63ea-3a3c-a133-cf2e4c37d39b",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "条件や比較に左右されず、単独で成立すること。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3761aed6-ac23-3030-a89e-88a9edd0dadf",
                                        "entry_id": "d326c2f7-ecbf-31be-b054-5f7b56356511",
                                        "glosses": [
                                            "「絶対」という言葉。完全に安全で確実なこと。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9a9e13-282a-4507-9c01-51ea82fce00b",
                                                "sense_id": "3761aed6-ac23-3030-a89e-88a9edd0dadf",
                                                "text": "山や海に絶対はない。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "絶対",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "deaf015f-a9c0-3d08-a3ff-3096ecaa66a1",
                                        "entry_id": "8a4d9944-980e-3a78-bf87-44aea8def58f",
                                        "glosses": [
                                            "条件無しで、間違いなく、かならず。"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "132e531d-dd4d-4173-a6c1-e5657cd115ba",
                                                "sense_id": "deaf015f-a9c0-3d08-a3ff-3096ecaa66a1",
                                                "text": "ご注意しますが、絶対あんなものには係わらねえほうが、いい。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
