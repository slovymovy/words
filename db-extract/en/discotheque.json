                                            {
                                                "example_id": "c825b4e4-0c67-467b-aab1-e3197ab8e60a",
                                                "sense_id": "b33bb107-c063-3bee-bcb3-3cd725e69380",
                                                "text": "„Meinen ersten Ostkontakt hatte ich nach dem Mauerfall, als ich einen Ostberliner in einer Duisburger Disco kennenlernte.“"
                                            },
