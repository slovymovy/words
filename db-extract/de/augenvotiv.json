                            "Anatomisches Votiv"
                        ],
                        "examples": [
                            {
                                "example_id": "62c075d7-bfc6-4bf9-895c-37c19ca20eb6",
                                "sense_id": "8e400249-142e-32ab-b54d-5298616f2054",
                                "text": "„Augenvotiv aus Wachs“"
                            },
                            {
                                "example_id": "9a109093-c3d9-4b4f-9e88-4bfadc32c5ca",
                                "sense_id": "8e400249-142e-32ab-b54d-5298616f2054",
                                "text": "„Möglich ist aber auch, dass auf die Aufgaben einzelner Körperglieder Bezug genommen wurde: Augenvotive bei schwindender Sehkraft, Ohren bei mangelndem Hörvermögen etc.“"
                            },
                            {
                                "example_id": "7e296204-263e-4fe6-82a7-ec1f287acc13",
                                "sense_id": "8e400249-142e-32ab-b54d-5298616f2054",
                                "text": "„Verankert im Bereich persönlicher Erfahrungen und Erlebnisse, waren Themen wie „Augenvotiv“ oder „Karyatide“ zunächst plastische Projektionen unmittelbar bedrängender Lebenssituationen, in Figur verwandelter Ausdruck psychischer Spannungen.“"
                            },
                            {
                                "example_id": "0f32533a-b5c6-4c3d-af95-9a046f7a4685",
                                "sense_id": "8e400249-142e-32ab-b54d-5298616f2054",
                                "text": "„Beide Stätten hatten zahlreiche Augenvotive in Wachs, Metall und Votivtafeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
