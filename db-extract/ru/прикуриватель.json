                "senses": [
                    {
                        "sense_id": "348932cd-143c-394f-bd15-47e7a42e5ae6",
                        "entry_id": "d03bf35e-4e26-3870-8c3c-b297917900f5",
                        "glosses": [
                            "автомоб. устройство, используемое для прикуривания сигарет во время езды в автомобиле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e55453-7c61-4f7a-9b5f-f4507cd0f155",
                                "sense_id": "348932cd-143c-394f-bd15-47e7a42e5ae6",
                                "text": "Машина у Короткова была совсем дряхлой, непонятно, как она еще передвигалась, и, пожалуй, единственным исправным прибором в ней был прикуриватель."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0d13bd6-4e88-32ff-b9d9-3e9452591cb2",
                        "entry_id": "d03bf35e-4e26-3870-8c3c-b297917900f5",
                        "glosses": [
                            "разг. провода для запуска двигателя с использованием аккумулятора другого автомобиля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40633aa-bbf5-482b-84b4-187470f5b34b",
                                "sense_id": "c0d13bd6-4e88-32ff-b9d9-3e9452591cb2",
                                "text": "Проснулись мы за полдень, разбудил сосед по даче (у него не заводилась машина, попросил прикуриватель)."
                            }
                        ]
                    }
                ],
