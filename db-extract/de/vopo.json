                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25547082-bfcd-4564-8680-13ecdc0757e7",
                                "sense_id": "5eb782bb-3d83-3d92-903d-ee865158130e",
                                "text": "„Die Weltfremdheit der Vopos konnte im Witz aber auch nahezu groteske Züge annehmen.“"
                            },
                            {
                                "example_id": "7665ef06-8267-428c-83b0-202ad281be66",
                                "sense_id": "5eb782bb-3d83-3d92-903d-ee865158130e",
                                "text": "„Zwei Vopos stiegen aus und wollten seine Papiere sehen.“"
                            },
                            {
                                "example_id": "6388a288-6eda-45ed-b14d-d31c0317b30d",
                                "sense_id": "5eb782bb-3d83-3d92-903d-ee865158130e",
                                "text": "[DDR 1989:] „Die Nachrichten überschlugen sich. Vopos hielten von ihren Autos aus Ansprachen an das rebellische Volk. Man bat um Mäßigung“ […]."
                            }
                        ],
