                    }
                ],
                "senses": [
                    {
                        "sense_id": "5750aecf-5495-36fd-b476-e67adfefaae6",
                        "entry_id": "65a11811-ea17-39b4-81f7-88771856a79b",
                        "glosses": [
                            "Confused and irregular; awkward; scambling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0ddb53-4794-42a8-a276-b88b52fc2df7",
                                "sense_id": "5750aecf-5495-36fd-b476-e67adfefaae6",
                                "text": "A huge old scrambling bedroom."
                            }
                        ]
                    },
                    {
                        "sense_id": "d260f269-3139-358c-9f29-78e0bbab3d3d",
                        "entry_id": "65a11811-ea17-39b4-81f7-88771856a79b",
                        "glosses": [
                            "Having a stem too weak to support itself, instead attaching to and relying on the stems or trunks of stronger plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9eb26c-eb8b-4936-b4d0-91a6fb72e550",
                                "sense_id": "d260f269-3139-358c-9f29-78e0bbab3d3d",
                                "text": "All three types of climbing organs here demonstrated for Late Palaeozoic seed ferns are also found in modern angiosperms. This leads to the conclusion that several taxa of Late Palaeozoic seed ferns were well-adapted to climbing and scrambling growth habits."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e2ae8738-3de0-3d10-9584-e4268677f6e5",
                "word": "scrambling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ff2d343c-ff95-4fdb-96e1-96e26de7e128",
                        "entry_id": "e2ae8738-3de0-3d10-9584-e4268677f6e5",
                        "tags": [
                            "plural"
                        ],
                        "form": "scramblings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "279548d0-dbdf-3444-a6bf-ea26a2c63829",
                        "entry_id": "e2ae8738-3de0-3d10-9584-e4268677f6e5",
                        "glosses": [
                            "The act by which something is scrambled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc66c91-7db6-4dbc-b6c6-0f1d291729aa",
                                "sense_id": "279548d0-dbdf-3444-a6bf-ea26a2c63829",
                                "text": "The scrambling of the message made it harder to decode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "519ab1a2-4bad-48cd-a5aa-64519a67e37a",
                        "source_entry_id": "e2ae8738-3de0-3d10-9584-e4268677f6e5",
                        "source_sense_id": "279548d0-dbdf-3444-a6bf-ea26a2c63829",
                        "source_sense_description": "Translations",
                        "target_lang_word": "brouillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brouillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd2729f-b8e7-3542-8cb9-61a634c7d028",
                                        "entry_id": "fb0bd490-63ab-3dd9-9367-e9046e18e4b9",
                                        "glosses": [
                                            "Action de brouiller, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4727cf-5156-47c9-b83c-4dd021632e3d",
                                                "sense_id": "2bd2729f-b8e7-3542-8cb9-61a634c7d028",
                                                "text": "Face au brouillage de l’organisation sociale accompagnant la fin de l’Empire romain d’Occident, les évêques entreprennent de définir localement (…), en s’appuyant sur les commentaires patristiques de la Bible, de nouvelles normes de fonctionnement social, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b65c63c-5098-3c3e-aae0-c7027b197f15",
                                        "entry_id": "fb0bd490-63ab-3dd9-9367-e9046e18e4b9",
                                        "glosses": [
                                            "Émission, réémission ou réflexion de signaux électromagnétiques perturbant le fonctionnement de moyens de détection ou de radiocommunication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8606e89a-2b2f-4c26-b57a-647b5cca3da3",
                                                "sense_id": "7b65c63c-5098-3c3e-aae0-c7027b197f15",
                                                "text": "Il écoute la radio sans cette nervosité qui m’agaçait : il se jetait sur un fauteuil, se levait, s’accrochait au bouton pour essayer d’éliminer le brouillage, jurait, se lamentait… Maintenant, la plupart du temps il rate les informations avec sérénité et se contente de ce que je lui en dis."
                                            },
                                            {
                                                "example_id": "b31a9d73-74e0-4b6b-92ab-35d85133d89a",
                                                "sense_id": "7b65c63c-5098-3c3e-aae0-c7027b197f15",
                                                "text": "15 septembre 1940 – On écoute tous les soirs la radio anglaise comme on prend de la drogue. Même rendue inaudible par le brouillage, elle réconforte. On sait que l’Angleterre vit toujours."
                                            },
                                            {
                                                "example_id": "4c0893cd-7df0-4432-bcc1-249a1486242c",
                                                "sense_id": "7b65c63c-5098-3c3e-aae0-c7027b197f15",
                                                "text": "Le conservateur était sorti de la pièce et déjà tournait le cadre antiparasites qui sur son poste de radio atténuait le brouillage des émissions de Londres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382c1e1b-d729-3484-a373-37fc952408ee",
                                        "entry_id": "fb0bd490-63ab-3dd9-9367-e9046e18e4b9",
                                        "glosses": [
                                            "Trouble apporté à la réception d’un signal utile par des phénomènes indésirables dus à la présence d’autres signaux ou de bruits se superposant à ce signal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4bf45a0-b3da-4124-a86c-37f21ee3df3a",
                                                "sense_id": "382c1e1b-d729-3484-a373-37fc952408ee",
                                                "text": "Le cas du brouillage des téléphones portables est à cet égard exemplaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ce9365-5483-34ec-b323-0ecce1a47c25",
                                        "entry_id": "fb0bd490-63ab-3dd9-9367-e9046e18e4b9",
                                        "glosses": [
                                            "Transformation du code source d’un programme destinée à le rendre incompréhensible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
