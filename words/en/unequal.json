{
    "word_family": [
        "unequally",
        "unequalness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b92760fc-ffbe-391c-843c-ae989c99ec41",
                    "sense_definition": "Not the same in amount, size, value, or status.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers received an <w>unequal</w> share of the inheritance.",
                            "target_lang_translations": {
                                "ru": "Два брата получили <w>неравные</w> доли наследства."
                            }
                        },
                        {
                            "text": "Wealth distribution remains highly <w>unequal</w> across different regions of the country.",
                            "target_lang_translations": {
                                "ru": "Распределение богатства остается крайне <w>неравномерным</w> в различных регионах страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "disparate",
                        "uneven"
                    ],
                    "antonyms": [
                        "equal"
                    ],
                    "common_phrases": [
                        "unequal distribution",
                        "unequal shares",
                        "unequal rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не равный по количеству, размеру, значению или статусу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неравный",
                                "target_lang_sense_clarification": "о количестве, доле, размере или правах"
                            },
                            {
                                "target_lang_word": "неодинаковый",
                                "target_lang_sense_clarification": "различный по величине или значению"
                            },
                            {
                                "target_lang_word": "неравномерный",
                                "target_lang_sense_clarification": "о распределении чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "992e8948-06cb-35f0-a81f-52e58f0c4b76",
                    "sense_definition": "Unfair, poorly matched, or out of balance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was an <w>unequal</w> contest between a seasoned champion and an inexperienced novice.",
                            "target_lang_translations": {
                                "ru": "Это было <w>неравное</w> состязание между опытным чемпионом и неопытным новичком."
                            }
                        },
                        {
                            "text": "The small rebel army fought an <w>unequal</w> battle against a massive military force.",
                            "target_lang_translations": {
                                "ru": "Небольшая армия повстанцев вела <w>неравный</w> бой против огромной военной силы."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneven"
                    ],
                    "antonyms": [
                        "equal"
                    ],
                    "common_phrases": [
                        "unequal battle",
                        "unequal contest",
                        "unequal fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несправедливый, с неравным соотношением сил или несбалансированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неравный",
                                "target_lang_sense_clarification": "о борьбе, схватке или состязании"
                            },
                            {
                                "target_lang_word": "неравноправный",
                                "target_lang_sense_clarification": "несправедливый по условиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98dc5f5c-ab28-3811-80ab-f078d6629e92",
                    "sense_definition": "Lacking the ability, strength, or resources necessary for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt entirely <w>unequal</w> to the task of leading the newly formed department.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя совершенно <w>неспособным</w> справиться с задачей руководства вновь созданным отделом."
                            }
                        },
                        {
                            "text": "She worried that her failing health would leave her <w>unequal</w> to the demands of travel.",
                            "target_lang_translations": {
                                "ru": "Она беспокоилась, что ухудшающееся здоровье сделает её <w>не готовой к</w> тяготам путешествий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unequal to the task",
                        "unequal to the challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий достаточными силами, способностями или ресурсами для выполнения задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособный",
                                "target_lang_sense_clarification": "не справляющийся с задачей"
                            },
                            {
                                "target_lang_word": "не соответствующий",
                                "target_lang_sense_clarification": "не готовый к требованиям или вызову"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "171fb3ef-114e-3a13-abf9-39cbc71bfb5d",
                    "sense_definition": "Inconsistent, variable, or erratic in quality or temperament.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician gave an <w>unequal</w> performance, playing brilliantly at times and carelessly at others.",
                            "target_lang_translations": {
                                "ru": "Музыкант показал <w>неровное</w> исполнение, играя то блестяще, то небрежно."
                            }
                        },
                        {
                            "text": "Her treatment of the staff was notoriously <w>unequal</w> and depended entirely on her mood.",
                            "target_lang_translations": {
                                "ru": "Её отношение к сотрудникам было заведомо <w>непостоянным</w> и зависело исключительно от её настроения."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непостоянный, изменчивый или неравномерный по качеству либо характеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "о выступлении, качестве работы или характере"
                            },
                            {
                                "target_lang_word": "непостоянный",
                                "target_lang_sense_clarification": "переменчивый в поведении или отношении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50fe76d6-ecba-3d03-bcca-0cad794203db",
                    "sense_definition": "A person who is not peer or equal to another in rank, ability, or status.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proud monarch refused to negotiate with people he considered his <w>unequals</w>.",
                            "target_lang_translations": {
                                "ru": "Гордый монарх отказывался вести переговоры с людьми, которых считал <w>не ровней себе</w>."
                            }
                        },
                        {
                            "text": "In a truly democratic society, citizens should never be treated as social <w>unequals</w>.",
                            "target_lang_translations": {
                                "ru": "В по-настоящему демократическом обществе к гражданам никогда не должны относиться как к <w>неравным по положению</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не являющийся ровней другому по рангу, положению или способностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не ровня",
                                "target_lang_sense_clarification": "человек другого ранга или статуса"
                            },
                            {
                                "target_lang_word": "неравный по положению",
                                "target_lang_sense_clarification": "лицо более низкого или иного социального статуса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}