                {
                    "sense_id": "5e4a6944-3954-30be-b384-45d25b6b775f",
                    "sense_definition": "A short, informal form for <w>champagne</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We opened a bottle of <w>champ</w> to celebrate the promotion.",
                            "target_lang_translations": {
                                "ru": "Мы открыли бутылку <w>шампанского</w>, чтобы отметить повышение.",
                                "zh": "我们开了一瓶<w>香槟</w>来庆祝这次晋升。",
                                "es": "Abrimos una botella de <w>champán</w> para celebrar el ascenso."
                            }
                        },
                        {
                            "text": "Would you like a glass of <w>champ</w> before dinner?",
                            "target_lang_translations": {
                                "ru": "Хочешь бокал <w>шампанского</w> перед ужином?",
                                "zh": "晚饭前想来一杯<w>香槟</w>吗？",
                                "es": "¿Te gustaría una copa de <w>champán</w> antes de cenar?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass of champ"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая, неформальная форма слова \"champagne\" (шампанское).",
                        "zh": "“Champagne”的非正式缩写，指香槟酒。",
                        "es": "Forma corta e informal de \"champagne\" (champaña o champán)."
                    },
                    "translations": {
