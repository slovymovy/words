                "senses": [
                    {
                        "sense_id": "f1928c8c-11bd-3e06-ad17-a91d6c3d8d17",
                        "entry_id": "af982669-2160-3fab-bed7-de5f2b6c2093",
                        "glosses": [
                            "hoekmeetinstrument dat onder meer werd gebruikt om de hoogtehoek van een hemellichaam boven de horizon te meten, en om de hoek tussen twee aardse objecten te meten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab40bd8-a6dc-40b9-83d6-a3097b1956da",
                                "sense_id": "f1928c8c-11bd-3e06-ad17-a91d6c3d8d17",
                                "text": "De gradenboog van een sextant is eenzesde deel van een cirkel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "148bb129-5a37-4e2a-8dee-b3c8d8498f90",
                        "source_entry_id": "af982669-2160-3fab-bed7-de5f2b6c2093",
                        "source_sense_id": "f1928c8c-11bd-3e06-ad17-a91d6c3d8d17",
                        "source_sense_description": "hoekmeetinstrument",
                        "target_lang_word": "Sextant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sextant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                        "entry_id": "de518d9a-1942-3045-aa89-09b94b7420fe",
                                        "glosses": [
                                            "optisches Messinstrument zur Messung von Winkeln anhand von fixierten Punkten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e376654-db00-4249-9c75-f1bb0e395744",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "Unter Zuhilfenahme eines Sextanten konnten Seefahrer früher die Position ihres Schiffes auf offenem Meer relativ genau bestimmen."
                                            },
                                            {
                                                "example_id": "bd957352-ed15-492d-8bfa-ce35ec9570cc",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Daher haben sie wohl auch den Sextanten im Gegensatz zu anderen Seefahrervölkern jahrzehntelang ungebraucht im Schrank liegen lassen.“"
                                            },
                                            {
                                                "example_id": "d324d05b-d4fd-452e-bca2-8ca374a3cafc",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Eine Nacht und einen Tag hatte sie allein im Zimmer gewartet, hatte vor Langeweile den Sextanten auseinandergenommen, die gesammelten Pflanzen durcheinander gebracht, von dem für Präparate vorgesehenen Spiritus getrunken und ihren Rausch ausgeschlafen.“"
                                            },
                                            {
                                                "example_id": "7d694b2e-400d-4057-9539-b41395a07408",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Ein Seetag dauerte von Mittag zu Mittag, da man mittags, wenn die Sonne am höchsten stand, mit dem Sextanten die geografische Breite bestimmen konnte.“"
                                            },
                                            {
                                                "example_id": "89372784-3c2a-440e-a325-7dbfa9fbbd81",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Silver besaß einen Kompaß, einen Sextanten und eine Seekarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74dfc76f-9280-32de-84e3-a84a0142fa8b",
                                        "entry_id": "de518d9a-1942-3045-aa89-09b94b7420fe",
                                        "glosses": [
                                            "Sternbild in der Nähe des Himmelsäquators"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96a7f565-90c6-44a9-bfa7-e00c1fe69132",
                        "source_entry_id": "af982669-2160-3fab-bed7-de5f2b6c2093",
                        "source_sense_id": "f1928c8c-11bd-3e06-ad17-a91d6c3d8d17",
                        "source_sense_description": "hoekmeetinstrument",
                        "target_lang_word": "sextant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sextant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7233f5f1-ed89-31fc-b650-e779f64a51f6",
                                        "entry_id": "d9491b8b-f23a-31f8-9148-fd788cb75007",
                                        "glosses": [
                                            "A navigational device for deriving angular distances between objects so as to determine latitude and longitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4feda180-2ed5-46b9-83c8-8e4a9e734661",
                                                "sense_id": "7233f5f1-ed89-31fc-b650-e779f64a51f6",
                                                "text": "[…] I can do more with a Quadrant, Sextant or Octant, of 1 foot Radius, furniſhed with Teleſcopical Sights and Screws, then ^([sic]) can poſſibly be done with any other Inſtrument, furniſhed only with Common Sights, though 10, 20, 30, nay threeſcore foot Radius; […]"
                                            },
                                            {
                                                "example_id": "d8cce6e7-c286-47c1-b7f9-7f20a9ad9166",
                                                "sense_id": "7233f5f1-ed89-31fc-b650-e779f64a51f6",
                                                "text": "I took our position every morning with my crude sextant; but the results were always most unsatisfactory."
                                            },
                                            {
                                                "example_id": "9d006bdc-42da-4a29-b29d-6bb1eafa0049",
                                                "sense_id": "7233f5f1-ed89-31fc-b650-e779f64a51f6",
                                                "text": "Moskowitz and Devereux have designed a hyperaccurate sextant for interstellar navigation based upon the design of the sextant used by the Apollo astronauts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad3fd082-d78c-3c5f-8906-a5defe87c588",
                                        "entry_id": "d9491b8b-f23a-31f8-9148-fd788cb75007",
                                        "glosses": [
                                            "One sixth of a circle or disc; a sector with an angle of 60°."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e039120e-f95a-3d73-be9d-e0f258aa61a1",
                                        "entry_id": "d9491b8b-f23a-31f8-9148-fd788cb75007",
                                        "glosses": [
                                            "One of six groups of adjacent teeth, excluding the wisdom teeth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9346d907-b6cf-3c12-9f06-0e04444b7716",
                                        "entry_id": "d9491b8b-f23a-31f8-9148-fd788cb75007",
                                        "glosses": [
                                            "A radial cell division of segments in three series, a sixth part of the original."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8bf8093-dfdc-42ae-bf4c-13fcde18d1a5",
                        "source_entry_id": "af982669-2160-3fab-bed7-de5f2b6c2093",
                        "source_sense_id": "f1928c8c-11bd-3e06-ad17-a91d6c3d8d17",
                        "source_sense_description": "hoekmeetinstrument",
                        "target_lang_word": "sextant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sextant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e50f8f3-e975-363c-9599-4628915a4fa9",
                                        "entry_id": "b96f74c4-2e0b-3c8f-832e-81ea29fd18e8",
                                        "glosses": [
                                            "Sixième partie d’un cercle, arc de soixante degrés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd9e3e6e-c881-3bd2-87a1-c7e2c925b4c0",
                                        "entry_id": "b96f74c4-2e0b-3c8f-832e-81ea29fd18e8",
                                        "glosses": [
                                            "Instrument permettant de relever la hauteur angulaire d’un astre au-dessus de l’horizon et de déterminer par calcul la latitude."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5fe9769-4501-46bb-862b-68a3faeda435",
                                                "sense_id": "bd9e3e6e-c881-3bd2-87a1-c7e2c925b4c0",
                                                "text": "Les instruments de l’astronome, peu nombreux d’ailleurs, - une lunette pour ses observations sélénographiques, un sextant destiné à donner la latitude, un chronomètre pour la fixation des longitudes, quelques cartes, quelques livres, - tout cela s’arrimait sur ce traîneau, […]."
                                            },
                                            {
                                                "example_id": "b3cce74a-cb07-482b-9d67-de396361cffc",
                                                "sense_id": "bd9e3e6e-c881-3bd2-87a1-c7e2c925b4c0",
                                                "text": "Il faisait le point à la manière des marins avec un sextant. Nous ne sommes jamais restés dans l’ignorance de notre position."
                                            },
                                            {
                                                "example_id": "0fa33087-8b89-454f-b9af-ab5bb2b8a95c",
                                                "sense_id": "bd9e3e6e-c881-3bd2-87a1-c7e2c925b4c0",
                                                "text": "Même si c’était lui qui, jour après jour, avec ses calculs au sextant, une montre précise, les livres et les cartes, confirmerait l’estime , préciserait la position, annoncerait les corrections de route et le cap, Pierre ne s’avancerait jamais à pronostiquer officiellement une date et encore moins une heure d’arrivée sur les lieux de pêche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
