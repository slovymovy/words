                        "glosses": [
                            "Personne s’intéressant aux astres, passionnée par tout ce qui touche aux astres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e9b606-f162-48f5-b100-e77eb766701d",
                                "sense_id": "219f4d32-fb8b-3426-9cf3-4fc27ca51e72",
                                "text": "Dans l’Égypte antique, les astrophiles ont fait débuter le calendrier au lever héliaque de l’étoile Sirius, qui survenait l’été au moment de la crue du Nil, indispensable au pays."
                            },
                            {
                                "example_id": "5374bee8-4979-474c-bfde-b3cdb4c247d5",
                                "sense_id": "219f4d32-fb8b-3426-9cf3-4fc27ca51e72",
                                "text": "L’astrophile aime les astres quand l’astrologue les fait parler et, même si Nostradamus a dressé de nombreux horoscopes, l’utilisation d’un mot plutôt que de l’autre est déjà très significative."
                            }
                        ]
                    }
