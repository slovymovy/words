                        "sense_id": "b06b7232-00e9-3c95-9b65-233075a011bb",
                        "entry_id": "37f6dac9-d19e-37cc-8d33-5502a515bad2",
                        "glosses": [
                            "Fahrausweis für eine einfache Fahrt von einem Startpunkt zu einem Ziel mit öffentlichen Verkehrsmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1362a775-7a91-4f30-8504-94287ce49117",
                                "sense_id": "b06b7232-00e9-3c95-9b65-233075a011bb",
                                "text": "„Alle anderen müssen entweder eine ermäßigte Einzelfahrkarte oder eine Fahrradkarte für 5 Euro kaufen, die maximal einen Monat und nur in Verbindung mit einer Monatskarte gilt.“"
                            },
                            {
                                "example_id": "6013d909-15c7-43df-b396-fbb9b6494fbf",
                                "sense_id": "b06b7232-00e9-3c95-9b65-233075a011bb",
                                "text": "„So erhöht sich die Einzelfahrkarte von Bremen nach Bremerhaven zum Beispiel von 10,70 Euro auf elf Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
