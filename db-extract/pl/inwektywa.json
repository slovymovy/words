                "translations": [
                    {
                        "translation_id": "135c0a07-2429-4b56-b865-e8cf3801db5f",
                        "source_entry_id": "0ee3ddca-f18f-35ba-904b-0c882bb376b6",
                        "source_sense_id": "07cc8a40-91ca-3ced-9264-1c31ce7a69b0",
                        "target_lang_word": "invective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9d7e8c-c9ac-3ead-88ec-a9c5b64e195a",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "An expression which inveighs or rails against a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fe653a1-6d46-31ad-bdce-57e2dccf2b1b",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "A severe or violent censure or reproach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "Something spoken or written, intended to cast shame, disgrace, censure, or reproach on another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9106561b-f835-47e6-baa2-d2374ccaae62",
                                                "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                                "text": "And wordy attacks against slavery drew sneers from observers which were not altogether undeserved. The authors were compared to doctors who offered to a patient nothing more than invectives against the disease which consumed him."
                                            },
                                            {
                                                "example_id": "4f3ea123-d376-4fb2-80c2-5debb80b0879",
                                                "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                                "text": "[A] savage passage of 14th-century invective about the text-obsessed nerdiness of the Florentine bibliophile and friend of Petrarch, Niccolò Niccoli ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f72c0a-9573-3c6a-b5ff-211e8417a020",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "A harsh or reproachful accusation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363045a6-8b0a-48b2-af68-5e4ec6563684",
                                                "sense_id": "f3f72c0a-9573-3c6a-b5ff-211e8417a020",
                                                "text": "Politics can raise invective to a low art."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "invective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06229ae7-4a93-3d3f-afa9-572874bc2c91",
                                        "entry_id": "55cff290-45c9-32e9-b306-6d2796d50ad3",
                                        "glosses": [
                                            "Characterized by invection or railing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71183c46-c5ac-4aad-b75c-835b235faa8f",
                                                "sense_id": "06229ae7-4a93-3d3f-afa9-572874bc2c91",
                                                "text": "Tom's speeches became diatribes — each more invective than the last."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f324ae47-5e2e-446b-a64f-25107a076a85",
                        "source_entry_id": "0ee3ddca-f18f-35ba-904b-0c882bb376b6",
                        "source_sense_id": "07cc8a40-91ca-3ced-9264-1c31ce7a69b0",
                        "target_lang_word": "Invektive",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Invektive",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                        "entry_id": "6acbc948-32c9-3e3d-94f1-3e242fd2279b",
                                        "glosses": [
                                            "unflätige Beleidigung, beleidigende Äußerung, Beschimpfung, Schmähung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f5533e-c32f-49e3-b3b5-89764f8a9b67",
                                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                                "text": "„Die Sitzung wird nach Austausch weiterer heftiger Invektiven ohne Festsetzung eines neuen Datums vertagt.“"
                                            },
                                            {
                                                "example_id": "c049ed7e-f414-49f2-aee5-a657853d622c",
                                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                                "text": "„Sein Mißmut steigert sich zu Invektiven auf die ‚saudummen Zeitungsartikel‘, auf das deutsche Volk, das ‚ernste Lektüre nicht liebt‘, auf die ‚üblen Prinzessinnenromane‘, die ihren Verfassern große Summen einbringen, ‚während ein Buch wie mein Steppenwolf im ganzen Reich keine Stelle fand, wo ein Vorabdruck möglich gewesen wäre‘.“"
                                            },
                                            {
                                                "example_id": "a55e863a-9a79-4bab-b469-c209e0db7724",
                                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                                "text": "„Doch lassen sich die Titanenkämpfe der Epoche nicht trennen von literarischem Futterneid, persönlichen Animositäten und der schieren Lust an der Invektive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99b754a3-476d-4854-b997-23845fd66f19",
                        "source_entry_id": "0ee3ddca-f18f-35ba-904b-0c882bb376b6",
                        "source_sense_id": "07cc8a40-91ca-3ced-9264-1c31ce7a69b0",
                        "target_lang_word": "брань",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брань",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                        "entry_id": "51bf191d-1cce-3a83-8de8-2654bea97e34",
                                        "glosses": [
                                            "бранные, ругательные, оскорбительные, поносные слова (также в речи); ругань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0940240-1718-4e2c-a737-63bc920f7e97",
                                                "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                                "text": "Публикация фольклорных текстов, содержащих брань."
                                            },
                                            {
                                                "example_id": "6378a212-3746-4b4a-9170-1c8ab71dc984",
                                                "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                                "text": "Вдруг толпа гусаров окружила нас с ужасною бранью."
                                            },
                                            {
                                                "example_id": "02cd28c2-c589-4f3d-ad88-70b71baa9d76",
                                                "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                                "text": "Извозчики с криком и бранью колотили лошадей."
                                            },
                                            {
                                                "example_id": "78909ef6-f9c6-47a8-8a9d-bd63d1f27ca6",
                                                "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                                "text": "Ведь трудно, согласитесь, проживая в сумасшедшем доме два года и слыша только брань сторожей и безумные речи больных, сохранить способность к ясному изложению мысли на письме."
                                            },
                                            {
                                                "example_id": "23095914-ed53-4ea0-9235-af4e0420b021",
                                                "sense_id": "93ab2c9a-cdbc-3d59-81c1-9a1aca340abc",
                                                "text": "Её удивляло, что брань слышалась непрерывно и что громче и дольше всех бранились старики, которым пора уже умирать. А дети и девушки слушали эту брань и нисколько не смущались, и видно было, что они привыкли к ней с колыбели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79edd114-3914-36b4-ae48-e78c43f853dc",
                                        "entry_id": "51bf191d-1cce-3a83-8de8-2654bea97e34",
                                        "glosses": [
                                            "осуждение, порицание, упрёки; поношение, ругань, проклятия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2eacb0-abe4-4286-bb7b-016581ca126c",
                                                "sense_id": "79edd114-3914-36b4-ae48-e78c43f853dc",
                                                "text": "«Я пла́чу… если вашей Тани // Вы не забыли до сих пор, // То знайте: колкость вашей брани, // Холодный, строгий разговор, // Когда б в моей лишь было власти, // Я предпочла б обидной страсти // И этим письмам и слезам.»"
                                            },
                                            {
                                                "example_id": "12bbc897-1f73-4428-a908-b2ef2894ddc7",
                                                "sense_id": "79edd114-3914-36b4-ae48-e78c43f853dc",
                                                "text": "Начиналась ломка, падение разных вещей, битьё посуды, опрокидыванье стульев; кончалось тем, что надо было его выгнать из комнаты, или он сам уходил с бранью и проклятиями."
                                            },
                                            {
                                                "example_id": "b59a5205-1801-45da-86f7-1b8ab2aced52",
                                                "sense_id": "79edd114-3914-36b4-ae48-e78c43f853dc",
                                                "text": "Можно и в напрасной похвале и в напрасной брани найти пользу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5b42d5-945f-39d3-8cb8-1a28366a85c9",
                                        "entry_id": "51bf191d-1cce-3a83-8de8-2654bea97e34",
                                        "glosses": [
                                            "устар. драка, колотня, свалка, рукопашная, побоище [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c43825f1-2e2e-3d7e-8c7a-9f426d01dac3",
                                        "entry_id": "51bf191d-1cce-3a83-8de8-2654bea97e34",
                                        "glosses": [
                                            "устар., церк., книжн., трад.-поэт., высок. бой, битва, сеча, сражение; война"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f66d17-de07-4bc1-9844-c4a62adc4618",
                                                "sense_id": "c43825f1-2e2e-3d7e-8c7a-9f426d01dac3",
                                                "text": "Коль великия нестроения, брани и человекоубийства в народах единой крови и единаго языка от разделения веры происходят, толь напротив того, крепко взаимным любви союзом сопрягает их единство веры, которая хотя много учением, однако больше примерами укрепляется."
                                            },
                                            {
                                                "example_id": "3d75570c-ddf9-4cd4-bf49-2902b5a17b2a",
                                                "sense_id": "c43825f1-2e2e-3d7e-8c7a-9f426d01dac3",
                                                "text": "Сражение было весьма кровопролитное, и сила Ардалионова начала ослабевать; тотчас растворили ворота, и в проломанные стены вышло великое множество русов. Тут ещё началась брань кровопролитнее первой."
                                            }
                                        ]
                                    }
                                ]
                            },
