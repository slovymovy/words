                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2ab4477-39b7-460d-a9dc-a981fc4a9c4c",
                        "source_entry_id": "4ce8960d-f9c2-3326-a7c9-3204ceb8cea9",
                        "source_sense_id": "d7a1b8cf-4d90-3486-9d66-d159dc51cf3f",
                        "target_lang_word": "trickster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "Any of numerous figures featuring in various mythologies and folk traditions, who use guile and secret knowledge to challenge authority and play tricks and pranks on others with their acts of trickery; any similar figure in literature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0db848-dd87-488f-83eb-bcda2cffc841",
                                                "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                                "text": "1991, Alan R. Velie (compiler and editor), American Indian Literature: An Anthology, Revised edition, page 44,\nThe trickster is one of the oldest and most widespread of mythological and literary figures. […] As the name implies, the trickster is, on one level—probably the most important—an amoral practical joker who wanders about playing pranks on unsuspecting victims […] With all the fluctuations, certain things about the trickster are predictable: he is always a wanderer, always hungry, and usually oversexed.\nTricksters abound in folktales […] ."
                                            },
                                            {
                                                "example_id": "d5402db5-2d3d-4fae-a29c-69e48dceee01",
                                                "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                                "text": "And let us begin with those sympathetic elements, the tricksters who obtain the lovers and the land, always at the expense of fools and knaves, sometimes at the expense of other tricksters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abda59b9-ea60-3f56-b579-db7568023a14",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "One who plays tricks or pranks on others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2391bf3b-5e94-48b4-9f20-3723ec36d263",
                                                "sense_id": "abda59b9-ea60-3f56-b579-db7568023a14",
                                                "text": "A skilled trickster knows how to outsmart their enemies with ease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbcf88d-8edd-3db0-9ac1-a2a95d21f253",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "One who performs tricks (parts of a magician act or entertainingly difficult physical actions)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9736423d-a44a-48ea-850e-a8475bd195a6",
                                                "sense_id": "cdbcf88d-8edd-3db0-9ac1-a2a95d21f253",
                                                "text": "Our fellow trickster will perform some impressive magic tricks tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c1f4dac-7fcb-3539-87ea-2e702caca85e",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "An impish or playful person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5c5b02b-d505-3a89-b829-689b8e451dc6",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "A fraud or cheat (person who performs a trick or hoax full of falsehoods for the purpose of unlawful gain)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3168273-a0cd-47cb-943e-e0efc45a05b3",
                                                "sense_id": "a5c5b02b-d505-3a89-b829-689b8e451dc6",
                                                "text": "That shady trickster faked being a psychic advisor to spread misinformation and gain profit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trickster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7402ce47-5451-3c82-8fc7-b14d88504327",
                                        "entry_id": "2c85fba3-cb16-35d0-b8df-0b0e3d381034",
                                        "glosses": [
                                            "To engage in the antics of a trickster; to play tricks."
                                        ],
