                            {
                                "example_id": "d7efb734-cd63-4795-93a4-572f4ef89504",
                                "sense_id": "66f065b5-c6d1-385b-af3a-0cac1c867127",
                                "text": "Le romantisme et le pragmatisme vont-ils s’autocontaminer et fusionner ?"
                            },
                            {
                                "example_id": "38e587a6-0327-4d75-be13-88df54902f17",
                                "sense_id": "66f065b5-c6d1-385b-af3a-0cac1c867127",
                                "text": "Lorsqu’il est dit que les deux peines n’en font qu’une puisque leur exécution simultanée signifie qu’elles s’«autocontaminent» en toutes leurs exclusions, la règle de l’autonomie des peines confondues est heurtée."
                            },
                            {
                                "example_id": "f223205b-0438-4efe-b579-aee35d215b9d",
                                "sense_id": "66f065b5-c6d1-385b-af3a-0cac1c867127",
                                "text": "Il est impossible, en outre, de s’autocontaminer."
                            }
                        ]
