                "senses": [
                    {
                        "sense_id": "23a84960-46d9-38df-8c04-e2d41fa6fb18",
                        "entry_id": "6afc004d-7faa-3887-b5a9-024ffdb345ed",
                        "glosses": [
                            "стать совсем сухим, чрезмерно высохнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f457d5d-5975-4d70-96a3-cdeb309a7db1",
                                "sense_id": "23a84960-46d9-38df-8c04-e2d41fa6fb18",
                                "text": "Почва пересохла от бездождия."
                            },
                            {
                                "example_id": "41f6bc15-fa26-4317-a162-3e3c6d8b5bf1",
                                "sense_id": "23a84960-46d9-38df-8c04-e2d41fa6fb18",
                                "text": "Губы пересохли от волнения."
                            },
                            {
                                "example_id": "71275747-d32d-459f-b26e-724d7c5bca35",
                                "sense_id": "23a84960-46d9-38df-8c04-e2d41fa6fb18",
                                "text": "От неустанной, напряжённой зубрячки у него пересохло во рту."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a157148-225c-35cb-8cc6-7181accaacbb",
                        "entry_id": "6afc004d-7faa-3887-b5a9-024ffdb345ed",
                        "glosses": [
                            "высохнуть, стать безводным"
                        ],
                        "tags": [
                            "об источнике:"
                        ],
                        "examples": [
                            {
                                "example_id": "ad386ca5-dc9f-4021-ae2a-1796a571d72d",
                                "sense_id": "3a157148-225c-35cb-8cc6-7181accaacbb",
                                "text": "Ручей пересох."
                            },
                            {
                                "example_id": "167a7be3-58c4-49ac-b1f9-e07871273eeb",
                                "sense_id": "3a157148-225c-35cb-8cc6-7181accaacbb",
                                "text": "Колодец пересох."
                            }
                        ]
                    },
                    {
                        "sense_id": "4449252b-9dcb-3818-a2f8-838e18784748",
                        "entry_id": "6afc004d-7faa-3887-b5a9-024ffdb345ed",
                        "glosses": [
                            "разг. высохнуть"
                        ],
                        "tags": [
