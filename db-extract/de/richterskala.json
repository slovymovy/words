                                        "entry_id": "18f0c140-3619-3508-b8ae-171058ce2ef9",
                                        "glosses": [
                                            "A value on the Richter scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e42b35-ace3-4136-8a86-3458408318b6",
                                                "sense_id": "632d36a0-3b1f-367b-9fa6-29e7d4cb0873",
                                                "text": "The students also faced and experienced earthquakes at various Richter scales."
                                            }
