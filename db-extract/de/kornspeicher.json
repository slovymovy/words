                "senses": [
                    {
                        "sense_id": "26ea0833-a530-3bcd-8f89-7f01bfb416fc",
                        "entry_id": "fecda18c-ffb3-3ee1-a2d9-a07283d75801",
                        "glosses": [
                            "Gebäude zur Aufbewahrung von Getreide oder Saatgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7398639e-187b-4376-8e21-30f19a8c43a4",
                                "sense_id": "26ea0833-a530-3bcd-8f89-7f01bfb416fc",
                                "text": "„Auf halbem Weg zwischen Kirche und Schloss steht ein Fachwerkgebäude mit vielen hölzernen Lüftungsklappen: der Kornspeicher.“"
                            },
                            {
                                "example_id": "65861778-08aa-4d35-89a4-f5976aec8e7c",
                                "sense_id": "26ea0833-a530-3bcd-8f89-7f01bfb416fc",
                                "text": "„Dann wieder organisierten sie Raubzüge auf eigene Faust, wenn die Geldtruhen, Kornspeicher und Weinfässer leer waren und die eigenen Kriegsknechte bedrohlich mürrisch wurden wegen des ausbleibenden Solds.“"
                            },
                            {
                                "example_id": "d82c1de3-4d21-4a26-8fc2-1daa3a2c6e6c",
                                "sense_id": "26ea0833-a530-3bcd-8f89-7f01bfb416fc",
                                "text": "„Da hatten sie die Mauern des Kornspeichers vor Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ed48876-6ccc-4ec4-97f1-9f3d81a06220",
