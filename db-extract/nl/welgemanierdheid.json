            {
                "entry_id": "2a96530c-7e89-3073-85d0-dd0e8ad0d6b7",
                "word": "welgemanierdheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "055d8cd6-1b55-3d9e-9564-92b196010e78",
                        "entry_id": "2a96530c-7e89-3073-85d0-dd0e8ad0d6b7",
                        "glosses": [
                            "het netjes en keurig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa5e3d2-8f3a-40d4-a57e-78e05898cf26",
                                "sense_id": "055d8cd6-1b55-3d9e-9564-92b196010e78",
                                "text": "De wederzijdse vriend nam contact op met Jessica, die een date wel zag zitten. \"Ja, ik heb haar op de ouderwetse manier mee uit gevraagd, via de telefoon. Van mijn vader en stiefvader heb ik geleerd dat er zoiets bestaat als welgemanierdheid. Daar doet de komst van internet niks aan af.\""
                            },
                            {
                                "example_id": "6ccd904b-05b2-4d7b-81d0-219e6d796d33",
                                "sense_id": "055d8cd6-1b55-3d9e-9564-92b196010e78",
                                "text": "Op de vraag hoe zij het vond dat ze het wereldrecord had verbroken, antwoordde ze afgemeten dat ze ‘very pleased’ was. Een prachtige symbiose van welgemanierdheid en jeugdige onverschrokkenheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c779ef2-da18-3500-9b49-860db02ddb74",
                        "entry_id": "2a96530c-7e89-3073-85d0-dd0e8ad0d6b7",
                        "glosses": [
                            "een nette keurige handeling"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9241aa91-6acc-4da2-af63-728a1fb6e00a",
                        "source_entry_id": "2a96530c-7e89-3073-85d0-dd0e8ad0d6b7",
                        "source_sense_id": "055d8cd6-1b55-3d9e-9564-92b196010e78",
                        "source_sense_description": "het netjes en keurig zijn",
                        "target_lang_word": "etiquette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etiquette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The manners or decent behaviour to be observed in social or professional life; conventional decorum; the ceremonial code of polite society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c2b673-52ed-4d41-b804-fe8bcfc083c6",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "20 May 2018, Hadley Freeman in The Guardian, Is Meghan Markle the American the royals have needed all along?\nMuch shock was expressed in the British press about the Palace’s utter failure to control the Markles and the Markles’ lack of etiquette."
                                            },
                                            {
                                                "example_id": "ada3d8e4-ae5d-4dff-be11-dbbd1123d7d2",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "Whenever Root would put his elbows on the table or clatter his dishes or commit any other breach of etiquette, the Professor would gently correct him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The customary behavior of members of a profession, business, law, or sports team towards each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7455b6f-2423-4c77-92df-de670558da0e",
                                                "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                                "text": "Cycling's complex etiquette contains an unwritten rule that riders in contention for a race win should not be penalised for sheer misfortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0c4aaa-91d6-3d15-86f5-41b82b439c28",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "A label used to indicate that a letter is to be sent by airmail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc3dbb7-d47a-458b-a24b-a3d8bd76fb27",
                        "source_entry_id": "2a96530c-7e89-3073-85d0-dd0e8ad0d6b7",
                        "source_sense_id": "055d8cd6-1b55-3d9e-9564-92b196010e78",
                        "source_sense_description": "het netjes en keurig zijn",
                        "target_lang_word": "courtesy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtesy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Polite behavior."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543ef2e2-5e64-4e90-8bc5-722c57de5b8b",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Please extend them the courtesy of your presence."
                                            },
                                            {
                                                "example_id": "2b87370e-b0e3-4f90-9960-4b8ce2a86693",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "He was always known for his grace, kindness, and courtesy to people of every rank."
                                            },
                                            {
                                                "example_id": "df7fd945-0b3c-40b5-904e-4da1f595b554",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Rabbit doesn't want to tell him anything. The more he tells, the more he loses. He's safe inside his own skin, he doesn't want to come out. This guy's whole game is to get him out into the open where he can be manipulated. But the fierce convention of courtesy pries open Rabbit's lips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A polite gesture or remark, especially as opposed to an obligation or standard practice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976bf96b-437e-4d8e-968d-3d13f879d6fd",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "I offered them a ride simply as a courtesy."
                                            },
                                            {
                                                "example_id": "37cb6746-3949-476d-8fb8-6e89e77c8608",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "My lord, for your many courtesies I thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Consent or agreement in spite of fact; indulgence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5c3842-1945-4383-b9fb-fec7517bd632",
                                                "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                                "text": "They call this pond a lake by courtesy only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Willingness or generosity in providing something needed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf86eb31-e180-42b4-be7f-ddcbc6566a95",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "They received free advertising through the courtesy of the local newspaper."
                                            },
                                            {
                                                "example_id": "4905db6d-1465-4cbb-9dd2-98c41061cc05",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "[on a label, caption, etc.] Courtesy the Smith Foundation: [e.g.] use of this image was allowed through the courtesy of the Smith Foundation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A curtsey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e478e550-cd1d-405b-a58d-767aeada387f",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "The lady drops a courtesy in token of obedience, and the ceremony proceeds as usual."
                                            },
                                            {
                                                "example_id": "c052f638-94b4-4007-9952-0908991bd959",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "[I]t was her favorite amusement to array herself in the faded brocades, and parade up and down before the long mirror, making stately courtesies, and sweeping her train about, with a rustle which delighted her ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb48f82-c1e4-3127-9665-f90d217a76b6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "The life interest that the surviving husband has in the real or heritable estate of his wife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
