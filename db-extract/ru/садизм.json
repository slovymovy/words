                    {
                        "translation_id": "e19e818b-438d-4b19-b524-61d49dfacf3e",
                        "source_entry_id": "42c46e5d-7cb5-39cb-9df9-b48e39e0645c",
                        "source_sense_description": "половая перверсия",
