                            {
                                "example_id": "f931b2e9-5749-443b-aac8-4b647bf703f1",
                                "sense_id": "de4de7fa-6777-3688-ad4b-f9fea9f62b76",
                                "text": "De bedoeling van dit boek is hierbij behulpzaam te zijn. In de vele lees- en voorleesverhalen en de korte documentaties wordt iets van de oorsprong en de viering van onze jaarfeesten belicht."
                            },
                            {
                                "example_id": "31b5b030-ed68-4e32-bedd-a0cdbf3a04dd",
                                "sense_id": "de4de7fa-6777-3688-ad4b-f9fea9f62b76",
                                "text": "Koning Willem-Alexander en koningin Máxima waren afgelopen weekend in Terneuzen. De koning gaf het startschot voor de viering van 75 jaar vrijheid. Want dit jaar is het 75 jaar geleden dat Nederland bevrijd werd."
                            }
                        ]
                    },
