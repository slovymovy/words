                                        "entry_id": "e4a2ccfc-4456-3144-8ffb-c4b9c4a9991a",
                                        "glosses": [
                                            "Variante de goulash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e5f6dc-c095-4514-b0f5-7aa237799b4e",
                                                "sense_id": "0ce933c1-6f3a-31d0-a74f-e54752770a53",
                                                "text": "Le goulache de queue de boeuf est un plat national hongrois qui consiste en une viande en sauce contenant beaucoup d’oignons et de poivre rouge appelé paprika."
                                            },
                                            {
                                                "example_id": "be635267-c057-49fe-94ea-43b4750ea757",
                                                "sense_id": "0ce933c1-6f3a-31d0-a74f-e54752770a53",
                                                "text": "Il avale le goulache sans sourciller."
                                            }
                                        ]
