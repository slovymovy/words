                                "target_senses": [
                                    {
                                        "sense_id": "4bb0bd03-f52b-30db-ac2c-f53166a14201",
                                        "entry_id": "23397645-22e1-3b3e-b451-5a393981f230",
                                        "glosses": [
                                            "A male given name from the Germanic languages, a Latinized form of Hugh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5853f257-df10-4308-9cac-2cabba663c19",
                                                "sense_id": "4bb0bd03-f52b-30db-ac2c-f53166a14201",
                                                "text": "He had liked a girl named Sandra in seventh grade. \"Where did you get the name Hugo?\" she had asked him once. \"It sounds like a made-up name. What's your real name, Hugo? Or are you a Russian spy?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7936a5b-09b2-3aa8-a41c-1067dbd3e0d2",
                                        "entry_id": "23397645-22e1-3b3e-b451-5a393981f230",
                                        "glosses": [
                                            "A surname from French."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e9d8cd3-cfb6-3325-966d-dc78d94e724b",
                                        "entry_id": "23397645-22e1-3b3e-b451-5a393981f230",
                                        "glosses": [
                                            "A statutory town, the county seat of Lincoln County, Colorado, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03f1acb1-a270-3874-9cb6-59d528b0cd44",
                                        "entry_id": "23397645-22e1-3b3e-b451-5a393981f230",
                                        "glosses": [
                                            "A city, the county seat of Choctaw County, Oklahoma, United States. It was named after Victor Hugo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Hugo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3339e88e-65e4-367f-8aab-690049db6e28",
                                        "entry_id": "ce196be4-f659-352c-843a-acbf2beaf490",
                                        "glosses": [
                                            "A Hugo Award, a statuette given out by the World Science Fiction Society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72d03c2-a579-43ef-9c90-10fb0a727de2",
                                                "sense_id": "3339e88e-65e4-367f-8aab-690049db6e28",
                                                "text": "Red Mars (1992) won a Nebula and Green Mars (1993) won a Hugo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fc5d086-38ba-4cf9-9a82-37be51bfc4fe",
                        "source_entry_id": "a3e26f4d-8d2a-3a66-8ea2-3e8ec86dbf80",
                        "source_sense_id": "6c5a7063-8f39-37eb-91be-6b423950ce55",
                        "target_lang_word": "Hugues",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hugues",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a58e9e40-9a95-3c37-9f89-4b0442f8374e",
                                        "entry_id": "4f2f90c9-053a-33e8-83ee-fe4757204dee",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b77614-ac1b-453c-b826-e94810cc3088",
                                                "sense_id": "a58e9e40-9a95-3c37-9f89-4b0442f8374e",
                                                "text": "« 70 % des villes de plus de 5 000 habitants sont nos clients », se réjouit Johan Hugues, le co-PDG."
                                            },
                                            {
                                                "example_id": "6723777d-7b7e-455b-bf4d-dac90d647f49",
                                                "sense_id": "a58e9e40-9a95-3c37-9f89-4b0442f8374e",
                                                "text": "Déguisés en ELvis Presley, John Sheppard, Phoenix Dean et Jake Hugues (de g. à dr.) ont participé, dimanche, aux championnats d’hommages artistiques de Blackpool, au Royaume-Uni."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hugues",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5760d50e-366f-325a-a7f6-b78c81b59ef4",
                                        "entry_id": "7ac1b97d-0f71-3e08-ba05-c7c4d268b201",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d08223c-ab66-4fe7-aa83-1a900b4e009f",
                                                "sense_id": "5760d50e-366f-325a-a7f6-b78c81b59ef4",
                                                "text": "Le soudain tutoiement, la violence des mots, enlaidissent Hugues aussitôt. Ce n'est plus qu'un petit voyou, plein de haine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "791aaf2f-ed40-4485-9364-5e1e32a85b33",
                        "source_entry_id": "a3e26f4d-8d2a-3a66-8ea2-3e8ec86dbf80",
                        "source_sense_id": "6c5a7063-8f39-37eb-91be-6b423950ce55",
                        "target_lang_word": "Hugo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hugo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44a44292-6de3-326e-add2-2e7fb7e14d9c",
                                        "entry_id": "ab355f7f-ddb8-3e57-ada2-71d208b7d4bd",
                                        "glosses": [
                                            "Getränk aus Prosecco, Sirup von Holunderblüten oder Zitronenmelisse und Soda-/Mineralwasser, garniert mit Minzblättchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4295d43e-cdb9-4e99-8372-a4e8159f5065",
                                                "sense_id": "44a44292-6de3-326e-add2-2e7fb7e14d9c",
                                                "text": "„Als ich Anfang voriger Woche auf Mallorca, wo man sich mit derlei ja wohl auskennen müsste, stoisch »so was wie Spritz, aber mal was Neues« bestellt habe, empfahl der Kellner einen Hugo. Wie süß. Wann hatte dieses Getränk noch mal versucht, den Spritz abzulösen? 2010?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hugo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5c8f31d-31a9-3148-b63c-6a4d03cdf857",
                                        "entry_id": "24a302d6-1f21-3b77-87ce-832780d0faa0",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3102bbb4-bdce-44d7-b947-28c654402cdf",
                                                "sense_id": "c5c8f31d-31a9-3148-b63c-6a4d03cdf857",
                                                "text": "Der dicke Hugo muss zur Schlankheitskur."
                                            },
                                            {
                                                "example_id": "8d36cf58-57f4-476b-94b3-0b4e054dce73",
                                                "sense_id": "c5c8f31d-31a9-3148-b63c-6a4d03cdf857",
                                                "text": "Onkel Hugos Dackel Waldi ist ausgebüxt."
                                            },
                                            {
                                                "example_id": "86d8f2ba-4d3e-4a9e-9c53-89a4f7ba64e8",
                                                "sense_id": "c5c8f31d-31a9-3148-b63c-6a4d03cdf857",
                                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hugo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2db29999-920c-337a-93c8-16bc00c7eba5",
                                        "entry_id": "2e24a740-15fd-3519-8f42-e4a68e47edde",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe563cf1-7334-4775-bf95-4f7e45611a28",
                                                "sense_id": "2db29999-920c-337a-93c8-16bc00c7eba5",
                                                "text": "Der Hugo aus dem Nachbarhaus hat schon wieder auf dem Balkon gegrillt."
                                            },
                                            {
                                                "example_id": "e8ab4c3b-cf8b-44d6-90ee-51e1f074e845",
                                                "sense_id": "2db29999-920c-337a-93c8-16bc00c7eba5",
                                                "text": "Die neuen Mieter, diese Hugos, sind nicht sehr hilfsbereit."
                                            },
                                            {
                                                "example_id": "80818b48-0c6f-4ba0-a28e-4a28d9b4b47f",
                                                "sense_id": "2db29999-920c-337a-93c8-16bc00c7eba5",
                                                "text": "Die kleine Hugo ist vielleicht ein Frechdachs!"
                                            },
                                            {
                                                "example_id": "2c7c01dd-cead-419d-8e13-f8b1165b5c0b",
                                                "sense_id": "2db29999-920c-337a-93c8-16bc00c7eba5",
                                                "text": "He, Hugo, komm mal her!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
