                    {
                        "sense_id": "092a417f-fcd7-323b-8dc9-9622d5be50ea",
                        "entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "glosses": [
                            "A brief two-piece bathing suit worn by women, especially one that exposes the midriff and navel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d09ea47a-a4ad-48c7-a030-891b6d63297f",
                                "sense_id": "092a417f-fcd7-323b-8dc9-9622d5be50ea",
                                "text": "Cole has little but scorn for France's famed Bikini bathing suits. Explains he: \" French girls, have short legs. Swimsuits have to be hiked up at the sides to make their legs look longer. \""
                            },
                            {
                                "example_id": "8d6730f1-49c7-41ac-96f8-f6efe1d8e52b",
                                "sense_id": "092a417f-fcd7-323b-8dc9-9622d5be50ea",
                                "text": "The café where they were gathered, Bikini Beans, was part of a chain whose baristas wear bikinis."
                            }
                        ]
                    },
                    {
                        "sense_id": "b42096a3-fa15-3ecc-bc6a-9cc9341800bb",
                        "entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "glosses": [
                            "A brief bathing suit worn by men."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e52b594-0b9f-451c-95c8-1366c062e36e",
                                "sense_id": "b42096a3-fa15-3ecc-bc6a-9cc9341800bb",
                                "text": "We high-schoolers didn't understand why death came in the form of a gorgeous young man with muscles in a skimpy bikini."
                            }
                        ]
                    },
                    {
                        "sense_id": "1939dd31-be0f-386c-8c1d-81652b74ac1b",
                        "entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "glosses": [
                            "Brief underpants or trousers that reach to the hips rather than the waist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da52963-2fe1-4033-b4c7-a87d3afb5ef6",
                                "sense_id": "1939dd31-be0f-386c-8c1d-81652b74ac1b",
                                "text": "Boxer shorts, knitted briefs, and bikinis are the most popular styles in shorts, formerly called “drawers.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec17f9cd-0085-49c6-ac27-cff4a463111e",
