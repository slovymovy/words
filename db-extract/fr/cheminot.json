                ],
                "senses": [
                    {
                        "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                        "entry_id": "34a2ebb0-3623-3df3-8773-23c8f4fe33c4",
                        "glosses": [
                            "Employé des chemins de fer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c9899bd2-c44f-4564-a8e9-e169b8121f8b",
                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                "text": "Lorsque Pizarro, le mécanicien de l’Aquila Azteca, immobilise sa locomotive à la verticale du signal rouge, il est stupéfait de voir surgir sur le marchepied gauche un cheminot en salopette, le visage barbouillé de cambouis."
                            },
                            {
                                "example_id": "9c56363c-e582-4d8a-82f2-c2a4e4d01c5b",
                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                "text": "Il oppose les « anciens », les T5 (conducteurs de grandes lignes ou « tégévistes ») et autres « sénateurs du rail », syndiqués dans leur grande majorité à la CGT ou à la FGAAC (Fédération générale autonome des agents de conduite), aux T4 (conducteurs de banlieue), plus jeunes et dotés d'une culture distincte de celle de la corporation traditionnelle des cheminots."
                            },
                            {
                                "example_id": "fbfbbdcd-ad92-4620-9207-45aae1a1dc94",
                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                "text": "Dans les cortèges qui défilent aux quatre coins du pays se mêlent employés de banque, contrôleurs aériens, cheminots, enseignants et travailleurs de la santé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21ac4477-3ab9-4d3a-9438-a1b85772f12c",
                        "source_entry_id": "34a2ebb0-3623-3df3-8773-23c8f4fe33c4",
                        "source_sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                        "target_lang_word": "Eisenbahner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisenbahner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                        "entry_id": "43c23b8d-986d-3efa-a603-4007bdb73ea4",
                                        "glosses": [
                                            "Mitarbeiter eines Eisenbahnunternehmens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603a2505-8ca0-48cd-a33f-485d1e89aa2c",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "Unter den Eisenbahnern gibt es ein starkes Zusammengehörigkeitsgefühl."
                                            },
                                            {
                                                "example_id": "11a9f31f-3849-4876-9ffc-8df9760f6ab4",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Ihr Vater war als Eisenbahner am Bahnhof von Tollmingkehmen beschäftigt.“"
                                            },
                                            {
                                                "example_id": "5ebce84c-ab29-4448-8e82-1705131bc568",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Ein Eisenbahner mit einer kleinen Lampe schüttelte mich und fragte nach meinem Reiseziel.“"
                                            },
                                            {
                                                "example_id": "3d61c424-a43d-4d95-a383-c4e7d6e1dbba",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Er nahm den Eisenbahner nicht für einen Offizier, trotz der Achselstücke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f216903-e915-4b82-984c-9e0077237c2e",
