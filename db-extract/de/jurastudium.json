                ],
                "senses": [
                    {
                        "sense_id": "bb5bcccb-3bfe-3a68-9382-fd864974dfb6",
                        "entry_id": "bcc9f88e-cd52-313f-8fa1-d5514e3086c3",
                        "glosses": [
                            "Studium der Rechtswissenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1c1027-d613-4f7e-90dc-5b686a735ebe",
                                "sense_id": "bb5bcccb-3bfe-3a68-9382-fd864974dfb6",
                                "text": "„Das Jurastudium war die Erfüllung ihres Vaters gewesen. Andrew hatte ebenfalls Ambitionen in dieser Richtung gehabt, sie selbst hatte jedoch nie in Erwägung gezogen, Juristin zu werden.“"
                            },
                            {
                                "example_id": "01cd8050-54fa-4fec-9bf6-cd46f9b28365",
                                "sense_id": "bb5bcccb-3bfe-3a68-9382-fd864974dfb6",
                                "text": "„Das Rüstzeug für seine verfassungsrechtlichen Konzepte holte er sich beim Jurastudium in Wien.“"
                            },
                            {
                                "example_id": "bb6bff92-9fff-4775-a7e1-7e85af97a91c",
                                "sense_id": "bb5bcccb-3bfe-3a68-9382-fd864974dfb6",
                                "text": "„Nach dem Jurastudium in London war Gandhi als junger Anwalt von einem reichen muslimischen Händler nach Südafrika gesandt worden, um dort dessen Geschäftsfreund in einem Rechtsstreit zu vertreten.“"
                            },
                            {
                                "example_id": "32c04c4f-7956-4d05-a319-3e77a301fc7f",
                                "sense_id": "bb5bcccb-3bfe-3a68-9382-fd864974dfb6",
                                "text": "„Außerdem hatte sie während des Jurastudiums bei einem Studentenjob weitaus mehr Stunden aufgeschrieben und in Rechnung gestellt, als sie tatsächlich gearbeitet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
