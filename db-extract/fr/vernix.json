                "senses": [
                    {
                        "sense_id": "aba887c9-d117-3e5b-a0a4-5608bb35f1dc",
                        "entry_id": "2455fc43-50d2-3011-9346-455c09dfff05",
                        "glosses": [
                            "Substance produite par les peaux des fœtus humains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772a6a35-b78f-470a-b8df-9da83e3d973f",
                                "sense_id": "aba887c9-d117-3e5b-a0a4-5608bb35f1dc",
                                "text": "On voit s’afficher sur les réseaux les ventres gonflés ou ramollis, les culottes filets portées après la délivrance, les cicatrices de césarienne, les bébés encore gluants de vernix pousser leur premier cri ou vissés au sein de leur mère, les larmes du baby blues."
                            },
                            {
                                "example_id": "2da1a4ac-6b45-4f47-ad9d-abae95b6a0b7",
                                "sense_id": "aba887c9-d117-3e5b-a0a4-5608bb35f1dc",
                                "text": "Votre bébé est le plus beau du monde. Lisse, rond, rose... Non ? Allons, il le sera dans quelques jours. Pour l'instant, il a peut-être... ...la peau couverte d'un enduit blanc et visqueux. C'est le vernix."
                            }
                        ]
                    }
