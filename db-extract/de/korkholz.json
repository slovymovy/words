                        "translation_id": "1cc69f23-4522-487c-8f2b-bc29a6faa107",
                        "source_entry_id": "a74daf0a-f8ce-39a2-9dd1-265d5d03344f",
                        "source_sense_id": "9bd68e3d-8b6a-3de4-9e99-2afeb955f74d",
                        "target_lang_word": "liège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42668881-93f1-3ec6-b0a2-85430dcf6924",
                                        "entry_id": "943f0977-7977-3c23-a369-8bcf6dc90326",
                                        "glosses": [
                                            "Écorce épaisse et légère du chêne-liège qu’on utilise dans la fabrication de bouchons ou comme matériau isolant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "773f841d-0a5f-4c5a-ac2e-74f075ef9821",
                                                "sense_id": "42668881-93f1-3ec6-b0a2-85430dcf6924",
                                                "text": "Des semelles de liège."
                                            },
                                            {
                                                "example_id": "b33a8ac9-0455-4a36-a09c-418f475cbf47",
                                                "sense_id": "42668881-93f1-3ec6-b0a2-85430dcf6924",
                                                "text": "Le liège flotte sur l’eau, à cause de sa légèreté."
                                            },
                                            {
                                                "example_id": "4c17e3a1-2a0a-4604-a555-7d08c3f29bec",
                                                "sense_id": "42668881-93f1-3ec6-b0a2-85430dcf6924",
                                                "text": "Les filets des pêcheurs sont garnis de petits morceaux de liège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "102174f6-57e9-3c11-a0b0-a18e8b2bb60c",
                                        "entry_id": "943f0977-7977-3c23-a369-8bcf6dc90326",
                                        "glosses": [
                                            "Partie la plus superficielle de l’écorce d’un arbre composé de cellules mortes issus de l'assise subéro-phellodermique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6538fc-45e0-413b-99d0-63fb277afa85",
                                                "sense_id": "102174f6-57e9-3c11-a0b0-a18e8b2bb60c",
                                                "text": "Il y a donc, en résumé, trois modes de cicatrisation: 1° par simple dessiccation, avec ou sans modification préalable des cellules desséchées; 2° par production de liège sans bourrelet; 3° par formation d’un bourrelet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada05473-26c8-3eb8-815f-5d08ecbc47c3",
                                        "entry_id": "943f0977-7977-3c23-a369-8bcf6dc90326",
                                        "glosses": [
                                            "Chêne-liège."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4861a7ba-822b-46c4-9547-b3e1a544c65d",
                                                "sense_id": "ada05473-26c8-3eb8-815f-5d08ecbc47c3",
                                                "text": "Lorsque le jour parut, nous étions encore dans les landes ; mais les pins étaient entremêlés de lièges, arbres que je m’étais toujours représentés sous la forme de bouchons, et qui sont en effet des arbres énormes qui tiennent à la fois du chêne et du caroubier pour la bizarrerie de l’attitude, la difformité et la rugosité des branches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e9cc66-638c-33cb-aab7-f25e214b04bf",
                                        "entry_id": "943f0977-7977-3c23-a369-8bcf6dc90326",
                                        "glosses": [
                                            "Garniture en liège au niveau du tenon de l’emmanchement de deux parties du corps d’un bois et qui permet d’assurer l’étanchéité (joint)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2a2a821-a4c0-40b2-a5d1-9240eeec4d84",
                                                "sense_id": "32e9cc66-638c-33cb-aab7-f25e214b04bf",
                                                "text": "Afin de faciliter l’assemblage des différentes parties, il est important de graisser ces lièges."
                                            }
                                        ]
                                    }
                                ]
                            },
