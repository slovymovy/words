                    {
                        "sense_id": "8ec19f51-c7ee-39bb-b041-b3c01f375afc",
                        "entry_id": "05157610-150b-347c-bf3e-76788c7bc65d",
                        "glosses": [
                            "bayou (a slow-moving, sometimes stagnant body of water left behind by the meandering of the Mississippi River in Louisiana or elsewhere)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f9879b-92a9-43f5-9649-9d2e4ff1145c",
                                "sense_id": "8ec19f51-c7ee-39bb-b041-b3c01f375afc",
                                "text": "Si tu vas dans la rivière il faut que tu restes dedans le chenal. C’est le plus creux dedans un bayou ou une rivière.",
                                "translation": "If you go in the river you have to stay in the channel. It’s the deepest part of a bayou or a river.",
                                "english": "If you go in the river you have to stay in the channel. It’s the deepest part of a bayou or a river."
                            },
                            {
                                "example_id": "b722a750-29fc-4aa3-bd05-d8016aab193b",
                                "sense_id": "8ec19f51-c7ee-39bb-b041-b3c01f375afc",
                                "text": "L’eau du bayou est huileuse depuis qu’ils ont fouillé le puits d’huile.",
                                "translation": "The bayou water is oily since they dug the oil well.",
                                "english": "The bayou water is oily since they dug the oil well."
                            },
                            {
                                "example_id": "caaaf0c7-27d8-4fd2-8ae8-ab7219b996ac",
                                "sense_id": "8ec19f51-c7ee-39bb-b041-b3c01f375afc",
                                "text": "Son mari a tombé du bateau dedans le bayou et il a jamais ressoud.",
                                "translation": "Her husband fell off the boat into the bayou and he never resurfaced.",
                                "english": "Her husband fell off the boat into the bayou and he never resurfaced."
                            },
                            {
                                "example_id": "a9f8fd34-9536-4236-8865-e5214104369c",
                                "sense_id": "8ec19f51-c7ee-39bb-b041-b3c01f375afc",
                                "text": "Ça va te tuer raide. Ici en bas du bayou il y a pas de serpent qu’est pas poisonous.",
                                "translation": "That will knock you dead. Down the bayou here there aren’t any snakes that aren’t poisonous.",
                                "english": "That will knock you dead. Down the bayou here there aren’t any snakes that aren’t poisonous."
                            }
                        ]
                    },
