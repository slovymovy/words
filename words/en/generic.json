{
    "word_family": [
        "generically",
        "generality",
        "generalize",
        "generalization",
        "genus",
        "genre"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce6f8aee-bb9f-39b9-b170-2f9fece0a979",
                    "sense_definition": "Describing a product, especially a drug, that does not have a brand name.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a <w>generic</w> drug because it was much cheaper.",
                            "target_lang_translations": {
                                "ru": "Врач выписал <w>непатентованное</w> лекарство, потому что оно было намного дешевле.",
                                "zh": "医生开了一种<w>非专利</w>药，因为它便宜得多。"
                            }
                        },
                        {
                            "text": "Many supermarkets sell <w>generic</w> brands alongside the famous ones.",
                            "target_lang_translations": {
                                "ru": "Многие супермаркеты продают <w>немарочные</w> бренды наряду с известными.",
                                "zh": "许多超市在销售名牌商品的同时，也卖<w>无品牌</w>商品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unbranded"
                    ],
                    "antonyms": [
                        "branded",
                        "proprietary"
                    ],
                    "common_phrases": [
                        "generic drug",
                        "generic brand",
                        "generic version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает продукт, особенно лекарство, не имеющий торговой марки.",
                        "zh": "指没有品牌名称的产品，尤指药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непатентованный",
                                "target_lang_sense_clarification": "о лекарствах"
                            },
                            {
                                "target_lang_word": "немарочный",
                                "target_lang_sense_clarification": "о товарах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非专利的",
                                "target_lang_sense_clarification": "指药物"
                            },
                            {
                                "target_lang_word": "无品牌的",
                                "target_lang_sense_clarification": "指一般商品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34b428cc-ecab-3a6a-9601-ae9bf44f4398",
                    "sense_definition": "Relating to or shared by a whole group or class of things; not specific to one instance.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "general_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word 'device' is a <w>generic</w> term for any piece of equipment.",
                            "target_lang_translations": {
                                "ru": "Слово «устройство» — это <w>общий</w> термин для любого вида оборудования.",
                                "zh": "“装置”一词是对任何设备的一种<w>通用</w>称呼。"
                            }
                        },
                        {
                            "text": "He gave a <w>generic</w> description that could apply to almost anyone.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>обобщённое</w> описание, которое могло подойти почти кому угодно.",
                                "zh": "他给出的描述非常<w>笼统</w>，几乎适用于任何人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general",
                        "broad",
                        "universal",
                        "nonspecific"
                    ],
                    "antonyms": [
                        "specific",
                        "particular"
                    ],
                    "common_phrases": [
                        "generic term",
                        "generic name",
                        "generic description"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к целой группе или классу вещей; не специфичный для одного случая.",
                        "zh": "与整个事物类别相关或共有，而非针对特定个体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "универсальный"
                            },
                            {
                                "target_lang_word": "обобщённый",
                                "target_lang_sense_clarification": "сводный, не детализированный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通用的",
                                "target_lang_sense_clarification": "适用于多种情况"
                            },
                            {
                                "target_lang_word": "笼统的",
                                "target_lang_sense_clarification": "不具体、概括性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32308645-793e-35a8-8c02-c316b91674ef",
                    "sense_definition": "Lacking distinctive characteristics or originality; dull and predictable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie had a <w>generic</w> plot that I had seen many times before.",
                            "target_lang_translations": {
                                "ru": "У фильма был <w>шаблонный</w> сюжет, который я видел уже много раз.",
                                "zh": "这部电影的情节非常<w>平庸</w>，我以前看过很多次了。"
                            }
                        },
                        {
                            "text": "I am tired of listening to <w>generic</w> pop music on the radio.",
                            "target_lang_translations": {
                                "ru": "Я устал слушать <w>стандартную</w> поп-музыку по радио.",
                                "zh": "我听腻了收音机里那些<w>千篇一律</w>的流行音乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "generic look",
                        "generic style"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to criticize a lack of originality."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый отличительных черт или оригинальности; скучный и предсказуемый.",
                        "zh": "缺乏独特性或原创性；平庸且可预见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблонный",
                                "target_lang_sense_clarification": "неоригинальный"
                            },
                            {
                                "target_lang_word": "стандартный",
                                "target_lang_sense_clarification": "типичный, безликий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平庸的",
                                "target_lang_sense_clarification": "缺乏特色"
                            },
                            {
                                "target_lang_word": "千篇一律的",
                                "target_lang_sense_clarification": "指内容或风格乏味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26117afc-96aa-3899-9855-810e7979653f",
                    "sense_definition": "Relating to a biological genus.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>generic</w> name of the domestic cat is Felis.",
                            "target_lang_translations": {
                                "ru": "<w>Родовое</w> название домашней кошки — Felis.",
                                "zh": "家猫的<w>属</w>名是猫属（Felis）。"
                            }
                        },
                        {
                            "text": "Taxonomy requires the precise use of both <w>generic</w> and specific names.",
                            "target_lang_translations": {
                                "ru": "Таксономия требует точного использования как <w>родовых</w>, так и видовых названий.",
                                "zh": "分类学要求精确使用<w>属</w>名和种名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "generic name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к биологическому роду.",
                        "zh": "与生物学上的“属”相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родовой",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "属的",
                                "target_lang_sense_clarification": "生物分类学用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d831bfb8-fc91-305b-88ea-7c5fa575e3c4",
                    "sense_definition": "A product, especially a drug, that is sold without a brand name.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can save money by buying <w>generics</w> instead of name brands.",
                            "target_lang_translations": {
                                "ru": "Вы можете сэкономить, покупая <w>дженерики</w> вместо брендовых товаров.",
                                "zh": "你可以通过购买<w>仿制药</w>而不是名牌药来省钱。"
                            }
                        },
                        {
                            "text": "The pharmacy stocks <w>generics</w> for most common painkillers.",
                            "target_lang_translations": {
                                "ru": "В аптеке есть <w>дженерики</w> большинства распространенных обезболивающих.",
                                "zh": "药店里有大多数常见止痛药的<w>仿制药</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheaper generics",
                        "switch to generics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукт, особенно лекарство, который продается без торговой марки.",
                        "zh": "没有品牌名称的产品，尤指药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дженерик",
                                "target_lang_sense_clarification": "лекарственный аналог"
                            },
                            {
                                "target_lang_word": "непатентованное средство",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仿制药",
                                "target_lang_sense_clarification": "指药物"
                            },
                            {
                                "target_lang_word": "非品牌商品",
                                "target_lang_sense_clarification": "指一般商品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0909c1fa-52fb-34f5-9e3f-809f3b69e278",
                    "sense_definition": "A wine made from a combination of several grape varieties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This cheap <w>generic</w> is actually quite drinkable for the price.",
                            "target_lang_translations": {
                                "ru": "Это дешевое <w>немарочное вино</w> на самом деле вполне пригодно для питья за свою цену.",
                                "zh": "这款廉价的<w>混合葡萄酒</w>以这个价格来说其实还挺好喝的。"
                            }
                        },
                        {
                            "text": "The winery produces both fine varietals and affordable <w>generics</w>.",
                            "target_lang_translations": {
                                "ru": "Винодельня производит как изысканные сортовые вина, так и доступные <w>немарочные вина</w>.",
                                "zh": "这家酒庄既生产优质的单一品种葡萄酒，也生产实惠的<w>普通餐酒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blend"
                    ],
                    "antonyms": [
                        "varietal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вино, изготовленное из сочетания нескольких сортов винограда.",
                        "zh": "由多种葡萄品种混合酿制而成的葡萄酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немарочное вино",
                                "target_lang_sense_clarification": "смесь сортов"
                            },
                            {
                                "target_lang_word": "ординарное вино",
                                "target_lang_sense_clarification": "столовое вино"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合葡萄酒",
                                "target_lang_sense_clarification": "非单一品种"
                            },
                            {
                                "target_lang_word": "普通餐酒",
                                "target_lang_sense_clarification": "指大众化酒品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}