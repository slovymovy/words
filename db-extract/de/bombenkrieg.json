                "senses": [
                    {
                        "sense_id": "c4efae06-793a-3977-ba47-8ef2beb00a6f",
                        "entry_id": "0cecd94d-9fb4-361e-9306-4ff6df8f06c2",
                        "glosses": [
                            "Kriegsgeschehen, das durch massenhaften Abwurf von Bomben geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8268d10-9c26-47eb-96f8-c58689fedd29",
                                "sense_id": "c4efae06-793a-3977-ba47-8ef2beb00a6f",
                                "text": "„Den Bombenkrieg überlebte Marianne Kraft im Ruhrgebiet.“"
                            },
                            {
                                "example_id": "75f080a6-9bd2-48c4-828a-77b23ac8a002",
                                "sense_id": "c4efae06-793a-3977-ba47-8ef2beb00a6f",
                                "text": "„Bombenkrieg und Eroberung haben Stettins Altstadt fast völlig zerstört; wir sehen die Ruine der Jakobikirche.“"
                            },
                            {
                                "example_id": "0b66d961-dd9c-4f6f-a416-b42444835aa1",
                                "sense_id": "c4efae06-793a-3977-ba47-8ef2beb00a6f",
                                "text": "„Von Jahresbeginn bis Anfang Mai 1945 forderte der Bombenkrieg in ganz Deutschland im Durchschnitt täglich tausend Todesopfer; insgesamt 130000.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
