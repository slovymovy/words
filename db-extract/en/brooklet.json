                "senses": [
                    {
                        "sense_id": "a2833d92-0d53-3410-b149-587cadeb3e6a",
                        "entry_id": "5e9e4eab-f6fb-3940-a9d1-2100a3216c63",
                        "glosses": [
                            "A little brook."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1059d5e-d11c-4718-91df-eca2ce414106",
                                "sense_id": "a2833d92-0d53-3410-b149-587cadeb3e6a",
                                "text": "Vast forests have disappeared from mountain spurs and ridges;[…] rivers famous in history and song have shrunk to humble brooklets; […]"
                            },
                            {
                                "example_id": "e2534e2d-d2c9-44f9-95c3-db812f98ba35",
                                "sense_id": "a2833d92-0d53-3410-b149-587cadeb3e6a",
                                "text": "There was a very light off-shore wind and scarcely any breakers, so that the approach to the shore was continued without finding bottom; yet though we were already quite close, we saw no indication of any indention in the coast from which even a tiny brooklet might issue, and certainly no mouth of a large river such as this must necessarily be to freshen the ocean even two hundred yards from shore."
                            }
                        ]
                    }
                ],
