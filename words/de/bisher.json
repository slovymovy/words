                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben <w>bisher</w> noch keine passende Antwort auf unsere Bewerbung erhalten.",
                            "target_lang_translations": {
                                "en": "We have not received a suitable response to our application <w>so far</w>.",
                                "ru": "Мы <w>до сих пор</w> ещё не получили подходящего ответа на нашу заявку.",
                                "nl": "We hebben <w>tot nu toe</w> nog geen passend antwoord op onze sollicitatie ontvangen.",
                                "pl": "<w>Dotychczas</w> nie otrzymaliśmy jeszcze odpowiedniej odpowiedzi na naszą aplikację.",
                                "fr": "Nous n'avons <w>jusqu'à présent</w> pas encore reçu de réponse appropriée à notre candidature.",
                                "it": "<w>Finora</w> non abbiamo ancora ricevuto una risposta adeguata alla nostra candidatura.",
                                "cs": "Na naši žádost jsme <w>dosud</w> ještě neobdrželi žádnou vhodnou odpověď.",
                                "tr": "Başvurumuza <w>şimdiye kadar</w> henüz uygun bir yanıt alamadık.",
                                "es": "<w>Hasta ahora</w> todavía no hemos recibido una respuesta adecuada a nuestra solicitud.",
                                "zh": "我们<w>至今</w>还没有收到对求职申请的合适答复。"
                            }
                        },
                        {
                            "text": "<w>Bisher</w> ist in dieser schwierigen Angelegenheit zum Glück noch nichts Schlimmes passiert.",
                            "target_lang_translations": {
                                "en": "<w>So far</w>, fortunately nothing bad has happened in this difficult matter.",
                                "ru": "<w>До сих пор</w> в этом сложном деле, к счастью, ничего плохого ещё не произошло.",
                                "nl": "<w>Tot dusver</w> is er in deze moeilijke kwestie gelukkig nog niets ergs gebeurd.",
                                "pl": "<w>Do tej pory</w> w tej trudnej sprawie na szczęście nie wydarzyło się jeszcze nic złego.",
                                "fr": "<w>Jusqu'à présent</w>, heureusement, rien de grave ne s'est produit dans cette affaire difficile.",
                                "it": "<w>Finora</w>, per fortuna, non è successo niente di grave in questa difficile faccenda.",
                                "cs": "<w>Doposud</w> se v této složité záležitosti naštěstí nestalo nic zlého.",
                                "tr": "<w>Şu ana kadar</w> bu zor meselede neyse ki henüz kötü bir şey olmadı.",
                                "es": "<w>Hasta ahora</w>, por suerte no ha ocurrido nada grave en este difícil asunto.",
                                "zh": "<w>到目前为止</w>，在这一棘手的事情上幸好还没发生什么糟糕的事。"
                            }
                        }
