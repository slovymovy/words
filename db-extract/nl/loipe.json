                                "target_senses": [
                                    {
                                        "sense_id": "3da20211-99a2-3bdb-950e-1161e3b1caa1",
                                        "entry_id": "f4d17ca4-729d-3f2b-8ed5-b12556af40b4",
                                        "glosses": [
                                            "A cross-country ski trail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285c800c-d76d-47ec-815b-8816a602ac57",
                                                "sense_id": "3da20211-99a2-3bdb-950e-1161e3b1caa1",
                                                "text": "The provision of one of the basic requirements, a prepared track, commonly called a \"loipe,\" is now a normal feature of almost every resort in the world."
                                            },
                                            {
                                                "example_id": "387148d7-e96e-449b-84dd-af1c4deeaf12",
                                                "sense_id": "3da20211-99a2-3bdb-950e-1161e3b1caa1",
                                                "text": "Cross-country skiers enjoy 21km of loipe, and winter walkers head out on 17km of footpaths; the tourist office offers loipe and walking maps."
                                            },
                                            {
                                                "example_id": "0dc129e0-88c3-425d-ad52-8f5e56bd4f25",
                                                "sense_id": "3da20211-99a2-3bdb-950e-1161e3b1caa1",
                                                "text": "As the profile of the loipe flashed through his mind, he felt a sinking feeling in his stomach, and struggled into a full snowplough, using both skis to decelerate as hard as possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
