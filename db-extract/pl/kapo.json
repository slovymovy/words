                                        "examples": [
                                            {
                                                "example_id": "9929fe61-9673-455d-ba3c-4629ff24820b",
                                                "sense_id": "5196fc19-5a81-330c-a951-3b578f345304",
                                                "text": "Der Kapo hat seine Anweisungen korrekt gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd6870ff-0e86-3c7a-b825-37f84683b474",
                                        "entry_id": "f84dae3b-f292-3151-82cc-f7f09f27e680",
                                        "glosses": [
                                            "ein Unteroffizier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc72b9e0-2df4-4db9-94be-b9dbef14f481",
                                                "sense_id": "dd6870ff-0e86-3c7a-b825-37f84683b474",
                                                "text": "Der Kapo hat seine Anweisungen korrekt gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0daa2976-2b8b-3197-9d0d-bf27fa5dc66a",
                                        "entry_id": "f84dae3b-f292-3151-82cc-f7f09f27e680",
                                        "glosses": [
                                            "Funktionshäftling in einem Konzentrationslager, der als Mitarbeiter der Lagerleitung und gegen Vergünstigungen andere Häftlinge im Auftrag der SS beaufsichtigte und anleitete"
                                        ],
                                        "tags": [
                                            "Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c4821f-2818-495d-9930-f05df87f80d9",
                                                "sense_id": "0daa2976-2b8b-3197-9d0d-bf27fa5dc66a",
                                                "text": "„Wir mußten uns in Reihen aufstellen, und die Kapos kontrollierten unsere Nummern.“"
                                            },
                                            {
                                                "example_id": "649ea896-9757-4887-acef-d8a0294036f4",
                                                "sense_id": "0daa2976-2b8b-3197-9d0d-bf27fa5dc66a",
                                                "text": "„Als die Deutschen schließlich eintrafen, reichte jeder Kapo dem Hauptkapo eine Liste, der wiederum der SS die Zahl der Häftlinge meldete.“"
                                            },
                                            {
                                                "example_id": "6bac3bc1-e314-4c95-af20-bc26b4c3c327",
                                                "sense_id": "0daa2976-2b8b-3197-9d0d-bf27fa5dc66a",
                                                "text": "„Jede Baracke hatte einen Blockältesten und einige Stubenälteste; die Arbeitskommandos unterstanden den Kapos und Vormännern, das ganze Lager den Lagerältesten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
