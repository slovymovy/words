                        "examples": [
                            {
                                "example_id": "69e90576-9a11-4181-91ff-0466c01e8a98",
                                "sense_id": "62648d21-e7d6-380b-af7f-a0c16881f1e0",
                                "text": "„Unsere drei Freunde hatten in einer dem Kellerloch schräg gegenübergelegenen Ecke Platz genommen, und Sander, der grad lange genug Verleger war, um sich auf lukullische Feinheiten zu verstehen, überflog eben die Wein- und Speisekarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f89ad8e-6f11-3500-922c-5e6ad2b420a1",
                        "entry_id": "da2177b5-7a63-3d5b-be33-131b77edd11e",
                        "glosses": [
                            "Öffnung in der Kellerwand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ee9e0b-c9b4-415a-83ab-6fd7bb43a838",
                                "sense_id": "5f89ad8e-6f11-3500-922c-5e6ad2b420a1",
                                "text": "Der Einbrecher gelangte durch ein Kellerloch ins Haus."
                            }
                        ],
                        "sense_index_json": "\"2\""
