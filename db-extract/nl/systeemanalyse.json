                "translations": [
                    {
                        "translation_id": "4a721090-1bc5-4fda-be6a-0c4443ee34ca",
                        "source_entry_id": "d4277fb4-3fa7-3878-828c-bbd8f3cca781",
                        "source_sense_id": "1e7b3630-144c-3546-9773-2617532c2349",
                        "source_sense_description": "een interdiscipline tussen informatie en bedrijfskunde, gericht op het analyseren van systemen, voorafgaande aan reorganisatie en of automatisering van bedrijfsprocessen",
                        "target_lang_word": "Systemanalyse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Systemanalyse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3937b60-1e2c-3424-9bd6-18af0c99690e",
                                        "entry_id": "9604aa53-90e9-315d-9d89-162ebab4ca11",
                                        "glosses": [
                                            "Untersuchung, Beschreibung und Bewertung von komplexen Zusammenspielen, zum Beispiel in technischen oder betrieblichen Systemen, Beschreibung des Soll-Zustandes eines zu entwickelnden Systems"
                                        ],
                                        "tags": [
                                            "EDV",
                                            "IT",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c089ba-c93e-4dc6-9f24-6d2093ea7674",
                                                "sense_id": "c3937b60-1e2c-3424-9bd6-18af0c99690e",
                                                "text": "Der Systemanalytiker führte zusammen mit seinen Kolleginnen die Systemanalyse durch."
                                            },
                                            {
                                                "example_id": "53d2806f-9dd2-4123-a5ff-37be1aa042d1",
                                                "sense_id": "c3937b60-1e2c-3424-9bd6-18af0c99690e",
                                                "text": "„Dies ist von besonderer Bedeutung, da eine Systemanalyse nicht zum Selbstzweck durchgeführt wird, sondern die Grundlagen für eine zielgerichtete Veränderung eines Systems schaffen soll.“"
                                            },
                                            {
                                                "example_id": "ba5af747-e5d8-47bc-b40c-5a3049be1b4a",
                                                "sense_id": "c3937b60-1e2c-3424-9bd6-18af0c99690e",
                                                "text": "„Die Beiträge des vorliegenden Sammelbandes wollen dem Leser das anspruchsvolle Konzept der sozialwissenschaftlichen Systemanalyse näher bringen und deren Tauglichkeit für die Analyse komplexer politischer Prozesse und Strukturen in verschiedenen Anwendungsgebieten demonstrieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
