                        "entry_id": "b1217417-7103-3bd3-9a67-9f70b3e10290",
                        "glosses": [
                            "eine aus dem Orient kommende Knüpftechnik zur Herstellung von Ornamenten oder Textilien"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fad3ec02-34e3-45b8-b9a6-bc60d16c3591",
                                "sense_id": "75f6a4dc-fc97-3ac7-ad87-32227d617d94",
                                "text": "Die Knotenkunstwerke des Macramé reichen von Ausmaßen um wenige Zentimeter bis zu beeindruckenden 10 Metern."
                            },
                            {
                                "example_id": "7d7c9b68-a8f8-4a9a-97dd-fc80f4da93a3",
                                "sense_id": "75f6a4dc-fc97-3ac7-ad87-32227d617d94",
                                "text": "Man findet die Knüpftechnik zum Beispiel als Chinesisches Macramé, das Glück zu Neujahr bringen soll oder Macramé-Eulen, eine traditionelle Form des Macramé."
                            }
                        ],
                        "sense_index_json": "\"1\""
