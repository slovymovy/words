                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "garner",
                                "target_lang_sense_clarification": "to gather or store grain"
                            },
                            {
                                "target_lang_word": "barn",
                                "target_lang_sense_clarification": "to store in a barn"
                            }
                        ]
                    }
                }
            ]
        },
