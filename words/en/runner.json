{
    "word_family": [
        "run",
        "running",
        "runway",
        "run-off",
        "run-in",
        "run-through",
        "run-around"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0721802-8177-329d-9184-85658c5ff582",
                    "sense_definition": "A person who moves on foot at a fast pace, especially as an athlete or for exercise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_who_runs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>runner</w> to cross the finish line wins the gold medal.",
                            "target_lang_translations": {
                                "ru": "Первый <w>бегун</w>, пересекший финишную черту, получает золотую медаль.",
                                "zh": "第一个冲过终点线的<w>跑步者</w>赢得了金牌。"
                            }
                        },
                        {
                            "text": "She is a fast <w>runner</w> and trains at the local track every morning.",
                            "target_lang_translations": {
                                "ru": "Она быстрая <w>бегунья</w> и каждое утро тренируется на местном стадионе.",
                                "zh": "她是一位速度很快的<w>跑步者</w>，每天早上都在当地的跑道上训练。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marathon runner",
                        "fast runner",
                        "cross-country runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который быстро передвигается пешком, особенно как спортсмен или для физических упражнений.",
                        "zh": "指跑步的人，尤指运动员或为了锻炼而跑步的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегун",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "бегунья",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跑步者",
                                "target_lang_sense_clarification": "泛指跑步的人"
                            },
                            {
                                "target_lang_word": "运动员",
                                "target_lang_sense_clarification": "指参加比赛的跑步选手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88eb8826-e5fd-374c-a141-e14f5858ef62",
                    "sense_definition": "A type of soft-soled shoe designed for running or sports.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new pair of <w>runners</w> before the race starts.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую пару <w>кроссовок</w> до начала забега.",
                                "zh": "在比赛开始前，我需要买一双新的<w>跑鞋</w>。"
                            }
                        },
                        {
                            "text": "He wore bright yellow <w>runners</w> that were very easy to spot.",
                            "target_lang_translations": {
                                "ru": "На нем были ярко-желтые <w>кроссовки</w>, которые было очень легко заметить.",
                                "zh": "他穿着一双亮黄色的<w>运动鞋</w>，非常显眼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sneaker",
                        "trainer"
                    ],
                    "common_phrases": [
                        "pair of runners"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Ireland, Australia, and parts of Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип обуви на мягкой подошве, предназначенный для бега или занятий спортом.",
                        "zh": "一种软底运动鞋，专为跑步或体育活动设计。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроссовки",
                                "target_lang_sense_clarification": "спортивная обувь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动鞋",
                                "target_lang_sense_clarification": "通用的运动鞋"
                            },
                            {
                                "target_lang_word": "跑鞋",
                                "target_lang_sense_clarification": "专门用于跑步的鞋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7dad6de-45eb-3323-bea4-36733e9aca01",
                    "sense_definition": "A long, narrow strip of fabric used to decorate or protect a table.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "household_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The red <w>runner</w> makes the dining table look very festive for the holidays.",
                            "target_lang_translations": {
                                "ru": "Красная <w>дорожка</w> придает обеденному столу очень праздничный вид.",
                                "zh": "红色的<w>桌旗</w>让餐桌在节日里看起来非常有气氛。"
                            }
                        },
                        {
                            "text": "We placed a lace <w>runner</w> over the wooden dresser to prevent scratches.",
                            "target_lang_translations": {
                                "ru": "Мы постелили кружевную <w>дорожку</w> на деревянный комод, чтобы предотвратить появление царапин.",
                                "zh": "我们在木制梳妆台上铺了一条蕾丝<w>桌旗</w>以防止刮伤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "table runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая полоска ткани, используемая для украшения или защиты стола.",
                        "zh": "铺在桌子中间的长条形装饰布，用于装饰或保护桌面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "настольная"
                            },
                            {
                                "target_lang_word": "раннер",
                                "target_lang_sense_clarification": "декоративная скатерть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桌旗",
                                "target_lang_sense_clarification": "装饰桌面的长条布"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "608c747a-e965-34cd-b853-37d1edae4f7e",
                    "sense_definition": "A long, narrow carpet used for hallways or stairs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "household_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to put a carpet <w>runner</w> in the hallway to reduce noise.",
                            "target_lang_translations": {
                                "ru": "Мы решили постелить ковровую <w>дорожку</w> в коридоре, чтобы уменьшить шум.",
                                "zh": "我们决定在走廊里铺一条<w>走廊地毯</w>来减少噪音。"
                            }
                        },
                        {
                            "text": "The stairs look much better now that the new <w>runner</w> is installed.",
                            "target_lang_translations": {
                                "ru": "Лестница выглядит гораздо лучше теперь, когда на ней лежит новая <w>дорожка</w>.",
                                "zh": "装上新的<w>楼梯地毯</w>后，楼梯看起来好多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stair runner",
                        "hallway runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий ковер, используемый для коридоров или лестниц.",
                        "zh": "铺在走廊或楼梯上的长条形地毯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "ковровая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走廊地毯",
                                "target_lang_sense_clarification": "铺在过道上的长条地毯"
                            },
                            {
                                "target_lang_word": "楼梯地毯",
                                "target_lang_sense_clarification": "铺在楼梯上的长条地毯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09085323-d730-331e-bbdd-694f3b12e3fc",
                    "sense_definition": "A person sent on an errand or to deliver messages and communications.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_who_runs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law firm hired a <w>runner</w> to deliver the documents to the courthouse.",
                            "target_lang_translations": {
                                "ru": "Юридическая фирма наняла <w>курьера</w> для доставки документов в здание суда.",
                                "zh": "律师事务所雇了一名<w>跑腿的</w>把文件送到法院。"
                            }
                        },
                        {
                            "text": "During the war, a <w>runner</w> was responsible for carrying messages between units.",
                            "target_lang_translations": {
                                "ru": "Во время войны <w>посыльный</w> отвечал за доставку сообщений между подразделениями.",
                                "zh": "战争期间，<w>信使</w>负责在各部队之间传递信息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, посланный с поручением или для доставки сообщений и корреспонденции.",
                        "zh": "被派去跑腿或传递信息的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курьер",
                                "target_lang_sense_clarification": "доставщик"
                            },
                            {
                                "target_lang_word": "посыльный",
                                "target_lang_sense_clarification": "выполняющий поручения"
                            },
                            {
                                "target_lang_word": "гонец",
                                "target_lang_sense_clarification": "со срочным известием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跑腿的",
                                "target_lang_sense_clarification": "负责办事的人"
                            },
                            {
                                "target_lang_word": "信使",
                                "target_lang_sense_clarification": "负责传递信息的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b4d4d69-77fd-3df5-b393-bc5f32942aad",
                    "sense_definition": "An entrant in a race or competition, such as a horse or a political candidate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competitor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable has one <w>runner</w> in the final race of the afternoon.",
                            "target_lang_translations": {
                                "ru": "У конюшни есть один <w>участник</w> в последнем дневном заезде.",
                                "zh": "马厩有一匹马参加了下午的最后一场<w>参赛者</w>比赛。"
                            }
                        },
                        {
                            "text": "The judge confirmed she would not be a <w>runner</w> in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Судья подтвердила, что не будет <w>кандидатом</w> на предстоящих выборах.",
                                "zh": "法官确认她不会参加即将到来的选举，不会成为<w>候选人</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "election runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник гонки или соревнования, например, лошадь или политический кандидат.",
                        "zh": "参加比赛或竞选的选手，如赛马或政治候选人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участник",
                                "target_lang_sense_clarification": "соревнований или выборов"
                            },
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "на выборах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参赛者",
                                "target_lang_sense_clarification": "参加比赛的人或动物"
                            },
                            {
                                "target_lang_word": "候选人",
                                "target_lang_sense_clarification": "参加竞选的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e6abd5-f7e4-3cfa-a54b-8cc70157e0bd",
                    "sense_definition": "A long stem sent out by a plant along the ground to root new plants.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strawberry plants spread quickly by sending out a <w>runner</w> to start new growth.",
                            "target_lang_translations": {
                                "ru": "Земляника быстро разрастается, выпуская <w>ус</w> для начала нового роста.",
                                "zh": "草莓植株通过长出<w>匍匐茎</w>来迅速繁殖新植株。"
                            }
                        },
                        {
                            "text": "You can propagate this plant by cutting the <w>runner</w> once it has rooted.",
                            "target_lang_translations": {
                                "ru": "Вы можете размножить это растение, отрезав <w>побег</w>, как только он укоренится.",
                                "zh": "一旦<w>匍匐茎</w>生根，你就可以通过剪断它来繁殖这种植物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "strawberry runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный стебель, выпускаемый растением вдоль земли для укоренения новых растений.",
                        "zh": "植物沿地面生长并能长出新植株的茎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "стелющийся"
                            },
                            {
                                "target_lang_word": "ус",
                                "target_lang_sense_clarification": "у клубники и др."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匍匐茎",
                                "target_lang_sense_clarification": "植物学名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b4eda30-50de-308e-91a3-f0cf41a86269",
                    "sense_definition": "A groove or strip on which a drawer or sliding door moves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drawer is stuck because it has come off its metal <w>runner</w>.",
                            "target_lang_translations": {
                                "ru": "Ящик застрял, потому что он соскочил с металлической <w>направляющей</w>.",
                                "zh": "抽屉卡住了，因为它从金属<w>滑轨</w>上脱落了。"
                            }
                        },
                        {
                            "text": "Apply some grease to the <w>runner</w> so the sliding door moves smoothly.",
                            "target_lang_translations": {
                                "ru": "Смажьте <w>полоз</w>, чтобы раздвижная дверь двигалась плавно.",
                                "zh": "在<w>滑轨</w>上涂点润滑油，这样推拉门移动起来会更顺畅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drawer runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Паз или планка, по которой движется выдвижной ящик или раздвижная дверь.",
                        "zh": "抽屉或推拉门滑动的轨道或槽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направляющая",
                                "target_lang_sense_clarification": "механическая деталь"
                            },
                            {
                                "target_lang_word": "полоз",
                                "target_lang_sense_clarification": "для скольжения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑轨",
                                "target_lang_sense_clarification": "用于滑动的机械部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb7c1782-d3af-3737-86e1-d95cd78f7547",
                    "sense_definition": "A person or vessel that engages in smuggling or evades blockades.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_who_runs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coast guard intercepted a blockade <w>runner</w> carrying illegal cargo.",
                            "target_lang_translations": {
                                "ru": "Береговая охрана перехватила <w>прорывщика</w> блокады, перевозившего нелегальный груз.",
                                "zh": "海岸警卫队拦截了一艘载有非法货物的<w>封锁突破者</w>。"
                            }
                        },
                        {
                            "text": "He was known as a notorious gun <w>runner</w> in the region.",
                            "target_lang_translations": {
                                "ru": "Он был известен в регионе как отъявленный <w>контрабандист</w> оружия.",
                                "zh": "他以该地区臭名昭著的军火<w>走私者</w>而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blockade runner",
                        "gun runner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или судно, занимающееся контрабандой или прорывом блокады.",
                        "zh": "从事走私或突破封锁的人或船只。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контрабандист",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "прорывщик",
                                "target_lang_sense_clarification": "блокады"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走私者",
                                "target_lang_sense_clarification": "从事非法运输的人"
                            },
                            {
                                "target_lang_word": "封锁突破者",
                                "target_lang_sense_clarification": "突破封锁的船只或人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a010dce-2773-3087-b931-d133d84defa6",
                    "sense_definition": "An idea, plan, or proposal that has the potential to be successful or adopted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_concepts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided that the new marketing plan wasn't a <w>runner</w>.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил, что новый маркетинговый план не является <w>жизнеспособным</w>.",
                                "zh": "经理认为新的营销计划不是一个<w>可行方案</w>。"
                            }
                        },
                        {
                            "text": "If we can lower the costs, this project might actually be a <w>runner</w>.",
                            "target_lang_translations": {
                                "ru": "Если мы сможем снизить затраты, этот проект может оказаться <w>перспективным</w>.",
                                "zh": "如果我们能降低成本，这个项目可能真的会成为一个<w>可行方案</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in business or political contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, план или предложение, имеющее потенциал для успеха или принятия.",
                        "zh": "有成功潜力或值得采纳的想法、计划或提议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнеспособный вариант",
                                "target_lang_sense_clarification": "об идее или плане"
                            },
                            {
                                "target_lang_word": "перспективный план",
                                "target_lang_sense_clarification": "имеющий шансы на успех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可行方案",
                                "target_lang_sense_clarification": "有潜力的计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc46e86-916d-3787-a3c9-4d6fc87b8c53",
                    "sense_definition": "A quick escape from a scene, often to avoid paying or being caught.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspects did a <w>runner</w> as soon as they heard the police sirens.",
                            "target_lang_translations": {
                                "ru": "Подозреваемые <w>бросились наутек</w>, как только услышали полицейские сирены.",
                                "zh": "嫌疑人一听到警笛声就<w>逃跑</w>了。"
                            }
