                "forms": [
                    {
                        "form_id": "d5f56b04-787e-4661-b95a-3e82ae88d33e",
                        "entry_id": "3a9ab40e-bf9e-30bf-b992-0c777e494aac",
                        "tags": [
                            "plural"
                        ],
                        "form": "anfractuosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                        "entry_id": "3a9ab40e-bf9e-30bf-b992-0c777e494aac",
                        "glosses": [
                            "Cavité, creux, enfoncement irrégulier et sinueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e536b4-50bc-482b-82f9-966a5c96541b",
                                "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                                "text": "Puis, de Vouvray jusqu'à Tours, les effrayantes anfractuosités de cette colline déchirée sont habitées par une population de vignerons."
                            },
                            {
                                "example_id": "a5678acc-1c8b-43b5-aefb-169a0168857a",
                                "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                                "text": "Les pies de mer, les alouettes de mer, suivaient en piétinant les anfractuosités de la côte."
                            },
                            {
                                "example_id": "1a79700e-6f83-4cb4-afc9-36a4b0862ea9",
                                "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                                "text": "Enfin il revint à son point de départ et examina une dernière fois si tout correspondait bien : la traînée d'herbes sèches à la traînée de poudre, et la traînée de poudre du sol avec la poudre contenue dans les anfractuosités du mur."
                            },
                            {
                                "example_id": "fd8363ae-0828-454e-af55-6e8106e1ddf9",
                                "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                                "text": "Dans un grand épanchement de clarté, je vois, sous les pins des promontoires, une côte éclatante, d'immenses baies toutes bleues, une théâtrale enluminure, où la ligne déchiquetée des porphyres limite en ses anfractuosités rougeoyantes l'azur doré de la mer."
                            },
                            {
                                "example_id": "fee5c473-2453-417c-a8e0-f291f768a958",
                                "sense_id": "b9f9f10c-6a8c-3154-8435-804a36449d15",
                                "text": "Une demi-heure plus tard, après avoir, suivant la tradition, placé dans une anfractuosité une bouteille cachetée contenant un document commémoratif que je leur passai, Moussard et Le François purent sauter de nouveau dans la baleinière."
                            }
                        ]
                    },
                    {
                        "sense_id": "d21c7acc-c308-3b01-b739-456e45f8b354",
                        "entry_id": "3a9ab40e-bf9e-30bf-b992-0c777e494aac",
                        "glosses": [
                            "Cavité inégale qui se trouve à la surface de certains os."
                        ],
                        "tags": [],
                        "examples": []
                    }
