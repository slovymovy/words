        "fr-extract.jsonl": [
            {
                "entry_id": "6191a434-cd11-34ad-bf95-7ad6bc7bcfcf",
                "word": "campanule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e2e7bc75-abce-46ba-8c5f-604e2419c1cd",
                        "entry_id": "6191a434-cd11-34ad-bf95-7ad6bc7bcfcf",
                        "tags": [
                            "plural"
                        ],
                        "form": "campanules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                        "entry_id": "6191a434-cd11-34ad-bf95-7ad6bc7bcfcf",
                        "glosses": [
                            "Genre de plantes dont il existe un très grand nombre d’espèces, qui toutes portent des fleurs en forme de cloches, et que l’on cultive, pour la plupart, dans les jardins d’agrément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f165533c-8321-43b1-a993-ac37c686b470",
                                "sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                                "text": "Les campanules qui croissent dans les fentes se balançaient au-dessus de ma tête, et la joue contre la pierre, chaude encore du brasier de midi, j’écoutais sangloter une source cachée."
                            },
                            {
                                "example_id": "9f6ca1e9-e0bd-4837-b42b-e82f706a0e53",
                                "sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                                "text": "Voici une pie grièche et voici un loriot, voilà la campanule et voilà la bourrache."
                            },
                            {
                                "example_id": "b51f2e09-bebf-480a-82c6-5999a5363fe2",
                                "sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                                "text": "Si l’homme ressemble un peu à mon père, la femme n’est pas ma mère — ça, c’est sûr, bien qu’elle se comporte comme telle quand elle vient me voir tous les jours : elle me caresse la main, m’embrasse les cheveux, me masse les pieds en suivant les instructions du physiothérapeute, et dispose des campanules et des anémones dans une cruche qu’elle a apportée ici."
                            },
                            {
                                "example_id": "73c60a9f-418b-4c16-bec6-d2b9408fa03a",
                                "sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                                "text": "Et puis la vieille capitale apparaît, nid de hiboux, avec son minaret dépassant ses murailles grises. — Vieux pont-levis, vieux remparts, — avec des touffes de campanules étalant partout sur les pierres leurs fleurs fraîches, d’un violet admirable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f206548-77f2-442d-9e66-f3f1ef229489",
                        "source_entry_id": "6191a434-cd11-34ad-bf95-7ad6bc7bcfcf",
                        "source_sense_id": "d8c43d55-7bb8-39cc-82a6-a1bbec327ab2",
                        "target_lang_word": "Glockenblume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glockenblume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                        "entry_id": "515e566c-1292-3101-be6e-3ffee3800577",
                                        "glosses": [
                                            "Pflanze, die zwischen 10 cm und 2 m hoch wächst und glocken- oder sternförmige meist violette oder blaue Blüten hat"
                                        ],
                                        "tags": [
                                            "Flora"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5c844a-252f-45f8-a83a-641085ae8afc",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Es ist der letzte Februartag, die Sonne scheint, im Hof sind die ersten Glockenblumen aufgeblüht.“"
                                            },
                                            {
                                                "example_id": "9a6f60ed-4fbd-4a36-9c16-3e640835d259",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Glockenblumen sind beliebte Schnitt- und Rabattblumen.“"
                                            },
                                            {
                                                "example_id": "bfa98b19-d56a-475b-97b9-836f94fbc299",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Leicht erkennbar sind Glockenblumen an ihren glocken-, röhren- oder sternförmigen Blüten, die sich je nach Art und Sorte zwischen Juni und September öffnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
