            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b5de732-dd8b-3c75-92cd-37b2ff5bf8af",
                    "sense_definition": "Iemand in grote verwarring of verbazing brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het onverwachte nieuws <w>verbijsterde</w> de hele aanwezige menigte.",
                            "target_lang_translations": {
                                "pl": "Nieoczekiwana wiadomość <w>wprawiła w osłupienie</w> cały zgromadzony tłum."
                            }
                        },
                        {
                            "text": "De plotselinge beslissing van de directeur <w>verbijsterde</w> het personeel volledig.",
                            "target_lang_translations": {
                                "pl": "Nagła decyzja dyrektora całkowicie <w>zbiła z tropu</w> personel."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwarren",
                        "verbazen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wprowadzić kogoś w stan wielkiego zdumienia, konsternacji lub oszołomienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wprawić w osłupienie",
                                "target_lang_sense_clarification": "wywołać u kogoś stan szoku lub wielkiego zdziwienia"
                            },
                            {
                                "target_lang_word": "zbić z tropu",
                                "target_lang_sense_clarification": "zdezorientować kogoś nagłą informacją lub sytuacją"
                            },
                            {
                                "target_lang_word": "zszokować",
                                "target_lang_sense_clarification": "wywołać silne zaskoczenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4d3d4eb-43e3-3e55-8c77-ec844625ea7e",
                    "sense_definition": "Iemand een gevoel van grote verslagenheid of ontzetting geven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De omvang van de ramp <w>verbijsterde</w> de hulpverleners ter plaatse.",
                            "target_lang_translations": {
                                "pl": "Skala katastrofy <w>wstrząsnęła</w> ratownikami na miejscu."
                            }
                        },
                        {
                            "text": "Het wrede onrecht <w>verbijsterde</w> iedereen die ervan hoorde.",
                            "target_lang_translations": {
                                "pl": "Okrutna niesprawiedliwość <w>wstrząsnęła</w> każdym, kto o niej usłyszał."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontstellen",
                        "verslagen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wywołać u kogoś uczucie głębokiego przygnębienia, przerażenia lub konsternacji w obliczu tragicznych wydarzeń."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wstrząsnąć",
                                "target_lang_sense_clarification": "wywołać silne, negatywne emocje w obliczu tragedii"
                            },
                            {
                                "target_lang_word": "przerażać",
                                "target_lang_sense_clarification": "budzić grozę lub głęboki niepokój"
                            },
                            {
                                "target_lang_word": "konsternować",
                                "target_lang_sense_clarification": "wprawiać w zakłopotanie lub bezradność"
                            }
                        ]
                    }
                }
            ]
        }
    ]
