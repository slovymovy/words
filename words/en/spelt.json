                            {
                                "target_lang_word": "zapisał",
                                "target_lang_sense_clarification": "w kontekście poprawnej pisowni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51e4c271-f35e-313c-a918-f8fe68f11e49",
                    "sense_definition": "To split, crush, or grind grain or pulses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crush_grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miller began to <w>spelt</w> the dried beans to prepare them for animal fodder.",
                            "target_lang_translations": {
                                "pl": "Młynarz zaczął <w>śrutować</w> suszoną fasolę, aby przygotować ją na paszę dla zwierząt."
                            }
                        },
                        {
                            "text": "Farmers used heavy stone mills to <w>spelt</w> the pulses during the winter months.",
                            "target_lang_translations": {
                                "pl": "Rolnicy używali ciężkich kamiennych żaren, aby <w>rozdrabniać</w> rośliny strączkowe w miesiącach zimowych."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare or regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "rozdrabniać, miażdżyć lub mleć ziarno bądź nasiona roślin strączkowych"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "śrutować",
                                "target_lang_sense_clarification": "grubo mielić ziarno lub nasiona"
                            },
                            {
                                "target_lang_word": "miażdżyć",
                                "target_lang_sense_clarification": "rozgniatać ziarno"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8262ca4-943c-300e-ba77-5dd1b2928719",
                    "sense_definition": "An ancient species of wheat with grains that have a nutty flavor, often used as flour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to bake artisan bread using whole <w>spelt</w> flour rather than modern wheat.",
                            "target_lang_translations": {
                                "pl": "Woli piec tradycyjny chleb z pełnoziarnistej mąki <w>orkiszowej</w> niż ze współczesnej pszenicy."
                            }
                        },
                        {
                            "text": "Ancient crops like <w>spelt</w> and barley have become popular in modern organic cooking.",
                            "target_lang_translations": {
                                "pl": "Dawne uprawy, takie jak <w>orkisz</w> i jęczmień, stały się popularne we współczesnej kuchni ekologicznej."
                            }
                        }
                    ],
                    "synonyms": [
                        "dinkel"
                    ],
                    "common_phrases": [
                        "spelt flour",
                        "spelt bread"
                    ],
                    "target_lang_definitions": {
                        "pl": "dawny gatunek pszenicy o orzechowym smaku ziarna, często używany jako mąka"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "orkisz",
                                "target_lang_sense_clarification": "gatunek pszenicy (Triticum spelta)"
                            },
                            {
                                "target_lang_word": "szpelc",
                                "target_lang_sense_clarification": "regionalnie lub rzadziej: orkisz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caae95dd-2a0c-3b9c-b726-94e95010a99a",
                    "sense_definition": "A thin sliver or splinter of wood or metal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny <w>spelt</w> of iron flew off the anvil as the smith struck the hot metal.",
                            "target_lang_translations": {
                                "pl": "Malutki <w>odłamek</w> żelaza odskoczył od kowadła, gdy kowal uderzył w rozgrzany metal."
                            }
                        },
                        {
                            "text": "He carefully removed a sharp <w>spelt</w> of timber that had pierced his leather glove.",
                            "target_lang_translations": {
                                "pl": "Ostrożnie usunął ostrą <w>drzazgę</w> drewna, która przebiła jego skórzaną rękawicę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "drzazga, odłamek lub mały wiór drewna bądź metalu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drzazga",
                                "target_lang_sense_clarification": "cienki odłamek drewna"
                            },
                            {
                                "target_lang_word": "odłamek",
                                "target_lang_sense_clarification": "mały kawałek metalu lub drewna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cce090f6-49fa-3acb-9f5e-9f074e68c34f",
                    "sense_definition": "Zinc, especially in the form of ingots or slabs used for industrial casting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers poured molten <w>spelt</w> into the molds to produce durable machine parts.",
                            "target_lang_translations": {
                                "pl": "Robotnicy wlewali stopiony <w>cynk</w> do form, aby wyprodukować trwałe części maszyn."
                            }
                        },
                        {
                            "text": "Several crates of refined <w>spelt</w> were shipped directly to the metal foundry.",
                            "target_lang_translations": {
                                "pl": "Kilka skrzyń oczyszczonego <w>cynku</w> wysłano bezpośrednio do odlewni metali."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "variant of spelter"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "cynk, zwłaszcza w postaci sztab lub bloków używanych w odlewnictwie przemysłowym"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cynk",
                                "target_lang_sense_clarification": "surowy cynk odlewniczy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b7c5cdc-996f-3744-a22c-b7e5e7e99164",
