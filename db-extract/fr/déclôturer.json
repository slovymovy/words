                "senses": [
                    {
                        "sense_id": "6f8914cf-db3f-3d05-a67a-03d8c582e15f",
                        "entry_id": "d7333d42-337a-334e-9c46-3380795d5a5d",
                        "glosses": [
                            "Supprimer ce qui clôture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7c3502-f42c-474b-ae38-7b333b5c8fb4",
                                "sense_id": "6f8914cf-db3f-3d05-a67a-03d8c582e15f",
                                "text": "Puis il le poussa vers le terrain vague, déclôturé au premier froid, en effet, la palissade avait disparu en une nuit, aspirée par mille foyers sans charbon."
                            },
                            {
                                "example_id": "1c7fe963-33eb-4520-8009-0cd7c3743e1d",
                                "sense_id": "6f8914cf-db3f-3d05-a67a-03d8c582e15f",
                                "text": "Il n'y a pas d'ouverture d'un espace de parole sans le geste qui y mène et qui continue à le soutenir, à le déclôturer."
                            },
                            {
                                "example_id": "b89b0124-011c-451b-9419-26fb7d75f036",
                                "sense_id": "6f8914cf-db3f-3d05-a67a-03d8c582e15f",
                                "text": "Permettent-ils de déclôturer ce qui se présente comme un clivage essentiel entre la parole du savoir institué et la parole personnelle ?"
                            }
                        ]
                    }
