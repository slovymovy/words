                "translations": [
                    {
                        "translation_id": "b2adb4e7-d635-4aa7-8f26-d9c63f7baf35",
                        "source_entry_id": "f0869eba-0a11-3a4f-9d17-239a38f05cce",
                        "source_sense_id": "382954e5-2c40-3aa0-b88b-04be07a91275",
                        "source_sense_description": "Handel: meist internationaler Drogenhandel, Rauschgifthandel",
                        "target_lang_word": "Drogenhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drogenhandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                        "entry_id": "6bc4c69f-901a-3465-a2fd-55b025c3a115",
                                        "glosses": [
                                            "der illegale Kauf und Verkauf von Betäubungsmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe31e84-002d-4fc7-b795-935ec0dd0fd6",
                                                "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                                "text": "Drei Männer wurden wegen Verdachts auf Drogenhandel festgenommen."
                                            },
                                            {
                                                "example_id": "588dfc1b-8bc3-4c94-b964-69aa947b3b89",
                                                "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                                "text": "„Dann wieder tauchen Zeltsiedlungen auf, Endstation der Gestrandeten des Drogenhandels aus Nord und Süd, vereint im binationalen Elend.“"
                                            },
                                            {
                                                "example_id": "aabe7bf1-71de-4091-aed4-2a7ad87ca00b",
                                                "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                                "text": "„Lange Zeit hatte Mali als demokratischer Vorzeigestaat gegolten, niemandem fiel auf, dass die frühere Regierung den Drogenhandel im Norden nicht nur tolerierte, sondern kräftig von ihm profitierte.“"
                                            },
                                            {
                                                "example_id": "1f34dd9f-e3da-4cb1-a491-052048920194",
                                                "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                                "text": "„Die Bordelle wurden über Nacht geschlossen und aller Drogenhandel verboten.“"
                                            },
                                            {
                                                "example_id": "7433357e-9865-4e69-950a-eac503b5d3f0",
                                                "sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                                                "text": "„Zum Glück hatte keiner entdeckt, dass hinter dieser Fassade durch Lorenzo und seinen Onkel Drogenhandel betrieben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d624c19a-9da4-4729-af37-b8feebbe58ca",
                        "source_entry_id": "f0869eba-0a11-3a4f-9d17-239a38f05cce",
                        "source_sense_id": "382954e5-2c40-3aa0-b88b-04be07a91275",
