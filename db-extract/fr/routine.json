                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3686e1c-517c-3d9d-a76e-a23affccf670",
                                        "entry_id": "1193caac-3758-32f3-867d-585c5681cfa5",
                                        "glosses": [
                                            "Regular; habitual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec0a1611-fc82-4a9a-8a3d-3ae927ec12b1",
                                                "sense_id": "a3686e1c-517c-3d9d-a76e-a23affccf670",
                                                "text": "Pepper's forgiven me in the quiet, hurt way women sometimes forgive. She doesn't cry. She doesn't smile either. She's being routine."
                                            },
                                            {
                                                "example_id": "c38da90d-98c8-48dd-97cc-0adb7b1b487b",
                                                "sense_id": "a3686e1c-517c-3d9d-a76e-a23affccf670",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine.[…]One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished. Modern society may not have done anything about war. But peace is a lot more peaceful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c24f5d5-fce4-32f2-bcf3-4c84012583b3",
                                        "entry_id": "1193caac-3758-32f3-867d-585c5681cfa5",
                                        "glosses": [
                                            "Ordinary with nothing to distinguish it from all the others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d616f011-d272-4933-93a1-202342368248",
                                                "sense_id": "7c24f5d5-fce4-32f2-bcf3-4c84012583b3",
                                                "text": "Stoke put themselves in a fine position to qualify for the Europa League knockout stage with a routine victory over Maccabi Tel-Aviv in Israel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
