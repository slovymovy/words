                                        "sense_id": "99094bc4-1004-3ffa-8912-b13ae174bf6f",
                                        "entry_id": "a34b4a2a-7fcd-3da5-8c8c-7d914cd6d8c8",
                                        "glosses": [
                                            "Une des espèces de petits poissons de mer au corps élancé, mince, à mâchoire supérieure proéminente, que l’on mange ordinairement en hors-d’œuvre, normalement de la famille des engraulidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b24b743-f715-4b7b-bcdb-24c5949b797b",
                                                "sense_id": "99094bc4-1004-3ffa-8912-b13ae174bf6f",
                                                "text": "Une salade d’anchois."
                                            },
                                            {
                                                "example_id": "bb0cfa3f-1e4e-4a5a-b099-c4fea91946e7",
                                                "sense_id": "99094bc4-1004-3ffa-8912-b13ae174bf6f",
                                                "text": "Prenez un anchois de Drontheim, rien n'est plus propre à ouvrir et préparer le tube digestif, organe des plus importants…"
                                            },
                                            {
                                                "example_id": "6641f286-1841-4486-919f-a84db2e23656",
                                                "sense_id": "99094bc4-1004-3ffa-8912-b13ae174bf6f",
                                                "text": "Hé les mecs ! je mangerais bien une bonne pizza tout-habillée, moi ! Pas d'anchois, j'horreur de ça."
                                            },
                                            {
                                                "example_id": "562e162a-25fe-4f80-9abe-109c4ab91486",
                                                "sense_id": "99094bc4-1004-3ffa-8912-b13ae174bf6f",
                                                "text": "Pour frayer, les anchois remontent les rivières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
