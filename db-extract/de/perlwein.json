                "senses": [
                    {
                        "sense_id": "0ad617ec-73c1-347d-9ca5-b8ac7ed458a9",
                        "entry_id": "d34c63ea-ce04-3e10-8e6f-6144ed497bab",
                        "glosses": [
                            "Wein, der bei 2 °C einen Kohlensäuredruck von 1,0 bis 2,5 Atmosphären aufweist und deutlich perlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a7194e-2af7-42a1-8390-79a6a8d18e7d",
                                "sense_id": "0ad617ec-73c1-347d-9ca5-b8ac7ed458a9",
                                "text": "„Perlwein unterliegt in Deutschland nicht der Sektsteuer. Perlwein darf in seiner Ausstattung nicht mit Sekt verwechselbar sein.“"
                            },
                            {
                                "example_id": "e20d6754-757a-4800-a576-fd245c7d6b20",
                                "sense_id": "0ad617ec-73c1-347d-9ca5-b8ac7ed458a9",
                                "text": "„Perlweine sind weder Stillweine noch Schaumweine, sondern bilden eine Sondergruppe von Getränken, die wie Stillwein dem Weingesetz unterliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
