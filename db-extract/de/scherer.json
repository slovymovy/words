                ],
                "senses": [
                    {
                        "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                        "entry_id": "dcec10b7-9717-36ff-933c-9521fec111fd",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5daf7e-58f0-4d8e-a97f-78b15479e048",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Frau Scherer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "742912d8-35f4-4281-8195-4c0a91a93ed8",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Herr Scherer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f9eca025-c657-4b0c-afe1-572ca1cd2ca2",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Die Scherers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4f9d5e64-b21b-4e2a-8d2e-1ff1af0e8396",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Der Scherer trägt nie die Schals, die die Scherer ihm strickt."
                            },
                            {
                                "example_id": "7e2a0a83-3e58-42aa-9569-4e405dc0b31d",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scherer kommt, geht der Herr Scherer.“"
                            },
                            {
                                "example_id": "1080da9e-ed5e-41c4-99eb-c328d666dfd2",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Scherer kommt und geht."
                            },
                            {
                                "example_id": "ab6af371-9a9e-4fc6-882f-e3ff3b840d64",
                                "sense_id": "edefa30a-125e-35c6-aa15-09d8131cec24",
                                "text": "Scherers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
