                "senses": [
                    {
                        "sense_id": "0bfc4410-2b36-3ca7-8f27-c4f4e36faa5b",
                        "entry_id": "bd7a133f-5ac3-3084-9261-c9a84d7f2cf8",
                        "glosses": [
                            "Mitglied einer Gruppe von drei nordamerikanischen Indianerstämmen der Algonkin am Saskatchewan und in Montana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce543316-d4c1-453e-81e8-19c649df8dd3",
                                "sense_id": "0bfc4410-2b36-3ca7-8f27-c4f4e36faa5b",
                                "text": "„Die Teerpappendächer schwitzen, der Asphalt brodelt, auf den Trümmerbergen wuchern Weidenröschen und Gelber Heinrich. Schorsch und seine indianischen Blutsbrüder, die sich Schwarzfüße nennen, schwören ewige Freundschaft, wünschen den Banditen von der Ulmenhofbande den Teufel an den Hals. Die Schwarzfüße sind schnell und gewitzt: überfallen Brotautos, durchkämmen die Ruinen und Trümmerviertel nach Tauschwaren, organisieren und wittern, wo es Geschäfte zu machen gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
