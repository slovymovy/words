                        "sense_id": "3e2a1c73-b39e-331e-b7f2-029b95cd0b34",
                        "entry_id": "632d62db-252c-387d-ae21-13cd39e203b6",
                        "glosses": [
                            "Se reprocher à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd374f64-63f6-4461-8abd-c94f5754f0ea",
                                "sense_id": "3e2a1c73-b39e-331e-b7f2-029b95cd0b34",
                                "text": "On a tout les deux des choses à s'auto-reprocher."
                            },
                            {
                                "example_id": "11ce6922-80f8-4d3a-8f05-ad9bc5c4f751",
                                "sense_id": "3e2a1c73-b39e-331e-b7f2-029b95cd0b34",
                                "text": "Par-dessus tout, il souhaitait chasser du discours de la jeune elfe l'idée qu'elle avait de s'auto-reprocher ses appétits, d'homme et de vampire."
                            },
                            {
                                "example_id": "3748f8bd-a4ea-463f-a7d4-fa9d08e80068",
                                "sense_id": "3e2a1c73-b39e-331e-b7f2-029b95cd0b34",
                                "text": "Et il est assez rare de s'auto-reprocher une blessure."
                            }
                        ]
                    }
