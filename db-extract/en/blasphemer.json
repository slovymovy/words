                                        "entry_id": "5b31d494-5936-3b33-a4e6-6f3d361d0c67",
                                        "glosses": [
                                            "Celle qui blasphème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301a7c45-96e9-4939-b4b0-f4bd4b8162e6",
                                                "sense_id": "5c814692-66b4-31b7-93a5-3c2ecf379c5a",
                                                "text": "Il la considéra comme si elle était une blasphématrice qui interrompt le service chrétien, l’apocalypse brûlant derrière ses yeux."
                                            },
                                            {
                                                "example_id": "48ac486a-ee52-491e-a866-089971635739",
                                                "sense_id": "5c814692-66b4-31b7-93a5-3c2ecf379c5a",
                                                "text": "La blasphématrice persiste, signe et en rajoute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blasphématrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91e37ffa-e94b-3cdb-947e-e6a9cdcaec2a",
                                        "entry_id": "7ef772d5-d44a-390e-90ae-6a921b46ea35",
                                        "glosses": [
                                            "Féminin singulier de blasphémateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e304806-4e60-4880-a190-4e1510a68a47",
                                                "sense_id": "91e37ffa-e94b-3cdb-947e-e6a9cdcaec2a",
                                                "text": "Cette femme est blasphématrice et contemptrice de Dieu, dans ses sacrements ; prévaricatrice de loi divine, de la sainte doctrine et des ordonnances ecclésiastiques"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
