                        "glosses": [
                            "variante rare de apéritiver (boire l’apéritif)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af04f2f0-bcd8-46c5-b74c-49b91a6e52f5",
                                "sense_id": "09f25438-cd29-3b7b-8895-74794ff75ff0",
                                "text": "Le temps n’est pas fameux nous \"apéritiferons\" donc dans la véranda."
                            },
                            {
                                "example_id": "0dad969a-1036-4960-86ab-28061d28285c",
                                "sense_id": "09f25438-cd29-3b7b-8895-74794ff75ff0",
                                "text": "Il arbore un agréable grand balcon qui vous permettra de déjeuner, « apéritifer » et diner agréablement avec pour toute vue la campagne, les chevaux et la forêt."
                            },
                            {
                                "example_id": "9a70e260-de8f-4afc-824c-764e54e1ac57",
                                "sense_id": "09f25438-cd29-3b7b-8895-74794ff75ff0",
                                "text": "4 semaines pour profiter, rêvasser le matin, se prélasser l’après midi, apéritifer le soir, barbequiouter le midi......"
                            },
                            {
                                "example_id": "f572478e-9b78-4176-9c8e-966b790e4d8c",
                                "sense_id": "09f25438-cd29-3b7b-8895-74794ff75ff0",
                                "text": "J’apéritife, tu apéritifes, il apéritife, nous apéritifons, ..."
                            },
                            {
                                "example_id": "fe0e1d5d-7a08-4d1c-ac7f-b89c0de6fb73",
                                "sense_id": "09f25438-cd29-3b7b-8895-74794ff75ff0",
                                "text": "Après avoir pédalé, ramé, frappé, récité, mangé, apéritifé, somnolé, zouké, gerbé, creusé, apéritifé, apéritifé, nous nous sommes couchés enchantés."
                            }
                        ]
