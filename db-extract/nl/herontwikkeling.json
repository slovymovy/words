                        "examples": [
                            {
                                "example_id": "f0ab0928-aa13-4703-b993-85c5086b1a6b",
                                "sense_id": "a98fbb2b-3337-3f31-9c71-97a8551a65ac",
                                "text": "Heijmans zegt scherp te letten op de kosten en op kansen. De bouwer gaat voor de gemeente Den Bosch een grote parkeergarage bouwen en verwierf de opdracht voor herontwikkeling, nieuwbouw en onderhoud van het nieuwe stadskantoor van de gemeente Rotterdam."
                            },
                            {
                                "example_id": "051d6a7c-ca9c-46b3-82d5-70c72032c6f7",
                                "sense_id": "a98fbb2b-3337-3f31-9c71-97a8551a65ac",
                                "text": "Volgens PropertyNL-directeur Wabe van Enk zijn de banken voluit op de rem gaan staan. Door de crisis kunnen ze al moeilijker geld vrijmaken voor MKB-leningen, laat staan de hoge bedragen die nodig zijn voor grote bouwprojecten. Het gevolg is dat er nauwelijks voldoende geld is voor het gewone onderhoud en de herontwikkeling van bijvoorbeeld lege kantoorgebouwen. Nederlands vastgoed verloedert daardoor, zegt Van Enk."
                            }
                        ]
                    }
