{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc437e0c-1807-3acd-ae28-23fc3f9bd378",
                    "sense_definition": "A personal computer designed to be used on a desk, usually consisting of a separate screen, keyboard, and system unit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computer_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer using a <w>desktop</w> for work because the screen is larger.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю использовать <w>настольный компьютер</w> для работы, потому что у него больше экран.",
                                "zh": "我工作时更喜欢用<w>台式机</w>，因为屏幕更大。"
                            }
                        },
                        {
                            "text": "Laptops are portable, but a <w>desktop</w> is often more powerful for the same price.",
                            "target_lang_translations": {
                                "ru": "Ноутбуки портативны, но <w>стационарный компьютер</w> часто мощнее за ту же цену.",
                                "zh": "笔记本电脑便于携带，但同等价位的<w>台式机</w>通常性能更强。"
                            }
                        }
                    ],
                    "synonyms": [
                        "PC",
                        "desktop computer"
                    ],
                    "antonyms": [
                        "laptop",
                        "notebook"
                    ],
                    "common_phrases": [
                        "gaming desktop",
                        "desktop PC"
                    ],
                    "target_lang_definitions": {
                        "ru": "Персональный компьютер, предназначенный для использования на столе, обычно состоящий из отдельного экрана, клавиатуры и системного блока.",
                        "zh": "一种设计用于放在桌面上使用的个人电脑，通常由独立的屏幕、键盘和主机组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настольный компьютер",
                                "target_lang_sense_clarification": "тип компьютера"
                            },
                            {
                                "target_lang_word": "стационарный компьютер",
                                "target_lang_sense_clarification": "непереносной компьютер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "台式机",
                                "target_lang_sense_clarification": "指台式电脑"
                            },
                            {
                                "target_lang_word": "台式电脑",
                                "target_lang_sense_clarification": "指台式电脑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eb45b4b-48f1-37db-a62e-bafd35381478",
                    "sense_definition": "The main display area on a computer screen where icons, windows, and the background wallpaper are arranged.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computer_interface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can save the file directly to your <w>desktop</w> for easy access.",
                            "target_lang_translations": {
                                "ru": "Вы можете сохранить файл прямо на <w>рабочий стол</w> для легкого доступа.",
                                "zh": "你可以把文件直接保存到<w>桌面</w>上，方便随时打开。"
                            }
                        },
                        {
                            "text": "She changed the background image on her <w>desktop</w> to a photo of her dog.",
                            "target_lang_translations": {
                                "ru": "Она сменила фоновое изображение на своем <w>рабочем столе</w> на фотографию своей собаки.",
                                "zh": "她把<w>桌面</w>背景换成了她狗狗的照片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "home screen"
                    ],
                    "common_phrases": [
                        "save to desktop",
                        "desktop icon",
                        "remote desktop",
                        "desktop background"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная область экрана компьютера, где расположены значки, окна и фоновое изображение.",
                        "zh": "电脑屏幕上的主要显示区域，用于排列图标、窗口和背景壁纸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочий стол",
                                "target_lang_sense_clarification": "интерфейс компьютера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桌面",
                                "target_lang_sense_clarification": "电脑操作系统界面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "450c24a3-693b-3550-8fad-b17cb71c10db",
                    "sense_definition": "The flat top surface of a desk where work is done.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "furniture_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped the coffee spill off the <w>desktop</w> with a cloth.",
                            "target_lang_translations": {
                                "ru": "Он вытер пролитый кофе со <w>столешницы</w> тряпкой.",
                                "zh": "他用抹布擦掉了<w>桌面</w>上洒出的咖啡。"
                            }
                        },
                        {
                            "text": "The <w>desktop</w> was cluttered with piles of old papers and books.",
                            "target_lang_translations": {
                                "ru": "<w>Столешница</w> была завалена кипами старых бумаг и книг.",
                                "zh": "<w>桌面</w>上堆满了旧报纸和书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "work surface"
                    ],
                    "common_phrases": [
                        "cluttered desktop",
                        "clear the desktop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская верхняя поверхность стола, на которой выполняется работа.",
                        "zh": "桌子上方用于工作的平坦表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столешница",
                                "target_lang_sense_clarification": "поверхность мебели"
                            },
                            {
                                "target_lang_word": "рабочая поверхность",
                                "target_lang_sense_clarification": "часть стола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桌面",
                                "target_lang_sense_clarification": "家具表面"
                            },
                            {
                                "target_lang_word": "台面",
                                "target_lang_sense_clarification": "家具表面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8e1e1b8-edc1-3cf1-9e41-3975300397b3",
                    "sense_definition": "Relating to software, websites, or applications designed for a personal computer rather than a mobile device.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computer_software_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>desktop</w> version of the website offers more features than the mobile app.",
                            "target_lang_translations": {
                                "ru": "<w>Настольная</w> версия сайта предлагает больше функций, чем мобильное приложение.",
                                "zh": "该网站的<w>桌面版</w>比手机应用提供更多功能。"
                            }
                        },
                        {
                            "text": "This is a <w>desktop</w> application, so it will not run on your tablet.",
                            "target_lang_translations": {
                                "ru": "Это <w>настольное</w> приложение, поэтому оно не будет работать на вашем планшете.",
                                "zh": "这是一个<w>桌面版</w>应用程序，所以无法在你的平板电脑上运行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "PC-based",
                        "computer-based"
                    ],
                    "antonyms": [
                        "mobile"
                    ],
                    "common_phrases": [
                        "desktop version",
                        "desktop app",
                        "desktop browser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к программному обеспечению или веб-сайтам, разработанным для персонального компьютера, а не для мобильного устройства.",
                        "zh": "指专为个人电脑而非移动设备设计的软件、网站或应用程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настольный",
                                "target_lang_sense_clarification": "о версии ПО или сайта"
                            },
                            {
                                "target_lang_word": "десктопный",
                                "target_lang_sense_clarification": "компьютерный (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桌面版",
                                "target_lang_sense_clarification": "指软件或网站的版本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee84ff1-6778-3796-9d18-733c372166a4",
                    "sense_definition": "Designed to be placed or used on a desk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a small <w>desktop</w> fan to keep cool while working.",
                            "target_lang_translations": {
                                "ru": "Она купила маленький <w>настольный</w> вентилятор, чтобы охлаждаться во время работы.",
                                "zh": "她买了一个小型的<w>台式</w>风扇，以便工作时保持凉爽。"
                            }
                        },
                        {
                            "text": "The office supplied a <w>desktop</w> organizer for all his pens and clips.",
                            "target_lang_translations": {
                                "ru": "Офис предоставил <w>настольный</w> органайзер для всех его ручек и скрепок.",
                                "zh": "办公室为他提供了一个<w>台式</w>收纳盒，用来放他的笔和回形针。"
                            }
                        }
                    ],
                    "antonyms": [
                        "portable",
                        "handheld"
                    ],
                    "common_phrases": [
                        "desktop publishing",
                        "desktop organizer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для размещения или использования на столе.",
                        "zh": "设计用于放在桌面上放置或使用的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настольный",
                                "target_lang_sense_clarification": "стоящий на столе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "台式",
                                "target_lang_sense_clarification": "形容词，指放在桌上的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}