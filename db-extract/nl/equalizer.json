                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A weapon, usually a blackjack or gun."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
