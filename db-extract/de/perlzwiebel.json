                    {
                        "sense_id": "e3682a83-d603-32e3-a12b-0b3a3de7f971",
                        "entry_id": "0980bf45-d5d1-322a-9253-a7d208c36250",
                        "glosses": [
                            "Zwiebelsorte aus der Familie der Lauchgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ed46f9-79db-457c-a325-aa5399517f1b",
                                "sense_id": "e3682a83-d603-32e3-a12b-0b3a3de7f971",
                                "text": "„So wie Simms es Rant erzählt hat, hat er, als er diese Hattie küsste, den Hackbraten mit Zwiebeln und Sauce geschmeckt, den sie in der Schulkantine zu Mittag gegessen hatte. Und ihr Abendessen vom Tag zuvor: gebratene Kalbsleber. Ihr Abendessen drei Tage zuvor: Rinderbraten im Teigmantel mit Perlzwiebeln in Sahne und Orangenpudding.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
