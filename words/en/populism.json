{
    "word_family": [
        "populist",
        "populistic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "528a995e-2feb-356c-bc43-fd1700997f34",
                    "sense_definition": "A political approach or ideology that represents the interests of ordinary people against an established, privileged elite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rise of <w>populism</w> has reshaped modern politics across many democratic nations."
                        },
                        {
                            "text": "Critics argue that his brand of <w>populism</w> divides society into ordinary citizens and corrupt elites."
                        }
                    ],
                    "antonyms": [
                        "elitism"
                    ],
                    "common_phrases": [
                        "rise of populism",
                        "right-wing populism",
                        "left-wing populism"
                    ]
                },
                {
                    "sense_id": "2fa2eb13-6aed-39fc-8925-2e5588d4c8ff",
                    "sense_definition": "The political strategy or practice of appealing directly to the concerns and emotions of ordinary citizens.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate was often accused of resorting to crude <w>populism</w> just to win votes."
                        },
                        {
                            "text": "Instead of proposing realistic solutions, the campaign relied heavily on cheap <w>populism</w>."
                        }
                    ],
                    "common_phrases": [
                        "crude populism",
                        "cheap populism"
                    ]
                }
            ]
        }
    ]
