                                        "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                        "entry_id": "29ee53e7-a1a0-3595-bc69-4e35b51eeded",
                                        "glosses": [
                                            "Person, die gerade Geburtstag hat"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cda3302-9995-4408-aa1a-92824ee8df94",
                                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                                "text": "Geburtstagskinder vom ersten Dezember werden eine folgenreiche Bekanntschaft machen."
                                            },
                                            {
                                                "example_id": "7ee764f2-6edf-40d1-8cc4-0e587c5f8b61",
                                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                                "text": "„Da Thomas vom Flügel aus das Geburtstagskind im Blick hatte, sah er, wie Meixners Gesicht sich während des Liedes leicht verfärbte, wobei Swetlana ihn ansah und sich deutlich an ihn lehnte.“"
                                            },
                                            {
                                                "example_id": "beeab7b6-794b-4204-a30e-2661b368fa6a",
                                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                                "text": "„Sie beschlossen den Abend in einem Frührestaurant, wo die beiden schwulen Freunde Jürgen und Peter abhanden kamen, statt dessen stellte sich ein Herr als Geburtstagskind vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ed709f0-6eb5-46f9-a968-64d0db809687",
                        "source_entry_id": "c106a1d2-6b91-30b6-89ef-53acf22dc304",
