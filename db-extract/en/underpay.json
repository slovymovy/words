                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75125045-f1ed-405c-b978-efaf4d8f5e61",
                                                "sense_id": "4d67423e-c5a9-3fa2-ab00-81849ada9a35",
                                                "text": "Op de plantages werken illegale arbeiders, die zwaar onderbetaald worden."
                                            },
                                            {
                                                "example_id": "631972e6-eee4-4e6a-93e4-c930fbbe6b16",
                                                "sense_id": "4d67423e-c5a9-3fa2-ab00-81849ada9a35",
                                                "text": "Uit het onderzoek bleek dat maar een klein deel van de bedrijven onderbetaalt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "595a63fa-b4f4-42e9-98bc-0e8c0e1c6546",
                        "source_entry_id": "d579f407-3427-3958-9e8e-9e71817bec98",
                        "source_sense_description": "to pay someone less than the value of their work",
                        "target_lang_word": "sous-payer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-payer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b11bb55d-776d-392c-913b-ee8cc1f7bf4b",
                                        "entry_id": "d0bc8c57-265d-3f71-b36f-04ffac2c2683",
                                        "glosses": [
                                            "Débourser pour une chose, moins que son prix normal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "927eaf2c-d636-3980-ab7c-63e059b80f50",
                                        "entry_id": "d0bc8c57-265d-3f71-b36f-04ffac2c2683",
                                        "glosses": [
                                            "Rémunérer quelqu’un moins que la valeur de son œuvre ou de son travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8dc0625-d346-4cc1-98a8-19863811643f",
                                                "sense_id": "927eaf2c-d636-3980-ab7c-63e059b80f50",
                                                "text": "Une nation qui ignore, méprise et sous-paye ses infirmières, ses policiers, ses chercheurs et ses enseignants est une nation en danger."
                                            },
                                            {
                                                "example_id": "ba508a68-d442-4110-a8ef-83b3f33e6a3d",
                                                "sense_id": "927eaf2c-d636-3980-ab7c-63e059b80f50",
                                                "text": "Moi, j’avais un casier universitaire vierge et une belle absence d’antécédent dans le domaine du travail : on avait donc le droit de me sous-payer."
                                            },
                                            {
                                                "example_id": "7ec63ca6-c772-4793-98cd-86cce90b8eb7",
                                                "sense_id": "927eaf2c-d636-3980-ab7c-63e059b80f50",
                                                "text": "Dans les aéroports, face aux énormes files d’attente de passagers à gérer, les employeurs commencent lentement à comprendre qu’ils ne peuvent pas s’en sortir en sous-payant ces travailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4a4de7-6f6a-4b42-888f-ed8a95e2e2a4",
                        "source_entry_id": "d579f407-3427-3958-9e8e-9e71817bec98",
