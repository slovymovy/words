        "de-extract.jsonl": [
            {
                "entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                "word": "dannen",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                        "entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                        "glosses": [
                            "daher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43b4266-be63-484f-92d3-f543c07958df",
                                "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                                "text": "„Und missest du nach Spannen",
                                "translation": "Ins Meer der Ewigkeit.“"
                            },
                            {
                                "example_id": "77578cb8-3eb7-486d-98b6-c80288670449",
                                "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                                "text": "„Da der König dannen kam, verwarfen sie ihm seine Münze zu Laster, und er fuhr wieder dar und bezwang sie dazu, daß sie von altem Leder Pfenning nehmen und geben müßten.“"
                            },
                            {
                                "example_id": "56f35deb-3805-4d4c-9819-11e8e45072aa",
                                "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                                "text": "„Da nicht sobald mein Hoffen zu erreichen,",
                                "translation": "Schneller, als im Galoppflug zu entweichen.“"
                            },
                            {
                                "example_id": "28e87375-3061-499e-955d-9eb68a3990ad",
                                "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                                "text": "„Reißender Strom, der du aus Alpenquelle",
                                "translation": "Dich treibt Natur, mich Lieb' an gleiche Stelle.“"
                            },
                            {
                                "example_id": "e97013aa-1676-4da4-8fa3-23f3242df022",
                                "sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                                "text": "„Da ritt er dannen auf dunkelm Pfade",
                                "translation": "Durch feuchtes Gebirg bis vor die Halle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bede6148-7406-301c-8085-4d6f18e956a5",
                        "entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                        "glosses": [
                            "daher, deshalb"
                        ],
                        "tags": [
                            "begründend (kausal)"
                        ],
                        "examples": [
                            {
                                "example_id": "6ed8a5b4-ab23-4c5b-b726-be046917c1ca",
                                "sense_id": "bede6148-7406-301c-8085-4d6f18e956a5",
                                "text": "„Dannen sey er auff Nornberg nach Sachsen geführet, gen Königslautern, zwischen Helmstadt und Brunschwig gelegen, (daselbst er ihm im Closter, welches er gestiffter und gebawet, sein Begrebnis erwehlet) auff den sechsten Decembris gebracht, und darnach auff Sanct Sylvesters Tag, im beysein aller Sächsischen Fürsten und Herren, ehrlich und herrlich zu erden gebestattet worden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4e2ea05c-0c08-3231-ada9-1dce3fe84ec7",
                        "entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                        "glosses": [
                            "da, dort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2853848-4595-49cc-b098-25683ba6e515",
                                "sense_id": "4e2ea05c-0c08-3231-ada9-1dce3fe84ec7",
                                "text": "„Alle Flüsse gehn ins Meer;",
                                "translation": "Alle kummen dannen her.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5445ca62-ee28-4005-afda-08f48659d7b4",
                        "source_entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                        "source_sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
                        "source_sense_description": "daher",
                        "target_lang_word": "thence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                        "entry_id": "90d1b224-8f4b-36c8-a552-bc4d295768c7",
                                        "glosses": [
                                            "From there, from that place or from that time."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86892461-fe57-4b03-bf89-045b02e73929",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "I came thence."
                                            },
                                            {
                                                "example_id": "332c8ebd-863e-454d-aaea-d2ec7e08e92f",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "Cross fix at 6000 feet, thence descend to 3000 feet and fly direct to MAP (missed approach point)."
                                            },
                                            {
                                                "example_id": "8e5beaa7-07f2-483b-8faf-6717ee776a29",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "And from thence he went agaynſt yͤ inhabiters of Debir (but Debir was called Kiriath Sepher afoꝛetyme.)"
                                            },
                                            {
                                                "example_id": "cdc9766a-7329-4ce1-a72c-213e87b36e9a",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "Miranda: O the heauens, / What fowle play had we, that we came from thence? / Or bleſſed was't we did?\nProspero: Both, both my Girle. / By fowle-play (as thou ſayſt) were we heau'd thence, / But bleſſedly holpe hither."
                                            },
                                            {
                                                "example_id": "924be996-1768-4836-8df0-c648f4cb4f53",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "My flight was going to Wu-han and Nan-ning and thence to Hanoi, which caused a certain interest; it is not every day that British passports go to North Vietnam. My immigration official was suitably inscrutable; he took the thing as no great drama (which it certainly was to me), rather did he appear to regard the trip as a quaint eccentricity."
                                            },
                                            {
                                                "example_id": "0108ec6f-baf0-4792-8b3c-f3069a2c8138",
                                                "sense_id": "d234e35a-f782-3ae5-97b2-0b2573eb28ff",
                                                "text": "From this we can find the characteristic roots b#95;1 and b#95;2 and thence proceed to the remaining steps of the solution process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac78f9f-acc3-3d5e-ae2a-7d89823d4583",
                                        "entry_id": "90d1b224-8f4b-36c8-a552-bc4d295768c7",
                                        "glosses": [
                                            "Deriving from this fact or circumstance; therefore, therefrom."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ced20357-36dd-4c89-8ca6-1fb2d39863f5",
                                                "sense_id": "7ac78f9f-acc3-3d5e-ae2a-7d89823d4583",
                                                "text": "I had a really bad car accident, and thence came all my backpains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d314e47a-2624-31e6-a595-dadaee8fc78f",
                                        "entry_id": "90d1b224-8f4b-36c8-a552-bc4d295768c7",
                                        "glosses": [
                                            "From that time; thenceforth; thereafter"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2383125-57ae-456f-bdb3-58576fc1b152",
                        "source_entry_id": "b6a30764-667c-3a18-9fe3-a4b6f594ea86",
                        "source_sense_id": "7f0a84ce-7896-395a-a9e1-2b89e9ba7ca9",
