                ],
                "senses": [
                    {
                        "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                        "entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                        "glosses": [
                            "waaraan niet te ontsnappen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d45250-e847-4374-bac7-0f38a9e9c16b",
                                "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                                "text": "Het is onvermijdelijk dat er bezuinigd moet worden in zorg."
                            },
                            {
                                "example_id": "b0a7bc1e-bb29-4bd2-81cb-faa7f66a884c",
                                "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                                "text": "Rond de in stijl overbeladen kersttafel in het appartement van oudoom Sverre ging het gesprek om te beginnen, dat was bijna onvermijdelijk, over kerst tegenwoordig en vroeger, over hoe de bedienden dapper hadden verdragen dat ze met de kerst moesten werken tegen een geringe vergoeding in de vorm van een niet al te eenvoudig kerstcadeau, een handtas, een zilveren armband, een vergulde broche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09447340-c5c7-44ec-b636-5817a6d062fb",
                        "source_entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                        "source_sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                        "target_lang_word": "unvermeidbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unvermeidbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cbf1280-e790-3827-9820-c4dc35b715ac",
                                        "entry_id": "c455ec9b-889a-38aa-a3b3-d52b2a89e0ac",
                                        "glosses": [
                                            "so, dass man es nicht abwenden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69370629-690b-41a2-8228-73fcbcf427b5",
                                                "sense_id": "9cbf1280-e790-3827-9820-c4dc35b715ac",
                                                "text": "Die Insolvenz der Firma war unvermeidbar."
                                            },
                                            {
                                                "example_id": "3a0c2add-2d37-414e-8d0c-fdb2d6748182",
                                                "sense_id": "9cbf1280-e790-3827-9820-c4dc35b715ac",
                                                "text": "„Die Autoren sind sich der Grenzen und der unvermeidbaren Defizite ihrer Untersuchung bewusst und skizzieren deswegen Forschungsdesiderate, die zukünftige Forschungen anregen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0377e731-c17a-41e6-87cc-42b3ffde5c9d",
                        "source_entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                        "source_sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                        "target_lang_word": "unavoidable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unavoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "491ad3e2-bd72-32a6-89e1-adec6bc1e993",
                                        "entry_id": "7dac441e-bae2-399a-b56a-2213c1fa90f9",
                                        "glosses": [
                                            "Impossible to avoid; bound to happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39545df-4357-4f14-bbd3-f0fffaaefc06",
                                                "sense_id": "491ad3e2-bd72-32a6-89e1-adec6bc1e993",
                                                "text": "an unavoidable urge"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84c78c10-f26b-3ce6-b36c-ff3a4d1d1f0d",
                                        "entry_id": "7dac441e-bae2-399a-b56a-2213c1fa90f9",
                                        "glosses": [
                                            "Not voidable; incapable of being made null or void."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194d0cb5-cbd1-4beb-b463-d9a48030bd9d",
                                                "sense_id": "84c78c10-f26b-3ce6-b36c-ff3a4d1d1f0d",
                                                "text": "A confirmation is allied to a release, being a conveyance of an estate or right in esse whereby a voidable estate is made unavoidable"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unavoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4f9d7a-f6dc-3677-88a0-37873e80b420",
                                        "entry_id": "b65fa26d-05e5-3e44-bd83-6d0287cd1d6a",
                                        "glosses": [
                                            "Something that cannot be avoided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87939fee-d758-4fa1-97c0-e233602258df",
                                                "sense_id": "2c4f9d7a-f6dc-3677-88a0-37873e80b420",
                                                "text": "Forty years before, I had thought this odour one of the necessities of life — one of the unavoidables at least[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75e9ebb5-a1ab-4eeb-b2bf-c5774e665aad",
                        "source_entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                        "source_sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                        "target_lang_word": "inévitable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inévitable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62a20724-e0a1-368d-89cb-cd5316d2ccdc",
                                        "entry_id": "005423a1-b61e-3c30-9921-b3466ecae717",
                                        "glosses": [
                                            "Qu’on ne peut éviter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1248eca-edc2-4e74-8f12-13cc560b6b0a",
                                                "sense_id": "62a20724-e0a1-368d-89cb-cd5316d2ccdc",
                                                "text": "[…] car elle se rattache à la grande et inévitable inimitié qui oppose dans toute la France détaillants et coopérateurs."
                                            },
                                            {
                                                "example_id": "c5c9cadb-89f6-40b1-b1c4-95aa8924e016",
                                                "sense_id": "62a20724-e0a1-368d-89cb-cd5316d2ccdc",
                                                "text": "Quant au massacre, c’est inévitable… Rien à y faire. Nous sommes des civilisés, des apprivoisés, tout à coup obligés de s’entretuer…"
                                            },
                                            {
                                                "example_id": "ac28e646-52d9-4d44-8733-afd39e50d3c4",
                                                "sense_id": "62a20724-e0a1-368d-89cb-cd5316d2ccdc",
                                                "text": "La route reliant Bastogne au quartier général du 8ᵉ Corps, par Sibret, fut en effet coupée, au cours de la nuit du mercredi, à la suite des confusions que l’incoordination des ordres rendait presque inévitable : la route resta non gardée pendant la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c987a20a-86b8-3224-9ad1-95084e71b769",
                                        "entry_id": "005423a1-b61e-3c30-9921-b3466ecae717",
                                        "glosses": [
                                            "Que l’on rencontre trop souvent."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa33c03e-c2a5-4338-8d6f-7d72715278f8",
                                                "sense_id": "c987a20a-86b8-3224-9ad1-95084e71b769",
                                                "text": "Alexandre de Gavinard, le grand financier […] rédigeait […] le septième rapport qu’il devait présenter, le jour même, à la septième société de crédit dont il était l’inévitable président."
                                            },
                                            {
                                                "example_id": "ac79856c-c885-4a4c-8c47-bd7c61985369",
                                                "sense_id": "c987a20a-86b8-3224-9ad1-95084e71b769",
                                                "text": "Hervé pâlit, deux heures durant, sur ces problèmes et, n'en trouvant point la solution, il s'en alla diner à son cercle où il tomba sur l’inévitable Pibrac qui ne manqua pas de l’accaparer."
                                            },
                                            {
                                                "example_id": "9134dfb5-6fef-4e66-8ff4-e3f87ccb35f8",
                                                "sense_id": "c987a20a-86b8-3224-9ad1-95084e71b769",
                                                "text": "Sandakan m'apparaissait comme n'importe quel port de ces côtes perdues : quelques bâtiments blancs dans la verdure des palmes et des cocotiers, […], un wharf branlant et l’inévitable vedette poussive de la police."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "039c1733-73b1-4bea-9e50-fb008b481fb8",
                        "source_entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                        "source_sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                        "target_lang_word": "nieunikniony",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nieunikniony",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7609732-68d1-35f1-97b4-df96b0305e3d",
                                        "entry_id": "3d674026-a51f-348d-9d94-80f2494f403c",
                                        "glosses": [
                                            "taki, którego nie da się uniknąć; taki, który musi zajść"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e096f6-65f8-4348-9ca7-f33129878b69",
                                                "sense_id": "c7609732-68d1-35f1-97b4-df96b0305e3d",
                                                "text": "Taneczny beat, podlany sosem frywolnego i skocznego jazzu powoduje, iż wystukiwanie rytmu stopą staje się nieuniknione."
                                            },
                                            {
                                                "example_id": "d580701d-bd0d-4dad-9df4-3066bce43d26",
                                                "sense_id": "c7609732-68d1-35f1-97b4-df96b0305e3d",
                                                "text": "Pierwszy raz w życiu jechała wspaniałym automobilem, toteż, mimo wstrząśnień nieuniknionych na obmurowaniach ścieków bocznej ulicy, miała złudzenie, iż uległa porwaniu do nieba."
                                            }
