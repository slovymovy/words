                "forms": [],
                "senses": [
                    {
                        "sense_id": "316e2592-f31f-364d-808c-500762eab5ec",
                        "entry_id": "0b8604d9-e929-3758-9983-6dc78ff5b90b",
                        "glosses": [
                            "D’une manière catégorique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d36606-72b7-4189-a214-bad60af3524d",
                                "sense_id": "316e2592-f31f-364d-808c-500762eab5ec",
                                "text": "Il a parlé catégoriquement. Répondre catégoriquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90db3081-7ede-484e-9cc0-ae6fde7d3833",
                        "source_entry_id": "0b8604d9-e929-3758-9983-6dc78ff5b90b",
                        "source_sense_id": "316e2592-f31f-364d-808c-500762eab5ec",
                        "target_lang_word": "categorically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "categorically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d94d3ec9-db5b-3563-a764-bd5f60cbdf25",
                                        "entry_id": "7352e15a-c1b1-338a-9dcb-7879c8c999e0",
                                        "glosses": [
                                            "In a categorical manner.",
                                            "By the use of categories; defining a category; defined by, or corollary to, a category."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc17681-26b3-49ce-860f-0050f679e26e",
                                                "sense_id": "d94d3ec9-db5b-3563-a764-bd5f60cbdf25",
                                                "text": "Near-synonyms: (sometimes synonymous) generically, classically, typically"
                                            },
                                            {
                                                "example_id": "c878258a-703a-4e75-ac10-832fcd02d5e0",
                                                "sense_id": "d94d3ec9-db5b-3563-a764-bd5f60cbdf25",
                                                "text": "a welfare scheme for the categorically needy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11520432-a680-33ba-ad3f-036e834462a7",
                                        "entry_id": "7352e15a-c1b1-338a-9dcb-7879c8c999e0",
                                        "glosses": [
                                            "In a categorical manner.",
                                            "Absolutely; in all regards (leaving no doubt or ambiguity)."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60649f4f-9953-49e0-aaf6-6ab854fbf9e7",
                                                "sense_id": "11520432-a680-33ba-ad3f-036e834462a7",
                                                "text": "She categorically denied all allegations of misconduct."
                                            },
                                            {
                                                "example_id": "12ed020e-3181-45c5-8a4a-0f06f8fb1d57",
                                                "sense_id": "11520432-a680-33ba-ad3f-036e834462a7",
                                                "text": "The Foreign and Commonwealth Office (FCO) has categorically ruled out any new negotiations saying the future of the Falklands can only be decided by the islanders themselves in accordance with the UN principle of self-determination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fe116db-223c-40e3-bbb2-bdec8a12fe7e",
                        "source_entry_id": "0b8604d9-e929-3758-9983-6dc78ff5b90b",
                        "source_sense_id": "316e2592-f31f-364d-808c-500762eab5ec",
                        "target_lang_word": "dogmatically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dogmatically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d8c65e2-726c-3ba8-a987-baf0bddab5bd",
                                        "entry_id": "8f400572-798c-33d7-ab90-9d94b46d0a3b",
                                        "glosses": [
                                            "In a dogmatic manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0135369b-ab12-466a-a1b1-d3d6526befe0",
                        "source_entry_id": "0b8604d9-e929-3758-9983-6dc78ff5b90b",
                        "source_sense_id": "316e2592-f31f-364d-808c-500762eab5ec",
                        "target_lang_word": "flatly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf3b2bf-837a-3f28-98b5-e581d57ef78a",
                                        "entry_id": "8dc63e37-b781-3c8f-a3ca-11df3a0f853b",
                                        "glosses": [
                                            "In a physically flat or level manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea22395f-f6c8-498f-8558-c820db912f8b",
                                                "sense_id": "ebf3b2bf-837a-3f28-98b5-e581d57ef78a",
                                                "text": "He bent over the old woman again, with his ear turned flatly to her lips and then to the region of her heart."
                                            },
                                            {
                                                "example_id": "32f5bc91-bba9-40c8-aab2-bb7e18f5735c",
                                                "sense_id": "ebf3b2bf-837a-3f28-98b5-e581d57ef78a",
                                                "text": "Rabbit country, the working man's uncultivable terrain. Half a mile away, square open patches of yellow sand flatly glittered, and far on the horizon cranes and vast silver cylinders stood about, ghostly shining inhabitants of the marsh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fa4c86-287f-39f2-bef4-5fbff8d18d30",
                                        "entry_id": "8dc63e37-b781-3c8f-a3ca-11df3a0f853b",
                                        "glosses": [
                                            "In a definite manner; in a manner showing complete certainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6786e9b4-4a6e-4177-bc7b-c3a8c6076a68",
                                                "sense_id": "77fa4c86-287f-39f2-bef4-5fbff8d18d30",
                                                "text": "It was an accusation that he flatly denied."
                                            },
                                            {
                                                "example_id": "f43c04f5-22b6-4520-a3e8-84482cb8a039",
                                                "sense_id": "77fa4c86-287f-39f2-bef4-5fbff8d18d30",
                                                "text": "In 2017 in Zimbabwe, a military takeover brought Robert Mugabe's 37-year rule to and end. But one of the leaders, Maj Gen Sibusiso Moyo, appeared on television at the time, flatly denying it was a military takeover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd745653-38a2-3123-aeb1-4c4c4d215598",
                                        "entry_id": "8dc63e37-b781-3c8f-a3ca-11df3a0f853b",
                                        "glosses": [
                                            "In a manner that shows no emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b6e74d-4ff5-40ed-865b-23361484e8e3",
                                                "sense_id": "fd745653-38a2-3123-aeb1-4c4c4d215598",
                                                "text": "He replied flatly to the policeman's questions."
                                            },
                                            {
                                                "example_id": "581b28f6-5ffe-404c-b927-296affa6b190",
                                                "sense_id": "fd745653-38a2-3123-aeb1-4c4c4d215598",
                                                "text": "\"Sure you never heard of him?\" he asked incredulously. \"Never,\" I said flatly."
                                            },
                                            {
                                                "example_id": "75e29db3-b719-4447-8504-70c35bbd4b9c",
                                                "sense_id": "fd745653-38a2-3123-aeb1-4c4c4d215598",
                                                "text": "\"It's barbarous, Norsus.\" \"It's Rome,\" said the giant flatly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45a84439-4904-441b-92c4-af06894bea90",
                        "source_entry_id": "0b8604d9-e929-3758-9983-6dc78ff5b90b",
