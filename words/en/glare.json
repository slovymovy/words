                {
                    "sense_id": "ded0a8fc-f554-3a00-a82e-3f4c61e1bf7d",
                    "sense_definition": "To shine brightly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neon signs <w>glare</w> in the dark city streets at night.",
                            "target_lang_translations": {
                                "tr": "Neon tabelalar gece karanlık şehir sokaklarında <w>göz kamaştırıyor</w>.",
                                "nl": "De neonreclames <w>verblinden</w> in de donkere stadsstraten 's nachts.",
                                "de": "Die Neonschilder <w>leuchten grell</w> in den dunklen Straßen der nächtlichen Stadt.",
                                "it": "Le insegne al neon <w>abbagliano</w> nelle buie strade della città di notte."
                            }
                        },
                        {
                            "text": "Bright lights <w>glare</w> down from the ceiling of the stadium.",
                            "target_lang_translations": {
                                "tr": "Parlak ışıklar stadyumun tavanından aşağıya <w>göz kamaştırıcı bir şekilde parlıyor</w>.",
                                "nl": "Felle lichten <w>schijnen verblindend</w> vanaf het plafond van het stadion.",
                                "de": "Helle Scheinwerfer <w>blenden</w> von der Stadiondecke herab.",
                                "it": "Luci accecanti <w>brillano intensamente</w> dal soffitto dello stadio."
                            }
                        }
                    ],
                    "synonyms": [
                        "shine"
                    ],
                    "target_lang_definitions": {
                        "tr": "Parlak bir şekilde ışıldamak.",
                        "nl": "Fel schijnen of licht uitstralen.",
                        "de": "Sehr hell oder blendend leuchten.",
                        "it": "Emettere una luce molto intensa o accecante."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göz kamaştırmak",
                                "target_lang_sense_clarification": "Çok parlak ışık yaymak."
                            },
                            {
                                "target_lang_word": "parlamak",
                                "target_lang_sense_clarification": "Yoğun bir ışık saçmak."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verblinden",
                                "target_lang_sense_clarification": "Zo fel schijnen dat het zicht tijdelijk wordt belemmerd."
                            },
                            {
                                "target_lang_word": "fel schijnen",
                                "target_lang_sense_clarification": "Een zeer helder en intens licht verspreiden."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "blenden",
                                "target_lang_sense_clarification": "So hell scheinen, dass es unangenehm für die Augen ist"
                            },
                            {
                                "target_lang_word": "grell leuchten",
                                "target_lang_sense_clarification": "Sehr intensiv und grell scheinen"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "abbagliare",
                                "target_lang_sense_clarification": "Brillare con tale forza da togliere la vista"
