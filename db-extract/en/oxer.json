                                                "sense_id": "04fe5071-a9d7-327e-8027-f81fe25bfbd0",
                                                "text": "„Ein Oxer, oder Hochweitsprung, besteht aus vier Hindernisständern.“"
                                            },
                                            {
                                                "example_id": "2859eeec-e86f-4e1e-95e2-9751c1b17358",
                                                "sense_id": "04fe5071-a9d7-327e-8027-f81fe25bfbd0",
                                                "text": "„Bei den Prüfungen für Anfänger sind Oxer rund einen knappen Meter breit.“"
                                            },
                                            {
                                                "example_id": "9b67a9bf-63f1-49b6-bd5b-1850f87557d8",
                                                "sense_id": "04fe5071-a9d7-327e-8027-f81fe25bfbd0",
                                                "text": "„Das Photo zeigte eine Gestalt im Reitdress, die auf einem ziemlich plumpen Pferd, typisch finnisch, über einen Oxer setzte.“"
                                            }
