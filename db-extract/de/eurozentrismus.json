                        "cross_references": []
                    },
                    {
                        "translation_id": "7f89da09-672f-4cb8-a789-9bd82e109c59",
                        "source_entry_id": "2ea1a90f-4a0d-3572-9570-b80358d9e0a7",
                        "source_sense_id": "7146cd82-4400-3f56-a6e0-ab8fbcf01f7f",
                        "target_lang_word": "eurocentrisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eurocentrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                        "entry_id": "a8b2ddcf-0a54-352f-bbc3-a0cf596bd69d",
                                        "glosses": [
                                            "Conception ou système de pensée — implicite ou explicite — qui place l’Europe au centre de l’histoire, du savoir ou des normes, en considérant ses normes comme universelles."
                                        ],
                                        "tags": [
                                            "Études postcoloniales",
                                            "Sciences humaines et sociales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5aa5793-032d-48ab-8aa2-749a06eb3b36",
                                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                                "text": "L’eurocentrisme valide le colonialisme et légitime l’orientalisme."
                                            },
                                            {
                                                "example_id": "d29ab509-d4a2-4244-ae17-efdcafbbfd00",
                                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                                "text": "L’eurocentrisme ne permet pas une interprétation idéaliste, mais seulement une interprétation matérialiste."
                                            },
                                            {
                                                "example_id": "af221e18-9e1d-4fdb-a544-0bfb7005fcf8",
                                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                                "text": "La domination même de l’eurocentrisme dans le curriculum des sciences sociales constitue un obstacle majeur à la décolonisation de la connaissance."
                                            },
                                            {
                                                "example_id": "1d03e331-3948-44f5-953c-7f68b64b7412",
                                                "sense_id": "1d66cf0e-800f-3a49-94bd-bd3e37f2fe72",
                                                "text": "Le modèle centre‑périphérie illustre comment l’eurocentrisme structure la production et la diffusion des connaissances en sciences sociales, en segmentant le Nord global comme source légitime de savoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c214b4d-371b-4768-98a0-0eefb7fee2b2",
                        "source_entry_id": "2ea1a90f-4a0d-3572-9570-b80358d9e0a7",
