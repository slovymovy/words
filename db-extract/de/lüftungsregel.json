                ],
                "senses": [
                    {
                        "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                        "entry_id": "cb191112-df52-3e92-ac47-2d4f9c7e3d6d",
                        "glosses": [
                            "Regel, nach der gelüftet werden sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac9df378-9889-4a27-a16c-cb6ea6ae96b5",
                                "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                                "text": "„Mit Lüftungsregeln sind Verhaltensregeln gemeint, die Ihren Ursprung in der Bauphysik haben.“"
                            },
                            {
                                "example_id": "1635e9e3-af80-453f-966b-63ef6f212903",
                                "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                                "text": "„Ist eine ausreichende Lüftung nach „allgemein bekannten Lüftungsregeln“ durch den Nutzer nicht möglich (z. B. aufgrund häufiger Abwesenheit der Bewohner) und wird eine weitere Verbesserung von Wohnkomfort und Wärmeschutz angestrebt, sollte die Installation einer Lüftungsanlage (keine Klimaanlage!) in Erwägung gezogen werden.“"
                            },
                            {
                                "example_id": "e7f3a156-d479-4915-9459-e38a90a6f5d6",
                                "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                                "text": "„Für den Keller gelten andere Lüftungsregeln: Halten Sie im Sommer Kellerfenster und -türen am besten geschlossen, da sonst die warme Luft an den kühlen Kellerwänden kondensiert und die Räume feucht werden.“"
                            },
                            {
                                "example_id": "2154b9a2-f095-44cc-be2a-bb210f65dc3b",
                                "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                                "text": "„Auf der nächsten Seite finden Sie die wichtigsten Lüftungsregeln auf einen Blick.“"
                            },
                            {
                                "example_id": "45d4aa0e-3e38-43a0-9167-b98f1c56f234",
                                "sense_id": "7236da24-29ec-3546-8046-68324a8849b1",
                                "text": "„Diese durch den Hygieneprofessor Max von Pettenkofer (gest. 1901) vor über 100 Jahre entwickelte Lüftungsregel basiert ursprünglich lediglich auf der Notwendigkeit, in Aufenthaltsräumen (insbesondere Schulen und Arbeitsräume) die verbrauchte Atemluft (CO2) aus hygienischer Sicht wieder wegzulüften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
