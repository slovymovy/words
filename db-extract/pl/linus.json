                "translations": [
                    {
                        "translation_id": "50f6bc41-8ad1-4b55-a628-0537197098ec",
                        "source_entry_id": "43e0ef5d-2d46-352a-94fa-b9d44ba08737",
                        "source_sense_id": "924452fc-2155-3443-b710-f931cc0d9193",
                        "target_lang_word": "Linus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44f2f355-c87a-3a34-a5e2-d52f692280ec",
                                        "entry_id": "4d1b467d-cd6c-3b7d-a3c4-8ada366fb9a7",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e13a4ae-8f3c-4005-8976-47c904cc323c",
                                                "sense_id": "44f2f355-c87a-3a34-a5e2-d52f692280ec",
                                                "text": "Do thy diligence to come before winter. Eubulus greeteth thee, and Pudens, and Linus, and Claudia, and all the brethren."
                                            },
                                            {
                                                "example_id": "e107ef73-8168-4751-aa71-a751ccf5a153",
                                                "sense_id": "44f2f355-c87a-3a34-a5e2-d52f692280ec",
                                                "text": "Yes, my children are Peanuts characters. Charlie, seven, and Lucy, five, were given their names without thought or reference to the comic strip. Charlie was named after Bob's grandfather and we both just liked the name Lucy. Then, when I was unexpectedly expecting again, […]\n\"I'd go with Schroeder,\" a work colleague offered. \"No, definitely Linus. Or Woodstock,\" said another. It was only then that I realized the pattern we'd started with our first two kids. And I liked the name Linus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Linus",
