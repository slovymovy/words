                ],
                "senses": [
                    {
                        "sense_id": "60d7ae10-45a3-35de-ac46-ac9cd09871bc",
                        "entry_id": "5e30f92e-5026-3e6b-86ae-d7058971de84",
                        "glosses": [
                            "Gerät, das Luft in eine bestimmte Richtung mit einem höheren Druck als ein Ventilator bläst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e21449a-a31e-4047-949b-303fbf999600",
                                "sense_id": "60d7ae10-45a3-35de-ac46-ac9cd09871bc",
                                "text": "Das Gebläse der Hüpfburg ist leider defekt."
                            },
                            {
                                "example_id": "9aebdaf9-dfab-4678-8d45-c66f649584f5",
                                "sense_id": "60d7ae10-45a3-35de-ac46-ac9cd09871bc",
                                "text": "„Unter herkömmlichem Bodyflying verstehen Sportler das Reiten auf einem vertikalen Luftstrom, der von einem starken Gebläse generiert wird.“"
                            },
                            {
                                "example_id": "eb849baa-1608-45f2-9046-d7782d512890",
                                "sense_id": "60d7ae10-45a3-35de-ac46-ac9cd09871bc",
                                "text": "„Im Verhältnis zur Leistung erzielen Ventilatoren aufgrund des niedrigen Druckverhältnisses hohe Volumenströme, Gebläse wegen des mittleren Druckverhältnisses mittlere Volumenströme.“"
                            },
                            {
                                "example_id": "df3ec496-3882-4fca-a82d-f53518ef5039",
                                "sense_id": "60d7ae10-45a3-35de-ac46-ac9cd09871bc",
                                "text": "„Ein Staubsauger ist ein Reinigungsgerät, das mit einem Gebläse ausgerüstet ist, um einen Unterdruck zu erzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
