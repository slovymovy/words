                    {
                        "sense_id": "19e4ffc7-1158-3ac2-bfdf-0b447279d226",
                        "entry_id": "3d8dee7f-4732-3009-be47-d80165a9e8ed",
                        "glosses": [
                            "Of or pertaining to wedding and marriage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16815022-6308-45e5-babd-1185b02aa256",
                                "sense_id": "19e4ffc7-1158-3ac2-bfdf-0b447279d226",
                                "text": "To prevent the erosion of his own authority, Basil is persuaded to re-enact his father's crime — to unflower the servant girl on her nuptial night."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ed8d2d-8992-3e66-8e2c-4c1c5f8b551c",
                        "entry_id": "3d8dee7f-4732-3009-be47-d80165a9e8ed",
                        "glosses": [
                            "Capable, or characteristic, of breeding."
