                "senses": [
                    {
                        "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                        "entry_id": "b652b054-d284-35dd-bcd1-3e4566e0bb88",
                        "glosses": [
                            "durch das Geruchsorgan wahrgenommene Ausdünstung von Salz in Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bfa5e0-f48e-4b94-b953-731ba7fd1e1e",
                                "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                                "text": "„Salzwassergeruch in der Luft, eine leichte Meeresbrise und aufregende Wellen – einfach perfekt, um das Leben der Surfer kennenzulernen, das besondere Flair zu erleben und die PROs zu beobachten.“"
                            },
                            {
                                "example_id": "2195d0bd-3492-46fc-9a0d-c1a2e7840fff",
                                "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                                "text": "„Der Wind weht dazu, Salzwassergeruch mischt sich mit Dieselabgasodeur.“"
                            },
                            {
                                "example_id": "f5a80161-9144-4fc7-845f-4ab62419a39e",
                                "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                                "text": "Sachte Wellen aus Sand kreuzen immer wieder den Bohlenweg, man sehnt sich förmlich nach dem Salzwassergeruch."
                            },
                            {
                                "example_id": "c77dbf44-e8d4-4190-b30e-de81c1bd866a",
                                "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                                "text": "Er wäre an dem Morgen, so sagte er, nach dem Dock hinuntergehumpelt, um mal wieder Salzwassergeruch in die Nase zu kriegen."
                            },
                            {
                                "example_id": "85389bb1-715e-4c9a-b0e7-657d73bf6f99",
                                "sense_id": "0fe6dcd2-c969-304b-a7ab-d6041ee09646",
                                "text": "Der Wind trug ihm den Salzwassergeruch zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
