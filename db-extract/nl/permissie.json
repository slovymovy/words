                                    {
                                        "sense_id": "32f89133-695f-35ab-848e-b9fbdecd1b9b",
                                        "entry_id": "ecf3d276-0fa8-3cbc-a438-abf54a1237bb",
                                        "glosses": [
                                            "authorisation; consent (especially formal consent from someone in authority)"
                                        ],
