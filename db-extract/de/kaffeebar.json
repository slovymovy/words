                "senses": [
                    {
                        "sense_id": "50e37c9f-04a6-3754-b68e-1543a7b54461",
                        "entry_id": "ec56bf28-e244-3daf-9f0f-57c29c3cdd4f",
                        "glosses": [
                            "einfache Gaststätte, in der vor allem Kaffee und Kuchen (zur Selbstbedienung) angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57516194-27d1-4a41-9e4f-1a5945a081f6",
                                "sense_id": "50e37c9f-04a6-3754-b68e-1543a7b54461",
                                "text": "„Den Umbau zur Kaffeebar hat sie selbst konzipiert und dabei manches Problem gemeistert.“"
                            },
                            {
                                "example_id": "9b9cea9f-264b-495b-b1c9-7c0c4cac6ffc",
                                "sense_id": "50e37c9f-04a6-3754-b68e-1543a7b54461",
                                "text": "„Wir laufen ins Dorf und gönnen uns ein Eis. In der Kaffeebar haben sie eine recht große Auswahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
