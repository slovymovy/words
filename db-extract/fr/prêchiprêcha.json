                "senses": [
                    {
                        "sense_id": "65d64ed6-ae23-37b3-828a-d296faaf628a",
                        "entry_id": "59a3cd56-6ed0-32e9-847c-1a091e632c40",
                        "glosses": [
                            "Sermon moralisateur, ennuyeux et généralement peu efficace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e474bc33-027a-479d-8003-7474cdc17228",
                                "sense_id": "65d64ed6-ae23-37b3-828a-d296faaf628a",
                                "text": "C’est un prêchiprêcha sur la citoyenneté, la prévention des conduites à risques, l’école lieu de vie ; bref, des sornettes lénifiantes."
                            },
                            {
                                "example_id": "f5ed4d7e-d1d8-43ea-8609-e0762b5977fe",
                                "sense_id": "65d64ed6-ae23-37b3-828a-d296faaf628a",
                                "text": "Et c’étaient des recommandations à n’en plus finir, d’adorables prêchi-prêcha sur le respect des propriétés, la politesse qu’on doit aux dames, un vrai code d’honneur militaire à l’usage des conquérants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da5ab56b-7a07-43ea-b718-04bf6840a872",
                        "source_entry_id": "59a3cd56-6ed0-32e9-847c-1a091e632c40",
                        "source_sense_id": "65d64ed6-ae23-37b3-828a-d296faaf628a",
                        "source_sense_description": "discours moralisateur",
                        "target_lang_word": "sermon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To discourse to or of, as in a sermon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3bf762-d23c-4472-8894-7e4066cb51e0",
                                                "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                                "text": "January 23 1583, Edmund Spenser, letter to Walter Raleigh\nTo some I know this methode will seem displeasaunt, which had rather have good discipline delivered plainly in way of precepts, or sermoned at large, as they use, then thus clowdily enwrapped in allegorical devises"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To tutor; to lecture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3368e2-c273-4024-9d00-841f3e850449",
                                                "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                                "text": "Come, sermon me no further."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "Religious discourse; a written or spoken address on a religious or moral matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c313a5-8464-4bac-88f3-6db45f027d69",
                                                "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdec74ea-8b19-36e5-8c06-7e5782a5d89a",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "A lengthy speech of reproval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "410bed00-1406-4508-a0bb-b68fdba1df3b",
                        "source_entry_id": "59a3cd56-6ed0-32e9-847c-1a091e632c40",
                        "source_sense_id": "65d64ed6-ae23-37b3-828a-d296faaf628a",
