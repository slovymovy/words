{
    "word_family": [
        "hapering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b72b3eb1-467b-36d1-962c-7824da91e6ec",
                    "sense_definition": "Niet goed functioneren of tijdelijk stoppen met werken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude computer begon plotseling te <w>haperen</w> tijdens de presentatie.",
                            "target_lang_translations": {
                                "en": "The old computer suddenly started to <w>malfunction</w> during the presentation."
                            }
                        },
                        {
                            "text": "De motor van de auto <w>haperde</w> even, maar liep daarna weer goed.",
                            "target_lang_translations": {
                                "en": "The car's engine <w>stuttered</w> for a moment, but then ran well again."
                            }
                        }
                    ],
                    "synonyms": [
                        "stotteren",
                        "falen"
                    ],
                    "common_phrases": [
                        "motor haperen",
                        "computer haperen"
                    ],
                    "target_lang_definitions": {
                        "en": "To not function properly or to stop working temporarily."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "malfunction",
                                "target_lang_sense_clarification": "To function improperly or fail to work correctly."
                            },
                            {
                                "target_lang_word": "go on the blink",
                                "target_lang_sense_clarification": "Informal term for a device or machine that is not working properly."
                            },
                            {
                                "target_lang_word": "stutter",
                                "target_lang_sense_clarification": "To move or operate with intermittent stops or jerks."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a0d1f53-9ab0-3aac-9adb-522ef976760a",
                    "sense_definition": "Stokken of niet soepel vooruitgaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>haperende</w> economie zorgt voor veel onzekerheid bij ondernemers.",
                            "target_lang_translations": {
                                "en": "The <w>faltering</w> economy is causing a lot of uncertainty for entrepreneurs."
                            }
                        },
                        {
                            "text": "Het gesprek <w>haperde</w> omdat niemand echt wist wat hij moest zeggen.",
                            "target_lang_translations": {
                                "en": "The conversation <w>stalled</w> because no one really knew what to say."
                            }
                        }
                    ],
                    "synonyms": [
                        "stagneren",
                        "stokken"
                    ],
                    "antonyms": [
                        "vlotten"
                    ],
                    "common_phrases": [
                        "gesprek haperen",
                        "haperende economie"
                    ],
                    "target_lang_definitions": {
                        "en": "To stall or fail to progress smoothly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stagnate",
                                "target_lang_sense_clarification": "To stop developing or making progress, often used for economies or processes."
                            },
                            {
                                "target_lang_word": "falter",
                                "target_lang_sense_clarification": "To lose strength or momentum; to become unsteady."
                            },
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "To stop making progress or to come to a standstill."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd5f4975-c30b-38ef-9cf3-90f0e08e458a",
                    "sense_definition": "Defect raken of tekenen van slijtage vertonen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het roer <w>hapert</w> door de jarenlange blootstelling aan zout water.",
                            "target_lang_translations": {
                                "en": "The rudder is <w>deteriorating</w> due to years of exposure to salt water."
                            }
                        },
                        {
                            "text": "Na tachtig jaar begint het menselijk lichaam onvermijdelijk te <w>haperen</w>.",
                            "target_lang_translations": {
                                "en": "After eighty years, the human body inevitably begins to <w>break down</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "defect raken",
                        "slijten"
                    ],
                    "common_phrases": [
                        "lichaam haperen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become defective or show signs of wear and tear."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deteriorate",
                                "target_lang_sense_clarification": "To become progressively worse in condition or quality."
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "To stop working due to wear or mechanical failure."
                            },
                            {
                                "target_lang_word": "wear out",
                                "target_lang_sense_clarification": "To become unusable or ineffective through long or hard use."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}