                "senses": [
                    {
                        "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                        "entry_id": "cf334152-eacf-33e2-81e9-20c2f0ab261d",
                        "glosses": [
                            "jahreszeitlich witterungsbedingtes vorgeschriebenes Langsamfahren von Eisenbahngarnituren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb61e5d-b359-4986-b4c0-707661b06382",
                                "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                                "text": "„Dies hat sich aktuell gezeigt, als die Herbstrestriktionen des Eisenbahn-Bundesamtes dazu führten, dass die S 7 aus Richtung Wolfratshausen in der Hauptverkehrszeit am Hauptbahnhof enden musste.“"
                            },
                            {
                                "example_id": "8716c6c6-af0d-41e8-a36e-e33b5eae7aca",
                                "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                                "text": "„Neben den Herbstrestriktionen sind auf besonders gefährdeten Streckenabschnitten für die betroffenen Fahrzeuge maximal 100 km/h erlaubt.“"
                            },
                            {
                                "example_id": "1116607b-5dda-478b-82e0-42f0e5b36c6f",
                                "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                                "text": "„Der Einbau hat dazu geführt, dass das Eisenbahnbundesamt, als Sicherheitsbehörde der S-Bahn München, die Herbstrestriktionen zum Fahrplanwechsel am 12. Dezember 2010 aufgehoben hat.“"
                            },
                            {
                                "example_id": "f709b18a-a1bc-423b-b895-8d4a05d9a4fb",
                                "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                                "text": "„Damit verfolgt die S-Bahn München ein klares Ziel: Herbstrestriktionen und damit Einschränkungen im S-Bahnangebot mit allen gegebenen Möglichkeiten zu vermeiden.“"
                            },
                            {
                                "example_id": "eb188fc5-12e5-4cc0-a4cb-c1e90c899ad6",
                                "sense_id": "e7f65034-b7c7-3967-a5c6-10e83c0764f0",
                                "text": "„Damit verfolgt die S-Bahn München das Ziel, Herbstrestriktionen und Einschränkungen im S-Bahn-Angebot zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
