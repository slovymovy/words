                "senses": [
                    {
                        "sense_id": "b60bda79-573b-351b-aae0-59be2a9f949b",
                        "entry_id": "00e37f12-baed-368b-b4c9-496cb89311f7",
                        "glosses": [
                            "Qui est propre ou relatif aux Jeux paralympiques."
                        ],
                        "tags": [
                            "Handisport"
                        ],
                        "examples": [
                            {
                                "example_id": "37125366-ef72-45c0-9bd8-d8510c672fcd",
                                "sense_id": "b60bda79-573b-351b-aae0-59be2a9f949b",
                                "text": "Liang avait remporté plusieurs multimarathons en Chine ces dernières années. Huang, qui était sourd-muet, avait remporté le marathon masculin pour les malentendants aux Jeux paralympiques nationaux de 2019 à Tianjin."
                            },
                            {
                                "example_id": "8dd9e263-398b-4f0f-bf9d-2d6446051112",
                                "sense_id": "b60bda79-573b-351b-aae0-59be2a9f949b",
                                "text": "Pour Enzo Giorgi, escrimeur handisport de haut niveau, c’est là tout l’objectif des Jeux paralympiques 2024 : « mettre sur un pied d’égalité tous les athlètes. »"
                            },
                            {
                                "example_id": "33bed8e0-cff2-45e7-89be-fe56365eb566",
                                "sense_id": "b60bda79-573b-351b-aae0-59be2a9f949b",
                                "text": "Une piste de saut en longueur sera installée pour permettre au champion paralympique allemand Markus Rehm de tenter de battre son propre record."
                            }
                        ]
                    }
                ],
