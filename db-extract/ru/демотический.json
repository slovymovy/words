                    },
                    {
                        "translation_id": "3f1c174c-a227-4bed-b352-ff8cb416f988",
                        "source_entry_id": "6c9c7a72-1c47-3273-b0c0-af40f20b87b6",
                        "source_sense_id": "58a40281-4643-3848-a423-a9750e0aa2c1",
                        "target_lang_word": "demotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ed6598-3189-314a-9b11-ffcea9a30804",
                                        "entry_id": "32ac408c-bc0f-3eba-ae7b-3ef37840cd78",
                                        "glosses": [
                                            "dem Denken und Fühlen des Volkes entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae8bdbb-630e-4c43-8239-a833ba4cd2cb",
                                                "sense_id": "c7ed6598-3189-314a-9b11-ffcea9a30804",
                                                "text": "Die Auffindung umfangreicher Tontafeldepots (150 Exemplare des Hieratischen Linear A in Agia Triada und rund 4000 Stück mit demotischem Linear B in Knossos) findet eine gewisse Parallele in Vorderasien und Ägypten."
                                            },
                                            {
                                                "example_id": "2736765c-87dc-4576-8569-516155fc73af",
                                                "sense_id": "c7ed6598-3189-314a-9b11-ffcea9a30804",
                                                "text": "Wir wissen von zahlreichen Grabungen, daß diese Urgriechen keine eigene Schrift hatten. Ihre spärliche Korrespondenz wurde in Keilschrift oder demotischen Ideogrammen geführt und mit ägyptischen Skarabaen gesiegelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "785f1b4a-d295-37ba-8b47-d050c142de5b",
                                        "entry_id": "32ac408c-bc0f-3eba-ae7b-3ef37840cd78",
                                        "glosses": [
                                            "altägyptisch, volkstümlich, die Hieroglyphen durch eine im 7. vorchristlichen Jahrhundert entstandene Schrägschrift ersetzend"
                                        ],
                                        "tags": [
                                            "in der Wendung „demotische Schrift“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca1d39c-1356-4938-add6-70e32c94353f",
                                                "sense_id": "785f1b4a-d295-37ba-8b47-d050c142de5b",
                                                "text": "Und von diesen drei Inschriften war die erste, mit vierzehn Linien, hieroglyphisch, die zweite, mit zweiunddreißig Linien, demotisch, und die dritte, mit vierundfünfzig Linien, griechisch Griechisch! Also lesbar!"
                                            },
                                            {
                                                "example_id": "8cc136e6-2b38-40af-989a-71da36097020",
                                                "sense_id": "785f1b4a-d295-37ba-8b47-d050c142de5b",
                                                "text": "Fieberhaft, akribisch und mit genialen Methoden studiert er unzählige Papyri und Kopien hieratischer und demotischer Schrift."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
