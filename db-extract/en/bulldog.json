                ],
                "senses": [
                    {
                        "sense_id": "3ffb60f4-015d-3517-aace-499c82589d8d",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "A breed of dog developed in England by the crossing of the bullbaiting dog and the Pug to produce a ladies' companion dog, having a very smooth coat, a flattened face, wrinkly cheeks, powerful front legs, and smaller hind legs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4a16829-8306-35c5-b6e1-8b6533fdc190",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "A breed of dog developed in England by the crossing of the bullbaiting dog and the Pug to produce a ladies' companion dog, having a very smooth coat, a flattened face, wrinkly cheeks, powerful front legs, and smaller hind legs.",
                            "The original form of this breed, the British bulldog."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "362fb9a3-675a-3da6-9198-2922ff837dc7",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "A stubborn or determined person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fad80fb-bab5-4223-9357-d67d36a32389",
                                "sense_id": "362fb9a3-675a-3da6-9198-2922ff837dc7",
                                "text": "We need a lawyer who will fight for our case, a real bulldog."
                            },
                            {
                                "example_id": "83508bd7-c8c5-4e39-8b6e-8bb231a9cbf9",
                                "sense_id": "362fb9a3-675a-3da6-9198-2922ff837dc7",
                                "text": "His bulldog determination was destined to bring him the opportunity he was seeking."
                            }
                        ]
                    },
                    {
                        "sense_id": "0acf66c9-ed4e-3a15-b29a-e9f068729ccb",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "A refractory material used as a furnace lining, obtained by calcining the cinder or slag from the puddling furnace of a rolling mill."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4577ad09-0e13-30e7-a4d6-36b0e537d394",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "One of the proctors' officers."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "a63ba4fe-c41c-4005-bf01-4d8815b642b7",
                                "sense_id": "4577ad09-0e13-30e7-a4d6-36b0e537d394",
                                "text": "[…] and was confronted by a “bulldog,” a proctor's assistant in charge of discipline, who asked if he was a member of the university since he wasn't wearing a gown, and he was able to say that he wasn't, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d94a4614-4c19-3f11-90e8-312f4987ef52",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "Any move in which the wrestler grabs an opponent's head and jumps forward, so that the wrestler lands, often in a sitting position, and drives the opponent's face into the mat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c13eec6f-c10b-3ce7-9dd1-9d96fd2604de",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "A bulldog edition."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "aee5fcf7-cdfc-4c78-9df5-1ddbec8664aa",
                                "sense_id": "c13eec6f-c10b-3ce7-9dd1-9d96fd2604de",
                                "text": "The bulldog's just gone to press."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ead137b-0bac-3ef6-8158-dce1dd48f183",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "Any of various species of African freshwater fish in the genus Marcusenius, a type of elephantfish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "20c82d44-a938-39ba-b385-5af5af84f6b7",
                        "entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "glosses": [
                            "The children's game of British Bulldog or Red Rover."
                        ],
                        "tags": [
                            "UK",
                            "capitalized",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "d057288a-71c8-4415-bf66-76300a5d3bf0",
                                "sense_id": "20c82d44-a938-39ba-b385-5af5af84f6b7",
                                "text": "\"... playing bulldog in the yard so I know you're fit enough to fight. Have you decided when you're coming back?”"
                            },
                            {
                                "example_id": "8d94dd62-4611-4b4a-b5dc-453f6667cfe1",
                                "sense_id": "20c82d44-a938-39ba-b385-5af5af84f6b7",
                                "text": "[…] playing bulldog on the plaza in front of the meeting hall."
                            },
                            {
                                "example_id": "c70720e5-4750-4350-bd8f-d39bbf591b83",
                                "sense_id": "20c82d44-a938-39ba-b385-5af5af84f6b7",
                                "text": "[…] playing bulldog, that game where you have two teams, one team runs and the other one catches. You have to run from […]"
                            },
                            {
                                "example_id": "2f4c939c-99c9-475a-89b4-834050e8fc3e",
                                "sense_id": "20c82d44-a938-39ba-b385-5af5af84f6b7",
                                "text": "Once Tyson skidded on some wet leaves when he and his friends were playing Bulldog in the park. As he lay on the ground they all laughed at him, even Ajay, and although he'd twisted his ankle, what hurt most was his pride."
                            }
                        ]
                    }
                ],
