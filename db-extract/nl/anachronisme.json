        "nl-extract.jsonl": [
            {
                "entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                "word": "anachronisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2cba05df-6443-4d7b-af5f-85e52c826afa",
                        "entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "tags": [
                            "plural"
                        ],
                        "form": "anachronismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a80a12e1-7186-347e-bdfa-766a922c6900",
                        "entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "glosses": [
                            "een al dan niet gewilde inbreuk op of breuk in de chronologische consistentie van toestanden of gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b056d6d2-8c93-383a-b835-637822e8ddd8",
                        "entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "glosses": [
                            "persoon of zaak die niet thuishoort in het betrokken tijdvak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c13b7e-e61f-45dc-8f6f-e037b213bc3f",
                                "sense_id": "b056d6d2-8c93-383a-b835-637822e8ddd8",
                                "text": "Maar je kon in Venetië niet van anachronismen spreken. De moderne tijd was een anachronisme in deze stad die op geen enkele manier was toegerust voor productiviteit, haast of nut. Hier was de tijd blijven zweven in melancholie en heimwee naar de droom van een schaduw van een rinkelend verleden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06be3df6-db2f-4cbc-937b-8003d8a75405",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "Anachronismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anachronismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "433f6c83-de43-3d14-b8d9-48abd1d959a0",
                                        "entry_id": "f342f8be-0e04-32da-a93a-09b9e2ce372c",
                                        "glosses": [
                                            "falsche zeitliche Einordnung"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f982e5b7-2698-4ffc-8915-43eadd6dead4",
                                                "sense_id": "433f6c83-de43-3d14-b8d9-48abd1d959a0",
                                                "text": "Unter den ganzen Computern wirkte die mechanische Schreibmaschine wie ein glatter Anachronismus."
                                            },
                                            {
                                                "example_id": "c45df4d2-e664-45b9-8f71-91a81100daa3",
                                                "sense_id": "433f6c83-de43-3d14-b8d9-48abd1d959a0",
                                                "text": "Ein Darsteller in einem Gladiatorenfilm, der eine Digitalarmbanduhr trägt, ist ein Beispiel für einen besonders krassen Anachronismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3aedad53-1d10-3cd8-9a83-470ada233332",
                                        "entry_id": "f342f8be-0e04-32da-a93a-09b9e2ce372c",
                                        "glosses": [
                                            "überholte Einrichtung, Ansicht"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8778e52-06bf-4c7c-9b0e-56b465768789",
                                                "sense_id": "3aedad53-1d10-3cd8-9a83-470ada233332",
                                                "text": "Das ist ein Anachronismus sondergleichen! Deine Ansicht zu diesem Thema ist völlig veraltet."
                                            },
                                            {
                                                "example_id": "905f5e39-d2d1-4432-b8de-8a8635c9548f",
                                                "sense_id": "3aedad53-1d10-3cd8-9a83-470ada233332",
                                                "text": "„Diese Hochnäsigkeit [bayerischer Schulpolitik] ist ein Anachronismus.“"
                                            },
                                            {
                                                "example_id": "256b8290-76ca-4628-bdd0-7eafe3a28d84",
                                                "sense_id": "3aedad53-1d10-3cd8-9a83-470ada233332",
                                                "text": "„Wie leicht man da in Anachronismen verrutschen kann, hat Martin Mosebach in seinem jüngsten Roman erfahren müssen.“"
                                            },
                                            {
                                                "example_id": "77ebd7d4-b5d2-4f79-a0c5-19e8680bcef9",
                                                "sense_id": "3aedad53-1d10-3cd8-9a83-470ada233332",
                                                "text": "„Auf Kant geht zurück, dass es heute ein belächelter Anachronismus ist, Gott beweisen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e2ce0b3-ab8f-4134-961f-9e9d4bc00158",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "anachronism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df68c685-c03c-332a-8372-c364be64efeb",
                                        "entry_id": "ccf6e791-4ed6-3dca-8d54-386094a8c195",
                                        "glosses": [
                                            "A chronological mistake; the erroneous dating of an event, circumstance, or object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe4dd9d0-23db-4085-9158-775f87c5fc33",
                                                "sense_id": "df68c685-c03c-332a-8372-c364be64efeb",
                                                "text": "Indeed, that Hall of the Upper Temple is a sight not uninteresting, and with the exception of some trifling improvements and anachronisms which have been introduced into the practice there, a man may sit down and fancy that he joins in a meal of the seventeenth century."
                                            },
                                            {
                                                "example_id": "5b9361d9-4a33-4be5-8e12-851d566ec884",
                                                "sense_id": "df68c685-c03c-332a-8372-c364be64efeb",
                                                "text": "[W]e beg the reader to understand that we only commit anachronisms when we choose and when by a daring violation of those natural laws some great ethical truth is to be advanced […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                        "entry_id": "ccf6e791-4ed6-3dca-8d54-386094a8c195",
                                        "glosses": [
                                            "A person or thing which seems to belong to a different time or period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03fa91ea-f713-4501-ba07-60e293cb9ce2",
                                                "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                                "text": "You are too young—it is an anachronism for you to have such thoughts"
                                            },
                                            {
                                                "example_id": "7e406380-6b3f-4955-b735-15864187cbcc",
                                                "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                                "text": "His movements, his clothes, everything about him, seemed slightly out of place in this assembly. He spoiled the pattern; like Alvin, he was an anachronism."
                                            },
                                            {
                                                "example_id": "a14abfd9-81ed-4860-83d6-f40aeae8ca27",
                                                "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                                "text": "There exist in Europe a number of independent or semi-independent countries which are complete anachronisms, they are mini-countries which have little business existing in this hurly-burly century, but somehow they survive."
                                            },
                                            {
                                                "example_id": "ea9fc1dc-4385-465b-8b4d-6bb8138dbf84",
                                                "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                                "text": "It has been a colossal error by Davos Man left-wingers to think of nation-states as embarrassing anachronisms hostile to democracy."
                                            },
                                            {
                                                "example_id": "8916f3da-2857-4704-acae-4fa1be491577",
                                                "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                                                "text": "The old portions are perfectly preserved[…]and yet right there, in their literal backyard, rise the newer portions, the Star Wars district and the Avatar experience, offering the best of current theme park technologies to match the lovingly maintained anachronisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e48d93-2c4f-3f6d-a588-b50d05923a86",
                                        "entry_id": "ccf6e791-4ed6-3dca-8d54-386094a8c195",
                                        "glosses": [
                                            "The aberrant projection of the present onto the past."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33065c7c-8b14-46ee-bb75-ceab0fcf987b",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "anachronisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11d28a94-21ed-3b82-ae2d-6aab45936ba8",
                                        "entry_id": "e576ac09-b90f-34fe-97cd-331584dfc64c",
                                        "glosses": [
                                            "Faute contre la chronologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13487616-bf47-4412-bf5b-b2ed63cc8942",
                                                "sense_id": "11d28a94-21ed-3b82-ae2d-6aab45936ba8",
                                                "text": "Et puis on découvrit — ce dont on aurait pu se douter à l’avance — que le rétablissement de la royauté, à la Henri V, c’est-à-dire avec son cortège d’idées désuètes et de principes périmés, était un anachronisme que la France de 1873 ne supporterait pas un instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4fde80-8acc-3311-8d2b-b02265d8fdbf",
                                        "entry_id": "e576ac09-b90f-34fe-97cd-331584dfc64c",
                                        "glosses": [
                                            "Toute erreur qui consiste à attribuer des usages, des idées, etc., aux hommes d’une époque où ces idées, ces usages n’étaient pas encore connus ou en pratique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c355a1ef-2645-4321-be49-aaf929f36c95",
                                                "sense_id": "2b4fde80-8acc-3311-8d2b-b02265d8fdbf",
                                                "text": "La Gaule était divisée en une multitude de petits états indépendants, […]. Chacun alors songeait à soi, à sa tribu ; et nous dirions volontiers, si nous ne craignions pas de commettre un anachronisme, que l’amour de la patrie était de l’intérêt de clocher."
                                            },
                                            {
                                                "example_id": "8a7e353a-dc76-4264-a30b-a22edd1d2a77",
                                                "sense_id": "2b4fde80-8acc-3311-8d2b-b02265d8fdbf",
                                                "text": "Il existe beaucoup d’autres noëls, il en est un originaire des environs de Gérardmer, où il est dit que les rois Mages se voyant menacés par le berger Robin, tirèrent… leurs pistolets ! — Pas mal comme anachronisme !"
                                            },
                                            {
                                                "example_id": "3faccba2-1d60-49bb-bc0c-c1640762c458",
                                                "sense_id": "2b4fde80-8acc-3311-8d2b-b02265d8fdbf",
                                                "text": "Il s’agit de l’anachronisme. Ce péché contre l’intelligence du passé consiste, à partir de nos certitudes du présent, à plaquer sur les personnages d’autrefois un jugement rétrospectif d’autant plus péremptoire qu’il est irresponsable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7078b871-9dd3-3de3-8c57-8b492aa12225",
                                        "entry_id": "e576ac09-b90f-34fe-97cd-331584dfc64c",
                                        "glosses": [
                                            "Usage propre à une époque révolue."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58864289-1e37-4e37-9b34-cb223d9e9126",
                                                "sense_id": "7078b871-9dd3-3de3-8c57-8b492aa12225",
                                                "text": "Comment se fait-il, citoyen Proudhon, que vous, l’éclaireur avancé de la Révolution et de l’avenir, vous vous soyez rendu coupable de cet anachronisme : Vive l'empereur !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d4576e-6a48-37cd-8d14-9dbfaf934897",
                                        "entry_id": "e576ac09-b90f-34fe-97cd-331584dfc64c",
                                        "glosses": [
                                            "Ce qui est digne d'une période révolue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b237c3a0-3416-4fa3-8408-a97975d99e51",
                                                "sense_id": "74d4576e-6a48-37cd-8d14-9dbfaf934897",
                                                "text": "Quoi qu’il en soit, l’Empire chérifien, sous sa forme actuelle, est un anachronisme condamné à disparaître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42606ff2-61ad-4dab-8d12-e3b375c4c77b",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "anachronizm",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "98533fb6-4ee5-33ed-8bcc-94f51b9adfcc",
                                        "entry_id": "d3d5bf8f-0f0c-3aae-87a6-b6a903059e32",
                                        "glosses": [
                                            "coś niezgodnego z duchem czasów i stanem wiedzy, przestarzałego (np. pogląd, rzecz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3798e902-7081-4f5b-80d0-fdb647d8aba2",
                                                "sense_id": "98533fb6-4ee5-33ed-8bcc-94f51b9adfcc",
                                                "text": "Stary profesor używał tak wielu anachronizmów językowych, że jego wykłady były kompletnie niezrozumiałe."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "9992d81c-9485-3911-ad65-51cb83dd64fb",
                                        "entry_id": "d3d5bf8f-0f0c-3aae-87a6-b6a903059e32",
                                        "glosses": [
                                            "błąd chronologiczny, polegający na umiejscawianiu w dziele przedmiotu, zjawiska, zachowania itp., które miało miejsce w innym czasie: po lub przed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876e5d47-593e-4a67-837d-794f04a17b96",
                                                "sense_id": "9992d81c-9485-3911-ad65-51cb83dd64fb",
                                                "text": "Znalazłem w filmie o imperium rzymskim kilka anachronizmów, na przykład pokazano jeźdźców używających strzemion."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68e65401-b61e-469f-9774-d3112d7f4566",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "анахронизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анахронизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "03fdc276-f2e7-3c04-bf15-7740768cee52",
                                        "entry_id": "1b542c14-ad5e-399c-ab2a-af22b2037f2b",
                                        "glosses": [
                                            "филол., истор. нарушение хронологической точности при описании, изображении чего-либо, ошибочное отнесение событий, реалий или явлений одной эпохи к другой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189d751d-9db2-4cbb-a7b0-ddcd67cd3179",
                                                "sense_id": "03fdc276-f2e7-3c04-bf15-7740768cee52",
                                                "text": "Эти легенды изобилуют историческими анахронизмами и ошибками, которые сразу же выдают подделку; в них описаны нелепые, а порой и жестокие чудеса, якобы совершенные Отроком Иисусом."
                                            },
                                            {
                                                "example_id": "b4319967-0674-4ace-b11b-1f6ea2e19beb",
                                                "sense_id": "03fdc276-f2e7-3c04-bf15-7740768cee52",
                                                "text": "Марус связан с алмазами покрепче, чем персонажи телефильма, он ведь умрет из-за алмазов. Поэтому даже ничтожных исторических познаний Валеры случайно хватило, чтобы уловить анахронизм в изображаемых событиях. Слыхом не слыхивая о знаменитых ювелирах Ренессанса, он тем не менее знает, что само слово «бриллиант» появилось только в конце XVII века, а до этого обрабатывать алмазы не умели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68560859-3c15-36af-a9e0-7eabdf342753",
                                        "entry_id": "1b542c14-ad5e-399c-ab2a-af22b2037f2b",
                                        "glosses": [
                                            "книжн. устарелое, не соответствующее условиям современности явление, понятие, мнение и т. п.; пережиток старины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e622648c-b3df-4bbb-8306-d57778112c33",
                                                "sense_id": "68560859-3c15-36af-a9e0-7eabdf342753",
                                                "text": "Самое название (от психе ― душа, психика и иатрея ― лечу) предполагает несколько иное понятие, но оно, как и многие другие, в том числе самые употребительные медицинские термины, относится к анахронизмам, которые правильно могут быть поняты только, если иметь в виду историю их возникновения."
                                            },
                                            {
                                                "example_id": "d871f5cc-0767-405e-a23f-36288a1c7f3e",
                                                "sense_id": "68560859-3c15-36af-a9e0-7eabdf342753",
                                                "text": "Этот ротмистр, последний отпрыск знаменитого гусарства времен партизанских войн и Дениса Давыдова, уже и в то отдаленное время являлся в наших глазах почтенным и немного странным анахронизмом."
                                            },
                                            {
                                                "example_id": "0e7eed42-ea2d-48aa-9577-7196ebcf01ee",
                                                "sense_id": "68560859-3c15-36af-a9e0-7eabdf342753",
                                                "text": "Вообразите, что тогда прошло уже два года, как он меня обидел, и вызов мой был безобразнейшим анахронизмом, несмотря на всю ловкость письма моего, объяснявшего и прикрывавшего анахронизм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9848dbf1-633a-4f83-8efc-be6478c8beb4",
                        "source_entry_id": "c5e4a50d-cd6b-34f9-8a6e-24d8905d8250",
                        "target_lang_word": "anacronismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
