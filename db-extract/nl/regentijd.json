                        "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                        "entry_id": "01dc11f3-8ed9-3dc9-bd6c-47cacbf0405a",
                        "glosses": [
                            "tijd van het jaar dat het veel regent in de tropen (april tot september in het noorden, van oktober tot maart in het zuiden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c88175-6429-4608-9b9b-f6e923dd37a9",
                                "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                                "text": "De regentijd in India duurt van juni tot september en de onweersfronten zorgen jaarlijks voor vele slachtoffers."
                            },
                            {
                                "example_id": "e0d00d4a-a44c-401c-bad3-e79a7c294294",
                                "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                                "text": "De autoriteiten gaan ervan uit dat het ergste leed geleden is wanneer de regentijd intreedt, over een maand. Het is onwaarschijnlijk dat de bevuiling de stenen van het monument van de liefde op den duur echt aantast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcf68015-db40-4471-bb33-829bbd119fbc",
                        "source_entry_id": "01dc11f3-8ed9-3dc9-bd6c-47cacbf0405a",
                        "source_sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                        "source_sense_description": "tijd van het jaar dat het veel regent in de tropen...",
                        "target_lang_word": "rainy season",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainy season",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1db12d63-66b7-392f-b5b9-6a99556666b9",
                                        "entry_id": "1214f455-61a7-364d-a1af-9389508af71f",
                                        "glosses": [
                                            "The portion of the year during which the most rain falls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4f8a26-ad47-4d64-830b-e0f58619c65e",
                                                "sense_id": "1db12d63-66b7-392f-b5b9-6a99556666b9",
                                                "text": "If the tourist wishes to avoid the clouds of dust that rise on the great plateau of Mexico, he should travel in the rainy season, i. e., June to September."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
