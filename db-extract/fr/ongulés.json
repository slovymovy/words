                        "source_entry_id": "be2dccd6-af5a-30bc-bf90-61ad22717ae9",
                        "source_sense_id": "49ffe1fc-cc36-3aad-b609-0703de941c7c",
                        "target_lang_word": "ungulate",
                        "target_lang_code": "en",
