                "senses": [
                    {
                        "sense_id": "1842f759-0d84-35cd-be76-c65f2c7d2815",
                        "entry_id": "7d7b86c1-6f86-39bc-b5a5-cc4a40209e62",
                        "glosses": [
                            "beim Schweißvorgang entstehende luftgetragene Partikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5368c4c-50b7-4f51-a562-dd2c0ee6b279",
                                "sense_id": "1842f759-0d84-35cd-be76-c65f2c7d2815",
                                "text": "Das Einatmen von Schweißrauch kann zu gravierenden gesundheitlichen Schädigungen führen."
                            },
                            {
                                "example_id": "5931f1f7-46e9-4c63-931e-6df827aedabe",
                                "sense_id": "1842f759-0d84-35cd-be76-c65f2c7d2815",
                                "text": "„Schweißrauche sind die beim Schweißen, thermischen Schneiden und bei den verwandten Verfahren entstehenden partikelförmigen Stoffe.“"
                            },
                            {
                                "example_id": "6fdcc0fb-118a-41e5-a426-19bcd4a61393",
                                "sense_id": "1842f759-0d84-35cd-be76-c65f2c7d2815",
                                "text": "Die Gefährdungen sind davon abhängig, welches Schweißverfahren angewendet wird. Häufig enthalten die Schweißrauche krebserregende Stoffe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
