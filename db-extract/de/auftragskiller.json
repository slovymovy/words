                "senses": [
                    {
                        "sense_id": "29e1d9b2-1222-35f2-9b34-d3d91c22a4a3",
                        "entry_id": "f2df7be0-67e2-3e7a-8044-f71dd5084e72",
                        "glosses": [
                            "Person, die einen Menschen für eine Gegenleistung ermordet; die einen Auftragsmord ausführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de99fbe2-2df5-4077-bc5a-875a4c9b7875",
                                "sense_id": "29e1d9b2-1222-35f2-9b34-d3d91c22a4a3",
                                "text": "„Denn der serbische Auftragskiller stellte sich drei Wochen später bei der Polizei in Wien, gab aber an, die Tat nicht durchgeführt zu haben.“"
                            },
                            {
                                "example_id": "2f9a7da2-34cc-4342-adb7-7d594fdc0b5c",
                                "sense_id": "29e1d9b2-1222-35f2-9b34-d3d91c22a4a3",
                                "text": "„Als er sich weigert, ein weiteres Mal zuzuschlagen, wird er selbst von seinen Auftraggebern bedroht. Nun sucht der Auftragskiller Schutz - bei einem Menschenrechtsverein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
