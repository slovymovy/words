        "pl-extract.jsonl": [
            {
                "entry_id": "99e4fe2d-971d-35d1-87ef-58fbc46aa7cd",
                "word": "liczbowo",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                        "entry_id": "99e4fe2d-971d-35d1-87ef-58fbc46aa7cd",
                        "glosses": [
                            "za pomocą liczb, cyfr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6abf3ec3-1dc1-4461-b643-b7d0b22e22cf",
                                "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                                "text": "Zmniejszenie wymiarów odlewu nazywamy powszechnie skurczem i wyrażamy je liczbowo w procentach"
                            },
                            {
                                "example_id": "b4989aa6-4e99-44fb-aa23-57ec59a7e374",
                                "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                                "text": "Chciałem tylko zwrócić uwagę na elementarne i najbardziej zasadnicze wielkości, charakteryzujące liczbowo stan gospodarki na progu tego roku"
                            },
                            {
                                "example_id": "a2ee8494-aa9c-4f92-bd97-003982d5bfe9",
                                "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                                "text": "Skala pozwala ująć liczbowo różnice w natężeniu każdej obserwowalnej kompetencji"
                            },
                            {
                                "example_id": "b304662c-3b72-417c-8a34-048173ccc9bc",
                                "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                                "text": "Czy uczony, próbując uchwycić liczbowo zjawiska losowe, których przecież nie da się przewidzieć, nie wkracza przypadkiem na teren zarezerwowany dla Pana Boga"
                            },
                            {
                                "example_id": "4b48cfb5-15de-4922-aade-504256a17963",
                                "sense_id": "5f439e8f-6188-3aa7-9860-3f3e739bddd9",
                                "text": "Skala zjawiska jest bardzo duża. Trudno jest ją określić liczbowo[,] ponieważ w mieście nie były prowadzone żadne badania socjologiczne tego zjawiska"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dea8f683-4383-3654-bd3c-c1acedd66af9",
                        "entry_id": "99e4fe2d-971d-35d1-87ef-58fbc46aa7cd",
                        "glosses": [
                            "ilościowo, liczebnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915cedc6-238f-43c1-80da-2fcd04902ecf",
                                "sense_id": "dea8f683-4383-3654-bd3c-c1acedd66af9",
                                "text": "Z danych statystycznych[,] wynika niezbicie, że panie górują — przynajmniej liczbowo — nad płcią brzydką"
                            },
                            {
                                "example_id": "c9a7d4b2-f5dc-49ec-a9cf-d6af37ad0adf",
                                "sense_id": "dea8f683-4383-3654-bd3c-c1acedd66af9",
                                "text": "W Amsterdamie, imigranci liczbowo już zdominowali rdzennych mieszkańców, i co na to powiesz"
                            },
                            {
                                "example_id": "8e902f6c-3fdc-49e8-a3ef-d36688f876dd",
                                "sense_id": "dea8f683-4383-3654-bd3c-c1acedd66af9",
                                "text": "W należących do NATO państwach europejskich proamerykańskie odłamy społeczeństwa są nieraz niewiele słabsze liczbowo i opiniotwórczo niż przeciwnicy czy krytycy Ameryki"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
