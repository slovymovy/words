                                "target_senses": [
                                    {
                                        "sense_id": "238c611e-bf93-3c05-ba1f-b973878181a8",
                                        "entry_id": "b47c6605-26ff-30fc-8c7c-f711eb171e18",
                                        "glosses": [
                                            "Complex, detailed, or sophisticated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c783e8b-c7d4-4266-9657-fbac454e4d2f",
                                                "sense_id": "238c611e-bf93-3c05-ba1f-b973878181a8",
                                                "text": "After reading a long, elaborate description, I was impressed but no wiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19dcf582-ad2d-3ddd-9135-5f6c55f0ff64",
                                        "entry_id": "b47c6605-26ff-30fc-8c7c-f711eb171e18",
                                        "glosses": [
                                            "Intricate, fancy, flashy, or showy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226d0323-e8b7-469e-9133-fa439a37cddf",
                                                "sense_id": "19dcf582-ad2d-3ddd-9135-5f6c55f0ff64",
                                                "text": "I stared for hours at the elaborate pattern in the rug."
                                            },
                                            {
                                                "example_id": "5301af23-3a28-498e-bb01-78232ec3ab28",
                                                "sense_id": "19dcf582-ad2d-3ddd-9135-5f6c55f0ff64",
                                                "text": "The house was a big elaborate limestone affair, evidently new. Winter sunshine sparkled on lace-hung casement, on glass marquise, and the burnished bronze foliations of grille and door."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elaborate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b5575e4-6e71-34f0-946b-cbffc6946819",
                                        "entry_id": "e8f80a15-ab4d-3a35-8f65-f7897d33e4b5",
                                        "glosses": [
                                            "Тo develop in detail or complexity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46fc8c8f-8080-4354-be27-ae0ca585fffd",
                                                "sense_id": "7b5575e4-6e71-34f0-946b-cbffc6946819",
                                                "text": "[…] by the time of the subsequent coronation, when the Prussian king put the crown on his own head in child-like belief of the obsolete doctrine called divine right, the untiring statesman had elaborated his scheme of reform."
                                            },
                                            {
                                                "example_id": "2adf324c-712f-43b0-8a64-09e0a156be70",
                                                "sense_id": "7b5575e4-6e71-34f0-946b-cbffc6946819",
                                                "text": "The notion of blood purity was first elaborated in Europe, where it was used to separate Old Christians from Spain’s New Christians—women and men of Jewish and Muslim origin whose ancestors had converted to Christianity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9381ba79-4d1f-328c-b53b-a9c83f05c3d8",
                                        "entry_id": "e8f80a15-ab4d-3a35-8f65-f7897d33e4b5",
                                        "glosses": [
                                            "To expand/enlarge in detail."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd780278-81de-4d7d-990b-fd29f040f4d0",
                                                "sense_id": "9381ba79-4d1f-328c-b53b-a9c83f05c3d8",
                                                "text": "What do you mean you didn't come home last night? Would you care to elaborate?"
                                            },
                                            {
                                                "example_id": "4f036c18-2406-408c-9b67-44397aee91c6",
                                                "sense_id": "9381ba79-4d1f-328c-b53b-a9c83f05c3d8",
                                                "text": "Could you elaborate on the plot for your novel for me?"
                                            }
                                        ]
