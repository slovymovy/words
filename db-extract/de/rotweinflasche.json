                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e20f65-7953-4762-bf7f-beaf583f1952",
                                "sense_id": "53cd5d71-f4e9-3fe8-a5da-afaa690e2167",
                                "text": "Er holte für das Essen eine Rotweinflasche aus dem Keller."
                            },
                            {
                                "example_id": "e81772c8-65c1-46fe-b9eb-a71c257e84a8",
                                "sense_id": "53cd5d71-f4e9-3fe8-a5da-afaa690e2167",
                                "text": "„Er nahm die Rotweinflasche und schenkte nach, während Thomas das Spiel betrachtete.“"
                            },
                            {
                                "example_id": "35eb9945-c279-4635-a6b1-c681f4c15a03",
                                "sense_id": "53cd5d71-f4e9-3fe8-a5da-afaa690e2167",
                                "text": "„Morel, der Bursche, brachte eine Kasserolle mit warmem Wasser und stellte die Rotweinflasche hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
