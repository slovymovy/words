                                        "glosses": [
                                            "Reconnaitre une maladie par ses symptômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5587fe6-c659-429d-8ad3-114d657c5bb8",
                                                "sense_id": "545428c6-c362-37a5-8eaf-1ce5f82ee8fd",
                                                "text": "Il diagnostique une simple foulure."
                                            },
                                            {
                                                "example_id": "a44e652d-bc3e-4897-a671-5b41b2c4770f",
                                                "sense_id": "545428c6-c362-37a5-8eaf-1ce5f82ee8fd",
                                                "text": "Pasteur diagnostiqua le mal : c’était la maladie dite des morts flats ou flacherie, indépendante de la pébrine."
                                            },
                                            {
                                                "example_id": "6e4dfdf7-6b18-4fa0-bdb0-c91212fa909a",
                                                "sense_id": "545428c6-c362-37a5-8eaf-1ce5f82ee8fd",
                                                "text": "L’ostéoporose se diagnostique en premier lieu par l’examen d’ostéodensitométrie (ou « densitométrie osseuse » au cours d’un interrogatoire détaillé chez le généraliste ou le gynécologue au moment de la ménopause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2002001-2ac7-35db-b756-b7e3ada42de6",
                                        "entry_id": "d38573ee-1699-3df0-b68f-88e520697e50",
                                        "glosses": [
                                            "Identifier un problème à partir d’observations, de contrôles ou de tests."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424a916b-3511-4f84-8c9c-248b1cd810b8",
                                                "sense_id": "a2002001-2ac7-35db-b756-b7e3ada42de6",
                                                "text": "\"Les patients plus jeunes souffriront souvent d'une forme plus avancée de la maladie quand ils seront finalement diagnostiqués\", poursuit-elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
