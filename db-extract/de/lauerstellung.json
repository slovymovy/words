                ],
                "senses": [
                    {
                        "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                        "entry_id": "4d620095-8185-3941-91d9-6e434d6bd384",
                        "glosses": [
                            "beobachtende Position (im Hintergrund), in der man auf jemanden oder etwas angespannt wartet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890952f6-1e4a-4973-8e95-097ad8c4aa8c",
                                "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                                "text": "„Sie befand sich eindeutig in Lauerstellung, geduldig, leicht angespannt, sämtliche Sinne auf einen Punkt fokussiert.“"
                            },
                            {
                                "example_id": "0c86019c-58fe-4068-b8bc-bc04b8cc2b0d",
                                "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                                "text": "„Ich wusste, dass mich solche Gedanken überhaupt nicht weiterbrachten und doch befand ich mich manchmal fast in einer Lauerstellung, welchen Streich mir mein Gehirn als Nächstes spielen würde.“"
                            },
                            {
                                "example_id": "b72c5002-5896-449f-8f87-84525c7115e0",
                                "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                                "text": "„Sie haben eine typische Lauerstellung, dabei steht der Vorderkörper in einem Winkel von 45° zur Unterlage.“"
                            },
                            {
                                "example_id": "8ec914ec-d097-42d1-9083-754ce02a9981",
                                "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                                "text": "„Auch Hejch befand sich nach wie vor in Lauerstellung und wartete auf ein Zeichen ihres Herrn, welches allerdings auf sich warten ließ.“"
                            },
                            {
                                "example_id": "2d40dbfe-0d21-4845-8ecb-7d3ec37b3b4e",
                                "sense_id": "64c68886-3e97-388c-afa7-b2d704251477",
                                "text": "„Da sind bestimmt einige in Lauerstellung, die nur darauf warten, dass Sie Schwächen zeigen, um dann Breitseiten auf Ihre Argumente abzufeuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
