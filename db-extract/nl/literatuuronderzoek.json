                        "entry_id": "71cb06ad-47b2-3eaa-86f5-c113c26b5e6c",
                        "glosses": [
                            "onderzoek naar wat eerder geschreven is over een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c03523-7765-433e-9bc1-cdbf4bcf5156",
                                "sense_id": "1242e060-c398-3aa2-8f8a-fffa20737cb5",
                                "text": "Het manifest komt enkele dagen voor de afronding van een onderzoek naar de gevolgen van schaliegas. Minister Kamp van Economische Zaken heeft de Tweede Kamer dit onderzoek toegezegd. Er is ook al kritiek op: het zou gaan om een globaal literatuuronderzoek dat geen antwoorden geeft op specifieke vragen van politici en burgers."
                            },
                            {
                                "example_id": "b1291541-7997-4319-9937-00951caad47e",
                                "sense_id": "1242e060-c398-3aa2-8f8a-fffa20737cb5",
                                "text": "Door mij destijds verricht archief- en literatuuronderzoek zorgde voor veel aanvullende en feitelijke informatie. Een hernieuwd literatuur- en archiefonderzoek heeft, anno nu, naast nieuwe gegevens ook nieuwe getuigen opgeleverd die zijn geïnterviewd."
                            }
                        ]
                    }
