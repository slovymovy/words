                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2d47e44-6d9c-4738-829e-0636ecec0e7c",
                        "entry_id": "630e35a8-68cc-3eb1-a53c-a20fe49d1ed1",
                        "tags": [
                            "plural"
                        ],
                        "form": "terrines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "190c6922-0c7a-32ee-b270-7c337f0f244c",
                        "entry_id": "630e35a8-68cc-3eb1-a53c-a20fe49d1ed1",
                        "glosses": [
                            "A deep type of dish or pan, typically used for casseroles and made out of pottery."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "81e74807-30b8-377a-a48c-2279e262ad44",
                        "entry_id": "630e35a8-68cc-3eb1-a53c-a20fe49d1ed1",
                        "glosses": [
                            "A pâté baked in such a dish and served cold."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eba44526-a0ca-4740-84e9-756fa3ea2f9f",
                        "source_entry_id": "630e35a8-68cc-3eb1-a53c-a20fe49d1ed1",
                        "source_sense_description": "dish",
                        "target_lang_word": "Terrine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                        "entry_id": "bca61997-0247-35ab-8308-d8a19e95e14e",
                                        "glosses": [
                                            "Suppenschüssel, die meist besonders verziert ist, auf einem Fuß/mehreren Füßen steht und einen Deckel hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125c7545-36b9-4809-833d-dd4fe14ec941",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "Jacob servierte die Hühnersuppe in einer Terrine."
                                            },
                                            {
                                                "example_id": "0e281f54-7daf-4523-b657-109f7f5c37a7",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "Rainer sammelt Terrinen mit Blumendekor."
                                            },
                                            {
                                                "example_id": "41d6a409-7be9-409b-b51b-6d5a6411ab4d",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "„Das Lokal war bei ihrer Ankunft verwaist, doch spärliche Anweisungen Machowskis genügten, um wenig später eine Terrine mit heißer Rinderbrühe serviert zu bekommen.“"
                                            },
                                            {
                                                "example_id": "bf3fdfb0-66d7-4e1c-b1e0-919bfd5f88be",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "„Die toten Fische glitzerten, die gefesselten Hummer bewegten sich frierend auf ihren Eisbetten, die Kellner balancierten Terrinen mit Fischsuppe über ihren Köpfen, das Lokal war voll, aber Hirsch war nicht da.“"
                                            },
                                            {
                                                "example_id": "7ce8d847-0b84-4cf4-9bdb-64d7bd90dd11",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "„Ich gab mir einen Ruck und ging mit der Terrine ins Eßzimmer.“"
                                            },
                                            {
                                                "example_id": "1f46f4ec-6c9d-48d4-b6e7-d47472a58483",
                                                "sense_id": "38268bd2-36e7-3d0b-bcc6-9d814f7c53c6",
                                                "text": "„Florin brachte also in einer riesigen Terrine den Punsch herein und Nina die Musikanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49819e77-6e46-3844-bc88-f3f328a27678",
                                        "entry_id": "bca61997-0247-35ab-8308-d8a19e95e14e",
                                        "glosses": [
                                            "(irdene) Form, in der Pasteten zubereitet und serviert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b84105-9dc0-4470-a394-4a5ca082dfd9",
                                                "sense_id": "49819e77-6e46-3844-bc88-f3f328a27678",
                                                "text": "„Diese Pasteten werden größtenteils ohne Butterteig in einer besonderen Terrine gefertigt, damit sie länger aufzubewahren sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ffb6ce01-f245-34c3-9fc9-0f168384c0ac",
                                        "entry_id": "bca61997-0247-35ab-8308-d8a19e95e14e",
                                        "glosses": [
                                            "Pastete ohne Teigmantel, die direkt in der Form gegart wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d6e859-3ddc-4fc6-a480-5a8a68042d61",
                                                "sense_id": "ffb6ce01-f245-34c3-9fc9-0f168384c0ac",
                                                "text": "„Tadellose Terrinen setzen die höheren Weihen der Kochkunst voraus: p[r]äziseste Arbeit und exakteste Garzeiten, geschmackliche Komposition und ansehnliche Präsentation.“"
                                            },
                                            {
                                                "example_id": "75b0efe7-12bd-4799-9ab5-a16a1780de69",
                                                "sense_id": "ffb6ce01-f245-34c3-9fc9-0f168384c0ac",
                                                "text": "„Da sie keinen Teigmantel besitzen, der Flüssigkeit aufsaugen kann, sind Terrinen besonders saftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54f74ad7-7bbd-421e-9740-6e3bc8f54d47",
                        "source_entry_id": "630e35a8-68cc-3eb1-a53c-a20fe49d1ed1",
