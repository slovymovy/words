                        "glosses": [
                            "tentoonstelling van kunstwerken die men ook kan kopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9e2277-d870-4f7a-a82f-58190a2f2553",
                                "sense_id": "dd502ff9-1d36-379f-ade9-083efdfb603c",
                                "text": "„Helaas kan ze de verkooptentoonstelling van haar eigen werk zelf niet meer meemaken.” Op haar verzoek komt de opbrengst geheel ten goede aan de Stichting Ambulance Wens. De verkoopexpositie is in De Hofkerk aan de Hofmeijerstraat 1 in Oldenzaal. Vrijdag van 14.00 tot 19.00 uur en zaterdag van 10.00 tot 16.00 uur."
                            },
                            {
                                "example_id": "ebe74724-5818-46e8-abb4-39c22ddbfbb0",
                                "sense_id": "dd502ff9-1d36-379f-ade9-083efdfb603c",
                                "text": "De opbrengst van de verkooptentoonstelling, enkele duizenden Euro’s, is bestemd voor jonge kunstenaars in Nederland."
                            }
                        ]
                    }
