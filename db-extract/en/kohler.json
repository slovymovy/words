                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Frau Kohler ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f60576e2-9ad1-4c35-a40d-8e7fd68726ee",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Herr Kohler wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "61bc1b9f-5561-4b1b-b814-f94ab523fdd9",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Die Kohlers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "d55c0284-dafd-47b3-9372-7aa8e231fce9",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Der Kohler trägt nie die Schals, die die Kohler ihm strickt."
                                            },
                                            {
                                                "example_id": "d188a872-2b40-4863-84be-db2f1e92d477",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kohler kommt, geht der Herr Kohler.“"
                                            },
                                            {
                                                "example_id": "a93030fb-f454-4f4d-ab51-2fe2e24911bd",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Kohler kommt und geht."
                                            },
                                            {
                                                "example_id": "1c414ef2-bd21-48b9-b3f0-58d0f75ae9c2",
                                                "sense_id": "bfd837fa-1ad0-3adf-8b10-88e675f9a27d",
                                                "text": "Kohlers kamen, sahen und siegten."
                                            }
