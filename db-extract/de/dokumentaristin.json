                        "examples": [
                            {
                                "example_id": "a3962bef-b580-4bdb-86eb-cfdcfd5fe60c",
                                "sense_id": "4051355f-5cde-3143-a2a5-74d3715f27a1",
                                "text": "„Sie arbeitete als Rechercheurin und Dokumentaristin für eine Film- und Fernsehproduktionsgesellschaft.“"
                            },
                            {
                                "example_id": "09cf9483-a8e5-423a-ac45-ea91d6d50ef4",
                                "sense_id": "4051355f-5cde-3143-a2a5-74d3715f27a1",
                                "text": "„An den gleichen Orten drehte die Dokumentaristin Dagmar Wagner nun einen Hochschul-Abschlußfilm, der seinen Erfolg sogar verdient.“"
                            },
                            {
                                "example_id": "1bf4306e-6d36-4f5c-bf5f-7c056b734a42",
                                "sense_id": "4051355f-5cde-3143-a2a5-74d3715f27a1",
                                "text": "„Nach Anstellungen als Dokumentaristin und Fachredakteurin trat sie 1980 in den Ruhestand.“"
                            }
