                "senses": [
                    {
                        "sense_id": "4249b35b-dcc3-3559-b455-f9eb24d9c089",
                        "entry_id": "1ddc6f8f-bdab-3f29-9ab8-8ab5c6c5cd8e",
                        "glosses": [
                            "Débarrasser des pièges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012168c8-4736-451c-9085-0bd9d9aa0efb",
                                "sense_id": "4249b35b-dcc3-3559-b455-f9eb24d9c089",
                                "text": "L'autre équipe doit visiter la maison et dépiéger en faisant sauter le minimum de pièges, ce qui n'est pas facile."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f8d64fc-263b-3529-aea5-8ce8459e5429",
                        "entry_id": "1ddc6f8f-bdab-3f29-9ab8-8ab5c6c5cd8e",
                        "glosses": [
                            "Libérer ce qui était piégé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56ca8f8-c071-4a6a-bd2b-183785c87748",
                                "sense_id": "6f8d64fc-263b-3529-aea5-8ce8459e5429",
                                "text": "J’aime cette peur du mâle sournoisement traqué et qui veut coûte que coûte dépiéger son sexe."
                            },
                            {
                                "example_id": "37e5760d-23be-4f4a-ae6e-f56a4f9ab848",
                                "sense_id": "6f8d64fc-263b-3529-aea5-8ce8459e5429",
                                "text": "Le couplage des électrons aux défauts est plus ou moins grand, il faut donc fournir une énergie plus ou moins importante pour dépiéger les électrons."
                            }
                        ]
                    }
                ],
