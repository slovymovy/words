            {
                "entry_id": "db8af0bf-2109-319b-a128-a81eedc99a6c",
                "word": "doxy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8231c121-7b5b-4334-bf14-bf561d39e456",
                        "entry_id": "db8af0bf-2109-319b-a128-a81eedc99a6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "doxies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                        "entry_id": "db8af0bf-2109-319b-a128-a81eedc99a6c",
                        "glosses": [
                            "An aggressive creature similar to a fairy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0dbb6f-df0d-46aa-bb3c-cc00074c4050",
                                "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                                "text": "\"Yeah, but she doesn't usually actively sabotage you.\"\n\"No worries. I'm used to doxy fairies\""
                            },
                            {
                                "example_id": "b969ab2e-abc4-4cdc-9844-15a17ea3182f",
                                "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                                "text": "The doxies were everywhere. So he just kept swinging, feeling a shudder through his arm each time the racquet made contact with a scaly body. Despite his best efforts, two or three of the nasty, screeching things got close."
                            },
                            {
                                "example_id": "f79b8156-2cb9-4ce3-84bc-e9370c9e204e",
                                "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                                "text": "\"And I'm a doxy not a fairy, you complete and utter fuckface.\""
                            },
                            {
                                "example_id": "ef2540df-340e-48e1-a213-2e102409cc10",
                                "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                                "text": "Trapped like this, the options are extremely pitiful and the damned doxies bite the way scorpions sting."
                            },
                            {
                                "example_id": "e0c7603e-1898-4faf-a0fc-7894ddeab315",
                                "sense_id": "8ed56f7a-f949-3eb3-bcfe-191447974303",
                                "text": "A doxy messenger can outfly a pixie by five klicks in optimal conditions. They can span 40 klicks in a little over five hours. Though not particularly good in combat, doxies can turn invisible, kill with a kiss, and cause hallucinations if touched."
                            }
                        ]
                    }
                ],
