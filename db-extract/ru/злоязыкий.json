                    {
                        "translation_id": "c2b4ec8b-7ffc-47cb-aff1-45a0b226140b",
                        "source_entry_id": "64aaf001-345b-3cca-a0a8-bc7041d4cc64",
                        "source_sense_id": "13c562db-2ec2-30ae-ac61-89e8d8133033",
                        "target_lang_word": "médisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85d2d880-b16c-3682-8c70-a5289c445d14",
                                        "entry_id": "a15b234d-9af4-3e05-bdfb-d97fd3c9a307",
                                        "glosses": [
                                            "Qui médit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010b9cd8-dd54-4652-be9a-5aad46c24944",
                                                "sense_id": "85d2d880-b16c-3682-8c70-a5289c445d14",
                                                "text": "On est d’ordinaire plus médisant par vanité que par malice."
                                            },
                                            {
                                                "example_id": "8315bd0a-5b80-4f26-b20e-a7aab67d32ca",
                                                "sense_id": "85d2d880-b16c-3682-8c70-a5289c445d14",
                                                "text": "La chanteuse regrettait Paris, sa petite cour d’amies potinières et d’anciens admirateurs, vieux rats de coulisses aussi médisants que les femmes de leur âge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "médisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23cef629-bdf6-3d06-8ce0-373179e0822a",
                                        "entry_id": "09423a25-9ffd-3b4d-a3d7-5dc8a9299459",
                                        "glosses": [
                                            "Qui médise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "médisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9cc723e-739a-390d-a43f-0d0e9fb34584",
                                        "entry_id": "c879f73e-69ce-3bc6-be97-f32b471ea08f",
                                        "glosses": [
                                            "Celui qui médit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffe5554-3a8f-4000-8039-55c01092051e",
                                                "sense_id": "a9cc723e-739a-390d-a43f-0d0e9fb34584",
                                                "text": "Ellénore refusait de paraître à toutes les fètes, où sa beauté lui aurait attiré les regards des curieux, et sa position, les propos des médisants."
                                            },
                                            {
                                                "example_id": "0035e5fb-a4df-45b3-a71a-49619b739c3f",
                                                "sense_id": "a9cc723e-739a-390d-a43f-0d0e9fb34584",
                                                "text": "Quinze jours plus tard, ma mauvaise étoile me mit en présence d’un médisant qui déchiquetait à belles dents la réputation d’une jeune fille, l’une de mes plus charmantes danseuses du dernier hiver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "médisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30e5133b-8619-357a-8fe5-53e52ce61bcf",
                                        "entry_id": "4be72009-96da-3013-b5e0-b3bafcfb4892",
                                        "glosses": [
                                            "Celui qui médise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb634bb-f08a-4b65-ac65-bf2e146d2f74",
                                                "sense_id": "30e5133b-8619-357a-8fe5-53e52ce61bcf",
                                                "text": "Dans le camps des « médisants » (du verbe médiser = épouser le parti des Mèdes, c’est-à-dire des Perses), figurent naturellement des Grecs d’Asie et des îles (...), mais aussi les Thébains et avec eux les Béotiens, sauf Thespies et Platées."
                                            }
                                        ]
                                    }
                                ]
                            },
