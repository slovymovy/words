                                    {
                                        "sense_id": "7983fcc6-fc28-3c01-b69a-6eb73f638432",
                                        "entry_id": "c3366d01-8305-3e40-b954-30e06fb6db96",
                                        "glosses": [
                                            "Homme noir habitant ou originaire des États-Unis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6840352-ebdd-462c-bb51-16b2f55bd8eb",
                                                "sense_id": "7983fcc6-fc28-3c01-b69a-6eb73f638432",
                                                "text": "Le but de l'association était d'atteindre la liberté complète pour les Afro-Américains, par tous les moyens."
                                            },
                                            {
                                                "example_id": "db1bf843-14c8-4a5f-b3db-89b3940c82de",
                                                "sense_id": "7983fcc6-fc28-3c01-b69a-6eb73f638432",
                                                "text": "Dans les années 50-60, entre 2 000 et 3 000 Afro-Américains, et pas des moindres, de James Baldwin à Miles Davis, vivent à Paris."
                                            },
                                            {
                                                "example_id": "2e5010a2-b68c-4c6c-bea0-7060684baeb1",
                                                "sense_id": "7983fcc6-fc28-3c01-b69a-6eb73f638432",
                                                "text": "Quand il visite les musées avec sa mère, il constate qu’il y a beaucoup d’Afro-Américains sur les murs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84efb800-1efb-34b2-bb39-cbea5c3128ce",
                                        "entry_id": "c3366d01-8305-3e40-b954-30e06fb6db96",
                                        "glosses": [
                                            "Homme noir originaire ou habitant en Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c96faf4-48ca-4b80-b44b-37983f21d5e0",
                                                "sense_id": "84efb800-1efb-34b2-bb39-cbea5c3128ce",
                                                "text": "Avocate de la justice et des pauvres, l’Église se rend solidaire des revendications des Afro-Américains pour la défense de leurs terres, pour l’affirmation de leurs droits et de leur citoyenneté, de leurs projets particuliers de développement et la conscience de leur négritude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
