                "senses": [
                    {
                        "sense_id": "2c62fe55-97d7-3031-91b3-ec20d101bfbc",
                        "entry_id": "3a1e269f-60b4-398d-bf54-29a8cd1ab79b",
                        "glosses": [
                            "Doctrine politique soutenant l’acquisition ou la préservation de l’autonomie politique d’une nation ou d’une région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c84f67d7-3848-4495-ab12-b73ef5f03a43",
                                "sense_id": "2c62fe55-97d7-3031-91b3-ec20d101bfbc",
                                "text": "Un autonomisme dont on ne parle pas parce qu’il appartient à une histoire proche et dont les Alsaciens devraient avoir une connaissance historique."
                            },
                            {
                                "example_id": "3826b279-d3c6-4027-9590-287323419da9",
                                "sense_id": "2c62fe55-97d7-3031-91b3-ec20d101bfbc",
                                "text": "L’autonomisme basque n’est pas un phénomène unique en son genre en Espagne ; il existe aussi un autonomisme catalan, un autonomisme galicien."
                            }
                        ]
                    },
                    {
                        "sense_id": "92d4e2c1-25c8-3582-a1de-406499be6f71",
                        "entry_id": "3a1e269f-60b4-398d-bf54-29a8cd1ab79b",
                        "glosses": [
                            "Tendance à s’administrer de façon indépendante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1a1b72-91db-4642-99ca-79247be607ec",
                                "sense_id": "92d4e2c1-25c8-3582-a1de-406499be6f71",
                                "text": "Quand on accuse l’Administration d’être cloisonnée à l’excès, c’est cette propension à l’autonomisme des bureaux que l’on stigmatise."
                            },
                            {
                                "example_id": "107f7ac5-b49e-42f4-ab0e-a92a7fff4005",
                                "sense_id": "92d4e2c1-25c8-3582-a1de-406499be6f71",
                                "text": "Sur ce fond d’anti-étatisme et d’autonomisme de gestion, le BNBV travaille les directives d’organisation des pouvoirs qu’il répartit généralement en trois instances…"
                            }
                        ]
                    }
