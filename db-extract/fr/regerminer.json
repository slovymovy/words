                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a43a7f4-51db-4f8b-878b-198bea389ce1",
                                "sense_id": "b216672e-795f-3a6d-b070-64240abb7fcb",
                                "text": "Cependant, un procédé de réalisation de barrière thermique qui consisterait à déposer des fines couches élémentaires en plusieurs fournées de dépôt dans le but de les faire regerminer les unes sur les autres constitue une solution difficilement applicable industriellement."
                            },
                            {
                                "example_id": "928b070f-5c0d-4da0-a995-762cee9980e7",
                                "sense_id": "b216672e-795f-3a6d-b070-64240abb7fcb",
                                "text": "Qui sait, les semences de celles ci pourront regerminer l'humanité?"
                            }
                        ]
                    }
