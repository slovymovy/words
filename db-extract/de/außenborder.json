                ],
                "senses": [
                    {
                        "sense_id": "f9cd8a94-96b0-3aa9-a78b-bf6b4d4c8a3e",
                        "entry_id": "a7ad16b1-9092-38fa-84b2-f1809c54fa1d",
                        "glosses": [
                            "Motor, der nicht im Innern eines Bootes fest eingebaut ist, sondern am Heck angebracht wird und recht leicht an- und abmontiert werden kann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "96e26980-b52e-45bc-9054-42af5bd05dfb",
                                "sense_id": "f9cd8a94-96b0-3aa9-a78b-bf6b4d4c8a3e",
                                "text": "Herrn Schneider wurde sein Außenborder gestohlen."
                            },
                            {
                                "example_id": "1da860a3-32ed-4639-a9c4-5fb8af75e6b7",
                                "sense_id": "f9cd8a94-96b0-3aa9-a78b-bf6b4d4c8a3e",
                                "text": "Mein alter Außenborder war zu schwach für mein Boot."
                            },
                            {
                                "example_id": "dc3f4609-67ed-4aad-9baa-77e678ef7983",
                                "sense_id": "f9cd8a94-96b0-3aa9-a78b-bf6b4d4c8a3e",
                                "text": "Der Außenborder sprang nicht an, als wir aufbrechen wollten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d754b1e-09db-3f94-81b2-e3c0e6b2bd21",
                        "entry_id": "a7ad16b1-9092-38fa-84b2-f1809c54fa1d",
                        "glosses": [
                            "Boot mit einem Motor wie unter [1] beschrieben"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "185b659b-14c2-4baa-9294-4b0d164fd775",
                                "sense_id": "6d754b1e-09db-3f94-81b2-e3c0e6b2bd21",
                                "text": "Mit fünf Personen war der Außenborder fast schon überladen."
                            },
                            {
                                "example_id": "61845889-7196-49d3-9c63-7bbc9fc5e59f",
                                "sense_id": "6d754b1e-09db-3f94-81b2-e3c0e6b2bd21",
                                "text": "Wir überquerten die Förde in einem Außenborder."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
