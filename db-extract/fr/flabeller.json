                "senses": [
                    {
                        "sense_id": "070b7a51-84a2-3a54-b901-cbf41c8a176e",
                        "entry_id": "f9ee9928-72ea-3ef9-8919-947c1a5a22e2",
                        "glosses": [
                            "Ventiler, user d’un éventail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4da9f5-8fcb-45bc-acdb-154c790b2395",
                                "sense_id": "070b7a51-84a2-3a54-b901-cbf41c8a176e",
                                "text": "Son précepte est bon, cela doit nous suffire, et d’ailleurs serait-ce un si grand mal de flabeller réellement et d’user effectivement de l’éventail ou d’un ventilateur équivalent ?"
                            },
                            {
                                "example_id": "b9ab0620-1d17-4385-81cc-654a126d2b61",
                                "sense_id": "070b7a51-84a2-3a54-b901-cbf41c8a176e",
                                "text": "Je suis accroupi près d’elle, un éventail à la main pour flabeller les mouches et je la domine ainsi, je la possède des yeux, toute renversée."
                            }
                        ]
                    }
