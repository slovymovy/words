                    {
                        "sense_id": "eb88ca35-1426-3793-8a39-fdf8ac19a408",
                        "entry_id": "0b871782-d820-3ad9-ab7b-475c37a3c84c",
                        "glosses": [
                            "zu Datteln gehörig, aus Datteln stammend"
                        ],
                        "tags": [
                            "undeklinierbar"
                        ],
                        "examples": [
                            {
                                "example_id": "e36cfa8f-cffb-4821-89ea-27eec0c16a1c",
                                "sense_id": "eb88ca35-1426-3793-8a39-fdf8ac19a408",
                                "text": "Einige Dattelner Straßen werden bald neu gemacht."
                            },
                            {
                                "example_id": "1ef68aa4-1b49-4524-b1a5-eeb0529265bf",
                                "sense_id": "eb88ca35-1426-3793-8a39-fdf8ac19a408",
                                "text": "„Die Länge dieser Wasserstraßen auf Dattelner Stadtgebiet beträgt insgesamt 17 Kilometer.“"
                            },
                            {
                                "example_id": "a661dc9e-184a-4db4-ae61-65c830348b07",
                                "sense_id": "eb88ca35-1426-3793-8a39-fdf8ac19a408",
                                "text": "„Der Dattelner Stadtrat hat über einen neuen Bebauungsplan für das E.ON-Kraftwerk entschieden[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
