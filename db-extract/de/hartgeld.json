                    {
                        "sense_id": "e9793c58-6895-348d-9178-9fa4efe7e277",
                        "entry_id": "e992a1fa-aedf-350a-9a7c-187c2f580dc7",
                        "glosses": [
                            "der Teil einer Währung, der in Form von Münzen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444ff3f9-d872-43dc-844d-9aa4e7becc64",
                                "sense_id": "e9793c58-6895-348d-9178-9fa4efe7e277",
                                "text": "Ich habe nur noch ein bisschen Hartgeld in der Tasche."
                            },
                            {
                                "example_id": "0538b82f-59d1-4bb5-b46e-7717aba48fc3",
                                "sense_id": "e9793c58-6895-348d-9178-9fa4efe7e277",
                                "text": "Evi bezahlte ihren Einkauf nur mit Hartgeld, damit ihr Portemonnaie endlich nicht mehr so schwer war."
                            },
                            {
                                "example_id": "55793914-fa04-433c-89d2-5d610b34352c",
                                "sense_id": "e9793c58-6895-348d-9178-9fa4efe7e277",
                                "text": "„Früher in der Sowjetunion konnte man dagegen mit Hartgeld große Einkäufe machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
