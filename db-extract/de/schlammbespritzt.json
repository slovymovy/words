                ],
                "senses": [
                    {
                        "sense_id": "a68f2772-b549-376c-95d4-40860603bc72",
                        "entry_id": "3a198635-a251-3a45-8d83-3388c0bee61c",
                        "glosses": [
                            "mit Schlamm bespritzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00a5218-364f-4445-8a5e-e46716523820",
                                "sense_id": "a68f2772-b549-376c-95d4-40860603bc72",
                                "text": "„Die neuen Stiefel, die ich erst gestern gekauft hatte, waren benutzt worden; sie waren schlammbespritzt.“"
                            },
                            {
                                "example_id": "2f2665f1-5f5a-4ead-8d7f-541ad3af17f6",
                                "sense_id": "a68f2772-b549-376c-95d4-40860603bc72",
                                "text": "„Zack kletterte aus dem Truck und wollte sich durchs offene Fahrerfenster lehnen, um weiterzureden, doch Court gab Vollgas, fuhr auf der Waldstraße davon nach Süden und ließ seinen schlammbespritzten Ex-Teamchef am Straßenrand stehen.“"
                            },
                            {
                                "example_id": "ea32ecd2-1079-4134-904c-2794efd96917",
                                "sense_id": "a68f2772-b549-376c-95d4-40860603bc72",
                                "text": "„Gladys’ Kleidung war schlammbespritzt, wahrscheinlich vom Regen der letzten Nacht, der nach der Dämmerung eingesetzt hatte.“"
                            },
                            {
                                "example_id": "d7abb51c-b790-402b-b393-920f58f40675",
                                "sense_id": "a68f2772-b549-376c-95d4-40860603bc72",
                                "text": "„Meine geisteskranke Nemesis, so deuchte mir, war mit diesem kläglichen, schlammbespritzten, wohlzerschrammten Wagen hier eingetroffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
