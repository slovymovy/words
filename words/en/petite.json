{
    "word_family": [
        "petiteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ce0ee22-9c33-3255-94e1-8b148a8892d9",
                    "sense_definition": "Fairly short and of slim build, usually describing a woman.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is quite <w>petite</w> and often has trouble finding clothes that fit her small frame.",
                            "target_lang_translations": {
                                "ru": "Она довольно <w>миниатюрная</w>, и ей часто трудно найти одежду, которая подходила бы на её маленькую фигуру."
                            }
                        },
                        {
                            "text": "The <w>petite</w> woman stood on her tiptoes to reach the top shelf of the bookcase.",
                            "target_lang_translations": {
                                "ru": "<w>Миниатюрная</w> женщина встала на цыпочки, чтобы дотянуться до верхней полки книжного шкафа."
                            }
                        }
                    ],
                    "synonyms": [
                        "slight",
                        "small",
                        "dainty"
                    ],
                    "antonyms": [
                        "large",
                        "tall"
                    ],
                    "common_phrases": [
                        "petite woman",
                        "petite frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Довольно невысокого роста и изящного телосложения (обычно о женщине)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миниатюрная",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "изящная",
                                "target_lang_sense_clarification": "о телосложении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc9d2dfa-9c86-3151-8997-b697e0e95d28",
                    "sense_definition": "Of a clothing size designed for women who are shorter than average.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The department store has a dedicated section for <w>petite</w> clothing on the second floor.",
                            "target_lang_translations": {
                                "ru": "В универмаге на втором этаже есть специальный отдел одежды <w>для невысоких</w>."
                            }
                        },
                        {
                            "text": "I always shop in the <w>petite</w> section because regular trousers are always too long for me.",
                            "target_lang_translations": {
                                "ru": "Я всегда закупаюсь в отделе <w>для миниатюрных</w>, потому что обычные брюки мне всегда слишком длинны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "petite section",
                        "petite sizes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размер одежды, предназначенный для женщин ростом ниже среднего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для невысоких",
                                "target_lang_sense_clarification": "о категории одежды"
                            },
                            {
                                "target_lang_word": "миниатюрный",
                                "target_lang_sense_clarification": "о размере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abbe031-1814-3f22-b790-0923508fe890",
                    "sense_definition": "Small or insignificant in scale or importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size_importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Earth and stars are not <w>petite</w> things but grand wonders of nature.",
                            "target_lang_translations": {
                                "ru": "Земля и звезды — это не <w>маленькие</w> вещи, а великие чудеса природы."
                            }
                        },
                        {
                            "text": "He dismissed the problem as a <w>petite</w> matter that did not require his immediate attention.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от проблемы как от <w>незначительного</w> дела, не требующего его немедленного внимания."
                            }
                        }
                    ],
                    "synonyms": [
                        "small",
                        "little",
                        "insignificant",
                        "petty"
                    ],
                    "antonyms": [
                        "grand",
                        "huge",
                        "significant"
                    ],
                    "common_phrases": [
                        "petite things"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой или незначительный по масштабу или важности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маленький",
                                "target_lang_sense_clarification": "незначительный"
                            },
                            {
                                "target_lang_word": "незначительный",
                                "target_lang_sense_clarification": "неважный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1d8436db-6b3a-354d-8c90-eb1eaeb33011",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a family named <w>Petite</w> living in this region during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается семья по фамилии <w>Петит</w>, жившая в этом регионе в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "Mr. <w>Petite</w> was appointed as the new director of the local community center last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце господин <w>Петит</w> был назначен новым директором местного общественного центра."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "This is a less common surname."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Петит",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1190fef7-aeab-3c61-ae08-b49bcc304782",
                    "sense_definition": "A yeast mutant that forms small colonies due to defects in mitochondrial function.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers studied the mitochondrial genomes of these <w>petites</w> to understand the mutation process.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили митохондриальные геномы этих <w>петит-мутантов</w>, чтобы понять процесс мутации."
                            }
                        },
                        {
                            "text": "The <w>petite</w> mutant was first identified in yeast cultures grown on glucose.",
                            "target_lang_translations": {
                                "ru": "<w>Петит-мутант</w> был впервые идентифицирован в культурах дрожжей, выращенных на глюкозе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "petite mutant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мутант дрожжей, образующий мелкие колонии из-за дефектов митохондриальной функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петит-мутант",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
