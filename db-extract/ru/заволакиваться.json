                ],
                "senses": [
                    {
                        "sense_id": "303bf206-a7e5-32ed-b71d-fe23561a85a3",
                        "entry_id": "45232594-d79e-3f23-bf5c-97cd96b68854",
                        "glosses": [
                            "to overcast, to become cloudy, to become dark"
                        ],
                        "tags": [
                            "also",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3d1a497-bc60-469e-8082-d32239c49e8d",
                                "sense_id": "303bf206-a7e5-32ed-b71d-fe23561a85a3",
                                "text": "Едва́ то́лько созна́ние его́ начина́ло завола́киваться тёмной, мя́гкой и сла́достной пелено́й забве́ния, как стра́шный вну́тренний толчо́к вдруг подбра́сывал его́ те́ло.",
                                "translation": "No sooner was his consciousness overcast with the soft, dark, delightful cloud of oblivion than his body was shaken by a terrible inward shock.",
                                "english": "No sooner was his consciousness overcast with the soft, dark, delightful cloud of oblivion than his body was shaken by a terrible inward shock."
                            },
                            {
                                "example_id": "985c9c70-a85f-4fc2-8f8e-a9d83bf62762",
                                "sense_id": "303bf206-a7e5-32ed-b71d-fe23561a85a3",
                                "text": "Выходи́ло со́лнце, и дрожа́щее ожида́нием се́мя завола́кивалось тёплым па́ром, набуха́ло, ло́палось и выпуска́ло со́чный бе́лый росто́к и ни́тку ко́рня.",
                                "translation": "Mikhail Osorgin",
                                "english": "Mikhail Osorgin"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
