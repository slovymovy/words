                                                "example_id": "b09a5250-8aa6-47fb-abcc-9afc4b59a573",
                                                "sense_id": "45038396-ef9f-34ed-a713-96077e85bff9",
                                                "text": "[“Egg Color”:] Cream eggs [“Chicken”:] Polish, Sussexes, Faverolles"
                                            },
