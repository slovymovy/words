                "senses": [
                    {
                        "sense_id": "beda2c36-8ab4-3c28-8285-5f30ab3c2c37",
                        "entry_id": "df32cbc9-10f6-39b1-ac93-50203a98e588",
                        "glosses": [
                            "A long tube woven from jacitara palm leaves, into which cut or mashed cassava roots (manioc) are placed so the poisonous juice can be pressed out of them."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344e080e-c09d-41ba-bc0e-9c056905b9eb",
                                "sense_id": "beda2c36-8ab4-3c28-8285-5f30ab3c2c37",
                                "text": "The lower part of the tipiti is closed, and brought nearly to a point, while the upper part is left open, [...] One of them is then filled with grated cassava, which is thrust into the elastic tube as tightly as possible, [...]"
                            },
                            {
                                "example_id": "d510949a-1056-4f99-ae63-978d5ae0f011",
                                "sense_id": "beda2c36-8ab4-3c28-8285-5f30ab3c2c37",
                                "text": "Underneath the tipiti is placed an earthenware bowl to receive the juice. [...] A pole is passed through the loop at the bottom of the tipiti, nd the shorter end of it is lashed to one of the upright posts of the house. The heavy weight [...] is then hung to the longer end of the pole, so as to produce a powerful leverage on the tipiti, and compress the cassava still further."
                            },
                            {
                                "example_id": "25a2ab75-1e00-48af-9c3f-71a4583c7aa0",
                                "sense_id": "beda2c36-8ab4-3c28-8285-5f30ab3c2c37",
                                "text": "The tipiti was a long tube made of loosely woven palm leaves, wide with an open mouth at the top and closed at the bottom. The top end was suspended from a rafter, and a long pole was placed through a loop at the bottom."
                            }
                        ]
                    }
                ],
