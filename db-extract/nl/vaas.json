                                "target_senses": [
                                    {
                                        "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                        "entry_id": "3535da67-c93b-38bd-8758-1594ccfb02d2",
                                        "glosses": [
                                            "To place in a vase or similar container."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b87893-1415-4360-b768-9e18a7035679",
                                                "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                                "text": "She bought only pastel pencils and vased them in cups, great wooden bouquets in mugs on nightstands and kitchen chairs."
                                            },
                                            {
                                                "example_id": "f8095057-1c30-4943-a082-407bb01c8792",
                                                "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                                "text": "After she'd finished, she picked a bouquet of wildflowers and vased them in an old mason jar. That seemed a fitting centerpiece for the table."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5abafb53-55ce-4f84-92ef-898f1a1c8ae0",
                        "source_entry_id": "511478bd-3206-32e3-a5c6-dce5b4c98b9b",
                        "source_sense_id": "760aff41-0194-3e4b-8e87-2bd7132214fc",
                        "source_sense_description": "een aardewerken of glazen kruik, vooral bedoeld voor het in het water zetten van bloemen",
                        "target_lang_word": "vase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                        "entry_id": "ad67a86f-89ab-3595-b1dd-e5b565546e93",
                                        "glosses": [
                                            "Bourbe, limon qui se dépose au fond de la mer, des fleuves, des étangs, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec429353-704d-4212-a7f6-e2c68c44e787",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Le curage des vases de la Darse au moyen d’un dragueur à la vapeur de la force de 14 chevaux, a été complet en 1837."
                                            },
                                            {
                                                "example_id": "c2457fbf-6b47-40be-8079-604de2612a66",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Ver de vase ou ver vaseux, larve d’un moucheron vivant dans la vase, utilisé comme appât par les pêcheurs."
                                            },
                                            {
                                                "example_id": "a8d4f840-f879-4c97-8e66-559b69fb37b0",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Vase atmosphérique, poussières, gouttelettes et autres particules en suspension descendant dans les basses couches de l’atmosphère."
                                            },
                                            {
                                                "example_id": "1e595964-9a9f-4900-924e-f22115567565",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Ces vases fluides, appelées « crème de vase » en français, peuvent se déplacer sous l’effet des courants et de la pente du fond."
                                            },
                                            {
                                                "example_id": "add0ca51-d1c1-49e3-8aa6-079cf057495a",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Un bateau à vapeur du service municipal de la Tamise heurta si violemment le ponton de Westminster qu’il n’échappa au naufrage qu’en allant s’enliser sur la rive opposée, dans la vase découverte par la marée basse."
                                            },
                                            {
                                                "example_id": "47933ec2-7a82-4c40-bec4-3ce8e58efef4",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Comme si elle savait ce que c’est que la vase… La vase, cette argile gris de perle, si douce aux orteils nus, mystérieusement musquée, elle la confond avec les gadoues."
                                            },
                                            {
                                                "example_id": "c886c6d5-386f-4414-b1f8-be3b2129a4a4",
                                                "sense_id": "1145775e-660d-356f-90d7-a4bd45d271c7",
                                                "text": "Tu croyais fouler le sol ferme, une piste —une pissate— te fier à son gazon honnête, il branle au même instant, la vase qu’il dissimule fait irruption à la surface, gargouille, emplit ta chaussure de sa rouille putride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a62ae4-64f2-33aa-88f3-0b9093dcc968",
                                        "entry_id": "ad67a86f-89ab-3595-b1dd-e5b565546e93",
                                        "glosses": [
                                            "Eau, en particulier pluie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "523e5756-f3c7-4a8a-8abc-12ff04a8c4d9",
                                                "sense_id": "c6a62ae4-64f2-33aa-88f3-0b9093dcc968",
                                                "text": "La vase qui tombait de plus en plus serré, semblait passer les trottoirs au cirage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6d5a0e-0374-3ac8-b70e-680d9613cd9c",
                                        "entry_id": "13671d5d-df18-3ec1-965d-9e45887e7cd4",
                                        "glosses": [
                                            "Récipient pour contenir un fluide ou une substance granuleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04943aa4-575b-4215-831f-316d78a1c20d",
                                                "sense_id": "1a6d5a0e-0374-3ac8-b70e-680d9613cd9c",
                                                "text": "Le principe des vases communicants."
                                            },
                                            {
                                                "example_id": "5351d895-3056-4afc-a612-061ad56a3c06",
                                                "sense_id": "1a6d5a0e-0374-3ac8-b70e-680d9613cd9c",
                                                "text": "L’installation comporte une chaudière, un circuit de distribution, des radiateurs, et aussi un organe important: le vase d’expansion, placé au point le plus élevé de la canalisation, et destiné à permettre à l’eau de tout le système de se dilater sous l’influence de la chaleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0b9594-b28b-3776-a38b-1b06dca78b1d",
                                        "entry_id": "13671d5d-df18-3ec1-965d-9e45887e7cd4",
                                        "glosses": [
                                            "Récipient de forme allongée, posé debout, utilisé pour contenir un liquide, des cendres, ou pour décorer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cdeda42-b1d0-46c4-a80d-41d10b7bd398",
                                                "sense_id": "9e0b9594-b28b-3776-a38b-1b06dca78b1d",
                                                "text": "L’ombre et le gel habitent la chambre où les colchiques mauves s’épanouissaient, en automne, dans le vase que tu m’as donné."
                                            },
                                            {
                                                "example_id": "ebfee5b6-07ea-4601-9e09-d2ddd7f942a9",
                                                "sense_id": "9e0b9594-b28b-3776-a38b-1b06dca78b1d",
                                                "text": "Ces résidus d’opium ont été retrouvés dans des vases en céramique découverts à Yehud (centre), dans des tombes cananéennes mises au jour en 2012 et vieilles de plus de 3 500 ans."
                                            },
                                            {
                                                "example_id": "1be9b8a0-98dc-454c-b7b3-b4bcce784e2a",
                                                "sense_id": "9e0b9594-b28b-3776-a38b-1b06dca78b1d",
                                                "text": "Aujourd’hui, on y fabrique des vases, des cruches, des pots, des cache-pots. Mais attention, ils ne sont pas de la même couleur qu’à Soufflenheim ! Rien à voir !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a10bdd-8b7b-3b29-b6a8-068a62a903be",
                                        "entry_id": "13671d5d-df18-3ec1-965d-9e45887e7cd4",
                                        "glosses": [
                                            "Apocope de vase de nuit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdb59eb-f335-4e89-ad46-690b1097f44a",
                                                "sense_id": "60a10bdd-8b7b-3b29-b6a8-068a62a903be",
                                                "text": "À cause de l’orage, la distribution a lieu dans un dortoir, —un dortoir dont on a enlevé les lits en les entassant avec leurs accessoires dans une salle voisine. On voyait dans cette salle par une porte vitrée, qui aurait dû avoir un rideau, mais n’en avait pas ; on distinguait des vases en piles, des vases qui pendant l’année servaient, mais qu’on retirait de dessous les lits pendant les vacances. On en avait fait une pyramide blanche."
                                            },
                                            {
                                                "example_id": "0d079128-d9ed-4328-9fde-3a9d0eb95aa9",
                                                "sense_id": "60a10bdd-8b7b-3b29-b6a8-068a62a903be",
                                                "text": "— Les cabinets sont au bout du champ de pommes de terre qui est après le jardin à gauche. Le jardin est tout de suite derrière la cour. Vous trouverez facilement… Maintenant vous avez un vase sous le premier lit à droite en venant de la porte… Je vous recommande de ne le remplir qu’à moitié rapport à une fente qu’il a dans le haut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daa0e00-25f7-3d44-94a9-c6335ff164f6",
                                        "entry_id": "13671d5d-df18-3ec1-965d-9e45887e7cd4",
                                        "glosses": [
                                            "Calice de certaines fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e584483-d08c-4df9-91e8-b2b27d836f8d",
                                                "sense_id": "8daa0e00-25f7-3d44-94a9-c6335ff164f6",
                                                "text": "Le vase de cette tulipe est trop ouvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4de40ff4-7221-3d5c-9239-194f4efef492",
                                        "entry_id": "13671d5d-df18-3ec1-965d-9e45887e7cd4",
                                        "glosses": [
                                            "Au billard électrique, la sortie de la bille en bas du plateau de jeu ; la perte de la bille en jeu, de cette façon."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2239f04c-73b7-4713-abc0-8f617c68d80b",
                                                "sense_id": "4de40ff4-7221-3d5c-9239-194f4efef492",
                                                "text": "Juste à quelques malheureux points de la partie gratuite, je me suis pris un vase."
                                            },
                                            {
                                                "example_id": "1d243f61-9962-4eaa-81c0-d97a692a7779",
                                                "sense_id": "4de40ff4-7221-3d5c-9239-194f4efef492",
                                                "text": "La boule est allée tout droit au vase."
                                            }
                                        ]
                                    }
                                ]
                            },
