                "senses": [
                    {
                        "sense_id": "9f0ae3a7-166a-330a-95dc-03f89f7a865b",
                        "entry_id": "b9b98cb6-79f1-3416-83ab-d339902b32f6",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße wohlerprobte, althergebrachte (konservative) Aspekte zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06edb02-84e2-4196-877a-eb2801956cf9",
                                "sense_id": "9f0ae3a7-166a-330a-95dc-03f89f7a865b",
                                "text": "„Die für Mercedes als typisch geltende Konservativität spiegelt sich auch in den Ergebnissen der Erhebung wider, denn mit einem Mittelwert von 7,02 wird die Eigenschaft als passend angesehen.“"
                            },
                            {
                                "example_id": "0219f55c-8064-4cdc-806f-deb1fa5c3084",
                                "sense_id": "9f0ae3a7-166a-330a-95dc-03f89f7a865b",
                                "text": "„Konservativität wird hierbei in Anlehnung an Wilson umschrieben als die Bevorzugung der bestehenden und traditionellen Institutionen, der Widerstand gegenüber Änderungen und eine grundsätzlich vorsichtige und bedächtige Einstellung. Weiterhin wird Konservativität in enge Verbindung zu Obrigkeitsdenken und Innovationsfreindlichkeit gebracht.“"
                            },
                            {
                                "example_id": "a9f6cc95-dc9d-4123-9baa-96236c2c2c5f",
                                "sense_id": "9f0ae3a7-166a-330a-95dc-03f89f7a865b",
                                "text": "„Dieses Gebiet war vielmehr weit offen auch für überzogene Forderungen besorgter Sachverständiger, die sich nur aus der Kumulation von vielen einzelnen Konservativitäten in der Berechnungskette für einen Störfall ergaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
