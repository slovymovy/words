                "senses": [
                    {
                        "sense_id": "41c3d1d7-87bd-3dc7-acee-5c5f8457a46b",
                        "entry_id": "c739d52c-28b0-34a3-a2e6-fc668d8cf878",
                        "glosses": [
                            "Faire se décrémenter automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8a4582-4103-4ab7-9225-f7d166d91e88",
                                "sense_id": "41c3d1d7-87bd-3dc7-acee-5c5f8457a46b",
                                "text": "Une structure de pile peut être construite en mémoire en initialisant un registre d’index à une certaine position de la mémoire, en autodécrémentant le registre d’index afin de pointer à une nouvelle position mémoire puis en sauvant des valeurs sur la pile par des instructions de transfert des registres vers la pile."
                            },
                            {
                                "example_id": "c5d40df0-7d02-4c03-bd08-10f14dd40811",
                                "sense_id": "41c3d1d7-87bd-3dc7-acee-5c5f8457a46b",
                                "text": "On a de la même façon des adressages autodécrémentés, ce qui s’exprime par les notations LOAD A, {XX +} post-autoincrémenté LOAD A, {+ XX} pré-autoincrémenté LOAD A, {XX -} post-autodécrémenté LOAD A, {-XX} pré-autodécrémenté"
                            }
                        ]
                    }
