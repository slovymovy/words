{
    "word_family": [
        "heiden",
        "heidendom"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7470b7a1-49d5-3f7d-a595-50cd6c4e8046",
                    "sense_definition": "Betrekking hebbend op het heidendom of de heidenen; niet behorend tot een van de monotheïstische wereldgodsdiensten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Europa zijn veel oude, <w>heidense</w> rituelen bewaard gebleven in lokale feesten.",
                            "target_lang_translations": {
                                "en": "In Europe, many old, <w>pagan</w> rituals have been preserved in local festivals."
                            }
                        },
                        {
                            "text": "Zij bestuderen de <w>heidense</w> tradities van de vroege bewoners van deze regio.",
                            "target_lang_translations": {
                                "en": "They study the <w>pagan</w> traditions of the early inhabitants of this region."
                            }
                        }
                    ],
                    "synonyms": [
                        "pagaans"
                    ],
                    "common_phrases": [
                        "heidense_rituelen",
                        "heidense_tradities"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to paganism or pagans; not belonging to one of the monotheistic world religions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pagan",
                                "target_lang_sense_clarification": "relating to non-monotheistic religions"
                            },
                            {
                                "target_lang_word": "heathen",
                                "target_lang_sense_clarification": "relating to people or customs not belonging to a major religion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58bd4e14-7207-341f-820c-466a14b73b0d",
                    "sense_definition": "Buitengewoon groot, zwaar of intens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_groot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schoonmaken van de hele zolder na de lekkage was een <w>heidens</w> karwei.",
                            "target_lang_translations": {
                                "en": "Cleaning the entire attic after the leak was a <w>hell of a</w> job."
                            }
                        },
                        {
                            "text": "We moesten in de vroege ochtend opstaan, wat een <w>heidens</w> kabaal veroorzaakte.",
                            "target_lang_translations": {
                                "en": "We had to get up in the early morning, which caused an <w>almighty</w> racket."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heidens_karwei",
                        "heidens_kabaal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in vaste verbindingen zoals 'een heidens karwei' of 'een heidens kabaal'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely large, heavy, difficult, or intense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hell of a",
                                "target_lang_sense_clarification": "used to emphasize how difficult or intense something is"
                            },
                            {
                                "target_lang_word": "herculean",
                                "target_lang_sense_clarification": "requiring great strength or effort"
                            },
                            {
                                "target_lang_word": "almighty",
                                "target_lang_sense_clarification": "extremely great or loud"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a074fb6-3fd0-369a-bebe-ad65a6cec93f",
                    "sense_definition": "Onbeschaafd, wild of goddeloos.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbeschaafd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>heidense</w> gedrag op het nette feest wekte veel verbazing bij de gasten.",
                            "target_lang_translations": {
                                "en": "His <w>heathen</w> behavior at the formal party caused a lot of surprise among the guests."
                            }
                        },
                        {
                            "text": "Zij vonden die moderne muziek maar een <w>heidens</w> lawaai.",
                            "target_lang_translations": {
                                "en": "They thought that modern music was nothing but a <w>barbaric</w> noise."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Uncivilized, wild, or godless."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heathen",
                                "target_lang_sense_clarification": "uncivilized or wild"
                            },
                            {
                                "target_lang_word": "pagan",
                                "target_lang_sense_clarification": "uncivilized or immoral"
                            },
                            {
                                "target_lang_word": "barbaric",
                                "target_lang_sense_clarification": "wild and unsophisticated"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac3ffb96-cf13-3d2f-b72a-766bc09004dc",
                    "sense_definition": "Niet-Joods; betrekking hebbend op volkeren buiten het Joodse geloof.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische teksten wordt vaak het onderscheid gemaakt tussen Joodse en <w>heidense</w> gemeenschappen.",
                            "target_lang_translations": {
                                "en": "In historical texts, a distinction is often made between Jewish and <w>gentile</w> communities."
                            }
                        },
                        {
                            "text": "Deze wetten waren destijds niet van toepassing op de <w>heidense</w> bevolking.",
                            "target_lang_translations": {
                                "en": "These laws did not apply to the <w>gentile</w> population at the time."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Gentile; relating to peoples or nations outside of the Jewish faith."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gentile",
                                "target_lang_sense_clarification": "non-Jewish"
                            },
                            {
                                "target_lang_word": "pagan",
                                "target_lang_sense_clarification": "non-Jewish or heathen in historical contexts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}