                                "target_senses": [
                                    {
                                        "sense_id": "76809c1d-983b-3ee0-9ebd-1c367b7b2285",
                                        "entry_id": "9d96dbda-77de-3d25-abcc-ad42a1da739a",
                                        "glosses": [
                                            "A basic truth, elementary concept, principle, rule, or law. An individual fundamental will often serve as a building block used to form a complex idea."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "753da27d-d826-3fdf-b6bf-c5c833eaac0a",
                                        "entry_id": "9d96dbda-77de-3d25-abcc-ad42a1da739a",
                                        "glosses": [
                                            "A collection of essential component ideas that are often grouped together to serve as the foundational basis of a complex idea."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6491ce98-0388-427a-86e4-fbb5f17f1ef4",
                                                "sense_id": "753da27d-d826-3fdf-b6bf-c5c833eaac0a",
                                                "text": "one of the fundamentals of linear algebra"
                                            },
                                            {
                                                "example_id": "67940440-8f5f-4ca0-986c-a5cfde55061d",
                                                "sense_id": "753da27d-d826-3fdf-b6bf-c5c833eaac0a",
                                                "text": "When any one offers me a compleat Catalogue of his Fundamentals, he does not unreaſonably demand me to quit mine for nothing[…]"
                                            },
                                            {
                                                "example_id": "bddfd29d-da14-4072-b951-76b70e419264",
                                                "sense_id": "753da27d-d826-3fdf-b6bf-c5c833eaac0a",
                                                "text": "Personal leadership is a fundamental of successful government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155ac10d-eb3a-37cd-b75a-f8aa9952a332",
                                        "entry_id": "9d96dbda-77de-3d25-abcc-ad42a1da739a",
                                        "glosses": [
                                            "The lowest frequency of a periodic waveform."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "296bb5dd-8229-325b-a4e9-afbccf119f51",
                                        "entry_id": "9d96dbda-77de-3d25-abcc-ad42a1da739a",
