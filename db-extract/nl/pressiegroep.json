                                "example_id": "54fc1345-004d-4997-8515-6a7cd76f758c",
                                "sense_id": "f7dabd22-3487-3282-a988-38059df30c3b",
                                "text": "1965, Paul van 't Veer, De helden van onze tijd, Bezige Bij, page 44.\nDe lobbyisten ('lobbies' zijn de wandelgangen van het parlementsgebouw, waar in meer primitieve tijden de senatoren door vertegenwoordigers der pressiegroep werden benaderd) hebben andere wegen gevonden.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "cc9ca069-479d-4de1-beae-e6bb5f998494",
                                "sense_id": "f7dabd22-3487-3282-a988-38059df30c3b",
                                "text": "Ambtenaren en politici worden vaak benaderd door pressiegroepen.",
                                "translation": "Government officials and politicians are often approached by pressure groups.",
                                "english": "Government officials and politicians are often approached by pressure groups."
                            }
                        ]
