                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Кармен</w> этим летом едет в Испанию навестить родственников."
                            }
                        },
                        {
                            "text": "The opera <w>Carmen</w> features one of the most famous female protagonists in musical history.",
                            "target_lang_translations": {
