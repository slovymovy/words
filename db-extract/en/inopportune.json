                            "comparative"
                        ],
                        "form": "more inopportune"
                    },
                    {
                        "form_id": "19378e49-6f85-4ebb-a40f-358a2fe6ab6c",
                        "entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inopportune"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                        "entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                        "glosses": [
                            "Unsuitable for some particular purpose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722f0fe4-6688-4f5f-9574-90afd10e042c",
                                "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                                "text": "That was a most inopportune spot for a picnic."
                            },
                            {
                                "example_id": "05f4cf77-56c3-4452-8029-fe875eedeb34",
                                "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                                "text": "\"It appears I come at an inopportune time, madam,\" said he, \"when my friend, Mr. Rochester, is from home; but I arrive from a very long journey, and I think I may presume so far on old and intimate acquaintance as to install myself here till he returns.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                        "entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                        "glosses": [
                            "Happening/occurring at an inconvenient or inappropriate time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98bf4276-e6cf-433d-9288-3b1dd27e1934",
                                "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                                "text": "The inopportune arrival of the bus cut short the interesting conversation."
                            },
                            {
                                "example_id": "c7655ef2-9f5a-4831-bbdd-96a5324cca85",
                                "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                                "text": "The object is to keep the yard operators apprised of main-line movements, so that they do not plan to occupy the main lines with activity into or out of the yard at an inopportune juncture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "197511ea-154b-47c9-aee1-88861aae6a24",
                        "source_entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                        "source_sense_description": "unsuitable for some particular purpose",
                        "target_lang_word": "ongeschikt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongeschikt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6955da42-dc09-3279-8d7e-b2ce05f0d8f5",
                                        "entry_id": "565a16c2-58ff-3e18-a2b5-8bec9c3e179e",
                                        "glosses": [
                                            "niet goed voor wat je ermee wilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f8940c-1dab-4121-9a28-440c5eb53a69",
                                                "sense_id": "6955da42-dc09-3279-8d7e-b2ce05f0d8f5",
                                                "text": "Hij is een ongeschikte kandidaat voor deze functie."
                                            },
                                            {
                                                "example_id": "827471be-e8ad-4004-8eab-6578d0bca357",
                                                "sense_id": "6955da42-dc09-3279-8d7e-b2ce05f0d8f5",
                                                "text": "De glooiende velden in Calabrië bijvoorbeeld waren voor moderne, grootschalige landbouw ongeschikt geworden, vertelt Cusani. Hennepplanten, die zo kostbaar zijn dat ze sowieso met de hand bewerkt moeten worden, vormen wel een ideale begroeiing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93eeaf83-1624-4ee6-b5e0-7a5674653d86",
                        "source_entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                        "source_sense_description": "unsuitable for some particular purpose",
                        "target_lang_word": "ongepast",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongepast",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                                        "entry_id": "51103c04-da06-3ba2-934e-b5da8de95a06",
                                        "glosses": [
                                            "niet gepast, niet geschikt voor een situatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c8e15c-d724-44e0-8f9b-ec39e8c3705f",
                                                "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                                                "text": "Die opmerking is ongepast."
                                            },
                                            {
                                                "example_id": "26e4338c-bc94-4193-b6a1-7adc9b6f300d",
                                                "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                                                "text": "De vrouw vindt niet dat ze de schuld moet dragen voor een systeem. Op de vraag of ze spijt heeft van haar reactie, antwoordt de telefoniste: ,,Laten we zeggen dat het ongepast was.” De telefoniste zou volgens haar advocaat gemiddeld 2000 telefoontjes per dag verwerken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b3765fd-487d-3995-a809-7f8c996a7606",
                                        "entry_id": "51103c04-da06-3ba2-934e-b5da8de95a06",
                                        "glosses": [
                                            "van kleding, niet geprobeerd of het de juiste grootte heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95b928ce-c550-4630-9fe9-89880788c286",
                                                "sense_id": "6b3765fd-487d-3995-a809-7f8c996a7606",
                                                "text": "Ik heb de broek ongepast gekocht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d72bf6-88fc-4753-a1a3-1cc4e56bae54",
