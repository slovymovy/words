                        "entry_id": "04f11582-4064-36ad-8911-6e6f51fd1254",
                        "glosses": [
                            "Qui a un brevet, en parlant de son titulaire ou de la chose soumise à brevet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c694c7e7-87ed-4a3b-a155-c5fe04935352",
                                "sense_id": "31d0ddd8-3d8a-3d7c-801c-18b8479e56a2",
                                "text": "Un inventeur breveté."
                            },
                            {
                                "example_id": "e55f7f1d-8eb6-4ce9-9005-d49ed36a6d92",
                                "sense_id": "31d0ddd8-3d8a-3d7c-801c-18b8479e56a2",
                                "text": "On y vit successivement une huile nouvelle pour faire pousser les cheveux, des appareils orthopédiques, une cafetière automatique, invention brevetée, dont l’exploitation lui donna bien du mal."
                            }
                        ]
                    }
