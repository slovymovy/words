                    {
                        "translation_id": "a58cad11-a6d3-4769-8125-491f47d6cb72",
                        "source_entry_id": "465a3f17-099c-3ae0-aa35-76d4f9c15cc0",
                        "target_lang_word": "Hindu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hindu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5313e42c-a65f-393f-9113-bb38bf323e1c",
                                        "entry_id": "c324046d-b701-3efc-94f6-929a77a2ce10",
                                        "glosses": [
                                            "an den Hinduismus glaubender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb07bf1-1897-4169-af6f-eab4e7f7fb07",
                                                "sense_id": "5313e42c-a65f-393f-9113-bb38bf323e1c",
                                                "text": "Bei seiner Rundreise durch Indien traf er mehrere Hindus, die ihn alle freundlich empfangen haben."
                                            },
                                            {
                                                "example_id": "caa71c76-1489-499a-9714-04aba7272b1f",
                                                "sense_id": "5313e42c-a65f-393f-9113-bb38bf323e1c",
                                                "text": "„Viele Muslime fanden sich auf der indischen Seite der Trennlinie, viele Hindus und Sikhs auf der pakistanischen.“"
                                            },
                                            {
                                                "example_id": "90f2d2fe-81f1-44b2-9b1a-1c4da08922e9",
                                                "sense_id": "5313e42c-a65f-393f-9113-bb38bf323e1c",
                                                "text": "„Die Identität der Sindhis bildete sich durch die Abgrenzung zu den bis 1947 in Administration und Wirtschaft dominanten Hindus im Sindh heraus und festige sich nach der Teilung Indiens.“"
                                            },
                                            {
                                                "example_id": "99a63b57-f8d9-4dc0-826d-94a7020968a7",
                                                "sense_id": "5313e42c-a65f-393f-9113-bb38bf323e1c",
                                                "text": "„Haben Sie je ein »Wort zum Sonntag« von einem esoterischen Guru, einem muslimischen Imam oder den Gemeinschaften der Zeugen Jehovas, der Mennoniten, der Juden, der orthodoxen Christen, der Buddhisten, der Hindus oder der Sikhs gesehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cf28546-75be-382c-aaa6-00e745804e67",
                                        "entry_id": "c324046d-b701-3efc-94f6-929a77a2ce10",
                                        "glosses": [
                                            "veraltet: Inder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6eb6165-743a-46d3-99de-ed115843b0df",
                                                "sense_id": "3cf28546-75be-382c-aaa6-00e745804e67",
                                                "text": "„Der junge Hindu freilich ist optimistisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hindu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
