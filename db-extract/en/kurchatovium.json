                "senses": [
                    {
                        "sense_id": "d2477c8e-8947-3f7b-aff7-fb2ccc57f248",
                        "entry_id": "01562127-55d2-3ce9-ad95-272e5ef302aa",
                        "glosses": [
                            "A rejected name for rutherfordium."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a7326de-08c3-41a5-a6f4-51567e1a6eb9",
                                "sense_id": "d2477c8e-8947-3f7b-aff7-fb2ccc57f248",
                                "text": "Research on the production and properties of kurchatovium isotopes has continued; Ghiorso et al. exposed Cf²⁴⁹ to C¹² and C¹³ ions to produce two new α-active isotopes of kurchatovium (which they called rutherfordium, Rf) having A fo 257 and 259, the T_(1/2) being 4.5 and 3 sec respectively."
                            },
                            {
                                "example_id": "6f897849-7bc2-492e-8752-6b128112c5c3",
                                "sense_id": "d2477c8e-8947-3f7b-aff7-fb2ccc57f248",
                                "text": "Kurchatovium-260 was obtained by bombarding a target of plutonium-242 with accelerated neon-22 ions. As to its chemical properties, kurchatovium differs from actinide elements but is close to hafnium."
                            }
                        ]
                    }
                ],
