                    },
                    {
                        "translation_id": "d4f7a828-cd2c-46a3-a7aa-8b58b4e3cbad",
                        "source_entry_id": "de06ea38-88dc-311f-a177-c73845398e5c",
                        "target_lang_word": "stifling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stifling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                        "entry_id": "c37b563b-971f-3e83-a4e7-fca29a3b1f3e",
                                        "glosses": [
                                            "That stifles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97cc1e41-50a0-4839-a681-9bfdbaafbba9",
                                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                                "text": "The heat was stifling; it seemed hard to breathe and the exertion of rolling over on the bed seemed too much."
                                            },
                                            {
                                                "example_id": "47a87e85-c3cb-4927-86ec-09d60963b323",
                                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                                "text": "The oppression of the cabin was stifling, and Evelyn had left her; she could not bear his absence, and she followed him."
                                            },
                                            {
                                                "example_id": "5eb79199-c568-4514-8554-a82c84c79b7a",
                                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                                "text": "Who would go back to the stifling, wicked cities of civilized man when the mighty reaches of the great jungle offered peace and liberty? Not he."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stifling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab68c48-95e4-306c-8c54-8e9f3155b55f",
                                        "entry_id": "74af572b-b730-3922-9f9e-68d20cccddfb",
                                        "glosses": [
                                            "present participle and gerund of stifle"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stifling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c88e26ea-6de2-3be8-9895-1d1f06029778",
                                        "entry_id": "c78f7099-328b-3fc6-884b-2c8e65cbe340",
                                        "glosses": [
                                            "The act by which something is stifled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d368fc31-fb94-452f-a5d1-693c88b13c72",
                                                "sense_id": "c88e26ea-6de2-3be8-9895-1d1f06029778",
                                                "text": "Every man who is destroyed must destroy himself. When a man stifles an admonition of conscience, he may fairly be said to sow the stiflings of conscience."
                                            },
                                            {
                                                "example_id": "e70fb5fc-4dce-452b-bfc4-ca452d64b113",
                                                "sense_id": "c88e26ea-6de2-3be8-9895-1d1f06029778",
                                                "text": "Despite this, Mott McDonald's report says: \"Following the loss of employment in mining and manufacturing opportunities across the area, a lack of connectivity and accessibility to new opportunities has led to the stifling of development and inward investment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ea9c813-0113-4826-bbf9-cdef38bda2dc",
                        "source_entry_id": "de06ea38-88dc-311f-a177-c73845398e5c",
                        "target_lang_word": "muggy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muggy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                        "entry_id": "48d82e8c-1082-3cd4-a807-31d362ac06d4",
                                        "glosses": [
                                            "Humid, or hot and humid."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc32d51d-5c91-489b-9275-aafbd51cb609",
                                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                                "text": "The next was a very unpropitious morning for a journey—muggy, damp, and drizzly."
                                            },
                                            {
                                                "example_id": "afc05830-7b3e-4eca-8bc6-1c2350b58675",
                                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                                "text": "What struck me as the most curious thing about this wonderful river was: how did the air keep fresh? It was muggy and thick, no doubt, but still not sufficiently so to render it bad or even remarkably unpleasant."
                                            },
                                            {
                                                "example_id": "e42eb1d1-f9d0-4f91-a067-7067ab57f683",
                                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                                "text": "The evening, though sunless, had been warm and muggy for the season, and Tess had come out with her milking-hood only, naked-armed and jacketless; certainly not dressed for a drive."
                                            },
                                            {
                                                "example_id": "8f282448-3ef9-4b39-aa6d-cf08ebab21f1",
                                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                                "text": "Muggy heat—temperature in the 90s and high humidity—greeted early arrivals for the 72-hole, three-day test, rated the hardest and most important in the sport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f22073a-bdf1-347a-8c2c-825c72509705",
                                        "entry_id": "48d82e8c-1082-3cd4-a807-31d362ac06d4",
                                        "glosses": [
                                            "Wet or mouldy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a9c4260-1b5d-4407-9e7c-e6b352689adc",
                                                "sense_id": "5f22073a-bdf1-347a-8c2c-825c72509705",
                                                "text": "muggy straw"
                                            }
                                        ]
                                    },
