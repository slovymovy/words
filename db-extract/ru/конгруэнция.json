                    {
                        "translation_id": "bca4c142-03f6-46c5-b516-71673770b1eb",
                        "source_entry_id": "f6d81006-234d-3129-a445-ea4dee329736",
                        "source_sense_id": "481b1671-70ed-3e4f-913b-2b13dac795e2",
