    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34dcd90b-65e7-370c-abbc-0bfb1c41edf7",
                    "sense_definition": "Quantité déterminée de nourriture attribuée à une personne ou à un animal pour un repas ou une journée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vétérinaire a conseillé de réduire la <w>ration</w> de croquettes du chien."
                        },
                        {
                            "text": "Après cette longue marche en forêt, les randonneurs ont dévoré une double <w>ration</w> de soupe."
                        }
                    ],
                    "synonyms": [
                        "portion",
                        "dose",
                        "part"
                    ],
                    "common_phrases": [
                        "ration quotidienne",
                        "double ration"
                    ]
                },
                {
                    "sense_id": "cf07b07a-d6b9-3173-8594-eb9ae46f2665",
                    "sense_definition": "Portion fixe de vivres ou de fournitures distribuée aux soldats, aux marins ou aux civils en temps de pénurie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée distribuait chaque matin une <w>ration</w> de survie aux troupes en mission."
                        },
                        {
                            "text": "Pendant le blocus, chaque habitant devait se contenter d'une <w>ration</w> très limitée de farine."
                        }
                    ],
                    "synonyms": [
                        "pitance"
                    ],
                    "common_phrases": [
                        "ration de survie",
                        "ration militaire"
                    ]
                },
                {
                    "sense_id": "fb3c0a07-fcf5-366d-b1f2-99badd9a7ff6",
                    "sense_definition": "Part ou lot qui revient à quelqu'un, généralement en parlant de choses pénibles ou désagréables.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet complexe lui a apporté sa <w>ration</w> de difficultés et de soucis."
                        },
                        {
                            "text": "En rentrant en retard sans prévenir, l'adolescent a essuyé une belle <w>ration</w> de reproches."
                        }
                    ],
                    "synonyms": [
                        "lot",
                        "part"
                    ],
                    "common_phrases": [
                        "ration de reproches",
                        "ration d'épreuves"
                    ]
                }
            ]
        }
    ]
