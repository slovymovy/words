                                    {
                                        "sense_id": "6cc44e86-26e9-3014-9c0d-f328ce8a9f8f",
                                        "entry_id": "e852275e-7503-38ab-925d-8d051e318a17",
                                        "glosses": [
                                            "Mettre en corrélation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e389fa4-4853-4439-856a-481fb07aa55f",
                                                "sense_id": "6cc44e86-26e9-3014-9c0d-f328ce8a9f8f",
                                                "text": "La méthode utilisée par les scientifiques dans les années 1970 a été de corréler les variations océaniques avec celles de l'insolation."
                                            },
                                            {
                                                "example_id": "6288fd44-fa9a-403e-a161-205a7a3cb41d",
                                                "sense_id": "6cc44e86-26e9-3014-9c0d-f328ce8a9f8f",
                                                "text": "Comme les précédents auteurs, nous n’avons pas résisté à la tentation de corréler les stades mis en évidence dans la vallée de l’Arve avec ceux de l’échelle des Alpes orientales."
                                            },
                                            {
                                                "example_id": "4f93e3dc-90cb-451e-8d19-1aabb8bcfd34",
                                                "sense_id": "6cc44e86-26e9-3014-9c0d-f328ce8a9f8f",
                                                "text": "Des expressions faciales que l'on associe à l'amusement, la colère, la crainte, la concentration, la confusion, le mépris, le contentement, le désir, la déception, le doute, la douleur, la tristesse, la surprise et le triomphe ont ainsi pu être analysées.\n Ensuite, les chercheurs ont corrélé ces expressions faciales avec les contextes dans lesquels elles se sont produites dans les différentes régions du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa4489d-b53f-3912-8ce2-1f8874030ef4",
                                        "entry_id": "e852275e-7503-38ab-925d-8d051e318a17",
                                        "glosses": [
                                            "Être en corrélation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77709d7d-45ea-4f0c-8aeb-6c9bd6c5527e",
                                                "sense_id": "baa4489d-b53f-3912-8ce2-1f8874030ef4",
                                                "text": "Les résultats obtenus démontrent que l’aspect scientifique de la démarche corrélait bien avec les éléments du terrain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
