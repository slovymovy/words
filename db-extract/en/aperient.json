                        "glosses": [
                            "A laxative, either in the form of a medicine or a food such as asparagus or hops, which has the effect of moving the bowels, or aiding digestion and preventing constipation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe78869-e79e-4959-85a0-329f45035383",
                                "sense_id": "1992f27e-e32c-3361-ade8-94776acb4065",
                                "text": "In its fresh vegetable state, chicory, or succory—the Cichorium Intybus of botanists, is said to be a good tonic, and to have the effect of an aperient."
                            }
                        ]
                    }
