    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e5fa694-4545-3a76-a7fb-8628d511aa78",
                    "sense_definition": "stawać się słabiej widocznym, słyszalnym lub odczuwalnym; stopniowo niknąć",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W miarę oddalania się od miasta sygnał radiowy stopniowo <w>zanikał</w>.",
                            "target_lang_translations": {
                                "ru": "По мере удаления от города радиосигнал постепенно <w>пропадал</w>."
                            }
                        },
                        {
                            "text": "Z wiekiem jego objawy chorobowe powoli <w>zanikają</w>.",
                            "target_lang_translations": {
                                "ru": "С возрастом симптомы его болезни медленно <w>проходят</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "niknąć",
                        "słabnąć",
                        "zacierać się",
                        "zamazywać się"
                    ],
                    "antonyms": [
                        "nasilać się",
                        "wzmagać się"
                    ],
                    "common_phrases": [
                        "sygnał zanika",
                        "bóle zanikają",
                        "zanikać powoli"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться менее заметным, слышным или ощутимым; постепенно угасать или ослабевать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "постепенно ослабевать (о чувствах, звуках)"
                            },
                            {
                                "target_lang_word": "пропадать",
                                "target_lang_sense_clarification": "исчезать, теряться (о сигнале, звуке)"
                            },
                            {
                                "target_lang_word": "затихать",
                                "target_lang_sense_clarification": "ослабевать по силе или громкости"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "становиться слабее (о симптомах, боли)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3982ea41-f5aa-3be1-9974-14d34b1e2aea",
                    "sense_definition": "przestawać stopniowo istnieć, ulegać zanikowi lub wymarciu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tradycyjne rzemiosło niestety <w>zanika</w> we współczesnym świecie.",
                            "target_lang_translations": {
                                "ru": "Традиционные ремёсла, к сожалению, <w>исчезают</w> в современном мире."
                            }
                        },
                        {
                            "text": "Te stare zwyczaje powoli <w>zanikają</w> w nowoczesnych miastach.",
                            "target_lang_translations": {
                                "ru": "Эти старые обычаи постепенно <w>отмирают</w> в современных городах."
                            }
                        }
                    ],
                    "synonyms": [
                        "ginąć",
                        "wymierać",
                        "zamierać",
                        "zatracać się"
                    ],
                    "antonyms": [
                        "powstawać",
                        "rozwijać się"
                    ],
                    "common_phrases": [
                        "zwyczaje zanikają",
                        "tradycja zanika"
                    ],
                    "target_lang_definitions": {
                        "ru": "постепенно переставать существовать, исчезать или вымирать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "переставать существовать со временем"
                            },
                            {
                                "target_lang_word": "отмирать",
                                "target_lang_sense_clarification": "постепенно уходить в прошлое (о традициях, обычаях)"
                            },
                            {
                                "target_lang_word": "вымирать",
                                "target_lang_sense_clarification": "постепенно гибнуть, прекращать существование"
                            }
                        ]
                    }
                }
            ]
        }
    ]
