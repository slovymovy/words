                "senses": [
                    {
                        "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                        "entry_id": "541cd58d-68f7-3c5a-a4d9-284a274af8d6",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a2c094-5bf4-4f99-a3d7-288b166596fd",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Frau Wegele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6f91162e-a068-494c-9bfa-b656def08eef",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Herr Wegele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "314104af-8f56-446d-b83d-206062cd6815",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Die Wegeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b03e075b-79f3-4df9-88fb-e3cac3bd0c23",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Der Wegele trägt nie die Pullover, die die Wegele ihm strickt."
                            },
                            {
                                "example_id": "eead4b77-8801-4c68-a0fe-760a109409e1",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wegele kommt, geht der Herr Wegele.“"
                            },
                            {
                                "example_id": "cc8ae469-5dba-448b-9624-551fb1befc05",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Wegele kommt und geht."
                            },
                            {
                                "example_id": "d88157f0-fe7f-4552-9fd8-81ff97d59415",
                                "sense_id": "9115bd5c-8bf9-37ac-9314-198463bd8468",
                                "text": "Wegeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
