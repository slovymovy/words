{
    "word_family": [
        "chisel",
        "chiseler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "679a7cdb-486b-3a82-94d2-3484a04f3e41",
                    "sense_definition": "Having strongly and clearly defined facial features, resembling a stone sculpture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was famous for his piercing blue eyes and <w>chiseled</w> jawline.",
                            "target_lang_translations": {
                                "it": "L'attore era famoso per i suoi penetranti occhi azzurri e la mascella <w>scolpita</w>."
                            }
                        },
                        {
                            "text": "Her <w>chiseled</w> features gave her an elegant and striking look in every photograph.",
                            "target_lang_translations": {
                                "it": "I suoi lineamenti <w>scolpiti</w> le conferivano un aspetto elegante e d'impatto in ogni fotografia."
                            }
                        }
                    ],
                    "synonyms": [
                        "sharp",
                        "defined"
                    ],
                    "common_phrases": [
                        "chiseled jawline",
                        "chiseled features"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha lineamenti del viso ben definiti e marcati, simili a quelli di una scultura."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scolpito",
                                "target_lang_sense_clarification": "riferito a lineamenti del viso ben definiti"
                            },
                            {
                                "target_lang_word": "cesellato",
                                "target_lang_sense_clarification": "delineato con precisione ed eleganza"
                            },
                            {
                                "target_lang_word": "marcato",
                                "target_lang_sense_clarification": "netto, ben definito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fa4b58c-f6be-34f5-b6ff-0e421bc91195",
                    "sense_definition": "Having well-developed, lean muscles with very little body fat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Months of intensive training helped him build a <w>chiseled</w> torso.",
                            "target_lang_translations": {
                                "it": "Mesi di allenamento intensivo lo hanno aiutato a sviluppare un busto <w>scolpito</w>."
                            }
                        },
                        {
                            "text": "The gymnast showed off a <w>chiseled</w> physique during the international competition.",
                            "target_lang_translations": {
                                "it": "Il ginnasta ha sfoggiato un fisico <w>scolpito</w> durante la competizione internazionale."
                            }
                        }
                    ],
                    "synonyms": [
                        "muscular",
                        "toned",
                        "ripped"
                    ],
                    "antonyms": [
                        "flabby"
                    ],
                    "common_phrases": [
                        "chiseled physique",
                        "chiseled abs"
                    ],
                    "target_lang_definitions": {
                        "it": "Detto di corpo o muscoli ben sviluppati, tonici e privi di grasso in eccesso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scolpito",
                                "target_lang_sense_clarification": "riferito a fisico o muscoli definiti"
                            },
                            {
                                "target_lang_word": "definito",
                                "target_lang_sense_clarification": "con muscoli evidenti e poco grasso"
                            },
                            {
                                "target_lang_word": "tonico",
                                "target_lang_sense_clarification": "sodo e asciutto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1530e086-49fe-38df-a1ad-d8ff14f0ae1c",
                    "sense_definition": "Simple past and past participle of <w>chisel</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sculptor carefully <w>chiseled</w> the rough marble into a delicate statue.",
                            "target_lang_translations": {
                                "it": "Lo scultore ha <w>scolpito</w> con cura il marmo grezzo trasformandolo in una statua delicata."
                            }
                        },
                        {
                            "text": "He <w>chiseled</w> his initials into the old wooden bench behind the school.",
                            "target_lang_translations": {
                                "it": "Ha <w>inciso</w> le sue iniziali sulla vecchia panchina di legno dietro la scuola."
                            }
