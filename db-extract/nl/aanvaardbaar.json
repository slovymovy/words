                                        "entry_id": "24685d37-e9f4-3174-aa64-b22531ec7041",
                                        "glosses": [
                                            "in einer Weise, dass man es akzeptieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a2b96e-b630-4210-8347-449cc37609f8",
                                                "sense_id": "8762ee6b-ab38-3285-a174-a8e0cef5e0d0",
                                                "text": "Der Preis des Produktes ist akzeptabel."
                                            },
                                            {
                                                "example_id": "6b0273c3-7953-4e17-b99d-41a83f5481d9",
                                                "sense_id": "8762ee6b-ab38-3285-a174-a8e0cef5e0d0",
                                                "text": "„Wasserstoff ist schneller getankt als Akkus geladen, und mit den 600 Liter fassenden Tanks, wie sie der Brennstoffzellenbus Toyota Sora nutzt, schafft man auch akzeptable Reichweiten.“"
