                ],
                "senses": [
                    {
                        "sense_id": "e1495703-6940-3e47-aab1-6197e0d03ef3",
                        "entry_id": "3e7166c6-a5df-36f1-b746-08dd908f2ab3",
                        "glosses": [
                            "Wooden (especially oaken) panelling on the lower part of a room’s walls."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3bf143ed-cbf7-4563-be3a-6a6aff89b4dd",
                                "sense_id": "e1495703-6940-3e47-aab1-6197e0d03ef3",
                                "text": "The giggles got louder and ran around the corners of the room like rats behind the wainscotting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b10f3e11-d8fe-4b0e-ac76-ef6921d11541",
                        "source_entry_id": "3e7166c6-a5df-36f1-b746-08dd908f2ab3",
                        "source_sense_id": "e1495703-6940-3e47-aab1-6197e0d03ef3",
                        "source_sense_description": "Wooden (especially oaken) panelling on the lower part of a room’s walls",
                        "target_lang_word": "lambrisering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambrisering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                        "entry_id": "d7b14b75-e511-3bb2-8b5e-c1f375611f67",
                                        "glosses": [
                                            "houten bekleding van de onderkant van de wand, tegenwoordig meestal tot rugleuninghoogte of lager"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8608aa44-063d-4293-9977-1ab061f3cf24",
                                                "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                                "text": "Van oud hout, „van de boer, de kringloop en de straat”, maakte Oosterhoff schuifdeuren en lambrisering. Door alle kamers legde Linzel Perzische tapijten. „In de tussenkamer kun je de vloer niet meer zien.” De muren stuukte ze zelf „expres een beetje rommelig” en werden rokerig geschilderd."
                                            },
                                            {
                                                "example_id": "193d0957-4e9a-4eb3-8a31-ad861713c82f",
                                                "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                                "text": "Terwijl ik goedkeurend met mijn vinger langs de vergulde lambrisering streek, de dikte voelde van de stof van de zware, oker overgordijnen en de stoel wegschoof om de openslaande deuren te openen naar het terras, dat uitzicht bood op de rozentuin, of wat daarvan over was, en de vijver met de defecte fontein, bedacht ik dat ik nog tijd genoeg zou hebben om deze kamer en detail te beschrijven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4d9e59a-6db2-4294-b6d9-93ba383d7df8",
                        "source_entry_id": "3e7166c6-a5df-36f1-b746-08dd908f2ab3",
                        "source_sense_id": "e1495703-6940-3e47-aab1-6197e0d03ef3",
                        "source_sense_description": "Wooden (especially oaken) panelling on the lower part of a room’s walls",
                        "target_lang_word": "lambris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Revêtement de menuiserie, de marbre, de stuc, etc., sur les murailles d’une salle, d’une chambre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30789d4b-44af-44d5-8f00-80fbb40de29d",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Ce lambris est de marbre de diverses couleurs."
                                            },
                                            {
                                                "example_id": "3e41a339-dfe9-454a-8589-7d647a10667e",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Ce lambris est peint en blanc, avec des moulures dorées. — Lambris de stuc."
                                            },
                                            {
                                                "example_id": "17b1470a-43ec-45fd-b63c-e699f9f4d018",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Lambris d’appui, lambris à hauteur d’appui qui règne autour d’une pièce."
                                            },
                                            {
                                                "example_id": "7d782096-df72-4308-9196-0bfe778677d5",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Les lambris d’appui de mon salon sont de chêne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3049ab7c-0bf9-31cb-8e66-9a18865392f3",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Enduit de plâtre fait au-dedans d’un grenier, d’un galetas, sur des lattes jointives clouées aux chevrons ; bacula."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Revêtement de menuiserie appliqué aux solives d’une salle, d’une chambre, etc., et où l’on forme quelquefois des caissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8462494d-2234-4923-861f-99fb9b34197c",
                                                "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                                "text": "Des lambris peints et dorés."
                                            },
                                            {
                                                "example_id": "7db05b82-964f-465e-ad59-dedba1bd843f",
                                                "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                                "text": "Lambris de plafond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Décoration intérieure d’une maison vaste et magnifique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1507a191-7a2c-47ac-9aa3-45016e7653d5",
                                                "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                                "text": "De vastes lambris, des lambris dorés, de riches lambris, etc."
                                            },
                                            {
                                                "example_id": "9cc6c45b-175b-4a56-bf96-576aff56d1d8",
                                                "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                                "text": "Le bonheur se trouve rarement sous les lambris dorés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
