                                            {
                                                "example_id": "f833c9ce-e9c3-473e-a267-ae30612c8bbd",
                                                "sense_id": "cd28e4c7-2034-3a37-96d6-b1a32775c8c2",
                                                "text": "They reviewed the report in secret."
