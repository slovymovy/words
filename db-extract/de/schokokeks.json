                "senses": [
                    {
                        "sense_id": "f5ba2f4d-cd18-3516-9da2-f56728de243b",
                        "entry_id": "ce06f42d-76d8-3cbb-8bb8-4a049ee971ab",
                        "glosses": [
                            "Gebäck/Keks mit Schokolade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ac6d540-2110-4012-a34a-2b7463b2b20b",
                                "sense_id": "f5ba2f4d-cd18-3516-9da2-f56728de243b",
                                "text": "„Jeden Nachmittag ging er in ein Café, kaufte Schokokekse, plauderte dann mit ein paar Kollegen, und irgendwann hatte er alle Kekse verdrückt.“"
                            },
                            {
                                "example_id": "d271ede3-bf7a-429e-beb5-99b9a753d3ef",
                                "sense_id": "f5ba2f4d-cd18-3516-9da2-f56728de243b",
                                "text": "„Jetzt stellen Sie ihm zwei Schalen hin, eine mit Schokokeksen (lecker) und eine mit Broccoli (igitt).“"
                            },
                            {
                                "example_id": "5e236f5e-e791-4846-bfe1-509c0b508b2f",
                                "sense_id": "f5ba2f4d-cd18-3516-9da2-f56728de243b",
                                "text": "„Sie biss vom Brot ab und machte sich eine mentale Notiz, für ihren nächsten Besuch ein paar Schokokekse zu backen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
