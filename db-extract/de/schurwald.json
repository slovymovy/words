                "senses": [
                    {
                        "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                        "entry_id": "51de6ce0-fd8c-3cca-9df8-562c652980c8",
                        "glosses": [
                            "waldreicher Höhenzug im südöstlichen Zentrum Baden-Württembergs, Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "66cacd36-649b-4163-89ed-ad46444a479d",
                                "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                                "text": "„Der Schurwald liegt östlich von Stuttgart und erstreckt sich über den Stadtkreis Stuttgart sowie über die Landkreise Esslingen, Göppingen, Rems-Murr- und Ostalbkreis.“"
                            },
                            {
                                "example_id": "ca94c109-8b16-440d-a550-4a36b181578a",
                                "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                                "text": "„Die beiden neuen Anlagen auf dem Schurwald an der Göppinger Kreisgrenze sind gestoppt worden.“"
                            },
                            {
                                "example_id": "6f437048-85d9-442e-a6a8-4ef0e2e7392c",
                                "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                                "text": "„In den kommenden Tagen beginnen auf Esslinger Gemarkung im Schurwald Rodungsarbeiten.“"
                            },
                            {
                                "example_id": "43012dc7-084c-4cce-9178-efa4e13888bc",
                                "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                                "text": "„Ein 31-Jähriger ist bei Baumfällarbeiten auf dem Schurwald von einer 30 Meter hohen fallenden Fichte erfasst und eingeklemmt worden.“"
                            },
                            {
                                "example_id": "2758b9bb-f2e1-457e-9256-175e95427d38",
                                "sense_id": "5c00f410-6d61-3716-a81b-d9ac885fa711",
                                "text": "„Um die Fruchtbarkeit der Waldböden zu erhalten und die Waldbäume klimastabiler zu machen, läuft im Forstbezirk Schurwald seit Anfang September die Bodenschutzkalkung im Staatswald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52e97ed0-fc13-35b8-9099-f51ecb84bc43",
                        "entry_id": "51de6ce0-fd8c-3cca-9df8-562c652980c8",
                        "glosses": [
                            "FFH-Gebiet im südöstlichen Zentrum Baden-Württembergs, Deutschland"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "8cbd4ab6-9894-4030-9d48-3b4e185820b3",
                                "sense_id": "52e97ed0-fc13-35b8-9099-f51ecb84bc43",
                                "text": "„Teile des Schurwaldes sind FFH-Gebiet diesem und weiteren Schutzgebieten werden v.a. Teile der tief eingeschnittenen Täler von Quellbächen geschützt.“"
                            }
                        ],
