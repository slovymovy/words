                                        "sense_id": "693664a1-20e9-3083-93c6-e30e065384b8",
                                        "entry_id": "26553113-b232-39dc-9f1a-6cc43fee11a9",
                                        "glosses": [
                                            "The use of microscopes."
                                        ],
                                        "tags": [
