                                        "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                        "entry_id": "b3f30787-daee-3f5d-be98-e58c6ea70fa5",
                                        "glosses": [
                                            "Albert Einstein, the world-famous 20th-century theoretical physicist who developed the theory of relativity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e7a24a-94d9-40ac-bdf9-8701145ad447",
                                                "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                                "text": "Men of Science More or Less Agog Over Results of Eclipse Observations.\nEINSTEIN THEORY TRIUMPHS\nStars Not Where They Seemed or Were Calculated to be, but Nobody Need Worry.\nA BOOK FOR 12 WISE MEN\nNo More in All the World Could Comprehend it, Said Einstein When His Daring Publishers Accepted it."
                                            },
                                            {
                                                "example_id": "f5a32acc-3159-4e6b-912d-ad323358b0d0",
                                                "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                                "text": "Einstein said he could never understand it all / Planets spinning through space"
                                            },
                                            {
                                                "example_id": "e336c5d4-ca0c-4a1f-869b-28fd7489b85b",
                                                "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                                "text": "Gaston: Picasso, Einstein, Schmendiman. Somehow it doesn't have a ring."
                                            },
                                            {
                                                "example_id": "c3111852-325a-45a0-8b5c-0ea6d693878e",
                                                "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                                "text": "We're sitting in a coffee shop in Sunnyvale, California. It's late. I've had a few beers, and my dinner date has downed a few plum wines. I peer deep into his eyes, trying to figure out why so many people throughout the high tech universe think Henry Massalin could be the Einstein of our time."
                                            },
                                            {
                                                "example_id": "9a503b57-3dab-4ae7-a13a-87568def8876",
                                                "sense_id": "fbd92055-babb-3acb-9e24-94d2c090bd5e",
                                                "text": "If Einstein, my dear / Were a toll booth cashier / I imagine he too would be [bored]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "505f22fe-18da-3f7c-a057-43abb86dd413",
                                        "entry_id": "b3f30787-daee-3f5d-be98-e58c6ea70fa5",
                                        "glosses": [
                                            "A surname from German."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Einstein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34432c35-c810-3a58-b066-d826d0963836",
                                        "entry_id": "f8d191fb-40fd-3202-8357-79d20f783057",
                                        "glosses": [
                                            "An extremely clever or intelligent person."
                                        ],
                                        "tags": [
                                            "sarcastic",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700df3a3-408e-41de-82e4-57eb64fd7b45",
                                                "sense_id": "34432c35-c810-3a58-b066-d826d0963836",
                                                "text": "Can you believe he's just a kindergartener? It looks like they've got an Einstein in the family."
                                            },
                                            {
                                                "example_id": "f0ec8e35-a8e9-4730-b58f-2bd431ff093e",
                                                "sense_id": "34432c35-c810-3a58-b066-d826d0963836",
                                                "text": "Good job, Einstein, thinking you could grab the wires with your pliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
