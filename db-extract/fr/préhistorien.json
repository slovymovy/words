                "senses": [
                    {
                        "sense_id": "9a87ec6c-08bd-3891-ad7c-f3a21029d01e",
                        "entry_id": "eef50632-f3de-337b-bf67-139caf218981",
                        "glosses": [
                            "Historien spécialisé dans la période de la préhistoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2272c2-5110-4e1a-87d8-c240dbd8da6c",
                                "sense_id": "9a87ec6c-08bd-3891-ad7c-f3a21029d01e",
                                "text": "Pour le préhistorien Jean Clottes qui a expertisé la grotte quelques jours après sa découverte et dirigé les recherches scientifiques de 1998 à 2006, « cette grotte unique avec ses peintures merveilleuses mérite d’être inscrite à l’Unesco »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60f4a6f1-c4a9-4b41-8424-dc4fbd7ec31a",
                        "source_entry_id": "eef50632-f3de-337b-bf67-139caf218981",
                        "source_sense_id": "9a87ec6c-08bd-3891-ad7c-f3a21029d01e",
                        "target_lang_word": "Prähistoriker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prähistoriker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e2a3d63-5226-3060-90b0-d46dd12c922e",
                                        "entry_id": "17a276c9-8188-32e1-92b3-9f884114ac94",
                                        "glosses": [
                                            "jemand, der zur Urgeschichte forscht; Wissenschaftler auf dem Gebiet der Prähistorie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d679e634-1737-4f53-bddb-d6eb1c25d1a9",
                                                "sense_id": "6e2a3d63-5226-3060-90b0-d46dd12c922e",
                                                "text": "„Der Prähistoriker Manfred Korfmann, Grabungsleiter in Troia seit 1988 und Inhaber einer persönlichen Grabungslizenz der türkischen Regierung, war ein Gelehrter, an dem sich manche rieben, aber zu dem viele bewundernd aufsahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "421016d8-fe0b-4910-829a-4cbd939c0d61",
                        "source_entry_id": "eef50632-f3de-337b-bf67-139caf218981",
                        "source_sense_id": "9a87ec6c-08bd-3891-ad7c-f3a21029d01e",
                        "target_lang_word": "prehistorian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prehistorian",
