                                        "entry_id": "cc2de34f-d043-3216-bc8f-78fe8f067730",
                                        "glosses": [
                                            "A cricket bat with no maker's logo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
