                                    {
                                        "sense_id": "1fb4a03d-783e-3a50-9a19-be6a85899461",
                                        "entry_id": "3c02fa56-4085-30f1-89f9-5266d655ac64",
                                        "glosses": [
                                            "Person, die auf die Jagd geht; Jäger"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c95a8676-5c62-4ca7-a3c8-2e36e354648f",
                                                "sense_id": "1fb4a03d-783e-3a50-9a19-be6a85899461",
                                                "text": "„An einem Schießstand kann der Besucher seine Treffsicherheit testen und sich an einer Fotowand als Wildschütz fotografieren lassen.“"
                                            },
                                            {
                                                "example_id": "03097852-b39a-4831-8856-3a9946891fb2",
                                                "sense_id": "1fb4a03d-783e-3a50-9a19-be6a85899461",
                                                "text": "„Oder hätte er, für einen Wildschütz eine grauenvolle Demütigung, die Gams nur gestreift?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cac8267c-8033-3c1c-a490-0742d9d03fce",
                                        "entry_id": "3c02fa56-4085-30f1-89f9-5266d655ac64",
                                        "glosses": [
                                            "Person, die unrechtmäßig Wild jagt und erlegt; Wilderer, Wilddieb"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad80746-dd97-4e94-8376-d820e52eb785",
                                                "sense_id": "cac8267c-8033-3c1c-a490-0742d9d03fce",
                                                "text": "„Oder hätte er, für einen Wildschütz eine grauenvolle Demütigung, die Gams nur gestreift?“"
                                            },
                                            {
                                                "example_id": "18b383af-e6ed-4274-8db5-386ca1ed4729",
                                                "sense_id": "cac8267c-8033-3c1c-a490-0742d9d03fce",
                                                "text": "„Einsiedel hielt dem Wilderer eine derbe Strafpredigt, und versprach ihm, sich dahin zu verwenden, daß er von der Strafe als Wildschütz freigesprochen und nur als Deserteur bestraft werden solle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
