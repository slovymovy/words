                                        "entry_id": "9c64639f-0836-3f7c-8bbc-d2c5e3bb6160",
                                        "glosses": [
                                            "A type of trade bloc which is composed of a free trade area with a common external tariff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f1b26e-2d5a-4fce-9e61-2b349cefee4d",
                                                "sense_id": "8776ae3f-c87f-334f-b219-9070f4ec0ce7",
                                                "text": "It appears the whole UK will remain in the customs union, so there are no tariff divergences or checks either on the island of Ireland or within the United Kingdom."
                                            }
                                        ]
                                    }
