{
    "word_family": [
        "angry",
        "angrily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                    "sense_definition": "A strong feeling of displeasure, hostility, or antagonism towards someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to learn how to control your <w>anger</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно научиться контролировать свой <w>гнев</w>.",
                                "de": "Du musst lernen, deinen <w>Ärger</w> zu kontrollieren.",
                                "zh": "你需要学会如何控制你的<w>愤怒</w>。"
                            }
                        },
                        {
                            "text": "His face turned red with <w>anger</w> when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Его лицо покраснело от <w>гнева</w>, когда он услышал новости.",
                                "de": "Sein Gesicht wurde rot vor <w>Wut</w>, als er die Nachrichten hörte.",
                                "zh": "听到这个消息时，他气得脸都红了，充满了<w>愤怒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fury",
                        "rage",
                        "wrath",
                        "ire",
                        "resentment",
                        "indignation",
                        "displeasure",
                        "vexation"
                    ],
                    "antonyms": [
                        "calmness",
                        "peacefulness"
                    ],
                    "common_phrases": [
                        "control anger",
                        "vent anger",
                        "anger management",
                        "deep anger",
                        "express anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство недовольства, враждебности или неприязни по отношению к кому-либо или чему-либо.",
                        "de": "Ein starkes Gefühl von Unzufriedenheit, Feindseligkeit oder Widerwillen gegenüber jemandem oder etwas.",
                        "zh": "对某人或某事感到强烈的不满、敌意或对抗的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнев",
                                "target_lang_sense_clarification": "сильное чувство возмущения"
                            },
                            {
                                "target_lang_word": "злость",
                                "target_lang_sense_clarification": "чувство раздражения и недоброжелательности"
                            },
                            {
                                "target_lang_word": "злоба",
                                "target_lang_sense_clarification": "затаенное чувство вражды"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ärger",
                                "target_lang_sense_clarification": "allgemeines Gefühl von Unzufriedenheit oder Verdruss"
                            },
                            {
                                "target_lang_word": "Wut",
                                "target_lang_sense_clarification": "sehr starke, oft aggressive Gemütserregung"
                            },
                            {
                                "target_lang_word": "Zorn",
                                "target_lang_sense_clarification": "heftiges, oft moralisch begründetes Gefühl der Empörung"
                            },
                            {
                                "target_lang_word": "Groll",
                                "target_lang_sense_clarification": "lang anhaltender, innerer Groll oder versteckte Feindseligkeit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愤怒",
                                "target_lang_sense_clarification": "强烈的愤怒情绪"
                            },
                            {
                                "target_lang_word": "生气",
                                "target_lang_sense_clarification": "因不快而产生的情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddf99fba-4710-308e-9494-14c06b4eefe4",
                    "sense_definition": "Pain or inflammation of a sore or wound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine helped to take away the <w>anger</w> of the wound.",
                            "target_lang_translations": {
                                "ru": "Лекарство помогло снять <w>воспаление</w> раны.",
                                "de": "Das Medikament half, die <w>Entzündung</w> der Wunde zu lindern.",
                                "zh": "药物有助于消除伤口的<w>炎症</w>。"
                            }
                        },
                        {
                            "text": "He waited for the <w>anger</w> in his sore foot to subside.",
                            "target_lang_translations": {
                                "ru": "Он ждал, пока утихнет <w>боль</w> в его больной ноге.",
                                "de": "Er wartete darauf, dass der <w>Schmerz</w> in seinem wunden Fuß nachließ.",
                                "zh": "他等着脚上的<w>疼痛</w>消退。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "implied by context and examples"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Боль или воспаление раны или ушиба.",
                        "de": "Schmerz oder Entzündung einer Wunde oder einer wunden Stelle.",
                        "zh": "伤口或患处的疼痛或炎症。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспаление",
                                "target_lang_sense_clarification": "болезненный процесс в тканях"
                            },
                            {
                                "target_lang_word": "боль",
                                "target_lang_sense_clarification": "физическое страдание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Entzündung",
                                "target_lang_sense_clarification": "medizinischer Zustand von Gewebe"
                            },
                            {
                                "target_lang_word": "Schmerz",
                                "target_lang_sense_clarification": "körperliches Empfinden bei einer Verletzung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炎症",
                                "target_lang_sense_clarification": "组织受损后的病理反应"
                            },
                            {
                                "target_lang_word": "疼痛",
                                "target_lang_sense_clarification": "身体上的不适感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                    "sense_definition": "To make someone feel angry or annoyed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unfair decision <w>angered</w> the entire staff.",
                            "target_lang_translations": {
                                "ru": "Несправедливое решение <w>разозлило</w> весь персонал.",
                                "de": "Die ungerechte Entscheidung <w>ärgerte</w> das gesamte Personal.",
                                "zh": "这个不公平的决定<w>激怒</w>了全体员工。"
                            }
                        },
                        {
                            "text": "It <w>angers</w> me when people are rude to waiters.",
                            "target_lang_translations": {
                                "ru": "Меня <w>злит</w>, когда люди грубы с официантами.",
                                "de": "Es <w>ärgert</w> mich, wenn Leute unhöflich zu Kellnern sind.",
                                "zh": "当人们对服务员无礼时，这让我感到<w>生气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrage",
                        "infuriate",
                        "annoy",
                        "irritate",
                        "vex",
                        "displease",
                        "aggravate",
                        "madden",
                        "upset"
                    ],
                    "common_phrases": [
                        "anger someone",
                        "easily angered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство злости или раздражения.",
                        "de": "Jemanden dazu bringen, sich über etwas zu ärgern oder verärgert zu sein.",
                        "zh": "使某人感到生气或烦恼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "вызывать злость"
                            },
                            {
                                "target_lang_word": "сердить",
                                "target_lang_sense_clarification": "приводить в раздражение"
                            },
                            {
                                "target_lang_word": "гневить",
                                "target_lang_sense_clarification": "вызывать гнев (книжн.)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ärgern",
                                "target_lang_sense_clarification": "jemanden verstimmen oder reizen"
                            },
                            {
                                "target_lang_word": "wütend machen",
                                "target_lang_sense_clarification": "jemanden in einen Zustand großer Wut versetzen"
                            },
                            {
                                "target_lang_word": "aufbringen",
                                "target_lang_sense_clarification": "jemanden aus der Ruhe bringen und verärgern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激怒",
                                "target_lang_sense_clarification": "使人产生强烈的愤怒"
                            },
                            {
                                "target_lang_word": "惹恼",
                                "target_lang_sense_clarification": "使人感到烦躁或不快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d9dccf-cd37-3fd6-8777-8c184f0ccbcb",
                    "sense_definition": "To become angry.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "become_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You <w>anger</w> too easily over small mistakes.",
                            "target_lang_translations": {
                                "ru": "Ты слишком легко <w>сердишься</w> из-за мелких ошибок.",
                                "de": "Du <w>ärgerst</w> dich zu leicht über kleine Fehler.",
                                "zh": "你太容易因为小错误而<w>发火</w>了。"
                            }
                        },
                        {
                            "text": "He <w>angers</w> quickly when he is tired or hungry.",
                            "target_lang_translations": {
                                "ru": "Он быстро начинает <w>злиться</w>, когда устал или голоден.",
                                "de": "Er <w>wird</w> schnell <w>wütend</w>, wenn er müde oder hungrig ist.",
                                "zh": "当他疲倦或饥饿时，很快就会<w>生气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "get angry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злиться, приходить в состояние гнева.",
                        "de": "In einen Zustand von Wut oder Ärger geraten.",
                        "zh": "变得生气，进入愤怒的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злиться",
                                "target_lang_sense_clarification": "испытывать злость"
                            },
                            {
                                "target_lang_word": "сердиться",
                                "target_lang_sense_clarification": "быть в раздражении"
                            },
                            {
                                "target_lang_word": "гневаться",
                                "target_lang_sense_clarification": "испытывать гнев"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich ärgern",
                                "target_lang_sense_clarification": "über etwas verstimmt sein"
                            },
                            {
                                "target_lang_word": "wütend werden",
                                "target_lang_sense_clarification": "in einen Zustand heftiger Wut geraten"
                            },
                            {
                                "target_lang_word": "zornig werden",
                                "target_lang_sense_clarification": "in einen Zustand von Zorn geraten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发火",
                                "target_lang_sense_clarification": "开始生气"
                            },
                            {
                                "target_lang_word": "生气",
                                "target_lang_sense_clarification": "处于愤怒状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
