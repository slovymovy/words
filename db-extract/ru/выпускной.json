                        "entry_id": "26c85b2d-e624-3210-9b62-cb4564555aee",
                        "glosses": [
                            "субстантивир. вечер, торжество, посвящённое выпуску"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa7993e-ee99-49e1-b28a-8d19898c8df9",
                                "sense_id": "209be2e5-4bd0-35a3-b667-ba21f2eaa00f",
                                "text": "Перед выпускным вышла на крыльцо. Решила обратиться к народу."
                            }
                        ]
                    }
                ],
