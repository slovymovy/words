                                    {
                                        "sense_id": "78aed503-790b-3e78-8345-31aae0c98d27",
                                        "entry_id": "39350341-e6b5-3a63-9cb8-124affb0a1a3",
                                        "glosses": [
                                            "Angehöriger des kaukasischen Volks der Tscherkessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ce9bcce-e7c5-4786-8889-e4d111f34231",
                                                "sense_id": "78aed503-790b-3e78-8345-31aae0c98d27",
                                                "text": "Der gebürtige Tscherkesse lebt seit vielen Jahren in Moskau."
                                            }
                                        ],
