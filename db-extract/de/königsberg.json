                                        "sense_id": "90c6f50d-ed61-312d-8a16-22a9a9bd77a9",
                                        "entry_id": "a0ba0d7d-6027-39b9-a506-3f79ae05799e",
                                        "glosses": [
                                            "A city, the administrative center of Kaliningrad Oblast, Russia, formerly called Königsberg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e47f4837-e15a-46ae-852a-e31baf50eaa8",
                                                "sense_id": "90c6f50d-ed61-312d-8a16-22a9a9bd77a9",
                                                "text": "As a second-year student at Kharkiv University, I took a summer job as a conductor of the train that ran from Novorossiysk on the Russian Black Sea coast to Kaliningrad in the Baltics - a 48-hour journey via Kharkiv, from where the train originated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c9c20f7-4f80-420a-a069-0d9c48e20ec3",
                        "source_entry_id": "120fd940-638e-37b8-8cba-41a201223f9a",
                        "source_sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
                        "target_lang_word": "Königsberg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Königsberg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64b0e4d0-8872-3468-a4d6-980e14c3ce17",
                                        "entry_id": "6bda5acf-7c8f-36f2-9397-b38c80cfa561",
                                        "glosses": [
                                            "Ancien nom (jusqu’en 1945) de Kaliningrad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59c1a5d-4224-4cf4-988c-2fc1c51c0636",
                                                "sense_id": "64b0e4d0-8872-3468-a4d6-980e14c3ce17",
                                                "text": "En apprenant la fin du grand penseur qui vécut et mourut solitaire dans sa retraite de Königsberg, le monde savant, le monde intellectuel virent dans cet événement une perte douloureuse pour la philosophie ; les élèves de Kant, une catastrophe personnelle, car ils perdaient un maître d’une valeur si exceptionnelle, qu’il était impossible de le remplacer ; ses adversaires même étaient déconcertés et attristés par cette mort, car ils se voyaient privés par elle de ce qui faisait l’occupation principale de leur vie, c’est-à-dire de leur controverse avec le grand philosophe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff45f5d5-b352-4d67-b99a-2d75ffc72544",
                        "source_entry_id": "120fd940-638e-37b8-8cba-41a201223f9a",
                        "source_sense_id": "bbcf1bc1-46db-3596-ab00-c178468a3a17",
