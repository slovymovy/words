                ],
                "senses": [
                    {
                        "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                        "entry_id": "8f93c8e8-2d9b-3133-ab27-eaa7ceecae77",
                        "glosses": [
                            "ein sehr lautes, oft lang anhaltendes Geräusch eines oder mehrerer Menschen sowie einiger Tierarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db41bc0-53c0-4c8a-a11d-510dbcb24491",
                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                "text": "Mit deinem Gebrüll weckst du noch die Kinder."
                            },
                            {
                                "example_id": "c816fd9b-630a-485c-930b-ed18590e31f1",
                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                "text": "Das Gebrüll der Tiere schreckte uns hoch."
                            },
                            {
                                "example_id": "e40d9c9a-cc0b-475c-a2d8-19dc4a2c9353",
                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                "text": "„Und so zogen wir unsere Rucksäcke über und spazierten einfach ins Freie und gingen hinüber nach Cochem, als ginge uns das ganze Gebrüll und Geschrei des Herbergsvaters einfach nichts an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
