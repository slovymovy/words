                    "synonyms": [
                        "AKA"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что человек также известен под другим именем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "он же",
                                "target_lang_sense_clarification": "при перечислении имен"
                            },
                            {
                                "target_lang_word": "известный как",
                                "target_lang_sense_clarification": "указание на псевдоним"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9ba4d62-6437-3159-bbe1-7e6bd0e2e48f",
                    "sense_definition": "To give an additional, often simpler, name to a file, command, or data element.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows users to <w>alias</w> complex database queries with simple keywords.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям <w>создавать псевдонимы</w> для сложных запросов к базе данных с помощью простых ключевых слов."
                            }
                        },
                        {
                            "text": "You should <w>alias</w> the command to make your workflow more efficient.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>назначить алиас</w> для этой команды, чтобы сделать рабочий процесс более эффективным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alias the command"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Присвоить дополнительное, часто более простое имя файлу, команде или элементу данных."
                    },
                    "translations": {
                        "ru": [
