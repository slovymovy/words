    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8315a734-adde-3d72-a49d-6019f622b195",
                    "sense_definition": "Être fictif qui figure dans une œuvre littéraire, théâtrale ou cinématographique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>personnage</w> principal de ce roman d'aventure surmonte de nombreux obstacles."
                        },
                        {
                            "text": "J'ai tout de suite aimé ce livre grâce à ses <w>personnages</w> attachants."
                        }
                    ],
                    "common_phrases": [
                        "personnage principal",
                        "personnage secondaire"
                    ]
                },
                {
                    "sense_id": "f3e74c34-cdba-31a4-b968-61a7b1453a98",
                    "sense_definition": "Rôle incarné par un comédien ou une actrice dans une pièce ou un film.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acteur a passé plusieurs mois à préparer son <w>personnage</w> avant le tournage."
                        },
                        {
                            "text": "Elle a su incarner un <w>personnage</w> difficile avec une grande justesse."
                        }
                    ],
                    "synonyms": [
                        "rôle"
                    ],
                    "common_phrases": [
                        "incarner un personnage",
                        "entrer dans le personnage"
                    ]
                },
                {
                    "sense_id": "2a3f5060-0af3-3a80-9d20-19c07035eac3",
                    "sense_definition": "Individu considéré sous l'angle de ses particularités ou de ses défauts, souvent avec méfiance ou ironie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un drôle de <w>personnage</w> qui refuse de parler à ses voisins."
                        },
                        {
                            "text": "Tout le quartier se méfie de ce sombre <w>personnage</w> apparu hier."
                        }
                    ],
                    "common_phrases": [
                        "drôle de personnage",
                        "curieux personnage"
                    ]
                },
                {
                    "sense_id": "7dfb4e77-4eab-3238-a09f-cbaa16dca5ac",
                    "sense_definition": "Personne notable par son rang, son autorité ou son influence sociale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "notabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs <w>personnages</w> influents de la région étaient invités à cette réception diplomatique."
                        },
                        {
                            "text": "Ce ministre est devenu un <w>personnage</w> incontournable de la vie politique nationale."
                        }
                    ],
                    "common_phrases": [
                        "personnage important",
                        "personnage influent",
                        "haut personnage"
                    ]
                },
                {
                    "sense_id": "22de930c-0288-3fc1-9727-55024305feca",
                    "sense_definition": "Figure humaine représentée dans une œuvre d'art plastique comme un tableau ou un bas-relief.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a représenté un <w>personnage</w> solitaire au milieu d'un vaste paysage."
                        },
                        {
                            "text": "Les <w>personnages</w> au premier plan attirent immédiatement le regard du spectateur."
                        }
                    ]
                },
                {
                    "sense_id": "5d697283-9e6b-3056-9b4e-fc4ae4cb4956",
                    "sense_definition": "Attitude ou rôle qu'une personne adopte dans la vie sociale pour donner une certaine image d'elle-même.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'efforce de jouer un <w>personnage</w> sérieux lors des réunions professionnelles."
                        },
                        {
                            "text": "Derrière ce masque d'homme froid, il soutient très bien son <w>personnage</w>."
                        }
                    ],
                    "common_phrases": [
                        "jouer un personnage",
                        "soutenir son personnage"
                    ]
                }
            ]
        }
    ]
}