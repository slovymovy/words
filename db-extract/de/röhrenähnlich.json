                ],
                "senses": [
                    {
                        "sense_id": "6688363e-2e8a-3ef0-92ef-0a2cd38ce6f7",
                        "entry_id": "0a183807-8586-385a-9ded-de347a7dcaa2",
                        "glosses": [
                            "wie eine Röhre aussehend, einer Röhre ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ddd0ca-8e3f-4a76-955e-4afddb0fe803",
                                "sense_id": "6688363e-2e8a-3ef0-92ef-0a2cd38ce6f7",
                                "text": "„Bei der Untersuchung liegt der Patient in einer röhrenähnlichen Konstruktion, die am Kopf- und Fußende geöffnet ist.“"
                            },
                            {
                                "example_id": "3dd7bca7-984f-4507-a67f-f572c33d1901",
                                "sense_id": "6688363e-2e8a-3ef0-92ef-0a2cd38ce6f7",
                                "text": "„Die Vokale Ö und Ü unterscheiden sich von E und I dadurch, dass bei ihnen auch die Lippen röhrenähnlich geformt werden, so dass diese eine Fortsetzung des engen Kanales bei E und I bilden.“"
                            },
                            {
                                "example_id": "8d8d9c9f-61cf-4b57-90dd-2c7f13558fcb",
                                "sense_id": "6688363e-2e8a-3ef0-92ef-0a2cd38ce6f7",
                                "text": "„An einigen Stellen ist das Knochengewebe kaum als solches zu erkennen, es erscheint körnig oder streitig und enthält wenig Hohlräume; an anderen Stellen sind die Hohlräume länglich, röhrenähnlich und verbinden sich mit einander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
