        "fr-extract.jsonl": [
            {
                "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                "word": "bastringue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6462d817-246d-4d89-a168-37853c66add7",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "tags": [
                            "plural"
                        ],
                        "form": "bastringues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Bal de guinguette."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a5a460be-89cd-4572-85d9-38cb2c9fdd07",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "On me demande pour un club et je tombe au milieu d’un bastringue."
                            },
                            {
                                "example_id": "47028885-0b39-4abe-b8fe-7830c02a5196",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "On était dans un bastringue de barrière, à la Boule-Noire, en plein mardi-gras ."
                            },
                            {
                                "example_id": "117baa9a-1f91-4c5b-9577-e1b6871d9128",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "L’orchestre, composé de cinq artistes de banlieue, jetait au loin sa musique de bastringue, maigre et sautillante."
                            },
                            {
                                "example_id": "6adbe49b-9dc3-47c5-b480-12726db466bb",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "Il y avait surtout beaucoup d’agents qui, leur capuchon sous le bras, allaient et venaient, d’un air paisible et faisait parfois halte pour écouter la musique des bastringues."
                            },
                            {
                                "example_id": "0a9d7a51-6b26-47f7-b881-0fcd649f84d2",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "Dimanche ! une route poudreuse, des amazones improvisées… Des guinguettes, des bastringues… Ici l’on danse !…"
                            },
                            {
                                "example_id": "212ab6eb-ba27-4a1f-901d-86f818acc7d8",
                                "sense_id": "a1b3cc30-641d-3bc9-9903-a7a5dca6a3a1",
                                "text": "Sa spécialité est de quêter des sous pour faire tourner le piano mécanique. L’important est de récolter plus de pièces qu’il n’en faut pour entretenir le bastringue : le surplus, c’est son tabac de la semaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "6765f204-1769-31ed-94cc-b79b8a88b768",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Vacarme, tapage."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "62c2b793-6360-46aa-99b9-ccf39121d5cc",
                                "sense_id": "6765f204-1769-31ed-94cc-b79b8a88b768",
                                "text": "On avait fait un tel bastringue qu’on a fini la nuit au poste."
                            },
                            {
                                "example_id": "2ec0ca60-1a4d-4fef-abba-97dc58217acd",
                                "sense_id": "6765f204-1769-31ed-94cc-b79b8a88b768",
                                "text": "Et le vent dehors, un vrai temps de salaud ! Le vent, la pluie, la grêle, le tonnerre, tout le bastringue, quoi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5bb30e49-16f6-3137-9357-278cb51ef3ce",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Attirail hétéroclite."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4813df-df61-426c-ad2f-d2c3995fd7a4",
                                "sense_id": "5bb30e49-16f6-3137-9357-278cb51ef3ce",
                                "text": "Ce fut justement l’extrême pauvreté de ce convoi — alors que nous savions tous parfaitement quelle puissance de destruction se trouvait enfermée dans ces bastringues de fer-blanc — qui créa une sorte d’effarement."
                            },
                            {
                                "example_id": "7eef134a-c1fd-4b2e-be05-6209f621a2d8",
                                "sense_id": "5bb30e49-16f6-3137-9357-278cb51ef3ce",
                                "text": "Sans médire, l’engin fonctionne potablement, mais si la pièce se coince, il faut aller le chercher pour lui demander de démonter le bastringue afin de la rendre."
                            },
                            {
                                "example_id": "aba3328d-4238-4491-8edd-3335baf53067",
                                "sense_id": "5bb30e49-16f6-3137-9357-278cb51ef3ce",
                                "text": "Ils ont dû remballer tout leur bastringue, l’emplacement avait déjà été réservé."
                            },
                            {
                                "example_id": "956369f6-86c1-4547-8d9f-56949cdb9a27",
                                "sense_id": "5bb30e49-16f6-3137-9357-278cb51ef3ce",
                                "text": "La morte ne portait pas de soutien-gorge, et quant à sa gorge, elle était ouverte comme il n’est pas permis, l’assassin avait flanqué en l’air jugulaire et carotide et tout le bastringue et c’était épouvantable à contempler."
                            }
                        ]
                    },
                    {
                        "sense_id": "228551ed-9e7f-3e6b-a714-2500f5eae1f7",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Ensemble des activités et de l’organisation du tabagn's."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d47f245e-e603-323f-a9a0-518fe837a4b8",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Juke-box."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32cb160-8419-4b2f-a7f9-0cea18115850",
                                "sense_id": "d47f245e-e603-323f-a9a0-518fe837a4b8",
                                "text": "J’enfilai le boulevard Brune, puis le boulevard Jourdan et m’arrêtai au Babel, le sympathique café en face de la Cité universitaire, où toutes les nationalités et toutes les races fraternisent sous les signes conjugués du Coca-Cola, du billard électrique et du bastringue."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bae2030-0956-3f7e-9171-37aad331a3f6",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Instrument volontairement désaccordé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a922f502-d79f-3832-8475-a8c0d704503d",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "Compas forestier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768a33cf-72ca-4f8d-acd5-70350f533d39",
                                "sense_id": "a922f502-d79f-3832-8475-a8c0d704503d",
                                "text": "On se sert tantôt du compas forestier dit bastringue, qui n’est autre que le compas de cordonnier beaucoup agrandi, tantôt de la chaîne ou du ruban métrique."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cd10c18-6155-3b26-97ac-dfddcc96dcae",
                        "entry_id": "41b1d66f-8d97-331e-b42f-f71b9d662847",
                        "glosses": [
                            "(féminin ou masculin) Fête bruyante réunissant, en principe, de nombreux participants."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8c155a-637c-4423-9231-a411c4743ae1",
                                "sense_id": "2cd10c18-6155-3b26-97ac-dfddcc96dcae",
                                "text": "Ça va être une puissante bastringue, je n'ai pas envie d’y aller."
                            },
                            {
                                "example_id": "61314419-a09e-4d1d-ae3b-07b8864a87cb",
                                "sense_id": "2cd10c18-6155-3b26-97ac-dfddcc96dcae",
                                "text": "Une bastringue, du \"hard\" et du café, on fait la noce ce week-end?"
                            }
                        ]
                    }
                ],
                "translations": [
