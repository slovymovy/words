                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40169c3b-d190-49e4-8415-6b83fb9e5adc",
                                "sense_id": "e6402f51-c448-31cf-856c-fa524a572ea7",
                                "text": "For this reason, green tea is frequently misbrewed, misunderstood, and thus not the tea of choice that it might otherwise be."
                            },
                            {
                                "example_id": "3e245e58-cbc7-4414-a020-968c064a39ec",
                                "sense_id": "e6402f51-c448-31cf-856c-fa524a572ea7",
                                "text": "That winter led, naturally, to the Olde GnarlyWine release, which the following year was accidentally-on-purpose misbrewed into Brown Shugga' when a flock of one-pound C&H brown sugar boxes found their way into the kettle following my incorect specification of the malt bill."
                            },
                            {
                                "example_id": "774cb231-8113-4475-81be-a40302cad92f",
                                "sense_id": "e6402f51-c448-31cf-856c-fa524a572ea7",
                                "text": "“Finally misbrew a potion?” Nan chuckled."
                            }
                        ]
                    }
