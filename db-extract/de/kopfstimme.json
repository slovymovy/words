                        "source_sense_id": "3e5900e9-9fd0-34cc-8790-7e84b4bee00c",
                        "source_sense_description": "Musik: hohe Stimmlage, bei der hauptsächlich der Kopf den Resonanzkörper bildet",
                        "target_lang_word": "head voice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "head voice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "790c5204-f0d2-39d2-b39e-4ef67dc46808",
                                        "entry_id": "c27fa53e-7b07-3a2e-a9ba-31cf68cfacb1",
                                        "glosses": [
                                            "A kind of voice of high pitch and of a thin quality ascribed to resonance in the head; voice of the thin register. In producing it, the vibration of the cords is limited to their thin edges in the upper part, which are then presented to each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66640b01-0840-32f3-90d0-d4c06468ac2f",
                                        "entry_id": "c27fa53e-7b07-3a2e-a9ba-31cf68cfacb1",
                                        "glosses": [
                                            "One's internal monologue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e54c1c6c-01a7-4111-9af0-a9bbacb93b63",
                                                "sense_id": "66640b01-0840-32f3-90d0-d4c06468ac2f",
                                                "text": "Since God is a personal God and if I were to recite the Pledge of Allegiance (One nation under God) in my living room in my voice or even in my head voice, would I be speaking for you and millions of others? Who would hear me? Am I allowed to speak for others?"
                                            },
                                            {
                                                "example_id": "51be7fa6-7c9b-4b1f-9e39-50b798fd0bee",
                                                "sense_id": "66640b01-0840-32f3-90d0-d4c06468ac2f",
                                                "text": "If I just had some encouragement other than my head voice...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cef73b7-5db6-498f-a649-fbc0700467c2",
                        "source_entry_id": "f0330cc4-daed-3bbb-9364-eea6cafbcc44",
                        "source_sense_id": "3e5900e9-9fd0-34cc-8790-7e84b4bee00c",
                        "source_sense_description": "Musik: hohe Stimmlage, bei der hauptsächlich der Kopf den Resonanzkörper bildet",
                        "target_lang_word": "voix de tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voix de tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e96d88-2a67-3429-8220-de0134c9006d",
                                        "entry_id": "64166076-e84e-38b7-948e-f49027e7fed2",
                                        "glosses": [
                                            "Fausset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b530fb8c-9dce-44fb-a6ed-6a5c5e5ba523",
                                                "sense_id": "c3e96d88-2a67-3429-8220-de0134c9006d",
                                                "text": "Quand je touche mon argent, au guichet, je lance un merci modulé, à voix de tête."
                                            },
                                            {
                                                "example_id": "c9df2f70-e842-4c57-a9d1-1d832e04b81d",
                                                "sense_id": "c3e96d88-2a67-3429-8220-de0134c9006d",
                                                "text": "Puis il avait parlé fort, de sa voix de tête, aiguë et lasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
