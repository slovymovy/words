                    {
                        "translation_id": "0423ed27-bda2-41af-bd70-4c838889e9b2",
                        "source_entry_id": "3f5d6c07-b746-3ef2-a218-043a5f2d4df5",
                        "target_lang_word": "nageboorte",
                        "target_lang_code": "nl",
