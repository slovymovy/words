                "translations": [
                    {
                        "translation_id": "cfc28dc5-2687-482b-94bc-80410c393638",
                        "source_entry_id": "8198f865-45c3-363c-9cc3-1f82c70ade1f",
                        "source_sense_id": "bf16fe47-5096-3ba3-b886-471aa14e48f1",
                        "target_lang_word": "Regina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "The reigning queen."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ff861a-dff8-4d99-a134-58ea2d56ebcf",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "Your Good FRIEND, / ANNE Regina. / SUNDERLAND."
                                            },
                                            {
                                                "example_id": "aa822268-1bfe-473a-bed0-0f02aeb56e85",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "The conveying of the Duc de Nevers and a Capuchin father to Civita Vecchia in 1608, was, indeed the Regina’s [Marie de’ Medici’s] sole real commission."
                                            },
                                            {
                                                "example_id": "6f66eddc-a317-4fad-8e14-9f2a86eea74b",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "Jesus is the new Adam, and Mary as the Queen of Heaven is His spouse and the perfection of Eve. / Perhaps the most explicit example of this felix culpa is displayed in the van Eyck Ghent Altarpiece. The artist used the same model for the shockingly nude Eve and for the Virgin Annunciate and her elevation to the heavens as the Regina, married to her own resurrected Son. Similarly, the model whom he used for Adam reappears in the inner presentation of the Altarpiece as Jesus in the role of the Regina’s Spouse."
                                            },
                                            {
                                                "example_id": "bc3dafea-1a9d-478c-a46a-165d3284178d",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "After work, she [Queen Victoria] would roll in her wheelchair along the smooth paths between the cypresses, palms and urns overflowing with flowers that crammed the Regina’s paradisical garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4793606a-898d-38b4-8956-05f477716c9e",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "The capital city of Saskatchewan, Canada, with a metropolitan population of about 250,000."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8291db0-bc46-33dd-877c-777c707b4d85",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "A neighborhood in the community of Nokomis, Minneapolis, Minnesota, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c46204f-ff77-30b6-b0a8-7ef5acf4e529",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "An unincorporated community in Jefferson County, Missouri, United States."
                                        ],
                                        "tags": [],
