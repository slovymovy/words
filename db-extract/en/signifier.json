    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                "word": "signifier",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "470c67da-c2cf-4a59-9f2e-8c4e5246ac7f",
                        "entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "tags": [
                            "plural"
                        ],
                        "form": "signifiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55a89e17-726a-336c-99fb-944173b262a8",
                        "entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "glosses": [
                            "Something or someone that signifies, makes something more significant or important."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806b2469-0948-483e-af87-2156f9a54a9b",
                                "sense_id": "55a89e17-726a-336c-99fb-944173b262a8",
                                "text": "If commentators have concurred on the characterization of Reagan as a synecdoche, they have also noted his status as a signifier."
                            }
                        ]
                    },
                    {
                        "sense_id": "b43d023c-f221-365a-85cb-b05e53bd3c79",
                        "entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "glosses": [
                            "Something or someone that signifies, makes something more significant or important.",
                            "A card representing a querent, question, or situation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4c6a730c-d4d3-3b8f-b812-d058c0b3ae9c",
                        "entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "glosses": [
                            "A sign, such as a written or spoken word, which refers to some concept, object or person, the signified."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0e019d-5aff-47de-8950-d50cd929de71",
                                "sense_id": "4c6a730c-d4d3-3b8f-b812-d058c0b3ae9c",
                                "text": "Here things are getting better and better for women and people of color, and gay men and lesbians, more and more integrated and open, and all you can think about is some stupid, lame problem with signifiers and signifieds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebb0d623-6b3a-4058-8f1e-0cf6c035fe3b",
                        "source_entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "source_sense_description": "(linguistics) the sound of spoken word or string of letters on a page that a person recognizes as a sign",
                        "target_lang_word": "signifikant",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7c51e5ad-498e-426d-aaf0-a389c006c06e",
                        "source_entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "source_sense_description": "(linguistics) the sound of spoken word or string of letters on a page that a person recognizes as a sign",
                        "target_lang_word": "signifiant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signifiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ae7322-8b51-3389-838d-16b3a9fa9117",
                                        "entry_id": "9a052a04-4e41-3e2f-b006-defc320e8647",
                                        "glosses": [
                                            "Qui signifie et opère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b767afba-fb7d-48ff-a00e-6a6f22be6066",
                                                "sense_id": "c9ae7322-8b51-3389-838d-16b3a9fa9117",
                                                "text": "Les sacrements sont les signes signifiants et effectifs de la grâce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c946f1f0-997b-32e0-8a4f-f99cd150089c",
                                        "entry_id": "9a052a04-4e41-3e2f-b006-defc320e8647",
                                        "glosses": [
                                            "Qui a de la signification, qui exprime beaucoup de choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7ac926-9a06-4bb5-894b-06ae89a2e9e9",
                                                "sense_id": "c946f1f0-997b-32e0-8a4f-f99cd150089c",
                                                "text": "Allégorie du genre féminin, aux longueurs codées selon les décennies, la jupe — dénoncée comme entravante et signifiante — n’est-elle pas en passe de devenir un symbole de réappropriation et de résistance face à des impératifs faits aux femmes ?"
                                            },
                                            {
                                                "example_id": "55f52694-9cef-48fa-8d0b-437f7f798405",
                                                "sense_id": "c946f1f0-997b-32e0-8a4f-f99cd150089c",
                                                "text": "Un des droits fondamentaux du petit enfant est qu'on porte une attention constante à ce qu'il dit. Il a besoin qu'on lui donne régulièrement des mots nouveaux. Il veut voir, dans les yeux de l'adulte, que l'on accueille avec vigilance ses tentatives parfois maladroites mais toujours signifiantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signifiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77c4b33b-fae9-3e21-a8c7-2f260089b624",
                                        "entry_id": "478d9939-8c00-382e-b328-fbab875dcc87",
                                        "glosses": [
                                            "Selon la terminologie instaurée par Ferdinand de Saussure, entité linguistique matérielle soit à l’oral ou à l’écrit, par opposition au signifié. On note généralement le signifiant en italique et le signifié entre guillemets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dcbc886-f5d5-40fe-ac24-b02dec30c5c3",
                                                "sense_id": "77c4b33b-fae9-3e21-a8c7-2f260089b624",
                                                "text": "Les unités significatives sont généralement désignées sous le nom de signes, leur sens étant dit signifié et leur forme parlée signifiant; […]."
                                            },
                                            {
                                                "example_id": "9f0806ef-9997-4aac-be7e-b6c676451d0c",
                                                "sense_id": "77c4b33b-fae9-3e21-a8c7-2f260089b624",
                                                "text": "Or il se trouve que dans ce pays (le Japon), l’emprise des signifiants est si vaste, il excède à tel point la parole, que l’échange des signes reste d’une richesse, d’une mobilité, d’une subtilité fascinantes en dépit de l’opacité de la langue, parfois même grâce à cette opacité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signifiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfda6fdd-a4bd-3de8-b27b-fa51dff10951",
                                        "entry_id": "58ac0603-5776-37a5-b644-7049d0732c52",
                                        "glosses": [
                                            "Participe présent du verbe signifier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54e1e2a5-842b-46ed-b7d2-cc5b7e075272",
                                                "sense_id": "dfda6fdd-a4bd-3de8-b27b-fa51dff10951",
                                                "text": "Mais Jules prenait un air ennuyé comme malgré lui, et Laurette, qui ne perdait rien de la situation, arborait un sourire signifiant : Tu peux toujours courir mon lapin désenligné !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c9953c-089f-42bc-b8bc-c9e87c1ffb25",
                        "source_entry_id": "8c5886cd-b824-33f6-8845-61d6f72b6e77",
                        "source_sense_description": "(linguistics) the sound of spoken word or string of letters on a page that a person recognizes as a sign",
                        "target_lang_word": "Signifikant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Signifikant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                        "entry_id": "85b92719-8e48-38bd-8ecb-9b7d8ad0f282",
                                        "glosses": [
                                            "anderer Ausdruck für signifiant: sinnlich wahrnehmbare Ausdrucksseite des sprachlichen Zeichens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90fe67dc-32fd-40e4-bd40-55eafcccbabd",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "Ein sprachliches Zeichen vereint in sich zwei Seiten: den sinnlich wahrnehmbaren Ausdruck, die Buchstaben- oder Lautfolge (Signifikant), und die damit verbundene Bedeutung: Signifikat. \"Hut\" z.B. besteht aus der Folge von 3 Buchstaben bzw. Lauten (Signifikant) und der damit verbundenen Bedeutung \"Art von Kopfbedeckung\" (Signifikat)."
                                            },
                                            {
                                                "example_id": "21c5ed9a-dc64-4e95-9ab8-6f3841e92cb1",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "„Saussure hat für Sprachzeichen eine bilaterale (zweiseitige) Ausdrucks- und Inhaltsstruktur angenommen, deren Zweiseitigkeit er durch die Termini Signifikant (»signifiant«) und Signifikat (»signifié«) angegeben hat.“"
                                            },
                                            {
                                                "example_id": "0184a531-e21d-4868-ada0-ed212355f4d7",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "„Die beiden Komponenten des Zeichens nennen wir Signifikant und Bedeutung.“"
                                            },
                                            {
                                                "example_id": "917a610d-016d-435d-abbe-33490981b4e6",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "„Werden nun z. B. in Wörterbüchern sprachliche Zeichen - Wort-Zeichen - fixiert, so erscheinen sie als bilaterale Einheiten, denn dem Formativ, dem verallgemeinerten Zeichenkörper, auch Signifikant, wird eine Bedeutung zugeschrieben - auch Signifikat."
                                            },
                                            {
                                                "example_id": "1909f0b5-e90a-4ec8-a2d4-2158055e811f",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "„So können etwa die seit jeher in Wörterbüchern angesetzten Lemmata unter der Voraussetzung, daß sie nicht einer bestimmten Belegform entsprechen, als Signifikanten in unserem Sinne beziehungsweise (exakter) als nominale Signeme (Namen) für solche Signifikanten aufgefaßt werden.“"
                                            },
                                            {
                                                "example_id": "85ff3411-a384-4571-9f7f-da4a45753ea2",
                                                "sense_id": "4c05553c-ca9a-35c4-b285-08c26fbab430",
                                                "text": "„Indem der Signifikant ›Volk‹ in einen bislang ungebräuchlichen außersprachlichen Kontext und sprachlichen Kontext gestellt wird, entsteht ein neues Signifikat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
