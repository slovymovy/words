                ],
                "senses": [
                    {
                        "sense_id": "3087fb52-0365-383a-872a-c52c7a53d54e",
                        "entry_id": "67bd5937-58ca-38a2-959b-6c9243a7afe9",
                        "glosses": [
                            "One who overachieves; one who has too much success."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d36244-b12a-4146-b7ac-0b41673aaa33",
                                "sense_id": "3087fb52-0365-383a-872a-c52c7a53d54e",
                                "text": "It is the portrait of one of the great teacher-parents, a zealot of European high culture self-confidently at work before the time that turned such a parent into a selfish tyrant and such a child into an \"overachiever,\" to use the philistine label which conveys the contemporary disdain for precocity and intellectual ardor."
                            },
                            {
                                "example_id": "40986997-919e-4ee1-bef8-e0b11cd08e21",
                                "sense_id": "3087fb52-0365-383a-872a-c52c7a53d54e",
                                "text": "But none of those is true for Mr. de Rothschild, who belongs instead to a multihyphened class of overachievers: eco-adventurer and green-evangelist."
                            },
                            {
                                "example_id": "8d452db9-cfb1-4963-a967-3d5a4b7ddfe2",
                                "sense_id": "3087fb52-0365-383a-872a-c52c7a53d54e",
                                "text": "The hyperfit athlete and the frail elderly woman are alike in that they are made in God's image. The lost rebellious teenager, the college overachiever, and the self-conscious middle schooler are all image bearers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18bec5b7-126f-43da-a582-b89ae8c435b0",
                        "source_entry_id": "67bd5937-58ca-38a2-959b-6c9243a7afe9",
                        "source_sense_id": "3087fb52-0365-383a-872a-c52c7a53d54e",
                        "source_sense_description": "one who overachieves",
                        "target_lang_word": "uitschieter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitschieter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "29485061-2d0d-3020-bbf1-789b602f1c57",
                                        "entry_id": "c257bcc9-8d94-3b0d-a85a-81157b87275e",
                                        "glosses": [
                                            "een waarneming die niet bij de overige lijkt te passen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c78eec5a-07fa-3176-a443-4fd1322187a3",
                                        "entry_id": "c257bcc9-8d94-3b0d-a85a-81157b87275e",
                                        "glosses": [
                                            "iets of iemand die heel veel beter of slechter is dan de rest, een prestatie die heel veel beter of slechter is dan de resultaten die men gewoonlijk behaalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467f8869-f643-4dbe-9cea-d2af8d09852d",
                                                "sense_id": "c78eec5a-07fa-3176-a443-4fd1322187a3",
                                                "text": "Sommige erfpachters met een lage buurstraatquote zijn dan ook blij met een laag voorstel, maar er zijn forse uitschieters aan de bovenkant. Zoals de 250.000 euro van Zikkenheimer, die vreest te moeten verhuizen. Van der Burg houdt tot nu toe echter vast aan de buurtstraatquote en de WOZ-waarde, beiden aangeraden door een commissie van experts."
                                            },
                                            {
                                                "example_id": "525afb56-e6f2-49b4-a91a-d429bf5c89fb",
                                                "sense_id": "c78eec5a-07fa-3176-a443-4fd1322187a3",
                                                "text": "Het dier legde de afstand af met soms erg hoge snelheden. Gemiddeld liep ze 46,3 kilometer per dag, maar op sommige dagen wist de vos veel grotere afstanden af te leggen, met een uitschieter van 155 kilometer. Waarschijnlijk gebruikte ze die dag het zee-ijs ‘als vervoersmiddel'."
                                            },
                                            {
                                                "example_id": "48a9ae40-a924-4cb3-a97b-be99dc2a26f9",
                                                "sense_id": "c78eec5a-07fa-3176-a443-4fd1322187a3",
                                                "text": "Bonnie is met windsnelheden tussen de 60 en 80 kilometer per uur nu nog een tropische storm van de zwakste categorie, zegt Geijs, hoewel er uitschieters naar boven mogelijk zijn. De lokale autoriteiten hebben echter uit voorzorg een stormwaarschuwing (Code Rood) gegeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
