                                                "sense_id": "84134579-4a80-3a43-95c0-dd69947b04af",
                                                "text": "Ich lebe in einem Großherzogtum."
                                            },
                                            {
                                                "example_id": "edceb271-49f1-4a29-a219-f957f34938b9",
                                                "sense_id": "84134579-4a80-3a43-95c0-dd69947b04af",
                                                "text": "Luxemburg ist das letzte noch existierende Großherzogtum."
                                            },
