                ],
                "senses": [
                    {
                        "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                        "entry_id": "bb449b75-b4ab-3ab1-963d-64b2ce4de8c1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48a60b6-6fc6-422f-ac37-dde12a42084d",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Frau Bruckmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "18ccf1e1-b956-45d4-8623-4e0aea439373",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Herr Bruckmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3a3193d3-4ec1-4b35-9cce-72798d48dfdf",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Die Bruckmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8c209bde-5cbf-481a-8ee4-65e8c6e1ab3d",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Der Bruckmann trägt nie die Schals, die die Bruckmann ihm strickt."
                            },
                            {
                                "example_id": "3e52138c-d817-4a79-b36d-be464869eaac",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bruckmann kommt, geht der Herr Bruckmann.“"
                            },
                            {
                                "example_id": "cd921895-1b34-46ea-8ee5-fa97805a6f63",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Bruckmann kommt und geht."
                            },
                            {
                                "example_id": "c38380dc-4cc1-495d-95d7-9594d221ee8c",
                                "sense_id": "15afd81c-b0cb-3fe5-b0dc-565d9fee2f9e",
                                "text": "Bruckmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
