                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To be recognized by a school or university as having completed the requirements of a degree studied at the institution."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6edbe4-c78d-49e8-9c77-ad8d0fb93cd3",
                                                "sense_id": "4fb849c1-070e-300f-b83a-7a93fdd9bb7a",
                                                "text": "The man graduated in 1967."
                                            },
                                            {
                                                "example_id": "f06be438-b469-4091-af5c-d9f5e77c8198",
                                                "sense_id": "4fb849c1-070e-300f-b83a-7a93fdd9bb7a",
                                                "text": "Trisha graduated from college."
                                            },
                                            {
                                                "example_id": "47e9e8ab-6a60-4ea5-9c73-c3aa265fdc75",
                                                "sense_id": "4fb849c1-070e-300f-b83a-7a93fdd9bb7a",
                                                "text": "After graduating from Princeton University, he earned a law degree in Canada, then worked as an environmental lawyer in Israel before settling on the south side of Youngstown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0510a85e-0751-3040-b378-7b476bf6b150",
                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To be certified as having earned a degree from; to graduate from (an institution)."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3988a1-de90-4fd6-ac52-da180b9f42c7",
                                                "sense_id": "0510a85e-0751-3040-b378-7b476bf6b150",
                                                "text": "Trisha graduated college."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e83d4d1-679f-31d3-afc8-7a793f013f09",
                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To certify (a student) as having earned a degree"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c574d40-9ba1-43c7-9c00-922265064863",
                                                "sense_id": "8e83d4d1-679f-31d3-afc8-7a793f013f09",
                                                "text": "Indiana University graduated the student."
                                            },
                                            {
                                                "example_id": "bc0eacd1-e48e-44e4-9b01-53b9682f893d",
                                                "sense_id": "8e83d4d1-679f-31d3-afc8-7a793f013f09",
                                                "text": "The college graduated him as soon as he was no longer eligible to play under NCAA rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3688932d-124b-3c4e-a436-bf36c65fd75f",
                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To mark (something) with degrees; to divide into regular steps or intervals, as the scale of a thermometer, a scheme of punishment or rewards, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "303f599e-5100-3cd3-a4d1-2a130071bce0",
                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To change gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd68303a-8390-42a9-b23e-abaacaaea8c3",
                                                "sense_id": "303f599e-5100-3cd3-a4d1-2a130071bce0",
                                                "text": "As the species graduate into each other, both in form and in habits, from the grass-eating Geese to the fish-eating Harelds, it is difficult, […] to divide this large group into sections."
                                            },
                                            {
                                                "example_id": "cd9836ae-e948-4c9b-bc07-f4e6f347b71a",
                                                "sense_id": "303f599e-5100-3cd3-a4d1-2a130071bce0",
                                                "text": "Yadav, born Bharat Kalicharan, was a petty thief who had graduated to bigger crimes, terrorising Kasturba Nagar, on the edge of the city of Nagpur, in Maharashtra, from the 1990s until his death."
                                            },
                                            {
                                                "example_id": "af9bf9db-d26b-4776-bcc3-1a1ce2684d30",
                                                "sense_id": "303f599e-5100-3cd3-a4d1-2a130071bce0",
                                                "text": "sandstone which graduates into gneiss; carnelian sometimes graduates into quartz"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a73a1a0-5286-3a25-b005-aa7da7dc4e67",
                                        "entry_id": "47820a1a-2c19-304b-9754-c0326882921a",
                                        "glosses": [
                                            "To prepare gradually; to arrange, temper, or modify by degrees or to a certain degree; to determine the degrees of."
                                        ],
                                        "tags": [],
                                        "examples": [
