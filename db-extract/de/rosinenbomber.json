                        "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                        "entry_id": "aa5a2880-3597-3ef5-ad62-108abbfd295a",
                        "glosses": [
                            "Flugzeug der amerikanischen und britischen Westalliierten, das im Rahmen der Berliner Luftbrücke (1948–1949) eingesetzt wurde"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "111648e5-f016-43c9-af1c-4d6c33c0d0e6",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "Noch immer sind Rosinenbomber als Touristenattraktion in Gebrauch."
                            },
                            {
                                "example_id": "6ca45caa-0179-46b3-a56f-72c83d5ff38d",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "„Damals starteten und landeten in Tempelhof die Rosinenbomber, wie die Berliner die blockadebrechenden Flugzeuge nannten, wie am laufenden Band.“"
                            },
                            {
                                "example_id": "31e7534d-7282-49db-beae-80caae560940",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "„Doch Washington fand noch einen Ausweg: Die Amerikaner gingen in die Luft, überbrückten mit ihren ‚Rosinenbombern‘ die Blockade zu Lande, akzeptierten aber auch die politische Teilung der Stadt durch die SED und gaben damit zu erkennen, daß sie sich mitsamt ihren beiden Verbündeten künftig nur noch für West-Berlin zuständig fühlten.“"
                            },
                            {
                                "example_id": "2c0853b6-c88d-4bd0-a099-da3e3c139a56",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "„Über uns flogen in Dreiminutenabständen die Rosinenbomber in die Stadt.“"
                            },
                            {
                                "example_id": "8d884d88-d51f-472c-a9b3-3a8ef839e1db",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "„Vor 51 Jahren kam der deutschstämmige Herman zum erstenmal an den Main – als Pilot eines ‚Rosinenbombers‘.“"
                            },
                            {
                                "example_id": "2402ca80-75ca-4263-adb8-ab2a44fb5175",
                                "sense_id": "e1381349-9ed0-317c-963f-2c7ca9dcdbac",
                                "text": "„Weil die Piloten aus ihren Cockpits oft auch Süßigkeiten für die Kinder abwarfen, wurden die Flugzeuge liebevoll als Rosinenbomber bezeichnet.“"
                            }
                        ],
