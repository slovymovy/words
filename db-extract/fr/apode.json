                                "example_id": "5cf8ca89-3457-45d2-9dab-abc269e03249",
                                "sense_id": "ad420643-655c-31e6-8d3e-8feeed22c61e",
                                "text": "Les serpents ont perfectionné plusieurs modes de locomotion apode.",
                                "translation": "Snakes have perfected several methods of limbless locomotion.",
                                "english": "Snakes have perfected several methods of limbless locomotion."
                            }
                        ]
                    }
