                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6993a90-2589-4369-babc-939e4afb0fdb",
                                "sense_id": "35572c11-2dd9-3898-b880-ded0247e9d72",
                                "text": "„Janosch Kriesten ist mit seinen Mitgründern auch auf die Anforderung gestoßen, bevor man ein Unternehmen gründet, einen Businessplan zu erstellen.“"
                            },
                            {
                                "example_id": "73d4ca9f-6b84-4dc4-872a-3e7c1e0d7844",
                                "sense_id": "35572c11-2dd9-3898-b880-ded0247e9d72",
                                "text": "„Die 36-Jährige heiratete in New Orleans ihren Freund Alexis Ohanian, den Mitgründer des Onlinedienstes Reddit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
