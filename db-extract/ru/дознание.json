                    }
                ],
                "senses": [
                    {
                        "sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                        "entry_id": "79c01aa6-177a-3b67-b061-06c3b3ccf8e4",
                        "glosses": [
                            "юр., офиц. вид предварительного расследования правонарушения, неотложные следственные действия по установлению и закреплению следов преступления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b258bd4b-1210-4250-93db-82536cca15d6",
                                "sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                                "text": "Марья Матвеевна, обнаружив эту оплошность, тотчас же произвела дознание, кто вчера последний лазил на чердак."
                            },
                            {
                                "example_id": "fcae9cf0-1724-47c3-9fa1-a7261843029a",
                                "sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                                "text": "Самый форменный был суд, с дознанием, с протоколами."
                            },
                            {
                                "example_id": "ac4e4dfe-3931-4c39-a9fb-30bcd91e6fb0",
                                "sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                                "text": "дознание ― форма предварительного расследования, осуществляемого дознавателем (следователем), по уголовному делу, по которому производство предварительного следствия необязательно;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ed5ed1-7783-4db6-bba4-21aea03746da",
                        "source_entry_id": "79c01aa6-177a-3b67-b061-06c3b3ccf8e4",
                        "source_sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                        "target_lang_word": "Ermittlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ermittlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d138732-60c9-3ed6-baf2-3b21f03dc5c7",
                                        "entry_id": "b7998519-5fcd-341a-8379-178fe90ccc40",
                                        "glosses": [
                                            "Aktivität, um noch Unbekanntes festzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76351157-753a-4c52-af5d-ffe4373e1dea",
                                                "sense_id": "5d138732-60c9-3ed6-baf2-3b21f03dc5c7",
                                                "text": "Der Mathematiklehrer stellte eine Textaufgabe. Für die Ermittlung des Ergebnisses durften die Schüler ihren Taschenrechner benutzen."
                                            },
                                            {
                                                "example_id": "eb94e104-c922-4c91-8d90-a3d84332b3d8",
                                                "sense_id": "5d138732-60c9-3ed6-baf2-3b21f03dc5c7",
                                                "text": "Weil die Ermittlung des Einkommens falsch war, habe ich gegen meinen Steuerbescheid Einspruch eingelegt."
                                            },
                                            {
                                                "example_id": "5c738bb4-3e34-4913-9405-94b5f6ec4390",
                                                "sense_id": "5d138732-60c9-3ed6-baf2-3b21f03dc5c7",
                                                "text": "Die Ermittlung des Wettkampfsiegers war schwieriger als erwartet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "846bab7c-7e9c-3cb0-884e-191aa45b7074",
                                        "entry_id": "b7998519-5fcd-341a-8379-178fe90ccc40",
                                        "glosses": [
                                            "Aktivität einer amtlichen Institution (Polizei, Zoll, …), um einen zweifelhaften Sachverhalt aufzuklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c151eb6c-3abe-470b-b2b8-b307c9916dbf",
                                                "sense_id": "846bab7c-7e9c-3cb0-884e-191aa45b7074",
                                                "text": "„Die Ermittlungen wurden eingestellt.“"
                                            },
                                            {
                                                "example_id": "f38ae485-b049-426f-a688-92ca8d91451e",
                                                "sense_id": "846bab7c-7e9c-3cb0-884e-191aa45b7074",
                                                "text": "„Die Ermittlungen ergaben, dass der Unfallverursacherin bereits im Februar 2016 der Führerschein entzogen worden war.“"
                                            },
                                            {
                                                "example_id": "759e9fa4-6b16-49a7-951e-11a6c8dadad4",
                                                "sense_id": "846bab7c-7e9c-3cb0-884e-191aa45b7074",
                                                "text": "„Ari hatte wirklich nicht vorgehabt, die Osterferien mit Ermittlungen zu verbringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae681d6c-1019-428b-9efd-5d821ab96c3d",
                        "source_entry_id": "79c01aa6-177a-3b67-b061-06c3b3ccf8e4",
                        "source_sense_id": "183cff3e-57d7-3eb7-abe6-a3798b8b1d4a",
                        "target_lang_word": "enquête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enquête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                        "entry_id": "122f4ffe-ecd2-3227-af8b-61a338f50500",
                                        "glosses": [
                                            "Recherche méthodique d’informations précises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3966fef-ddc5-4df0-b6f2-05e65b664d44",
                                                "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                                "text": "Rémi mena donc son enquête avec une prudence pointilleuse, n'hésitant pas à utiliser des subterfuges pour varier ses approches."
                                            },
                                            {
                                                "example_id": "b0d884ee-d1e2-4d21-aad4-f4ba20ddb4b0",
                                                "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                                "text": "[…] mais comme la mère Désiré agonisait et que quelques autres ne valaient guère mieux, il jugea que l’enquête rigoureuse et sévère qui s’imposait devait lui faire découvrir la source occulte de cette extraordinaire épidémie."
                                            },
                                            {
                                                "example_id": "143be3d6-b888-4567-9e1e-2a58c291321d",
                                                "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                                            },
                                            {
                                                "example_id": "8a6a0f1c-2a2f-4e17-8786-59ee54246468",
                                                "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                                "text": "Il n’est pas question d’entamer ici une enquête anthropologique sur la question de l’universalité des fictions ni de prendre parti en leur faveur ou en leur défaveur."
                                            },
                                            {
                                                "example_id": "4f0de1c8-12a6-4f05-b6f6-4a69fd71ee30",
                                                "sense_id": "8640c887-ee26-3074-bef6-c100305679ce",
                                                "text": "Déjà, les enquêtes menées un jour de semaine de septembre 2008 au départ de la gare de Paris Lyon ont révélé des taux de remplissage des trains pouvant atteindre 105%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                        "entry_id": "122f4ffe-ecd2-3227-af8b-61a338f50500",
                                        "glosses": [
                                            "Recherche méthodique d’informations précises.",
                                            "Recherche, preuve qui se fait en justice par audition de témoins."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbe4031-b270-4928-9a76-5a619c0ce428",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "Mais, à la longue, elle se vit contrainte de renoncer à ses méthodes iniques, parce trop d'enquêtes s'étaient tournées à sa confusion."
                                            },
                                            {
                                                "example_id": "5d00a3d4-cf41-4e5a-9592-8e08080ed0e7",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "Les parties étant contraires en faits, on ordonna une enquête."
                                            },
                                            {
                                                "example_id": "133ec4ac-a8ad-4967-bd07-a87022459c0b",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "Procéder à une enquête."
                                            },
                                            {
                                                "example_id": "a5fc6dd8-84b9-40b7-a65e-2813fde9c26b",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "L’ouverture, la clôture d’une enquête."
                                            },
                                            {
                                                "example_id": "089a8c71-2566-4052-94f6-23fc0b619c7b",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "L’enquête a été faite devant tel juge, par-devant tel juge."
                                            },
                                            {
                                                "example_id": "3fbbba56-6974-4e97-93e7-4d58c55870ee",
                                                "sense_id": "55e01593-1ca4-36d3-aa7d-f947e1568d49",
                                                "text": "Procès-verbal d’enquête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2024d3d0-713b-3ab2-b868-5f5324fa0696",
                                        "entry_id": "122f4ffe-ecd2-3227-af8b-61a338f50500",
                                        "glosses": [
                                            "Recherche méthodique d’informations précises.",
                                            "Recherche faites par ordre de l’autorité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdf681f-2d32-48ab-a8c3-355566ba46fb",
                                                "sense_id": "2024d3d0-713b-3ab2-b868-5f5324fa0696",
                                                "text": "Mener une enquête sur l’enseignement public, sur le régime pénitentiaire."
                                            },
                                            {
                                                "example_id": "8561638b-9c7d-4d0b-946f-a1ee368c7d2b",
                                                "sense_id": "2024d3d0-713b-3ab2-b868-5f5324fa0696",
                                                "text": "Nommer une commission d’enquête."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enquête",
