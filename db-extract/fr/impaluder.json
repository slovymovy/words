                ],
                "senses": [
                    {
                        "sense_id": "85d972f7-dbf4-39cc-8464-1c35d7866cf9",
                        "entry_id": "9295dc6e-1458-3d38-a222-030776b94ac2",
                        "glosses": [
                            "Inoculer le paludisme à (un malade, pour le soigner d’un autre mal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605e6cdd-9a5e-4125-a405-47034236093c",
                                "sense_id": "85d972f7-dbf4-39cc-8464-1c35d7866cf9",
                                "text": "On décida alors, entre autres, d’impaluder le patient, afin de provoquer un accès palustre, ou encore mieux si l’on peut dire, de l’insuliner, réalisant des comas de plus d’une demi-heure, à raison de quatre à cinq par semaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b35cbc1-9bc1-3b3c-bfed-e74b3cc7dadf",
                        "entry_id": "9295dc6e-1458-3d38-a222-030776b94ac2",
                        "glosses": [
                            "Devenir victime du paludisme."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1f1b9c-0347-4a9c-8067-7d43469f9096",
                                "sense_id": "2b35cbc1-9bc1-3b3c-bfed-e74b3cc7dadf",
                                "text": "La rate est normale comme aspect et comme volume : à la coupe, elle est plus dure que les rates qu’on est habitué à voir en Algérie (la saison à laquelle il a séjourné en Afrique ne lui a pas permis de s’impaluder)."
                            }
                        ]
                    }
