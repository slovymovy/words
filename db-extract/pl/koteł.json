                "senses": [
                    {
                        "sense_id": "325a3fc3-9a1f-3720-ae9d-fc24366dbf00",
                        "entry_id": "8b835e8f-4536-3b88-8959-6ec1f75b0fdd",
                        "glosses": [
                            "kot"
                        ],
                        "tags": [
                            "humorous",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5e79f3d7-00d6-406f-b3f6-3458be186ad5",
                                "sense_id": "325a3fc3-9a1f-3720-ae9d-fc24366dbf00",
                                "text": "Mój koteł nie pozwala mi grać w gierki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db38e1c-402b-44e6-8c7f-6db793e4b01b",
                        "source_entry_id": "8b835e8f-4536-3b88-8959-6ec1f75b0fdd",
                        "source_sense_id": "325a3fc3-9a1f-3720-ae9d-fc24366dbf00",
                        "target_lang_word": "cate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                        "entry_id": "f61aefb5-691a-3e3f-930e-8ccb7e9eb6cb",
                                        "glosses": [
                                            "A delicacy or item of food."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2c2ad1-0a49-4bf7-a63c-94186f05f68a",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "Kate of Kate-hall, my super-daintie Kate, / For dainties are all Kates, and therefore Kate / Take this of me, Kate of my consolation […]"
                                            },
                                            {
                                                "example_id": "191abd65-cd4e-407b-9ca8-24d50732ecb5",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "Have we not heard of divers most fertile regions, plenteously yeelding al maner of necessary victuals, where neverthelesse the most ordinary cates [translating méz] and daintiest dishes, were but bread, water-cresses, and water?"
                                            },
                                            {
                                                "example_id": "ff131a83-4472-496d-bb45-a37f34639355",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "All cates and dainties shall be stored there / Quickly on this feast-night: [...]"
                                            },
                                            {
                                                "example_id": "e204899c-dc1d-4909-ade4-179ee71f257c",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "He did not at first produce the cates and vintages they expected; they looked, most of them, puzzled at the lack of materials of revelry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
