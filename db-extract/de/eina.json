            {
                "entry_id": "38cda2c5-9d9f-35de-97bd-1828c4f273e9",
                "word": "eina",
                "pos": "adv",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "9e05d12a-b0f7-40d6-a8d2-b74dfafa5994",
                        "entry_id": "38cda2c5-9d9f-35de-97bd-1828c4f273e9",
                        "tags": [
                            "variant"
                        ],
                        "form": "einher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                        "entry_id": "38cda2c5-9d9f-35de-97bd-1828c4f273e9",
                        "glosses": [
                            "herein"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "fbfafd29-1fda-4522-83a3-aac5fa849895",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "Kommen S’ eina!"
                            },
                            {
                                "example_id": "89e91a7f-c3af-44a0-813f-539e82dcbad0",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Nur die Buam derf’n eina‘ — sagte er.“"
                            },
                            {
                                "example_id": "eb4dfe78-e86f-4980-9384-7ab3b998e035",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Konnt’st scho’ eina,‘ rief die Waben,[…] ‚i lieg’ scho’.‘“"
                            },
                            {
                                "example_id": "b2496908-3ad8-4622-8511-2356dcbc38bb",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Da eina!‘ schrie er scharf und befehlend in den Laden hinaus.“"
                            },
                            {
                                "example_id": "29b27b1b-73aa-41f8-934e-fa5111032cde",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Han i net g’sagt, ins Haus kimmst ma nimma eina!‘ rief der Wegbrunner und trat auf dem Pflaster herum, ohne sich von der Stelle zu bewegen.“"
                            },
                            {
                                "example_id": "7c48913b-120a-435e-9caa-fede996eeabc",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Do kemmz eina‘, rief er uns zu, ‚eez werdz ja batscherl noß‘.“"
                            },
                            {
                                "example_id": "74e8f40d-7374-484e-a9fa-17df111e9ea0",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„Fahrts lei mitn Auto in Hof eina, sagte er.“"
                            },
                            {
                                "example_id": "50f4ea2c-69bd-40c8-9eab-58f84f491695",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„Wenn Odad zu Hansi ‚Hol’s Taferl eina!‘ sagte, war gute Stimmung im Haus, denn das bedeutete, daß die zwei Zweibettzimmer und das Einbettzimmer vermietet waren.“"
                            },
                            {
                                "example_id": "e7e87ee0-b1ed-4426-938b-452ae6d3d44c",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Kemmt’s eina!‘ rief Franzis Vater zur Tür heraus.“"
                            },
                            {
                                "example_id": "0e0970fb-5b64-4eeb-9e57-0c7067d252e6",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Schaud a scho wieder eina?‘ sagt ein Gast zur jungen Kellnerin.“"
                            },
                            {
                                "example_id": "5ac1bcf4-b878-4dda-815c-2302f9031506",
                                "sense_id": "0957d37d-e21d-3ca6-972e-27da4ee01aba",
                                "text": "„‚Als dann, gehns eina‘, sagte sie schließlich, nicht unfreundlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
