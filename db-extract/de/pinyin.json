                "senses": [
                    {
                        "sense_id": "05e25a12-3d16-316b-a690-74bedfcbd288",
                        "entry_id": "68c3e35d-0873-3c18-b54c-5136bad8c6fd",
                        "glosses": [
                            "Alphabetschrift, die eigens für das Chinesische entwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "918cbde5-e0ac-4f3c-a837-c1c2afb08ab4",
                                "sense_id": "05e25a12-3d16-316b-a690-74bedfcbd288",
                                "text": "„Doch erst seit 1958 gibt es eine staatlich anerkannte Alphabetschrift, das sogenannte Pinyin (chinesisch pin, zusammensetzen, yin, Silbe).“"
                            },
                            {
                                "example_id": "6c9baf81-957a-4e30-8946-b87a430696ab",
                                "sense_id": "05e25a12-3d16-316b-a690-74bedfcbd288",
                                "text": "„Nunmehr hat die Regierung der Volksrepublik China ein Transkriptionssystem eingeführt, genannt Pinyin, wörtlich »Buchstabieren«, das sich international schon weitgehend durchgesetzt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
