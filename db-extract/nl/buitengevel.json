                        "glosses": [
                            "een van de zijden aan de buitenkant van een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c3479b-cdd4-4f1c-ac83-50bb84cfedee",
                                "sense_id": "0cfebb8b-dccd-32b2-b77c-c82c9bd7393b",
                                "text": "De woorden \"Centraal Station\" prijken weer boven de ingang van het treinstation van Rotterdam. Veel inwoners van de stad hadden aangegeven dat ze de letters van het oude station graag zouden terugzien op de buitengevel van het nieuwe gebouw."
                            },
                            {
                                "example_id": "29720a0c-7e51-4dcd-a54e-75d6d2222dec",
                                "sense_id": "0cfebb8b-dccd-32b2-b77c-c82c9bd7393b",
                                "text": "Meer dan 200 brandweerlieden deden ondanks de bittere kou hun best om het pakhuis van de ondergang te redden. Uiteindelijk bleef weinig meer over dan een in ijsgehulde buitengevel."
                            }
                        ]
                    }
