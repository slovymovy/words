                "senses": [
                    {
                        "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                        "entry_id": "13445796-4773-3054-a9ab-c610c5fae991",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60e2327-b5b6-4dae-8db2-b7392ece5638",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Frau Schubart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "01dd76ef-6148-4a9d-b81a-91ed2d4f47a3",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Herr Schubart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dbecfac3-622b-4f22-a43b-0fbe0873d3b1",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Die Schubarts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1f3e089d-e8f4-495a-acba-323574d0967c",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Der Schubart trägt nie die Schals, die die Schubart ihm strickt."
                            },
                            {
                                "example_id": "0a9f0fac-db20-46be-bd53-f788a6f7ee4a",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schubart kommt, geht der Herr Schubart.“"
                            },
                            {
                                "example_id": "4e8f687a-86a7-4ef2-8d28-2ac152b5c1ab",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Schubart kommt und geht."
                            },
                            {
                                "example_id": "282157e9-5c13-4e0a-812a-02060589a19f",
                                "sense_id": "4ddff44c-81b7-36c3-a009-b5767c6b1389",
                                "text": "Schubarts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
