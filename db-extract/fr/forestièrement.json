                "senses": [
                    {
                        "sense_id": "395f14ab-8664-38c7-b6f9-2a3f6aa9b3b2",
                        "entry_id": "9f4d8691-36db-3251-8a2e-21d14dc3f301",
                        "glosses": [
                            "En ce qui concerne la forêt ou les forestiers ; d'une manière forestière."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "ff0bfb52-42b5-42a7-a41f-ca1b81af3b57",
                                "sense_id": "395f14ab-8664-38c7-b6f9-2a3f6aa9b3b2",
                                "text": "Finot dirigea contre l’huile de Macassar cette charmante plaisanterie qui faisait tant rire aux Funambules, quand Pierrot prend un vieux balai de crin dont on ne voit que les trous, y met de l’huile de Macassar, et rend ainsi le balai forestièrement touffu."
                            },
                            {
                                "example_id": "14043ee5-1db4-4d87-96f1-486083af0010",
                                "sense_id": "395f14ab-8664-38c7-b6f9-2a3f6aa9b3b2",
                                "text": "Forestièrement parlant, ceci peut servir à expliquer la longue absence de tout progrès dans l’éducation des bois, et tout ensemble le peu d'intérêt qu'on a mis à les relever de cet état d'incurie, pour ainsi dire, systématique, qui les menaçait de ruine."
                            },
                            {
                                "example_id": "df8cca58-e296-4552-b744-147144ec9cb4",
                                "sense_id": "395f14ab-8664-38c7-b6f9-2a3f6aa9b3b2",
                                "text": "C'est à partir de cette époque que le pourtour Méditerranéen commença à décliner forestièrement. De magnifiques futaies résineuses existaient, mais progressivement, les troupeaux de caprins et les violents incendies, les décimaient."
                            }
                        ]
                    }
