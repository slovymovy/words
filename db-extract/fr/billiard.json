                    {
                        "translation_id": "d4ca8405-d492-4807-b5a2-dfe847fd69ec",
                        "source_entry_id": "5ea9539e-d1e6-3f7f-b237-1e57718331d8",
                        "source_sense_id": "29225e7a-0e91-3510-942f-f9667f949d9f",
                        "target_lang_word": "биллиард",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "биллиард",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eca9f54c-c761-3623-b451-266777648246",
                                        "entry_id": "bfa2f326-2519-3aa1-8203-d3521daf7339",
                                        "glosses": [
                                            "устар. название числа 10¹⁵ в системе Шюке — Пелетье (Пельтье), миллион миллиардов, квадрильон"
                                        ],
                                        "tags": [
                                            "числит."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a87f6d7-20b3-4881-a547-5b2e4992b551",
                                                "sense_id": "eca9f54c-c761-3623-b451-266777648246",
                                                "text": "Биллиард, 1000 миллиардов или 1000 биллионов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d87f5e-b179-3b9e-9256-11b3ae4abb17",
                                        "entry_id": "bfa2f326-2519-3aa1-8203-d3521daf7339",
                                        "glosses": [
                                            "перен. очень большое число"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c05abb-f770-4aeb-baec-bfdb3b30c36c",
                                                "sense_id": "59d87f5e-b179-3b9e-9256-11b3ae4abb17",
                                                "text": "— А музеи, картинные галереи! Идёшь — удивляешься, сколько в каждую вещь красоты убухано! На миллионы, на биллионы. // — А по мне, хошь на миллиарды, хошь на биллиарды, ― их дело."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "биллиард",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9232ae4a-3a21-3cca-80ff-67d07ec7a4d5",
                                        "entry_id": "533f20e5-efc5-35f0-89ba-973700b9e208",
                                        "glosses": [
                                            "то же, что бильярд; игра с шарами и кием на специальном столе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a13b368-197d-4d9b-8024-35a83a25aaf4",
                                                "sense_id": "9232ae4a-3a21-3cca-80ff-67d07ec7a4d5",
                                                "text": "Играли в биллиард и другие игры для препровождения времени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "826bdea1-a4e7-351e-a313-fda7093cb227",
                                        "entry_id": "533f20e5-efc5-35f0-89ba-973700b9e208",
                                        "glosses": [
                                            "то же, что бильярд; стол для такой игры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f26f947b-9291-44bd-9b8e-e010763b84da",
                                                "sense_id": "826bdea1-a4e7-351e-a313-fda7093cb227",
                                                "text": "Поневоле пойдешь в трактир и станешь играть на биллиарде; а для того надобно уметь играть!"
                                            },
                                            {
                                                "example_id": "b5f5b8ef-0742-45ed-a93d-54dc90018c17",
                                                "sense_id": "826bdea1-a4e7-351e-a313-fda7093cb227",
                                                "text": "Я стоял у биллиарда и по неведению заслонял дорогу, а тому надо было пройти; он взял меня за плечи и молча, — не предуведомив и не объяснившись, — переставил меня с того места, где я стоял, на другое, а сам прошел как будто и не заметив."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9cb13b-64c6-3024-a350-5377898bbbc0",
                                        "entry_id": "533f20e5-efc5-35f0-89ba-973700b9e208",
                                        "glosses": [
                                            "матем. то же, что бильярд; математическая модель этой игры: динамическая система, которая описывает движение материальной точки в некоторой ограниченной области многообразия с условием упругого отражения от границы по закону «угол падения равен углу отражения»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987f4f85-c11b-434a-adf9-394a10e1d340",
                                                "sense_id": "7f9cb13b-64c6-3024-a350-5377898bbbc0",
                                                "text": "Динамический биллиард отличается от классического математического биллиарда тем, что в нём биллиардная точка двигается в заданном поле сил."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
