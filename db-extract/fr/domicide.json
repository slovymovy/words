                "senses": [
                    {
                        "sense_id": "e410f38e-000c-341c-99d1-c63e72737bdd",
                        "entry_id": "ba5f7eb5-397d-3bbb-9f88-2c8272ce7ddb",
                        "glosses": [
                            "Destruction de domiciles ou entrave à leur construction, de manière systématique, à l'échelle d'un groupe humain."
                        ],
                        "tags": [
                            "Droit international"
                        ],
                        "examples": [
                            {
                                "example_id": "f4a6c002-80b5-4581-a066-d99c01703776",
                                "sense_id": "e410f38e-000c-341c-99d1-c63e72737bdd",
                                "text": "« La démolition systématique de maisons palestiniennes, l’érection de colonies israéliennes illégales et le refus systématique de permis de construire pour les Palestiniens en Cisjordanie occupée s’apparentent à un “domicide” », soutiennent les trois rapporteurs, parmi lesquels figure Balakrishnan Rajagopal, spécialisé sur le logement convenable."
                            },
                            {
                                "example_id": "39be04a6-564e-4e6b-8a6a-0093b948093d",
                                "sense_id": "e410f38e-000c-341c-99d1-c63e72737bdd",
                                "text": "Le ravage est d’une ampleur telle que le rapporteur spécial de l’ONU sur le droit à un logement convenable a suggéré d’ajouter le concept de « domicide » à la liste des crimes contre l’humanité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43e75a1b-c4a0-4935-a19a-30d150447293",
                        "source_entry_id": "ba5f7eb5-397d-3bbb-9f88-2c8272ce7ddb",
                        "source_sense_id": "e410f38e-000c-341c-99d1-c63e72737bdd",
