                                    {
                                        "sense_id": "1651f0c6-904f-38fb-83cd-18df1cc65d66",
                                        "entry_id": "b5b8e981-b54c-3083-b2e2-448e34fd2aaa",
                                        "glosses": [
                                            "Sorte de luth à deux chevilliers et à son plus grave que le luth ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af7711c-6135-48dd-815d-eaf7e56f2561",
                                                "sense_id": "1651f0c6-904f-38fb-83cd-18df1cc65d66",
                                                "text": "Le téorbe est une bandurka perfectionnée, espèce de luth un peu plus grand et ventru; les cordes en sont de métal; on les pinçait avec les doigts de la main droite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e091dee8-d1b9-47f1-bc03-09d08c93ec92",
                        "source_entry_id": "96a9e8a7-9ec4-3df5-9517-1af8b1d34f85",
