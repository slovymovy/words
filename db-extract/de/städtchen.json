                        "form": "die Städtchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                        "entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                        "glosses": [
                            "kleine Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d750945-ffc7-47d3-918f-5c9f4fd6f17f",
                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                "text": "„Auf dem höchsten Punkt des Latium zum Beispiel, in dem Städtchen Guadagnolo, sieht in meinem Lieblingslokal zwischen den Amaro-Flaschen vom Regal hinter der Kasse eine gar nicht so kleine Figur des Duce der Wirtin über die Schulter.“"
                            },
                            {
                                "example_id": "77901bc6-c972-477f-8be1-1a28f97a1502",
                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                "text": "„Das kleine Städtchen Ilulissat liegt 250 Kilometer nördlich des Polarkreises, hat fünftausend Einwohner und ebenso viele Schlittenhunde, einhundert angemeldete Autos, aber keine Ampel.“"
                            },
                            {
                                "example_id": "e81a554d-b022-4ffe-bb0f-23d1c9b199e6",
                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                "text": "„Augustinus wurde im Städtchen Tagaste in Nordafrika geboren, ging aber schon mit sechzehn Jahren zum Studium nach Karthago.“"
                            },
                            {
                                "example_id": "3645092c-afd5-448f-95e9-c65acf455371",
                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                "text": "„Ein hübsch am See gelegenes Städtchen, das sich, ruhig im Zonenrandgebiet gelegen, idyllisch gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23ccb733-bbc8-4441-b4c3-8a6942265113",
                        "source_entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                        "source_sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                        "source_sense_description": "kleine Stadt",
                        "target_lang_word": "small town",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small town",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7deb75c-586c-3a24-ad5f-edf09ace9266",
                                        "entry_id": "239b7341-762a-3306-b55e-e806f89ddcf6",
                                        "glosses": [
                                            "A small (generally rural) town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5e3f3d-5ccb-42fd-be0f-dcf85977df67",
                                                "sense_id": "b7deb75c-586c-3a24-ad5f-edf09ace9266",
                                                "text": "I went to heaven,– / ’T was a small town, / Lit with a ruby, / Lathed with down."
                                            },
                                            {
                                                "example_id": "f0213c22-654c-406f-b4a8-49a7a1424b1f",
                                                "sense_id": "b7deb75c-586c-3a24-ad5f-edf09ace9266",
                                                "text": "There's only one good use for a small town / You hate it—and you know you'll have to leave"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23cb4ebd-a273-4212-9e6e-e6cec6381a52",
                        "source_entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                        "source_sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                        "source_sense_description": "kleine Stadt",
                        "target_lang_word": "little town",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "92366c4e-ee78-4646-839b-26cafc4f8634",
                        "source_entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                        "source_sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                        "source_sense_description": "kleine Stadt",
