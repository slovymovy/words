                            {
                                "example_id": "8538f088-4a70-431f-a171-67e7263edad4",
                                "sense_id": "eb5894df-9aa6-31fb-862e-55181d5c7438",
                                "text": "Ein Yogin kann sich, je nach Vorliebe, auf Shiva, Vishnu oder eine andere Gottheit ausrichten."
                            },
                            {
                                "example_id": "12841088-728a-4ae3-9dbe-7087253a58b2",
                                "sense_id": "eb5894df-9aa6-31fb-862e-55181d5c7438",
                                "text": "Es ist nicht schwer zu verstehen, dass sie in dieser Form – als Yoginis, Gefährtinnen des Yogins – den tantrischen Asketen zu Göttinnen der Inspiration wurden."
                            }
                        ],
