                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3a68d9-76db-4e9f-a7d3-76be172d9f44",
                                "sense_id": "0ca18792-21b4-3345-a353-80f64ef5af6f",
                                "text": "John Conley attested, That in the Lords Faulkland, Grandison and Chichester's times, the King's Rents werde collected by Horse-men, who laid upon them till they were paid."
                            },
                            {
                                "example_id": "d0dbb2e3-c4ed-49a1-82f0-a634ccf6831d",
                                "sense_id": "0ca18792-21b4-3345-a353-80f64ef5af6f",
                                "text": "After she was brutally murdered, Jim Conley, the black janitor at the factory, testified that Frank had killed the girl, then forced Conley to dispose of the body."
                            }
                        ]
                    },
                    {
                        "sense_id": "91f340bb-075c-3b7a-afaf-671cce266c2c",
