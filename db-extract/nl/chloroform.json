                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7422744-de1f-34b3-86e1-4888f2839218",
                        "entry_id": "69431654-164d-322b-8ba1-ed16d04a94de",
                        "glosses": [
                            "trichloormethaan, zeer vluchtige vloeistof, gebruikt als verdovend middel"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4155d99a-1e16-47aa-87fe-2dd5bec5756e",
                        "source_entry_id": "69431654-164d-322b-8ba1-ed16d04a94de",
                        "source_sense_id": "b7422744-de1f-34b3-86e1-4888f2839218",
                        "target_lang_word": "Chloroform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chloroform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                        "entry_id": "cb6d736b-8840-39a8-bc4e-1a896ec5b971",
                                        "glosses": [
                                            "ein 1831 erstmals hergestellter chlorierter Kohlenwasserstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3651edf5-a996-4eee-ba32-fe86eae125c9",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Ihm gelang 1831 die Herstellung von Chloroform, unabhängig von Justus von Liebig und Eugene Souberain.“"
                                            },
                                            {
                                                "example_id": "c0bfc149-47e8-45e6-aafa-df03e3fa5bda",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Am Abend des 4. November 1847 testete er mit zwei Freunden in einer privaten Runde Chloroform als Narkosemittel.“"
                                            },
                                            {
                                                "example_id": "f19f081f-8001-492f-b5b9-85931ba9bc14",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Die Vorteile des neuen Medikamentes lagen darin, dass es leicht herstellbar war, gut sedativ wirkte und wenig Nebenwirkungen aufwies, auch nicht den vom Chloroform bekannten und gefürchteten Rausch.“"
                                            },
                                            {
                                                "example_id": "bc0f6239-d29c-4819-9bf6-146e099260e5",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Aus der spanischen Fliege, einem Käfer, der zu den Forstschädlingen gehört, wird durch Ausziehn mit Chloroform eine organische Substanz, das Kantharidin, gewonnen, die offizinell ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fc38b99-d46d-4767-a5a0-c87cf6ad2ce5",
                        "source_entry_id": "69431654-164d-322b-8ba1-ed16d04a94de",
                        "source_sense_id": "b7422744-de1f-34b3-86e1-4888f2839218",
                        "target_lang_word": "Trichlormethan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trichlormethan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c89f750-d445-3611-9365-814c7b2218ab",
                                        "entry_id": "1307293d-e7e1-351d-9903-43cb76a99b85",
                                        "glosses": [
                                            "organische Verbindung aus einer Methylgruppe und drei Chloratomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f22e144-f68d-4acf-8206-e29278dba995",
                                                "sense_id": "8c89f750-d445-3611-9365-814c7b2218ab",
                                                "text": "„Dabei reagiert Methan mit Chlor unter Bildung von Chlorwasserstoff zunächst zu Chlormethan, dann weiter zu Dichlormethan, Trichlormethan und schließlich zu Tetrachlormethan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba9bda5d-70d1-440f-b526-622f3fb1c3b3",
                        "source_entry_id": "69431654-164d-322b-8ba1-ed16d04a94de",
