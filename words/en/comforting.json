                                "target_lang_sense_clarification": "łagodzący ból lub stres"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36e801f9-b6bc-383c-84bf-9174f7510951",
                    "sense_definition": "Present participle and gerund of <w>comfort</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was gently <w>comforting</w> the crying child after he fell.",
                            "target_lang_translations": {
                                "pl": "Delikatnie <w>pocieszała</w> płaczące dziecko po tym, jak upadło."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>comforting</w> his friend who had lost a pet.",
                            "target_lang_translations": {
                                "pl": "Spędził całe popołudnie na <w>pocieszaniu</w> przyjaciela, który stracił zwierzę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma czasu teraźniejszego (imiesłów przysłówkowy współczesny / rzeczownik odczasownikowy) od czasownika comfort: pocieszać, uspokajać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pocieszanie",
                                "target_lang_sense_clarification": "rzeczownik odczasownikowy"
                            },
                            {
                                "target_lang_word": "pocieszając",
                                "target_lang_sense_clarification": "imiesłów przysłówkowy współczesny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9e82f3b-b4ca-39f3-822d-707768bc8632",
                    "sense_definition": "The act of providing comfort or solace to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient responded well to the quiet <w>comforting</w> offered by the nurse.",
                            "target_lang_translations": {
                                "pl": "Pacjent dobrze zareagował na ciche <w>pocieszanie</w> ze strony pielęgniarki."
                            }
                        },
                        {
                            "text": "They sat together by the fireplace, cheered by the simple <w>comfortings</w> of home.",
                            "target_lang_translations": {
                                "pl": "Siedzieli razem przy kominku, radując się prostym domowym <w>ukojeniem</w>."
                            }
