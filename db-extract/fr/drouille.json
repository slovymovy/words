                "senses": [
                    {
                        "sense_id": "bd341ebc-4072-3c04-9d9e-e9550ded82fa",
                        "entry_id": "ee3bba1d-7af5-34d0-90cb-4d4e2d785574",
                        "glosses": [
                            "Femme de mauvaise vie."
                        ],
                        "tags": [
                            "offensive",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a649327d-fe0b-328a-b91d-5a3cac7e1959",
                        "entry_id": "ee3bba1d-7af5-34d0-90cb-4d4e2d785574",
                        "glosses": [
                            "Marchandise sans valeur."
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0aa2db56-be99-4e18-bc46-927da74340d3",
                                "sense_id": "a649327d-fe0b-328a-b91d-5a3cac7e1959",
                                "text": "La drouille, les polars à un franc, les reproductions aux couleurs criardes de poulbots, ce n’était pas son truc."
                            },
                            {
                                "example_id": "6afefae7-82d0-4364-b881-54d4447c2c26",
                                "sense_id": "a649327d-fe0b-328a-b91d-5a3cac7e1959",
                                "text": "Et Mick, y vendait d’la drouille aux puces et sur les marchés."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f717d3a-8afd-3cd1-902c-4c5c0cf6693a",
                        "entry_id": "ee3bba1d-7af5-34d0-90cb-4d4e2d785574",
                        "glosses": [
                            "Ancienne pièce de monnaie très usée, dont la valeur marchande est quasi nulle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f45c407-a52f-451e-8d8a-48808650b574",
                                "sense_id": "4f717d3a-8afd-3cd1-902c-4c5c0cf6693a",
                                "text": "Alors, je sais bien que c'est pas parce qu'un vendeur est malhonnête qu'il faut être malhonnête aussi, mais quand j'ai vu cette pièce dans sa boîte à drouille, alors que je ne m'intéresse pas du tout aux monnaies américaines, j'ai tout de suite compris que cette pièce valait peut-être quelque chose, ou, tout du moins, avait une histoire numismatique intéressante."
                            },
                            {
                                "example_id": "233252d4-9a44-441a-8b0c-f61ec7f90385",
                                "sense_id": "4f717d3a-8afd-3cd1-902c-4c5c0cf6693a",
                                "text": "Pour la drouille de monnaies modernes autre que cuivre bronze argent et métaux précieux pas de problème avec de l'huile, pour cuivre et bronze (romaines napoléon III Cérès dupuis etc ... ) attention à la patine."
                            }
                        ]
                    }
                ],
