                                "target_senses": [
                                    {
                                        "sense_id": "24fa6951-9600-31b8-880f-47bc143cc37d",
                                        "entry_id": "8821805e-f7ff-32cb-980c-d53910ab67cf",
                                        "glosses": [
                                            "A patient who receives treatment at a hospital or clinic but is not admitted overnight; a receiver of ambulatory care."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f796f175-7c40-4c72-9bc6-cae11b7b0499",
                                                "sense_id": "24fa6951-9600-31b8-880f-47bc143cc37d",
                                                "text": "An empty shop at Birmingham New Street station has been converted into an NHS outpatient clinic, to enable patients to have routine blood tests away from hospital."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outpatient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2f8fbd-ffb3-3fba-8696-1a2d058a1d14",
                                        "entry_id": "1be4d924-d83b-3468-9b91-9c49a4ef4cac",
                                        "glosses": [
                                            "Provided without requiring an overnight stay by the patient."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f2c973-8833-4e0b-88fa-3339a3ea7a9c",
                                                "sense_id": "fc2f8fbd-ffb3-3fba-8696-1a2d058a1d14",
                                                "text": "MR. MILLER: It is more outpatient than it is inpatient."
                                            },
                                            {
                                                "example_id": "5c332f87-61f9-45b5-8f4a-cde915e2ce3b",
                                                "sense_id": "fc2f8fbd-ffb3-3fba-8696-1a2d058a1d14",
                                                "text": "The changes are necessary because \"health care is going more outpatient than inpatient,\" Whitacre said."
                                            },
                                            {
                                                "example_id": "9aaf78bb-8bb8-41f5-8ba8-6658f84589eb",
                                                "sense_id": "fc2f8fbd-ffb3-3fba-8696-1a2d058a1d14",
                                                "text": "It is outpatient and prepaid."
                                            }
                                        ]
                                    }
