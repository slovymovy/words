        "civilized"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "224c9ebb-aab4-3d29-8d25-838d4967b2f5",
                    "sense_definition": "Having a high state of culture and social development, or showing polite and reasonable behaviour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to discuss this issue in a <w>civilised</w> society without shouting at each other.",
                            "target_lang_translations": {
                                "tr": "Bu konuyu birbirimize bağırmadan, <w>medeni</w> bir toplumda tartışmamız gerekiyor."
                            }
                        },
                        {
                            "text": "They decided to sit down and have a <w>civilised</w> conversation to resolve their dispute.",
                            "target_lang_translations": {
                                "tr": "Anlaşmazlıklarını çözmek için oturup <w>medeni</w> bir sohbet etmeye karar verdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "cultured",
                        "polite",
                        "refined"
                    ],
                    "antonyms": [
                        "uncivilised"
                    ],
                    "common_phrases": [
                        "civilised society",
                        "civilised conversation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek bir kültür ve sosyal gelişmişlik düzeyine sahip olan veya kibar ve mantıklı davranışlar sergileyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "medeni",
                                "target_lang_sense_clarification": "toplum veya davranış için"
                            },
                            {
                                "target_lang_word": "uygar",
                                "target_lang_sense_clarification": "kültürlü ve gelişmiş"
                            },
                            {
                                "target_lang_word": "görgülü",
                                "target_lang_sense_clarification": "kibar ve terbiyeli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edbbcbef-d4f0-3174-80bc-ff19ccfa614c",
                    "sense_definition": "Simple past tense and past participle of <w>civilise</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient empire <w>civilised</w> many surrounding regions over the centuries.",
                            "target_lang_translations": {
                                "tr": "Kadim imparatorluk yüzyıllar boyunca etrafındaki birçok bölgeyi <w>medenileştirdi</w>."
                            }
                        },
                        {
                            "text": "Education and trade gradually <w>civilised</w> the remote communities.",
                            "target_lang_translations": {
                                "tr": "Eğitim ve ticaret uzak toplulukları kademeli olarak <w>uygarlaştırdı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Civilise\" (medenileştirmek/uygarlaştırmak) fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "medenileştirdi",
                                "target_lang_sense_clarification": "geçmiş zaman"
                            },
                            {
                                "target_lang_word": "uygarlaştırdı",
                                "target_lang_sense_clarification": "geçmiş zaman"
                            }
                        ]
                    }
                }
            ]
        }
