    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "77fd4a52-c4be-3ff7-af13-c9db094bb6ce",
                "word": "lasciviousness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                        "entry_id": "77fd4a52-c4be-3ff7-af13-c9db094bb6ce",
                        "glosses": [
                            "The characteristic or state of being lascivious."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "83e2e4e5-85fe-49c9-bc89-e913b9c08825",
                                "sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                                "text": "For from within, out of the heart of men, proceed euill thoughts, adulteries, fornications, murders, / Thefts, couetouſneſſe, wickedneſſe, deceit, laſciuiouſneſſe, an euill eye, blaſphemie, pride, fooliſhneſſe: / All theſe euill things come from within, and defile the man."
                            },
                            {
                                "example_id": "28dfcb07-5c48-47b1-942b-cc3b98086ba5",
                                "sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                                "text": "Diodorus Siculus bears out this, and states that the goat was made a god on account of its genital member and lasciviousness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b50723-74ef-4e89-a8be-a04029433e2c",
                        "source_entry_id": "77fd4a52-c4be-3ff7-af13-c9db094bb6ce",
                        "source_sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                        "source_sense_description": "characteristic or state of being lascivious",
                        "target_lang_word": "lascivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lascivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4bf56bd-cc5a-3e88-b486-fd13a0736bc2",
                                        "entry_id": "21cac98e-0a66-333f-98b7-a9b5c2e61453",
                                        "glosses": [
                                            "État caractérisé par un mélange de paresse, de sensualité extrême et d'inclination à la luxure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc5dc7b-621f-4fbb-958a-456c5be36734",
                                                "sense_id": "e4bf56bd-cc5a-3e88-b486-fd13a0736bc2",
                                                "text": "Le pire pourtant n’est pas dans ces chansons et dans la lascivité de la musique, et la position de Villiers ne se confond pas avec celle de Boileau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eae5c06-8255-4b2f-b0ea-1461d345f378",
                        "source_entry_id": "77fd4a52-c4be-3ff7-af13-c9db094bb6ce",
                        "source_sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                        "source_sense_description": "characteristic or state of being lascivious",
                        "target_lang_word": "Laszivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laszivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91cb573b-497e-3ca1-8cef-70bf3718ab7b",
                                        "entry_id": "2104ea09-5dcd-30d1-950a-bb9d4b2d7b0c",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die bewusst den Körper einsetzt, um durch sexuelle Reize (laszives Verhalten) zu verführen oder Begehren/Begierde zu wecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79443a26-b142-4220-a498-6300204c07ee",
                                                "sense_id": "91cb573b-497e-3ca1-8cef-70bf3718ab7b",
                                                "text": "„In einer der berühmtesten Sequenzen des Films trägt Dietrich einen Anzug und küsst eine Frau, führt das Selbstbewusstsein, die Laszivität und Nonchalance der Amy Jolly also auch performativ vor.“"
                                            },
                                            {
                                                "example_id": "2db6dacd-73f1-469c-98df-4af7a26123de",
                                                "sense_id": "91cb573b-497e-3ca1-8cef-70bf3718ab7b",
                                                "text": "„Laszivität in der Musik entsprach der Laszivität der Sitten. Ganz abgesehn vom Politischen (und 1831 tost das ganze Pariser Leben von Politik, dem Verhaßtesten, was der junge Mendelssohn kennt!) ist es die Überbetonung des Erotischen auf dem Theater, die ihn verletzt und die ihn erschreckt.“"
                                            },
                                            {
                                                "example_id": "3ded5309-e58c-4f9a-841b-4999a7126439",
                                                "sense_id": "91cb573b-497e-3ca1-8cef-70bf3718ab7b",
                                                "text": "„Ich bewundere die Laszivität der feingeschwungenen Linien auf dem Glanzpapier, die das Papier zugleich verlassen und mich erfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27041afc-3126-4d2c-8dad-38626a183d2c",
                        "source_entry_id": "77fd4a52-c4be-3ff7-af13-c9db094bb6ce",
                        "source_sense_id": "7ab1e56f-c927-38bf-93b5-28e09558af77",
                        "source_sense_description": "characteristic or state of being lascivious",
                        "target_lang_word": "Lüsternheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüsternheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                        "entry_id": "1063f4d5-ddaa-391b-8d63-de9f80095086",
                                        "glosses": [
                                            "Zustand, lüstern/sexuell begehrlich zu sein"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20cce53-2476-4ffd-88b1-fa3f439834bb",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Der Faun freilich in seinem abgeschwächten Zustand und bei wieder kühlem Kopfe registrierte die satte Lüsternheit seiner beiden Freundinnen mit dem Blick des Theaterbesuchers zur Bühne: Mir wird ein Spiel geboten.“"
                                            },
                                            {
                                                "example_id": "e5bbb7d0-ffca-40e2-bc08-0aa87c97a2e3",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Sie bemächtigte sich des Mannes, der ihre Lüsternheit erregte, und er mußte ihr zu Willen sein.“"
                                            },
                                            {
                                                "example_id": "bace0aa9-1f40-41e7-928c-53a6e0660b3d",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Ich selbst bin überaus empfindlich gegen Obszönität, besonders den Sexualwitz, wo er aus einem vitalen Mangel und Ersatzbedürfnis, aus Angeberei oder zerebraler Lüsternheit resultiert.“"
                                            },
                                            {
                                                "example_id": "ca9cb19b-4178-4668-94d1-ad0e6fa7ee90",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„In Deutschland schrieb man um diese Zeit oder bald nachher dergleichen auf sentimentale Manier und streute eine Fingerspitze Lüsternheiten darüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
