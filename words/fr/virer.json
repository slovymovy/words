    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb128142-fe7a-341a-affb-e44883f84dbd",
                    "sense_definition": "Renvoyer ou licencier une personne, généralement sans ménagement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emploi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>virer</w> trois employés après la crise financière."
                        },
                        {
                            "text": "Il a peur de se faire <w>virer</w> s'il arrive encore en retard demain matin."
                        }
                    ],
                    "synonyms": [
                        "licencier",
                        "renvoyer",
                        "chasser"
                    ],
                    "antonyms": [
                        "embaucher",
                        "recruter"
                    ],
                    "common_phrases": [
                        "se faire virer",
                        "virer un employé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "8af4bae0-d266-3b9a-917b-b58e56864098",
                    "sense_definition": "Changer de direction en se déplaçant ou en tournant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a dû <w>virer</w> brusquement à droite pour éviter l'obstacle sur la route."
                        },
                        {
                            "text": "Le navire a commencé à <w>virer</w> lentement afin d'entrer dans le port."
                        }
                    ],
                    "synonyms": [
                        "tourner",
                        "bifurquer"
                    ],
                    "common_phrases": [
                        "virer à droite",
                        "virer à gauche",
                        "virer de bord"
                    ]
                },
                {
                    "sense_id": "86f19ca6-70c6-351b-aad4-3cec75be90c7",
                    "sense_definition": "Transférer une somme d'argent d'un compte bancaire à un autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle va <w>virer</w> de l'argent sur le compte de son fils pour ses études."
                        },
                        {
                            "text": "N'oublie pas de me <w>virer</w> ta part du loyer avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "transférer"
                    ],
                    "common_phrases": [
                        "virer de l'argent",
                        "virer une somme"
                    ]
                },
                {
                    "sense_id": "77b56a90-ccd0-3716-b906-aad48ccce600",
                    "sense_definition": "Changer d'aspect, de couleur ou évoluer vers un nouvel état souvent négatif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La discussion calme a fini par <w>virer</w> à la dispute générale."
                        },
                        {
                            "text": "Avec la chaleur de l'été, le ciel commence à <w>virer</w> à l'orage en fin d'après-midi."
                        }
                    ],
                    "synonyms": [
                        "tourner",
                        "se transformer"
                    ],
                    "common_phrases": [
                        "virer au cauchemar",
                        "virer au drame",
                        "virer au rouge"
                    ]
                },
                {
                    "sense_id": "8c02cb82-8142-351c-b5f8-6b2fa1f0f24f",
                    "sense_definition": "Se débarrasser de quelque chose ou retirer un objet d'un endroit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons faire du tri et <w>virer</w> tous ces vieux cartons inutiles du garage."
                        },
                        {
                            "text": "Il a décidé de tout <w>virer</w> de son bureau pour repartir à zéro."
                        }
                    ],
                    "synonyms": [
                        "jeter",
                        "enlever",
                        "débarrasser"
                    ],
                    "antonyms": [
                        "garder",
                        "conserver"
                    ],
                    "common_phrases": [
                        "tout virer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
