                ],
                "senses": [
                    {
                        "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                        "entry_id": "4248a311-03a4-3d65-ac08-5d745f141035",
                        "glosses": [
                            "waarvan schande gesproken kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d97f681-f609-4bc8-9239-12b51d515ef1",
                                "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                                "text": "Veel mensen vinden die wet in Florida die toestaat mensen overhoop te schieten als je maar beweert dat je je bedreigd voelde een schandalige zaak."
                            },
                            {
                                "example_id": "bbf7954a-9d45-463d-8564-0992fd70ed7a",
                                "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                                "text": "Met de zalvende domineeswoorden dat zijn tafel voor iedereen is en dat iedereen daar zijn verhaal mag doen. Op een ding had de redactie niet gerekend: dat Douwes bleef zitten. Slim, vond ik. Want zo kon ze ons kijkers haarfijn uitleggen op welke schandalige wijze ze genaaid werd door Twan en zijn redactie."
                            }
                        ]
                    }
                ],
