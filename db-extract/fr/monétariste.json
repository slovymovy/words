                        "entry_id": "9bdee660-3bc3-33f9-8f57-cf67e2c9f958",
                        "glosses": [
                            "Partisan du monétarisme."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "756292ff-5b97-40c0-becd-85d15adf5a66",
                                "sense_id": "75b7708c-09bd-388e-ae42-a544a3f4c38c",
                                "text": "Les monétaristes contestent l’interprétation keynésienne du rôle de la monnaie."
                            },
                            {
                                "example_id": "5d8a5fac-818c-44a7-8ed3-316ce7d023da",
                                "sense_id": "75b7708c-09bd-388e-ae42-a544a3f4c38c",
                                "text": "Pour un monétariste, l’argent rendu aux banques dans le cadre de ces acquisitions ne pouvait qu’accroitre la masse monétaire et alimenter l’inflation."
                            }
                        ]
                    }
                ],
