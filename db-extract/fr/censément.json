                "senses": [
                    {
                        "sense_id": "d099a0b3-c93f-3a16-8a7b-060d96e0e068",
                        "entry_id": "15f431fd-7b3f-308c-8219-d3d6717be510",
                        "glosses": [
                            "Par supposition."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e47907c0-e7cc-4903-af44-ba64ba45fde8",
                                "sense_id": "d099a0b3-c93f-3a16-8a7b-060d96e0e068",
                                "text": "Entre nous, m'est avis qu'y devait faire un peu ce contrebande. L'habitude, censément : pendant trois ans Londres lui avait revalu ses services en lui faisant passer whiskies et cigarettes qu'ensuite il pouvait revendre au noir, censément."
                            }
                        ]
                    },
                    {
                        "sense_id": "a10f8873-293e-3f3e-83c0-5b183af77d5f",
                        "entry_id": "15f431fd-7b3f-308c-8219-d3d6717be510",
                        "glosses": [
                            "ou Soi-disant ; peut-être."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "98c23f71-d447-44aa-99b6-c53568bd28a2",
                                "sense_id": "a10f8873-293e-3f3e-83c0-5b183af77d5f",
                                "text": "[…] savoir :\n1° 5,891 fr. montant d'une facture de draps, censément fournis par un sieur Gilson, à la compagnie du Luxembourg, qui n'a rien reçu ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "aff808d2-c1a7-3806-8939-ed38b44fcaaf",
                        "entry_id": "15f431fd-7b3f-308c-8219-d3d6717be510",
                        "glosses": [
                            "En apparence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f4d760b-7fb7-4dc7-bf1e-e1f74aae4ef0",
                                "sense_id": "aff808d2-c1a7-3806-8939-ed38b44fcaaf",
                                "text": "Hier au soir, un mami, qui avait pour défroque un grand panaire comme censément celui d'un jésuite, cogne discrètement à ma porte : […]."
                            },
                            {
                                "example_id": "453412ae-feee-4968-b8df-3b6601ffcf09",
                                "sense_id": "aff808d2-c1a7-3806-8939-ed38b44fcaaf",
                                "text": "Il me restait trois francs ; je lui ai demandé sa blague à tabac, censément pour bourrer ma pipe, et j’ai mis les trois francs dedans la blague, bien au-dessus du tabac, pour qu’il les trouve quand il voudrait fumer sa cigarette, plus tard."
                            },
                            {
                                "example_id": "414a08bc-18ac-47ca-a6bb-e9aee602e857",
                                "sense_id": "aff808d2-c1a7-3806-8939-ed38b44fcaaf",
                                "text": "Comprenez-vous ? sur moi, sa mère, ce regard que vous avez, censément pareil à n’importe lequel, mais qui a tant de pitié."
                            },
                            {
                                "example_id": "f69a9464-736d-4d9c-8a76-83c969a1fcb2",
                                "sense_id": "aff808d2-c1a7-3806-8939-ed38b44fcaaf",
                                "text": "Censément conçues pour imposer une « supervision législative vigilante » à la communauté du renseignement, ces commissions sont en fait actuellement dirigées par certains des fidèles de la NSA parmi les plus loyalistes qui se puissent trouver à Washington […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a534f5f0-5514-45d2-9099-0258e8a34f82",
                        "source_entry_id": "15f431fd-7b3f-308c-8219-d3d6717be510",
                        "target_lang_word": "vermutlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermutlich",
