                {
                    "sense_id": "bdd12b15-dac5-3536-99a2-40bc9d010128",
                    "sense_definition": "Een informele uitroep om instemming of bevestiging aan te geven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik bel je vanavond nog even over de details. — <w>Joe</w>, is goed.",
                            "target_lang_translations": {
                                "ru": "Я позвоню тебе сегодня вечером насчет деталей. — <w>Ага</w>, хорошо.",
                                "en": "I'll call you tonight about the details. — <w>Okay</w>, sounds good.",
                                "pl": "Zadzwonię do ciebie wieczorem w sprawie szczegółów. — <w>Dobra</w>, zgoda.",
                                "de": "Ich rufe dich heute Abend wegen der Details an. — <w>Alles klar</w>, passt.",
                                "fr": "Je t'appelle ce soir pour les détails. — <w>Ok</w>, ça marche.",
                                "it": "Ti chiamo stasera per i dettagli. — <w>Ok</w>, va bene.",
                                "cs": "Zavolám ti večer kvůli těm detailům. — <w>Jo</w>, dobře.",
                                "tr": "Detaylar için seni bu akşam arayacağım. — <w>Tamam</w>, olur.",
                                "es": "Te llamo esta noche para los detalles. — <w>Vale</w>, está bien.",
                                "zh": "我今晚再打电话跟你说细节。——<w>好</w>，没问题。"
                            }
                        },
                        {
                            "text": "Wil jij de deur even achter je dichttrekken? — <w>Joe</w>!",
                            "target_lang_translations": {
                                "ru": "Закроешь за собой дверь? — <w>Ага</w>!",
                                "en": "Could you pull the door shut behind you? — <w>Sure</w>!",
                                "pl": "Zamkniesz za sobą drzwi? — <w>Jasne</w>!",
                                "de": "Kannst du bitte die Tür hinter dir zuziehen? — <w>Jo</w>!",
                                "fr": "Tu peux fermer la porte derrière toi ? — <w>D'accord</w> !",
                                "it": "Puoi chiudere la porta dietro di te? — <w>Certo</w>!",
                                "cs": "Můžeš za sebou zavřít dveře? — <w>Jo</w>!",
                                "tr": "Kapıyı arkandan kapatır mısın? — <w>Tamam</w>!",
                                "es": "¿Puedes cerrar la puerta al salir? — ¡<w>Vale</w>!",
                                "zh": "你能顺手把门带上吗？——<w>行</w>！"
                            }
                        }
