                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc407a14-50b9-4815-a530-1ecb88b1c8e3",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Nietrzeźwy kierowca powiedział policjantowi, że piwo to nie alkohol."
                                            },
                                            {
                                                "example_id": "f1cd2347-4e89-4c9a-8b84-6c02ac7d76a6",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "To brawura kierowcy zabiła tyle osób."
                                            },
                                            {
                                                "example_id": "c4d3ffb8-41bc-4bbb-853f-b8c9b2db841c",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kto jest kierowcą tamtego samochodu?"
                                            },
                                            {
                                                "example_id": "53a52d03-6b6f-442f-9021-03ff21f34b81",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kierowco, uważaj na drodze!"
                                            },
                                            {
                                                "example_id": "bc795c54-2152-447d-a826-422344221883",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kierowcy denerwowali się stojąc w korku."
                                            },
                                            {
                                                "example_id": "0c4e1b9f-4e74-4860-9d22-05271a9dfb51",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Święty Krzysztof jest patronem kierowców, przewoźników i podróżników."
                                            }
