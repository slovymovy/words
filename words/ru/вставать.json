    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2cb11579-bce9-33ff-b2d9-4fa64f9fc615",
                    "sense_definition": "Принимать вертикальное положение, подниматься на ноги.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученики должны <вставать>, когда учитель входит в класс.",
                            "target_lang_translations": {
                                "en": "Students must <stand up> when the teacher enters the classroom.",
                                "de": "Die Schüler müssen <aufstehen>, wenn der Lehrer das Klassenzimmer betritt."
                            }
                        },
                        {
                            "text": "После долгого сидения тяжело <вставать> со стула.",
                            "target_lang_translations": {
                                "en": "After sitting for a long time, it is hard to <get up> from the chair.",
                                "de": "Nach langem Sitzen ist es schwer, vom Stuhl <aufzustehen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься",
                        "подыматься"
                    ],
                    "antonyms": [
                        "садиться",
                        "ложиться"
                    ],
                    "common_phrases": [
                        "вставать со стула",
                        "вставать с места",
                        "вставать на ноги"
                    ],
                    "target_lang_definitions": {
                        "en": "To assume a vertical position, to rise to one's feet.",
                        "de": "Eine aufrechte Position einnehmen, sich auf die Beine erheben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand up",
                                "target_lang_sense_clarification": "general physical action"
                            },
                            {
                                "target_lang_word": "get up",
                                "target_lang_sense_clarification": "common synonym, often from a sitting position"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "formal or literary"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufstehen",
                                "target_lang_sense_clarification": "sich von einem Sitz oder einer liegenden Position erheben"
                            },
                            {
                                "target_lang_word": "sich erheben",
                                "target_lang_sense_clarification": "formeller Ausdruck für das Aufstehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b57da4c-b4cb-31fe-bc60-fb83646006ea",
                    "sense_definition": "Просыпаться и подниматься с постели после сна.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "daily_routine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я привык <вставать> в шесть часов утра каждый день.",
                            "target_lang_translations": {
                                "en": "I am used to <getting up> at six o'clock in the morning every day.",
                                "de": "Ich bin es gewohnt, jeden Tag um sechs Uhr morgens <aufzustehen>."
                            }
                        },
                        {
                            "text": "В выходные мы любим <вставать> поздно.",
                            "target_lang_translations": {
                                "en": "On weekends we love to <get up> late.",
                                "de": "Am Wochenende stehen wir gerne spät <auf>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься"
                    ],
                    "antonyms": [
                        "ложиться",
                        "засыпа́ть"
                    ],
                    "common_phrases": [
                        "вставать рано",
                        "вставать по утрам",
                        "пора вставать"
                    ],
                    "target_lang_definitions": {
                        "en": "To wake up and get out of bed after sleeping.",
                        "de": "Nach dem Schlafen wach werden und das Bett verlassen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get up",
                                "target_lang_sense_clarification": "standard term for leaving bed"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "formal or poetic"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufstehen",
                                "target_lang_sense_clarification": "das Bett verlassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ade83b90-caa6-30dc-80bd-4569d456ea0d",
                    "sense_definition": "Становиться ногами на поверхность чего-либо.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не нужно <вставать> на грязный коврик в чистой обуви.",
                            "target_lang_translations": {
                                "en": "You shouldn't <step> on the dirty rug in clean shoes.",
                                "de": "Man sollte sich nicht mit sauberen Schuhen auf den schmutzigen Teppich <stellen>."
                            }
                        },
                        {
                            "text": "Чтобы достать книгу с верхней полки, мне пришлось <вставать> на табуретку.",
                            "target_lang_translations": {
                                "en": "To reach the book from the top shelf, I had to <stand> on a stool.",
                                "de": "Um das Buch aus dem obersten Regal zu holen, musste ich mich auf einen Hocker <stellen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ступать",
                        "наступать",
                        "становиться"
                    ],
                    "common_phrases": [
                        "вставать на стул",
                        "вставать на весы",
                        "вставать на цыпочки"
                    ],
                    "target_lang_definitions": {
                        "en": "To place one's feet on the surface of something.",
                        "de": "Die Füße auf eine Oberfläche stellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "to be in a vertical position on something"
                            },
                            {
                                "target_lang_word": "step",
                                "target_lang_sense_clarification": "the action of placing one's foot onto something"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "used with 'on', e.g., get on a chair"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich stellen auf",
                                "target_lang_sense_clarification": "sich mit den Füßen auf etwas positionieren"
                            },
                            {
                                "target_lang_word": "steigen auf",
                                "target_lang_sense_clarification": "auf eine erhöhte Fläche treten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5270cfb4-0138-3eea-97b4-027d6a7103cf",
                    "sense_definition": "Появляться над горизонтом (о небесных светилах).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом солнце <встаёт> очень рано и светит ярко.",
                            "target_lang_translations": {
                                "en": "In summer the sun <rises> very early and shines brightly.",
                                "de": "Im Sommer <geht> die Sonne sehr früh <auf> und scheint hell."
                            }
                        },
                        {
                            "text": "Мы сидели на берегу и смотрели, как <встаёт> луна.",
                            "target_lang_translations": {
                                "en": "We sat on the shore and watched the moon <rise>.",
                                "de": "Wir saßen am Ufer und beobachteten, wie der Mond <aufging>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься",
                        "восходить"
                    ],
                    "antonyms": [
                        "садиться"
                    ],
                    "common_phrases": [
                        "солнце встаёт",
                        "луна встаёт"
                    ],
                    "target_lang_definitions": {
                        "en": "To appear above the horizon (referring to celestial bodies).",
                        "de": "Über dem Horizont erscheinen (bei Himmelskörpern)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "standard for sun, moon, etc."
                            },
                            {
                                "target_lang_word": "come up",
                                "target_lang_sense_clarification": "common phrasal verb"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufgehen",
                                "target_lang_sense_clarification": "Standardausdruck für Sonne, Mond oder Sterne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7699b7a-3cb1-3974-b7e1-5630c02677e0",
                    "sense_definition": "Возникать или появляться (о вопросе, проблеме, задаче).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед выпускниками часто <встаёт> вопрос выбора будущей профессии.",
                            "target_lang_translations": {
                                "en": "The question of choosing a future profession often <arises> before graduates.",
                                "de": "Vor den Absolventen <stellt> sich oft die Frage nach der Wahl des zukünftigen Berufs."
                            }
                        },
                        {
                            "text": "Эта проблема <встаёт> каждый раз при обсуждении бюджета.",
                            "target_lang_translations": {
                                "en": "This problem <comes up> every time we discuss the budget.",
                                "de": "Dieses Problem <taucht> jedes Mal bei der Budgetdiskussion <auf>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься"
                    ],
                    "common_phrases": [
                        "встаёт вопрос",
                        "встаёт проблема",
                        "встаёт задача"
                    ],
                    "target_lang_definitions": {
                        "en": "To arise or appear (referring to a question, problem, or task).",
                        "de": "Entstehen oder auftreten (bei Fragen, Problemen oder Aufgaben)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "formal, for abstract concepts"
                            },
                            {
                                "target_lang_word": "come up",
                                "target_lang_sense_clarification": "conversational, meaning to happen or appear"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufkommen",
                                "target_lang_sense_clarification": "plötzlich entstehen oder auftauchen"
                            },
                            {
                                "target_lang_word": "sich stellen",
                                "target_lang_sense_clarification": "im Sinne von 'eine Frage stellt sich'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eecb841-6eff-3832-b819-363bb7c0dd29",
                    "sense_definition": "Занимать определённую позицию в споре или начинать активные действия для защиты.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весь народ готов <вставать> на защиту своей страны в трудный час.",
                            "target_lang_translations": {
                                "en": "The whole nation is ready to <stand up> for the defense of their country in a difficult hour.",
                                "de": "Das ganze Volk ist bereit, in schwierigen Zeiten für die Verteidigung seines Landes <einzutreten>."
                            }
                        },
                        {
                            "text": "В любых спорах он предпочитает <вставать> на сторону своих друзей.",
                            "target_lang_translations": {
                                "en": "In any disputes, he prefers to <side> with his friends.",
                                "de": "In jedem Streit zieht er es vor, sich auf die Seite seiner Freunde zu <stellen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься"
                    ],
                    "common_phrases": [
                        "вставать на защиту",
                        "вставать на сторону",
                        "вставать на путь"
                    ],
                    "target_lang_definitions": {
                        "en": "To take a specific position in a dispute or start active actions for defense.",
                        "de": "Eine bestimmte Position in einem Streit einnehmen oder aktiv werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand up",
                                "target_lang_sense_clarification": "used in 'stand up for' or 'stand up to'"
                            },
                            {
                                "target_lang_word": "side",
                                "target_lang_sense_clarification": "used in 'side with someone'"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "used in 'rise to the defense'"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich einsetzen für",
                                "target_lang_sense_clarification": "aktiv für jemanden oder etwas eintreten"
                            },
                            {
                                "target_lang_word": "Partei ergreifen",
                                "target_lang_sense_clarification": "sich auf eine Seite in einem Streit schlagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1aa9f1c-8137-336d-920b-8e0989a9eee3",
                    "sense_definition": "Помещаться, умещаться в каком-либо пространстве (обычно о мебели или предметах).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот большой шкаф никак не <встаёт> в нашу маленькую прихожую.",
                            "target_lang_translations": {
                                "en": "This big wardrobe just won't <fit> into our small hallway.",
                                "de": "Dieser große Schrank <passt> einfach nicht in unseren kleinen Flur."
                            }
                        },
                        {
                            "text": "Новый холодильник отлично <встаёт> в свободный угол кухни.",
                            "target_lang_translations": {
                                "en": "The new fridge <fits> perfectly into the free corner of the kitchen.",
                                "de": "Der neue Kühlschrank <passt> perfekt in die freie Ecke der Küche."
                            }
                        }
                    ],
                    "synonyms": [
                        "умещаться",
                        "помещаться",
                        "размещаться"
                    ],
                    "common_phrases": [
                        "шкаф не встаёт",
                        "мебель встаёт"
                    ],
                    "target_lang_definitions": {
                        "en": "To fit into a specific space (usually referring to furniture or objects).",
                        "de": "In einen bestimmten Raum passen (meist bei Möbeln)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fit",
                                "target_lang_sense_clarification": "to be of the right size for a space"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hineinpassen",
                                "target_lang_sense_clarification": "von der Größe her in einen Raum passen"
                            },
                            {
                                "target_lang_word": "Platz finden",
                                "target_lang_sense_clarification": "genug Raum haben, um aufgestellt zu werden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}