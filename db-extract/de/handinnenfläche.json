                        "source_sense_description": "innere Fläche der Hand",
                        "target_lang_word": "ладо́нь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ладо́нь",
