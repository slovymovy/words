                ],
                "senses": [
                    {
                        "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                        "entry_id": "5ae380ad-5e1b-3449-a1d1-b43f102c974b",
                        "glosses": [
                            "die größte Geschwindigkeit, die mit einem Transportmittel oder durch körperliche Leistung erreicht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf5af0b-8c56-4f31-a5c3-dac898c6f0b4",
                                "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                                "text": "Der X³ ist ein neuartiger Helikoptertyp. Ein Prototyp erreichte eine Rekordgeschwindigkeit von 472 Kilometern pro Stunde."
                            },
                            {
                                "example_id": "295a9067-d80e-4a2d-8f64-21046c3e9bba",
                                "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                                "text": "Hermann Lang schafft auf der umgebauten Strecke die ungebrochene Rekordgeschwindigkeit von durchschnittlich 267 Kilometern pro Stunde auf der Avus."
                            },
                            {
                                "example_id": "80812b71-0f66-4a18-ad70-42fbc3e101f0",
                                "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                                "text": "Die Rekordgeschwindigkeit unter bemannten Flugzeugen hält der Düsenjet Lockheed SR-71. Er erreichte im Juli 1976 bei einem Testflug über Kalifornien, USA, 3529,6 Kilometer pro Stunde!"
                            },
                            {
                                "example_id": "681ec52b-8367-4ec6-8606-232bf21dae8c",
                                "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                                "text": "Der Shinkansen-L0 ist ein in Entwicklung befindlicher japanischer Magnetschwebezug, der ab 2027 einen Teil der Strecke zwischen Tokio und Osaka zurücklegen soll. Im April 2015 stellte er die Rekordgeschwindigkeit von 603 km/h auf."
                            },
                            {
                                "example_id": "6300bf28-06c2-4b2a-9c23-63a18b765e60",
                                "sense_id": "e2a6487d-d75e-3675-8ed1-9340bba5e2ea",
                                "text": "Im August 1959 übertraf Jacqueline Auriol ihre eigene Bestleistung vom Juli 1955 deutlich: Sie schaffte mit einem Düsenjäger vom Typ „Mirage III“ eine Rekordgeschwindigkeit von 2.150 Stundenkilometern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
