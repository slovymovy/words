                    "frequency": "Middle",
                    "semantic_group_id": "son_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un cri <w>perçant</w> a retenti dans la ruelle sombre au milieu de la nuit."
                        },
                        {
                            "text": "Elle parlait avec une voix <w>perçante</w> qui dérangeait tous les voisins."
                        }
                    ],
                    "common_phrases": [
                        "cri perçant",
                        "voix perçante",
                        "froid perçant"
                    ]
                },
                {
                    "sense_id": "c2210b7e-aaf4-30c4-8dd4-07e9d83deff6",
                    "sense_definition": "Qui a une grande acuité, qui semble scruter au fond des choses, en parlant des yeux ou du regard.",
