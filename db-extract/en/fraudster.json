                    }
                ],
                "senses": [
                    {
                        "sense_id": "77accbab-638a-3136-b73a-4b2a1ed50802",
                        "entry_id": "02cae437-c4ed-32bf-86e6-bb8171a1f763",
                        "glosses": [
                            "A person who carries out fraud; a swindler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e3b893-36b4-44ab-807a-5385a78ad19c",
                                "sense_id": "77accbab-638a-3136-b73a-4b2a1ed50802",
                                "text": "2016 Eric Andrew-Gee Why and how Ontarians change their names in the 21st century The Globe and Mail\nWith a few exceptions, all those changes were published in the Ontario Gazette, a little-read compendium of government business that comes out every week. The province requires this by law, as do most Canadian jurisdictions, nominally to thwart fraudsters and deadbeats."
                            },
                            {
                                "example_id": "b55123f5-7b0a-40a4-a978-e7f0b0df7f03",
                                "sense_id": "77accbab-638a-3136-b73a-4b2a1ed50802",
                                "text": "CPS MerseyCheshire welcomes the jailing of Helen Dove who conned her friend into giving up her job for a dream post that never existed. Kimberley McDonnell lost around £50,000 because of the fraudster."
                            },
                            {
                                "example_id": "b974f480-8846-4935-a1d0-6114eff94957",
                                "sense_id": "77accbab-638a-3136-b73a-4b2a1ed50802",
                                "text": "Northern has made it harder for fraudsters to cheat checks on barcode season tickets. The operator has made it impossible for people to screenshot tickets from within the Northern app and then share the tickets for others to use."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830c51d8-6f7c-4881-93b2-efb446041049",
                        "source_entry_id": "02cae437-c4ed-32bf-86e6-bb8171a1f763",
                        "source_sense_id": "77accbab-638a-3136-b73a-4b2a1ed50802",
                        "source_sense_description": "a person who practices fraud",
                        "target_lang_word": "fraudeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraudeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                        "entry_id": "5947d381-b7c6-36bd-858d-9acef4f76404",
                                        "glosses": [
                                            "Celui qui fraude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7ff238-5d33-4d7d-bbfc-07fb29c7ef1c",
                                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                                "text": "Écoutez bien, je dis pour changer : O bon peuple de Paris ! vous êtes un tas de niais, et vos seigneurs, vos nobles de robe et d’épée, ne sont que d’hypocrites fraudeurs et de fieffés escogriffes !"
                                            },
                                            {
                                                "example_id": "f14a73bf-e748-4eb6-b123-346eccebb7a0",
                                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                                "text": "Assurément, les fraudeurs ne comptaient pas y entreposer leurs ballots de marchandises prohibées. Les fraudeurs n'ont pas coutume d'emmener leurs femmes dans leurs expéditions."
                                            },
                                            {
                                                "example_id": "13b9980f-0b61-45dd-8e57-edaedf8ec476",
                                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                                "text": "Le Mohtasib, en effet, surveillait ces métiers pour les poids et mesures, punissant le fraudeur du châtiment du tatouif."
                                            },
                                            {
                                                "example_id": "4591a355-5fdb-4f08-9884-d4087142998a",
                                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                                "text": "Le fraudeur essaie de corrompre le douanier ou pas; simultanément le douanier choisit d’être malhonnête ou non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf0bd2a-0567-4b46-b61b-aea6106a094c",
                        "source_entry_id": "02cae437-c4ed-32bf-86e6-bb8171a1f763",
