                                "target_senses": [
                                    {
                                        "sense_id": "e7deeabb-2b90-383d-bab9-edb7870a03ab",
                                        "entry_id": "dd9ac107-2583-337b-8595-e77cb958d1a1",
                                        "glosses": [
                                            "Féminin singulier de second."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40f2f89f-80ce-440e-9cdd-340192f4b428",
                                                "sense_id": "e7deeabb-2b90-383d-bab9-edb7870a03ab",
                                                "text": "Si une seconde citation est comprise à l’intérieur de la première, chaque ligne de la citation incluse sera précédée d’un guillemet ouvrant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79668c37-3f80-30e5-ac8f-b309088285dc",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Seconde classe, qui précède la première ou, autrefois, la terminale et suit la troisième, pour les enfants de 15-16 ans."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b28e6b-80fa-4571-b018-f1f9a157b26d",
                                                "sense_id": "79668c37-3f80-30e5-ac8f-b309088285dc",
                                                "text": "La seconde n’a rien à voir avec le secondaire qui représente l’enseignement des collèges et des lycées, par opposition d’une part à l’enseignement primaire et d’autre part à l’enseignement supérieur."
                                            },
                                            {
                                                "example_id": "db2c377a-f08b-41fd-8da5-f7f08de17f7d",
                                                "sense_id": "79668c37-3f80-30e5-ac8f-b309088285dc",
                                                "text": "Un écolier qui est en seconde."
                                            },
                                            {
                                                "example_id": "1e5c9b0f-92ad-4f1a-ab76-ac7e96c9815c",
                                                "sense_id": "79668c37-3f80-30e5-ac8f-b309088285dc",
                                                "text": "Professer la seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ecd3ff-17cd-3f15-a8e9-c4fc056c71c4",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Seconde classe, qui précède la première ou, autrefois, la terminale et suit la troisième, pour les enfants de 15-16 ans.",
                                            "Élève de seconde au lycée. Note d’usage : en ce sens, le mot est féminin ou masculin."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46010f82-0b39-4031-a859-edcb99a8a82a",
                                                "sense_id": "c6ecd3ff-17cd-3f15-a8e9-c4fc056c71c4",
                                                "text": "Yvan Mozec, plus grand en taille que tous les secondes du lycée, était accoutré comme un acteur des années trente, complet veston, pochette et cravate, nœud papillon."
                                            },
                                            {
                                                "example_id": "60094797-865e-40ed-b920-db26c337b869",
                                                "sense_id": "c6ecd3ff-17cd-3f15-a8e9-c4fc056c71c4",
                                                "text": "La professeure de français n’a que des filles cette année, presque toutes des secondes, et quelques premières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df39d506-645e-32e5-944e-9b45136253bf",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Seconde classe d’un train, d’un tramway, d’un bateau, etc."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b3f548-9b8b-4e05-b73d-a40a06e16260",
                                                "sense_id": "df39d506-645e-32e5-944e-9b45136253bf",
                                                "text": "Monter, voyager en seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d485c6-2e76-39cd-925b-3597ca4c8194",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Place de seconde classe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321588c8-2b90-4d25-b87c-21233189e3fa",
                                                "sense_id": "62d485c6-2e76-39cd-925b-3597ca4c8194",
                                                "text": "Donnez-moi une seconde pour Marseille."
                                            },
                                            {
                                                "example_id": "5f60e8a7-12ff-4123-a065-b36d59dfac02",
                                                "sense_id": "62d485c6-2e76-39cd-925b-3597ca4c8194",
                                                "text": "Les secondes, les places de seconde classe."
                                            },
                                            {
                                                "example_id": "4ff70902-92aa-4fb6-9987-59880712d185",
                                                "sense_id": "62d485c6-2e76-39cd-925b-3597ca4c8194",
                                                "text": "Prendre des secondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e486d4-1d47-3d4c-8861-333f5b86dd67",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Deuxième palier de vitesse d’un véhicule doté d’une boîte de vitesses."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f905a4-50b9-446f-a961-21ccb11884eb",
                                                "sense_id": "81e486d4-1d47-3d4c-8861-333f5b86dd67",
                                                "text": "On entendit le léger ronronnement d’une auto montant la côte en prise directe et M. Serge dit encore :\n« Une grosse voiture… Elle n’a même pas eu besoin de se mettre en seconde… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007aba57-c1c0-3f31-91b1-6dc917aede0b",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Seconde position de l’épée dans la ligne du dehors, la pointe basse."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b608cbe8-1349-4bd6-bbca-057f90c6c0bd",
                                                "sense_id": "007aba57-c1c0-3f31-91b1-6dc917aede0b",
                                                "text": "Que je voudrais qu’il se fâchât ! dit Julien, avec quelle assurance je lui donnerais maintenant un coup d’épée. Et il faisait le geste du coup de seconde."
                                            },
                                            {
                                                "example_id": "e96f103a-2927-466d-9bb0-80f4137a5bf2",
                                                "sense_id": "007aba57-c1c0-3f31-91b1-6dc917aede0b",
                                                "text": "Le matador ne peut frapper le taureau qu’à l’endroit de la réunion de la nuque avec le dos, ce que les Espagnols appellent la croix. Le coup doit être porté de haut en bas, comme on dirait en seconde ; jamais en dessous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2b1446-3165-333c-8cad-3f0144a94100",
                                        "entry_id": "2a3e3551-146d-36dd-bf08-81f687f8006b",
                                        "glosses": [
                                            "Intervalle compris entre deux notes consécutives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53a0990-a802-4f6b-a404-9342ea9429b9",
                                                "sense_id": "3b2b1446-3165-333c-8cad-3f0144a94100",
                                                "text": "Il y a trois espèces de seconde : la seconde majeure, comme ut naturel et ré naturel ; la seconde mineure, comme ut naturel et ré bémol ; et la seconde augmentée, comme ut naturel et ré dièse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                        "entry_id": "88c5fda5-4f3e-333b-a935-d6e619d37022",
                                        "glosses": [
                                            "Unité de mesure du temps (symbole s) égale à la soixantième partie d’une minute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e6755d-a419-4373-883a-d0959eb4a300",
                                                "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                                "text": "Quand j’entends cette chanson là sur les ondes\nDe ma FM j’téléphone à ma femme\nPour lui offrir ce collier de secondes\nDeux noires une blanche, une blanche une ronde."
                                            },
                                            {
                                                "example_id": "dc6e8790-583b-4342-b7f0-af304ab135c5",
                                                "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                                "text": "Alors je sortis la grosse montre de M. Goulden, qui marquait les secondes, et je vis qu’il y avait beaucoup de retard."
                                            },
                                            {
                                                "example_id": "aa3d3891-b752-4002-b390-32cc7c4253a5",
                                                "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                                "text": "Dans ce chenal étroit je pouvais à peine faire route trente secondes entre deux virements de bord et encore je devais utiliser cette demi-minute pour prendre les relèvements au compas et m’assurer de ma position."
                                            },
                                            {
                                                "example_id": "e5784b50-dcc6-4fd6-a8c9-41d3a2e648d4",
                                                "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                                "text": "Il ne devinait pas encore combien l’âme de la jeune fille, déjà, lui appartenait. Il habitait chaque seconde de ses heures, chaque rêve de ses nuits."
                                            },
                                            {
                                                "example_id": "a2a49cc9-50cb-4ab7-96cd-0bd8bbd36da0",
                                                "sense_id": "5d0f7b1c-1bb9-379d-9fcc-1821481be834",
                                                "text": "En ouvrant les yeux, je mis quelques secondes à reprendre contact avec la réalité. J’étais étendu, détaché et nu, au milieu des paras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612aa469-9bca-397d-a9f7-872247564ece",
                                        "entry_id": "88c5fda5-4f3e-333b-a935-d6e619d37022",
                                        "glosses": [
                                            "Unité de mesure du temps (symbole s) égale à la soixantième partie d’une minute.",
                                            "Temps très court ; instant."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ab4664-c8f4-465e-967a-e300625cf6c2",
                                                "sense_id": "612aa469-9bca-397d-a9f7-872247564ece",
                                                "text": "– Monsieur vous demande de l’attendre une seconde, me dit le valet de chambre."
                                            },
                                            {
                                                "example_id": "b2d3832b-89c1-45f9-a89d-6ad742eff26d",
                                                "sense_id": "612aa469-9bca-397d-a9f7-872247564ece",
                                                "text": "Parpoil et Gaspard demeurèrent immobiles pendant une seconde, après quoi Gaspard tourna les talons et regrimpa l’escalier quatre à quatre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e4a06d-44f2-3d67-a767-7aa3244e07ec",
                                        "entry_id": "88c5fda5-4f3e-333b-a935-d6e619d37022",
                                        "glosses": [
                                            "Soixantième partie d’une minute, qui est elle-même la soixantième partie d’un degré. On dit plus précisément seconde d’arc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811dba91-1e07-4047-897a-a68cb7b80377",
                                                "sense_id": "83e4a06d-44f2-3d67-a767-7aa3244e07ec",
                                                "text": "Latitude : 3 degrés 53 minutes 0 seconde Sud. Longitude: 34 degrés 53 minutes 50 secondes Ouest de Paris."
                                            },
                                            {
                                                "example_id": "16d01bae-86f1-42dd-8d8c-d93b98a9b109",
                                                "sense_id": "83e4a06d-44f2-3d67-a767-7aa3244e07ec",
                                                "text": "Cette planète est élevée sur l’horizon de tant de degrés, de tant de minutes et de tant de secondes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4b90f2-9ded-37f1-90ec-2f5ba690d89b",
                                        "entry_id": "2f2db3bf-924e-3238-bafd-f4be03efef33",
                                        "glosses": [
                                            "Celle qui tient le second rang dans un classement, dans une hiérarchie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3ba644-540c-49f0-8bf1-314712658473",
                                                "sense_id": "1f4b90f2-9ded-37f1-90ec-2f5ba690d89b",
                                                "text": "La plupart des modèles d’hélicoptères ont à la fois des versions militaires et civiles, les secondes étant dérivées des premières qui bénéficient d'un financement étatique pour la R&D."
                                            }
                                        ]
                                    }
                                ]
                            },
