                "senses": [
                    {
                        "sense_id": "1c05af1a-35c7-3e85-be4e-9bd9d0b18fca",
                        "entry_id": "a009d437-40ae-3cd7-8aeb-f5d9ba5df616",
                        "glosses": [
                            "Changer le lume (d’une aiguille de montre, par exemple)."
                        ],
                        "tags": [
                            "Horlogerie"
                        ],
                        "examples": [
                            {
                                "example_id": "5d3ff7ad-fdff-4fc4-919d-d5a264450717",
                                "sense_id": "1c05af1a-35c7-3e85-be4e-9bd9d0b18fca",
                                "text": "J'ai pensé à relumer avec la teinte ad hoc mais il me paraissait plus simple de \"théiser\" ,quand a la stabilité du thé dans le temps pas de probléme"
                            },
                            {
                                "example_id": "8fab5ce9-45d1-45fb-ae91-d270bd381ce4",
                                "sense_id": "1c05af1a-35c7-3e85-be4e-9bd9d0b18fca",
                                "text": "Auriez-vous une bonne adresse, en France, afin de faire relumer professionnellement les index d'une Speed cal 321 ?"
                            },
                            {
                                "example_id": "ec9abd10-183d-4d52-8424-37b810635040",
                                "sense_id": "1c05af1a-35c7-3e85-be4e-9bd9d0b18fca",
                                "text": "Au pire j'en achète des neuves et je les théise ou les relume avec la bonne teinte!"
                            }
                        ]
                    }
                ],
