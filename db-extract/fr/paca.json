                "senses": [
                    {
                        "sense_id": "5fc1cbe6-b59f-3fda-bd7b-d9d5b4e4bcd5",
                        "entry_id": "637d8ca9-a8c7-3fd8-a3c1-7bea7e4d080b",
                        "glosses": [
                            "Grand Rongeur (max. 80 cm de long) nocturne d'Amérique tropicale vivant du Sud du Mexique jusqu'au Paraguay, proche parent de l'agouti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f721cda-4d67-4e95-87bf-7817876e13e6",
                                "sense_id": "5fc1cbe6-b59f-3fda-bd7b-d9d5b4e4bcd5",
                                "text": "La viande de paca est très recherchée, ce qui menace son existence."
                            },
                            {
                                "example_id": "2fd3c787-f530-481f-b916-d163a81600b1",
                                "sense_id": "5fc1cbe6-b59f-3fda-bd7b-d9d5b4e4bcd5",
                                "text": "Le paca vit dans un terrier. Les mœurs sont proches de celles de l'agouti, mais la femelle a un seul petit par an, au milieu de l'été. Il s'apprivoise facilement."
                            },
                            {
                                "example_id": "a8f8cef7-6907-4165-af96-cc413767807b",
                                "sense_id": "5fc1cbe6-b59f-3fda-bd7b-d9d5b4e4bcd5",
                                "text": "Chez le paca, genre de gros rongeurs sud-américains appartenant à la même famille que le cochon d’Inde, il y a sept lobes au poumon droit et quatre au gauche."
                            }
                        ]
                    }
                ],
