                "senses": [
                    {
                        "sense_id": "eaa347d3-612b-3840-bb2b-79649e5c6f51",
                        "entry_id": "044b2d70-4a62-3170-bb57-71261470d5f8",
                        "glosses": [
                            "Donner un caractère messianique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe664c8-f5ca-441c-8516-3267396606a6",
                                "sense_id": "eaa347d3-612b-3840-bb2b-79649e5c6f51",
                                "text": "Gardons-nous de messianiser la classe ouvrière, de l'arracher à ses usines pour la faire vivre en utopie, en idyllie."
                            },
                            {
                                "example_id": "36fdd7fc-71f3-46b3-92d9-2661921c7e13",
                                "sense_id": "eaa347d3-612b-3840-bb2b-79649e5c6f51",
                                "text": "Bon prétexte pour envoyer Neymar au laboratoire et le messianiser."
                            },
                            {
                                "example_id": "9c02296c-3c33-4bcd-b5e6-815ef8dc3b1b",
                                "sense_id": "eaa347d3-612b-3840-bb2b-79649e5c6f51",
                                "text": "Le premier message que la sagesse adressera aux transhumanistes, c'est celui de ne pas « messianiser » leur cause."
                            }
                        ]
                    }
