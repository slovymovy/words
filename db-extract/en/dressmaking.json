                                                "sense_id": "38450493-60e1-32d4-a89c-0f3bd518588e",
                                                "text": "Apprendre la couture."
                                            },
                                            {
                                                "example_id": "54dafffa-7d9c-4f0d-8d09-2ba0119c22c1",
                                                "sense_id": "38450493-60e1-32d4-a89c-0f3bd518588e",
