                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f937f293-780b-4dec-af39-e672d521cb1c",
                                                "sense_id": "394ce4b2-321f-3141-82eb-68886aa4d954",
                                                "text": "Das Wort „Siebzehntausender“ hat siebzehn Buchstaben."
                                            },
                                            {
                                                "example_id": "f37dbe12-45b7-4b49-9315-451a049cffc0",
                                                "sense_id": "394ce4b2-321f-3141-82eb-68886aa4d954",
                                                "text": "„Chigurh humpelte die siebzehn Treppen des kühlen Betontreppenschachts hinauf, und als er bei der Stahltür auf dem Treppenabsatz anlangte, schoss er mit dem Bolzenschussgerät den Schlosszylinder heraus, öffnete die Tür, trat in den Flur und schloss die Tür hinter sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1974825a-f2c2-3bdd-9ffb-f88de6226420",
                                        "entry_id": "518865bf-edf1-30e9-8dac-63d148e92e3e",
                                        "glosses": [
                                            "kurz für „siebzehn Jahre (alt)“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7189eb2-aac5-413a-9963-77ba598c0e7d",
                                                "sense_id": "1974825a-f2c2-3bdd-9ffb-f88de6226420",
                                                "text": "Was wolltest du werden, als du siebzehn warst?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
