                                        "entry_id": "34248f04-0b0d-37e4-a0ef-b65faad4fde5",
                                        "glosses": [
                                            "australisches Säugetier mit grauem Fell, das auf Bäumen lebt und sich fast ausschließlich von Eukalyptusblättern ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed9e23f2-2611-49ff-b358-7f86882855b9",
                                                "sense_id": "11345dbc-d8b4-33c9-bc53-53d6f3ef7319",
                                                "text": "„Kein halbes Jahr später strotzte das Naturschutzgebiet wieder vor sattem Grün; sogar Koalabären waren zurückgekehrt.“"
                                            }
