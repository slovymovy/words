                ],
                "senses": [
                    {
                        "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                        "entry_id": "a85b564a-afc8-3c2d-9c55-dc4123ca0c8e",
                        "glosses": [
                            "Maschine, die aus erwärmtem Kunststoffgranulat direkt verwendbare Kunststoffteile formt"
                        ],
                        "tags": [
                            "Kunststofftechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "15bc4739-b995-47e9-8dbf-593e145174d3",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„Für das Kunststoffspritzgießen werden Metallwerkzeugeinsätze benötigt, die in Stammwerkzeuge eingesetzt und an Kunststoffspritzgießmaschinen genutzt werden können.“"
                            },
                            {
                                "example_id": "79ffd3c3-0743-40b5-8832-af9ff41899bc",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„Ein typisches Beispiel dafür ist die Regelung von servoelektrischen Pumpenantrieben in Kunststoffspritzgießmaschinen.“"
                            },
                            {
                                "example_id": "6f7a12c1-c0ab-4aad-94f2-ac29dc130eae",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„Die Werkzeuge werden in der Regel auf Kunststoffspritzgießmaschinen zur Fertigung von Bauteilen aus thermoplastischen Kunststoffen verwendet und dazu in Stammrahmen montiert.“"
                            },
                            {
                                "example_id": "a0be0bdc-826c-4390-9618-c375e04951f6",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„1946 war LEGO der erste Spielzeughersteller in Dänemark, der eine Kunststoffspritzgießmaschine anschaffte; sie kostete mehr als das Doppelte des Vorjahresgewinns.“"
                            },
                            {
                                "example_id": "e8e40b81-fa1b-4464-81fd-89baf9384124",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„Der Hersteller von Kunststoffspritzgießmaschinen zählt weltweit zu den Branchenführern.“"
                            },
                            {
                                "example_id": "c27baa8a-0e47-4428-b7c9-41aa62010bbc",
                                "sense_id": "8e5a79d2-38c0-357e-ad3c-9c663ea3fa2f",
                                "text": "„Die Simulation bildet eine Fertigungshalle inklusive Klimatisierung sowie die in der Halle stattfindende Produktion an 23 Kunststoffspritzgießmaschinen nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
