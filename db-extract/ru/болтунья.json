                        "sense_id": "bd50b3b8-eafa-3858-a2b1-b1b7296c5ef4",
                        "entry_id": "a69b6eb5-6654-3b7c-b8b8-adb4d4bae3d7",
                        "glosses": [
                            "female equivalent of болту́н (boltún): an overly talkative person"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3c9049b2-0e37-480c-bd62-502c3c12161f",
                                "sense_id": "bd50b3b8-eafa-3858-a2b1-b1b7296c5ef4",
                                "text": "А ме́жду тем сестра́ Зи́на молода́, — ей то́лько 22 го́да, — хороша́ собо́й, изя́щна, весела́; она́ хохоту́шка, болту́нья, спо́рщица, стра́стная музыка́нтша<...>.",
                                "translation": "And meanwhile Zina was young--she was only twenty-two--good-looking, elegant, gay; she was fond of laughing, chatter, argument, a passionate musician<...>.",
                                "english": "And meanwhile Zina was young--she was only twenty-two--good-looking, elegant, gay; she was fond of laughing, chatter, argument, a passionate musician<...>."
                            }
                        ]
