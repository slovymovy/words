                ],
                "senses": [
                    {
                        "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                        "entry_id": "4a4616ee-d7d8-36a8-8b12-4bb55938b755",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156c8787-3f11-4108-b5b1-5a91038aacb8",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Frau Nikolai ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c5f08661-aaac-4483-86ab-b8c5d638bad1",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Herr Nikolai wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "24955535-3c8c-47b2-8470-3e68016b7c4c",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Die Nikolais fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fac4dbda-2bd0-4691-9998-63c125b11eec",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Der Nikolai trägt nie die Schals, die die Nikolai ihm strickt."
                            },
                            {
                                "example_id": "0c141101-5b73-4f0f-8614-9c7844622d6e",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nikolai kommt, geht der Herr Nikolai.“"
                            },
                            {
                                "example_id": "6942287d-dcd8-4c71-8f66-95833ff308e6",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Nikolai kommt und geht."
                            },
                            {
                                "example_id": "b4f2ab06-2cb7-44aa-92ad-154f0b4b5bf3",
                                "sense_id": "44a50465-3474-320c-b353-05e6042692c6",
                                "text": "Nikolais kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
