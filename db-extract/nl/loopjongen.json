                        "examples": [
                            {
                                "example_id": "fa9d6b09-1daa-4a05-b5a0-17da98d9a61d",
                                "sense_id": "48df6b64-f212-346b-a4bb-3142efaa693e",
                                "text": "Het wrange is dat het vooral ook in het voordeel van Turkse Nederlanders is om zich in de eerste plaats om hun eigen land te bekommeren. Misschien is het verstandiger om je niet alleen maar als een loopjongen van Erdogan te gedragen, maar ook af en toe te demonstreren voor zaken die in jouw eigen belang zijn, zoals bijvoorbeeld de zorg, pensioenen, onderwijs en milieu in ons land, Nederland."
                            }
                        ]
                    },
