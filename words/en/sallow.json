{
    "word_family": [
        "sallowness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6e4b9ba-7b85-37d1-a526-e82e323d9928",
                    "sense_definition": "Having skin of a sickly pale or yellowish colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Time is jealous of you, and you will become <w>sallow</w> and hollow-cheeked.",
                            "target_lang_translations": {
                                "cs": "Čas na tebe žárlí a ty budeš <w>nažloutlá</w> a propadlá v tvářích."
                            }
                        },
                        {
                            "text": "In a matter of hours she was looking gaunt and <w>sallow</w>.",
                            "target_lang_translations": {
                                "cs": "Během několika hodin vypadala vyzáble a <w>nažloutle</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající nezdravě bledou nebo nažloutlou barvu pleti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nažloutlý",
                                "target_lang_sense_clarification": "o barvě pleti, která působí nezdravě"
                            },
                            {
                                "target_lang_word": "bledý",
                                "target_lang_sense_clarification": "o nezdravě vypadající, bledé pleti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02866c85-81e4-3e78-a86d-3b939d197b59",
                    "sense_definition": "Having a pale, yellowish colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sallow</w> pages of the old book seemed to turn red with age.",
                            "target_lang_translations": {
                                "cs": "<w>Zažloutlé</w> stránky staré knihy jako by stářím červenaly."
                            }
                        },
                        {
                            "text": "A <w>sallow</w> night-light glowed from the table and cast shadows on the walls.",
                            "target_lang_translations": {
                                "cs": "Ze stolu zářilo <w>nažloutlé</w> noční světlo a vrhalo stíny na stěny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající bledou, nažloutlou barvu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zažloutlý",
                                "target_lang_sense_clarification": "o barvě věcí, které stářím zežloutly"
                            },
                            {
                                "target_lang_word": "nažloutlý",
                                "target_lang_sense_clarification": "mající nádech žluté barvy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2094ca98-551f-3049-ba78-cf0f4ac54791",
                    "sense_definition": "Foul, murky, or sickly in appearance or atmosphere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sallow</w> air of our cities is a sad legacy of industrial pollution.",
                            "target_lang_translations": {
                                "cs": "<w>Kalný</w> vzduch našich měst je smutným dědictvím průmyslového znečištění."
                            }
                        },
                        {
                            "text": "The boat's deck was covered in moss and its <w>sallow</w> water gave off a glow.",
                            "target_lang_translations": {
                                "cs": "Paluba lodi byla pokrytá mechem a její <w>kalná</w> voda vydávala záři."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nečistý, kalný nebo nezdravě působící vzhled či atmosféra."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kalný",
                                "target_lang_sense_clarification": "o nečistém, neprůhledném vzhledu"
                            },
                            {
                                "target_lang_word": "nezdravý",
                                "target_lang_sense_clarification": "o atmosféře nebo prostředí, které působí škodlivě"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe5dfb98-23bf-3baa-9690-f67b23e8df83",
                    "sense_definition": "A European willow tree that has broad leaves and large catkins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small gnats mourn among the river <w>sallows</w>.",
                            "target_lang_translations": {
                                "cs": "Drobní komáři truchlí mezi říčními <w>vrbami jívami</w>."
                            }
                        },
                        {
                            "text": "Everything irritated him, even the two <w>sallows</w> by the river.",
                            "target_lang_translations": {
                                "cs": "Všechno ho dráždilo, dokonce i ty dvě <w>jívy</w> u řeky."
                            }
                        }
                    ],
                    "synonyms": [
                        "goat willow"
                    ],
                    "target_lang_definitions": {
                        "cs": "Evropský druh vrby s širokými listy a velkými jehnědami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrba jíva",
                                "target_lang_sense_clarification": "botanický název pro tento druh vrby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf3946c5-e115-3980-b57f-bf29f60a8b4d",
                    "sense_definition": "A flexible willow twig or branch used for weaving.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stuck a number of <w>sallows</w> in the grass to form a circle.",
                            "target_lang_translations": {
                                "cs": "Zapíchal do trávy několik <w>vrbových proutků</w>, aby vytvořil kruh."
                            }
                        },
                        {
                            "text": "The <w>sallow</w> knows the basketmaker's thumb.",
                            "target_lang_translations": {
                                "cs": "<w>Vrbový proutek</w> zná palec košíkáře."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ohebný vrbový proutek nebo větev používaná k pletení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrbový proutek",
                                "target_lang_sense_clarification": "ohebná větev vrby vhodná k pletení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c8634e9-dbf6-352d-9a7a-3173a3797c1d",
                    "sense_definition": "To become sallow in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His complexion had darkened and <w>sallowed</w> over the years.",
                            "target_lang_translations": {
                                "cs": "Jeho pleť během let ztmavla a <w>zežloutla</w>."
                            }
                        },
                        {
                            "text": "I watched each petal <w>sallowing</w> as the flower died.",
                            "target_lang_translations": {
                                "cs": "Sledoval jsem, jak každý okvětní lístek <w>žloutne</w>, zatímco květ umíral."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Získat nažloutlý nebo nezdravý vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zežloutnout",
                                "target_lang_sense_clarification": "získat žlutý nádech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2a9ea35-0e13-3a84-987d-c544f9577c9d",
                    "sense_definition": "To cause someone or something to become sallow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many causes combine to <w>sallow</w> their complexions.",
                            "target_lang_translations": {
                                "cs": "Mnoho příčin se spojuje, aby <w>způsobilo zežloutnutí</w> jejich pleti."
                            }
                        },
                        {
                            "text": "The years had <w>sallowed</w> her skin.",
                            "target_lang_translations": {
                                "cs": "Léta <w>způsobila zežloutnutí</w> její kůže."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že někdo nebo něco získá nažloutlý vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "způsobit zežloutnutí",
                                "target_lang_sense_clarification": "vyvolat změnu barvy na žlutou"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}