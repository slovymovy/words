                "senses": [
                    {
                        "sense_id": "f2f9d678-18a7-3b2f-a6c2-ca9238caf85d",
                        "entry_id": "9b8fb2d2-4613-3fbc-a4e8-3b0042f34e6d",
                        "glosses": [
                            "weibliche Person, die Drogen verkauft"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "be95c42d-36af-45e6-ac44-7662a59abf12",
                                "sense_id": "f2f9d678-18a7-3b2f-a6c2-ca9238caf85d",
                                "text": "„Eine 29 Jahre alte Dealerin hat die Polizei in Wilhelmsburg festgenommen, als sie gerade Heroin verkaufen wollte.“"
                            },
                            {
                                "example_id": "f93a47e1-4911-47ff-b50c-43c8593261b2",
                                "sense_id": "f2f9d678-18a7-3b2f-a6c2-ca9238caf85d",
                                "text": "„Sie wird zur Dealerin und greift dabei auch auf ihre Backkünste als ehemalige Konditorin zurück.“"
                            },
                            {
                                "example_id": "a04ee473-8e0e-4e2d-9603-5ab979403984",
                                "sense_id": "f2f9d678-18a7-3b2f-a6c2-ca9238caf85d",
                                "text": "„Ein Kunde der mutmaßlichen Dealerin, ein 25-jähriger Mann aus Wien, wurde auf freiem Fuß angezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
