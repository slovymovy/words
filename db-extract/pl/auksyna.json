                        "translation_id": "24b12f33-4935-4229-b35c-82e4807132c8",
                        "source_entry_id": "550cb618-ec34-3c22-8b08-6ef224f1b413",
                        "source_sense_id": "9d6ebf9f-97be-3382-af00-f762bf272991",
                        "target_lang_word": "auxin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auxin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                        "entry_id": "9c964444-ce90-38de-b2b6-50ec5b4e3f1b",
                                        "glosses": [
                                            "A class of plant growth substance (often called phytohormones or plant hormones) which play an essential role in coordination of many growth and behavioral processes in the plant life cycle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec73c23c-0afa-465b-8e39-4079a9da7608",
                                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                                "text": "In Arabidopsis roots, cold stress may reduce shootward auxin transport and alter the intracellular auxin gradient."
                                            },
                                            {
                                                "example_id": "cdb1b9d9-cedd-4307-b49a-348613cfdb00",
                                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                                "text": "SE onset depends on a complex network of interactions among plant growth regulators, mainly auxins and cytokinins, during the proembryogenic early stages, and ethylene and gibberellic and abscisic acids later in the development of somatic embryos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fe3d1a3-44c1-4aca-9ee4-4f82ac8184aa",
                        "source_entry_id": "550cb618-ec34-3c22-8b08-6ef224f1b413",
                        "source_sense_id": "9d6ebf9f-97be-3382-af00-f762bf272991",
                        "target_lang_word": "auxine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auxine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550714c9-8e3c-3f35-b14a-b66aa4e28c63",
                                        "entry_id": "78de3269-0ecd-3acb-9177-8edcc40eb93c",
                                        "glosses": [
                                            "Acide β-indole acétique, en tant qu’hormone végétale de croissance qui joue un grand rôle dans le développement d’une plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13da9c89-8d18-40a7-95d4-d0925a70f0e7",
                                                "sense_id": "550714c9-8e3c-3f35-b14a-b66aa4e28c63",
                                                "text": "Des teneurs importantes en cytokinines et en auxines dans les nodules actinorhiziens ont déjà été signalées."
                                            },
                                            {
                                                "example_id": "224ae1d0-6fc5-42a9-b1c0-ed2cc8c281cc",
                                                "sense_id": "550714c9-8e3c-3f35-b14a-b66aa4e28c63",
                                                "text": "Vers de terre, collemboles ou nématodes influencent le développement des plantes par la production d’hormones végétales telles que l’auxine, probablement du fait de la stimulation de bactéries du sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1780545-b8f6-30e9-b817-4ad54eb506f2",
                                        "entry_id": "78de3269-0ecd-3acb-9177-8edcc40eb93c",
                                        "glosses": [
                                            "Toute phytohormone dont la molécule porte un noyau indol."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
