                "senses": [
                    {
                        "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                        "entry_id": "05f394cb-3dd1-33a6-b19a-7f56bdb12dea",
                        "glosses": [
                            "Feldzug, um Vergeltung zu üben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec731d3-59cc-41e4-82d6-a8849ab106d0",
                                "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                                "text": "„In einem Rachefeldzug sollte er verlorenes Terrain für Rom zurückgewinnen - eine unerfüllbare Mission.“"
                            },
                            {
                                "example_id": "a540d223-2cff-469b-bb5d-607f47f5026b",
                                "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                                "text": "„Ein Rachefeldzug im folgenden Jahre 811 führte das aus Franken und Sachsen bestehende Heer abermals über die Elbe.“"
                            },
                            {
                                "example_id": "f7fada76-5787-4de7-a169-7404b0a5d93c",
                                "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                                "text": "„Am 15. Januar 1947 kam sie damit in Innsbruck an, um ihren Rachefeldzug zu beginnen.“"
                            },
                            {
                                "example_id": "78c9e595-cf5a-4941-ad8f-ff2ca34bd46d",
                                "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                                "text": "„Als sich die Kunde verbreitete, stellte Kelseys Bruder eine Miliz für einen Rachefeldzug zusammen.“"
                            },
                            {
                                "example_id": "7e7f21bd-8107-4e46-bd6b-cff020910a25",
                                "sense_id": "e2212faa-43fb-3095-8b72-946bc28322bc",
                                "text": "„Sie zögern nicht, extreme Maßnahmen gegen andere zu ergreifen, wenn es darum geht, einen Überfall oder einen Rachefeldzug zu planen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
