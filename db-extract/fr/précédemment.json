                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "562735d6-4213-3951-ba55-7534a8b772c4",
                                        "entry_id": "663a3ce1-b195-33ce-a8ed-0ddfa5cf3ead",
                                        "glosses": [
                                            "First; beforehand, in advance."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61dbcd53-1dbc-41f2-8b4d-a238fd71e1fa",
                                                "sense_id": "562735d6-4213-3951-ba55-7534a8b772c4",
                                                "text": "I must, however, previously remark, that the power of generalizing ideas, to any great extent, is not very common amongst men or women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a136d3b2-c04f-3bdf-a5ef-08f7f31498c8",
                                        "entry_id": "663a3ce1-b195-33ce-a8ed-0ddfa5cf3ead",
                                        "glosses": [
                                            "At an earlier time; already."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed9424e-ec31-4dff-a4e3-de6eaf0248c0",
                                                "sense_id": "a136d3b2-c04f-3bdf-a5ef-08f7f31498c8",
                                                "text": "The discovery of a previously unknown species had taken place nearly two years previously."
                                            },
                                            {
                                                "example_id": "b18f63e1-5f68-4f65-80f8-bea7e4d4f838",
                                                "sense_id": "a136d3b2-c04f-3bdf-a5ef-08f7f31498c8",
                                                "text": "Pliny the Elder, the Roman encyclopedist, declares that to urinate in a spot where a dog has previously done so results in loss of virility."
                                            },
                                            {
                                                "example_id": "88004a8e-f155-4db9-bce2-d62ca6d9e709",
                                                "sense_id": "a136d3b2-c04f-3bdf-a5ef-08f7f31498c8",
                                                "text": "In the lawsuit, Giuffre claimed she was forced to have sex with a “large amount of people,” some of whom had not previously been named including New Mexico Gov. Bill Richardson […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535bdfc8-99dc-3bc0-b2f2-bc757e94f1eb",
                                        "entry_id": "663a3ce1-b195-33ce-a8ed-0ddfa5cf3ead",
                                        "glosses": [
                                            "Recapitulating the preceding episodes of a series."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d04b5afa-fc0a-41ae-8bc4-c4221f4a7a4b",
                        "source_entry_id": "a1efe844-2d59-3e6f-a6c7-a83711eeab6f",
