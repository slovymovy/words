                "senses": [
                    {
                        "sense_id": "08f304bf-c581-304b-b92d-bb49b4af72d1",
                        "entry_id": "e4b180d3-c0a2-3808-8469-df847315c9b0",
                        "glosses": [
                            "lenient, forgiving, permissive, concessive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cedd98f6-e05e-44de-9cc9-063c9aa1b000",
                                "sense_id": "08f304bf-c581-304b-b92d-bb49b4af72d1",
                                "text": "De leraar was toegeeflijk en gaf de studenten extra tijd voor hun project.",
                                "translation": "The teacher was lenient and gave the students extra time for their project.",
                                "english": "The teacher was lenient and gave the students extra time for their project."
                            },
                            {
                                "example_id": "3b13388f-7875-4323-a0c8-0cb226408ab8",
                                "sense_id": "08f304bf-c581-304b-b92d-bb49b4af72d1",
                                "text": "Veel ouders zijn te toegeeflijk als het gaat om de schermtijd van hun kinderen.",
                                "translation": "Many parents are too permissive when it comes to their children's screen time.",
                                "english": "Many parents are too permissive when it comes to their children's screen time."
                            },
                            {
                                "example_id": "c1d210af-6b7f-4fe2-91d8-4c81bc37dbb3",
                                "sense_id": "08f304bf-c581-304b-b92d-bb49b4af72d1",
                                "text": "Ondanks haar fouten was hij altijd toegeeflijk en vergevingsgezind.",
                                "translation": "Despite her mistakes, he was always forgiving and understanding.",
                                "english": "Despite her mistakes, he was always forgiving and understanding."
                            }
                        ]
                    }
                ],
