                {
                    "sense_id": "560a34e0-84b0-375a-b455-c83854273762",
                    "sense_definition": "Fleur parfumée poussant en grappes pyramidales au printemps, généralement mauve, violette ou blanche.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a cueilli un grand bouquet de <w>lilas</w> pour décorer la table du salon."
                        },
                        {
                            "text": "L'odeur des <w>lilas</w> fraîchement coupés embaumait toute la pièce dès le matin."
                        }
                    ],
                    "common_phrases": [
                        "bouquet de lilas",
                        "branche de lilas"
                    ]
                },
                {
                    "sense_id": "59b82b29-0bfc-36a0-9dce-45393554fe8e",
                    "sense_definition": "Arbuste ornemental à feuilles caduques opposées et aux grappes de fleurs très odorantes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque printemps, le vieux <w>lilas</w> au fond du jardin se couvre de jolies fleurs."
                        },
                        {
                            "text": "Nous avons décidé de planter un <w>lilas</w> près de la barrière de notre maison."
                        }
                    ],
                    "common_phrases": [
                        "lilas en fleur"
                    ]
                },
                {
                    "sense_id": "fae6d0b4-c467-3f00-87e3-82d472128882",
                    "sense_definition": "Couleur mauve clair tirant sur le violet pâle, semblable à celle des fleurs du même nom.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel prenait une teinte subtile de <w>lilas</w> au fur et à mesure que le soleil se couchait."
                        },
                        {
                            "text": "Cette nuance délicate de <w>lilas</w> apporte beaucoup de douceur sur les murs de la chambre."
                        }
