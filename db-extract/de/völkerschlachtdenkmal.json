                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c44d60-26f8-469b-811c-cbcc0d173f1e",
                                "sense_id": "c7ee5210-9aeb-3139-ac2e-08340dcb2885",
                                "text": "„Der Förderverein Völkerschlachtdenkmal e. V. setzt alles daran, bis 2013 auch die Außenanlagen instand zu setzen.“"
                            },
                            {
                                "example_id": "95efcbea-9541-4835-a99b-830781059517",
                                "sense_id": "c7ee5210-9aeb-3139-ac2e-08340dcb2885",
                                "text": "„Das Völkerschlachtdenkmal am Rand der Stadt Leipzig ist das mit Abstand größte deutsche Nationaldenkmal.“"
                            },
                            {
                                "example_id": "ce0f7f7d-ea78-41d2-93db-452a0d255161",
                                "sense_id": "c7ee5210-9aeb-3139-ac2e-08340dcb2885",
                                "text": "„Nicht zuletzt sind die Heiligenstädter stolze Besitzer des ältesten deutschen Völkerschlachtdenkmals, eingeweiht noch während des Wiener Kongresses 1815.“"
                            }
                        ],
