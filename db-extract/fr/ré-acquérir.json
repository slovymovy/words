                "senses": [
                    {
                        "sense_id": "36dd2cd6-1133-3037-a6c9-0b44f560834d",
                        "entry_id": "cdc1372d-3844-329b-b0f2-7ff5e8882b00",
                        "glosses": [
                            "Autre orthographe de réacquérir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3319cc74-240c-4a02-99b6-8e32a5e1bc13",
                                "sense_id": "36dd2cd6-1133-3037-a6c9-0b44f560834d",
                                "text": "L'activité ELANs permet au bénéficiaire : - de travailler sur sa situation personnelle pour permettre une re-dynamisation - de reprendre un rythme de vie, de travail, d'acquérir ou de ré-acquérir des repères socio-professionnels (...)"
                            },
                            {
                                "example_id": "fa9b00dd-86ca-49e4-841f-ad629c9ac17c",
                                "sense_id": "36dd2cd6-1133-3037-a6c9-0b44f560834d",
                                "text": "Le but de la rééducation des personnes suite à un traumatisme cérébral est de les aider à ré-acquérir le plus haut niveau d'autonomie possible."
                            },
                            {
                                "example_id": "84be04fc-da31-498c-b97c-46cbfaf5d5b0",
                                "sense_id": "36dd2cd6-1133-3037-a6c9-0b44f560834d",
                                "text": "Un savoir-faire que vous pouvez ré-acquérir en peu de temps, et à peu de frais."
                            }
                        ]
                    }
