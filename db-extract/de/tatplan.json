                "senses": [
                    {
                        "sense_id": "6584b597-d0d4-3df5-b5e5-277e97aa1859",
                        "entry_id": "f359caaf-3d0a-3f1d-a434-08895b49c8e6",
                        "glosses": [
                            "durchdachte Vorgehensweise für eine Handlung (insbesondere für eine Straftat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b732d0c9-042c-4a7e-b744-68bf268b9f32",
                                "sense_id": "6584b597-d0d4-3df5-b5e5-277e97aa1859",
                                "text": "„Einen gemeinsamen Tatplan der Schläger und der Gruppe im Hof hätten die Ermittlungen nicht ergeben, so die Staatsanwaltschaft.“"
                            },
                            {
                                "example_id": "a81e4481-cfec-4c39-87e1-784c74f78f36",
                                "sense_id": "6584b597-d0d4-3df5-b5e5-277e97aa1859",
                                "text": "„Wenn zwei Personen an einem Tatgeschehen arbeitsteilig zusammenwirken und nach einem gemeinsamen Tatplan agieren, wäre es nicht angemessen, die Handlungen der beiden Täter isoliert voneinander zu betrachten. Daher werden die Tatbeiträge der einvernehmlich Agierenden gegenseitig zugerechnet, um dem Unrechtsgehalt der Tat gerecht zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
