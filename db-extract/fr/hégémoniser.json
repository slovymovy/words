                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3c2b50e2-77cc-33c8-b8cc-be3ad9735db5",
                        "entry_id": "3bc1a975-a0dd-3e1b-95a1-8245a6f87640",
                        "glosses": [
                            "Se montrer hégémonique envers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8beedfa6-e593-4ee9-b863-62e024be8c1d",
                                "sense_id": "3c2b50e2-77cc-33c8-b8cc-be3ad9735db5",
                                "text": "En défendant bec et ongles la création d’un espace ouvert à tous où aucune organisation, aucun mouvement, aucun parti politique ne saurait prétendre hégémoniser l’ensemble (Whitaker, 2006)."
                            },
                            {
                                "example_id": "f1099f3f-417b-4f59-a7bd-b295cc6b0084",
                                "sense_id": "3c2b50e2-77cc-33c8-b8cc-be3ad9735db5",
                                "text": "La question qui se pose alors concerne le fonctionnement de l’objet a dans cette tension entre le signifiant maître et l’ensemble des signifiants « ordinaires » qui luttent pour l’hégémoniser."
                            }
                        ]
                    }
                ],
