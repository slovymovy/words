                                        "glosses": [
                                            "weibliche Person, die sich in politischen Gremien für die Interessen einer Gruppe, meist eines wirtschaftlichen Unternehmens, einsetzt/stark macht"
                                        ],
                                        "tags": [],
                                        "examples": [
