                "senses": [
                    {
                        "sense_id": "9114ca8b-3bf6-3330-aad0-30ec0bbf7c38",
                        "entry_id": "9c0fd5c1-32ea-37d8-8743-5d1327b10927",
                        "glosses": [
                            "kleiner Rucksack, in dem Dinge, die während eines Tages benötigt werden, mitgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab139787-5a5d-476d-9ae2-463e01d80778",
                                "sense_id": "9114ca8b-3bf6-3330-aad0-30ec0bbf7c38",
                                "text": "Ich setze meinen Tagesrucksack für nahezu jedes Vorhaben ein: zur Arbeit, zum Einkaufen oder für einen Tagesausflug ins Grüne."
                            },
                            {
                                "example_id": "64d5743a-7e80-45af-a2b5-f75e91a59834",
                                "sense_id": "9114ca8b-3bf6-3330-aad0-30ec0bbf7c38",
                                "text": "Für eine Bergtour gehören eine Brotzeit, Wanderkarten, ein GPS-Gerät und eine warme Jacke in den Tagesrucksack."
                            },
                            {
                                "example_id": "20278ada-1668-413a-b998-5bf78cea6466",
                                "sense_id": "9114ca8b-3bf6-3330-aad0-30ec0bbf7c38",
                                "text": "„Diesen Tagesrucksack gibt es selbstverständlich in vielfältig verschiedenen Größen und Ausführungen, spezialisiert auf die Bedürfnisse von Bikern, Bergwanderern oder Büromenschen.“"
                            },
                            {
                                "example_id": "65f08083-5d8e-465a-8fa1-d59d4e220594",
                                "sense_id": "9114ca8b-3bf6-3330-aad0-30ec0bbf7c38",
                                "text": "„Pemba Dorje Sherpa brauchte gestern für seinen Gipfelaufstieg vom Basislager nicht mehr als eine nepalesische Flagge, ein gerahmtes Bild von Thucche, einem Lama aus Rimpoche, und einen kleinen Tagesrucksack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
