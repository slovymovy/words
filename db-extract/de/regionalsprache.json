                ],
                "senses": [
                    {
                        "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                        "entry_id": "60dd03d7-6d5b-31b9-85fb-c219bdfc09be",
                        "glosses": [
                            "eine Sprachform, die in einer Sprachgemeinschaft nur eine räumlich begrenzte Verbreitung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6433c186-b302-4c39-a921-0c19f395e34c",
                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                "text": "„Die Tarnung früherer krimineller Vaganten als ambulante Gewerbetreibende, z.B. Wandermusikanten, Hausierer, Korbmacher, Kesselflicker, verweist zugleich auf weitere Sprachteilhaber des Rotwelschen, das im alltäglichen Kontakt mit dem Jiddischen (Handelsjuden), Zigeunerischen und der jeweiligen Regionalsprache zahlreiche Differenzierungen erfahren hat.“"
                            },
                            {
                                "example_id": "4478f27a-88a8-418c-8616-16537b430b94",
                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                "text": "„Einzig zur soziolektalen Differenzierung einer Regionalsprache (des Ruhrgebiets) und zu deren sozialen Stigma-Signalen liegt eine empirische Studie von W. Steinig (1976) vor.“"
                            },
                            {
                                "example_id": "a4b8d09d-49cc-4bed-8789-ff67238f23ac",
                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                "text": "„Ortssprachen und Regionalsprachen, über deren sprachwissenschaftliche Analyse wir nachdenken wollen, gehören in den Zusammenhang von Sprache und Sprachen in einem Gebiet, das ein Ortspunkt, ein Bezirk, eine Region, ein Land, eine Ländergruppe usf. sein kann.“"
                            },
                            {
                                "example_id": "9a04817b-8ea8-4859-9dc1-5084b2e46fa5",
                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                "text": "„Die Diskriminierung der südlichen Regionalsprachen findet täglich in den Kindergärten und Schulen statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                        "entry_id": "60dd03d7-6d5b-31b9-85fb-c219bdfc09be",
                        "glosses": [
                            "Sprachform mit nur regionaler Verbreitung in einer Sprachgemeinschaft, die besonders geschützt/gefördert werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a7c9c8-b18c-4e43-9cd8-9ee0ee8fc501",
                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                "text": "In Deutschland genießt nur das Niederdeutsche den Status einer Regionalsprache."
                            },
                            {
                                "example_id": "5248bc25-5c10-43b3-a608-dd37e8c1d25d",
                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                "text": "„Das Departement Haut-Rhin hat die Beamten ausdrücklich dazu aufgefordert, im Publikumsverkehr die Regionalsprache einzusetzen.“"
                            },
                            {
                                "example_id": "38795688-5e5f-4f6e-8ccd-1302da5e6660",
                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                "text": "„Dabei gibt es doch die Europäische Charta der Regional- oder Minderheitensprachen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af6d62f-b1bc-40fe-b3ed-f13df642723f",
                        "source_entry_id": "60dd03d7-6d5b-31b9-85fb-c219bdfc09be",
                        "source_sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                        "target_lang_word": "langue régionale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue régionale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92dd5556-547d-39f1-9690-7e51519e5c60",
                                        "entry_id": "547f4b3d-846e-34ff-999a-f988f5acb34f",
                                        "glosses": [
                                            "Langue parlée par une partie de la population d’un pays, qui n’en est pas une langue officielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfac6ae7-7440-4b84-9b4b-e10436e23c2c",
                                                "sense_id": "92dd5556-547d-39f1-9690-7e51519e5c60",
                                                "text": "Au fil de ces conflits se défait le régime de semi-tolérance que la Constituante avait d’abord accordé aux langues régionales. La langue locale, aux premiers jours de la Révolution, paraissait seulement une gêne, simple obstacle à la diffusion rapide des idées révolutionnaires ; on traduisait en basque ou en breton les lois et décrets ; […]"
                                            },
                                            {
                                                "example_id": "c933d429-e7c1-4678-882c-6c447abc6aca",
                                                "sense_id": "92dd5556-547d-39f1-9690-7e51519e5c60",
                                                "text": "Pendant des décennies, les familles ont pensé que transmettre à leurs enfants leur langue régionale revenait à leur transmettre une maladie sociale. Aujourd’hui, elles ont compris que défendre la diversité culturelle participe de la défense de la diversité de la planète."
                                            },
                                            {
                                                "example_id": "5b19e604-ac55-4adc-994e-4ae60c3a1afd",
                                                "sense_id": "92dd5556-547d-39f1-9690-7e51519e5c60",
                                                "text": "Il ne faut pas confondre « dialectes régionaux » et « langues régionales ». Les dialectes sont des variétés d'une même langue, alors que les langues régionales ont un statut de langue à part entière, généralement parce qu'elles ont une graphie codifiée, mais parfois aussi pour des raisons politiques. Des exemples de langues régionales en France sont les différents créoles français, le breton, le corse ou encore le tahitien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
