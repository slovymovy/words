                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c8b8a6-ccd3-4c6a-8c19-e2c76901e1b1",
                                                "sense_id": "59543801-fdb6-35a7-b8df-d7a72e1b7a95",
                                                "text": "Noch haben wir mehrere Möglichkeiten."
                                            },
                                            {
                                                "example_id": "4280ee7b-fbcd-4268-af0b-7bbec8c5fcc5",
                                                "sense_id": "59543801-fdb6-35a7-b8df-d7a72e1b7a95",
                                                "text": "Holger ist jetzt 40 Jahre alt. Er hatte schon mehrere Partner. Mit dem letzten lebte er acht Jahre lang zusammen."
                                            }
