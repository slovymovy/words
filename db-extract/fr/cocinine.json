        "fr-extract.jsonl": [
            {
                "entry_id": "0316c5de-00c8-3c7f-bad8-84df5eccc5e5",
                "word": "cocinine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1961bd5-f503-3567-b78c-1a322ededc79",
                        "entry_id": "0316c5de-00c8-3c7f-bad8-84df5eccc5e5",
                        "glosses": [
                            "Matière grasse extraite de la noix de coco, dont la formule brute est C₂₂H₂₂O₄."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d212f6-e6d8-4133-98e1-2d99daa0072f",
                                "sense_id": "e1961bd5-f503-3567-b78c-1a322ededc79",
                                "text": "L'huile de coco fond à 22 ° . Elle se compose en majeure partie d'une graisse particulière, la cocinine, et de petites quantités d'oléine."
                            },
                            {
                                "example_id": "3ad51b43-b70d-4c67-b043-b470e79caaed",
                                "sense_id": "e1961bd5-f503-3567-b78c-1a322ededc79",
                                "text": "Cocinine, cocostéarine ou cocinate de glycérine. On l'obtient en coupant les noix de cocos en tranches minces, ou en les réduisant en bouillie et en exprimant la masse entre deux plaques chaudes ; l'huile exprimée se fige en se refroidissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "03b58602-b729-3e5a-86ab-ad68946c1a96",
                        "entry_id": "0316c5de-00c8-3c7f-bad8-84df5eccc5e5",
                        "glosses": [
                            "Alcaloïde extrait de Conium maculatum ou grande cigüe. Il s’agit probablement de la conicine ou conine ou cicutine, présenté ici sous un autre nom, ou simplement une inversion de lettre dans conicine (information à préciser ou à vérifier)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a62aad1-acd4-487b-9012-ebe6dd6b5b01",
                                "sense_id": "03b58602-b729-3e5a-86ab-ad68946c1a96",
                                "text": "On y a trouvé toute une échelle de cinq alcaloïdes dont le plus important (cocinine) se présente sous forme de liquide et volatile."
                            },
                            {
                                "example_id": "5d99092a-b168-406c-945c-ae81dd1cf05d",
                                "sense_id": "03b58602-b729-3e5a-86ab-ad68946c1a96",
                                "text": "Les symptômes que provoque absorption de la ciguë s'expliquent évidemment par une inhibition motrice complète. Or les corps susceptibles de précipiter la cocinine sont, à côté de l'iodure de potassium ioduré (combiné à d'énergiques vomitifs), le tanin, par conséquence le vin."
                            }
                        ]
                    }
                ],
