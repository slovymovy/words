                    {
                        "sense_id": "1096137a-18c7-3b0d-b7d1-49481b8108b6",
                        "entry_id": "5bf46c9d-16c0-3fc8-b453-bff543554cc5",
                        "glosses": [
                            "Agitation zur Rechtfertigung/Verherrlichung des Krieges"
