                "senses": [
                    {
                        "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                        "entry_id": "f0f71b45-7d94-3eab-9ddd-7571a7094e1d",
                        "glosses": [
                            "zonder mogelijkheid om ongedaan gemaakt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ad92fc-c236-46b5-b20c-80203f105b86",
                                "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                                "text": "Dat is toch geen onherroepelijke zaak!"
                            },
                            {
                                "example_id": "39f530a7-9dc4-40bf-91e9-3811e529a2b4",
                                "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                                "text": "Aan weerskanten brullen kerels als gekken om zichzelf te verdoven, om zichzelf moed te geven. Anderen rennen net als hij, geconcentreerd, de zenuwen in hun buik, met droge keel. Ze stormen allemaal op de vijand af, gewapend met een onherroepelijke woede, een verlangen naar wraak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ca38ae0-578a-4438-8a99-0f8a9938170b",
                        "source_entry_id": "f0f71b45-7d94-3eab-9ddd-7571a7094e1d",
                        "source_sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                        "source_sense_description": "zonder mogelijkheid om ongedaan gemaakt te worden",
                        "target_lang_word": "unwiderruflich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwiderruflich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bca4bb0-f2b0-397a-8c0b-4a9ba17e11fa",
                                        "entry_id": "c05b6e73-0207-3fed-acd3-f5946927af6c",
                                        "glosses": [
                                            "ohne Möglichkeit, etwas zu widerrufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38edd6d7-5a2f-441a-9696-3b6b93e5dbb8",
                                                "sense_id": "7bca4bb0-f2b0-397a-8c0b-4a9ba17e11fa",
                                                "text": "Das Urteil steht unwiderruflich fest."
                                            },
                                            {
                                                "example_id": "74bfb978-2487-4572-a328-ecbac6036000",
                                                "sense_id": "7bca4bb0-f2b0-397a-8c0b-4a9ba17e11fa",
                                                "text": "„Aber sie gehören inzwischen unwiderruflich zum Fachvokabular der Soziologie […], ohne daß als Grund dafür mehr als Gewöhnung an einen Zufall bei der Wahl eines geeigneten Wortes für eine noch nicht begriffene Sache ersichtlich ist – eines Wortes, das in einem großen, prädisziplinär-terminologischen Fundus zusammen mit anderen potentiellen Fachtermini zu fast beliebiger Verwendung bereit lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32aa8840-123d-3e9e-ae81-1f7e8c520f8c",
                                        "entry_id": "c05b6e73-0207-3fed-acd3-f5946927af6c",
                                        "glosses": [
                                            "nicht rückgängig zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3fc4a4e-bf5b-488c-a0d7-0939c3faac94",
                                                "sense_id": "32aa8840-123d-3e9e-ae81-1f7e8c520f8c",
                                                "text": "Mit diesem Programm werden die Daten von der Festplatte unwiderruflich gelöscht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6360a4ac-67ad-4827-afa0-53cece8a58c4",
                        "source_entry_id": "f0f71b45-7d94-3eab-9ddd-7571a7094e1d",
