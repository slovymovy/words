                "senses": [
                    {
                        "sense_id": "878c1dfc-4de3-3a5a-96d7-48739f0d46f5",
                        "entry_id": "e3ea519b-8a73-3520-9afc-d5de94761f86",
                        "glosses": [
                            "Lehre von der individuellen Ausgestaltung des Tempos in einem Musikstück"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "38807b12-41b5-46e4-99d5-05331f429cb9",
                                "sense_id": "878c1dfc-4de3-3a5a-96d7-48739f0d46f5",
                                "text": "Diese Konzentration auf die Darstellungsmittel der Agogik und Dynamik hat der Broschüre die spontane Wertschätzung Hugo Riemanns eingetragen, obwohl Klauwell im übrigen eine systematische Verbindung dieser Vortragsmittel mit der motivischen Struktur der Musik gar nicht beabsichtigt."
                            },
                            {
                                "example_id": "8044fbfd-8561-433b-ac80-48153f8d6b38",
                                "sense_id": "878c1dfc-4de3-3a5a-96d7-48739f0d46f5",
                                "text": "Diese Einspielung nun gibt ein weiteres Rätsel hinzu: Wie kommt es zu dieser freien Agogik, dieser fast sentimental zu nennenden Bewegung in Tempo und Lautstärke, in Phrasierung und Artikulation?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b8da46b-0412-4e8e-81b1-9846310a1112",
                        "source_entry_id": "e3ea519b-8a73-3520-9afc-d5de94761f86",
                        "source_sense_id": "878c1dfc-4de3-3a5a-96d7-48739f0d46f5",
                        "source_sense_description": "Musik: Lehre von der individuellen Ausgestaltung des Tempos in einem Musikstück",
                        "target_lang_word": "agogic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agogic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9233fb90-9c4c-3f29-9310-fc5e1cba3427",
                                        "entry_id": "3464036f-ba9a-39ad-a4b2-b4445d8ee629",
                                        "glosses": [
                                            "Accentuating a note by extending it slightly beyond its normal time value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ada87d-ed4a-4ff2-a480-9c3395e34217",
                                                "sense_id": "9233fb90-9c4c-3f29-9310-fc5e1cba3427",
                                                "text": "On most early instruments, changes were made only at agogic pauses, caesuras, repeats or between sections."
                                            },
                                            {
                                                "example_id": "8eb4c5fd-f584-4363-ad0e-0cce3a017844",
                                                "sense_id": "9233fb90-9c4c-3f29-9310-fc5e1cba3427",
                                                "text": "6F is the longest-held cadence sonority (it has the most agogic emphasis), and ends very conclusively with the V₇-I-V₇-V-I chord progression."
                                            },
                                            {
                                                "example_id": "65caa0cd-9d2e-41e2-aa4f-f33e741bff1f",
                                                "sense_id": "9233fb90-9c4c-3f29-9310-fc5e1cba3427",
                                                "text": "Obviously, extended melodies should end on the strongest and most agogic melodic cadence."
                                            },
                                            {
                                                "example_id": "058ee978-35a6-4bf9-bb34-4295307f71a4",
                                                "sense_id": "9233fb90-9c4c-3f29-9310-fc5e1cba3427",
                                                "text": "Timpanists need to be particularly aware of agogic accents because they often swallow up the smaller notes that precede them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agogic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76893300-e9bf-3c17-b666-957e42b21f40",
                                        "entry_id": "ee546f44-3d2f-3952-bbe7-4d90fc17a59a",
                                        "glosses": [
                                            "An accent that accentuates a note by extending it slightly beyond its normal time value."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5a96fb-0d79-4030-af99-dac91d1e8400",
