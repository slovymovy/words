                {
                    "sense_id": "a4443fdf-0f93-3306-8d9a-77f1ae05db2d",
                    "sense_definition": "Okrzyk wykrzykiwany przy uderzaniu kogoś, wyrażający agresję lub wymierzanie kary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Masz> za swoje, ty kłamco!",
                            "target_lang_translations": {
                                "ru": "<Получай> за всё, лжец!",
                                "en": "<Take that>, you liar!",
                                "nl": "<Zo>, dat heb je verdiend, jij leugenaar!",
                                "de": "<Nimm das>, du Lügner!",
                                "fr": "<Prends ça>, menteur !",
                                "it": "<Beccati> questo, bugiardo!",
                                "cs": "<Tady to máš>, ty lháři!",
                                "tr": "<w>Al bakalım</w> hak ettiğini, seni yalancı!",
                                "es": "<Toma> por lo que hiciste, ¡mentiroso!",
                                "zh": "<w>活该</w>，你这个骗子！"
                            }
                        },
                        {
                            "text": "<Masz>, żebyś popamiętał to na długo!",
                            "target_lang_translations": {
                                "ru": "<На>, чтобы ты запомнил это надолго!",
                                "en": "<Take that>, so you remember this for a long time!",
                                "nl": "<Zo>, dat zul je niet snel vergeten!",
                                "de": "<Nimm das>, damit du dir das für lange Zeit merkst!",
                                "fr": "<Prends ça>, pour que tu t'en souviennes longtemps !",
                                "it": "<Prendi>, così te lo ricorderai per un bel po'!",
                                "cs": "<Ber>, ať si to pamatuješ dlouho!",
                                "tr": "<w>Al bunu</w>, uzun süre unutmayasın diye!",
                                "es": "<Toma>, ¡para que te acuerdes de esto por mucho tiempo!",
                                "zh": "<w>受着吧</w>，让你长长记性！"
                            }
                        }
                    ],
