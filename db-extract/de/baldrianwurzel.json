                "senses": [
                    {
                        "sense_id": "6d9bbf37-8f41-3483-ad7e-86db7dd62702",
                        "entry_id": "535eea67-c626-34f9-bb84-3693630ee749",
                        "glosses": [
                            "Wurzel des Baldrians"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba330184-4e69-483a-8ef8-710f78ac38ba",
                                "sense_id": "6d9bbf37-8f41-3483-ad7e-86db7dd62702",
                                "text": "„Eine Angabe wie beispielsweise Baldrianwurzelextrakt 5:1 bedeutet, dass bei der Extraktion aus 5 Teilen Baldrianwurzel 1 Teil Baldrianextrakt erhalten wurde, die Wirkstoffe liegen im Extrakt in 5-fach höherer Konzentration vor als in der getrockneten Baldrianwurzel.“"
                            },
                            {
                                "example_id": "b40bf374-14f8-45d4-aacf-f00e36709210",
                                "sense_id": "6d9bbf37-8f41-3483-ad7e-86db7dd62702",
                                "text": "„Mein Arzt sagte, ich solle Baldrianwurzel kauen und mich mehr bewegen, irgendwann würde ich schon einschlafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
