                "senses": [
                    {
                        "sense_id": "4c1860cc-6c11-3ea9-835a-9e863ff46871",
                        "entry_id": "955e197a-3558-38c6-bb82-2f92c20f1dec",
                        "glosses": [
                            "Grade dans la cavalerie militaire, officier subalterne des armées impériales allemande et austro-hongroise à la tête d’un escadron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba41ca26-b159-4e47-9236-7e59efabd0b3",
                                "sense_id": "4c1860cc-6c11-3ea9-835a-9e863ff46871",
                                "text": "La salle n’était plus qu’un chaos humain indistinct. En haut de l’estrade : des douzaines de messieurs en habit. Manchettes blanches, bagues étincelantes. Un uniforme de dragon avec des cordons de rittmestre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2ee690d-058f-407c-b28b-01ec08bc7aee",
                        "source_entry_id": "955e197a-3558-38c6-bb82-2f92c20f1dec",
                        "source_sense_id": "4c1860cc-6c11-3ea9-835a-9e863ff46871",
                        "target_lang_word": "Rittmeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rittmeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50515149-d819-3e62-a96a-c4a5e6882eb5",
                                        "entry_id": "911a5170-dc9e-37a6-8e23-ef614f0f6c78",
                                        "glosses": [
                                            "Chef einer Schwadron bei der Kavallerie im Hauptmannsrang, Hauptmann der Kavallerie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e9f6bd-0ca2-4c4f-9151-7731c97d03cd",
                                                "sense_id": "50515149-d819-3e62-a96a-c4a5e6882eb5",
                                                "text": "„Der Rittmeister befahl, mit äußerster Vorsicht einzureiten; er rechnete mit einem Hinterhalt.“"
                                            },
                                            {
                                                "example_id": "4c802b87-34eb-4c07-b8eb-f8eec93c2015",
                                                "sense_id": "50515149-d819-3e62-a96a-c4a5e6882eb5",
                                                "text": "„Ein ähnlich klassisch gebildeter Mann war jener alte preußische Rittmeister, der eines Morgens auf die Reitbahn kommt und eine Zeitlang zuhört, wie der Feldwebel sich mit den Rekruten vergnügt, denen er gerade die ersten Anfänge der Reitkunst beibringt.“"
                                            },
                                            {
                                                "example_id": "674a6bc3-270d-4f0b-a7a1-b9e90e752d7d",
                                                "sense_id": "50515149-d819-3e62-a96a-c4a5e6882eb5",
                                                "text": "„In seiner Abwesenheit war er zum Rittmeister befördert worden, und als das Regiment auf Kriegsstärke gebracht wurde, bekam er wieder seine alte Schwadron.“"
                                            },
                                            {
                                                "example_id": "252e8c6e-3ee2-453b-91d3-00bfbd1dce73",
                                                "sense_id": "50515149-d819-3e62-a96a-c4a5e6882eb5",
                                                "text": "„Bei dem Grafen machte ich auch die Bekanntschaft des Baron von Sellentin, eines Rittmeisters in preußischen Diensten, der in Augsburg für seinen Herrn Rekruten anwarb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
