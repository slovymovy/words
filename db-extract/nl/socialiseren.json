                                    {
                                        "sense_id": "de89bf90-98a2-37e6-be63-afac2d828230",
                                        "entry_id": "1c3bdcdc-93ce-3252-84b6-2112862adf7e",
                                        "glosses": [
                                            "Werte in das Eigentum des Staates (der Gesellschaft) überführen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be626ff-9fc8-491e-b76b-5325fcc6544a",
                                                "sense_id": "de89bf90-98a2-37e6-be63-afac2d828230",
                                                "text": "Das Privateigentum ist aufzuheben und die Produktionsmittel sind zu vergesellschaften."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb55f9cb-42b7-34aa-abdf-c04d274d9b97",
                                        "entry_id": "1c3bdcdc-93ce-3252-84b6-2112862adf7e",
                                        "glosses": [
                                            "eine Gesellschaft/Gemeinschaft bilden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b332a8b6-1a3c-4224-80f3-eda48b86ea99",
                                                "sense_id": "eb55f9cb-42b7-34aa-abdf-c04d274d9b97",
                                                "text": "Soziologie beschäftigt sich mit denjenigen zwischenmenschlichen Vorgängen, durch die die Individuen sich vergesellschaften."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "edc0056d-cee8-31c7-b642-6b968d6e6d7d",
                                        "entry_id": "1c3bdcdc-93ce-3252-84b6-2112862adf7e",
                                        "glosses": [
                                            "sich in der Nähe von einander aufhalten/leben/wachsen/zeigen oder auch ein solches Zusammenleben fördern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b211fa-471a-4121-aabf-9edb3f48314e",
                                                "sense_id": "edc0056d-cee8-31c7-b642-6b968d6e6d7d",
                                                "text": "„Regenwaldbäume etwa vergesellschaften sich häufig mit Organismen, die Nährstoffe einfangen und rezyklieren.“"
                                            },
                                            {
                                                "example_id": "c118b447-91a6-4eb7-9c4b-1ac4fe1eac62",
                                                "sense_id": "edc0056d-cee8-31c7-b642-6b968d6e6d7d",
                                                "text": "„Sollen Kaninchen miteinander vergesellschaftet werden, dürfen sie keinesfalls sofort zusammen in einen Käfig gesetzt werden.“"
                                            },
                                            {
                                                "example_id": "8231c0f1-5f02-48a8-8cb3-fd4351de43b1",
                                                "sense_id": "edc0056d-cee8-31c7-b642-6b968d6e6d7d",
                                                "text": "„Die Regionalanästhesie war lediglich mit einer Reduktion postoperativer kognitiver Störungen vergesellschaftet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
