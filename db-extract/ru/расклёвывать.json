                        "translation_id": "ad99d464-80b6-49fb-8264-5770c372fea2",
                        "source_entry_id": "b11236b6-0987-376c-b249-fee522f412b2",
                        "source_sense_description": "клюя, поедать, растаскивать",
                        "target_lang_word": "aufpicken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufpicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb5ceafa-ff4d-322d-a9ed-5854bdbdb56b",
                                        "entry_id": "6afc1335-9df5-3d20-bcb7-564385dd8659",
                                        "glosses": [
                                            "etwas mit dem Schnabel pickend aufnehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23eece79-c40b-46e7-a2bb-941c3a4be918",
                                                "sense_id": "cb5ceafa-ff4d-322d-a9ed-5854bdbdb56b",
                                                "text": "Ein schwedischer Verhaltensforscher will wilde Krähen dazu bringen, weggeworfene Zigarettenstummel gegen Belohnung aufzupicken."
                                            },
                                            {
                                                "example_id": "e93c04f1-4299-43e2-9459-12faaf4e2c2a",
                                                "sense_id": "cb5ceafa-ff4d-322d-a9ed-5854bdbdb56b",
                                                "text": "Besonders bemerkenswert ist das Jagdverhalten des Kronenkranichs. Dabei stampft der Vogel auf den Boden, um seine Beute aufzuschrecken und, sobald sich diese bewegt, aufzupicken."
                                            },
                                            {
                                                "example_id": "0f9a6b0c-da46-4835-96fd-8cf15c2d409c",
                                                "sense_id": "cb5ceafa-ff4d-322d-a9ed-5854bdbdb56b",
                                                "text": "Die Nahrungspartikel werden mit dem Schnabel manipuliert und aufgepickt, was bis zu 15000 Pickbewegungen am Tag ausmachen kann (…)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8447668e-a2ff-3831-9906-4b05b3add063",
                                        "entry_id": "6afc1335-9df5-3d20-bcb7-564385dd8659",
                                        "glosses": [
                                            "etwas mit dem Schnabel hackend öffnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2805eb-ef04-4139-ad77-6ed24b71b34e",
                                                "sense_id": "8447668e-a2ff-3831-9906-4b05b3add063",
                                                "text": "Die innere Schalenhaut in der Luftkammer wird mit dem „Eizahn“, einem dornartigen Auswuchs am Oberschnabel durchstoßen, also von innen aufgepickt."
                                            },
                                            {
                                                "example_id": "77e6f726-c7cf-491d-8d96-385e96db81de",
                                                "sense_id": "8447668e-a2ff-3831-9906-4b05b3add063",
                                                "text": "Die ersten Küken, flauschige, dunkelbraune Knäuel, werden vorsichtig aus dem Karton gehoben und gestreichelt. Eines von ihnen hat sogar noch den Zahn, mit dem es die Schale aufgepickt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8039224c-9e4c-3bc5-8100-eee5a0170f0c",
                                        "entry_id": "6afc1335-9df5-3d20-bcb7-564385dd8659",
                                        "glosses": [
                                            "etwas auf etwas kleben"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af8e3ab-ec30-42cd-bc7b-0b3114c38987",
                                                "sense_id": "8039224c-9e4c-3bc5-8100-eee5a0170f0c",
                                                "text": "Ab 1. Oktober müssen Parkpickerl nicht mehr aufgepickt werden!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
