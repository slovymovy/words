                ],
                "senses": [
                    {
                        "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                        "entry_id": "85f0dd2c-6f21-3b01-baaa-a36574af4d6c",
                        "glosses": [
                            "Anbringen von Schneeketten bei einem Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce670fc-3f44-4333-b35d-85f7c6f69955",
                                "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                                "text": "„Die kleinste vom Fahrzeughersteller freigegebene Rad-/Reifenkombination eignet sich am besten für die Schneekettenmontage.“"
                            },
                            {
                                "example_id": "b94d2c6e-4b53-4573-9c49-a78ebd731b35",
                                "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                                "text": "„Bei der Schneekettenmontage kann zudem der Platz im Radkasten knapp werden.“"
                            },
                            {
                                "example_id": "a1e4ea8a-e6b7-4a4c-aeeb-1a4759827c7a",
                                "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                                "text": "„Vorderachse oder Hinterachse - das ist oft die Frage, wenn es um die richtige Achse zur Montage der Schneekette geht. […] Am besten ist hier ohnehin die Schneekettenmontage an allen Rädern.“"
                            },
                            {
                                "example_id": "acefc09c-e81c-4524-b53b-28e42a6b8068",
                                "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                                "text": "„Bei frontgetriebenen Wohnmobilen sind allerdings oft breitere Reifen aufgezogen, hier muss man darauf achten, ob der Chassis-Hersteller auf diesen Abmessungen eine Schneekettenmontage zulässt.“"
                            },
                            {
                                "example_id": "84137415-2bef-48a5-bb93-15e3157ca50a",
                                "sense_id": "7d81f7e0-2fa3-373e-ac71-fccde668abcd",
                                "text": "„Also Autowaschen, Reifenwechsel, Schneekettenmontage und die kleinen Reparaturen, die fast jeder Praktiker selbst vornimmt, sei es, weil sie während der Fahrt, wo kein Mechaniker in der Nähe ist, notwendig werden, oder weil man sich selbst mehr Sorgfalt und Gründlichkeit zutraut als den Mechanikerhilfskräften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
