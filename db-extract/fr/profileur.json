                ],
                "senses": [
                    {
                        "sense_id": "eabdb531-a030-3442-9871-ba8353a92d82",
                        "entry_id": "3042386d-33ec-3a6e-acff-dc5fc77fd320",
                        "glosses": [
                            "Celui qui fait le profilage psychologique d’un criminel inconnu pour faciliter son identification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f685f9ab-192f-4530-bf52-6c54a345513a",
                                "sense_id": "eabdb531-a030-3442-9871-ba8353a92d82",
                                "text": "Crimes en série met en scène les enquêtes policières du profileur Thomas Berthier."
                            },
                            {
                                "example_id": "380247ee-6e82-41e5-9b84-e5b810922934",
                                "sense_id": "eabdb531-a030-3442-9871-ba8353a92d82",
                                "text": "Des équipes régionales d’intervention et de sécurité (ERIS), unités chargées de la sécurité dans les établissements pénitentiaires dépendant du ministère de la Justice, venues de Strasbourg, ainsi que deux équipes du GIGN, des profileurs et des négociateurs ont participé à l’opération."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f27a96b-4703-34c1-85e3-ffc12a43ce3b",
                        "entry_id": "3042386d-33ec-3a6e-acff-dc5fc77fd320",
                        "glosses": [
                            "Celui qui conduit une profileuse, une machine à profiler, traçant le profil d’un ouvrage à l’aide de celle-ci."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e52a760-a79d-3cee-99b2-1b03f97b3bc3",
                        "entry_id": "3042386d-33ec-3a6e-acff-dc5fc77fd320",
                        "glosses": [
                            "Celui qui est chargé du profilage du client, de l’élaboration des profils types de consommateurs."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
