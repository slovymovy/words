                                    {
                                        "sense_id": "7b77e47e-5da7-30bf-adc0-a3f82a19a2d8",
                                        "entry_id": "f492188c-75fd-3e0b-aa00-7f3850ebaac0",
                                        "glosses": [
                                            "A state of the Northeast Region, Brazil. Capital: Recife."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pernambuco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b215708-11a7-3389-a428-d3e1e2ded510",
                                        "entry_id": "22b229af-25d3-35e9-ab53-e8989d4bb425",
                                        "glosses": [
                                            "The hard, reddish wood of a tree of the tribe Caesalpinieae, often used as dyewood; especially Paubrasilia echinata, used to make violin bows."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f89ebf6-0c5e-4164-84d4-0138b2ea63c2",
                                                "sense_id": "0b215708-11a7-3389-a428-d3e1e2ded510",
                                                "text": "When I annealed the bows over heat, the smell was quite different from the Pernambuco wood we are used to."
                                            },
                                            {
                                                "example_id": "3aca3d42-ee29-43a7-9e6b-cc12e641365c",
                                                "sense_id": "0b215708-11a7-3389-a428-d3e1e2ded510",
                                                "text": "[P]ernambucco – the finest brasil from Brazil, so strong it almost resembles iron – became the favoured material for good bows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70af4f9c-1147-462b-a1a0-4afdc47b68eb",
