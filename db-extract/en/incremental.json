                        "target_lang_word": "inkrementell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkrementell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c89fa0dc-0d41-3190-91da-a555a75a0708",
                                        "entry_id": "2f55e1ac-aaa6-38f6-886c-a767591c1cfa",
                                        "glosses": [
                                            "den schrittweisen Zuwachs betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f7f4d6-af71-47d6-a716-02cd06aa6f8d",
                                                "sense_id": "c89fa0dc-0d41-3190-91da-a555a75a0708",
                                                "text": "„Die neue Plattform basiert auf dem mit DirectX10 geschaffenen Fundament und wird wie schon zu Zeiten der Versionen 7, 8 und 9 inkrementell verbessert, aber nicht in ihren Grundlagen verändert.“"
                                            },
                                            {
                                                "example_id": "d60e2354-62ff-45b3-a15f-236ae7bdff3a",
                                                "sense_id": "c89fa0dc-0d41-3190-91da-a555a75a0708",
                                                "text": "„Es sichert ganze Platten oder nur Teile davon, auf Wunsch komplett oder inkrementell (also nur durch Austausch der veränderten Datenbereiche)“"
                                            },
                                            {
                                                "example_id": "8fa0f052-5b7c-474c-bb8b-5f93ba146564",
                                                "sense_id": "c89fa0dc-0d41-3190-91da-a555a75a0708",
                                                "text": "„Die wechselseitige Anpassung der Gruppen und inkrementelle Prozesse der Entscheidungsfindung wurden als bedeutende innovative Faktoren des politischen Lebens angesehen ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41bd591a-b1a1-4a53-879e-accf793b7331",
                        "source_entry_id": "f841c493-b9b5-3497-b318-4514ce26a806",
