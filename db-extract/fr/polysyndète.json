                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "deb0cbe2-5a78-443a-abde-2b80fa7a36e8",
                        "entry_id": "05229cd7-8f01-3679-9725-d433bd78f4ec",
                        "tags": [
                            "plural"
