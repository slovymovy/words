                        "glosses": [
                            "związany z Merowingami, dotyczący Merowingów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc14326-962d-4b8e-b10c-89c2f1d6ce90",
                                "sense_id": "49994150-a240-300d-8b19-0391fd75f8c2",
                                "text": ", s. 75, wyd. Iskry, Warszawa 2004.."
                            },
                            {
                                "example_id": "515b0730-2849-4338-8a5e-1c18a274143a",
                                "sense_id": "49994150-a240-300d-8b19-0391fd75f8c2",
                                "text": "Uznał on, że imię Piast oznacza piastuna, człowieka, który na dworze Popiela zajmował się wychowaniem jego synów, a zarazem pełnił funkcję porównywalną do majordomów w merowińskim królestwie Franków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
