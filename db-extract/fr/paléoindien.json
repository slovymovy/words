                    {
                        "sense_id": "e6df9f07-99bb-3514-8c58-20251e428021",
                        "entry_id": "332490a4-e292-36bf-8f8f-a6ed326e769d",
                        "glosses": [
                            "Relatif aux premiers habitants humains avérés du continent américain, ancêtres des actuels Autochtones d’Amérique."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "88d19454-6c10-43c7-846d-112891f0fc5f",
                                "sense_id": "e6df9f07-99bb-3514-8c58-20251e428021",
                                "text": "Tandis que le climat devient de moins contraignant et que la végétation colonise les terres fraîchement émergées, les groupes paléoindiens se régionalisent progressivement et s’adaptent à leur nouvel environnement."
                            },
                            {
                                "example_id": "3526ab5e-cdf7-43fd-bc39-8b6141094072",
                                "sense_id": "e6df9f07-99bb-3514-8c58-20251e428021",
                                "text": "C’est dans la revue que nous avons appris qu’il existait des sites très anciens au Québec, des sites associés à la période paléoindienne."
                            }
                        ]
                    }
                ],
