{
    "word_family": [
        "greed",
        "greedily",
        "greediness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d8c7001-3325-39fa-bc7f-908ac351ea65",
                    "sense_definition": "Wanting to eat or drink more than is necessary or polite.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>greedy</w> child ate all the cookies before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "<w>Жадный</w> ребёнок съел всё печенье до прихода гостей.",
                                "zh": "那个<w>贪吃</w>的孩子在客人到达之前就把饼干全吃光了。"
                            }
                        },
                        {
                            "text": "Don't be a <w>greedy</w> pig and leave some pizza for your brother.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>жадной</w> свиньёй и оставь немного пиццы брату.",
                                "zh": "别那么<w>贪吃</w>，给你的兄弟留点披萨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gluttonous",
                        "piggish",
                        "voracious"
                    ],
                    "common_phrases": [
                        "greedy eater",
                        "greedy pig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желающий съесть или выпить больше, чем необходимо или прилично.",
                        "zh": "指在饮食方面贪婪，不知节制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́дный",
                                "target_lang_sense_clarification": "до еды"
                            },
                            {
                                "target_lang_word": "ненасы́тный",
                                "target_lang_sense_clarification": "об аппетите"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贪吃",
                                "target_lang_sense_clarification": "形容人贪图食物"
                            },
                            {
                                "target_lang_word": "馋",
                                "target_lang_sense_clarification": "形容人贪嘴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91a7792e-5122-3a71-bdb8-1f4c7ffd7e60",
                    "sense_definition": "Having an excessive and selfish desire for something, especially money, wealth, or power.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>greedy</w> businessman wanted to buy every small shop in the town.",
                            "target_lang_translations": {
                                "ru": "<w>Жадный</w> бизнесмен хотел скупить все маленькие магазинчики в городе.",
                                "zh": "那个<w>贪婪</w>的商人想买下镇上的每一家小店。"
                            }
                        },
                        {
                            "text": "He became <w>greedy</w> for power and lost the trust of his friends.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>жадным</w> до власти и потерял доверие друзей.",
                                "zh": "他对权力变得<w>贪婪</w>，失去了朋友们的信任。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acquisitive",
                        "avaricious",
                        "covetous",
                        "grasping",
                        "rapacious",
                        "selfish"
                    ],
                    "common_phrases": [
                        "greedy for money",
                        "greedy for power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий чрезмерное и эгоистичное желание обладать чем-либо, особенно деньгами, богатством или властью.",
                        "zh": "指对金钱、财富或权力有过度且自私的欲望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́дный",
                                "target_lang_sense_clarification": "до денег, власти"
                            },
                            {
                                "target_lang_word": "а́лчный",
                                "target_lang_sense_clarification": "корыстолюбивый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贪婪",
                                "target_lang_sense_clarification": "形容对财物或权力不知满足"
                            },
                            {
                                "target_lang_word": "贪心",
                                "target_lang_sense_clarification": "形容欲望过大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2447ef2a-bf0f-3e2a-8b0f-abddbba73371",
                    "sense_definition": "Relating to an algorithm that makes the optimal choice at each small step to find the best overall solution.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>greedy</w> algorithm is often used to solve optimization problems quickly.",
                            "target_lang_translations": {
                                "ru": "<w>Жадный</w> алгоритм часто используется для быстрого решения задач оптимизации.",
                                "zh": "<w>贪心</w>算法常被用于快速解决优化问题。"
                            }
                        },
                        {
                            "text": "We applied a <w>greedy</w> approach, but it did not yield the most efficient result.",
                            "target_lang_translations": {
                                "ru": "Мы применили <w>жадный</w> подход, но он не дал наиболее эффективного результата.",
                                "zh": "我们采用了<w>贪心</w>策略，但并没有得到最高效的结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "greedy algorithm",
                        "greedy approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к алгоритму, который делает оптимальный выбор на каждом шаге для поиска лучшего общего решения.",
                        "zh": "指一种在每一步选择中都采取当前最优解的算法策略。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́дный",
                                "target_lang_sense_clarification": "алгоритм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贪心",
                                "target_lang_sense_clarification": "计算机算法术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc408bf-2ead-385f-bb59-ddb67315a9e8",
                    "sense_definition": "Describing a pattern matching process in computing that matches the longest possible string of text.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regular expression uses a <w>greedy</w> match by default.",
                            "target_lang_translations": {
                                "ru": "Регулярное выражение использует <w>жадное</w> совпадение по умолчанию.",
                                "zh": "该正则表达式默认使用<w>贪婪</w>匹配。"
                            }
                        },
                        {
                            "text": "You can switch to a nongreedy mode if the <w>greedy</w> quantifier captures too much text.",
                            "target_lang_translations": {
                                "ru": "Вы можете переключиться в нежадный режим, если <w>жадный</w> квантификатор захватывает слишком много текста.",
                                "zh": "如果<w>贪婪</w>量词捕获了过多的文本，你可以切换到非贪婪模式。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nongreedy"
                    ],
                    "common_phrases": [
                        "greedy match",
                        "greedy quantifier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий процесс сопоставления шаблонов в информатике, который захватывает максимально возможную строку текста.",
                        "zh": "指在模式匹配中尽可能匹配最长字符串的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́дный",
                                "target_lang_sense_clarification": "квантификатор, поиск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贪婪",
                                "target_lang_sense_clarification": "正则表达式匹配模式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}