                "senses": [
                    {
                        "sense_id": "5544759b-3551-3899-9d39-7b094d33d0a4",
                        "entry_id": "eb093744-7e5f-33c7-a776-8dd8334c7bd3",
                        "glosses": [
                            "интернет. веб-конференция, телеконференция"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881b1b5f-f972-416a-b09c-81fdc8c4fdfb",
                                "sense_id": "5544759b-3551-3899-9d39-7b094d33d0a4",
                                "text": "Будут воросы пиши на мыло (в конфе бываю редко)."
                            },
                            {
                                "example_id": "62000699-caa6-411f-8df2-1da3b2402346",
                                "sense_id": "5544759b-3551-3899-9d39-7b094d33d0a4",
                                "text": "В день проведения семинара кинем сюда ссылку на конфу в зуме."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d0559fb-af9a-37f2-94ae-33cda589ef5a",
                        "entry_id": "eb093744-7e5f-33c7-a776-8dd8334c7bd3",
                        "glosses": [
                            "разг. то же, что конференция"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d59bb3-e713-4961-b979-6f42f05ed017",
                                "sense_id": "1d0559fb-af9a-37f2-94ae-33cda589ef5a",
                                "text": "Они этот нетворкинг собирают на конфах, а конф теперь нет."
                            }
                        ]
                    }
