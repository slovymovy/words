                            }
                        ]
                    },
                    {
                        "translation_id": "1c680187-403b-403c-bc4b-8960dccf5773",
                        "source_entry_id": "9d81a2ae-251d-368b-af49-20168794b366",
                        "target_lang_word": "wage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56e2de05-6240-3cc4-877b-767d022ab041",
                                        "entry_id": "64c072e3-300d-3045-b6b9-bb483beda882",
                                        "glosses": [
                                            "An amount of money paid to a worker for a specified quantity of work, usually calculated on an hourly basis and expressed in an amount of money per hour."
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e085c8f-edb7-4b61-86b6-8aa438bf7475",
                                                "sense_id": "56e2de05-6240-3cc4-877b-767d022ab041",
                                                "text": "Before her promotion, her wages were 20% less."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb09b65-4111-3694-aea2-a71983bc1eb1",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To wager, bet."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4df280-49c0-4a3f-89d1-3a1059bbb2d6",
                                                "sense_id": "dcb09b65-4111-3694-aea2-a71983bc1eb1",
                                                "text": "My life I never held but as a pawn / To wage against thine enemies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c32d97-11d4-30d7-89c6-3bda98fd7934",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To expose oneself to, as a risk; to incur, as a danger; to venture; to hazard."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c91e2b-e554-4d6a-a839-80521f5fca4d",
                                                "sense_id": "59c32d97-11d4-30d7-89c6-3bda98fd7934",
                                                "text": "I fear the power of Percy is too weak / To wage an instant trial with the King."
                                            },
                                            {
                                                "example_id": "b28e54a4-7c5e-46cc-8f05-0a6886c37e59",
                                                "sense_id": "59c32d97-11d4-30d7-89c6-3bda98fd7934",
                                                "text": "to wake and wage a danger profitless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12dc46c1-8fb9-3a96-94cf-ba8cf7e92e27",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To employ for wages; to hire."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d59a1e1-5b9d-49dc-a756-7a5d8d2441e6",
                                                "sense_id": "12dc46c1-8fb9-3a96-94cf-ba8cf7e92e27",
                                                "text": "Thenne said Arthur I wille goo with yow / Nay said the kynges ye shalle not at this tyme / for ye haue moche to doo yet in these landes / therfore we wille departe / and with the grete goodes that we haue goten in these landes by youre yeftes we shalle wage good knyghtes & withstande the kynge Claudas malyce"
                                            },
                                            {
                                                "example_id": "ec008bfe-4da4-4fd6-976a-adef954f3291",
                                                "sense_id": "12dc46c1-8fb9-3a96-94cf-ba8cf7e92e27",
                                                "text": "[B]etter it as for him to trie the vttermoſt pointe of fortunes happe, than with diſhonour ſo to yeelde at the firſt blow of hyr frowarde hande, conſidering the abundance of treaſure whiche he had in ſtore, wherewith hee might wage ſouldiers and menne of warre out of Germanie and other places, in number ſufficient to matche with his enimies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96943ef-8afa-3ed5-823b-d58ef07f3f87",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To conduct or carry out (a war or other contest)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3091b9a4-f1dc-4614-9828-fff0f64de6c7",
                                                "sense_id": "c96943ef-8afa-3ed5-823b-d58ef07f3f87",
                                                "text": "Setting our sights back on King’s Landing, where the Last War will be waged, makes a lot of sense, even if it does feel a bit anticlimactic after last week’s deadly, blustery maelstrom."
                                            },
                                            {
                                                "example_id": "1608a6fa-c9ad-4733-9a66-14475f4b004e",
                                                "sense_id": "c96943ef-8afa-3ed5-823b-d58ef07f3f87",
                                                "text": "pond'ring which of all his Sons was fit / To Reign, and wage immortal War with Wit"
                                            },
                                            {
                                                "example_id": "e8e678d2-e422-47bd-b08c-ddd0ba4738f1",
                                                "sense_id": "c96943ef-8afa-3ed5-823b-d58ef07f3f87",
                                                "text": "The two are waging war, and the one triumphs by the destruction of the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83762bd1-cb3e-33ff-9ba2-3a7b2889710f",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To adventure, or lay out, for hire or reward; to hire out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa80d5ff-92cd-435d-ae66-cbbb2512239e",
                                                "sense_id": "83762bd1-cb3e-33ff-9ba2-3a7b2889710f",
                                                "text": "Thou that doest liue in later times, must wage / Thy workes for wealth, and life for gold engage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0701cda8-a53b-31b5-9699-2ddda631200c",
                                        "entry_id": "51021a4a-71bb-30c0-9f29-88fa12a4b47c",
                                        "glosses": [
                                            "To give security for the performance of."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
