            "senses": [
                {
                    "sense_id": "91547cbe-9923-3262-95d3-f1f4b0eb3c29",
                    "sense_definition": "Disposition à entreprendre des actions difficiles ou risquées sans craindre le danger ou l'échec.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "courage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a fait preuve d'<w>audace</w> en décidant de lancer sa propre entreprise innovante."
                        },
                        {
                            "text": "Le jeune chef a surpris les critiques avec l'<w>audace</w> de ses nouvelles créations culinaires."
                        }
                    ],
                    "synonyms": [
                        "hardiesse"
                    ],
                    "antonyms": [
                        "lâcheté",
                        "peur",
                        "timidité"
                    ],
                    "common_phrases": [
                        "faire preuve d'audace",
                        "avec audace",
                        "manquer d'audace"
                    ]
                },
                {
                    "sense_id": "d1c49dbc-7d87-3808-a635-b94a4ce56e68",
                    "sense_definition": "Hardiesse excessive qui dépasse les limites de la bienséance, du respect ou de la politesse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insolence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu l'<w>audace</w> de mentir à ses collègues droit dans les yeux sans rougir."
                        },
                        {
                            "text": "Quelle <w>audace</w> de critiquer ce travail alors que tu n'as rien fait pour aider !"
                        }
                    ],
                    "synonyms": [
                        "aplomb",
                        "culot",
                        "effronterie",
                        "impertinence",
                        "impudence",
                        "insolence",
                        "outrecuidance",
                        "toupet"
                    ],
                    "antonyms": [
                        "déférence",
                        "politesse",
                        "respect",
                        "retenue"
                    ],
                    "common_phrases": [
                        "avoir l'audace de",
                        "quelle audace"
                    ]
                },
                {
                    "sense_id": "55a552da-0700-322c-83b4-8aeabf23fa68",
                    "sense_definition": "Ganse utilisée au XVIIe siècle pour relever les bords d'un chapeau masculin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chapeau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gentilhomme ajustait l'<w>audace</w> de son chapeau avant d'entrer dans la salle d'armes."
                        },
                        {
                            "text": "Cette fine <w>audace</w> en soie noire permettait de donner un style plus martial au feutre."
