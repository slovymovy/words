                    {
                        "translation_id": "795c3b02-33ad-4c45-a97e-5e703e4b0a82",
                        "source_entry_id": "a618bbc9-0310-3de1-b63f-9ec60ed1ce2a",
                        "source_sense_description": "the court system, inclusive of clerical staff, etc.",
                        "target_lang_word": "Gerichtswesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerichtswesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bef231a1-b509-3c67-ab6c-370da2b0a1a2",
                                        "entry_id": "8df4a77b-659a-392e-aa91-7ed58eb011cd",
                                        "glosses": [
                                            "Gesamtheit aller materiellen Voraussetzungen und aller Regelungen, die für die Arbeit von Gerichten nötig sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6cc7683-8cc0-43c7-98fe-3b3b0539a457",
                                                "sense_id": "bef231a1-b509-3c67-ab6c-370da2b0a1a2",
                                                "text": "„Arnaei Rapporte über die Zustände auf Island gleichwie seine vorgeschlagenen Reformen betreffend Handel, Gewerbe, Gerichtswesen und Verwaltung des Landes hatten in der Königlichen Kanzlei kühle Aufnahme gefunden; es ist zweifelhaft, ob sie überhaupt gelesen worden waren.“"
                                            },
                                            {
                                                "example_id": "a67739e1-1e34-4ee9-aea5-ceb32ac5662c",
                                                "sense_id": "bef231a1-b509-3c67-ab6c-370da2b0a1a2",
                                                "text": "„Bereits unter Hastings hatte nicht nur eine Konsolidierung der Territorialverwaltung, sondern auch eine rasche Verbreitung des britischen Gerichtswesens in Indien stattgefunden.“"
                                            },
                                            {
                                                "example_id": "16930e55-c1c2-4860-a859-fdca5e4d2305",
                                                "sense_id": "bef231a1-b509-3c67-ab6c-370da2b0a1a2",
                                                "text": "„Indessen lähmten die unzähligen Verleumdungsklagen gegen Autor, Herausgeber und Drucker von Simon Balcairns letztem Artikel beinahe das Gerichtswesen des ganzen Landes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6afad1b-8775-4fad-8659-f15ca149b81e",
                        "source_entry_id": "a618bbc9-0310-3de1-b63f-9ec60ed1ce2a",
                        "source_sense_description": "the court system, inclusive of clerical staff, etc.",
                        "target_lang_word": "Rechtswesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtswesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc306613-17f6-3fdf-8194-74df3d1ebe9f",
                                        "entry_id": "874d798d-afff-36fd-ac80-b66e34c1649e",
                                        "glosses": [
                                            "Gesamtheit des organisatorischen Systems der Justizorgane und anderer juristischer Organisationen sowie deren Aufgaben, Aktivitäten und Arbeitsweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3789af07-5836-4d21-9ed5-e89c22813a59",
                                                "sense_id": "fc306613-17f6-3fdf-8194-74df3d1ebe9f",
                                                "text": "Damit ist es der Regierung gestattet, Rechtswesen und Rohstoffverwaltung unabhängig von Dänemark zu regeln – und auch die zu erwartenden Einnahmen aus dem Rohstoffgeschäft zu behalten."
                                            },
                                            {
                                                "example_id": "a2dab4b0-a808-4624-80f2-f2ff3b432b25",
                                                "sense_id": "fc306613-17f6-3fdf-8194-74df3d1ebe9f",
                                                "text": "Die eilfertigsten HelferInnen [sic] dieser Kräfte sind heute oft KonvertitInnen [sic], und das in allen Lebensbereichen: an Universitäten, im Rechtswesen wie in den Medien."
                                            },
                                            {
                                                "example_id": "ec2f1315-cc9b-4c19-895f-2c8770dfa4ec",
                                                "sense_id": "fc306613-17f6-3fdf-8194-74df3d1ebe9f",
                                                "text": "Das Gemeinwesen besteht nicht nur aus dem Rechtswesen, sondern aus vielen freien Beziehungen, in denen das Bürgerliche Gesetzbuch oder das Strafgesetzbuch die meiste Zeit keine Rolle spielen."
                                            },
                                            {
                                                "example_id": "4e0b00cb-8576-4530-aa08-b217990d198d",
                                                "sense_id": "fc306613-17f6-3fdf-8194-74df3d1ebe9f",
                                                "text": "Der Aufwand für die Bürokratie und das Rechtswesen war dabei erheblich, zum Teil höher als der durch die Enteignung erzielte \"Gewinn\", und zwar nicht zuletzt deshalb, weil das Dollfuß/ Schuschnigg-Regime auf den Anschein der Legalität Wert legte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6c6902-c87f-4e6e-833d-ac022aa0a471",
                        "source_entry_id": "a618bbc9-0310-3de1-b63f-9ec60ed1ce2a",
