                "senses": [
                    {
                        "sense_id": "47ec5ada-3e38-3d01-9dcd-7f6cf9eb2f65",
                        "entry_id": "f002155e-c642-34b9-85ee-fed2115791f2",
                        "glosses": [
                            "To speak boastfully."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6ecc62e0-bacf-4c48-b951-20a017053d3f",
                                "sense_id": "47ec5ada-3e38-3d01-9dcd-7f6cf9eb2f65",
                                "text": "\"The number,\" said he, \"is great, but what can be expected from mere citizen soldiers? They vaunt and menace in time of safety; none are so arrogant when the enemy is at a distance; but when the din of war thunders at the gates they hide themselves in terror.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e899c2f8-963d-324d-ab90-c8cfa605e245",
                        "entry_id": "f002155e-c642-34b9-85ee-fed2115791f2",
                        "glosses": [
                            "To speak boastfully about."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7dff2cc6-700e-30c3-9dfd-9ea49ffe2900",
                        "entry_id": "f002155e-c642-34b9-85ee-fed2115791f2",
                        "glosses": [
                            "To boast of; to make a vain display of; to display with ostentation."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bdf244e8-0883-4081-a386-aa0fd133b970",
                                "sense_id": "7dff2cc6-700e-30c3-9dfd-9ea49ffe2900",
                                "text": "Charity vaunteth not itself, is not puffed up."
                            },
                            {
                                "example_id": "2e4a456b-3f97-4093-b44a-a5367539ff24",
                                "sense_id": "7dff2cc6-700e-30c3-9dfd-9ea49ffe2900",
                                "text": "My vanquisher, spoiled of his vaunted spoil."
                            }
                        ]
                    }
                ],
