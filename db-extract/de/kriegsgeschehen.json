                ],
                "senses": [
                    {
                        "sense_id": "b6c70caf-e910-3cf0-81a3-6e8129ba0a34",
                        "entry_id": "455d2bfe-da13-3d7a-9cf1-4ed632ef1765",
                        "glosses": [
                            "Gesamtheit der Ereignisse im Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a04b8d-ccff-43ff-8c39-03b4f4487ebf",
                                "sense_id": "b6c70caf-e910-3cf0-81a3-6e8129ba0a34",
                                "text": "„Mit Sorgen und Resignation verfolgt Remarque in diesen Monaten das Kriegsgeschehen, das die Zeitungen, Radionachrichten und auch die Gespräche der Exilanten beherrscht.“"
                            },
                            {
                                "example_id": "4f95e231-98e8-4447-93af-3d2996863fbb",
                                "sense_id": "b6c70caf-e910-3cf0-81a3-6e8129ba0a34",
                                "text": "„Vom Zweiten Weltkrieg war Mugabe kaum betroffen, denn Rhodesien lag weit entfernt vom Kriegsgeschehen.“"
                            },
                            {
                                "example_id": "f89985d8-d772-4f97-b21f-a1db553365f1",
                                "sense_id": "b6c70caf-e910-3cf0-81a3-6e8129ba0a34",
                                "text": "[Schneidemühl, Sommer 1914:] „So wird das Kriegsgeschehen selbst zum Bestandteil des Unterrichts, in den Klassenzimmern hängen bald Landkarten, auf denen den verblüfften Kindern der aktuelle Frontverlauf geschildert wird.“"
                            },
                            {
                                "example_id": "fae5fc93-8b40-4502-b5d1-7f1eed94de6b",
                                "sense_id": "b6c70caf-e910-3cf0-81a3-6e8129ba0a34",
                                "text": "„Bisher war den Götzlackern das Kriegsgeschehen nur ans Ohr gedrungen; es war nah, aber es hatte sie nicht unmittelbar bedroht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
