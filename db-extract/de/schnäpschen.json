                "senses": [
                    {
                        "sense_id": "323bb7e7-cf5d-39ef-a418-415e24809690",
                        "entry_id": "56b8c86c-7674-3d0d-808c-582f097b02d3",
                        "glosses": [
                            "kleiner Schnaps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10984871-f49a-44e6-9a44-ea7bf7f8c63d",
                                "sense_id": "323bb7e7-cf5d-39ef-a418-415e24809690",
                                "text": "„Gleich am ersten Abend nahm ich ein Bad, wonach wir ein schmackhaftes Abendessen verzehrten, mit einem Schnäpschen begossen, was mir meine Leber leider verübelte.“"
                            },
                            {
                                "example_id": "d0ff3f03-8015-401e-9f2a-b4d3a1617b90",
                                "sense_id": "323bb7e7-cf5d-39ef-a418-415e24809690",
                                "text": "„Der versichert, es gefalle ihm ausgezeichnet, mich abends auf ihrem kleinen Platz mit einem Glas Wein, einem Schnäpschen und einer Zigarette sitzen und in einem Buch lesen zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
