                "senses": [
                    {
                        "sense_id": "7b0c031d-f662-3350-bb9d-8be453d355f8",
                        "entry_id": "fc4cf32a-cacf-3e6e-94b0-81659afa1af9",
                        "glosses": [
                            "разг. женск. к баловник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe031895-de97-4a45-8582-ece7c9c642ba",
                                "sense_id": "7b0c031d-f662-3350-bb9d-8be453d355f8",
                                "text": "Это против Юлии-то Михайловны, против ихней-то баловницы, покровительницы, прощавшей им без пути все их школьничества?"
                            },
                            {
                                "example_id": "3f8dcd22-a49c-4927-8d45-4ddc4c8d9481",
                                "sense_id": "7b0c031d-f662-3350-bb9d-8be453d355f8",
                                "text": "И к необыкновенной изобразительной способности Лермонтова, в которой так счастливо и чудно сплелись разнородные таланты, баловница природа прибавила еще дар могучего воображения и быстрой мысли."
                            }
                        ]
                    }
