                },
                {
                    "sense_id": "88b122d2-943e-3c88-8064-c884e10b19f7",
                    "sense_definition": "Relating to the scientific study of the interrelationships of organisms and their environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ecological</w> balance of the lake was disturbed by the introduction of invasive species.",
                            "target_lang_translations": {
