                                "example_id": "3552ed25-9dd2-4153-bdef-57c5ba0da395",
                                "sense_id": "2a6469ab-f3c6-38a7-9145-4094cdc1cff7",
                                "text": "\"Overal hingen touwtjes uit de brievenbussen. De kinderen konden gewoon de voordeur opentrekken en bij elkaar binnenlopen. Volwassenen ook. We vertrouwden mekaar.\""
                            },
                            {
                                "example_id": "72efe6f7-264c-4f19-91c5-2c8c91c4cb82",
                                "sense_id": "2a6469ab-f3c6-38a7-9145-4094cdc1cff7",
                                "text": "Iemand met paranoïde dwanggedachten had het gebouw in paniek bij mekaar geschreeuwd."
                            }
                        ]
                    }
