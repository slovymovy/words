                                        "sense_id": "170bb64d-9c3a-3319-8adb-820f89a69044",
                                        "entry_id": "03135c86-93ca-3ea7-a5ef-dc2840e4d26d",
                                        "glosses": [
                                            "etwas in Ordnung bringen, (figürlich) etwas wieder gerade biegen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab030e1-9101-4ab6-942a-da87c8d71db9",
                                                "sense_id": "170bb64d-9c3a-3319-8adb-820f89a69044",
                                                "text": "„Das Lied Der Papa wird's schon richten (Text und Musik von Gerhard Bronner, bekannteste Gesangsversion von Helmut Qualtinger) ist eine kritische Kabarettnummer aus dem Jahr 1958, deren Titel in Österreich als Synonym für Protektions- und Vetternwirtschaft sprichwörtlich geworden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4fb059ad-e476-3ed1-97d6-08ffdd7975d9",
                                        "entry_id": "03135c86-93ca-3ea7-a5ef-dc2840e4d26d",
                                        "glosses": [
                                            "etwas zubereiten, vorbereiten"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d6d590d-e0e8-4696-a97f-c83f82248396",
                                                "sense_id": "4fb059ad-e476-3ed1-97d6-08ffdd7975d9",
                                                "text": "Wie richtet man am besten das Bett, wenn der Kranke nicht aufstehen kann?"
                                            },
                                            {
                                                "example_id": "89364494-306a-4710-a2cf-2c9ed7435eb1",
                                                "sense_id": "4fb059ad-e476-3ed1-97d6-08ffdd7975d9",
                                                "text": "Liselotte richtet das Abendessen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a597918c-f98e-337c-8380-1acb7a83befc",
                                        "entry_id": "03135c86-93ca-3ea7-a5ef-dc2840e4d26d",
                                        "glosses": [
                                            "ein Urteil über jemanden fällen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d00f935-1f56-40ee-9b5c-6e03ff33603f",
                                                "sense_id": "a597918c-f98e-337c-8380-1acb7a83befc",
                                                "text": "„Die zweite Stelle steht im Schlusskapitel der Bergpredigt und folgt dort Jesu Gebot ‚Richtet nicht, damit ihr nicht gerichtet werdet‘ (Mt 7,1) und seiner Lehre zum Gebet (Mt 7,7–11 EU).“"
