                "senses": [
                    {
                        "sense_id": "43e9ce15-6632-3529-8bf2-80fca7f6cebb",
                        "entry_id": "bf4687df-1d82-3ff9-a40b-f30aa3487525",
                        "glosses": [
                            "A female given name originating as a coinage [in turn from Latin]."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce7ea367-203f-41fb-9da6-d93d7a2393d2",
                                "sense_id": "43e9ce15-6632-3529-8bf2-80fca7f6cebb",
                                "text": "Admir'd Miranda!\nIndeed, the top of admiration; worth\nWhat's dearest in the world!"
                            },
                            {
                                "example_id": "2a300d38-6d13-40c1-835d-7cef00ad2e1d",
                                "sense_id": "43e9ce15-6632-3529-8bf2-80fca7f6cebb",
                                "text": "Miranda Guzman alleges that the state’s vaccine mandate violates a 2023 West Virginia law that stipulates the government would not be able to “substantially burden” someone’s constitutional right to freedom of religion unless doing so “is essential to further a compelling governmental interest.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "93f568b2-703f-30b1-91f0-4bf944522bb6",
                        "entry_id": "bf4687df-1d82-3ff9-a40b-f30aa3487525",
                        "glosses": [
                            "One of the moons of the planet of Uranus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06da5c7c-94c7-4089-b27f-b448add49751",
                                "sense_id": "93f568b2-703f-30b1-91f0-4bf944522bb6",
                                "text": "When Red Dwarf had stopped for supplies at Miranda, he'd spent the last afternoon of his three-day ship leave and all his wages buying the smallest, healthiest animal with the best pedigree he could find."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d512f4f-6196-3c7a-9709-4562d7e58c5a",
                        "entry_id": "bf4687df-1d82-3ff9-a40b-f30aa3487525",
                        "glosses": [
                            "A census-designated place in Humboldt County, California, United States."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07432f35-e060-4958-95ee-eee8624706b4",
                        "source_entry_id": "bf4687df-1d82-3ff9-a40b-f30aa3487525",
                        "source_sense_description": "female name",
                        "target_lang_word": "Мира́нда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Мира́нда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf5321a-bb7c-3d5b-8c39-90ba3016e83a",
                                        "entry_id": "73c8a057-46c7-3de1-acaf-a461465627c9",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52ddba71-d20e-4f8d-ad62-8e9abc4dc1b8",
                                                "sense_id": "8bf5321a-bb7c-3d5b-8c39-90ba3016e83a",
                                                "text": "Мария… Миранда… Мирэй… ― ей достаточно было быть собой, чтобы быть ― всеми .."
                                            },
                                            {
                                                "example_id": "768c567a-bf48-4117-b239-92d373e4eb1b",
                                                "sense_id": "8bf5321a-bb7c-3d5b-8c39-90ba3016e83a",
                                                "text": "В ролях: Николь Кидман, Джулианн Мур, Мерил Стрип, Миранда Ричардсон, Эд Харрис, Джон Си Рейли, Стивен Диллейн и другие."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Мира́нда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45a23729-7b02-3a93-b105-f42c6fe7a18e",
                                        "entry_id": "6598d79c-5477-3ae7-8c0c-bef3f2bebb9f",
                                        "glosses": [
                                            "фамилия"
                                        ],
                                        "tags": [],
