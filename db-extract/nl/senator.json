                "translations": [
                    {
                        "translation_id": "72a8619e-93cb-4cc6-bf56-7e66aa7151d2",
                        "source_entry_id": "6681ce51-a0dc-3bae-b246-27a6ffbdc13d",
                        "source_sense_id": "15cd6db9-32e7-307e-983c-dd0c56eaedb6",
                        "target_lang_word": "senator",
