                                "target_senses": [
                                    {
                                        "sense_id": "459cad3f-a879-3ab2-8331-eb5a1188eeac",
                                        "entry_id": "1f6dd447-f60e-3f77-b6c1-b6baa6bfa41d",
                                        "glosses": [
                                            "niet geloven, in de godsdienstige zin het niet geloven in een opperwezen."
                                        ],
                                        "tags": [],
