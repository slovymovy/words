                "senses": [
                    {
                        "sense_id": "a69df62f-ff8e-3ad3-aca6-dbdc3e2c1bba",
                        "entry_id": "006a912f-75fb-3a48-b4b5-e6005dbc485a",
                        "glosses": [
                            "Umstand, jemandem sexuell hörig zu sein"
