                        "entry_id": "5a03575a-6a69-32b9-a265-13ca5f242ba9",
                        "glosses": [
                            "Dreckkehrer, Journalist oder Schriftsteller, der wirkliche oder unterstellte Korruptionsfälle in der Politik und in der Geschäftswelt anprangert und reißerisch veröffentlicht; deckt Skandale auf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2161f03-45b6-4594-9978-99b0ef36d0b9",
                                "sense_id": "f0d1e536-0274-3188-9747-03aa890b5336",
                                "text": "Knorrig, knatschig, kriegerisch: Hersh ist das Relikt einer untergegangenen Ära des US-Journalismus - der Ära der \"Muckrakers\", die die Mächtigen entblößen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
