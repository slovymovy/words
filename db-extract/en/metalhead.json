                    {
                        "translation_id": "1c043b1c-d2d8-46e9-8e5c-45ca3c6d861a",
                        "source_entry_id": "919006bd-f730-3d74-ae7a-7404cd96cf4a",
                        "source_sense_id": "c8c1356e-e390-317e-8195-8d42531bf824",
                        "source_sense_description": "one who listens to (is a fan of) heavy metal music",
                        "target_lang_word": "metalowiec",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metalowiec",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "eb46796b-ac11-38e5-945e-94c3ad4dd6ed",
                                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                                        "glosses": [
                                            "osoba pracująca w przemyśle metalowym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98cf4db9-b988-4bf3-af5c-5dc4d9259b15",
                                                "sense_id": "eb46796b-ac11-38e5-945e-94c3ad4dd6ed",
                                                "text": "Świerczewski uczęszczał do szkoły powszechnej, w której skończył dwie klasy. Wraz z ojcem podjął naukę tokarstwa metali, a po jego śmierci w 1912 pracował w warszawskich zakładach Gerlacha jako pomocnik tokarza i tokarz metalowiec"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7026e359-560a-31c9-8d8a-8e9437d32797",
                                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                                        "glosses": [
                                            "muzyk wykonujący muzykę rockową w jej odmianach nazywanych metalem (np. heavy metal, death metal, black metal, doom metal itd.)"
                                        ],
                                        "tags": [
                                            "środ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a078d93c-dff9-4ba3-9829-d22025a44f0b",
                                                "sense_id": "7026e359-560a-31c9-8d8a-8e9437d32797",
                                                "text": "Liczyła na to, że po koncercie pozna któregoś z metalowców."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "52f82bd2-88f2-351a-8040-53d3cc4bbd7f",
                                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                                        "glosses": [
                                            "członek subkultury skupiającej się wokół środowiska związanego z heavy metalem i jego odmianami"
                                        ],
                                        "tags": [
                                            "środ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad43db86-3898-4785-9add-300b25e47a6b",
                                                "sense_id": "52f82bd2-88f2-351a-8040-53d3cc4bbd7f",
                                                "text": "Klasyczny styl metalowców, spotykany powszechnie od lat 80. XX wieku, to długie włosy, dżinsowe spodnie, glany, katany (często z naszywkami ulubionych zespołów), skórzane kurtki, „ramoneski”, na które często nakłada się dżinsowe kamizelki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "6bde1902-6a96-3131-92f4-e387d4b09911",
                                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                                        "glosses": [
                                            "wielbiciel muzyki nazywanej metalem"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "youth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144391d2-c182-4375-990f-c6a69ae73c7d",
                                                "sense_id": "6bde1902-6a96-3131-92f4-e387d4b09911",
                                                "text": "Pamiętam nieformalną „wojnę” między depeszowcami a metalowcami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6de3dada-359d-49ea-8193-2e686b3f6980",
                        "source_entry_id": "919006bd-f730-3d74-ae7a-7404cd96cf4a",
                        "source_sense_id": "c8c1356e-e390-317e-8195-8d42531bf824",
                        "source_sense_description": "one who listens to (is a fan of) heavy metal music",
                        "target_lang_word": "металли́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "металли́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "рабочий металлообрабатывающей промышленности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f213879-cff6-4501-8dd0-7f1d440d569b",
                                                "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                                "text": "На лице старого рабочего-металлиста, сидящего на табурете с паяльником в одной руке, с медной трубкой в другой, были написаны усердие, выдержка, уверенность в себе, торжество, любование своей работой и сдержанный восторг перед собственным мастерством."
                                            },
                                            {
                                                "example_id": "d52cbe34-a41a-4aea-91a5-ea9873b1e748",
                                                "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                                "text": "― Кончу семилетку, поступлю в фабзавуч. Буду металлистом, настоящим рабочим. Меня в комсомол и без кандидатского стажа примут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d241d1-6008-342b-b2a9-1e21fcd186c9",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "специалист по металлам, металловедению"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "исполнитель или поклонник металлического рока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2de4fbc-e467-4ca5-b631-44f0d264bcbd",
                                                "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                                "text": "Когда я тусовалась с рокерами, с металлистами, как ни старалась, не могла принять их культ силы, исключительной личности."
                                            },
                                            {
                                                "example_id": "df0aa13b-b083-4799-a3d1-1571ea53a043",
                                                "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                                "text": "Кто-то из «старых» видел однажды в клубе металлиста с Космонавтов: с цепями, браслетами и прочей ерундой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
