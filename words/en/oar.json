{
    "word_family": [
        "oarsman",
        "oarsmanship",
        "oared"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62b6c481-47b2-3d27-8a21-37213045b367",
                    "sense_definition": "A long pole with a flat blade at one end, used as a lever to row or steer a boat through water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rowing_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost his grip on the <w>oar</w> and it slipped into the lake.",
                            "target_lang_translations": {
                                "ru": "Он упустил <w>весло</w>, и оно соскользнуло в озеро."
                            }
                        },
                        {
                            "text": "We need a spare <w>oar</w> in case one of them breaks during the trip.",
                            "target_lang_translations": {
                                "ru": "Нам нужно запасное <w>весло</w> на случай, если одно из них сломается во время поездки."
                            }
                        }
                    ],
                    "synonyms": [
                        "paddle"
                    ],
                    "common_phrases": [
                        "spare oar",
                        "pull an oar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный шест с плоской лопастью на конце, используемый в качестве рычага для гребли или управления лодкой на воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весло",
                                "target_lang_sense_clarification": "приспособление для гребли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cbf530a-97cf-3822-8f5c-bd1d9cf83ebd",
                    "sense_definition": "A person who rows a boat; a rower.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rowing_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is considered the strongest <w>oar</w> in the university's rowing team.",
                            "target_lang_translations": {
                                "ru": "Она считается сильнейшим <w>гребцом</w> в университетской команде по гребле."
                            }
                        },
                        {
                            "text": "The coach selected each <w>oar</w> carefully to ensure perfect synchronization.",
                            "target_lang_translations": {
                                "ru": "Тренер тщательно отбирал каждого <w>гребца</w>, чтобы обеспечить идеальную синхронность."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который гребет на лодке; гребец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребец",
                                "target_lang_sense_clarification": "спортсмен или человек на веслах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45c94446-ebb6-32e9-8ba5-06551cc42fdd",
                    "sense_definition": "An oar-like swimming organ or appendage of various invertebrates.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological_appendages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aquatic insect uses its modified hind legs as an <w>oar</w> to propel itself through the pond.",
                            "target_lang_translations": {
                                "ru": "Водное насекомое использует свои видоизмененные задние ноги как <w>весла</w>, чтобы передвигаться по пруду."
                            }
                        },
                        {
                            "text": "Each swimming <w>oar</w> of the crustacean is fringed with fine hairs to push water efficiently.",
                            "target_lang_translations": {
                                "ru": "Каждая плавательная <w>ножка</w> ракообразного окаймлена тонкими волосками для эффективного отталкивания воды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Похожий на весло плавательный орган или придаток у различных беспозвоночных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавательная ножка",
                                "target_lang_sense_clarification": "у беспозвоночных"
                            },
                            {
                                "target_lang_word": "весло",
                                "target_lang_sense_clarification": "в биологическом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72283b32-f39a-3ee1-aa4a-05a372dc9dbb",
                    "sense_definition": "Initialism of original aspect ratio.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "media_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Film enthusiasts prefer watching movies in their <w>OAR</w> rather than cropped versions.",
                            "target_lang_translations": {
                                "ru": "Любители кино предпочитают смотреть фильмы в их <w>оригинальном формате</w>, а не в обрезанных версиях."
                            }
                        },
                        {
                            "text": "The blu-ray release preserves the <w>OAR</w> of the classic film.",
                            "target_lang_translations": {
                                "ru": "Релиз на Blu-ray сохраняет <w>оригинальное соотношение сторон</w> классического фильма."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от original aspect ratio (оригинальное соотношение сторон экрана)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оригинальное соотношение сторон",
                                "target_lang_sense_clarification": "в кинематографе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "678b38ef-18e5-36b0-ba38-f894a3800e6a",
                    "sense_definition": "To row; to travel with, or as if with, oars.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They began to <w>oar</w> their way across the calm waters of the bay.",
                            "target_lang_translations": {
                                "ru": "Они начали <w>грести</w> по спокойным водам залива."
                            }
                        },
                        {
                            "text": "The birds seemed to <w>oar</w> through the heavy morning air with slow wingbeats.",
                            "target_lang_translations": {
                                "ru": "Казалось, птицы медленно <w>парят</w> в тяжелом утреннем воздухе, плавно взмахивая крыльями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грести; передвигаться с помощью весел или подобно им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "с помощью весел"
                            },
                            {
                                "target_lang_word": "взмахивать крыльями",
                                "target_lang_sense_clarification": "о птицах, поэтически"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}