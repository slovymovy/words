                "senses": [
                    {
                        "sense_id": "eb6b5b48-1b24-3229-b5ce-539987bc46d6",
                        "entry_id": "0bde675c-f4d6-3a3d-962e-d094ef63d716",
                        "glosses": [
                            "Schmerzempfindlichkeit, physiologische Schmerzempfindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e2d2d7-78ee-4178-b358-c0031305e2ee",
                                "sense_id": "eb6b5b48-1b24-3229-b5ce-539987bc46d6",
                                "text": "Bei Patienten mit initial motorisch kompletter Lähmung aber noch erhaltener Schmerzempfindung (Algesie) unterhalb des Verletzungsniveaus steigt die Rate der motorischen Erholung auf mehr als 60% an (…)."
                            },
                            {
                                "example_id": "4475ac1c-1bb1-431b-a9f2-54a182ca7cb4",
                                "sense_id": "eb6b5b48-1b24-3229-b5ce-539987bc46d6",
                                "text": "Liegen Punkte eines Meridians im Zentrum bzw. in der Nähe eines gestörten Geschehens (z. B. schmerzhaftes Ellenbogengelenk) werden seine Punkte ober- und unterhalb der Algesie ganz gezielt stimuliert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
