                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1b2075e-edc9-38f0-b522-612e978bb62c",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To make complete, to bring to a full development."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e1edb4-5388-4402-8749-7a4f4b98fb0a",
                                                "sense_id": "c1b2075e-edc9-38f0-b522-612e978bb62c",
                                                "text": "Our Father’s Death\nWould fill up all the Guilt of Civil War,\nAnd cloſe the Scene of Blood."
                                            }
