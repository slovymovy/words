                        "glosses": [
                            "Not censurable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcfe4372-bf7e-4649-a2a5-87e2941f7aa9",
                                "sense_id": "8e5a68c3-7c6b-374e-b872-356012f5e35e",
                                "text": "When this license expires, he cannot without being disorderly, continue to preach, unless it is renewed; and it will not be renewed, unless his character continues to be incensurable."
                            },
                            {
                                "example_id": "6c3e4146-b6c0-4299-b0ba-dfa856d58a54",
                                "sense_id": "8e5a68c3-7c6b-374e-b872-356012f5e35e",
                                "text": "Do only such acts as are incensurable and none else."
                            },
                            {
                                "example_id": "24b98b41-c783-425a-8605-11b642f037e0",
                                "sense_id": "8e5a68c3-7c6b-374e-b872-356012f5e35e",
                                "text": "Their wealth is blameless and incensurable."
                            },
                            {
                                "example_id": "07b24109-52a3-45d6-8d27-aeaa241ec37e",
                                "sense_id": "8e5a68c3-7c6b-374e-b872-356012f5e35e",
                                "text": "Anticipating possible criticism of his calculations, Luzzatto expressly concedes that he does not \"dare to assert that the above computation is incensurable and incastigable,for political matters are subject to changes and contingencies..."
                            }
                        ]
                    }
                ],
