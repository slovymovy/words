                "senses": [
                    {
                        "sense_id": "64dbb775-c6e0-30f0-ac92-1a13aa182a08",
                        "entry_id": "a5e93932-d0aa-3734-9c4c-2aba906c405d",
                        "glosses": [
                            "Donner un caractère de jihad à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a247ae20-c65c-4aea-b6f9-54253f77e675",
                                "sense_id": "64dbb775-c6e0-30f0-ac92-1a13aa182a08",
                                "text": "Le choix entre militants de plus en plus « jihadisés » et appareil d’État alaouite soutenu par le Hezbollah ne rend pas les décisions faciles pour les gouvernements occidentaux."
                            },
                            {
                                "example_id": "a1b57c17-d244-4d1a-bb15-b3fa8295d691",
                                "sense_id": "64dbb775-c6e0-30f0-ac92-1a13aa182a08",
                                "text": "Cela ne signifie pas que ces derniers soient des agents du régime mais il est évident que Bachar al-Assad a un intérêt direct à «jihadiser» la révolution."
                            },
                            {
                                "example_id": "6cf5acf2-6ff4-407b-bef2-9181ed30b740",
                                "sense_id": "64dbb775-c6e0-30f0-ac92-1a13aa182a08",
                                "text": "Il y a un an et demi, ils savaient que ce kid était prêt à se jihadiser."
                            }
                        ]
                    }
