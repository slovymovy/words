                {
                    "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                    "sense_definition": "Without intention; by mistake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unintentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>accidentally</w> dropped my phone into the water.",
                            "target_lang_translations": {
                                "ru": "Я <w>случайно</w> уронил свой телефон в воду.",
                                "tr": "Telefonumu <w>kazara</w> suya düşürdüm.",
                                "zh": "我<w>不小心</w>把手机掉进水里了。",
                                "nl": "Ik liet mijn telefoon <w>per ongeluk</w> in het water vallen.",
                                "pl": "Ja <w>przypadkowo</w> upuściłem telefon do wody.",
                                "de": "Ich habe mein Handy <w>aus Versehen</w> ins Wasser fallen lassen.",
                                "fr": "J'ai <w>par mégarde</w> fait tomber mon téléphone dans l'eau.",
                                "it": "Ho <w>accidentalmente</w> fatto cadere il mio telefono nell'acqua.",
                                "cs": "Telefon mi <w>omylem</w> spadl do vody.",
                                "es": "Se me cayó <w>accidentalmente</w> el teléfono al agua."
                            }
                        },
                        {
                            "text": "She <w>accidentally</w> sent the email to the wrong person.",
                            "target_lang_translations": {
                                "ru": "Она <w>по ошибке</w> отправила электронное письмо не тому человеку.",
                                "tr": "E-postayı <w>yanlışlıkla</w> yanlış kişiye gönderdi.",
                                "zh": "她<w>无意中</w>把邮件发给了错误的人。",
                                "nl": "Ze stuurde de e-mail <w>per ongeluk</w> naar de verkeerde persoon.",
                                "pl": "Ona <w>niechcący</w> wysłała e-mail do niewłaściwej osoby.",
                                "de": "Sie hat die E-Mail <w>versehentlich</w> an die falsche Person geschickt.",
                                "fr": "Elle a <w>accidentellement</w> envoyé l'e-mail à la mauvaise personne.",
                                "it": "Ha inviato <w>per sbaglio</w> l'email alla persona sbagliata.",
                                "cs": "E-mail <w>nedopatřením</w> poslala nesprávné osobě.",
                                "es": "Ella envió el correo electrónico a la persona equivocada <w>sin querer</w>."
                            }
                        }
                    ],
