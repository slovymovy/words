                                "target_senses": [
                                    {
                                        "sense_id": "56ae1e55-9ed7-30a6-8854-805df6c43b64",
                                        "entry_id": "829e5573-4155-3384-8407-b0e1d2d11610",
                                        "glosses": [
                                            "Any of several African mammals of the family Bovidae distinguished by hollow horns, which, unlike deer, they do not shed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e6ae3a1-54e7-3d19-9ac5-a058e3cd5715",
                                        "entry_id": "829e5573-4155-3384-8407-b0e1d2d11610",
                                        "glosses": [
                                            "The pronghorn, Antilocapra americana."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab9d007-bcd2-4628-a3b6-b2dda39463f7",
                                                "sense_id": "9e6ae3a1-54e7-3d19-9ac5-a058e3cd5715",
                                                "text": "Rarely antelopes are seen, but wolves, rabbits, and sundry ground squirrels abound."
                                            },
                                            {
                                                "example_id": "62214c56-0ad4-4c21-8afe-292fb9e063d3",
                                                "sense_id": "9e6ae3a1-54e7-3d19-9ac5-a058e3cd5715",
                                                "text": "\"It reminds me of when I was hunting antelope in Colorado,\" he said to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d85d83-1957-3b0d-9f96-1f9d039ad1c8",
                                        "entry_id": "829e5573-4155-3384-8407-b0e1d2d11610",
                                        "glosses": [
                                            "A fierce legendary creature said to live on the banks of the Euphrates, having long serrated horns and being hard to catch."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
