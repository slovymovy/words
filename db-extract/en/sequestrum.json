                    {
                        "sense_id": "7c42e136-277e-348d-b8b7-a12ff297e84e",
                        "entry_id": "c50a0b3b-fb96-38f0-84cc-40b6608fb7c9",
                        "glosses": [
                            "A fragment of bone or other dead tissue that has separated during necrosis."
                        ],
                        "tags": [],
