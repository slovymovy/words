    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43922ef1-712b-3347-9d37-333c8d600b82",
                    "sense_definition": "Sudden, striking, or very noticeable in appearance or effect",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impactful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company saw a <w>dramatic</w> increase in sales after the new marketing campaign launched.",
                            "target_lang_translations": {
                                "ru": "Компания зафиксировала <w>драматический</w> рост продаж после запуска новой маркетинговой кампании.",
                                "zh": "新营销活动推出后，该公司的销售额出现了<w>巨大</w>的增长。"
                            }
                        },
                        {
                            "text": "There has been a <w>dramatic</w> change in the weather since this morning.",
                            "target_lang_translations": {
                                "ru": "С утра погода претерпела <w>резкие</w> изменения.",
                                "zh": "自今天早上以来，天气发生了<w>剧烈</w>的变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "striking",
                        "spectacular",
                        "considerable",
                        "substantial"
                    ],
                    "antonyms": [
                        "slight",
                        "gradual",
                        "minor"
                    ],
                    "common_phrases": [
                        "dramatic change",
                        "dramatic increase",
                        "dramatic improvement",
                        "dramatic effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, поразительный или очень заметный по внешнему виду или эффекту",
                        "zh": "指外观或效果上突然的、惊人的或非常显著的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драматический",
                                "target_lang_sense_clarification": "о резких переменах или росте"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о внезапных изменениях"
                            },
                            {
                                "target_lang_word": "впечатляющий",
                                "target_lang_sense_clarification": "о сильном эффекте"
                            },
                            {
                                "target_lang_word": "значительный",
                                "target_lang_sense_clarification": "о существенном влиянии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "形容变化或增长幅度大"
                            },
                            {
                                "target_lang_word": "剧烈的",
                                "target_lang_sense_clarification": "形容变化突然且强烈"
                            },
                            {
                                "target_lang_word": "显著的",
                                "target_lang_sense_clarification": "形容非常明显"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7c6896-48ad-308f-82e3-69f19e59a706",
                    "sense_definition": "Tending to exaggerate reactions or behavior to get attention or express strong emotion",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop being so <w>dramatic</w>; it is just a small scratch on your finger.",
                            "target_lang_translations": {
                                "ru": "Перестань быть таким <w>драматичным</w>; это всего лишь маленькая царапина на пальце.",
                                "zh": "别那么<w>夸张</w>了，那不过是你手指上的一点小划痕。"
                            }
                        },
                        {
                            "text": "She is known for her <w>dramatic</w> behavior whenever things do not go her way.",
                            "target_lang_translations": {
                                "ru": "Она известна своим <w>театральным</w> поведением всякий раз, когда всё идет не по её плану.",
                                "zh": "每当事情不如意时，她就以<w>戏剧性</w>的行为而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "theatrical",
                        "histrionic",
                        "over-the-top"
                    ],
                    "antonyms": [
                        "stoic",
                        "understated",
                        "calm"
                    ],
                    "common_phrases": [
                        "being so dramatic",
                        "dramatic reaction",
                        "dramatic gesture"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe overreacting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный преувеличивать реакции или поведение, чтобы привлечь внимание или выразить сильные эмоции",
                        "zh": "倾向于夸大反应或行为以博取关注或表达强烈情绪"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драматичный",
                                "target_lang_sense_clarification": "о поведении человека"
                            },
                            {
                                "target_lang_word": "театральный",
                                "target_lang_sense_clarification": "о наигранном поведении"
                            },
                            {
                                "target_lang_word": "демонстративный",
                                "target_lang_sense_clarification": "о поведении напоказ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夸张的",
                                "target_lang_sense_clarification": "形容行为过火"
                            },
                            {
                                "target_lang_word": "戏剧性的",
                                "target_lang_sense_clarification": "形容人表现得像在演戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df947fbc-5c71-38f4-86ab-c28dc2001b6b",
                    "sense_definition": "Relating to the performance or writing of plays and theater",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university offers a renowned program in <w>dramatic</w> arts and performance.",
                            "target_lang_translations": {
                                "ru": "Университет предлагает известную программу в области <w>драматического</w> искусства и актерского мастерства.",
                                "zh": "这所大学提供著名的<w>戏剧</w>艺术与表演课程。"
                            }
                        },
                        {
                            "text": "He studied <w>dramatic</w> literature to understand the history of the stage.",
                            "target_lang_translations": {
                                "ru": "Он изучал <w>драматическую</w> литературу, чтобы понять историю сцены.",
                                "zh": "他研究<w>戏剧</w>文学以了解舞台的历史。"
                            }
                        }
                    ],
                    "synonyms": [
                        "theatrical",
                        "scenic"
                    ],
                    "common_phrases": [
                        "dramatic arts",
                        "dramatic literature",
                        "dramatic performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к исполнению или написанию пьес и театру",
                        "zh": "与戏剧表演或剧本创作相关的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драматический",
                                "target_lang_sense_clarification": "относящийся к искусству и театру"
                            },
                            {
                                "target_lang_word": "театральный",
                                "target_lang_sense_clarification": "связанный со сценой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏剧的",
                                "target_lang_sense_clarification": "与戏剧艺术相关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bf70048-db39-3c3e-8741-273c871cbe1a",
                    "sense_definition": "Having a powerful, rich, and expressive singing voice suitable for intense operatic roles",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dramatic</w> soprano filled the entire concert hall with her powerful voice.",
                            "target_lang_translations": {
                                "ru": "<w>Драматическое</w> сопрано наполнило весь концертный зал своим мощным голосом.",
                                "zh": "这位<w>戏剧性</w>女高音用她强有力的嗓音填满了整个音乐厅。"
                            }
                        },
                        {
                            "text": "He is a <w>dramatic</w> tenor capable of singing the most demanding Wagnerian roles.",
                            "target_lang_translations": {
                                "ru": "Он — <w>драматический</w> тенор, способный исполнять самые сложные вагнеровские партии.",
                                "zh": "他是一位<w>戏剧性</w>男高音，能够演唱要求最高的瓦格纳歌剧角色。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lyric"
                    ],
                    "common_phrases": [
                        "dramatic soprano",
                        "dramatic tenor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music/opera"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий мощным, богатым и выразительным певческим голосом, подходящим для напряженных оперных ролей",
                        "zh": "指歌唱声音强劲、丰富且富有表现力，适合演唱高难度歌剧角色"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драматический",
                                "target_lang_sense_clarification": "о типе певческого голоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏剧性",
                                "target_lang_sense_clarification": "指声部类型"
                            }
