                        ],
                        "examples": [
                            {
                                "example_id": "61be7759-606f-4762-a8b1-c0172ddcca37",
                                "sense_id": "a838ee36-c8da-34e9-86bb-3ce926757cb3",
                                "text": "faire du lèche-vitrine",
                                "translation": "to go window-shopping",
                                "english": "to go window-shopping"
                            },
                            {
                                "example_id": "93478261-9e7d-4c8b-a859-7ab882d62649",
                                "sense_id": "a838ee36-c8da-34e9-86bb-3ce926757cb3",
                                "text": "Je me serais bien arrêtée devant les magasins pour faire du lèche-vitrine, mais mon compagnon aurait peut-être pensé que je voulais me faire offrir quelque chose, ce qui l’aurait mis dans une situation délicate vu qu’il n’a certainement pas beaucoup d’argent de poche : il n’y a qu’à le regarder.",
                                "translation": "I would have gladly stopped in front of the stores to do some window shopping, but my companion might have thought that I wanted to get something for myself, which would have put him in a delicate situation given that he certainly didn't have a lot of pocket money: you could tell just by looking at him.",
                                "english": "I would have gladly stopped in front of the stores to do some window shopping, but my companion might have thought that I wanted to get something for myself, which would have put him in a delicate situation given that he certainly didn't have a lot of pocket money: you could tell just by looking at him."
                            }
                        ]
                    },
                    {
                        "sense_id": "be749ac6-4953-348b-a95a-34e81620f26c",
                        "entry_id": "b53fd409-27cc-3887-91ea-2f5caeb31c52",
                        "glosses": [
                            "window-shopper"
                        ],
                        "tags": [
                            "feminine",
                            "idiomatic",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c921d8-f1b4-40d9-85ab-5d60aab6c5c9",
                                "sense_id": "be749ac6-4953-348b-a95a-34e81620f26c",
                                "text": "Elle est une véritable lèche-vitrine.",
                                "translation": "She's a real window-shopper.",
                                "english": "She's a real window-shopper."
                            }
                        ]
                    }
                ],
