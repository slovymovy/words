{
    "word_family": [
        "round",
        "about"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b175b88a-7ba3-34e3-b119-722b56385f62",
                    "sense_definition": "A road junction at which traffic streams circularly around a central island.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "road_junction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take the second exit at the <w>roundabout</w> to stay on the main road.",
                            "target_lang_translations": {
                                "zh": "在<w>环岛</w>走第二个出口，继续沿主路行驶。"
                            }
                        },
                        {
                            "text": "The new traffic system replaced the old intersection with a modern <w>roundabout</w>.",
                            "target_lang_translations": {
                                "zh": "新的交通系统用现代化的<w>环形交叉路口</w>取代了原来的十字路口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "traffic circle",
                        "rotary",
                        "rotunda",
                        "island"
                    ],
                    "common_phrases": [
                        "traffic roundabout",
                        "busy roundabout"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种道路交叉口，车辆绕中央安全岛单向环行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "环岛",
                                "target_lang_sense_clarification": "道路交通术语，车辆绕中央岛行驶的路口"
                            },
                            {
                                "target_lang_word": "环形交叉路口",
                                "target_lang_sense_clarification": "较正式说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bff85977-b7c5-3630-a98b-03f88e194323",
                    "sense_definition": "A horizontal wheel which rotates around a central axis when pushed and on which children ride, often found in parks as a children's play apparatus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "playground_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children laughed as they spun quickly on the playground <w>roundabout</w>.",
                            "target_lang_translations": {
                                "zh": "孩子们在游乐场的<w>转盘</w>上飞快旋转，笑个不停。"
                            }
                        },
                        {
                            "text": "He felt slightly dizzy after spinning on the <w>roundabout</w> for several minutes.",
                            "target_lang_translations": {
                                "zh": "他在<w>转盘</w>上转了几分钟后，觉得有点头晕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merry-go-round"
                    ],
                    "common_phrases": [
                        "playground roundabout"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种水平圆盘式儿童游乐设施，受推动后绕中心轴旋转，孩子可以坐在上面玩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "转盘",
                                "target_lang_sense_clarification": "儿童游乐设施，可推着旋转"
                            },
                            {
                                "target_lang_word": "旋转转盘",
                                "target_lang_sense_clarification": "儿童游乐场语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb2ba93-7419-34a0-b27c-b8d7c77f267c",
                    "sense_definition": "A fairground carousel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fairground_ride",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright lights of the fairground <w>roundabout</w> could be seen from miles away.",
                            "target_lang_translations": {
                                "zh": "远远就能看见游乐场<w>旋转木马</w>明亮的灯光。"
                            }
                        },
                        {
                            "text": "She chose to ride the wooden horse on the traditional <w>roundabout</w>.",
                            "target_lang_translations": {
                                "zh": "她选择骑上传统<w>旋转木马</w>上的木马。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merry-go-round"
                    ],
                    "common_phrases": [
                        "fairground roundabout"
                    ],
                    "target_lang_definitions": {
                        "zh": "游乐场中的旋转木马。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "旋转木马",
                                "target_lang_sense_clarification": "游乐场里的大型旋转骑乘设施"
                            },
                            {
                                "target_lang_word": "转马",
                                "target_lang_sense_clarification": "较宽泛的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8a92da9-e434-368b-a78d-6b6ae0500e1d",
                    "sense_definition": "A detour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because of the road construction, we had to take a long <w>roundabout</w> to get home.",
                            "target_lang_translations": {
                                "zh": "因为道路施工，我们只好绕一大段<w>绕路</w>回家。"
                            }
                        },
                        {
                            "text": "The path was blocked, forcing the hikers to make a scenic <w>roundabout</w> through the woods.",
                            "target_lang_translations": {
                                "zh": "小路被堵住了，徒步者们只得穿过树林走一段风景优美的<w>绕道</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "long roundabout"
                    ],
                    "target_lang_definitions": {
                        "zh": "绕行的路；改道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绕路",
                                "target_lang_sense_clarification": "为避开障碍或封路而改走的路"
                            },
                            {
                                "target_lang_word": "绕道",
                                "target_lang_sense_clarification": "名词，改道路线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ce23b8b-9255-3e7f-b3ba-b1d14f2f17a7",
                    "sense_definition": "A short, close-fitting coat or jacket worn by men or boys, especially in the 19th century.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boy wore a woolen <w>roundabout</w> that kept him warm during the winter of 1850.",
                            "target_lang_translations": {
                                "zh": "那个小男孩穿着一件羊毛<w>短外套</w>，在1850年的冬天里很保暖。"
                            }
                        },
                        {
                            "text": "Historical reenactors often wear a traditional <w>roundabout</w> to depict the era accurately.",
                            "target_lang_translations": {
                                "zh": "历史场景重演者常穿传统的<w>紧身短上衣</w>，以准确再现那个时代。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily historical clothing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种男性或男童穿的短而贴身的外套或夹克，尤指19世纪常见的款式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "短外套",
                                "target_lang_sense_clarification": "历史服装，男士或男童穿的短款外衣"
                            },
                            {
                                "target_lang_word": "紧身短上衣",
                                "target_lang_sense_clarification": "强调贴身、短款的旧式上衣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc49498-de54-3cbc-b194-b33c1ca823db",
                    "sense_definition": "A round dance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers joined hands to perform a lively <w>roundabout</w> during the spring festival.",
                            "target_lang_translations": {
                                "zh": "村民们在春节期间手拉着手跳起热闹的<w>环舞</w>。"
                            }
                        },
                        {
                            "text": "Traditional folk music accompanied the dancers as they spun in a <w>roundabout</w>.",
                            "target_lang_translations": {
                                "zh": "舞者们跳着<w>圆圈舞</w>旋转时，有传统民间音乐为他们伴奏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种围成圆圈跳的舞蹈。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "环舞",
                                "target_lang_sense_clarification": "围成圆圈跳的舞，古语"
                            },
                            {
                                "target_lang_word": "圆圈舞",
                                "target_lang_sense_clarification": "传统舞蹈语境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                    "sense_definition": "Indirect, circuitous, or circumlocutionary.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indirectness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of answering directly, he gave a <w>roundabout</w> explanation that confused everyone.",
                            "target_lang_translations": {
                                "zh": "他没有直接回答，而是作了一番<w>拐弯抹角的</w>解释，把大家都弄糊涂了。"
                            }
                        },
                        {
                            "text": "They reached the cabin by a very <w>roundabout</w> route to avoid the heavy traffic on the highway.",
                            "target_lang_translations": {
                                "zh": "为了避开公路上的拥堵，他们沿着一条很<w>绕远的</w>路线到达了小木屋。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "roundabout way",
                        "roundabout route",
                        "roundabout explanation"
                    ],
                    "target_lang_definitions": {
                        "zh": "不直接的；迂回的；说话绕圈子的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拐弯抹角的",
                                "target_lang_sense_clarification": "说话或做事不直接"
                            },
                            {
                                "target_lang_word": "迂回的",
                                "target_lang_sense_clarification": "路线、方式曲折迂回"
                            },
                            {
                                "target_lang_word": "绕远的",
                                "target_lang_sense_clarification": "强调绕远"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b06e6b2-69b7-386f-9186-40001523f396",
                    "sense_definition": "Encircling; enveloping; comprehensive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comprehensiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He possessed a broad, <w>roundabout</w> common sense that allowed him to see all sides of the issue.",
                            "target_lang_translations": {
                                "zh": "他具有一种<w>全面的</w>常识判断力，因此能看到问题的各个方面。"
                            }
                        },
                        {
                            "text": "The scholar's <w>roundabout</w> view of history encompassed multiple cultural perspectives.",
                            "target_lang_translations": {
                                "zh": "这位学者对历史的<w>包罗周全的</w>看法涵盖了多种文化视角。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "环绕的；包围的；广泛而全面的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "全面的",
                                "target_lang_sense_clarification": "古义，包罗广泛、顾及周全"
                            },
                            {
                                "target_lang_word": "周全的",
                                "target_lang_sense_clarification": "较书面、较少用"
                            },
                            {
                                "target_lang_word": "包罗周全的",
                                "target_lang_sense_clarification": "强调涵盖面广"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea8472e3-41a4-351a-8290-c4847e604418",
                    "sense_definition": "To talk in a roundabout, indirect manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indirect_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of stating his demands, he began to <w>roundabout</w> for several minutes.",
                            "target_lang_translations": {
                                "zh": "他没有直接说出自己的要求，而是开始<w>拐弯抹角地说</w>了好几分钟。"
                            }
                        },
                        {
                            "text": "Stop <w>roundabouting</w> and tell me exactly what you want from this deal.",
                            "target_lang_translations": {
                                "zh": "别再<w>拐弯抹角</w>了，直接告诉我你想从这笔交易里得到什么。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以拐弯抹角、间接的方式说话。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拐弯抹角地说",
                                "target_lang_sense_clarification": "指说话不直说，绕圈子"
                            },
                            {
                                "target_lang_word": "绕着说",
                                "target_lang_sense_clarification": "较简洁的动词说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed0af57-df7b-39a3-b6e3-7787424cf740",
                    "sense_definition": "To play on a roundabout (carousel).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "play_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children loved to <w>roundabout</w> in the park until they were completely dizzy.",
                            "target_lang_translations": {
                                "zh": "孩子们喜欢在公园里玩<w>转盘</w>，直到转得头晕眼花。"
                            }
                        },
                        {
                            "text": "They spent the entire afternoon <w>roundabouting</w> at the local playground.",
                            "target_lang_translations": {
                                "zh": "他们整个下午都在附近的游乐场里<w>玩转盘</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在转盘或旋转类游乐设施上玩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "玩转盘",
                                "target_lang_sense_clarification": "指在儿童转盘或类似设施上玩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25a5e3e0-150d-3687-b81f-80037b052f53",
                    "sense_definition": "To travel round roundabouts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>roundabout</w> through the city center to find the correct exit.",
                            "target_lang_translations": {
                                "zh": "为了找到正确的出口，我们只好开车在市中心的各个<w>环岛</w>间绕行。"
                            }
                        },
                        {
                            "text": "The driver spent hours <w>roundabouting</w> through the complex road network.",
                            "target_lang_translations": {
                                "zh": "司机在复杂的道路网络和一个个<w>环岛</w>之间绕行了好几个小时。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在一个个环岛之间行驶或绕行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绕环岛行驶",
                                "target_lang_sense_clarification": "在多个环岛间行驶、兜圈前进"
                            },
                            {
                                "target_lang_word": "在环岛间绕行",
                                "target_lang_sense_clarification": "较自然的概括说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}