                "senses": [
                    {
                        "sense_id": "363ec323-d331-3c67-9723-988d2c95b5fe",
                        "entry_id": "f4d1f40a-a145-330a-a519-dfb2875f3ee0",
                        "glosses": [
                            "искусств. приверженец или представитель экспрессионизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7714ba15-8565-40a8-8e8f-599c11ffcdc9",
                                "sense_id": "363ec323-d331-3c67-9723-988d2c95b5fe",
                                "text": "Кубисты и футуристы, или экспрессионисты (как их стали называть в Германии), с Пикассо во главе, круто повернули к Энгру и Пуссену."
                            },
                            {
                                "example_id": "d1919248-0f89-4b57-96b6-ca44a1be1ed4",
                                "sense_id": "363ec323-d331-3c67-9723-988d2c95b5fe",
                                "text": "Парадоксальные ощущения лучше всего давались экспрессионистам, искажавшим реальность под воздействием сильнейших эмоциональных состояний."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c69ba0b-c022-49dc-8cdf-755b3f9c5c78",
                        "source_entry_id": "f4d1f40a-a145-330a-a519-dfb2875f3ee0",
                        "source_sense_id": "363ec323-d331-3c67-9723-988d2c95b5fe",
                        "target_lang_word": "expressionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionist",
