                                    },
                                    {
                                        "sense_id": "cca456b9-d3ae-3822-9f91-3bc74b22ca66",
                                        "entry_id": "69a333e6-b2f2-3d74-960d-83617494dc8c",
                                        "glosses": [
                                            "Adjacent; neighboring."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fdbfe07-0fc9-4ab4-aede-5db4d44d739c",
                                                "sense_id": "cca456b9-d3ae-3822-9f91-3bc74b22ca66",
                                                "text": "1730–1774, Oliver Goldsmith, Introductory to Switzerland\nThough poor the peasant’s hut, his feasts though small,\nHe sees his little lot the lot of all;\nSees no contiguous palace rear its head\nTo shame the meanness of his humble shed;"
                                            },
                                            {
                                                "example_id": "5bf14027-9de5-430c-8370-5f03206c79c0",
                                                "sense_id": "cca456b9-d3ae-3822-9f91-3bc74b22ca66",
                                                "text": "[…] the usual quietness of the day, with us, was broken in upon by the shout of success from the pursuing boats, followed by vehement respondings from the contiguous ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b1fb9b-dcde-3d87-847e-247da77ce7ce",
                                        "entry_id": "69a333e6-b2f2-3d74-960d-83617494dc8c",
                                        "glosses": [
                                            "Connecting without a break."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8e27ed-bbda-4506-8b94-2ed0f425878d",
                                                "sense_id": "c1b1fb9b-dcde-3d87-847e-247da77ce7ce",
                                                "text": "the forty-eight contiguous states"
                                            },
                                            {
                                                "example_id": "b15d4613-3a06-4568-93c6-4a58b536f2c6",
                                                "sense_id": "c1b1fb9b-dcde-3d87-847e-247da77ce7ce",
                                                "text": "Supposing three such houses to be contiguous to a central one, each separated from the latter by a straight wall."
                                            }
                                        ]
                                    }
