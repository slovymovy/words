                    "frequency": "Middle",
                    "semantic_group_id": "zeitliche_gliederung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unser Arbeitsalltag im Betrieb ist von morgens bis abends sehr eng getaktet."
                        },
                        {
                            "text": "Die Verkehrsbetriebe takten die Busse im Berufsverkehr in einem Fünf-Minuten-Intervall."
                        }
                    ],
                    "synonyms": [
                        "strukturieren",
                        "rhythmisieren"
                    ],
                    "common_phrases": [
                        "eng getaktet",
                        "strikter getaktet",
                        "getakteter Fahrplan"
