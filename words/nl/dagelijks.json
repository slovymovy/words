                    "sense_definition": "wat elke dag gebeurt, voorkomt of nodig is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om voldoende <w>dagelijkse</w> beweging te krijgen voor een goede gezondheid.",
                            "target_lang_translations": {
                                "en": "It is important to get enough <w>daily</w> exercise for good health.",
                                "ru": "Для хорошего здоровья важно получать достаточное количество <w>ежедневной</w> физической нагрузки.",
