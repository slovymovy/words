                "senses": [
                    {
                        "sense_id": "8118de77-39cc-34ef-abbc-333f47f6e147",
                        "entry_id": "0d72fede-ee94-3fb1-a7b6-4e3ae87d3a95",
                        "glosses": [
                            "cabbage, Brassica oleracea"
                        ],
                        "tags": [
                            "Central",
                            "German",
                            "Upper-German",
                            "West",
