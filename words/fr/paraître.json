    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3096c70f-8350-3a09-8f1a-021bb71f6a66",
                    "sense_definition": "Avoir une certaine apparence, donner l'impression d'être.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sembler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet te <w>paraît</w> complexe, mais tu réussiras sans difficulté avec un peu d'aide."
                        },
                        {
                            "text": "Avec sa nouvelle coiffure, elle <w>paraît</w> beaucoup plus jeune que son âge."
                        }
                    ],
                    "synonyms": [
                        "sembler"
                    ],
                    "common_phrases": [
                        "paraître plus jeune",
                        "laisser paraître"
                    ]
                },
                {
                    "sense_id": "31e40435-d524-3f7f-b3d5-f2d3d006ab50",
                    "sense_definition": "Être rapporté par la rumeur ou par des bruits qui courent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sembler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>paraît</w> que cette ancienne maison au bord de la rivière est totalement abandonnée."
                        },
                        {
                            "text": "À ce qu'il <w>paraît</w>, la directrice annoncera d'importants changements dès la semaine prochaine."
                        }
                    ],
                    "common_phrases": [
                        "il paraît que",
                        "à ce qu'il paraît"
                    ]
                },
                {
                    "sense_id": "b6cf7484-a2ba-36aa-912d-db05eb8dde9e",
                    "sense_definition": "Être publié et mis en vente ou en circulation, en parlant d'un livre ou d'un périodique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau roman de cet écrivain célèbre va <w>paraître</w> en librairie le mois prochain."
                        },
                        {
                            "text": "Cet article spécialisé vient tout juste de <w>paraître</w> dans une grande revue scientifique."
                        }
                    ],
                    "synonyms": [
                        "être publié"
                    ],
                    "common_phrases": [
                        "à paraître",
                        "venir de paraître"
                    ]
                },
                {
                    "sense_id": "ce89169e-55f2-35d8-92bb-01ed27593ee0",
                    "sense_definition": "Devenir visible, se montrer à la vue ou se manifester.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil commence enfin à <w>paraître</w> derrière les nuages après plusieurs jours d'orage."
                        },
                        {
                            "text": "Dès qu'un témoin osa <w>paraître</w> dans la pièce, tout le monde garda le silence."
                        }
                    ],
                    "synonyms": [
                        "apparaître"
                    ],
                    "common_phrases": [
                        "faire paraître"
                    ]
                },
                {
                    "sense_id": "d18d8276-ff74-3c00-ad25-7c484b3ad7af",
                    "sense_definition": "Chercher à se faire remarquer ou briller par son allure et ses artifices en société.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ostentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il dépense tout son argent dans des vêtements de luxe uniquement pour <w>paraître</w> en soirée."
                        },
                        {
                            "text": "Dans ce milieu mondain, l'envie de <w>paraître</w> semble bien plus forte que toute sincérité."
                        }
                    ],
                    "common_phrases": [
                        "aimer paraître"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56ac2015-b2e7-30ba-b309-7aa31abbbf61",
                    "sense_definition": "Aspect extérieur superficiel ou faux-semblant, souvent mis en opposition avec l'authenticité de l'être.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ostentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette entreprise, le culte du <w>paraître</w> l'emporte souvent sur les compétences réelles."
                        },
                        {
                            "text": "Elle a toujours accordé plus d'importance aux sentiments profonds qu'aux pièges du <w>paraître</w>."
                        }
                    ],
                    "common_phrases": [
                        "l'être et le paraître",
                        "culte du paraître"
                    ]
                }
            ]
        }
    ]
}