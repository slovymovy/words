                        "examples": [
                            {
                                "example_id": "e7000573-1f09-4658-ab2c-9f14aaa6c8ec",
                                "sense_id": "1031372d-7f9b-3669-98a5-ec5fb176d0c3",
                                "text": "Bloedkoraal (Corallium rubrum) is een koraalsoort uit de Middellandse Zee. Het wordt aangetroffen op een diepte van 2 tot 280 meter. De onregelmatig gevormde kolonies worden 5 tot 20 centimeter hoog. Meestal is bloedkoraal donkeroranje. Er zijn echter ook witte en zwarte exemplaren bekend."
                            }
                        ]
                    }
