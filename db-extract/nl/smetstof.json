                    },
                    {
                        "translation_id": "efe4996b-2d8c-45e0-93a7-4a9bcb5c1349",
                        "source_entry_id": "e1f32504-d717-3891-965d-0aedaee85d1d",
                        "source_sense_id": "4b7656ec-17cb-3b5b-95dc-c9e7d1cfb135",
                        "source_sense_description": "besmet materiaal",
                        "target_lang_word": "contagium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contagium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ab8e56d-3c45-3282-a069-7f278df2e00a",
                                        "entry_id": "2ed98ae5-bc94-3a46-9cf2-61212a0fa505",
                                        "glosses": [
                                            "contagion; contagious matter"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c316c4a-fd20-4f80-b2df-b706bcc875ff",
                                                "sense_id": "4ab8e56d-3c45-3282-a069-7f278df2e00a",
                                                "text": "And its escape [from certain diseases] is an approximative proof that, at least for those ten years, no contagium of measles, “nor any contagium of scarlet fever, nor any contagium of small-pox, had arisen spontaneously\" within its limits."
                                            },
                                            {
                                                "example_id": "e9bb3384-fb74-465a-ac28-fea811a6a67c",
                                                "sense_id": "4ab8e56d-3c45-3282-a069-7f278df2e00a",
                                                "text": "That this in fact was the case was ascertained by Dr. Edington, who, by adding a large percentage (33 per cent.) of glycerine to the gall taken from a rinderpest beast, was able to show that by such contact the infective power of bile was as effectually destroyed as was the contagium of blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3518c7a2-1852-4173-97a4-4219759319cc",
                        "source_entry_id": "e1f32504-d717-3891-965d-0aedaee85d1d",
