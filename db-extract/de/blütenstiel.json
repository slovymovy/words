                                "target_senses": [
                                    {
                                        "sense_id": "3d5b5423-cd00-32bc-b9a9-6882d470de46",
                                        "entry_id": "dd05c787-1bee-342d-9271-40e32d2120aa",
                                        "glosses": [
                                            "Ramification du pédoncule supportant directement la fleur ou pédoncule très court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dc78a2-080b-412b-beae-0b46530866b7",
                                                "sense_id": "3d5b5423-cd00-32bc-b9a9-6882d470de46",
                                                "text": "L’éclatement du fruit (« shattering habit ») prend deux formes chez le sarrasin : un pédicelle cassant et un pédicelle faible. Le pédicelle cassant est observé chez le sarrasin sauvage mais pas chez le sarrasin cultivé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf744f1a-39fe-4174-bd08-28e18083b6fc",
                        "source_entry_id": "15783448-76a5-3ece-961c-4742430e1f68",
                        "source_sense_id": "19172c56-9893-32f0-9e42-72b18fd2b54f",
                        "source_sense_description": "Botanik: der Bereich des Stängels, an dem die Blütenblätter ansetzen",
                        "target_lang_word": "pédoncule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédoncule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                        "entry_id": "d9e517bf-af8d-3f87-945d-d2ab87c2a76e",
                                        "glosses": [
                                            "Tige (ou queue) d’une fleur (et donc, après fécondation, d’un fruit), distincte de la tige de la plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf13f5c9-959f-496d-a4af-13c7292fdc46",
                                                "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                                "text": "Leur pédoncule vert et frisé est vraiment bien réussi."
                                            },
                                            {
                                                "example_id": "65ccd623-aba1-4c29-8b87-8515786b35c7",
                                                "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                                "text": "Sur 382 variétés observées pendant trois ans, seulement six variétés rouges et deux variétés blanches présentent une très bonne aptitude à la récolte sans pédoncule. […] Il est à noter que jusqu’à présent aucune variété rouge précoce n’est susceptible d’être récoltée sans pédoncule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                        "entry_id": "d9e517bf-af8d-3f87-945d-d2ab87c2a76e",
                                        "glosses": [
                                            "Support d’une partie quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a1a7f8-3e18-4481-a2f9-67f9e3f8444c",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "À l’aide du sous-marin de recherche Johnson Sea Link, des spécimens de la pentacrine Neocrinus decorus vivant au large des Bahamas par 420 m de profondeur ont été marqués, replacés puis récupérés 250 jours plus tard. La vitesse moyenne de croissance en longueur du pédoncule est de 10,8 cm/a avec une valeur maximum de 14,3 cm/a."
                                            },
                                            {
                                                "example_id": "ef175eaa-a01a-4fc2-9502-c1d951cb9136",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "Pédoncules cérébraux, prolongements de la moelle allongée."
                                            },
                                            {
                                                "example_id": "5483ea21-2947-41d0-b70c-1c8be5f9cfff",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "Pédoncules cérébelleux, cordons qui relient le cervelet au cerveau et concourent à la formation des pédoncules cérébraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
