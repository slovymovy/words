                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e7ee209-84c6-4f45-9439-fa0febc1d33c",
                                "sense_id": "05f28a56-fa2f-347f-9dd4-c86fef80f3df",
                                "text": "Araukanien weist ein ähnliches Klima wie Deutschland auf."
                            },
                            {
                                "example_id": "84c2b9d7-19fe-4392-b10d-12142240ebd3",
                                "sense_id": "05f28a56-fa2f-347f-9dd4-c86fef80f3df",
                                "text": "„Die Indianer von Araukanien hatten kurz vorher ein an ihrer Küste gestrandetes Schiff geplündert, zugleich waren bei dieser Gelegenheit einige Menschen verloren gegangen.“"
                            },
                            {
                                "example_id": "d90417e9-286e-410a-9d86-70b8762e3114",
                                "sense_id": "05f28a56-fa2f-347f-9dd4-c86fef80f3df",
                                "text": "„Nachdem wir die Hauptstadt von Araukanien durchquert haben, setzen wir unseren Weg durch den Andenpaß von Antuco fort und lassen den Vulkan im Süden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
