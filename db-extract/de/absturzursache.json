                                "example_id": "6e6b79ee-3c92-4f95-ba3b-0fe8e7235602",
                                "sense_id": "b0ef2909-2a89-35e2-9e94-eec926516cde",
                                "text": "„Zur Absturzursache sei nichts bekannt, auch die französischen Kollegen hatten zunächst nichts mitgeteilt, sagte ein Sprecher der deutschen Flugsicherung.“"
                            },
                            {
                                "example_id": "17f38ffe-a4ba-48a4-9e27-b36634ca5a2d",
                                "sense_id": "b0ef2909-2a89-35e2-9e94-eec926516cde",
                                "text": "„Die Maschinen sollten am Boden bleiben, solange die Untersuchung über die Absturzursache im spanischen Sevilla laufe, sagte eine Sprecherin des Verteidigungsministeriums in London.“"
                            }
                        ],
