                    }
                ],
                "senses": [
                    {
                        "sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                        "entry_id": "ee7777f0-1d94-3935-befc-9b2b034c7d0b",
                        "glosses": [
                            "Dangereux, risqué, périlleux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592b7960-67ad-4834-8016-a59f32380765",
                                "sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                                "text": "Bienvenue dans le genre très casse-gueule du méta-podcast."
                            },
                            {
                                "example_id": "1a2cc07f-5557-4f75-a94b-7f7e4d9b2851",
                                "sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                                "text": "Mais ça avait suffi pour rendre glissante la courbure écorcée des troncs et les transformer sur toute leur longueur en pistes de voltige des plus casse-gueule qui soient."
                            },
                            {
                                "example_id": "0ef5db29-28be-43dc-99fc-df349bd52735",
                                "sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                                "text": "Casse-gueule : le mot revient souvent pour décrire, plus largement, le retour de la droite LR aux affaires. « Quel est l’intérêt d’entrer dans un gouvernement aussi éphémère ? », écrit le maire LR d’une grande ville que l’on interroge sur ses ambitions personnelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0229e0ee-2890-45ac-aaab-fddfb6abaecd",
                        "source_entry_id": "ee7777f0-1d94-3935-befc-9b2b034c7d0b",
                        "source_sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                        "target_lang_word": "treacherous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treacherous",
