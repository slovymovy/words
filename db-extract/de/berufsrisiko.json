                "senses": [
                    {
                        "sense_id": "9b9be83e-ecef-3aaa-a73a-6b9f2111a8de",
                        "entry_id": "661e4c4c-7615-3de7-81d1-69c23e51f1d9",
                        "glosses": [
                            "Risiko, das bei Ausübung eines Berufs besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af82484-b8bf-4acf-8266-05c1613e43dd",
                                "sense_id": "9b9be83e-ecef-3aaa-a73a-6b9f2111a8de",
                                "text": "„Das war ein Berufsrisiko, das man als Bücherjägerin und vor allem an der Seite meiner unkonventionellen Tante nicht ganz umgehen konnte und an das ich mich gewöhnt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b22b6b66-c8bd-4640-975a-db02100ff5ea",
                        "source_entry_id": "661e4c4c-7615-3de7-81d1-69c23e51f1d9",
                        "source_sense_id": "9b9be83e-ecef-3aaa-a73a-6b9f2111a8de",
                        "source_sense_description": "Risiko, das bei Ausübung eines Berufs besteht",
                        "target_lang_word": "occupational hazard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occupational hazard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7001124c-1fd7-358a-bd9c-c004b99e30c2",
                                        "entry_id": "428ff732-c64d-3cc5-a79b-5fd247c0d9e1",
                                        "glosses": [
                                            "A substantial risk to a worker's physical or mental well-being which is present in a certain task, job, or profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c82d757-3453-4f7d-a2a6-0ff880d3f39f",
                                                "sense_id": "7001124c-1fd7-358a-bd9c-c004b99e30c2",
                                                "text": "They are the abrasive breed of radio and television personalities, most of them talk-show hosts, who treat their profession as a verbal adjunct to street fighting. . . . Threats and sometimes violence are indeed an occupational hazard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                        "entry_id": "428ff732-c64d-3cc5-a79b-5fd247c0d9e1",
                                        "glosses": [
                                            "An unpleasant, inconvenient, or unusual circumstance which occurs or is likely to occur during the course of one's employment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e102c7c5-cfaf-4da7-8ec5-cf00ab7fe31c",
                                                "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                                "text": "The attentions of passionate spinsters were an occupational hazard for all members of the clergy."
                                            },
                                            {
                                                "example_id": "a72a013b-0813-450f-ba86-beea4cad5cad",
                                                "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                                "text": "Today he was going to make a few stops at the rare-book shops in the area—an occupational hazard of his new profession."
                                            },
                                            {
                                                "example_id": "c6457c87-e574-4db1-8010-f8bcc5ecfa52",
                                                "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                                "text": "\"Sorry. Asking uncomfortable questions at the most inopportune time is an occupational hazard.\""
                                            },
                                            {
                                                "example_id": "b1830c60-d124-4e97-ad87-7a4ab5ae0b53",
                                                "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                                "text": "\"Student crushes are an occupational hazard. Ask any teacher.\""
                                            },
                                            {
                                                "example_id": "90fa6b7a-012f-4c4d-9449-4374d56648b3",
                                                "sense_id": "775f6e80-c32b-347e-8604-bb64e00c9af0",
                                                "text": "Normally I'm a big fan of managers handling performance problems on their staff themselves rather than looking to HR to do it for them, but in this case, since she's putting curses on her manager, I can see an argument for you having a one-time meeting with her and her manager and jointly laying down the law. (Of course, this may just get you added to the list of people she's cursing, but black magic is one of many occupational hazards.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
