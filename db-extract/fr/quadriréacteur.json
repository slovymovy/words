                "senses": [
                    {
                        "sense_id": "419dad11-798e-3500-b384-fa58ac0a3c74",
                        "entry_id": "e3da5602-83d2-3644-a005-62a75419de5e",
                        "glosses": [
                            "Qui a quatre réacteurs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "408ff83c-7993-3e66-96c9-5f9b745e7890",
                        "entry_id": "e3da5602-83d2-3644-a005-62a75419de5e",
                        "glosses": [
                            "Qui peut voler grâce à quatre turboréacteurs."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6494cd45-6154-4a22-a56a-0c414b4cfb62",
                                "sense_id": "408ff83c-7993-3e66-96c9-5f9b745e7890",
                                "text": "Le premier avion à réaction destiné au transport des passagers, le De Havilland Comet quadriréacteur, a effectué son vol d’essai Londres-Tripoli-Londres en 6 h et 36 min, soit une moyenne horaire de 726,66 km."
                            },
                            {
                                "example_id": "6bab4b62-c8ff-480f-af90-081ae3b23dc1",
                                "sense_id": "408ff83c-7993-3e66-96c9-5f9b745e7890",
                                "text": "Le Gouverneur et les principaux ministres du gouvernement, ainsi que l’état-major du conseil militaire montèrent dans l’engin quadriréacteur dont les ailes venaient de pivoter en position verticale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d45f3ae9-552a-4ace-be32-31a62e12a441",
                        "source_entry_id": "e3da5602-83d2-3644-a005-62a75419de5e",
                        "target_lang_word": "vierstrahlig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vierstrahlig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1107814-7563-30e1-a153-2b4a1b9d4170",
                                        "entry_id": "a86f29da-e164-39c0-9e0c-29810b04e5ef",
                                        "glosses": [
                                            "mit vier Strahltriebwerken ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806c4ec4-84aa-47a5-baa7-23c2ade4d608",
                                                "sense_id": "c1107814-7563-30e1-a153-2b4a1b9d4170",
                                                "text": "„Die beiden vierstrahligen Großraumflugzeuge vom Typ Boeing 747 flogen fast parallel zueinander, bewegten sich dabei aber leicht aufeinander zu, während die Besatzungen sich auf die Überquerung des Atlantiks vorbereiteten.“"
                                            },
                                            {
                                                "example_id": "5fc06743-61f6-4048-8250-aa7878843f15",
                                                "sense_id": "c1107814-7563-30e1-a153-2b4a1b9d4170",
                                                "text": "„Unter Experten wird schon länger darüber diskutiert, ob es in Zukunft vierstrahlige Flugzeuge mit 1000 Sitzen geben muss oder ob nicht Großraummodelle mit zwei Triebwerken ausreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
