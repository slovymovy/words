{
    "word_family": [
        "recherche",
        "chercheur",
        "chercheuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "223852be-7fb1-3a6a-8cd3-7caa5d7a1f96",
                    "sense_definition": "Chercher avec soin et méthode pour trouver ou découvrir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques <w>recherchent</w> les causes précises de cette maladie rare."
                        },
                        {
                            "text": "Il passe beaucoup de temps à <w>rechercher</w> une solution efficace à ce problème."
                        }
                    ],
                    "synonyms": [
                        "chercher"
                    ],
                    "common_phrases": [
                        "rechercher une solution",
                        "rechercher la cause"
                    ]
                },
                {
                    "sense_id": "24142b43-db25-3cb9-9268-9cb0878e5dd7",
                    "sense_definition": "Tâcher d'obtenir, viser à se procurer quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise <w>recherche</w> avant tout la rentabilité et la croissance rapide."
                        },
                        {
                            "text": "Après une longue semaine de travail, nous <w>recherchons</w> le calme et le repos."
                        }
                    ],
                    "common_phrases": [
                        "rechercher le calme",
                        "rechercher la simplicité"
                    ]
                },
                {
                    "sense_id": "b7ca2077-ffb9-34f4-ac9e-2304abb95510",
                    "sense_definition": "Faire l'objet de poursuites judiciaires ou d'une traque policière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police <w>recherche</w> activement le suspect en fuite depuis hier soir."
                        },
                        {
                            "text": "Cet individu dangereux est <w>recherché</w> par les forces de l'ordre dans tout le pays."
                        }
                    ],
                    "synonyms": [
                        "chercher"
                    ],
                    "common_phrases": [
                        "recherché par la police"
                    ]
                },
                {
                    "sense_id": "ed8fbcc6-a509-3c24-b105-d1838756e8f3",
                    "sense_definition": "Chercher de nouveau un objet ou une personne qu'on ne trouve pas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une première fouille inutile, j'ai <w>recherché</w> mes lunettes dans toute la maison."
                        },
                        {
                            "text": "Le dossier n'était pas sur la table, il faudra le <w>rechercher</w> demain."
                        }
                    ]
                },
                {
                    "sense_id": "ea8a21c0-2a5b-3ab2-b32d-71990aeef066",
                    "sense_definition": "Désirer fréquenter la compagnie de quelqu'un, ou faire des démarches pour l'épouser.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une personne d'une grande culture dont la haute société <w>recherche</w> le commerce."
                        },
                        {
                            "text": "Dans ce roman classique, plusieurs jeunes gens <w>recherchaient</w> la fille du comte en mariage."
                        }
                    ],
                    "common_phrases": [
                        "rechercher en mariage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de fréquenter ou courtiser quelqu'un en mariage"
                        }
                    ]
                }
            ]
        }
    ]
}