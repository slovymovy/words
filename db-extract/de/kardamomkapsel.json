                "senses": [
                    {
                        "sense_id": "50230a88-9284-3b29-8914-655cb82f299c",
                        "entry_id": "b2c5fcf0-6c29-32cd-b627-c7fc18f3ce12",
                        "glosses": [
                            "einen Kardamomsamen umgebende Hülle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19936946-eb75-4ac6-9680-9d16485ed879",
                                "sense_id": "50230a88-9284-3b29-8914-655cb82f299c",
                                "text": "„Obaid baute sich vor mir auf, hob die Augenklappe an, streckte die Zunge heraus und bot mir seine halb zerkaute Kardamomkapsel an.“"
                            },
                            {
                                "example_id": "c2855e0f-b378-41b3-a1e1-6694e5aaea94",
                                "sense_id": "50230a88-9284-3b29-8914-655cb82f299c",
                                "text": "„Zu diesem Behufe hatten sich alle in das Haus von Ibn Hasd, dem Schuster, begeben, wo sie mit Mandelküchlein und mit Kaffee, der mit Kardamomkapseln gewürzt war und mit Honig gesüßt war, bewirtet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
