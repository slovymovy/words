                "senses": [
                    {
                        "sense_id": "a249d3fe-8342-3341-b987-cb7c407e5dce",
                        "entry_id": "f07bb583-3e83-32c8-b066-44ac407936d5",
                        "glosses": [
                            "Ginkgo biloba, a tree native to China with small, fan-shaped leaves and edible seeds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90400e1-d803-4342-86f3-24e1be42e085",
                                "sense_id": "a249d3fe-8342-3341-b987-cb7c407e5dce",
                                "text": "Like cycads — their gymnosperm relatives — and ferns, the ginkgo produces motile sperm. […] In fact, the tree was originally thought to be extinct in the wild until two populations were located in China. Such native ginkgos remain rare, with a preference for rich, streamside habitats."
                            }
                        ]
                    },
                    {
                        "sense_id": "236a007b-1007-3105-82fa-b50d4cdf57b7",
                        "entry_id": "f07bb583-3e83-32c8-b066-44ac407936d5",
                        "glosses": [
                            "The seed of a ginkgo tree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b4bfca-22c6-4a53-b55f-f3f80f00a774",
                                "sense_id": "236a007b-1007-3105-82fa-b50d4cdf57b7",
                                "text": "I swear the gingko's working in reverse"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1545fc3-f2ee-439a-b799-eb1d4b2f098a",
