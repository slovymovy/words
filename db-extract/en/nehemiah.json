                        "glosses": [
                            "A governor of Judea who was, according to the Tanakh, sent by the king of Persia to rebuild the walls of Jerusalem."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc7d36a-611d-4ff1-b49a-fd5f2e9f42a3",
                                "sense_id": "761f6f07-b45b-3e26-af50-fe4630c19cc8",
                                "text": "Nehemiah stood firm by rejecting the imaginative and wicked spin the enemies put on reality and persisted in what God had called him to do. Then he prayed that, rather than his hands dropping from the work, God would strengthen them in...[…]"
                            }
                        ]
                    },
