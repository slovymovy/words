                "senses": [
                    {
                        "sense_id": "ca03d8a2-e8b4-3a7b-90dd-587f7d3d66de",
                        "entry_id": "da7cd24a-7908-355b-818f-185d5ffccd60",
                        "glosses": [
                            "Wissenschaftler auf dem Gebiet der Paläobiologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a6c81b-936f-4897-bd3e-d91ffdae2b05",
                                "sense_id": "ca03d8a2-e8b4-3a7b-90dd-587f7d3d66de",
                                "text": "„Er ist Paläobiologe und arbeitet beim britischen Polarforschungsprogramm mit.“"
                            },
                            {
                                "example_id": "3593a134-9578-4049-97c6-7c611e21ee08",
                                "sense_id": "ca03d8a2-e8b4-3a7b-90dd-587f7d3d66de",
                                "text": "„Der Paläobiologe kann anhand der Proben zum Beispiel sehen, wie stark die Bäume während der Regenzeiten gewachsen sind.“"
                            },
                            {
                                "example_id": "ad1eb20b-0f29-47c6-a37c-2c72a633c858",
                                "sense_id": "ca03d8a2-e8b4-3a7b-90dd-587f7d3d66de",
                                "text": "„Der britische Paläobiologe Simon Conway Morris verweist beim Thema Aliens gerne darauf, dass die Evolution auf der Erde immer und immer wieder auf dieselben Lösungen verfallen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
