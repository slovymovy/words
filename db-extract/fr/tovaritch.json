                "translations": [
                    {
                        "translation_id": "dc9ba924-ca95-45fb-82d8-ec189d7acc75",
                        "source_entry_id": "66c134c1-9b2b-3fcd-a51a-158c91b37191",
                        "target_lang_word": "tovarich",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tovarich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5789c154-8078-3fef-bafd-eff0273f6de1",
                                        "entry_id": "8f42bd50-4856-31aa-91f4-6c7f086fd8fb",
                                        "glosses": [
                                            "Alternative form of tovarish."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90adfc5-7772-4faf-8fbc-cdc98ca50328",
                                                "sense_id": "5789c154-8078-3fef-bafd-eff0273f6de1",
                                                "text": "Blade gulped and said as steadily as possible, “I'm looking for work, tovarich.”\nThe sneer increased, exposing more of the yellow upper teeth, as the leathery face moved forward to intimidate, “I'm not your tovarich, maggot!”"
                                            },
                                            {
                                                "example_id": "b7939d9b-b5d9-4775-b2d2-38557de8e08e",
                                                "sense_id": "5789c154-8078-3fef-bafd-eff0273f6de1",
                                                "text": "So when he got his hands on that cocaine, he decided to play a little game with the tovarich fellow."
                                            },
                                            {
                                                "example_id": "618f6e48-5928-4bc7-bf54-95bd0d322f82",
                                                "sense_id": "5789c154-8078-3fef-bafd-eff0273f6de1",
                                                "text": "What possible reason would anyone have for sabotaging your parachute, tovarich?"
                                            },
                                            {
                                                "example_id": "7333d022-63ed-46b4-be11-3dd0d6c6e4bd",
                                                "sense_id": "5789c154-8078-3fef-bafd-eff0273f6de1",
                                                "text": "It's our own Russian tovarich, Dimitri, an authority on woodland and shrubs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6e460dd-c006-48a9-a321-8d6e2fee10f6",
                        "source_entry_id": "66c134c1-9b2b-3fcd-a51a-158c91b37191",
                        "target_lang_word": "tovarish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tovarish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                        "entry_id": "caed8438-0933-3bb0-b1de-22bad94b4640",
                                        "glosses": [
                                            "Comrade, especially with reference to the former USSR."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbf7b52-ed28-44bf-afde-eb97cd038c21",
                                                "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                                "text": "Instead of addressing them according to revolutionary etiquette as Tovarish (comrade), he asked them their Christian names and that of their fathers, while telling them his own."
                                            },
                                            {
                                                "example_id": "95c07f40-e6ea-4528-af73-975a683d10e1",
                                                "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                                "text": "Touching one of them on the shoulder, she said, “Tovarish, these tovarishes want to know who you are.”"
                                            },
                                            {
                                                "example_id": "75a44fc8-2b5c-473f-8cd8-42655f25601d",
                                                "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                                "text": "Jensen laughed, “My wife complains: ‘All day long they ring our door bell. Tovarish here, tovarish there. They come from Moscow, from Leningrad, from Berlin and Hamburg. They don't speak one word of Danish. Comrade Jensen, they say, fix us up with Danish passports.’ So it goes.″"
                                            },
                                            {
                                                "example_id": "fd01190e-73ba-4a65-a5b2-71bef6fa7282",
                                                "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                                "text": "His Russian was derived from a fortnight's crash course. \"You'd better see what this ah tovarish thinks he wants.\""
                                            },
                                            {
                                                "example_id": "81f10507-c120-4e73-92c1-01766088b6af",
                                                "sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                                                "text": "The tovarishes bring along their harmonicas and balalaikas, their good voices and their good humor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
