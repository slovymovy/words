{
    "word_family": [
        "kindling",
        "rekindle",
        "enkindle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5b78ef2-3d29-32ac-8333-94cff0f8d303",
                    "sense_definition": "To start a fire or cause something to begin burning.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "ignite_arouse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used dry leaves and twigs to <w>kindle</w> a small fire.",
                            "target_lang_translations": {
                                "ru": "Они использовали сухие листья и ветки, чтобы <w>разжечь</w> небольшой костер.",
                                "zh": "他们用枯叶和细树枝<w>点燃</w>了一小堆火。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>kindle</w> damp wood without extra fuel.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>разжечь</w> сырые дрова без дополнительного топлива.",
                                "zh": "没有多余燃料的情况下，很难<w>点着</w>潮湿的木头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ignite",
                        "light",
                        "start",
                        "set on fire"
                    ],
                    "antonyms": [
                        "extinguish",
                        "douse",
                        "put out",
                        "quench"
                    ],
                    "common_phrases": [
                        "kindle a fire",
                        "kindle a flame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разводить огонь или заставлять что-то гореть.",
                        "zh": "点火；使燃烧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разжигать",
                                "target_lang_sense_clarification": "разводить огонь, костер"
                            },
                            {
                                "target_lang_word": "разжечь",
                                "target_lang_sense_clarification": "развести огонь (сов. вид)"
                            },
                            {
                                "target_lang_word": "зажигать",
                                "target_lang_sense_clarification": "воспламенять"
                            },
                            {
                                "target_lang_word": "растапливать",
                                "target_lang_sense_clarification": "разводить огонь в печи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点燃",
                                "target_lang_sense_clarification": "使着火，点火"
                            },
                            {
                                "target_lang_word": "生火",
                                "target_lang_sense_clarification": "引发火势"
                            },
                            {
                                "target_lang_word": "燃起",
                                "target_lang_sense_clarification": "开始燃烧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fca52312-80ca-32bf-b7fc-193642b34d1f",
                    "sense_definition": "To arouse or inspire a strong emotion, interest, or reaction.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "ignite_arouse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's enthusiastic speech helped <w>kindle</w> an interest in science among the students.",
                            "target_lang_translations": {
                                "ru": "Полная энтузиазма речь учителя помогла <w>пробудить</w> у студентов интерес к науке.",
                                "zh": "老师热情的演讲帮助<w>激发</w>了学生们对科学的兴趣。"
                            }
                        },
                        {
                            "text": "Her mysterious questions <w>kindled</w> his curiosity about the ancient artifact.",
                            "target_lang_translations": {
                                "ru": "Ее загадочные вопросы <w>разжгли</w> его любопытство к древнему артефакту.",
                                "zh": "她那些神秘的提问<w>唤起</w>了他对这件古文物的好奇心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arouse",
                        "inspire",
                        "spark",
                        "provoke",
                        "awaken",
                        "stimulate"
                    ],
                    "antonyms": [
                        "dampen"
                    ],
                    "common_phrases": [
                        "kindle interest",
                        "kindle hope",
                        "kindle enthusiasm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробуждать или вызывать сильную эмоцию, интерес или реакцию.",
                        "zh": "激起或引发某种强烈的感情、兴趣或反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "вызывать интерес или чувства"
                            },
                            {
                                "target_lang_word": "разжигать",
                                "target_lang_sense_clarification": "усиливать эмоции, страсть"
                            },
                            {
                                "target_lang_word": "зажигать",
                                "target_lang_sense_clarification": "воодушевлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激发",
                                "target_lang_sense_clarification": "引起兴趣或情感"
                            },
                            {
                                "target_lang_word": "点燃",
                                "target_lang_sense_clarification": "比喻激发热情、希望等"
                            },
                            {
                                "target_lang_word": "唤起",
                                "target_lang_sense_clarification": "使感情或意识苏醒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b8238d1-2d1a-3125-a9a8-a3edd13a8c2c",
                    "sense_definition": "To give birth to young animals, especially rabbits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit is expected to <w>kindle</w> her litter in the early spring.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что крольчиха <w>окролится</w> ранней весной.",
                                "zh": "预计这只兔子将在初春<w>产仔</w>。"
                            }
                        },
                        {
                            "text": "Breeders monitor the does closely when they are ready to <w>kindle</w>.",
                            "target_lang_translations": {
                                "ru": "Заводчики внимательно следят за самками, когда те готовы <w>окролиться</w>.",
                                "zh": "当母兔准备<w>生产</w>时，饲养员会密切监视。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рожать детенышей (о кроликах).",
                        "zh": "（尤指兔子等小动物）产仔，分娩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окролиться",
                                "target_lang_sense_clarification": "родить (о крольчихе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产仔",
                                "target_lang_sense_clarification": "动物分娩生下幼崽"
                            },
                            {
                                "target_lang_word": "分娩",
                                "target_lang_sense_clarification": "生小动物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0005f2b6-637b-3fd0-907f-0bcd4ec8be86",
                    "sense_definition": "A group of kittens born to the same mother.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found a <w>kindle</w> of kittens sleeping in the barn.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>выводок</w> котят, спящих в сарае.",
                                "zh": "我们在谷仓里发现睡着<w>一窝</w>小猫。"
                            }
                        },
                        {
                            "text": "The mother cat protected her <w>kindle</w> from the loud noise.",
                            "target_lang_translations": {
                                "ru": "Кошка-мать защищала свой <w>выводок</w> от громкого шума.",
                                "zh": "母猫保护着自己的<w>幼崽</w>免受巨响惊扰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "litter"
                    ],
                    "common_phrases": [
                        "a kindle of kittens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа котят, рожденных одной матерью (выводок).",
                        "zh": "一窝幼崽（尤指小猫）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводок",
                                "target_lang_sense_clarification": "группа детенышей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一窝",
                                "target_lang_sense_clarification": "同一次出生的一群幼崽"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ef26d3fa-b784-3696-a611-ba9b3710ff33",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Kindle</w> has lived in this neighborhood for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Киндл</w> живет в этом районе уже двадцать лет.",
                                "zh": "<w>金德尔</w>先生在这个街区已经住了二十年。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Kindle</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У меня назначен прием у доктора <w>Киндла</w> завтра утром.",
                                "zh": "我明天上午约了<w>金德尔</w>医生。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "金德尔（姓氏）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Киндл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金德尔",
                                "target_lang_sense_clarification": "姓氏译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}