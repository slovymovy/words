                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                        "entry_id": "00b6d2e1-7f0f-34f5-b014-22779dae974f",
                        "glosses": [
                            "iets dat geen zin (nut) heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7bbd3f-8b2a-43b3-9765-89697275cfa0",
                                "sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                                "text": "Sommigen vinden het schrijven voor WikiWoordenboek een zinloze bezigheid."
                            },
                            {
                                "example_id": "64d92b33-16ac-4398-8eb2-4a9c81ed10c9",
                                "sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                                "text": "Gedurende het dappere maar zinloze verzet brachten ze drie Duitse kruisers en meerdere torpedojagers tot zinken, vooral in het noorden leden de Duitsers zware verliezen."
                            },
                            {
                                "example_id": "152c7a5f-ebbc-4df0-ae90-86a2afa74461",
                                "sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                                "text": "Als gevolg hiervan was het een zinloos project, dat rond deze tijd grote delen van buitenparlementair links in West-Europa kenmerkte, om te proberen deze tot zwijgen gebrachte arbeidersklasse te mobiliseren tot een socialistische revolutie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "749d8151-3a02-487f-8f4b-2e38303955c2",
                        "source_entry_id": "00b6d2e1-7f0f-34f5-b014-22779dae974f",
                        "source_sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                        "source_sense_description": "iets dat geen zin (nut) heeft",
                        "target_lang_word": "sinnlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinnlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                        "entry_id": "2cd01182-ae14-3652-b530-3a45f4800aa4",
                                        "glosses": [
                                            "ohne Sinn seiend, eine inhaltsleere oder unüberlegte Aussage seiend, ohne Zusammenhang seiend, sich auf fehlenden Sinn beziehend, ohne Zweck, ohne Vernunft seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e9c041-aa52-44dd-bcff-c05566982d02",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "Jede sinnlose Aussage ist sinnfrei. Nicht jede sinnfreie Aussage ist jedoch sinnlos. Denn sowohl „sinnfrei“ als auch „sinnlos“ bedeutet ‚ohne Sinn‘."
                                            },
                                            {
                                                "example_id": "2f991709-c24d-48c0-9761-3a4b55ffcb7a",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "Gegen Windmühlenflügel zu kämpfen ist sinnlos."
                                            },
                                            {
                                                "example_id": "a2c65544-968e-4509-af99-4867f78a3ede",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Wohl fielen die Inschriften auf den Denkmälern den Arabern auf; allein deren Deutungsversuche kamen über sinnlose Phantastereien nicht hinaus.“"
                                            },
                                            {
                                                "example_id": "6cee22e8-70a7-41ab-a5b8-47a7c8387022",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Die Beschäftigung mit dem Totenreich der Vergangenheit ist sinnlos, wenn sie nicht der Sinngebung der lebendigen Gegenwart dient.“"
                                            },
                                            {
                                                "example_id": "247da6a3-87ab-4b5e-80d1-224a5c9b74b7",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Die Schlachten zwischen Österreichern und Italienern zählen zu den blutigsten und sinnlosesten der europäischen Kriegsgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08f6834e-8967-44b6-99d3-4c3b08876cbe",
                        "source_entry_id": "00b6d2e1-7f0f-34f5-b014-22779dae974f",
                        "source_sense_id": "cd119a5e-1623-3c31-82f4-d8981cbcf7b6",
                        "source_sense_description": "iets dat geen zin (nut) heeft",
                        "target_lang_word": "useless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Without use or possibility to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d175fa6f-2a60-45fc-a2e8-111de79cbdaa",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "This fork's prongs are bent. It's useless now."
                                            },
                                            {
                                                "example_id": "a4286ea4-9aa2-4365-8c8a-bc30181c9c71",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unhelpful, not useful; pointless (of an action)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20054cb-dfff-4314-a444-ed39adc34f8c",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I think it's useless to keep this discussion going. It's like talking to a brick wall."
                                            },
                                            {
                                                "example_id": "4c91d144-b3f0-4d4b-9751-fd698afdb7c4",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I tried my best to make him quit smoking, but my efforts were useless. He now smokes six packs a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Good-for-nothing; not dependable."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e7ffd5-78c9-4edf-8e3d-b659f4630d37",
                                                "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                                "text": "Bill never mows the lawn, takes out the trash or anything. He's useless, but I love him anyways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unable to do well at a particular task or thing. Useless is mildly insulting."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd42613c-721a-4d51-8927-6d02a9d9ff19",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "My brother is useless at most computer games, but he is an awesome PS2 player."
                                            },
                                            {
                                                "example_id": "4c07a921-0837-4a35-adbf-28318b15deba",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "Why do you keep trying? You're obviously useless at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
