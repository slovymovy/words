                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "A destructive rampage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32355ea1-cb39-44a2-b421-e7b775ddea3b",
                                                "sense_id": "f6d2d24d-805c-390e-856e-8715ecf5948f",
                                                "text": "The Lords acknowledge the great and happy Providence of Almighty God, in the preventing of ſo horrid an Outrage, which might have endangered the Lives of the Chief Magiſtrates, and alſo hazarded the Spoil of the whole City of London."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
