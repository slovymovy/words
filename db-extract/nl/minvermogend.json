                ],
                "senses": [
                    {
                        "sense_id": "4586fdfb-252d-3c24-8092-74810c0c1308",
                        "entry_id": "49020fc1-c5d6-346e-8c8f-913365a5d6d1",
                        "glosses": [
                            "heel weinig geld te besteden hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46ac54d-58ca-47e0-bd0f-f9e3eda76845",
                                "sense_id": "4586fdfb-252d-3c24-8092-74810c0c1308",
                                "text": "Enschede meent een wapen te hebben gevonden om minvermogende stadsgenoten uit de schulden te houden/helpen. Het heet Wonen+. In een proef die in september begint neemt de Stadsbank de financiële regie over in dertig huishoudens in Pathmos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c554e33c-cf36-40e7-99d3-0eacffe5ee51",
                        "source_entry_id": "49020fc1-c5d6-346e-8c8f-913365a5d6d1",
                        "source_sense_id": "4586fdfb-252d-3c24-8092-74810c0c1308",
                        "target_lang_word": "poor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "With no or few possessions or money, particularly in relation to contemporaries who do have them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be108ca-1d49-4bea-bcc7-e25b6d934df6",
                                                "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                                "text": "We were so poor that we couldn't afford shoes."
                                            },
                                            {
                                                "example_id": "2885edaf-a712-4436-a605-190513f5005e",
                                                "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                                "text": "England is growne to ſuch a paſſe of late,\nThat rich men triumph to ſee the poore beg at their gate."
                                            },
                                            {
                                                "example_id": "4dcaa133-d5d5-493b-bd71-29556191de04",
                                                "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                                "text": "When Owenism and Chartism had burned themselves out, England had become poorer by that substance out of which the Anglo-Saxon ideal of a free society could have been built up for centuries to come."
                                            },
                                            {
                                                "example_id": "caecf336-91e2-46cd-b148-5210ecd6e722",
                                                "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                                "text": "The poorest of the poor are truly destitute, with so few assets they are basically shackless."
                                            },
                                            {
                                                "example_id": "d1c347f6-46eb-46c2-9948-dcd358158ac6",
                                                "sense_id": "2827b164-d0ba-3764-b4a9-69dcb955cd7e",
                                                "text": "Durable goods can be cost-effective but make great disease vectors, and disposables like syringes and needles can be a problem in the poorest places, where there's desperate need of vaccines for diseases like polio. That's where the UCSD scientists come in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197bedad-4c7b-3f61-868d-14da6b2aa3c6",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "Of low quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67630773-bedb-4635-8cb0-eef33632568c",
                                                "sense_id": "197bedad-4c7b-3f61-868d-14da6b2aa3c6",
                                                "text": "That was a poor performance."
                                            },
                                            {
                                                "example_id": "29c2b15a-3d7a-460a-b071-84495b8dcb61",
                                                "sense_id": "197bedad-4c7b-3f61-868d-14da6b2aa3c6",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            },
                                            {
                                                "example_id": "5d14dee2-f0df-4131-aa44-f5bcae593f76",
                                                "sense_id": "197bedad-4c7b-3f61-868d-14da6b2aa3c6",
                                                "text": "Meanwhile, due to a lack of wind, air quality in west Taiwan was poor yesterday, the Environmental Protection Administration said. Air quality could deteriorate early this morning, triggering a “red” alert — which signals unhealthy air quality — in some parts of Yunlin, Chiayi and Tainan counties, it said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "164b3347-2789-3ec3-ba6e-d764430b3e0e",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "Worthy of pity."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f198e8ce-97d4-4e19-89a8-294f9f5694aa",
                                                "sense_id": "164b3347-2789-3ec3-ba6e-d764430b3e0e",
                                                "text": "Oh, you poor thing, you're drenched!"
                                            },
                                            {
                                                "example_id": "52ecb70d-6195-4d3a-9720-d93190ff918d",
                                                "sense_id": "164b3347-2789-3ec3-ba6e-d764430b3e0e",
                                                "text": "This poor little puppy got a nasty snake bite."
                                            },
                                            {
                                                "example_id": "4854f79b-3c44-4e6b-ae96-9ba2a223fb0c",
                                                "sense_id": "164b3347-2789-3ec3-ba6e-d764430b3e0e",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "d3dcae05-01ae-4f02-8769-20c670b6f15f",
                                                "sense_id": "164b3347-2789-3ec3-ba6e-d764430b3e0e",
                                                "text": "Mr. Campion sighed. ‘Poor man,’ he said. ‘He sees his great sacrifices rejected by the gods, and so, no doubt, all the Misses Eumenides let loose again to plague him.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d99b11b-d0fb-3337-847d-f328fd877c22",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "Deficient in a specified way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7962ed-72f3-41e8-9b89-971c2e473609",
                                                "sense_id": "6d99b11b-d0fb-3337-847d-f328fd877c22",
                                                "text": "Cow's milk is poor in iron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f39d9556-afbd-3943-95ad-1e53b7372fc1",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "Inadequate, insufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef13e75-5712-448a-a27f-23f8e469d436",
                                                "sense_id": "f39d9556-afbd-3943-95ad-1e53b7372fc1",
                                                "text": "I received a poor reward for all my hard work."
                                            },
                                            {
                                                "example_id": "7c3c4d94-c63c-42f6-8069-3d8120fd6599",
                                                "sense_id": "f39d9556-afbd-3943-95ad-1e53b7372fc1",
                                                "text": "That I have wronged no Man, will be a poor plea or apology at the last day."
                                            },
                                            {
                                                "example_id": "28dc3c9a-7ead-44a4-a87a-dc6c9400aae4",
                                                "sense_id": "f39d9556-afbd-3943-95ad-1e53b7372fc1",
                                                "text": "The temptation was more than mortal heart could resist. She gave him the promise he sought, stifling the voice of conscience; and as she clung to his neck it seemed to her that heaven was a poor thing compared with a man's love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f640494-f4de-3d98-b88e-385f5b2a959a",
                                        "entry_id": "17d7ef2c-9f72-35cc-b419-c141800066d5",
                                        "glosses": [
                                            "Free from self-assertion; not proud or arrogant; meek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6b7a92-23ba-466c-8357-1d7b610f428a",
                                                "sense_id": "7f640494-f4de-3d98-b88e-385f5b2a959a",
                                                "text": "Blessed are the poor in spirit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                        "entry_id": "65ac1525-c548-322b-9392-4a2bf48dd667",
                                        "glosses": [
                                            "The poor people of a society or the world collectively, the poor class of a society."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ceee28-9c34-4871-9e1c-c3a797c41149",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "...when his disciples saw it, they had indignation, saying, To what purpose is this waste? For this ointment might haue bin sold for much, and giuen to the poore. When Iesus vnderstood it, he said vnto them, Why trouble ye the woman? for she hath wrought a good worke vpon me. For ye haue the poore alwayes with you, but me ye haue not alwayes."
                                            },
                                            {
                                                "example_id": "e3e06db5-1e74-46b2-b30a-494681b0e1a3",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "Harry Truman used to say that 13 or 14 million Americans had their interests represented in Washington, but that the rest of the people had to depend on the President of the United States. That is how I felt about the 35 million American poor. They had no voice and no champion. Whatever the cost, I was determined to represent them. Through me they would have an advocate and, I believed, new hope."
                                            },
                                            {
                                                "example_id": "6711389b-f2e6-41c8-969f-2588c14db9c9",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "Then there have not always been proletarians?\nNo. There have always been poor and working classes; and those who worked were almost always the poor. But there have not always been proletarians, just as competition has not always been free."
                                            },
                                            {
                                                "example_id": "e4a65289-0a36-452a-a591-e53f60127617",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "He is glad to see me and tells me that during his absence from the parish one of the women beggars died. Usually in these cases the state comes and takes the body away in a bag, to incinerate, but this time, because of his teachings, the other poor decided that she deserved a real funeral."
                                            },
                                            {
                                                "example_id": "a079fb6e-535f-4406-adf2-773ebda83fda",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "This is the same Randian bullshit that we've been hearing from people like Brooks for ages and its entire premise is really revolting and insulting—this idea that the way society works is that the productive \"rich\" feed the needy \"poor,\" and that any attempt by the latter to punish the former for \"excesses\" might inspire Atlas to Shrug his way out of town and leave the helpless poor on their own to starve. That's basically Brooks's entire argument here. Yes, the rich and powerful do rig the game in their own favor, and yes, they are guilty of \"excesses\"—but fucking deal with it, if you want to eat."
                                            },
                                            {
                                                "example_id": "feb3ea55-3c4e-4bec-8119-6bf42b594257",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "The sun shines on the rich and the poor alike but, come the rain, the rich have better umbrellas."
                                            },
                                            {
                                                "example_id": "f880f02d-dccc-4e0d-b747-a3322c0501f9",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "The poor are always with us."
                                            },
                                            {
                                                "example_id": "da2cbb7b-582e-4214-abc9-18705092210d",
                                                "sense_id": "9e161795-03eb-34f4-b352-ebf4a6d71255",
                                                "text": "The rich are often so insulated from reality that they think the poor have extra money they could save for more than a short time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                        "entry_id": "6157bc4b-e3d1-3b76-beda-5336e8992592",
                                        "glosses": [
                                            "A poor person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e47b9aa0-92eb-409a-807e-836afc9056d5",
                                                "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                                "text": "The poors are at it again."
                                            },
                                            {
                                                "example_id": "ab702148-a0db-40d3-8cec-00a5700bd881",
                                                "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                                "text": "...me vint of ane king to huam a poure acsede ane peny..."
                                            },
                                            {
                                                "example_id": "1cfe6cef-e55b-4293-a7b2-6b6aef13460f",
                                                "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                                "text": "He had given somewhat to every poore in the Parish."
                                            },
                                            {
                                                "example_id": "16ef5c72-93e6-4151-9676-6865ae9984fd",
                                                "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                                "text": "So what happened? It’s fun to point the finger. Some say it was the poors, or the uneducateds, or even the third-party voters. No matter the scenario, it’s always fun to blame someone else and throw up your hands (while a finger on each is pointed of course)."
                                            },
                                            {
                                                "example_id": "0dac71d8-ae5d-41ff-a93f-6b1972032fef",
                                                "sense_id": "41cf665f-e96a-3348-8ab7-54a175470981",
                                                "text": "I don't understand, Simmons! I have all the money in the world, but I'm still unhappy! […] It must be the poors! Those leeches have been stealing my happiness somehow!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "648089f9-955c-305f-ab66-6b7dcdcc19a5",
                                        "entry_id": "6157bc4b-e3d1-3b76-beda-5336e8992592",
                                        "glosses": [
                                            "Synonym of poor cod."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "poor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd4f7f8-8f8d-34f9-9327-bc6de9382fc4",
                                        "entry_id": "a5c7c758-447d-3703-94f0-e63813c8b83d",
                                        "glosses": [
                                            "Synonym of impoverish, to make poor."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a3481b-9a7c-47aa-ada3-11a251686537",
                                                "sense_id": "cdd4f7f8-8f8d-34f9-9327-bc6de9382fc4",
                                                "text": "It is very evident that Americans are being ‘poored down’ to suit the world socialist agenda, and to maximize profits for the international corporations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea6e0ee-70ac-3650-9410-6ddef78e55e5",
                                        "entry_id": "a5c7c758-447d-3703-94f0-e63813c8b83d",
                                        "glosses": [
                                            "To become poor."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06269b24-f5b8-450d-92eb-cda6c6c40f2b",
                                                "sense_id": "1ea6e0ee-70ac-3650-9410-6ddef78e55e5",
                                                "text": "The mone of this realme is born out in gret quantite and the realme puryt of the sammyn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4974ad-e664-3257-896e-ef3af6008f64",
                                        "entry_id": "a5c7c758-447d-3703-94f0-e63813c8b83d",
                                        "glosses": [
                                            "To call poor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c025bbe-c399-469d-b9a5-11f0feb89ff6",
                                                "sense_id": "2c4974ad-e664-3257-896e-ef3af6008f64",
                                                "text": "Miss Lavinia... put in that she didn't want to be ‘poored by pa,’ or anybody else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
