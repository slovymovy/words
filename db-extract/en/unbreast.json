                        "examples": [
                            {
                                "example_id": "996a3188-c7ca-41b7-b13b-6efda571d3e5",
                                "sense_id": "b101d94b-9582-3f45-9ca3-95752d1c6a18",
                                "text": "Could'st thou unmask their pomp, unbreast their heart"
                            },
                            {
                                "example_id": "2cbc9bec-4a4f-455d-96c7-4dcfc27705f3",
                                "sense_id": "b101d94b-9582-3f45-9ca3-95752d1c6a18",
                                "text": "Alas! the wings of Hope, that soar elate, / On earth fall quivering, soon to faint, and cease, / Leaving the unbreasted clouds to darken and increase."
                            }
                        ]
                    }
