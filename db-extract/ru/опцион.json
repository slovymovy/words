                    },
                    {
                        "translation_id": "f5cd5d10-1a32-491d-babe-bac07fff6858",
                        "source_entry_id": "198810df-6387-32dc-864c-c988e89a6219",
                        "target_lang_word": "Option",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Option",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                        "entry_id": "30e1070b-cb16-3b34-a797-b7052b327774",
                                        "glosses": [
                                            "Auswahlmöglichkeit, Alternative: die Möglichkeit eine Auswahl zwischen verschiedenen Angeboten treffen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fd47a8-80c9-409f-8d50-a47b77a9cd6f",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "Du hast jetzt zwei Optionen: Ihn fragen, oder es sein lassen."
                                            },
                                            {
                                                "example_id": "6f34c587-22b6-456e-992a-de74e45492c5",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "Wir hatten auch einen extremen Segeltörn im Oktober im Auge. Aber davon haben uns die Experten wegen des Wetters abgeraten. Auch Wandern auf dem Montblanc war eine Option."
                                            },
                                            {
                                                "example_id": "57ff8bc0-dae8-4dff-8150-1ce6e810ca38",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Es ist keine Option, den Nazis und Völkischen nun einfach das Feld zu überlassen, weil sie gewaltvoller sind. Es ist auch keine Option, sie zu umwerben und zu verharmlosen und dann jedes Mal wieder überrascht zu sein, wenn sie schießen.“"
                                            },
                                            {
                                                "example_id": "606647bc-dd29-4838-957b-954e20f93e81",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Sie plädierten für eine zweite Option, und Truman schloss sich ihnen an: die Invasion.“"
                                            },
                                            {
                                                "example_id": "9e67c158-e5ab-4f91-9e36-ad90ad960576",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Eine solche Option hatten Juden nicht.“"
                                            },
                                            {
                                                "example_id": "b011e232-37fb-4444-a77a-360c338d2ddb",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Die Option war ihr noch gar nicht in den Sinn gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                        "entry_id": "30e1070b-cb16-3b34-a797-b7052b327774",
                                        "glosses": [
                                            "bedingtes Termingeschäft: das Recht, eine bestimmte Sache zu einem späteren Zeitpunkt zu einem vereinbarten Preis zu kaufen oder zu verkaufen"
                                        ],
                                        "tags": [
                                            "Finanzwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8544345c-d52b-4b3b-b6fc-a0a265d9e4d0",
                                                "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                                "text": "Für den geregelten Handel mit Optionen ist es Voraussetzung, dass die Basiswerte an liquiden Märkten gehandelt werden, um jederzeit den Wert der Option ermitteln zu können."
                                            },
                                            {
                                                "example_id": "c83ac810-cea3-45ee-b0af-0c4dd4033c4c",
                                                "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                                "text": "Für etwas Bewegung sorgte indes der auch \"Hexensabbat\" genannte dreifache Verfallstermin, an dem viermal im Jahr der letzte Handelstag aller vier Derivate-Typen, also der Optionen und Futures auf Indizes und einzelne Aktien, auf den gleichen Tag fällt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
