                                "target_senses": [
                                    {
                                        "sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                                        "entry_id": "1aabab09-9651-3375-a432-25fe5e4ddf60",
                                        "glosses": [
                                            "Se dit d’une fonction qui a exactement le même résultat qu’on l’appelle une fois ou plusieurs : fof=f,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5921da6f-ddd8-4089-ae23-f8d23b4b371e",
                                                "sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                                                "text": "Mais ici apparaît une différence avec tous les opérateurs modaux ; “très très grand” n’est pas équivalent à “très grand”. L’opérateur “très” n’est pas idempotent…"
                                            },
