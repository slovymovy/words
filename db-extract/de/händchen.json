                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                        "entry_id": "f9ba0ab0-feed-3de6-a24e-ea1c4f0bc7f4",
                        "glosses": [
                            "kleine Hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39d4d7c-611d-46a8-b018-362bae7ef183",
                                "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                                "text": "Am entzückendsten fand ich die kleinen Händchen des Babys."
                            },
                            {
                                "example_id": "dc26ab09-b0ae-4de1-a211-72325720f9ab",
                                "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                                "text": "„Selbst im Winter war klar, dass Tante Maria ihr grünes Händchen von ihrer Mutter geerbt hatte.“"
                            },
                            {
                                "example_id": "de2aac79-ec8e-4e73-af4d-2baec1c70f5a",
                                "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                                "text": "„Die Kinder auf der Lagerstatt fuchtelten mit den Händchen und strampelten mit den Füßchen.“"
                            },
                            {
                                "example_id": "e4a2e39b-38b4-4254-8d6e-dbacf440d538",
                                "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                                "text": "„Die Herrschaft hatte ihr verboten, die Kleine abends zu den Betstunden mitzunehmen, doch jedesmal, bevor sie ging, jagte sie die arme Kleine aus dem Bett, ließ sie im getüpfelten Nachthemdchen die Händchen falten, lange auf dem Fußboden knien, Bußreime über Jesus aufsagen, darin sie eine Unmenge begangener Verbrechen zugab, und den Heiland anflehen, an ihr keine Rache zu nehmen.“"
                            },
                            {
                                "example_id": "9fb087cd-48f4-426f-8e9e-a92cf0b2af35",
                                "sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                                "text": "„Er faltete die rosigen, fetten Händchen und senkte den rosigen, dicken Kopf mit den blonden Haaren, den blonden Augenbrauen und dem blonden Bärtchen am Kinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eee9b75d-a443-4cad-b169-e5308f2c6d67",
                        "source_entry_id": "f9ba0ab0-feed-3de6-a24e-ea1c4f0bc7f4",
                        "source_sense_id": "bd44d41a-c53e-3385-92a8-d226947eb988",
                        "source_sense_description": "kleine Hand",
                        "target_lang_word": "menotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2d5836-b2f5-3d42-9c20-90f5229f90d8",
                                        "entry_id": "84143083-ff3c-3c3f-873e-70508cb4f3fe",
                                        "glosses": [
                                            "Main d’un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca47c4bc-10af-45e3-9361-be097a29e46c",
                                                "sense_id": "3b2d5836-b2f5-3d42-9c20-90f5229f90d8",
                                                "text": "La demoiselle couvrait de baisers les menottes brûlées et pleurait aussi ; sur son visage blanc, de grosses larmes claires coulaient qu’elle n’essayait point de retenir."
                                            },
                                            {
                                                "example_id": "cbd9724b-f3c3-42fe-be5e-8531bc4ab8a4",
                                                "sense_id": "3b2d5836-b2f5-3d42-9c20-90f5229f90d8",
                                                "text": "Quand ce mot lui fut remis, quelques instants après, Ulrich se fit l’effet d’un enfant que l’on congédie en lui glissant dans la menotte un morceau de chocolat."
                                            },
                                            {
                                                "example_id": "c644d625-c7af-4b38-83ad-e0086eef29ca",
                                                "sense_id": "3b2d5836-b2f5-3d42-9c20-90f5229f90d8",
                                                "text": "Ah, nous voilà enfin tous réunis, bien sages, faisant ce qu’auraient approuvé nos parents, nous voilà donc enfin tous là, convenables, chantant en chœur comme de braves enfants qu’une grande personne invisible surveille pendant qu’ils font la ronde gentiment en se donnant une menotte triste et moite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e28646-cfc4-3e4b-8c3c-ef6424d52577",
                                        "entry_id": "84143083-ff3c-3c3f-873e-70508cb4f3fe",
                                        "glosses": [
                                            "Lien de fer ou de corde qu’on met aux poignets d’un prisonnier, d’un malfaiteur, pour lui ôter l’usage des mains. → voir menottes"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9ee613-299e-4b69-8c8a-c260c8a8d6e0",
                                                "sense_id": "f4e28646-cfc4-3e4b-8c3c-ef6424d52577",
                                                "text": "Juanita avait fait savoir qu’elle ne voulait pas voir son fils menottes aux mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b33cc7c3-7fbf-3979-8cfd-2874a9a99cb0",
                                        "entry_id": "84143083-ff3c-3c3f-873e-70508cb4f3fe",
                                        "glosses": [
                                            "Demi-anneau en fer, dont la partie non fermée est traversée par un boulon à tête et écrou, employé en carrosserie soit comme intermédiaire entre la caisse et le palonnier, soit comme partie de la suspension des véhicules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac957cb-a135-4145-aad2-d6b2f4ab32e6",
                                                "sense_id": "b33cc7c3-7fbf-3979-8cfd-2874a9a99cb0",
                                                "text": "Le demi-ressort peut être droit ; il forme alors le ressort demi-pincette et est relié au ressort d’essieu par un boulon; mais l’allongement inégal dos deux ressorts fait buter le ressort d’essieu contre la menotte, ce qui le rend dur […]"
                                            }
                                        ]
                                    }
                                ]
                            },
