                "senses": [
                    {
                        "sense_id": "0b2b1334-458c-3232-badd-e9b81c3555f3",
                        "entry_id": "468a8107-4745-306a-a381-6602b46cf6b9",
                        "glosses": [
                            "Personne qui est reçue dans quelque corps, dans quelque compagnie, avec une certaine solennité, avec un certain cérémonial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868e168f-b75e-43d3-9303-395844e53c96",
                                "sense_id": "0b2b1334-458c-3232-badd-e9b81c3555f3",
                                "text": "À l’Académie française, le récipiendaire prononce un remerciement et le directeur y fait une réponse."
                            },
                            {
                                "example_id": "b0e4728a-7c24-4689-b04b-785802448e2e",
                                "sense_id": "0b2b1334-458c-3232-badd-e9b81c3555f3",
                                "text": "Je répète donc que si l’on a cru devoir épargner au récipiendaire les épreuves, il y a lieu de lui poser au moins les questions."
                            },
                            {
                                "example_id": "3b3b3310-432c-4864-aaeb-d557d085d41a",
                                "sense_id": "0b2b1334-458c-3232-badd-e9b81c3555f3",
                                "text": "Lorsque le nouveau Grand Septon en aurait fini de faire ânonner leurs vœux solennels aux chevaliers récipiendaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "73b48ab9-dc53-3c9c-ad33-22ce160fbece",
                        "entry_id": "468a8107-4745-306a-a381-6602b46cf6b9",
                        "glosses": [
                            "Personne qui reçoit quelque chose."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e94a7683-86da-4e07-83bf-c50fccf3f0b0",
                                "sense_id": "73b48ab9-dc53-3c9c-ad33-22ce160fbece",
                                "text": "Muhammad Yunus est le récipiendaire du prix Nobel 2006 de la Paix."
                            },
                            {
                                "example_id": "6b7290f5-b1b8-4e90-a906-6e69ce0aaf18",
                                "sense_id": "73b48ab9-dc53-3c9c-ad33-22ce160fbece",
                                "text": "De plus, le récipiendaire du courriel doit avoir une raison de rester inscrit à la liste d’envoi : des offres spéciales, des informations exclusives."
                            }
                        ]
                    }
                ],
