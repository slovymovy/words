{
    "word_family": [
        "imagine",
        "imaginary",
        "imaginative",
        "unimaginable",
        "unimaginative",
        "imagining"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02e47274-73ce-37d0-bf5a-a8a273b43043",
                    "sense_definition": "The ability of the mind to form mental images or concepts of things that are not present to the senses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental faculty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reading books is a great way to develop a child's <w>imagination</w>.",
                            "target_lang_translations": {
                                "ru": "Чтение книг — отличный способ развить <w>воображение</w> ребенка.",
                                "zh": "阅读书籍是培养孩子<w>想象力</w>的好方法。"
                            }
                        },
                        {
                            "text": "The artist used his vivid <w>imagination</w> to create a world full of strange creatures.",
                            "target_lang_translations": {
                                "ru": "Художник использовал свое живое <w>воображение</w>, чтобы создать мир, полный странных существ.",
                                "zh": "这位艺术家运用他丰富的<w>想象力</w>创造了一个充满奇异生物的世界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fancy",
                        "imagining"
                    ],
                    "common_phrases": [
                        "vivid imagination",
                        "active imagination",
                        "lack of imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность разума создавать мысленные образы или концепции вещей, которые не воспринимаются органами чувств в данный момент.",
                        "zh": "大脑形成不在眼前的客观事物或概念的心理图像的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воображение",
                                "target_lang_sense_clarification": "способность мыслить образами"
                            },
                            {
                                "target_lang_word": "фантазия",
                                "target_lang_sense_clarification": "способность воображать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "想象力",
                                "target_lang_sense_clarification": "指构思和创造心理图像的能力"
                            },
                            {
                                "target_lang_word": "想象",
                                "target_lang_sense_clarification": "指在脑海中构思事物的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66657a7b-6a39-396c-9020-81f32c3f15eb",
                    "sense_definition": "The ability to be creative or resourceful in solving problems or creating new things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creativity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef showed great <w>imagination</w> in the way he presented the simple dish.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар проявил большую <w>фантазию</w> в том, как он подал это простое блюдо.",
                                "zh": "厨师在呈现这道简单菜肴的方式上展现了极大的<w>创造力</w>。"
                            }
                        },
                        {
                            "text": "You need to use your <w>imagination</w> to find a solution to this difficult puzzle.",
                            "target_lang_translations": {
                                "ru": "Вам нужно задействовать свое <w>воображение</w>, чтобы найти решение этой сложной головоломки.",
                                "zh": "你需要发挥<w>想象力</w>来找到解决这个难题的方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creativity",
                        "inventiveness",
                        "invention"
                    ],
                    "common_phrases": [
                        "use your imagination",
                        "creative imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность проявлять творческий подход или находчивость при решении проблем или создании чего-то нового.",
                        "zh": "在解决问题或创造新事物时表现出的创造性或机智。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воображение",
                                "target_lang_sense_clarification": "творческий подход"
                            },
                            {
                                "target_lang_word": "фантазия",
                                "target_lang_sense_clarification": "изобретательность"
                            },
                            {
                                "target_lang_word": "креативность",
                                "target_lang_sense_clarification": "творческие способности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造力",
                                "target_lang_sense_clarification": "指产生新颖想法的能力"
                            },
                            {
                                "target_lang_word": "想象力",
                                "target_lang_sense_clarification": "指在解决问题时表现出的构思能力"
                            },
                            {
                                "target_lang_word": "独创性",
                                "target_lang_sense_clarification": "指与众不同的构思能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf48a79f-224d-3e2f-8319-e041881aea42",
                    "sense_definition": "The act of believing something is real or true when it is actually false or just a fantasy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no ghost in the attic; it is just your <w>imagination</w> playing tricks on you.",
                            "target_lang_translations": {
                                "ru": "На чердаке нет привидения; это просто твое <w>воображение</w> играет с тобой злую шутку.",
                                "zh": "阁楼里没有鬼；那只是你的<w>臆想</w>在作祟。"
                            }
                        },
                        {
                            "text": "He thought he heard a voice, but it was merely a figment of his <w>imagination</w>.",
                            "target_lang_translations": {
                                "ru": "Ему показалось, что он слышит голос, но это был лишь плод его <w>воображения</w>.",
                                "zh": "他以为自己听到了声音，但那不过是他<w>幻觉</w>的产物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fancy"
                    ],
                    "common_phrases": [
                        "just your imagination",
                        "figment of imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убежденность в реальности чего-то, что на самом деле является ложным или просто фантазией.",
                        "zh": "将虚假或纯属幻想的事物误认为是真实存在的心理状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воображение",
                                "target_lang_sense_clarification": "домысел или плод фантазии"
                            },
                            {
                                "target_lang_word": "фантазия",
                                "target_lang_sense_clarification": "вымысел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幻觉",
                                "target_lang_sense_clarification": "指虚构的感知"
                            },
                            {
                                "target_lang_word": "臆想",
                                "target_lang_sense_clarification": "指主观的虚构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7066f6-be62-393e-821d-31e36d3c302b",
                    "sense_definition": "A specific mental image or idea that has been created by the mind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental product",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet's <w>imaginations</w> were often filled with divine and mystical themes.",
                            "target_lang_translations": {
                                "ru": "<w>Фантазии</w> поэта часто были наполнены божественными и мистическими темами.",
                                "zh": "这位诗人的<w>幻想</w>中常常充斥着神圣而神秘的主题。"
                            }
                        },
                        {
                            "text": "These strange <w>imaginations</w> kept him awake throughout the long night.",
                            "target_lang_translations": {
                                "ru": "Эти странные <w>образы</w> не давали ему уснуть на протяжении всей долгой ночи.",
                                "zh": "这些奇怪的<w>构想</w>让他整晚辗转难眠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conception",
                        "notion",
                        "imagining"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный мысленный образ или идея, созданные разумом.",
                        "zh": "由大脑创造出的具体心理图像或想法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантазия",
                                "target_lang_sense_clarification": "плод воображения"
                            },
                            {
                                "target_lang_word": "вымысел",
                                "target_lang_sense_clarification": "нечто воображаемое"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "мысленный образ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幻想",
                                "target_lang_sense_clarification": "指脑海中构思出的具体内容"
                            },
                            {
                                "target_lang_word": "构想",
                                "target_lang_sense_clarification": "指脑海中形成的初步想法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}