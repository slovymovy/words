                                    {
                                        "sense_id": "d03524ea-2b05-3f8d-a864-cf0da8cc9db1",
                                        "entry_id": "47948601-85c0-3c01-a613-cbae85ee509c",
                                        "glosses": [
                                            "A review of one's thoughts, words, actions, and omissions for the purpose of ascertaining conformity with, or deviation from, the moral law."
                                        ],
