            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89b6a3f1-d5c7-36f9-9c88-f72a1e90829e",
                    "sense_definition": "iets nieuws bedenken of creëren met de eigen fantasie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creativiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen kunnen altijd een leuk spelletje <w>verzinnen</w> als ze zich vervelen.",
                            "target_lang_translations": {
                                "en": "The children can always <w>think up</w> a fun game when they are bored."
                            }
                        },
                        {
                            "text": "Je moet een goed plan <w>verzinnen</w> om dit probleem op te lossen.",
                            "target_lang_translations": {
                                "en": "You need to <w>come up with</w> a good plan to solve this problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedenken",
                        "uitdenken",
                        "creëren",
                        "fantaseren"
                    ],
                    "common_phrases": [
                        "een plan verzinnen",
                        "een oplossing verzinnen",
                        "een spelletje verzinnen"
                    ],
                    "target_lang_definitions": {
                        "en": "to think of or create something new using one's own imagination"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to think up",
                                "target_lang_sense_clarification": "to invent a plan or idea"
                            },
                            {
                                "target_lang_word": "to come up with",
                                "target_lang_sense_clarification": "to produce an idea or solution"
                            },
                            {
                                "target_lang_word": "to invent",
                                "target_lang_sense_clarification": "to create something new mentally"
                            },
                            {
                                "target_lang_word": "to devise",
                                "target_lang_sense_clarification": "to plan or invent a complex system or method"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73536c22-9a88-3948-ac55-55184282ace8",
                    "sense_definition": "iets onwaars of fictiefs vertellen om iemand te misleiden of te vermaken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fictie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest snel een smoesje <w>verzinnen</w> omdat hij te laat op zijn werk kwam.",
                            "target_lang_translations": {
                                "en": "He had to quickly <w>make up</w> an excuse because he arrived late to work."
                            }
                        },
                        {
                            "text": "Het hele verhaal is niet waar; hij heeft het gewoon ter plekke <w>verzonnen</w>.",
                            "target_lang_translations": {
                                "en": "The whole story isn't true; he just <w>made it up</w> on the spot."
                            }
                        }
                    ],
                    "synonyms": [
                        "fabuleren",
                        "liegen",
                        "verdichten"
                    ],
                    "common_phrases": [
                        "een smoesje verzinnen",
                        "een verhaal verzinnen",
                        "ter plekke verzinnen"
                    ],
                    "target_lang_definitions": {
                        "en": "to tell something untrue or fictitious in order to mislead or entertain someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to make up",
                                "target_lang_sense_clarification": "to invent a story or excuse"
                            },
                            {
                                "target_lang_word": "to fabricate",
                                "target_lang_sense_clarification": "to invent false information"
                            },
                            {
                                "target_lang_word": "to concoct",
                                "target_lang_sense_clarification": "to invent a story or plan, often a dishonest one"
                            }
                        ]
                    }
                }
            ]
        }
    ]
