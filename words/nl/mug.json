{
    "word_family": [
        "muggenbeet",
        "muggenbult",
        "muggenzifter",
        "muggennet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79e0a41a-c4c5-3ee4-a2fa-f9d545b10788",
                    "sense_definition": "een klein vliegend insect met een dun lichaam en lange poten dat vaak steekt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "insecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kon vannacht niet slapen omdat er een <w>mug</w> in mijn kamer vloog.",
                            "target_lang_translations": {
                                "en": "I couldn't sleep last night because there was a <w>mosquito</w> flying in my room."
                            }
                        },
                        {
                            "text": "In de zomer moet je oppassen voor een vervelende <w>muggenbeet</w> bij het water.",
                            "target_lang_translations": {
                                "en": "In the summer, you have to watch out for an annoying <w>mosquito bite</w> near the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "muskiet",
                        "steekmug"
                    ],
                    "common_phrases": [
                        "last van een mug",
                        "gestoken door een mug"
                    ],
                    "target_lang_definitions": {
                        "en": "a small flying insect with a thin body and long legs that often bites"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mosquito",
                                "target_lang_sense_clarification": "the blood-sucking insect"
                            },
                            {
                                "target_lang_word": "gnat",
                                "target_lang_sense_clarification": "small flying insect"
                            },
                            {
                                "target_lang_word": "midge",
                                "target_lang_sense_clarification": "tiny biting or non-biting fly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdaba990-b07a-33d4-aa22-606d235ca15f",
                    "sense_definition": "een onbeduidend of onbelangrijk persoon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde zich een kleine <w>mug</w> vergeleken met de grote directeuren van het bedrijf.",
                            "target_lang_translations": {
                                "en": "He felt like a little <w>nobody</w> compared to the big directors of the company."
                            }
                        },
                        {
                            "text": "Je moet van een <w>mug</w> geen olifant maken door zo overdreven te reageren.",
                            "target_lang_translations": {
                                "en": "You shouldn't make a mountain out of a <w>molehill</w> by reacting so excessively."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van een mug een olifant maken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in figuurlijke zin of spreekwoorden"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an insignificant or unimportant person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "an unimportant person"
                            },
                            {
                                "target_lang_word": "gnat",
                                "target_lang_sense_clarification": "an annoying or insignificant person"
                            },
                            {
                                "target_lang_word": "nonentity",
                                "target_lang_sense_clarification": "someone of no importance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "058dc0bc-5489-35ee-9e58-5e4696f343a4",
                    "sense_definition": "een afkorting voor Mobiele Urgentiegroep, een medische hulpdienst die ter plaatse komt bij noodgevallen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het zware ongeval op de snelweg was de <w>mug</w> zeer snel ter plaatse.",
                            "target_lang_translations": {
                                "en": "After the serious accident on the highway, the <w>mobile emergency group</w> was on the scene very quickly."
                            }
                        },
                        {
                            "text": "De arts van de <w>mug</w> verleende eerste hulp aan het slachtoffer.",
                            "target_lang_translations": {
                                "en": "The doctor from the <w>emergency medical team</w> provided first aid to the victim."
                            }
                        }
                    ],
                    "synonyms": [
                        "Mobiele Urgentiegroep"
                    ],
                    "common_phrases": [
                        "de mug-dienst"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifiek gebruikt in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "abbreviation for Mobile Urgency Group, a medical emergency service that arrives on-site for emergencies"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mobile emergency group",
                                "target_lang_sense_clarification": "specialized medical emergency team"
                            },
                            {
                                "target_lang_word": "MUG unit",
                                "target_lang_sense_clarification": "emergency medical service in Belgium"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}