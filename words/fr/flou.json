                            {
                                "target_lang_word": "difuso",
                                "target_lang_sense_clarification": "de contornos y bordes"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指照片、图像和轮廓"
                            },
                            {
                                "target_lang_word": "朦胧",
                                "target_lang_sense_clarification": "指远处景物或视线不清"
