                        "sense_id": "5e18b748-f9e6-3de5-ac20-e1ce5fc9ddc2",
                        "entry_id": "5fa7031e-d60e-30f5-bada-75f4cdb35afa",
                        "glosses": [
                            "Krankheit, die durch sich widersprechende Sinneseindrücke bei relativen Körperbewegungen zur Umwelt beispielsweise in einem fahrenden Schiff oder in einem fliegenden Flugzeug induziert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7634c3c4-5101-45d6-916b-f93b8d675fba",
                                "sense_id": "5e18b748-f9e6-3de5-ac20-e1ce5fc9ddc2",
                                "text": "Kinetosen äußern sich in Kopfschmerzen, Schwindel, Brechreiz, Erbrechen und Übelkeit."
                            },
                            {
                                "example_id": "91cbdaa3-55c5-4aca-8258-1d5018fdd996",
                                "sense_id": "5e18b748-f9e6-3de5-ac20-e1ce5fc9ddc2",
                                "text": "„Ein guter Trick gegen Kinetose ist, die Reize auf Augen und Gleichgewichtsorgan so gering wie möglich zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
