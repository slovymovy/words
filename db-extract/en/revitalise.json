                    {
                        "translation_id": "c3380e50-86b0-4f5c-901c-3f5ad2ca2471",
                        "source_entry_id": "534b233b-9fd3-3ad4-b377-cc79ef9d294d",
                        "source_sense_description": "to give new life, energy, activity or success",
                        "target_lang_word": "revivifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revivifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eefbfa4b-e376-381d-bfb3-a0caf5b611ac",
                                        "entry_id": "353d72c1-fbc2-32c5-bee1-03aed7a0ec76",
                                        "glosses": [
                                            "Vivifier de nouveau, redonner la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aee5463-611b-4f81-9c91-c597a6100827",
                                                "sense_id": "eefbfa4b-e376-381d-bfb3-a0caf5b611ac",
                                                "text": "Il était très faible, mais le grand air l’a revivifié."
                                            },
                                            {
                                                "example_id": "b2a4e7a3-d7f5-45a6-8141-961380c04a4e",
                                                "sense_id": "eefbfa4b-e376-381d-bfb3-a0caf5b611ac",
                                                "text": "Ce projet de séjour sous les pins et au bord de la mer l’emplit d’une sorte de nostalgique douceur, comme si toutes les émotions desséchées se revivifiaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2631a38-a273-3137-96db-d6a3489fe95d",
                                        "entry_id": "353d72c1-fbc2-32c5-bee1-03aed7a0ec76",
                                        "glosses": [
                                            "Donner une nouvelle vie spirituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b3063a-a4f7-4e2c-a347-cc9fa75af013",
                                                "sense_id": "b2631a38-a273-3137-96db-d6a3489fe95d",
                                                "text": "[…], le nationalisme […] a partagé cette responsabilité avec le mouvement réformiste islamique antérieur, qui cherchait à revivifier l'islam, comme moyen de résister aux empiétements et aux incursions de la puissance et des idées européennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e17fb85-494a-3af1-bca4-f1d1d97e6e1d",
                                        "entry_id": "353d72c1-fbc2-32c5-bee1-03aed7a0ec76",
                                        "glosses": [
                                            "Remettre en son état naturel, rendre à sa forme métallique, en parlant du mercure."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
