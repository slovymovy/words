        "nl-extract.jsonl": [
            {
                "entry_id": "53231f5c-a229-33aa-9970-620c532f47bf",
                "word": "treuzelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3858d52f-eab2-3ea4-a5f1-95cfc68279a0",
                        "entry_id": "53231f5c-a229-33aa-9970-620c532f47bf",
                        "glosses": [
                            "langzaam lopen, langzaam aan doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda91037-518a-47ca-8195-612e498c1997",
                                "sense_id": "3858d52f-eab2-3ea4-a5f1-95cfc68279a0",
                                "text": "Pas ergens „begin 2017” wil May in Brussel de officiële vertrekprocedure starten (‘artikel 50’). De kritiek aan het thuisfront neemt toe: ze zou treuzelen, een controlfreak zijn die niet durft te delegeren, of ze zegt niets omdat haar ministers het onderling oneens zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfeb0221-7038-3714-9f11-88c3af4256d7",
                        "entry_id": "53231f5c-a229-33aa-9970-620c532f47bf",
                        "glosses": [
                            "precies maar langzaam werken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ecad81ef-4ccf-30f8-8f02-47a8db8cd1b1",
                        "entry_id": "53231f5c-a229-33aa-9970-620c532f47bf",
                        "glosses": [
                            "aarzelen om iets te gaan doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f59dd1a-cabf-4d3d-9f1b-fd9d67f8ad8f",
                                "sense_id": "ecad81ef-4ccf-30f8-8f02-47a8db8cd1b1",
                                "text": "Nadat iedereen filmend en fotograferend langs de pingpongtafel getrokken was, bleven ze allemaal met hun apparatuur in de aanslag staan treuzelen, blik op de gesloten zijdeur naast de rechterlijke desk gericht, alsof daar elk moment, elegant uit zijn graf herrezen, in coltrui en spijkerbroek Steve Jobs kon verschijnen om een postuum ontworpen digitaal speeltje wereldkundig te maken."
                            }
                        ]
                    }
                ],
