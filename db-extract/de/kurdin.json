                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "902981bb-dbf4-401b-b2ea-664bba31b2f2",
                                "sense_id": "42b31eb5-eb66-3a80-a1c0-a35489684157",
                                "text": "Viele Kurdinnen kamen mit ihren Männern nach Deutschland."
                            },
                            {
                                "example_id": "5e29d34a-a999-42d9-b1b3-e49107d06204",
                                "sense_id": "42b31eb5-eb66-3a80-a1c0-a35489684157",
                                "text": "Die Frau, die gestern im Bahnhof gesehen hatte, war eine Kurdin."
                            },
                            {
                                "example_id": "86a0e7c8-d479-4862-a2e7-7ab58a1408ba",
                                "sense_id": "42b31eb5-eb66-3a80-a1c0-a35489684157",
                                "text": "Die meisten Kurdinnen, die ich sehe, tragen Kopftuch."
                            }
                        ],
