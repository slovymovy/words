                "senses": [
                    {
                        "sense_id": "38939e58-6aab-3f92-96a4-e69be2130456",
                        "entry_id": "cb4162c3-818d-3521-8c6f-918b60e158d6",
                        "glosses": [
                            "Direktträgerwein aus dem Südburgenland, welcher wegen der Vernichtung europäischer Weinreben (um 1900) durch die Reblaus durch Veredelung amerikanischer, reblausresistenter Rebstöcke entwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94485e4f-7362-48d6-b0c5-730f5aa691d6",
                                "sense_id": "38939e58-6aab-3f92-96a4-e69be2130456",
                                "text": "Der Uhudler war lange Zeit verboten, wird heutzutage jedoch als Spezialität gehandelt, obwohl er nicht als Qualitätswein bezeichnet werden darf."
                            },
                            {
                                "example_id": "317f7071-0bbb-4791-b838-ccc40d5f6de5",
                                "sense_id": "38939e58-6aab-3f92-96a4-e69be2130456",
                                "text": "Uhudler sollte gut gekühlt getrunken werden."
                            },
                            {
                                "example_id": "aa08761f-1309-4e82-b0b5-8db77ac2fc19",
                                "sense_id": "38939e58-6aab-3f92-96a4-e69be2130456",
                                "text": "„Gott sei Dank haben sich nicht alle Weinbauern davon abhalten lassen, den Uhudler anzupflanzen. Mein Großvater war ein solcher Revolutionär. Und auch wenn er mal hat eine Strafe zahlen müssen, und seine Weinstöcke öffentlich verbrannt worden sind, der Uhudler war nicht auszurotten!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
