                                "target_lang_word": "делаешь",
                                "target_lang_sense_clarification": "общее значение действия"
                            },
                            {
                                "target_lang_word": "вытворяешь",
                                "target_lang_sense_clarification": "совершаешь что-то неожиданное или неприятное"
                            }
                        ]
