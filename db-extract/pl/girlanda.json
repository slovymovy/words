                    },
                    {
                        "translation_id": "42b4d0d1-7160-482a-87e0-11ac29d16287",
                        "source_entry_id": "ce1c4829-6d23-3ee1-b79b-5203e827cd8d",
                        "source_sense_id": "5e171fcf-08b5-3d16-bbf0-cddd1ccc7531",
                        "target_lang_word": "Girlande",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Girlande",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                        "entry_id": "12968f0a-5af6-339b-a387-7b43f53da52d",
                                        "glosses": [
                                            "aus Laub, Blumen, Papier oder Stoffbändern geflochtenes, dekoratives Band"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc3aa68-b4b2-4547-a467-7e8c793c9b4b",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "Der Weihnachtsbaum wird oft mit Girlanden geschmückt."
                                            },
                                            {
                                                "example_id": "589b3a63-46dd-442e-8132-76f0d31482b1",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "Für das Straßenfest schmückten wir die Häuser und die Straßenlaternen mit Girlanden."
                                            },
                                            {
                                                "example_id": "52501774-147e-4916-9406-9e475f7f31c7",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„In der Stube stand ein Vertiko und darauf eine Jesus-Figur aus Gips mit einer Girlande aus Papierrosen und einem Heiligenschein aus Katzengold.“"
                                            },
                                            {
                                                "example_id": "7a65d1b8-f5c8-4a68-8b46-830f2c16adc4",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Die Girlanden vor dem Haus sollen zusätzlich mit bunten Bändern in den Familienfarben geschmückt werden.“"
                                            },
                                            {
                                                "example_id": "8a0eaae8-6116-4576-91a3-0a6f0eb47145",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Im großen Festsaal, am Vormittag von der Hausdame und ihren Mädchen mit einer Fülle von Blumengestecken und Girlanden dekoriert, wurden die Dessert-Teller abgeräumt.“"
                                            },
                                            {
                                                "example_id": "c75e5ebb-4269-41ed-96d6-b88330114716",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Überall hängen Girlanden aus Papier, Fahnen, natürlich schwarzweißrote, und Kränze aus Tannengrün.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fed863ec-0616-473f-963b-49abd30504af",
                        "source_entry_id": "ce1c4829-6d23-3ee1-b79b-5203e827cd8d",
                        "source_sense_id": "5e171fcf-08b5-3d16-bbf0-cddd1ccc7531",
                        "target_lang_word": "гирлянда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гирлянда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "64a9ca0a-b0f9-3f9a-86e9-5f1d62337045",
                                        "entry_id": "2d5b699e-b57b-3237-a225-079d6f2dff4e",
                                        "glosses": [
                                            "декоративное украшение в виде последовательно расположенных повторяющихся элементов, обычно цветов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef1eae6-5d34-4917-aa53-5884e879dbec",
                                                "sense_id": "64a9ca0a-b0f9-3f9a-86e9-5f1d62337045",
                                                "text": "Её каштановые волосы украшала гирлянда искусственных, но искусно выполненных цветов."
                                            },
                                            {
                                                "example_id": "e8904478-6b38-4955-93f6-90108b144e6c",
                                                "sense_id": "64a9ca0a-b0f9-3f9a-86e9-5f1d62337045",
                                                "text": "Листья зашуршали от моего прикосновения, когда я заглянула внутрь, там висела гирлянда, сплетённая из одуванчиков, лежала кучка примятой травы, а по самой середине прорастал ствол берёзки."
                                            },
                                            {
                                                "example_id": "30c6826d-532f-4cee-a22a-c508d7172d5d",
                                                "sense_id": "64a9ca0a-b0f9-3f9a-86e9-5f1d62337045",
                                                "text": "Первым делом — электрическая гирлянда, к каждой её лампочке надо пристроить серебряные розетки, делающие свет загадочным, волшебным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abb0cef-23aa-301e-a21b-907427a8b4b1",
                                        "entry_id": "2d5b699e-b57b-3237-a225-079d6f2dff4e",
                                        "glosses": [
                                            "перен., книжн. ряд подобных элементов, как правило красиво, празднично выглядящих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a225b4b-88bc-46a2-8a03-5fdf49792aaf",
                                                "sense_id": "3abb0cef-23aa-301e-a21b-907427a8b4b1",
                                                "text": "Светящаяся в ста метрах гирлянда иллюминаторов аэробуса «А-300» символизировала свободу перемещения."
                                            },
                                            {
                                                "example_id": "1709f063-09f9-4fe8-bf35-4764f4a7d90a",
                                                "sense_id": "3abb0cef-23aa-301e-a21b-907427a8b4b1",
                                                "text": "В результате довольно привычно было встретить на улице или в метро человека, у которого на шее висела здоровая гирлянда из рулонов туалетной бумаги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d5f995-eb96-368d-9d1f-7545ba14e110",
                                        "entry_id": "2d5b699e-b57b-3237-a225-079d6f2dff4e",
                                        "glosses": [
                                            "перен., спец. ряд последовательно соединённых изоляторов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc66dfe3-c870-43eb-9476-0954c38aa866",
                                                "sense_id": "96d5f995-eb96-368d-9d1f-7545ba14e110",
                                                "text": "А Бережной заученным движением рванул на себя ближайший к нему изолятор и в считанные секунды гирлянду с проводом подцепил к траверсе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
