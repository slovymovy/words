{
    "word_family": [
        "connect",
        "connection",
        "annex"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b6d6f52-38eb-3a0b-92aa-a3b936ad33c6",
                    "sense_definition": "A connection or link between things, people, or events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a clear <w>nexus</w> between poverty and poor health outcomes.",
                            "target_lang_translations": {
                                "ru": "Существует явная <w>связь</w> между бедностью и плохим состоянием здоровья.",
                                "nl": "Er is een duidelijke <w>verbinding</w> tussen armoede en slechte gezondheidsuitkomsten."
                            }
                        },
                        {
                            "text": "Investigators are trying to establish a <w>nexus</w> between the suspect and the crime scene.",
                            "target_lang_translations": {
                                "ru": "Следователи пытаются установить <w>связь</w> между подозреваемым и местом преступления.",
                                "nl": "Onderzoekers proberen een <w>link</w> te leggen tussen de verdachte en de plaats delict."
                            }
                        }
                    ],
                    "synonyms": [
                        "connection",
                        "link",
                        "bond",
                        "tie",
                        "junction"
                    ],
                    "common_phrases": [
                        "nexus between",
                        "causal nexus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связь или соединение между вещами, людьми или событиями.",
                        "nl": "Een verbinding of link tussen dingen, mensen of gebeurtenissen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "соединение, взаимоотношение"
                            },
                            {
                                "target_lang_word": "сцепление",
                                "target_lang_sense_clarification": "взаимосвязь"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verbinding",
                                "target_lang_sense_clarification": "algemene term voor een link of samenhang"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "directe relatie of connectie"
                            },
                            {
                                "target_lang_word": "samenhang",
                                "target_lang_sense_clarification": "logische relatie tussen zaken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37d75bd1-eee3-3157-b678-6ff61a7f5535",
                    "sense_definition": "The central point or focus of a situation or activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bustling market square is the <w>nexus</w> of the town's social life.",
                            "target_lang_translations": {
                                "ru": "Оживленная рыночная площадь — это <w>центр</w> общественной жизни города.",
                                "nl": "Het drukke marktplein is het <w>middelpunt</w> van het sociale leven in de stad."
                            }
                        },
                        {
                            "text": "This university has become a <w>nexus</w> for scientific research and innovation.",
                            "target_lang_translations": {
                                "ru": "Этот университет стал <w>центром</w> научных исследований и инноваций.",
                                "nl": "Deze universiteit is een <w>knooppunt</w> geworden voor wetenschappelijk onderzoek en innovatie."
                            }
                        }
                    ],
                    "synonyms": [
                        "hub"
                    ],
                    "common_phrases": [
                        "nexus of activity",
                        "cultural nexus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная точка, ядро или средоточие ситуации или деятельности.",
                        "nl": "Het centrale punt, de kern of het middelpunt van een situatie of activiteit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "центр",
                                "target_lang_sense_clarification": "главное место, ядро"
                            },
                            {
                                "target_lang_word": "средоточие",
                                "target_lang_sense_clarification": "фокус, место концентрации"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "centrum",
                                "target_lang_sense_clarification": "belangrijkste plaats of kern"
                            },
                            {
                                "target_lang_word": "knooppunt",
                                "target_lang_sense_clarification": "centraal punt waar activiteiten samenkomen"
                            },
                            {
                                "target_lang_word": "middelpunt",
                                "target_lang_sense_clarification": "focus van een activiteit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc570dff-c7ff-3eb6-81ee-8e826de52490",
                    "sense_definition": "A complicated series of connections between different things; a connected group or network.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article exposed a complex <w>nexus</w> of political power and corporate money.",
                            "target_lang_translations": {
                                "ru": "Статья разоблачила сложное <w>сплетение</w> политической власти и корпоративных денег.",
                                "nl": "Het artikel legde een complex <w>netwerk</w> van politieke macht en bedrijfsgeld bloot."
                            }
                        },
                        {
                            "text": "He found himself trapped in a <w>nexus</w> of conflicting obligations.",
                            "target_lang_translations": {
                                "ru": "Он оказался в ловушке <w>сплетения</w> противоречивых обязательств.",
                                "nl": "Hij zat gevangen in een <w>web</w> van tegenstrijdige verplichtingen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nexus of interests",
                        "complex nexus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложная совокупность связей между различными вещами; переплетение или сеть.",
                        "nl": "Een ingewikkelde reeks verbindingen tussen verschillende zaken; een verbonden groep of netwerk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетение",
                                "target_lang_sense_clarification": "сложное переплетение связей"
                            },
                            {
                                "target_lang_word": "совокупность",
                                "target_lang_sense_clarification": "связанная группа"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "netwerk",
                                "target_lang_sense_clarification": "complex geheel van onderlinge relaties"
                            },
                            {
                                "target_lang_word": "samenhang",
                                "target_lang_sense_clarification": "ingewikkelde structuur van verbanden"
                            },
                            {
                                "target_lang_word": "web",
                                "target_lang_sense_clarification": "figuurlijk voor een complex netwerk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a3ffaf4-26d9-32f2-8409-a3ae58e4627a",
                    "sense_definition": "The relationship between a vendor and a jurisdiction that requires the vendor to pay taxes there.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company does not have a sufficient <w>nexus</w> in the state to be taxed.",
                            "target_lang_translations": {
                                "ru": "У компании нет достаточной <w>связи</w> со штатом для налогообложения.",
                                "nl": "Het bedrijf heeft onvoldoende <w>fiscale banden</w> in de staat om belast te worden."
                            }
                        },
                        {
                            "text": "Online retailers must understand the rules of tax <w>nexus</w> in every state they sell to.",
                            "target_lang_translations": {
                                "ru": "Интернет-ритейлеры должны понимать правила <w>налоговой связи</w> в каждом штате, куда они продают товары.",
                                "nl": "Online retailers moeten de regels omtrent <w>belastbare aanwezigheid</w> begrijpen in elke staat waar ze aan verkopen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax nexus",
                        "establish a nexus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношения между продавцом и юрисдикцией, обязывающие продавца платить там налоги.",
                        "nl": "De relatie tussen een verkoper en een rechtsgebied die de verkoper verplicht daar belasting te betalen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налоговая связь",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "для целей налогообложения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "fiscale band",
                                "target_lang_sense_clarification": "juridische term voor belastingplicht"
                            },
                            {
                                "target_lang_word": "belastbare aanwezigheid",
                                "target_lang_sense_clarification": "juridische status voor belastingdoeleinden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}