                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quality of life is <w>significantly</w> higher than it was twenty years ago.",
                            "target_lang_translations": {
                                "ru": "Качество жизни <w>значительно</w> выше, чем двадцать лет назад.",
                                "zh": "现在的生活质量比二十年前<w>显著</w>提高。"
                            }
                        },
                        {
                            "text": "Her health has <w>significantly</w> improved since she started the new treatment.",
                            "target_lang_translations": {
                                "ru": "Её здоровье <w>значительно</w> улучшилось с тех пор, как она начала новое лечение.",
                                "zh": "自从开始新的治疗后，她的健康状况有了<w>显著</w>改善。"
                            }
                        }
                    ],
                    "synonyms": [
                        "way"
                    ],
                    "antonyms": [
                        "slightly",
                        "insignificantly"
                    ],
                    "common_phrases": [
