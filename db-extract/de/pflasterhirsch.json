                "senses": [
                    {
                        "sense_id": "183e9636-1922-3bea-8c1f-22f904eeeec2",
                        "entry_id": "4906b51a-fbd9-3b9d-80c8-16803c902b9c",
                        "glosses": [
                            "Pferd (das ein kleines Fuhrwerk zieht)"
                        ],
                        "tags": [
                            "Vienna",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "60a5a6b6-b1f5-4712-a048-35557b05baf7",
                                "sense_id": "183e9636-1922-3bea-8c1f-22f904eeeec2",
                                "text": "„Gemeint war mit Pflasterhirsch das Zugpferd eines kleinen Fuhrwerks, das im städtischen Bereich, also am Straßenpflaster, verkehrt, manchmal auch das Fuhrwerk selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1c07815-d1be-3ce7-a7eb-1d349f5b6fdc",
                        "entry_id": "4906b51a-fbd9-3b9d-80c8-16803c902b9c",
                        "glosses": [
                            "(hierarchisch niederer) Polizist"
                        ],
                        "tags": [
                            "Vienna",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "130320a0-5c10-406a-b726-c8101fb60064",
                                "sense_id": "e1c07815-d1be-3ce7-a7eb-1d349f5b6fdc",
                                "text": "„Grün wie der Pflasterhirsch, malachitfarben wie die Unterwäsche der Palmersdamen und melonenfarben wie Jesu Vater“"
                            },
                            {
                                "example_id": "bab6d3ca-51e2-48f1-8011-0b7a4bfa80ec",
                                "sense_id": "e1c07815-d1be-3ce7-a7eb-1d349f5b6fdc",
                                "text": "„Wiener „Pflasterhirschen” – Die Bevölkerung hat für die Fußpatrouillen bald einen Kosenamen“"
                            },
                            {
                                "example_id": "e6d3ba58-6cec-49aa-a4ef-d24f8e9e5e11",
                                "sense_id": "e1c07815-d1be-3ce7-a7eb-1d349f5b6fdc",
                                "text": "„Ich bin ja nur ein kleiner Pflasterhirsch. Aber die Pratergeschichte lös ich, ob's krumm oder gerade geht, Kinder.“"
                            },
                            {
                                "example_id": "16c03ae1-fa21-4ddd-b515-268394b4b759",
                                "sense_id": "e1c07815-d1be-3ce7-a7eb-1d349f5b6fdc",
                                "text": "„Ein Pflasterhirsch ist einerseits eine Straßenprostituierte, andererseits ein Polizist auf Fußstreife.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "198d42cd-f529-3db2-81f1-8c592292fa03",
                        "entry_id": "4906b51a-fbd9-3b9d-80c8-16803c902b9c",
                        "glosses": [
                            "Straßenprostituierte"
                        ],
                        "tags": [
                            "Vienna",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9eef264f-6cf5-4b75-8f11-63ff45a37e6d",
                                "sense_id": "198d42cd-f529-3db2-81f1-8c592292fa03",
                                "text": "„Ein Pflasterhirsch ist einerseits eine Straßenprostituierte, andererseits ein Polizist auf Fußstreife.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
