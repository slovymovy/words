                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c79cc63-4e47-30e1-9e1a-363dd5cf4dc8",
                        "entry_id": "0549bd9e-a656-3252-bef5-af541485dcf4",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ac0b33-bf8a-47d4-840d-ce5d5575b674",
                                "sense_id": "5c79cc63-4e47-30e1-9e1a-363dd5cf4dc8",
                                "text": "Le maire, Yannig Robin, s’attend à essuyer d’autres tacles verbaux mais il réfute le carton rouge pour trahison de promesses : « Nous avons toujours été clairs en indiquant une participation municipale de 450 000 € dans ce projet »."
                            },
                            {
                                "example_id": "40bf64a2-341c-467b-ab8d-32e797217702",
                                "sense_id": "5c79cc63-4e47-30e1-9e1a-363dd5cf4dc8",
                                "text": "L’actrice Catherine Deneuve, souvent invitée chez son ami Christophe Robin, le coiffeur coloriste des stars, en encore le réalisateur Jean-Paul Rappeneau y ont également leurs habitudes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00f24a7b-46f9-4707-b3ea-294e6d08b914",
                        "source_entry_id": "0549bd9e-a656-3252-bef5-af541485dcf4",
                        "source_sense_id": "5c79cc63-4e47-30e1-9e1a-363dd5cf4dc8",
                        "target_lang_word": "로빈",
                        "target_lang_code": "ko",
