        "fr-extract.jsonl": [
            {
                "entry_id": "54d05d71-5209-3de6-8cb7-6d85071626f7",
                "word": "contre-espionnage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9de05083-f2fb-49ea-971b-5fa542ec78bd",
                        "entry_id": "54d05d71-5209-3de6-8cb7-6d85071626f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "contre-espionnages"
                    },
                    {
                        "form_id": "820c76b5-fbe8-4983-b75d-a029eb5e0ad3",
                        "entry_id": "54d05d71-5209-3de6-8cb7-6d85071626f7",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "contrespionnage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6e2449b-9dd8-3ba0-bca3-ae73719935db",
                        "entry_id": "54d05d71-5209-3de6-8cb7-6d85071626f7",
                        "glosses": [
                            "Activité qui vise à rechercher, identifier et contrecarrer les activités, traditionnelles ou nouvelles, d'espionnage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3538209-644e-4ef5-ab53-dc8bf9fb7d72",
                                "sense_id": "e6e2449b-9dd8-3ba0-bca3-ae73719935db",
                                "text": "Pressé par son interlocuteur, il se retranche derrière une phrase curieuse : « Voyez-vous, mon cher, entre l'espionnage et le contre-espionnage il n'y a que l'épaisseur d'une feuille de papier à cigarettes (sic). »"
                            },
                            {
                                "example_id": "f43c3d1f-7ce9-4327-884c-8a46c8da04b1",
                                "sense_id": "e6e2449b-9dd8-3ba0-bca3-ae73719935db",
                                "text": "Pourtant, la frontière ayant été fermée trop tard, force fut au chef du contre-espionnage de Bologne de lâcher Soubray à la poursuite des voleurs qu'on savait entrés en Yougoslavie."
                            },
                            {
                                "example_id": "0c17e7e3-45da-4431-b2fe-4085ee31c728",
                                "sense_id": "e6e2449b-9dd8-3ba0-bca3-ae73719935db",
                                "text": "Il est important de comprendre que les enquêtes de contre-espionnage du FBI diffèrent des enquêtes criminelles plus classiques. Le but du Bureau, dans une enquête de contre-espionnage, est de comprendre les méthodes techniques et humaines qu'emploient les puissances étrangères hostiles en vue d’influencer les États-Unis ou de voler nos secrets. Le FBI utilise ces informations pour perturber ces tentatives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2380cdb9-4b49-4d31-ad48-295151d10655",
                        "source_entry_id": "54d05d71-5209-3de6-8cb7-6d85071626f7",
                        "source_sense_id": "e6e2449b-9dd8-3ba0-bca3-ae73719935db",
                        "target_lang_word": "Spionageabwehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spionageabwehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3023b6e-8fd8-3d33-bdc5-c472ad85bfaa",
                                        "entry_id": "70661a76-4e43-3d19-ab79-6cf7f8bf4ff0",
                                        "glosses": [
                                            "Tätigkeiten von Sicherheitsbehörden, fremde Spione im eigenen Land aufzuklären und zu bekämpfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645fb9e5-e4d5-4e68-9d92-32081b6b529b",
                                                "sense_id": "e3023b6e-8fd8-3d33-bdc5-c472ad85bfaa",
                                                "text": "„Dabei stellte sich rasch heraus, dass sie ein hervorragendes Namens- und Zahlengedächtnis hatte, und so wurde sie gleich noch einmal befördert, diesmal zur Analystin bei der Spionageabwehr.“"
                                            },
                                            {
                                                "example_id": "ab225d90-1d7a-4033-b210-2ca93b79fb1a",
                                                "sense_id": "e3023b6e-8fd8-3d33-bdc5-c472ad85bfaa",
                                                "text": "„Später wechselte er zum New York Field Office, wo er sich hauptsächlich mit Spionageabwehr beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
