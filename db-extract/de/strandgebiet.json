                "senses": [
                    {
                        "sense_id": "833c5f7c-f95d-3d5c-91d2-6fff9203c080",
                        "entry_id": "7aaa654d-3a66-37bc-a949-065d17a922d2",
                        "glosses": [
                            "Gegend mit Sand am Meeresufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af87119d-669e-4518-b416-7f6a93722a56",
                                "sense_id": "833c5f7c-f95d-3d5c-91d2-6fff9203c080",
                                "text": "„Das Strandgebiet darf nur von Personen in Anspruch genommen werden, die im Besitz einer gültigen Kur-, Tages- oder Dauerstrandkarte sind.“"
                            },
                            {
                                "example_id": "847a2a52-6fe7-475e-8d2c-29867b647409",
                                "sense_id": "833c5f7c-f95d-3d5c-91d2-6fff9203c080",
                                "text": "„Vielleicht kann die aktive Wärmeregulation, die ich bei den Strandcarabiden zu finden geglaubt habe, als ein wirksamer Faktor eintreten, wenn die Tiere bei hoher Temperatur auf dem Strandgebiete in Aktivität sind.“"
                            }
                        ],
