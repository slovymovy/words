                    },
                    {
                        "translation_id": "b36826ce-4ae0-446c-a270-83eae64487d3",
                        "source_entry_id": "677b8c7a-85b9-3350-a940-93b65660e855",
                        "source_sense_id": "085d0d0e-8d50-3cad-9569-59b0b8054288",
