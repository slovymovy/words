                "senses": [
                    {
                        "sense_id": "69874ab3-8404-34a8-a29f-284e771b5d93",
                        "entry_id": "abec5e14-c525-3fe5-a71e-e14d2962c52e",
                        "glosses": [
                            "beeldhouwwerken gemaakt van bevroren water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2303bdee-b293-48d4-8465-31f83d59fdb7",
                                "sense_id": "69874ab3-8404-34a8-a29f-284e771b5d93",
                                "text": "Het Nederlands IJsbeelden Festival, van zaterdag 12 december tot en met zondag 24 januari, vindt ook dit jaar weer plaats in de 6.500 m² authentieke NS-Loods bij het station van Zwolle. Kunstenaars uit zestien verschillende landen hebben, in combinatie met ’Special effects’ weer gezorgd voor een mooi winters plaatje. Thema van de expositie dit jaar is: ’Journey through a frozen world’. En zoals elke wereldreis begint ook deze op het vliegveld."
                            },
                            {
                                "example_id": "8956b209-5274-4c6b-ae13-21b7d78924a9",
                                "sense_id": "69874ab3-8404-34a8-a29f-284e771b5d93",
                                "text": "De ijssculpturen die worden tentoongesteld tijdens het COOL Event in Scheveningen druppelen ook langzaam weg. Volgens Bram Janson van het evenement kunnen de grote koelers de ijsbeelden door de hoge temperaturen in de tenten niet koud genoeg houden. Belangstellenden moeten dus snel zijn, want de tentoonstelling gaat zaterdag een dag eerder dicht dan gepland."
                            }
                        ]
                    }
