                                        "sense_id": "8c697883-9553-3dd0-b2d1-cf5d27072038",
                                        "entry_id": "3483efbb-7e03-3fb0-a3f9-b80366b90bd0",
                                        "glosses": [
                                            "Qui est d’origine animale ; qui est du fait des animaux."
                                        ],
                                        "tags": [
                                            "Extrêmement rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "442e321d-0895-4fe5-b837-c4b8ceb3ab2f",
                                                "sense_id": "8c697883-9553-3dd0-b2d1-cf5d27072038",
                                                "text": "Les terrains d'origine organique sont phytogènes: exemples, les forêts submergées dans les eaux douces ou salées, les tourbes, l’humus; ou zoogènes, comme les terrains de polypiers, de madrépores, de coraux."
                                            },
                                            {
                                                "example_id": "353c6ed1-ac71-4c75-b3de-a892480793b1",
                                                "sense_id": "8c697883-9553-3dd0-b2d1-cf5d27072038",
                                                "text": "Un petit groupement secondaire d’origine « zoogène » qu’on peut observer au pâquis de Conflans […], et caractérisé par une végétation presque rase d’herbes plus ou moins décombantes."
                                            }
                                        ]
                                    }
                                ]
