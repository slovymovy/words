                            {
                                "example_id": "dc54fba3-92d1-4b0d-b696-07c06c6afe60",
                                "sense_id": "625f015b-ce81-3305-a1cd-f471a2dd4d21",
                                "text": "„Wanderer, kommst du nach Sparta, verkündige dorten, du habest",
                                "translation": "Uns hier liegen gesehn, wie das Gesetz es befahl.“"
                            },
                            {
                                "example_id": "bc388f99-5ced-4fa0-80a4-047aa627f817",
                                "sense_id": "625f015b-ce81-3305-a1cd-f471a2dd4d21",
                                "text": "„Denn die Auskünfte in eigener Sache, die man dorten auf Nachfrage bekommt, sind nicht selten im feinsten Sinne des Dichters kafkaesk.“"
                            },
                            {
                                "example_id": "2f2123cd-53e3-4467-928c-3e8c0a8dc3a1",
                                "sense_id": "625f015b-ce81-3305-a1cd-f471a2dd4d21",
                                "text": "„Er [Wolfgang Schäuble] hat auf Englisch formuliert, worin man dorten [im Südwesten Deutschlands] nicht so zu Hause ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
