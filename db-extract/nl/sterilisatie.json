                                "target_senses": [
                                    {
                                        "sense_id": "1e42ca22-644b-375d-84ae-2bae32322f08",
                                        "entry_id": "7d838abe-5326-3841-aa4c-a4f96311872d",
                                        "glosses": [
                                            "The process of treating something to kill or inactivate microorganisms."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e080826f-d0b2-4bcf-9ed6-8abf69568a5d",
                                                "sense_id": "1e42ca22-644b-375d-84ae-2bae32322f08",
                                                "text": "Heat sterilization is used during canning so the food can be safely stored for long periods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d1fb1e8-c1ff-367f-8620-b48b54d249f8",
                                        "entry_id": "7d838abe-5326-3841-aa4c-a4f96311872d",
                                        "glosses": [
                                            "A procedure to permanently prevent an organism from reproducing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb16bf21-893e-44f7-8fff-7164e459cf52",
                                                "sense_id": "4d1fb1e8-c1ff-367f-8620-b48b54d249f8",
                                                "text": "Spaying a cat is a form of sterilization to limit the population growth."
                                            },
                                            {
                                                "example_id": "e1f2921f-7e41-4326-bc3c-672c11381802",
                                                "sense_id": "4d1fb1e8-c1ff-367f-8620-b48b54d249f8",
                                                "text": "One the most chilling parts of the film, which is available online, involves an appearance by Adolf Hitler. Ferrari shows how America’s sterilization policies inspired Nazi Germany’s leaders to launch their own eugenics program, which later led to genocide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69928cf3-bb1a-31e6-884d-243a9cb99ab4",
                                        "entry_id": "7d838abe-5326-3841-aa4c-a4f96311872d",
                                        "glosses": [
                                            "An instance of a sterilization procedure."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7185722-9440-4ab4-aa51-f1cf1d3f7690",
                                                "sense_id": "69928cf3-bb1a-31e6-884d-243a9cb99ab4",
                                                "text": "The vet performed several sterilizations this week."
                                            },
                                            {
                                                "example_id": "23cbcbf7-808c-48d5-955a-78cf9eb252e6",
                                                "sense_id": "69928cf3-bb1a-31e6-884d-243a9cb99ab4",
                                                "text": "One of the most shocking aspects of the Chinese occupation is the forced sterilization of Tibetan women. In an article on this subject, the ICLT used my photograph of a nomadic woman with her herd of goats in the Ngari region of western Tibet. In many ways this is one of the more idyllic photographs I have taken. It is a wonderfully warm image that captures the woman in the late-day sun while in the distance yak-hair tents are scattered across a dramatic Tibetan landscape. The accompanying text shatters Shangri-la like a bullet through a stained-glass window: “Gross violations of women’s reproductive freedom are not uncommon in Tibet. Some of the most disturbing reports are of ‘blitz’ campaigns of mobile family planning teams, which have gone into remote villages of Tibet and carried out forced abortions and sterilizations of virtually every woman of child bearing age, regardless of the number of children, age, or health. These barbaric practices, says the Chinese Centre for Human Rights and Democracy in Dharamsala, ‘constitute an immediate threat to the survival of Tibetans as a distinct people.'\""
                                            },
                                            {
                                                "example_id": "0371901a-d078-4126-a48a-8830cedf8329",
                                                "sense_id": "69928cf3-bb1a-31e6-884d-243a9cb99ab4",
                                                "text": "The eugenics mania that swept the country in the late 19th and early 20th centuries led to forced sterilizations and the passage of laws in 27 states designed to limit the numbers of those considered genetically unfit: immigrants, Jews, African-Americans, the mentally ill and those deemed “morally delinquent.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35b3735-144f-376f-b368-306850e04dee",
                                        "entry_id": "7d838abe-5326-3841-aa4c-a4f96311872d",
                                        "glosses": [
                                            "A monetary policy operation used to offset a foreign exchange intervention."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55df65d6-865c-4d98-89db-765dc07aa8b5",
                                                "sense_id": "d35b3735-144f-376f-b368-306850e04dee",
                                                "text": "The Federal Reserve is responsible for foreign exchange sterilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d857bb23-6e74-33e5-8bc8-b75309f6535e",
                                        "entry_id": "7d838abe-5326-3841-aa4c-a4f96311872d",
                                        "glosses": [
                                            "The process of permanently rendering a planet like Earth completely uninhabitable to all life, including even microbes, leading to their complete extinction."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d374ef8-56e1-4c52-af34-b31251962336",
                                                "sense_id": "d857bb23-6e74-33e5-8bc8-b75309f6535e",
                                                "text": "In about 1 billion years, the increasing heat from the Sun as it gradually ages, by triggering a runaway greenhouse effect that will boil away the oceans, will lead to the complete sterilization of all life on Earth."
                                            }
                                        ]
                                    }
                                ]
                            }
