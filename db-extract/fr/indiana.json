                                                "sense_id": "00a720fb-1183-3be0-956f-709521e4d6ad",
                                                "text": "13 Jahre lang war Indiana Teil des Nordwestterritoriums."
                                            },
                                            {
                                                "example_id": "dc15f923-7f17-4dfc-84e2-43039a8e51a5",
                                                "sense_id": "00a720fb-1183-3be0-956f-709521e4d6ad",
                                                "text": "Indiana wurde im Jahre 1816 als 19. Bundesstaat in die USA aufgenommen."
                                            },
