                                "target_senses": [
                                    {
                                        "sense_id": "7f0bdfc5-16f2-35f1-ada0-19e151b8bdc2",
                                        "entry_id": "4238cee6-a473-3dc3-bdc5-2a5c9b141a00",
                                        "glosses": [
                                            "The univalent radical CH₂=CH−, derived from ethylene."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c84200-f634-3673-8303-abb1ffe8aab1",
                                        "entry_id": "4238cee6-a473-3dc3-bdc5-2a5c9b141a00",
                                        "glosses": [
                                            "Any of various compounds and substances containing the vinyl radical, especially various tough, flexible, shiny plastics."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4a9706e-8581-32d3-a8f6-22c31099fbd3",
                                        "entry_id": "4238cee6-a473-3dc3-bdc5-2a5c9b141a00",
                                        "glosses": [
                                            "Phonograph records as a medium."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64d46c7a-bae2-4086-a9f7-3e002bddd87e",
                                                "sense_id": "c4a9706e-8581-32d3-a8f6-22c31099fbd3",
                                                "text": "Many DJs prefer vinyl to CDs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc70a44a-f7b2-3d1d-85b4-3f06d6887ef6",
                                        "entry_id": "4238cee6-a473-3dc3-bdc5-2a5c9b141a00",
                                        "glosses": [
                                            "A phonograph record."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0344e7-f98c-4d42-9710-0275429895ed",
                                                "sense_id": "dc70a44a-f7b2-3d1d-85b4-3f06d6887ef6",
                                                "text": "This is a tangible example of the net's natural flow toward improved environmental outcomes. Although some people lament the loss of flipping through CDs, or eight-tracks, or vinyls, there is a clear upside to dematerialization."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vinyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53d4b079-3206-39ff-96ba-f4b4b8f4e73a",
                                        "entry_id": "f66a5af2-d6d9-3410-b2fd-fd7065f9f2f3",
                                        "glosses": [
