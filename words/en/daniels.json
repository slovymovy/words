            "senses": [
                {
                    "sense_id": "6b74166b-4fa8-3ba3-a496-5751a8679183",
                    "sense_definition": "The plural form of the noun <w>daniel</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics acted like wise <w>daniels</w> passing judgment on the new play.",
                            "target_lang_translations": {
                                "ru": "Критики вели себя как мудрые <w>даниилы</w>, выносящие суждение о новой пьесе.",
                                "zh": "评论家们表现得像睿智的<w>丹尼尔</w>一样，对这部新剧进行评判。"
                            }
                        },
                        {
                            "text": "We need a few <w>daniels</w> to help resolve this complicated legal dispute.",
                            "target_lang_translations": {
