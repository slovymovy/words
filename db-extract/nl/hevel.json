                    {
                        "sense_id": "744cf0ae-2573-3a5a-a573-b95c5dec48f0",
                        "entry_id": "e197d764-3b87-3537-9baa-ceba04ab6ab4",
                        "glosses": [
                            "een geheel met vloeistof gevulde pijp of slang waarvan het ene einde lager gehouden wordt dan de andere, waardoor vloeistof van de laatste mond naar de eerste stroomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f5320e-48b0-4d80-b303-6d7a352b7f2b",
                                "sense_id": "744cf0ae-2573-3a5a-a573-b95c5dec48f0",
                                "text": "Met een hevel kun je gemakkelijk water uit een aquarium verwijderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d401a1e0-01f9-4d63-919d-650c8267e373",
                        "source_entry_id": "e197d764-3b87-3537-9baa-ceba04ab6ab4",
                        "source_sense_id": "744cf0ae-2573-3a5a-a573-b95c5dec48f0",
                        "source_sense_description": "een geheel met vloeistof gevulde pijp of slang waarvan het ene einde lager gehouden wordt dan de andere, waardoor vloeistof van de laatste mond naar de eerste stroomt",
                        "target_lang_word": "Heber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf2d2f7-4a98-34dd-b092-47cb710f174e",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Person oder Vorrichtung, die hebt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72e2b111-e979-3b37-80a1-4ac9ebe7d343",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Gerät zum Entleeren eines Gefäßes unter Ausnutzung des hydrostatischen Drucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c3e2d2-949f-4e04-aa50-5a40ae7fcc46",
                                                "sense_id": "72e2b111-e979-3b37-80a1-4ac9ebe7d343",
                                                "text": "„Der Küfer nimmt den Heber in die Rechte und die Probiergläschen in die Linke, löst den Spund, taucht den Heber ein, füllt die Gläser und reicht sie um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "80d8d797-c366-3d91-9d9d-623222c23ba5",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Person, welche die Sportart Gewichtheben ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbe990f7-9e25-343d-a71c-dfcd217d8272",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "(hydraulische) Vorrichtung zum Heben schwerer Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f689da1-f578-454e-9a65-69955308722b",
                                                "sense_id": "dbe990f7-9e25-343d-a71c-dfcd217d8272",
                                                "text": "„Der einfache mechanisch oder hydraulisch betätigte Heber ist bei Starrachsen sicher unterzuschieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "646593c4-1be7-37cb-af79-bce270c8862b",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Ball, der über den Gegenspieler gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6583a70-5556-4225-bd97-9024a38d56fd",
                                                "sense_id": "646593c4-1be7-37cb-af79-bce270c8862b",
                                                "text": "„Seine Torgefährlichkeit wies er auch beim FC Sochaux nach; so gelang ihm im Viertelfinale des französischen Pokals Anfang 2010 ein sehenswerter Treffer, als er Monacos Torhüter Stéphane Ruffier aus dem Anstoßkreis heraus mit einem Heber überwand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ce46b0-22a1-41a2-99a7-73251c0a821c",
                        "source_entry_id": "e197d764-3b87-3537-9baa-ceba04ab6ab4",
                        "source_sense_id": "744cf0ae-2573-3a5a-a573-b95c5dec48f0",
                        "source_sense_description": "een geheel met vloeistof gevulde pijp of slang waarvan het ene einde lager gehouden wordt dan de andere, waardoor vloeistof van de laatste mond naar de eerste stroomt",
                        "target_lang_word": "siphon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siphon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42fa6fb4-9539-30a7-be2c-6e0a5e826f7b",
                                        "entry_id": "1f0d03fe-6669-39ad-ad28-5ec1ac8d9b3d",
                                        "glosses": [
                                            "A bent pipe or tube with one end lower than the other, in which hydrostatic pressure exerted due to the force of gravity moves liquid from one reservoir to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe486fc-26c9-45ab-85a9-dbff09c76c1e",
                                                "sense_id": "42fa6fb4-9539-30a7-be2c-6e0a5e826f7b",
                                                "text": "The asserted fact that free hydrochloric acid is absent from the fluid removed by a siphon in cases of cancer of the stomach has been lately much discussed in Germany, and Dr Van der Welden, of Strassburg, introduced an alcoholic solution of tropæolin as a test with this object."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179a2392-2f62-3e05-ac45-38edc2fb2dd1",
                                        "entry_id": "1f0d03fe-6669-39ad-ad28-5ec1ac8d9b3d",
                                        "glosses": [
                                            "A soda siphon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5fcf27f-895a-3116-8f78-7f329f32af3b",
                                        "entry_id": "1f0d03fe-6669-39ad-ad28-5ec1ac8d9b3d",
                                        "glosses": [
                                            "A tubelike organ found in animals or elongated cell found in plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcf754f-ce9a-4349-a205-ee87ff819c2a",
                                                "sense_id": "a5fcf27f-895a-3116-8f78-7f329f32af3b",
                                                "text": "As a result, although corbinas commonly utilize mollusks, they are limited to the siphons, foot, or other soft parts that either extend from the shell or can be picked from it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "siphon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf651c8-cc4c-340d-a9aa-acb62be5f67b",
                                        "entry_id": "004573a3-862d-316b-be0a-8091059525d1",
                                        "glosses": [
                                            "To transfer (liquid) by means of a siphon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f0f64d-23f4-4e91-9135-0d9011bc977d",
                                                "sense_id": "adf651c8-cc4c-340d-a9aa-acb62be5f67b",
                                                "text": "He used a rubber tube to siphon petrol from the car's fuel tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e90af7-7e9d-34ff-9d00-1d14ebe7b20b",
                                        "entry_id": "004573a3-862d-316b-be0a-8091059525d1",
                                        "glosses": [
                                            "To transfer directly."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290fa6ad-d462-4136-ac67-5a9415d22d6a",
                                                "sense_id": "50e90af7-7e9d-34ff-9d00-1d14ebe7b20b",
                                                "text": "Today's teenagers are siphoning dangerous levels of membrane-damaging noise directly into their eardrums, with long-term effects that otologists prophesy will be disastrous for their hearing and lead to an epidemic of middle-aged deafness in the next thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                        "entry_id": "004573a3-862d-316b-be0a-8091059525d1",
                                        "glosses": [
                                            "To steal or skim off something, such as money, in small amounts; to embezzle."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55450d7a-4d0e-4ac9-9794-bf1fa25f8e89",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "In Juchipila power to the whole community of thirty thousand evaporated as the supraheavy grid buried alongside the little mountain cantina siphoned energy from the entire west-central portion of the Namerican national power net."
                                            },
                                            {
                                                "example_id": "a479ea7e-15da-40e4-890a-9304c356e3d8",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "Attempting to “unfeel” whatever you feel is a huge drain on your energy, and that effort can siphon off the power you need to crunch your problem."
                                            },
                                            {
                                                "example_id": "3a9eb35d-dd08-4d7c-b535-3164788491c7",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "Artiles, a Republican operative with a reputation for a foul mouth and sharp elbows, is accused of financing a sham candidate whose candidacy was intended to siphon votes from a legitimate Democratic candidate in a state Senate race in South Florida’s 37th District. The candidate has the same last name as then-Democratic incumbent Jose Javier Rodriguez but did not actively campaign for the seat and has since admitted being recruited as a spoiler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
