                                        "glosses": [
                                            "Of or relating to extremism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f671c45-bc48-4840-a9eb-6c2a8bd9469c",
                        "source_entry_id": "731ec609-1588-3007-bc5c-3e91485ed8ec",
                        "source_sense_id": "a9ac34e2-c5c1-3c5f-b27e-8cee43d3dc34",
                        "source_sense_description": "iemand met radicale, extremistische standpunten, een aanhanger van een ideologie die ver van het politieke of maatschappelijke centrum ligt",
                        "target_lang_word": "extrémiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrémiste",
