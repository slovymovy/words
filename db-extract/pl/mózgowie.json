                                                "example_id": "3d36049d-080c-4f9c-bb4f-d3de92c1febd",
                                                "sense_id": "4319e8bb-71cd-3e11-9428-87873f7431d7",
                                                "text": "It was the ſwift celeritie of his death / […] That brain'd my purpoſe:"
                                            },
