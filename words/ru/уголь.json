    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6c451d1-8826-34b7-b3ee-2a26ee52313f",
                    "sense_definition": "Ископаемое твёрдое горючее вещество растительного происхождения, используемое как топливо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fuel_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом регионе активно добывают каменный <w>уголь</w>.",
                            "target_lang_translations": {
                                "en": "Hard <w>coal</w> is actively mined in this region.",
                                "es": "En esta región se extrae activamente <w>carbón</w> mineral.",
                                "fr": "Dans cette région, on extrait activement du <w>charbon</w> de terre."
                            }
                        },
                        {
                            "text": "Старый паровоз работал на <w>угле</w> и выпускал густой дым.",
                            "target_lang_translations": {
                                "en": "The old steam locomotive ran on <w>coal</w> and let out thick smoke.",
                                "es": "La vieja locomotora funcionaba con <w>carbón</w> y soltaba un humo espeso.",
                                "fr": "La vieille locomotive à vapeur fonctionnait au <w>charbon</w> et dégageait une épaisse fumée."
                            }
                        }
                    ],
                    "common_phrases": [
                        "каменный уголь",
                        "бурый уголь",
                        "древесный уголь",
                        "добыча угля"
                    ],
                    "target_lang_definitions": {
                        "en": "A hard fossil fuel of plant origin used as fuel.",
                        "es": "Combustible fósil sólido de origen vegetal utilizado como fuente de energía.",
                        "fr": "Combustible fossile solide d'origine végétale utilisé comme combustible."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coal",
                                "target_lang_sense_clarification": "fossil fuel"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "carbón",
                                "target_lang_sense_clarification": "combustible fósil"
                            },
                            {
                                "target_lang_word": "carbón mineral",
                                "target_lang_sense_clarification": "extraído de la tierra"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "charbon",
                                "target_lang_sense_clarification": "combustible fossile"
                            },
                            {
                                "target_lang_word": "houille",
                                "target_lang_sense_clarification": "charbon de terre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bca5eb92-d6cf-3ca1-a7a8-d1d34bd12ebc",
                    "sense_definition": "Кусок перегоревшего дерева, который ещё сохраняет жар или уже превратился в золу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burnt_wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы запекли картошку в горячих <w>углях</w> костра.",
                            "target_lang_translations": {
                                "en": "We baked potatoes in the hot <w>coals</w> of the campfire.",
                                "es": "Asamos patatas en las <w>brasas</w> calientes de la fogata.",
                                "fr": "Nous avons fait cuire des pommes de terre dans les <w>braises</w> chaudes du feu de camp."
                            }
                        },
                        {
                            "text": "Из печки случайно выпал тлеющий <w>уголь</w>.",
                            "target_lang_translations": {
                                "en": "A smoldering <w>coal</w> accidentally fell out of the stove.",
                                "es": "De la estufa cayó accidentalmente un <w>carbón</w> encendido.",
                                "fr": "Une <w>braise</w> fumante est tombée accidentellement du poêle."
                            }
                        }
                    ],
                    "synonyms": [
                        "головешка"
                    ],
                    "common_phrases": [
                        "горячие угли",
                        "красные угли",
                        "раздувать угли"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of burnt wood that still retains heat or has turned into ash.",
                        "es": "Trozo de madera quemada que aún conserva calor o se ha convertido en ceniza.",
                        "fr": "Morceau de bois calciné qui conserve encore de la chaleur ou s'est transformé en cendres."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coal",
                                "target_lang_sense_clarification": "glowing piece of fuel"
                            },
                            {
                                "target_lang_word": "ember",
                                "target_lang_sense_clarification": "glowing fragment"
                            },
                            {
                                "target_lang_word": "charcoal",
