{
    "word_family": [
        "prey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6628b9d-72a9-3b8c-8bf2-84da756616b6",
                    "sense_definition": "An animal or person that hunts and kills others for food or gain",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "predator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion is a natural <w>preyer</w> that keeps the population of herbivores in check.",
                            "target_lang_translations": {
                                "tr": "Aslan, otçul popülasyonunu dengede tutan doğal bir <w>avcıdır</w>."
                            }
                        },
                        {
                            "text": "In the deep ocean, every creature is either a <w>preyer</w> or a victim.",
                            "target_lang_translations": {
                                "tr": "Derin okyanusta her canlı ya bir <w>avcıdır</w> ya da bir kurban."
                            }
                        }
                    ],
                    "synonyms": [
                        "predator",
                        "devourer"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarını yiyecek veya kazanç için avlayan ve öldüren hayvan veya kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "avcı",
                                "target_lang_sense_clarification": "Bir canlıyı avlayan, yırtıcı hayvan veya kişi."
                            },
                            {
                                "target_lang_word": "yırtıcı",
                                "target_lang_sense_clarification": "Beslenmek için diğer hayvanları avlayan canlı."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "425c5640-3b6f-3994-b5fa-ef9f9d2cb8e8",
                    "sense_definition": "A surname of German origin",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher <w>Preyer</w> published several studies on child development in the late nineteenth century.",
                            "target_lang_translations": {
                                "tr": "Araştırmacı <w>Preyer</w>, on dokuzuncu yüzyılın sonlarında çocuk gelişimi üzerine birçok çalışma yayımladı."
                            }
                        },
                        {
                            "text": "Many families named <w>Preyer</w> migrated to the United States during the nineteenth century.",
                            "target_lang_translations": {
                                "tr": "<w>Preyer</w> soyadını taşıyan birçok aile, on dokuzuncu yüzyılda Amerika Birleşik Devletleri'ne göç etti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "This is a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Alman kökenli bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Preyer",
                                "target_lang_sense_clarification": "Özel isim olduğu için çevrilmez."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}