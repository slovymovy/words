                "senses": [
                    {
                        "sense_id": "03512b2a-d9e4-31bb-b6e4-d258f6c3f7ba",
                        "entry_id": "1961601c-f820-3100-a889-ad3816b4d107",
                        "glosses": [
                            "Test zur Untersuchung der Qualität eines Untersuchungsinstruments, der vor dem eigentlichen Test eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "73569ab7-4816-31dd-b428-2f2bfa566aed",
                        "entry_id": "1961601c-f820-3100-a889-ad3816b4d107",
                        "glosses": [
                            "Test zur Ermittlung der gegenwärtigen Ausprägung eines (Persönlichkeits-)Merkmals, bevor eine Intervention/ein Treatment eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad1e091-2554-4d4a-8c27-4c7efb16cd80",
                                "sense_id": "73569ab7-4816-31dd-b428-2f2bfa566aed",
                                "text": "„Es fanden sich keine bedeutsamen Veränderungen von Pre- zu Posttest und keine bedeutsamen Unterschiede zwischen den Gruppen in der Ausprägung des Merkmals.“"
                            },
                            {
                                "example_id": "b0380905-9dab-4f47-86cb-14df7f6e36ae",
                                "sense_id": "73569ab7-4816-31dd-b428-2f2bfa566aed",
                                "text": "„Unterscheiden sich die Differenzen in den Messungen der abhängigen Variablen von Pre- und Posttest signifikant und wurden alle weiteren Faktoren, die zu alternativen Erklärungen führen können, eliminiert oder ausgeschlossen, so kann die Veränderung des abhängigen Indikators nur auf die Wirkung des Treatments und auf die Variation der Unabhängigen zurückgeführt werden.“"
                            },
                            {
                                "example_id": "97d031b3-ca1d-4d90-9c5a-cd4addf76ac8",
                                "sense_id": "73569ab7-4816-31dd-b428-2f2bfa566aed",
                                "text": "„Die Art der Behandlung hat keinen Einfluss darauf, wie sich die Depressivität zwischen Pre- und Posttest verändert.“"
                            },
                            {
                                "example_id": "d199ab5b-e09a-42e4-995d-2e4b46505b8f",
                                "sense_id": "73569ab7-4816-31dd-b428-2f2bfa566aed",
                                "text": "„Dabei wird davon ausgegangen, dass die Messwerte bei Pretest und Posttest gleich ausgefallen wären, wenn es keine Intervention gegeben hätte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
