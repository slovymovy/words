                                "target_senses": [
                                    {
                                        "sense_id": "720b4b92-a5ed-3992-8577-fe275c443c02",
                                        "entry_id": "990bb32d-bce4-36bc-a6ad-6c1d67641ae3",
                                        "glosses": [
                                            "Auteur ou autrice qui compose des fables, des apologues."
                                        ],
