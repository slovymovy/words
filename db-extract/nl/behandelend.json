                "senses": [
                    {
                        "sense_id": "88b2e8bc-c00d-34b7-bb36-274df4868a54",
                        "entry_id": "1a8e2cbe-ab65-3dc8-a015-10ca7fa1a7e5",
                        "glosses": [
                            "van iemand dat hij een patiënt of een zaak behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a09a49-25a1-45ff-b25d-6142affd3103",
                                "sense_id": "88b2e8bc-c00d-34b7-bb36-274df4868a54",
                                "text": "De dood van Van Gogh bleef in veel opzichten een mysterie. De behandelend arts had een kogel in zijn lichaam gevonden."
                            },
                            {
                                "example_id": "4feaef3f-e7d9-4512-8142-d50a712409d6",
                                "sense_id": "88b2e8bc-c00d-34b7-bb36-274df4868a54",
                                "text": "Over het aanstellen van een tweede reserverechter wordt nog nagedacht, meldt de Rechtspraak donderdag. In grote, langdurige zaken wordt vaker gewerkt met reserverechters. Hij of zij kan een behandelend rechter vervangen, bijvoorbeeld in geval van ziekte, zodat de zaak gewoon door kan gaan."
                            }
                        ]
                    }
