                    {
                        "sense_id": "8e08048b-26aa-30a4-83bf-67554ba66104",
                        "entry_id": "3a2bd7a8-7fa9-3ad2-9a1c-895fea11a42d",
                        "glosses": [
                            "een rechtopstaande gebeeldhouwde steen die de aanwezigheid van een graf markeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269b64a7-1dd1-400a-9073-3b5cf56dde6e",
                                "sense_id": "8e08048b-26aa-30a4-83bf-67554ba66104",
                                "text": "Een marmeren grafsteen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5573cd6c-a497-4227-af7e-9c1c7d7336a2",
                        "source_entry_id": "3a2bd7a8-7fa9-3ad2-9a1c-895fea11a42d",
                        "source_sense_id": "8e08048b-26aa-30a4-83bf-67554ba66104",
                        "source_sense_description": "een rechtopstaande gebeeldhouwde steen die de aanwezigheid van een graf markeert",
                        "target_lang_word": "Grabstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grabstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                        "entry_id": "29692d38-7d4e-3818-9ae0-5b973ead9edb",
                                        "glosses": [
                                            "Gedenkstein, der auf einem Grab angebracht ist und an die Verstorbenen erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed40c3e-3ce3-414e-97de-538692b08bdc",
                                                "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                                "text": "Viele der Grabsteine sind älter als 100 Jahre."
                                            },
                                            {
                                                "example_id": "6c6ba8af-a29b-44c9-928d-0da6e27da458",
                                                "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                                "text": "„Ich spazierte zum Friedhof und verbrachte die Zeit damit, die Inschriften auf den Grabsteinen zu lesen.“"
                                            },
                                            {
                                                "example_id": "fa480313-e4a0-484a-97f6-a5378d11fc83",
                                                "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                                "text": "„Ob man davon weiß oder nicht, jeder, der die Straßen von Kalisz entlanggeht, tritt die Grabsteine mit Füßen.“"
                                            },
                                            {
                                                "example_id": "b283b309-089b-46b7-8fd1-1d7904b4b191",
                                                "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                                "text": "„Viele Grabsteine auf dem jüdischen Friedhof sind in Jiddisch abgefasst.“"
                                            },
                                            {
                                                "example_id": "a7f85bcd-2391-4a4d-92f0-39e08086d1f2",
                                                "sense_id": "cbde23fa-ea11-3e0a-a700-ee972d8ec5f7",
                                                "text": "„Grabsteine und Kreuze waren umgekippt und lagen kreuz und quer übereinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2dba360-31d0-4614-bb7c-c2c3ed57e824",
                        "source_entry_id": "3a2bd7a8-7fa9-3ad2-9a1c-895fea11a42d",
                        "source_sense_id": "8e08048b-26aa-30a4-83bf-67554ba66104",
                        "source_sense_description": "een rechtopstaande gebeeldhouwde steen die de aanwezigheid van een graf markeert",
                        "target_lang_word": "tombstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tombstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1408d1d0-53f7-3ad1-b42f-693c14d9fb5d",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A grave marker, a stone slab or similar object marking a person's grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68ba237-b813-47e1-b1e0-aff530a8bd57",
                                                "sense_id": "1408d1d0-53f7-3ad1-b42f-693c14d9fb5d",
                                                "text": "True, there's no harm in crying for one's husband, and the tombstone, though plain, was a solid piece of work, and on summer's days when the widow brought her boys to stand there one felt kindly towards her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b28fdf7-e5d7-361f-8fa3-e748eecd529a",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "The symbol \\\"∎\\\" marking the end of a proof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f17a75b8-6e59-30f1-9d84-ac21c9833cdd",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A marker that takes the place of deleted data, allowing for replication of the deletion across servers etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375974b4-2ac4-4c14-8d6b-f83ee487babf",
                                                "sense_id": "f17a75b8-6e59-30f1-9d84-ac21c9833cdd",
                                                "text": "If you attempt to restore a backup that is older than the tombstone lifetime, it may introduce objects that were deleted […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f30cd57e-fc37-3d11-8d20-03d3045b05b2",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A crashdump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202e4942-2e74-45ba-acce-2509fbda38aa",
                                                "sense_id": "f30cd57e-fc37-3d11-8d20-03d3045b05b2",
                                                "text": "This actually results in a crash dump, which is written to the log and to a tombstone file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8779109a-326d-30fe-b8dd-be51790cbd53",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "An unusual morphological feature on an electrocardiogram indicative of acute myocardial infarction, characterized by a massive ST elevation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a413ed17-5d68-33e5-8ffb-49b1d28519f8",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A printed advertisement in a newspaper or magazine, typically having unadorned centered text in black and white, enclosed in a simple box."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d67c9e09-8d4b-3915-9e5e-a1ce6d355da5",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A museum plaque or caption displaying information about a work of art or exhibited object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca846dea-18f0-494d-910d-a5380d915a3d",
                                                "sense_id": "d67c9e09-8d4b-3915-9e5e-a1ce6d355da5",
                                                "text": "The last bit of information on each tombstone is an accession number—an alphanumeric block that is assigned when an object is added (accessioned) to the museums’ collections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc7dc79-a285-31ad-bea7-96ff3ddf3413",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A pawnbroker's ticket."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c118529f-96b3-4e6f-9061-785874fa9415",
                                                "sense_id": "9bc7dc79-a285-31ad-bea7-96ff3ddf3413",
                                                "text": "\"[…] Pity we're not both same size, or I'd steal one of your shirts, for I buried the last of mine yesterday, and here's the tombstone,\" producing a pawnbroker's duplicate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tombstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dbfbaf9-d4a2-3f82-973d-9fd707782376",
                                        "entry_id": "7bf01612-4f31-3074-95be-1624fb818c56",
                                        "glosses": [
                                            "To take part in tombstoning: to jump into the sea, etc. from a cliff or other high point so as to enter the water vertically straight."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e789b73c-7867-3aae-ac14-65eeca8fa0ee",
                                        "entry_id": "7bf01612-4f31-3074-95be-1624fb818c56",
                                        "glosses": [
                                            "For a surfboard to stand upright half-submerged in the water (like a tombstone, above) because the surfer is underwater with his or her legrope pulled tight. Often this indicates a surfer in difficulty, either held down by the power of a wave or unconscious and unable to get to the surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "648c1395-167c-4a6f-874c-23be37162c13",
                                                "sense_id": "e789b73c-7867-3aae-ac14-65eeca8fa0ee",
                                                "text": "Before the contest even started, Slater went down hard in a warmup session. He took a two-wave hold-down in the semifinals, his board tombstoning eerily for all to see, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf08022e-f056-383c-9954-063e4cceafd3",
                                        "entry_id": "7bf01612-4f31-3074-95be-1624fb818c56",
                                        "glosses": [
                                            "To replace (an object or data) with a tombstone marker."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0195bb70-9b69-4c7c-8054-7502e7f4675e",
                                                "sense_id": "cf08022e-f056-383c-9954-063e4cceafd3",
                                                "text": "One of the many improvements in Windows 2000 WINS (and NT4 SP4) is the capability to selectively delete or tombstone records."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217c8cbb-a745-4141-b416-84d036ff3c97",
                        "source_entry_id": "3a2bd7a8-7fa9-3ad2-9a1c-895fea11a42d",
                        "source_sense_id": "8e08048b-26aa-30a4-83bf-67554ba66104",
                        "source_sense_description": "een rechtopstaande gebeeldhouwde steen die de aanwezigheid van een graf markeert",
                        "target_lang_word": "pierre tombale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pierre tombale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3677444c-d248-3f59-9b38-bcab477052c5",
                                        "entry_id": "54d17f12-4d04-329a-9174-4af453cea7e2",
                                        "glosses": [
                                            "Bloc de pierre, généralement taillé dans du granit ou du marbre, recouvrant la sépulture d’une personne gravé du nom de celle-ci, des dates clés de sa vie et généralement ornée de symboles religieux."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c783c938-83e0-4083-82ce-1166d2ca2894",
                                                "sense_id": "3677444c-d248-3f59-9b38-bcab477052c5",
                                                "text": "Il y avait là, dans l’angle, une vieille pierre tombale oubliée lors du déménagement de l’ancien cimetière et qui, posée sur un champ et un peu de biais, faisait une sorte de banc élevé."
                                            },
                                            {
                                                "example_id": "3b6ee631-a953-4df4-aebc-1efff615a3ce",
                                                "sense_id": "3677444c-d248-3f59-9b38-bcab477052c5",
                                                "text": "En 1866, M. l'abbé Jeuffrain, nommé récemment curé de Graville-Sainte-Honorine, remarqua dans la chapelle de sainte Honorine une pierre tombale de grande dimension, sans légende, mais chargée de traces d'incrustations héraldiques, au nombre de douze ou quatorze, et présentant les effigies d'un chevalier et de sa femme."
                                            },
                                            {
                                                "example_id": "4487713b-1390-4d67-9d59-e9c4d52de159",
                                                "sense_id": "3677444c-d248-3f59-9b38-bcab477052c5",
                                                "text": "Mais au cimetière une volée d’obus s'écrase sur le groupe, fend les pierres tombales, et fait surgir du sol de sèches gerbes d'ossements."
                                            },
                                            {
                                                "example_id": "07694416-5c01-47bb-bc14-6e8301accff4",
                                                "sense_id": "3677444c-d248-3f59-9b38-bcab477052c5",
                                                "text": "Nous venions juste d'annoncer la nouvelle à Belle-Maman, un premier novembre, jour des Morts où l'on avait fait la tournée des cimetières, boulevards des allongés, en choisissant un prénom sur des pierres tombales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
