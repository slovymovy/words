                                "target_senses": [
                                    {
                                        "sense_id": "3fcb9ef5-526d-391e-96b8-65aca31fa52e",
                                        "entry_id": "494811f0-5e06-33c3-adcb-881331f87abf",
                                        "glosses": [
                                            "Alternative spelling of streetlight."
                                        ],
                                        "tags": [
                                            "alt-of",
