                "translations": [
                    {
                        "translation_id": "4b028b1d-79a4-49eb-9bc3-3b9ba38cda6c",
                        "source_entry_id": "ca4c4141-b396-30c1-a5ae-763838c61512",
                        "source_sense_id": "13247567-0840-313c-bf96-ab5462f61527",
                        "target_lang_word": "canteen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canteen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3222bd7d-f17b-3452-a62a-113b25f4c09f",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A small cafeteria or snack bar, especially one in a military establishment, school, or place of work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6227cad8-3a48-468c-9a45-f399ab23139a",
                                                "sense_id": "3222bd7d-f17b-3452-a62a-113b25f4c09f",
                                                "text": "He ordered a salad at the canteen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea476709-4c06-38be-ac84-0f3ecf0568d5",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A small cafeteria or snack bar, especially one in a military establishment, school, or place of work.",
                                            "A cafeteria in a school or place of work."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Hong-Kong",
                                            "India",
                                            "Malaysia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b85cf691-8c62-3376-b8bc-0ada49674fbb",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A small cafeteria or snack bar, especially one in a military establishment, school, or place of work.",
                                            "Goods purchased from a prison canteen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779081f9-a217-4418-b25a-20f893bb35c7",
                                                "sense_id": "b85cf691-8c62-3376-b8bc-0ada49674fbb",
                                                "text": "Yeah, I worked that bitch. She was buying me all the canteen I wanted."
                                            },
                                            {
                                                "example_id": "26db78d0-c0f3-4a02-9c14-cc2994b31876",
                                                "sense_id": "b85cf691-8c62-3376-b8bc-0ada49674fbb",
                                                "text": "“Well, le’me give you some advice,” he continued. “If someone offers you some canteen, don’t take it.”\nI instinctively knew what he was warning me against. But I felt slightly disrespected because it wasn’t as if I were a frail young girl who might go out on a date with someone and feel obligated to have sex because the guy had bought me a Happy Meal. The way I saw it, if someone wanted to give me some canteen, I was getting something for nothing!"
                                            },
                                            {
                                                "example_id": "d9c7eb8a-4eaa-4071-884f-e9eacf99c464",
                                                "sense_id": "b85cf691-8c62-3376-b8bc-0ada49674fbb",
                                                "text": "Administrative Confinement, sort of like a jail inside the prison, this is for those waiting on disciplinary court for a violation, or under investigation, plus other things. 2 man cells, allowed your tablets, some property, some canteen including food, reading books. 4 hours outside exercise weekly after 30 days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a770e21-3c3d-33b1-8ad1-9fe2c54a5136",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A temporary or mobile café used in an emergency or on a film location etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11b7896b-92ab-3f52-91e6-da0e528b81f5",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A box with compartments for storing eating utensils, silverware etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2e28bc-6547-3074-9f46-a1ebb8192c3e",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A military mess kit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "626a9622-10c3-347f-9835-af4f88a3ed82",
                                        "entry_id": "d87e04f5-af4c-3d13-a8d9-f9000ddb273e",
                                        "glosses": [
                                            "A water bottle, flask, or other vessel, typically used by a soldier or camper as a bottle for carrying water or liquor for drink."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b74de3-a9d3-43a1-91da-5cdab4bfbd4f",
                                                "sense_id": "626a9622-10c3-347f-9835-af4f88a3ed82",
                                                "text": "Come, stack arms, Men! Pile on the rails; stir up the campfire bright; no matter if the canteen fails, we'll make a roaring night. Here Shenandoah brawls along, there burly Blue Ridge echoes strong, to swell the Brigade's rousing song, of “Stonewall Jackson’s Way.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
