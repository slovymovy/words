                        "target_lang_word": "Dietrich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dietrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aae2174a-151d-3100-b4e5-a17e1db04228",
                                        "entry_id": "adadf28d-ab41-3185-8747-af7bbf619452",
                                        "glosses": [
                                            "Einbruchswerkzeug in Form eines für viele Schlösser passenden Schlüssels; Nachschlüssel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68900caf-9694-4da6-b57a-2b0d038bb446",
                                                "sense_id": "aae2174a-151d-3100-b4e5-a17e1db04228",
                                                "text": "Für solche Schlösser gibt es noch keinen Dietrich."
                                            },
                                            {
                                                "example_id": "56d994eb-79b2-4783-8681-66d10b468fb1",
                                                "sense_id": "aae2174a-151d-3100-b4e5-a17e1db04228",
                                                "text": "„Aber in diesem Augenblick bedeutete der Dietrich für uns alle die Rettung.“"
                                            },
                                            {
                                                "example_id": "dd427c1b-aa7d-4030-95d8-d818b196dd04",
                                                "sense_id": "aae2174a-151d-3100-b4e5-a17e1db04228",
                                                "text": "„Und offenbar hatte man sie auch im Benutzen eines Dietrichs unterwiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dietrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1caa4d-9185-3aee-9538-8ee4d0fdcc7f",
                                        "entry_id": "a6efd573-d17e-3774-b6c1-d628eb9ad0bb",
                                        "glosses": [
                                            "deutschsprachiger Familienname; Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
