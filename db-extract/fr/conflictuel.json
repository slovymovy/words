                                "example_id": "1cb6aea0-eb96-431f-a5d4-942b7dec891c",
                                "sense_id": "fb17679d-c222-3be9-a98c-e68b22f2eb50",
                                "text": "L’imaginaire social du macronisme minore ou méconnaît cette dimension conflictuelle."
                            },
                            {
                                "example_id": "63e91c4a-9ff7-43a7-9aea-b7e78f36bad5",
                                "sense_id": "fb17679d-c222-3be9-a98c-e68b22f2eb50",
                                "text": "De son côté, Mozilla a adopté une approche plus mesurée et moins conflictuelle du blocage des publicités."
                            }
                        ]
