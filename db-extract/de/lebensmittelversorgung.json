                "senses": [
                    {
                        "sense_id": "7f982151-2dcc-3277-9348-c28d27663a9d",
                        "entry_id": "25010971-267a-37ae-8c4b-b1d5c2b5a51d",
                        "glosses": [
                            "Bereitstellung der notwendigen Mengen an Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5eab91d-9386-4e72-b82d-109956510176",
                                "sense_id": "7f982151-2dcc-3277-9348-c28d27663a9d",
                                "text": "„Viersens Oberbürgermeister Peter Stern nannte die Lebensmittelversorgung eine wesentliche neue Aufgabe seiner Verwaltung im neuen Jahr.“"
                            },
                            {
                                "example_id": "47af544a-22ea-45a9-b382-0a108d57c9a9",
                                "sense_id": "7f982151-2dcc-3277-9348-c28d27663a9d",
                                "text": "„Bis Ende des Jahrhunderts könnte allein die Lebensmittelversorgung zwischen etwa 0,7 und 0,9 Grad zur Erderwärmung beitragen – und damit dafür sorgen, dass das 1,5-Grad-Ziel überschritten wird, berichten Fachleute im Fachjournal »Nature Climate Change«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
