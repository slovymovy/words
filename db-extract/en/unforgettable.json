                    },
                    {
                        "form_id": "a2964fc2-fd73-4ac6-afe0-9f3319bba543",
                        "entry_id": "2d048332-78a8-3f99-80fe-4066712ed5d3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unforgettable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c1743e2-f5e8-339a-9160-caad78cbd572",
                        "entry_id": "2d048332-78a8-3f99-80fe-4066712ed5d3",
                        "glosses": [
                            "Very difficult or impossible to forget."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8b8908-91ec-4bf8-b041-133f4d01153c",
                                "sense_id": "5c1743e2-f5e8-339a-9160-caad78cbd572",
                                "text": "The things he subjected me to were horrible and unforgettable."
                            },
                            {
                                "example_id": "fd087965-bd3e-4e0f-9ad0-321cdf2d2167",
                                "sense_id": "5c1743e2-f5e8-339a-9160-caad78cbd572",
                                "text": "He had never seen dogs fight as these wolfish creatures fought, and his first experience taught him an unforgetable lesson. It is true, it was a vicarious experience, else he would not have lived to profit by it."
                            },
                            {
                                "example_id": "e46479bb-760f-49f0-9104-6bc70dd2bfb7",
                                "sense_id": "5c1743e2-f5e8-339a-9160-caad78cbd572",
                                "text": "The leading engine was one of the Class Y6 2-8-8-2 compound articulateds, [...] The stack noise of one of these great brutes slogging up a grade was quite unforgettable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51beb1f1-abf1-442f-9c04-348e95d69987",
                        "source_entry_id": "2d048332-78a8-3f99-80fe-4066712ed5d3",
                        "source_sense_id": "5c1743e2-f5e8-339a-9160-caad78cbd572",
