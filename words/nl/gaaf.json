                        "heel",
                        "intact",
                        "compleet"
                    ],
                    "antonyms": [
                        "beschadigd",
                        "kapot",
                        "stuk"
                    ],
                    "common_phrases": [
                        "gaaf en gezond",
                        "een gaaf gebit"
                    ],
                    "target_lang_definitions": {
