                "senses": [
                    {
                        "sense_id": "22a09d55-c5c0-32de-b207-51416263ef35",
                        "entry_id": "8cad0616-7bd1-3ab9-95cc-9e217d2655c5",
                        "glosses": [
                            "To splash or splatter, especially with something dirty."
                        ],
                        "tags": [
                            "England",
                            "dialectal",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "fe712d7d-a7e3-4558-89b2-bc90ed007a70",
                                "sense_id": "22a09d55-c5c0-32de-b207-51416263ef35",
                                "text": "Luke at that dolly! — slarting t' barns wi' t' dish-clart, astead o' gehring wesh'd up,[…]"
                            },
                            {
                                "example_id": "5aef9159-8ebc-43ba-8bcf-2a7b9be95f2b",
                                "sense_id": "22a09d55-c5c0-32de-b207-51416263ef35",
                                "text": "Wheer t'much [muck] slarts daan t'winders / We've all on us coil up / We're agait naah wi't cinders / And if t'bum bailiff cums lads / E'll nivver find us / Cos we're right daan in t'coil oil / Wheer t'much slarts daan t'winders. Bob Schofield, Francis, Day & Hunter […]"
                            },
                            {
                                "example_id": "8ef1cffa-3925-4239-bc60-d753bf145f38",
                                "sense_id": "22a09d55-c5c0-32de-b207-51416263ef35",
                                "text": "[…] on his throne the slarting / Thunderer turns, / Melts with soft sighs, with kindling rapture burns; / Clasps her fair hand, and eyes in fond amaze / The bright Intruder with enamour'd gaze. / \"And leaves my Goddess, like a blooming bride,[…]\""
                            }
                        ]
                    }
