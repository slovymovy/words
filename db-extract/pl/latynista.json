                                "target_senses": [
                                    {
                                        "sense_id": "18cfad22-70ba-3061-87af-4fcd76dbfb8e",
                                        "entry_id": "3b40eba9-63de-3a0f-b3eb-a17910b7efe8",
                                        "glosses": [
                                            "Lehrer oder Forscher auf dem Gebiet der lateinischen Sprache"
                                        ],
                                        "tags": [],
