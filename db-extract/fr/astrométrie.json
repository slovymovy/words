                    {
                        "sense_id": "985797b7-6f28-3ef9-942f-ca9d8143bb4a",
                        "entry_id": "6df931b5-d563-3c87-b976-662bebc100c6",
                        "glosses": [
                            "Branche de l’astronomie relative aux calculs des positions et des déplacements des astres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c036414b-3b57-4550-acc9-a0c7c7f6e550",
                                "sense_id": "985797b7-6f28-3ef9-942f-ca9d8143bb4a",
                                "text": "Le cours d’astrométrie abordera les repères de la sphère céleste, les instruments d’observation et les méthodes de réduction astrométrique par rattachement."
                            },
                            {
                                "example_id": "ab8cf36a-c92c-48be-8e26-f630de9b41df",
                                "sense_id": "985797b7-6f28-3ef9-942f-ca9d8143bb4a",
                                "text": "Cette astrométrie de précision donne alors accès, pour ces astres, à une donnée fondamentale : leur parallaxe, et donc leur distance."
                            }
                        ]
                    }
                ],
