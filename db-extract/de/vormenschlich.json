                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4714add8-c308-4bb8-bf64-fcaf31da8eca",
                                                "sense_id": "429c2160-bdf4-3550-861a-56aa5d11ab0f",
                                                "text": "In the recently opened Anne and Bernard Spitzer Hall of Human Origins, there are more than 200 casts of prehuman and human fossils and artifacts that illustrate stages in physical and behavioral evolution."
