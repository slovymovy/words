                "senses": [
                    {
                        "sense_id": "3d0cce79-305e-33cf-ba1e-4b10bb3d3bbf",
                        "entry_id": "d3c48d0a-2239-3916-b8fe-0d1152dbca28",
                        "glosses": [
                            "Donner un caractère gaélique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b353469d-3922-4415-ae88-db08b7c24828",
                                "sense_id": "3d0cce79-305e-33cf-ba1e-4b10bb3d3bbf",
                                "text": "Au lieu d’angliciser les noms gaéliques, ils viennent de gaéliciser « Roland », de lui rendre son identité vraie et de mettre en danger la tâche qui les occupe."
                            },
                            {
                                "example_id": "97afca3c-333a-43e8-914c-ec96116c4f0e",
                                "sense_id": "3d0cce79-305e-33cf-ba1e-4b10bb3d3bbf",
                                "text": "« Je n’ai rien à gagner à me laisser gaéliciser par ces jeunes gens en colère qui n’ont pas digéré l’horrible répression des Pâques sanglantes de 1916 », écrivit-elle à sa mère, tout en lui faisant promettre de ne rien dire à Léonord."
                            }
                        ]
                    }
