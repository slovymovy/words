{
    "word_family": [
        "weight",
        "underweight",
        "weighty",
        "weightless",
        "counterweight"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd59d8ef-76fb-37ab-8e10-c6f5257f5eaf",
                    "sense_definition": "Having a higher body weight, especially fat, than is generally considered healthy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "body_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told him he was <w>overweight</w> and needed to change his diet.",
                            "target_lang_translations": {
                                "ru": "Врач сказал ему, что у него <w>избы́точный вес</w>, и ему нужно изменить диету.",
                                "zh": "医生告诉他已经<w>超重</w>了，需要改变饮食习惯。"
                            }
                        },
                        {
                            "text": "Many <w>overweight</w> people find it difficult to lose the extra kilos.",
                            "target_lang_translations": {
                                "ru": "Многим людям <w>с ли́шним ве́сом</w> трудно сбросить лишние килограммы.",
                                "zh": "许多<w>超重</w>的人觉得减掉多余的体重很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fat",
                        "obese",
                        "plump",
                        "chubby",
                        "plus-size",
                        "tubby",
                        "heavy"
                    ],
                    "antonyms": [
                        "thin",
                        "slender",
                        "scrawny",
                        "underweight"
                    ],
                    "common_phrases": [
                        "slightly overweight",
                        "overweight person",
                        "overweight child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий вес тела выше нормы, особенно из-за жировых отложений.",
                        "zh": "指体重超过一般认为健康的范围，通常指脂肪过多。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с ли́шним ве́сом",
                                "target_lang_sense_clarification": "наиболее употребительный вариант"
                            },
                            {
                                "target_lang_word": "по́лный",
                                "target_lang_sense_clarification": "вежливое описание"
                            },
                            {
                                "target_lang_word": "ту́чный",
                                "target_lang_sense_clarification": "очень полный, грузный"
                            },
                            {
                                "target_lang_word": "страда́ющий ожире́нием",
                                "target_lang_sense_clarification": "медицинский контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超重",
                                "target_lang_sense_clarification": "最常用的医学和日常用语"
                            },
                            {
                                "target_lang_word": "肥胖",
                                "target_lang_sense_clarification": "指程度较重的超重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b386d0bb-ddb9-3018-91f3-d08b6a1b81a0",
                    "sense_definition": "Weighing more than the allowed limit for safety or legal regulations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "excess_load",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will have to pay an extra fee if your suitcase is <w>overweight</w>.",
                            "target_lang_translations": {
                                "ru": "Вам придется доплатить, если у вашего чемодана будет <w>переве́с</w>.",
                                "zh": "如果你的行李箱<w>超重</w>，你将需要支付额外费用。"
                            }
                        },
                        {
                            "text": "The truck was <w>overweight</w> and was not allowed to cross the bridge.",
                            "target_lang_translations": {
                                "ru": "Грузовик был <w>перегру́жен</w>, и его не пропустили через мост.",
                                "zh": "这辆卡车<w>超载</w>了，不允许通过这座桥。"
                            }
                        }
                    ],
                    "antonyms": [
                        "underweight"
                    ],
                    "common_phrases": [
                        "overweight luggage",
                        "overweight vehicle",
                        "overweight fine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Весящий больше допустимого предела, установленного правилами безопасности или законом.",
                        "zh": "指重量超过了安全或法律规定的限制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "име́ющий переве́с",
                                "target_lang_sense_clarification": "о багаже"
                            },
                            {
                                "target_lang_word": "перегру́женный",
                                "target_lang_sense_clarification": "о транспортном средстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超重",
                                "target_lang_sense_clarification": "指行李或货物超过限重"
                            },
                            {
                                "target_lang_word": "超载",
                                "target_lang_sense_clarification": "指车辆或船只超过载重限制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6983b92f-a93c-33c7-8383-f0e628337646",
                    "sense_definition": "Having a larger proportion of a specific asset in a portfolio than the benchmark.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fund manager is currently <w>overweight</w> in technology stocks.",
                            "target_lang_translations": {
                                "ru": "Управляющий фондом в настоящее время <w>держит повышенную долю</w> в акциях технологических компаний.",
                                "zh": "基金经理目前对科技股进行了<w>超配</w>。"
                            }
                        },
                        {
                            "text": "Our strategy is to be <w>overweight</w> in emerging markets for the next quarter.",
                            "target_lang_translations": {
                                "ru": "Наша стратегия — <w>иметь повышенную долю</w> на развивающихся рынках в следующем квартале.",
                                "zh": "我们的策略是在下一季度对新兴市场进行<w>超配</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "underweight"
                    ],
                    "common_phrases": [
                        "overweight position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий большую долю определенного актива в портфеле по сравнению с эталонным показателем.",
                        "zh": "指在投资组合中，某种资产的比例高于基准配置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с повы́шенной до́лей",
                                "target_lang_sense_clarification": "в инвестиционном портфеле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超配",
                                "target_lang_sense_clarification": "金融投资术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d4488cf-76bc-3c0c-b9f4-1db06a44fa1e",
                    "sense_definition": "The physical condition of weighing more than is considered healthy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise is the best way to prevent <w>overweight</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения — лучший способ предотвратить <w>избы́точный вес</w>.",
                                "zh": "经常锻炼是预防<w>超重</w>的最佳方法。"
                            }
                        },
                        {
                            "text": "The clinic specializes in treating <w>overweight</w> and obesity.",
                            "target_lang_translations": {
                                "ru": "Клиника специализируется на лечении <w>избы́точного ве́са</w> и ожирения.",
                                "zh": "这家诊所专门治疗<w>超重</w>和肥胖症。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obesity",
                        "excess weight"
                    ],
                    "antonyms": [
                        "underweight"
                    ],
                    "common_phrases": [
                        "risk of overweight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое состояние, при котором вес тела превышает норму.",
                        "zh": "指体重超过健康标准的身体状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избы́точный вес",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "ли́шний вес",
                                "target_lang_sense_clarification": "общеупотребительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超重",
                                "target_lang_sense_clarification": "指身体状况"
                            },
                            {
                                "target_lang_word": "肥胖",
                                "target_lang_sense_clarification": "指病理性的体重过重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d24315e5-3317-349c-97d1-9b5fcf02c65d",
                    "sense_definition": "An amount of weight that exceeds the allowed limit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excess_load",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline charges a steep penalty for any <w>overweight</w> in checked bags.",
                            "target_lang_translations": {
                                "ru": "Авиакомпания взимает высокий штраф за любой <w>переве́с</w> в регистрируемом багаже.",
                                "zh": "航空公司对托运行李的任何<w>超重</w>都会收取高额罚款。"
                            }
                        },
                        {
                            "text": "Drivers are responsible for any <w>overweight</w> on their trucks.",
                            "target_lang_translations": {
                                "ru": "Водители несут ответственность за любой <w>перегру́з</w> своих грузовиков.",
                                "zh": "司机应对其卡车的任何<w>超载</w>负责。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вес, превышающий установленную норму.",
                        "zh": "指超过允许限度的重量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переве́с",
                                "target_lang_sense_clarification": "багажа или груза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超重",
                                "target_lang_sense_clarification": "指行李或货物的额外重量"
                            },
                            {
                                "target_lang_word": "超载",
                                "target_lang_sense_clarification": "指车辆的额外负荷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "523be444-f7cc-3026-9b6e-387f53b770fd",
                    "sense_definition": "A person who weighs more than is considered healthy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study compared the dietary habits of <w>overweights</w> and people of normal weight.",
                            "target_lang_translations": {
                                "ru": "В исследовании сравнивались пищевые привычки <w>людей с ли́шним ве́сом</w> и людей с нормальным весом.",
                                "zh": "这项研究比较了<w>超重者</w>与体重正常者的饮食习惯。"
                            }
                        },
                        {
                            "text": "Insurance premiums may be higher for <w>overweights</w> due to health risks.",
                            "target_lang_translations": {
                                "ru": "Страховые взносы могут быть выше для <w>лиц с избы́точным ве́сом</w> из-за рисков для здоровья.",
                                "zh": "由于健康风险，<w>超重者</w>的保险费可能会更高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чей вес превышает медицинскую норму.",
                        "zh": "指体重超过医学标准的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "челове́к с ли́шним ве́сом",
                                "target_lang_sense_clarification": "описательный перевод"
                            },
                            {
                                "target_lang_word": "лицо́ с избы́точным ве́сом",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超重者",
                                "target_lang_sense_clarification": "指代超重的人群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54345468-c128-3b7a-9f51-17a354c24346",
                    "sense_definition": "A security or asset that constitutes a larger than average part of a portfolio.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have listed our recommended <w>overweights</w> for the coming year.",
                            "target_lang_translations": {
                                "ru": "Мы перечислили наши рекомендованные <w>активы с повышенной долей</w> на предстоящий год.",
                                "zh": "我们列出了来年推荐的<w>超配</w>资产。"
                            }
                        },
                        {
                            "text": "Technology stocks are currently <w>overweights</w> in the fund.",
                            "target_lang_translations": {
                                "ru": "Акции технологических компаний в настоящее время являются <w>активами с повышенной долей</w> в фонде.",
                                "zh": "科技股目前是该基金中的<w>超配</w>资产。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценная бумага или актив, составляющий большую часть портфеля, чем в среднем.",
                        "zh": "指在投资组合中占比高于平均水平的证券或资产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акти́в с повы́шенной до́лей",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超配资产",
                                "target_lang_sense_clarification": "金融投资术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6338826-de4e-3f36-b503-307c8dea02f4",
                    "sense_definition": "To invest more heavily in a specific asset or sector than the benchmark.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The analyst advised clients to <w>overweight</w> pharmaceutical stocks.",
                            "target_lang_translations": {
                                "ru": "Аналитик посоветовал клиентам <w>увеличить долю</w> акций фармацевтических компаний.",
                                "zh": "分析师建议客户<w>超配</w>医药股。"
                            }
                        },
                        {
                            "text": "If you <w>overweight</w> this sector, you might see higher returns.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>увеличите долю</w> в этом секторе, вы можете получить более высокую прибыль.",
                                "zh": "如果你对这个行业进行<w>超配</w>，可能会获得更高的回报。"
                            }
                        }
                    ],
                    "antonyms": [
                        "underweight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвестировать в определенный актив или сектор больше, чем предусмотрено эталонным показателем.",
                        "zh": "指在投资组合中增加某种资产或行业的配置比例，使其高于基准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увели́чивать до́лю",
                                "target_lang_sense_clarification": "в портфеле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超配",
                                "target_lang_sense_clarification": "金融投资动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb28c77-e5b6-30c2-8d0f-016407fdb152",
                    "sense_definition": "To put too much weight or burden on something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "excess_load",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>overweight</w> the boat or it might sink.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>перегрузи́ть</w> лодку, иначе она может утонуть.",
                                "zh": "小心不要让船<w>超载</w>，否则它可能会沉没。"
                            }
                        },
                        {
                            "text": "The roof was <w>overweighted</w> by the heavy snow.",
                            "target_lang_translations": {
                                "ru": "Крыша была <w>перегру́жена</w> тяжелым снегом.",
                                "zh": "屋顶因大雪而<w>超载</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нагружать чем-то слишком тяжелым.",
                        "zh": "指给某物施加过重的负担。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегружа́ть",
                                "target_lang_sense_clarification": "физически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超载",
                                "target_lang_sense_clarification": "指物理上的过重负荷"
                            },
                            {
                                "target_lang_word": "过重负担",
                                "target_lang_sense_clarification": "指抽象或物理上的负担"
                            }
                        ]
                    }
                }
            ]
        }
    ]
