                ],
                "senses": [
                    {
                        "sense_id": "fc2908d8-7cc4-36bb-9650-dd6835c8b134",
                        "entry_id": "052d934e-5503-3bfd-a724-4ba4e77fecc7",
                        "glosses": [
                            "Voleuse agissant par ruse ; tricheuse au jeu ; personne qui abuse de la confiance."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e189b814-2bd7-451c-b304-56d2437ce5a1",
                                "sense_id": "fc2908d8-7cc4-36bb-9650-dd6835c8b134",
                                "text": "Ce vol consiste à attirer toute l'attention des marchands en feignant de leur acheter ou même en leur achetant. Alors un second filou ou une filoute vient pour assortir un échantillon qu'on ne peut trouver, et s'empare de la pièce préparée par le premier."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa7be7d5-5344-3aa5-95a0-c9ac2115c8eb",
                        "entry_id": "052d934e-5503-3bfd-a724-4ba4e77fecc7",
                        "glosses": [
                            "Femme ou fille malhonnête."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d20ddf-9afd-45fe-b09d-a5a1855879c3",
                                "sense_id": "aa7be7d5-5344-3aa5-95a0-c9ac2115c8eb",
                                "text": "En plus de n'avoir aucun talent, Carney Andrews était une filoute, mais avait l'avantage d'être mariée au juge de la Cour supérieure, Bryce Andrews. Celui-ci avait passé vingt-cinq ans comme procureur avant d'être nommé juge."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6171dbe-e1b1-33c7-a0ab-09fc1edf0800",
                        "entry_id": "052d934e-5503-3bfd-a724-4ba4e77fecc7",
                        "glosses": [
                            "Femme ou fille espiègle ou coquine."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c0460a1d-6b2e-4661-9edd-baa1fab0625b",
                                "sense_id": "f6171dbe-e1b1-33c7-a0ab-09fc1edf0800",
                                "text": "Et là, admiratif, il avait déclaré mezza voce, sourire aux lèvres : vous êtes une « filoute » !"
                            }
                        ]
                    }
                ],
