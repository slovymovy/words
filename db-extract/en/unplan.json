                        "sense_id": "7a8d0990-c876-389a-9a8d-5e6d2efd7a8a",
                        "entry_id": "b2ba43db-0812-361c-8b36-03f1521f57dd",
                        "glosses": [
                            "To undo the planning of (something previously planned); to cancel."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2f95af91-7fcc-42e6-ae61-43a872a0afc6",
                                "sense_id": "7a8d0990-c876-389a-9a8d-5e6d2efd7a8a",
                                "text": "O, Goodness! help me to unplan that plan, and to unpurpose that purpose!"
                            },
                            {
                                "example_id": "ab8d2d4f-521b-407c-80ed-d4fd896904a5",
                                "sense_id": "7a8d0990-c876-389a-9a8d-5e6d2efd7a8a",
                                "text": "“How do you know people from West Point are marching?” “My organization planned it!” “You ought to unplan it.”"
                            },
                            {
                                "example_id": "97e22c8b-4591-4d6f-89d1-d5737069d360",
                                "sense_id": "7a8d0990-c876-389a-9a8d-5e6d2efd7a8a",
                                "text": "I then had to deal with finding a place to live, trying to make more money, and unplanning a wedding. The hurt, embarrassment, and shock of a breakup was something I had never planned on facing."
                            }
                        ]
                    }
