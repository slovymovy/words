                        "glosses": [
                            "Action de déboulonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06b88da-4d19-4387-86e4-be365d0828b0",
                                "sense_id": "1308055a-b7e2-3a7c-841e-cfd05d39cba0",
                                "text": "Il est amusant de constater qu’après avoir peint L'Origine du Monde, Courbet ait revendiqué le déboulonnement de la colonne Vendôme."
                            },
                            {
                                "example_id": "89df0e84-96fb-459b-a9e5-46517e993349",
                                "sense_id": "1308055a-b7e2-3a7c-841e-cfd05d39cba0",
                                "text": "Le déboulonnement de la dernière statue du Caudillo, en mars 2005, à Madrid, ne fait que raviver l’amertume des partisans du franquisme, désormais devenus ultraminoritaires."
                            },
                            {
                                "example_id": "6ab44fa7-608a-462b-9c65-506875fd6d8a",
                                "sense_id": "1308055a-b7e2-3a7c-841e-cfd05d39cba0",
                                "text": "La fin du culte de la personne du chef avec rejet de la marche de soutien de l’Hôtel de ville et le déboulonnement des panneaux à l’effigie de l’ancien président sont des actes importants qui contribueront à mettre fin à toutes ces manifestations qui n’avaient pour but que d’enrichir frauduleusement leurs organisateurs."
                            }
                        ]
                    }
