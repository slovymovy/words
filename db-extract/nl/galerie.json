                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "A covered passage cut through the earth or masonry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "044d5cfe-2215-46ae-b04c-0bb1cf37c43e",
