                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7034a1d-8f43-449c-9cdd-6b9975123e7d",
                                                "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                                "text": "to twitch somebody's sleeve for attention"
                                            },
                                            {
                                                "example_id": "b0cffe8b-2366-4c93-aa94-3caf9b69d800",
                                                "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                                "text": "Thrice they twitched the diamond in her ear."
                                            }
                                        ]
                                    },
