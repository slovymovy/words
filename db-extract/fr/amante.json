                        "sense_id": "3b268686-4541-3a49-9c5d-88880647372e",
                        "entry_id": "0248514d-3087-3af2-9381-96da299d3b03",
                        "glosses": [
                            "ou Celle qui a de l’amour pour une autre personne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b037a4f1-882e-33c9-ae86-a8149394cd6a",
                        "entry_id": "0248514d-3087-3af2-9381-96da299d3b03",
                        "glosses": [
                            "ou Celle qui aime quelque chose avec passion."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "literary"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "34dedf2f-0d5c-3d1d-80ac-549c01179b36",
                        "entry_id": "0248514d-3087-3af2-9381-96da299d3b03",
                        "glosses": [
                            "Celle qui reçoit les faveurs d’un homme (ou, plus rarement, d’une femme) avec lequel elle n’est pas mariée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a11b8d-9faa-455d-97ad-e8da85029ab7",
                                "sense_id": "34dedf2f-0d5c-3d1d-80ac-549c01179b36",
                                "text": "Les principaux acteurs étaient M. de Voltaire qui s'était chargé des rôles de vieillards, madame Denis qui jouait les amantes passionnées, un imprimeur de Genève, appelé Craner, qu’on habillait en Gengis-kan ou en Orosmane, et Chabanon qui avait l’emploi des jeunes premiers."
                            },
                            {
                                "example_id": "ce371e52-1690-49e6-a9fe-7974de39d0e5",
                                "sense_id": "34dedf2f-0d5c-3d1d-80ac-549c01179b36",
                                "text": "Thomyra est l’amie et l’amante de la belle fille qui se nomme Penthésilée, et elle craint de perdre une affection qui lui est chère, si elle devient grosse des œuvres du captif."
                            },
                            {
                                "example_id": "0c0fe15b-7126-4069-b6db-d648ad6197c3",
                                "sense_id": "34dedf2f-0d5c-3d1d-80ac-549c01179b36",
                                "text": "Beaucoup de ces trentenaires auraient certainement apprécié qu’il leur proposât la botte, mais il était certain qu’elles ne pourraient pas lui offrir le plaisir procuré par ses jeunes amantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f3e68b2-e8f8-3501-98f1-806f12ac7f6d",
                        "entry_id": "0248514d-3087-3af2-9381-96da299d3b03",
                        "glosses": [
                            "Celle qui donne du plaisir sexuel."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f46b3c0a-d120-4d41-b44b-4f2c9357ae7a",
                        "source_entry_id": "0248514d-3087-3af2-9381-96da299d3b03",
                        "target_lang_word": "girlfriend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "girlfriend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                        "entry_id": "d8e3ca00-11f7-3076-9dee-e56fe13d6e54",
                                        "glosses": [
                                            "A female partner in an unmarried romantic relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e896516-9e5b-4d3a-a67b-9e011034852f",
                                                "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                                "text": "Marc went to the park with his girlfriend and watched the sunset with her."
                                            },
                                            {
                                                "example_id": "c7c1461d-5739-489d-b397-91c46b5fc5fe",
                                                "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                                "text": "I was playing the acoustic guitar and my girlfriend was playing the drums."
                                            },
                                            {
                                                "example_id": "2379df3d-369c-4f7c-a40b-44c4e66e95a9",
                                                "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                                "text": "Want to pick some flowers, doctor? When a man visits an old girlfriend she usually expects something like that."
                                            },
                                            {
                                                "example_id": "0727fa31-ea93-4f2a-b06f-472a6c21ee25",
                                                "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                                "text": "Former Playboy Bunnies Holly Madison and Kendra Wilkinson, whose lives as Hugh Hefner’s girlfriends were featured in “The Girls Next Door” reality show, are feuding after Madison shared the claims of their less-than-glamorous life in the Playboy Mansion."
                                            },
                                            {
                                                "example_id": "b3228688-58fd-47c6-af8e-084b156bcdb7",
                                                "sense_id": "c6f859e9-b5d6-3036-9ca1-d86f258330c0",
                                                "text": "Referring to someone as your boyfriend or girlfriend suggests several things about your relationship, said Leah Carey, a sex and relationship coach and podcast host of “Good Girls Talk About Sex.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a80badc-2eef-3740-8b25-1dc35723816a",
                                        "entry_id": "d8e3ca00-11f7-3076-9dee-e56fe13d6e54",
                                        "glosses": [
                                            "A female friend of a woman or girl."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf78ebe-392a-41dc-803c-37f485d33a3b",
                                                "sense_id": "3a80badc-2eef-3740-8b25-1dc35723816a",
                                                "text": "Mary always enjoyed hanging out with her girlfriend Jessica."
                                            },
                                            {
                                                "example_id": "3912f2d7-4366-4f39-9283-ddbeb9c3306e",
                                                "sense_id": "3a80badc-2eef-3740-8b25-1dc35723816a",
                                                "text": "[…] for the past 45 years, Neri had sat outside with her girlfriends Fotini and Eleni, two school friends who, having grown old in their company, Neri loved dearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39cae5e0-b7de-36b1-8b83-931b98d759ff",
                                        "entry_id": "d8e3ca00-11f7-3076-9dee-e56fe13d6e54",
                                        "glosses": [
                                            "A fellow gay man, especially a friend as opposed to a sexual partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbae0904-5e30-4e54-9aeb-02ee4178b6a0",
                                                "sense_id": "39cae5e0-b7de-36b1-8b83-931b98d759ff",
                                                "text": "[Tim:] james huh? my lover carlos's best girlfriend is named james.\n[James:] yes, i know. i AM your lover carlos's best girlfriend james."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e617a1d2-bafd-397d-ac28-df3f6dd31a16",
                                        "entry_id": "d8e3ca00-11f7-3076-9dee-e56fe13d6e54",
                                        "glosses": [
                                            "A term of address for a female friend or among gay men."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ad57ef-ecde-42c4-bfbc-6a868c05b78c",
                                                "sense_id": "e617a1d2-bafd-397d-ac28-df3f6dd31a16",
                                                "text": "[Hanque:] girlfriend - how'r we doing?\n[Doug:] hi hanque, i'd like a capuccino and some lobster bisque..\n[Caption:] (friendliness with the waitstaff is a good sign)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
