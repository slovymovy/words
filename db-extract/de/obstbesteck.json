                "senses": [
                    {
                        "sense_id": "8e5d4200-1b62-3ce1-b698-6e9c75bd985a",
                        "entry_id": "c3ef1b0d-4c20-3db0-9312-cb24283997cd",
                        "glosses": [
                            "zweiteiliges Set aus kleiner, spitzer Obstgabel und kleinem, scharfem Obstmesser zum Verzehr von Obst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26028c89-226f-4ab3-8fd0-a9b96bcbe3d0",
                                "sense_id": "8e5d4200-1b62-3ce1-b698-6e9c75bd985a",
                                "text": "„Obst wird grundsätzlich mit dem dafür aufgetragenen Obstbesteck (Messer und Gabel) gegessen.“"
                            },
                            {
                                "example_id": "31aecec8-e2c5-43ee-84b7-98d1eee7a8fc",
                                "sense_id": "8e5d4200-1b62-3ce1-b698-6e9c75bd985a",
                                "text": "„Wenn Sie im Restaurant eine Grapefruit mit Obstbesteck bekommen, haben Sie eine echte Herausforderung vor sich. Ohne Spritzer geht es nämlich kaum ab.“"
                            }
                        ],
