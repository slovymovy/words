                    {
                        "sense_id": "7c022abb-a48f-3bfc-8820-9955f853f56e",
                        "entry_id": "b0d9e2d6-52b1-39d6-8bab-1e670da5df96",
                        "glosses": [
                            "wskazówki autora, tekst poboczny zawierający objaśnienia dotyczące sposobu wystawienia sztuki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b0ff6e-05c1-46bd-b97d-fdd8b4987299",
                                "sense_id": "7c022abb-a48f-3bfc-8820-9955f853f56e",
                                "text": "Początkujący lektor ośmieszył się czytaniem na głos również didaskaliów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86d35d07-bef5-4f1c-b4c4-25cbc345226f",
                        "source_entry_id": "b0d9e2d6-52b1-39d6-8bab-1e670da5df96",
                        "source_sense_id": "7c022abb-a48f-3bfc-8820-9955f853f56e",
                        "target_lang_word": "stage direction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stage direction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                        "entry_id": "ef4bfe0f-bc0c-360f-9942-c1dc8fbf629a",
                                        "glosses": [
                                            "An instruction given to an actor that tells the actor what should be done and in what manner to do it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c8a707-a476-48eb-a88c-17e1d208378a",
                                                "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                                "text": "The stage direction given in the script said to walk forward and speak the line loudly."
                                            },
                                            {
                                                "example_id": "7ddea9b1-ffaa-4477-bad7-6c764332cac3",
                                                "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                                "text": "In a few spots, where we've felt it was particularly important, we added stage directions indicating things like quick glances between Helene and Erik."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df8f3e66-4575-43ac-8b9f-9c7379ac6b56",
                        "source_entry_id": "b0d9e2d6-52b1-39d6-8bab-1e670da5df96",
                        "source_sense_id": "7c022abb-a48f-3bfc-8820-9955f853f56e",
                        "target_lang_word": "indication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Action d’indiquer ; le renseignement fourni."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcd83a9-551d-4beb-b1f2-5a6ec4601062",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "[…]; arrivé devant cette planche où l'on espérait lire une indication de route, on se trouve en face d'une sauvage peinture, barbouillage de flammes rouges et d'ailes volantes ; […]."
                                            },
                                            {
                                                "example_id": "e72a8ef6-37e6-42cb-bdb1-429f7c341f35",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Le reste, sauf, si l'on veut, le compas de relèvement, est à l'avenant, ou parfaitement dérisoire, comme le spidomètre (pour mesurer la vitesse), sans aucune précision, donc sans usage de loch, sans raison d'être hors de régate, et l'anémomètre, dont l’indication... dépend de l'endroit où on le place."
                                            },
                                            {
                                                "example_id": "f3a74e6b-0e81-44f3-a7fc-101bfeddda87",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Il fut arrêté dans la foule, sur l’indication d’un tel."
                                            },
                                            {
                                                "example_id": "f2571c1b-1ddd-4e81-b315-4ba2ce8864ef",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Cela peut fournir d’utiles indications. — Vous m’aviez donné une fausse indication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d09a04d-1310-30ef-8ef1-94448f73bd1a",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Ce qui indique, ce qui donne à connaître quelque chose, et qui en est une espèce de signe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45c0bc7-3ba9-4dfd-a3f1-0c434a6738c2",
                                                "sense_id": "9d09a04d-1310-30ef-8ef1-94448f73bd1a",
                                                "text": "Son embarras est une indication de sa faute, une indication qu’il se sent coupable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Justification médicale (situation clinique en général : diagnostic, pathologie, etc.) d’un examen ou d’un traitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74c1bf9-0e3b-4e79-bfb2-e22dd36193b9",
                                                "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                                "text": "Les indications des radiographies du crâne sont limitées aux suspicions d’embarrure et aux plaies profondes"
                                            },
                                            {
                                                "example_id": "b0cca5ba-ea85-4196-be7b-4b88902b8e3e",
                                                "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                                "text": "À la fin du XIXᵉ siècle, la liqueur de Fowler, solution d'arsenic dans du bicarbonate de potassium, occupe une place de choix comme tonique, une indication qui n'est plus réservée aujourd'hui qu'aux chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d862052c-8a72-3529-a4b8-7407f97fa556",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Valeur fournie par un instrument ou système de mesure lors d’une opération de mesurage."
                                        ],
                                        "tags": [],
                                        "note": "Cette valeur est souvent de nature différente de celle du mesurande (cf. exemple",
                                        "examples": [
                                            {
                                                "example_id": "decc1ff5-196e-4f7e-abd9-5c21a1250202",
                                                "sense_id": "d862052c-8a72-3529-a4b8-7407f97fa556",
                                                "text": "Beaucoup de capteurs de pression fournissent une indication de la pression mesurée sous forme de tension électrique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c082a9-750e-4bf8-b34a-d23bc681b1b5",
                        "source_entry_id": "b0d9e2d6-52b1-39d6-8bab-1e670da5df96",
                        "source_sense_id": "7c022abb-a48f-3bfc-8820-9955f853f56e",
                        "target_lang_word": "scénique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scénique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25887771-3d08-34bb-bf1c-25e41b80be32",
                                        "entry_id": "0562d358-4366-36ab-89e7-f0ac07ce4c05",
                                        "glosses": [
                                            "Relatif à la scène, au théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941601ac-a9ca-4a08-8545-508200bdde06",
                                                "sense_id": "25887771-3d08-34bb-bf1c-25e41b80be32",
                                                "text": "Aucun d'eux, tel Eschyle ou Molière, n'a souci du lieu scénique. La scène n'a plus que le forme d'un réduit, d'une alcôve ; elle ne requiert plus que le lit."
                                            },
                                            {
                                                "example_id": "3b15334f-3543-44bb-9796-37172b37141f",
                                                "sense_id": "25887771-3d08-34bb-bf1c-25e41b80be32",
                                                "text": "En quoi leur vécu stylisé et codé par les normes du genre opératique, leurs émotions transmises par le biais de lois musicales et scéniques, ont-ils le pouvoir de concerner non seulement les générations passées mais aussi celles de demain ?"
                                            },
                                            {
                                                "example_id": "556f6f41-a12f-4fa7-8982-5d6e05c39e4c",
                                                "sense_id": "25887771-3d08-34bb-bf1c-25e41b80be32",
                                                "text": "À 20 ans à peine, il atteint une immense popularité, créant des émeutes sur son passage, faisant de chacune de ses apparitions télé et scéniques – dans les cabarets – un événement. Michel Louvain chante l’amour à un public qui en redemande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58948a59-9390-3399-b1de-988942b0f4f7",
                                        "entry_id": "0562d358-4366-36ab-89e7-f0ac07ce4c05",
                                        "glosses": [
                                            "Qui convient à la scène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a6d215-fe9a-4b9b-aa82-31eeed4bf00b",
                                                "sense_id": "58948a59-9390-3399-b1de-988942b0f4f7",
                                                "text": "Autres comportements scéniques : une femme tire la tête de son mari en rêvant qu’elle cueille des pommes, un homme enfile le drap comme un pantalon, plonge comme pour attraper un ballon de foot et se cogne violemment au radiateur, un patient voulant échapper à un éléphant recule dans le lit jusqu’à se retrouver carrément assis sur sa femme !"
                                            },
                                            {
                                                "example_id": "d9cded8b-719f-4c69-b405-863738795dea",
                                                "sense_id": "58948a59-9390-3399-b1de-988942b0f4f7",
                                                "text": "Confortablement installée à ma fenêtre, je goûtais la morsure du soleil, un bouquin à la main, quand une puissante impression scénique m’a saisie.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
