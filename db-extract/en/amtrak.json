                        "examples": [
                            {
                                "example_id": "47534f9f-5ddf-47f2-b567-1f32592dac07",
                                "sense_id": "41b1c689-9bd6-3e72-b8a5-27f597904d36",
                                "text": "Trains are fuller under Amtrak, but it is thought to be largely because there are fewer trains."
                            },
                            {
                                "example_id": "9710fde1-cca0-4813-836b-63e9681b7675",
                                "sense_id": "41b1c689-9bd6-3e72-b8a5-27f597904d36",
                                "text": "Its pitifully small appropriation of $40 million already gone, Amtrak has asked Congress for another $170 million to keep the trains running through mid-1973."
                            },
                            {
                                "example_id": "397195d4-48c7-418b-8692-82926fa7c5d7",
                                "sense_id": "41b1c689-9bd6-3e72-b8a5-27f597904d36",
                                "text": "The Amtrak brand revitalization approach represents one of the most ambitious, comprehensive, and systematic experiential marketing approaches I have ever seen."
                            }
                        ]
