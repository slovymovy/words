                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1792cc3c-42d8-4cf8-8b4e-1a9d5e97e44d",
                                "sense_id": "006f1fb8-f2dc-3798-8b29-049030f4bbec",
                                "text": "„Als das Donnergrollen näher rückt und erste schwere Tropfen auf meiner Stirn platzen, steige ich hinunter und setze mich auf den Beifahrersitz.“"
                            },
                            {
                                "example_id": "39ce78af-6a55-4ba9-8e15-9ac511409596",
                                "sense_id": "006f1fb8-f2dc-3798-8b29-049030f4bbec",
                                "text": "„Es gab um den Globus verteilt angeblich immer wieder vereinzelt dieses Donnergrollen, ohne dass ein Blitz beobachtet werden konnte.“"
                            },
                            {
                                "example_id": "1f021b9f-0eab-4a2d-a57b-169c7cd20669",
                                "sense_id": "006f1fb8-f2dc-3798-8b29-049030f4bbec",
                                "text": "„Draußen hörte ich Donnergrollen und einen Moment später erleuchtete das grelle Flackern eines Blitzes den Dachstuhl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
