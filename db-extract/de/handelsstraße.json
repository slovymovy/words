                ],
                "senses": [
                    {
                        "sense_id": "8ac2e13f-8d48-3670-926b-9c8e1323917e",
                        "entry_id": "c83d9900-6aa8-308f-8f2a-21d083a03406",
                        "glosses": [
                            "Weg, der zum Transport von Waren dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893283f8-92f9-4652-96d8-128527062b2f",
                                "sense_id": "8ac2e13f-8d48-3670-926b-9c8e1323917e",
                                "text": "„Der Platz war auch dafür geeignet, insofern als hier vermutlich eine alte Handelsstraße, die von der Elbe kam, die Dosse überschritt und sich bereits eine größere wendische Niederlassung hier befunden hatte, die im 10. Jh. Mittelpunkt eines Burgwardes war.“"
                            },
                            {
                                "example_id": "ef734db9-56f8-4659-85d4-ca66f86e2625",
                                "sense_id": "8ac2e13f-8d48-3670-926b-9c8e1323917e",
                                "text": "„Arabisch-sansibarische Kaufleute hatten nicht nur die großen Niederlassungen fest im Griff, sie übten auch die Macht entlang ihrer Handelsstraßen aus.“"
                            },
                            {
                                "example_id": "810b103e-e943-4e65-8bad-a5dacf3f3eaa",
                                "sense_id": "8ac2e13f-8d48-3670-926b-9c8e1323917e",
                                "text": "„Die schiffbaren Flüsse hatten eine ähnliche Bedeutung wie die großen Handelsstraßen, über die auf Bollerwagen mit zum Teil noch speichenlosen Scheibenrädern die Waren von Messestadt zu Messestadt und von Marktfleck zu Marktfleck geschafft wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
