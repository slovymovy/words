                        "entry_id": "ce8a2514-c05e-3db0-98b3-efb85c67de6b",
                        "glosses": [
                            "Celle qui est sale."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d17f41-1dc6-48bf-a0b1-4ae31943a4be",
                                "sense_id": "c08d0151-2522-389a-8d03-c0dafe56820d",
                                "text": "Et poure qui ? pour une salaude, toute fripée toute vieille, toute crasseuse… que j’ai ramassée par pitié…"
                            }
                        ]
                    },
                    {
                        "sense_id": "55aad7ad-99ba-33ec-971e-f0b46c270e00",
                        "entry_id": "ce8a2514-c05e-3db0-98b3-efb85c67de6b",
                        "glosses": [
                            "Femme qui agit de façon immorale, méprisable."
                        ],
                        "tags": [
                            "broadly",
                            "offensive",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "8c3a309e-ec41-4cdb-bc7e-828f63d74e76",
                                "sense_id": "55aad7ad-99ba-33ec-971e-f0b46c270e00",
                                "text": "Le prince brandit son énorme vit en criant : « Comment, jeunes salaudes, encore et toujours à vous passer la main dans le derrière ! »"
                            }
                        ]
                    }
