                "senses": [
                    {
                        "sense_id": "15121f34-1f4d-351a-80f9-3f52f926f3d6",
                        "entry_id": "8138258f-073c-35f2-bf95-bfe577c1a726",
                        "glosses": [
                            "Stiftungsvermögen, das zur Finanzierung des Baus/Betriebs/der Erhaltung einer Kirche oder zu ähnlichen Zwecken dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6595b670-9e95-4998-843b-70e8e597963d",
                                "sense_id": "15121f34-1f4d-351a-80f9-3f52f926f3d6",
                                "text": "„Für die Kirchenfabrik, d. h. die Unterhaltung der Kirche wies die Brudermeister-Rechnung ein Vermögen von 93 Gulden auf; ferner bezog die Bruderschaft 2½ Fuder Wieswachs und von einer Wiese 10 Denare Zins; sie besaß 10 Acker Land und einen Rodbusch »mit 2 Malter zu besähen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8a4b29b-08c1-329f-8360-082724bc1375",
                        "entry_id": "8138258f-073c-35f2-bf95-bfe577c1a726",
                        "glosses": [
                            "öffentlich-rechtliche Körperschaft zur Verwaltung des Vermögens einer Pfarrei"
                        ],
                        "tags": [
                            "Belgien",
                            "Elsass",
                            "historisch auch Luxemburg"
                        ],
                        "examples": [
                            {
                                "example_id": "907b4515-58db-4b74-aebe-8a3d8b00ec9c",
                                "sense_id": "c8a4b29b-08c1-329f-8360-082724bc1375",
                                "text": "„Eine Kirchenfabrik ist eine öffentliche Einrichtung mit Rechtspersönlichkeit.“"
                            },
                            {
                                "example_id": "b20cbbb2-e0a3-404e-9893-3ec8748260de",
                                "sense_id": "c8a4b29b-08c1-329f-8360-082724bc1375",
                                "text": "„Die Kirchenfabriken der DG sollen dazu verpflichtet werden, ihre Vermögen offenzulegen. […] Hintergrund ist, dass die verschiedenen Gemeinden die Kirchenfabriken bezuschussen.“"
                            },
                            {
                                "example_id": "6ce54a01-6b55-4e1f-bb3f-514ea8bd37bc",
                                "sense_id": "c8a4b29b-08c1-329f-8360-082724bc1375",
                                "text": "„Sein Anliegen war es dabei, im Unterschied zu seinen klerikalen Kollegen aus Paris und Metz, die existierenden Kirchenfabriken in associations cultuelles nach dem Gesetz von 1905 umzuwandeln, um eine Revisionsdebatte im Parlament und damit die ‚querelles stériles‘ zu vermeiden.“"
                            },
                            {
                                "example_id": "639d5208-0344-4b8c-8e65-995c474779d9",
                                "sense_id": "c8a4b29b-08c1-329f-8360-082724bc1375",
                                "text": "„Im Streit um die Basilika-Konvention schlägt die Echternacher Kirchenfabrik versöhnliche Töne an und will zu einer Einigung finden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
