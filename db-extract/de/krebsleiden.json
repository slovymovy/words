                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144f1c5e-fa7b-4b9a-a2c0-13ba524cff3b",
                                "sense_id": "d6901795-7bbc-30bd-bfb9-9c7e2aad7bb8",
                                "text": "Sein Großvater starb letztes Jahr an einem Krebsleiden."
                            },
                            {
                                "example_id": "430eac33-9182-450a-b6cb-5a1e9e37e0f0",
                                "sense_id": "d6901795-7bbc-30bd-bfb9-9c7e2aad7bb8",
                                "text": "„Kurz darauf starb der frühere Rebell in einem Moskauer Krankenhaus, wo er wegen eines Krebsleidens behandelt wurde.“"
                            },
                            {
                                "example_id": "ad0f4a05-3d70-461d-96d9-ac7c34aac5a6",
                                "sense_id": "d6901795-7bbc-30bd-bfb9-9c7e2aad7bb8",
                                "text": "„In der Gestalt der von einem tödlichen Krebsleiden befallenen Amerikanerin Kate Hegström läßt Remarque im übrigen eine sympathische Gegenfigur zu Joan Madou auftreten.“"
                            }
                        ],
