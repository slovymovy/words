                                        "glosses": [
                                            "Verschlag zur Haltung von Haustauben in Form eines Häuschens, das auf einer Säule steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b1ab8a-e065-4245-ad00-110bbb9578ca",
                                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                                "text": "„Weshalb setzen wir ein Taubenhaus auf eine himmelhohe Stange? – Um die jeder Verteidigung fast unfähigen Insassen vor dem Marder zu schützen. Er kommt aber doch hinein.“"
                                            },
                                            {
                                                "example_id": "09e04637-6b1a-4848-a450-32736e376954",
                                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                                "text": "„Das Dach ist voller Technik: Überall sind Lüftungen, Bauten für die Klimaanlage des Kaufhauses. Dazwischen steht unauffällig ein Taubenhaus, 15 Quadratmeter Fläche, etwa zwei Meter hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
