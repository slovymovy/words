                        "form_id": "02153749-d624-4290-9ca4-c137da15c8be",
                        "entry_id": "7fb520b4-aac2-30b4-8517-b683e8473492",
                        "tags": [
                            "plural"
                        ],
                        "form": "abecedarians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "639d123b-a5bf-3174-9e92-165c755ccbc1",
                        "entry_id": "7fb520b4-aac2-30b4-8517-b683e8473492",
                        "glosses": [
                            "Someone who is learning the alphabet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3427a7d9-4f88-39cc-ab47-073a14b12d2d",
                        "entry_id": "7fb520b4-aac2-30b4-8517-b683e8473492",
                        "glosses": [
                            "An elementary student, a novice; one in the early steps of learning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166719d2-935f-47e5-9ad3-9d328e5066cf",
                                "sense_id": "3427a7d9-4f88-39cc-ab47-073a14b12d2d",
                                "text": "A man may alwaies continue his studie, but not schooling. O fond-foolish for an old man to be ever an Abcedarian [translating abecedaire]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4665b87-4084-3ea8-bcb7-e8968d7b3bf3",
                        "entry_id": "7fb520b4-aac2-30b4-8517-b683e8473492",
                        "glosses": [
                            "Someone engaged in teaching the alphabet; an elementary teacher; one that teaches the methods and principles of learning."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c7170e30-3325-3f5a-8a8d-9a833c1bd979",
                        "entry_id": "7fb520b4-aac2-30b4-8517-b683e8473492",
                        "glosses": [
                            "A work which uses words or lines in alphabetical order."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "324e2c59-2d9d-42bb-8cf4-0c8388421b46",
                                "sense_id": "c7170e30-3325-3f5a-8a8d-9a833c1bd979",
                                "text": "This formal organization is most likely to create obscurity in such elaborate and artificial forms as: palindromes (words, phrases, or verses which read the same backward or forward), abecedarians (poems in which the initial letters of lines or stanzas are arranged to[…])[…]."
                            },
                            {
                                "example_id": "282c61ff-ee2e-4cf8-bf15-ac8a649b8c14",
                                "sense_id": "c7170e30-3325-3f5a-8a8d-9a833c1bd979",
                                "text": "Abecedarian verses are chanted stichoi/stichera verses in which the first letter of each verse follows an alphabetical order.[…]The Amomos, an abecedarian, is the longest psalm in the Psalter[…]."
                            },
                            {
                                "example_id": "0ee62fe2-a393-47e7-8c19-7ed2cbfd9cac",
                                "sense_id": "c7170e30-3325-3f5a-8a8d-9a833c1bd979",
                                "text": "An Abecedarian is any poem constrained by alphabetical order."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
