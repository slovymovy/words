                        ],
                        "examples": [
                            {
                                "example_id": "a3691791-7657-42e5-a818-7696666901c8",
                                "sense_id": "530189e2-0f0b-31b5-a4e0-4b7700cd857c",
                                "text": "Corinne, avec ses cheveux courts, elle fait lesbos.",
