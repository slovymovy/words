                    {
                        "translation_id": "c981dcef-151f-4634-9232-794dd418a3f7",
                        "source_entry_id": "307032b1-5b70-3f15-9013-3cfbefcaff89",
                        "source_sense_id": "7e5cf2cc-6a32-3be4-933b-de8c1ea25ade",
