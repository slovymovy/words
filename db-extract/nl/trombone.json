                        "sense_id": "f5be29ff-56bd-3595-981f-74adca44612a",
                        "entry_id": "d718192b-d17e-3626-a235-7fdf361787eb",
                        "glosses": [
                            "koperen blaasinstrument waarbij de toonhoogte door middel van spanning van de lippen en een schuif wordt geregeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfa21f2-bc8d-4bb7-b402-58408588dd57",
                                "sense_id": "f5be29ff-56bd-3595-981f-74adca44612a",
                                "text": "De trombone was op de grond gevallen, maar gelukkig deed de schuif het nog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87d3df9d-e920-4c99-b11b-5aaa015a760e",
                        "source_entry_id": "d718192b-d17e-3626-a235-7fdf361787eb",
                        "source_sense_id": "f5be29ff-56bd-3595-981f-74adca44612a",
