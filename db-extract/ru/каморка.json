                "senses": [
                    {
                        "sense_id": "0ecd8298-01ef-3e51-a1be-c38f2f75a5c9",
                        "entry_id": "d6102dbc-de54-304a-95ad-d58d3d2d2b94",
                        "glosses": [
                            "разг. уменьш. к камо́ра; маленькая комната или чулан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "425cc17f-70ef-44ac-bd89-b656e5584202",
                                "sense_id": "0ecd8298-01ef-3e51-a1be-c38f2f75a5c9",
                                "text": "Каморка его приходилась под самою кровлей высокого пятиэтажного дома и походила более на шкаф, чем на квартиру."
                            },
                            {
                                "example_id": "243e2a13-3336-4493-8745-ec10adf741a3",
                                "sense_id": "0ecd8298-01ef-3e51-a1be-c38f2f75a5c9",
                                "text": "Когда ей резали аппендикс в Киеве, он не выходил из больницы и всё время жил в каморке у больничного швейцара."
                            }
                        ]
                    }
