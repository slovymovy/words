                ],
                "senses": [
                    {
                        "sense_id": "4148c1f5-4fa5-31eb-a34e-e40749f1573b",
                        "entry_id": "874c7d14-e9f8-3c5a-b936-8b13ad30a7d8",
                        "glosses": [
                            "Qui pullule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1fb7b0b-e2a9-4e14-a186-a4ab3dfefeee",
                                "sense_id": "4148c1f5-4fa5-31eb-a34e-e40749f1573b",
                                "text": "Sa femme, grosse dès la nuit des noces, accouchée d’un garçon en mai, était grosse encore de deux mois, dans un de ces cas de fécondité pullulante qui ne laissent pas aux mères le temps d’allaiter leurs petits."
                            },
                            {
                                "example_id": "232e407a-7fd9-4e02-8a17-4f51a87da1b5",
                                "sense_id": "4148c1f5-4fa5-31eb-a34e-e40749f1573b",
                                "text": "Des deux côtés, des prairies comblées d’herbes pullulantes, de hautes haies plantées de chênes humides et des bouquets de peupliers ; tout l’horizon est une grande coupe plate de verdure."
                            },
                            {
                                "example_id": "ee1664da-db59-44ff-8912-750a0c07a297",
                                "sense_id": "4148c1f5-4fa5-31eb-a34e-e40749f1573b",
                                "text": "Ah! Théophraste Renaudot, triste novateur, pâle nigaud, viens donc contempler ta pullulante progéniture!"
                            },
                            {
                                "example_id": "e2899f82-324d-40c3-93f5-352e7ed63c9f",
                                "sense_id": "4148c1f5-4fa5-31eb-a34e-e40749f1573b",
                                "text": "Les enfants, cessant de jouer, filaient entre les jambes, à travers l’activité pullulante des trottoirs."
                            }
                        ]
                    }
                ],
