                "senses": [
                    {
                        "sense_id": "c2020b65-eb19-35fe-a5fb-893ae8dfd46a",
                        "entry_id": "d6dcda1d-0df2-3fbe-845d-20b8dd43be8b",
                        "glosses": [
                            "Accorder un statut de permanent à."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "1a7492ed-f17a-4d61-bc5f-68dc38d05aab",
                                "sense_id": "c2020b65-eb19-35fe-a5fb-893ae8dfd46a",
                                "text": "L'Ugta veut permaniser 150.000 travailleurs."
                            },
                            {
                                "example_id": "faa23595-91a5-4faf-bf51-c15f3be5ed30",
                                "sense_id": "c2020b65-eb19-35fe-a5fb-893ae8dfd46a",
                                "text": "Par ailleurs, M. Ben Hamadi a ordonné de permaniser l'ensemble des contractuels dans le cadre du pré-emploi comme il n'a pas manqué d'ordonner le remplacement des retraités par les jeunes licenciés des universités afin de combler le vide enregistré dans les ressources humaines des structures des deux institutions à savoir Algérie Télécoms et Algérie Postes."
                            },
                            {
                                "example_id": "6d5a6b30-a64a-4b70-8f90-2b9221f462b3",
                                "sense_id": "c2020b65-eb19-35fe-a5fb-893ae8dfd46a",
                                "text": "Cette loi qui oblige les employeurs de « permaniser » une partie des jeunes embauchés dans le cadre de ce dispositif, au bout de deux ans est « ignorée » par la majorité des entreprises."
                            }
                        ]
                    }
