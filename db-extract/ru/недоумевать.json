                    },
                    {
                        "translation_id": "df6a678c-37a7-485e-99d5-4ac8810af93b",
                        "source_entry_id": "52b62cbe-3f48-3114-9868-fdf9e63c9376",
                        "source_sense_id": "cc6d17b1-16eb-3a74-8cf0-23485211abde",
                        "target_lang_word": "s'étonner",
