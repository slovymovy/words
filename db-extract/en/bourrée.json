                                                "sense_id": "b0a5f8e4-ccfd-3283-98ba-a6631599aa1e",
                                                "text": "„Ein der Bourree ähnlicher Tanz ist das Rigodon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "714a1d46-e969-32bf-a4aa-97fea8970ed8",
                                        "entry_id": "432f6366-4d2c-3d0d-b93d-da1e6725be21",
                                        "glosses": [
                                            "Musikstück, das zu [1] komponiert wurde"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fabe9a-f2f0-4b97-b961-70ac9ec55778",
                                                "sense_id": "714a1d46-e969-32bf-a4aa-97fea8970ed8",
                                                "text": "„Hier findet eine Überlagerung von thematischer und ornamentaler Funktion statt, wie er auf ähnliche Art in der Bourree I der Violoncello-Suite IV anzutreffen ist (ein genau entsprechender Fall von 16tel-Gruppen), aber auch in der Bourree II der französischen Ouverture, in der sogar auf der Thesis häufig eine aus dem Doppelschlag generierte Figur steht.“"
                                            }
                                        ],
