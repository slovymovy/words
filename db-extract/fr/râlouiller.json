                ],
                "senses": [
                    {
                        "sense_id": "42e767db-094c-35bf-bc06-05caa2e5d040",
                        "entry_id": "a049c536-7e32-3cba-a087-6fdd8956a99f",
                        "glosses": [
                            "Râler faiblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ce0084-cbc3-4b69-ae46-b500f3273025",
                                "sense_id": "42e767db-094c-35bf-bc06-05caa2e5d040",
                                "text": "Benjamin finissait toujours par râlouiller, arguant que les filles venaient toujours à nous pour les mauvaises raisons, à savoir ma belle gueule."
                            },
                            {
                                "example_id": "0ad53b93-16ad-44d9-8738-5d9e6bc871f5",
                                "sense_id": "42e767db-094c-35bf-bc06-05caa2e5d040",
                                "text": "Le plaintif roubillonne, rouscaille et râlouille, mais, au contraire du syndicaliste convaincu, il ne se risque pas à ces borborygmes pour une cause annexée à la sienne."
                            }
                        ]
                    }
