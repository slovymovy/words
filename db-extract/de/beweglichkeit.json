                        ],
                        "form": "die Beweglichkeit"
                    },
                    {
                        "form_id": "88c6c3fa-79ec-4295-9435-d7346557a78e",
                        "entry_id": "76af694f-e89e-3dd2-8052-b3faace06f21",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Beweglichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8f92fda-531d-3ce7-83b3-565bb03398a0",
                        "entry_id": "76af694f-e89e-3dd2-8052-b3faace06f21",
                        "glosses": [
                            "Fähigkeit, sich bewegen zu können, sich bewegen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40388144-ae79-4181-b328-40d189e59138",
                                "sense_id": "b8f92fda-531d-3ce7-83b3-565bb03398a0",
                                "text": "„Und gerade diese Maschine hat dank der freien Beweglichkeit der Teile und dem langen Dämpfungshub ein fest verlegtes Fundament, das nie zu Problemen Anlaß gegeben hat.“"
                            },
                            {
                                "example_id": "153a75d7-5f4b-42cf-ad06-794f4a185f85",
                                "sense_id": "b8f92fda-531d-3ce7-83b3-565bb03398a0",
                                "text": "„Damit liegt praktisch keine freie Beweglichkeit der einzelnen Polymerketten vor, das ganze dreidimensionale Gebilde aus Polymerketten ist sehr inflexibel und brüchig: Es verhält sich in vielerlei Hinsicht wie Glas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                        "entry_id": "76af694f-e89e-3dd2-8052-b3faace06f21",
                        "glosses": [
                            "Grad, wie beweglich, wendig etwas ist (zum Beispiel ein Körperteil); Ausmaß von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a78b35-991f-44e2-9205-6f6dc295b4e6",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Die Beweglichkeit wird den konditionellen Fähigkeiten zugeschrieben.“"
                            },
                            {
                                "example_id": "4c96f11f-da4d-4c61-b391-a975def9f2b7",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Sportwissenschaftler Lutz Herdener stellt dir 50 Workouts vor, um Muskeln aufzubauen, deine Kraftausdauer zu steigern, die Stabilität deines Körpers zu verbessern und deine Beweglichkeit zu fördern.“"
                            },
                            {
                                "example_id": "fe42673e-b844-4fa3-88b6-3794b7de3a87",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Dabei ist nicht nur Kraft gefragt, sondern auch Beweglichkeit, Fingerspitzengefühl und Balance.“"
                            },
                            {
                                "example_id": "ed309731-f192-4b6e-8297-82a1c67f672b",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Was die muskuläre Beweglichkeit anbelangt, so nimmt diese tendenziell im Laufe des Lebens ab.“"
                            },
                            {
                                "example_id": "164a9e33-507e-4b86-9307-54eb1ffcf70e",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Die Förderung von Beweglichkeit und Mobilität im Alter sind wesentlich, um Selbstständigkeit und soziale Teilhabe lange aufrecht zu erhalten.“"
                            },
                            {
                                "example_id": "1ce124c8-c954-4246-9430-970c2cacc97c",
                                "sense_id": "6b4003ca-56d6-3e53-ba0b-8baa7a9cf0b2",
                                "text": "„Geistig steht Vata zugleich für das Denken, für geistige Wachheit sowie für körperliche und geistige Beweglichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cbdc563c-5706-3bf1-9366-f90faecc6ee3",
                        "entry_id": "76af694f-e89e-3dd2-8052-b3faace06f21",
                        "glosses": [
                            "Eigenschaft, über gute geistige Fähigkeiten zu verfügen, geistig wendig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c448acf-e330-482a-9b34-f02b84214344",
                                "sense_id": "cbdc563c-5706-3bf1-9366-f90faecc6ee3",
                                "text": "„Geistig steht Vata zugleich für das Denken, für geistige Wachheit sowie für körperliche und geistige Beweglichkeit.“"
                            },
                            {
                                "example_id": "c0919d9d-1fe8-452d-b5bf-9107ac79953d",
                                "sense_id": "cbdc563c-5706-3bf1-9366-f90faecc6ee3",
                                "text": "„Es ist erwiesen, dass durch lockere Bewegungen, zum Beispiel beim Tanzen, auch die geistige Beweglichkeit wieder gefördert wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
