                "senses": [
                    {
                        "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                        "entry_id": "8ce33fc4-3df6-3d24-992d-e430846b6f1f",
                        "glosses": [
                            "zur Familie der Schmetterlingsblütler gehörende Blütenpflanze, die als eiweißreiches Viehfutter angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debb45b1-bdf4-4b61-9895-cad2dcb7e8e2",
                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                "text": "Dagegen gedeihen Lupinen, Sonnenblumen und Serradella auf schwach sauren Böden am besten."
                            },
                            {
                                "example_id": "8a08c7a5-18ed-46b9-8561-f1500ab33f07",
                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                "text": "Ärmlich brennt das Licht der Lupinen."
                            },
                            {
                                "example_id": "b44bb30e-ce73-4c77-acee-1b2c310f0e7d",
                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                "text": "„Doch richtig schlimm wird es, wenn es um die Lupinen geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
