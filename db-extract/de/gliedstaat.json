                "senses": [
                    {
                        "sense_id": "0f68534f-74d8-3e39-8092-91d79437f8d7",
                        "entry_id": "61e3578f-7715-3dff-a83c-ff2e98574399",
                        "glosses": [
                            "Staat, der Teil eines föderalistischen Staates ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f3a556-1bcc-45be-a66f-3d55473218ea",
                                "sense_id": "0f68534f-74d8-3e39-8092-91d79437f8d7",
                                "text": "„So sollten es Kinder in der Schule leichter haben, wenn sie von einem Schweizer Gliedstaat in einen anderen umziehen.“"
                            },
                            {
                                "example_id": "8040a01f-5810-4df7-870b-2239b7e8b8f3",
                                "sense_id": "0f68534f-74d8-3e39-8092-91d79437f8d7",
                                "text": "„Bei den Verhandlungen um eine Staatsreform spielen die Minderheitenrechte von Frankofonen in Flandern eine Hauptrolle. Daneben geht es um die Verlagerung von Kompetenzen auf die Gliedstaaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
