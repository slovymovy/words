                                            {
                                                "example_id": "9409ba97-5582-4dda-8042-9b98033161ab",
                                                "sense_id": "1662790c-dc08-3d65-9e00-6e66e542ac65",
                                                "text": "Hierop zet je een vaas met bloemen."
                                            },
                                            {
                                                "example_id": "52dc2cc9-581b-41cf-bb1e-154fb2249427",
                                                "sense_id": "1662790c-dc08-3d65-9e00-6e66e542ac65",
                                                "text": "Hierop had hij geen antwoord."
                                            },
                                            {
                                                "example_id": "80f05d58-1d5c-42d4-a0e1-bfba7c02f9db",
                                                "sense_id": "1662790c-dc08-3d65-9e00-6e66e542ac65",
                                                "text": "Ik was verrast en blij om te zien hoeveel mensen hierop reageerden, waardoor binnen twee weken mijn streefdoel van 4.286 dollar was behaald."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
