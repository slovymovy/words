                "word": "klimaatspijbelaar",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "41e40734-b6b5-46e5-92c3-d49ec9e3cf5e",
                        "entry_id": "d21e9f60-2c01-3336-99b4-cca85406a28b",
                        "tags": [
