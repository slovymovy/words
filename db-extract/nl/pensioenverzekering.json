                        "glosses": [
                            "een verzekering die een periodieke uitkering uitkeert als men ouder is dan een bepaalde leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc4cb24-23a6-4a99-9db6-39cfd05f14a4",
                                "sense_id": "a6c50960-f0ea-360d-808c-29303ea38229",
                                "text": "Mensen met een pensioenverzekering bouwen geen verder pensioen op als de werkgever geen premies heeft betaald. Zij zullen zelf moeten proberen dat geld alsnog op de werkgever te verhalen."
                            },
                            {
                                "example_id": "4ba9222f-7a70-4c06-8d41-a66b90996ed2",
                                "sense_id": "a6c50960-f0ea-360d-808c-29303ea38229",
                                "text": "38 procent van de werknemers weet niet of hun pensioen wel toereikend is. In de leeftijdsgroep 25-35 jaar denkt zelfs meer dan de helft van de ondervraagden dat het pensioen niet genoeg is om uit de armoede te blijven. De vakcentrale noemt het een \"duidelijk signaal dat het vertrouwen in de pensioenverzekering massaal inzakt\"."
                            }
                        ]
