                                    },
                                    {
                                        "sense_id": "9e13fd36-a217-311c-b683-5bc6313b0ff3",
                                        "entry_id": "eb097d45-8db9-3060-a0c6-da0ce7553e26",
                                        "glosses": [
                                            "Offizier im Range eines Admirals, im weiteren Sinne jeder Offizier in der Laufbahngruppe der Admirale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f5c83c-dded-4cdf-a169-ad751ad96cad",
                                                "sense_id": "9e13fd36-a217-311c-b683-5bc6313b0ff3",
                                                "text": "Die Windstärkenskala wurde vom britischen Admiral Beaufort eingeführt."
                                            },
                                            {
                                                "example_id": "b2570894-d239-4bae-9868-1cd3bd1524c0",
                                                "sense_id": "9e13fd36-a217-311c-b683-5bc6313b0ff3",
                                                "text": "„Im April 1944 bediente sich Admiral Rolf Johannesson derselben Zeilen während eines Gedenkgottesdienstes für einhundert Seeleute, die bei einem britischen Luftangriff gegen das Schlachtschiff TIRPITZ ums Leben gekommen waren.“"
                                            },
                                            {
                                                "example_id": "776ee100-1c46-4a1d-b4c7-0c2472579ef3",
                                                "sense_id": "9e13fd36-a217-311c-b683-5bc6313b0ff3",
                                                "text": "„Der Admiral stellte Narcisse die gleiche Frage, der, für mich wenig überraschend, Kapität Porteret seinerseits nicht erkannte.“"
                                            },
                                            {
                                                "example_id": "cb93d9cb-8fb0-4dab-9080-b4a710c5d74e",
                                                "sense_id": "9e13fd36-a217-311c-b683-5bc6313b0ff3",
                                                "text": "„Seit September 1940 ist er Vizeadmiral, am 14. März 1942 wird Hitler ihn zum Admiral befördern und weitere zehn Monate später zum Großadmiral.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "176c0ed8-642f-3970-afb5-508e8caef403",
                                        "entry_id": "eb097d45-8db9-3060-a0c6-da0ce7553e26",
                                        "glosses": [
                                            "Schmetterling , der in Südeuropa überwintert"
                                        ],
