                "senses": [
                    {
                        "sense_id": "27dbc366-01f6-326c-92ed-bf47dba26b14",
                        "entry_id": "cd0a7cb4-2285-34e7-bade-fd7f2cd5b648",
                        "glosses": [
                            "горящий постоянно; неугасающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bda2923-c034-4d95-89aa-a47ff0665f2e",
                                "sense_id": "27dbc366-01f6-326c-92ed-bf47dba26b14",
                                "text": "Мы видим мерцание звезд, ослепляющий свет солнечных лучей и «московских окон негасимый свет» — это тоже вибрация."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bd04ebe-f90c-3d92-82bf-98a0931f24bc",
                        "entry_id": "cd0a7cb4-2285-34e7-bade-fd7f2cd5b648",
                        "glosses": [
                            "перен. не ослабевающий в течение долгого времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a660476f-cbc8-4f2f-b953-02cfa7569cc8",
                                "sense_id": "6bd04ebe-f90c-3d92-82bf-98a0931f24bc",
                                "text": "Тундры усталые плечи, // И негасимый закат. // Утро – а всё-таки вечер! // Камни – а всё-таки сад!"
                            }
                        ]
                    }
                ],
