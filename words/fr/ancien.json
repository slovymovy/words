                {
                    "sense_id": "7373acb4-1e10-32bb-bf85-abf00f52c8b5",
                    "sense_definition": "Personne qui a vécu dans des temps très éloignés de nous, notamment les auteurs et les peuples de l'Antiquité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ancien : personnes du passé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sucre était connu des <w>anciens</w> mais rarement utilisé."
                        },
                        {
                            "text": "Les <w>Anciens</w> croyaient que la Terre était au centre de l'univers."
                        }
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
                        "les anciens et les modernes",
                        "sagesse des anciens"
                    ]
                },
                {
                    "sense_id": "2bb750a0-9f27-30d2-af55-f4cb4f9059fc",
