            "senses": [
                {
                    "sense_id": "a6faeaac-ae17-3873-82ef-97a3361e7f97",
                    "sense_definition": "Donner une chose en contrepartie d'une autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voudrais <w>échanger</w> cette chemise parce qu'elle est un peu trop petite."
                        },
                        {
                            "text": "Les enfants aiment <w>échanger</w> leurs cartes de jeu pendant la récréation."
                        }
