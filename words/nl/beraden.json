                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>beraad</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
