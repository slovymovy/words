{
    "word_family": [
        "infestation",
        "infestant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31ef6cbd-2c87-3015-ab17-fd19cb649d05",
                    "sense_definition": "To inhabit a place in unpleasantly large numbers; to plague, harass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many types of insects <w>infest</w> the basement during the humid summer months.",
                            "target_lang_translations": {
                                "ru": "Многие виды насекомых <w>кишат</w> в подвале в течение влажных летних месяцев.",
                                "tr": "Nemli yaz aylarında bodrumu birçok böcek türü <w>basar</w>.",
                                "zh": "在潮湿的夏季，地下室会有许多种类的昆虫<w>出没</w>。"
                            }
                        },
                        {
                            "text": "Weeds <w>infest</w> the garden every spring if it is left untended.",
                            "target_lang_translations": {
                                "ru": "Если за садом не ухаживать, каждую весну его <w>наводняют</w> сорняки.",
                                "tr": "Bakımsız bırakılırsa her ilkbaharda bahçeyi yabani otlar <w>sarar</w>.",
                                "zh": "如果花园无人打理，每年春天杂草就会在其中<w>蔓延</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plague"
                    ],
                    "common_phrases": [
                        "infest the home",
                        "infest the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнять собой какое-либо место в неприятно большом количестве; досаждать, мучить.",
                        "tr": "Bir yeri rahatsız edici derecede kalabalık sayılarda istila etmek, basmak veya sarmak.",
                        "zh": "（害虫、盗贼等）大批出没、成群滋生于某处；大肆侵扰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "о большом количестве вредителей или насекомых в помещении"
                            },
                            {
                                "target_lang_word": "наводнять",
                                "target_lang_sense_clarification": "о массовом появлении чего-либо нежелательного"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "о навязчивых мыслях или беспокойстве"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "istila etmek",
                                "target_lang_sense_clarification": "haşere, böcek veya istenmeyen canlıların bir yeri sarması"
                            },
                            {
                                "target_lang_word": "basmak",
                                "target_lang_sense_clarification": "zararlıların ya da böceklerin bir mekâna doluşması"
                            },
                            {
                                "target_lang_word": "sarmak",
                                "target_lang_sense_clarification": "yabani ot veya böceklerin her yeri kaplaması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大批滋生",
                                "target_lang_sense_clarification": "害虫或杂草等大量繁殖滋长"
                            },
                            {
                                "target_lang_word": "出没",
                                "target_lang_sense_clarification": "害虫、有害动物等频繁成群活动"
                            },
                            {
                                "target_lang_word": "蔓延",
                                "target_lang_sense_clarification": "杂草等不良植物大范围生长侵占"
                            },
                            {
                                "target_lang_word": "横行",
                                "target_lang_sense_clarification": "害虫或盗贼等猖獗肆虐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e3c572c-19d9-3ad9-8ba5-b4713e679f49",
                    "sense_definition": "To invade a host plant or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain types of beetles <w>infest</w> the leaves of the oak tree every spring.",
                            "target_lang_translations": {
                                "ru": "Определенные виды жуков <w>поражают</w> листья дуба каждую весну.",
                                "tr": "Belirli kın kanatlı türleri her ilkbaharda meşe ağacının yapraklarına <w>musallat olur</w>.",
                                "zh": "每年春天，某些种类的甲虫都会<w>危害</w>橡树的叶子。"
                            }
                        },
                        {
                            "text": "Parasites often <w>infest</w> the skin of animals living in poor conditions.",
                            "target_lang_translations": {
                                "ru": "Паразиты часто <w>поражают</w> кожу животных, живущих в плохих условиях.",
                                "tr": "Parazitler kötü koşullarda yaşayan hayvanların derisini sıklıkla <w>sarar</w>.",
                                "zh": "寄生虫常常会<w>侵染</w>生活在恶劣条件下的动物的皮肤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "infest host plants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поражать растение или животное (о паразитах).",
                        "tr": "Bir konakçı bitkiyi veya hayvanı asalak olarak istila etmek, musallat olmak.",
                        "zh": "（寄生虫、病虫害等）侵染、寄生于动植物宿主。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "о воздействии паразитов на организм"
                            },
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "о проникновении паразитов в ткани"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "musallat olmak",
                                "target_lang_sense_clarification": "parazitlerin canlı bir konakçıya yerleşmesi"
                            },
                            {
                                "target_lang_word": "sarmak",
                                "target_lang_sense_clarification": "asalakların veya böceklerin bitki ya da hayvana yayılması"
                            },
                            {
                                "target_lang_word": "istila etmek",
                                "target_lang_sense_clarification": "parazitlerin organizmaya yayılması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侵染",
                                "target_lang_sense_clarification": "病虫害侵袭寄主植物或动物"
                            },
                            {
                                "target_lang_word": "寄生",
                                "target_lang_sense_clarification": "寄生虫寄居于动植物宿主"
                            },
                            {
                                "target_lang_word": "危害",
                                "target_lang_sense_clarification": "害虫危害叶片、枝干等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f68d7042-e9e1-31bf-83e5-130c24f36a47",
                    "sense_definition": "Mischievous; hurtful; harassing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight fought with a <w>infest</w> spirit against his many enemies.",
                            "target_lang_translations": {
                                "ru": "Рыцарь сражался с <w>враждебным</w> духом против своих многочисленных врагов.",
                                "tr": "Şövalye, çok sayıdaki düşmanına karşı <w>düşmanca</w> bir ruhla savaştı.",
                                "zh": "骑士带着<w>敌对的</w>斗志与他的众多敌人搏斗。"
                            }
                        },
                        {
                            "text": "He launched an <w>infest</w> attack that left his opponent completely defenseless.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>злобную</w> атаку, которая оставила его противника совершенно беззащитным.",
                                "tr": "Rakibini tamamen savunmasız bırakan <w>acımasız</w> bir saldırı başlattı.",
                                "zh": "他发起了一场<w>凶狠的</w>攻击，使对手毫无招架之力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебный, злобный, причиняющий вред (устар.).",
                        "tr": "Zararlı, düşmanca, taciz edici (eskimiş).",
                        "zh": "（古语）恶意的；有害的；充满敌意的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебный",
                                "target_lang_sense_clarification": "выражающий неприязнь"
                            },
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "исполненный злобы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düşmanca",
                                "target_lang_sense_clarification": "hasmane tavır veya niyet sergileyen"
                            },
                            {
                                "target_lang_word": "zararlı",
                                "target_lang_sense_clarification": "hasar verici, muzır"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶意的",
                                "target_lang_sense_clarification": "心怀怨恨或有害企图的"
                            },
                            {
                                "target_lang_word": "敌对的",
                                "target_lang_sense_clarification": "表现出敌意或侵害性的"
                            },
                            {
                                "target_lang_word": "凶狠的",
                                "target_lang_sense_clarification": "充满攻击性或残忍的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d719ecc-65f4-30b6-8cbe-26119e794a14",
                    "sense_definition": "Hostility.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>infest</w> of the crowd caught the guards by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>враждебность</w> толпы застала стражников врасплох.",
                                "tr": "Kalabalığın ani <w>düşmanlığı</w> muhafızları hazırlıksız yakaladı.",
                                "zh": "人群中突如其来的<w>敌意</w>让卫兵们措手不及。"
                            }
                        },
                        {
                            "text": "His words were filled with a deep <w>infest</w> toward his former allies.",
                            "target_lang_translations": {
                                "ru": "Его слова были наполнены глубокой <w>неприязнью</w> к бывшим союзникам.",
                                "tr": "Sözleri, eski müttefiklerine karşı derin bir <w>husumet</w> ile doluydu.",
                                "zh": "他的言语中充满了对昔日盟友的深深<w>敌意</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебность, неприязнь (устар.).",
                        "tr": "Düşmanlık, hasımlık (eskimiş).",
                        "zh": "（古语）敌意；敌对情绪；仇恨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "состояние неприязни"
                            },
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "чувство недоброжелательности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düşmanlık",
                                "target_lang_sense_clarification": "hasmane duygu veya durum"
                            },
                            {
                                "target_lang_word": "husumet",
                                "target_lang_sense_clarification": "derin nefrete dayalı çekişme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敌意",
                                "target_lang_sense_clarification": "仇视或敌对的情感"
                            },
                            {
                                "target_lang_word": "敌对",
                                "target_lang_sense_clarification": "互相对抗或仇恨的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}