                            "осветительный прибор, дающий сильный направленный пучок света"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "21d5dea9-d51f-3ff5-9eb8-b34d70282e92",
                        "entry_id": "7cd44769-3573-3e95-91f3-d4053e535e80",
