                        "glosses": [
                            "Not obliterated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "102ff4c0-535d-41c5-879d-0fa13a614a12",
                                "sense_id": "fcca92b0-06ac-39cb-a548-5a9b6dfdc478",
                                "text": "He re-entered the Place of the Capitol--he stood by the staircase of the Lion; there was a red stain upon the pavement, unobliterated since Montreal's execution, and the Senator drew himself aside with an inward shudder."
                            },
                            {
                                "example_id": "0e5b8fb7-4cbe-4a9e-8796-b3e585f0ba37",
                                "sense_id": "fcca92b0-06ac-39cb-a548-5a9b6dfdc478",
                                "text": "It should be noticed however that he too distinctly says that Joseph was of the tribe of Judah (Dial. 78) and that his family came from Bethlehem, which looks very much like an unobliterated trace of the same inconsistency."
                            },
                            {
                                "example_id": "f8f87d2b-4ce0-49bc-8c0f-4806dd30b4a6",
                                "sense_id": "fcca92b0-06ac-39cb-a548-5a9b6dfdc478",
                                "text": "These embossed books, unobliterated by the tears and laughter of Time, Are signed with the vital hands of undaunted men."
                            }
                        ]
                    }
