{
    "word_family": [
        "chip",
        "chipper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47212843-9335-3cb3-9725-8c3c425902a3",
                    "sense_definition": "Having small pieces broken off the edge or surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damaged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought me a <w>chipped</w> plate for my dinner.",
                            "target_lang_translations": {
                                "cs": "Číšník mi k večeři přinesl <w>otlučený</w> talíř."
                            }
                        },
                        {
                            "text": "Be careful with that mug because the rim is <w>chipped</w>.",
                            "target_lang_translations": {
                                "cs": "Dávej na ten hrnek pozor, protože má <w>otlučený</w> okraj."
                            }
                        }
                    ],
                    "synonyms": [
                        "damaged",
                        "broken"
                    ],
                    "antonyms": [
                        "intact"
                    ],
                    "common_phrases": [
                        "chipped plate",
                        "chipped mug"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající odštípnuté malé kousky z okraje nebo povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otlučený",
                                "target_lang_sense_clarification": "běžné pro nádobí a předměty"
                            },
                            {
                                "target_lang_word": "odštípnutý",
                                "target_lang_sense_clarification": "popisující konkrétní poškození"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba6933a-cfd5-3890-8ccc-9d0322204595",
                    "sense_definition": "Having a microchip implanted for identification purposes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every <w>chipped</w> pet cat can be easily returned to its owner.",
                            "target_lang_translations": {
                                "cs": "Každá <w>očipovaná</w> kočka může být snadno vrácena svému majiteli."
                            }
                        },
                        {
                            "text": "The shelter ensures that every dog is <w>chipped</w> before adoption.",
                            "target_lang_translations": {
                                "cs": "Útulek zajišťuje, aby byl každý pes před adopcí <w>očipován</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chipped pet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající implantovaný mikročip pro účely identifikace."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "očipovaný",
                                "target_lang_sense_clarification": "standardní termín pro zvířata"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "737b7737-f7dc-3fe0-900b-0a57b5abfed7",
                    "sense_definition": "Having an engine control unit modified to improve performance.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chipped</w> engine provides much more power than the original version.",
                            "target_lang_translations": {
                                "cs": "<w>Upravený</w> motor poskytuje mnohem vyšší výkon než původní verze."
                            }
                        },
                        {
                            "text": "He bought a <w>chipped</w> car that accelerates faster than a standard model.",
                            "target_lang_translations": {
                                "cs": "Koupil si <w>upravené</w> auto, které zrychluje rychleji než standardní model."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající upravenou řídicí jednotku motoru pro vyšší výkon."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "upravený",
                                "target_lang_sense_clarification": "v kontextu tuningu motoru"
                            },
                            {
                                "target_lang_word": "chiptuningovaný",
                                "target_lang_sense_clarification": "odborný slangový výraz"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d36f98f9-2f00-36d6-825d-7b21e2dab782",
                    "sense_definition": "Simple past and past participle of <w>chip</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>chipped</w> the paint while moving the heavy wooden table.",
                            "target_lang_translations": {
                                "cs": "Při stěhování těžkého dřevěného stolu <w>odštípl</w> barvu."
                            }
                        },
                        {
                            "text": "She has <w>chipped</w> her tooth on a hard piece of candy.",
                            "target_lang_translations": {
                                "cs": "O tvrdý bonbon si <w>odštípla</w> zub."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé od slovesa chip (odštípnout, oštípat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odštípl",
                                "target_lang_sense_clarification": "minulý čas"
                            },
                            {
                                "target_lang_word": "odštípnul",
                                "target_lang_sense_clarification": "hovorová varianta"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}