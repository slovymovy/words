                "senses": [
                    {
                        "sense_id": "68dc5121-00ba-3521-b82f-8c3575158bf8",
                        "entry_id": "e932e2bf-9a08-3748-8c3c-ff06d57022ec",
                        "glosses": [
                            "An Italian starter for a meal; normally a cold assortment of salami, cheese, seafood, and vegetables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22b0894-4e6f-46df-8fef-3c4ee24b9bbe",
                                "sense_id": "68dc5121-00ba-3521-b82f-8c3575158bf8",
                                "text": "The antipasto often features fettunta—thin slices of Tuscan bread toasted and salted (the bread itself is unsalted) and perhaps rubbed with garlic (you may prefer to rub it on for yourself, or not if you're due to discuss Uganda or have an interview with Silvio Berlusconi)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caa7d752-d5b8-4794-a686-0f85e20fb46a",
                        "source_entry_id": "e932e2bf-9a08-3748-8c3c-ff06d57022ec",
                        "source_sense_id": "68dc5121-00ba-3521-b82f-8c3575158bf8",
                        "source_sense_description": "Italian starter for a meal",
                        "target_lang_word": "předkrm",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "předkrm",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "27737ec8-a195-3af8-8999-329982a28c8b",
                                        "entry_id": "8a1a9ec7-d744-3d45-8a42-7ff8e1d1c0c2",
                                        "glosses": [
                                            "malá porce lehkého jídla podávaná před hlavním chodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed185e41-0167-4cab-8bc5-d30ff1730b7e",
                                                "sense_id": "27737ec8-a195-3af8-8999-329982a28c8b",
                                                "text": "Scezený chřest urovnáme na talíře, posypeme vejci, přelijeme horkým máslem s přísadami a posypeme sýrem. Podáváme jako sváteční předkrm, pohoštění k bílému vínu, vinnému střiku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5328a323-129f-3683-affd-c66a772f9063",
                                        "entry_id": "8a1a9ec7-d744-3d45-8a42-7ff8e1d1c0c2",
                                        "glosses": [
                                            "menší část předcházející hlavní na upoutání pozornosti, navození atmosféry apod."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9ee007-2f85-4f9d-92fa-047c42a4cef0",
                                                "sense_id": "5328a323-129f-3683-affd-c66a772f9063",
                                                "text": "Nad Roland Garros se honila mračna a v chladu i mokru většinu kurtů halily nepromokavé pláště. Přesto šla Paříž spát okouzlená: jako předkrm včerejší porce stačila. A dnes už to vypukne naplno."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
