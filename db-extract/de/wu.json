                "senses": [
                    {
                        "sense_id": "c8e5008b-3623-34ad-ac20-6d451b3dd2bc",
                        "entry_id": "61ead5f3-3eb2-336c-acd8-f6da42a90009",
                        "glosses": [
                            "chinesische Sprache, die vor allem in Shanghai und den Provinzen Zhejiang und Jiangsu gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2315e2-e4aa-43c5-a3b2-f018b349d74e",
                                "sense_id": "c8e5008b-3623-34ad-ac20-6d451b3dd2bc",
                                "text": "„Zählt man noch weitere chinesische Sprachen wie Kanton, Wu, Min und Hakka dazu, dann werden von rund 1,2 Mrd. Menschen chinesische Sprachen gesprochen, was einem Prozentsatz von 18,8 Prozent an der Weltbevölkerung entspricht.“"
                            },
                            {
                                "example_id": "f455f4b8-0580-462e-a670-c68a2eda0ad5",
                                "sense_id": "c8e5008b-3623-34ad-ac20-6d451b3dd2bc",
                                "text": "13 Mio. Menschen sprechen Schanghaiisch, das zum Wu-Dialekt gehört, benannt nach dem Königreich Wu in der heutigen Provinz Jiangsu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
