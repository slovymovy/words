{
    "word_family": [
        "snipper",
        "snipperen",
        "versnippering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "756df4a1-8425-30b7-a84c-8df3e9a54dae",
                    "sense_definition": "Iets in kleine stukjes of repen snijden, knippen of scheuren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shredding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente <w>versnippert</w> de ingezamelde kerstbomen.",
                            "target_lang_translations": {
                                "en": "The municipality <w>chips</w> the collected Christmas trees."
                            }
                        },
                        {
                            "text": "Medewerkers <w>versnipperden</w> de documenten voordat ze deze weggooiden.",
                            "target_lang_translations": {
                                "en": "Employees <w>shredded</w> the documents before throwing them away."
                            }
                        },
                        {
                            "text": "Je moet die vertrouwelijke papieren eerst <w>versnipperen</w>.",
                            "target_lang_translations": {
                                "en": "You must <w>shred</w> those confidential papers first."
                            }
                        }
                    ],
                    "synonyms": [
                        "verscheuren",
                        "fijnknippen"
                    ],
                    "common_phrases": [
                        "documenten versnipperen",
                        "papier versnipperen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cut, clip, or tear something into small pieces or strips."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shred",
                                "target_lang_sense_clarification": "to cut or tear into small strips"
                            },
                            {
                                "target_lang_word": "chip",
                                "target_lang_sense_clarification": "to cut wood or organic waste into small pieces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39645dcd-9615-3db5-af01-fa6631513847",
                    "sense_definition": "Zich verdelen in kleine, onsamenhangende delen of fragmenten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragmentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de interne ruzies dreigt de politieke partij te <w>versnipperen</w>.",
                            "target_lang_translations": {
                                "en": "Due to internal arguments, the political party is in danger of <w>splintering</w>."
                            }
                        },
                        {
                            "text": "We moeten voorkomen dat onze aandacht te veel gaat <w>versnipperen</w>.",
                            "target_lang_translations": {
                                "en": "We must prevent our attention from becoming too <w>scattered</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragmenteren",
                        "opdelen"
                    ],
                    "antonyms": [
                        "ontsnipperen"
                    ],
                    "common_phrases": [
                        "aandacht versnipperen",
                        "krachten versnipperen"
                    ],
                    "target_lang_definitions": {
                        "en": "To divide or split into small, disconnected parts or fragments."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fragment",
                                "target_lang_sense_clarification": "to break or split into small parts"
                            },
                            {
                                "target_lang_word": "splinter",
                                "target_lang_sense_clarification": "to divide into smaller, often opposing groups"
                            },
                            {
                                "target_lang_word": "scatter",
                                "target_lang_sense_clarification": "to disperse or divide attention or resources"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}