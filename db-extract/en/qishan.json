                    },
                    {
                        "sense_id": "5b069da8-d411-3e31-85c0-5da1f80b4972",
                        "entry_id": "6d4891d5-c8b7-3e7d-8aa3-5e2fd7b4c02c",
                        "glosses": [
                            "Synonym of Zongzhou, former capital of the Zhou, now An archaeological site in Baoji, Shaanxi, China."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                        "entry_id": "6d4891d5-c8b7-3e7d-8aa3-5e2fd7b4c02c",
                        "glosses": [
                            "A county of Baoji, Shaanxi, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a67ea46-291a-436a-a2fa-3c25d0ce40e2",
                                "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                                "text": "In one village in Chi-shan county . . . the village chief bought his son a wife with money be got by selling a cow and two huts."
                            },
                            {
                                "example_id": "fa502ba2-cdb7-49c3-a7d8-f026980d4813",
                                "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                                "text": "In 1977 a large body of fragments of Chou dynasty oracle bone inscriptions was discovered at Chi-shan county in Shensi province."
                            },
                            {
                                "example_id": "7ddaf6b3-2589-4590-aed7-45433c43d004",
                                "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                                "text": "The Mao Kung Ting was unearthed in Chi Shan County, Shensi Province around 1848. Chi Shan, located 75 miles west of Sian, is also located forty-five miles beyond the site of the famous 1974 discovery of the army of 6,000 clay figures which guarded the grave of Emperor Chʻin Shih Huang Ti."
                            },
                            {
                                "example_id": "bd650c5b-5db4-4e8a-85ef-8f2f5af18ae9",
                                "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                                "text": "Throughout Chinese history, Qishan county in Shaanxi province has been known as the ancestral homeland of the Zhou 周 people. In reality, the actual site of the Zhou homeland, known as the Zhouyuan 周原 (Plain of Zhou), includes only the eastern edge of Qishan county, where it meets Fufeng county (fig. 12-1)."
                            },
                            {
                                "example_id": "10cbc8d6-9c86-432b-86a7-05d6ecde7558",
                                "sense_id": "b963fc91-613d-3a19-9039-39bb67c07947",
                                "text": "A quilt factory in Shaanxi's Qishan county was caught using juvenile workers who were forced to work 12 hours a day without pay for nearly six months."
                            }
                        ]
                    }
                ],
