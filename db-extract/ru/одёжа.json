                "senses": [
                    {
                        "sense_id": "f10a4a86-16ff-345c-9aca-db7ed6920a65",
                        "entry_id": "25bb4493-9f1f-356f-9d67-4df9d50053d2",
                        "glosses": [
                            "clothes, clothing, garments"
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "feminine",
                            "inanimate"
                        ],
                        "examples": [
                            {
                                "example_id": "ed072eb6-4b61-41f9-99db-e369cd1e0c89",
                                "sense_id": "f10a4a86-16ff-345c-9aca-db7ed6920a65",
                                "text": "— В на́ши-те го́ды одё́жа куда́ краси́вей да бога́че ны́нешней была́! Одё́жа бога́че, а жи́ли — про́ще, ла́днее. Прошли́ времена́, не воро́тятся! Ну, примеря́й, ряди́сь…",
                                "translation": "‘In my days dresses were far richer and finer than they are today,’ he would say. ‘They spent more on dresses then, but lived more simply, peacefully. Those times will never return! Try this one on.’",
                                "english": "‘In my days dresses were far richer and finer than they are today,’ he would say. ‘They spent more on dresses then, but lived more simply, peacefully. Those times will never return! Try this one on.’"
                            }
                        ]
