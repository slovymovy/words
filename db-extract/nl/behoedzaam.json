                "senses": [
                    {
                        "sense_id": "6e4acc98-bd04-3f2a-a61c-cf2ab2154237",
                        "entry_id": "1cb75578-1f48-363e-8308-01522fe6ed8d",
                        "glosses": [
                            "op zijn of haar hoede om gevaar te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece6a04e-68bc-4540-bce2-82faa9764f76",
                                "sense_id": "6e4acc98-bd04-3f2a-a61c-cf2ab2154237",
                                "text": "Heel behoedzaam ging de jongen over het ijs."
                            },
                            {
                                "example_id": "6801cc50-1df6-448b-84ef-820da467a17d",
                                "sense_id": "6e4acc98-bd04-3f2a-a61c-cf2ab2154237",
                                "text": "Zijn bewegingen waren behoedzaam en beheerst."
                            },
                            {
                                "example_id": "19f1cb45-fdfc-4f15-818c-9300102bd29b",
                                "sense_id": "6e4acc98-bd04-3f2a-a61c-cf2ab2154237",
                                "text": "En diplomatiek, een facet waarin ze niet uitblonk. Tijdens dit gesprek moest ze goed in kunnen schatten wanneer ze haar schoonmoeder van repliek diende te geven, of juist tegenovergesteld moest reageren. In alle gevallen moest het op behoedzame wijze gebeuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8571241b-581d-4cd9-a9f5-65eb6db1c392",
                        "source_entry_id": "1cb75578-1f48-363e-8308-01522fe6ed8d",
                        "source_sense_id": "6e4acc98-bd04-3f2a-a61c-cf2ab2154237",
                        "source_sense_description": "op zijn of haar hoede om gevaar te voorkomen",
                        "target_lang_word": "careful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Taking care; attentive to potential danger, error or harm; cautious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0e0307-fe95-4e6e-9784-2c28720c19cc",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "He was a slow and careful driver."
                                            },
                                            {
                                                "example_id": "5ee3284a-d576-41b6-9b0d-2e2888cb51b7",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "Be very careful while trekking through the jungle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Conscientious and painstaking; meticulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd90f9a-e845-4124-939b-646e2e278746",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "They made a careful search of the crime scene."
                                            },
                                            {
                                                "example_id": "d4eaaa64-c486-4df0-b413-c449c3ba1776",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "At the same time, we were cognisant that careful scholars should never solely rely on their own impressionistic observations, and, that our own impressions were inexact and not capable of being quantified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3f5b5c-0245-3a6b-8a41-221f1512b687",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of care or grief; sorrowful, sad."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of cares or anxiety; worried, troubled."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2baf3193-1792-4787-bbc4-e9cc9ece0e39",
                                                "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                                "text": "Where through long watch, and late daies weary toile, / She soundly slept, and carefull thoughts did quite assoile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
