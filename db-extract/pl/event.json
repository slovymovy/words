                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "event",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "422998ed-9ca0-300c-80b7-e5b869acd2e5",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "An occurrence; something that happens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b4cb60-507d-46e3-8e72-0919f39b42aa",
                                                "sense_id": "422998ed-9ca0-300c-80b7-e5b869acd2e5",
                                                "text": "In the event of strong wind…"
                                            },
                                            {
                                                "example_id": "f71e4759-22ac-4fdd-9ee4-7de5663bba6a",
                                                "sense_id": "422998ed-9ca0-300c-80b7-e5b869acd2e5",
                                                "text": "the events of his early years"
                                            },
                                            {
                                                "example_id": "3c088dd1-4f44-4ddc-9a27-89470e151d15",
                                                "sense_id": "422998ed-9ca0-300c-80b7-e5b869acd2e5",
                                                "text": "Experience in Australia indicates that after a devastating weather event, up to one-fifth of people suffer the debilitating effects of extreme stress, emotional injury, and despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8f3377b-aba8-3bb7-9e98-86bb73c13008",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "A prearranged social activity (function, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd62357d-7602-41c0-a510-93deb5ef388e",
                                                "sense_id": "a8f3377b-aba8-3bb7-9e98-86bb73c13008",
                                                "text": "I went to an event in San Francisco last week."
                                            },
                                            {
                                                "example_id": "a0a7f31d-3bdb-42bd-9f11-c53cc719bda4",
                                                "sense_id": "a8f3377b-aba8-3bb7-9e98-86bb73c13008",
                                                "text": "Where will the event be held?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd6a114d-1e95-32d5-939f-763af4fef45a",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "One of several contests that combine to make up a competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "An end result; an outcome (now chiefly in phrases)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28bacd12-5baf-4271-9f87-1d07adff9f29",
                                                "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                                                "text": "hard beginnings have many times prosperous events […]."
                                            },
                                            {
                                                "example_id": "7cecc81e-2605-4393-a41d-ce20db5cb9cc",
                                                "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                                                "text": "Of my ill boding Dream / Behold the dire Event."
                                            },
                                            {
                                                "example_id": "90adab46-4b8e-4a5e-81da-9cc65979591d",
                                                "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                                                "text": "dark doubts between the promise and event"
                                            },
                                            {
                                                "example_id": "30df2c10-a77a-4dbc-9242-5c710dc567d7",
                                                "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                                                "text": "In the event, he turned out to have what I needed anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7962770e-9ff2-3cd6-af8c-487ac12257b0",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "A remarkable person."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a04de3-8888-4853-8633-b28915d64503",
                                                "sense_id": "7962770e-9ff2-3cd6-af8c-487ac12257b0",
                                                "text": "Miss Burton, you are an event! Sleepy, old Lymston's going to love you! Bye-bye. Bye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca4ae5a-839e-3b76-b57f-552d218b8058",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "A point in spacetime having three spatial coordinates and one temporal coordinate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af15f309-3eaf-374f-bf85-70200c30c9a7",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "A possible action that the user can perform that is monitored by an application or the operating system (event listener). When an event occurs an event handler is called which performs a specific task."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ed7f0ab-7aed-320b-a0c3-53e76bc29126",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "A set of some of the possible outcomes; a subset of the sample space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb12cfe-53aa-4664-9859-adc192cdb26d",
                                                "sense_id": "1ed7f0ab-7aed-320b-a0c3-53e76bc29126",
                                                "text": "If X is a random variable representing the toss of a six-sided die, then its sample space could be denoted as {1,2,3,4,5,6}. Examples of events could be: X=1, X=2, X>5,X̸=4, and X isin 1,3,5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1cd165-3169-3057-a509-3a18175a23eb",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "An affair in hand; business; enterprise."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eecfa46-03ec-4a2c-82ac-edab76400bcb",
                                                "sense_id": "1b1cd165-3169-3057-a509-3a18175a23eb",
                                                "text": "Leave we him to his events."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91c223e-521e-3660-a47e-14cd1eb0f216",
                                        "entry_id": "463f8455-8e20-343d-8ca6-3cb2005cab82",
                                        "glosses": [
                                            "An episode of severe health conditions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "event",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44922c02-8381-3da8-a2cb-23a822fab322",
                                        "entry_id": "13e11ce6-b0f3-37ec-9186-efc16db5232d",
                                        "glosses": [
                                            "To occur, take place."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98942437-c719-4dc9-9806-823a023e56a3",
                                                "sense_id": "44922c02-8381-3da8-a2cb-23a822fab322",
                                                "text": "1590, Robert Greene, Greene’s Never Too Late, in The Life and Complete Works in Prose and Verse of Robert Greene, Volume 8, Huff Library, 1881, p. 33,\n[…] I will first rehearse you an English Historie acted and evented in my Countrey of England […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "event",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79b1aefd-667d-3978-ae0e-2fb11fce821f",
                                        "entry_id": "15c48697-1609-3466-8045-d21679b65e07",
                                        "glosses": [
                                            "To be emitted or breathed out; to evaporate."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2190ac9a-298f-4557-8840-302ce1fda77a",
                                                "sense_id": "79b1aefd-667d-3978-ae0e-2fb11fce821f",
                                                "text": "c. 1597, Ben Jonson, The Case is Altered, Act V, Scene 8, in C. H. Herford and Percy Simpson (editors), Ben Jonson, Volume 3, Oxford: Clarendon Press, 1927, p. 178,\nô that thou sawst my heart, or didst behold\nThe place from whence that scalding sigh evented."
                                            },
                                            {
                                                "example_id": "1e25425c-b408-458e-9656-27ed27b04129",
                                                "sense_id": "79b1aefd-667d-3978-ae0e-2fb11fce821f",
                                                "text": "This is the reason why this water hath no such force when it is carried, as it hath at the spring it self: because the vertue of it consisteth in a spiritual and occulte qualitie, which eventeth and vanisheth by the carriage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c185b5e1-0664-3d36-8094-76229174371f",
                                        "entry_id": "15c48697-1609-3466-8045-d21679b65e07",
                                        "glosses": [
                                            "To expose to the air, ventilate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c63ab7-20e6-4b78-bb0b-669ab6ece550",
                                                "sense_id": "c185b5e1-0664-3d36-8094-76229174371f",
                                                "text": "1559, attributed to William Baldwin, “How the Lorde Clyfford for his straunge and abhominable cruelty came to as straunge and sodayne a death” in The Mirror for Magistrates, Part III, edited by Joseph Haslewood, London: Lackington, Allen & Co., 1815, Volume 2, p. 198,\nFor as I would my gorget have undon\nTo event the heat that had mee nigh undone,\nAn headles arrow strake mee through the throte,\nWhere through my soule forsooke his fylthy cote."
                                            },
                                            {
                                                "example_id": "577c5785-9638-4690-a27f-a16c9c658e85",
                                                "sense_id": "c185b5e1-0664-3d36-8094-76229174371f",
                                                "text": "1598, George Chapman, The Third Sestiad, Hero and Leander (completion of the poem begun by Christopher Marlowe),\n[…] as Phœbus throws\nHis beams abroad, though he in clouds be clos’d,\nStill glancing by them till he find oppos’d\nA loose and rorid vapour that is fit\nT’ event his searching beams, and useth it\nTo form a tender twenty-colour’d eye,\nCast in a circle round about the sky […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
