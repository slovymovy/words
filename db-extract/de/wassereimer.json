                "senses": [
                    {
                        "sense_id": "c7f78453-760c-39e4-a0f3-76f9cb92da07",
                        "entry_id": "b83bf203-2741-3b8a-8734-2a52364c8bee",
                        "glosses": [
                            "Gefäß (Eimer) zur Aufbewahrung und/oder zum Transport von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8366e3-48e9-41db-a6ac-f81c0b6cb54d",
                                "sense_id": "c7f78453-760c-39e4-a0f3-76f9cb92da07",
                                "text": "„Sie trug einen Wassereimer in der rechten Hand, schlenkerte damit, blinzelte ihm zu, blieb aber diesmal stehen.“"
                            },
                            {
                                "example_id": "b2221e19-fc72-4bbb-946c-8e6f22109aaf",
                                "sense_id": "c7f78453-760c-39e4-a0f3-76f9cb92da07",
                                "text": "„Keine Feuerwehren rückten aus, keiner schleppte Wassereimer, um zu löschen.“"
                            },
                            {
                                "example_id": "e9fb01bb-9026-48ec-94f0-e446a867d55f",
                                "sense_id": "c7f78453-760c-39e4-a0f3-76f9cb92da07",
                                "text": "„Marion nahm den langstieligen Flaschenkürbis, der im Wassereimer lag, und reichte ihn dem alten Mann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
