                "senses": [
                    {
                        "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                        "entry_id": "c5f2b7e8-13db-31b9-891a-23bf29888169",
                        "glosses": [
                            "freie Dachentwässerung eines Jahrhundertregenereignisses über Notablauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2bde51-0621-4eb9-aa15-d03f67b23262",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "Bei Starkregenereignissen kann es zu Überflutungen auf Dachflächen kommen. Deshalb muß grundsätzlich jedem Entwässerungstiefpunkt auf dem Flachdach, in der Nähe des Dachablaufes, eine Notentwässerung zugeordnet werden."
                            },
                            {
                                "example_id": "0ca57b72-7399-4d97-a2a1-195ea9391be0",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "Bei vorgehängten Dachrinnen erfolgt die Notentwässerung planmäßig über die Rinnenvorderkante."
                            },
                            {
                                "example_id": "fc0fbdec-0e26-43f4-877b-3e1a551e9db8",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "„Für Flachdächer ist eine Notentwässerung in Form eines Notüberlaufs vorgeschrieben.“"
                            },
                            {
                                "example_id": "c06e7e4a-6538-4cd1-9cbe-ab814e5612fd",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "„Für Notentwässerungen können Notüberläufe (zum Beispiel rechteckige bzw. runde Öffnungen in der Attika) oder Notabläufe (Attikaabläufe bzw. Notabläufe mit Rohrsystemen) eingesetzt werden.“"
                            },
                            {
                                "example_id": "4d2719cd-fd25-44f9-9325-e9429cb07577",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "„Jede Dachfläche bzw. jeder durch die Dachkonstruktion vorgegebene Tiefpunkt muss über eine Notentwässerung verfügen.“"
                            },
                            {
                                "example_id": "46f35575-1e9b-4706-b223-8ee48279ed01",
                                "sense_id": "db6f27b4-d868-3cb0-95a6-644c600abc07",
                                "text": "„Nach DIN 1986-1001) muss heute aber jede Dachfläche über eine Notentwässerung verfügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
