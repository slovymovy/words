                        "sense_id": "c5b9ffee-a107-3ccb-ad28-17d23e9d52f2",
                        "entry_id": "557f75a5-389d-31b3-b9c5-fd4c15d5075b",
                        "glosses": [
                            "Société d’étudiants liée au départ à une aspiration à l’unité du peuple allemand et aux guerres de libération contre Napoléon, puis virant à la fin du XIXe siècle vers un antilibéralisme teinté d'antisémitisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c564a8e-016c-4f50-84a2-ba5fb6da0785",
                                "sense_id": "c5b9ffee-a107-3ccb-ad28-17d23e9d52f2",
                                "text": "Friedrich Nietzsche war Mitglied in der Burschenschaft »Franconia«.",
                                "translation": "F Nietzsche était membre de la Burschenschaft \"Franconia\"."
                            }
                        ]
                    }
