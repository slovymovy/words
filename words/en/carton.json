    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bdf8f73-848d-38a8-90a9-e2e1a5b83f21",
                    "sense_definition": "A light box or container made of cardboard or waxed paper, typically used for holding food or drinks.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a <w>carton</w> of milk and a loaf of bread from the corner store.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>пакет</w> молока и буханку хлеба в магазине на углу."
                            }
                        },
                        {
                            "text": "Please put the empty <w>carton</w> into the recycling bin when you are finished.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выбрось пустую <w>коробку</w> в контейнер для переработки, когда освободишься."
                            }
                        }
                    ],
                    "synonyms": [
                        "cardboard box",
                        "container",
                        "package"
                    ],
                    "common_phrases": [
                        "carton of milk",
                        "egg carton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Картонная коробка или пачка, обычно предназначенная для пищевых продуктов или напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "картонный, для молока или сока"
                            },
                            {
                                "target_lang_word": "коробка",
                                "target_lang_sense_clarification": "картонная емкость"
                            },
                            {
                                "target_lang_word": "пачка",
                                "target_lang_sense_clarification": "небольшая картонная упаковка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8047a87-9b74-3aaf-b40a-b4973dc5bffa",
                    "sense_definition": "A standard package containing multiple smaller packs of cigarettes, usually ten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "package",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He purchased a full <w>carton</w> of cigarettes at the duty-free shop before boarding.",
                            "target_lang_translations": {
                                "ru": "Перед посадкой он купил целый <w>блок</w> сигарет в магазине беспошлинной торговли."
                            }
                        },
                        {
                            "text": "The store owner kept each <w>carton</w> behind the counter to prevent theft.",
                            "target_lang_translations": {
                                "ru": "Владелец магазина держал каждый <w>блок</w> за прилавком во избежание краж."
                            }
                        }
                    ],
                    "synonyms": [
                        "package"
                    ],
                    "common_phrases": [
                        "carton of cigarettes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная упаковка, вмещающая несколько пачек сигарет, обычно десять штук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "упаковка из десяти пачек сигарет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1c4f84f-ef15-3894-9fc4-9e4e907abf09",
                    "sense_definition": "A cardboard box or case designed to hold multiple bottles or cans of beer, typically 24.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They carried a heavy <w>carton</w> of beer into the backyard for the party.",
                            "target_lang_translations": {
                                "ru": "Они отнесли тяжелый <w>ящик</w> пива на задний двор для вечеринки."
                            }
                        },
                        {
                            "text": "We ordered a <w>carton</w> of cans from the beverage warehouse.",
                            "target_lang_translations": {
                                "ru": "Мы заказали <w>упаковку</w> банок со склада напитков."
                            }
                        }
                    ],
                    "synonyms": [
                        "case"
                    ],
                    "common_phrases": [
                        "carton of beer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Картонная коробка или упаковка для транспортировки нескольких бутылок или банок пива (обычно 24 штук)."
