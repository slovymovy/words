{
    "word_family": [
        "duik",
        "duiker",
        "duikboot",
        "duikplank"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a655963e-ad36-326d-ad20-de441a19c218",
                    "sense_definition": "Onder de waterspiegel verdwijnen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "duiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pinguïns <w>doken</w> regelmatig <w>onder</w> om vis te vangen.",
                            "target_lang_translations": {
                                "en": "The penguins regularly <w>dived</w> under to catch fish."
                            }
                        },
                        {
                            "text": "De zwemmer <w>dook</w> snel <w>onder</w> om de bal te pakken.",
                            "target_lang_translations": {
                                "en": "The swimmer quickly <w>dived</w> under to grab the ball."
                            }
                        }
                    ],
                    "synonyms": [
                        "duiken"
                    ],
                    "common_phrases": [
                        "onder duiken"
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear below the water surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dive",
                                "target_lang_sense_clarification": "To swim or go under water."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7593b0af-52d9-3859-a5ff-5915a85ed271",
                    "sense_definition": "Zich verbergen voor de heersende machthebbers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de invoering van de Arbeitseinsatz <w>doken</w> veel mannen <w>onder</w> in Nederland.",
                            "target_lang_translations": {
                                "en": "After the introduction of the Arbeitseinsatz, many men <w>went into hiding</w> in the Netherlands."
                            }
                        },
                        {
                            "text": "Tijdens de oorlog moesten veel mensen <w>onderduiken</w> om te overleven.",
                            "target_lang_translations": {
                                "en": "During the war, many people had to <w>go into hiding</w> to survive."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich schuilhouden",
                        "zich verbergen",
                        "zich verschuilen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hide oneself from the ruling authorities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go into hiding",
                                "target_lang_sense_clarification": "To conceal oneself to avoid capture or persecution."
                            },
                            {
                                "target_lang_word": "go underground",
                                "target_lang_sense_clarification": "To go into hiding, often for political or illegal reasons."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "054bf288-1092-3bfe-bb58-b55d071428d7",
                    "sense_definition": "Het onder water duiken.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "duiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>onderduiken</w> van de dolfijn was prachtig om te zien.",
                            "target_lang_translations": {
                                "en": "The <w>diving</w> of the dolphin was beautiful to see."
                            }
                        },
                        {
                            "text": "Na het <w>onderduiken</w> kwam hij weer boven water.",
                            "target_lang_translations": {
                                "en": "After <w>diving</w> under, he came back above water."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of diving under water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "diving",
                                "target_lang_sense_clarification": "The act of submerging oneself under water."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed0d9275-d083-3308-a9ec-fd35d7deb877",
                    "sense_definition": "Het zich schuilhouden om zekere maatregelen te ontgaan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>onderduiken</w> was voor velen de enige manier om veilig te blijven.",
                            "target_lang_translations": {
                                "en": "<w>Going into hiding</w> was the only way for many to stay safe."
                            }
                        },
                        {
                            "text": "Door het <w>onderduiken</w> konden ze de controle ontlopen.",
                            "target_lang_translations": {
                                "en": "By <w>going into hiding</w>, they were able to avoid inspection."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich schuilhouden",
                        "zich verbergen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of hiding oneself to avoid certain measures or authorities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "going into hiding",
                                "target_lang_sense_clarification": "The state or act of being in concealment."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}