                        ]
                    },
                    {
                        "translation_id": "47a6af91-d806-4983-80b2-b36ad54e64e2",
                        "source_entry_id": "909bc1a1-22c9-3107-836e-abd18424799b",
                        "source_sense_id": "62283aa4-7463-3838-9a68-b61ee88b1bcc",
                        "target_lang_word": "assyriologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assyriologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
                                        "entry_id": "9588327d-4046-39a2-aa95-001310548b94",
                                        "glosses": [
                                            "Personne qui étudie les civilisations de la Mésopotamie et ses langues : le sumérien et l’akkadien (assyro-babylonien)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5f5cad-49c0-4408-b16d-3d05e8a37619",
                                                "sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
                                                "text": "Ce n’est pas à l’assyriologue de dire comment résoudre les conflits d’aujourd’hui, mais il peut rappeler qu’en dépit des fondamentalistes de tous genres, il n’y a pas de civilisation « pure »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5cfd4b9-8817-434d-a761-20acf2d80340",
                        "source_entry_id": "909bc1a1-22c9-3107-836e-abd18424799b",
                        "source_sense_id": "62283aa4-7463-3838-9a68-b61ee88b1bcc",
                        "target_lang_word": "Assyriologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Assyriologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                        "entry_id": "faab63f5-8d9e-312d-ac11-05a53b59e42f",
                                        "glosses": [
                                            "Mann, der die Wissenschaft der Assyriologie ausübt. auch eine Mehrzahl beiderlei Geschlechts"
                                        ],
                                        "tags": [
                                            "Nur im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a860a9f-aca3-43ac-be42-51e073918151",
                                                "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                                "text": "„Der Assyriologe Joachim Marzahn, 54, betreut am Vorderasiatischen Museum Berlin das aus 25 000 Tafeln bestehende größte deutsche Keilschriftarchiv.“"
                                            },
                                            {
                                                "example_id": "9b5e579e-94ae-41dc-9833-678be3c6cf7d",
                                                "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                                "text": "Der Grabungsphilologe, der hier auf der Ausgrabungsstätte die frisch aus der Erde geholten Keilschrifttafeln entzifferte, war ein Assyriologe aus Leipzig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2ef9018-f1b1-4a30-a1c8-fc4290fb123b",
                        "source_entry_id": "909bc1a1-22c9-3107-836e-abd18424799b",
                        "source_sense_id": "62283aa4-7463-3838-9a68-b61ee88b1bcc",
                        "target_lang_word": "ассириолог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ассириолог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e32d2e3f-1731-3d80-97cc-a382ae1af488",
                                        "entry_id": "36140568-b94d-3782-8abf-94a864934137",
                                        "glosses": [
                                            "специалист в области ассириологии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58aa08be-098a-4a94-bc29-966ef35c5292",
                                                "sense_id": "e32d2e3f-1731-3d80-97cc-a382ae1af488",
                                                "text": "Но особенно замечательна была его коллекция клинописных документов. По числу единиц хранения она, конечно, не шла ни в какое сравнение со знаменитыми собраниями Британского музея, Лувра, Берлинского музея, Стамбульского музея; но ни в одном собрании мира не были так полно представлены все периоды развития клинописи, от самого первого в мире предклинописного иероглифического документа четвертого тысячелетия до н. э. до эллинистических текстов последних веков до нашей эры; и все жанры клинописных текстов ―хозяйственные, юридические, культовые, литературные, словарные, математические, геодезические. Не было и нет на свете коллекции, лучше приспособленной для воспитания ассириологов-универсалистов"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
