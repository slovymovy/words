                    {
                        "translation_id": "0fe8b471-7e19-4b0b-97f9-05025c07b247",
                        "source_entry_id": "f84313fe-23ed-3e60-bd3f-8ac9c7a6ff64",
                        "source_sense_description": "song",
                        "target_lang_word": "Jodler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jodler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aff151ca-39d7-3ec0-830f-5a56af817e67",
                                        "entry_id": "88780bd6-8ee9-37f8-99e1-5cff2c9330b1",
                                        "glosses": [
                                            "ein Musikstück, das gejodelt wird, also in einer speziellen Singweise dargeboten wird. Die Stimme schlägt dabei häufig von der Bruststimme in eine Fistel- oder Falsettstimme um."
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67cebc31-95f7-480c-b306-9a65c4216f80",
                                                "sense_id": "aff151ca-39d7-3ec0-830f-5a56af817e67",
                                                "text": "„Ursprüngliche Jodler wurden oft solistisch praktiziert, die meisten Jodel-Lieder sind mehrstimmig und scheinen häufig als Kehr- und Schluss-Refrain von Volksliedern auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3063208f-7eff-3ba7-b61a-5dcb7dc1714a",
                                        "entry_id": "88780bd6-8ee9-37f8-99e1-5cff2c9330b1",
                                        "glosses": [
                                            "eine Person, die jodelt, eben in einer ganz bestimmten Weise singt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db856f35-10a9-4108-a741-5dfd38d37c8c",
                                                "sense_id": "3063208f-7eff-3ba7-b61a-5dcb7dc1714a",
                                                "text": "Der ursprüngliche, feinsinnige Jodler aus Karl Ganzers Kufsteinlied wurde durch den heute weltbekannten Bierzelt-Jodler ersetzt."
                                            },
                                            {
                                                "example_id": "42f03a86-56c8-4b92-9587-6dbc035e300a",
                                                "sense_id": "3063208f-7eff-3ba7-b61a-5dcb7dc1714a",
                                                "text": "„Der Jodler \"begnügt sich mit gebrochenen Tonika- und Dominant-Nonen-Akkorden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
