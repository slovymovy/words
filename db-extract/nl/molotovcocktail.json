                "senses": [
                    {
                        "sense_id": "fc4274bc-d91d-3b32-8266-c066a475dfe8",
                        "entry_id": "b25c8f17-ed5d-31d6-8dc3-f61a3257a6ca",
                        "glosses": [
                            "met brandbare stof gevulde glazen fles die via een lont of lap stof wordt ontstoken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34168305-6b92-43b0-932a-03446726fcbf",
                                "sense_id": "fc4274bc-d91d-3b32-8266-c066a475dfe8",
                                "text": "In Hongkong had hij schijnbaar zonder angst aan de frontlinies van de protesten gestaan, en met molotovcocktails de traangasaanvallen van de politie gepareerd."
                            },
                            {
                                "example_id": "f9a1f47a-8394-483d-b5f3-67075df578b3",
                                "sense_id": "fc4274bc-d91d-3b32-8266-c066a475dfe8",
                                "text": "Een school in Apeldoorn is gisteren ontruimd omdat een brandende molotovcocktail naar binnen was gegooid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d38aa2b1-eca4-484b-b428-9858c7f3a438",
                        "source_entry_id": "b25c8f17-ed5d-31d6-8dc3-f61a3257a6ca",
                        "source_sense_id": "fc4274bc-d91d-3b32-8266-c066a475dfe8",
                        "source_sense_description": "met brandbare stof gevulde glazen fles die via een lont of lap stof wordt ontstoken",
                        "target_lang_word": "Molotowcocktail",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molotowcocktail",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                        "entry_id": "1ed675a8-dba7-38d8-9e81-a923b41205fd",
                                        "glosses": [
                                            "einfach konstruierter Wurfbrandsatz, meist in Form einer mit Benzin gefüllten Glasflasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70be390a-cb4f-4dc6-835e-59619029d59f",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "Bei den Unruhen in Kairo kamen auch Molotowcocktails zum Einsatz."
                                            },
                                            {
                                                "example_id": "e4b49578-9fee-4e62-8db1-c03053337307",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "Nachdem die Lage eskaliert ist, flogen Steine und sogar Molotowcocktails."
                                            },
                                            {
                                                "example_id": "01fa1418-1b54-4e3e-bcad-a5c1887750d2",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "„Es ist völlig daneben, in Deutschland oder Frankreich Molotowcocktails auf Polizisten zu werfen."
                                            },
                                            {
                                                "example_id": "3cae326c-5450-490e-a25b-e28fa5ae3c95",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "[Belfast:] „Jugendliche warfen im Westen der Stadt Steine, Feuerwerkskörper und Molotowcocktails auf Polizisten.“"
                                            },
                                            {
                                                "example_id": "3e6fedaa-f2b1-485a-9afe-7d402b73c1b9",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "In Athen ging die Polizei mit Tränengas und Wasserwerfern gegen Demonstranten vor, nachdem aus deren Reihen Molotowcocktails auf die Einsatzkräfte geworfen worden waren.“"
                                            },
                                            {
                                                "example_id": "73a5adcb-42b5-4791-9b2c-e5484ecf8b0b",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "„Manchmal stehen Demonstranten mit Molotowcocktails vor dem Heim.“"
                                            },
                                            {
                                                "example_id": "2f2907b2-a4d8-45f0-a2d9-589c5596920b",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "„Unter meinem provisorischen Friseursessel liegen Molotowcocktails.“"
                                            },
                                            {
                                                "example_id": "a77b5ab5-c21b-44ac-9ff0-99f2932963d2",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "„Nach einem Angriff mit Molotowcocktails und einer Messerattacke töteten israelische Sicherheitskräfte im Westjordanland und in Ostjerusalem zwei junge Palästinenser.“"
                                            },
                                            {
                                                "example_id": "93d70c46-05d2-4203-95e0-33cac2fee5b5",
                                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                                "text": "[Skinheads hatten] „unter Applaus in Rostock-Lichtenhagen ein Asylbewerberheim mit Molotowcocktails in Brand gesteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
