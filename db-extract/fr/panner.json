                "senses": [
                    {
                        "sense_id": "6db993d3-d142-3926-9adb-9329e90fe55c",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Tomber en panne."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "21cf2291-98be-40df-a0e0-bfff54d14fdf",
                                "sense_id": "6db993d3-d142-3926-9adb-9329e90fe55c",
                                "text": "Mais, à partir de Hirsova, le moteur s'est mis à chauffer très fort et menaçait de panner, d’où ralentissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a28e965-fd3b-3b26-8a13-235a30766b47",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Creuser avec la partie du marteau appelée panne.  ^([1])"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3294fabc-7188-3238-b11f-7ba7975d7420",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Essuyer avec un linge ou un morceau de drap.  ^([2])"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "76005893-cd84-389e-8214-c0f0cf672ff8",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Saisir un meuble pour sûreté de paiement.  ^([3])  ^([4])"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a020e168-2039-4135-a425-5e25587845ee",
                                "sense_id": "76005893-cd84-389e-8214-c0f0cf672ff8",
                                "text": "En cas de refus de paiement, le bouteiller du comte peut panner le délinquant en sa maison, pour la valeur de l’amende encourue, sans porter atteinte aux franchises de la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "58c5f72e-9980-3959-a202-e079ac899a94",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Gagner au jeu.  ^([5])"
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a8c10742-070a-3abc-b2a5-9cbf99bfa3cf",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Aplatir la viande en frappant dessus ^([6])."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ebd80d5c-0916-3596-9882-7c4f94fbbeb4",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Couvrir la face crue d’un jambon de panne, mélange de graisse de porc et farine de riz, pour ne pas qu’il croute durant l’affinage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b7b038ba-293b-30c3-b8f0-b9c3e2d239d8",
                        "entry_id": "b1d2b798-0cfd-35ee-a6f0-bbb5e09a34c3",
                        "glosses": [
                            "Comprendre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
