                    {
                        "sense_id": "eadb3a57-f7e6-3e50-bf08-35c9850a671f",
                        "entry_id": "01b59d2b-e8f1-309a-8de9-29844c84b026",
                        "glosses": [
                            "Espèce de champignons microscopiques, de la famille des Trichocomaceae, classe des ascomycètes, appartenant aux moisissures « nobles », de nom scientifique Aspergillus oryzae, proche de Penicillium, et donc des moisissures des fromages à pâte persillée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1661ad-8e34-4ccd-a8bd-28b988b32028",
                                "sense_id": "eadb3a57-f7e6-3e50-bf08-35c9850a671f",
                                "text": "Titrant généralement de 14 à 18 % du volume, cet alcool élaboré à partir d’un brassage d’eau et de riz avec des levures et des moisissures — le koji-kin qui transforme l’amidon du riz en sucre —, le saké se distingue par sa finesse, sa diversité et sa capacité à accompagner les meilleurs repas."
                            },
                            {
                                "example_id": "a87ec2b5-ccee-444d-a541-5323ccedc94b",
                                "sense_id": "eadb3a57-f7e6-3e50-bf08-35c9850a671f",
                                "text": "Le komé-koji est le riz cuit à la vapeur traité par le champignon koji-kin (aspergillus flavus orisae)."
                            },
                            {
                                "example_id": "cfbd33f5-9cb9-4c73-8aa6-bb301f1074fd",
                                "sense_id": "eadb3a57-f7e6-3e50-bf08-35c9850a671f",
                                "text": "Le Koji-kin (aspergillus orizae de son vrai nom) est un champignon unicellulaire."
                            }
                        ]
                    }
