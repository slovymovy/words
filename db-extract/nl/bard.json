                        "entry_id": "d5d6440f-acb0-386c-a61c-7582701643cb",
                        "glosses": [
                            "een zanger en dichter bij de oude Kelten en Galliërs"
                        ],
                        "tags": [
                            "Middle-Ages",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7b5ae843-f6c3-41f7-8dfb-b3451763641d",
                                "sense_id": "7c448a1d-cb26-3fae-90ec-0df9381556f1",
                                "text": "In die tijd waren er veel barden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea0bc765-21cd-3618-9f26-412f22985121",
                        "entry_id": "d5d6440f-acb0-386c-a61c-7582701643cb",
                        "glosses": [
                            "een dichter"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3e1c6ddb-db38-4562-a736-8987949f77c8",
                                "sense_id": "ea0bc765-21cd-3618-9f26-412f22985121",
                                "text": "Ik houd helemaal niet van die bard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2defe4e-7781-4227-90ec-fd415f26e7c4",
                        "source_entry_id": "d5d6440f-acb0-386c-a61c-7582701643cb",
                        "source_sense_id": "7c448a1d-cb26-3fae-90ec-0df9381556f1",
                        "source_sense_description": "middeleeuws dichter en zanger bij de Kelten",
                        "target_lang_word": "Barde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                        "entry_id": "91134dc7-38ce-3795-9a6e-f3589a51ab5d",
                                        "glosses": [
                                            "keltischer Sänger und Dichter"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50af562-0aea-4b6d-8e4a-5f1ace8e90d5",
                                                "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                                "text": "„Die Barden erscheinen hauptsächlich als Dichter, Sänger, Musiker (auf der ‚Krotta‘ oder Leier) und Lobpreiser, ihre genaue Beziehung zu Druiden und Vaten bleibt im Dunkeln.“"
                                            },
                                            {
                                                "example_id": "40c033f2-95d7-4fba-a5ca-59ff0ba42296",
                                                "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                                "text": "„Für Unterhaltung bei den Gastmählern sorgten vor allem die Barden (…): Dichter und Sänger, die ihre Heldengesänge meist in Begleitung einer Harfe vortrugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                        "entry_id": "91134dc7-38ce-3795-9a6e-f3589a51ab5d",
                                        "glosses": [
                                            "jemand, der Lieder verfasst und selbst vorträgt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58771843-c60f-42f1-8c3e-b44fab5ae9d0",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Der niederbayerische Barde Fredl Fesl schaffte es mit seiner unnachahmlichen Art, dass seine Fans Tränen lachten.“"
                                            },
                                            {
                                                "example_id": "df4b27a5-0904-42e2-afae-acb7dab8c4af",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Die Lächerlichkeit der Situation entgeht Hoffmann nicht; keinerlei Lächerlichkeit ist ihm jemals entgangen, und im gleichen Sinn wie Sterne ist er ein wahrhafter Barde des Grotesken.“"
                                            },
                                            {
                                                "example_id": "f44e2941-f620-4e39-957c-19550de8e28c",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Was jedoch überrascht, ist, dass der Barde viele seiner Wörter wieder streicht und eine sehr sparsame Zeichensetzung wählt: Es gibt einige wenige Kommas und ein paar Punkte, aber keine Frage- und Ausrufezeichen, auch nicht an Stellen, an denen wir sie ohne jeden Skrupel einsetzen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Barde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a9c566-26c7-3cbc-a238-10c786c3dd67",
                                        "entry_id": "6051c60f-1b16-3a39-a6ef-83d3054071ae",
                                        "glosses": [
                                            "Scheibe von (fettem) Speck, mit der mageres Fleisch beim Braten umwickelt oder belegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4dc249-2f0f-409a-8877-2fe2d30868e0",
                                                "sense_id": "29a9c566-26c7-3cbc-a238-10c786c3dd67",
                                                "text": "Barden um die Wachtelbrüstchen verhindern das Austrocknen des Fleisches."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6b69d23-9dd2-4172-923e-e89b67d5ef50",
                        "source_entry_id": "d5d6440f-acb0-386c-a61c-7582701643cb",
                        "source_sense_id": "7c448a1d-cb26-3fae-90ec-0df9381556f1",
                        "source_sense_description": "middeleeuws dichter en zanger bij de Kelten",
                        "target_lang_word": "bard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e752ab23-c1f5-38af-81d7-42510a60e667",
                                        "entry_id": "3e12b3a3-2c52-356f-9111-828296ee9a53",
                                        "glosses": [
                                            "A professional poet and singer, like among the ancient Celts, whose occupation was to compose and sing verses in honor of the heroic achievements of princes and brave men."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b6aac7-18ff-40de-9fa1-64a3b926bb13",
                                                "sense_id": "e752ab23-c1f5-38af-81d7-42510a60e667",
                                                "text": "He is a Welsh bard, and a man full of animation, anecdote, and independence; […]"
                                            },
                                            {
                                                "example_id": "b93bc1f0-76d2-414c-aa0a-23ed572144f7",
                                                "sense_id": "e752ab23-c1f5-38af-81d7-42510a60e667",
                                                "text": "A WEAPON, THE WARRIOR CARRIES. A SAW, THE IDIOT CARRIES. AN INSTRUMENT, THE BARD CARRIES."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596293b5-e099-3750-ab3a-ee4157124290",
                                        "entry_id": "3e12b3a3-2c52-356f-9111-828296ee9a53",
                                        "glosses": [
                                            "A poet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f77591-97cc-4eb0-a481-69cc8e413542",
                                                "sense_id": "596293b5-e099-3750-ab3a-ee4157124290",
                                                "text": "Shakespeare is known as the bard of Avon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8460ae9a-ee67-3e7d-80b4-71a830dcdb92",
                                        "entry_id": "3e12b3a3-2c52-356f-9111-828296ee9a53",
                                        "glosses": [
                                            "A class of character that typically focuses on charisma, magic and supporting other players; a fantasy fiction character inspired by this archetype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79fbb1f8-c06a-491c-b49c-168ba217ba79",
                                                "sense_id": "8460ae9a-ee67-3e7d-80b4-71a830dcdb92",
                                                "text": "I saw a bard work a bit of magic once. He brought up a volunteer from the audience, insulted him in rather colorful fashion, and then made the man forget the insults—and then he did the same trick all over again, twice more.”"
                                            },
                                            {
                                                "example_id": "ad8ba5b1-ce56-4f46-bf80-8104d71e94f5",
                                                "sense_id": "8460ae9a-ee67-3e7d-80b4-71a830dcdb92",
                                                "text": "\"Having a bard would be even less helpful than having a second wizard, \" John interjects."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04306e04-1bdf-37ba-b3d4-06763727ebfd",
