    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                    "sense_definition": "Côté ou ligne vers lequel une personne ou une chose se déplace, est orientée ou regarde.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous marchons dans la bonne <w>direction</w> pour aller au musée."
                        },
                        {
                            "text": "Le train roule en <w>direction</w> de Paris depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "sens"
                    ],
                    "common_phrases": [
                        "changer de direction",
                        "en direction de",
                        "dans la mauvaise direction",
                        "indiquer la direction"
                    ]
                },
                {
                    "sense_id": "5483bae8-4be5-3927-be03-5c5e370185e3",
                    "sense_definition": "Ensemble des personnes responsables qui commandent ou gèrent une entreprise, une école ou une institution.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>direction</w> a accepté d'accorder une prime à tous les employés."
                        },
                        {
                            "text": "Il faut envoyer une lettre officielle à la <w>direction</w> du collège."
                        }
                    ],
                    "common_phrases": [
                        "direction générale"
                    ]
                },
                {
                    "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                    "sense_definition": "Action de diriger, de superviser ou d'administrer une activité, un projet ou un groupe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet avance très vite sous la <w>direction</w> de notre nouveau chef."
                        },
                        {
                            "text": "Elle a pris la <w>direction</w> des opérations dès le premier jour."
                        }
                    ],
                    "common_phrases": [
                        "prendre la direction",
                        "sous la direction",
                        "assurer la direction"
                    ]
                },
                {
                    "sense_id": "a926f444-a0a5-32b4-810d-527f11832d84",
                    "sense_definition": "Orientation générale ou sens donné à une démarche, une politique, une carrière ou une réflexion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite donner une nouvelle <w>direction</w> à sa politique économique."
                        },
                        {
                            "text": "Ses recherches scientifiques ont pris une <w>direction</w> inattendue après cette découverte."
                        }
                    ],
                    "common_phrases": [
                        "donner une direction",
                        "nouvelle direction"
                    ]
                },
                {
                    "sense_id": "7d40a88e-10f0-327f-b208-ccf865852bf4",
                    "sense_definition": "Système mécanique permettant au conducteur de guider les roues d'un véhicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garagiste a vérifié la <w>direction</w> de la voiture après l'accident."
                        },
                        {
                            "text": "Cette voiture moderne possède une <w>direction</w> assistée très agréable en ville."
                        }
                    ],
                    "common_phrases": [
                        "direction assistée",
                        "colonne de direction",
                        "système de direction"
                    ]
                },
                {
                    "sense_id": "076bef23-4bd7-3ec6-9e5e-57becc98ad23",
                    "sense_definition": "En géométrie et en physique, position d'une droite dans l'espace indépendamment du sens de parcours.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux vecteurs parallèles partagent nécessairement la même <w>direction</w>."
                        },
                        {
                            "text": "Un vecteur est défini par sa norme, son sens et sa <w>direction</w>."
                        }
                    ],
                    "common_phrases": [
                        "même direction"
                    ]
                }
            ]
        }
    ]
