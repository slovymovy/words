                        "glosses": [
                            "bedeutsame Industrieanlage, die von früheren Zeiten Zeugnis ablegt und besonders geschützt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfda0f1-13ce-4a92-9a9a-3bcc971aedd7",
                                "sense_id": "b2e47702-e964-32c1-9e7d-f626d69fcf7f",
                                "text": "„20 Autominuten entfernt von dem Fabrikhotel findet sich ein weiteres Industriedenkmal: die alte Lohnhalle der Zeche Bonifacius in Essen-Kray, Baujahr 1903. Sie ist ein Symbol für den Strukturwandel, den die Region seit dem Ende der Kohle-Ära erlebt.“"
                            }
                        ],
