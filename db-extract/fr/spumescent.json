                "senses": [
                    {
                        "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                        "entry_id": "f7d4692e-6c99-3e49-be23-6eba2919cadc",
                        "glosses": [
                            "Qui produit de l'écume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0a7986-4016-4318-a15a-91f0c806b516",
                                "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                                "text": "La couleur rouge éclatante du sang artériel, violette & presque noire du veineux, la température plus élevée, la pesanteur moins grande, l'état spumescent du premier, opposé à ces propriétés considérées dans Je second , ont appris que ce liquide prenoit de nouveaux caractères dans les poumons […]."
                            },
                            {
                                "example_id": "00f9244d-0bf3-44df-919c-9b45223a21c9",
                                "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                                "text": "Alors, parmi le fracas des vagues spumescentes, Charcot descend calmement dans sa cabine pour libérer l'oiseau."
                            },
                            {
                                "example_id": "e62c3d4f-62cf-4c2c-8a05-17121a2c4a07",
                                "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                                "text": "Les trois nains laissent un filet spumescent couler entre leurs dents noires."
                            },
                            {
                                "example_id": "41c20fa4-8168-4481-85ae-ac421fff79db",
                                "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                                "text": "Le cadre était vraiment parfait pour un petit meurtre rapide et spumescent."
                            },
                            {
                                "example_id": "f8f03ad4-af12-4fd2-8b81-56971244c2ba",
                                "sense_id": "b25f555c-d3f2-3e27-a55d-128182a3fd6a",
                                "text": "L'heure de la fermeture approchait, il pleuvait dehors, il faisait nuit, il faisait frisquet, l'atmosphère était spumescente (spumescente !) et je n'avais pas envie de rentrer chez moi, surtout pas."
                            }
                        ]
                    }
