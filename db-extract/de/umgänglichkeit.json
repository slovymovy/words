                "translations": [
                    {
                        "translation_id": "3df3bf3d-ece5-4fbc-9b5e-4534731f4218",
                        "source_entry_id": "458885a4-fc30-3faa-9474-646e47782c35",
                        "source_sense_id": "5a2a3d43-bf0b-3c15-a54e-74d88c0aa272",
