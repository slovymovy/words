{
    "word_family": [
        "betrayal",
        "betrayer",
        "betrayingly",
        "betrayable",
        "unbetrayed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af2be456-b989-30cc-a595-a4e29bd3b9c3",
                    "sense_definition": "To be disloyal to someone or something that trusts you; to act treacherously or deceive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "loyalty and trust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt hurt when he <w>betrayed</w> me and told my friends my private story.",
                            "target_lang_translations": {
                                "ru": "Мне было больно, когда он <w>предал</w> меня и рассказал друзьям мою личную историю."
                            }
                        },
                        {
                            "text": "She promised to help our team, but she <w>betrayed</w> the group at the last minute.",
                            "target_lang_translations": {
                                "ru": "Она обещала помочь нашей команде, но в последнюю минуту <w>подвела</w> группу."
                            }
                        }
                    ],
                    "synonyms": [
                        "sell"
                    ],
                    "antonyms": [
                        "stay loyal",
                        "stand by",
                        "support"
                    ],
                    "common_phrases": [
                        "betray someone",
                        "betray a friend",
                        "betray a cause",
                        "betray trust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть неверным кому-либо или чему-либо, кто вам доверяет; поступать вероломно или обманывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "нарушать верность"
                            },
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "быть неверным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57151cad-c172-3b99-9972-99f0e5e88058",
                    "sense_definition": "To break someone’s confidence by revealing a secret or private information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secret disclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please don’t <w>betray</w> my secret; I told you in confidence.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>выдавай</w> мой секрет; я рассказал тебе по секрету."
                            }
                        },
                        {
                            "text": "He was angry because she <w>betrayed</w> his confidence and shared the news at work.",
                            "target_lang_translations": {
                                "ru": "Он был зол, потому что она <w>обманула</w> его доверие и поделилась новостью на работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "give away"
                    ],
                    "antonyms": [
                        "keep",
                        "conceal"
                    ],
                    "common_phrases": [
                        "betray a secret",
                        "betray confidence",
                        "betray a promise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злоупотребить чьим-либо доверием, раскрыв секрет или частную информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "раскрывать секрет"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "разглашать тайну"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b840e531-f656-3223-bd41-06c34add7f2c",
                    "sense_definition": "To reveal or show something unintentionally, especially something you would prefer to hide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unintentional revealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to sound calm, but his voice <w>betrayed</w> his fear.",
                            "target_lang_translations": {
                                "ru": "Он старался говорить спокойно, но голос <w>выдавал</w> его страх."
                            }
                        },
                        {
                            "text": "Even when she smiled, her eyes <w>betrayed</w> her true feelings.",
                            "target_lang_translations": {
                                "ru": "Даже когда она улыбалась, глаза <w>выдавали</w> её истинные чувства."
                            }
                        }
                    ],
                    "synonyms": [
                        "give away"
                    ],
                    "antonyms": [
                        "hide",
                        "conceal"
                    ],
                    "common_phrases": [
                        "betray feelings",
                        "betray fear",
                        "betray emotion",
                        "betray identity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непреднамеренно обнаружить или показать что-либо, что вы предпочли бы скрыть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "обнаруживать скрываемое"
                            },
                            {
                                "target_lang_word": "обнаруживать",
                                "target_lang_sense_clarification": "показывать чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0e8fd29-557b-398b-85f5-914f2fb9451f",
                    "sense_definition": "To mislead someone or cause someone to end up in trouble or error unexpectedly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "misleading or leading into trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright sign <w>betrayed</w> us and led us to the wrong entrance.",
                            "target_lang_translations": {
                                "ru": "Яркая вывеска <w>подвела</w> нас и привела не к тому входу."
                            }
                        },
                        {
                            "text": "His confidence <w>betrayed</w> him, and he made a careless mistake.",
                            "target_lang_translations": {
                                "ru": "Уверенность <w>подвела</w> его, и он совершил неосторожную ошибку."
                            }
                        }
                    ],
                    "antonyms": [
                        "guide",
                        "help"
                    ],
                    "common_phrases": [
                        "betray someone into",
                        "betray into error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ввести кого-либо в заблуждение или неожиданно стать причиной чьих-либо неприятностей или ошибок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подводить",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "подводить в трудную минуту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7966f85-7fc0-3a3c-817e-1d29d88e903e",
                    "sense_definition": "To hand someone or something over to an enemy by treachery, violating trust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "treason or handing over",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general <w>betrayed</w> the city to the enemy during the war.",
                            "target_lang_translations": {
                                "ru": "Во время войны генерал <w>сдал</w> город врагу."
                            }
                        },
                        {
                            "text": "He was accused of trying to <w>betray</w> his country for money.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в попытке <w>предать</w> свою страну ради денег."
                            }
                        }
                    ],
                    "antonyms": [
                        "defend",
                        "protect"
                    ],
                    "common_phrases": [
                        "betray the city",
                        "betray the country",
                        "betray to the enemy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often in historical, legal, or military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать кого-либо или что-либо врагу путем предательства, нарушая доверие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "выдавать врагу"
                            },
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "передавать противнику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5455c4a6-4db3-3338-b36b-e859c72cbd0b",
                    "sense_definition": "To seduce someone (often with a promise of marriage) and then abandon them.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seduction and abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old story, he <w>betrayed</w> her with promises of marriage and then left.",
                            "target_lang_translations": {
                                "ru": "В старой истории он <w>обманул</w> её обещаниями женитьбы, а затем бросил."
                            }
                        },
                        {
                            "text": "The novel describes a man who <w>betrayed</w> a young woman and abandoned her.",
                            "target_lang_translations": {
                                "ru": "В романе описывается человек, который <w>предал</w> молодую женщину и оставил её."
                            }
                        }
                    ],
                    "common_phrases": [
                        "betray under promise",
                        "betray then abandon"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older or literary use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обольстить кого-либо (часто обещанием брака), а затем бросить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "обольщать и бросать"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "нарушать обещание любви"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}