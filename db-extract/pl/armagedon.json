                        ]
                    },
                    {
                        "translation_id": "85c63a94-2ff3-4bfb-ae53-fbc2b2703ebd",
                        "source_entry_id": "04a4e331-a344-399c-8486-26078ba756f4",
                        "source_sense_id": "2f69f9dd-8cf5-3236-a9f4-316a1c2ac8fd",
                        "target_lang_word": "Armageddon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armageddon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddcaa378-aca0-3dd7-b465-0d9615029a13",
                                        "entry_id": "48a2f493-94ef-3a43-b1d9-d12a876dc3a5",
                                        "glosses": [
                                            "nach der Offenbarung des Johannes 16, 16 der mythische Ort der letzten Entscheidungsschlacht"
                                        ],
                                        "tags": [
                                            "Bibel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1860d037-0e7e-4d43-b3f7-bb6782e77726",
                                                "sense_id": "ddcaa378-aca0-3dd7-b465-0d9615029a13",
                                                "text": "„Der Höhepunkt ist, wenn sie mir von dem gottgewollten Weltuntergang erzählen, den sie Armageddon nennen.“"
                                            },
                                            {
                                                "example_id": "fcdf9161-67d0-4272-9720-b8d9fb448125",
                                                "sense_id": "ddcaa378-aca0-3dd7-b465-0d9615029a13",
                                                "text": "„Er wird Gog und Magog um sich scharen, zwei Völker von den Enden der Erde; der Messias wird erneut erscheinen, und nach einem fürchterlichen Endkampf, dem Armageddon, werden Satan und alle, die ihm gefolgt sind, vom ewigen Höllenfeuer verschlungen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "96d97802-0815-35ec-894a-9fb97fe74273",
                                        "entry_id": "48a2f493-94ef-3a43-b1d9-d12a876dc3a5",
                                        "glosses": [
                                            "katastrophales (politisches) Ereignis"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d29c5e-139b-4aeb-9c58-75436d9442bf",
                                                "sense_id": "96d97802-0815-35ec-894a-9fb97fe74273",
                                                "text": "„Die ganze Nacht sah man auf allen Kanälen diese Farce des Armageddon, auf das wir seit dem 6. August 1945 in unseren Luftschutzkellern gewartet hatten.“"
                                            },
                                            {
                                                "example_id": "3959a50b-0c2f-4939-a4cd-cca62098c5a9",
                                                "sense_id": "96d97802-0815-35ec-894a-9fb97fe74273",
                                                "text": "„Es japst lautlos, um Luft für das nächste Armageddon zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
