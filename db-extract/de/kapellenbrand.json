                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de01386-c0de-45b3-b212-0da39523bc1b",
                                "sense_id": "a1020e18-c550-3155-ac7b-438fa727d99e",
                                "text": "„Der Bildstock wurde beim Kapellenbrand am 23.6.1975 zerstört.“"
                            },
                            {
                                "example_id": "71098641-50a9-4336-8001-75749cab0040",
                                "sense_id": "a1020e18-c550-3155-ac7b-438fa727d99e",
                                "text": "„Am 17/04/14 wurde die FF-Hollersbach zu einem Kapellenbrand am Sonnberg gerufen.“"
                            },
                            {
                                "example_id": "256dc152-4d4c-4e28-bee8-abd5b87bd561",
                                "sense_id": "a1020e18-c550-3155-ac7b-438fa727d99e",
                                "text": "„Die beim Kapellenbrand 1963 vernichtete Statue des hl. Johannes wurde 1983 durch eine vom Bildhauer Wolfgang Kaindl geschaffene Holzplastik ersetzt.“"
                            },
                            {
                                "example_id": "df41a887-a9b1-40e2-a370-06581ce57c09",
                                "sense_id": "a1020e18-c550-3155-ac7b-438fa727d99e",
                                "text": "„Bei weiteren Bränden im Verlaufe des Monats fährt der Löschzug zu einem Kellerbrand in eine Nachbargemeinde, sowie zu einem Kapellenbrand in einen Stadtteil.“"
                            },
                            {
                                "example_id": "30510e7b-3fe9-42bf-97ce-5f536f0b71fd",
                                "sense_id": "a1020e18-c550-3155-ac7b-438fa727d99e",
                                "text": "„Die Gruppe des KLF-A fuhr zu einem Kapellenbrand aus und mussten mittels Tragkraftspritze eine Wasserversorgung herstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
