                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der klaren Winternacht <w>funkeln</w> unzählige Sterne am dunklen Himmel."
                        },
                        {
                            "text": "Die kleinen Tautropfen auf dem frischen Gras <w>funkeln</w> wie Diamanten in der Morgensonne."
                        }
                    ],
