                                                "example_id": "bcbca294-d886-4765-b603-33cf4a66f981",
                                                "sense_id": "87ae93b8-80fa-3533-915f-134b80f1c9aa",
                                                "text": "„Oft bekommen Autofahrer einen Strafzettel aber nicht aus Ignoranz, sondern weil das Parksystem verwirrend ist.“"
                                            },
                                            {
                                                "example_id": "8cde4e4c-7234-465b-a775-4ce5f37dbbf7",
                                                "sense_id": "87ae93b8-80fa-3533-915f-134b80f1c9aa",
                                                "text": "„Er füllte den Strafzettel aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
