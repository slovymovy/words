    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edcf73c0-729c-344e-9f11-a7a52bf5ed9a",
                    "sense_definition": "The simple past tense of <w>sing</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>sang</w> a beautiful lullaby to the baby.",
                            "target_lang_translations": {
                                "ru": "Она <w>спела</w> ребенку красивую колыбельную.",
                                "zh": "她给宝宝<w>唱</w>了一首优美的摇篮曲。"
                            }
                        },
                        {
                            "text": "We all <w>sang</w> along when our favorite song came on the radio.",
                            "target_lang_translations": {
                                "ru": "Мы все <w>подпевали</w>, когда по радио заиграла наша любимая песня.",
                                "zh": "当收音机里播放我们最喜欢的歌时，我们都跟着<w>唱</w>了起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sang along",
                        "sang out",
                        "sang a song"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола <w>sing</w> (петь).",
                        "zh": "动词 sing 的过去式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пел",
                                "target_lang_sense_clarification": "прошедшее время, несовершенный вид"
                            },
                            {
                                "target_lang_word": "спел",
                                "target_lang_sense_clarification": "прошедшее время, совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唱",
                                "target_lang_sense_clarification": "动词，表示发出歌声"
                            },
                            {
                                "target_lang_word": "演唱",
                                "target_lang_sense_clarification": "动词，正式的表演歌唱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ae05ba0c-7075-3570-a99f-b33dcac33350",
                    "sense_definition": "A surname of Chinese, Korean, or Khmer origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Sang</w> introduced himself at the beginning of the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Санг</w> представился в начале встречи.",
                                "zh": "<w>桑</w>先生在会议开始时做了自我介绍。"
                            }
                        },
                        {
                            "text": "I believe <w>Sang</w> is a fairly common family name in that region.",
                            "target_lang_translations": {
                                "ru": "Я полагаю, что <w>Санг</w> — довольно распространенная фамилия в этом регионе.",
                                "zh": "我相信<w>桑</w>在那个地区是一个相当常见的姓氏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия китайского, корейского или кхмерского происхождения.",
                        "zh": "源自中国、韩国或高棉的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Санг",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桑",
                                "target_lang_sense_clarification": "中文姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fae27a4-5456-3bcf-9a9b-8c506fa00e89",
                    "sense_definition": "An alternative form of <w>sheng</w> (a Chinese wind instrument).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum exhibit featured an ancient <w>sang</w> from the Ming dynasty.",
                            "target_lang_translations": {
                                "ru": "В экспозиции музея был представлен древний <w>шэн</w> династии Мин.",
                                "zh": "博物馆的展览中陈列着一件明代的古<w>笙</w>。"
                            }
                        },
                        {
                            "text": "He learned to play the <w>sang</w> while studying traditional music abroad.",
                            "target_lang_translations": {
                                "ru": "Он научился играть на <w>шэне</w> во время изучения традиционной музыки за границей.",
                                "zh": "他在国外学习传统音乐时学会了吹<w>笙</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативная форма слова <w>sheng</w> (китайский духовой инструмент).",
                        "zh": "笙（一种中国传统吹奏乐器）的另一种拼写形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шэн",
                                "target_lang_sense_clarification": "музыкальный инструмент"
