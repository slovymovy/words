                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c4080b3-ced8-4151-b691-36aa1ef91bd0",
                                "sense_id": "006f06fd-e2f4-3ff5-9574-07b75da7b821",
                                "text": "Struck by his desperate dauntlessness, and his wild desire to visit Christendom, the captain at last relented, and told him he might make himself at home."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
