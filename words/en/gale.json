                            {
                                "target_lang_word": "очередно́й плате́ж",
                                "target_lang_sense_clarification": "срок уплаты аренды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f03e7f47-0b3f-3f7a-9e87-b369964a6729",
                    "sense_definition": "The personal mining plot of a freeminer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The freeminer secured a <w>gale</w> to extract coal from the forest.",
                            "target_lang_translations": {
                                "ru": "Фримайнер получил <w>отвод</w> на добычу угля в лесу."
                            }
                        },
                        {
                            "text": "He decided to lease his <w>gale</w> to a larger mining company.",
                            "target_lang_translations": {
                                "ru": "Он решил сдать свой <w>участок</w> в аренду более крупной горнодобывающей компании."
                            }
                        }
