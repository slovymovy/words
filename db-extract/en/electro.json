                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                                        "entry_id": "13ff041d-ec3b-3725-b572-249bed2a0a86",
                                        "glosses": [
                                            "Musique électronique caractérisée par l’utilisation de boîtes à rythmes spécifiques (TR-808, TR-909) et d’échantillons de funk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc88727-623d-4da0-a518-6429132df4e6",
                                                "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                                                "text": "Certes des initiatives se développent — […] — mais elles nécessitent encore des réseaux autres que ceux du bouche à oreille des passionnés de l’électro."
                                            },
                                            {
                                                "example_id": "153d4fb2-db06-4b98-b7d0-ca62b8ff0731",
                                                "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                                                "text": "Église transformée en temple de la house et de l’électro, le Glória rappelle les discothèques européennes des années 1980 et attire une foule branchée alternative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06e964f-3412-324d-a01e-7ab94d0eedd1",
                                        "entry_id": "13ff041d-ec3b-3725-b572-249bed2a0a86",
                                        "glosses": [
                                            "Musique électronique correspondant à la première époque du hip hop, illustrant la confrontation entre une musique noire, urbaine et technologique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b55bfb7-4f59-364b-bf83-936088b25b17",
                                        "entry_id": "13ff041d-ec3b-3725-b572-249bed2a0a86",
                                        "glosses": [
                                            "Genre générique englobant de multiples genres de Musique électronique dansante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "électro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe86ab2-2492-3cc4-a183-9950e321d1fb",
                                        "entry_id": "c1625ceb-e495-3a8e-a991-070bde8d387d",
                                        "glosses": [
                                            "Électricien qui s'occupe de l’installation des projecteurs et de la gestion des installations électriques sur un plateau de tournage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9397ead0-7c0d-48f4-a4bd-973ecab0a95c",
                                                "sense_id": "1fe86ab2-2492-3cc4-a183-9950e321d1fb",
                                                "text": "Sur les indications que le directeur de la photo a données au chef électricien, l’équipe des électros s’occupe de disposer, d’alimenter et de régler les projecteurs de lumière."
                                            },
                                            {
                                                "example_id": "86c924f1-8421-45f3-ace9-926a32457aa6",
                                                "sense_id": "1fe86ab2-2492-3cc4-a183-9950e321d1fb",
                                                "text": "Chaque jour, Gabin apprend beaucoup de la technique, il interroge sans cesse chaque technicien sur les mystères du cinématographe, « copine » avec le chef électro Louis Berger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c8201e0-a4f2-3176-98a4-daa822515f22",
                                        "entry_id": "4d11572c-3f87-35b8-91bd-f66e3484ea58",
                                        "glosses": [
                                            "Électroaimant."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20838270-e2e4-4fa5-82de-0815b49c70ee",
                                                "sense_id": "9c8201e0-a4f2-3176-98a4-daa822515f22",
                                                "text": "Les électro-aimants inducteurs N, S, N, S, etc., sont pourvus d'un enroulement de fil unique, dont le sens alterne de l'un à l'autre ; les noyaux de ces électros sont en fer doux ou en fonte ; le courant d'excitation est fourni par une petite dynamo à courant continu, du type supérieur Gramme, montée sur le même arbre que l'inducteur de l'alternateur."
                                            },
                                            {
                                                "example_id": "c60f355e-14d4-4f8a-a238-f772e614451f",
                                                "sense_id": "9c8201e0-a4f2-3176-98a4-daa822515f22",
                                                "text": "La disposition choisie dans le but de l'enclenchement automatique ou à la main , et qui consiste à munir les électros 38, 39, 40 et 41 d'un double enroulement, ressort clairement de la figure."
                                            },
                                            {
                                                "example_id": "553005d8-31f2-4fe8-ba6e-60c47ff68856",
                                                "sense_id": "9c8201e0-a4f2-3176-98a4-daa822515f22",
                                                "text": "Les cliquets se lèvent quand leurs électros respectifs reçoivent le courant, c'est à dire quand les interrupteurs à tube de mercure des relais sont fermés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f707ff25-8aff-38d3-8d68-d3203b2f9dba",
                                        "entry_id": "84b583c2-0181-3b44-91ca-a60c2178c3ef",
                                        "glosses": [
                                            "Qui fait de l’électro ; relatif à cette musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a982627-e339-41d1-a537-997258bdd53e",
                                                "sense_id": "f707ff25-8aff-38d3-8d68-d3203b2f9dba",
                                                "text": "Sur Internet, les organisateurs avaient fait monter le buzz depuis des mois avec la présence assurée de Calvin Harris, Frankie Knuckles, de groupes électro appréciés du public comme Justice, Jamaïca et Atman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
