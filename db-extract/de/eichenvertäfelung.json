                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ff2a77-8a49-40ea-8cf9-bc3f7bf0e7a2",
                                "sense_id": "0187da18-cf97-3a39-9871-091ce468b80d",
                                "text": "„Am folgenden Tage saß ich in meinem Arbeitszimmer, einem hohen, westlich gelegenen Raum im zweiten Stock mit Kreuzbogen, schwarzer Eichenvertäfelung und einem dreigeteilten gotischen Fenster, durch das man auf den Kalksteinfelsen und das trostlose Tal blickte, als ein Diener den Raum betrat.“"
                            },
                            {
                                "example_id": "30b6a586-fb16-4053-b0ce-32dc9b6efc14",
                                "sense_id": "0187da18-cf97-3a39-9871-091ce468b80d",
                                "text": "„Unter der hohen Decke hingen Spinnweben, und die aufwändig verzierten Eichenvertäfelungen waren schwarz und schmutzig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
