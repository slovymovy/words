                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43777284-58fb-49b2-85cf-1c47a9a85158",
                                "sense_id": "77ebd3db-5ec4-34c8-8b4c-000b2dfa7dca",
                                "text": "The groom is a Boanerges, rants twice as loud and twice as long as my Phoenix, and is, of course, in the estimate of the fanatics, twice as clever a fellow."
                            },
                            {
                                "example_id": "456257cd-216c-44aa-86e4-e5bec051ae5e",
                                "sense_id": "77ebd3db-5ec4-34c8-8b4c-000b2dfa7dca",
                                "text": "I have sat under Boanerges when he has specifically addressed himself to us — us, the infants — and at this present writing I hear his lumbering jocularity (which never amused us, though we basely pretended that it did), and I behold his big round face, and I look up the inside of his outstretched coat-sleeve as if it were a telescope with the stopper on, and I hate him with an unwholesome hatred for two hours."
                            }
                        ]
                    }
