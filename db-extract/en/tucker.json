                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9acfbc-501d-4d89-bc54-3444a68624dd",
                                                "sense_id": "3cb1e267-7e2d-30ba-87c5-2a774a259de2",
                                                "text": "Než jsem skupince trochu utek, běželo se mi skvěle. Na 25. km mě ale vyřídil kopec a zbytek jsem protrpěl."
