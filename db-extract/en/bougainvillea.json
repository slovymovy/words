                "senses": [
                    {
                        "sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                        "entry_id": "c001ce3a-b57c-3099-85cc-0f9dda093661",
                        "glosses": [
                            "Any of several South American flowering shrubs or lianas, of the genus Bougainvillea, having three showy, colorful bracts attached below each group of three inconspicuous flowers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f4d2ff-ab8b-4d2a-af8b-9b0334023ba1",
                                "sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                                "text": "He is outside in his garden, surrounded by bougainvillea bursting with color."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a69e7e80-9afd-4d25-a01c-5205d6990e08",
                        "source_entry_id": "c001ce3a-b57c-3099-85cc-0f9dda093661",
                        "source_sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                        "source_sense_description": "flower",
                        "target_lang_word": "bougainvillea",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bougainvillea",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9d02011b-1346-361f-9f0e-b8821e263436",
                                        "entry_id": "73df22ea-90af-3fe1-93fb-80d387e8c322",
                                        "glosses": [
                                            "een geslacht Bougainvillea uit de familie Nyctaginaceae. Soorten en kruisingen uit het geslacht worden toegepast als tuin- en kamerplant. Er zijn circa 15 soorten, afkomstig uit de tropen en subtropen van Zuid-Amerika, vooral Brazilië. Ze zijn in de eerste helft van de 19de eeuw in Europa ingevoerd. Vooral in de landen rond de Middellandse Zee en in Afrika tieren ze welig"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2c3acb9-c3eb-419b-a61a-ee926cb24b57",
                        "source_entry_id": "c001ce3a-b57c-3099-85cc-0f9dda093661",
                        "source_sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                        "source_sense_description": "flower",
                        "target_lang_word": "bougainvillée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bougainvillée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd0364f7-8139-3d99-b7a1-b85b08ffca61",
                                        "entry_id": "b29b553c-21b0-35cd-9e35-1b4a8a162f1f",
                                        "glosses": [
                                            "Genre d’arbustes épineux grimpants du genre Bougainvillea, de la famille des nyctaginacées comprenant une environ 19 espèces originaires des forêts tropicales humides d’Amérique du Sud, utilisés en Europe comme plantes ornementales pour les vives couleurs de leurs bractées. (Bougainvillea spp.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bbb3797-0a1e-46ab-8346-0a0b46ce7a74",
                                                "sense_id": "dd0364f7-8139-3d99-b7a1-b85b08ffca61",
                                                "text": "Le bougainvillée est décoratif par ses grandes bractées colorées de rouge pourpré et non par ses fleurs blanchâtres, petites et discrètes ^([1])."
                                            },
                                            {
                                                "example_id": "9e1849e3-a49b-4b47-9f3a-27c008eb2a10",
                                                "sense_id": "dd0364f7-8139-3d99-b7a1-b85b08ffca61",
                                                "text": "Je sortis dans le jardin et circulai quelques minutes entre les plantes – qui pouvaient aussi bien être des bougainvillées, pour ce que j’en avais à foutre."
                                            },
                                            {
                                                "example_id": "852f1cd2-677b-4c0e-acb8-e00b32045b48",
                                                "sense_id": "dd0364f7-8139-3d99-b7a1-b85b08ffca61",
                                                "text": "La lune en plein jour, les pieds dans l’eau, le clapotis tiède, la brise écœurante, l’odeur des bougainvillées, des bouquets de jacarandas, c’est à gerber de fleurs puantes […]"
                                            },
                                            {
                                                "example_id": "f706d3b5-b752-4b3d-9cae-2a51669e4cbb",
                                                "sense_id": "dd0364f7-8139-3d99-b7a1-b85b08ffca61",
                                                "text": "De vigoureuses bougainvillées d’un orange éclatant grimpaient à l’assaut des murs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3ac4c7c-53b6-4771-95f4-a21744638e29",
                        "source_entry_id": "c001ce3a-b57c-3099-85cc-0f9dda093661",
                        "source_sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                        "source_sense_description": "flower",
                        "target_lang_word": "bougainvillier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bougainvillier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7c2269-1cd0-329d-b92d-1568b151c0e6",
                                        "entry_id": "44952fba-5e9b-3d27-b743-8f5450441be5",
                                        "glosses": [
                                            "Variante de bougainvillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cad04a4-35fe-49d4-84e7-b628d557959e",
                                                "sense_id": "6e7c2269-1cd0-329d-b92d-1568b151c0e6",
                                                "text": "Los Angeles est luxuriante de bougainvilliers et de camélias nourris de l'eau volée à la vallée de l'Owens. Los Angeles, c'est une piscine dans le jardin et une BMW dans l'allée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a39b7ff7-5022-4574-8a85-36b149965dd8",
                        "source_entry_id": "c001ce3a-b57c-3099-85cc-0f9dda093661",
                        "source_sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                        "source_sense_description": "flower",
                        "target_lang_word": "Bougainvillea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bougainvillea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                        "entry_id": "fa19b702-e262-3574-98e7-87f075e6ab3c",
                                        "glosses": [
                                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2cd015a-38e4-4e8c-bdba-bbb8868eb8c7",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie machte ihn aufmerksam auf das, was jetzt hier blühte: Hibiskus, Bougainvillea, Fuchsien.“"
                                            },
                                            {
                                                "example_id": "9387f595-00f6-48ed-9820-6bdf7443afab",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie sahen die unversehrten Stadtmauern, die zugewucherten Straßen, die von den Bougainvilleen verschlungenen Festungen, die Marmorpaläste mit den Goldaltären und den Vizekönigen, die pestkrank in ihren Rüstungen verfault waren.“"
                                            },
                                            {
                                                "example_id": "590243bf-e1b9-42e5-a7df-56ac5383cfdb",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„»[…] Auch die Bougainvillea kommt aus meiner Heimat, obwohl man hierzulande glaubt, sie wachse nur im Mittelmeerraum.«“"
                                            },
                                            {
                                                "example_id": "714e8bc9-793a-4079-ba91-a1d7e071cfa9",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Pinkblühende Bougainvilleen ranken sich an den Mauern empor, sanftes Palmenrauschen über uns.“"
                                            },
                                            {
                                                "example_id": "138e7021-db33-457c-a7f5-2cdf593b8861",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Das heutige Karthago ist der wohl schönste Vorort von Tunis mit palmen- und eukalyptusgesäumten Alleen, Villen und Gärten voll roter Hibiskusblüten und lila Bougainvilleen.“"
                                            },
                                            {
                                                "example_id": "50dcebf4-9b02-43c3-b8f2-71f065a9f9c0",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Bougainvilleen bilden schrillrote Blütenkaskaden.“"
                                            },
                                            {
                                                "example_id": "3baf6041-6bed-428a-825c-8abd0a868f32",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Unter der purpurroten Bougainvillea kommt sie wieder zu Atem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
