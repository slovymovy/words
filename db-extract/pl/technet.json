                                        "entry_id": "049177b7-7e30-3f9c-98c0-a07b201afdbc",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 43 et de symbole Tc, qui fait partie de la série des métaux de transition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "674e27ec-163e-43a4-a88d-763416e99823",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "Le technétium ne possède pas d’isotope stable."
                                            },
                                            {
                                                "example_id": "ff30eb60-740d-43d1-959c-60e2badfa0fe",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "Le technétium s’appela d’abord masurium."
                                            },
                                            {
                                                "example_id": "579e00e8-11cb-4159-bd8e-369107b1dc5a",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "En 1937, il [Emilio Segré] découvrit le technétium, le premier élément chimique (de numéro atomique 43) à avoir été produit artificiellement (technetos veut dire « artificiel » en grec)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d67eb82-3b0f-461b-98d8-39622e7ecf66",
                        "source_entry_id": "bfbfa00c-ff35-33e2-823d-7a7d8d83e8d2",
                        "source_sense_id": "df215445-f2a7-328e-9bd4-6aa5dd71fe2d",
                        "target_lang_word": "tecnecio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
