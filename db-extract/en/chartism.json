                        "translation_id": "d6bbfca0-02d4-4642-9459-4b70237f7516",
                        "source_entry_id": "c2596f0e-7ddc-3d58-b1e0-f84a90ca74db",
                        "source_sense_id": "ffb123c7-41de-3b85-83b3-246dd72537ed",
                        "source_sense_description": "a movement for political and social reform in the United Kingdom during the mid-19th century",
                        "target_lang_word": "chartisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chartisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e56da7-d03e-3895-84a0-af1fa2c192b0",
                                        "entry_id": "22107bff-eb00-3aab-a96b-759fec203565",
                                        "glosses": [
                                            "Mouvement social ouvrier en Angleterre entre 1838 et 1848."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edd3e1c-650f-471c-8012-c0c6421f135c",
                                                "sense_id": "c7e56da7-d03e-3895-84a0-af1fa2c192b0",
                                                "text": "Le chartisme, cette plaie terrible, était constitué, et, jusque aux portes de Londres la population inquiète des tisserands de soie de Spitael-Fields, poussait, dans d’innombrables meetings, des cris de haine contre la métropole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22efd23-787c-3728-858f-efa771941602",
                                        "entry_id": "22107bff-eb00-3aab-a96b-759fec203565",
                                        "glosses": [
                                            "Limitation des pouvoirs d’un peuple souverain par une série de chartes et de traités."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e37ef48-6873-4d02-9be3-98364408ecdb",
                                                "sense_id": "d22efd23-787c-3728-858f-efa771941602",
                                                "text": "Maxime Tandonnet décrit ce que Mathieu Bock-Coté appelle le chartisme : à coups de chartes et de traités, on limite de plus en plus les pouvoirs du peuple souverain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0439a86a-22ca-38ec-9d09-16606022c496",
                                        "entry_id": "22107bff-eb00-3aab-a96b-759fec203565",
                                        "glosses": [
                                            "Technique d’analyse boursière reposant sur les graphiques des cours de bourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf0e0b6-350a-4b27-b782-9ddf3b5436f8",
                                                "sense_id": "0439a86a-22ca-38ec-9d09-16606022c496",
                                                "text": "Le chartisme est une méthode d'analyse basée sur la reconnaissance de “figures types” (Triangle, Biseau, ETE, Flag, etc…) et permettant d'appréhender l’évolution du marché boursier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
