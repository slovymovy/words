                    "frequency": "Middle",
                    "semantic_group_id": "pride",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>arrogance</w> prevented him from listening to the advice of his more experienced colleagues.",
                            "target_lang_translations": {
                                "ru": "Его <w>высокомерие</w> помешало ему прислушаться к совету более опытных коллег."
                            }
                        },
                        {
                            "text": "The manager's sheer <w>arrogance</w> made it impossible for the team to work together effectively.",
                            "target_lang_translations": {
                                "ru": "Вопиющая <w>заносчивость</w> руководителя делала эффективную совместную работу команды невозможной."
                            }
                        }
                    ],
                    "synonyms": [
