                                "example_id": "8c0327f7-6f45-4529-bbca-1ccc7ec337f1",
                                "sense_id": "f3d33e8c-348b-315b-aa73-65820dc342cf",
                                "text": "Ik verwarm mijn eten altijd in de magnetron als ik weinig tijd heb.",
                                "translation": "I always heat my food in the microwave oven when I'm short on time.",
                                "english": "I always heat my food in the microwave oven when I'm short on time."
                            },
                            {
                                "example_id": "18e32abc-ca0f-4c95-88e7-4e3b6320ce8b",
                                "sense_id": "f3d33e8c-348b-315b-aa73-65820dc342cf",
                                "text": "De magnetron is handig om snel restjes op te warmen.",
                                "translation": "The microwave oven is handy for quickly reheating leftovers.",
                                "english": "The microwave oven is handy for quickly reheating leftovers."
                            },
                            {
                                "example_id": "4d7b09fd-9e20-40b5-b373-38a59a2f4655",
                                "sense_id": "f3d33e8c-348b-315b-aa73-65820dc342cf",
                                "text": "Hij plaatste de kom met soep in het kleine magnetronnetje om het op te warmen.",
                                "translation": "He put the bowl of soup in the small microwave oven to heat it up.",
                                "english": "He put the bowl of soup in the small microwave oven to heat it up."
                            }
                        ]
                    }
