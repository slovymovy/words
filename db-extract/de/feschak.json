                "senses": [
                    {
                        "sense_id": "3df9d773-a62c-3f6c-b390-311b44bba450",
                        "entry_id": "f9e82e65-61aa-3ca1-8d17-0dda57e9a3a5",
                        "glosses": [
                            "gut aussehender und/oder gut gekleideter Mann"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0d148e85-4a25-4e41-884f-b6acf7ebf9de",
                                "sense_id": "3df9d773-a62c-3f6c-b390-311b44bba450",
                                "text": "„Der Zahlkellner vom ‚Bauernfeind‘ kam lange nicht. Er war ein stadtbekannter Feschak, und die Damen, mit Ausnahme meiner Großmutter, pflegten mit ihm kindisch zu kokettieren.“"
                            },
                            {
                                "example_id": "5cb49726-b6ec-401b-b43e-9952ea1dcd5a",
                                "sense_id": "3df9d773-a62c-3f6c-b390-311b44bba450",
                                "text": "„Etwas obenhin, scheint mir, mehr so, sagen wir einmal, à la Feschak.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a30538-581d-4442-baab-20998b12fd93",
                        "source_entry_id": "f9e82e65-61aa-3ca1-8d17-0dda57e9a3a5",
                        "source_sense_id": "3df9d773-a62c-3f6c-b390-311b44bba450",
                        "source_sense_description": "gut aussehender und/oder gut gekleideter Mann",
                        "target_lang_word": "beau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97ef8f8f-7bb8-3967-84fa-dca6f2a63345",
                                        "entry_id": "c2682251-1fb6-34e9-91b5-e9dc33edad5c",
                                        "glosses": [
                                            "A man with a reputation for fine dress and etiquette; a dandy or fop."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877757cc-947b-40a0-a01a-4b763433df8e",
                                                "sense_id": "97ef8f8f-7bb8-3967-84fa-dca6f2a63345",
                                                "text": "“[…]—I suppose your brother was quite a beau, Miss Dashwood, before he married, as he was so rich?”\n“Upon my word,” replied Elinor, “I cannot tell you, for I do not perfectly comprehend the meaning of the word. But this I can say, that if he ever was a beau before he married, he is one still, for there is not the smallest alteration in him.”\n“Oh! dear! one never thinks of married men’s being beaux—they have something else to do.”"
                                            },
                                            {
                                                "example_id": "f4f4e204-efbd-4618-b94e-6640ebc8645b",
                                                "sense_id": "97ef8f8f-7bb8-3967-84fa-dca6f2a63345",
                                                "text": "[H]e could not but turn with ineffable contempt to the tawdry beaus and belles from the city, who presumed to mingle in the fashionable gala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1d33d1-25e9-3982-93f5-6961a4c0adec",
                                        "entry_id": "c2682251-1fb6-34e9-91b5-e9dc33edad5c",
                                        "glosses": [
                                            "A male lover; a boyfriend."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6833364-e01c-4870-9433-4d0de6eb963d",
                                                "sense_id": "0a1d33d1-25e9-3982-93f5-6961a4c0adec",
                                                "text": "Hannah's beau takes all her time 'n' thought, and when she gits a husband her mother'll be out o' sight and out o' mind."
                                            },
                                            {
                                                "example_id": "3e08fd07-6ffb-4b1a-b734-ee6e04f445d6",
                                                "sense_id": "0a1d33d1-25e9-3982-93f5-6961a4c0adec",
                                                "text": "“I don’t see how. But anyhow, you’ll be rich some day—your Aunt Elizabeth will likely leave you all her money, Mother says. So I don’t care if you are living on charity—I love you and I’m going to stick up for you. Have you got a beau, Emily?”\n“No,” cried Emily, blushing violently and quite scandalized at the idea. “Why, I’m only eleven.”"
                                            },
                                            {
                                                "example_id": "91fc609f-8fe8-40de-955c-5bf5a2b5d3e6",
                                                "sense_id": "0a1d33d1-25e9-3982-93f5-6961a4c0adec",
                                                "text": "Kristin Davis has taken time out to enjoy the surf and sand with her Australian beau, photographer Russell James."
                                            },
                                            {
                                                "example_id": "de57861c-1cd0-43fa-bacb-ae8b8ab7a3f2",
                                                "sense_id": "0a1d33d1-25e9-3982-93f5-6961a4c0adec",
                                                "text": "Reporters ask her about her love life—her current beau is rumored to be Conor Kennedy, a grandson of Robert F. Kennedy—even if they get nowhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1736d0bd-6cb7-3e65-818e-ca898a2b8138",
                                        "entry_id": "c2682251-1fb6-34e9-91b5-e9dc33edad5c",
                                        "glosses": [
                                            "A male escort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88154b6e-1bcc-3da9-850b-93febdddc61f",
                                        "entry_id": "c2682251-1fb6-34e9-91b5-e9dc33edad5c",
                                        "glosses": [
                                            "A suitor of a lady."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77550bb1-7d46-3755-bd1b-6ba8c0383cb1",
                                        "entry_id": "0ea2222d-e51d-3af8-bc52-8c8bff5a6c42",
                                        "glosses": [
                                            "To act as a beau (towards); to court or woo."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045650db-e795-4731-9af1-692e8c366527",
                                                "sense_id": "77550bb1-7d46-3755-bd1b-6ba8c0383cb1",
                                                "text": "Everyone was feeling grandacious, as if getting dressed for a night of beauing."
                                            }
                                        ]
