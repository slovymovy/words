                            },
                            {
                                "target_lang_word": "zijvleugel",
                                "target_lang_sense_clarification": "aanbouw aan de zijkant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4937f4b-cfc3-3a44-a7c3-b535fc5b33b7",
