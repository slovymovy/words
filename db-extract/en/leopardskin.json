                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70fbb303-8c08-4701-8860-863ea36fb1a0",
                                "sense_id": "deca7aa4-a340-3a43-a84e-19a891d8ae70",
                                "text": "I turned, and followed him down the passage, and when we reached the great central cave saw that many Amahagger, some robed, and some merely clad in the sweet simplicity of a leopard skin, were hurrying along it."
                            },
                            {
                                "example_id": "e835940e-f07b-426e-9ba6-dbf9a6825076",
                                "sense_id": "deca7aa4-a340-3a43-a84e-19a891d8ae70",
                                "text": "Opposite him was the Fat Lady, red-faced and laughing. Beside her, the India-rubber Man wound spaghetti on to a fork with an expression of deepest melancholy. Further down the table, the Strong Man, an overcoat covering his leopard-skin, talked garrulously."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fdd75d7-a9e1-383a-8f52-8acd58b0dc8e",
                        "entry_id": "55ad92f0-ea88-325a-99fc-71096e74afd1",
                        "glosses": [
                            "A design, especially on fabric, similar to the markings of a leopard."
