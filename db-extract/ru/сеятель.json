                                "target_senses": [
                                    {
                                        "sense_id": "cba29307-95fe-396f-a3aa-05de5413ac9e",
                                        "entry_id": "ffb3f270-3470-3840-81b5-928e030a1867",
                                        "glosses": [
                                            "One who, or that which, disseminates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214afa3d-21cf-435d-be1e-fa16ed43f2bf",
                                                "sense_id": "cba29307-95fe-396f-a3aa-05de5413ac9e",
                                                "text": "It is these people, gentlemen, the disseminators of these rumours, who are my dangerous accusers; because those who hear them suppose that anyone who inquires into such matters must be an atheist."
                                            },
                                            {
                                                "example_id": "72642e15-99fd-4085-b286-1e67f02c3dec",
                                                "sense_id": "cba29307-95fe-396f-a3aa-05de5413ac9e",
                                                "text": "I think that the New Song movement may hold the key in the cultural merging of many cultures and peoples, for it expands the role of the artists into a disseminator of artistic culture, instead of the self-absorbed, individualistic style that characterizes North American songwriters."
                                            }
                                        ]
                                    }
                                ]
                            }
