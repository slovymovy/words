                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac8650f6-eece-3e39-9c56-482b56051213",
                        "entry_id": "a206a24b-92bb-3204-b09a-0876404f5faf",
                        "glosses": [
                            "Être retrouvé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6621a768-44ea-4fa0-b019-4716e10a5ff2",
                                "sense_id": "ac8650f6-eece-3e39-9c56-482b56051213",
                                "text": "Пропа́жа нашла́сь. : L’objet perdu a été retrouvé."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b1535df-e28a-3ddf-93eb-862000c901aa",
                        "entry_id": "a206a24b-92bb-3204-b09a-0876404f5faf",
                        "glosses": [
                            "Se trouver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bfba6c4-73a3-4dc5-a07f-203617079981",
                                "sense_id": "6b1535df-e28a-3ddf-93eb-862000c901aa",
                                "text": "Нашёлся челове́к, кото́рый э́то сде́лал. : Il s’est trouvé un homme pour le faire."
                            },
                            {
                                "example_id": "c0db4e89-47e6-4791-81bf-2830e5d7ce29",
                                "sense_id": "6b1535df-e28a-3ddf-93eb-862000c901aa",
                                "text": "Не нашло́сь охо́тников е́хать так далеко́. : Personne n’a été tenté par un si lointain voyage."
                            }
                        ]
                    },
                    {
                        "sense_id": "68a0c388-9bf7-3f62-b6a2-745a8db73238",
                        "entry_id": "a206a24b-92bb-3204-b09a-0876404f5faf",
                        "glosses": [
                            "Avoir l’esprit prompt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba0524d-fc7c-4eb6-b703-7893310ea3d3",
                                "sense_id": "68a0c388-9bf7-3f62-b6a2-745a8db73238",
                                "text": "Он всегда́ найдётся (что отве́тить). : Il est prompt à la riposte."
                            }
                        ]
                    }
