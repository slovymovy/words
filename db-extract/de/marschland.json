                "senses": [
                    {
                        "sense_id": "33580fcb-c7f8-301c-98ac-4bc20929cf9a",
                        "entry_id": "15db2c59-c0fb-3a5f-ae2d-e76c26c3622b",
                        "glosses": [
                            "angeschwemmtes, fruchtbares Land an der Küste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2ba6e1-314e-479f-9f9e-1b0bcb009278",
                                "sense_id": "33580fcb-c7f8-301c-98ac-4bc20929cf9a",
                                "text": "Seine Familie lebt im Marschland von Schleswig-Holstein."
                            },
                            {
                                "example_id": "8ace90bb-8bae-43e7-bd6f-97cf5cbc2568",
                                "sense_id": "33580fcb-c7f8-301c-98ac-4bc20929cf9a",
                                "text": "„Wer auf die Outer Banks vor der Ostküste der Vereinigten Staaten fährt, findet kilometerlange Strände, haushohe Dünen und unberührtes Marschland.“"
                            },
                            {
                                "example_id": "44712223-eeeb-4716-95fb-d0d6d8ddf433",
                                "sense_id": "33580fcb-c7f8-301c-98ac-4bc20929cf9a",
                                "text": "„Marschländer, in denen sich das Wasser ausbreiten und versickern konnte, wurden zubetoniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
