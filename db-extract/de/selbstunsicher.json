                ],
                "senses": [
                    {
                        "sense_id": "3861c479-e6b9-3ced-8af1-a96cffafc4e8",
                        "entry_id": "4138c38e-4170-36ec-bd5b-8b9ebdd3fe93",
                        "glosses": [
                            "sich in seinem eigenen Auftreten, seinen Handlungen nicht sicher seiend; keine Selbstsicherheit besitzend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "312255db-4336-46c3-96cc-40e42bd68ba6",
                                "sense_id": "3861c479-e6b9-3ced-8af1-a96cffafc4e8",
                                "text": "„In vielen Bereichen ihres Lebens sind sie eher inkompetent, selbstunsicher, fühlen sich unwohl.“"
                            },
                            {
                                "example_id": "9467435a-1cd5-462c-b2e8-15232e9aee7d",
                                "sense_id": "3861c479-e6b9-3ced-8af1-a96cffafc4e8",
                                "text": "„Da ging sie zum Arzt, und der diagnostizierte: Depressionen, Angstzustände und eine selbstunsichere Persönlichkeit.“"
                            },
                            {
                                "example_id": "850b6469-931b-4b23-a239-c06695d70462",
                                "sense_id": "3861c479-e6b9-3ced-8af1-a96cffafc4e8",
                                "text": "„Lammel sagte im Prozess vor dem Landgericht Potsdam, der 33-jährige Angeklagte habe zwar eine Persönlichkeitsstörung mit selbstunsicheren, ängstlich-vermeidenden Verhaltensmustern, das beeinträchtige aber die Schuldfähigkeit nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
