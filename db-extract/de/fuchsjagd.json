                        "source_entry_id": "1be0bbf6-2440-30d0-ab38-391e51d03ee3",
                        "source_sense_id": "7df3514b-a00e-318e-9bf1-ac0265e8c63f",
                        "source_sense_description": "Jagd auf Füchse",
                        "target_lang_word": "vossenjacht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vossenjacht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "81f0d98d-d1e1-31d5-a87e-46a5ca249c17",
                                        "entry_id": "ada8f002-8f58-3b8c-9ed2-00cc6a8be57e",
                                        "glosses": [
                                            "jacht op vossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743bd23e-4151-4ec0-acfb-eebd801594e0",
                                                "sense_id": "81f0d98d-d1e1-31d5-a87e-46a5ca249c17",
                                                "text": "De vossenjacht in Engeland en Wales, een adellijke traditie, blijft verboden. Premier Theresa May had in de aanloop naar de verkiezingen vorig jaar beloofd dat het parlement over een intrekking van het verbod zou stemmen, maar dat gaat niet door. May leed bij de stembusgang een pijnlijke nederlaag. „Een duidelijke boodschap”, aldus May zondag tegen de BBC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "830cf921-347b-33e3-b1a6-535e32a08a27",
                                        "entry_id": "ada8f002-8f58-3b8c-9ed2-00cc6a8be57e",
                                        "glosses": [
                                            "speurtocht naar vermomde personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66431de9-c808-4dbd-bb6f-160bfbd9b042",
                                                "sense_id": "830cf921-347b-33e3-b1a6-535e32a08a27",
                                                "text": "Zo legden de kinderen een parcours af op een luchtkussenbaan, wierpen ze speren van foam en en deden ze mee aan een vossenjacht. Twee leerkrachten van de school hadden het initiatief genomen voor de speciale sportdag. De plek lag voor de hand, veel van de kinderen kennen Het Oogziekenhuis aangezien ze er als patiënt komen."
                                            },
                                            {
                                                "example_id": "110c117e-2416-4c03-8e1b-b766de74931c",
                                                "sense_id": "830cf921-347b-33e3-b1a6-535e32a08a27",
                                                "text": "De aanwas is des te opmerkelijker, omdat sportclubs vorige week nog een terugloop van het aantal leden meldden. Onder meer hedendaagse spelletjes vormen een geducht wapen in de strijd om de jeugd enthousiast te maken voor de padvinderij. Zo worden onder meer digitale vossenjachten en gps-races met smartphones gehouden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
