                            },
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "радостное, оживлённое настроение"
                            },
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "чувство удовольствия и удовлетворения"
                            },
                            {
                                "target_lang_word": "злорадство",
                                "target_lang_sense_clarification": "радость по поводу чужой беды или неудачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342797d2-83a8-3e85-972a-0d80c671391d",
                    "sense_definition": "An unaccompanied part song for three or more solo voices, popular especially in the 18th and 19th centuries.",
