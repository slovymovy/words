                    {
                        "translation_id": "a57d8b15-19d6-4d9a-838f-d0f164cbd20a",
                        "source_entry_id": "bacd5455-f653-3989-91f3-7f633db45370",
                        "source_sense_id": "01cbf673-b677-32ed-8b30-f66150f0fce5",
                        "target_lang_word": "ontologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                        "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                                        "glosses": [
                                            "Qui a rapport à l’ontologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7aa9b9-410a-4bc8-b117-b9adc7546886",
                                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                                "text": "La preuve ontologique de l’existence de Dieu, c’est la preuve tirée de l’idée de l’être infini, l’existence étant contenue dans l’idée que l’on a de la perfection."
                                            },
                                            {
                                                "example_id": "4c261843-440f-4920-b778-27d86e8aba57",
                                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                                "text": "Pour s’évader de la mentalité scolastique, il fallait répudier le réalisme des universaux […] ; qui conduisait à des théories erronées, telles que la fixité des espèces et la distinction ontologique des caractères essentiels et accidentels ; […]."
                                            },
                                            {
                                                "example_id": "5144eea2-2b8e-4488-8335-4dad26466bf5",
                                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                                "text": "Je fis sur « la preuve ontologique chez Descartes » une dissertation que Mademoiselle Lambert jugea médiocre."
                                            },
                                            {
                                                "example_id": "d25e764a-8492-440c-b247-4457b5fece11",
                                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                                "text": "Mais l’histoire n’est jamais la simple réalisation ontologique d’une telle potentialité, c’est une transformation permanente des réalités antérieures en fonction des conditions du moment […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e47f854-57e8-3db8-beeb-14754056a7bb",
                                        "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                                        "glosses": [
                                            "Qui concerne ce qui est constitutif de l’être, le fait même d’exister."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5c7249-fda2-4212-91d2-1bb74a0c70ab",
                                                "sense_id": "4e47f854-57e8-3db8-beeb-14754056a7bb",
                                                "text": "Le moignon ontologique insulte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "069118bb-9725-42a7-9ee2-9647cdde3ea0",
                        "source_entry_id": "bacd5455-f653-3989-91f3-7f633db45370",
                        "source_sense_id": "01cbf673-b677-32ed-8b30-f66150f0fce5",
                        "target_lang_word": "ontologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
