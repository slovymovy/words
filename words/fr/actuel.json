    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46ea7ab7-ec75-3b1e-9433-4206f14102e0",
                    "sense_definition": "Qui appartient à l'époque présente, qui existe ou a cours en ce moment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La situation <w>actuelle</w> du pays exige des décisions économiques rapides."
                        },
                        {
                            "text": "Dans notre société <w>actuelle</w>, l'accès à Internet est devenu indispensable pour tous."
                        }
                    ],
                    "synonyms": [
                        "contemporain",
                        "présent"
                    ],
                    "antonyms": [
                        "ancien",
                        "futur",
                        "passé"
                    ],
                    "common_phrases": [
                        "à l'heure actuelle",
                        "situation actuelle"
                    ]
                },
                {
                    "sense_id": "b74e48ac-7e7b-3400-be5b-8447092b4274",
                    "sense_definition": "Qui existe réellement, concrètement et en acte, par opposition à ce qui n'est que virtuel ou potentiel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe distingue la puissance de l'état purement <w>actuel</w> de la matière."
                        },
                        {
                            "text": "Une volonté <w>actuelle</w> se différencie nettement d'une simple disposition virtuelle."
                        }
                    ],
                    "synonyms": [
                        "effectif",
                        "réel"
                    ],
                    "antonyms": [
                        "potentiel",
                        "virtuel"
                    ],
                    "common_phrases": [
                        "volonté actuelle",
                        "valeur actuelle"
                    ]
                },
                {
                    "sense_id": "1c9a98ed-9e22-30ce-81d6-e76339a5d354",
                    "sense_definition": "Qui se manifeste concrètement par des actes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il préférait une foi <w>actuelle</w> exprimée par des actes concrets plutôt que de vaines paroles."
                        },
                        {
                            "text": "Le prédicateur réclamait une charité <w>actuelle</w>, faite d'actes et non de simples intentions."
                        }
                    ],
                    "synonyms": [
                        "actif"
                    ]
                }
            ]
        }
    ]
