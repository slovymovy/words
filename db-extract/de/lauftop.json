                ],
                "senses": [
                    {
                        "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                        "entry_id": "e0d8e8f0-2950-3cc1-976f-108bfe44517d",
                        "glosses": [
                            "ärmelloses, leichtes Oberteil, das speziell für das Laufen bestimmt ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "ca68914f-c47e-4869-8d7f-67d8c121490a",
                                "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                                "text": "„Das kurze Lauftop Moana besteht aus dem regeniertem Polyamid ECONYL®, dass größtenteils aus herumtreibenden Fischernetzen gewonnen wird.“"
                            },
                            {
                                "example_id": "1863216d-7afa-442a-b365-0d825b502cf2",
                                "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                                "text": "„Dieses Lauftop verfügt über stärker belüftete Zonen unter den Achseln, oberhalb der Brust, am Rücken und an den Seiten für eine verbesserte Feuchtigkeitsableitung und schnelleres Trocknen.“"
                            },
                            {
                                "example_id": "4a2fdc83-e9eb-4325-9148-604d98656cb6",
                                "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                                "text": "„Wenn die Temperatur in die Höhe schnellt, ist dieses innovative Lauftop für Frauen aus hochwertigem Mischgewebe bestehend aus hautfreundlichen Leinen und schnelltrockenendem PES der optimale Begleiter.“"
                            },
                            {
                                "example_id": "1f2443cc-4ba7-41e8-a961-d73ed6eee7ed",
                                "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                                "text": "„Bei dem Lauftop bin ich etwas skeptisch, was den Schnitt angeht – es ist hinten kürzer als vorne – gefällt mir persönlich nicht so gut, da es den Po sehr betont.“"
                            },
                            {
                                "example_id": "79982d94-64d1-4682-ab6f-42349336da25",
                                "sense_id": "2ae84e28-cd10-3913-a7be-a04e89913522",
                                "text": "„Hohen Tragekomfort bietet auch ein sogenanntes Bra-Top-Modell, ein Lauftop mit integriertem BH.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
