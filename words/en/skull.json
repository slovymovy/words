{
    "word_family": [
        "skullcap",
        "skull-like",
        "skullery",
        "skull-duggery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b60129a-d49d-3e9a-87dd-5a7c4a684eb5",
                    "sense_definition": "The bony structure that forms the head and encloses the brain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaeologist carefully brushed the dirt away from the ancient human <w>skull</w>.",
                            "target_lang_translations": {
                                "ru": "Археолог осторожно смахнул грязь с древнего человеческого <w>черепа</w>.",
                                "zh": "考古学家小心地刷去那具古代人类<w>头骨</w>上的泥土。"
                            }
                        },
                        {
                            "text": "A thick <w>skull</w> protects the brain from injuries during a fall.",
                            "target_lang_translations": {
                                "ru": "Толстый <w>череп</w> защищает мозг от травм при падении.",
                                "zh": "厚实的<w>颅骨</w>能在跌倒时保护大脑免受伤害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cranium"
                    ],
                    "common_phrases": [
                        "human skull",
                        "thick skull",
                        "fractured skull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Костная структура, образующая голову и защищающая мозг.",
                        "zh": "构成头部并包围、保护大脑的骨性结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "череп",
                                "target_lang_sense_clarification": "анатомическая структура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头骨",
                                "target_lang_sense_clarification": "解剖学；头部的骨性结构"
                            },
                            {
                                "target_lang_word": "颅骨",
                                "target_lang_sense_clarification": "较书面；包围和保护大脑的骨骼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "333a60ef-d794-3297-a690-424f553ea907",
                    "sense_definition": "The mind or the seat of thought and intelligence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot get that catchy song out of my <w>skull</w> no matter how hard I try.",
                            "target_lang_translations": {
                                "ru": "Я не могу выкинуть эту привязчивую песню из <w>головы</w>, как ни стараюсь.",
                                "zh": "不管我怎么努力，都没法把那首洗脑的歌从我的<w>脑子</w>里赶出去。"
                            }
                        },
                        {
                            "text": "He has some very strange ideas floating around inside his <w>skull</w>.",
                            "target_lang_translations": {
                                "ru": "У него в <w>голове</w> крутятся какие-то очень странные идеи.",
                                "zh": "他<w>脑子</w>里转着一些非常奇怪的想法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brainbox"
                    ],
                    "common_phrases": [
                        "inside my skull",
                        "get it through your skull"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used when referring to thoughts or stubbornness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разум или вместилище мыслей и интеллекта.",
                        "zh": "指人的头脑，即思维和智力所在之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голова",
                                "target_lang_sense_clarification": "в значении ума или памяти"
                            },
                            {
                                "target_lang_word": "черепушка",
                                "target_lang_sense_clarification": "разговорное обозначение головы"
                            },
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "грубо-разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脑子",
                                "target_lang_sense_clarification": "口语；指人的思维、记忆或脑中所想"
                            },
                            {
                                "target_lang_word": "头脑",
                                "target_lang_sense_clarification": "较泛；借指头脑、心智"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f7f40b-2e00-3484-8531-df2ddd1e4e5c",
                    "sense_definition": "A representation of the head bones used as a symbol for death or danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "symbolism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate flag featured a white <w>skull</w> and crossbones on a black background.",
                            "target_lang_translations": {
                                "ru": "На пиратском флаге был изображен белый <w>череп</w> и скрещенные кости на черном фоне.",
                                "zh": "那面海盗旗以黑色为底，上面有一个白色的<w>骷髅</w>和交叉骨头。"
                            }
                        },
                        {
                            "text": "The poison bottle was clearly marked with a <w>skull</w> to warn people.",
                            "target_lang_translations": {
                                "ru": "Бутылка с ядом была четко помечена <w>черепом</w>, чтобы предупредить людей.",
                                "zh": "那个毒药瓶上清楚地标着一个<w>骷髅</w>图案，用来警示人们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skull and crossbones"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение костей головы, используемое как символ смерти или опасности.",
                        "zh": "作为死亡或危险象征使用的头骨图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "череп",
                                "target_lang_sense_clarification": "символ или рисунок"
                            },
                            {
                                "target_lang_word": "мёртвая голова",
                                "target_lang_sense_clarification": "эмблема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骷髅",
                                "target_lang_sense_clarification": "作为死亡或危险标志的图案或符号"
                            },
                            {
                                "target_lang_word": "骷髅标志",
                                "target_lang_sense_clarification": "固定搭配；表示危险警示标志"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f243f54-e467-3c3b-9cea-4c5d6c3d2f4f",
                    "sense_definition": "The head or master of a college.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic_titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senior members of the university were often referred to as the <w>skulls</w> of the institution.",
                            "target_lang_translations": {
                                "ru": "Старейших членов университета часто называли <w>главами</w> учебного заведения.",
                                "zh": "大学里的资深成员常被称为这所学校的<w>主管者</w>。"
                            }
                        },
                        {
                            "text": "He took his seat among the <w>skulls</w> during the formal graduation ceremony.",
                            "target_lang_translations": {
                                "ru": "Он занял свое место среди <w>руководителей</w> во время официальной церемонии выпуска.",
                                "zh": "在正式的毕业典礼上，他在一群<w>校方主管</w>中入座。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specifically used in some older university contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глава или руководитель колледжа (в старых университетах).",
                        "zh": "古旧用法，指学院或大学的负责人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глава",
                                "target_lang_sense_clarification": "руководитель учебного заведения"
                            },
                            {
                                "target_lang_word": "ректор",
                                "target_lang_sense_clarification": "в академическом контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主管者",
                                "target_lang_sense_clarification": "古旧用法；学院或大学的负责人"
                            },
                            {
                                "target_lang_word": "校方主管",
                                "target_lang_sense_clarification": "古旧学术语境；校方高层人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb8ec03-4db7-3765-8726-4a1ab0ab5c10",
                    "sense_definition": "The crown or top part of a headpiece in a suit of armor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's helmet had a reinforced <w>skull</w> to deflect heavy blows from above.",
                            "target_lang_translations": {
                                "ru": "Шлем рыцаря имел усиленную <w>тулью</w>, чтобы отражать тяжелые удары сверху.",
                                "zh": "那顶骑士头盔的<w>盔顶</w>经过加固，以挡开从上方袭来的重击。"
                            }
                        },
                        {
                            "text": "The metal <w>skull</w> of the headpiece was polished until it shone like a mirror.",
                            "target_lang_translations": {
                                "ru": "Металлический <w>свод</w> шлема был отполирован до зеркального блеска.",
                                "zh": "这件头部护具的金属<w>盔顶</w>被擦得像镜子一样发亮。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть шлема в доспехах.",
                        "zh": "盔甲头盔上部或顶部的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тулья",
                                "target_lang_sense_clarification": "верхняя часть шлема"
                            },
                            {
                                "target_lang_word": "череп",
                                "target_lang_sense_clarification": "свод шлема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盔顶",
                                "target_lang_sense_clarification": "盔甲或头盔最上方的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0743e8f-99fe-3d6d-b1bd-6230ff2f782d",
                    "sense_definition": "A crust of partially cooled molten metal formed on a ladle or container.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metallurgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to remove the <w>skull</w> from the ladle before the next pour.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось удалить <w>настыль</w> из ковша перед следующей заливкой.",
                                "zh": "工人在下一次浇注前，必须先把钢包里的<w>凝壳</w>清除掉。"
                            }
                        },
                        {
                            "text": "A thick <w>skull</w> of iron had solidified against the cold walls of the vessel.",
                            "target_lang_translations": {
                                "ru": "Толстая железная <w>корка</w> застыла на холодных стенках сосуда.",
                                "zh": "一层厚厚的铁<w>凝壳</w>已经在容器冰冷的内壁上凝固了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in metallurgy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корка частично остывшего расплавленного металла в ковше или контейнере.",
                        "zh": "冶金术语，指在钢包或容器中由部分冷却的熔融金属形成的硬壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настыль",
                                "target_lang_sense_clarification": "слой застывшего металла"
                            },
                            {
                                "target_lang_word": "козел",
                                "target_lang_sense_clarification": "металлургический сленг для застывшего остатка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凝壳",
                                "target_lang_sense_clarification": "冶金；钢包或容器中部分冷却后形成的金属硬壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c0ff191-c005-33fd-bce7-7290568b5675",
                    "sense_definition": "An <w>obsolete</w> form of <w>school</w>, referring to a large group or multitude, especially of fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors observed a massive <w>skull</w> of herring moving just beneath the surface.",
                            "target_lang_translations": {
                                "ru": "Моряки наблюдали за огромным <w>косяком</w> сельди, идущим прямо под поверхностью.",
                                "zh": "水手们看到一大<w>群</w>鲱鱼就在水面下方游动。"
                            }
                        },
                        {
                            "text": "In the old texts, a <w>skull</w> of fish was said to follow the warm currents.",
                            "target_lang_translations": {
                                "ru": "В старых текстах говорилось, что <w>стая</w> рыб следует за теплыми течениями.",
                                "zh": "古文献里说，一<w>群</w>鱼会追随暖流而行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "now spelled as school"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова school, означающая косяк или стаю рыб.",
                        "zh": "school 的古旧写法，指一大群，尤指鱼群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косяк",
                                "target_lang_sense_clarification": "группа рыб"
                            },
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "множество морских обитателей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群",
                                "target_lang_sense_clarification": "古旧用法；尤指鱼群"
                            },
                            {
                                "target_lang_word": "鱼群",
                                "target_lang_sense_clarification": "用于鱼类时更具体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fd06704-1caf-3d91-88f8-41ce307302de",
                    "sense_definition": "To drink the entire contents of a glass or bottle in one go by tilting it back.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>skull</w> his drink in seconds before heading back to the dance floor.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>осушить залпом</w> свой напиток за считанные секунды, прежде чем вернуться на танцпол.",
                                "zh": "回到舞池前，他几秒钟就把饮料<w>一口闷了</w>。"
                            }
                        },
                        {
                            "text": "The crowd cheered as he started to <w>skull</w> a pint of beer.",
                            "target_lang_translations": {
                                "ru": "Толпа ликовала, когда он начал <w>пить залпом</w> пинту пива.",
                                "zh": "他开始把一品脱啤酒<w>一口闷</w>时，人群欢呼了起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skull a drink",
                        "skull a pint"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпить все содержимое стакана или бутылки залпом.",
                        "zh": "一下子仰头喝完整杯或整瓶饮料；一饮而尽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осушить залпом",
                                "target_lang_sense_clarification": "выпить до дна"
                            },
                            {
                                "target_lang_word": "хлопнуть",
                                "target_lang_sense_clarification": "быстро выпить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一口闷",
                                "target_lang_sense_clarification": "口语；把一整杯或一整瓶饮料一下子喝光"
                            },
                            {
                                "target_lang_word": "一口喝干",
                                "target_lang_sense_clarification": "口语；迅速一饮而尽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35b6c3c5-ad3c-3734-ad5e-f9b4c653e995",
                    "sense_definition": "To hit someone on the head with a fist or an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>skull</w> the guard with a heavy wooden club.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>ударить по голове</w> охранника тяжелой деревянной дубинкой.",
                                "zh": "小偷试图用沉重的木棍<w>猛击……的头部</w>守卫。"
                            }
                        },
                        {
                            "text": "He was arrested after he attempted to <w>skull</w> his opponent during the brawl.",
                            "target_lang_translations": {
                                "ru": "Его арестовали после того, как он попытался <w>огреть</w> противника во время драки.",
                                "zh": "他在混战中试图<w>猛击……的头部</w>对手，随后被逮捕了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for physical striking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-то по голове кулаком или предметом.",
                        "zh": "用拳头或物体击打某人的头部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дать по башке",
                                "target_lang_sense_clarification": "ударить по голове"
                            },
                            {
                                "target_lang_word": "огреть",
                                "target_lang_sense_clarification": "сильно ударить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛击……的头部",
                                "target_lang_sense_clarification": "口语；朝别人的头上重重打一下"
                            },
                            {
                                "target_lang_word": "打……的头",
                                "target_lang_sense_clarification": "较短促口语；打对方脑袋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e605ed-df01-3f6c-97c8-2657be3df550",
                    "sense_definition": "To hit the top half of a ball, especially in golf, causing it to fly low and too far.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to chip the ball onto the green but I <w>skulled</w> it into the bunker.",
                            "target_lang_translations": {
                                "ru": "Я пытался подбить мяч на грин, но <w>срезал</w> его прямо в бункер.",
                                "zh": "我本想把球挑上果岭，结果却<w>削中了球的上半部</w>，把它打进了沙坑。"
                            }
                        },
                        {
                            "text": "If you <w>skull</w> the ball, it will likely roll much further than you intended.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>ударите по верху</w> мяча, он, скорее всего, укатится гораздо дальше, чем планировалось.",
                                "zh": "如果你<w>削中了球的上半部</w>，球很可能会滚得比你预想的远得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skull the ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specific to golf and similar sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить по верхней части мяча (в гольфе), из-за чего он летит низко и слишком далеко.",
