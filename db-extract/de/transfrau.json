                "senses": [
                    {
                        "sense_id": "1e7b8540-9bf1-33f5-8154-443309bfd4a1",
                        "entry_id": "57b94041-81e5-39f3-aae1-0792e28775f5",
                        "glosses": [
                            "Person, die sich nicht mit dem bei der Geburt aufgrund äußerlicher Merkmale festgestellten männlichen Geschlecht identifiziert und eine weibliche Geschlechtsidentität hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c4b15fa-a3d6-4ef7-9cbb-40d84b9802da",
                                "sense_id": "1e7b8540-9bf1-33f5-8154-443309bfd4a1",
                                "text": "„Sie ist die einzige Transfrau unter den Top 10-Kandidatinnen und eine von 15.000 Frauen, die sich beworben haben, wie Jil Andert von Miss Germany Studios sagt - einem Oldenburger Unternehmen, das die Show organisiert.“"
                            },
                            {
                                "example_id": "fcb030a5-e9f3-4aca-b7a1-3f8732abdd72",
                                "sense_id": "1e7b8540-9bf1-33f5-8154-443309bfd4a1",
                                "text": "„Mit einem ‚antiquierten Familienbild‘, wie es jetzt polemisch heißt, hat es nichts zu tun, wenn eine Transfrau nicht als Mutter des mit ihrem Samen gezeugten Kindes und ein Transmann nicht als Vater seines von ihm geborenen Kindes anerkannt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5806663-9278-4c89-8e3e-64f986df06b4",
                        "source_entry_id": "57b94041-81e5-39f3-aae1-0792e28775f5",
                        "source_sense_id": "1e7b8540-9bf1-33f5-8154-443309bfd4a1",
                        "source_sense_description": "Person, die sich nicht mit dem bei der Geburt festgestellten männlichen Geschlecht identifiziert und eine weibliche Geschlechtsidentität hat",
                        "target_lang_word": "transwoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transwoman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                        "entry_id": "ef800451-649f-336f-86b8-0066374e696b",
                                        "glosses": [
                                            "Alternative spelling of trans woman."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "derogatory",
                                            "offensive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a21b205-56d8-4d80-8919-7ca454adfab9",
                                                "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                                "text": "She had been attracted to Sharon from the time they met, but had not felt comfortable with the idea of dating a transwoman."
                                            },
                                            {
                                                "example_id": "50ce1488-ed55-4b55-86ad-53a51dfadeb1",
                                                "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                                "text": "A transwoman is thus required to fashion her own body as a blank in order to gain a document that is not itself a blank; the document will not speak her sex until her body fails to."
                                            },
                                            {
                                                "example_id": "d7e4a344-e844-47de-a203-1270d83489f4",
                                                "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                                "text": "Not only do people harass and attack transwomen for being who they are: transwomen also face scrutiny from both ciswomen and cismen over “what” they are."
                                            },
                                            {
                                                "example_id": "016b4636-32fe-4827-966f-6e87167d636c",
                                                "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                                "text": "Conversely, if you are a lesbian-identified transwoman who was legally married to a woman prior to transition, some people may claim your union is now illegal because it is presently a same-sex marriage."
                                            },
                                            {
                                                "example_id": "4e685e7f-76ad-4896-aea6-f7159a9db284",
                                                "sense_id": "50ee4cf2-fce3-3d85-aeda-55f343968257",
                                                "text": "“There’s going to be a lot of people for whom this is going to mean nothing, but for the few it does impact, it means the world,” said Facebook software engineer Brielle Harrison, who worked on the project and is herself undergoing gender transformation, from male to female. On Thursday, while watchdogging the software for any problems, she said she was also changing her Facebook identity from Female to TransWoman.\n“All too often transgender people like myself and other gender nonconforming people are given this binary option, do you want to be male or female? What is your gender? And it’s kind of disheartening because none of those let us tell others who we really are,” she said. “This really changes that, and for the first time I get to go to the site and specify to all the people I know what my gender is.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
