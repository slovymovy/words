                ],
                "senses": [
                    {
                        "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                        "entry_id": "0fae5791-9730-38a0-9166-0c17275bde36",
                        "glosses": [
                            "The act of holding or participating in a banquet."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "045a89ea-bb47-4aa1-b608-a9b19badf37f",
                                "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                                "text": "Come, come, Therſites help to trim my tent?\nThis night in banquetting muſt al be ſpent, away Patroclus."
                            },
                            {
                                "example_id": "c504fcef-fe26-45b4-9dff-ede2a9da5534",
                                "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                                "text": "Foꝛ the time paſt of our life may ſuffice vs to haue wꝛought the will of the Gentiles, when we walked in laſciuiouſnes, luſts, exceſſe of wine, reuellings, banquetings, and abhominable idolatries."
                            },
                            {
                                "example_id": "02025004-8f58-4e20-9138-81cf125b738b",
                                "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                                "text": "Tis not to sit In place of worship at the royal masques, Their pastimes, plays, and Whitehall banquetings, For none of these, Nor yet to be seen whispering with some great one, Do I affect the favours of the court."
                            },
                            {
                                "example_id": "4663d255-6540-4f94-b805-8e3be52121ce",
                                "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                                "text": "It is no proof of generosity (say the objectors) to take the bread of the laborer, to lavish it in banquetings on the rich."
                            },
                            {
                                "example_id": "c82458eb-5857-464a-a9d4-e8dd63889d4e",
                                "sense_id": "af81eab8-0e4b-37e9-96b4-376e88fb4e23",
                                "text": "Huludao’s Xingcheng county and two districts have ordered entertainment venues such as theatres and cinemas to close, while restaurants are not to offer banqueting services or cater for large gatherings."
                            }
                        ]
                    }
                ],
