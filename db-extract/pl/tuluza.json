                    {
                        "translation_id": "bed9d61a-0de0-4223-b0ea-9fadce41988c",
                        "source_entry_id": "ed44c3c9-19bb-3e08-be4c-7439642b770e",
                        "source_sense_id": "2562250d-59b3-3f45-a32d-7b34eba6da0f",
                        "target_lang_word": "Toulouse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Toulouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b6abaa-1cf4-3baa-ae7a-7f82ecf65885",
                                        "entry_id": "e5b424b9-fb5b-3970-a7a7-9ba4c79f02be",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, située dans le département de la Haute-Garonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14390eb1-d81f-4f74-b754-78de0d8c8021",
                                                "sense_id": "f9b6abaa-1cf4-3baa-ae7a-7f82ecf65885",
                                                "text": "Gasparini fut arrêté le 19 juillet, par les soins de M. Duroux, directeur des Messageries à Toulouse."
                                            },
                                            {
                                                "example_id": "bd7abfcd-8a7f-4ea8-969e-82615f197ecb",
                                                "sense_id": "f9b6abaa-1cf4-3baa-ae7a-7f82ecf65885",
                                                "text": "En débarquant à Toulouse, je me trouvais devant la gare assez hésitant. Une canette au buffet et me voici quand même déambulant à travers les rues."
                                            },
                                            {
                                                "example_id": "5cdcc3d4-cf19-4866-88f8-9b366c90e179",
                                                "sense_id": "f9b6abaa-1cf4-3baa-ae7a-7f82ecf65885",
                                                "text": "Le relâchement du lien vassalitique est une des causes de la défaite finale du Midi et de son suzerain, le comte de Toulouse."
                                            },
                                            {
                                                "example_id": "98aebbd0-fdd0-45e4-bf2c-9901aa7b9058",
                                                "sense_id": "f9b6abaa-1cf4-3baa-ae7a-7f82ecf65885",
                                                "text": "Près de Toulouse, le Genêt scorpion a disparu mais il y a encore le Ciste à feuilles de Sauge qui imprime un cachet méditerranéen à côté du Genêt à balai plutôt atlantique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
