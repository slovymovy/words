                        "examples": [
                            {
                                "example_id": "6b61050a-d39a-43b6-9b55-ee44b3d57f66",
                                "sense_id": "b8a96509-a049-3832-a004-536cea732db0",
                                "text": "„Drei Stunden später stand er in einem weiten Bogen von Hufspuren, die ein von Süden kommender Reitertrupp hinterlassen hatte.“"
                            },
                            {
                                "example_id": "90f13e4f-7bb8-4e9a-a1d3-271ecb7ab47a",
                                "sense_id": "b8a96509-a049-3832-a004-536cea732db0",
                                "text": "„Hugh Glass starrte nach unten auf die gespaltenen Hufspuren, die sich klar und deutlich in der weichen Erde abzeichneten.“"
                            }
                        ],
