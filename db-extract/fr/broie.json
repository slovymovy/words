                        "entry_id": "5c21cffb-e127-3ff2-a1d4-08788ad562fa",
                        "glosses": [
                            "Instrument propre à briser la tige du chanvre et du lin pour détacher la filasse de la chènevotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d434ed51-5e1f-4c4d-9294-dc60d3d977c5",
                                "sense_id": "22715c17-ec43-36c8-ae77-8f95db460e79",
                                "text": "On commence par passer les tiges dans un outil très simple, appelé broie, espèce de couteau de bois mobile autour d'un point placé à l'une de ses extrémités et à l'aide duquel on les broye."
                            }
                        ]
