            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "108a500e-b6f3-37b4-8b8c-547486ab2bc2",
                    "sense_definition": "Feeling fear or being afraid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frightened</w> child hid behind his mother when the dog barked.",
                            "target_lang_translations": {
                                "ru": "<w>Испуганный</w> ребенок спрятался за мать, когда залаяла собака.",
                                "tr": "Köpek havladığında <w>korkmuş</w> çocuk annesinin arkasına saklandı.",
                                "nl": "Het <w>bange</w> kind verstopte zich achter zijn moeder toen de hond blafte.",
                                "pl": "<w>Przestraszone</w> dziecko schowało się za matką, gdy pies zaszczekał.",
                                "de": "Das <w>verängstigte</w> Kind versteckte sich hinter seiner Mutter, als der Hund bellte.",
                                "fr": "L'enfant <w>effrayé</w> s'est caché derrière sa mère quand le chien a aboyé.",
                                "it": "Il bambino <w>spaurito</w> si è nascosto dietro la madre quando il cane ha abbaiato.",
                                "cs": "<w>Vystrašené</w> dítě se schovalo za matku, když pes zaštěkal.",
                                "es": "El niño <w>asustado</w> se escondió detrás de su madre cuando el perro ladró.",
                                "zh": "狗叫时，那个<w>受惊</w>的孩子躲到了妈妈身后。"
                            }
                        },
                        {
                            "text": "She looked very much <w>frightened</w> of the storm outside.",
                            "target_lang_translations": {
                                "ru": "Она выглядела очень <w>напуганной</w> бурей за окном.",
                                "tr": "Dışarıdaki fırtınadan çok <w>korkmuş</w> görünüyordu.",
                                "nl": "Ze zag er erg <w>angstig</w> uit door de storm buiten.",
                                "pl": "Wyglądała na bardzo <w>przestraszoną</w> burzą na zewnątrz.",
                                "de": "Sie sah sehr <w>erschrocken</w> wegen des Sturms draußen aus.",
                                "fr": "Elle semblait très <w>effrayée</w> par l'orage dehors.",
                                "it": "Sembrava molto <w>spaventata</w> dal temporale fuori.",
                                "cs": "Vypadala, že je z té bouřky venku velmi <w>vyděšená</w>.",
                                "es": "Ella se veía muy <w>atemorizada</w> por la tormenta de afuera.",
                                "zh": "她看起来非常<w>害怕</w>外面的暴风雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid",
                        "scared",
                        "fearful",
                        "terrified"
                    ],
                    "antonyms": [
                        "brave",
                        "unafraid",
                        "fearless",
                        "confident"
                    ],
                    "common_phrases": [
                        "frightened of",
                        "frightened to death",
                        "look frightened",
                        "frightened by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий страх или боящийся чего-либо.",
                        "tr": "Korku hisseden veya korkmuş olan.",
                        "nl": "Gevoelens van angst ervaren of bang zijn.",
                        "pl": "Odczuwający strach lub lęk przed czymś.",
                        "de": "Sich ängstlich fühlen oder Angst haben.",
                        "fr": "Qui ressent de la peur ou de l'effroi.",
                        "it": "Che prova paura o timore.",
                        "cs": "Stav, kdy někdo pociťuje strach nebo má z něčeho obavy.",
                        "es": "Que siente miedo o está asustado.",
                        "zh": "感到恐惧或害怕。"
                    },
