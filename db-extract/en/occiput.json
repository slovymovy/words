                                        "sense_id": "2c9cc00a-2559-3e44-a2e1-ef01d3752914",
                                        "entry_id": "7c2ec7fc-4d8f-318a-bc39-6352f5ebac03",
                                        "glosses": [
                                            "Os postérieur et inférieur de la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8feccbf-8621-4dd1-8f76-76c38a6c2c2c",
                                                "sense_id": "2c9cc00a-2559-3e44-a2e1-ef01d3752914",
                                                "text": "La presqu’île de Portland, vue en plan géométral, offre l’aspect d’une tête d’oiseau dont le bec est tourné vers l’océan et l’occiput vers Weymouth ; l’isthme est le cou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c012b514-487e-34d1-b308-a7349c97546e",
                                        "entry_id": "7c2ec7fc-4d8f-318a-bc39-6352f5ebac03",
