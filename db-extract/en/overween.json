                "senses": [
                    {
                        "sense_id": "3c59a306-ad7a-3548-a318-1d265599827c",
                        "entry_id": "207ef429-e0c9-3e93-9da1-4f7faee9ea9a",
                        "glosses": [
                            "To think too highly or arrogantly of (oneself)."
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "8208a960-74da-40ec-941c-bd2324c80bd1",
                                "sense_id": "3c59a306-ad7a-3548-a318-1d265599827c",
                                "text": "and they that overween, / And at thy growing virtues fret their spleen,"
                            },
                            {
                                "example_id": "ed26ba59-a457-432c-a7c4-10449b517fdd",
                                "sense_id": "3c59a306-ad7a-3548-a318-1d265599827c",
                                "text": "The clouds on Futurity Day bore out in a general way this prognostication. But he overweened himself."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f494001-3841-3677-bd4a-fb549eb7d402",
                        "entry_id": "207ef429-e0c9-3e93-9da1-4f7faee9ea9a",
                        "glosses": [
                            "To make or render arrogant and overweening."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6046f11a-9b87-4a2d-9e05-fede40eedfee",
                                "sense_id": "7f494001-3841-3677-bd4a-fb549eb7d402",
                                "text": "There is, I suppose, the cheap drama of man sticking his nose into an area where it does little good except to expand his already overweened vanity."
                            },
                            {
                                "example_id": "9f01118c-5495-4b6d-ada9-f00852557247",
                                "sense_id": "7f494001-3841-3677-bd4a-fb549eb7d402",
                                "text": "Sometimes we manage to come up with original ways of viewing a world hardened, stratified, overweened by its own power, a world which believes itself as omnipotent as its technological achievements might seem to imply."
                            }
                        ]
                    },
                    {
                        "sense_id": "45cbea33-de90-33ee-a7a9-658d59173cfb",
                        "entry_id": "207ef429-e0c9-3e93-9da1-4f7faee9ea9a",
                        "glosses": [
                            "To overwhelm."
                        ],
                        "tags": [
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "a2224e7e-d4f7-48fc-a54d-edbc75a473ae",
                                "sense_id": "45cbea33-de90-33ee-a7a9-658d59173cfb",
                                "text": "The invasion of a vast enemy host upon the unprepared is unstoppable; the huge phalanx of tanks overweens our small army of trucks and rifles; […]"
                            }
                        ]
                    }
