                ],
                "senses": [
                    {
                        "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                        "entry_id": "81a55aac-0ef2-3f01-a0f9-3c1423bf8769",
                        "glosses": [
                            "großer Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dcf85af-dae4-421a-ba81-9966aae1c721",
                                "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                                "text": "„Im Tal floss der Dnjepr-Strom und umgab Smolensk wie ein Burggraben.“"
                            },
                            {
                                "example_id": "2c25c4e3-4d26-4f38-b397-04ed80559993",
                                "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                                "text": "„Obwohl das Land am Dnjepr-Strom noch immer zwischen West und Ost gespalten ist, haben die Ukrainer im Gegensatz zu ihren Nachbarn blutige Konflikte im Inneren verhindern können.“"
                            },
                            {
                                "example_id": "0a009ec4-e3eb-4c62-a248-3ccac52f3232",
                                "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                                "text": "„Der hessische Reisende wiederum schwärmt von der Vier-Millionen-Metropole am Dnjepr-Strom.“"
                            },
                            {
                                "example_id": "a93af611-4ce4-41bf-8ef1-4bd41b59aa76",
                                "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                                "text": "„Denn warum sollen denn immer den glatten Strom eueres (und unsers) Lebens entweder Schmerzen oder Sünden brechen, und warum soll er erst wie der Dnjepr-Strom nach dreizehn Wasserfällen im schwarzen Meer der Gruft einsinken?“"
                            },
                            {
                                "example_id": "ff6c6ed2-931e-49be-b210-6423cffddc56",
                                "sense_id": "56e0c86f-4abf-3fd5-ac1d-2794a62fa89f",
                                "text": "„Was sie taten, war verboten. Sie radelten am gewaltigen Dnjepr-Strom entlang, grüßten freundlich auf Russisch Milizionäre und Soldaten, bei Pannen wurde ihnen geholfen, überhaupt gab es viel Gastfreundschaft, und in Odessa hatten sie ein unverschämtes Glück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
