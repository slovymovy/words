                "senses": [
                    {
                        "sense_id": "0be5f333-9860-3f1d-ab56-eecd92123898",
                        "entry_id": "ce51859f-cf79-3ce7-9a31-acd4f922dcae",
                        "glosses": [
                            "Gebühr, die für die Teilnahme an einem Kolleg zu entrichten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00514dfb-3183-4ca7-b495-abf7250b75e0",
                                "sense_id": "0be5f333-9860-3f1d-ab56-eecd92123898",
                                "text": "„Und da Albert Einstein zwar die Relativitätstheorie entdeckt hat, nicht aber die Theorie, wie man offenkundiger Unaufmerksamkeit begegnet, so beschloß er, während der Zeit, in der Lustreisen unternommen werden, nicht zu lesen und den Hörern die Kolleggebühr zurückzuerstatten.“"
                            },
                            {
                                "example_id": "5ebd93ed-01e3-4370-87a8-1c4fbd273e12",
                                "sense_id": "0be5f333-9860-3f1d-ab56-eecd92123898",
                                "text": "„Mit Eingang der Kolleggebühr auf unten genanntem Konto ist Ihre Teilnahme dann garantiert.“"
                            },
                            {
                                "example_id": "3b905619-0cc7-456c-8304-608bd2d419fb",
                                "sense_id": "0be5f333-9860-3f1d-ab56-eecd92123898",
                                "text": "„Die Kolleggebühr beträgt 940,00 DM (bei 6 – 8 Teilnehmern) bzw. 840,00 DM (bei 9 – 15 Teilnehmern).“"
                            },
                            {
                                "example_id": "2b93a8d5-d87a-4601-80b5-30d2457df362",
                                "sense_id": "0be5f333-9860-3f1d-ab56-eecd92123898",
                                "text": "„Die Kanzlei und die Fakultätsverwaltung achteten auf eine geordnete Dokumentation des Studienverlaufs, sammelten Kolleggebühren ein und bescheinigten Prüfungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
