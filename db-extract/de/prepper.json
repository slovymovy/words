                        ],
                        "examples": [
                            {
                                "example_id": "7a5a3340-ead3-4a13-b316-1d3c60d9f82f",
                                "sense_id": "924a92a0-659d-39c6-959a-ad07db468dfd",
                                "text": "Wo sind die Prepper? Wo sind die Eier?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
