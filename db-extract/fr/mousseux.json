            {
                "entry_id": "a47fdee9-7349-30ec-92a3-98f5002ab07c",
                "word": "mousseux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                        "entry_id": "a47fdee9-7349-30ec-92a3-98f5002ab07c",
                        "glosses": [
                            "Vin pétillant."
                        ],
                        "tags": [],
                        "note": "ne s’emploie pas en parlant du champagne",
                        "examples": [
                            {
                                "example_id": "f68be465-d239-43f1-b8a6-fc9b87a86b83",
                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                "text": "Mouin, j’avais préparé un ripage de concombres, un colombo, un gratin de christophines ; j’avais acheté du rosé et du mousseux…"
                            },
                            {
                                "example_id": "1ee90e93-2f44-49b2-96dc-ec31e3130a13",
                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                "text": "Dans les mousseux à prise de mousse naturelle, comme l’Asti du Piémont, le jus de raisin est enflaconné avant la fin de sa fermentation et c’est la transformation du sucre résiduel qui crée la pression."
                            },
                            {
                                "example_id": "5d8c5042-19ce-4124-93c7-f8977ce8b21e",
                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                "text": "Les Parisiens ne prennent jamais les bateaux-mouches et peu d’entre eux sont montés un jour sur la tour Eiffel. Ou alors il y vont, obligés, quand ils reçoivent la visite de Léo, le cousin de province, pourvoyeur en mousseux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e01bc618-69ab-42c8-9e5b-886fc1e7125c",
                        "source_entry_id": "a47fdee9-7349-30ec-92a3-98f5002ab07c",
                        "source_sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                        "target_lang_word": "Schaumwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaumwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed9027d2-1666-339f-a36d-63632ede7cd5",
                                        "entry_id": "b3c85269-f549-3235-8df3-bc25dcd050f8",
                                        "glosses": [
                                            "Oberbegriff für alle schäumenden und perlenden Weine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ff8b98-ad6a-406e-92fa-02a55636dc52",
                                                "sense_id": "ed9027d2-1666-339f-a36d-63632ede7cd5",
                                                "text": "„Nur der in der Champagne hergestellte Schaumwein darf Champagner heißen.“"
                                            },
                                            {
                                                "example_id": "e4a64f53-d3be-4bb3-a372-d661806a5966",
                                                "sense_id": "ed9027d2-1666-339f-a36d-63632ede7cd5",
                                                "text": "„Als ich verstand, dass man aus den eigentlich dunklen Trauben, wenn man sie nur früh genug erntete, einen weißen Schaumwein herstellen konnte, fühlte ich mich fast ein bisschen betrogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
