                        "examples": [
                            {
                                "example_id": "48aa4673-d5bf-4bb7-90a3-5017230f5921",
                                "sense_id": "11b34cf9-c72f-3595-8999-ca15ff9cd3b4",
                                "text": "Woods lichaam werd drijvend op het water gevonden. De actrice droeg een donsjas en nachtkleding. Haar dood werd aanvankelijk afgedaan als een ongeval. ‘Verdronken toen ze uitgleed op het familiejacht en overboord sloeg’, zo luidde het politierapport."
                            },
                            {
                                "example_id": "eec426a6-14a3-4f5d-b2a8-424377268cb0",
                                "sense_id": "11b34cf9-c72f-3595-8999-ca15ff9cd3b4",
                                "text": "Over mijn donsjas had ik mijn regenjas aangetrokken en ik lag met een regenbroek plus legging in mijn slaapzak te bibberen van de kou."
                            }
                        ]
                    }
