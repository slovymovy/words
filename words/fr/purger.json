                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé réussit à lui <w>purger</w> la main pour lui montrer qu'il restait conscient."
                        },
                        {
                            "text": "Elle lui demanda de lui <w>purger</w> le bras pour arrêter momentanément la circulation."
                        }
                    ],
                    "synonyms": [
                        "presser",
                        "serrer"
                    ],
                    "common_phrases": [
