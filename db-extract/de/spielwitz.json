                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32552e64-df50-4811-92ba-585a6d44aff0",
                                "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                                "text": "„Kentin ist ein schneller Spieler mit viel Spielintelligenz und auch Spielwitz.“"
                            },
                            {
                                "example_id": "690a6820-eae8-4a4d-8637-b55712a976fc",
                                "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                                "text": "„Seine Antwort auf körperliche Unterlegenheit seien Technik, Spielwitz und Spielverständnis gewesen, sagt er.“"
                            },
                            {
                                "example_id": "df2beafd-d657-4e44-b3aa-faa36895cdc1",
                                "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                                "text": "„Wenn zwei junge Brüder aus England mit mathematischem Spielwitz jede Liedstruktur schreddern, klingt Punkrock fast intellektuell.“"
                            },
                            {
                                "example_id": "1bd4ad37-88fb-4c85-a61c-f070794d80aa",
                                "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                                "text": "„Zauberhafte Treffer, imposantes Tempo, sehenswerter Spielwitz - der runderneuerte Dortmunder Kader kommt nach holprigem Saisonstart immer besser in Fahrt.“"
                            },
                            {
                                "example_id": "df5e4028-89dc-449d-b9a7-ef79568583d1",
                                "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                                "text": "„Wir haben viel Spielwitz gezeigt, waren konzentriert bis zum Ende, bilanzierte Neid zufrieden, auch wenn nach insgesamt sechs Wechseln im zweiten Abschnitt nur noch zwei Tore gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
