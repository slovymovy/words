                        "source_sense_id": "f46f3d14-27af-3538-a767-912a1ca6ac78",
                        "source_sense_description": "mit Lichtsignalen ausgestattete Anlage, die zur Regelung des Verkehrs dient",
                        "target_lang_word": "traffic light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traffic light",
