                                "target_senses": [
                                    {
                                        "sense_id": "fc7795e6-6b34-3745-a671-331e54264975",
                                        "entry_id": "de92dc07-a33c-3ee6-8bce-5d21c2443f10",
                                        "glosses": [
                                            "Action, fait de déifier, de considérer comme un dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459bbd15-96e5-45db-ac51-7a6c8e29e598",
                                                "sense_id": "fc7795e6-6b34-3745-a671-331e54264975",
                                                "text": "L’apothéose était une cérémonie qui plaçait des hommes au rang des dieux ; la déification est l’acte d’une imagination superstitieuse qui voit la divinité dans un être où elle n’est pas."
                                            },
                                            {
                                                "example_id": "b3567671-bd72-414c-9195-36d9660193f8",
                                                "sense_id": "fc7795e6-6b34-3745-a671-331e54264975",
                                                "text": "La grâce divinisante incréée du Christ, qui rendra aussi le corps humain conforme à celui de Sa gloire, est semée en l’homme dès sa vie présente et produit sa déification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
