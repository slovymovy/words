                        "sense_id": "20c72dc0-3026-351b-b64a-f5d5aa2d3a18",
                        "entry_id": "0ff1a30f-8c10-3cc6-b06f-a22928a9853b",
                        "glosses": [
                            "Temple ou tombe rupestre de l’ancienne Égypte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "574bc1bd-02f0-4ecd-ac4b-8577746aad71",
                                "sense_id": "20c72dc0-3026-351b-b64a-f5d5aa2d3a18",
                                "text": "Le spéos est une imitation des hypogées, chambres funéraires souterraines creusées dans la pierre."
                            },
                            {
                                "example_id": "0aaf89ff-2d7f-4da2-9f3c-f776495621e9",
                                "sense_id": "20c72dc0-3026-351b-b64a-f5d5aa2d3a18",
                                "text": "Parmi les plus beaux exemples de spéos de l’Égypte antique, ceux d’Abou Simbel et celui de la déesse Pachet à Béni-Hassan."
                            },
                            {
                                "example_id": "1de0509b-3f1b-45ab-be38-8fe6a5042ebe",
                                "sense_id": "20c72dc0-3026-351b-b64a-f5d5aa2d3a18",
                                "text": "Dans cette montagne, qui n’est qu’une roche, Ramsès-Sésostris a fait creuser un spéos qu’il a dédié à Phré à la tête d’épervier."
                            }
                        ]
                    }
