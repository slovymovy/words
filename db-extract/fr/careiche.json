                        "sense_id": "6d3bda82-4875-32b7-b7da-4d9d6e99a5c6",
                        "entry_id": "1c4eeb24-b124-3940-9488-f70e18419cc4",
                        "glosses": [
                            "carex, sedge"
                        ],
                        "tags": [
                            "archaic",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "853c16ba-ac69-4024-9850-e6f0093cca28",
                                "sense_id": "6d3bda82-4875-32b7-b7da-4d9d6e99a5c6",
                                "text": "Ils arrivaient avec des brins de joncs, des racines, des careiches sèches, sans parvenir à les utiliser.",
                                "translation": "They arrived with blades of rushes, roots, dry sedges, without succeeding in using them.",
                                "english": "They arrived with blades of rushes, roots, dry sedges, without succeeding in using them."
                            },
                            {
                                "example_id": "d1b024cb-a107-42ca-83eb-8560e61f9709",
                                "sense_id": "6d3bda82-4875-32b7-b7da-4d9d6e99a5c6",
                                "text": "Brillant comme le ventre d'un poisson, tout en écailles blanches, il serpenterait entre les touffes de careiche et les flaques d'eau d'où monte le coassement mélancolique des rainettes.",
                                "translation": "Shining like the belly of a fish, all white scales, it snaked through the tufts of sedge and the puddles of water from which the melancholy croaks of tree frogs rise.",
                                "english": "Shining like the belly of a fish, all white scales, it snaked through the tufts of sedge and the puddles of water from which the melancholy croaks of tree frogs rise."
                            },
                            {
                                "example_id": "c0608a1a-54ec-48ae-b397-6105b86f48b2",
                                "sense_id": "6d3bda82-4875-32b7-b7da-4d9d6e99a5c6",
                                "text": "Fais-la sortir les careiches, ton oiselle; fais-l'en sortir, au nom des dieux, que nous puissons, nous deux aussi, voir la rossignole à notre aise.",
                                "translation": "Bring out your little bird from the sedges; bring her out in the name of the gods, so that we two may also behold the nightingale at our leisure.",
                                "english": "Bring out your little bird from the sedges; bring her out in the name of the gods, so that we two may also behold the nightingale at our leisure."
                            }
                        ]
                    }
                ],
