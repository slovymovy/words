                "senses": [
                    {
                        "sense_id": "a7c84cfb-451b-36dc-819b-054d49e27611",
                        "entry_id": "2cbf5a58-6af2-3a2e-9cb7-a62dd977297d",
                        "glosses": [
                            "vertragliche Vereinbarung zwischen Staaten, mit der die Regeln für die Wirtschaftsbeziehungen festgelegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4420cb4c-0a1b-4003-9913-5fcfed3dbc20",
                                "sense_id": "a7c84cfb-451b-36dc-819b-054d49e27611",
                                "text": "„Die Wirtschaftsabkommen bewirkten, dass noch mehr taiwanesische Unternehmer ihre Fabriken nach China verlegten – und damit auch Jobs.“"
                            },
                            {
                                "example_id": "f88c0e56-6708-4c86-b82b-29718e077e11",
                                "sense_id": "a7c84cfb-451b-36dc-819b-054d49e27611",
                                "text": "„Die Erfahrung mit bereits abgeschlossenen Wirtschaftsabkommen zeigt, dass die undurchsichtigen Sonderrechte von Konzernen immer häufiger missbraucht werden, etwa um unternehmerische Risiken auf die Allgemeinheit, also die Steuerzahler, abzuwälzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
