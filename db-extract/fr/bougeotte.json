                ],
                "senses": [
                    {
                        "sense_id": "34263101-8672-339a-b1e2-0e583aa9e803",
                        "entry_id": "34dc5dc5-ec8f-3195-a49a-de0c00862592",
                        "glosses": [
                            "Manie de bouger sans cesse, ou de ne pas rester en place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57c3668-1a13-4061-bae7-b804d3fb9ad6",
                                "sense_id": "34263101-8672-339a-b1e2-0e583aa9e803",
                                "text": "Roland avait, depuis le berceau, ce que nos grands-mères appelaient le diable au corps, ce que nous appellerions nous la bougeotte névrotique, un besoin viscéral de se frotter à tous les interdits."
                            }
                        ]
                    },
                    {
                        "sense_id": "e68c6190-4b29-3ff3-9e91-2ac6dc6574fb",
                        "entry_id": "34dc5dc5-ec8f-3195-a49a-de0c00862592",
                        "glosses": [
                            "Besoin ou envie de voyager."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3b355918-e2f5-4331-8b32-c0aae92c971d",
                                "sense_id": "e68c6190-4b29-3ff3-9e91-2ac6dc6574fb",
                                "text": "On disait les Français casaniers, aujourd’hui, ils ont la bougeotte."
                            },
                            {
                                "example_id": "e3bbf817-533c-4a79-b5c5-a52f42cbbf81",
                                "sense_id": "e68c6190-4b29-3ff3-9e91-2ac6dc6574fb",
                                "text": "Ainsi commençait le plus inutile, le plus absurde périple. Banal ou pittoresque, l’horizon n’avait aux yeux d’Arthur qu’une seule vertu : celle du changement. Il ne savait pas voyager : il se déplaçait. Il obéissait, dans l’état de mouvement, à la loi d’inertie. Pas le moindre goût de la découverte, qui fait l’explorateur, ni de la flânerie, qui fait le touriste ; mais celui de la bougeotte. Une seule province d’élection : celle où il n’était pas."
                            }
                        ]
                    }
                ],
