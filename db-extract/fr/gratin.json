                                "target_senses": [
                                    {
                                        "sense_id": "c92106b7-c01d-3629-b244-9579d71aa3d9",
                                        "entry_id": "2f580d21-555d-3794-9962-60232d55256e",
                                        "glosses": [
                                            "Someone on an A-list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12e3420-e4f3-40b1-a42b-fb5a893194c1",
                                                "sense_id": "c92106b7-c01d-3629-b244-9579d71aa3d9",
                                                "text": "Seeing A-listers in the aisles makes Frieze seem sexier than most fairs, placing added pressure on galleries to live up to the sponsorship provided by high-end fashion brands and luxury goods."
                                            },
                                            {
                                                "example_id": "b1151903-78c3-414e-9de9-2a86849549f0",
                                                "sense_id": "c92106b7-c01d-3629-b244-9579d71aa3d9",
                                                "text": "[Hasan] Piker had already shown off his “cozy-ass ’fit” (sweatpants with kitschy bald eagles, a custom pair of platform Crocs), and recounted his experience the previous night at the Streamer Awards, a red-carpet event honoring A-listers on Twitch—the popular live-streaming site where he is one of the biggest stars, and the only prominent leftist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
