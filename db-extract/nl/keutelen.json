                        ]
                    },
                    {
                        "translation_id": "8e7ab607-aa0c-42c5-a73d-2336519c4e4f",
                        "source_entry_id": "c474b3ab-d75e-3d4d-b1a1-b96b0f1f9cf1",
                        "source_sense_id": "e631e367-e738-3465-be46-142b531683f6",
                        "source_sense_description": "nutteloos bezig zijn",
                        "target_lang_word": "trifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "An English dessert made from a mixture of thick custard, fruit, sponge cake, jelly and whipped cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c79891-8b81-4e10-965e-c82cfeea0232",
                                                "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                                "text": "It is interesting to watch the surface joviality on screen while racism is layered between courses like soggy trifles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c68516-c47b-4d02-89d9-6e2659ed57cf",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Trifles light as air / Are to the jealous confirmation strong / As proofs of holy writ."
                                            },
                                            {
                                                "example_id": "7a322d08-5d32-4bdf-ae4e-65156e9bb983",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Olde Chaucer doth of Topas tell, / Mad Rablais of Pantagruell, / A latter third of Dowsabell, / With such poore trifles playing:"
                                            },
                                            {
                                                "example_id": "6a71d67f-3840-4163-9984-2e1bb1705b17",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "[W]hen they had the Character and Honour of a VVoman at their Mercy, often times made it their Jest, and at least look’d upon it as a Trifle, and counted the Ruin of thoſe, they had had their VVill of, as a thing of no value."
                                            },
                                            {
                                                "example_id": "cc0830cd-ed41-4040-accd-6023fc7c1807",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "‘And all about a rattle!’ said Alice, still hoping to make them a little ashamed of fighting for such a trifle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth.",
                                            "An insignificant amount of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f54872-5640-4509-96de-a7698a1c41b3",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "A trifle, some eight-penny matter."
                                            },
                                            {
                                                "example_id": "bd603be3-d0d9-4754-b0a8-5084a51b2f27",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "He told her of horses which he had bought for a trifle and sold for incredible sums […]"
                                            },
                                            {
                                                "example_id": "8e271f1c-1a22-433f-9479-ec1c83112fde",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "What’s eighty dollars? A trifle. An insignificant sum."
                                            },
                                            {
                                                "example_id": "85951f32-6dda-42f7-aec1-972de8c23560",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "“It was bad of me then not to send the fifteen hundred dollars. I assumed it would be a trifle.” / “Well, until a few months ago it was a trifle.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A very small amount (of something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1634c6-8368-4253-8bff-c50aef9a1a95",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "This Line leaves out […] Poplar and Black-vvall, vvhich are indeed contiguous, a Trifle of Ground excepted, and very populous."
                                            },
                                            {
                                                "example_id": "204b9cd2-5780-403d-8608-6516694dd026",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "There was a good deal of rustling and whispering behind the curtain, a trifle of lamp smoke, and an occasional giggle from Amy […]"
                                            },
                                            {
                                                "example_id": "b3c1ac67-15a2-4679-8308-a8aab5d864ca",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "“Take just a trifle of French mustard […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8aabf77-061e-38c9-96be-9de1b426d461",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A particular kind of pewter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9bf760d-1973-3934-b633-aeb9b3929599",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Utensils made from this particular kind of pewter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To deal with something as if it were of little importance or worth."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e7008be-5805-4793-b780-0069e73f9a6b",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "You must not trifle with her affections."
                                            },
                                            {
                                                "example_id": "8791ad27-10bd-4bf7-8097-ea7210e03b50",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "[…] Do not believe / That, from the sense of all civility, / I thus would play and trifle with your reverence:"
                                            },
                                            {
                                                "example_id": "fada06cd-b8c1-4fdd-9ebd-8f2964ce0e54",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "“Miss Bennet,” replied her ladyship, in an angry tone, “you ought to know, that I am not to be trifled with […]”"
                                            },
                                            {
                                                "example_id": "f7b0b147-5669-4051-9659-4c97cdf7b084",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "But a Judge may not trifle with the Law because the society is defective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To act, speak, or otherwise behave with jest."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8471fd01-9f98-41a1-94d2-003a618de041",
                                                "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                                "text": "[…] playing and trifling are completely banished out of my mind […]"
                                            },
                                            {
                                                "example_id": "3d4c96c8-dd9d-4829-9fcf-3b3fe7b6869a",
                                                "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                                "text": "But he was terribly roused too and bound to go on; he wasn’t just trifling but intended something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To inconsequentially toy with something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee57bda-284c-4782-8ad5-8d59d8361834",
                                                "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                                "text": "Mr. Micawber, leaning back in his chair, trifled with his eye-glass and cast his eyes up at the ceiling […]"
                                            },
                                            {
                                                "example_id": "5d8aad01-a139-47d3-bf1d-e67d7d455fd2",
                                                "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                                "text": "She sat in a café, trifling with her coffee spoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To squander or waste."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a205f2-a3f4-4db6-9306-04bef681bec4",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "We trifle time: I pray thee, pursue sentence."
                                            },
                                            {
                                                "example_id": "508faf7c-ac0d-427f-a250-99903adbfb41",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "For an honest and sober man will rather make that woman his wife, whom he seeth employed continually about her business, than one who makes it her business to trifle away her own and others time."
                                            },
                                            {
                                                "example_id": "119ada1f-f336-4d5a-95fe-e3b2aca3c3e2",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "As it was, he did nothing with much zeal, but sport; and his time was otherwise trifled away, without benefit from books or anything else."
                                            },
                                            {
                                                "example_id": "cab4c630-7bf7-4cfa-9e81-d438230ba4d3",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "You who have known neither sorrow nor pleasure; who have trifled your life away!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae1394c-58d1-397f-a3ee-cf64ed4caeee",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To make a trifle of, to make trivial."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860c4768-bd5f-4df7-a1f8-59d369a329ef",
                                                "sense_id": "7ae1394c-58d1-397f-a3ee-cf64ed4caeee",
                                                "text": "[…] but this sore night / Hath trifled former knowings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
