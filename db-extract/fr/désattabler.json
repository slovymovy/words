                "senses": [
                    {
                        "sense_id": "f4171888-e735-3790-9f00-bdd196b61053",
                        "entry_id": "b3728a76-4569-303d-afbf-28277490fc54",
                        "glosses": [
                            "Quitter la table où on était attablé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c69d8d2-e9d9-42e4-a12c-3bd5c5b8b833",
                                "sense_id": "f4171888-e735-3790-9f00-bdd196b61053",
                                "text": "C’est à la taverne de Raoulet qu’Ysengrin revint en rescons, s’attablant comme s’il ne s’était point désattablé de la soirée ; et c’est là que vint le chercher Houdée, de la part de Bernard : (…)"
                            },
                            {
                                "example_id": "c85ea966-6d8d-4fa7-a006-5ae39ac92caa",
                                "sense_id": "f4171888-e735-3790-9f00-bdd196b61053",
                                "text": "Les 3 flics attablés se désattablèrent en quatrième vitesse et sortirent à la queue leu-leu façon petit train du plaisir."
                            }
                        ]
                    }
