            {
                "entry_id": "4449a5b5-404c-335e-aaa5-365f08c50f2b",
                "word": "machiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3a3e14d1-cd8c-465e-9991-6912fd8f5995",
                        "entry_id": "4449a5b5-404c-335e-aaa5-365f08c50f2b",
                        "tags": [
                            "plural",
