                                    {
                                        "sense_id": "20e01ac2-9711-36a5-9d3f-5899e52281fb",
                                        "entry_id": "8bd1a6ae-44b7-39f4-8ae3-3fb5b516c0c1",
                                        "glosses": [
                                            "A stiff, slender organ of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338b39d7-7b23-41e9-bcf7-5a67ad624a13",
                                                "sense_id": "20e01ac2-9711-36a5-9d3f-5899e52281fb",
                                                "text": "Even octopuses without stylets almost certainly retain the molecular machinery necessary to build them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65dbf607-b10b-4d85-9461-f44c49831677",
                        "source_entry_id": "d3027e43-1080-31db-8a63-989d6849005f",
                        "source_sense_id": "cd9e89ee-e402-3023-ad94-525df9ccce53",
                        "target_lang_word": "Stilett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stilett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "995d11e8-4c3a-38cf-8395-2bb80d95a74f",
                                        "entry_id": "5465972c-c2fb-3c49-a395-c7fccfe76c06",
                                        "glosses": [
                                            "kleiner Dolch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec727dea-fc31-474f-aa86-e383a0264160",
                                                "sense_id": "995d11e8-4c3a-38cf-8395-2bb80d95a74f",
                                                "text": "„Aber es waren keine Goldstücke, die er herausholte - sondern eine Stahlklinge, ein langes scharfes Stilett, das er im Nu in seinem Ärmel verschwinden ließ.“"
                                            },
                                            {
                                                "example_id": "44751d3c-00d0-4774-b056-edb9500854bb",
                                                "sense_id": "995d11e8-4c3a-38cf-8395-2bb80d95a74f",
                                                "text": "„In diesem Augenblick griff sie in ihre Tasche, dachte ein wenig nach, zog ein Stilett von zehn Zoll Länge heraus und legte es auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
