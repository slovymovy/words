                    "frequency": "High",
                    "semantic_group_id": "anstreben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unsere Firma <w>verfolgt</w> das klare Ziel, den Energieverbrauch langfristig zu senken."
                        },
                        {
                            "text": "Sie <w>verfolgte</w> ihren beruflichen Plan trotz vieler Schwierigkeiten mit großem Fleiß."
                        }
                    ],
                    "synonyms": [
                        "anstreben",
                        "weiterverfolgen"
                    ],
                    "antonyms": [
