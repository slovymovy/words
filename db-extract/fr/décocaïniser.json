                ],
                "senses": [
                    {
                        "sense_id": "09a05ac7-a826-3fd8-af00-b45245af2481",
                        "entry_id": "c6c8aa04-22cc-32c8-ba7b-f2686eeed32e",
                        "glosses": [
                            "Débarrasser de la cocaïne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d66893-03cd-4cfa-94cc-445a6799fba5",
                                "sense_id": "09a05ac7-a826-3fd8-af00-b45245af2481",
                                "text": "Aujourd'hui, la multinationale Coca-Cola utilise encore les feuilles de coca, mais après les avoir décocaïnisées, la cocaïne extraite servant à l’industrie pharmaceutique."
                            },
                            {
                                "example_id": "090c3e52-4e24-4207-bc9b-e1e5b1d30152",
                                "sense_id": "09a05ac7-a826-3fd8-af00-b45245af2481",
                                "text": "Après avoir essayé de modifier la recette en augmentant sa teneur en caféine pour conserver son effet tonique, il opta finalement en faveur de l'utilisation de feuilles de coca… préalablement décocaïnisées."
                            },
                            {
                                "example_id": "4b7e1eb4-f959-4ccb-b6d4-2158b097eaed",
                                "sense_id": "09a05ac7-a826-3fd8-af00-b45245af2481",
                                "text": "En 1903, le fabricant de la boisson favorite des Américains est sommé de “décocaïniser” ses feuilles de coca avant de les utiliser."
                            }
                        ]
                    }
                ],
