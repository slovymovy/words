                        "sense_id": "b11a1848-b22d-3b51-bda1-053e54d51e31",
                        "entry_id": "01146ea4-b4b8-3ea6-8857-7bf27a2a2eff",
                        "glosses": [
                            "to be foggy"
                        ],
                        "tags": [
                            "impersonal",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "5ba8a251-020c-4601-a65d-b3b8735160fe",
                                "sense_id": "b11a1848-b22d-3b51-bda1-053e54d51e31",
                                "text": "Ik keek door 't raam en peinsde: — Wel, 't regent niet meer, het nevelt. En ik stak mijn hoofd in den buitenschen nacht, en: — Wel, riep ik, het nevelt niet, het sneeuwt! Het sneeuwt!",
                                "translation": "I looked through the window and thought: — Well, it's not raining any more, it's foggy. And I stuck my head out into the night outside, and: — Well, I cried, it's not foggy, it's snowing! It's snowing!",
                                "english": "I looked through the window and thought: — Well, it's not raining any more, it's foggy. And I stuck my head out into the night outside, and: — Well, I cried, it's not foggy, it's snowing! It's snowing!"
                            }
                        ]
                    }
