                ],
                "senses": [
                    {
                        "sense_id": "3da57f9f-cdae-3a19-bf2c-a6930be4018a",
                        "entry_id": "c0e1596e-eb1e-3102-ba35-cd223882224b",
                        "glosses": [
                            "исполненный пафоса, патетики, страстно-взволнованный"
                        ],
                        "tags": [],
