                "senses": [
                    {
                        "sense_id": "70e72c1f-6af5-31b0-ac8f-2546850597d6",
                        "entry_id": "b0ab8bda-d8dc-3191-9009-c6c305a8c92b",
                        "glosses": [
                            "met het gevoel dat men zaken verkeerd heeft gedaan, dat men niet had moeten doen wat men gedaan heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346588b8-c19a-4aab-8466-2dce961c3579",
                                "sense_id": "70e72c1f-6af5-31b0-ac8f-2546850597d6",
                                "text": "Invloed in de wereld is echter een kapitaal waarmee je zuinig moet omgaan om het te behouden. Vorst Vasili wist dit en toen hij eenmaal had begrepen dat als hij voor iedereen die hem daarom verzocht gunsten zou vragen, hij weldra niets meer voor zichzelf zou kunnen vragen, wendde hij zijn invloed zelden aan. In het geval van vorstin Droebetskoj voelde hij echter na haar nieuwe smeekbede iets van gewetenswroeging."
                            },
                            {
                                "example_id": "40a1ae0a-21e9-4582-a85d-74e62b7137d9",
                                "sense_id": "70e72c1f-6af5-31b0-ac8f-2546850597d6",
                                "text": "De mensen die het geweld van dichtbij meemaakten, zullen dat nooit vergeten. Door verdriet, of door gewetenswroeging. We weten ook dat leden van de ETA na hun arrestatie werden gemarteld door de politie.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a3e5b57-1d62-42fe-a423-5dc3257741aa",
                        "source_entry_id": "b0ab8bda-d8dc-3191-9009-c6c305a8c92b",
                        "source_sense_id": "70e72c1f-6af5-31b0-ac8f-2546850597d6",
                        "source_sense_description": "met het gevoel dat men zaken verkeerd heeft gedaan, dat men niet had moeten doen wat men gedaan heeft",
                        "target_lang_word": "qualms of conscience",
