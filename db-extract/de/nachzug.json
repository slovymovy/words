                "senses": [
                    {
                        "sense_id": "30d1c5aa-aac7-3bcd-9278-ae8524b5a8f9",
                        "entry_id": "ccf7c60d-165c-3d15-b9d4-eda3a8eee4cb",
                        "glosses": [
                            "legale Einwanderung von Angehörigen eines im Lande lebenden Ausländers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8310fa37-2134-4b09-9fdb-4b66cf03d062",
                                "sense_id": "30d1c5aa-aac7-3bcd-9278-ae8524b5a8f9",
                                "text": "„Die Opposition drängt daher die Bundesregierung, allen anerkannten Flüchtlingen den sofortigen Nachzug von Ehepartnern und Kindern wieder zu erlauben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e47296ec-2a8d-3bff-8066-ea596f7662a2",
                        "entry_id": "ccf7c60d-165c-3d15-b9d4-eda3a8eee4cb",
                        "glosses": [
                            "Schienenfahrzeug, das wegen großen Fahrgastaufkommens zusätzlich zum normalen Fahrplan verkehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d55e04d4-46cb-468f-a95b-10f315c33574",
                                "sense_id": "e47296ec-2a8d-3bff-8066-ea596f7662a2",
                                "text": "„Meist verkehren Entlastungszüge als Vor- oder Nachzug kurz vor oder kurz nach den planmäßigen Zügen und haben die gleiche Zuggattung und eine ähnliche Zugnummer wie diese.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "67b7a948-3d92-37e1-ae2d-3c88bd78b680",
                        "entry_id": "ccf7c60d-165c-3d15-b9d4-eda3a8eee4cb",
                        "glosses": [
                            "Schienenfahrzeug, das im Sichtabstand ohne eigene Signalfreigabe folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2d486a-558e-43de-bec5-a492c13fc556",
                                "sense_id": "67b7a948-3d92-37e1-ae2d-3c88bd78b680",
                                "text": "„An den Ausweichen müssen die entgegenkommenden Fahrten warten, bis alle Nachzüge gekreuzt haben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
