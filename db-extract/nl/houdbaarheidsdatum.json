                                    {
                                        "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                        "entry_id": "036fc773-9599-35ad-853b-86e54bf49584",
                                        "glosses": [
                                            "The date on which something runs out or expires and becomes out of date, in many cases requiring renewal."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ababd-5383-41fe-8c32-93eea868ee01",
                                                "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                                "text": "The expiry date of my debit card is the 30th of April."
                                            },
                                            {
                                                "example_id": "5a17bd1d-0937-4975-a069-2bc630eaa5d4",
                                                "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                                "text": "You'd better throw that milk out: it's passed the expiry date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "433cc0a0-eca8-4a81-a026-f274ced863af",
                        "source_entry_id": "5026805d-5292-3a03-a303-4a012ab9225f",
                        "source_sense_id": "344b2658-0027-3ec0-9d31-99adb9ebf789",
                        "target_lang_word": "expiration date",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expiration date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                        "entry_id": "0f847cc1-e10f-3a21-850b-40ae1574df78",
                                        "glosses": [
                                            "A date by which an object either should not be used or loses its value, depending upon the item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f860aef9-ae3a-4300-a8c1-00f9215583c2",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "credit card expiration date"
                                            },
                                            {
                                                "example_id": "acc2c936-d854-4826-a336-9bab1a2ad2c4",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "Well, in the mercy of God we are normally unaware of our personal expiration date."
                                            },
                                            {
                                                "example_id": "4f3a670a-1f70-4e5c-8267-2f8ca63aacf7",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "You have an expiration date, and despite your wanting to claim control over life circumstances, you're not entitled to know when your expiration date will be."
                                            },
                                            {
                                                "example_id": "40b0b0d0-f554-4ce0-82f9-390a69c78665",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "If my expiration date is set, then it doesn't matter if I smoke or eat a gallon of ice cream a day; however, the quality of my life between now and that point will be improved considerably by eating well and taking good care of myself."
                                            },
                                            {
                                                "example_id": "adc2c976-a3cd-41c4-b139-493e1a2afa21",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "It is modern medicine's best guess, a 50/50 shot, a coin flip of a lifespan. I would not want to know my expiration date or median survival."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9470b84d-b6d7-4231-9678-4b91bd86bd5b",
                        "source_entry_id": "5026805d-5292-3a03-a303-4a012ab9225f",
                        "source_sense_id": "344b2658-0027-3ec0-9d31-99adb9ebf789",
                        "target_lang_word": "date de péremption",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "date de péremption",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c767ba81-fea9-3e1c-9138-4188a9b44f73",
                                        "entry_id": "3d973730-f115-3628-806b-0f048880e00e",
                                        "glosses": [
                                            "Date à partir de laquelle un produit perd ses qualités et ne doit plus être utilisé ou consommé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c11d82-dba3-4505-a3eb-cd9d8ecf7e22",
                                                "sense_id": "c767ba81-fea9-3e1c-9138-4188a9b44f73",
                                                "text": "Pour lutter contre le gaspillage, voici les aliments que vous pouvez encore consommer même après leur date de péremption."
                                            },
                                            {
                                                "example_id": "598a1c6f-48bd-45f2-8306-ca6f0b3aefe2",
                                                "sense_id": "c767ba81-fea9-3e1c-9138-4188a9b44f73",
                                                "text": "La défense de la liberté d’expression n’a pas de date de péremption et ne connaît pas de limites géographiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31c7fa0-2fd7-328c-b1b0-398cb3f1e387",
                                        "entry_id": "3d973730-f115-3628-806b-0f048880e00e",
                                        "glosses": [
                                            "Âge à partir duquel une personne est jugée moins apte pour son travail, son rôle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e42c0e-7b5c-45d7-a459-871989c90c7b",
                                                "sense_id": "a31c7fa0-2fd7-328c-b1b0-398cb3f1e387",
                                                "text": "Là où la majorité des actrices américaines, au cinéma uniquement, voient leur salaire décroître aux alentours de 34 ans, la date de péremption semble plus souple en France, mais le plafond de verre se trouve à 50 ans."
                                            },
                                            {
                                                "example_id": "f30b044c-d769-444f-b556-fbb90b585f57",
                                                "sense_id": "a31c7fa0-2fd7-328c-b1b0-398cb3f1e387",
                                                "text": "Alors ça n'en finira jamais, pensait Sabine, nous serons toujours soumises aux hommes d'une façon ou d'une autre, nous serons toujours cette marchandise espérant qu'on l'achète, les noces ou la misère, ce troc auquel aujourd'hui encore on se prête, désirant le mariage et le plus tôt possible avant notre date de péremption, et d'ailleurs quelle est-elle ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
