                ],
                "senses": [
                    {
                        "sense_id": "c75cd050-9d76-30a5-b61c-83c1901b84b1",
                        "entry_id": "f8830001-143c-359d-ae76-e28f6a583e5f",
                        "glosses": [
                            "Lehrerin oder Wissenschaftlerin im Fach Anglistik; weibliche Person, die sich mit der englischen Sprache, der englischsprachigen Literatur und der Kultur des englischen Sprachraumes beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df6eedb-880b-46b7-b008-e7f2461ac1a9",
                                "sense_id": "c75cd050-9d76-30a5-b61c-83c1901b84b1",
                                "text": "„In ihrer Studie Crossmappings versammelt die einflussreiche Züricher Anglistin Elisabeth Bronfen diverse Untersuchungen zur visuellen Kultur, die sie in den letzten Jahrzehnten verfasst hat.“"
                            },
                            {
                                "example_id": "bc1cb329-a131-4cd5-a1b3-32734f735ed5",
                                "sense_id": "c75cd050-9d76-30a5-b61c-83c1901b84b1",
                                "text": "„Anglisten und Anglistinnen bzw. Amerikanisten und Amerikanistinnen können in unterschiedlichen Bereichen tätig sein. Beispielsweise lesen, prüfen und bearbeiten sie im Verlagswesen Manuskripte, entwickeln neue Medienprodukte und betreuen Autoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
