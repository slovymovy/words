{
    "word_family": [
        "heat",
        "heater",
        "heated",
        "overheat",
        "preheat",
        "reheat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e532188-b7c2-3800-bbde-ab1e002e4b76",
                    "sense_definition": "A system or equipment used to raise the temperature of a room or building.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are hoping to have the new <w>heating</w> installed before the winter starts.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся установить новое <w>отопление</w> до начала зимы."
                            }
                        },
                        {
                            "text": "The central <w>heating</w> system is broken, so the house is very cold today.",
                            "target_lang_translations": {
                                "ru": "Система центрального <w>отопления</w> сломана, поэтому сегодня в доме очень холодно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "central heating",
                        "electric heating",
                        "gas heating",
                        "underfloor heating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система или оборудование, используемое для повышения температуры в помещении или здании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отопление",
                                "target_lang_sense_clarification": "система обогрева здания"
                            },
                            {
                                "target_lang_word": "обогрев",
                                "target_lang_sense_clarification": "процесс или система поддержания тепла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40d76c43-0037-3a42-b589-23a38b1bba2b",
                    "sense_definition": "The process or act of making something hot or increasing its temperature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thermal process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crucible was subjected to several <w>heatings</w> to ensure the metal melted completely.",
                            "target_lang_translations": {
                                "ru": "Тигель подвергался нескольким <w>нагревам</w>, чтобы металл полностью расплавился."
                            }
                        },
                        {
                            "text": "The rapid <w>heating</w> of the liquid caused the glass container to crack.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>нагревание</w> жидкости привело к тому, что стеклянная емкость треснула."
                            }
                        }
                    ],
                    "synonyms": [
                        "warming"
                    ],
                    "antonyms": [
                        "cooling"
                    ],
                    "common_phrases": [
                        "rapid heating",
                        "uniform heating",
                        "induction heating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие по нагреванию чего-либо или повышению его температуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагрев",
                                "target_lang_sense_clarification": "процесс повышения температуры"
                            },
                            {
                                "target_lang_word": "нагревание",
                                "target_lang_sense_clarification": "действие по приведению в горячее состояние"
                            },
                            {
                                "target_lang_word": "прогрев",
                                "target_lang_sense_clarification": "равномерное нагревание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "008a20f7-73c8-3d26-86c5-ee7c9a555b1f",
                    "sense_definition": "The present participle and gerund of <w>heat</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>heating</w> some soup on the stove for her lunch.",
                            "target_lang_translations": {
                                "ru": "Она <w>разогревает</w> суп на плите себе на обед."
                            }
                        },
                        {
                            "text": "The sun is <w>heating</w> the pavement until it is too hot to touch.",
                            "target_lang_translations": {
                                "ru": "Солнце так <w>нагревает</w> тротуар, что к нему невозможно прикоснуться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «греть» или «нагревать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греет",
                                "target_lang_sense_clarification": "в процессе нагревания"
                            },
                            {
                                "target_lang_word": "разогревает",
                                "target_lang_sense_clarification": "делает горячим (о еде)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03e298df-dfbe-38f7-80d4-bbe2134a95e1",
                    "sense_definition": "Having the quality of causing or producing heat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "thermal properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain spices are known for their <w>heating</w> effect on the body during digestion.",
                            "target_lang_translations": {
                                "ru": "Некоторые специи известны своим <w>согревающим</w> эффектом на организм во время пищеварения."
                            }
                        },
                        {
                            "text": "The <w>heating</w> properties of this ointment help to soothe sore muscles.",
                            "target_lang_translations": {
                                "ru": "<w>Разогревающие</w> свойства этой мази помогают успокоить боль в мышцах."
                            }
                        }
                    ],
                    "synonyms": [
                        "calorific",
                        "warming"
                    ],
                    "antonyms": [
                        "cooling"
                    ],
                    "common_phrases": [
                        "heating effect",
                        "heating properties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий свойством вызывать или производить тепло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согревающий",
                                "target_lang_sense_clarification": "дающий ощущение тепла"
                            },
                            {
                                "target_lang_word": "разогревающий",
                                "target_lang_sense_clarification": "стимулирующий приток тепла (о мазях, специях)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}