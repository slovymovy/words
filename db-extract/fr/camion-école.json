                        "glosses": [
                            "Véhicule mobile dédié à l’apprentissage, qui se présente comme un substitut à l’école, initialement destiné aux Tsiganes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e62f8e8e-1de9-4d71-b5c4-83f74ae08bb3",
                                "sense_id": "afee9128-6522-39ec-a439-342a6f79d72c",
                                "text": "Désigné sous le nom d'Antenne scolaire mobile (Asm), le camion-école a été créé en 1982 par une association d’Aide à la scolarisation des enfants tsiganes (Aset) afin de répondre à une demande d’instruction de plus en plus importante de la part de familles itinérantes dont les enfants ne fréquentaient pas l’école sédentaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b9b99e8-2159-3948-847d-1579680b7733",
                        "entry_id": "c0a536d7-abea-3913-9b4a-1bf9eb62ec3a",
                        "glosses": [
                            "Véhicule dédié à l’apprentissage d’une compétence quelconque."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ed422438-9c18-4f46-ac48-004c84593b92",
                                "sense_id": "4b9b99e8-2159-3948-847d-1579680b7733",
                                "text": "Un camion-école de natation se déplace de ville en ville pour permettre à tous d’apprendre à nager."
                            }
                        ]
                    }
