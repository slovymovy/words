                        "entry_id": "c87b0f6e-7a70-3574-a771-900dc504d950",
                        "glosses": [
                            "Zustand der Körperstarre bei wachem Bewusstsein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe546d95-5260-4da4-b711-077ce77931bd",
                                "sense_id": "5a8aaa61-16cc-3da0-8401-a772eb183774",
                                "text": "Der Stupor kann durch psychische Erkrankungen ausgelöst werden."
                            },
                            {
                                "example_id": "caf308cb-ba5c-44c3-a3cf-c3d395b88df0",
                                "sense_id": "5a8aaa61-16cc-3da0-8401-a772eb183774",
                                "text": "„Eine Frau kam wegen Stupor und Mutismus, aufgetreten im Wochenbett, zur stationären Behandlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "663d063d-2377-45ed-a56f-bfc89ea014d8",
                        "source_entry_id": "c87b0f6e-7a70-3574-a771-900dc504d950",
                        "source_sense_id": "5a8aaa61-16cc-3da0-8401-a772eb183774",
                        "source_sense_description": "Medizin, Psychologie: Zustand der Körperstarre bei wachem Bewusstsein",
                        "target_lang_word": "stupor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                        "entry_id": "90c4b78c-3a2c-3803-baef-ce985718f148",
                                        "glosses": [
                                            "A state of greatly dulled or completely suspended consciousness or sensibility; (particularly medicine) a chiefly mental condition marked by absence of spontaneous movement, greatly diminished responsiveness to stimulation, and usually impaired consciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb12bb99-a082-4761-92e0-b8d4bedb137e",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "He fell into a drunken stupor."
                                            },
                                            {
                                                "example_id": "c91d65eb-ddbf-4fc2-9c9b-2b8f4569a737",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "She woke from a deep stupor after the medication."
                                            },
                                            {
                                                "example_id": "f4801100-2d3d-4363-a2f3-9ab01bd09059",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The shock left him in a stupor of disbelief."
                                            },
                                            {
                                                "example_id": "c4a0fdbd-5388-4028-8c4a-af6f187884e6",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The heat drove the workers into a midday stupor."
                                            },
                                            {
                                                "example_id": "bb3658e9-c64f-4e3b-9419-b7b51a44785e",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "He sat in a dazed stupor on the couch."
                                            },
                                            {
                                                "example_id": "4fc4b26d-5c18-4b71-8126-a33e4ae8546b",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The team stumbled off the field in a stupor of exhaustion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd145e08-d470-3db9-bbd1-70b5c11e834d",
                                        "entry_id": "90c4b78c-3a2c-3803-baef-ce985718f148",
                                        "glosses": [
                                            "A state of extreme apathy or torpor resulting often from stress or shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
