                        ],
                        "examples": [
                            {
                                "example_id": "1acb593d-b5eb-4f1a-bd1f-12cb12f03459",
                                "sense_id": "49e2956c-9527-3c40-867f-ae2f3233fe83",
                                "text": "Он покла́л всё в ра́зные карма́ны, в пальто́ и в оста́вшийся пра́вый карма́н пантало́н, стара́ясь, чтоб бы́ло неприме́тнее.",
                                "translation": "He put them all in the different pockets of his overcoat, and the remaining pocket of his trousers, trying to conceal them as much as possible.",
                                "english": "He put them all in the different pockets of his overcoat, and the remaining pocket of his trousers, trying to conceal them as much as possible."
                            }
                        ]
                    }
