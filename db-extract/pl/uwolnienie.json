                "translations": [
                    {
                        "translation_id": "4daa2d1c-1343-41bc-ba7e-86ed7bafd3d4",
                        "source_entry_id": "7003370b-5a55-37ea-b3cc-36b3afd4f716",
                        "source_sense_id": "06b8ab9e-220f-3236-84fd-7a19075f9a05",
                        "target_lang_word": "liberation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "The act of liberating or the state of being liberated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b205b989-2675-41de-b549-c2a6ed03ca54",
                                                "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                                "text": "The liberation of American slaves was accomplished by the Department of War, that of British slaves by the Exchequer."
                                            },
                                            {
                                                "example_id": "ae8a9c9a-0082-4fec-b4a7-a23c0e935c99",
                                                "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                                "text": "People saw in the elders, who were closer to death, the manifestation of the divine force that was thought to achieve its full liberation at death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba17b8c1-7f0c-35d7-8733-9edfe2ccaabf",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "Synonym of conquest or theft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "ironic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf44f717-df6f-33c1-abd7-4a4eb69a73d3",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "The achievement of equal rights and status, particularly as seen as freedom from historic and structural oppression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841a8f72-e75b-4369-96b6-c3720433f381",
                                                "sense_id": "cf44f717-df6f-33c1-abd7-4a4eb69a73d3",
                                                "text": "women's liberation... black liberation... gay liberation..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6828451-3a34-46d5-9c85-d989f8e06cd0",
                        "source_entry_id": "7003370b-5a55-37ea-b3cc-36b3afd4f716",
                        "source_sense_id": "06b8ab9e-220f-3236-84fd-7a19075f9a05",
                        "target_lang_word": "libération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8704338-85c0-32a6-8d81-de62254626af",
                                        "entry_id": "b483bc19-3989-30da-a61b-513d49415ca2",
                                        "glosses": [
                                            "Action de libérer ou de rendre libre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38291a2-b6be-402f-98e1-2b813b7caaa3",
                                                "sense_id": "d8704338-85c0-32a6-8d81-de62254626af",
                                                "text": "Avec la libération des mœurs, certaines femmes histrioniques vont aller plus loin en utilisant le sexe pour attirer l’attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                        "entry_id": "b483bc19-3989-30da-a61b-513d49415ca2",
                                        "glosses": [
                                            "Décharge d’une dette ou d’une servitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731ff5cf-bf76-4082-b6cd-54189861adbb",
                                                "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                                "text": "Les lois sont toujours favorables à la libération du débiteur."
                                            },
                                            {
                                                "example_id": "147c6e93-bb30-4c5d-a8de-b8230b015fee",
                                                "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                                "text": "J’ai obtenu, moyennant telle somme, la libération d’une servitude fort gênante qui grevait ma propriété."
                                            },
                                            {
                                                "example_id": "d197d800-b0d9-413a-96a2-8463d4c43666",
                                                "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                                "text": "La libération de l’état, L’acquittement, l’amortissement de la dette publique."
                                            },
                                            {
                                                "example_id": "215eee1c-623b-440c-82ca-504225c612c9",
                                                "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                                "text": "La libération du territoire, La délivrance du territoire qui cesse d’être occupé par l’étranger."
                                            },
                                            {
                                                "example_id": "7dcef3e1-9488-4c2a-b34e-25c247b3b50b",
                                                "sense_id": "31544035-d2b9-3097-ae7d-c0aeb0cbe1fb",
                                                "text": "La libération d’un condamné, La mise en liberté d’un condamné après l’expiration de sa peine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b42e939-9a82-35e6-958d-669bdddee44a",
                                        "entry_id": "b483bc19-3989-30da-a61b-513d49415ca2",
                                        "glosses": [
                                            "Jour où les conscrits quittent le service militaire actif et retournent dans leurs foyers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89ee80f6-7686-3d6f-8cc7-228b6b3ae0ce",
                                        "entry_id": "b483bc19-3989-30da-a61b-513d49415ca2",
                                        "glosses": [
                                            "Suppression d’une variable, de sorte que son adressage est rendu à la mémoire libre."
                                        ],
