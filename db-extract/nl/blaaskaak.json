                "senses": [
                    {
                        "sense_id": "0b52280b-29fa-324d-8e09-9a48f9a0b269",
                        "entry_id": "826b215f-7fb4-36cf-95ed-02ab046063e6",
                        "glosses": [
                            "iemand die altijd opschept over zichzelf zonder dat daar echt reden voor is"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "14041de8-70e0-415e-91c3-f5b1c69ef8a4",
                                "sense_id": "0b52280b-29fa-324d-8e09-9a48f9a0b269",
                                "text": "Macron heeft ditmaal gewonnen. Maar daardoor is de crisis van de sociaaldemocratie nog niet opgelost. Labour ligt in het Verenigd Koninkrijk op sterven. Met de PvdA gaat het nauwelijks beter. En Donald Trump, een gevaarlijke blaaskaak zonder enige politieke ervaring, werd president door het ‘echte volk’ op te hitsen tegen culturele elites, bankiers, buitenlanders, immigranten en internationale instituties."
                            },
                            {
                                "example_id": "6ecdc8b9-acdf-4057-b623-c9f24c93c855",
                                "sense_id": "0b52280b-29fa-324d-8e09-9a48f9a0b269",
                                "text": "Ik ben geen blaaskaak. Ga liever om met Piet, Jan en Klaas dan met bobo’s."
                            },
                            {
                                "example_id": "25c31898-c773-4d43-b3f6-87ff3fc69052",
                                "sense_id": "0b52280b-29fa-324d-8e09-9a48f9a0b269",
                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                            }
                        ]
                    }
                ],
