                                    {
                                        "sense_id": "c4e29fca-8e3f-35bb-a7f2-c60db9ee34e7",
                                        "entry_id": "a4990b09-bc81-3bfc-ac02-836785275684",
                                        "glosses": [
                                            "wstęp do czegoś, wprowadzenie, przygotowanie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5715b0d6-5493-4fca-81fd-d4d874e09761",
                                                "sense_id": "c4e29fca-8e3f-35bb-a7f2-c60db9ee34e7",
                                                "text": "Pamiętam, jak w szkole z różnych mało lubianych przedmiotów (np. propedeutyka wiedzy o społeczeństwie) kombinowałem, jak dostać dobry stopień."
