                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708be1b7-dc94-4597-913d-a6326768d698",
                                "sense_id": "87dfc6f7-9be3-3583-9b04-4d1a5e7f0b62",
                                "text": "Een speksteenkachel wordt aangeprezen als uiterst vriendelijk voor het milieu, houtbesparend en er wordt een hoog rendement beloofd van 90 tot 95 procent."
                            },
                            {
                                "example_id": "999a3b80-4058-48c5-bb1d-4eb90b66ccca",
                                "sense_id": "87dfc6f7-9be3-3583-9b04-4d1a5e7f0b62",
                                "text": "Amelia gaf hem nu ook bezigheid genoeg: zij sprak met hem van houtbesparende ovens, van draaimachines, van ploegen, welke te gelijk zaaiden en egden; en hij maakte haar van dit alles kleine modellen."
                            }
