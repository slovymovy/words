                                "target_senses": [
                                    {
                                        "sense_id": "e0948891-e282-3fb3-baf5-3d73168d2134",
                                        "entry_id": "6401965f-a87c-3d1c-8ae3-0a773bd3f031",
                                        "glosses": [
                                            "To give a written or spoken response, especially to a question, request, accusation or criticism; to answer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9cd383a-9b4e-43ec-b514-c1dcf04865db",
                                                "sense_id": "e0948891-e282-3fb3-baf5-3d73168d2134",
                                                "text": "(intransitive) Please reply to my letter."
                                            },
                                            {
                                                "example_id": "877052de-c1c4-44ee-a127-f55f8f2cac6c",
                                                "sense_id": "e0948891-e282-3fb3-baf5-3d73168d2134",
                                                "text": "(transitive) \"Sorry I'm late,\" replied the student."
                                            },
                                            {
                                                "example_id": "7726447e-2bb6-4dc9-8c43-338625ebde9e",
                                                "sense_id": "e0948891-e282-3fb3-baf5-3d73168d2134",
                                                "text": "(transitive) He replied that he was not sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7477ee3-ee4e-325a-b6d9-8041ff9c5d07",
                                        "entry_id": "6401965f-a87c-3d1c-8ae3-0a773bd3f031",
                                        "glosses": [
                                            "To act or gesture in response."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ea6231-2db0-4444-9b82-d1bad0cc1554",
                                                "sense_id": "e7477ee3-ee4e-325a-b6d9-8041ff9c5d07",
                                                "text": "Joanne replied to Pete's insult with a slap to his face."
                                            },
                                            {
                                                "example_id": "fee0983c-3448-4a16-b1c2-74ab6bf03cec",
                                                "sense_id": "e7477ee3-ee4e-325a-b6d9-8041ff9c5d07",
                                                "text": "It is a sound to be dreaded until you ascertain that it is being made by friendly forces; even then, your welcome to it must be tempered with some caution, because gunfire usually leads to replying gunfire[…]"
                                            },
                                            {
                                                "example_id": "833f6652-6ac0-4605-a069-23d6dbb1ace1",
                                                "sense_id": "e7477ee3-ee4e-325a-b6d9-8041ff9c5d07",
                                                "text": "[…] bulged the onion bag for the Blades, and Downes and Prendergast replied for the Owls."
                                            }
                                        ]
                                    },
