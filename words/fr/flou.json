    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "822a8f23-3f10-3916-aaf5-47e330edc6e3",
                    "sense_definition": "Qui manque de netteté visuelle, dont les contours ne sont pas bien définis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aspect_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette photo est complètement <w>floue</w> parce que tu as bougé au moment de déclencher.",
                            "target_lang_translations": {
                                "en": "This photo is completely <w>blurry</w> because you moved when you pressed the shutter.",
                                "ru": "Эта фотография получилась совершенно <w>размытой</w>, потому что ты шевельнулся в момент съёмки.",
                                "de": "Dieses Foto ist völlig <w>verschwommen</w>, weil du dich beim Auslösen bewegt hast.",
                                "es": "Esta foto está completamente <w>borrosa</w> porque te moviste en el momento de disparar.",
                                "zh": "这张照片完全<w>模糊</w>了，因为你按快门的时候动了一下。"
                            }
                        },
                        {
                            "text": "Sans ses lunettes, tous les visages au loin lui paraissent totalement <w>flous</w>.",
                            "target_lang_translations": {
                                "en": "Without his glasses, all the faces in the distance look completely <w>blurry</w> to him.",
                                "ru": "Без очков все лица вдали кажутся ему совершенно <w>размытыми</w>.",
                                "de": "Ohne seine Brille wirken alle Gesichter in der Ferne für ihn völlig <w>verschwommen</w>.",
                                "es": "Sin sus gafas, todos los rostros a lo lejos le parecen totalmente <w>borrosos</w>.",
                                "zh": "没戴眼镜的话，远处的人脸在他看来全都<w>模糊</w>不清。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brouillé",
                        "brumeux",
                        "indistinct",
                        "trouble",
                        "voilé"
                    ],
                    "antonyms": [
                        "clair",
                        "distinct",
                        "net"
                    ],
                    "common_phrases": [
                        "photo floue",
                        "image floue"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking visual sharpness, with outlines that are not clearly defined.",
                        "ru": "Лишённый визуальной чёткости, с нечётко очерченными контурами.",
                        "de": "Ohne optische Schärfe, mit nicht klar erkennbaren Konturen.",
                        "es": "Que carece de nitidez visual y cuyos contornos no están bien definidos.",
                        "zh": "视觉上不清晰、轮廓不分明的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blurry",
                                "target_lang_sense_clarification": "of photos and images"
                            },
                            {
                                "target_lang_word": "fuzzy",
                                "target_lang_sense_clarification": "of edges and outlines"
                            },
                            {
                                "target_lang_word": "unfocused",
                                "target_lang_sense_clarification": "of lenses or eyesight"
                            }
                        ],
                        "ru": [
