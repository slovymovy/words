                },
                {
                    "sense_id": "85c7a1b0-0a4e-393b-8002-a01746f10976",
                    "sense_definition": "moeilijk te doorgronden of zeer diepzinnig en abstract",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geheimzinnig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tekst in dit oude boek is erg <w>mysterieus</w> en lastig te interpreteren.",
                            "target_lang_translations": {
                                "en": "The text in this old book is very <w>abstruse</w> and difficult to interpret."
                            }
                        },
                        {
                            "text": "Zijn <w>mysterieuze</w> glimlach deed ons vermoeden dat hij meer wist dan hij zei.",
                            "target_lang_translations": {
                                "en": "His <w>mysterious</w> smile made us suspect that he knew more than he was saying."
                            }
