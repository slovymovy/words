                "senses": [
                    {
                        "sense_id": "9bfa3755-45c1-38dc-b4e2-6d29266759df",
                        "entry_id": "e3f321ee-e706-3665-94c6-2a85ed8d6725",
                        "glosses": [
                            "Basiseinheit des Internationalen Einheitensystems, auch kurz SI (Abkürzung für französisch: Système international d'unités) genannt"
                        ],
                        "tags": [
                            "Naturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "fb9a800b-7dcd-438a-a432-81a97e8565f4",
                                "sense_id": "9bfa3755-45c1-38dc-b4e2-6d29266759df",
                                "text": "Aus den SI-Basiseinheiten werden alle andere Einheiten des metrischen Systems abgeleitet."
                            },
                            {
                                "example_id": "026b78f0-4bf8-48f8-a70f-c2be58967391",
                                "sense_id": "9bfa3755-45c1-38dc-b4e2-6d29266759df",
                                "text": "„Einem Frequenz- oder Zeitnormal kommt dabei eine besonders wichtige Rolle zu, da sich davon die SI-Basiseinheit \"Meter\" über die Festlegung der Lichtgeschwindigkeit ableitet und ein Frequenznormal über Josephson- und Quanten-Hall-Effekt mit der Basiseinheit \"Ampere\" verknüpft ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
