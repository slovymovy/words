                                "target_lang_sense_clarification": "un título o una victoria"
                            },
                            {
                                "target_lang_word": "obtener",
                                "target_lang_sense_clarification": "premios, medallas o distinciones"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赢得",
