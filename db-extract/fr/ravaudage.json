                                    {
                                        "sense_id": "9a19c88c-45b5-3232-be2a-cdedf44b5b15",
                                        "entry_id": "e8d59f4d-cb59-3085-ab60-363ada28b217",
                                        "glosses": [
                                            "etwas Verformbares irgendwo hineindrücken"
                                        ],
