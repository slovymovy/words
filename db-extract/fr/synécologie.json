                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e9c13bea-3954-43ce-9fda-1e787d415ad2",
                        "entry_id": "3c4fb3e0-6df2-30c2-accf-46472ed7f3cf",
                        "tags": [
