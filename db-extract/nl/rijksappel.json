                                                "example_id": "6271286b-1851-4a1e-abfc-f53b5c443310",
                                                "sense_id": "4b718341-e821-3ae2-9410-f7c5c7378807",
                                                "text": "small blank windows or panels, for in later times such panels were called orbs, blind windows"
                                            }
                                        ]
