        "fr-extract.jsonl": [
            {
                "entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                "word": "vitrail",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc04e59f-1899-4e3d-b073-55e414b9285c",
                        "entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                        "tags": [
                            "plural"
                        ],
                        "form": "vitraux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                        "entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                        "glosses": [
                            "Panneau de verres assemblés par compartiments, enchâssés dans des cadres de plomb et qui le plus souvent forment une décoration ou représentent un sujet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012aa887-5509-4fb5-b6b7-013d2c3c636f",
                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                "text": "C’était une retraite obscure et religieuse où le jour ne pénétrait qu’à travers les vitraux coloriés et où tout disposait l’âme à la prière."
                            },
                            {
                                "example_id": "779454a8-0f4a-4ce9-8c83-d43a2d1a8aff",
                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                "text": "Les vitraux de plomb disjoints laissaient tomber les verres octogones des croisées qui semblaient éborgnées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "118021ca-d512-4e0a-84eb-afcab5917388",
                        "source_entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                        "source_sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                        "target_lang_word": "Kirchenfenster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenfenster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                        "entry_id": "4f49a0ca-37d6-3b82-b534-05493efd727f",
                                        "glosses": [
                                            "verglaste Öffnung in einem Gotteshaus, die häufig mit religiösen Motiven als Kunstobjekt ausgestaltet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "063f862e-8415-44ac-9030-5a073c45667e",
                                                "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                                "text": "Auf diesem Kirchenfenster werden „Die Gerechten in Abrahams Schoß“ dargestellt."
                                            },
                                            {
                                                "example_id": "fa0a282e-be27-461f-bb20-9bd4006d2d16",
                                                "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                                "text": "„Mit der Verwendung des Blaus in den Kirchenfenstern von Saint-Denis und Chartres im 12. Jahrhundert hatte ein sonnendurchflutetes Blau in die Gotteshäuser Einzug gehalten, das die himmlische Transzendenz zu symbolisieren vermochte.“"
                                            },
                                            {
                                                "example_id": "1c6a6c56-7a34-4a06-b78c-60a8de8bfce5",
                                                "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                                "text": "„Und jetzt wurden sie so feierlich wie ein Kirchenfenster, ein tiefes, sattes Rot und strahlendes Dunkelblau.“"
                                            },
                                            {
                                                "example_id": "9a0b118f-e332-454d-a6bd-5e324a9439c0",
                                                "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                                "text": "„Im Dämmerlicht der Kirchenfenster wird er einst ein ungleich düstereres Aussehen gehabt haben als es sich jetzt darbietet.“"
                                            },
                                            {
                                                "example_id": "2b24abbe-fcc5-4d8d-b50c-331e8424ca4b",
                                                "sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                                                "text": "„Die Frau war ganz hellblond, Sommersprossen übersäten ihre Wangen, und sie trug jenen einfältigen Ausdruck zur Schau, den man bei den Bauern auf Kirchenfenstern sieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a5cd21-e9ee-4611-bfe6-e0d19f939200",
                        "source_entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                        "source_sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                        "target_lang_word": "stained glass window",
                        "target_lang_code": "en",
