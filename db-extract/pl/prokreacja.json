                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1a8b72-1b0b-4a59-9146-aa786f51493d",
                                "sense_id": "e89381ac-ee81-3b6d-ae01-1f4ed09f3427",
                                "text": "Bronił praw kobiet do decydowania o prokreacji i własnej seksualności"
                            },
                            {
                                "example_id": "bc831f15-39e4-4190-93f7-ca2b086bac5a",
                                "sense_id": "e89381ac-ee81-3b6d-ae01-1f4ed09f3427",
                                "text": "W sferze stosunków społecznych islam propaguje model konserwatywnego układu społecznego ze ściśle określanymi rolami obydwu płci i reguluje drobiazgowo relacje w sferze prokreacji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
