                ],
                "senses": [
                    {
                        "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                        "entry_id": "ca1dc94e-e3a8-3805-9007-63ac3446f0e2",
                        "glosses": [
                            "„Ortsbestimmung eines bewegten Objekts aufgrund von Bewegungsrichtung (Kurs) und Geschwindigkeit (Fahrt)“"
                        ],
                        "tags": [
                            "Seewesen"
                        ],
                        "examples": [
                            {
                                "example_id": "73d495fc-17ad-4efd-894f-da66bdb7dc85",
                                "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                                "text": "„Vermerken Sie den Zeitpunkt der Standortbestimmung neben dem Eintrag auf der Seekarte, um die Koppelnavigation zu erleichtern.“"
                            },
                            {
                                "example_id": "4f1a85d6-d078-4a8e-9488-9a90ac046400",
                                "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                                "text": "„Die Koppelnavigation ist nicht so genau wie das Bestimmen der Position mithilfe einer Navigations-App oder akkurater Standlinien, es ist aber eine unschätzbare Fähigkeit für Langstreckensegler und Navigatoren.“"
                            },
                            {
                                "example_id": "55f96561-a2a3-4240-8bdf-bcb477e0dae8",
                                "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                                "text": "„Um Berechnungen für die Koppelnavigation durchführen zu können müssen sie erst einmal den wichtigen Zusammenhang zwischen Geschwindigkeit, Zeit und Entfernung verstehen.“"
                            },
                            {
                                "example_id": "0b076f63-d8ca-4e4e-9d4f-26dabc413756",
                                "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                                "text": "„Der Koppelnavigation ist bei schwerem Wetter besondere Aufmerksamkeit zu widmen.“"
                            },
                            {
                                "example_id": "c1f87187-d692-4e1b-8611-a9fc14431303",
                                "sense_id": "f6be10c9-c479-32a3-8867-6269aec5ca03",
                                "text": "„Die Standorte der Koppelnavigation sind, sofern durch die elektronischen Navigationssysteme verifiziert, in kürzeren Abständen als gewohnt in die Seekarte einzutragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
