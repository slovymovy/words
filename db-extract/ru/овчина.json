                    {
                        "form_id": "1cbec2f3-072d-471a-ac51-c4ed8582de3f",
                        "entry_id": "46d8c7d6-d404-359d-a7d0-277bbef13441",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "овчи́нах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e2766f2-d6d8-3f8a-aa47-cae676e99f6d",
                        "entry_id": "46d8c7d6-d404-359d-a7d0-277bbef13441",
                        "glosses": [
                            "выделанная овечья шкура"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a680c9-df10-42e3-ab3c-06332f2c0405",
                                "sense_id": "9e2766f2-d6d8-3f8a-aa47-cae676e99f6d",
                                "text": "Материалы приходилось большей частью закупать через частных предпринимателей, частью в Ставропольской губернии (войлок, овчина), частью на Кубани и Тереке (смазочные вещества, дерево для поделки седел, пеньку)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f17aacc-43e1-4e00-b12c-12ee8f0fe842",
                        "source_entry_id": "46d8c7d6-d404-359d-a7d0-277bbef13441",
                        "source_sense_id": "9e2766f2-d6d8-3f8a-aa47-cae676e99f6d",
                        "target_lang_word": "mouton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bda0d36-0fa9-30a9-a716-8b9bbbed59e6",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Mammifère herbivore de la famille des ovidés, à poils laineux et frisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b21b0b0-0df8-4e87-943d-e97239e3ccb2",
                                                "sense_id": "8bda0d36-0fa9-30a9-a716-8b9bbbed59e6",
                                                "text": "Il ne voulait pas lâcher son mouton, mais les bêlements semblaient s’éloigner et la maudite bête tirait sur sa corde et refusait de pénétrer dans le fourré."
                                            },
                                            {
                                                "example_id": "c2f16c11-06fd-4ff3-9143-b20d26149ff8",
                                                "sense_id": "8bda0d36-0fa9-30a9-a716-8b9bbbed59e6",
                                                "text": "La noirceur de la tourbe et des basaltes est coupée par des taches d’un gazon vert et abondant qui, bien que coriace, sert cependant de nourriture à près de 200.000 moutons sauvages, venus on ne sait d’où."
                                            },
                                            {
                                                "example_id": "790b4970-539c-4e2f-9567-0738d4532058",
                                                "sense_id": "8bda0d36-0fa9-30a9-a716-8b9bbbed59e6",
                                                "text": "Les moutons transhumants portent, attachés leur laine, de nombreuses graines de la plaine vers la montagne et surtout de la montagne vers la plaine."
                                            },
                                            {
                                                "example_id": "afe70dbb-dd8c-4648-b119-dbf4c2ee0b71",
                                                "sense_id": "8bda0d36-0fa9-30a9-a716-8b9bbbed59e6",
                                                "text": "Retourner au village, vivre à nouveau parmi les racontars des femmes, écouter tout le jour les piaulements des dindes et des poulets, les bêlements des moutons, cela l’attirait peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8683fa4a-e941-3ab9-ab82-34437b77ca14",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Les béliers, brebis et agneaux, quand ils sont en troupe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "347f7a11-809c-4ac6-8387-5b7e4459e681",
                                                "sense_id": "8683fa4a-e941-3ab9-ab82-34437b77ca14",
                                                "text": "Un ouvrier quitte sa houe, un vigneron relève son dos voûté, une petite gardeuse de chèvres, de vaches ou de moutons grimpe dans un saule pour vous espionner."
                                            },
                                            {
                                                "example_id": "8fab9af4-b5ae-45f1-91c7-c7fe6102e793",
                                                "sense_id": "8683fa4a-e941-3ab9-ab82-34437b77ca14",
                                                "text": "Les paysans du Nivernais ont accoutumé de dire de leurs voisins du Berry que « quatre-vingt-dix-neuf moutons et un Berriat (ou Berrichon) font cent bêtes », locution que les Berrichons ou Berriats ne manquent pas de transformer à l’usage des Limousins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97b46d7-5f94-34ee-8b88-a2f1e2439165",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Bélier châtré qu’on engraisse pour la boucherie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a6db9c5-e1d3-41ac-9e86-697bc557767a",
                                                "sense_id": "d97b46d7-5f94-34ee-8b88-a2f1e2439165",
                                                "text": "Mouton de pré-salé."
                                            },
                                            {
                                                "example_id": "27020009-b67e-4ce0-a02e-1d1a3a14950e",
                                                "sense_id": "d97b46d7-5f94-34ee-8b88-a2f1e2439165",
                                                "text": "Gigot, épaule, côtelettes, pieds de mouton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a738a91-3c90-3559-958c-1a968edd2839",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Viande de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99d43537-a82a-4894-a631-b750407f54a2",
                                                "sense_id": "0a738a91-3c90-3559-958c-1a968edd2839",
                                                "text": "Le procureur mangeait du mouton rôti en compagnie de jeunes femmes bronzées, Sabatier faisait sa sieste au SRPJ, Leclerc devait être en train de prendre des initiatives hasardeuses à Darcé — à moins qu’il ne soit allé piquer une tête dans la piscine des Serruzier, histoire d’exhiber sa musculature et son style imbattable à la brasse papillon ! —, et lui, il s’empiégeait dans une enquête de flagrant délit qui lui saccageait son seul vrai dimanche de l’année !"
                                            },
                                            {
                                                "example_id": "bb2dcf70-696a-4e85-92ce-ea3c37cd8cf9",
                                                "sense_id": "0a738a91-3c90-3559-958c-1a968edd2839",
                                                "text": "Au menu : apéritif, melon de pays, terrine de poisson, coup du milieu, mouton ou magret de canard, mojhettes, salade, fromage, glace, café cognac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c3cfed-4f4c-35c6-a37e-b84a4aa48580",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Peau de cet animal, basane."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e7a78b-29bf-4691-9a97-8e821febdd73",
                                                "sense_id": "70c3cfed-4f4c-35c6-a37e-b84a4aa48580",
                                                "text": "La reliure de ce livre est en mouton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "879c662e-005e-31b5-b530-4c5e0b8246b8",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31dc310-05c9-4790-832f-1d8b3cb9c345",
                                                "sense_id": "879c662e-005e-31b5-b530-4c5e0b8246b8",
                                                "text": "De gueules au mouton d’argent surmonté de trois coquilles du même rangées en chef, qui est de Hestroff de Moselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a39d8b-af4b-3e85-aff8-401665feb6d9",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Homme aposté pour gagner la confiance d’un prisonnier, découvrir son secret et le révéler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d54f3a-96af-49be-b5ce-2e13d6c4308d",
                                                "sense_id": "74a39d8b-af4b-3e85-aff8-401665feb6d9",
                                                "text": "On mit près de lui un mouton pour le faire parler."
                                            },
                                            {
                                                "example_id": "08a58205-4e9a-4455-8234-ba2f18f5dc97",
                                                "sense_id": "74a39d8b-af4b-3e85-aff8-401665feb6d9",
                                                "text": "Il demeurait silencieux et ce n’était qu’au bout de quelques minutes seulement qu’il reprenait la parole :\n— Il y avait un mouchard, le Gréviste ?…\n— Pis que cela, patron… un mouton."
                                            },
                                            {
                                                "example_id": "0515f069-1678-4e80-9243-ae3f646dba89",
                                                "sense_id": "74a39d8b-af4b-3e85-aff8-401665feb6d9",
                                                "text": "« J’oubliais ! Je fais immédiatement une démarche pour qu’on change votre compagnon de cellule. C’est un “'mouton”. Méfiez-vous aussi de celui qu’on mettra à sa place. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9605ba09-5849-376a-b661-5c54cc804ba9",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Personne sans autonomie ou originalité, conformiste, qui se contente de suivre un meneur ou un groupe → voir mouton de Panurge."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0572212-35dc-456f-a13d-8ef65e3bccba",
                                                "sense_id": "9605ba09-5849-376a-b661-5c54cc804ba9",
                                                "text": "Ils l’ont tous suivi comme des moutons."
                                            },
                                            {
                                                "example_id": "bbbf68f3-1a65-43a5-a3d1-2d76113e1c2c",
                                                "sense_id": "9605ba09-5849-376a-b661-5c54cc804ba9",
                                                "text": "De cette période, elle dira « c’est une période difficile le collège, de toute façon, peu importe où on est : les enfants sont pas sympas, on est jugé, on se fait moquer […] si on est pas un mouton, tout de suite, ça plaît pas aux autres… »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c9864f-c380-3a76-b4fd-8328b0eff57e",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Personne dominée et docile, qui se fait dépouiller de ses richesses, qui ne sait pas se défendre."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f852e672-e17e-44d1-9df0-c8c8e17ded70",
                                                "sense_id": "73c9864f-c380-3a76-b4fd-8328b0eff57e",
                                                "text": "Les femmes persuadent toujours aux hommes de qui elles ont fait des moutons qu’ils sont des lions, et qu’ils ont un caractère de fer."
                                            },
                                            {
                                                "example_id": "f5203f1d-f890-4683-94cb-e11ad0cc0143",
                                                "sense_id": "73c9864f-c380-3a76-b4fd-8328b0eff57e",
                                                "text": "Alors elle a sauté le pas : fin octobre elle a créé, à son tour, son groupe Facebook appelant à manifester le 17 novembre contre la hausse des prix des carburants ; il s’appelle « Nous ne sommes pas des moutons à la Tour-du-Pin » – du nom de sa commune de l’Isère – et il compte déjà près de 500 membres, pour 8 000 habitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4c573d-1f8e-383d-bb8f-4972705ee8ee",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Masse de fer ou grosse pièce de bois, qu’on élève et qu’on laisse retomber sur des pieux pour les enfoncer en terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a25ae99-9a1f-436d-82fa-e866e3a52a17",
                                                "sense_id": "1f4c573d-1f8e-383d-bb8f-4972705ee8ee",
                                                "text": "Lorsque, par l'effet de l'enfoncement du pieu, sa tête est parvenue un peu au-dessous du pied de la sonnette, le mouton ne peut plus l’atteindre, et alors on ne peut continuer le battage que par le moyen d’un faux pieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f76963b-b4c1-3b24-b8ca-8bc84fbcf21e",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Grosse pièce de bois dans laquelle sont engagées les anses d’une cloche, pour la tenir suspendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f8f7d2-4b20-4954-940d-3c55be4fb517",
                                                "sense_id": "8f76963b-b4c1-3b24-b8ca-8bc84fbcf21e",
                                                "text": "De plus, c’est la fabrique qui abritera et nourrira le fondeur, parfois accompagné de sa famille, pendant trois à cinq semaines, et elle devra aussi, à l’occasion faire façonner le batant et le mouton de la cloche par un serrurier ou un taillandier du voisinage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d70ddb4-ee9d-3478-ba11-67a8c15f79bc",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Vagues blanchissantes qui s’élèvent sur la mer et sur les grandes rivières, lorsqu’elles commencent à être agitées."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c05a1cce-049c-396f-b7b7-4e38526145e1",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Flocons de poussière qui s’assemblent sous les meubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff4c37d-594a-47d4-a52d-5d37111ea3c8",
                                                "sense_id": "c05a1cce-049c-396f-b7b7-4e38526145e1",
                                                "text": "Tu ne fais pas le ménage souvent : c’est plein de moutons sous ton divan !"
                                            },
                                            {
                                                "example_id": "457a2a7a-b525-49d1-95a5-9def716cca61",
                                                "sense_id": "c05a1cce-049c-396f-b7b7-4e38526145e1",
                                                "text": "Le regard de son œil bleu, froid et rigide comme de l’acier, se glissait jusque sous les meubles à tout moment ; aussi eussiez-vous plus facilement trouvé dans son cœur une corde sensible qu’un mouton sous une bergère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14fa4d47-eddf-3ff2-91d6-1f5364192171",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "Espèce de marteau utilisé pour frapper le métal dans la fabrication des épingles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae3ec95e-278b-3313-88c5-3cbbc025d796",
                                        "entry_id": "33938170-e094-30ca-89d4-ee883a2bf126",
                                        "glosses": [
                                            "En poterie, pièces collées entre elles et ratées par une cuisson trop forte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e671406-c68c-4552-b5a4-34c10277f5eb",
                                                "sense_id": "ae3ec95e-278b-3313-88c5-3cbbc025d796",
                                                "text": "Pour être certain d’avoir affaire à un four de tuilier, il faut constater une grande concentration de matériel de construction : briques, tuiles, etc., une absence de tessons de poterie et surtout des ratés de cuisson caractéristiques : tuiles ou briques déformées ou collées entre elles par la surcuisson, ce qu’on appelle un « mouton »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
