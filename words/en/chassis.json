    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47a810d3-9ac7-399a-96a6-5b1808535e26",
                    "sense_definition": "The base frame of a motor vehicle, such as a car or truck, to which the body and engine are attached.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_frame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic inspected the <w>chassis</w> for any signs of rust or structural damage.",
                            "target_lang_translations": {
                                "ru": "Механик осмотрел <w>шасси</w> на предмет ржавчины или структурных повреждений."
                            }
                        },
                        {
                            "text": "A lightweight <w>chassis</w> helps improve the overall fuel efficiency of the vehicle.",
                            "target_lang_translations": {
                                "ru": "Легкое <w>шасси</w> помогает улучшить общую топливную экономичность автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "frame",
                        "framework",
                        "undercarriage"
                    ],
                    "common_phrases": [
                        "vehicle chassis",
                        "aluminum chassis",
                        "chassis number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорная рама транспортного средства (автомобиля или грузовика), к которой крепятся кузов и двигатель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шасси",
                                "target_lang_sense_clarification": "автомобильное"
                            },
                            {
                                "target_lang_word": "рама",
                                "target_lang_sense_clarification": "несущая конструкция"
                            },
                            {
                                "target_lang_word": "ходовая часть",
                                "target_lang_sense_clarification": "совокупность узлов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec70b723-b707-319f-8942-86fcad9572cb",
                    "sense_definition": "A frame or housing containing electrical or mechanical equipment, such as the internal structure of a computer or radio.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_frame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician carefully slid the motherboard into the computer <w>chassis</w>.",
                            "target_lang_translations": {
                                "ru": "Техник осторожно вставил материнскую плату в <w>корпус</w> компьютера."
                            }
                        },
                        {
                            "text": "This server <w>chassis</w> is designed to hold up to twelve hard drives simultaneously.",
                            "target_lang_translations": {
                                "ru": "Это серверное <w>шасси</w> рассчитано на одновременную установку до двенадцати жестких дисков."
                            }
