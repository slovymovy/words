                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebfd228c-89ae-4053-b2fb-46313327b1a5",
                        "source_entry_id": "53476e47-95de-379e-b3ba-798bbcd09efc",
                        "source_sense_id": "d9e72e39-9d84-3062-9236-8a1a928d34b0",
                        "target_lang_word": "palpable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palpable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                        "entry_id": "f8e53833-3ea4-30bf-8d4e-0459fd8d213c",
                                        "glosses": [
                                            "Capable of being touched, felt or handled; touchable, tangible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c624b95-80de-4aff-ae9c-09585ebc32d2",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "Osric: A hit, a very palpable hit."
                                            },
                                            {
                                                "example_id": "ba26eb84-2a4d-41a0-963d-44403e4729d8",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "The imagination shuns to reveal its workings, unless it can clothe them in some lovely and palpable shape, and create into existence the high romance, the mournful song, the animated canvass, or the carved marble;..."
                                            },
                                            {
                                                "example_id": "a623f82b-8ae2-4dce-9ce0-889c1a46b2fc",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "I had felt that some palpable although invisible object had passed lightly by my person."
                                            },
                                            {
                                                "example_id": "2e4f913c-b222-410c-8b1a-e9f5fc6bdd94",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "The next morning the fog had given way to a palpable, horizontally driving rain."
                                            },
                                            {
                                                "example_id": "ffd67654-fd1b-43bc-aca4-6612b40e0036",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "[T]he gondolas stole in and out of the opaque distance more noiselessly and dreamily than ever; and a silence, almost palpable, lay upon the mutest city in the world."
                                            },
                                            {
                                                "example_id": "b4af6a29-7ded-4aad-a28b-04af4597cfdc",
                                                "sense_id": "3b3840e0-a2d6-3b31-93ce-c80305ecb9ed",
                                                "text": "The force of her horror must have been palpable in the air, because Jorge's eyes opened as she raised the bayonet up. \"Fina?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                        "entry_id": "f8e53833-3ea4-30bf-8d4e-0459fd8d213c",
                                        "glosses": [
                                            "Obvious or easily perceived; noticeable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33addb4-6ef1-49b7-ab52-dcc91e660f7b",
                                                "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                                "text": "No use in raging, in reasoning, in arguing. No use in setting forth the facts, the palpable right and wrong."
                                            },
                                            {
                                                "example_id": "491c8b3d-5381-4656-9583-3315a39352de",
                                                "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness,[…]. It was with a palpable relief that he heard the first warning notes of the figure."
                                            },
                                            {
                                                "example_id": "140ac64e-bd60-4908-bb9b-d6eec39ef241",
                                                "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                                "text": "Her voice, her palpable agitation, prepared us for something extraordinary."
                                            },
                                            {
                                                "example_id": "6d221bec-5525-4051-8e41-542f760d9083",
                                                "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                                "text": "By Thursday, there was a palpable sense of frustration with the opposition’s strategy on the streets of Caracas, people in the capital said."
                                            },
                                            {
                                                "example_id": "7a7ff0b9-79c1-4fb8-882b-2c2b01158c35",
                                                "sense_id": "8f33ca60-2a55-36b0-8a66-4e742b881200",
                                                "text": "Elena Remigi, of the In Limbo Project, which is documenting the experiences of EU citizens in the UK, said: “The anxiety among EU citizens is palpable. My inbox is full of messages of people asking for reassurance or guidance.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7834d57a-22cf-3070-863a-c8e8c0de6398",
                                        "entry_id": "f8e53833-3ea4-30bf-8d4e-0459fd8d213c",
                                        "glosses": [
                                            "That can be detected by palpation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1ea5cf0-c5f4-4dc4-b6c6-f3270195b7e5",
                        "source_entry_id": "53476e47-95de-379e-b3ba-798bbcd09efc",
