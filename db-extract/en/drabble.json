                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b2b7cf32-f818-4a77-baa3-d6fdbd376f2e",
                                "sense_id": "fb40b53a-6c73-368f-ac4f-ea0b8771319f",
                                "text": "That which eſpecialleſt nouriſht the moſt prime pleaſure in me, was after a ſtorme when they were driuen inſwarmes, and lay close peſtred together as thicke as they could packe; the next day following, if it were faire, they would cloud the whole skie with canuas, by ſpreading their drabled ſailes in the full clue abroad a drying, and make a brauer ſhew with them, then ſo many banners and ſtreamers diſplayed againſt the Sunne on a mountaine top."
                            }
                        ]
