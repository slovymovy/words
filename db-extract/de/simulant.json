                    }
                ],
                "senses": [
                    {
                        "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                        "entry_id": "98f4f61f-3251-36ff-9288-5d2601d29520",
                        "glosses": [
                            "(männliche^☆) Person, die etwas, meist eine Krankheit, vortäuscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a5c931-64ed-422a-bd46-716e2eb8cbc6",
                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                "text": "Wissentlich falsche Auskünfte gibt der Simulant, der einen Hörschaden vortäuschen will, während bei der Aggravation ein Hörverlust vorliegt, der aber größer als vorhanden angegeben wird."
                            },
                            {
                                "example_id": "cf31064e-9af0-4b90-8062-571609a6049b",
                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                "text": "Ein dritter Typus sind die operativen Hektiker: Sie sind entweder unorganisiert und verzetteln sich ständig oder sie geben sich als Simulant, der sich bewusst emsig gibt."
                            },
                            {
                                "example_id": "23748db3-5a43-4522-8c60-3c004555f81a",
                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                "text": "Wer nach dem Zweiten Weltkrieg als Überlebender der Gräuel in Lagern und Haftanstalten materielle Entschädigung suchte, galt oft noch als Simulant und stand im Verdacht, sich Leistungen erschleichen zu wollen."
                            },
                            {
                                "example_id": "b9fac62b-f587-4a1a-9db4-3a27bb75718c",
                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                "text": "Ihr Anwalt Walter Rubach warf dem Mediziner vor, auf einen Simulanten hereingefallen zu sein."
                            },
                            {
                                "example_id": "1f789029-467b-4c3e-9d74-3f5940af3b34",
                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                "text": "An oberster Stelle der Forderungen stünden „mehr Verständnis und Akzeptanz“, man wolle nicht als Simulant oder Psycho-Patient betrachtet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb7a526-4a34-4356-abb7-a6fc6c2c7ee3",
                        "source_entry_id": "98f4f61f-3251-36ff-9288-5d2601d29520",
                        "source_sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                        "target_lang_word": "malingerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malingerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                        "entry_id": "cd0a4517-1c49-3aee-8f98-53e216b16894",
                                        "glosses": [
                                            "A person who malingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe21d44-4b16-4d24-baa0-f8bea204ffb8",
                                                "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                                "text": "It is telling, in this context of rising rates of mental illness, that New Labour committed itself, early in its third term in government, to removing people from Incapacity Benefit, implying that many, if not most, claimants are malingerers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857fab89-c9c8-461a-bb44-01871b8c315b",
                        "source_entry_id": "98f4f61f-3251-36ff-9288-5d2601d29520",
                        "source_sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                        "target_lang_word": "simulateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb94e0a9-dee3-3c49-b054-413522bfe8d0",
                                        "entry_id": "d3315f30-1b4c-33d4-a74b-f7aea05301fb",
                                        "glosses": [
                                            "Celui qui simule, qui feint un sentiment, une attitude, une action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "906b952d-9909-3880-b6fa-1507491429aa",
                                        "entry_id": "d3315f30-1b4c-33d4-a74b-f7aea05301fb",
                                        "glosses": [
                                            "Celui qui simule la folie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b71d63fe-1d77-4a96-b1f2-9947c4dd335d",
                                                "sense_id": "906b952d-9909-3880-b6fa-1507491429aa",
                                                "text": "Il se dit atteint d’amnésie : c’est un simulateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "simulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Appareil qui permet de simuler un système quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce745f6-6b58-4af4-bb63-3f8bb4297390",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Des études sur simulateur (Rudin-Brown, 2004 ; Rudin-Brown et McCurdie, 2004 ; Lee, 1995), ainsi que des études expérimentales, laissent penser que les conducteurs de véhicules tout-terrain, de pick-up et de camionnettes évaluent leur vitesse avec moins de précision, parce qu'ils sont assis plus haut, au-dessus de la chaussée, que les conducteurs de voitures particulières."
                                            },
                                            {
                                                "example_id": "7c2324e0-0a43-406e-bc5d-0b27d6d7e807",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Les pilotes de chasse professionnels, dont le numéro 2 de la Patrouille de France, venus tester le simulateur alsacien, sont tous unanimes sur le réalisme de l'expérience."
                                            },
                                            {
                                                "example_id": "097ffc5a-5fc0-478b-942d-a522fce7618d",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Monsieur, vous avez deux options : soit vous payez une amende et vous allez peut-être au tribunal, soit vous suivez un stage sur la thématique des téléphones au volant, avec des passages dans un simulateur de conduite par exemple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2d6840-169c-3eb2-99ce-f3dbe02208cf",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Simulateur-ergomètre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
