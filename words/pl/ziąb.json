{
    "word_family": [
        "ziębnąć",
        "zziębnięty",
        "ziębły"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "926e26d6-d72e-3efc-8cc7-aae759a01ba7",
                    "sense_definition": "Przenikliwy, dokuczliwy chłód w powietrzu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chłód",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zewnątrz panował przenikliwy <w>ziąb</w>, więc szybko wróciłem do domu.",
                            "target_lang_translations": {
                                "ru": "На улице стоял пронизывающий <w>холодище</w>, поэтому я быстро вернулся домой."
                            }
                        },
                        {
                            "text": "Jesienny <w>ziąb</w> przenikał przez ubranie podczas długiego spaceru.",
                            "target_lang_translations": {
                                "ru": "Осенняя <w>стужа</w> пробирала до костей во время долгой прогулки."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłód",
                        "zimnica",
                        "zimno"
                    ],
                    "antonyms": [
                        "gorąco",
                        "gorąc"
                    ],
                    "common_phrases": [
                        "przenikliwy ziąb",
                        "dokuczliwy ziąb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пронизывающий, неприятный холод в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодище",
                                "target_lang_sense_clarification": "разговорное, усилительное обозначение сильного холода"
                            },
                            {
                                "target_lang_word": "стужа",
                                "target_lang_sense_clarification": "сильный, пронизывающий холод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18f8c6d6-a4ba-3e68-b50c-f3c1f603d9e8",
                    "sense_definition": "Uczucie przejmującego chłodu odczuwane przez organizm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chłód",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poczuł nagły <w>ziąb</w>, gdy tylko wyszedł z gorącej sauny na mróz.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапный <w>озноб</w>, как только вышел из горячей сауны на мороз."
                            }
                        },
                        {
                            "text": "Przeszedł go <w>ziąb</w> na samą myśl o nadchodzącym egzaminie.",
                            "target_lang_translations": {
                                "ru": "Его пробрал <w>холод</w> при одной только мысли о предстоящем экзамене."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłód",
                        "zimnica"
                    ],
                    "common_phrases": [
                        "poczuć ziąb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение пронизывающего холода, испытываемое организмом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озноб",
                                "target_lang_sense_clarification": "ощущение холода, дрожь в теле"
                            },
                            {
                                "target_lang_word": "холод",
                                "target_lang_sense_clarification": "общее ощущение низкой температуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a8314f4-5318-3025-985e-b414078e1ff6",
                    "sense_definition": "Stan niskiej temperatury otoczenia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chłód",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nieogrzewanym pomieszczeniu panował dotkliwy <w>ziąb</w> przez całą noc.",
                            "target_lang_translations": {
                                "ru": "В неотапливаемом помещении всю ночь стоял лютый <w>холод</w>."
                            }
                        },
                        {
                            "text": "Mimo że słońce świeciło, w cieniu wciąż utrzymywał się <w>ziąb</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что светило солнце, в тени всё ещё сохранялся <w>холод</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłód",
                        "zimno"
                    ],
                    "antonyms": [
                        "gorąco"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние низкой температуры окружающей среды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холод",
                                "target_lang_sense_clarification": "низкая температура воздуха"
                            },
                            {
                                "target_lang_word": "холода",
                                "target_lang_sense_clarification": "период или состояние сильного холода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}