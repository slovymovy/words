                    }
                ],
                "senses": [
                    {
                        "sense_id": "86a08d1e-fb32-3adc-ac8f-278cf9e7d6c2",
                        "entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                        "glosses": [
                            "An ignorant person; an idiot."
                        ],
                        "tags": [
                            "childish",
                            "endearing"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fceacae-20ab-4132-9294-94c41ae9631f",
                        "source_entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                        "source_sense_id": "86a08d1e-fb32-3adc-ac8f-278cf9e7d6c2",
                        "source_sense_description": "an idiot",
                        "target_lang_word": "ду́рень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ду́рень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f08d1d68-2cbd-3397-aa8f-01cfc7c9d5e4",
                                        "entry_id": "068b5daf-5bc3-3e6c-a8fb-3042e927108a",
                                        "glosses": [
                                            "разг., фам. глупец, дурак"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b835c814-483e-401b-b50c-758601b4b89b",
                                                "sense_id": "f08d1d68-2cbd-3397-aa8f-01cfc7c9d5e4",
                                                "text": "— А дорого я дал бы, чтоб посмотреть, какая рожа будет у этого дурня, когда он увидит, что купил десять фунтов воздуха за два миллиона."
                                            },
                                            {
                                                "example_id": "af315d06-6fff-4e42-b289-8c5780423336",
                                                "sense_id": "f08d1d68-2cbd-3397-aa8f-01cfc7c9d5e4",
                                                "text": "Дурень ты, дурень, пиши скорее матери, проси у неё прощенья, не своди её с ума…"
                                            },
                                            {
                                                "example_id": "6b3f7f81-0f6e-4bf0-ac45-39a3f4d623b1",
                                                "sense_id": "f08d1d68-2cbd-3397-aa8f-01cfc7c9d5e4",
                                                "text": "На экране красовалась одна и та же картинка, скажем, «меню» очередного субботнего номера, и что этот дурень на ней разглядывал часами ― неведомо."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac0d5dd7-36de-4114-9b36-9bd9e73561ba",
                        "source_entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                        "source_sense_id": "86a08d1e-fb32-3adc-ac8f-278cf9e7d6c2",
                        "source_sense_description": "an idiot",
                        "target_lang_word": "болва́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "болва́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "81448854-23d9-358b-acb8-1a6887af3b2a",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "устар. то же, что идол"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdd2edb-f92b-4107-8a63-d389df066915",
                                                "sense_id": "81448854-23d9-358b-acb8-1a6887af3b2a",
                                                "text": "Сему болвану и Прону приносили нередко в жертву Христиан плененных; при заклании оных прикушивал жрец их крови: от чего надеялися получать ему больше силы и действия к предсказанию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe0fac2-a0a6-31bc-973b-98bd5d2f9c04",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "нар.-разг. бестолковый, глупый человек (мужчина)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef257f21-6977-4d61-ae80-b3547a517608",
                                                "sense_id": "bfe0fac2-a0a6-31bc-973b-98bd5d2f9c04",
                                                "text": "И в самом деле, прежде они просто были болваны, а теперь они вдруг стали нигилисты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dda3e59-7528-39e5-b8ee-23114c6a2f09",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "форма, на которую натягивают головные уборы, парики, изготавливая или расправляя их"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30b8f22-e74d-3074-af6b-1ecb3f10b872",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "металл. выступ формовочной смеси, который создаётся при формовке"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b4f0c8f-510f-3350-8c0d-d299ee97a2aa",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "при игре в преферанс вчетвером — сдающий игрок, не берущий карт"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2828af-a2c7-3209-be95-8f06556b60ee",
                                        "entry_id": "63b183ee-3537-312e-963a-381230e418d6",
                                        "glosses": [
                                            "в бридже в паре, сделавшей последний заказ — партнёр игрока, который первый заявил заказанный козырь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21bac4b-50f0-49d2-b221-9017896be186",
                        "source_entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                        "source_sense_id": "86a08d1e-fb32-3adc-ac8f-278cf9e7d6c2",
                        "source_sense_description": "an idiot",
                        "target_lang_word": "о́лух",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "о́лух",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f702428-6cc4-3f85-b890-1b06268d7117",
                                        "entry_id": "93d220f7-950f-36fe-9f6c-d0a9ce7b89f6",
                                        "glosses": [
                                            "дурак, болван, простофиля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c32d455-6f29-4ff8-af75-63303e88fcfe",
                                                "sense_id": "6f702428-6cc4-3f85-b890-1b06268d7117",
                                                "text": "Какой же я олух! — воскликнул он, — на какую удочку попался!"
                                            },
                                            {
                                                "example_id": "668bb98c-9b64-4e22-b59f-c564d0e68246",
                                                "sense_id": "6f702428-6cc4-3f85-b890-1b06268d7117",
                                                "text": "Спрашиваю я теперь себя, маточка, как же это я жил до сих пор таким олухом, прости господи? Что делал? Из каких я лесов?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
