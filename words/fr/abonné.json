                    "frequency": "High",
                    "semantic_group_id": "souscription",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>abonné</w> reçoit son journal tous les matins avant sept heures."
                        },
                        {
                            "text": "Le théâtre propose un tarif réduit pour chaque <w>abonné</w> de la saison."
                        }
                    ],
                    "common_phrases": [
