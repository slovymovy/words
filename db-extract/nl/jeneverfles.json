                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e132106-7873-46b6-92f9-6b5a69efa1b1",
                                "sense_id": "a838b269-58bd-3ecd-a4fa-2324eccc5bd0",
                                "text": "Het was De Wit die, wijzend naar de lege jeneverfles tegen de plint, eindelijk het stilzwijgen verbrak: Éerst hebben ze gefept, en toen geflept."
                            },
                            {
                                "example_id": "b5ff0faa-e7a2-48c4-ba68-6ad096d9311a",
                                "sense_id": "a838b269-58bd-3ecd-a4fa-2324eccc5bd0",
                                "text": "De Nederlandse Rijksdienst voor Cultureel Erfgoed kreeg de jeneverfles opgestuurd, en stelde vast dat die tussen 1880 en 1900 gemaakt was."
                            }
                        ]
                    }
