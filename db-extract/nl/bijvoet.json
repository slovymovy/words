                                    {
                                        "sense_id": "06662e7b-3fb8-3f79-9145-4573551449bf",
                                        "entry_id": "bf5467a8-2546-3074-99cd-2ab0e23659d7",
                                        "glosses": [
                                            "Any of several aromatic plants of the genus Artemisia native to Europe and Asia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fa7e54e-c78f-3b0a-8613-59c30d31ed5e",
                                        "entry_id": "bf5467a8-2546-3074-99cd-2ab0e23659d7",
                                        "glosses": [
                                            "Artemisia vulgaris, traditionally used medicinally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6e2ccd-04aa-48b8-9668-df0cd8674b0a",
                                                "sense_id": "5fa7e54e-c78f-3b0a-8613-59c30d31ed5e",
                                                "text": "Mugwort is with good success put among other herbs that are boiled, for women to sit over the hot decoction to draw down their courses, to help the delivery of the birth and expel the afterbirth, as also for the obstructions and inflammations of the mother."
                                            },
                                            {
                                                "example_id": "4097eb9a-bf9b-4c4f-bc8c-1066d7564a62",
                                                "sense_id": "5fa7e54e-c78f-3b0a-8613-59c30d31ed5e",
                                                "text": "Peony would keep away any kind of storms. Mugwort hung over doorways on Midsummer's Day, June 24, would keep off lightning, as St. John's-Wort would if gathered before sunrise on that day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47aa8870-0093-462d-9232-9baed0ef3dd8",
                        "source_entry_id": "2e8b7a46-b67d-3562-a53c-25d3b6290504",
                        "source_sense_id": "83b9f78d-6b2b-3c20-8f52-6a78cb25fc21",
                        "source_sense_description": "Artemisia vulgaris, een plant uit de composietenfamilie Asteraceae",
                        "target_lang_word": "armoise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                        "entry_id": "39fff2d5-dcaf-37cf-bd92-fbbbfc0eb440",
                                        "glosses": [
                                            "Nom usuel donné à plusieurs plantes du genre Artemisia, de la famille des Asteraceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f11f35-a99b-4cdd-82a2-ec6d6e8c847c",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "Des perdrix, entre les tiges d’armoise parfumée, se coulaient, leur lourd arrière-train laissant sur les herbes un sillage sitôt redressé."
                                            },
                                            {
                                                "example_id": "5763401e-c7c0-45d5-9ec1-9763d69b016e",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "[…] ; la végétation, très dégradée, se réduit, pour l'ordinaire, à une garrigue appauvrie, à un tomillar parfumé, avec des plaques d’armoises et d’alfa ([…])."
                                            },
                                            {
                                                "example_id": "5299ab2b-e6fe-42e0-a11f-351770526d81",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "Après quoi nous fumions, soit des feuilles séchées d’armoise, soit une tige mince et craquante que l’on appelait du bois de pipe."
                                            },
                                            {
                                                "example_id": "ec798e43-3da1-44fd-965b-529f904877d6",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "L’appartement allait être irrespirable pendant deux jours car le père préparait son tabac du mois. Il faisait dessécher sur son réchaud à gaz des feuilles d’armoise qui marinaient depuis un certain temps dans la saumure."
                                            },
                                            {
                                                "example_id": "b07d02ba-6de2-40f1-973c-006aa78893a4",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "Bientôt l’été tricote des orages au galop, armoises et sauges parfumées\nSuccombent dans les champs d’août; dans la grange revit le chant du zéphyr!"
                                            },
                                            {
                                                "example_id": "1e93c80e-01fd-4bac-8e84-9bbe69f2a882",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "J’apprends que l’absinthe est fabriquée à base d’armoise. Les Égyptiens ne trempaient-ils pas de l’armoise dans le vin pour s’en servir comme remède contre diverses maladies ?"
                                            },
                                            {
                                                "example_id": "31925d97-6256-43f3-b658-541c4f5a6081",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "L’armoise commune est d’un grand usage en médecine, comme stimulante, tonique, etc."
                                            },
                                            {
                                                "example_id": "54951656-8544-4c39-8f19-b40b35af7fe3",
                                                "sense_id": "c9024d1a-4887-3272-be80-cf1e0ab6a2f0",
                                                "text": "L’absinthe, l’estragon sont des armoises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
