                "senses": [
                    {
                        "sense_id": "7ffce864-2f78-32d6-95c5-4683acc62e2c",
                        "entry_id": "f3cbadf2-4f85-3cf7-82fe-c7ca74a8fcbe",
                        "glosses": [
                            "Émission de lave sans projection ni écoulement, qui forme aiguille ou dôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05237578-a08d-49ac-842f-532dac62d184",
                                "sense_id": "7ffce864-2f78-32d6-95c5-4683acc62e2c",
                                "text": "Une extrusion visqueuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ac0b979-d970-343e-8181-8c9cacc75824",
                        "entry_id": "f3cbadf2-4f85-3cf7-82fe-c7ca74a8fcbe",
                        "glosses": [
                            "Procédé de fabrication en continu de produits au moyen d'une boudineuse ou d'une filière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d416a52-a05e-4cad-8d6d-ab41dea3f017",
                                "sense_id": "1ac0b979-d970-343e-8181-8c9cacc75824",
                                "text": "L'extrusion s'applique à divers produits comme les métaux (voir l'article filage), les matières plastiques, les caoutchoucs, les matériaux composites, mais aussi l'argile, les pâtes alimentaires, etc."
                            },
                            {
                                "example_id": "986c4cb1-e32b-47bc-be4b-2cbeba4495d4",
                                "sense_id": "1ac0b979-d970-343e-8181-8c9cacc75824",
                                "text": "Leur mise en œuvre pour obtenir les formes désirées est faite par extrusion, par moulage avec injection, thermoformage, moulage avec soufflage ou moulage avec compression."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c9f1cac-9453-3e5f-b8fd-92fe3ba59f80",
                        "entry_id": "f3cbadf2-4f85-3cf7-82fe-c7ca74a8fcbe",
                        "glosses": [
                            "Type d'effets spéciaux applicables à un dessin vectoriel, consistant à créer une forme tridimensionnelle à partir d'un objet plan."
                        ],
                        "tags": [
                            "Infographie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f18c1048-f66e-36b5-afc7-6855feee1d2a",
                        "entry_id": "f3cbadf2-4f85-3cf7-82fe-c7ca74a8fcbe",
                        "glosses": [
                            "Processus affectant un tissu cellulaire, au cours duquel une cellule s’extrait du tissu et se transforme en cellule migratrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8721f0-16b2-49f4-8964-ab4d52ab2e80",
                                "sense_id": "f18c1048-f66e-36b5-afc7-6855feee1d2a",
                                "text": "Les tissus sont formés essentiellement de cellules épithéliales formant des monocouches. Au cours du développement, les cellules peuvent parfois quitter ces monocouches par un processus appelé transition épithélio-mésenchymateuse. Ce processus correspond à l'extrusion d’une cellule hors du tissu et à sa transformation en cellule migratrice."
                            }
                        ]
                    }
                ],
