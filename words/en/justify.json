{
    "word_family": [
        "justification",
        "justifiable",
        "unjustified",
        "unjustifiable",
        "justifier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "866a428f-b23b-3f89-87f2-f58c2d712e4f",
                    "sense_definition": "To be a good or acceptable reason for something; to warrant a particular action or state.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high cost of the project is hard to <w>justify</w> given the limited benefits it provides.",
                            "target_lang_translations": {
                                "ru": "Высокую стоимость проекта трудно <w>оправдать</w>, учитывая те ограниченные выгоды, которые он приносит."
                            }
                        },
                        {
                            "text": "Nothing can <w>justify</w> rude behavior toward staff members in this office.",
                            "target_lang_translations": {
                                "ru": "Ничто не может <w>оправдать</w> грубое поведение по отношению к сотрудникам в этом офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "vindicate"
                    ],
                    "common_phrases": [
                        "justify the cost",
                        "hard to justify",
                        "justify the means"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить веским или приемлемым основанием для чего-либо; подтверждать целесообразность действия или состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "служить оправданием для затрат или поведения"
                            },
                            {
                                "target_lang_word": "обосновывать",
                                "target_lang_sense_clarification": "приводить убедительные доводы в пользу чего-либо"
                            },
                            {
                                "target_lang_word": "объяснять",
                                "target_lang_sense_clarification": "находить причины или основания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09c1f0f3-b842-3f71-8edf-9c2219cd4bcc",
                    "sense_definition": "To give reasons for one's own actions or to argue that one is right.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt she did not need to <w>justify</w> herself to anyone after making her decision.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что ей не нужно ни перед кем <w>оправдываться</w> после принятия решения."
                            }
                        },
                        {
                            "text": "Stop trying to <w>justify</w> your actions and just admit that you made a mistake.",
                            "target_lang_translations": {
                                "ru": "Перестань пытаться <w>обосновать</w> свои действия и просто признай, что совершил ошибку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "justify oneself",
                        "justify your actions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить доводы в защиту своих действий или доказывать свою правоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдываться",
                                "target_lang_sense_clarification": "приводить доводы в свою защиту"
                            },
                            {
                                "target_lang_word": "обосновывать",
                                "target_lang_sense_clarification": "доказывать правомерность своих поступков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e486b966-6ca8-3541-a4d0-11f95e2ddc74",
                    "sense_definition": "To align text on a page so that both the left and right margins are straight.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>justify</w> the text to make the document look more professional.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>выровнять</w> текст по ширине, чтобы документ выглядел более профессионально."
                            }
                        },
                        {
                            "text": "The software allows you to <w>justify</w> paragraphs with a single click.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет <w>выравнивать</w> абзацы одним щелчком мыши."
                            }
                        }
                    ],
                    "common_phrases": [
                        "justify the text",
                        "fully justify"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in typography and word processing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выравнивать текст на странице так, чтобы и левый, и правый края были ровными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выравнивать",
                                "target_lang_sense_clarification": "по ширине страницы"
                            },
                            {
                                "target_lang_word": "форматировать",
                                "target_lang_sense_clarification": "задавать расположение текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6473b67a-f467-3833-a0da-89ba35b3c69b",
                    "sense_definition": "To declare someone free of blame or sin, especially in a religious or legal context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "absolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theological doctrine explains how faith can <w>justify</w> a person before God.",
                            "target_lang_translations": {
                                "ru": "Теологическая доктрина объясняет, как вера может <w>оправдать</w> человека перед Богом."
                            }
                        },
                        {
                            "text": "The court's decision served to <w>justify</w> the defendant in the eyes of the public.",
                            "target_lang_translations": {
                                "ru": "Решение суда послужило тому, чтобы <w>оправдать</w> подсудимого в глазах общественности."
                            }
                        }
                    ],
                    "synonyms": [
                        "vindicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or formal legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять кого-либо свободным от вины или греха, особенно в религиозном или юридическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "признавать невиновным в суде"
                            },
                            {
                                "target_lang_word": "отпускать грехи",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}