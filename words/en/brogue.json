{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80187a15-dd56-3e00-82a9-c353f47b3745",
                    "sense_definition": "A sturdy leather shoe featuring decorative perforations and wingtips.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a pair of brown leather <w>brogues</w> to wear to the office.",
                            "target_lang_translations": {
                                "ru": "Он купил пару коричневых кожаных <w>брогов</w>, чтобы носить их в офис."
                            }
                        },
                        {
                            "text": "Polishing his <w>brogues</w> before every formal meeting was part of his routine.",
                            "target_lang_translations": {
                                "ru": "Чистка <w>брогов</w> перед каждой официальной встречей была частью его привычного распорядка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather brogues",
                        "pair of brogues"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочная кожаная обувь с декоративной перфорацией и характерными узорчатыми швами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "броги",
                                "target_lang_sense_clarification": "туфли с декоративной перфорацией"
                            },
                            {
                                "target_lang_word": "туфли с перфорацией",
                                "target_lang_sense_clarification": "модель обуви с узором из отверстий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a8435b3-8c2e-3b9b-a470-f5564c1a0be4",
                    "sense_definition": "A strong regional accent, especially an Irish or Scottish accent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor spoke with a thick Irish <w>brogue</w> throughout the entire performance.",
                            "target_lang_translations": {
                                "ru": "На протяжении всего спектакля актёр говорил с сильным ирландским <w>акцентом</w>."
                            }
                        },
                        {
                            "text": "Her distinctive Scottish <w>brogue</w> made her voice instantly recognizable on the radio.",
                            "target_lang_translations": {
                                "ru": "Её характерный шотландский <w>говор</w> делал её голос сразу узнаваемым на радио."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Irish brogue",
                        "Scottish brogue",
                        "thick brogue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметный региональный акцент, в особенности ирландский или шотландский."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциальный акцент",
                                "target_lang_sense_clarification": "региональное произношение"
                            },
                            {
                                "target_lang_word": "резкий акцент",
                                "target_lang_sense_clarification": "сильный диалектный говор"
                            },
                            {
                                "target_lang_word": "ирландский акцент",
                                "target_lang_sense_clarification": "характерное ирландское произношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6f2af45-7511-3fd6-8fd1-ce63e5337c54",
                    "sense_definition": "A crude, heavy shoe historically made of untanned leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum exhibited an ancient <w>brogue</w> worn by rural laborers centuries ago.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен древний <w>башмак</w>, который века назад носили сельские труженики."
                            }
                        },
                        {
                            "text": "Travelers across the bog lands relied on simple leather <w>brogues</w> for protection.",
                            "target_lang_translations": {
                                "ru": "Путники, пересекавшие болота, полагались на простые кожаные <w>башмаки</w> для защиты ног."
                            }
                        }
                    ],
                    "synonyms": [
                        "brogan"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical type of footwear"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубая, тяжёлая обувь, которую исторически изготавливали из сыромятной кожи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый башмак",
                                "target_lang_sense_clarification": "тяжёлая историческая обувь"
                            },
                            {
                                "target_lang_word": "башмак",
                                "target_lang_sense_clarification": "простая кожаная обувь"
                            },
                            {
                                "target_lang_word": "поршень",
                                "target_lang_sense_clarification": "старинная простая обувь из цельного куска кожи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "506056c5-7757-32ab-ad87-eca7cbe1ccfa",
                    "sense_definition": "To speak with a brogue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He usually tries to conceal his background, but he <w>brogues</w> when he gets emotional.",
                            "target_lang_translations": {
                                "ru": "Обычно он пытается скрыть своё происхождение, но <w>говорит с акцентом</w>, когда начинает волноваться."
                            }
                        },
                        {
                            "text": "She was effortlessly <w>broguing</w> while telling old stories from the countryside.",
                            "target_lang_translations": {
                                "ru": "Она непринуждённо <w>говорила с акцентом</w>, рассказывая старые деревенские истории."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с характерным региональным (особенно ирландским) акцентом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить с акцентом",
                                "target_lang_sense_clarification": "иметь сильное диалектное произношение"
                            },
                            {
                                "target_lang_word": "говорить с ирландским акцентом",
                                "target_lang_sense_clarification": "звучать как уроженец Ирландии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f17058-8b18-3a0c-9bb5-7e63d94f75db",
                    "sense_definition": "To walk or travel on foot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>brogue</w> along the muddy lane after the cart broke down.",
                            "target_lang_translations": {
                                "ru": "После того как телега сломалась, нам пришлось <w>брести</w> по грязной дороге пешком."
                            }
                        },
                        {
                            "text": "The tired wanderer was seen <w>broguing</w> slowly toward the village.",
                            "target_lang_translations": {
                                "ru": "Видели, как усталый странник медленно <w>плёлся</w> в сторону деревни."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти пешком, брести или путешествовать пешком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "медленно идти пешком"
                            },
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "идти с трудом пешком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cf72899-76fd-33a1-b178-a3847d5c21ac",
                    "sense_definition": "To kick something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry farmer threatened to <w>brogue</w> the stray dog off his land.",
                            "target_lang_translations": {
                                "ru": "Рассерженный фермер пригрозил <w>выгнать пинками</w> бродячую собаку со своей земли."
                            }
                        },
                        {
                            "text": "He <w>brogued</w> the heavy door until the lock finally gave way.",
                            "target_lang_translations": {
                                "ru": "Он <w>бил ногой</w> в тяжёлую дверь, пока замок наконец не поддался."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пнуть или ударить ногой кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пнуть",
                                "target_lang_sense_clarification": "ударить ногой"
                            },
                            {
                                "target_lang_word": "ударить ногой",
                                "target_lang_sense_clarification": "нанести удар ногой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba26c17-9082-3709-b775-afd34f6eaeea",
                    "sense_definition": "To make a hole in something, such as with an awl.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pierce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler needed to <w>brogue</w> the stiff leather before threading the lace.",
                            "target_lang_translations": {
                                "ru": "Сапожнику нужно было <w>проколоть</w> жёсткую кожу перед тем, как продеть шнурок."
                            }
                        },
                        {
                            "text": "He <w>brogued</w> a small opening into the belt to fit his waist.",
                            "target_lang_translations": {
                                "ru": "Он <w>проделал</w> маленькое отверстие в ремне, чтобы подогнать его по талии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "specialized or regional craft usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проделывать отверстие в чём-либо, например шилом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протыкать",
                                "target_lang_sense_clarification": "делать отверстие шилом или острым инструментом"
                            },
                            {
                                "target_lang_word": "прокалывать",
                                "target_lang_sense_clarification": "делать прокол в коже или плотном материале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a485a9fd-5460-3a86-8448-cf58055ee35a",
                    "sense_definition": "To fish for eels by disturbing the muddy bed or water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys went down to the riverbank to <w>brogue</w> in the shallows.",
                            "target_lang_translations": {
                                "ru": "Мальчишки спустились к берегу реки, чтобы <w>ловить угрей</w> на мелководье."
                            }
                        },
                        {
                            "text": "Locals have been <w>broguing</w> for river eels along this canal for generations.",
                            "target_lang_translations": {
                                "ru": "Местные жители поколениями <w>ловили</w> речных угрей вдоль этого канала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "traditional fishing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить угрей, взмучивая донный ил или воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить угрей",
                                "target_lang_sense_clarification": "традиционный способ рыбалки на угря с взмучиванием ила"
                            }
                        ]
                    }
                }
            ]
        },
        {
