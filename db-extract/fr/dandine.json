                ],
                "senses": [
                    {
                        "sense_id": "d55d14e7-cc93-311a-bc6d-e03853b399ce",
                        "entry_id": "89744060-3a6d-3b06-ae13-dff8d3a475fe",
                        "glosses": [
                            "Tige en métal servant à agiter le vin pendant le collage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96622170-0a0c-34b1-b397-f0744f8ef517",
                        "entry_id": "89744060-3a6d-3b06-ae13-dff8d3a475fe",
                        "glosses": [
                            "Variante de dandinette, méthode de pêche à la ligne qui consiste à animer un leurre de mouvements verticaux répétitifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b25e08-2711-40c2-9b40-f79ec7ea17de",
                                "sense_id": "96622170-0a0c-34b1-b397-f0744f8ef517",
                                "text": "[Ce leurre] se prête notamment bien à des animations en dandine verticale qui vous permettent d’exploiter toute la hauteur de la colonne d’eau."
                            },
                            {
                                "example_id": "0e832b15-ff60-4c23-87a1-c692ffa8cc30",
                                "sense_id": "96622170-0a0c-34b1-b397-f0744f8ef517",
                                "text": "Également appelée pêche à la dandine, cette technique ancestrale et universelle connaît un regain de popularité spectaculaire avec le développement de la pêche verticale profonde, notamment en lac de barrage."
                            },
                            {
                                "example_id": "4484650f-0e65-4635-88e3-9b055f681567",
                                "sense_id": "96622170-0a0c-34b1-b397-f0744f8ef517",
                                "text": "La pêche en dandine consiste à effectuer des mouvements de montée et de descente d’un leurre métallique lourd (tête plombée et leurre souple, cuiller ou jig) pour rechercher des petits poissons pélagiques sous la surface comme des poissons de grandes profondeurs au delà de 80 mètres."
                            }
                        ]
                    }
                ],
