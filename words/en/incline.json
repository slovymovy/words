{
    "word_family": [
        "inclination",
        "recline",
        "disincline",
        "disinclination"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                    "sense_definition": "To have a tendency or willingness to feel, think, or act in a particular way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>incline</w> to believe that she is telling the truth about the event. ",
                            "target_lang_translations": {
                                "ru": "Я <w>склоняюсь</w> к мысли, что она говорит правду о случившемся."
                            }
                        },
                        {
                            "text": "Many voters <w>incline</w> toward supporting the new policy. ",
                            "target_lang_translations": {
                                "ru": "Многие избиратели <w>склоняются</w> к поддержке новой политики."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispose"
                    ],
                    "common_phrases": [
                        "incline toward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь склонность, предрасположенность или готовность чувствовать, думать или поступать определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склоняться",
                                "target_lang_sense_clarification": "к мнению, решению или действию"
                            },
                            {
                                "target_lang_word": "быть склонным",
                                "target_lang_sense_clarification": "иметь склонность к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4adf33d0-1629-342e-8cb4-fd993309cf06",
                    "sense_definition": "To bend, bow, or tilt slightly in a specific direction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will <w>incline</w> his head to show respect during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Он <w>наклонит</w> голову, чтобы выразить уважение во время церемонии."
                            }
                        },
                        {
                            "text": "She decided to <w>incline</w> her body forward to hear the quiet music.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>наклониться</w> вперед, чтобы услышать тихую музыку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incline one's head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка наклонять, наклонять вперед или набок часть тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонять",
                                "target_lang_sense_clarification": "голову или корпус"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "голову в знак уважения или внимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "141706c2-c6a4-3510-81a8-3f8c52b40166",
                    "sense_definition": "To lean or slope away from a vertical or horizontal line.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ground will <w>incline</w> sharply as you walk up the mountain path.",
                            "target_lang_translations": {
                                "ru": "Земля будет круто <w>подниматься</w>, когда вы пойдете вверх по горной тропе."
                            }
                        },
                        {
                            "text": "The walls of the old house began to <w>incline</w> over time.",
                            "target_lang_translations": {
                                "ru": "Стены старого дома со временем начали <w>наклоняться</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь наклон, отклоняться от вертикали или горизонтали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоняться",
                                "target_lang_sense_clarification": "поверхность или строение"
                            },
                            {
                                "target_lang_word": "иметь уклон",
                                "target_lang_sense_clarification": "о дороге, рельефе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98463d2b-6ec6-39d9-b7fc-d5dd08090197",
                    "sense_definition": "An inclined surface, slope, or slant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to walk up a steep <w>incline</w> to reach the top of the hill.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось подниматься по крутому <w>склону</w>, чтобы добраться до вершины холма."
                            }
                        },
                        {
                            "text": "The cyclist struggled as she rode up the steep <w>incline</w>.",
                            "target_lang_translations": {
                                "ru": "Велосипедистке было тяжело ехать вверх по крутому <w>подъему</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steep incline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонная поверхность, подъем или склон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "горы, холма"
                            },
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "наклон дороги или местности"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "дорога, идущая вверх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e21e5f8-c18b-33a3-8949-0204d206235a",
                    "sense_definition": "An entrance or portal to a subway or railway tunnel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tram entered the tunnel through the <w>incline</w> near the street.",
                            "target_lang_translations": {
                                "ru": "Трамвай въехал в тоннель через <w>наклонный въезд</w> рядом с улицей."
                            }
                        },
                        {
                            "text": "Engineers inspected the concrete <w>incline</w> of the old subway line.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели бетонный <w>наклонный ход</w> старой линии метро."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонный въезд или портал в тоннель метро или железной дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонный ход",
                                "target_lang_sense_clarification": "въезд в тоннель метро или ж/д"
                            },
                            {
                                "target_lang_word": "наклонный портал",
                                "target_lang_sense_clarification": "портал тоннеля"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}