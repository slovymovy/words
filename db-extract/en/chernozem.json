                                        "entry_id": "b24fda08-a25f-3bfb-88cc-b365d269e6f8",
                                        "glosses": [
                                            "fruchtbarer, humusreicher Bodentyp im Steppengürtel"
                                        ],
                                        "tags": [
                                            "Bodenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "235b6574-2982-41a4-9e8e-bf438d6258bb",
                                                "sense_id": "394063fe-da61-3964-9ea6-0f17ffec1326",
                                                "text": "„Der gut gewässerte Wurzelballen wird nun locker eingesetzt, und der Raum zwischen Loch und Ballen mit feinster Braunerde oder gar Tschernosem bedeckt und fest angedrückt.“"
                                            }
                                        ],
