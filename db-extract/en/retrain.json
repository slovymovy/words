                        "sense_id": "586c6150-6a70-3c5e-85ae-6444315d433b",
                        "entry_id": "7b95f483-1635-32ff-bd4a-efaa577b2f3f",
                        "glosses": [
                            "An instance of training again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb2b22d-6435-4c2e-9861-e9ce33091b02",
                                "sense_id": "586c6150-6a70-3c5e-85ae-6444315d433b",
                                "text": "This adds a bit of complexity as it means that our solution should not retrain for every request coming in but be able to determine whether a retrain is worth it for a given request or whether the model is already up to date."
                            }
                        ]
                    }
                ],
