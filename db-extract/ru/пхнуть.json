                        "examples": [
                            {
                                "example_id": "b7f02604-9c4a-4677-b189-facfa8b25592",
                                "sense_id": "92ce2d1f-31ef-31f3-8b4f-72f91e285bb1",
                                "text": "Возьмёт он тебя и засадит в острог, в яму пхнёт, а там крысы, лягушки, змеи, и кажинный день тебя будут из ямы вынимать и ― пороть!"
                            },
                            {
                                "example_id": "cc086ad6-31a0-40b1-8698-f00466a7c399",
                                "sense_id": "92ce2d1f-31ef-31f3-8b4f-72f91e285bb1",
                                "text": "Старик пхнул Александру в бок, и она упала, заохав и загремев тяжёлым стулом."
                            }
                        ]
                    }
