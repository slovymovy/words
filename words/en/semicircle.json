                    "frequency": "VeryLow",
                    "semantic_group_id": "measuring tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique surveyor's kit included a brass <w>semicircle</w> in its wooden case."
                        },
                        {
                            "text": "He used the <w>semicircle</w> to determine the bearings between the distant hills."
                        }
                    ],
                    "synonyms": [
