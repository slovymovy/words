{
    "word_family": [
        "мечта",
        "мечтатель",
        "мечтательный",
        "мечтательница",
        "помечтать",
        "замечтаться",
        "мечтание"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66a7caa8-cdde-3e9e-9225-acaae74b8d48",
                    "sense_definition": "Сильно желать чего-либо, страстно стремиться к осуществлению чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "желание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С самого раннего детства он искренне <w>мечтал</w> стать известным врачом.",
                            "target_lang_translations": {
                                "de": "Von frühester Kindheit an <w>träumte</w> er aufrichtig davon, ein berühmter Arzt zu werden."
                            }
                        },
                        {
                            "text": "Мы давно <w>мечтаем</w> поехать в большое путешествие всей дружной семьёй.",
                            "target_lang_translations": {
                                "de": "Wir <w>träumen</w> schon lange davon, mit der ganzen Familie eine große Reise zu unternehmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "грезить",
                        "вожделеть"
                    ],
                    "common_phrases": [
                        "мечтать о будущем",
                        "мечтать о поездке",
                        "мечтать о счастье"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas von ganzem Herzen ersehnen; den intensiven Wunsch haben, ein Ziel zu erreichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "träumen",
                                "target_lang_sense_clarification": "von etwas träumen, einen sehnlichen Wunsch haben"
                            },
                            {
                                "target_lang_word": "sich sehnen",
                                "target_lang_sense_clarification": "ein tiefes Verlangen nach etwas haben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91cec604-d1f3-3765-b9bb-95dfc30ad59d",
                    "sense_definition": "Предаваться мыслям о желаемом, мысленно уноситься в мир грёз и фантазий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "фантазии",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она любит сидеть у открытого окна и тихо <w>мечтать</w> тёплыми вечерами.",
                            "target_lang_translations": {
                                "de": "Sie liebt es, am offenen Fenster zu sitzen und an lauen Abenden still vor sich hin zu <w>träumen</w>."
                            }
                        },
                        {
                            "text": "Хватит просто лежать и <w>мечтать</w>, пора наконец заняться важными делами.",
                            "target_lang_translations": {
                                "de": "Hör auf, einfach nur herumzuliegen und zu <w>tagträumen</w>, es ist an der Zeit, sich wichtigen Dingen zu widmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "грезить",
                        "фантазировать"
                    ],
                    "common_phrases": [
                        "сидеть и мечтать",
                        "любить мечтать"
                    ],
                    "target_lang_definitions": {
                        "de": "Seinen Gedanken nachhängen, Tagträumen nachgehen und sich gedanklich in Fantasiewelten verlieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "träumen",
                                "target_lang_sense_clarification": "im Wachzustand den Gedanken nachhängen"
                            },
                            {
                                "target_lang_word": "tagträumen",
                                "target_lang_sense_clarification": "wach vor sich hin träumen"
                            },
                            {
                                "target_lang_word": "schwelgen",
                                "target_lang_sense_clarification": "in Gedanken oder Träumen schwelgen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e93455e-9708-3272-b9cf-26378a34a451",
                    "sense_definition": "Создавать в мыслях какой-либо образ, рисовать что-либо в воображении.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "фантазии",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художник закрывал глаза и подолгу <w>мечтал</w>, каким будет новый пейзаж.",
                            "target_lang_translations": {
                                "de": "Der Maler schloss die Augen und <w>malte sich</w> lange Zeit <w>aus</w>, wie die neue Landschaft aussehen würde."
                            }
                        },
                        {
                            "text": "Мальчик часто <w>мечтал</w>, будто он отважный капитан на огромном корабле.",
                            "target_lang_translations": {
                                "de": "Der Junge <w>fantasierte</w> oft darüber, ein mutiger Kapitän auf einem riesigen Schiff zu sein."
                            }
                        }
                    ],
                    "synonyms": [
                        "воображать",
                        "фантазировать"
                    ],
                    "common_phrases": [
                        "втайне мечтать"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich etwas im Geiste bildhaft vorstellen; ein Bild oder Szenario in der eigenen Fantasie entwerfen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fantasieren",
                                "target_lang_sense_clarification": "sich etwas in Gedanken ausmalen"
                            },
                            {
                                "target_lang_word": "sich vorstellen",
                                "target_lang_sense_clarification": "im Geist ein Bild erschaffen"
                            },
                            {
                                "target_lang_word": "träumen",
                                "target_lang_sense_clarification": "sich gedanklich ein Bild machen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c7b2438-f655-37c5-a0a1-47c51c265b3f",
                    "sense_definition": "Полагать, считать возможным, питать надежду на что-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "предположение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не смел и <w>мечтать</w>, что его скромная просьба будет столь благосклонно принята.",
                            "target_lang_translations": {
                                "de": "Er <w>wagte</w> nicht einmal <w>zu hoffen</w>, dass seine bescheidene Bitte so wohlwollend aufgenommen werden würde."
                            }
                        },
                        {
                            "text": "Молодой человек наивно <w>мечтал</w>, что старый дядюшка простит ему легкомысленные долги.",
                            "target_lang_translations": {
                                "de": "Der junge Mann <w>machte sich</w> die naive <w>Hoffnung</w>, der alte Onkel würde ihm die leichtfertigen Schulden erlassen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "не сметь мечтать"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas für möglich halten, sich der Hoffnung hingeben oder wagen zu hoffen (gehoben/veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zu hoffen wagen",
                                "target_lang_sense_clarification": "es kaum für möglich halten, dass etwas eintrifft"
                            },
                            {
                                "target_lang_word": "sich einbilden",
                                "target_lang_sense_clarification": "irrig oder naiv annehmen"
                            },
                            {
                                "target_lang_word": "träumen",
                                "target_lang_sense_clarification": "nicht im Traum daran denken / zu träumen wagen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}