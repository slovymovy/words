                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a2c654-a65f-41b8-9849-fbc40b1ebe1c",
                                "sense_id": "b5d8649c-0421-3fa4-8744-aa44782a14ed",
                                "text": "„Die lebenslustige Marlies verreiste gern, war eine leidenschaftliche Opernbesucherin.“"
                            },
                            {
                                "example_id": "c922c8f9-39ac-42ca-b285-f43a5d8c9a1f",
                                "sense_id": "b5d8649c-0421-3fa4-8744-aa44782a14ed",
                                "text": "„Niemand in der Familie hatte sie inspiriert oder gar angehalten, eifrige Opernbesucherin zu werden, so wie sie andererseits niemandes aus der Familie Verständnis für ihre Schwärmerei bekam.“"
                            }
                        ],
