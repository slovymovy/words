        "fr-extract.jsonl": [
            {
                "entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                "word": "yack",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef401a73-2cba-4d60-9029-6a9b3a5cc3aa",
                        "entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                        "tags": [
                            "plural"
                        ],
                        "form": "yacks"
                    },
                    {
                        "form_id": "c7fcebc5-3393-4531-bf81-0d2b638569e4",
                        "entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                        "tags": [
                            "une femelle"
                        ],
                        "form": "dri"
                    },
                    {
                        "form_id": "e33b746b-752f-4420-a44d-2d768cc949cb",
                        "entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                        "tags": [],
                        "form": "yak"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                        "entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                        "glosses": [
                            "Ruminant à cornes et à longs poils, qui vit dans l’Asie centrale sur les hauts plateaux en altitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6de097f-bb71-42db-8f60-d09081f98250",
                                "sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                                "text": "Voyez ce yack des hauts plateaux: protégé par sa toison, il ne craint rien…"
                            },
                            {
                                "example_id": "04e7f56d-17e9-4d3e-a32a-e570fcbede73",
                                "sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                                "text": "Les éleveurs de yaks tirent leurs revenus du lait (transformé en fromage et en beurre) et en second lieu de la viande des animaux excédentaires (en général les mâles castrés). Toutefois, le yak est également un animal de bât, surtout dans les troupeaux transhumants, et l’on utilise en outre couramment son cuir, son long pelage et des excréments comme combustible."
                            },
                            {
                                "example_id": "c9ba8182-7e1e-4e70-bafe-467752b3b634",
                                "sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                                "text": "Les plats se résumaient à des cannages, des lentilles et des plats mijotés de viande comme le yack ou l’ibex."
                            },
                            {
                                "example_id": "ffd41523-69d8-4dac-bfc5-f7e6e330c0fc",
                                "sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                                "text": "Il y a deux espèces ou sous-espèces de yacks : le yack domestique ou yack grogneur, et le yack sauvage ou yack muet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d3a917e-0fdb-449b-af9c-b2748efd7e1d",
                        "source_entry_id": "7f6a7411-522a-39ba-8521-97400d1ab176",
                        "source_sense_id": "7ec7dbdc-d279-33f5-b915-60f0cd3bd4fb",
                        "target_lang_word": "yak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8127a5-d08d-3e01-aed0-10632c57cc64",
                                        "entry_id": "64563bc9-7628-363f-89bd-b20525fc92e5",
                                        "glosses": [
                                            "An ox-like mammal native to the Himalayas, Mongolia, Myanmar, and Tibet with dark, long, and silky hair, a horse-like tail, and a full, bushy mane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c98e637-04ee-432c-bd46-c18b4af5c3fd",
                                                "sense_id": "ba8127a5-d08d-3e01-aed0-10632c57cc64",
                                                "text": "Utilization efficiency of dietary protein in the yak differs with diet composition and feeding level, age, sex, body condition score, and animal production level (e.g., growth, lactation). Researchers reported no difference between lactating and dry cows in crude protein digestibility, although lactating yak tend to consume more feed than dry yak."
                                            },
                                            {
                                                "example_id": "f58b128d-5a4c-406f-a470-195f055711b9",
                                                "sense_id": "ba8127a5-d08d-3e01-aed0-10632c57cc64",
                                                "text": "Attempts are now being made, by selection, to create a new breed of yak (the Datong yak) from such crosses. Hybridization of domestic yak with local cattle, at intermediate elevations, has been practiced for generations. The hybrids inherit some of the good characteristics from each species, but lack the adaptation of the yak to the harsh conditions at higher elevations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4aca5e-913e-3762-afd1-bb12fdebebfe",
                                        "entry_id": "3f7eb7ce-f163-316a-a90c-84c27998574c",
                                        "glosses": [
                                            "To talk, particularly informally but persistently; to chatter or prattle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581b4e03-009f-478c-8b7d-63761944ed11",
                                                "sense_id": "bc4aca5e-913e-3762-afd1-bb12fdebebfe",
                                                "text": "“You'll like Poppet. Nice dog. Wears his ears inside out. Why do dachshunds wear their ears inside out?” “I could not say, sir.” “Nor me. I've often wondered. But this won't do, Jeeves. Here we are, yakking about Jezebels and dachshunds, when we ought to be concentrating our minds […]"
                                            },
                                            {
                                                "example_id": "4b5d36ea-3007-4cf9-85d0-ed3feee03f29",
                                                "sense_id": "bc4aca5e-913e-3762-afd1-bb12fdebebfe",
                                                "text": "And in the last few days Clair's boundless capacity to yak about herself while Melissa listened had turned Chip against her, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4588f94d-dec8-3697-9ae6-6d000209faad",
                                        "entry_id": "3f7eb7ce-f163-316a-a90c-84c27998574c",
                                        "glosses": [
                                            "To vomit, usually as a result of excessive alcohol consumption."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab9564d-7f27-4733-9412-a247a62e8dd2",
                                                "sense_id": "4588f94d-dec8-3697-9ae6-6d000209faad",
                                                "text": "She'll feel better when she yaks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a85d6ea3-c385-3252-b78f-43de65c95150",
                                        "entry_id": "c59865b6-5fea-3789-8e6c-d0e52cc1ec2d",
                                        "glosses": [
                                            "A talk, particular an informal talk; chattering; gossip."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c56b84-9dc5-499e-aab5-a6b243e45e4a",
                                                "sense_id": "a85d6ea3-c385-3252-b78f-43de65c95150",
                                                "text": "Sluggsy said indifferently, ‘You’ll be wised up come morning. Meanwhiles, howsabout shuttin’ that dumb little hashtrap of yours? All this yak is bending my ear. I want some action."
                                            },
                                            {
                                                "example_id": "80375a85-bcd2-440b-a0a3-0a5457d410e2",
                                                "sense_id": "a85d6ea3-c385-3252-b78f-43de65c95150",
                                                "text": "The sudden head-down butt jabbed into someone’s face, is a highly effective way of putting a stop to his yack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad6b33d-ce0c-37fa-9f42-b565d536cf42",
                                        "entry_id": "c59865b6-5fea-3789-8e6c-d0e52cc1ec2d",
                                        "glosses": [
                                            "A laugh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df79dc5f-62bc-4bd2-9b8f-9f81456de10a",
                                                "sense_id": "1ad6b33d-ce0c-37fa-9f42-b565d536cf42",
                                                "text": "Would-be gags from would-be gagsters. And, nine chances out of ten, not a yak in the lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "758d25e4-e291-3fdb-8f08-07854725db4e",
                                        "entry_id": "c59865b6-5fea-3789-8e6c-d0e52cc1ec2d",
                                        "glosses": [
                                            "Vomit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
