            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a34bc1eb-a464-3c58-bd4e-f2257c5d04ce",
                    "sense_definition": "de aandacht richten op iets of iemand om informatie op te nemen of gevaar te vermijden",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet goed <w>opletten</w> in de klas als de leraar spreekt.",
                            "target_lang_translations": {
                                "en": "You must <w>pay</w> close <w>attention</w> in class when the teacher is speaking."
                            }
                        },
                        {
                            "text": "<w>Let</w> goed <w>op</w> zodat je niet verdwaalt in deze grote stad!",
                            "target_lang_translations": {
                                "en": "<w>Watch out</w> carefully so you don't get lost in this big city!"
                            }
                        }
                    ],
                    "synonyms": [
                        "uitkijken",
                        "oppassen",
                        "acht slaan op"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "goed opletten",
                        "scherp opletten"
                    ],
                    "target_lang_definitions": {
                        "en": "To focus one's attention on something or someone in order to absorb information or avoid danger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay attention",
                                "target_lang_sense_clarification": "to focus on what is being said or done"
                            },
                            {
                                "target_lang_word": "watch out",
                                "target_lang_sense_clarification": "to be careful of danger"
                            },
                            {
                                "target_lang_word": "look out",
                                "target_lang_sense_clarification": "to be vigilant or alert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94f7a68-b5c0-3169-b5ac-14ee20c0d0dd",
                    "sense_definition": "bij voortduring aandachtig zijn gedurende een langere periode of een specifieke taak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je tijdens de les niet <w>oplet</w>, moet je niet vreemd opkijken dat je een onvoldoende krijgt.",
                            "target_lang_translations": {
                                "en": "If you don't <w>pay attention</w> during the lesson, you shouldn't be surprised if you get a failing grade."
                            }
                        },
                        {
                            "text": "Ik moest tijdens de hele wandeling <w>opletten</w> om niet uit te glijden over de losse stenen.",
                            "target_lang_translations": {
                                "en": "I had to <w>be careful</w> during the entire walk not to slip on the loose stones."
                            }
                        }
                    ],
                    "synonyms": [
                        "opmerkzaam zijn",
                        "waakzaam zijn"
                    ],
                    "antonyms": [
                        "indommelen",
                        "verslappen"
                    ],
                    "common_phrases": [
                        "voortdurend opletten",
                        "blijven opletten"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain attentive continuously over a longer period or during a specific task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay attention",
                                "target_lang_sense_clarification": "to be attentive or focus one's attention"
                            },
                            {
                                "target_lang_word": "stay alert",
                                "target_lang_sense_clarification": "to remain watchful and focused"
                            },
                            {
                                "target_lang_word": "keep an eye out",
                                "target_lang_sense_clarification": "to maintain awareness over time"
                            }
                        ]
                    }
                }
            ]
        }
