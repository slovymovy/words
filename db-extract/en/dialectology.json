                    },
                    {
                        "translation_id": "7395d362-542d-4e15-b29b-eb33df8d3054",
                        "source_entry_id": "ada9f476-77b5-3106-8510-7312672b0fba",
                        "source_sense_id": "d559b9d1-3e17-3588-8a65-a08d2fa1a292",
                        "source_sense_description": "study of dialects",
                        "target_lang_word": "Dialektforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dialektforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "540407d6-afc0-3586-890b-4d035353befc",
                                        "entry_id": "ad97c7a8-99ea-3f73-beaf-5e6df4e04820",
                                        "glosses": [
                                            "wissenschaftliche Untersuchung von Dialekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9b8580-0e41-461f-b4d9-5fd6fdab6246",
                                                "sense_id": "540407d6-afc0-3586-890b-4d035353befc",
                                                "text": "„Die Nennung der verschiedenen durch die Dialektforschung herausgearbeiteten Abgrenzungskriterien nach außen zeigt deutlich, daß es ein einheitliches sprachliches Merkmal, das alle westfälischen Regionen miteinander verbindet, nicht gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
