                                        "glosses": [
                                            "A person of Serb descent (not necessarily from Serbia). (Compare Serbian.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47413f53-6087-4ad4-8a5f-d5e0d281fd02",
                                                "sense_id": "a0a8191a-0ae1-3acf-becb-d506cb45b330",
                                                "text": "Dozens of NATO peacekeepers were injured after they were attacked by ethnic Serbs in northern Kosovo, during protests over the installation of ethnically Albanian mayors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
