                "senses": [
                    {
                        "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                        "entry_id": "e1effb8a-3637-3dca-a1aa-3d466fb909e4",
                        "glosses": [
                            "technische und organisatorische Voraussetzung für das Zustandekommen eines Spiels beziehungsweise Leistungsanspruch, den ein Spiel an die Spielenden stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711b736b-8659-4927-8fd8-a07891aef525",
                                "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                                "text": "„Dieser allein an Spielzielen und –funktionen orientierten Kategorisierung stehen nach Spielinhalten strukturierte Ordnungsversuche gegenüber […], doch können solche Klassifikationen lediglich typisierend sein, denn viele Bildschirmspiele enthalten mehrere Elemente, von strategischen oder reaktiven Spielanforderungen bis zu Glücks- und Gesellschaftsspiel-Eigenschaften.“"
                            },
                            {
                                "example_id": "ef45c9fd-7343-4936-b46a-93fc4b159008",
                                "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                                "text": "„Um ein Computerspiel überhaupt spielen zu können, muß der Spieler zunächst spezifische Fähigkeiten zur Erfüllung der Spielanforderungen entwickeln.“"
                            },
                            {
                                "example_id": "8c7f6b9f-8ab2-4fd6-b398-526ee90ad15b",
                                "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                                "text": "„Die Erinnerung geht zurück: an Kompositionsseminare von Stockhausen mit lauter böhmischen Dörfern und Ligeti mit komplizierten, zudem wie aus einem Maschinengewehr ohne Punkt und Komma abgeschossenen Analysen; von Boulez mit gelegentlich an eine Mathematik- oder Logik-Vorlesung gemahnenden, aber doch im wesentlichen auf ästhetische Prinzipien zielenden provokanten Theorie-Systeme über hochkomplexe Strukturen und Spielanforderungen; von Kagel, der dem Musizieren plötzlich eine theatralische Komponente ab-, besser: hinzugewann.“"
                            },
                            {
                                "example_id": "a0392e1c-0030-4b6c-a753-3a5fa8d8c886",
                                "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                                "text": "„Die spezifischen Spielanforderungen für die Gruppe Stud01 liegen somit in der erfolgreichen Bewältigung der Reflexionsgelegenheiten im Spielverlauf.“"
                            },
                            {
                                "example_id": "347a3f50-a261-4d2b-8ea7-1fe1c2f66913",
                                "sense_id": "46431516-f960-3934-8bef-dadcf9d6090a",
                                "text": "„Sie tut dies in einer Situation, in der sich Suse schon den Spielanforderungen gegenüber als nicht souverän zeigt und ihre Handlungsmöglichkeiten, auf diese zu reagieren, stark verengt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
