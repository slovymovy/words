                                        "sense_id": "8d8bfd8b-0b6f-3f2c-a815-456f2372a9e8",
                                        "entry_id": "6ee35329-2c1e-3c46-ad4d-f97421d7f1fa",
                                        "glosses": [
                                            "The top or crown of the head."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c621b6-fcf0-4ff3-bfe9-661270ad4545",
                                                "sense_id": "8d8bfd8b-0b6f-3f2c-a815-456f2372a9e8",
                                                "text": "What a while continueth the mould and crowne of our heads to beate and pant, before our braine is well ſetled[…]"
                                            },
                                            {
                                                "example_id": "76df647b-7d6a-4eb6-8fab-9a313a79685a",
                                                "sense_id": "8d8bfd8b-0b6f-3f2c-a815-456f2372a9e8",
                                                "text": "By reaſon whereof the flaſhing of the Water, and ſharpness of the Air, did ſo pierce the Archbiſhop (being above Threeſcore and thirteen years of Age) that he complained the ſame night of a great cold, which he had then taken in the mould of his Head."
                                            },
                                            {
                                                "example_id": "e78c4bc4-8061-439c-837b-4247d9961a58",
                                                "sense_id": "8d8bfd8b-0b6f-3f2c-a815-456f2372a9e8",
                                                "text": "[…]its eyes as large as a mans; and betwixt the two eyes, it hath a hole like the mould in the head of a man, by which it ſucks in and ſpouts out the Water[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
