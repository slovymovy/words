                                "target_senses": [
                                    {
                                        "sense_id": "1f886c4c-66c5-3d8c-acf4-1b89eb8ec6e4",
                                        "entry_id": "ad0667a3-dea8-3453-b152-4c5c1e370809",
                                        "glosses": [
