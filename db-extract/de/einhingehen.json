                                            {
                                                "example_id": "89654944-419c-4bb2-a7c1-f56bd9a1b27f",
                                                "sense_id": "911274fc-3f25-3936-b715-7c6ceb41c92b",
                                                "text": "„Rico ging hinein und setzte sich auf die Bank an der Wand und bewegte sich nicht.“"
                                            },
                                            {
                                                "example_id": "28a444a6-6e50-40e8-8919-94fa95518355",
                                                "sense_id": "911274fc-3f25-3936-b715-7c6ceb41c92b",
                                                "text": "„Und wenn der Fürst hineingeht, soll er durch die Halle des Tors hineingehen und desselben Weges wieder herausgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fccef0a-7505-35e2-8a13-15b509b0665f",
                                        "entry_id": "c0c80d53-7f32-32e8-bb38-2fe1a694bc1c",
                                        "glosses": [
                                            "in etwas Platz haben"
                                        ],
