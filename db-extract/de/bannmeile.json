                    },
                    {
                        "translation_id": "fb4fa298-b100-41fa-bc3e-2023a197621c",
                        "source_entry_id": "f03c8d90-b650-3be8-b041-0ec742b48f1d",
                        "source_sense_id": "2c181131-84dc-375e-a5d7-6a24844f4726",
                        "source_sense_description": "geschützter Bereich um wichtige Institutionen",
                        "target_lang_word": "périmètre de sécurité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périmètre de sécurité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                        "entry_id": "1f1c658a-b154-38a1-9799-8fffd09d9bfd",
                                        "glosses": [
                                            "Espace délimité autour d’une zone sensible, afin d’en assurer la protection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce1a46d-f4ab-4148-8449-4fe60db5fe21",
                                                "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                                "text": "Son mutisme, cette façon de vous regarder sans voir, l’œil mi-clos derrière la fumée de sa cigarette, tissait autour de lui un périmètre de sécurité qui ne se franchissait qu’avec son assentiment."
                                            },
                                            {
                                                "example_id": "438c00d3-4549-4f62-9871-f6c56efac597",
                                                "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                                "text": "Jed arriva avec cinq minutes de retard, aperçut tout de suite l’écrivain à une table du fond. Autour de lui les tables voisines étaient inoccupées, formant une espèce de périmètre de sécurité d’un rayon de deux mètres."
                                            },
                                            {
                                                "example_id": "3a26c9e2-0bcc-4353-a12a-ddbfdff00700",
                                                "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                                "text": "L’écriture me met à nu, détruit une à une mes barrières de protection, défait en silence mon propre périmètre de sécurité."
                                            },
                                            {
                                                "example_id": "e1ef3336-1be3-41d3-b6b2-2a238d2f4ba1",
                                                "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                                "text": "Longtemps associée au périmètre de sécurité et à la longue attente que devait respecter une personne contagieuse, la quarantaine révélait sa vérité que Dominique trouvait sublime : à quarante ans, on récoltait le fruit de ses efforts."
                                            },
                                            {
                                                "example_id": "46d25686-3f26-4ee2-8049-8416319cef92",
                                                "sense_id": "3d3728dd-521d-3732-985c-76aefa9db5fc",
                                                "text": "Les occupants de l’automobile n’ont subi aucune blessure, a informé la police, qui a érigé un périmètre de sécurité sur la scène afin de poursuivre son enquête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
