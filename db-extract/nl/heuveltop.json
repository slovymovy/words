                                                "example_id": "5299c797-575e-439e-a847-21dd0654bffe",
                                                "sense_id": "473c3225-939d-3795-9f74-2cf6dceada08",
                                                "text": "In summer, it is possible to hike to the summit of Mount Shasta."
                                            },
                                            {
                                                "example_id": "446266ab-5ea6-4622-80f7-3b68a01dccb2",
                                                "sense_id": "473c3225-939d-3795-9f74-2cf6dceada08",
                                                "text": "How can I crawl up to reach those heights / And run? / The venom is what keeps me alive / The venom is what keeps me alive / Up to the summit at night / Desperate to find that beating heart of mine that always makes me run"
                                            }
                                        ]
                                    },
