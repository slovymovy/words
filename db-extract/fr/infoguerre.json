                "senses": [
                    {
                        "sense_id": "333cf488-43f0-3c58-bac7-d8150312cd01",
                        "entry_id": "fe9cd59e-6aee-3d9b-b51f-a309b89814ad",
                        "glosses": [
                            "Guerre de l’information que se livrent les services de renseignements de divers pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3206c0-d0c3-4218-a78c-b672e0e96037",
                                "sense_id": "333cf488-43f0-3c58-bac7-d8150312cd01",
                                "text": "Avec l’infoguerre on ouvre l’éventail des objectifs : il ne s’agit plus de vaincre des corps d’armées mais aussi de s’en prendre à des infrastructures civiles et, plus largement à l’esprit de populations entières."
                            },
                            {
                                "example_id": "a2325a09-7cbd-407b-8cd5-a9f997fbc20d",
                                "sense_id": "333cf488-43f0-3c58-bac7-d8150312cd01",
                                "text": "À l’avenir, plus un pays sera avancé technologiquement, plus il sera vulnérable à l’infoguerre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
