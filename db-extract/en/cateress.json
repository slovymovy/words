                        "glosses": [
                            "A woman who caters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c17a88-d913-4914-a998-2175d524cf51",
                                "sense_id": "9855e818-b8e4-34eb-9e87-c568bd43b83c",
                                "text": "With her abundance; she, good cateress,\nMeans her provision only to the good",
                                "translation": "Comus",
                                "english": "Comus"
                            },
                            {
                                "example_id": "273c332b-b403-4d34-a7a6-56cd7cf371e4",
                                "sense_id": "9855e818-b8e4-34eb-9e87-c568bd43b83c",
                                "text": "After a while the mistress of the house arose, and said to the cateress: \" Arise, O my sister, and let us fulfil our debt.\" The cateress left the saloon, and soon returned leading two black hounds , with chains around their necks."
                            },
                            {
                                "example_id": "68e28842-4db4-400c-951b-3912c32afe4f",
                                "sense_id": "9855e818-b8e4-34eb-9e87-c568bd43b83c",
                                "text": "In the kitchen, partly partitioned by a curtain, the cateress and her helper were busy."
                            }
                        ]
                    }
                ],
