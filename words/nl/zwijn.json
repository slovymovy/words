                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwijn</w> me er altijd doorheen als ik de antwoorden niet weet.",
                            "target_lang_translations": {
                                "en": "I always <w>get lucky</w> and scrape through when I don't know the answers."
                            }
                        },
                        {
                            "text": "Soms <w>zwijn</w> ik enorm en win ik de hoofdprijs zonder moeite.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>get incredibly lucky</w> and win the grand prize without any effort."
                            }
