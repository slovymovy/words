                    {
                        "translation_id": "4bf78123-5071-4614-b92a-6271ee53e55e",
                        "source_entry_id": "5ff21c15-4d0d-38f1-95ab-10df04245400",
                        "source_sense_id": "612f8a8f-87c3-38ce-a42b-65ca82ba8943",
                        "source_sense_description": "lower levels of the atmosphere",
                        "target_lang_word": "troposfeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troposfeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                        "entry_id": "d5fd2a45-697b-3023-afe2-b72a5f73f1e3",
                                        "glosses": [
                                            "de onderste 10 kilometer van de dampkring van de aarde waar de weersveranderingen merkbaar zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8b0a2b6-8a92-4284-8329-226f4fe48f11",
                                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                                "text": "Bij die botsing braken de buitenlagen van de ster uiteen, de fotosfeer en de troposfeer, waardoor de stellaire materie vanaf de binnenkant de ruimte in werd uitgestoten en een omringende atmosfeer vormde."
                                            },
                                            {
                                                "example_id": "98df852e-0d72-4982-8e29-f0e8ad1e1756",
                                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                                "text": "De troposfeer (tot 10 km hoogte) zal daardoor opwarmen, de zeespiegel stijgen en wereldwijd zal het klimaat veranderen."
                                            },
                                            {
                                                "example_id": "a01a15e6-6675-468c-82ca-e9caeb6ecabb",
                                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                                "text": "\"Die grotere temperatuurverschillen versterken de zogeheten straalstromen hoog in de troposfeer, een soort stromende luchtrivieren waar vliegtuigen doorheen vliegen. Door die hogere windsnelheden ontstaat meer clear air turbulence (CAT)\", zegt Storer. Deze vorm van turbulentie, de naam zegt het al, doet zich voor bij een strakblauwe hemel, is niet altijd te voorspellen en kan je dus zomaar verrassen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ad28a90-b865-44e6-8b55-956499b917d8",
                        "source_entry_id": "5ff21c15-4d0d-38f1-95ab-10df04245400",
                        "source_sense_id": "612f8a8f-87c3-38ce-a42b-65ca82ba8943",
                        "source_sense_description": "lower levels of the atmosphere",
