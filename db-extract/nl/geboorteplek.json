                "senses": [
                    {
                        "sense_id": "307f1e62-aa63-3c87-9719-b3aabef05a75",
                        "entry_id": "ff730772-071a-3ae2-acfa-9ef44134e2db",
                        "glosses": [
                            "plaats waar men geboren is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ec20cc-a700-442f-affb-b2dc4158295d",
                                "sense_id": "307f1e62-aa63-3c87-9719-b3aabef05a75",
                                "text": "Het eerste wat je ziet als je Komenda binnenrijdt, is een spandoek met Tadej Pogacar erop. De geboorteplek van de geletruidrager in de Tour de France is een gehucht met nog geen duizend inwoners aan de voet van de bergen in Noord-Slovenië. Hier leerde hij fietsen, in de bergen kilometerslang steil omhoog afzien."
                            },
                            {
                                "example_id": "a4a4fff2-094f-4837-8bc7-7c8bc483e2fa",
                                "sense_id": "307f1e62-aa63-3c87-9719-b3aabef05a75",
                                "text": "Alet Boukes, voormalig stadsdichter van het Overijsselse Zwolle, heeft de mooiste zin geschreven over de Achterhoek. Bakker Marcel Stroet schreef hiervoor een prijsvraag uit bij de onthulling op 22 maart van het borstbeeld van de dichter Willem Sluiter tegenover zijn geboorteplek in Neede."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ff1cd0d-8e6a-48cc-bd4f-12baebf90874",
                        "source_entry_id": "ff730772-071a-3ae2-acfa-9ef44134e2db",
                        "source_sense_id": "307f1e62-aa63-3c87-9719-b3aabef05a75",
                        "source_sense_description": "plaats waar men geboren is",
                        "target_lang_word": "cradle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cradle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A bed or cot for a baby, oscillating on rockers or swinging on pivots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ba1c45-fe78-496c-bf3e-6c229bba5bc4",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "No sooner was I crept out of my cradle / But I was made a king, at nine months old."
                                            },
                                            {
                                                "example_id": "023d5d1a-8ce8-4779-9301-4ce612854f82",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "the cradle that received thee at thy birth"
                                            },
                                            {
                                                "example_id": "6cb15a8a-9270-4265-89d0-119fd29be68a",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "Hush-a-by, baby, upon the tree-top; / When the wind blows the cradle will rock; / When the bough breaks the cradle will fall; / Down will come cradle and baby and all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "The place of origin, or in which anything is nurtured or protected in the earlier period of existence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3298c7-edef-4fc5-9234-3fc2e73a8860",
                                                "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                                "text": "a cradle of crime"
                                            },
                                            {
                                                "example_id": "62864615-6cbc-4104-a3c7-63539091f6d6",
                                                "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                                "text": "the cradle of liberty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "Infancy, or very early life."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a039ca-0294-4c83-9782-e84d27a5e0e4",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "from the cradle to the grave"
                                            },
                                            {
                                                "example_id": "0a64f56d-531f-4065-87bb-a4e24b2780f2",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "from their cradles bred together"
                                            },
                                            {
                                                "example_id": "002c41e4-40cf-448f-8d3f-dc9e7e0b1b32",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "a form of worship in which they had been educated from their cradle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a9b403-79b7-3361-b2bd-080f5761c0bd",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "An implement consisting of a broad scythe for cutting grain, with a set of long fingers parallel to the scythe, designed to receive the grain, and to lay it evenly in a swath."
                                        ],
