                                    {
                                        "sense_id": "24f84a7d-7c29-3502-b938-9c56b94e2697",
                                        "entry_id": "4492d274-81f4-39a4-a5a5-4e2164211e3f",
                                        "glosses": [
                                            "Fortschritt zeigend, auf Fortschritt ausgerichtet; sich weiterentwickelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88a007b-330a-4d41-9f32-a11ea6a422f2",
                                                "sense_id": "24f84a7d-7c29-3502-b938-9c56b94e2697",
                                                "text": "Der Parteivorsitzende hatte recht progressive Ideen, zum Beispiel das erwerbsunabhängige Grundeinkommen."
                                            },
                                            {
                                                "example_id": "cfc0c6ae-6420-4ecb-b0db-85b33ad06585",
                                                "sense_id": "24f84a7d-7c29-3502-b938-9c56b94e2697",
                                                "text": "„Ihre progressiven Vorstellungen stehen allerdings oft im Gegensatz zu denen der Trustees, die traditionell konservative britische und australische Kunst bevorzugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a1d7ca1-7ad2-3d53-ba0f-70dc4ba9972c",
                                        "entry_id": "4492d274-81f4-39a4-a5a5-4e2164211e3f",
                                        "glosses": [
                                            "fortschreitend, im Laufe der Zeit zunehmend, sich vergrößernd"
                                        ],
                                        "tags": [
                                            "especially",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd04a7c6-cc51-4629-a957-a36c133a5376",
                                                "sense_id": "9a1d7ca1-7ad2-3d53-ba0f-70dc4ba9972c",
                                                "text": "Dieser Tumor ist progressiv, er wächst."
                                            },
                                            {
                                                "example_id": "d7408217-a396-4034-874f-3690c3ba97ad",
                                                "sense_id": "9a1d7ca1-7ad2-3d53-ba0f-70dc4ba9972c",
                                                "text": "Dieser Steuersatz ist progressiv."
                                            },
                                            {
                                                "example_id": "314e53f7-c025-483c-afc2-1062a3b0e53a",
                                                "sense_id": "9a1d7ca1-7ad2-3d53-ba0f-70dc4ba9972c",
                                                "text": "Der Patient leidet unter progressiver Paralyse."
                                            },
                                            {
                                                "example_id": "5a558eb7-a87d-429c-a13e-5470e3570bdd",
                                                "sense_id": "9a1d7ca1-7ad2-3d53-ba0f-70dc4ba9972c",
                                                "text": "„Der Vorteil einer progressiven Kapitalsteuer liegt darin, mit den unterschiedlichsten Situationen auf flexible, konsistente, vorhersehbare Weise umgehen zu können, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
