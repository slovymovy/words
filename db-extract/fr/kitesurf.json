                        "sense_id": "ad6b053c-d692-33fa-a722-4fd23731a664",
                        "entry_id": "4566f445-5b79-30e9-b36a-ce11078ec612",
                        "glosses": [
                            "Sport nautique qui se pratique avec un équipement composé d’une planche de surf modifiée et d’une voile, genre voile de parapente qui, une fois gonflée et attachée par des sangles autour de la ceinture du surfeur, assure la traction par les rafales de vent."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "62aa9e1d-dc2e-4129-abf1-45aad89ccd7a",
                                "sense_id": "ad6b053c-d692-33fa-a722-4fd23731a664",
                                "text": "Le kitesurf attire les regards des spectateurs qui n’hésitent pas à s’approcher."
                            },
                            {
                                "example_id": "836b464e-d3d9-4be6-a050-c9a505f7a0d9",
                                "sense_id": "ad6b053c-d692-33fa-a722-4fd23731a664",
                                "text": "On y pratique le surf, le kitesurf, le bodyboard et le windsurf."
                            }
                        ]
                    }
