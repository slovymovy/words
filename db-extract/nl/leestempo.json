                        "examples": [
                            {
                                "example_id": "831b5cf0-2863-4672-8222-dbb3457e420b",
                                "sense_id": "bccbc6e6-2788-35c4-8fc4-5204c5b87593",
                                "text": "De jury prees de originele manier waarop Naomi haar verhaal inleidde, haar goede leestempo, heldere stem en de wijze waarop ze het verhaal aan de luisteraars overbracht. Behalve Naomi gaat ook Lisa Niens uit Vilsteren door naar de provinciale finale."
                            },
                            {
                                "example_id": "91be279f-cb6c-4a69-be3d-86a873373f15",
                                "sense_id": "bccbc6e6-2788-35c4-8fc4-5204c5b87593",
                                "text": "Doordat Murakami heel behulpzaam de begin- en eindtijd van de besproken muziekstukken geeft - 'de piano zet het tweede thema in (7:35)'- en die allemaal online voorhanden blijken, is het mogelijk de gedachtenwisseling op de voet te volgen, wat een onbetaalbaar extra oplevert, maar wel in een drastisch gereduceerd leestempo resulteert (uitgeverij Penguin is zo vriendelijk geweest links naar alle relevante Spotify-fragmenten op een rij te zetten)."
                            }
                        ]
                    }
