    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                "word": "eventuality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75112710-5e45-4747-90ba-4b42227450b4",
                        "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "eventualities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                        "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                        "glosses": [
                            "A possible event; something that may happen."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac6620d-9465-4097-a72b-f53852b87ecb",
                                "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                                "text": "Vigil: You are not Prothean. But you are not machine, either. This eventuality was one of many that was anticipated. This is why we sent our warning through the beacons."
                            },
                            {
                                "example_id": "14dcbe0f-9896-4818-b269-da0ee33af9c1",
                                "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                                "text": "England could have met world and European champions Spain but that eventuality was avoided by Sweden's 2-0 win against France, and Rooney's first goal in a major tournament since scoring twice in the 4-2 victory over Croatia in Lisbon at Euro 2004."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0fa532d-65a4-3d86-b33b-36a14054566d",
                        "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                        "glosses": [
                            "An individual's propensity to take notice of events, changes, or facts."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c1309ed-8f45-47eb-8e68-d326be8b22b0",
                        "source_entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                        "source_sense_description": "possible event — see also contingency",
                        "target_lang_word": "éventualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éventualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                        "entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                                        "glosses": [
                                            "Caractère de ce qui est éventuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e4b128-0d85-4265-a32f-cfaa6dc1397c",
                                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                                "text": "Toutes les éventualités se présentèrent : le désert sans ressources, des Américains exaspérés, des Japonais, des Chinois, peut-être des Peaux-Rouges !"
                                            },
                                            {
                                                "example_id": "325bbd48-361e-4bc3-b472-9833dc11eb6f",
                                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                                "text": "Après tout, les conjurés n'étaient pas passés aux actes. Ils pouvaient, à la rigueur, soutenir qu'ils n'avaient fait qu'envisager des éventualités."
                                            },
                                            {
                                                "example_id": "0705661c-5016-47bd-96c2-50e79a85bca2",
                                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                                "text": "L’éventualité de la gifle dissuade l'enfant de déchirer les livres de la bibliothèque paternelle, comme l’éventualité de la contravention dissuade l'automobiliste de stationner, dans la zone bleue, au delà de l'heure marquée au cadran."
                                            },
                                            {
                                                "example_id": "c803e001-9e1c-403d-9329-b977242be5f9",
                                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                                "text": "Elle laisse entendre au dragueur qu'elle est ouverte a toute éventualité. Elle va alors lui donner une série de rendez-vous auxquels elle ne se rendra pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3328b5f0-9475-4d66-b9b0-bf459e168d89",
                        "source_entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                        "source_sense_description": "possible event — see also contingency",
                        "target_lang_word": "Eventualität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eventualität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                        "entry_id": "7060af6c-e635-3c8e-9a2a-372c167c42b5",
                                        "glosses": [
                                            "ein ganz bestimmter, möglicher (eventuell eintreffender) Fall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57c18e4-b9ba-4aa3-b91e-dc01a6224aab",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "Es besteht auch die Eventualität, dass zu dem Thema heute gar keine Entscheidung getroffen wird."
                                            },
                                            {
                                                "example_id": "2c1d21a7-74ad-44fa-a6fa-cdcd88f3f1bc",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "Sie hatte ihrer Meinung nach für jede mögliche Eventualität vorausgeplant."
                                            },
                                            {
                                                "example_id": "58582bbc-44fc-48f2-9ebc-569344d408a4",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "Wir sind auf alle Eventualitäten vorbereitet."
                                            },
                                            {
                                                "example_id": "c4cfdae4-f61d-4335-8257-fe7477d14a05",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "Wir sind für alle Eventualitäten gerüstet."
                                            },
                                            {
                                                "example_id": "0ad9cf76-2fc0-4e65-96af-3c4430a99f1c",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "„Er suchte sich, ebenso wie die Jüngern es taten, alle Eventualitäten vorzustellen, nur mit dem Unterschiede, dass er auf Mutmassungen solcher Art keine Gebäude aufbaute und dass er nicht zwei oder drei, sondern tausend Eventualitäten sah.“"
                                            },
                                            {
                                                "example_id": "fa2c85a2-e734-46eb-906f-e70e1d58c21c",
                                                "sense_id": "79236540-63a2-3c73-8bcf-6b0464268f59",
                                                "text": "„Wenn ich hier von Gewandtheit spreche, so verstehe ich darunter die vollkommene Beherrschung des Spieles, die mit einem Blicke alle Eventualitäten erkennt, aus denen sich ein rechtmäßiger Vorteil ziehen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
