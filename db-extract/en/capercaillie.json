                            {
                                "target_word": "глуха́рь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa13e4a-5432-3aec-b128-2398ca45a499",
                                        "entry_id": "42004470-521f-306e-afbb-12e941ff7d2b",
                                        "glosses": [
                                            "проф. нераскрытое, не поддающееся раскрытию преступление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
