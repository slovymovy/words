                        "examples": [
                            {
                                "example_id": "6770ec3b-b514-420a-bb55-ec1001998da9",
                                "sense_id": "7b53076c-fca6-398e-b1cc-c596957f7843",
                                "text": "Floridsdorf ist mit 4444,3 Hektar Fläche der zweitgrößte Bezirk."
                            },
                            {
                                "example_id": "f211458e-b019-44e8-8049-7a97077f9da6",
                                "sense_id": "7b53076c-fca6-398e-b1cc-c596957f7843",
                                "text": "In Floridsdorf wurde Wiens erster Naschgarten eröffnet, …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59a448a9-3f77-3e4a-9fa1-811f423663e9",
                        "entry_id": "4be62128-a150-30fc-b5af-904c5ecd8b4e",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673b3aba-4474-4798-9efd-27d4954bd878",
                                "sense_id": "59a448a9-3f77-3e4a-9fa1-811f423663e9",
                                "text": "Floridsdorf hat nicht nur prominente Töchter und Söhne hervorgebracht, Floridsdorf hatte auch das Potenzial zur Hauptstadt."
                            },
                            {
                                "example_id": "8954fdd2-72b0-4537-ba52-7d4fc8ed8f71",
                                "sense_id": "59a448a9-3f77-3e4a-9fa1-811f423663e9",
                                "text": "1895, als der Bezirk noch zu Niederösterreich gehörte, hätte Floridsdorf Hauptstadt von Niederösterreich werden sollen."
                            }
                        ],
                        "sense_index_json": "\"2\""
