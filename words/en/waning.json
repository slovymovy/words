                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола wane (убывать, угасать, ослабевать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "ослабевающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "убывающий",
                                "target_lang_sense_clarification": "причастие"
