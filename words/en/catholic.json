    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73a3e2b0-937d-3a4e-ae3d-fa026d1c11a8",
                    "sense_definition": "Relating to the Roman Catholic Church, its beliefs, and its practices.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother attends a <w>Catholic</w> church every Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка посещает <w>католическую</w> церковь каждое воскресное утро.",
                                "zh": "我祖母每个周日上午都会去参加<w>天主教</w>教堂的礼拜。"
                            }
                        },
                        {
                            "text": "Many <w>Catholic</w> schools are known for their high academic standards.",
                            "target_lang_translations": {
                                "ru": "Многие <w>католические</w> школы известны своими высокими академическими стандартами.",
                                "zh": "许多<w>天主教</w>学校以其高学术标准而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman Catholic"
                    ],
                    "antonyms": [
                        "Protestant"
                    ],
                    "common_phrases": [
                        "Catholic church",
                        "Catholic school",
                        "Catholic priest",
                        "Catholic faith"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Римско-католической церкви, её верованиям и обрядам.",
                        "zh": "与罗马天主教会、其信仰及仪式相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "католический",
                                "target_lang_sense_clarification": "относящийся к католицизму"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天主教的",
                                "target_lang_sense_clarification": "形容词，指代天主教相关事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c58ae0e5-5ce2-32d8-a090-a1804902e735",
                    "sense_definition": "Including a wide variety of things; broad, diverse, or all-embracing in range.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "general_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>catholic</w> tastes in music, enjoying everything from classical symphonies to modern jazz.",
                            "target_lang_translations": {
                                "ru": "У неё <w>разносторонние</w> вкусы в музыке: ей нравится всё, от классических симфоний до современного джаза.",
                                "zh": "她在音乐方面有着<w>广泛的</w>品味，从古典交响乐到现代爵士乐，她都喜欢。"
                            }
                        },
                        {
                            "text": "The museum curator has a <w>catholic</w> interest in art, collecting pieces from every continent and era.",
                            "target_lang_translations": {
                                "ru": "Куратор музея проявляет <w>широкий</w> интерес к искусству, собирая экспонаты со всех континентов и эпох.",
                                "zh": "这位博物馆馆长对艺术有着<w>包罗万象的</w>兴趣，收藏了来自各大洲和各个时代的作品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eclectic",
                        "diverse",
                        "broad",
                        "comprehensive",
                        "universal",
                        "all-embracing"
                    ],
                    "antonyms": [
                        "narrow",
                        "limited",
                        "specific"
                    ],
                    "common_phrases": [
                        "catholic tastes",
                        "catholic interests"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually lowercase"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий в себя широкое разнообразие вещей; широкий, разносторонний или всеобъемлющий.",
                        "zh": "包含广泛的事物；范围广阔、多样或包罗万象的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разносторонний",
