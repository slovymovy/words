                        "entry_id": "1eee2a6c-2010-367a-af0a-f39be1b21d0b",
                        "glosses": [
                            "Avantage stipulé, par contrat de mariage, en faveur de l’époux survivant."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
