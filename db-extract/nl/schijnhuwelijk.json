                ],
                "senses": [
                    {
                        "sense_id": "91d37adb-33ba-3041-8ce5-ff14d3c1af20",
                        "entry_id": "ad43f5af-5b65-3867-9055-83e04b448e46",
                        "glosses": [
                            "een huwelijk waarbij de beide partijen niet aan de verplichtingen hebben voldaan (of van plan zijn te voldoen) die de wet aan een huwelijk stelt (zoals diens consummatie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72126104-e7e6-4f04-a9a1-594e03153c37",
                                "sense_id": "91d37adb-33ba-3041-8ce5-ff14d3c1af20",
                                "text": "Net zoals een poging tot een schijnhuwelijk, waar hij eens getuige van was. „Ik vond het al vreemd, want een jongen van 19 wilde met een vrouw van 33 trouwen. Ze zouden elkaar kennen via het schrijven van brieven. Later bleek dat het kinderen van dezelfde moeder waren, broer en zus dus."
                            },
                            {
                                "example_id": "c7cd2b63-fa85-4431-8649-3ab124bf92ff",
                                "sense_id": "91d37adb-33ba-3041-8ce5-ff14d3c1af20",
                                "text": "Fiscalisten raden alleenstaande cliënten daarom wel eens aan om met hun erfgenamen te trouwen. Als de vriendschapsakte fiscale consequenties krijgt, kan dat hier ook een oplossing voor zijn. Misschien voelt het waarachtiger om je erfenis na te laten aan een geregistreerde vriend dan om er een schijnhuwelijk voor aan te gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41f8d6ab-0084-478b-81c0-8fcb8bb84898",
                        "source_entry_id": "ad43f5af-5b65-3867-9055-83e04b448e46",
                        "source_sense_id": "91d37adb-33ba-3041-8ce5-ff14d3c1af20",
                        "source_sense_description": "huwelijk voor de schijn",
                        "target_lang_word": "Scheinehe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheinehe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                                        "entry_id": "a5f6c9db-82a9-37e0-9bc1-5e99375fd6c4",
                                        "glosses": [
                                            "eine Ehe, die zum Schein geführt wird, um irgendwelche Begünstigen zu erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c574e6c-1d8d-48f2-941a-46f973175fba",
                                                "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                                                "text": "Die Scheinehe zwischen Einheimischen und Zugereisten ist nicht immer gern gesehen."
                                            },
                                            {
                                                "example_id": "18850b05-f915-4a99-99bb-8ee45879ed77",
                                                "sense_id": "c9798eaf-3eff-3ce1-af68-fda6e5c2cbdb",
                                                "text": "„Ich überlegte kurz, ob ich mit ihm eine Scheinehe eingehe, damit sich mein Handicap durch einen neuen Namen auf dem ohnehin schon angespannten Wohnungsmarkt wie ein Schweizer Kräuterbonbon auflöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8990ef9e-addb-4601-a077-5facb57c390f",
                        "source_entry_id": "ad43f5af-5b65-3867-9055-83e04b448e46",
