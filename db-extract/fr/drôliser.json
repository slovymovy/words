                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4830ccf7-56fc-4108-92d9-eca28b370559",
                                "sense_id": "5f922553-9b58-31a8-a91b-1638316266df",
                                "text": "Ainsi l’arrivée du « gore » sur les écrans dans les années 60, puis la renaissance au cinéma du « pulp », au cours des années 90, ont fortement contribué à « drôliser » volontairement ou non, un genre qui se voulait tout autre, et qui parfois se prenait trop au sérieux."
                            },
                            {
                                "example_id": "516efe44-b6d8-4c51-8c0f-1cd6393e5daa",
                                "sense_id": "5f922553-9b58-31a8-a91b-1638316266df",
                                "text": "Moi qui voulait^([sic]) drôliser ce post..."
                            },
                            {
                                "example_id": "76de1489-14cb-4ced-a186-ef8d89349ecf",
                                "sense_id": "5f922553-9b58-31a8-a91b-1638316266df",
                                "text": "bon promis j'y pense et je vais essayer de me drôliser (si ça se dit ! la preuve)"
                            }
                        ]
