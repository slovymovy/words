                "senses": [
                    {
                        "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                        "entry_id": "86a4f9ef-9f3b-325e-af74-2ddea0450cb3",
                        "glosses": [
                            "Jacke, die speziell für das Laufen/Joggen konzipiert ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "78347f20-f23f-4e65-a33e-acf3b8fa452b",
                                "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                                "text": "„Erstmals in der zweiten Jahreshälfte habe ich Hoodie und Laufjacke auch ein Halstuch und Handschuhe am Start gehabt.“"
                            },
                            {
                                "example_id": "888a1eb6-3695-44b4-b675-bac274152e68",
                                "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                                "text": "„Am Ende habe ich mich sogar geärgert, dass ich die dünne Laufjacke getragen habe – das kurze Laufshirt hätte auch gereicht.“"
                            },
                            {
                                "example_id": "a34dc0d3-2b2d-4791-9d76-7a40f5606b4d",
                                "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                                "text": "„Elf Grad auf dem Thermometer und damit war es Zeit, die Laufjacke aus dem Schrank zu nehmen.“"
                            },
                            {
                                "example_id": "f5fbbb28-48bc-4e17-b8fa-b2a95f844439",
                                "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                                "text": "„Dank der hohen Elastizität bieten Dir unsere Laufjacken auch bei ausdauerndem Aktivsport einen hervorragenden Tragekomfort.“"
                            },
                            {
                                "example_id": "82a48c06-334c-4722-93c5-a3a669db3710",
                                "sense_id": "c8fab405-a8b3-3d0b-8a30-82c63a23a40c",
                                "text": "„Unsere Laufjacken passen sich beim Sport durch ihr modisches Design und dem raffinierten Schnitt perfekt Deinen Körperproportionen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
