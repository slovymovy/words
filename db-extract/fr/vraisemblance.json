                    {
                        "translation_id": "44f2418b-2ed1-4229-b1c2-8e6469012548",
                        "source_entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "source_sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                        "target_lang_word": "plausibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plausibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The quality of deserving applause, praiseworthiness; something worthy of praise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f440a85-a4ec-435c-be71-e1bbac1db2ac",
                                                "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                                "text": "integrity, fidelity, and other gracious plausibilities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The appearance of truth, especially when deceptive; speciousness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61db0587-2281-4459-9435-46809b3ea56e",
                                                "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                                "text": "Plausibility, I know, can only be unmasked by shewing the absurdities it glosses over, and the simple truths it involves with specious errors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "A plausible statement, argument etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4190e124-957a-4108-adf9-720796e5b26d",
                                                "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                                "text": "She too must shimmer through the gloom o' the grave, / Come and confront me— […] / Striking me dumb, and helping her to speak, / Tell her own story her own way, and turn / My plausibility to nothingness!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The fact of being believable; believability, credibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27289e7b-337e-496c-a0a9-1290465c1c74",
                                                "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                                "text": "The question of the plausibility of the counter-factual is seen as key in all three discussions of allohistorical fiction (as it is in Demandt's and Ferguson's examinations of allohistory) (cf. Rodiek 25–26; Ritter 15–16; Helbig 32)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
