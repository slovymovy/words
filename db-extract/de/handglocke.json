                                "sense_id": "d0e33dc6-0a05-3d3d-b73e-7b72b7d794fd",
                                "text": "Ilmenau - Wenn der Wehrführer mit der Handglocke läutet",
                                "translation": "Ilmenau - When the military leader rings the handbell",
                                "english": "Ilmenau - When the military leader rings the handbell"
                            },
