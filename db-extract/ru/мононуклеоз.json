                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ffcb64-95e3-4255-a36b-414d6850e2e3",
                                                "sense_id": "6ac83065-12fd-326e-ba63-79e60488f687",
                                                "text": "Because many in the audience were very close to one of the speakers, the DJ decided to play the music in mono."
                                            }
                                        ]
