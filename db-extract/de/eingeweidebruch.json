                        "entry_id": "b7debd74-a98f-3496-81d3-1bd3dac7a4a7",
                        "glosses": [
                            "Austritt von Eingeweiden aus der Bauchhöhle durch eine angeborene oder erworbene Öffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654bc009-b676-44dc-88de-eeadeb22ee40",
                                "sense_id": "3ef1c66d-fd7a-3cff-b65f-5397da503a88",
                                "text": "Alle Situationen, die Erhöhung des intraabdominalen Drucks verursachen, wie Verstopfung, Schwangerschaft, Übergewicht und schwere körperliche Arbeit, sind an der Entwicklung von Eingeweidebrüchen beteiligt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
