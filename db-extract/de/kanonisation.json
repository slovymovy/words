                        "entry_id": "c3c85018-8acb-3301-a0e9-9ee5a7b1834e",
                        "glosses": [
                            "Aufnahme in das Verzeichnis der Heiligen (Kanon) durch den Papst"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "dd7d1a79-1bfe-4e86-884a-dc92189c70ea",
                                "sense_id": "b368e3ba-858a-3a5b-a72a-9214520ec031",
                                "text": "Eine Beatifikation ist eine Voraussetzung für die Kanonisation."
                            }
