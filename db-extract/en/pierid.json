                                "target_senses": [
                                    {
                                        "sense_id": "cf0ea2be-995b-3f2a-9eb0-1a426d24a011",
                                        "entry_id": "7a967620-bf02-3b43-92d4-8b412daf0b09",
                                        "glosses": [
                                            "Lépidoptère de la famille des Pieridae, dont la chenille est souvent parasite d'une crucifère."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098ce9a1-5a83-4d0c-9648-3d38ee72e225",
                                                "sense_id": "cf0ea2be-995b-3f2a-9eb0-1a426d24a011",
                                                "text": "Quand on voit le joli papillon la piéride du chou, on ne se doute pas forcément que sa larve est un ravageur redoutable."
                                            },
                                            {
                                                "example_id": "74376fa4-e286-49b4-8860-8e7a4d43b50d",
                                                "sense_id": "cf0ea2be-995b-3f2a-9eb0-1a426d24a011",
                                                "text": "Il suffit de déposer des gourmands de tomates sur un chou, pour éviter que la piéride vienne y pondre, et les ravages dus aux chenilles qui naissent ensuite."
                                            },
                                            {
                                                "example_id": "8ec68171-7c4b-4e7f-b78b-2df8993ba23c",
                                                "sense_id": "cf0ea2be-995b-3f2a-9eb0-1a426d24a011",
                                                "text": "Pour cela, il nous avait fait ramasser dans les jardins des chrysalides de piérides du chou, il nous les avait fait mettre dans des bocaux alignés sur la fenêtre. Jour après jour, nous observions leur sommeil mystérieux, n’arrivant pas à croire que ces espèces de crottes inertes pourraient donner des papillons jaune et blanc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
