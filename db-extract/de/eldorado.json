                "senses": [
                    {
                        "sense_id": "0ee783f6-25e3-3ed8-9224-67f36a1c6ad7",
                        "entry_id": "0ba348bf-88cf-31f0-b4bc-1c8c3399b814",
                        "glosses": [
                            "das Goldland, das Land mit sagenhaften Goldschätzen im Inneren des nördlichen Südamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01c471c-378f-4b27-b6c0-e33998234c18",
                                "sense_id": "0ee783f6-25e3-3ed8-9224-67f36a1c6ad7",
                                "text": "\"Eldorado basiert auf einer kolumbianischen Legende, über die spanische Chronisten im 17. Jahrhundert berichteten.\""
                            },
                            {
                                "example_id": "82c691ee-b46b-4a10-9157-662765623546",
                                "sense_id": "0ee783f6-25e3-3ed8-9224-67f36a1c6ad7",
                                "text": "\"Die Suche nach den Goldschätzen von Eldorado war eine der wesentlichen Triebfedern für die Erkundung und Eroberung Südamerikas durch die Spanier.\""
                            },
                            {
                                "example_id": "574ff2d7-852a-481d-887b-c2e3bd3a1f5d",
                                "sense_id": "0ee783f6-25e3-3ed8-9224-67f36a1c6ad7",
                                "text": "„Einen Beitrag dazu leisten die unzähligen Bergbahnen. Durch sie wird das Gebiet auch zum Eldorado für Gleitschirm- und Deltaflieger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d744458c-5da6-349b-aaab-da51359501e9",
                        "entry_id": "0ba348bf-88cf-31f0-b4bc-1c8c3399b814",
                        "glosses": [
                            "ein Gebiet, das jemandem ideale Voraussetzungen und Entfaltungsmöglichkeiten für seine Lieblingsbeschäftigung bietet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c7e1b304-5f9c-43b0-bcc8-30e8763682dd",
                                "sense_id": "d744458c-5da6-349b-aaab-da51359501e9",
                                "text": "\"Touristenzentren sind ein Eldorado für Diebe und Gauner.\""
                            },
                            {
                                "example_id": "9e583a35-94e7-4f83-b0d2-6ab872c024a0",
                                "sense_id": "d744458c-5da6-349b-aaab-da51359501e9",
                                "text": "„Der Tiergarten, unweit vom Hauptbahnhof, ist das Eldorado der Freizeitläufer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
