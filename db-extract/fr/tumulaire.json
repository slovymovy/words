                "senses": [
                    {
                        "sense_id": "3dc877c4-986b-3394-9ed2-cf501c4d0b7b",
                        "entry_id": "94d2e6dc-c79c-308a-a39b-7750bbdfc9d0",
                        "glosses": [
                            "Qui appartient, qui est relatif aux tombeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe8901d-9323-43c8-8f02-4b1bc20c8742",
                                "sense_id": "3dc877c4-986b-3394-9ed2-cf501c4d0b7b",
                                "text": "La pierre infernale jetée au cœur de cette mère était une des pierres tumulaires du petit cimetière d’Ingouville, …."
                            },
                            {
                                "example_id": "27b744a9-4f57-4dac-a85c-8588778501e2",
                                "sense_id": "3dc877c4-986b-3394-9ed2-cf501c4d0b7b",
                                "text": "Le jour où nous y assistâmes, le cimetière était couvert d’une foule de cierges allumés sur les tombes, et nous vîmes plusieurs pierres tumulaires chargées de fruits, de volailles rôties, … de vin et d’une singulière variété d'offrandes matérielles, que le clergé fit enlever pour son usage personnel."
                            },
                            {
                                "example_id": "2e1bb138-5ee1-40d4-9fef-ab2b98b826c4",
                                "sense_id": "3dc877c4-986b-3394-9ed2-cf501c4d0b7b",
                                "text": "Il règne, sur cette statue tumulaire, un malaise de souffrance dans un sursaut d’orgueil, qui en font une oeuvre profonde, révélatrice."
                            },
                            {
                                "example_id": "a5763da2-c9d8-4db7-b227-758590f26268",
                                "sense_id": "3dc877c4-986b-3394-9ed2-cf501c4d0b7b",
                                "text": "C’était une de ces pierres tumulaires qui sont en Turquie particulières aux femmes, et j’étais assis sur la terre, dans le grand cimetière de Kassim-Pacha."
                            }
                        ]
                    }
                ],
