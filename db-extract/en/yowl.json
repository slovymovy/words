                        "target_lang_word": "gejank",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gejank",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c40dd2bf-8ffe-3c32-bc1e-3dab42f65f3c",
                                        "entry_id": "2b6cfbe6-46d4-38ae-ae05-686f431e5f4a",
                                        "glosses": [
                                            "geluid gemaakt door dieren m.n. kattengejank is bekend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f4c5d6-5ab7-4777-9242-127789ae47a6",
                                                "sense_id": "c40dd2bf-8ffe-3c32-bc1e-3dab42f65f3c",
                                                "text": "Het gejank van de katten in de nacht was zeer hinderlijk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c22ce3-1844-30ba-8fe4-48f60a7f5d5b",
                                        "entry_id": "2b6cfbe6-46d4-38ae-ae05-686f431e5f4a",
                                        "glosses": [
                                            "een klagerig huilend geluid dat mensen en vooral kinderen kunnen maken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45948591-11b2-42e1-899d-25ee26634dc6",
                                                "sense_id": "11c22ce3-1844-30ba-8fe4-48f60a7f5d5b",
                                                "text": "Het gejank van de kinderen maakte de moeder wanhopig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc35d47a-3f61-3944-af43-02f6a4f2b64c",
                                        "entry_id": "2b6cfbe6-46d4-38ae-ae05-686f431e5f4a",
                                        "glosses": [
                                            "het geluid van een strijkinstrument"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b25e94a-d0a8-47de-9c63-de9b2dd42a4b",
                                                "sense_id": "cc35d47a-3f61-3944-af43-02f6a4f2b64c",
                                                "text": "De man vond het geluid van de violen maar kattengejank."
                                            },
                                            {
                                                "example_id": "ba1409b8-e785-401d-aa69-56e0bcd0547c",
                                                "sense_id": "cc35d47a-3f61-3944-af43-02f6a4f2b64c",
                                                "text": "Het orgelspel hield op. ‘Met enkele variaties van Franck besloot Piet Karwiel dit orgelconcert,’ zei de omroeper. ‘U hoort nu tot negen uur een nonstopprogramma van Hawaianmelodieën.’ ‘Dat is wel een beetje erg, dat gejank,’ zei zijn vader, toen de muziek begon, ‘laten we dat maar afzetten.’ ‘Ik houd er veel van,’ zei Frits, ‘ik ben dol op die uithalen van de snaren.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
