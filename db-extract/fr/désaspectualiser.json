                "senses": [
                    {
                        "sense_id": "67e2314d-131f-3144-bdc3-f7970f4d2262",
                        "entry_id": "38a87b6c-9542-3a05-bb92-a8442c4cc8b0",
                        "glosses": [
                            "Enlever son caractère aspectuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1afad32-151c-4d9d-a8b4-f7d94c6a3517",
                                "sense_id": "67e2314d-131f-3144-bdc3-f7970f4d2262",
                                "text": "Une catégorie aspectuelle peut être désaspectualisée et devenir ainsi un temps verbal, dont un exemple fréquent est la transformation du perfectif en prétérite dans nombre de langues indo-européennes (Drossard 1991:85)."
                            },
                            {
                                "example_id": "f0bd9e5b-2436-4b5b-ac45-86864a83f739",
                                "sense_id": "67e2314d-131f-3144-bdc3-f7970f4d2262",
                                "text": "La question qui nous intéresse ici est de savoir où cette évolution vers l’imparfait « prétérit » complètement désaspectualisé en est exactement."
                            }
                        ]
                    }
