                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eed7335f-21c5-3784-b91f-2e3afc455fc8",
                        "entry_id": "17599a2c-feb7-365d-b6ff-0f70d960b284",
                        "glosses": [
                            "ein Luftraum, der für Aktivitäten vorgesehen ist, die eine Gefahr für Luftfahrzeuge darstellen"
