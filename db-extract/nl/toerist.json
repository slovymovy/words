                        "form": "toeristje"
                    },
                    {
                        "form_id": "dcb95457-53a4-40b0-b8df-a2746999fb4d",
                        "entry_id": "de74510d-fce9-3c34-aeb5-1db90b287b4e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "toeristjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                        "entry_id": "de74510d-fce9-3c34-aeb5-1db90b287b4e",
                        "glosses": [
                            "een (mannelijk) persoon die voor zijn plezier reist (een toer maakt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30707eea-d771-4d61-b67d-1a85525bbfc3",
                                "sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                                "text": "In dat land werd hij als een toerist ontvangen."
                            },
                            {
                                "example_id": "a4eb49ac-7d3f-456e-86f1-0a590e49ca2a",
                                "sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                                "text": "'De Route Nationale 7 is nog altijd belangrijk voor ons, omdat ze veel toeristen aanvoert', zegt Sandro Belle (30), chef de cuisine van het Vineum in Tain l'Hermitage, een lunchrestaurant en wijnproeverij, twee jaar geleden geopend door de grote wijnproducent Paul Jaboulet Ainé."
                            },
                            {
                                "example_id": "0368e119-ba3f-4a2e-8486-75effbafb2d4",
                                "sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                                "text": "Het was welbeschouwd belachelijk dat die dingen in de eenentwintigste eeuw nog steeds bestonden, als prehistorische watervogels die op een wonderlijke manier weer tot leven waren gewekt voor de toeristen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7025c800-5210-49c4-975c-4373b2ebaa1d",
                        "source_entry_id": "de74510d-fce9-3c34-aeb5-1db90b287b4e",
                        "source_sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                        "source_sense_description": "een mannelijk persoon die voor zijn plezier reist",
                        "target_lang_word": "Tourist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tourist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                        "entry_id": "fdf87410-5b4f-3066-b014-0449c370d2ff",
                                        "glosses": [
                                            "Person, die zu ihrem Vergnügen reist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c8fae3-8a16-406b-8d67-b6f5f7ce0204",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "Der Ansturm der Touristen gefährdet das Ökosystem des Waldes."
                                            },
                                            {
                                                "example_id": "26e76985-40cd-4988-b5a0-98872795f20c",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "Die Gemeinde erhofft sich zusätzliche Einnahmen durch die Touristen."
                                            },
                                            {
                                                "example_id": "fa176889-3e94-4a31-84db-be3f3b41d427",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "Bisher war ich nur als Tourist in England."
                                            },
                                            {
                                                "example_id": "75bcbb69-b163-446b-9cc3-28252d4f4d11",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "„Der junge Tourist neigt dazu, den zehnten Tag als eine Schneeverwehung auf seinem Weg zu sehen und durch sie hindurchstürmen zu wollen.“"
                                            },
                                            {
                                                "example_id": "ce447ebd-81ed-4998-8dad-56fa4dcb968e",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "„Mit Touristen hätten sie sicher nicht so offen und freundlich gesprochen, dachte ich.“"
                                            },
                                            {
                                                "example_id": "4d7c3a08-5a32-4881-a236-5863a7e63c9a",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "„Die Touristen kamen auch hierher und brachten dieses Treiben mit.“"
                                            },
                                            {
                                                "example_id": "5a4ad58f-0182-4468-9a86-19f7dbe539f6",
                                                "sense_id": "5c25f712-ff8c-3296-9f40-3c961ce3a9eb",
                                                "text": "„Die Touristen schlugen einen Marsch für den Frieden vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "487f3303-725a-4055-bd87-550b93859db9",
                        "source_entry_id": "de74510d-fce9-3c34-aeb5-1db90b287b4e",
                        "source_sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                        "source_sense_description": "een mannelijk persoon die voor zijn plezier reist",
                        "target_lang_word": "tourist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ff52be4-57d2-395a-a3c5-f918dcda564e",
                                        "entry_id": "99a496de-620f-342b-8e38-7ed637fba12b",
                                        "glosses": [
                                            "Someone who travels for pleasure rather than for business."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cf8902d-6825-46ed-86a0-e4c76e17132a",
                                                "sense_id": "1ff52be4-57d2-395a-a3c5-f918dcda564e",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "1b4165c9-7b9e-491c-b903-815208371db4",
                                                "sense_id": "1ff52be4-57d2-395a-a3c5-f918dcda564e",
                                                "text": "The group operating where we were was called the \"Abu Sayyaf\" and specialised in K&R (kidnap and ransom), usually of tourists who would finish up beheaded on TV."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb3f4b2e-32fc-3dd4-a044-737358feb21b",
                                        "entry_id": "99a496de-620f-342b-8e38-7ed637fba12b",
                                        "glosses": [
                                            "One who visits a place, attends a social event or joins a group hobby out of curiosity, wanting to watch or participate without actual commitment or involvement."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08e34d5-0ac0-402f-a8c9-43794f4645bd",
                                                "sense_id": "cb3f4b2e-32fc-3dd4-a044-737358feb21b",
                                                "text": "Marla - the big tourist. The faker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7ec106-6094-3ffd-9a84-d66c2e245d89",
                                        "entry_id": "99a496de-620f-342b-8e38-7ed637fba12b",
                                        "glosses": [
                                            "One who visits a place, attends a social event or joins a group hobby out of curiosity, wanting to watch or participate without actual commitment or involvement.",
                                            "One who is not a member of a fandom or hobby-oriented community but engages with its discourse to seek attention or approval, often with a disrespectful or harassing behavior towards the norms or long time members of the subculture they are trying to be part of with an increased sense of unwelcome moral self-importance over the enthusiast group. Derived from the term \\\"Problem Tourist\\\"."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "740f2d53-8764-3506-9be5-9b7bc232cda9",
                                        "entry_id": "99a496de-620f-342b-8e38-7ed637fba12b",
                                        "glosses": [
                                            "A member of the visiting team in a match."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6334f363-a0a0-3992-a6e6-5ecd8e797059",
                                        "entry_id": "99a496de-620f-342b-8e38-7ed637fba12b",
                                        "glosses": [
                                            "A guest user on a computer system."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72921f59-609a-433a-a4dc-deae8f9681d3",
                                                "sense_id": "6334f363-a0a0-3992-a6e6-5ecd8e797059",
                                                "text": "This popularity was supposedly due to M.I.T.'s tolerance of \"tourists\" on its system."
                                            },
                                            {
                                                "example_id": "0323a188-9e7b-4dfb-b5c8-6de8ccb8bc99",
                                                "sense_id": "6334f363-a0a0-3992-a6e6-5ecd8e797059",
                                                "text": "The online tourists then uploaded the files to share with other BBS aficionados."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tourist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b846cc2-cc6c-3299-8f4a-ea40bb0a28a4",
                                        "entry_id": "6e2f72d1-86a3-3571-8798-34e5350c047d",
                                        "glosses": [
                                            "To travel as a tourist."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee1a4c3-80fe-4433-8a57-8787630d0669",
                                                "sense_id": "7b846cc2-cc6c-3299-8f4a-ea40bb0a28a4",
                                                "text": "“You can’t go touristing anymore like you used to, but weekends away — traditionally crammed into sneaking out of work slightly early on a Friday in a dash to have some repose — now mean heading out on a Wednesday night, logging on to work and coming back Monday night,” said Tom Caton, the co-founder and chief revenue officer of AirDNA […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e3c74f2-af05-4c4f-a8a8-5bc1d93cb8eb",
                        "source_entry_id": "de74510d-fce9-3c34-aeb5-1db90b287b4e",
                        "source_sense_id": "d451bf5a-eace-329d-9458-a7452dcf1acd",
                        "source_sense_description": "een mannelijk persoon die voor zijn plezier reist",
                        "target_lang_word": "touriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                        "entry_id": "33ffbbee-4f84-3dad-8c55-37179c86c27b",
                                        "glosses": [
                                            "Personne qui voyage pour son plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088a2f88-eac6-449c-85e6-e52add3ba6d9",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Fourchette à la main et vue sur mer, un combo souvent recherché par les touristes mais également apprécié par les locaux qui ne souhaitent pas trop dépenser."
                                            },
                                            {
                                                "example_id": "29fde68a-2c3b-41d9-b967-46b5ef0c2886",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Du touriste, il n’avait ni la curiosité ni la hâte. Il préférait découvrir les détails lentement, peu à peu, au hasard de la vie et des promenades quotidiennes, sans but et sans intention."
                                            },
                                            {
                                                "example_id": "0aa0de49-2f41-4bfa-a7e5-9ee341b82285",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "L’avion allemand qui passe là-haut ne peut noter dans ce coin de village qu’un touriste ou un indiscret."
                                            },
                                            {
                                                "example_id": "40bf2ad5-d393-4e39-9cdb-18066edfeb00",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                                            },
                                            {
                                                "example_id": "d9446bb5-cb76-46b2-8bca-d6a77037dbb4",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "L’artiste, le poète et le touriste se réjouissent ici d’un pittoresque qui fait le désespoir de l’agriculteur."
                                            },
                                            {
                                                "example_id": "2886de40-eb1e-4b58-bcbf-4d1ade5abf81",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "La vie de touriste n’est pas une vie. Le touriste toujours va où va le touriste, aux seules fins de pouvoir narrer chez lui à d’autres touristes des histoires de touristes."
                                            },
                                            {
                                                "example_id": "95ae6d2c-4df8-40d3-8dd4-679302ecd714",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Selon les informations de BFMTV, les touristes faisaient du camping sauvage à proximité de Castellane (Alpes-de-Haute-Provence) et ont décidé d’allumer un feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fba773-6ffc-3ad9-9075-b512e307f768",
                                        "entry_id": "33ffbbee-4f84-3dad-8c55-37179c86c27b",
                                        "glosses": [
                                            "Dilettante."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4263ad79-864d-457e-a2b3-5bc3edf80f7a",
                                                "sense_id": "c3fba773-6ffc-3ad9-9075-b512e307f768",
                                                "text": "Il vient au lycée en touriste, se déplace d’une salle à une autre, en sifflotant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
