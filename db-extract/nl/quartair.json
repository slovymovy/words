                                "target_senses": [
                                    {
                                        "sense_id": "86486118-6d59-3c68-a601-e48f418ed67c",
                                        "entry_id": "285bc9e9-c285-347f-b31f-5f25e2e53fed",
                                        "glosses": [
                                            "jüngster, bis heute andauernder Zeitabschnitt des Känozoikums (Erdneuzeit), der vor etwa 2,6 Millionen Jahren begann; folgt auf das Neogen und umfasst das Pleistozän und das Holozän"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f58d4d-a345-4300-a78e-61166ac6d628",
                                                "sense_id": "86486118-6d59-3c68-a601-e48f418ed67c",
                                                "text": "„In der Kreidezeit und im Paläogen gab es deutlich stärkeren Vulkanismus als im Neogen und Quartär.“"
                                            },
                                            {
                                                "example_id": "1d3ee94c-bb16-467d-8c7d-72d4d5d86ad0",
                                                "sense_id": "86486118-6d59-3c68-a601-e48f418ed67c",
                                                "text": "„Auch sonst war das Quartär, etwas großzügig definiert, eine tektonisch ausgesprochen unruhige Zeit.“"
                                            },
                                            {
                                                "example_id": "8783f317-f783-4448-ba88-d23baa062c33",
                                                "sense_id": "86486118-6d59-3c68-a601-e48f418ed67c",
                                                "text": "„Pleistozän und Holozän bilden zusammen die vor 2,6 Millionen Jahren beginnende Periode des Quartärs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
