                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edd2261-659a-4a68-a28f-3346495bbe1d",
                                                "sense_id": "7fe544fa-c7ec-3523-bc7e-3dd00cfb8f2c",
                                                "text": "Man schneidet die Grenadine am Stielansatz ein und bricht sie auseinander."
                                            },
                                            {
                                                "example_id": "b92a4fec-aaf5-46be-8972-41dbb955bf18",
                                                "sense_id": "7fe544fa-c7ec-3523-bc7e-3dd00cfb8f2c",
                                                "text": "Die Rede ist von den Grenadieren, die ihren Namen von der Ähnlichkeit ihrer luntengezündeten Wurfbomben mit dem Grenadine- Apfel haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "344e2dcd-4631-3d7e-873d-d092833b6bfd",
                                        "entry_id": "8c83183c-9751-3360-ade9-c7e7d088a02a",
                                        "glosses": [
                                            "Sirup oder Saft aus Granatäpfeln, auch aus Orangen und Zitronen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e8b31d-a464-4627-98fb-eae8943733ab",
                                                "sense_id": "344e2dcd-4631-3d7e-873d-d092833b6bfd",
                                                "text": "Ein Glas Orangensaft mit zwei Spritzern Grenadine."
                                            },
                                            {
                                                "example_id": "39225d49-cbcc-4c06-804d-9baa39670c37",
                                                "sense_id": "344e2dcd-4631-3d7e-873d-d092833b6bfd",
                                                "text": "In Südeuropa wird aus dem säuerlichen, weinartig schmeckenden, rotgefärbten Fruchtsaft ein durstlöschender Sirup, „Grenadine“ oder auch ‚Scherbet‘ geheissen, bereitet."
                                            },
                                            {
                                                "example_id": "9c844f4d-d2b5-4133-90b0-043d92f7238d",
                                                "sense_id": "344e2dcd-4631-3d7e-873d-d092833b6bfd",
                                                "text": "Das Samenfleisch findet auch zur Herstellung von Sirup (Grenadine) und als Gewürz für Fleischgerichte Verwendung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
