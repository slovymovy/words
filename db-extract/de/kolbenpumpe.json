                "senses": [
                    {
                        "sense_id": "044dc095-38c4-3e08-a0cf-63df6415a4f7",
                        "entry_id": "73ca0e77-d062-364d-a6d9-10a74361d7c3",
                        "glosses": [
                            "Arbeitsmaschine, die mittels Kolben ein Fluid verdichtet oder nur den Druck erhöht, pumpt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1a733f-e07c-41be-90c1-4c8a6cd14f70",
                                "sense_id": "044dc095-38c4-3e08-a0cf-63df6415a4f7",
                                "text": "„Eine Kolbenpumpe ist eine Maschine zur Förderung von Flüssigkeiten oder Gasen wobei Gase dabei auch verdichtet werden.“"
                            },
                            {
                                "example_id": "5c4cd63b-176c-474f-8596-035de8586249",
                                "sense_id": "044dc095-38c4-3e08-a0cf-63df6415a4f7",
                                "text": "„Die bekannteste Verdrängerpumpe ist die Kolbenpumpe mit geradliniger Hubbewegung.“"
                            },
                            {
                                "example_id": "767f4322-64e5-4877-9cdc-dd91ceede1c4",
                                "sense_id": "044dc095-38c4-3e08-a0cf-63df6415a4f7",
                                "text": "„Im wesentlichen besteht eine Kolbenpumpe aus einem Zylinder mit passendem Kolben, sowie einem Einlaßventil und einem Auslaßventil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
