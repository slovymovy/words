                        "examples": [
                            {
                                "example_id": "e4b43144-0c7f-4e95-a2e7-bdb4b21251b5",
                                "sense_id": "444081eb-6934-3702-9b24-07d0145a75e3",
                                "text": "Au nord-est de l'Italie, à la frontière avec la Slovénie et l'Autriche, la région autonome Frioul-Vénétie-Julienne, peu fréquentée par les touristes, ne manque pas de charme."
                            },
                            {
                                "example_id": "3e72057c-9f22-4a53-a9b2-8f71c1a38ddf",
                                "sense_id": "444081eb-6934-3702-9b24-07d0145a75e3",
                                "text": "Le Frioul-Vénétie-Julienne est une région située tout au nord-est de l’Italie, région en contact avec ses voisines germanique, slovène et vénitienne."
                            }
                        ]
                    }
