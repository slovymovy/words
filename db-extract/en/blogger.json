                    {
                        "translation_id": "770fcd7d-5851-4205-afa0-d4dec9f9307f",
                        "source_entry_id": "5f038527-fb99-3d9a-9710-5247148f3fbe",
                        "source_sense_id": "0a69f36d-c2e5-320c-8a8d-7b869dd0c6c8",
                        "source_sense_description": "contributor to a blog",
                        "target_lang_word": "blogueur",
