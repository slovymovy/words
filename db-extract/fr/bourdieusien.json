                "senses": [
                    {
                        "sense_id": "c5a99dfc-f8cb-313c-8616-ef1289d2bbcd",
                        "entry_id": "b63712ea-a113-315e-8c34-55bb0b3badae",
                        "glosses": [
                            "Qui se réfère spécifiquement à quelques notions-clés développées par le sociologue français Pierre Bourdieu, en particulier l’habitus, le champ, la violence symbolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48bed4f-95a0-4df9-ba2e-c3be70c22762",
                                "sense_id": "c5a99dfc-f8cb-313c-8616-ef1289d2bbcd",
                                "text": "Choses qui ne sont pas toujours possibles au sein de la famille puisque les milieux défavorises sont dit éloignés de la culture scolaire selon le concept bourdieusien."
                            },
                            {
                                "example_id": "90f4a405-bb80-401d-8667-8a52930d10a1",
                                "sense_id": "c5a99dfc-f8cb-313c-8616-ef1289d2bbcd",
                                "text": "Contrairement à ce qu’elle prétend être, l’écriture inclusive est un pur signe de distinction, de domination culturelle et donc d’exclusion, dans le sens bourdieusien du terme, car seul celui qui maîtrise tous les codes peut se payer le luxe de les déconstruire pour son amusement comme d’autres jouent aux mots-croisés afin de tromper leur ennui."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fef4e90-6d0f-3386-a34d-9217659cd378",
                        "entry_id": "b63712ea-a113-315e-8c34-55bb0b3badae",
                        "glosses": [
                            "Qui dérive de, procède de ou rappelle, de façon générale, la sociologie et les méthodes du sociologue français Pierre Bourdieu. Souvent utilisé en collocation avec les mots lexique, vocabulaire, écriture, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9d082f-dc7d-41fd-aa67-e999685411a1",
                                "sense_id": "3fef4e90-6d0f-3386-a34d-9217659cd378",
                                "text": "L’écriture bourdieusienne rebute souvent le profane."
                            },
                            {
                                "example_id": "c9f4b841-2691-4c35-bcc6-d12945ed3ae4",
                                "sense_id": "3fef4e90-6d0f-3386-a34d-9217659cd378",
                                "text": "Parlez-vous bourdieusien ?"
                            }
                        ]
                    }
