{
    "word_family": [
        "crook"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eefbaf8a-fd8a-38a0-8e28-ee93af817612",
                    "sense_definition": "Not straight; having one or more bends or angles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked up the <w>crooked</w> path to the top of the hill.",
                            "target_lang_translations": {
                                "de": "Wir gingen den <w>krummen</w> Pfad bis zur Spitze des Hügels hinauf.",
                                "es": "Subimos por el camino <w>torcido</w> hasta la cima de la colina.",
                                "it": "Abbiamo risalito il sentiero <w>storto</w> fino alla cima della collina.",
                                "fr": "Nous avons remonté le sentier <w>tortueux</w> jusqu'au sommet de la colline."
                            }
                        },
                        {
                            "text": "The old tree had a <w>crooked</w> branch that hung over the river.",
                            "target_lang_translations": {
                                "de": "Der alte Baum hatte einen <w>krummen</w> Ast, der über den Fluss hing.",
                                "es": "El viejo árbol tenía una rama <w>torcida</w> que colgaba sobre el río.",
                                "it": "Il vecchio albero aveva un ramo <w>storto</w> che pendeva sul fiume.",
                                "fr": "Le vieil arbre avait une branche <w>courbée</w> qui pendait au-dessus de la rivière."
                            }
                        }
                    ],
                    "synonyms": [
                        "bent",
                        "curved",
                        "twisted"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "crooked path",
                        "crooked line"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht gerade; mit einer oder mehreren Biegungen oder Winkeln versehen.",
                        "es": "Que no es recto; que tiene una o más curvas, dobleces o ángulos.",
                        "it": "Non dritto; che presenta una o più curve, pieghe o angoli.",
                        "fr": "Qui n'est pas droit ; qui présente une ou plusieurs courbes, des plis ou des angles."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "allgemein für nicht gerade Formen"
                            },
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "oft für Dinge, die nicht in der korrekten Ausrichtung sind"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "torcido",
                                "target_lang_sense_clarification": "que no sigue una línea recta"
                            },
                            {
                                "target_lang_word": "curvo",
                                "target_lang_sense_clarification": "que tiene forma de curva"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "che non è dritto o lineare"
                            },
                            {
                                "target_lang_word": "tortuoso",
                                "target_lang_sense_clarification": "che presenta molte curve, spesso riferito a percorsi"
                            },
                            {
                                "target_lang_word": "curvo",
                                "target_lang_sense_clarification": "che segue un andamento a forma di arco"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "courbé",
                                "target_lang_sense_clarification": "qui a une forme arrondie ou arquée"
                            },
                            {
                                "target_lang_word": "tortueux",
                                "target_lang_sense_clarification": "qui présente de nombreux détours, souvent utilisé pour des chemins ou des rivières"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da491dd-3f4d-316f-89bb-34886dfe85cd",
                    "sense_definition": "Set at an angle; not vertical or square.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That picture is <w>crooked</w> - could you straighten it up for me?",
                            "target_lang_translations": {
                                "de": "Das Bild hängt <w>schief</w> – könntest du es für mich gerade rücken?",
                                "es": "Ese cuadro está <w>torcido</w>, ¿podrías enderezarlo por mí?",
                                "it": "Quel quadro è <w>storto</w>, potresti raddrizzarlo per me?",
                                "fr": "Ce tableau est <w>de travers</w> - pourrais-tu le redresser pour moi ?"
                            }
                        },
                        {
                            "text": "He wore his hat <w>crooked</w> on his head.",
                            "target_lang_translations": {
                                "de": "Er trug seinen Hut <w>schief</w> auf dem Kopf.",
                                "es": "Llevaba el sombrero <w>torcido</w> en la cabeza.",
                                "it": "Portava il cappello <w>storto</w> in testa.",
                                "fr": "Il portait son chapeau <w>de travers</w> sur la tête."
                            }
                        }
                    ],
                    "synonyms": [
                        "askew",
                        "tilted"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "hang crooked"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem Winkel stehend; nicht vertikal oder rechtwinklig.",
                        "es": "Colocado en un ángulo; que no está vertical, nivelado o derecho.",
                        "it": "Posto in un angolo; non verticale, non livellato o non dritto.",
                        "fr": "Placé de travers ; qui n'est pas vertical, droit ou bien aligné."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "nicht gerade hängend oder stehend"
                            },
                            {
                                "target_lang_word": "schräg",
                                "target_lang_sense_clarification": "in einem Winkel zur Horizontalen oder Vertikalen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "torcido",
                                "target_lang_sense_clarification": "que no está en la posición correcta"
                            },
                            {
                                "target_lang_word": "chueco",
                                "target_lang_sense_clarification": "coloquial, que no está derecho o nivelado"
                            },
                            {
                                "target_lang_word": "inclinado",
                                "target_lang_sense_clarification": "que tiene una pendiente o ángulo"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "non posizionato correttamente o dritto"
                            },
                            {
                                "target_lang_word": "inclinato",
                                "target_lang_sense_clarification": "che pende o non è perfettamente verticale"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tordu",
                                "target_lang_sense_clarification": "qui a été déformé ou qui n'est pas dans la position correcte"
                            },
                            {
                                "target_lang_word": "de travers",
                                "target_lang_sense_clarification": "qui n'est pas droit ou bien aligné"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e873a6-0e4a-33c4-bb13-7aebc375a65d",
                    "sense_definition": "Dishonest or illegal; corrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was trying to interest me in another one of his <w>crooked</w> deals.",
                            "target_lang_translations": {
                                "de": "Er versuchte, mich für eines seiner weiteren <w>krummen</w> Dinger zu interessieren.",
                                "es": "Intentaba interesarme en otro de sus negocios <w>corruptos</w>.",
                                "it": "Cercava di coinvolgermi in un altro dei suoi affari <w>loschi</w>.",
                                "fr": "Il essayait de m'intéresser à une autre de ses affaires <w>louches</w>."
                            }
                        },
                        {
                            "text": "The police officer was fired for being <w>crooked</w> and taking bribes.",
                            "target_lang_translations": {
                                "de": "Der Polizist wurde entlassen, weil er <w>betrügerisch</w> war und Bestechungsgelder annahm.",
                                "es": "El oficial de policía fue despedido por ser <w>deshonesto</w> y aceptar sobornos.",
                                "it": "L'agente di polizia è stato licenziato perché <w>corrotto</w> e perché prendeva tangenti.",
                                "fr": "Le policier a été renvoyé pour avoir été <w>corrompu</w> et avoir accepté des pots-de-vin."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "dishonest",
                        "fraudulent"
                    ],
                    "antonyms": [
                        "honest",
                        "upright"
                    ],
                    "common_phrases": [
                        "crooked deal",
                        "crooked politician"
                    ],
                    "target_lang_definitions": {
                        "de": "Unehrlich oder illegal; korrupt.",
                        "es": "Deshonesto, ilegal o corrupto.",
                        "it": "Disonesto, illegale o corrotto.",
                        "fr": "Malhonnête, illégal ou corrompu."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "figurativ für illegale Machenschaften"
                            },
                            {
                                "target_lang_word": "betrügerisch",
                                "target_lang_sense_clarification": "mit der Absicht zu betrügen"
                            },
                            {
                                "target_lang_word": "unehrlich",
                                "target_lang_sense_clarification": "allgemein unaufrichtig oder unredlich"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "corrupto",
                                "target_lang_sense_clarification": "que actúa de forma deshonesta"
                            },
                            {
                                "target_lang_word": "deshonesto",
                                "target_lang_sense_clarification": "que carece de integridad moral"
                            },
                            {
                                "target_lang_word": "chueco",
                                "target_lang_sense_clarification": "coloquial, que actúa de forma ilegal o inmoral"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "disonesto",
                                "target_lang_sense_clarification": "che manca di integrità morale"
                            },
                            {
                                "target_lang_word": "corrotto",
                                "target_lang_sense_clarification": "che agisce in modo illegale o immorale"
                            },
                            {
                                "target_lang_word": "losco",
                                "target_lang_sense_clarification": "riferito ad affari o persone poco trasparenti"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "malhonnête",
                                "target_lang_sense_clarification": "qui manque d'intégrité morale"
                            },
                            {
                                "target_lang_word": "corrompu",
                                "target_lang_sense_clarification": "qui agit de manière illégale ou immorale"
                            },
                            {
                                "target_lang_word": "louche",
                                "target_lang_sense_clarification": "qui manque de transparence, souvent pour des affaires"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a257405-6228-32aa-9795-7d0fe1a93dd8",
                    "sense_definition": "Ill-tempered; grumpy; cranky.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is feeling quite <w>crooked</w> after a long day of work.",
                            "target_lang_translations": {
                                "de": "Er fühlt sich nach einem langen Arbeitstag ziemlich <w>mürrisch</w>.",
                                "es": "Se siente bastante <w>malhumorado</w> después de un largo día de trabajo.",
                                "it": "Si sente piuttosto <w>malumoroso</w> dopo una lunga giornata di lavoro.",
                                "fr": "Il se sent assez <w>mal luné</w> après une longue journée de travail."
                            }
                        },
                        {
                            "text": "Don't mind him, he is just a bit <w>crooked</w> this morning.",
                            "target_lang_translations": {
                                "de": "Beachte ihn nicht, er ist heute Morgen nur ein bisschen <w>gereizt</w>.",
                                "es": "No le hagas caso, solo está un poco <w>irritable</w> esta mañana.",
                                "it": "Non farci caso, è solo un po' <w>irritabile</w> stamattina.",
                                "fr": "Ne fais pas attention à lui, il est juste un peu <w>irritable</w> ce matin."
                            }
                        }
                    ],
                    "synonyms": [
                        "cranky",
                        "grumpy",
                        "irritable"
                    ],
                    "antonyms": [
                        "cheerful",
                        "pleasant"
                    ],
