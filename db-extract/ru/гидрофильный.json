                    },
                    {
                        "translation_id": "c8939133-746c-4483-be8b-3a7754a659cb",
                        "source_entry_id": "72e01097-a3a8-3990-9af6-3e993789653d",
                        "source_sense_id": "2be374fc-017f-3c7b-96b6-0c31f7b8319b",
                        "target_lang_word": "hydrofilowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "87c8e0b2-b7ba-4eae-aa8d-d677d4f4da84",
                        "source_entry_id": "72e01097-a3a8-3990-9af6-3e993789653d",
                        "source_sense_id": "2be374fc-017f-3c7b-96b6-0c31f7b8319b",
                        "target_lang_word": "hydrophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18f08cdc-7705-3cfb-87f6-3fcd120060bf",
                                        "entry_id": "d4199956-bfb3-3f20-b680-30f90217209d",
                                        "glosses": [
                                            "Qui aime l’eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9affb492-c70b-39a3-b533-b9e1735ef7c1",
                                        "entry_id": "d4199956-bfb3-3f20-b680-30f90217209d",
                                        "glosses": [
                                            "Qui absorbe facilement l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8231ee85-c92b-4fbd-bdda-f7d6aea1c244",
                                                "sense_id": "9affb492-c70b-39a3-b533-b9e1735ef7c1",
                                                "text": "Le coton ou la ouate hydrophile utilisé en médecine, pour l’hygiène ou la toilette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a241131-f94d-33d7-8edc-fc89e1b96d9e",
                                        "entry_id": "d4199956-bfb3-3f20-b680-30f90217209d",
                                        "glosses": [
                                            "Se dit d’une substance, ou d’un groupement moléculaire, ayant une affinité pour l’eau et les solvants polaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0537441b-4abf-455a-867a-bf8d70c61784",
                                                "sense_id": "0a241131-f94d-33d7-8edc-fc89e1b96d9e",
                                                "text": "On peut en conclure que les perméants hydrophiles utilisés ne donnent pas lieu à une adsorption sensible sur les structures musculaires (auquel cas R aurait une tendance à augmenter dans le domaine des concentrations faibles)."
                                            },
                                            {
                                                "example_id": "d74c2c0a-0118-4c81-8c1d-9d8ed67bc86a",
                                                "sense_id": "0a241131-f94d-33d7-8edc-fc89e1b96d9e",
                                                "text": "Sur une surface hydrophile comme le verre ordinaire, l’eau s’étale ; on dit qu’elle mouille la surface."
                                            },
                                            {
                                                "example_id": "6ba02d65-e8a7-4bd3-85f0-e438cec5748c",
                                                "sense_id": "0a241131-f94d-33d7-8edc-fc89e1b96d9e",
                                                "text": "Le savon est obtenu à partir d’un mélange d’acide gras et d’une base forte (hydroxyde de sodium ou de potassium). Les molécules le composant sont amphiphiles et leur structure peut être comparée à celle d’une épingle. La tête de l’épingle est hydrophile alors que la tige est composée d’une longue chaîne d’acide gras, hydrophobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5c1fd6-2d57-333b-b123-e42b958fa8ed",
                                        "entry_id": "d4199956-bfb3-3f20-b680-30f90217209d",
                                        "glosses": [
                                            "Se dit d’une plante qui croit dans des milieux inondés durant plusieurs mois de l’année (voir aussi : amphibie). Intermédiaire entre hygrophile et amphibie puis aquatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a777ade-1dc7-4411-888f-059cf5a7207e",
                                                "sense_id": "6b5c1fd6-2d57-333b-b123-e42b958fa8ed",
                                                "text": "Les végétations hydrophiles et halophiles se retrouvent dans les trois zones pratiquement sans changement. Parmi les plantes hydrophiles, les joncs, les typhas, les phragmites, se retrouvent partout, de même que les halophiles : Cressa cretica, Cyperus divers, Atriplex et des Salsola, Suaeda, Salicornia, Halocnemon et Arthocnemon."
                                            },
                                            {
                                                "example_id": "f539824d-3568-4b6f-84df-8108fcb52683",
                                                "sense_id": "6b5c1fd6-2d57-333b-b123-e42b958fa8ed",
                                                "text": "La complexité naturelle culmine près des voies d’eau où la forêt de terra firme s’enrichit des espèces hydrophiles de la forêt de várzea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296b3337-0a32-3154-b21c-0db835f26918",
                                        "entry_id": "d4199956-bfb3-3f20-b680-30f90217209d",
                                        "glosses": [
                                            "Se dit d’une pollinisation qui a lieu dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc2240b-8d48-4300-bd6b-62cd2241933e",
                                                "sense_id": "296b3337-0a32-3154-b21c-0db835f26918",
                                                "text": "La pollinisation est le plus souvent entomophile [chez les Asterides]. Mais le disque nectarifère ─ manque chez le genre Plantago où la pollinisation est anémophile, et le genre Callitriche chez lequel la pollinisation est hydrophile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hydrophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc24a1f-6251-3894-ad0e-45c00525d70e",
                                        "entry_id": "561769a1-198c-3662-8b79-3fbe4f75e676",
                                        "glosses": [
                                            "De la famille des hydrophilidés, coléoptère ovale des eaux douces stagnantes et à la livrée noire uniforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243750be-5a0b-483e-970d-724ae41e1c73",
                                                "sense_id": "9cc24a1f-6251-3894-ad0e-45c00525d70e",
                                                "text": "Avec 5 cm de long, l’hydrophile est l’un des plus gros insecte aquatique d’Europe."
                                            },
                                            {
                                                "example_id": "3712e5af-ef8b-49aa-8136-a29fc6b95cd6",
                                                "sense_id": "9cc24a1f-6251-3894-ad0e-45c00525d70e",
                                                "text": "Des employés du Muséum, de ceux que Balzac appelle les casquettifères, terminaient de lentes manilles sous le gaz. Un rugissement de lion ébranlait parfois le hall d’air dans lequel le quartier semblait s’être glissé avec ses tonneaux, ses chimpanzés et ses hydrophiles…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
