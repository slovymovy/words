                        "entry_id": "5fcbfd8e-791e-387e-bb67-d18c79c47c5b",
                        "glosses": [
                            "In advance of the time when; before."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0ad069-8969-4469-9438-3852a2b60e56",
                                "sense_id": "4398a07a-61c9-3583-8e14-2325714c2888",
                                "text": "Now the hand of the Lord was vpon mee in the euening, afore hee that was escaped came, and had opened my mouth vntill hee came to mee in the morning, and my mouth was opened, and I was no more dumbe."
