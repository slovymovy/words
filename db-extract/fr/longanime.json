                    {
                        "translation_id": "42381fa5-f5db-4c98-a403-20c119c99b97",
                        "source_entry_id": "39b732ae-1881-3ed9-853a-cdaac2f34a9f",
                        "source_sense_id": "e7407198-0d4e-3efa-bc5d-3b16e429fe51",
                        "target_lang_word": "indulgent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indulgent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a66c354-185a-335c-bb47-5968b59e1074",
                                        "entry_id": "cc44a0ba-f4de-360a-9d74-7e69bd2a8064",
                                        "glosses": [
                                            "Disposed or prone to indulge, humor, gratify, or yield to one's own or another's desires, etc., or to be compliant, lenient, or forbearing;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1787752d-c43a-4e5c-8121-6e34637f1e78",
                                                "sense_id": "7a66c354-185a-335c-bb47-5968b59e1074",
                                                "text": "an indulgent parent"
                                            },
                                            {
                                                "example_id": "e3e299b0-f8e4-4a9a-b884-a05ff4127eca",
                                                "sense_id": "7a66c354-185a-335c-bb47-5968b59e1074",
                                                "text": "to be indulgent to servants"
                                            },
                                            {
                                                "example_id": "8df2f0e8-8f9b-47ec-b66e-cb424d279dcd",
                                                "sense_id": "7a66c354-185a-335c-bb47-5968b59e1074",
                                                "text": "An indulgent playmate, Grannie would lay aside the long scratchy-looking letter she was writing (heavily crossed ‘to save notepaper’) and enter into the delightful pastime of ‘a chicken from Mr Whiteley's’."
                                            },
                                            {
                                                "example_id": "0556dd45-5cbf-4bb2-b68f-2d383bdd4c8a",
                                                "sense_id": "7a66c354-185a-335c-bb47-5968b59e1074",
                                                "text": "Mr. Burns is similarly perfectly cast as a heartless capitalist willing to do anything for a quick buck, even if it means endangering the lives of those around him and Marge elegantly rounds out the main cast as a good, pure-hearted and overly indulgent woman who sees the big, good heart (literally and metaphorically) of a monstrous man-brute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93fa8204-0fc9-4730-b831-82d1c9fe809a",
                        "source_entry_id": "39b732ae-1881-3ed9-853a-cdaac2f34a9f",
                        "source_sense_id": "e7407198-0d4e-3efa-bc5d-3b16e429fe51",
                        "target_lang_word": "lenient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "836043da-4461-3f70-8217-ac56b1a1cb54",
                                        "entry_id": "fd77c0e9-cb83-3417-8781-1f4f100de24f",
                                        "glosses": [
                                            "Lax; not strict; tolerant of dissent or deviation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3f47f3-1442-4df0-8250-93873a08fa79",
                                                "sense_id": "836043da-4461-3f70-8217-ac56b1a1cb54",
                                                "text": "The standard is fairly lenient, so use your discretion."
                                            },
                                            {
                                                "example_id": "f1731d41-d014-49b1-a84a-b5ed617c2df5",
                                                "sense_id": "836043da-4461-3f70-8217-ac56b1a1cb54",
                                                "text": "But in other points, as well as this, I was growing very lenient to my master; I was forgetting all his faults, for which I had once kept a sharp look-out. It had formerly been my endeavour to study all sides of his character; to take the bad with the good; and from the just weighing of both, to form an equitable judgment. Now I saw no bad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lenient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bffc23e-241e-3609-9137-58d0cb6de6a5",
                                        "entry_id": "e4902179-30f0-3223-9a71-e7098cf94070",
                                        "glosses": [
                                            "A lenitive; an emollient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
