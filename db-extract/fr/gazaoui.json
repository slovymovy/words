                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea2b031b-2a37-325c-a897-1cb1c5452de6",
                        "entry_id": "fa83e28b-7c69-316b-bc3d-6ebad7045dfd",
                        "glosses": [
                            "Relatif à Gaza ou à la bande de Gaza."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41b835c-3267-4885-8841-1d957b6db90e",
                                "sense_id": "ea2b031b-2a37-325c-a897-1cb1c5452de6",
                                "text": "Ils accueillaient des travailleurs gazaouis régulièrement."
                            },
                            {
                                "example_id": "c8898d44-bd3c-4145-bba8-eedbb8b43e44",
                                "sense_id": "ea2b031b-2a37-325c-a897-1cb1c5452de6",
                                "text": "Tant qu’Israël n’autorise pas l’entrée de matériaux de construction dans la bande, il est tout simplement impossible de dégager les ruines de 4 000 bâtiments. Le ministère des ­Travaux publics gazaoui [du Hamas] interdit aux habitants de le faire eux-mêmes : c’est trop dangereux."
                            },
                            {
                                "example_id": "1b518ae5-e6c0-4d40-be12-7771faa30068",
                                "sense_id": "ea2b031b-2a37-325c-a897-1cb1c5452de6",
                                "text": "Les islamistes gazaouis confrontés à une vague de suicides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5663a41-c4cc-4bb2-a614-2c5b8895cd46",
                        "source_entry_id": "fa83e28b-7c69-316b-bc3d-6ebad7045dfd",
                        "source_sense_id": "ea2b031b-2a37-325c-a897-1cb1c5452de6",
                        "source_sense_description": "Relatif à Gaza",
                        "target_lang_word": "Gazan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gazan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0bd6ec8-6183-35f0-81b9-af6378bb36ef",
                                        "entry_id": "50276ef6-6c47-3801-a293-7ac6543f6de0",
                                        "glosses": [
                                            "A native or inhabitant of Gaza (Gaza City or the Gaza Strip in general)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64c7a915-0bea-4cb1-a3d5-bd51972b3c03",
                                                "sense_id": "a0bd6ec8-6183-35f0-81b9-af6378bb36ef",
                                                "text": "Many Gazans scorn Fatah as corrupt and incompetent, and they dislike Hamas's overzealousness and repression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gazan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6221124-8bd2-3b99-86fd-08a842d2340b",
                                        "entry_id": "2e23238c-ff82-3d48-ae44-7c32387fa630",
                                        "glosses": [
                                            "Of or from Gaza."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66897853-a364-4c3f-a125-8ec6ac33a611",
                                                "sense_id": "e6221124-8bd2-3b99-86fd-08a842d2340b",
                                                "text": "He expressed outrage at the massacres of Jews by Hamas, as he should have, but he has struggled to be equally clear about valuing Gazan lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
