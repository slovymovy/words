                "senses": [
                    {
                        "sense_id": "6a8c2c95-8780-39e9-ae79-00c986887971",
                        "entry_id": "d962620a-8e5d-3874-9a1b-e9fd1c56f456",
                        "glosses": [
                            "per- und polyfluorierte Alkylverbindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da184531-4379-4761-862b-90ecba11936c",
                                "sense_id": "6a8c2c95-8780-39e9-ae79-00c986887971",
                                "text": "„Menschen können PFAS vor allem über Nahrung und Trinken aufnehmen, denn die Chemikalien gelangen in Böden, das Grundwasser, Futtermittel, Verpackungen oder ins Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
