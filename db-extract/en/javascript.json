                "translations": [
                    {
                        "translation_id": "b2558c45-ab30-42e2-be0a-98d81a5c902a",
                        "source_entry_id": "e61e7006-20c0-38a3-a347-7f7b067f2e95",
                        "source_sense_id": "4c11f54e-5154-3cc3-87e1-36659bcd64e6",
