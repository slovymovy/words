                        "translation_id": "3c13326b-f540-43dc-84b3-9bf707b58bdb",
                        "source_entry_id": "b10e2593-7a7e-3f92-9021-c123a8b39716",
                        "source_sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                        "source_sense_description": "bank of snow",
                        "target_lang_word": "congère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                                        "entry_id": "28281485-6c1d-3761-95f8-c4f6aa594307",
                                        "glosses": [
                                            "Amas de neige de plus ou moins grande ampleur qui se forme par l’action du vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24dad1a2-3455-4b08-9623-a40336619d68",
                                                "sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                                                "text": "Le blizzard est complétement déchaîné et la neige tombe si vite et si dru que les bâtiments ont l'air de fantômes. Des congères commencent déjà à se former devant les devantures des magasins de Main Street."
                                            },
                                            {
                                                "example_id": "fb923a76-1a06-4d7a-a4f7-e15c8259038d",
                                                "sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                                                "text": "Ils marchèrent pendant une demi-heure, jusqu’au moment où, juste sur leur gauche, une congère se mit soudain à bouger."
                                            },
                                            {
                                                "example_id": "18294b40-2a9d-47b5-b1de-a182df642ae4",
                                                "sense_id": "3d5d9ce6-f833-3e68-bea1-e9997ef1b681",
                                                "text": "Comme on avait mis du temps à se décider, le grand déménagement eut lieu en décembre par un dimanche infernal, neige & congères au rendez-vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a150743f-4375-4bcb-bf85-e59916a4c0c7",
                        "source_entry_id": "b10e2593-7a7e-3f92-9021-c123a8b39716",
                        "source_sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                        "source_sense_description": "bank of snow",
                        "target_lang_word": "Schneewehe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneewehe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0c3da2-bea1-3b4a-ad98-cc4aa127a1be",
                                        "entry_id": "9a955768-959c-30f1-938b-4f9f552789d7",
                                        "glosses": [
                                            "vom Wind zusammengewehte, aufgehäufte Ansammlung von Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2404877-2d13-4efc-a2b7-12ea76cd2fed",
                                                "sense_id": "9c0c3da2-bea1-3b4a-ad98-cc4aa127a1be",
                                                "text": "„Am nächsten Tag würde es keine Schneewehen geben.“"
                                            },
                                            {
                                                "example_id": "995c9033-31da-49ab-99e2-37ec0b2af906",
                                                "sense_id": "9c0c3da2-bea1-3b4a-ad98-cc4aa127a1be",
                                                "text": "„Es war hinter einer Schneewehe verschwunden.“"
                                            },
                                            {
                                                "example_id": "409b04ba-e2a8-4335-b301-aa54a0c26042",
                                                "sense_id": "9c0c3da2-bea1-3b4a-ad98-cc4aa127a1be",
                                                "text": "„Schneewehen sperren die Straßen.“"
                                            },
                                            {
                                                "example_id": "c1af7a00-8b02-486f-ba66-f75b55fec273",
                                                "sense_id": "9c0c3da2-bea1-3b4a-ad98-cc4aa127a1be",
                                                "text": "„Magnea musste also nicht durch große Schneewehen stapfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
