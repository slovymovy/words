                "senses": [
                    {
                        "sense_id": "75d3cd4a-067e-373a-ab43-6f065252c6a0",
                        "entry_id": "407bf5ff-340f-3634-a3d3-10fd0fe4c325",
                        "glosses": [
                            "Espèce minérale appartenant au groupe des silicates, sous-groupe des inosilicates, famille des clinopyroxènes. Sa formule chimique simplifiée CaMgSi₂O₆ en fait un minéral-modèle, un des pôles purs de la solution solide des clinopyroxènes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42bdd85-e6b3-487a-b7bd-eb664d9bbd42",
                                "sense_id": "75d3cd4a-067e-373a-ab43-6f065252c6a0",
                                "text": "Il s’y ajoute aussi de fins débris de hornblende brun vert et de diopside provenant de la microgranulation périphérique des résidus."
                            }
                        ]
                    }
                ],
