                "senses": [
                    {
                        "sense_id": "3d422d1d-8474-3ebc-b3ba-84e821e5b32b",
                        "entry_id": "35256716-0b12-3b3e-bf79-9464d6bca733",
                        "glosses": [
                            "Roche dont le métamorphisme est dû à un simple réarrangement minéralogique sans apport extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aef8535-0b9a-4756-8cc2-454bde99c535",
                                "sense_id": "3d422d1d-8474-3ebc-b3ba-84e821e5b32b",
                                "text": "Les phénomènes de métamorphisme dus à l’action des granites hercyniens des Vosges sont ceux d'un métamorphisme faible, dans lequel la recristallisation de la roche primitive s'est faite sans apport de magma ou de solutions feldspathiques montées de la profondeur. On leur donne le nom d’ectinites."
                            },
                            {
                                "example_id": "0d115c92-3995-4ddc-a73a-0da463f5240f",
                                "sense_id": "3d422d1d-8474-3ebc-b3ba-84e821e5b32b",
                                "text": "La séquence argileuse (ou pélitique) : schistes, micaschistes, gneiss, granulites, illustre parfaitement le métamorphisme général. Elle constitue la série des ectinites dont la composition chimique est restée semblable à celle des roches dont elles dérivent."
                            }
                        ]
                    }
