                    {
                        "sense_id": "2e61d735-0cfc-39a3-8562-22a590ea1cbb",
                        "entry_id": "f4c63745-6c60-359c-a597-f6b373812358",
                        "glosses": [
                            "zaokrąglenie warg występujące przy artykulacji niektórych głosek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc5bd69-48a6-4ee9-a4d9-8705787761ae",
                                "sense_id": "2e61d735-0cfc-39a3-8562-22a590ea1cbb",
                                "text": "Na obszarze tym występuje typowa dla Małopolski labializacja nagłosowych i śródgłosowych samogłosek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ec6e546-8ed5-407b-b176-f83c830beab0",
                        "source_entry_id": "f4c63745-6c60-359c-a597-f6b373812358",
                        "source_sense_id": "2e61d735-0cfc-39a3-8562-22a590ea1cbb",
                        "target_lang_word": "labialization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labialization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67f22ec1-1667-36f0-9a4f-a05a98187cf8",
                                        "entry_id": "cca357f6-c9fa-36a7-85df-079c47d882e9",
                                        "glosses": [
                                            "A secondary articulatory feature of usually consonants that involves the contraction or rounding of the lips (labia) during pronunciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1254123-0d94-49fb-87a5-a3239991fe5d",
                                                "sense_id": "67f22ec1-1667-36f0-9a4f-a05a98187cf8",
                                                "text": "These labialized stops are of course nothing but positionally determined allophones of the [t] and the [k] phoneme, and their labialization is non-distinctive"
                                            },
                                            {
                                                "example_id": "d1839714-8cb0-46c8-a425-f98bbf6ac0e1",
                                                "sense_id": "67f22ec1-1667-36f0-9a4f-a05a98187cf8",
                                                "text": "The second question concerns the reasons for the labialization of this suffix in [1.3] - in the case of artukluk one immediately thinks of an assimilation (*u - ı > u - u)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
