                                                "sense_id": "1acd93c9-81ea-3f2b-900b-5565efadc13c",
                                                "text": "Untel est toujours sous le coup d’une poursuite judiciaire."
                                            },
                                            {
                                                "example_id": "aa483a38-6247-4238-b59e-3c593dec3ddd",
                                                "sense_id": "1acd93c9-81ea-3f2b-900b-5565efadc13c",
                                                "text": "Toute utilisation non autorisée constatée pourra faire l’objet de poursuite judiciaire."
                                            },
