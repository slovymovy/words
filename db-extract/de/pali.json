                ],
                "senses": [
                    {
                        "sense_id": "15b5f7dc-5913-3638-9adb-7bd245b5c4e2",
                        "entry_id": "094c365b-ac7d-34e3-88c7-fa7f523c519e",
                        "glosses": [
                            "eine mittelindoarische Sprache aus dem 1. Jahrhundert vor Christus; buddhistische Literatursprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7142ab-12ca-428d-ac21-c6207bacd960",
                                "sense_id": "15b5f7dc-5913-3638-9adb-7bd245b5c4e2",
                                "text": "„Pali hat keine eigene Schrift, sondern wird je nach Land mit verschiedenen örtlichen Schriften geschrieben.“"
                            },
                            {
                                "example_id": "4cc2a293-2a57-47e1-a7a8-f763525245d6",
                                "sense_id": "15b5f7dc-5913-3638-9adb-7bd245b5c4e2",
                                "text": "„Im Falle des Pali ist bis heute umstritten, ob es ein lokaler Dialekt oder eher eine koinisierte West-früh-mittelindische Lingua Franca war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d725e42c-4a2c-4872-b24c-bfb24096a9d1",
                        "source_entry_id": "094c365b-ac7d-34e3-88c7-fa7f523c519e",
                        "source_sense_id": "15b5f7dc-5913-3638-9adb-7bd245b5c4e2",
                        "source_sense_description": "mittelindoarische Sprache aus dem 1. Jahrhundert vor Christus",
                        "target_lang_word": "Pali",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1474dfdd-b225-3a16-8b8f-a0df0759ce6c",
                                        "entry_id": "b4017d86-37af-392b-9a86-af0cf34a8925",
                                        "glosses": [
                                            "A Middle Indo-Aryan language of north India, closely related to Sanskrit; the sacred language of Theravāda Buddhism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                        "entry_id": "b5855530-1b8e-3c2d-a412-02fd43ba7c83",
                                        "glosses": [
                                            "Alternative form of Bali."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5570d55a-2b38-4491-aa27-e4c9b4005ef1",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "For field release trials, two C. p. fatigans breeding places (hereafter referred to as sites “A” and “B”) were selected in Pali Township, Taipei County."
                                            },
                                            {
                                                "example_id": "8cea8198-79db-440e-8fe0-1a9bb215e688",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "Forty minutes later, we found ourselves seated on boulders on the side of Kuan Yin Shan with a lovely view of the river and the town of Tamsui to the east and the farms and field of Pali to the north.",
                                                "translation": "Free China Weekly",
                                                "english": "Free China Weekly"
                                            },
                                            {
                                                "example_id": "4aac04b5-02a4-409c-95b0-eaca922c3c0a",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "Earlier in the day, Chen volunteered his services at Loshan Sanatorium in Pali on the outskirts of Taipei to mark his third anniversary in office.",
                                                "translation": "Office of the President, Republic of China (Taiwan)",
                                                "english": "Office of the President, Republic of China (Taiwan)"
                                            },
                                            {
                                                "example_id": "e159bae0-9f3e-45d9-896d-49311c24f72e",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "A massive die-off of fish has been discovered along the Pali coast in Taipei County, with a preliminary investigation ascribing the mortality to too much mud and silt in the waters due to recent heavy rains, the county's Environmental Protection Bureau official said Friday."
                                            },
                                            {
                                                "example_id": "9b5e9e39-072c-4a0d-9180-dd75fc2dbfb2",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "Exactly one year to the day a predawn fire destroyed the Cloud Gate Dance Theatre’s (雲門舞集) home in Pali, Taipei County, founder Lin Hwai-min (林懷民) stood in front of the Taipei Story House on Wednesday, a huge banner with dancer Chiu I-wen (邱怡文) leaping in the air hanging behind him."
                                            },
                                            {
                                                "example_id": "acd4086b-66be-4900-a08a-1a999282b7f5",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "Two men walk at the explosion site of the water park in the Pali district in New Taipei City, Taiwan, on June 28."
                                            },
                                            {
                                                "example_id": "c04f2708-beae-4891-b4df-e12e66e997d6",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "The initial broadcasts went on the air on shortwave on May 1, 1955, from a transmitter at Panchao^([sic – meaning Panchiao]), located just beyond the western edge of the capital city, Taipei. This was an interim location, while a new base was constructed at Pali, on the coast 20 km north of Taipei."
                                            },
                                            {
                                                "example_id": "7c2bccf6-85f7-4fff-a762-b7e994fd0d7c",
                                                "sense_id": "68238ec2-4f52-32bf-9e25-ebb237238678",
                                                "text": "The Taipei port is the biggest container facility in the northern region of Taiwan. Built by reclamation of coastland and comprising an artificial harbour, it is located in Pali close to Keelung port. It was dredged and expanded using innovative technologies to achieve the highest productivity and lower the project’s environmental impact."
                                            }
                                        ]
                                    }
                                ]
                            },
