                "senses": [
                    {
                        "sense_id": "ce221d6d-a64e-3f53-8db4-235ea0e8e4ed",
                        "entry_id": "92838a6d-5366-3e62-9f6d-a6d6dae44b99",
                        "glosses": [
                            "Griff aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9db657e-bc5d-4fc7-bd9b-37bd62550308",
                                "sense_id": "ce221d6d-a64e-3f53-8db4-235ea0e8e4ed",
                                "text": "„Es waren eine kleine, lederne Brieftasche, ein gewöhnliches, aber doch neues und erst wenig gebrauchtes Jagdmesser mit Holzgriff und zwei halbgerauchte Zigarren.“"
                            },
                            {
                                "example_id": "955fa502-7d79-4e7e-b340-e8d83b7dc5cb",
                                "sense_id": "ce221d6d-a64e-3f53-8db4-235ea0e8e4ed",
                                "text": "„Er nahm einen konischen Metalldorn, der in einem Holzgriff steckte, eine Art Schusterahle, und führte ihn von der Fotoseite her durch die erste Öse des Paßbildes so weit ein, daß er festsaß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
