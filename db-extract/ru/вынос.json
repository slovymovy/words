                        "sense_id": "4349a679-d1e1-33cb-9e65-877e54b06feb",
                        "entry_id": "6b26df6d-5720-3ffc-9e75-88c7ea39efe7",
                        "glosses": [
                            "действие по значению гл. выносить; перемещение чего-либо за пределы чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173dd262-db86-40a7-88dc-9abc42a10b71",
                                "sense_id": "4349a679-d1e1-33cb-9e65-877e54b06feb",
                                "text": "— Снимите шляпы, — сказал Остап, — обнажите головы. Сейчас состоится вынос тела."
                            },
                            {
                                "example_id": "e18e717c-f6a2-4820-a0a5-f72c9add891f",
                                "sense_id": "4349a679-d1e1-33cb-9e65-877e54b06feb",
                                "text": "Вынос общего множителя за скобки."
                            },
                            {
                                "example_id": "602be475-c635-4413-9312-cf5294b377d7",
                                "sense_id": "4349a679-d1e1-33cb-9e65-877e54b06feb",
                                "text": "Полный вынос мозга."
                            }
                        ]
                    },
