                        "glosses": [
                            "Blüte des Lindenbaumes; blühender Fruchtstand des einhäusigen Laubbaumes Linde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea352ac-fd35-41a9-bfa8-61fe15e8dc0c",
                                "sense_id": "2efc9b61-8215-3b87-a745-262da4ad2069",
