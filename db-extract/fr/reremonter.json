                "senses": [
                    {
                        "sense_id": "ebabe2c1-01eb-3be5-8a43-3047f6276b84",
                        "entry_id": "31893f3a-570a-37ea-a17e-5f0631dcf6ca",
                        "glosses": [
                            "Monter à nouveau (pour la troisième fois au moins)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0250c4c-cdf0-416a-8e40-da622246d4b3",
                                "sense_id": "ebabe2c1-01eb-3be5-8a43-3047f6276b84",
                                "text": "Non mais franchement, ça sert à quoi que je me décarcasse si c'est pour qu'ils se promènent en forêt sous prétexte qu'ils aiment monter descendre et monter et descendre et remonter et redescendre et reremonter et reredescendre..."
                            },
                            {
                                "example_id": "1e2e6ce2-b563-4851-af52-6193b4e85f8c",
                                "sense_id": "ebabe2c1-01eb-3be5-8a43-3047f6276b84",
                                "text": "Mais... démonter le pare-soleil, tourner, remonter le pare-soleil ; redémonter le pare-soleil, retourner, reremonter... moi cela me g***."
                            },
                            {
                                "example_id": "877a048e-cbc8-412a-91a5-eac71ae38040",
                                "sense_id": "ebabe2c1-01eb-3be5-8a43-3047f6276b84",
                                "text": "Désolé de reremonter ce topic, mais le problème actuel m'intéresse."
                            },
                            {
                                "example_id": "ec6ef73e-c708-4346-b75a-92c8f039b5ef",
                                "sense_id": "ebabe2c1-01eb-3be5-8a43-3047f6276b84",
                                "text": "Pour te faire plaisir je vais reremonter ce topic."
                            }
                        ]
                    }
