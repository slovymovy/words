                                        "tags": [
                                            "excessive",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ed8690-79b4-406d-b776-37e44fd2cba3",
                                                "sense_id": "0fc5a648-67c1-3483-bf03-632d68534728",
                                                "text": "From what cursed old antediluvian, who lived before the invention of the spinning-jennies, she learned this craft, Heaven only knows; […]"
                                            },
                                            {
                                                "example_id": "553b0944-b8f9-4c5d-ba88-346d9bad306f",
                                                "sense_id": "0fc5a648-67c1-3483-bf03-632d68534728",
                                                "text": "He was a boy in form, and an antediluvian in feature. Some thought […] that he was really and truly a Brownie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9709ed-83de-37c2-86bb-25e283a6211f",
                                        "entry_id": "0aacbcef-4165-3678-a1da-fbe6c94d3d3b",
                                        "glosses": [
                                            "A person with extremely old-fashioned attitudes, ideas, etc., especially to a laughable extent; a fogey or old fogey."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
