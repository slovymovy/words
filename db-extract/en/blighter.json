                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9d66cd-31dd-47b1-a393-945eea9ee836",
                                                "sense_id": "267fa186-a22c-3397-ace6-06b19ffdcbc9",
                                                "text": "Mon patron est une vraie tête à claques."
                                            },
                                            {
                                                "example_id": "577cc683-7cab-4b2c-908b-9dde903a8c36",
                                                "sense_id": "267fa186-a22c-3397-ace6-06b19ffdcbc9",
                                                "text": "Ma mère, quand elle m’a déposée à la DDASS, disait de moi que j’étais une tête à claques, qu’elle allait finir par me tuer."
                                            }
                                        ]
                                    }
                                ]
