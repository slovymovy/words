                    {
                        "form_id": "0dbf3f5a-935c-4df9-860e-26464278d3c3",
                        "entry_id": "6172cc6b-5f73-3318-b0e0-a47014f12eb5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Großkonzerne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                        "entry_id": "6172cc6b-5f73-3318-b0e0-a47014f12eb5",
                        "glosses": [
                            "Unternehmen, dessen Geschäftszahlen bestimmte Größen übersteigen (beispielsweise beim Umsatz, Gewinn, Mitarbeiterzahl); daher hat ein Großkonzern meist erhebliche wirtschaftliche Bedeutung und dessen Marken sind oft sehr bekannt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86fcd40d-ae19-4478-8f9d-23a8cff861b3",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Der Großkonzern und die Familienbrauerei haben völlig unterschiedliche Vorstellungen.“"
                            },
                            {
                                "example_id": "57833c7b-6a4b-4703-a972-5dbb955491ff",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„So entstand ein Großkonzern mit über 200.000 Mitarbeitern.“"
                            },
                            {
                                "example_id": "132433ef-cc0f-4349-9a16-302f3529dfda",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Bei einem Ritt nach Berlin erkannte er: Er muss raus aus seinem Managerjob im Großkonzern.“"
                            },
                            {
                                "example_id": "92292f29-1924-405c-867d-41f10803a6e5",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Weitere Zweige, in denen der Großkonzern tätig ist, sind: Maschinenbau, Automobile, Versicherung, Großhandel, Immobilien und Freizeit.“"
                            },
                            {
                                "example_id": "05b3b7b2-dbbf-45af-8732-a4983aec40ca",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Jetzt, in der Corona-Krise zeigt der eine oder andere Großkonzern seine wahre Gesinnung.“"
                            },
                            {
                                "example_id": "c084966c-fcea-4a39-9c0e-f6d2a246fe65",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Mein Onkel,“ […] „der als Manager in einem südchinesischen Großkonzern arbeitet, klagte, es werde immer schwieriger, in den reichen Küstenprovinzen billige Arbeitskräfte zu finden.“"
                            },
                            {
                                "example_id": "26e28663-3102-45dd-8ef6-ac95af12bd3e",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Der in über 40 Ländern tätige Großkonzern wurde im August 1996 wieder in die beiden unabhängig voneinander operierenden Gesellschaften Thorn und EMI Group aufgeteilt.“"
                            },
                            {
                                "example_id": "e0b132f1-12c2-4ed4-8a37-df626c26fe7a",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Je digitaler die Welt, umso mehr Möglichkeiten bieten sich auch Kriminellen. Vom Handynutzer bis zum Großkonzern kann jeder zum Opfer werden.“"
                            },
                            {
                                "example_id": "e8ecc944-ad69-4811-9e62-96cb1baf6710",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Der US-Konzern hat sich dagegen entschieden, seine neue Chipfabrik in Schwerin zu errichten. Damit scheitert zum zweiten Mal der Versuch, in der Landeshauptstadt von MV einen Großkonzern für eine Milliardeninvestition zu gewinnen.“"
                            },
                            {
                                "example_id": "1ccec179-f287-480e-babb-f5642b8cdaa0",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Der Großkonzern Coca-Cola/Apollinaris Brands fördert seit 2014 mit zwei Brunnen jährlich 350.000 m³ Grundwasser.“"
                            },
                            {
                                "example_id": "87a6d035-5f0c-4b05-b0a7-73de684db4fc",
                                "sense_id": "f059cbae-fddf-3864-8566-6dd40bc282f1",
                                "text": "„Noch gilt Deutschland als tiermedizinisches Billigland: Doch immer mehr Praxen und Kliniken werden von den Großkonzernen Mars und Nestlé aufgekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
