                                "target_senses": [
                                    {
                                        "sense_id": "d0427870-af1e-3a75-bf29-66038543a3b7",
                                        "entry_id": "80d40a25-69a1-305b-aa16-5782fb632ac8",
                                        "glosses": [
                                            "Soumettre à un système soviétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7e8058-0f4d-43e8-b8c7-82aef413e9cb",
                                                "sense_id": "d0427870-af1e-3a75-bf29-66038543a3b7",
                                                "text": "Ivan Smirnov, l’homme qui sauva en 1918 la république à la bataille de Sviajsk, l’homme qui plus tard soviétisa la Sibérie, compromet un moment ce sinistre jeu, avec quelques dénégations méprisantes capables de tout renverser."
                                            },
                                            {
                                                "example_id": "1cf5ccf5-14ad-45d4-aa81-538d80c361d9",
                                                "sense_id": "d0427870-af1e-3a75-bf29-66038543a3b7",
                                                "text": "La multiplication des bureaucraties fait ressembler l’Europe capitaliste à sa sœur soviétisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50066aa-3886-3dde-b4ca-bff7b3c02151",
                                        "entry_id": "80d40a25-69a1-305b-aa16-5782fb632ac8",
                                        "glosses": [
                                            "Soumettre à un traitement rappelant les méthodes soviétiques, par exemple en censurant les éléments subversifs ou non conformes à l'orientation arrêtée par l'establishment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8004a16-0bfd-467d-af04-88fd9fd4e232",
                                                "sense_id": "a50066aa-3886-3dde-b4ca-bff7b3c02151",
                                                "text": "La mise au point du premier ministre, bien que largement relayée par les journaux et la radio, ne figure pas dans le compte rendu du congrès. Pas plus d'ailleurs que le brandon de Pierre Daviaul. Les actes du congrès ont été pour ainsi dire « soviétisés »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
