                                        "sense_id": "c3bad4e3-020f-353b-a540-51748431bd00",
                                        "entry_id": "483485d4-6a1f-3ced-be00-7ae35036631c",
                                        "glosses": [
                                            "A place where a precious metal found in gravel is separated from lighter material by washing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
