                    {
                        "translation_id": "5e8678f1-e3b8-4ce2-9e09-fa22b5d6e6eb",
                        "source_entry_id": "8873502a-32e8-3d05-a532-b90b568a843c",
                        "source_sense_description": "container for ashes",
                        "target_lang_word": "poubelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poubelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Récipient destiné à recevoir des détritus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c599155-bd68-4583-bbfe-013c346a6bcc",
                                                "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                                "text": "Il lui fallait pêcher sa croûte, n’importe comment, dans les poubelles, à plat ventre, dans la fange, dans la m... Tout d’ailleurs n’était que m... La société, la belle société, un vaste pot de m..., un gulf-stream de m..."
                                            },
                                            {
                                                "example_id": "84b71e92-16a6-4183-98c8-ea7394e64002",
                                                "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                                "text": "Les zoniers sont nombreux encore qui habitent des cabanes plus ou moins construites avec de vieilles boites à sardines. L'industrie des chiffons et l'exploration matutinale des poubelles ne leur permettent pas de villas plus cossues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e0a692-32a5-3b96-9c20-bfcd9c397c21",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Ensemble des ordures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1bca21d-547f-3318-9f5e-83c385c10b1e",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Mécanisme logiciel qui permet de mettre à l’écart des fichiers qu’on envisage de supprimer → voir corbeille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b29a15-c499-42e6-9798-04925d85e32a",
                                                "sense_id": "a1bca21d-547f-3318-9f5e-83c385c10b1e",
                                                "text": "Sur le bureau on trouve aussi la poubelle. C’est ici que se retrouve tous les objets que vous supprimez. Donc pas de panique si vous avez supprimé un objet par mégarde, il est ici."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poubelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                        "entry_id": "da4ac02f-0fee-314b-aa90-2eb229ffe4eb",
                                        "glosses": [
                                            "Qui est fortement dévalorisé, qui constitue un rebut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f47a94-f644-42a8-9fca-711dd1641bc9",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "Au fond du H.L.M.\nDe cette cité poubelle\nSe cache une fillette\nQui s’ennuie à mourir"
                                            },
                                            {
                                                "example_id": "b879e223-5bcd-4688-ba42-95be2b3a2588",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "Vous passiez un bac G,\nUn bac à bon marché\nDans un lycée poubelle,\nL'ouverture habituelle\nDes horizons bouchés"
                                            },
                                            {
                                                "example_id": "d371ba4e-739e-4e9a-8108-3d072bd5df97",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "En réponse à « À Québec, il n’y a que des radios poubelles », affiché depuis plusieurs jours un peu partout en ville, les nouvelles affiches diffuseront : « Faux, Québec fait de la bonne radio »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
