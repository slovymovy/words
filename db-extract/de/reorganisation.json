                "senses": [
                    {
                        "sense_id": "73d76445-1d0c-3c23-b6f2-44d741b62fda",
                        "entry_id": "6c6e7c6c-d35f-39ce-ba57-ba3fb13d8c5d",
                        "glosses": [
                            "Einführung eines neuen Systems der Ordnung; die Umwandlung bestehender Dinge in ein neues/anderes Verhältnis"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "8256802d-97b8-4507-9cad-8578ed563f38",
                                "sense_id": "73d76445-1d0c-3c23-b6f2-44d741b62fda",
                                "text": "Das neue Gesetz erfordert eine Reorganisation der Betriebsabläufe."
                            },
                            {
                                "example_id": "50b153d3-906d-4034-8ab3-e11ada4ec713",
                                "sense_id": "73d76445-1d0c-3c23-b6f2-44d741b62fda",
                                "text": "„Das Quellenmaterial zeigt, daß die Inka eine aktive Rolle bei der Reorganisation des von ihnen beherrschten Gebietes spielten und eine von ihnen entworfene neue Ordnung einführten.“"
                            },
                            {
                                "example_id": "a84a4f86-e2ce-43be-9f94-197fc86db6b2",
                                "sense_id": "73d76445-1d0c-3c23-b6f2-44d741b62fda",
                                "text": "„Die Reorganisation des Heeres […] bereitete die kriegerische Nationalstaatsgründung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3d8fac4-8d13-3233-a767-62a2f7c0588c",
                        "entry_id": "6c6e7c6c-d35f-39ce-ba57-ba3fb13d8c5d",
                        "glosses": [
                            "mit dem Heilungsprozess eintretende Neubildung von geschädigtem Gewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0dc3df-64f0-488a-ad55-1cc4716388b0",
                                "sense_id": "f3d8fac4-8d13-3233-a767-62a2f7c0588c",
                                "text": "„Die osteopathische Behandlung kann das brotische Stadium in ein entzündliches zurückführen und zu einer besseren Reorganisation der Gewebe und zu einer teilweisen oder völligen Normalisierung der Gewebemobilität führen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
