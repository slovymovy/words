                "senses": [
                    {
                        "sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
                        "entry_id": "e8369484-1711-300e-9e06-510f5031246e",
                        "glosses": [
                            "een verwonding die men door sportbeoefening heeft gekregen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae34dfd9-4338-4f7b-ae38-d1a88075764e",
                                "sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
                                "text": "Hij zat al maanden niet meer op de fiets als gevolg van een blessure aan beide knieën. ,,Officieel heet het overbelasting, maar concreet is het een zeurende pijn in het midden van beide knieschijven."
                            },
                            {
                                "example_id": "77a04395-7552-44d5-acd7-a9a30d2a1446",
                                "sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
                                "text": "We spraken een plek af waar we elkaar over een week zouden treffen, maar helaas duurde zijn blessure langer dan verwacht en zag ik hem pas een maand later weer terug."
                            },
                            {
                                "example_id": "85141f3d-1712-49f3-a1fe-87b09f3612b8",
                                "sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
                                "text": "Ik vertelde natuurlijk wat er gebeurd was, dat we de laatste tijd niet zoveel hadden geijshockeyd maar vooral meisjestikkertje hadden gespeeld, waarbij het risico op een blessure laag was. En dat ik zojuist meerdere koppen thee had gedronken in het huis van een meisje op wie ik waarschijnlijk verliefd was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17e21dd2-82e5-4df9-a70f-1b40877ee902",
                        "source_entry_id": "e8369484-1711-300e-9e06-510f5031246e",
                        "source_sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
                        "source_sense_description": "een verwonding die men door sportbeoefening heeft gekregen",
                        "target_lang_word": "Verletzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verletzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "eine Beschädigung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91166979-0281-4914-acc6-3ea838d69718",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "„Bei den von mir untersuchten Wagnissportarten Bergsteigen, Fallschirmspringen, Gleitschirm-, Drachen-, Segelfliegen und Bungeespringen wird – gemessen an der Anzahl der Einzelaktionen, der Betätigungsdauer und der Schwere der Verletzungen – ein Gefährdungslevel unterschritten, der in anderen gesellschaftlichen Bereichen (z.B. dem Straßenverkehr) und in Volkssportarten (Fußball, Abfahrtski) allgemein toleriert wird.“"
                                            },
                                            {
                                                "example_id": "43baee43-193d-45a1-b6b7-5bde7cfec572",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "Ich habe mir gestern eine Verletzung der Milz zugezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "das Übertreten eines Gebotes, einer Grenze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e952727-0649-45db-914d-094ff0f1efb3",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "Es war eine schwere Verletzung der Aufsichtspflicht."
                                            },
                                            {
                                                "example_id": "b0c6ccb7-14cc-48a6-9b19-d9a5ae287a67",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "„Wir glauben kaum nötig zu haben, unsern Lesern die Tatsache zu bestätigen, die der Squire soeben erzählte und die, wie wir wissen, genau dahin ging, daß der berühmte Sieger wirklich zu dieser Geldstrafe wegen Verletzung der Habeascorpusakte während seines Oberbefehls verurteilt wurde: eine Strafe, der er sich auch willig unterzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fcfc502-a62d-4791-b23c-f2905df2b12e",
                        "source_entry_id": "e8369484-1711-300e-9e06-510f5031246e",
                        "source_sense_id": "f9fd045a-bdc7-3961-87e5-28615be083ac",
