                "senses": [
                    {
                        "sense_id": "8084a3fd-d1d3-3783-a2b0-47e259913633",
                        "entry_id": "ee613942-53f7-3df5-a256-f1c4ae6c40a1",
                        "glosses": [
                            "Umfeld, in dem man nur noch Informationen angeboten bekommt/aufnimmt, die den eigenen Vorlieben entsprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b020a79-d9be-4c75-bddc-a3e9c0225a43",
                                "sense_id": "8084a3fd-d1d3-3783-a2b0-47e259913633",
                                "text": "„Es kann aber dazu führen, […] dass man sich im eigenen Echoraum einschließt und sich dadurch gegen andere Positionen, Meinungen oder Argumente immunisiert.“"
                            },
                            {
                                "example_id": "ce78f0f5-2a4f-46ac-8706-3340bf988b79",
                                "sense_id": "8084a3fd-d1d3-3783-a2b0-47e259913633",
                                "text": "„Die exzessive Beschäftigung mit dem eigenen Privatleben und dem Privatleben anderer Menschen, die Individualisierungsprozesse der Gesellschaft und die konsensverhindernden Echoräume sozialer Netzwerke tragen dazu bei, dass die Agora der Zivilgesellschaft zunehmend leerer wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9519fc4-d810-4205-994e-e63ce640d452",
                        "source_entry_id": "ee613942-53f7-3df5-a256-f1c4ae6c40a1",
                        "source_sense_id": "8084a3fd-d1d3-3783-a2b0-47e259913633",
                        "source_sense_description": "Umfeld, in dem man nur ohnehin bevorzugte Informationen erhält",
                        "target_lang_word": "echo chamber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "echo chamber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc8569ed-d956-3343-936a-4d6fd5f9fc13",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "A room or other enclosed space that is highly conducive to the production of echoes, particularly one that has been designed and built for this purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ee64ecf-8790-341b-bfe3-b0bb8e8f6cfc",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "A sound effect that may be applied to live or recorded sounds through a sound editing process, which creates the impression that the sounds originated in an enclosed space which was conducive to producing echoes or echoing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "An environment in which a person is exposed to only those beliefs and opinions that agree with their own, so that their existing views are magnified and reinforced while alternative ideas are not expressed or considered."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf9817b-a0af-45bb-a268-1a6c46779a87",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "But it would resound in the conservative media's echo chamber."
                                            },
                                            {
                                                "example_id": "42710bb6-e08e-4fa2-9c9e-481ccc5f1f5a",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "“What you’re going to end up doing is amplifying within an echo chamber, which is really different from what the movement wants,” said Dana Fisher, a professor of sociology at the University of Maryland whose research focuses on activism."
                                            },
                                            {
                                                "example_id": "58411964-2660-4167-81aa-479f3504fbdf",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "The videos were tailored for the “echo chamber” that is often created by social media networks like YouTube. To keep you watching, YouTube serves up videos similar to those you have watched before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
