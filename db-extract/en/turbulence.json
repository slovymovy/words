                    {
                        "translation_id": "b36b1ebc-8559-403d-9cf7-c3e09f1f7372",
                        "source_entry_id": "099d069a-503f-3b35-b894-5489452db528",
                        "source_sense_description": "disturbance in gas, fluid",
                        "target_lang_word": "turbulence",
