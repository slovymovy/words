                "forms": [],
                "senses": [
                    {
                        "sense_id": "e73f84b7-585f-3a86-8d42-a55312eef01b",
                        "entry_id": "be681e15-a4d2-39a0-ac40-131682f9a80d",
                        "glosses": [
                            "Then; thereupon."
                        ],
                        "tags": [
                            "dialectal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "93c2bb76-9fc2-42f3-bb53-9062c59e4aa0",
                                "sense_id": "e73f84b7-585f-3a86-8d42-a55312eef01b",
                                "text": "1481, William Caxton, The History Reynard the Foxː\nTho went I near and found Master Reynard, that had left that he first read and sang, and began to play his old play."
                            },
                            {
                                "example_id": "95d38806-2472-4b54-9b27-d7e7cb3933dc",
                                "sense_id": "e73f84b7-585f-3a86-8d42-a55312eef01b",
                                "text": "Tho to a hill his faynting flocke he ledde."
                            },
                            {
                                "example_id": "61bd10ea-f240-489e-9c90-b95ae1f6dfee",
                                "sense_id": "e73f84b7-585f-3a86-8d42-a55312eef01b",
                                "text": "Tho, her avizing of the vertues rare / Which thereof spoken were, she gan againe / Her to bethink of that mote to her selfe pertaine."
                            },
                            {
                                "example_id": "7dd7b369-5fd7-494b-a9d2-c1938465c9a3",
                                "sense_id": "e73f84b7-585f-3a86-8d42-a55312eef01b",
                                "text": "1642, Henry More, Song Soulː\nTho I gan closely on his person look."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
