                                        "sense_id": "d1e9209f-ccb3-3e0c-973f-c679b42064df",
                                        "entry_id": "d2b12ba7-b983-366a-ad71-d5c5868a9512",
                                        "glosses": [
                                            "Mot n'ayant qu'une seule signification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74af9b9-c6cb-4dff-a506-193efae09c0d",
                                                "sense_id": "d1e9209f-ccb3-3e0c-973f-c679b42064df",
                                                "text": "Un monosème, ou un mot monosémique, est un signe linguistique dont le sémantisme plénier est réalisé du premier coup"
                                            },
                                            {
                                                "example_id": "0ae5a764-1e86-4f36-97b1-e0672054b369",
                                                "sense_id": "d1e9209f-ccb3-3e0c-973f-c679b42064df",
                                                "text": "Un item lexical est une unité de sens ; c'est un monosème, selon un certain angle de vue qui demande à être défini."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monosème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba00354-31c2-378b-84f5-a01349e7d0a7",
                                        "entry_id": "ca85614a-b541-3fd4-be4d-fb5f433b7b93",
                                        "glosses": [
                                            "Qui n'a qu'une seule signification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236925c9-4b15-4be3-9a89-bfc6eff5723c",
                                                "sense_id": "4ba00354-31c2-378b-84f5-a01349e7d0a7",
                                                "text": "La substitution vocable monosème / vocable polysème."
                                            },
                                            {
                                                "example_id": "bdcb46c4-b6dc-44aa-aa12-b1ae1a0b71a6",
                                                "sense_id": "4ba00354-31c2-378b-84f5-a01349e7d0a7",
                                                "text": "Il est conseiller de créer autant de dictionnaires qu'il y a de thèmes traités, et non de faire un énorme dictionnaire, et que chaque entrée (mot) soit monosème (le mot n'a qu'un seul sens) et non-redondant (éviter les synonymes, sauf contextuels);"
                                            }
                                        ]
                                    }
