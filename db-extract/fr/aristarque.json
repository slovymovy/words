            {
                "entry_id": "7521cef9-3d28-3f73-b1b3-856ffba078ab",
                "word": "Aristarque",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a38759ce-93ae-3003-b356-6ca2619e5ad9",
                        "entry_id": "7521cef9-3d28-3f73-b1b3-856ffba078ab",
                        "glosses": [
                            "Grammairien d’Alexandrie (IIIᵉ av. J.-C.), éditeur et commentateur d’Homère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0be0d3-e452-431d-b735-c0d36c66355b",
                                "sense_id": "a38759ce-93ae-3003-b356-6ca2619e5ad9",
                                "text": "Cette respiration est une révolution, souligne Isabelle Serça, professeur de littérature à l’Université de Toulouse. Avant ces deux esprits solaires, Homère, Sophocle et Aristote coulaient en un flot d’ombres continu. Aristophane et Aristarque n’y ont pas seulement introduit du blanc, ils se sont mis à ponctuer, c’est-à-dire à piquer les textes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a3b993-c241-4f40-a281-741e1a8cd0ac",
                        "source_entry_id": "7521cef9-3d28-3f73-b1b3-856ffba078ab",
                        "source_sense_id": "a38759ce-93ae-3003-b356-6ca2619e5ad9",
                        "target_lang_word": "Aristarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aristarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed095435-e1fb-31f4-82fa-b3605f15ab0f",
                                        "entry_id": "43d3ae1b-b666-39fa-9e83-031aa8ed67fb",
                                        "glosses": [
                                            "A severe critic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d6ff33-1321-483f-b5cb-45922757a05e",
                                                "sense_id": "ed095435-e1fb-31f4-82fa-b3605f15ab0f",
                                                "text": "Let no Ariſtarch of learning diſdain performances of this kind."
                                            },
                                            {
                                                "example_id": "0bbe4171-a10a-4193-a597-f62907e7e37a",
                                                "sense_id": "ed095435-e1fb-31f4-82fa-b3605f15ab0f",
                                                "text": "Then let these Aristarchs read the geographer Morse; they will then see that the good Penn, however concerned he may have been with spiritual good, did not for all that neglect the goods of this world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
