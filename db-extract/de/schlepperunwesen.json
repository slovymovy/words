                        "examples": [
                            {
                                "example_id": "18b82eca-4fec-41c6-912a-38b45f99c145",
                                "sense_id": "1b0f9134-98af-3bb6-a8a2-a97e438e32d8",
                                "text": "„Seit dem EU-Beitritt 2004 […] und dem folgenden Schengen-Beitritt 2007 hat Ungarn eine EU-Außengrenze. Serbien ist noch mit den Konsolidierungen nach den Jugoslawienkriegen beschäftigt, dadurch wurde die Route Serbien–Ungarn zunehmend eine der Hauptrouten auch des Schlepperunwesens […], hauptsächlich dem Landweg von Süd- und Mittelasien über die Türkei und Griechenland.“"
                            },
                            {
                                "example_id": "485cc640-c674-4f92-89b5-d4a1b1a2f415",
                                "sense_id": "1b0f9134-98af-3bb6-a8a2-a97e438e32d8",
                                "text": "„In seiner Rede am Donnerstag vor der UN-Vollversammlung will Schüssel neben der Betonung der Menschenrechte den Vorschlag einer internationalen Konvention gegen das Schlepperunwesen einbringen.“"
                            }
