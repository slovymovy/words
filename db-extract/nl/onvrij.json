                                        "examples": [
                                            {
                                                "example_id": "7a78d0a9-1365-41fc-8f54-8fe5dd877ac4",
                                                "sense_id": "ec64f4f2-c4cd-386e-b90d-980e488d9d8c",
                                                "text": "The rabbit bounded down the lane."
                                            },
                                            {
                                                "example_id": "8f5e6119-dbd3-49ef-a507-732343f78a53",
                                                "sense_id": "ec64f4f2-c4cd-386e-b90d-980e488d9d8c",
                                                "text": "But when I turn away, / Thou, willing me to stay, / Wooest not, nor vainly wranglest; / But, looking fixedly the while, / All my bounding heart entanglest, / In a golden-netted smile; […]"
                                            },
                                            {
                                                "example_id": "34096b40-4734-4439-a0e5-3fa0aa91bfd1",
                                                "sense_id": "ec64f4f2-c4cd-386e-b90d-980e488d9d8c",
                                                "text": "They make love, he hauls her to the bath, washes her, hauls her out and dries her, and twenty minutes later Mary and Magnus are bounding across the little park on the top of Döbling like the happy couple they nearly are, past the sandpits and the climbing frame that Tom is too big for, past the elephant cage where Tom kicks his football, down the hill towards the Restaurant Teheran which is their improbable pub because Magnus so adores the black and white videos of Arab romances they play for you with the sound down while you eat your couscous and drink your Kalterer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4375fc5-0a38-3e43-964d-74f0807c26cd",
