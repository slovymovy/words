                "senses": [
                    {
                        "sense_id": "bf9404f9-2b9a-37df-888e-87bce33185dc",
                        "entry_id": "3623d47f-655d-38c1-852b-28d483a146fc",
                        "glosses": [
                            "Semem, die komplette Bedeutung einer selbständigen Buchstabenfolge (= Lexem, Wort), zusammengesetzt aus den einzelnen Semen"
                        ],
                        "tags": [
                            "steht für"
                        ],
                        "examples": [
                            {
                                "example_id": "924ede50-6cd6-45ea-b3ca-ac9ed04b2b77",
                                "sense_id": "bf9404f9-2b9a-37df-888e-87bce33185dc",
                                "text": "Das Lexem/Wort ‚Frau‘ zum Beispiel hat unter anderem die Seme [+ menschlich], [+weiblich], [+erwachsen] – womöglich mehr –, die zusammen zum Semantem (zur Bedeutung) dieses Wortes gehören."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44877f2c-45fe-3050-a809-35be8be9d090",
                        "entry_id": "3623d47f-655d-38c1-852b-28d483a146fc",
                        "glosses": [
                            "Sem, kleinster Bestandteil der (Lexem-, Wort-)Bedeutung"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b24020b9-8dd1-4184-a575-b6cf85042d1e",
                                "sense_id": "44877f2c-45fe-3050-a809-35be8be9d090",
                                "text": "In diesem Sinne ist [+ weiblich] eines der Semanteme des Wortes »Mutter«."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f15dc20c-a821-3a9e-8cc1-27f945773825",
                        "entry_id": "3623d47f-655d-38c1-852b-28d483a146fc",
                        "glosses": [
                            "Form-/Ausdrucksseite eines Lexems/Wortes, die die inhaltliche/lexikalische/denotative Bedeutung repräsentiert"
                        ],
                        "tags": [
                            "Gegenteil von wortbildendem Morphem"
                        ],
                        "examples": [
                            {
                                "example_id": "a931682d-44b8-4aa9-92fd-b7ee6c683345",
                                "sense_id": "f15dc20c-a821-3a9e-8cc1-27f945773825",
                                "text": "„Man kann 3 Grundtypen unterscheiden: 1. das Semantem als Träger der lexikalisch-semantischen Grundbedeutung, 2. das das Semantem grammatisch und semantisch modifizierende Derivatem, 3. das Grammatem als Träger der grammatischen Relationen.“"
                            },
                            {
                                "example_id": "c769438b-6b46-47e6-a59a-975594fe391b",
                                "sense_id": "f15dc20c-a821-3a9e-8cc1-27f945773825",
                                "text": "In diesem Sinne kann man dem Wort »jugendliches« das Semantem »Jugend«, das Derivatem zum Adjektiv »-lich« und die grammatische Endung »-es« zuordnen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
