        "fr-extract.jsonl": [
            {
                "entry_id": "501d9ba1-e622-3f67-8483-9fce66cceb1c",
                "word": "balayure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ec1652b-5c9c-442e-8a58-89c90565a066",
                        "entry_id": "501d9ba1-e622-3f67-8483-9fce66cceb1c",
                        "tags": [
                            "plural"
                        ],
                        "form": "balayures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3ecde74-c1b8-3bee-a568-9cd9a5721f17",
                        "entry_id": "501d9ba1-e622-3f67-8483-9fce66cceb1c",
                        "glosses": [
                            "Déchet produit par le balayage, ordure ramassée avec un balai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2cb519-7e00-463c-8a04-a5f80c8e0ee5",
                                "sense_id": "b3ecde74-c1b8-3bee-a568-9cd9a5721f17",
                                "text": "Quoiqu'on ne sème point les pâtures, il est bon d'y répandre, de temps à autre les restes et les balayures des greniers à foin, quand ils sont vuides: …."
                            },
                            {
                                "example_id": "0405bb2b-23f0-4843-b808-ff5c1e7ac3ba",
                                "sense_id": "b3ecde74-c1b8-3bee-a568-9cd9a5721f17",
                                "text": "REJET DES BALAYURES OU DES RÉSIDUS DE CARGAISON SÈCHE DANS LES GRANDS LACS: […] 3. Les commissaires discutent des balayures de cargaison sèche et de l'énoncé d'impact environnemental de la garde côtière américaine en vue de la fixation des règles au sujet du rejet des balayures dans les Grands Lacs."
                            },
                            {
                                "example_id": "520f3ca9-065a-4901-a196-8edc859510aa",
                                "sense_id": "b3ecde74-c1b8-3bee-a568-9cd9a5721f17",
                                "text": "Et maintenant, le ciel se couvre (...). En haut, dans un faible étamage lumineux, il est traversé par des balayures démesurées de poussière humide."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e4a0dd-e10e-3fd6-b352-6accfd667dab",
                        "entry_id": "501d9ba1-e622-3f67-8483-9fce66cceb1c",
                        "glosses": [
                            "Rebut, objet ou personne méprisé(e), rejeté(e)."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4ccb28f9-b571-49c8-a0c3-fd9a7758aed7",
                                "sense_id": "83e4a0dd-e10e-3fd6-b352-6accfd667dab",
                                "text": "«Tu nous as fait la balayure et le rebut au milieu des peuples»"
                            },
                            {
                                "example_id": "edef1ae2-5165-4444-89c7-dc9e10f74487",
                                "sense_id": "83e4a0dd-e10e-3fd6-b352-6accfd667dab",
                                "text": "La mesure est comble quand on apprend qu’il a jeté à la balayure un insignifiant mais vénérable portrait d’ancêtre qui occupait à A. la même place entre deux crédences depuis cent cinquante ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fff7bb3-6d7f-4f9b-a108-22408a91516f",
                        "source_entry_id": "501d9ba1-e622-3f67-8483-9fce66cceb1c",
                        "target_lang_word": "Kehricht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kehricht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                        "entry_id": "b75ec172-1d43-3075-b02a-8a7f8305a413",
                                        "glosses": [
                                            "durch Kehren mit einem Besen zusammengetragener Müll oder Schmutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f26900ec-cd04-4423-86ec-9db12ad46485",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "„Du hast uns zum Kehricht und zum Ekel gemacht inmitten der Völker.“"
                                            },
                                            {
                                                "example_id": "cf0407b2-8381-45d7-952c-c2efd8e6be43",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "Den Kehricht bringst Du aber heute noch weg!"
                                            },
                                            {
                                                "example_id": "8fab0787-50fd-44fe-aa37-47da39c51dfb",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "In unserer Werkstatt fällt immer so viel Kehricht an."
                                            },
                                            {
                                                "example_id": "5d027ca6-4a8b-4a2e-a55c-bf592d9a3613",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "„Einige Personen waren damit beschäftigt, sie vom Schmutz zu befreien und kümmerlich zu schichten, andere stöberten in dem Kehricht herum, als suchten sie nach irgend etwas Brauchbarem, und schufen wieder neue Unordnung.“"
                                            },
                                            {
                                                "example_id": "e6f42109-08fe-4c46-9fe3-51b4877b66a0",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "„An diesem Herbsttage war alles still in Skálholt, und niemand wußte, daß etwas geschehen; es begann zu frieren, und dadurch roch es nicht mehr so arg nach Kehricht und Schmutz, was sonst ein Kennzeichen dieses Ortes war.“"
                                            },
                                            {
                                                "example_id": "1889dc85-52c0-4d9b-ac74-2552ff240ea0",
                                                "sense_id": "a71828f2-429d-356f-af17-a66e3a243f3c",
                                                "text": "„Wir sollten den Hof des Gemeindegebäudes vom Kehricht säubern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d050fbc4-3e0e-3546-b544-83f438d8b8b4",
                                        "entry_id": "b75ec172-1d43-3075-b02a-8a7f8305a413",
                                        "glosses": [
                                            "Hausmüll, der von der Kehrichtabfuhr abgeholt wird"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
