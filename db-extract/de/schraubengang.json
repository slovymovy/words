                        ],
                        "examples": [
                            {
                                "example_id": "ffc474c9-5232-49c1-a617-7ab3befda3b0",
                                "sense_id": "5c7027e7-eda7-345a-85a3-384d4587d83e",
                                "text": "„Die Stirnfläche dieses vorderen Theiles legt sich unmittelbar gegen die Rückseite des Verschlusscylinderansatzes (ka) an und ist in einem, dem Schraubengange des letzteren an Steigung gleichen, der Richtung nach aber entgegengesetzten (d. h. von rechts nach links fallenden) Schraubengange geführt.“ (1876)"
                            },
                            {
                                "example_id": "649fa962-203a-475c-882f-bb9ec3fe69a8",
                                "sense_id": "5c7027e7-eda7-345a-85a3-384d4587d83e",
                                "text": "„Der Schraubengang schließt nicht dicht an den Anschlagring an, läßt vielmehr einen dem Durchmesser des Stiftes k entsprechenden Spalt rz frei.“ (1917)"
                            }
                        ],
