                                        "glosses": [
                                            "ohne auf die Form zu achten, ungezwungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcede114-1cfb-4ad9-bf75-6b3e66cc29b3",
                                                "sense_id": "d0cc4e4f-050b-3a09-a95c-0ed817fee22a",
                                                "text": "Seine Art zu sprechen hatte etwas Nachlässiges."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7addf92-cd64-3ff1-bf45-d1fda0a94eeb",
                                        "entry_id": "ec73fb22-de6e-3895-be81-2a5572b17e46",
                                        "glosses": [
                                            "ohne innere Beteiligung, gleichgültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b4e0c7-9538-467a-b0a4-427db0c01904",
                                                "sense_id": "a7addf92-cd64-3ff1-bf45-d1fda0a94eeb",
                                                "text": "„Warum sollte ich dich schlagen“, antwortete er nachlässig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b8f7b6eb-48fa-324c-8b66-0d296c48900c",
                                        "entry_id": "ec73fb22-de6e-3895-be81-2a5572b17e46",
                                        "glosses": [
                                            "säumig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b637ec3-9ca9-4f91-8e22-de9070d8c2ac",
                                                "sense_id": "b8f7b6eb-48fa-324c-8b66-0d296c48900c",
                                                "text": "Das aber pflegt mit einem Krach zu enden, wenn die Zinsen nicht bezahlt werden können, und zuweilen endet es mit Gefängnis, wenn man als nachlässiger Schuldner befunden wird."
                                            }
                                        ],
