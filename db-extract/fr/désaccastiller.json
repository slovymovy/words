                ],
                "senses": [
                    {
                        "sense_id": "df6a63bb-53cf-363d-a421-ae118b42c4e5",
                        "entry_id": "4887bc98-a2f6-3671-9239-c3d880a86a40",
                        "glosses": [
                            "Enlever ses parties non structurelles à (normalement, un bateau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9b4583-c16d-4221-9c08-201ad2df55a2",
                                "sense_id": "df6a63bb-53cf-363d-a421-ae118b42c4e5",
                                "text": "C’était une journée de solitude glorieuse pour le jeune garçon qui, épuisé mais heureux s’apprêtait à désaccastiller, quand soudain, quittant les véhicules alignés au dessus de la plage déserte, un petit groupe d’hommes se laissa glisser le long du mur de remblai."
                            },
                            {
                                "example_id": "dd01a148-b547-4a2d-a00a-b65f865b9b94",
                                "sense_id": "df6a63bb-53cf-363d-a421-ae118b42c4e5",
                                "text": "Pendant que François s'attaque à l'allonge avant, je désaccastille le mât et c'est parti pour le décapage."
                            },
                            {
                                "example_id": "87004347-7244-40a0-b910-6ead84bcfb72",
                                "sense_id": "df6a63bb-53cf-363d-a421-ae118b42c4e5",
                                "text": "Nous avons totalement désaccastillé le bateau, poncé la coque et le pont."
                            }
                        ]
                    }
                ],
