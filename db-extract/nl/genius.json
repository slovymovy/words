                "translations": [
                    {
                        "translation_id": "8931f42b-8910-429d-9d2d-484c26218bc9",
                        "source_entry_id": "66b244f4-459c-34c2-a408-cb854d78dc8c",
                        "source_sense_id": "ab46ec92-fe81-3269-ae45-14417ae4e9e3",
                        "target_lang_word": "genius",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Someone possessing extraordinary intelligence or skill; especially somebody who has demonstrated this by a creative or original work in science, music, art, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abbeb92-db64-4f99-a0d2-3a329c451b21",
                                                "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                                "text": "She's a genius; she won a Nobel Prize at fifteen!"
                                            },
                                            {
                                                "example_id": "ce7bbcbe-70b9-4c82-8314-8fec14e3c8a5",
                                                "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                                "text": "Marx stand höher, sah weiter, überblickte mehr und rascher als wir andern alle. Marx war ein Genie, wir andern höchstens Talente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Extraordinary mental capacity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eef459c-5396-4530-9e9d-4f48aa4c64d6",
                                                "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                                "text": "Excuse, therefore, the shortcomings of genius under the sudorific influence of the summer solstice; for be assured that the vertical sun, however it may dulcify and mature cherries, plums, and other fruitful ‘plumpitudes,’ is by no means favorable to the development of intellectual products."
                                            },
                                            {
                                                "example_id": "9f4e2c3e-7c52-4a04-bc04-f7711c9c4e6c",
                                                "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Inspiration, a mental leap, an extraordinary creative process."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba412b07-46bc-414e-b491-e67367aa0439",
                                                "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                                "text": "a work of genius"
                                            },
                                            {
                                                "example_id": "03fc1f94-6f44-4f8e-a196-87849860ff86",
                                                "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                                "text": "to add a dash of cinnamon amid such umami was pure genius"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "The tutelary deity or spirit of a place or person."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "also",
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb9edf1-2b0e-46c6-9b01-b6c2a638f6da",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "and the genius of the place: the growing enthusiasm for codified standards in the Army and Navy"
                                            },
                                            {
                                                "example_id": "6d3ac11f-8994-4c45-9d96-632af89f0059",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "We talk of genius still, but with thought how changed! The genius of Augustus was a tutelary demon, to be sworn by and to receive offerings on an altar as a deity."
                                            },
                                            {
                                                "example_id": "d40ea247-0431-48c1-997c-ac4072e991da",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "An old sinner, in shape of a khansamah, is the genius of the place, and has rarely aught else to tempt the tired traveller with than a “sudden death”—a fowl caught running in the yard, and dished up forthwith; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "genius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                        "entry_id": "f2b4b6d3-17eb-3671-9321-6d36b852c675",
                                        "glosses": [
                                            "Ingenious, brilliant, very clever, or original."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f1de90-36e5-4672-978f-e4943bb52d16",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "What a genius idea!"
                                            },
                                            {
                                                "example_id": "b0fb9657-9410-4203-8dd4-3c07ceae311b",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "Bjarte Birkeland asserts that the reason why Nynorsk writers of fiction have succeeded in coming so close to naked life is not that they are more genius than authors writing in Bokmal, but that they are using their mother tongue"
                                            },
                                            {
                                                "example_id": "3310dbba-d360-4b70-8834-93383e2ff935",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "We all know how genius “Kamp Krusty,” “A Streetcar Named Marge,” “Homer The Heretic,” “Itchy & Scratchy: The Movie” and “Mr. Plow” are, but even the relatively unheralded episodes offer wall-to-wall laughs and some of the smartest, darkest, and weirdest gags ever Trojan-horsed into a network cartoon with a massive family audience."
                                            },
                                            {
                                                "example_id": "d45e4381-9166-475b-a518-305fe98781ae",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "But Vahul was more genius than Rishi."
                                            },
                                            {
                                                "example_id": "c22a01b0-0d8b-4cf2-8d09-47b72cb6291f",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "She said the writing for these products “is very genius” because it's carefully done."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09d766c3-4f1b-45da-beda-d573d7151915",
                        "source_entry_id": "66b244f4-459c-34c2-a408-cb854d78dc8c",
                        "source_sense_id": "ab46ec92-fe81-3269-ae45-14417ae4e9e3",
                        "target_lang_word": "guardian angel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
