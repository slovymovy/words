                        "entry_id": "23caa4fe-a552-30dd-a94c-382c385e6375",
                        "glosses": [
                            "progressive und pro-europäische politische Partei in Polen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5cb1f9-965d-4fcb-a273-7a058df21d2d",
                                "sense_id": "6d2f8b03-c4ea-3306-9265-a9c4890aee8d",
                                "text": "In Polen ist eine neue Partei namens Wiosna (Frühling) gegründet worden."
                            },
                            {
                                "example_id": "92e0532a-ec7f-477e-b8cf-7ee5d27fe043",
                                "sense_id": "6d2f8b03-c4ea-3306-9265-a9c4890aee8d",
                                "text": "Polens neue Partei „Wiosna“ will den Einfluss der Kirche auf den Staat zurückdrängen und findet damit auch unter gläubigen Katholiken Gehör."
                            },
                            {
                                "example_id": "6d5dcb13-961a-40d5-84ee-8b100f668754",
                                "sense_id": "6d2f8b03-c4ea-3306-9265-a9c4890aee8d",
                                "text": "Seiner neuen Partei hat er deshalb bei der Gründungsveranstaltung am Sonntag in Warschau den Namen Wiosna gegeben, auf Deutsch: Frühling."
                            },
                            {
                                "example_id": "bbb67626-dc2c-4116-ae30-b7ff2cbbfa95",
                                "sense_id": "6d2f8b03-c4ea-3306-9265-a9c4890aee8d",
                                "text": "Neue polnische Linkspartei Wiosna kommt in Umfragen auf Platz drei."
                            }
                        ],
