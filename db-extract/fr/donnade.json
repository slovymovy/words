                        "glosses": [
                            "Bagarre plus ou moins ritualisée à coups de poings."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "be16acb4-c50c-4a1a-8882-9a432fdc1805",
                                "sense_id": "4d0fc8fe-f79f-375e-9050-01a20bb654b6",
                                "text": "Les donnades étaient simplement des duels, où les poings remplaçaient l’épée, mais qui obéissaient à un cérémonial identique."
                            }
                        ]
                    },
                    {
                        "sense_id": "232ce003-e373-3f04-9d34-e0758893a0be",
                        "entry_id": "79af07e3-897c-3166-8d76-0101c40b39f5",
                        "glosses": [
                            "Bataille, bagarre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9c7462e5-2bcc-4185-bf57-088fbb5ed7fd",
                                "sense_id": "232ce003-e373-3f04-9d34-e0758893a0be",
                                "text": "On les empêchera de partir. Les pieds noirs, on n’a qu’à prendre tous les armes, allez ! La grande donnade, la grande bagarre, et qu’on en finisse une fois pour toutes ! Purée de nous !"
                            }
                        ]
                    }
