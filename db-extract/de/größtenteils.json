                    {
                        "sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                        "entry_id": "cd84de26-2dbb-3568-a6d9-78e8cf98d84b",
                        "glosses": [
                            "die Mehrheit, die größte Teilmenge umfassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b47336bc-6d03-4999-a30c-a0339316076d",
                                "sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                                "text": "Das Projekt wurde größtenteils mit Steuergeldern finanziert."
                            },
                            {
                                "example_id": "63932594-c271-47b4-9a96-76046dc319f0",
                                "sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                                "text": "Die Bevölkerung steht größtenteils hinter der Regierung."
                            },
                            {
                                "example_id": "9482e3eb-dce6-4af2-862b-eae025d138bb",
                                "sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                                "text": "„In dem Konflikt geht es um mehr als eine Reihe größtenteils unbewohnter Inseln und Riffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f78a7f8-144c-4f1c-866e-fa9ee2a1af1f",
                        "source_entry_id": "cd84de26-2dbb-3568-a6d9-78e8cf98d84b",
                        "source_sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                        "source_sense_description": "die Mehrheit, die größte Teilmenge umfassend",
                        "target_lang_word": "for the most part",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the most part",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                        "entry_id": "25a6b36f-0a88-36ac-9ec9-7dd3c2369ef8",
                                        "glosses": [
                                            "In most aspects; mostly; generally."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ba8bc7-c406-4e1e-b59b-d29a47d7a4cf",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "For the most part, the crowd was orderly."
                                            },
                                            {
                                                "example_id": "b072f81e-e4a0-4821-8508-5158a9691f55",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "The sky is overcast for the most part."
                                            },
                                            {
                                                "example_id": "0e9e9f60-4039-405d-8ea2-677e1b90b6df",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "Until the 1600s, English was, for the most part, spoken in England."
                                            },
                                            {
                                                "example_id": "4090b4b8-f56c-4b01-9f81-0762a72b38a0",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "O, it offends mee to the Soule, to ſee a robuſtious Pery-wig-pated Fellow, teare a Paſſion to tatters, to verie ragges, to ſplit the eares of the Groundlings: who (for the moſt part) are capeable of nothing, but inexplicable dumbe ſhewes, & noiſe:[…]"
                                            },
                                            {
                                                "example_id": "7aa23865-2f9e-4f4e-8891-9d390324a39c",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "Such souls can with assistance rise to better things, but it is a very arduous task and for the most part they remain rejoicers in evil."
                                            },
                                            {
                                                "example_id": "6be70a0d-d189-48fa-ac79-6a9860a2f5df",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "For the most part they were small standard gauge 0-6-0 side tanks of the type illustrated, with long tapered chimneys and an unusual feature for the Continent in the shape of domeless boilers, the protuberance just behind the chimney being a sandbox."
                                            },
                                            {
                                                "example_id": "26a9e8dc-4abc-483b-b671-afebfe96b8de",
                                                "sense_id": "ca32d96d-17f0-39fb-a84c-89b7ad243a49",
                                                "text": "With half-time approaching, England rather switched off, but for the most part it was an improved first 40 minutes from Johnson's side, which came in for much criticism following stuttering displays in their first two games."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23c0754e-231e-4bb4-8e5e-2923d1119613",
                        "source_entry_id": "cd84de26-2dbb-3568-a6d9-78e8cf98d84b",
                        "source_sense_id": "25caa48b-5104-374a-be50-0a5744cae9f0",
                        "source_sense_description": "die Mehrheit, die größte Teilmenge umfassend",
                        "target_lang_word": "mainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Chiefly; for the most part."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c611281-7900-4468-bce6-a678acc47ffd",
                                                "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                                "text": "She had Lord James' collar in one big fist and she pounded the table with the other and talked a blue streak. Nobody could make out plain what she said, for she was mainly jabbering Swede lingo, but there was English enough, of a kind, to give us some idee."
                                            },
                                            {
                                                "example_id": "f12e6d1c-f71d-479c-a346-36300a0fb718",
                                                "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                                "text": "If you’re looking for the most breathable mask, Lukovics says, “Cotton is preferable, mainly for absorbing moisture/sweat.” She says multiple layers may be more protective but will also impact breathability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Forcefully, vigorously."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9dc792-e7f5-4c58-b3e5-6a5522e985d3",
                                                "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                                "text": "Such breadth of ſhoulders as might mainely beare\nOlde Atlas burthen, […]"
                                            },
                                            {
                                                "example_id": "ab9258e4-70c9-4cd1-bdd3-db41ea0f67c5",
                                                "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                                "text": "Mainly they all attonce vpon him laid, / And sore beset on euery side around […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d1e9fc-0700-3bff-b602-3f62ee8c1e5d",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Of the production of a sound: loudly, powerfully."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "284fc8bc-08de-43a3-a48c-49015dbc7370",
                                                "sense_id": "e3d1e9fc-0700-3bff-b602-3f62ee8c1e5d",
                                                "text": "But in the end, mainly crying out, he fell to raling and wringing his master, upbraiding him that he was not a true Philosopher[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833b6ef3-df0a-3287-9b5b-9c4495df10cb",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "To a great degree; very much."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
