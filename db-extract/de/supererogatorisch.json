                        "source_sense_description": "Philosophie, Moraltheologie: mehr als ethisch gefordert; über die Pflichterfüllung hinausgehend gut",
                        "target_lang_word": "supererogatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supererogatory",
