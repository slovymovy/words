                "senses": [
                    {
                        "sense_id": "e235633c-33ea-3abb-a428-6f927517954a",
                        "entry_id": "5fd4b519-1dd6-3d4f-a1cc-e65fc1285b90",
                        "glosses": [
                            "Ne plus amuser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c515392a-5824-42af-919f-1615623923b0",
                                "sense_id": "e235633c-33ea-3abb-a428-6f927517954a",
                                "text": "Sûrement aussi Rafounet puisque son textounet pour une fois amuse ses \"détracteurs\" et désamuse ses adulateurs."
                            },
                            {
                                "example_id": "00cbd0af-73c5-449a-bb29-2f6e9f71d345",
                                "sense_id": "e235633c-33ea-3abb-a428-6f927517954a",
                                "text": "On se désabuse, on se désamuse."
                            },
                            {
                                "example_id": "54508de2-889c-470e-afe5-6273b1d02a62",
                                "sense_id": "e235633c-33ea-3abb-a428-6f927517954a",
                                "text": "Regarder au risque de voir, c'est se désamuser des références pour oser se laisser abuser par les sens."
                            }
                        ]
                    }
