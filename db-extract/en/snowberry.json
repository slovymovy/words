                                "target_senses": [
                                    {
                                        "sense_id": "26da1d51-62e6-3897-a9ac-2c989f5f4cd4",
                                        "entry_id": "1e0cdd43-df16-3c38-91b9-27e1cacd829d",
                                        "glosses": [
                                            "Plante du genre Symphoricarpos de la famille des Caprifoliacées, originaire d'Amérique, il compte 17 espèces d'arbustes caducs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12bfdcab-1c3f-4046-b5dd-a6e6ef7e3b3e",
                                                "sense_id": "26da1d51-62e6-3897-a9ac-2c989f5f4cd4",
                                                "text": "Il avait sur la poitrine un chapelet dont les grains blancs, autour d'une rose en train de se faner, ressemblaient à l'égrènement d'un rameau de symphorine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1443e5b-af93-417a-be96-bb9cb9ff31b3",
                        "source_entry_id": "afe6cb29-f6de-3f2e-8d87-f1b7c194cc21",
                        "source_sense_description": "Translations",
                        "target_lang_word": "śnieguliczka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "61a20c7c-6397-4fc8-9227-0172e23d9013",
                        "source_entry_id": "afe6cb29-f6de-3f2e-8d87-f1b7c194cc21",
                        "source_sense_description": "fruit",
                        "target_lang_word": "Knallerbse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knallerbse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                        "entry_id": "3491fc32-9378-3bc6-961a-597d05041b83",
                                        "glosses": [
                                            "kleiner kugelförmiger Feuerwerkskörper, der beim Aufprall knallend explodiert"
                                        ],
                                        "tags": [
                                            "Pyrotechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b939b681-990b-4162-9ef9-1c214ff5bbc7",
                                                "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                                "text": "Er ließ am Silvesterabend ein paar Knallerbsen im Garten zerspringen."
                                            },
                                            {
                                                "example_id": "3b46b874-c0d2-41e2-a22b-6ffb2822d471",
                                                "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                                "text": "„Am Abend war die ganze Stadt erleuchtet; und die Soldaten ſchoſſen mit Kanonen und die Knaben mit Knallerbſen; und es wurde gegeſſen und getrunken, angeſtoßen und geſprungen oben im Schloſſe.“"
                                            },
                                            {
                                                "example_id": "1d6191dc-f814-4401-a184-908aff169430",
                                                "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                                "text": "„Für gewöhnlich hat man, um den Glauben an Etwas zu erschüttern, durchaus nicht nöthig, ohne Weiteres das schwerste Geschütz des Angriffs vorzufahren; bei Vielen führt es schon zum Ziele, wenn man den Angriff mit etwas Lärm macht: sodass oft Knallerbsen genügen.“"
                                            },
                                            {
                                                "example_id": "988ba479-725e-4ebd-a61c-7f5e1ae7ef20",
                                                "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                                "text": "„Doch dieses zweite Jahr, das zu Ende ging, war das Jahr 32. Elli beruhigte ihr Kind, das durch die Knallerbsen und Prositrufe auf das Jahr 33 erwachte.“"
                                            },
                                            {
                                                "example_id": "a5116af8-0091-4b43-9b03-a517ce57a09e",
                                                "sense_id": "08896c83-2d3f-36d0-aacf-3b18172154c5",
                                                "text": "„Darauf verstummte alles, und dann war es wieder anzuhören, als sei jemand auf Knallerbsen getreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88a578ad-1cd5-3388-bc9f-2e1bfc5e387f",
                                        "entry_id": "3491fc32-9378-3bc6-961a-597d05041b83",
                                        "glosses": [
                                            "weiße Frucht der Gewöhnlichen Schneebeere (Symphoricarpos albus), die beim Zerdrücken ein knackendes Geräusch erzeugt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f57acfa4-7387-4c2e-b33e-b014988d9fb8",
                                                "sense_id": "88a578ad-1cd5-3388-bc9f-2e1bfc5e387f",
                                                "text": "„Die letzte, noch subtilere Form, stellen die Knallerbsen dar, die, von den kahlen Sträuchern gepflückt und auf der Straße zertreten, plupp machen, zumindest manchmal.“"
                                            },
                                            {
                                                "example_id": "f9d0eb7c-0d2e-4bd6-9c34-38c6a681b20c",
                                                "sense_id": "88a578ad-1cd5-3388-bc9f-2e1bfc5e387f",
                                                "text": "„Die Kinder pflücken ‚Knallerbsen‘ von einem Busch und lassen sie am Boden zerplatzten.“"
                                            },
                                            {
                                                "example_id": "65049a63-9673-4194-b503-34dd85f82eaf",
                                                "sense_id": "88a578ad-1cd5-3388-bc9f-2e1bfc5e387f",
                                                "text": "„Von den Büschen wurden die weißen Knallerbsen gepflückt, die ich dann mit einem lauten Knall zertreten durfte.“"
                                            },
                                            {
                                                "example_id": "1d899668-579d-4cf3-8713-24cf5aacd8e8",
                                                "sense_id": "88a578ad-1cd5-3388-bc9f-2e1bfc5e387f",
                                                "text": "„Gerade steuert ein Mädchen mit seinem jüngeren Bruder an der Hand zielstrebig auf das Gebüsch zu. ‚Knallerbsen!‘, ruft die Kleine erfreut, denn so werden die Beeren im Volksmund genannt. In bester Laune stellen sich die Kinder auf Zehenspitzen und recken die Arme in die Höhe, um an die weißen Kugeln zu gelangen. Dann werfen sie sie mit Schwung auf den Erdboden und freuen sich über das puffende Geräusch, das beim Aufprall entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7be3c92f-549d-3813-9c75-9a04a9cda3ba",
                                        "entry_id": "3491fc32-9378-3bc6-961a-597d05041b83",
                                        "glosses": [
                                            "jemand, der als dumm, einfältig oder als nicht sonderlich kompetent angesehen wird"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91ed64b-8b76-4f69-8d2b-bbbd42d04a39",
                                                "sense_id": "7be3c92f-549d-3813-9c75-9a04a9cda3ba",
                                                "text": "„‚Die Erde ist rund, und wir stehen obendrauf. Aber sie dreht sich schließlich, und so müßten wir doch irgendwann einmal auf dem Kopf stehen. He, warum stehen wir nicht auf dem Kopf?‘ ‚Du Knallerbse!‘ brummte Schönfisch. ‚Das ist ganz einfach, das macht die Anziehungskraft der Erde. Sie wirkt wie ein Magnet.‘“"
                                            },
                                            {
                                                "example_id": "5805a1ed-306b-42c2-a5d7-c25970077102",
                                                "sense_id": "7be3c92f-549d-3813-9c75-9a04a9cda3ba",
                                                "text": "„Marion C.’s Tochter war gerade acht, als sie von ihrer Lehrerin zu hören bekam: ‚Du Knallerbse, streng deinen Gehirnkasten an.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
