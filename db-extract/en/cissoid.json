                        "entry_id": "0a102dde-ad5c-3030-bfb5-3c35678358a8",
                        "glosses": [
                            "Any of a family of curves defined as the locus of a point, P, on a line from a given fixed point and intersecting two given curves, C₁ and C₂, where the distance along the line from C₁ to P remains constant and equal to the distance from P to C₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72cc083a-8a56-41a2-b480-4cb8e394f711",
                                "sense_id": "6ae6cfc7-b796-3630-96d5-2c83e5332b63",
                                "text": "The cissoid of a circle and a line is a conchoid"
                            }
                        ]
                    }
                ],
