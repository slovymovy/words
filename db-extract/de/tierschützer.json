                ],
                "senses": [
                    {
                        "sense_id": "a296cad3-e32a-3bd3-97aa-ec2cd86dcf0a",
                        "entry_id": "c19ae8c2-9abf-3cf7-aef7-b64d276b41ac",
                        "glosses": [
                            "Person, die sich im Tierschutz engagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba24b0c-ad6c-4706-b048-19e71532f1c3",
                                "sense_id": "a296cad3-e32a-3bd3-97aa-ec2cd86dcf0a",
                                "text": "Tierschützer fordern schon lange ein Verbot für Tierversuche."
                            },
                            {
                                "example_id": "79d7d141-83d2-49e4-bd56-8a8ca00ae6bd",
                                "sense_id": "a296cad3-e32a-3bd3-97aa-ec2cd86dcf0a",
                                "text": "„Gegen die noch immer beliebten Gatterjagden laufen die Tierschützer vom VgT (Verein gegen Tierfabriken) seit Jahren Sturm. Mehrere Prozesse gegen diverse Veranstalter sind anhängig.“"
                            },
                            {
                                "example_id": "545f6b47-cc8d-447e-a311-34f05d11ef3a",
                                "sense_id": "a296cad3-e32a-3bd3-97aa-ec2cd86dcf0a",
                                "text": "„Vielleicht haben sich Menschen seither fortwährend Gedanken darüber gemacht, wie Tiere gehalten werden sollen. Vereinsmäßig organisierten sich Tierschützer und Tierschützerinnen aber erst im 19. Jahrhundert, die ersten in Österreich 1846 in Wien und 1860 in Graz.“"
                            },
                            {
                                "example_id": "3b64db1c-72d7-42a7-a7fc-1015b1dee4e4",
                                "sense_id": "a296cad3-e32a-3bd3-97aa-ec2cd86dcf0a",
                                "text": "„Tierschützer greifen oft Klimawissenschaftler an, nur weil diese darauf hinweisen, dass der Beitrag des Fleischessens im Vergleich zur Verbrennung fossiler Brennstoffe gering ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
