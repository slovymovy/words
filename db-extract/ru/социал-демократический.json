                        "cross_references": [
                            {
                                "target_word": "social-démocrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                                        "entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                                        "glosses": [
                                            "Partisan de la social-démocratie ; socialiste non marxiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4da5f1-ee02-4646-90c8-2c847b55c725",
                                                "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                                                "text": "Pendant que dans l'économie communiste le Gosplan était substitué à la « main invisible » du marché, le keynésianisme tempéré, combinant le rôle de l'État et celui du marché, inspirait la pensée des démocrates américains et des sociaux-démocrates européens."
                                            },
                                            {
                                                "example_id": "4767a9cb-789f-4df2-bc49-b50eef4b4a47",
                                                "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                                                "text": "Ils pensent qu'il faut investir ici, fabriquer ici, créer de emplois de qualité ici, ce qui est essentiel pour les sociaux-démocrates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c1ff43-3c75-3fe4-b05f-b9e0f92931e2",
                                        "entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                                        "glosses": [
                                            "Membre ou partisan d'un parti membre de la Deuxième Internationale ; en principe socialiste marxiste."
                                        ],
                                        "tags": [
                                            "Marxism"
                                        ],
                                        "note": "Dans ce cas le pluriel social-démocrates est utilisé car le terme « social » est considéré comme l'apocope de « socialiste »",
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "social-démocrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f70335b-59f7-3766-8e09-6d0387265ac8",
                                        "entry_id": "62713327-00b5-3146-8b78-56ce9d68beac",
                                        "glosses": [
                                            "Relatif à la social-démocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6a75eb-55af-4cda-a6ca-4f2f57528027",
                                                "sense_id": "4f70335b-59f7-3766-8e09-6d0387265ac8",
                                                "text": "D’autres militants ont aussi connu un changement idéologique, des volontaires nous ont fait part notamment de l’américain Michael Israel, militant social-démocrate aux États-Unis, qui a commencé à s’intéresser en Syrie aux théories anarchistes et marxistes-léninistes."
                                            }
                                        ]
                                    }
                                ]
                            }
