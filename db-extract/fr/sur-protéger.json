                ],
                "senses": [
                    {
                        "sense_id": "717c0c41-7a28-3d3a-8c99-2b8b7171e169",
                        "entry_id": "adea0f32-0f43-3ac8-939d-03a9587a9acd",
                        "glosses": [
                            "Protéger excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f514d7-0e3b-4f29-989c-8d30184f944a",
                                "sense_id": "717c0c41-7a28-3d3a-8c99-2b8b7171e169",
                                "text": "Dans le même temps, il vend de faux tableaux à des hommes redoutables et cambriole des musées sur-protégés."
                            },
                            {
                                "example_id": "131af965-57da-479b-a12f-fed287b2e9a2",
                                "sense_id": "717c0c41-7a28-3d3a-8c99-2b8b7171e169",
                                "text": "Nous savons que leur expérience historique les a poussés à se sur-protéger."
                            },
                            {
                                "example_id": "5abedb5a-9c58-4802-9419-d574c32685c6",
                                "sense_id": "717c0c41-7a28-3d3a-8c99-2b8b7171e169",
                                "text": "Jumeau survivant, dans l’atmosphère magico-superstitieuse de l’époque, Charles a été élevé en jumeau, attitude qui, chez ses parents, correspond vraisemblablement au désir de le « sur-protéger », de le garantir contre le mauvais sort."
                            }
                        ]
                    }
