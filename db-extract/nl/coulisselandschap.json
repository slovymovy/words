                "senses": [
                    {
                        "sense_id": "e6f12d39-94ae-39ee-81d9-cf8d1ab0039a",
                        "entry_id": "51bfbc54-983e-37dd-a07f-fc431a8b73d9",
                        "glosses": [
                            "een landschap met weiden omgeven door houtwallen en heggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e04fe0a-a767-474a-898c-e73f775f0fd0",
                                "sense_id": "e6f12d39-94ae-39ee-81d9-cf8d1ab0039a",
                                "text": "In de Brabantse gemeente Bergeijk liggen het openbare groen en de particuliere tuinen er volgens de jury prima bij. Het kleinschalige coulisselandschap krijgt de bescherming die het verdient, inclusief de heideontginningen, productiebossen, kruidenrijke vloeiweiden en meanderende beken."
                            },
                            {
                                "example_id": "e6b9011f-e3e2-4d7c-9559-1b8453a78bff",
                                "sense_id": "e6f12d39-94ae-39ee-81d9-cf8d1ab0039a",
                                "text": "De natuur, gemeenschapszin (noaberschap) en nuchterheid maken de inwoners van Overijssel trots. Ook hier zijn de ouderen vaker trots op de natuur, zoals het coulisselandschap. Jongeren zijn trots op Grolsch en de tradities (o.a. de Paasvuren) van hun provincie."
                            }
                        ]
                    }
