                    "frequency": "Middle",
                    "semantic_group_id": "maturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tomatoes will <w>ripen</w> on the vine if you leave them in the sun."
                        },
                        {
                            "text": "These peaches need a few more days to <w>ripen</w> properly."
                        }
                    ],
                    "synonyms": [
                        "mature",
                        "mellow"
                    ],
                    "common_phrases": [
