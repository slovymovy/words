                        "glosses": [
                            "Begriff, durch den in einer Definition das Definiendum erklärt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724798ac-5f5c-4891-beb3-8a9faf862f0e",
                                "sense_id": "47c424ff-ec8c-3fe3-a657-70701639fc65",
                                "text": "In \"Ein Mann ist ein erwachsener, männlicher Mensch.\" ist \"ein erwachsener, männlicher Mensch\" das Definiens, \"Mann\" das Definiendum."
                            }
                        ],
                        "sense_index_json": "\"1\""
