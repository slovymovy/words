                                    {
                                        "sense_id": "f01041ad-3ebe-3216-ae07-743185a6a179",
                                        "entry_id": "07fbfc6f-d070-376f-acbc-108608313019",
                                        "glosses": [
                                            "een bos dat langs rivieren groeit op de strook land aan weerszijden ervan die regelmatig overstroomt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad00542-3832-4cf8-b0fc-8a1bac61050f",
                                                "sense_id": "f01041ad-3ebe-3216-ae07-743185a6a179",
                                                "text": "Zulke ooibossen bestaan uit wilgen en populieren, die bestand zijn tegen overstromingen. Op hogere plekken in de ooibossen staan eiken, essen en iepen."
                                            }
                                        ]
                                    }
                                ]
                            }
