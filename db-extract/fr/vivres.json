    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4ab6f286-89ca-338b-9793-b7770ad50e71",
                "word": "vivres",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a77f47c2-a62b-3b19-be10-5b35a9a31002",
                        "entry_id": "4ab6f286-89ca-338b-9793-b7770ad50e71",
                        "glosses": [
                            "food supplies, provisions"
                        ],
                        "tags": [
                            "masculine",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1dc397dc-7621-434c-bdb2-c0ffe5836b59",
                                "sense_id": "a77f47c2-a62b-3b19-be10-5b35a9a31002",
                                "text": "Quant aux provisions, c'était autre chose. Les vivres devaient être abondants et facilement transportables.",
                                "translation": "As for provisions, it was a different story. The supplies had to be abundant and easily transportable.",
                                "english": "As for provisions, it was a different story. The supplies had to be abundant and easily transportable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [],
