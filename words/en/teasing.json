{
    "word_family": [
        "tease",
        "teaser"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0505f9b8-cda9-3f41-984b-450c34a197dd",
                    "sense_definition": "Playfully vexing, especially by ridicule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "teasing_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children exchanged <w>teasing</w> remarks during recess.",
                            "target_lang_translations": {
                                "ru": "Во время перемены дети обменивались <w>дразнящими</w> замечаниями."
                            }
                        },
                        {
                            "text": "He gave her a <w>teasing</w> smile after winning the game.",
                            "target_lang_translations": {
                                "ru": "Выиграв игру, он одарил её <w>насмешливой</w> улыбкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "mocking"
                    ],
                    "common_phrases": [
                        "teasing remark"
                    ],
                    "target_lang_definitions": {
