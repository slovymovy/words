                        "target_lang_word": "windfall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windfall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92c2f153-4fd9-39db-a536-d68b996b1c7b",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "Something that has been blown down by the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e93d463-284c-38f8-849c-d592e2eda51d",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "The act of something being blown down by wind."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45875ac5-299f-4a3c-a3b3-fd4da5174d31",
                                                "sense_id": "2e93d463-284c-38f8-849c-d592e2eda51d",
                                                "text": "The danger from windfall is greatest to trees developed in dense stands, which are tall and have slender stems, and increases with the age of the stand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff33d22-9d55-326d-bccc-9911759bc189",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "A fruit that has fallen from a tree naturally, as from wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a790415e-5b52-4310-a15d-3d226f913a04",
                                                "sense_id": "aff33d22-9d55-326d-bccc-9911759bc189",
                                                "text": "They couldn't reach the branches, so they ate the windfalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                        "entry_id": "9189ca77-26ef-3eab-bef2-36f2b0c0d6a1",
                                        "glosses": [
                                            "A sudden large benefit; especially, a sudden or unexpected large amount of money, as from lottery or sweepstakes winnings or an unexpected inheritance or gift."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad07cc43-4463-4162-9eb1-9c5abb8495a2",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "Businessmen rushed to get every last commodity aboard a departing ship, hoping for a windfall once the world realized these would be the very last sacks of flour available, thus driving up prices."
                                            },
                                            {
                                                "example_id": "7bf3917a-6ead-4bbd-a46d-11092edfdb6c",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "One of six siblings who’d been raised by a single mother, the client had earned a windfall of around $400,000 after going viral in 2021."
                                            },
                                            {
                                                "example_id": "cd1807a4-d245-4cc5-9892-c03a47b50e49",
                                                "sense_id": "9779eeb1-39b7-33f8-ba58-239a28c2f5d6",
                                                "text": "In addition to following the lead of Newcastle and Crystal Palace in making this a season of glory for clubs who rarely, if ever, win a trophy, Tottenham are also set to benefit from a £100m windfall after qualifying for next season's Champions League."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112599af-1487-4085-a61b-bf782077ec93",
                        "source_entry_id": "12d30563-c34f-360c-a2c4-5d8f3343f60c",
                        "target_lang_word": "Sturmknickung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "35cd03a7-5675-4862-9d19-af72f3abfe62",
                        "source_entry_id": "12d30563-c34f-360c-a2c4-5d8f3343f60c",
                        "target_lang_word": "Windbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a16c990c-aac5-367f-844e-34ffedb4a523",
                                        "entry_id": "8a98412b-be9c-3b56-96f9-0c3ca27f6a46",
                                        "glosses": [
                                            "durch Sturm hervorgerufene Zerstörung von Pflanzen (meist in Wäldern); das so entstandene Holz, das entsorgt beziehungsweise verwendet werden kann"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eecd087-696f-407f-ac3f-ae55d30e6bc5",
                                                "sense_id": "a16c990c-aac5-367f-844e-34ffedb4a523",
                                                "text": "„Die Bundesstraße 255 im Landkreis Altenkirchen musste nach massivem Windbruch voll gesperrt werden.“"
                                            },
                                            {
                                                "example_id": "41dae43d-cc2d-4664-aec9-f15e6903e294",
                                                "sense_id": "a16c990c-aac5-367f-844e-34ffedb4a523",
                                                "text": "„Ein einzelner, vom Winde mit der Wurzel umgestürzter Baum wird Windfall genannt, und ein vom Winde abgebrochener Stamm wird Windbruch genannt.“"
                                            },
                                            {
                                                "example_id": "850b1cee-ebc1-4b04-896d-f5c7b5f3be05",
                                                "sense_id": "a16c990c-aac5-367f-844e-34ffedb4a523",
                                                "text": "„Von diesem Windbruch muß der größte Teil verfaulen, weil man in diesen Gegenden, sobald man solche räumen wollte, das Holz nicht absetzen könnte.“"
                                            },
                                            {
                                                "example_id": "c64f80aa-490c-45fd-9b64-aed540afc45d",
                                                "sense_id": "a16c990c-aac5-367f-844e-34ffedb4a523",
                                                "text": "„Sofort wurden neue Eßvorräte ins Granithaus geschafft, und die Siedler sahen bei ihren Gängen, daß der Sturm einen ziemlichen Windbruch hinterlassen und sogar 2 m vom Schornstein des Töpferofens umgeworfen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
