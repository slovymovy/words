{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65af3171-5cb7-3b0e-948a-5efd7d9ebabd",
                    "sense_definition": "The right-hand side of a ship, boat, or aircraft when facing forward toward the bow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nautical_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain spotted a lighthouse off the <w>starboard</w> side of the ship.",
                            "target_lang_translations": {
                                "zh": "船长在船的<w>右舷</w>方向发现了一座灯塔。"
                            }
                        },
                        {
                            "text": "Passengers were instructed to assemble on <w>starboard</w> during the safety drill.",
                            "target_lang_translations": {
                                "zh": "安全演习期间，乘客们被指示在<w>右舷</w>集合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "right"
                    ],
                    "antonyms": [
                        "port",
                        "larboard"
                    ],
                    "common_phrases": [
                        "starboard side",
                        "to starboard"
                    ],
                    "target_lang_definitions": {
                        "zh": "（船或飞机的）右舷，面向船首或机头方向时的右侧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "右舷",
                                "target_lang_sense_clarification": "船只或飞行器的右侧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8acfa9d3-6f78-3fad-bcc2-6707481b6439",
                    "sense_definition": "A channel, list, or feed in an online community that showcases messages marked or starred by users.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "online_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her funny comment received ten reactions and immediately appeared on the <w>starboard</w>.",
                            "target_lang_translations": {
                                "zh": "她那条有趣的评论获得了十个互动，并立即出现在了<w>星标频道</w>上。"
                            }
                        },
                        {
                            "text": "The server moderators added a bot to manage the <w>starboard</w> automatically.",
                            "target_lang_translations": {
                                "zh": "服务器管理员添加了一个机器人来自动管理<w>星标频道</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in online chat communities like Discord"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（网络社群，如Discord中）用于展示被用户加星标或高赞消息的精华频道或精选看板。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "星标频道",
                                "target_lang_sense_clarification": "社群中汇集被加星标优质消息的频道"
                            },
                            {
                                "target_lang_word": "精华板",
                                "target_lang_sense_clarification": "展示精选或高赞消息的板块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00014445-a29e-3a7f-8773-8e94d470b7d6",
                    "sense_definition": "One of the two traditional crew shifts or watches aboard a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew was divided into port and <w>starboard</w> to cover the night duties.",
                            "target_lang_translations": {
                                "zh": "全体船员被分为左舷班和<w>右舷班</w>来轮流执行夜间值班任务。"
                            }
                        },
                        {
                            "text": "Members of the <w>starboard</w> stood ready on deck as the storm intensified.",
                            "target_lang_translations": {
                                "zh": "随着暴风雨加剧，<w>右舷值班组</w>的成员在甲板上严阵以待。"
                            }
                        }
                    ],
                    "antonyms": [
                        "port"
                    ],
                    "common_phrases": [
                        "starboard watch"
                    ],
                    "target_lang_definitions": {
                        "zh": "（船上的）右舷值班组，传统上船员分成两班轮值中的一组。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "右舷值班组",
                                "target_lang_sense_clarification": "船上轮流值班的右舷船员组"
                            },
                            {
                                "target_lang_word": "右舷班",
                                "target_lang_sense_clarification": "右舷值班人员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8b0c65b-aa83-3ffd-9b5a-02025bc5f3bc",
                    "sense_definition": "To turn the helm or steer a vessel toward the right-hand side.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The helmsman was ordered to <w>starboard</w> the wheel immediately to avoid the rocks.",
                            "target_lang_translations": {
                                "zh": "舵手接到命令立即<w>向右转舵</w>，以避开暗礁。"
                            }
                        },
                        {
                            "text": "As the navigator yelled, the sailor quickly <w>starboarded</w> to avert the collision.",
                            "target_lang_translations": {
                                "zh": "随着领航员一声大喊，水手迅速<w>向右转舵</w>以避免碰撞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "starboard the helm"
                    ],
                    "target_lang_definitions": {
                        "zh": "把舵或船身转向右舷；向右转舵。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "向右转舵",
                                "target_lang_sense_clarification": "操舵使船只向右转向"
                            },
                            {
                                "target_lang_word": "右转",
                                "target_lang_sense_clarification": "操纵船只向右偏转"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}