                                "target_senses": [
                                    {
                                        "sense_id": "9af62066-01c1-3f4f-949a-f668f31e43de",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "A pigment (or dye)-based fluid used for writing, printing etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e910c30a-6976-4437-a646-7cf8d1722096",
                                                "sense_id": "9af62066-01c1-3f4f-949a-f668f31e43de",
                                                "text": "This form should be filled out in ink."
                                            },
                                            {
                                                "example_id": "4d730449-6c2d-4fd0-b68e-bd51626fc666",
                                                "sense_id": "9af62066-01c1-3f4f-949a-f668f31e43de",
                                                "text": "While I was waiting for him in the Matted Gallery, a young man was most finely working in Indian inke the great picture of the King and Queen sitting [Charles I of England and Henrietta Maria of France], by Van Dyke [Anthony van Dyck]; and did it very finely."
                                            },
                                            {
                                                "example_id": "6878514a-a2e7-4f96-a0e7-c69d96e5d39d",
                                                "sense_id": "9af62066-01c1-3f4f-949a-f668f31e43de",
                                                "text": "Both halves feature lyrics that are so teen-girly they sound like they were written in pink ink in a padlocked diary with hearts and frowny faces for punctuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9858255c-c3be-334f-98f4-2c58159edfd6",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "A particular type, color or container of this fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "154609de-4e83-3dc8-a888-4104a8889bc7",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "The black or dark-colored fluid ejected by squid, octopus etc, as a protective strategy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14aea5b-e17c-4ecd-8843-55ea9ad8446f",
                                                "sense_id": "154609de-4e83-3dc8-a888-4104a8889bc7",
                                                "text": "Experimentally, some ink has been shown to be unpalatable to fish (Wood et al. 2010) and observationally, ink can also function as an attractant to predators to give cephalopods a bit more time to escape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250868ae-f267-30fd-baed-4aceb3059799",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "Publicity."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad800469-c893-4a3c-8469-e29aaa9d081c",
                                                "sense_id": "250868ae-f267-30fd-baed-4aceb3059799",
                                                "text": "to get ink"
                                            },
                                            {
                                                "example_id": "6f8e1d91-e457-41ca-a2a2-b56f7b011b3a",
                                                "sense_id": "250868ae-f267-30fd-baed-4aceb3059799",
                                                "text": "The TSA has been getting a lot of ink lately."
                                            },
                                            {
                                                "example_id": "6f4489dc-8e85-4823-82dc-3e7dd9387f26",
                                                "sense_id": "250868ae-f267-30fd-baed-4aceb3059799",
                                                "text": "[Judith] Hope […] has been getting ink by the barrelful with her regular interviews quoting conversations with the first lady, on subjects ranging from Senate ambitions to summer and post-White House living arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eccfb73e-b17e-344d-b6db-052c204c9c4e",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "Tattoo work."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f6a215-0bc9-4e7b-9ae5-a7e7f1244710",
                                                "sense_id": "eccfb73e-b17e-344d-b6db-052c204c9c4e",
                                                "text": "\"I saw it hanging on the wall of a tattoo hut where I went to get some ink done ten years ago,\" he stuttered, flushing in splotches and squirming in his chair."
                                            },
                                            {
                                                "example_id": "d9dad2aa-a845-4ad0-b544-0d917d87291b",
                                                "sense_id": "eccfb73e-b17e-344d-b6db-052c204c9c4e",
                                                "text": "Now he's getting a tattoo / Yeah, he's getting ink done / He asked for a 13, / But they drew a 31"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74446e09-13c7-35cc-b556-b800b491a148",
                                        "entry_id": "4e3d3486-b15c-3d72-8822-0159deb6f161",
                                        "glosses": [
                                            "Cheap red wine."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72d6fba7-338a-3b52-8582-17310fa0331e",
                                        "entry_id": "08566df6-1bb4-398a-98b5-e9b0baeff298",
                                        "glosses": [
                                            "To apply ink to; to cover or smear with ink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949228a7-791b-457a-a4b0-d816b5e20762",
                                                "sense_id": "72d6fba7-338a-3b52-8582-17310fa0331e",
                                                "text": "A plain impression is obtained by pressing the bulb of the finger, with the plane of the nail parallel to the plane of the plate, on the inked plate and then on the paper in the same manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "717c8dbb-dcc3-3024-90ca-b81858cd6f26",
                                        "entry_id": "08566df6-1bb4-398a-98b5-e9b0baeff298",
                                        "glosses": [
                                            "To sign (a contract or similar document)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c1cbf61-bc17-4bf3-99c7-77f4e85987d7",
                                                "sense_id": "717c8dbb-dcc3-3024-90ca-b81858cd6f26",
                                                "text": "Before Musk, America’s space industry was moribund. In 2011, NASA mothballed the last space shuttle, after inking a deal with SpaceX to make uncrewed cargo resupply runs to the International Space Station (ISS)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2e5441-bf4e-3dfe-af4f-fd53c260bda3",
