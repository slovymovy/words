                    "frequency": "Low",
                    "semantic_group_id": "agonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille entreprise <w>râle</w> depuis des mois avant son inévitable fermeture."
                        },
                        {
                            "text": "Le soldat blessé a <w>râlé</w> pendant plusieurs heures avant de s'éteindre."
                        }
                    ]
                },
                {
                    "sense_id": "e46e67e3-44dc-3f1c-8f65-2ce20126b6e7",
                    "sense_definition": "Pousser son cri naturel, en parlant de certains animaux comme le daim ou le cerf.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au fond des bois humides, on pouvait entendre le daim <w>râler</w> à la tombée de la nuit."
                        },
                        {
                            "text": "Le grand cerf <w>râlait</w> au cœur de la forêt pour marquer son territoire."
                        }
                    ]
                }
            ]
        },
