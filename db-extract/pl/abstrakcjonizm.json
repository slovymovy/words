                    {
                        "translation_id": "79285677-932d-434c-9d40-89d9938522b1",
                        "source_entry_id": "26f1c6c7-f5f0-34f8-a858-960d0a9b7fc3",
                        "source_sense_id": "bfb92a6c-530c-3595-84d6-153c6ad88c83",
                        "target_lang_word": "abstractionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstractionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "816f081d-dc9e-32fd-affb-39eaa39beceb",
                                        "entry_id": "1f673032-950c-32b0-a01c-a6e5e9683692",
                                        "glosses": [
                                            "Art abstrait, qui atteint ou recherche un niveau d’abstraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ae16e3-118c-4256-8cef-00d2c21b1560",
                                                "sense_id": "816f081d-dc9e-32fd-affb-39eaa39beceb",
                                                "text": "C'est un abstractionnisme désincarné et morbide."
                                            },
                                            {
                                                "example_id": "8e193384-c567-41a4-9078-7ed8bde77589",
                                                "sense_id": "816f081d-dc9e-32fd-affb-39eaa39beceb",
                                                "text": "Notre époque, empoisonnée par l’abstractionnisme galopant et par le nihilisme de l’art conceptuel, a besoin de quelqu’un qui dessine le visage de la contemporanéité."
                                            },
                                            {
                                                "example_id": "acd9c1cf-2b4d-40d8-b6e6-5f737f1ae92c",
                                                "sense_id": "816f081d-dc9e-32fd-affb-39eaa39beceb",
                                                "text": "Il est chez nous des critiques d’art isolés prêts à affirmer que le plus grand malheur de notre art — est la diffusion insuffisante de l’abstractionnisme capable d’infuser une vie nouvelle à l’art socialiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce99ca5a-834f-45d9-a131-b8597435dd0a",
                        "source_entry_id": "26f1c6c7-f5f0-34f8-a858-960d0a9b7fc3",
                        "source_sense_id": "bfb92a6c-530c-3595-84d6-153c6ad88c83",
                        "target_lang_word": "абстракционизм",
                        "target_lang_code": "ru",
