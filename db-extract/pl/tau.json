                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "Das Schiff war mit einem Tau am Bollwerk befestigt."
                                            },
                                            {
                                                "example_id": "545e05e9-3420-4a8b-8cc1-8112a608a6da",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Er trat mit dem Tau aufs Dock und warf es über einen Poller.“"
                                            },
                                            {
                                                "example_id": "b6110d7a-7826-498b-9096-aa7f615e6be2",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Auf diesem lief er bis ans Ufer und befestigte dort das Tau in einem der zu diesem Zweck angebrachten eisernen Ringe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae6cd3dc-4f00-3e22-bd3e-e9b3ca6b5d0b",
                                        "entry_id": "f0f60c3c-f463-3db4-adbd-f85105d2286b",
                                        "glosses": [
                                            "Seil, insbesondere zum Klettern"
                                        ],
