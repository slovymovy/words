                        "entry_id": "ae8a186b-3b62-3793-95ec-c10da2193ec0",
                        "glosses": [
                            "Arbre de la famille des asperges, originaire d’Amérique et dont les feuilles contiennent un fil duquel on fait des cordes et de la grosse toile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c9c9b00-31d4-4768-a57b-4bfdd84d4d23",
                                "sense_id": "ff8649a3-8c69-3019-a304-5d81f9554408",
                                "text": "L’agavé sert à former des haies impénétrables."
                            }
                        ]
                    }
                ],
