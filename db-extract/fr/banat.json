                "translations": [
                    {
                        "translation_id": "4333a172-d891-45ca-94fd-c63d698a39c1",
                        "source_entry_id": "76468a2d-13f3-3cbb-bcb3-6636b7d8002d",
                        "source_sense_id": "f89159e2-b207-3296-84b3-b208f11ea960",
                        "target_lang_word": "Banat",
