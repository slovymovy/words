                "translations": [
                    {
                        "translation_id": "fafee335-a9a9-4994-b54d-a7dbdbeb731c",
                        "source_entry_id": "c59da1da-0716-325f-8674-46251425c3a3",
                        "source_sense_id": "6675fdb9-155e-3b69-9c1f-a05c467d4e06",
                        "target_lang_word": "dancer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dancer",
