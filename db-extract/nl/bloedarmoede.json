        "nl-extract.jsonl": [
            {
                "entry_id": "da5085a2-7804-3771-8ac1-8b661ba27b58",
                "word": "bloedarmoede",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f4858df-6187-344a-8474-dd126f305712",
                        "entry_id": "da5085a2-7804-3771-8ac1-8b661ba27b58",
                        "glosses": [
                            "situatie waarbij er een minder dan normaal aantal rode bloedcellen in het bloed zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "630a09cd-25b3-46d6-a2cb-daa0fb9725c6",
                                "sense_id": "1f4858df-6187-344a-8474-dd126f305712",
                                "text": "- Na de maagbloeding had de patiënt een flinke bloedarmoede."
                            },
                            {
                                "example_id": "4899d7af-5ce1-40d6-9b4c-85eaf8d90e7b",
                                "sense_id": "1f4858df-6187-344a-8474-dd126f305712",
                                "text": "- In Nederland bestaat de topvijf van die kwalen (die de meeste last veroorzaken) uit rugpijn, nekpijn, angststoornissen, migraine en depressie. Wereldwijd staat rugpijn op de eerste plaats. Rugpijn is zowel een ziekte van mensen die zware en vaak eentonige lichaamsarbeid doe als van mensen die hun werk grotendeels zittend doen. Depressie staat op plaats twee van de wereldlijst, gevolgd door bloedarmoede (door ijzergebrek), nekpijn en gehoorverlies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84d5c397-1462-422e-8f39-d41fcc5c42c5",
                        "source_entry_id": "da5085a2-7804-3771-8ac1-8b661ba27b58",
                        "source_sense_id": "1f4858df-6187-344a-8474-dd126f305712",
                        "target_lang_word": "Blutarmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutarmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f437b34-a521-38c7-a59f-d016e710b82e",
                                        "entry_id": "ccc458b0-efc4-332d-9df4-abe1a234a01f",
                                        "glosses": [
                                            "Zustand, der sich durch einen Mangel an roten Blutkörperchen im Blut auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06dff7ab-bf47-4520-9492-2d4bd0e918b6",
                                                "sense_id": "6f437b34-a521-38c7-a59f-d016e710b82e",
                                                "text": "Ein Sprecher des Königshauses teilte mit, bei der Greisin sei Blutarmut (Anämie) diagnostiziert worden."
                                            },
                                            {
                                                "example_id": "12e7548f-4c50-4a2c-b417-271de665f433",
                                                "sense_id": "6f437b34-a521-38c7-a59f-d016e710b82e",
                                                "text": "„Er litt zudem unter Blutarmut und würde Fremdblut brauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbf5c1b3-2a82-47af-8be7-76fea40b9837",
                        "source_entry_id": "da5085a2-7804-3771-8ac1-8b661ba27b58",
