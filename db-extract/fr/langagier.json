                "senses": [
                    {
                        "sense_id": "affa452b-584f-3e96-b707-c1918513b7d9",
                        "entry_id": "f2429814-42e1-3957-badc-eefe08e66562",
                        "glosses": [
                            "Professionnel utilisant des techniques linguistiques pour évaluer et améliorer des œuvres dans une langue donnée ou entre plusieurs langues."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "73a82938-f1ba-3e45-8b65-a803f51ea1bb",
                        "entry_id": "f2429814-42e1-3957-badc-eefe08e66562",
                        "glosses": [
                            "Professionnel de la langue."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "note": "Ce terme désigne généralement les traducteurs, les interprètes, les terminologues, les réviseurs et les linguistes",
                        "examples": [
                            {
                                "example_id": "f9d7e601-5842-4908-94de-f053618edcea",
                                "sense_id": "73a82938-f1ba-3e45-8b65-a803f51ea1bb",
                                "text": "Le public ne peut pas se douter du temps et des connaissances qui sont nécessaires aux langagiers pour éviter tous les pièges qui se dressent entre eux et la rectitude linguistique, le respect de l’esprit de la langue française."
                            },
                            {
                                "example_id": "a25fa8f6-9b85-44ed-b9ca-1bd120d6dca2",
                                "sense_id": "73a82938-f1ba-3e45-8b65-a803f51ea1bb",
                                "text": "En fait, même les spécialistes, ceux qui travaillent en révision ou en traduction (on les appelle des langagiers) disent ne pas toutes les maîtriser."
                            }
                        ]
                    }
