            {
                "entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
                "word": "occultiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "957b9b90-d032-4e8c-97a5-bb1c07ef532e",
                        "entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "occultistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                        "entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
                        "glosses": [
                            "Adepte de l'occultisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53feb273-a771-4d67-aaa3-3f2e22514a01",
                                "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                                "text": "Un occultiste aura plutôt tendance à désirer devenir lui-même la source de son idéal, soit pour se démarquer de toutes les autres, soit pour s’inscrire dans une lignée spirituelle reconnue et certifiée."
                            },
                            {
                                "example_id": "a1abd130-6fd3-4fd2-930a-f28468ac4252",
                                "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                                "text": "Si la plupart des occultistes se revendiquent des enseignements mystiques d’Hermès Trismégiste ou de la tradition des kabbalistes, certains subirent l’influence de la pensée orientale, popularisée par la Société théosophique, d'autres encore s'inspirèrent de la religion chrétienne, de la gnose, ou de la mythologie égyptienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c174896b-2520-4aa2-b3ba-64ecb3287e6d",
                        "source_entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
                        "source_sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                        "target_lang_word": "occultist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occultist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                        "entry_id": "651501de-d21b-305b-9bde-177bb28ff1b0",
                                        "glosses": [
                                            "A person who practises or studies occultism; a practitioner of, or person learned in, the occult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a49e8a3-9f2f-4702-aee7-27213cf801cb",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "Albertus Magnus, the thirteenth century philosopher and occultist, states that coriander, valerian, and violet are love producing herbs."
                                            },
                                            {
                                                "example_id": "860c63db-1995-4a88-8f17-38b23247a727",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "In the early 1930s, he fell under the spell of a wife-beating, alcoholic, Austrian occultist called Karl Maria Wiligut and a Dutch prehistorian called Herman Wirth, whose views further fed his fantastical illusions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed8e7d73-ad4b-4fb8-84fb-7a4dc1a0027d",
                        "source_entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
