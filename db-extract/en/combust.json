                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c6a5d20-d8f2-307e-b4de-b6f948619258",
                        "entry_id": "e7d9a870-ab61-349e-9f33-23f08685e807",
                        "glosses": [
                            "To burn; to catch fire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1fc760c-7798-43bb-90c1-3cfab2873eca",
                                "sense_id": "2c6a5d20-d8f2-307e-b4de-b6f948619258",
                                "text": "Brom swore after that he spoke only the truth, the truth that as he sat by my side praying for my soul, my body had combusted into flame, the fire rapidly engulfing my entire being."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cca13ba-7028-3c22-b420-2c054d2e2539",
                        "entry_id": "e7d9a870-ab61-349e-9f33-23f08685e807",
                        "glosses": [
                            "To erupt with enthusiasm or boisterousness."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5b15b76c-3b09-4d9f-a0d9-58b7944adb56",
                                "sense_id": "8cca13ba-7028-3c22-b420-2c054d2e2539",
                                "text": "The audience combusts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eabdf56-497a-45b4-96b2-dc2213f11df4",
                        "source_entry_id": "e7d9a870-ab61-349e-9f33-23f08685e807",
                        "source_sense_description": "burn",
                        "target_lang_word": "verbrennen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbrennen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d0d6a3-2152-31f2-8340-9efed580186c",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "etwas durch Feuer vernichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee354f5-2898-442c-a3a4-01c4aa66604e",
                                                "sense_id": "f5d0d6a3-2152-31f2-8340-9efed580186c",
                                                "text": "Er hat alle Reste des Mülls verbrannt, um keine Entsorgungskosten zu bezahlen."
                                            },
                                            {
                                                "example_id": "0e79c2db-fbb4-47d9-87ec-e615efff96a1",
                                                "sense_id": "f5d0d6a3-2152-31f2-8340-9efed580186c",
                                                "text": "„Willst du dich von etwas trennen, dann musst du es verbrennen.“"
                                            },
                                            {
                                                "example_id": "607ef6e6-79f5-4a99-84ab-550c2f15a0a5",
                                                "sense_id": "f5d0d6a3-2152-31f2-8340-9efed580186c",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            },
                                            {
                                                "example_id": "28e670fc-ca4b-422b-adae-17ddf1b3a650",
                                                "sense_id": "f5d0d6a3-2152-31f2-8340-9efed580186c",
                                                "text": "„Seit Jahrtausenden nutzten die Menschen eine Vielzahl von Energiequellen: Sie verbrannten organische Materialien wie Holz und machten Naturgewalten wie Wind- und Wasserkraft nutzbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce2dfaf0-c10b-373d-b1f9-a4b856f20ea6",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "einen Menschen (auf einem Scheiterhaufen) durch Feuer exekutieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27741896-03a9-432f-b390-61ed671fa9f1",
                                                "sense_id": "ce2dfaf0-c10b-373d-b1f9-a4b856f20ea6",
                                                "text": "Jahrhundertelang wurden unschuldige Frauen, welche angeblich Hexen waren, auf dem Scheiterhaufen verbrannt."
                                            },
                                            {
                                                "example_id": "039e31fb-b83c-4232-a071-4d0729d26d4a",
                                                "sense_id": "ce2dfaf0-c10b-373d-b1f9-a4b856f20ea6",
                                                "text": "Neben der Methode, den Verurteilten bei lebendigem Leibe am Brandpfahl gekettet oder gebunden zu verbrennen, gab es auch die Möglichkeit, diesen zuvor auf dem Scheiterhaufen zu erwürgen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "949ffa43-bf6b-3ff9-8d89-bb5fa4372c8b",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "einen Leichnam im Feuer bestatten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "611fbfd8-3d84-4399-a076-2768929dc928",
                                                "sense_id": "949ffa43-bf6b-3ff9-8d89-bb5fa4372c8b",
                                                "text": "Nech meinem Ableben möchte ich verbrannt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2e2e2eeb-e9a1-38bc-87c2-c64c0ff0303b",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "durch Feuer zerstört werden"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae5e453-3f49-43bc-ae64-a09a1424f3b4",
                                                "sense_id": "2e2e2eeb-e9a1-38bc-87c2-c64c0ff0303b",
                                                "text": "Die gesamte Einrichtung verbrannte restlos."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "45ffab07-0fa6-3dab-bfce-63b1baa7017b",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "jemanden durch Feuer oder Hitze verletzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e8d2c3-d1e2-4785-b9df-40a1c2b29d3d",
                                                "sense_id": "45ffab07-0fa6-3dab-bfce-63b1baa7017b",
                                                "text": "Pass auf, dass du dich nicht an der heißen Herdplatte verbrennst."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "55139114-f6e3-36b5-b9b1-a03c527cc527",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "eine Speise zu lange garen, so dass die Oberfläche beginnt zu verkohlen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f163724-efba-41ff-8921-223daffdf58a",
                                                "sense_id": "55139114-f6e3-36b5-b9b1-a03c527cc527",
                                                "text": "Ich schalte den Backofen auf eine niedrigere Stufe, damit die Pizza nicht verbrennt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "9a088aa7-0b97-3537-8f5d-e512c94d5b09",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "jemanden entdecken, entlarven"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739f9120-666e-4817-9c68-8fec15711e72",
                                                "sense_id": "9a088aa7-0b97-3537-8f5d-e512c94d5b09",
                                                "text": "Wir müssen aufpassen, dass die Bande unseren Spitzel nicht verbrennt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "cc9ae700-cabc-325b-b046-86112bf699e3",
                                        "entry_id": "14779f8a-0457-376a-8c2b-fb5a85f5bddd",
                                        "glosses": [
                                            "etwas verschwenden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe822ddc-963f-4da2-8de2-8cfb75bb2193",
                                                "sense_id": "cc9ae700-cabc-325b-b046-86112bf699e3",
                                                "text": "„Allein für die Entsalzungsanlage werden pro Tag durchschnittlich etwa 1000 Liter Diesel verbrannt.“"
                                            },
                                            {
                                                "example_id": "14d84c06-7122-4492-8523-6ddc17d8ef8c",
                                                "sense_id": "cc9ae700-cabc-325b-b046-86112bf699e3",
                                                "text": "„Doch laut Bundesrechnungshof lässt Verkehrsminister Wissing dem Konzern dabei zu viele Freiheiten, Geld zu verbrennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
