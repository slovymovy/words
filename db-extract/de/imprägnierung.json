                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bebe4ed-4f60-4497-8676-98c9cc9edd0f",
                                "sense_id": "dde4b7e2-73c9-3f08-b892-53b6cdf9ae78",
                                "text": "Die Imprägnierung kann Wasser abweisen aber nicht so leicht Salzwasser.",
                                "translation": "L’imperméabilisation peut rejeter l’eau douce mais pas aussi facilement de l’eau salée."
                            }
                        ]
