                                        "entry_id": "c7ef5600-7916-3de9-ac97-c9b54ba5c8c5",
                                        "glosses": [
                                            "A molecule consisting of two identical halves, formed by joining two identical molecules, sometimes with a single atom acting as a bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194a645b-42f3-4986-aec0-efd724ebd5f7",
                                                "sense_id": "33a0bd43-9dc6-3761-b70e-43d88e6be609",
                                                "text": "Non-polymerized lamins are dimers and they can polymerize to structures such as head to tail or by unparallel dimers which aggregate in tetramers and polymerize to thick fibers."
                                            }
                                        ]
                                    }
