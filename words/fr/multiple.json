                },
                {
                    "sense_id": "0fe8359f-6a13-3ce9-b425-0710d9578a0a",
                    "sense_definition": "Unité de mesure qui vaut plusieurs fois l'unité principale servant de référence.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le kilomètre est un <w>multiple</w> du mètre souvent utilisé pour exprimer de longues distances."
                        },
                        {
                            "text": "Dans le système international, chaque préfixe désigne un <w>multiple</w> ou un sous-multiple de l'unité."
