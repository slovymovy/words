                        "examples": [
                            {
                                "example_id": "9c1b7e07-232f-4fe4-a36a-bfae3098c10b",
                                "sense_id": "d7deff1e-79b6-3373-aa21-f22307722544",
                                "text": "„Bevor die Festtafel verlassen wurde, stand eine junge Frau auf und reichte mir eine Zeitschrift.“"
                            },
                            {
                                "example_id": "b6e7ae89-4b38-4f62-b7fe-1bb77d0f5ec3",
                                "sense_id": "d7deff1e-79b6-3373-aa21-f22307722544",
                                "text": "„Der Geruch von den Festtafeln und der eigene Hunger brachten ihn endlich wieder zu sich: bevor er aufbrach, musste er unbedingt noch etwas essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
