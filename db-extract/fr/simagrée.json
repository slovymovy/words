        "fr-extract.jsonl": [
            {
                "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                "word": "simagrée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2e1da47e-e623-4ba0-a58e-8f6d7de06e7d",
                        "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                        "tags": [
                            "plural"
                        ],
                        "form": "simagrées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                        "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                        "glosses": [
                            "Attitude, geste ou parole affectée qu’on utilise pour se donner une certaine apparence, pour se faire valoir ou pour tromper."
                        ],
                        "tags": [
                            "familiar",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "58471e6a-05a0-44ff-ac1d-767f1273b2a3",
                                "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                                "text": "J’ai horreur des simagrées : faire la cour à une femme, c’est avilissant pour soi et pour elle."
                            },
                            {
                                "example_id": "db59d80d-e85e-4fd1-bbbf-4ec830743084",
                                "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                                "text": "Sortons ! fis-je irrité par toutes ces simagrées et littéralement pris d’une colère que je ne m’expliquais pas."
                            },
                            {
                                "example_id": "949a62b7-b471-4a5c-83db-090af068466e",
                                "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                                "text": "Ah ! mais, je commence à en avoir assez, de vous autres et de vos simagrées. Je sais ce que vous valez, à présent, vous tous, et votre guerre, et votre Empire, et votre trompe-l’œil… De la camelote, tout ça, du chiqué !"
                            },
                            {
                                "example_id": "e5ccb778-08ad-4376-8e47-48d3a4391176",
                                "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                                "text": "C’est pas la peine de faire tant de simagrées si vous voulez me baiser, allez-y."
                            },
                            {
                                "example_id": "8550795c-f705-4280-8d48-88dc9765afd7",
                                "sense_id": "2b6701ff-fd62-3de7-9ab1-d678f111c96f",
                                "text": "Malgré toutes les simagrées à propos de sa prestigieuse galerie londonienne, il était sans l'ombre d'un doute financièrement aux abois."
                            }
                        ]
                    },
                    {
                        "sense_id": "00e1d866-e535-3489-b744-1e7e0027dd2d",
                        "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                        "glosses": [
                            "Pitreries, grimaces."
                        ],
                        "tags": [
                            "familiar",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "8571147e-c73e-42e3-a3b1-782ab2bb4918",
                                "sense_id": "00e1d866-e535-3489-b744-1e7e0027dd2d",
                                "text": "Elle a accompagné ses blagues de simagrées, a encore fait preuve d’autodérision, mais de manière plus naturelle et avec parcimonie.."
                            },
                            {
                                "example_id": "c367799b-5315-40ec-b564-210870f05ab4",
                                "sense_id": "00e1d866-e535-3489-b744-1e7e0027dd2d",
                                "text": "Sentant que sa rivale était plus stressée qu’elle, Labbé a commencé à faire des simagrées."
                            }
                        ]
                    },
                    {
                        "sense_id": "7973567a-2b8e-34dc-9804-837b46c866cc",
                        "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                        "glosses": [
                            "Minauderie ; manière artificielle ou affectée."
                        ],
                        "tags": [
                            "formal",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "569b4216-cfc7-4d96-afad-b97d2664daa4",
                                "sense_id": "7973567a-2b8e-34dc-9804-837b46c866cc",
                                "text": "Les prières sont ici une pure simagrée Les gens ne font que rire & parler à l'oreille pendant tout le tems qu'elles durent."
                            },
                            {
                                "example_id": "1ee56c03-075a-491e-a4dd-68f5674254d5",
                                "sense_id": "7973567a-2b8e-34dc-9804-837b46c866cc",
                                "text": "[…]; le pape, ses cardinaux, lavant, baisant, ainsi que l'autre jour lavaient et baisaient les princesses, telle a été cette cérémonie, vraie simagrée à laquelle il était impossible de rattacher une pensée religieuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "0678a415-c6cb-3d2c-99c2-110a9546dcba",
                        "entry_id": "175f898b-74ed-3535-a3e5-6fb333a2770d",
                        "glosses": [
                            "Parodie."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b4b72f96-f530-43e9-8d8b-bf3620553b4e",
                                "sense_id": "0678a415-c6cb-3d2c-99c2-110a9546dcba",
                                "text": "Les recrutements sont devenus difficiles; les ressources financières ne sont pas moins gênées; la simagrée de patriotisme figure assez bien dans les gazettes de la cour, mais ne répond ni au besoin des coffres, ni aux besoins des armées."
                            },
                            {
                                "example_id": "82e2895b-07a7-4fee-b31a-b78d5e3cae30",
                                "sense_id": "0678a415-c6cb-3d2c-99c2-110a9546dcba",
                                "text": "Néanmoins, il fallait jouer la simagrée du désespoir, en vue des urnes prochaines."
                            },
                            {
                                "example_id": "35eb6e3c-47d0-436c-9e14-ad635d469858",
                                "sense_id": "0678a415-c6cb-3d2c-99c2-110a9546dcba",
                                "text": "C'est toujours ce discours-là qui pousse les tyrans du tiers-monde à faire la simagrée de la démocratie, à jouer à la parodie des droits de l'homme."
                            }
                        ]
                    }
                ],
