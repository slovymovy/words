                        "sense_id": "6c55fc5b-f0e6-3295-829f-f085565a9eb0",
                        "entry_id": "38d0614e-8a54-3647-a9e1-98e324206f70",
                        "glosses": [
                            "Periode von unverhältnismäßig kalten Tagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdfb0a8f-bb81-4dbf-9de2-42d0aeed009b",
                                "sense_id": "6c55fc5b-f0e6-3295-829f-f085565a9eb0",
                                "text": "Eine Kältewelle kann zum Anstieg der Energiepreise führen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26da225c-1f3b-4b95-819c-fa8990fcc6fa",
                        "source_entry_id": "38d0614e-8a54-3647-a9e1-98e324206f70",
                        "source_sense_id": "6c55fc5b-f0e6-3295-829f-f085565a9eb0",
                        "source_sense_description": "Periode von unverhältnismäßig kalten Tagen",
                        "target_lang_word": "cold spell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cold spell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23c1fcfd-f20c-3561-8aff-e3ad6e09e8ab",
                                        "entry_id": "459a2f5d-858b-38de-841b-9809d01eca02",
                                        "glosses": [
                                            "A short period during which temperatures are much lower than usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb617430-1259-42c5-afc9-98dc63035dd8",
                                                "sense_id": "23c1fcfd-f20c-3561-8aff-e3ad6e09e8ab",
                                                "text": "The only factors in the first four weeks of this year which, apart from greater commercial effort, might have been expected to influence B.R. receipts were the cold spell and the Post Office \"go slow\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c41a0d-472d-31a4-873d-d4b39c59a763",
                                        "entry_id": "459a2f5d-858b-38de-841b-9809d01eca02",
                                        "glosses": [
                                            "A period of poor performance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30cb5deb-c84b-4fb0-b080-d6007ff055b6",
                                                "sense_id": "96c41a0d-472d-31a4-873d-d4b39c59a763",
                                                "text": "The Rizing Zephyr took a 71-70 lead on a Shota Tsuyama free throw (he missed the first attempt) with 1:42 to play, which was followed by a cold spell by both offenses before Coleby got in position to put his stamp on the final outcome."
                                            },
                                            {
                                                "example_id": "dc23d7ae-ebbe-47b9-bf78-f8156b00e2d4",
                                                "sense_id": "96c41a0d-472d-31a4-873d-d4b39c59a763",
                                                "text": "Utility player Garrett Hampson, who was one of the Rockies’ most consistent players early in the season, has hit a cold spell. He snapped an 0-for-16 hitless streak with a single in the seventh inning Sunday but had just one hit in his last 20 at-bats entering Tuesday night’s game."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
