                    {
                        "translation_id": "aa42cacb-839b-4b3a-a617-b7b6d7d39cef",
                        "source_entry_id": "cae32b06-7438-36c6-868b-5f40f110bac1",
                        "source_sense_id": "68ed56af-860d-3016-84b8-9053f47404c2",
