                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e89bc39-c571-48b8-90b8-003618c552e1",
                        "source_entry_id": "918d057e-99bf-3698-b922-cbcdc26be7a0",
                        "source_sense_id": "7dd69bf6-f058-35fc-a0c1-44427f37f6c3",
                        "target_lang_word": "monogamist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monogamist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abe29c13-9d8e-3b54-ba73-37ca3673baf8",
                                        "entry_id": "87056f52-4a4f-359a-9e44-3757db552a67",
                                        "glosses": [
                                            "A person who practices monogamy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbe8f41-7c8d-4356-bc8f-2ed31d073e22",
                                                "sense_id": "abe29c13-9d8e-3b54-ba73-37ca3673baf8",
                                                "text": "I maintained with Whiston, that it was unlawful for a priest of the church of England, after the death of his first wife, to take a second, or to express it in one word, I valued myself upon being a strict monogamist."
                                            },
                                            {
                                                "example_id": "b4d4253e-08e3-41bf-886a-89bca84fa8fb",
                                                "sense_id": "abe29c13-9d8e-3b54-ba73-37ca3673baf8",
                                                "text": "Suppose, for example, that if polygamy were legal, 10 percent of adult men would take an average of three wives apiece and that all remaining marriages would be monogamous. Among aspiring monogamists, there would then be nine men for every seven women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "915b9247-db56-4baf-80ca-24b4fc99e519",
                        "source_entry_id": "918d057e-99bf-3698-b922-cbcdc26be7a0",
                        "source_sense_id": "7dd69bf6-f058-35fc-a0c1-44427f37f6c3",
                        "target_lang_word": "monogame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monogame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                        "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                                        "glosses": [
                                            "Qui n’a qu’un seul partenaire sexuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04a3b3c-0f02-42e2-bce3-75f27b74dcad",
                                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                                "text": "– Plus monogames que nous quatre, ça n’existe nulle part."
                                            },
                                            {
                                                "example_id": "1628e698-9894-4f7a-ac04-e501f670d0ea",
                                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                                "text": "Cet apôtre de la liberté sexuelle est radicalement monogame, et toujours sa Marcelle lui suffira."
                                            },
                                            {
                                                "example_id": "b20cb848-6e3b-43f5-a5f9-53800329e769",
                                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                                "text": "Elle a de ces arrondis qui rendraient le roi Salomon monogame à vie, et elle a ce genre de santé qui ferait passer cette poule romaine, Junon, pour une phtisique au dernier degré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9af9eee7-a0d3-3c40-a759-05824597fc83",
                                        "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                                        "glosses": [
                                            "Qui a le caractère de monogamie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monogame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5a625b-38c8-3d9e-9361-8daa7be0d10a",
                                        "entry_id": "16c97afa-32ad-3e0e-9b4f-df73e09f754f",
                                        "glosses": [
                                            "Personne qui n’a qu’un seul partenaire sexuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d6be9e-e773-4ac2-b489-6bc2c4337336",
                                                "sense_id": "5c5a625b-38c8-3d9e-9361-8daa7be0d10a",
                                                "text": "Une tourte comme Hermine, si elle changeait d’homme, ça se verrait sur sa figure. Plus monogames que nous quatre, ça n’existe nulle part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c99a5dcc-4ebb-3540-beb1-d1b5ef5819c7",
                                        "entry_id": "16c97afa-32ad-3e0e-9b4f-df73e09f754f",
                                        "glosses": [
                                            "Celui qui n’est marié qu’à une seule femme, celle qui n’est mariée qu’à un seul homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690b3014-1a86-4a39-a9dd-37cb2c416a34",
                                                "sense_id": "c99a5dcc-4ebb-3540-beb1-d1b5ef5819c7",
                                                "text": "Lorsqu’on sait que les surplus monétaires libérés par un cultivateur célibataire à la fin des bonnes années climatiques peuvent atteindre 15 000 F CFA, ceux d’un monogame, 30 à 40 000 F, on voit qu’il faudrait plus de dix ans au monogame pour acquérir une seconde épouse s’il en avait seul la responsabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3ad583-1d4d-3817-bc84-891936757965",
                                        "entry_id": "16c97afa-32ad-3e0e-9b4f-df73e09f754f",
                                        "glosses": [
                                            "Plante qui a le caractère de monogamie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
