                                        "sense_id": "ec0c6b23-c60c-3630-be62-b80533bb4ffc",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "A picture or series of pictures painted on two tablets, usually connected by hinges."
