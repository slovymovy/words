                    {
                        "translation_id": "23484290-08a4-43fd-a439-afa1e86f529c",
                        "source_entry_id": "15b5d98e-f602-3c0c-969d-8e979679710e",
                        "source_sense_id": "343b08b4-de54-32c0-a569-7846ed297974",
                        "source_sense_description": "wind instrument",
                        "target_lang_word": "корне́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "корне́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a39fe8d9-103a-3cd5-8712-1972959d043c",
                                        "entry_id": "29f444d9-69c4-37f0-b9fb-4ad0c2502f50",
                                        "glosses": [
                                            "воен., истор. первый офицерский чин в кавалерии и войсках пограничной стражи соответствовавший прапорщику в пехоте (с 1884 г. подпоручику) и хорунжему в казачьих войсках"
                                        ],
                                        "tags": [
                                            "в Российском государстве до 1917 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd60886d-e41c-43a3-bbb0-83046e946983",
                                                "sense_id": "a39fe8d9-103a-3cd5-8712-1972959d043c",
                                                "text": "В 18 лет Дмитрий Хилков стал корнетом лейб-гвардии гусарского полка, а в неполные 20 уже сражался за Родину в Русско-турецкой войне."
                                            },
                                            {
                                                "example_id": "18c0cbbc-2ec9-4468-af8b-73e600b7bb81",
                                                "sense_id": "a39fe8d9-103a-3cd5-8712-1972959d043c",
                                                "text": "А его самого отправить в главную квартиру… я только что был произведен в корнеты, и это была первая моя откомандировка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6fbb7c-8960-38d8-a171-4b8a23bf882a",
                                        "entry_id": "29f444d9-69c4-37f0-b9fb-4ad0c2502f50",
                                        "glosses": [
                                            "воен., истор. лицо, имевшее такое звание"
                                        ],
                                        "tags": [
                                            "в Российском государстве до 1917 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6672e3a0-a525-44b4-be9c-c8081e8aed2d",
                                                "sense_id": "0d6fbb7c-8960-38d8-a171-4b8a23bf882a",
                                                "text": "Но честолюбивому корнету хотелось более ― ему хотелось попасть в тот заветный круг, в котором жили его друзья, посмотреть поближе на тех милых женщин, о которых они беспрестанно говорили и в которых были влюблены."
                                            },
                                            {
                                                "example_id": "1126ec4d-5e0b-4365-a9ec-bcb320645763",
                                                "sense_id": "0d6fbb7c-8960-38d8-a171-4b8a23bf882a",
                                                "text": "Принимая во внимание нравы времени, приходится быть более снисходительным к молодому корнету, платившему ему дань."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "корне́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21284dfe-305f-376d-acb4-a17d3b9472a3",
                                        "entry_id": "529ca560-2100-3840-8e4e-829526aa944b",
                                        "glosses": [
                                            "муз. медный духовой музыкальный инструмент в виде небольшой изогнутой трубы (рожка) с тремя клапанами, мундштуком и вентилем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a03e17e7-c4ca-4cc0-a820-5decb81e42f7",
                                                "sense_id": "21284dfe-305f-376d-acb4-a17d3b9472a3",
                                                "text": "Хвост во все стороны машет, камертон тон задает, указывает корнетам и тромбонам, когда вступать, а зазевается музыкант ― тотчас камертон по лбу."
                                            },
                                            {
                                                "example_id": "9d157029-3712-4e2a-a7e3-011c97df1b24",
                                                "sense_id": "21284dfe-305f-376d-acb4-a17d3b9472a3",
                                                "text": "Александр Александрович сначала играл на корнете, а потом, когда оркестр увеличился, заказал себе огромный медный геликон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b1c969-34ab-39ae-9e99-a64dbebff083",
                                        "entry_id": "529ca560-2100-3840-8e4e-829526aa944b",
                                        "glosses": [
                                            "цинк; старинный музыкальный инструмент"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fabb6c3-36c7-391e-9039-5f0dafe83562",
                                        "entry_id": "529ca560-2100-3840-8e4e-829526aa944b",
                                        "glosses": [
                                            "устар. старинный головной женский убор, в виде чепчика с двумя рожками впереди"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b6137e-1b61-47f7-92f4-55de16765dbe",
                                                "sense_id": "1fabb6c3-36c7-391e-9039-5f0dafe83562",
                                                "text": "Повелел он бороды брить, отменил старинные русские одеяния и вместо длинных платьев заставил мужчин немецкие кафтаны носить, а женщин вместо телогреи ― бостроги, юбки, шлафроки и самары, вместо подколков фантанжами и корнетами голову украшать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca39f2d-a33f-4fdc-8fd6-a8fa16953d3d",
                        "source_entry_id": "15b5d98e-f602-3c0c-969d-8e979679710e",
                        "source_sense_id": "343b08b4-de54-32c0-a569-7846ed297974",
                        "source_sense_description": "wind instrument",
                        "target_lang_word": "ци́нк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ци́нк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e198db1b-0e4a-36a8-8a08-61559c42e918",
                                        "entry_id": "9cb9f49b-ef95-3d0d-9187-62b9ac477c05",
                                        "glosses": [
                                            "хим. химический элемент с атомным номером 30, обозначается химическим символом Zn"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac5e53da-6998-3ba8-9215-b2ef29d4f6ac",
                                        "entry_id": "9cb9f49b-ef95-3d0d-9187-62b9ac477c05",
                                        "glosses": [
                                            "хим. простое вещество, при нормальных условиях — хрупкий ковкий переходный металл голубовато-белого цвета"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49c80a31-fbd7-3bca-ac08-b0f71dc0feac",
                                        "entry_id": "9cb9f49b-ef95-3d0d-9187-62b9ac477c05",
                                        "glosses": [
                                            "воен. то же, что цинка; герметичный ящик из оцинкованного железа, используемый для длительного хранения боеприпасов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262d47c3-ccb1-43d0-b1d1-83dc88db8b05",
                                                "sense_id": "49c80a31-fbd7-3bca-ac08-b0f71dc0feac",
                                                "text": "В другом тайнике — ещё 150 кг пластида, а также гранаты, глушители, несколько цинков с патронами, почти 30 электрических детонаторов и несколько стеклянных банок с химическим веществом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b15c17fa-b1cb-32bf-ac86-5ca0577c9c41",
                                        "entry_id": "9cb9f49b-ef95-3d0d-9187-62b9ac477c05",
                                        "glosses": [
                                            "воен. жарг. и разг. цинковый гроб"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758d9b43-4ec9-485e-a060-24304dbb4724",
                                                "sense_id": "b15c17fa-b1cb-32bf-ac86-5ca0577c9c41",
                                                "text": "Отдыхает в морге, вскрытый и неровно заштопанный суровой ниткой, скоро в цинке поедет домой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
