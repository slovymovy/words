                    {
                        "sense_id": "e65f6d88-c9ab-31dd-8ab3-fc7ed7bf128c",
                        "entry_id": "69a47302-87b9-3a6d-8390-50c15307239e",
                        "glosses": [
                            "de prijs die een koper daadwerkelijk betaalt bij de aanschaf van een product"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a81681-9175-40a5-9e27-3e4e045bdccd",
                                "sense_id": "e65f6d88-c9ab-31dd-8ab3-fc7ed7bf128c",
                                "text": "De aanschafprijs van het apparaat is relatief hoog, maar de energiekosten zijn ontzettend laag."
                            },
                            {
                                "example_id": "bcba7f07-ffcb-4371-aa76-738e275021c1",
                                "sense_id": "e65f6d88-c9ab-31dd-8ab3-fc7ed7bf128c",
                                "text": "De wegen in Azië zijn bovendien meestal geasfalteerd terwijl dat in Afrika maar voor een kwart geldt. Dat betekent dat voor Afrikaanse boeren het gebruikmaken van externe productiemiddelen lastig is. De aanschafprijs is te hoog, en de baten zijn moeilijk te verzilveren. Afrikaanse boeren blijven hierdoor autarkisch en improductief, en de economie komt niet op gang."
                            }
                        ]
                    }
