                        "entry_id": "3d1def51-aa1a-342a-8d0c-21aae01c9d3b",
                        "glosses": [
                            "Ausdruck einer romanischen Sprache, der in eine andere Sprache entlehnt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c723c9f8-70d2-4148-9b69-5ab49a8d7d33",
                                "sense_id": "516cae82-3e7e-3760-8585-44cced566ce1",
                                "text": "„Sie sind schon wegen des Akzents auf der Ultima des Stammes als Gallizismen oder Romanismen anderer Art, jedenfalls nicht als Anglizismen anzusehen.“"
                            }
