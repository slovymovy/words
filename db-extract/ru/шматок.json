                "senses": [
                    {
                        "sense_id": "0cb9b28e-a79c-34a8-8e52-e41cd6ae2705",
                        "entry_id": "a2ff0c9b-9de6-30af-87ab-49b6081fda8f",
                        "glosses": [
                            "прост. кусочек, клочок"
                        ],
                        "tags": [
                            "обычно о еде"
                        ],
                        "examples": [
                            {
                                "example_id": "e4527aed-8d17-462b-b611-c71726194199",
                                "sense_id": "0cb9b28e-a79c-34a8-8e52-e41cd6ae2705",
                                "text": "― Прибежала оттуда ― лица на ней нет, вся рубаха в шматки растерзана…"
                            },
                            {
                                "example_id": "1df1c3a2-8de0-4790-9e8e-48e93900e69d",
                                "sense_id": "0cb9b28e-a79c-34a8-8e52-e41cd6ae2705",
                                "text": "― Он закашлялся, схватился за грудь и выхаркнул шматок загустевшей чёрной крови."
                            },
                            {
                                "example_id": "d734ef50-c5f0-498f-8b07-3d0c105c3c7b",
                                "sense_id": "0cb9b28e-a79c-34a8-8e52-e41cd6ae2705",
                                "text": "Напившись и закусив шматком сала, я поднялся и направился туда, где возле пленника толпилась кучка красноармейцев."
                            }
                        ]
                    }
                ],
