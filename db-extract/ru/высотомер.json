                                        "entry_id": "1556b6d6-97a3-3275-9f90-02f61c162f3b",
                                        "glosses": [
                                            "Gerät, mit dem man bestimmen kann, in welcher Höhe man sich befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf4f4b1-3210-48b6-9555-853f02b9c28a",
                                                "sense_id": "14333a83-d0e2-3452-a54d-b64c73117bf6",
                                                "text": "„Wir kommen nun zum höchsten Punkt unserer Reise, mein Höhenmesser zeigt fast dreitausend Meter.“"
                                            }
