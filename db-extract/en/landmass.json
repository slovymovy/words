                        "target_lang_word": "су́ша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́ша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9615752-8e33-3337-b8c4-348f8ee306a0",
                                        "entry_id": "500c32f3-06dd-309b-b550-203e4d67d500",
                                        "glosses": [
                                            "твёрдая земля как противоположность водному пространству"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6310a384-ecc7-4ac2-a2fa-65a68e752904",
                                                "sense_id": "c9615752-8e33-3337-b8c4-348f8ee306a0",
                                                "text": "На сороковой день плавания моряки увидели сушу."
                                            },
                                            {
                                                "example_id": "0fcd4ead-8a0d-44fe-ba63-e06fbe35556c",
                                                "sense_id": "c9615752-8e33-3337-b8c4-348f8ee306a0",
                                                "text": "Выйти из моря на сушу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "су́ша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c089e58d-b23c-38c3-a7f9-49630e2e38b4",
                                        "entry_id": "66a9a220-a5e7-3dda-942d-d7bd5493753f",
                                        "glosses": [
                                            "деепричастие настоящего времени от глагола сушить"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48d8704e-9361-4a73-875d-c897e77cfd3b",
                        "source_entry_id": "d3023d4d-6207-3760-9df3-189b2d898b50",
                        "source_sense_id": "3e90d8d6-9553-3e5b-af88-71b70b9a759d",
                        "source_sense_description": "large continuous area of land",
                        "target_lang_word": "твердь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "твердь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6020d5e7-cf9e-3851-88f2-73605795e940",
                                        "entry_id": "3d8919a4-449f-3973-8c7e-c68d54b91147",
                                        "glosses": [
                                            "устар., высок. земля, суша"
                                        ],
                                        "tags": [
                                            "обычно в сочетании с земная"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b7bf705-7ad8-4b94-9eca-37b403440a8b",
                                                "sense_id": "6020d5e7-cf9e-3851-88f2-73605795e940",
                                                "text": "А внизу медленно плыла твердь земная, как бы охваченная лихорадочным бредом."
                                            },
                                            {
                                                "example_id": "22a1525a-c93b-4f44-9b9e-05638fe86650",
                                                "sense_id": "6020d5e7-cf9e-3851-88f2-73605795e940",
                                                "text": "Океаны мерно дышали приливами и отливами, сотрясая штормами земную твердь, и прибой превращал острые обломки скал в круглую, обточенную гальку…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4541083-d91b-3265-8257-0924d6187029",
                                        "entry_id": "3d8919a4-449f-3973-8c7e-c68d54b91147",
                                        "glosses": [
                                            "устар., высок., поэт. небо, небосвод"
                                        ],
                                        "tags": [
                                            "обычно в сочетании с небесная"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d501a5-028c-4d29-bd98-45fb2d3f42a9",
                                                "sense_id": "e4541083-d91b-3265-8257-0924d6187029",
                                                "text": "И назвал Бог твердь небом."
                                            },
                                            {
                                                "example_id": "472617a6-eebb-47a1-b0b5-05564a2adebd",
                                                "sense_id": "e4541083-d91b-3265-8257-0924d6187029",
                                                "text": "В считанные минуты всё вокруг было залито вспененной водой и, подобно небесной тверди, засверкало яростным металлическим блеском."
                                            },
                                            {
                                                "example_id": "2778a36b-6c4c-4040-b235-306cc0be6f77",
                                                "sense_id": "e4541083-d91b-3265-8257-0924d6187029",
                                                "text": "Я хотел, чтоб мы были врагами, // Так за что ж подарила мне ты // Луг с цветами и твердь со звёздами — // Всё проклятье своей красоты?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc28057c-cbcc-3130-b15c-c8b69e53d4b0",
                                        "entry_id": "3d8919a4-449f-3973-8c7e-c68d54b91147",
                                        "glosses": [
                                            "нечто твёрдое, устойчивое; также твёрдость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d70b02-8777-4aaa-833c-e4e9d5c276c0",
                                                "sense_id": "dc28057c-cbcc-3130-b15c-c8b69e53d4b0",
                                                "text": "О, метеоритная твердь твоих клыков, дикий ты зверь!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
