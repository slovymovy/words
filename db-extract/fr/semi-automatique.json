                                        "glosses": [
                                            "während des Laufs einer Maschine nur bei bestimmten Handlungen Bedienung erfordernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0328dd-2b90-4eee-af4c-fa340bb34442",
                                                "sense_id": "ff9cfba3-a9f5-383c-a392-0dc6711620ec",
                                                "text": "Dieses Programm läuft halbautomatisch."
                                            },
                                            {
                                                "example_id": "207594c7-99e4-40dc-b77a-4aef0d1b0e5e",
                                                "sense_id": "ff9cfba3-a9f5-383c-a392-0dc6711620ec",
                                                "text": "Das Gesetz sieht vor, dass keine schweren Kriegswaffen eingesetzt werden dürfen, halbautomatische Waffen könnten dagegen genehmigt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
