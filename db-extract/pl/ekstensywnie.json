                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2691e3c3-1b41-43a7-b740-976eb5952ecc",
                                                "sense_id": "15ac05b1-f082-3543-a641-4d6b8e4e3328",
                                                "text": "He became more extensively involved than he intended."
                                            },
                                            {
                                                "example_id": "77f3a5ab-9916-4fae-ab8f-6fae29ecaacb",
                                                "sense_id": "15ac05b1-f082-3543-a641-4d6b8e4e3328",
                                                "text": "The White House counsel, Donald F. McGahn II, has cooperated extensively in the special counsel investigation, sharing detailed accounts about the episodes at the heart of the inquiry into whether President Trump obstructed justice, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73c4aa17-85cb-45e4-9fdd-b576da9af5c6",
                        "source_entry_id": "0112abf8-6e8d-33ae-8201-df1efeee0ee0",
                        "source_sense_id": "ca130d76-92df-3b3e-8aa5-12b60ed9b342",
