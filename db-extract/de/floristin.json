                            {
                                "example_id": "869a056c-a31d-43e7-9039-608e936e8598",
                                "sense_id": "bedbdd94-5f76-3299-981b-be19d1b67b86",
                                "text": "Vielleicht sollten wir mal eine Floristin fragen, wie diese Pflanze hier heißt. Vielleicht die Frau Wagner?"
                            }
