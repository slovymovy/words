{
    "word_family": [
        "linger",
        "lingerer",
        "lingeringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19830073-8646-3f56-b7c0-82113bf20f23",
                    "sense_definition": "present participle and gerund of <w>linger</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>lingering</w> outside the shop window, hoping to catch one last glimpse of him.",
                            "target_lang_translations": {
                                "ru": "Она <w>задерживалась</w> у витрины магазина, надеясь увидеть его в последний раз."
                            }
                        },
                        {
                            "text": "The guests stayed late, <w>lingering</w> over dessert while discussing their upcoming holiday plans.",
                            "target_lang_translations": {
                                "ru": "Гости засиделись допоздна, <w>затягивая</w> десерт и обсуждая свои планы на предстоящие праздники."
                            }
                        }
                    ],
                    "synonyms": [
                        "loitering",
                        "dallying",
                        "tarrying"
                    ],
                    "common_phrases": [
                        "lingering doubt",
                        "lingering scent",
                        "lingering pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени или деепричастие от глагола linger; задерживающийся, затягивающийся, затяжной"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживающийся",
                                "target_lang_sense_clarification": "причастие, о том, кто не уходит"
                            },
                            {
                                "target_lang_word": "задерживаясь",
                                "target_lang_sense_clarification": "деепричастие, медля с уходом"
                            },
                            {
                                "target_lang_word": "затяжной",
                                "target_lang_sense_clarification": "длящийся долго, упорный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "217667db-6ece-3d2e-874f-58be03ebb081",
                    "sense_definition": "The act of loitering, waiting, or delaying departure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After several minutes of hesitant <w>lingering</w> in the lobby, he finally approached the front desk.",
                            "target_lang_translations": {
                                "ru": "После нескольких минут нерешительного <w>колебания</w> в вестибюле он наконец подошел к стойке регистрации."
                            }
                        },
                        {
                            "text": "Her deliberate <w>lingering</w> by the doorway made it clear that she wanted to speak in private.",
                            "target_lang_translations": {
                                "ru": "Её намеренное <w>промедление</w> у дверей ясно давало понять, что она хочет поговорить наедине."
                            }
                        }
                    ],
                    "synonyms": [
                        "loitering",
                        "tarrying",
                        "dallying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержка, промедление, медлительность или бесцельное пребывание на месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промедление",
                                "target_lang_sense_clarification": "задержка ухода или действия"
                            },
                            {
                                "target_lang_word": "задержка",
                                "target_lang_sense_clarification": "остановка или нахождение на одном месте"
                            },
                            {
                                "target_lang_word": "ожидание",
                                "target_lang_sense_clarification": "выжидание или медлительность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e54b93e5-1b85-3994-ab6b-4637db1e8c4f",
                    "sense_definition": "Something that lingers or remains behind; a remnant or trace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The faint <w>lingerings</w> of winter were still evident in the patches of snow upon the hills.",
                            "target_lang_translations": {
                                "ru": "Слабые <w>отголоски</w> зимы всё ещё были видны в островках снега на холмах."
                            }
                        },
                        {
                            "text": "He tried to ignore the subtle <w>lingerings</w> of doubt that troubled his mind after the interview.",
                            "target_lang_translations": {
                                "ru": "Он пытался игнорировать затаившиеся <w>остатки</w> сомнений, которые тревожили его душу после собеседования."
                            }
                        }
                    ],
                    "synonyms": [
                        "remnant",
                        "trace",
                        "vestige"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in older or literary contexts, especially in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что остается или сохраняется; пережиток, след или остаток чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережиток",
                                "target_lang_sense_clarification": "сохранившийся след прошлого"
                            },
                            {
                                "target_lang_word": "отголосок",
                                "target_lang_sense_clarification": "слабое напоминание, остаток"
                            },
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "сохранившаяся часть или след"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}