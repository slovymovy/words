{
    "word_family": [
        "imperil",
        "perilous",
        "perilously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2815e679-0c44-3a3b-8047-c7a3c463d5da",
                    "sense_definition": "A state of serious and immediate danger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "danger_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew realized their ship was in grave <w>peril</w> as the storm grew stronger.",
                            "target_lang_translations": {
                                "de": "Die Besatzung erkannte, dass ihr Schiff in großer <w>Gefahr</w> schwebte, als der Sturm stärker wurde."
                            }
                        },
                        {
                            "text": "You must understand that your life is in <w>peril</w> if you remain in this war zone.",
                            "target_lang_translations": {
                                "de": "Sie müssen verstehen, dass Ihr Leben in <w>Gefahr</w> ist, wenn Sie in diesem Kriegsgebiet bleiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "danger",
                        "jeopardy"
                    ],
                    "antonyms": [
                        "safety",
                        "security"
                    ],
                    "common_phrases": [
                        "in grave peril",
                        "mortal peril"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand ernster und unmittelbarer Gefahr."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gefahr",
                                "target_lang_sense_clarification": "Zustand der Bedrohung oder des Risikos"
                            },
                            {
                                "target_lang_word": "Lebensgefahr",
                                "target_lang_sense_clarification": "speziell bei Bedrohung des Lebens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44df4d90-6929-36b0-bac3-8a2ddbb8e360",
                    "sense_definition": "Something that causes, contains, or presents danger; a hazard.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "danger_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were warned about the <w>perils</w> of the deep jungle before starting our expedition.",
                            "target_lang_translations": {
                                "de": "Wir wurden vor den <w>Gefahren</w> des tiefen Dschungels gewarnt, bevor wir unsere Expedition begannen."
                            }
                        },
                        {
                            "text": "She wrote a book detailing the many <w>perils</w> of social media for young teenagers.",
                            "target_lang_translations": {
                                "de": "Sie schrieb ein Buch, das die vielen <w>Gefahren</w> von Social Media für junge Teenager im Detail beschreibt."
                            }
                        }
                    ],
                    "synonyms": [
                        "hazard",
                        "risk",
                        "threat"
                    ],
                    "common_phrases": [
                        "perils of the road",
                        "hidden perils"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das Gefahr verursacht, in sich birgt oder darstellt; ein Risiko oder eine Bedrohung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gefahr",
                                "target_lang_sense_clarification": "eine Gefahrenquelle oder Bedrohung"
                            },
                            {
                                "target_lang_word": "Risiko",
                                "target_lang_sense_clarification": "ein Wagnis oder eine potenzielle Gefahr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b1be2df-e6b1-374d-b285-26bd9797ec19",
                    "sense_definition": "An event which causes a loss, or the risk of a specific such event, especially in insurance contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "danger_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The standard home insurance policy does not cover the <w>peril</w> of earthquakes.",
                            "target_lang_translations": {
                                "de": "Die Standard-Hausratversicherung deckt die <w>Gefahr</w> von Erdbeben nicht ab."
                            }
                        },
                        {
                            "text": "You can purchase additional coverage to protect your business against the <w>peril</w> of flood.",
                            "target_lang_translations": {
                                "de": "Sie können eine Zusatzversicherung abschließen, um Ihr Unternehmen gegen das <w>Risiko</w> von Überschwemmungen abzusichern."
                            }
                        }
                    ],
                    "synonyms": [
                        "risk",
                        "hazard"
                    ],
                    "common_phrases": [
                        "covered peril",
                        "insured peril"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical insurance term"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ereignis, das einen Schaden verursacht, oder das Risiko eines solchen Ereignisses, insbesondere im Versicherungswesen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gefahr",
                                "target_lang_sense_clarification": "versichertes Risiko oder Schadensereignis"
                            },
                            {
                                "target_lang_word": "Risiko",
                                "target_lang_sense_clarification": "im Kontext von Versicherungen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cbf4738-748d-34f6-80c6-fb28a84d2cca",
                    "sense_definition": "To expose to danger; to risk or imperil.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will not <w>peril</w> my reputation by associating with dishonest business partners.",
                            "target_lang_translations": {
                                "de": "Ich werde meinen Ruf nicht <w>aufs Spiel setzen</w>, indem ich mich mit unehrlichen Geschäftspartnern einlasse."
                            }
                        },
                        {
                            "text": "The brave soldiers were willing to <w>peril</w> their lives for the freedom of their country.",
                            "target_lang_translations": {
                                "de": "Die tapferen Soldaten waren bereit, ihr Leben für die Freiheit ihres Landes zu <w>riskieren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "risk",
                        "threat"
                    ],
                    "antonyms": [
                        "protect",
                        "safeguard"
                    ],
                    "common_phrases": [
                        "peril one's life",
                        "peril one's reputation"
                    ],
                    "target_lang_definitions": {
                        "de": "Einer Gefahr aussetzen; riskieren oder gefährden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gefährden",
                                "target_lang_sense_clarification": "in Gefahr bringen"
                            },
                            {
                                "target_lang_word": "aufs Spiel setzen",
                                "target_lang_sense_clarification": "riskieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}