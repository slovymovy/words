                "entry_id": "7f018951-42f1-3acb-a932-b0c2b7dcb326",
                "word": "schampar",
                "pos": "particle",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                        "entry_id": "7f018951-42f1-3acb-a932-b0c2b7dcb326",
                        "glosses": [
                            "Steigerung eines Adjektivs oder Adverbs ohne Vergleich: in hohem Maße, besonders"
                        ],
                        "tags": [
                            "Swiss German"
                        ],
                        "examples": [
                            {
                                "example_id": "0c581497-f34f-4692-a9f2-b9f210982d6d",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "Diese Wohnung ist schampar schön."
                            },
                            {
                                "example_id": "488759c4-8e45-4e2a-a17b-cd8fbacfa568",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "«Ich hatte ,schampar‘ Mühe, mir vorzustellen, dass der Sturm wirklich alles zerstört hatte.»"
                            },
                            {
                                "example_id": "e77b456d-64de-4d6d-8009-4e2759a72546",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "«Danach fragen ihn die anderen Bauern: ‹Und, wie isch es gsi?› ‹Paris isch cheibe schön›, antwortet der Weitgereiste, ‹aber schampar abgläge.›»"
                            },
                            {
                                "example_id": "513972b3-a29f-4ee1-9d5a-ef727355ceb1",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "«‹Wir haben schampar gute vier Jahre hinter uns und für den Thurgau eine saugute Lösung ausgejasst›, erklärte Ständerat Philippe Stähelin burschikos und meinte damit den Finanzausgleich, der in vielen Gemeinden zu Steuersenkungen geführt habe.»"
                            },
                            {
                                "example_id": "f3dcb830-e79a-45f4-8170-dcc01c22c7f5",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "«Einen Eintrag habe ich natürlich keinen, aber ich kassierte schon eine Parkbusse und 40 Franken für zu schnelles Fahren. Das hat mich schampar gereut!»"
                            },
                            {
                                "example_id": "4c37fbca-d2b2-4bf3-a0f8-3e6c82b49f55",
                                "sense_id": "40d6f592-7444-331e-b777-61fc7ebb831d",
                                "text": "«Während jugendliche Raser durch die Dörfer donnern, Schlägertrupps die Stadt unsicher machen und junge wie alte Menschen spitalreif schlagen, ist es natürlich schampar gäbig, vom warmen Bürosessel aus Pyrozünder per Internet zu jagen, als in der Kälte draussen für Ordnung zu sorgen.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
