                                    {
                                        "sense_id": "92faad61-aaa4-31c1-9a59-7aabbedeb944",
                                        "entry_id": "6c24e1b2-fac6-33e2-bbb1-45a072b688d5",
                                        "glosses": [
                                            "Celle qui viole, qui enfreint ou qui profane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4d4cf7-a872-4f3a-a534-abee473bb50a",
                                                "sense_id": "92faad61-aaa4-31c1-9a59-7aabbedeb944",
                                                "text": "Il en est de ces crânes comme des reliques de Toutankhamon dont la violatrice du tombeau amena la mort singulière de tous ceux qui y participèrent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "violatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56a31371-4c32-3333-bf36-8527e5d94433",
                                        "entry_id": "d877668e-6557-3d01-a848-6aee25c67d8a",
                                        "glosses": [
                                            "Féminin singulier de violateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b151c80c-a054-44fa-bdb7-ee1000436f95",
                                                "sense_id": "56a31371-4c32-3333-bf36-8527e5d94433",
                                                "text": "S’il était vrai que la Charte nous fût ravie par une loi violatrice de l’arche d’alliance entre le Roi et son peuple, la désobéissance à cette loi serait une vertu digne de couronnes civiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3a937f1-8c2f-4ad2-9457-45b623541157",
                        "source_entry_id": "b5be241c-1712-3004-b2d2-fb0a69b00552",
                        "source_sense_description": "one who violates",
                        "target_lang_word": "Verletzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
