                                "example_id": "5818869d-7331-485f-9f92-7d13422d8192",
                                "sense_id": "8f1fce76-49fd-36a5-821d-bd5eaa234659",
                                "text": "„Wenig ist leichter als ein weißes Herren-T-Shirt zu kaufen.“"
                            },
                            {
                                "example_id": "327ba934-899f-4154-aae3-8b7d854a070b",
                                "sense_id": "8f1fce76-49fd-36a5-821d-bd5eaa234659",
                                "text": "„Legt man ein klassisches Herren-T-Shirt auf den Boden, so hat es die Form des Buchstaben T.“"
                            },
                            {
                                "example_id": "b6000cec-c094-47da-b44d-1bc96fb9ec52",
                                "sense_id": "8f1fce76-49fd-36a5-821d-bd5eaa234659",
                                "text": "„Sie trug wieder ein Herren-T-Shirt, ein weißes, es war ein wenig zu eng, er konnte sehen, wie ihr BH in weiches Fleisch drückte.“"
                            }
                        ],
