        "fr-extract.jsonl": [
            {
                "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                "word": "souille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e072c6b-533f-49b6-b627-30aa13208a2d",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "souilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68e542cd-43dd-3821-8bbc-063f60a13daa",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Cuvette bourbeuse où se vautre ponctuellement le gibier pour se débarrasser de ses parasites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e246bcf-e3ee-40a6-956c-67f85ed43fc7",
                                "sense_id": "68e542cd-43dd-3821-8bbc-063f60a13daa",
                                "text": "Plusieurs hardes de pécaris avaient établi leur souille dans les marécages de la côte orientale de l’île et y demeuraient enfouies pendant les heures les plus chaudes de la journée."
                            },
                            {
                                "example_id": "f4d5db12-1c36-4772-99ae-8b1b3a3cd613",
                                "sense_id": "68e542cd-43dd-3821-8bbc-063f60a13daa",
                                "text": "Un des éléments qu’il considère comme étant crucial pour atteindre le succès escompté est la découverte d’un indice frais démontrant, hors de tout doute, la présence d’un orignal, comme une souille récente ou un frottage présentant une écorce fraîchement dégarnie."
                            },
                            {
                                "example_id": "0df7b0c0-f71e-4b61-85ea-ed41ab1cc7b0",
                                "sense_id": "68e542cd-43dd-3821-8bbc-063f60a13daa",
                                "text": "Grimes était aujourd’hui bien trop familier de sa souille pour caresser l’idée qu’il comptait parmi les élus tragiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8991fa0-7649-32de-aa65-8703a8934220",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Enfoncement dans un sol sableux ou vaseux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6eeaa718-6b53-41f7-9e93-86840b774a74",
                                "sense_id": "e8991fa0-7649-32de-aa65-8703a8934220",
                                "text": "Je la suivis ; j’avais caché dans un trou mon panier et mes sabots et je marchais pieds nus sur la grève, où mes pas creusaient une souille qui s’emplissait d’eau..."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e3da143-021d-380c-aa97-20472a83dc7a",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Enfoncement, sorte de lit que forme, dans la vase ou dans le sable mou, un navire échoué momentanément."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "baa175bf-e4b6-44c5-8da3-0bd7e8af9d72",
                                "sense_id": "7e3da143-021d-380c-aa97-20472a83dc7a",
                                "text": "En fin d'exploitation, taluter les bords de souille en pente douce et niveler le fond si nécessaire pour rendre le site propre au chalutage."
                            }
                        ]
                    },
                    {
                        "sense_id": "255d97e4-61e1-3c3a-b059-3e8b674aa860",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Cuvette bourbeuse où se vautre l’éléphant de mer ^([2])."
                        ],
                        "tags": [
                            "Vocabulaire des TAAF"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1027f010-7342-3b0e-939b-c570ff793bce",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Cuvette bourbeuse où se vautre l’éléphant de mer ^([2]).",
                            "Tout endroit boueux ^([2])."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8e66f3e9-5301-3aed-b53e-df62c75f20e1",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Fête arrosée ^([2])."
                        ],
                        "tags": [
                            "Vocabulaire des TAAF"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bf707302-983f-3765-a30d-ac43439a81f1",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Taie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054dedf2-dfa4-4780-b31e-da2ea0f948ba",
                                "sense_id": "bf707302-983f-3765-a30d-ac43439a81f1",
                                "text": "La souille est une pièce de tissu qui recouvre les couettes, les travers et les oreillers."
                            }
                        ]
                    },
                    {
                        "sense_id": "4361531a-ba15-3dab-b5ef-b5603420a4c5",
                        "entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "glosses": [
                            "Recru arbustif, particulièrement celui s’opposant à une régénération en ombrageant le sol ou en se substituant aux semis de l’essence objectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1227fb-8892-48a6-b524-453708f4b34b",
                                "sense_id": "4361531a-ba15-3dab-b5ef-b5603420a4c5",
                                "text": "Ces coupes de préparation dans le taillis sont réalisées au moins dix ans avant le début escompté de la phase de régénération, afin que le couvert du taillis restant ait le temps de se refermer et de garantir ainsi un sol propre au moment de la coupe d’ensemencement. Dans le cas où elles seraient réalisées à moins de dix ans de la future coupe d’ensemencement, il faut particulièrement veiller à ce que leur intensité ne soit pas trop forte, ce qui entraînerait le développement de la souille et d’une strate basse qu’il faudrait ensuite réduire par des travaux coûteux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44ff2c2b-d8dd-49ae-8fba-025b7fed85b0",
                        "source_entry_id": "6a3602f1-74de-3af9-a1fb-4841ea1021f3",
                        "target_lang_word": "wallow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "362fa05d-27c0-32de-a8ea-be2c89e51c80",
                                        "entry_id": "addf3461-fdc1-3a0c-a24f-044d26b2bf69",
                                        "glosses": [
                                            "Tasteless, flat."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fffc83d-5bc6-3347-8e31-cb07df1e723f",
                                        "entry_id": "5f43ce9f-25de-39b0-a16d-4645e25b1bb6",
                                        "glosses": [
                                            "To roll oneself about in something dirty, for example in mud."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e771321b-0c89-4390-ad08-4b59b22ae51f",
                                                "sense_id": "1fffc83d-5bc6-3347-8e31-cb07df1e723f",
                                                "text": "When Manſoul trampled upon things Divine, / And wallowed in filth as doth a ſwine:"
                                            },
                                            {
                                                "example_id": "44a0ed6e-5dd0-4149-90b4-007781d3a451",
                                                "sense_id": "1fffc83d-5bc6-3347-8e31-cb07df1e723f",
                                                "text": "Pigs wallow in the mud."
                                            },
                                            {
                                                "example_id": "30df6c93-090e-4d4e-b787-485a74fab6bb",
                                                "sense_id": "1fffc83d-5bc6-3347-8e31-cb07df1e723f",
                                                "text": "O be thou my Charon, / And giue me ſwift tranſportance to theſe fieldes, / VVhere I may wallow in the lilly beds, / Propoſ'd for the deſeruer."
                                            },
                                            {
                                                "example_id": "72ecd759-c808-45fb-8fd1-580325151602",
                                                "sense_id": "1fffc83d-5bc6-3347-8e31-cb07df1e723f",
                                                "text": "Make ye him drunken: for hee magnified himselfe against the Lord: Moab also shall wallow in his vomit, and he also shalbe in derision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd08ce6-8be1-3e71-98d6-d905ce3251e8",
                                        "entry_id": "5f43ce9f-25de-39b0-a16d-4645e25b1bb6",
                                        "glosses": [
                                            "To move lazily or heavily in any medium."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290f6be7-1a98-4409-a1d7-d2e97f3ab6c0",
                                                "sense_id": "6fd08ce6-8be1-3e71-98d6-d905ce3251e8",
                                                "text": "The fire was thrown to a great height; the fountains and jets all wallowed together; new ones appeared, and danced joyously round the margin, then converging towards the centre they merged into one glowing mass, which upheaved itself pyramidally and disappeared with a vast plunge."
                                            },
                                            {
                                                "example_id": "347063fd-ce8d-4386-8482-0cecb2667fef",
                                                "sense_id": "6fd08ce6-8be1-3e71-98d6-d905ce3251e8",
                                                "text": "Amongst the cruisers, it's not such good news. New Orleans is sunk; Wichita is wallowing and desperately in need of assistance, which two destroyers are providing; meanwhile, Biloxi and Vincennes are both in the process of going down and being abandoned, whilst Miami is right on the knife-edge of being recoverable, with three destroyers clustering around offering pumping and additional damage-control crews to try and keep the light cruiser afloat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                        "entry_id": "5f43ce9f-25de-39b0-a16d-4645e25b1bb6",
                                        "glosses": [
                                            "To immerse oneself in, to occupy oneself with, metaphorically."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5312002d-cbd9-4d5c-a0bb-54ba7dd29338",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "She wallowed in her misery."
                                            },
                                            {
                                                "example_id": "d443ff85-32ef-427b-b45f-58f2da15e257",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "If there be any lazy Fellow, any that cannot away with Work, any that would wallow in Pleaſures, he is haſty to be prieſted. And, when he is made one, and hath gotten a Benefice, he conſorts with his Neighbour Prieſts, who are altogether given to Pleaſures; and then both he, and they, live, not like Chriſtians, but like Epicures; drinking, eating, feaſting, and revelling, till the Cow come Home, as the saying is; [...]"
                                            },
                                            {
                                                "example_id": "88584db6-be99-4acf-87eb-a15bdffb0564",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "With the help of a sleepy waiter, Little Billee got the bacchanalian into his room and lit his candle for him, and, disengaging himself from his maudlin embraces, left him to wallow in solitude."
                                            },
                                            {
                                                "example_id": "52b5cb88-1434-4d7d-bc59-39480894a416",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "Regret is an appalling waste of energy, and no one who intends to be a writer can afford to indulge in it. You can't get it into shape; you can't build on it; it's only good for wallowing in."
                                            },
                                            {
                                                "example_id": "84fbb753-221d-4be8-b9e7-35a20fc04834",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "There the North British, having apparently decided that we had sufficiently wallowed in luxury, turned us out and loaded us into ancient four-wheelers, which were then attached to the rear of the night express (8.15 from Kings Cross)."
                                            },
                                            {
                                                "example_id": "1f7a3aba-77d1-4379-b5d8-ce4b29121644",
                                                "sense_id": "efcbb29a-bbfd-31dd-a0a8-41cce1cc4342",
                                                "text": "With Smithers out of the picture I was free to wallow in my own crapulence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f7d01e-86f8-30e9-a198-0a0d769c30e8",
                                        "entry_id": "5f43ce9f-25de-39b0-a16d-4645e25b1bb6",
                                        "glosses": [
                                            "To live or exist in filth or in a sickening manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d90105c1-740c-46bb-b6cc-c0456c216366",
                                                "sense_id": "21f7d01e-86f8-30e9-a198-0a0d769c30e8",
                                                "text": "God sees a man wallowing in his native impurity."
                                            },
                                            {
                                                "example_id": "50db595c-464d-4d75-8490-f54fa24ecff6",
                                                "sense_id": "21f7d01e-86f8-30e9-a198-0a0d769c30e8",
                                                "text": "The floors are at times inches deep with dirt and scraps of clothing. The whole place wallows with putrefaction. In some of the rooms it would seem that there had not been a breath of fresh air for five years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33c5d8c8-33a9-3110-8486-9adf3bec2c94",
                                        "entry_id": "6b0ce30f-bc61-39bb-953d-bf96e9f3cb27",
                                        "glosses": [
                                            "An instance of wallowing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "252ff37f-6514-3127-a3c1-3c1dd8f4906b",
                                        "entry_id": "6b0ce30f-bc61-39bb-953d-bf96e9f3cb27",
                                        "glosses": [
                                            "A pool of water or mud in which animals wallow, or the depression left by them in the ground."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccba2a64-05bb-4724-8b2b-2c5b4b7ee5d6",
                                                "sense_id": "252ff37f-6514-3127-a3c1-3c1dd8f4906b",
                                                "text": "However, we have no time to linger, and picking our way among the countless buffalo wallows which indent the level surface of the summit, the wagon, […]"
                                            },
                                            {
                                                "example_id": "d04c4cf7-38ba-4b0e-bd59-c292b9017274",
                                                "sense_id": "252ff37f-6514-3127-a3c1-3c1dd8f4906b",
                                                "text": "Soon, the incessant wind would dry the stenchy wallow to corduroyed cement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81429c51-a88f-3ca1-84a7-1cf3f0b50f42",
                                        "entry_id": "6b0ce30f-bc61-39bb-953d-bf96e9f3cb27",
                                        "glosses": [
                                            "A kind of rolling walk."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wallow",
                                "target_lang_code": "en",
                                "target_senses": [
