                "senses": [
                    {
                        "sense_id": "afd2ccb9-c68f-35bc-86c4-a69d0be3f011",
                        "entry_id": "a19ceedb-0ea5-3daa-ab8f-1f605e55002d",
                        "glosses": [
                            "eine Schlichtaxt für Zimmerleute in der Form eines Bartbeiles und langer Klinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f66f3e73-9ec0-451c-84e4-82d7909acb2d",
                                "sense_id": "afd2ccb9-c68f-35bc-86c4-a69d0be3f011",
                                "text": "„Doch hatte Eske nach alter Zimmermannssitte sein eigenes Blattbeil mitgenommen, um es bei der Arbeit zu benutzen.“"
                            },
                            {
                                "example_id": "6c3461d1-8887-4e19-9ceb-68fa1d35edef",
                                "sense_id": "afd2ccb9-c68f-35bc-86c4-a69d0be3f011",
                                "text": "„Breitbeil n; auch Blattbeil n; Dünnbeil n: Beschlagbeil des Zimmermanns mit langer Schneide (20-40 cm) und in der Form eines Bartbeiles.“"
                            },
                            {
                                "example_id": "44f93a61-af17-4264-a8f7-318b6ee43537",
                                "sense_id": "afd2ccb9-c68f-35bc-86c4-a69d0be3f011",
                                "text": "„Breitaxt (Breitbeil, Blattbeil), Beil mit sehr breiter, auf der einen Seite ganz ebener Klinge, die Seiten der Balken damit glatt zu hauen, Schlichtaxt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
