                            {
                                "example_id": "f471c252-17b0-4f4b-8f60-2758b94dc1b8",
                                "sense_id": "2f8264ff-6ed0-3fd3-b87d-ffb38190625a",
                                "text": "Niet voor niets draagt Vrouwe Justitia een blinddoek."
                            },
                            {
                                "example_id": "f0a6c767-3adb-4ce2-90f7-ef505b9ee746",
                                "sense_id": "2f8264ff-6ed0-3fd3-b87d-ffb38190625a",
                                "text": "Bij het spelletje ezeltje prik heeft het kind een blinddoek om."
                            }
                        ]
