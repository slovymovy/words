                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433b1fdb-b215-4abc-8118-68316c9187bd",
                        "source_entry_id": "1f883983-9c86-3d04-ad4f-54c0059be634",
                        "target_lang_word": "sportif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sportif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui se rapporte ou est propre au sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe047e3b-4d28-4ad6-80a4-3bd0ef8f8dcd",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "Le gouvernement s’emploiera en outre, avec des partenaires, à accroitre les activités sportives aux niveaux communautaire et compétitif."
                                            },
                                            {
                                                "example_id": "90bbbd81-d028-4fce-a142-4084d0c4b3ec",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "Ces derniers ont montré que le temps de jeu sur le terrain était, lui aussi, fonction de variables extra-sportives en plus de variables sportives."
                                            },
                                            {
                                                "example_id": "07f0f6d4-b92e-499c-9168-111ac71796fc",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "[…], mais elles n'existaient plus l’échoppe du cordonnier que traversaient les émissions sportives et la boulangerie où la mère de Josette pesait le pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1866d6df-0125-31aa-a6ec-32ed64578a4d",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui pratique un sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c1a51e-63f2-4221-b3a4-ca72110b997a",
                                                "sense_id": "1866d6df-0125-31aa-a6ec-32ed64578a4d",
                                                "text": "Elle est très sportive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a17a2f-f0b0-3b97-9151-68dadce5596c",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui atteste de sportivité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dab4bf2-37f9-4b71-b97a-9a9e74afb730",
                                                "sense_id": "63a17a2f-f0b0-3b97-9151-68dadce5596c",
                                                "text": "Il court à une allure sportive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e45333-d990-33de-99eb-7a393cb15f82",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui correspond à l'esprit du sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7a59f9-131e-4de8-b708-0f1afc35abde",
                                                "sense_id": "f4e45333-d990-33de-99eb-7a393cb15f82",
                                                "text": "Le public britannique est connu pour n’être pas très sportif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sportif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a85e7f-4038-3964-a475-f2ca4425bb4f",
                                        "entry_id": "aae60818-ed5d-37a4-936a-9c885bb5d5b3",
                                        "glosses": [
