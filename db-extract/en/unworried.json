                        "glosses": [
                            "Free of worries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3bd4905-946a-4454-9368-65cc485b0a19",
                                "sense_id": "494e10fb-e189-3352-b94a-bc5011bb1367",
                                "text": "PSCs [passenger service contracts] will entail GBR [Great British Railways] paying a fee to the operator to run the trains, while fares go to GBR. Taxpayer money can be fed into GBR through grants from the DfT. This will leave operators unworried about the wider state of the economy and its effect on passenger numbers."
                            }
                        ]
                    }
