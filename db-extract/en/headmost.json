                        "glosses": [
                            "Closest to the front of a group or pack"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e81847b1-72bb-4616-9ee5-6924a492df9f",
                                "sense_id": "16803f84-71e2-3a94-94b6-c810c592ac75",
                                "text": "The headmost was a ship, and the other, a brig."
                            },
                            {
                                "example_id": "e24ca316-f780-4f1f-84f0-77f84fcf5fd7",
                                "sense_id": "16803f84-71e2-3a94-94b6-c810c592ac75",
                                "text": "The headmost hounds soon burst out of the coppice, followed by three or four riders with reckless haste, regardless of the broken and difficult nature of the ground. \""
                            },
                            {
                                "example_id": "9e55b995-b36c-4e23-8091-9f18723fc513",
                                "sense_id": "16803f84-71e2-3a94-94b6-c810c592ac75",
                                "text": "We were now the headmost line of battle ship and gaining fast upon the enemy; but the main part of our fleet seemed rather to drop from them."
                            }
                        ]
                    }
                ],
