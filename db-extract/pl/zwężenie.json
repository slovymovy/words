                "senses": [
                    {
                        "sense_id": "eebf05cd-411c-3dc7-88ea-49c628779e78",
                        "entry_id": "920b5384-b422-31b7-b413-e7ce0d8d4530",
                        "glosses": [
                            "miejsce, w którym coś jest wąskie lub węższe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d3c455-8d5e-4674-8013-cd4df4c4a175",
                                "sense_id": "eebf05cd-411c-3dc7-88ea-49c628779e78",
                                "text": "Podniebienie miękkie, nazywane też warstwą podniebienną, jest strukturą gładką i częściowo ruchomą, oddzielającą jamę ustną od gardła w zwężeniu zwanym cieśnią gardzieli."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5ef36b74-6fb7-3b8d-88d0-08c1972e170c",
                        "entry_id": "920b5384-b422-31b7-b413-e7ce0d8d4530",
                        "glosses": [
                            "zmodyfikowanie ubrania tak, aby było węższe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f0ed069-4003-4069-9943-160700f88018",
                                "sense_id": "5ef36b74-6fb7-3b8d-88d0-08c1972e170c",
                                "text": "Moja ulubiona spódnica jest do zwężenia w talii."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
