                {
                    "sense_id": "125584d8-f289-3a20-a507-a88af3266a91",
                    "sense_definition": "Of, from, or pertaining to the United States of America, its people, or its culture.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "usa_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He married an <w>American</w> woman and moved to New York.",
                            "target_lang_translations": {
                                "ru": "Он женился на <w>американке</w> и переехал в Нью-Йорк.",
                                "zh": "他娶了一位<w>美国</w>女性，并搬到了纽约。"
                            }
                        },
                        {
                            "text": "Thanksgiving is a very popular <w>American</w> tradition.",
                            "target_lang_translations": {
                                "ru": "День благодарения — очень популярная <w>американская</w> традиция.",
                                "zh": "感恩节是一个非常受欢迎的<w>美式</w>传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "US-American",
                        "U.S. American"
                    ],
                    "common_phrases": [
                        "American dream",
                        "American culture",
                        "American football",
                        "American history"
                    ],
