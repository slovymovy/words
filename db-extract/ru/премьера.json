                                    {
                                        "sense_id": "2822fd5e-c6a1-37b8-b918-894380ec18ae",
                                        "entry_id": "2ced16a7-cd41-3678-85d1-6cab66dafe61",
                                        "glosses": [
                                            "Of a film or play, to play for the first time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02592132-fc19-465c-a2d7-058eefbaf3e9",
                                                "sense_id": "2822fd5e-c6a1-37b8-b918-894380ec18ae",
                                                "text": "The new film premieres this weekend."
                                            },
                                            {
                                                "example_id": "18f1de05-3338-45ae-a463-dfa622773cbd",
                                                "sense_id": "2822fd5e-c6a1-37b8-b918-894380ec18ae",
                                                "text": "His two most recent films are last year's Greyhound, a Hanks-penned World War Two thriller in which he plays a naval commander, and now News of the World, a Western set in the years immediately following the close of the US Civil War, directed by Paul Greengrass, which is premiering around the world on Netflix tomorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171ea187-9311-3340-b1da-b23a81995e3b",
                                        "entry_id": "2ced16a7-cd41-3678-85d1-6cab66dafe61",
                                        "glosses": [
                                            "To present a film or play for the first time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "109692c2-6fd5-425f-aca7-773b888b3d96",
                                                "sense_id": "171ea187-9311-3340-b1da-b23a81995e3b",
                                                "text": "The local theatre will premiere its latest play this week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "484e53a0-e0cf-4472-b7a6-e0a1d6463a92",
                        "source_entry_id": "0cc5d1eb-62c8-3a81-a6a6-b95b634d7cc0",
                        "source_sense_id": "d06f6d4d-187d-37ef-9b7d-a955357b9d13",
                        "target_lang_word": "Uraufführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uraufführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                        "entry_id": "1e6fbaa1-f2ae-3dc9-90e8-219ca2332e76",
                                        "glosses": [
                                            "allererste öffentliche Aufführung eines Musikstückes oder Bühnenwerkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929dba94-49e1-41e7-b369-5bc471943545",
                                                "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                                "text": "Die Uraufführung eines seiner Werke ist ein besonderes Ereignis für einen Komponisten."
                                            },
                                            {
                                                "example_id": "cde4222d-9673-4205-8dec-d5f55407fe6e",
                                                "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                                "text": "„Am Tage der Uraufführung in Max Reinhardts Großem Schauspielhaus in Berlin wurde Rathenau von völkischen Studenten ermordet.“"
                                            },
                                            {
                                                "example_id": "585c62a4-f93e-4204-9d73-ac4d8f387cfb",
                                                "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                                "text": "„Die Uraufführung fand in Köthen statt.“"
                                            },
                                            {
                                                "example_id": "821a0048-49a5-4ff0-966a-5e30db82a30d",
                                                "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                                "text": "„Die Uraufführung fand am 22. Juni im Rahmen der EXPO 2000 statt, natürlich in Hannover.“"
                                            },
                                            {
                                                "example_id": "a50bc627-44f4-47f4-abde-943be3aeb3ec",
                                                "sense_id": "d280d881-01a6-3a2b-aaf0-7753fddbf2fb",
                                                "text": "„Bei der Uraufführung war sie denn auch eine umstrittene Sensation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
