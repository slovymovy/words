                        "target_lang_word": "江南",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "江南",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                        "entry_id": "89762fa8-7161-344e-9ad3-fda8e41f804e",
                                        "glosses": [
                                            "位於中國，指長江以南的地區，特指長江下游的蘇南、皖南、浙北地區"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4c2f64-a732-47a0-84fc-a7c03f274170",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "魂兮歸來，哀江南！",
                                                "translation": "回家吧，你的靈魂，並憐憫你心愛的南方土地！"
                                            },
                                            {
                                                "example_id": "24342bf1-7f29-449d-bfec-c5e9080f96c1",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "魂兮归来，哀江南！",
                                                "translation": "回家吧，你的靈魂，並憐憫你心愛的南方土地！"
                                            },
                                            {
                                                "example_id": "4cf920b3-b684-4d34-ba6d-7c6d04bdcc1e",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "江南有丹橘，經冬猶綠林。"
                                            },
                                            {
                                                "example_id": "ffc82ea5-76b7-4f99-bc7d-441d1043d1b2",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "江南有丹橘，经冬犹绿林。"
                                            },
                                            {
                                                "example_id": "cd3a07bb-83aa-4d6b-ad05-a5d0c8f86d73",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "孤與將軍，恩如骨肉，割授江南，不屬本州。"
                                            },
                                            {
                                                "example_id": "94376061-4239-480d-8596-6ce9337c299e",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "孤与将军，恩如骨肉，割授江南，不属本州。"
                                            },
                                            {
                                                "example_id": "3a6d95d4-c8a5-4406-9b8f-f69b2c437966",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "自濟州往江南，則頗遠，自全羅道往遼東，則甚近。",
                                                "translation": "如果從濟州前往江南，[路途]相當遙遠；如果從全羅前往遼東，則非常接近。"
                                            },
                                            {
                                                "example_id": "a18ef7c1-9827-4bf9-9258-fb49d4c74980",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "此日一帆憑顧盼，重山復水是江南。"
                                            },
                                            {
                                                "example_id": "7e1f52b1-66f2-4f14-85c2-d6a73e0934ff",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "此日一帆凭顾盼，重山复水是江南。"
                                            },
                                            {
                                                "example_id": "4874e17a-1d34-4b44-ae37-841df58c5bb9",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "千古奇冤，江南一葉；同室操戈，相煎何急！？"
                                            },
                                            {
                                                "example_id": "a73d40eb-ba68-4490-ada9-08942dd03898",
                                                "sense_id": "0a55f888-96ed-32d3-bac6-bc66307ead11",
                                                "text": "千古奇冤，江南一叶；同室操戈，相煎何急！？"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d02b18-c031-3f43-905f-99d616f610b2",
                                        "entry_id": "89762fa8-7161-344e-9ad3-fda8e41f804e",
                                        "glosses": [
                                            "南北朝時期，稱呼南朝及其統治的地區"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e547312d-9773-4c9a-ba65-64fcfe6ac352",
                                                "sense_id": "e9d02b18-c031-3f43-905f-99d616f610b2",
                                                "text": "江南佳麗地，金陵帝王州。"
                                            },
                                            {
                                                "example_id": "dfb699c4-1249-4b12-9667-41c4474a7295",
                                                "sense_id": "e9d02b18-c031-3f43-905f-99d616f610b2",
                                                "text": "江南佳丽地，金陵帝王州。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e4460d-30e8-34d6-9c27-8acfb5e7c8a5",
                                        "entry_id": "89762fa8-7161-344e-9ad3-fda8e41f804e",
                                        "glosses": [
                                            "五代十國時期，稱呼南唐及其統治的地區"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737565ee-33a8-491f-acd8-af0cdffb9a67",
                                                "sense_id": "73e4460d-30e8-34d6-9c27-8acfb5e7c8a5",
                                                "text": "江南偽主李煜，承奕世之遺基，據偏方而竊號。"
                                            },
                                            {
                                                "example_id": "972606a6-008f-41f0-81ff-31179392a9b6",
                                                "sense_id": "73e4460d-30e8-34d6-9c27-8acfb5e7c8a5",
                                                "text": "江南伪主李煜，承奕世之遗基，据偏方而窃号。"
                                            },
                                            {
                                                "example_id": "c097c069-320f-438c-9b34-0e16565d9625",
                                                "sense_id": "73e4460d-30e8-34d6-9c27-8acfb5e7c8a5",
                                                "text": "（乾祐）三年，江南遣其將查文徽攻福州，俶發兵擒文徽。"
                                            },
                                            {
                                                "example_id": "4fba24a6-f668-4aa1-a673-bf381ee0464d",
                                                "sense_id": "73e4460d-30e8-34d6-9c27-8acfb5e7c8a5",
                                                "text": "（乾祐）三年，江南遣其将查文徽攻福州，俶发兵擒文徽。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcfdaa37-7300-3405-b3bc-4b68964006b1",
