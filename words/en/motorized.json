{
    "word_family": [
        "motor",
        "motorize",
        "motorization",
        "motorist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "64db9eda-af3a-343b-88b0-873ade006697",
                    "sense_definition": "Equipped with a motor or engine to provide power or movement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "powered equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly man uses a <w>motorized</w> wheelchair to get around the shopping mall.",
                            "target_lang_translations": {
                                "ru": "Пожилой мужчина использует <w>моторизованное</w> инвалидное кресло, чтобы передвигаться по торговому центру."
                            }
                        },
                        {
                            "text": "Some people argue that a moped is just a <w>motorized</w> bicycle with extra features.",
                            "target_lang_translations": {
                                "ru": "Некоторые утверждают, что мопед — это просто <w>моторизованный</w> велосипед с дополнительными функциями."
                            }
                        }
                    ],
                    "synonyms": [
                        "powered",
                        "engine-driven"
                    ],
                    "antonyms": [
                        "manual",
                        "non-motorized"
                    ],
                    "common_phrases": [
                        "motorized_bicycle",
                        "motorized_wheelchair",
                        "motorized_vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный мотором или двигателем для обеспечения мощности или движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторизованный",
                                "target_lang_sense_clarification": "оснащенный двигателем"
                            },
                            {
                                "target_lang_word": "с электроприводом",
                                "target_lang_sense_clarification": "приводимый в движение электричеством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01a5f410-c490-362d-b871-d0e0708e08be",
                    "sense_definition": "Equipped with or using motor vehicles, especially for transport or military movement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army deployed a <w>motorized</w> unit to reach the border more quickly.",
                            "target_lang_translations": {
                                "ru": "Армия развернула <w>моторизованное</w> подразделение, чтобы быстрее добраться до границы."
                            }
                        },
                        {
                            "text": "In highly <w>motorized</w> towns, traffic congestion has become a major environmental problem.",
                            "target_lang_translations": {
                                "ru": "В сильно <w>автомобилизированных</w> городах пробки стали серьезной экологической проблемой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "motorized_infantry",
                        "motorized_unit",
                        "motorized_transport"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный или использующий автотранспортные средства, особенно для перевозок или военных перемещений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторизованный",
                                "target_lang_sense_clarification": "о воинских частях или транспорте"
                            },
                            {
                                "target_lang_word": "автомобилизированный",
                                "target_lang_sense_clarification": "о городах или обществе с большим количеством машин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7ddf2cd-59a7-38e7-a1da-37ba81b90e13",
                    "sense_definition": "Simple past and past participle of <w>motorize</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>motorized</w> the assembly line to increase production speed.",
                            "target_lang_translations": {
                                "ru": "Завод <w>моторизовал</w> сборочную линию, чтобы увеличить скорость производства."
                            }
                        },
                        {
                            "text": "They have <w>motorized</w> the heavy gates so they open automatically.",
                            "target_lang_translations": {
                                "ru": "Они <w>оснастили электроприводом</w> тяжелые ворота, чтобы они открывались автоматически."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «motorize» (оснащать двигателем)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторизовал",
                                "target_lang_sense_clarification": "оснастил двигателем"
                            },
                            {
                                "target_lang_word": "моторизованный",
                                "target_lang_sense_clarification": "ставший автоматическим или оснащенным приводом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}