                        "glosses": [
                            "Fruits ou légumes cuits lentement pour donner une compote ou une marmelade, servant à accompagner des mets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf555dc-2032-4393-bf44-349b02acb82e",
                                "sense_id": "09e256fa-369e-3195-bfdb-01c9e9d16872",
                                "text": "Chébran, le tiramisu végan de Nabil Barina, champion du monde du tiramisu sacré à Lyon, avec son Verde à la crème végétale, compotée de pommes cuites en deux façons, pétales de main de Bouddha, zeste de citron vert et café vert !"
                            },
                            {
                                "example_id": "b503f79c-1a79-4523-8b16-db116c22d2a9",
                                "sense_id": "09e256fa-369e-3195-bfdb-01c9e9d16872",
                                "text": "Au moment de servir, étalez la compotée de clémentines à la fleur d’oranger sur le cheesecake, puis saupoudrez d’éclats de pistaches."
                            }
                        ]
                    }
