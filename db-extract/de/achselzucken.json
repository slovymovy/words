                        ],
                        "form": "das Achselzucken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                        "entry_id": "c31bb2a6-cac6-367a-ba28-faf75d503ad3",
                        "glosses": [
                            "Geste durch eine willkürliche Bewegung der Achsel/Achseln, um Nichtwissen/Unschlüssigkeit oder dergleichen anzudeuten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e61d97-4aa0-4a44-902c-9aeeb149c4c6",
                                "sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                                "text": "„Mit einem Achselzucken kann Eos ihre Enttäuschung nicht überspielen.“"
                            },
                            {
                                "example_id": "037046e4-f8b4-4339-b3fe-dbe062725b5c",
                                "sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                                "text": "„Auf die Frage nach den Umständen solch einer Reise gibt es bloß Achselzucken, ein ungeduldiges Fingertrommeln auf dem Tisch, den leeren Blick durch uns hindurch.“"
                            },
                            {
                                "example_id": "2b9ce90e-c507-4bec-b031-121a48805f92",
                                "sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                                "text": "„Es erschien mir als nonchalantes Achselzucken, als eine mögliche operettenhafte Antwort auf das Unabänderliche, ein heiterer Fatalismus.“"
                            },
                            {
                                "example_id": "7f332610-6341-47c0-8f33-8ded862d45cd",
                                "sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                                "text": "„Bilibin deutete mit einem Achselzucken an, wenn die Sache so schwierig liege, wisse nicht einmal er einen Rat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "726e8d99-34af-441b-aabc-328d152cedf3",
                        "source_entry_id": "c31bb2a6-cac6-367a-ba28-faf75d503ad3",
                        "source_sense_id": "e6e14354-2b75-35bb-ae49-ff7d35cfdf4c",
                        "source_sense_description": "willkürliche Bewegung der Achsel/Achseln",
                        "target_lang_word": "shrug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A lifting of the shoulders to signal indifference or a casual lack of knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67d267b-17aa-498c-842b-ad17d8cee3d6",
                                                "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                                "text": "He dismissed my comment with a shrug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35444622-19df-3e52-8b51-00429e129e44",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A cropped, cardigan-like garment with short or long sleeves, typically knitted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                        "entry_id": "bd5e31b5-6b5d-348e-bea2-6dcd30fd6896",
                                        "glosses": [
                                            "To raise (the shoulders) to express uncertainty, lack of concern, (formerly) dread, etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca91abe-7538-4bf0-9ff1-765ef6b6c42b",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "I asked him for an answer and he just shrugged."
                                            },
                                            {
                                                "example_id": "6b70f9f0-90c9-4e87-a869-79ee967d8714",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "When he saw the problem, he just shrugged and started fixing it."
                                            },
                                            {
                                                "example_id": "d4f052aa-7fcd-4b92-8411-b492e9e5f23e",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "He[…] shrugs his shoulders when you talk of securities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
