                "senses": [
                    {
                        "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                        "entry_id": "9d159c5f-2b61-3f7a-a11f-79e54ac38d77",
                        "glosses": [
                            "Computerprogramm, das sich selbst weiter verbreiten kann und mit einer Schadfunktion ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b892e8-3611-490c-b896-b7aafd61382c",
                                "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                                "text": "„Als Cohen Computerviren definierte, hatte er deren Vorbilder aus der Biologie im Hinterkopf: […]“"
                            },
                            {
                                "example_id": "1ec27aee-169e-4e45-9bb6-87d60db410fe",
                                "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                                "text": "„Die Ausschüsse für Unfug und Desinformation wetteifern darum, einen Computervirus zu entwickeln, der Bankautomaten so krank macht, dass sie massenhaft Zehn- und Zwanzigdollarscheine ausspucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ee5ba47-4a3d-423e-a715-f3ea30493c54",
                        "source_entry_id": "9d159c5f-2b61-3f7a-a11f-79e54ac38d77",
                        "source_sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                        "source_sense_description": "Computerprogramm, das sich selbst weiter verbreiten kann und mit einer Schadfunktion ausgestattet ist",
                        "target_lang_word": "computer virus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "computer virus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20864392-8f0d-36d4-97dc-9489353dea17",
                                        "entry_id": "142e9e0d-bf64-3ea9-9355-91d31ca5f44d",
                                        "glosses": [
                                            "A program which can covertly transmit itself between computers via networks (especially the Internet) or removable storage such as disks and USB drives, often causing damage to systems and data."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d2eb6b-c229-4fc2-b91f-57451aac321f",
                        "source_entry_id": "9d159c5f-2b61-3f7a-a11f-79e54ac38d77",
                        "source_sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                        "source_sense_description": "Computerprogramm, das sich selbst weiter verbreiten kann und mit einer Schadfunktion ausgestattet ist",
                        "target_lang_word": "virus informatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virus informatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38bf0550-978d-3759-936f-32fb62995067",
                                        "entry_id": "616ced05-bf70-3fde-96b0-4b522343ce83",
                                        "glosses": [
                                            "Logiciel malveillant écrit dans le but de se dupliquer sur d’autres ordinateurs, afin de provoquer des pertes de données ou encore le « plantage » du système d’exploitation sur les ordinateurs contaminés, ou même des dégâts matériels : « crash » du disque dur, voire « flashage » de la carte mère, ce qui met l’ordinateur totalement hors-service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e66a469-7c51-43b7-9453-ef488225e7ca",
                                                "sense_id": "38bf0550-978d-3759-936f-32fb62995067",
                                                "text": "Tout comme le virus de la grippe, un virus informatique est conçu pour se propager d'un hôte à un autre, avec la capacité de se répliquer. À l'instar d'un virus qui ne peut se reproduire sans une cellule hôte, le virus informatique ne peut proliférer sans un programme, par exemple un fichier ou un document."
                                            },
                                            {
                                                "example_id": "f81aee6b-9eff-466d-91ae-47bba8f4fcaf",
                                                "sense_id": "38bf0550-978d-3759-936f-32fb62995067",
                                                "text": "Un virus informatique est un programme écrit dans le but de se propager sournoisement et rapidement à d'autres ordinateurs. Il perturbe plus ou moins gravement le fonctionnement de l'ordinateur infecté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
