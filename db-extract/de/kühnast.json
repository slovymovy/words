                ],
                "senses": [
                    {
                        "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                        "entry_id": "b91960bb-20bc-3905-ad87-e97a5a9dac15",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ecd0afe-1c3e-438b-bd08-f088869c438b",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kühnast kommt, geht der Herr Kühnast.“"
                            },
                            {
                                "example_id": "c64947a1-fe84-4515-b336-d3f04edcd9b7",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Kühnast kommt und geht."
                            },
                            {
                                "example_id": "5a5a9373-aec6-494b-916d-1571e82d53b6",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Kühnasts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ccd25da1-28c4-42c4-9941-16d52f1f1ed1",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Frau Kühnast ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "29f09123-f8c1-4613-8e85-b4864d0f6252",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Herr Kühnast wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "12341016-3fe6-45ba-8e96-3476cb1a2f32",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Die Kühnasts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "32719877-f21b-4212-b0d2-ebdae6b994c7",
                                "sense_id": "6751d3a4-0915-397a-b646-dfb01967f39e",
                                "text": "Der Kühnast trägt nie die Pullover, die die Kühnast ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
