                                        "glosses": [
                                            "To pop repeatedly, like popcorn cooking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcbe7940-db0f-3fab-a590-c917dc1a39a5",
