        "fr-extract.jsonl": [
            {
                "entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                "word": "molleton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df5e2912-70d4-426b-bcad-d308a2019a4b",
                        "entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "tags": [
                            "plural"
                        ],
                        "form": "molletons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                        "entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "glosses": [
                            "Étoffe de laine, de coton ou de soie, tirée à poil, d’un seul côté ou des deux côtés, douce, chaude et mollette, dont on fait des couvertures, des gilets, des robes de chambre, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ea4164-8e12-4169-abfd-1b06b34f29e0",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Gilet doublé de molleton."
                            },
                            {
                                "example_id": "561bfdb2-d42c-4053-8fd2-a7f336e4fa07",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Adeline ne put retenir un cri perçant en voyant son mari, le baron Hulot, en veste grise tricotée, en pantalon de vieux molleton gris et en pantoufles."
                            },
                            {
                                "example_id": "3089129c-d922-42fc-a74a-e2e62ea24f9a",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Cela partait de haut, des pièces de lainage et de draperie, mérinos, cheviottes, molletons, tombaient de l’entresol."
                            },
                            {
                                "example_id": "faadfeca-6aa4-46ff-b880-39e15f78287d",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Jacques avait sa tenue d’atelier : un pantalon de coupe flottante et un veston de molleton blanc."
                            },
                            {
                                "example_id": "fe567813-9489-4932-88ee-2f484dbccefd",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Quant à la peau, elle ne sentait même pas le grain grossier des toiles ni le poids des molletons qui la couvraient : elle était morte."
                            },
                            {
                                "example_id": "3fee6dab-c214-4a2b-8858-1f9f6711716c",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Elle avait pourtant doublé les fenêtres de rideaux à molleton, mais refusé de mettre son piano à la cave, ainsi que le commissaire de police le lui avait suggéré en prenant pour exemple les cafés-chantants de la cité."
                            },
                            {
                                "example_id": "1b31ac3d-8855-4ba2-bf8e-6f07c8bc2590",
                                "sense_id": "99483e66-4bc6-3a9e-aab3-3d6f5857bf39",
                                "text": "Découpez votre molleton environ 5 cm plus large que votre coupon de tissu."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b093c61-d3b9-3863-a10f-a1323263d4d1",
                        "entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "glosses": [
                            "Calcaire en poudre (blanc de Meudon, craie, blanc d'Espagne…) malaxé dans l'huile, ce mélange sert à imiter la céruse."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "612e690f-322a-4d40-9eec-39cba8c9a3b4",
                                "sense_id": "2b093c61-d3b9-3863-a10f-a1323263d4d1",
                                "text": "En effet, c'est principalement avec le blanc d'Espagne, appelé aussi blanc de Bougival, blanc de Meudon, ou, en termes d'atelier, Molleton, que se falsifie la céruse."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c7202bb-a1be-38b9-8742-30f0e04a36db",
                        "entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "glosses": [
                            "Mollets"
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ac52841a-e000-49ec-b2f1-578b80c9e6e3",
                                "sense_id": "7c7202bb-a1be-38b9-8742-30f0e04a36db",
                                "text": "Quéque t'as, t'es patraque ma mistonne chérie ? Tu flageoles sur tes molletons !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15acdbc1-2bb1-4f04-9182-04928f8260bf",
                        "source_entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "target_lang_word": "Molton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b297f3-7555-398c-8fb8-8e03a89f8007",
                                        "entry_id": "6e4c4cc5-be12-38b5-898f-5da2b3bfbdea",
                                        "glosses": [
                                            "Die unter die Tischdecke gelegte Stoffdecke aus aufgerauter Baumwolle, die laute Geräusche beim Abstellen von Geschirr auf dem Tisch verhindert und die Tischdecke nicht verrutschen lässt."
                                        ],
                                        "tags": [
                                            "Textilindustrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070c2948-08c0-4ec0-bd6d-84f34e34b506",
                                                "sense_id": "e5b297f3-7555-398c-8fb8-8e03a89f8007",
                                                "text": "Mit Molton kann man gestalten, schützen, verdunkeln oder auch eine Schalldämpfung erreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae4633d3-e5a3-4019-bd29-75b5b34ecf0e",
                        "source_entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "target_lang_word": "melton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0890e811-b7ee-32aa-bb13-655d42f7eda5",
                                        "entry_id": "e8a07396-1c46-3955-a99c-3d6bb0777ae8",
                                        "glosses": [
                                            "A tough, short-napped material used for making overcoats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd2cb511-78b8-423e-9ce0-aad18c8691bc",
                                                "sense_id": "0890e811-b7ee-32aa-bb13-655d42f7eda5",
                                                "text": "‘Two of the boys are wearing your Melton overcoat; I hope you don't mind.’"
                                            },
                                            {
                                                "example_id": "a782ec6d-75d8-4513-8f2b-8fc5c13f7fe6",
                                                "sense_id": "0890e811-b7ee-32aa-bb13-655d42f7eda5",
                                                "text": "Skiwear has moved swiftly away from wool — and cotton — into a brave new world of chemistry. […] Wool pants or knickers, usually of melton — a thick, tightly woven, smooth fabric — were good for shedding snow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f72ac89-3c9a-459f-aa9f-12efb219851e",
                        "source_entry_id": "cdd4aeca-d268-3753-879f-4fc2e16f2830",
                        "target_lang_word": "fleece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "Hair or wool of a sheep or similar animal"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e9253e-b3ee-42da-bb99-decfadac3930",
                                                "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                                                "text": "The Sun ſhall change, the Moon to change ſhall ceaſe; / The Gaits to clim-----the Sheep to yield the Fleece, / Ere ought by me be either ſaid or done, / Shall do thee Wrang, I ſwear by all aboon."
                                            },
                                            {
                                                "example_id": "bb7b323c-ba99-40f7-8c08-9a855e580afd",
                                                "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                                                "text": "Wool became the substitute for money. […] In all the middle periods of British history, the fleece was the expression and the measure of national prosperity or calamity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e029ba-86b6-34c3-8e49-d0d4cad4ad01",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "Insulating skin with the wool attached"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5da2265d-bc0c-39dd-bbf6-a1dd5a2e4f74",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "A textile similar to velvet, but with a longer pile that gives it a softness and a higher sheen."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3e6a0d7-0e41-30f4-b994-24cbc9e1fc22",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "An insulating wooly jacket"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40f3f9ce-9c97-39ad-809a-490b6e18c1ea",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "Mat or felts composed of fibers, sometimes used as a membrane backer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "460ec2bf-e9dd-36ce-a3af-d1f5b71e1412",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "Any soft woolly covering resembling a fleece."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e29139-75cd-49b3-86a1-727a4fb1d7ac",
                                                "sense_id": "460ec2bf-e9dd-36ce-a3af-d1f5b71e1412",
                                                "text": "Alas! in the morning the eaglet was gone; and, full of sorrow, they stooped to pick up the shining fleece with which the floor was spread. At their touch, every feather became a golden coin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4e2a7e-3c20-3118-8893-a3cf4dc772ee",
                                        "entry_id": "e7ebff9b-2117-3ecc-a64f-72e50cc14520",
                                        "glosses": [
                                            "The fine web of cotton or wool removed by the doffing knife from the cylinder of a carding machine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fleece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53f21f36-621f-3a0b-96be-0f568f8b8ac4",
                                        "entry_id": "03d1c2fe-5a6b-3612-8927-1a351e9977f8",
                                        "glosses": [
                                            "To con or trick (someone) out of money."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
