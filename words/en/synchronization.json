{
    "word_family": [
        "synchronize",
        "synchronous",
        "synchrony",
        "asynchrony"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b85df6b9-0748-305d-b078-43b2a951a900",
                    "sense_definition": "The state or property of occurring at the same time or moving at the same speed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The generator went off line when it lost <w>synchronization</w> with the power line.",
                            "target_lang_translations": {
                                "zh": "当发电机与输电线失去<w>同步</w>时，它便停止了运行。"
                            }
                        },
                        {
                            "text": "The dancers practiced for hours to achieve perfect <w>synchronization</w> during their performance.",
                            "target_lang_translations": {
                                "zh": "舞者们练习了数小时，以在表演中达到完美的<w>同步</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "synchronicity",
                        "simultaneousness"
                    ],
                    "common_phrases": [
                        "perfect synchronization",
                        "loss of synchronization"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物在同一时间发生或以相同速度运行的状态或特性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同步",
                                "target_lang_sense_clarification": "指动作、时间或速度的一致性，最常用的对应词。"
                            },
                            {
                                "target_lang_word": "同步性",
                                "target_lang_sense_clarification": "强调作为一种属性或状态的同步。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97e7e45-d967-3aba-857f-9e9f2adcdfdb",
                    "sense_definition": "The strategic arrangement of military actions in time and space to maximize combat power.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The success of the mission depended on the precise <w>synchronization</w> of the ground and air forces.",
                            "target_lang_translations": {
                                "zh": "任务的成功取决于地面部队与空中部队的精确<w>协同</w>。"
                            }
                        },
                        {
                            "text": "Effective <w>synchronization</w> of artillery fire allowed the infantry to advance safely.",
                            "target_lang_translations": {
                                "zh": "炮火的有效<w>协同</w>使得步兵能够安全推进。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tactical synchronization"
                    ],
                    "target_lang_definitions": {
                        "zh": "在军事行动中，为了最大化战斗力而对时间和空间进行的战略性安排。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "协同",
                                "target_lang_sense_clarification": "军事语境下指各部队在时间和空间上的配合。"
                            },
                            {
                                "target_lang_word": "同步作战",
                                "target_lang_sense_clarification": "指在军事行动中实现各单位的同步配合。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}