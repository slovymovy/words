{
    "word_family": [
        "paranoia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                    "sense_definition": "Exhibiting excessive fear, suspicion, or distrust.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started to feel <w>paranoid</w> that her colleagues were talking about her behind her back.",
                            "target_lang_translations": {
                                "zh": "她开始感到<w>多疑</w>，觉得同事们在背后议论她。"
                            }
                        },
                        {
                            "text": "Don't be <w>paranoid</w> about the security cameras; they are just there for everyone's safety.",
                            "target_lang_translations": {
                                "zh": "别对监控摄像头<w>疑神疑鬼</w>的；它们只是为了大家的安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suspicious",
                        "distrustful",
                        "fearful",
                        "mistrustful"
                    ],
                    "antonyms": [
                        "trusting",
                        "confident"
                    ],
                    "common_phrases": [
                        "paranoid about",
                        "get paranoid",
                        "feel paranoid"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出过度的恐惧、怀疑或不信任。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多疑的",
                                "target_lang_sense_clarification": "形容人容易怀疑他人或事物。"
                            },
                            {
                                "target_lang_word": "疑神疑鬼的",
                                "target_lang_sense_clarification": "形容人非常多疑，常有不必要的担心。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "360b5826-627c-36ef-8f70-d487a1b29955",
                    "sense_definition": "Of, related to, or suffering from clinical paranoia.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clinical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with <w>paranoid</w> schizophrenia after reporting severe hallucinations.",
                            "target_lang_translations": {
                                "zh": "该患者在报告出现严重幻觉后，被诊断为<w>偏执</w>型精神分裂症。"
                            }
                        },
                        {
                            "text": "Doctors observed <w>paranoid</w> behavior in the subject during the psychological evaluation.",
                            "target_lang_translations": {
                                "zh": "医生在心理评估过程中观察到了受试者的<w>偏执</w>行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delusional"
                    ],
                    "antonyms": [
                        "sane",
                        "rational"
                    ],
                    "common_phrases": [
                        "paranoid schizophrenia",
                        "paranoid delusion",
                        "paranoid personality disorder"
                    ],
                    "target_lang_definitions": {
                        "zh": "属于、关于或患有临床偏执狂的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偏执的",
                                "target_lang_sense_clarification": "用于医学或心理学语境，指偏执型精神障碍。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d39ce8a1-01ba-3627-8ee2-8f2b232f1f1a",
                    "sense_definition": "A person suffering from paranoia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic specializes in treating <w>paranoids</w> and other patients with severe delusions.",
                            "target_lang_translations": {
                                "zh": "这家诊所专门治疗<w>偏执狂患者</w>以及其他患有严重妄想症的病人。"
                            }
                        },
                        {
                            "text": "He acted like a <w>paranoid</w>, constantly checking the locks on his doors.",
                            "target_lang_translations": {
                                "zh": "他表现得像个<w>偏执狂</w>，不停地检查门锁。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "患有偏执狂的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偏执狂患者",
                                "target_lang_sense_clarification": "指患有偏执型精神疾病的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}