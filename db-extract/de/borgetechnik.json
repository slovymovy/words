                "senses": [
                    {
                        "sense_id": "25158055-48a3-361f-91b8-0a2f5f0da516",
                        "entry_id": "434dfaf5-5f42-3ec3-a3d5-14446c9d5624",
                        "glosses": [
                            "Verfahren zum schriftlichen Subtrahieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523d3507-e1f8-481f-ae97-deaffb500e3a",
                                "sense_id": "25158055-48a3-361f-91b8-0a2f5f0da516",
                                "text": "„Die Bezeichnung »Borgetechnik« ist allerdings nicht ganz zutreffend; denn bei dieser Technik wird offenkundig nichts geborgt und später zurückgegeben, sondern es wird gewechselt oder entbündelt.“"
                            },
                            {
                                "example_id": "685d1277-a460-4850-aa55-29e5196a80a8",
                                "sense_id": "25158055-48a3-361f-91b8-0a2f5f0da516",
                                "text": "„Dabei gibt es drei verschiedene Techniken nämlich die Borgetechnik (Entbündeln), die Erweiterungstechnik und die Auffülltechnik.“"
                            },
                            {
                                "example_id": "6001cd49-ad9f-41b1-a75f-a1f3f355da63",
                                "sense_id": "25158055-48a3-361f-91b8-0a2f5f0da516",
                                "text": "„Die Borgetechnik – die Bezeichnung ist nicht ganz zutreffend, jedoch gebräuchlich […] – wird in der Regel mit dem Abziehverfahren kombiniert.“"
                            },
                            {
                                "example_id": "0552b1b4-7308-469c-b113-c30fe4cd69fd",
                                "sense_id": "25158055-48a3-361f-91b8-0a2f5f0da516",
                                "text": "„Entbündelungstechnik (auch Borgetechnik): Minuend wird entbündelt; danach Abzieh- oder Ergänzungsverfahren“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
