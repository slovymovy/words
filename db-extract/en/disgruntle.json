                        "entry_id": "fa89a8b3-42a8-3faa-ac79-c707789bbadb",
                        "glosses": [
                            "To make discontent or cross; to put in a bad temper."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9043886c-6f28-47bb-8d8d-f41c3ad3861d",
                                "sense_id": "6bdf0955-aa15-3a42-a142-5978c0521c30",
                                "text": "A pregnant woman who ordered pizza in Florida was stabbed 14 times by a delivery driver who police say was disgruntled over her $2 tip."
                            }
                        ]
                    }
                ],
