                "senses": [
                    {
                        "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                        "entry_id": "699ff481-e894-3a47-a384-77fcdb65efb4",
                        "glosses": [
                            "Aufzeichnung eines hörbaren Ereignisses (Musik, gesprochener Text, Naturgeräusch, …) und deren Ergebnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7013bcf9-4b96-4259-a4f9-e892470f38b4",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "„Unser großen Glück sind die wenigen Tonaufnahmen, die mit Johnson gemacht wurden.“"
                            },
                            {
                                "example_id": "0d9fb805-57af-4673-b600-17e3fc5e6cf9",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "Das Gespräch [zwischen Radovan Karadzic und Ratko Mladic] haben auch andere aufgezeichnet. Die Tonaufnahme und andere Beweise liegen dem Haager Kriegsverbrechertribunal vor."
                            },
                            {
                                "example_id": "4a217253-7e20-4d31-9369-5138d2a9ed16",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "Am späten Mittag standen Messner und Habeler auf dem höchsten Punkt der Erde, 8850 Meter hoch. Eine Umarmung, ein paar Fotos, eine Tonaufnahme, zu viel mehr waren beide nicht mehr fähig."
                            },
                            {
                                "example_id": "13b1324a-a3bf-418d-b616-ff909fed06f7",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "[New York Philharmonic Orchestra:] Fast 2.000 Tonaufnahmen – und bis 1999 13.000 Aufführungen: Das sind Zahlen, an die kein anderes Orchester der Welt herankommt."
                            },
                            {
                                "example_id": "0af52f43-5310-4dd7-a399-6636aa35f5f7",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "Allerdings konnten die Experten nicht alles entschlüsseln. Mit der Walze, auf der eine deutsche Stimme zu hören war, wendeten sie sich daher an den Berliner Restaurator Stephan Puille, einen international anerkannten Experten für Tonaufnahmen."
                            },
                            {
                                "example_id": "6da2617e-6063-46b3-9131-74086d844ed9",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "[…] veröffentlicht wurde nun eine Tonaufnahme, die von einer verdeckten Ermittlung der New Yorker Polizei von 2015 stammen soll."
                            },
                            {
                                "example_id": "e0fb63a4-b0a1-4706-af20-4ecda53b1fc9",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "Er [Stephen Manning] erwartet im Mai eine zweimonatige Haftstrafe. Angeblich hat er einen Richter im Saal beschimpft. Der Abschnitt der Tonaufnahme, die das beweisen soll, ist gelöscht. Warum? – darauf gibt die Justiz auf Nachfrage keine Antwort."
                            },
                            {
                                "example_id": "d02f9f1a-0c43-471c-b8fa-8980611b1f44",
                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                "text": "Richard Huelsenbeck liest aus seinen „Phantastischen Gebeten“. Zu Beginn des Ersten Weltkriegs entstanden, hielten sie der absurd gewordenen Welt den Spiegel vor. Die Tonaufnahme stammt aus den 50er-Jahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e76ee00-54f1-4c9a-aea2-8316a83eee14",
                        "source_entry_id": "699ff481-e894-3a47-a384-77fcdb65efb4",
                        "source_sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                        "target_lang_word": "recording",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recording",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0039a62b-bbab-31a3-a7ef-567353083510",
                                        "entry_id": "65c69e77-4211-3886-a0a6-91816a6e5490",
                                        "glosses": [
                                            "present participle and gerund of record"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0dca5d9-499c-4796-996b-bd945974e834",
                                                "sense_id": "0039a62b-bbab-31a3-a7ef-567353083510",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recording",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca97bf6-a0e9-3372-82d2-af9f5bb4281a",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "The act of storing sound, video, etc., in a permanent medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e94a0df-4512-470e-a92c-fe93eafb3776",
                                                "sense_id": "4ca97bf6-a0e9-3372-82d2-af9f5bb4281a",
                                                "text": "The one-party consent law permits the recording of telephone calls with the consent of at least one of the parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "A reproduction of sound, video, etc., stored in a permanent medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b249a2-5377-4521-8739-a20b714ffb05",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "I made a recording of the TV show so that I could watch it later."
                                            },
                                            {
                                                "example_id": "e14d1866-66c9-4175-aaaf-a2289fcb0755",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "But, she says, a wartime ban on recordings using shellac and vinyl kept the Walker version from being released."
                                            },
                                            {
                                                "example_id": "b7e9988d-3dff-4a22-909a-c2f1aa120746",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "The resulting integrated neurograms were then studied, and only the recordings with bursts that reached a signal:noise ratio of at least 3:1 were accepted for analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5bdfaa-5b1e-3539-ad4c-a1631eaf8c88",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "The act of registering for something; registration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
