                    {
                        "sense_id": "34407a96-0913-3afc-b2a2-c6ec0aa8f436",
                        "entry_id": "5380d1fe-7e5f-3ac7-9632-48403b2783ed",
                        "glosses": [
                            "A teacher or lecturer at some universities (in central Europe, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e7cd3df-5f31-40bb-a72e-8300e2e73cff",
                                "sense_id": "34407a96-0913-3afc-b2a2-c6ec0aa8f436",
                                "text": "Zermelo had been a docent at Göttingen when Kit was there and, like Russell, had been preoccupied with the set of all sets that are not members of themselves."
                            }
                        ]
                    },
                    {
                        "sense_id": "04e3cce8-6c39-3383-89cf-27b6d41b48c9",
                        "entry_id": "5380d1fe-7e5f-3ac7-9632-48403b2783ed",
                        "glosses": [
                            "A tour guide at a museum, art gallery, historical site, etc."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "7b739530-5177-4512-aa17-69a7affb7016",
                                "sense_id": "04e3cce8-6c39-3383-89cf-27b6d41b48c9",
                                "text": "The docent greeted the visitors and welcomed them to the Smithsonian."
                            },
                            {
                                "example_id": "742530b3-c58b-4746-914f-7328177ac815",
                                "sense_id": "04e3cce8-6c39-3383-89cf-27b6d41b48c9",
                                "text": "She was listening distractedly as an elderly docent intoned to a circle of listless children."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
