    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6b67c60-2c03-3330-8a59-a3b5ca191ab3",
                    "sense_definition": "uczyć się rzemiosła pod okiem mistrza",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nauka_zawodu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody chłopak musiał <w>terminować</w> u stolarza przez trzy lata, aby zdobyć odpowiednie kwalifikacje.",
                            "target_lang_translations": {
                                "ru": "Молодой парень должен был <w>обучаться ремеслу</w> у столяра три года, чтобы получить соответствующую квалификацию."
                            }
                        },
                        {
                            "text": "W dawnych czasach każdy uczeń musiał <w>terminować</w> u mistrza, zanim otworzył własny warsztat.",
                            "target_lang_translations": {
                                "ru": "В прежние времена каждый ученик должен был <w>проходить ученичество</w> у мастера, прежде чем открыть собственную мастерскую."
                            }
                        }
                    ],
                    "synonyms": [
                        "praktykować"
                    ],
                    "common_phrases": [
                        "terminować u mistrza"
                    ],
                    "target_lang_definitions": {
                        "ru": "обучаться ремеслу под руководством мастера"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучаться ремеслу",
                                "target_lang_sense_clarification": "процесс освоения профессии у наставника"
                            },
                            {
                                "target_lang_word": "проходить ученичество",
                                "target_lang_sense_clarification": "традиционный путь получения квалификации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf68cc07-ce5a-37d9-9abe-a816ba6d7c63",
                    "sense_definition": "zdobywać doświadczenie w jakimś zawodzie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nauka_zawodu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po studiach zaczął <w>terminować</w> w renomowanej kancelarii prawnej, aby poznać tajniki zawodu.",
                            "target_lang_translations": {
                                "ru": "После учебы он начал <w>стажироваться</w> в известной юридической фирме, чтобы познать секреты профессии."
                            }
                        },
                        {
                            "text": "Wielu młodych lekarzy musi <w>terminować</w> w szpitalach, zanim zaczną samodzielnie prowadzić pacjentów.",
                            "target_lang_translations": {
                                "ru": "Многие молодые врачи должны <w>проходить практику</w> в больницах, прежде чем начнут самостоятельно вести пациентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "przyuczać się",
                        "praktykować"
                    ],
                    "target_lang_definitions": {
                        "ru": "получать профессиональный опыт, стажироваться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стажироваться",
                                "target_lang_sense_clarification": "получение практического опыта в организации"
                            },
                            {
                                "target_lang_word": "проходить практику",
                                "target_lang_sense_clarification": "обучение через выполнение профессиональных задач"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a0ede5-f254-3212-a7ef-afa28b29e18e",
                    "sense_definition": "kończyć coś, przerywać działanie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zarząd zdecydował się <w>terminować</w> umowę z dostawcą ze względu na liczne opóźnienia.",
                            "target_lang_translations": {
                                "ru": "Руководство решило <w>расторгнуть</w> договор с поставщиком из-за многочисленных задержек."
                            }
                        },
                        {
                            "text": "Nie można tak po prostu <w>terminować</w> projektu bez wcześniejszego powiadomienia zespołu.",
                            "target_lang_translations": {
                                "ru": "Нельзя просто так <w>прекращать</w> проект без предварительного уведомления команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrywać",
                        "kończyć"
                    ],
                    "antonyms": [
                        "rozpoczynać"
                    ],
                    "common_phrases": [
                        "terminować umowę"
                    ],
                    "target_lang_definitions": {
                        "ru": "завершать, прекращать действие чего-либо (обычно договора или процесса)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расторгать",
                                "target_lang_sense_clarification": "официальное прекращение действия договора"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "остановка выполнения какого-либо процесса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}