                "senses": [
                    {
                        "sense_id": "294dcdf5-6a85-3f1f-955b-ec9908340efd",
                        "entry_id": "cbc93ab4-a743-33ec-81b9-8453d7772ced",
                        "glosses": [
                            "Arzneimittel zur örtlichen Betäubung (Lokalanästhesie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9acd288-02dc-4567-9f5f-273dea8ccfc4",
                                "sense_id": "294dcdf5-6a85-3f1f-955b-ec9908340efd",
                                "text": "Schon kurze Zeit nach der ersten erfolgreichen Lokalanästhesie im Jahr 1884 wurde auf dramatische Weise klar, dass das verwendete Kokain bei weitem nicht den Ansprüchen an ein „ideales“ Lokalanästhetikum gerecht wurde."
                            },
                            {
                                "example_id": "4a70c304-6bf5-49d1-ba6f-ec6c89c5c14e",
                                "sense_id": "294dcdf5-6a85-3f1f-955b-ec9908340efd",
                                "text": "Levobupivacain ist das linksdrehende Enantiomer des lang wirksamen Amid-Lokalanästhetikums Bupivacain."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee4fdf6f-e603-4b4d-8972-f91db6ef1b2d",
                        "source_entry_id": "cbc93ab4-a743-33ec-81b9-8453d7772ced",
                        "source_sense_id": "294dcdf5-6a85-3f1f-955b-ec9908340efd",
                        "source_sense_description": "Medizin, Pharmazie: Arzneimittel zur örtlichen Betäubung (Lokalanästhesie)",
                        "target_lang_word": "local anesthetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "local anesthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebdb2c6e-90f2-3864-952e-608a9746f25a",
                                        "entry_id": "d79fa875-5ca2-382b-9558-1213cdd5e739",
                                        "glosses": [
                                            "An anesthetic (anesthetic substance) that causes loss of sensation only to the area to which it is applied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02904e25-6bf9-4568-a707-ce8e816abbd4",
                                                "sense_id": "ebdb2c6e-90f2-3864-952e-608a9746f25a",
                                                "text": "He used a local anaesthetic called something or other \"snow,\" which froze the tissue and avoided pain until the probe, the scalpel or the forceps got below the frozen portion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "135d88be-e960-4249-aa37-68b00bb1f9bb",
                        "source_entry_id": "cbc93ab4-a743-33ec-81b9-8453d7772ced",
                        "source_sense_id": "294dcdf5-6a85-3f1f-955b-ec9908340efd",
                        "source_sense_description": "Medizin, Pharmazie: Arzneimittel zur örtlichen Betäubung (Lokalanästhesie)",
                        "target_lang_word": "anesthésique local",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anesthésique local",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86d58367-e399-38e3-84b5-a72413954bdc",
                                        "entry_id": "3952d07a-fa5e-3c3f-893f-7a31f4a7316f",
                                        "glosses": [
                                            "Anesthésique dont l’action ne s’applique qu’à une partie de l’organisme et ne cause généralement pas la perte de connaissance."
                                        ],
                                        "tags": [
                                            "Pharmacie",
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469b3fc3-bb93-4e57-a9ae-7ff0987b47c2",
                                                "sense_id": "86d58367-e399-38e3-84b5-a72413954bdc",
                                                "text": "On peut obtenir un degré d’insensibilité locale assez grand à l’aide de la compression des membres ou des nerfs de la région où l’on opère. Malheureusement cette manœuvre ancienne n’est pas toujours facile et elle à été abandonnée. L’électricité proposée comme un anesthésique local, n’a pas cette vertu; la douleur légère due à l’électrisation masque un peu la douleur de l’opération et c’est là tout."
                                            },
                                            {
                                                "example_id": "a83a4686-160f-4aca-b78a-88e7dfe36ed1",
                                                "sense_id": "86d58367-e399-38e3-84b5-a72413954bdc",
                                                "text": "Les anesthésiques sont des médicaments qui rendent l’animal insensible à la douleur. Les anesthésiques généraux rendent l’animal inconscient. Les techniciens expérimentés les utilisent quand ils doivent faire des opérations compliquées. En revanche, les anesthésiques locaux, n’ont un effet que sur la partie du corps qui se trouve à côté de l’endroit où ils ont été appliqués ou injectés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
