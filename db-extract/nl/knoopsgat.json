                            },
                            {
                                "target_word": "buttonhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c346a994-63da-3df8-9b63-73635ad55892",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To detain (a person) in conversation against their will."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6d5ab91-6425-42bd-a42d-c5bbcae8030b",
                                                "sense_id": "c346a994-63da-3df8-9b63-73635ad55892",
                                                "text": "He backed Mr. Lykins against an iron fence, buttonholed him, fastened him with his eye, like the ancient mariner, and proceeded to unfold his narrative as placidly and peacefully as if we were all stretched comfortably in a blossomy summer meadow instead of being persecuted by a wintry midnight tempest: […]"
                                            },
                                            {
                                                "example_id": "86bde340-7f52-40ae-8ecc-66c5da1cfc0e",
                                                "sense_id": "c346a994-63da-3df8-9b63-73635ad55892",
                                                "text": "Hiro and Chuck grab the closest thing they can find to a corner table. Hiro buttonholes a waiter and surreptitiously orders a pitcher of Pub Special, mixed half and half with nonalcoholic beer."
                                            },
                                            {
                                                "example_id": "dfb5ce03-4a6b-4f9b-b553-2b729f2aa130",
                                                "sense_id": "c346a994-63da-3df8-9b63-73635ad55892",
                                                "text": "He buttonholed people on the street and related details of his child’s miraculous progress without even prefacing his remarks with the hypocritical but polite: “I know everyone thinks their own child is smart but—”"
                                            },
                                            {
                                                "example_id": "f2f0e757-cb97-4ae0-962b-fec0d60c5ae0",
                                                "sense_id": "c346a994-63da-3df8-9b63-73635ad55892",
                                                "text": "Here they are, the brainless few we had been raised to pity and fear, the Stone Age oafs and the seething runts and the ominous, swaggering weightlifters, buttonholing kids like me out on Chancellor Avenue and telling us to keep our baseball bats at the ready in case we were called in the night to take to the streets [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4441cbf5-6331-3638-95dd-8425a1c3aece",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To cut one or more buttonholes (in)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fdc51a5-ff33-3b9d-9814-473606297a10",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To sew by buttonhole stitch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e71e47e-6a3c-3769-b365-a220ff69487e",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To make a small slot-like incision in (intentionally or unintentionally)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4539e0c-43d3-38ba-9752-cddb945db570",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To apply a flowery formation in."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f654453-1ff5-49ec-81e0-9f0fd6fe8013",
                                                "sense_id": "c4539e0c-43d3-38ba-9752-cddb945db570",
                                                "text": "What tree of more pulchritude and symmetricalness could you nominate for roadside, street and public park planting than the graceful linden? We should possess more of the spirit which predominates in this direction in the crowning gem of America’s constitutionality—the City of Washington, D. C. ‘‘Unter den Lindens’’ would not only be found in Germany, but in all the large cities of our grand and glorious United States. Washington has her Unter den Linden in the Massachussetts^([sic]) avenue. Her North and South Capital streets are buttonholed with the stately tulips, which are fit emblems to thus adorn the meridian of the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f7ab40-460a-32a7-ac9e-6fa168e47e72",
                                        "entry_id": "214ded16-d9cc-3afb-abc7-59e0f20f0463",
                                        "glosses": [
                                            "To attain buttonhole-like formations on cutting."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da336f63-deb6-477a-844f-8cdb2bc6fc53",
                                                "sense_id": "26f7ab40-460a-32a7-ac9e-6fa168e47e72",
                                                "text": "Furze cut it himself after his dinner, with great care and concentrated solemnity, finding the loaf rather too new and the knife too blunt for the carving of slices of ideal thinness. The beastly things would buttonhole!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc008fcc-388d-4fe0-a45b-a291bd1bc2fa",
                        "source_entry_id": "4c98f030-3ae5-3b85-bf3d-593b4afd6cc7",
                        "source_sense_id": "a990c1fb-4b6f-3247-9818-7a06fea39ddc",
                        "source_sense_description": "spleet die in een stuk stof is gemaakt zodat een ander stuk stof daaraan kan worden vastgemaakt",
                        "target_lang_word": "boutonnière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boutonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Petite fente faite à un vêtement pour y passer un bouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c740e9d7-9582-4793-b52c-c31e3fe55bb8",
                                                "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                                "text": "Tartous Hama, en smoking d’ottoman blanc, une rose desséchée à sa boutonnière, pieds et poings liés, le visage convulsé et bleu, les yeux exorbités."
                                            },
                                            {
                                                "example_id": "a43b62db-cd14-44be-9bc9-020c201e2899",
                                                "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                                "text": "Orlando se tenait devant son miroir, cherchant à tâtons les boutonnières de sa chemise. Encore une fois, les perles venaient de lui glisser des doigts et étaient tombées par terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Petite fente sur le col gauche d'un costume par laquelle on attache les décorations civiles ou militaires, une fleur ou un bijou."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc512c03-53ea-471e-85f4-5d990859eeda",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les mâles éclairs de ses yeux bleus, la bravoure inscrite dans les rides de ses joues flétries, annonçaient qu'il avait acheté par de rudes travaux le ruban rouge qui fleurissait la boutonnière de son habit."
                                            },
                                            {
                                                "example_id": "4c042cbc-e297-4e99-88f9-d95084af4aa2",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les Palmes académiques, dont le Quatorze Juillet va fleurir tant de boutonnières, m'ont laissé toute une suite d'impressions désastreuses."
                                            },
                                            {
                                                "example_id": "70ce5761-5857-4e2e-a98c-a947aab6f4eb",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les vieux ramollots du temps jadis, ces vétérans des guerres d'Italie et de Crimée qui promenaient leurs redingotes sanglées à la taille et épinglées de rouge à la boutonnière sous les ombrages du Champ-de-Juillet en regardant manœuvrer les jeunes recrues, […]."
                                            },
                                            {
                                                "example_id": "c5439653-43af-44ac-b0b5-4da2c7d54da5",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "[…]; une véritable épidémie de petits drapeaux et d’insignes pour boutonnières s’abattit sur les torrents de jeunesse laborieuse et pressée […]. Il était dangereux de ne pas avoir d’insignes patriotiques au revers de l’habit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3b2bbe-9a5e-3fcf-8723-2cfcea2a4fba",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Incision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Dépression creusée par érosion dans l'axe d'un anticlinal. Ce sont deux cuestas qui se font face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99c6e0e-c373-45e7-a027-3b3920912633",
                                                "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                                "text": "Les goûts de ma mère étaient plus futiles. Elle mourait d’envie d’aller voir un puits artésien dans la région du Nord et cette fameuse boutonnière du pays de Bray qui lui suggérait cette idée amusante : peut-être que dame Nature avait besoin, comme tout le monde, de coutures et de boutons pour ajuster sa verte parure de prairies et de guérets ?"
                                            },
                                            {
                                                "example_id": "d991e460-b397-4c69-9ff5-5e702da92991",
                                                "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                                "text": "Auneuil est un village situé sur le rebord sud de la boutonnière du pays de Bray, où la structure géologique a permis l’affleurement de couches d’argile de grande qualité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boutonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                        "entry_id": "abc30132-6426-3f1c-ac6b-32ec492d3e17",
                                        "glosses": [
                                            "Artisane ou ouvrière qui fait des boutons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a872b2f6-e165-4f1f-8c05-0eacadfd0295",
                                                "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                                "text": "Les femmes sont également cirières et employées aux diverses manipulations qui aboutissent à la fabrication de cire à cacheter, boutonnières, employées à la vente des bouchons, émailleuses et ouvrières pour perles fausses ; l’industrie des fleurs artificielles en occupe un très grand nombre."
                                            },
                                            {
                                                "example_id": "5d081da5-449e-4234-a7fc-40cfa8789b02",
                                                "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                                "text": "À en juger par l’état de ses finances à la fin de sa vie, la veuve Mangin n’avait pas connu un grand succès en tant que maîtresse passementière et boutonnière, même si elle vivait encore dans son propre logement à sa mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
