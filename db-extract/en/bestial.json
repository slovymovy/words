    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4ab4e6f0-982c-3450-bd38-c51f4fb8ed2d",
                "word": "bestial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c027c07e-0bef-48b1-be00-4fb547bcb8d2",
                        "entry_id": "4ab4e6f0-982c-3450-bd38-c51f4fb8ed2d",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more bestial"
                    },
                    {
                        "form_id": "0f18571c-0546-4438-a0c4-c39d8a4173ee",
                        "entry_id": "4ab4e6f0-982c-3450-bd38-c51f4fb8ed2d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most bestial"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                        "entry_id": "4ab4e6f0-982c-3450-bd38-c51f4fb8ed2d",
                        "glosses": [
                            "Beast-like"
                        ],
                        "tags": [
                            "figuratively",
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "60047da5-8fc5-4833-8893-c0963ed4ab41",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "Reputation, reputation, reputation! O, I have lost my reputation! I have lost the immortal part of myself, and what remains is bestial."
                            },
                            {
                                "example_id": "aed05469-54c6-4060-93c2-58f6e56a901b",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "By thee adulterous lust was driven from men /\nAmong the bestial herds to range […]"
                            },
                            {
                                "example_id": "79d71f9e-867b-4c03-85b7-beb1ce4a6a12",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "This familiar that I called out of my own soul, and sent forth alone to do his good pleasure, was a being inherently malign and villainous; his every act and thought centered on self; drinking pleasure with bestial avidity from any degree of torture to another; relentless like a man of stone."
                            },
                            {
                                "example_id": "5c2e3f9b-116a-4f38-8bda-e984f167855b",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "His was a bestial face, a face that bore the stamp of Nature's eternal injustice."
                            },
                            {
                                "example_id": "c6a261f2-cafd-4c29-b28a-a10161d5345a",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "Ah, if the invincible forest god of that dead past were but with them now. No longer would there be aught to fear from prowling beasts, or from the bestial Russian."
                            },
                            {
                                "example_id": "9446e8fe-ddc2-40e8-ab47-cc8936127f5d",
                                "sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                                "text": "The Game of Thrones novels were best sellers without fleshed-out Dothraki; the languages in Star Wars, one of the most successful franchises ever, are mostly gibberish, even if Han Solo claims to understand Chewbacca’s bestial warbling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "195d5c23-e883-4156-ba1e-4b65aba70682",
                        "source_entry_id": "4ab4e6f0-982c-3450-bd38-c51f4fb8ed2d",
                        "source_sense_id": "aacd09aa-af4b-3b54-b3f8-792e72d80d7b",
                        "source_sense_description": "beast-like",
                        "target_lang_word": "tierisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tierisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                        "entry_id": "9d742874-e09e-3b73-b160-30574f7a0c65",
                                        "glosses": [
                                            "in der Art und Weise eines Tieres, sich auf ein Tier beziehend, zu einem Tier gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4a207c-c8c4-4889-b1a3-b8840e142cfe",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "Veganer meiden jegliche tierische Produkte, d.h. nicht nur Fleisch, sondern auch Milch, Eier, Leder und Honig."
                                            },
                                            {
                                                "example_id": "8e9ba824-9d10-484e-9375-c86fd493ae71",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "adverbial: Im Zoo geht es tierisch zu."
                                            },
                                            {
                                                "example_id": "d784701b-2dee-4708-8bf3-dc3330da8fbb",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "„Die Verfütterung von ehemaligen Lebensmitteln tierischer Herkunft an Nutztiere ist verboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tierisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                        "entry_id": "c2a6d1c4-fdb6-3a79-ab72-f757ba8f3b21",
                                        "glosses": [
                                            "sehr, arg"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c738e829-dd77-44e9-afa8-3d8dcb845424",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Er ist heute tierisch gut drauf."
                                            },
                                            {
                                                "example_id": "44f848d6-eadb-4528-b2a8-f29256930ced",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Bei solch einer Hitze begann sie tierisch an zu schwitzen."
                                            },
                                            {
                                                "example_id": "ddc564c0-7f35-4f44-898c-ab49d998cd16",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Ranzige Butter stinkt tierisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
