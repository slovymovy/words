                "senses": [
                    {
                        "sense_id": "50e42bb0-dc12-3689-bd51-dfb03fd98841",
                        "entry_id": "aef447a1-a46d-34d2-b492-2156d4a4824b",
                        "glosses": [
                            "Affluent du Pô."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8ce80d04-c65d-3e8c-a5e2-7ebf89f4afb0",
                        "entry_id": "aef447a1-a46d-34d2-b492-2156d4a4824b",
                        "glosses": [
                            "Canton du sud de la Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0439a5-1617-42ec-ac95-523690bfbe3e",
                                "sense_id": "8ce80d04-c65d-3e8c-a5e2-7ebf89f4afb0",
                                "text": "L’aire des dialectes lombards a pour cœur l’ancien duché de Milan, fondé au XIVᵉ siècle. Elle inclut, à l’est, Bergame et Brescia (vénitiennes du XVᵉ au XVIIIᵉ siècle), au nord, le Tessin (conquis par les Suisses au début du XVIᵉ siècle), à l’ouest, Novare (rattachée au Piémont au XVIIIᵉ siècle)."
                            },
                            {
                                "example_id": "1d22d974-e687-4b5d-b722-f9aa45e70d6e",
                                "sense_id": "8ce80d04-c65d-3e8c-a5e2-7ebf89f4afb0",
                                "text": "De sa gaieté, il ressortit que le Tessin était le plus bel endroit du monde, qu’un mètre dix de neige était tombé en vingt-quatre heures, qu’on aurait du mal à basculer sur l’Engadine et qu’un virus pulmonaire se répandait dans la vallée, d’origine probablement chinoise et dont ici, en altitude, on n’avait rien à craindre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5de2e547-48eb-446b-96f2-7510c1bf753d",
                        "source_entry_id": "aef447a1-a46d-34d2-b492-2156d4a4824b",
                        "source_sense_description": "Rivière",
                        "target_lang_word": "Tessin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tessin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                        "entry_id": "767ba037-c844-3ad5-ba24-2322125a0d7e",
                                        "glosses": [
                                            "italienischsprachiger Kanton der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337fc1bd-9ccf-4a16-8887-ecf748ed91c3",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "Der Kanton Tessin liegt im Süden der Schweiz."
                                            },
                                            {
                                                "example_id": "e5e12fb8-a5c1-403e-bb33-d798e9db7a7e",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "Wir besuchen bald Tante Ursina im Tessin."
                                            },
                                            {
                                                "example_id": "103c3296-036e-4229-896c-65cc4865def1",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "„FDP-Kantonalpräsident Walter Gianora betont, die guten politischen Kräfte sollten hinter Carobbio stehen, denn dies geschehe im Interesse des ganzen Tessins […]“."
                                            },
                                            {
                                                "example_id": "53815e77-f3eb-4d56-8a6b-4fb7b2b20ef4",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "„Im Tessin hat FDP-Parteipräsident Fulvio Pelli hat die Wiederwahl in den Nationalrat knapp geschafft.“"
                                            },
                                            {
                                                "example_id": "ce96a627-183c-4e46-98b4-f430fec4b63e",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "„Man neigt dazu, im Tessin vor lauter Romanik und Barock die Renaissance zu übersehen.“"
                                            },
                                            {
                                                "example_id": "a392745d-f0cd-4339-97c0-54a50afa8bed",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "„Der einzige Kanton, der das Phänomen mittels einer Befragung zu quantifizieren versucht hat, ist das Tessin.“"
                                            },
                                            {
                                                "example_id": "c113f81d-2d0e-4009-a201-97ea5b2fabc0",
                                                "sense_id": "5635f86c-e582-352f-ac40-7c755a1a7892",
                                                "text": "„Es fällt einem schwer zu glauben, dass sich bloss einen Steinwurf von der Ausfahrt Chiasso entfernt eine der schönsten Naturlandschaften des Tessins erstreckt, die Gole della Breggia.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tessin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec17374-1f2e-3f7a-a9a5-1f0107295ead",
                                        "entry_id": "d4e075b5-76e7-3d65-8865-059702e95b19",
                                        "glosses": [
                                            "linker Nebenfluss des Po, der von der Schweiz nach Norditalien fließt und dabei den Lago Maggiore durchquert"
                                        ],
                                        "tags": [],
                                        "examples": [
