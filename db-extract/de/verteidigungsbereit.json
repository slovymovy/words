                ],
                "senses": [
                    {
                        "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                        "entry_id": "4ffa7f2e-9165-3072-aac2-04c05022315c",
                        "glosses": [
                            "fähig und willens, einen militärischen Angriff auf etwas (beispielsweise ein Land, eine Stadt, eine Burg) mit Waffen abzuwehren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b6bd7d-9083-4e89-84c5-59d19407cde9",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Schlagzeile:] „Taiwan bedingt verteidigungsbereit“"
                            },
                            {
                                "example_id": "bc3659af-7c25-4043-a316-23d40308b7b7",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Zweiter Weltkrieg:] „Die polnische Armee war vom deutschen Angriff nicht überrascht worden. Er traf sie aber noch im Aufmarsch und deshalb nicht ganz verteidigungsbereit.“"
                            },
                            {
                                "example_id": "793d3def-4f4d-4eb8-a517-afdb981f8285",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Erster Weltkrieg: Fort Vaux/Verdun] „Um dem erwarteten Angriff zu begegnen, hatte es von Pétain aber eine starke, verteidigungsbereite Besatzung bekommen. Der Angriff gegen Fort Vaux geriet zu einem blutigen Gemetzel,“ […]."
                            },
                            {
                                "example_id": "d4dd4c25-8e1e-40dc-9989-b6063e08f0e8",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "„Ziel der städtischen Politik war offensichtlich die Errichtung einer wehrhaften und verteidigungsbereiten Gemeinschaft“ […]."
                            },
                            {
                                "example_id": "b5b656f9-58be-49bd-b65f-2d2deb919549",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "„Deutschland muss sich endlich ehrlich machen, und wieder in seine Bundeswehr investieren. Auch wenn bisher viele mit einer nur bedingt verteidigungsbereiten Armee in Deutschland leben konnten.“"
                            },
                            {
                                "example_id": "93f7b6e9-0278-4c6d-8066-8dc4c3465c21",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "„Obwohl noch verteidigungsbereite Truppen in Südtaiwan standen, musste man am 21. Oktober kapitulieren und die Geschichte der Republik war nach 184 Tagen beendet.“"
                            },
                            {
                                "example_id": "da681a07-97c7-4c45-88e5-fafcd3865239",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Kesselschlacht:] „Ein Angriff auf die Flanken ist für die unter solchen Gegebenheiten Angegriffenen zumeist deshalb fatal, da er auf rückwärtige, wenig verteidigungsbereite Truppenteile trifft.“"
                            },
                            {
                                "example_id": "c6a545df-b686-45c9-8a16-2fdda481c58f",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "„Am 18. März 1871 versuchte der französische Premierminister Adolphe Thiers, die verteidigungsbereite Nationalgarde von Paris entwaffnen zu lassen.“"
                            },
                            {
                                "example_id": "4db7317b-2052-40b6-8ea7-02891eef7841",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Dwight D. Eisenhower:] „In den Folgejahren wollte er dann neue Verbände aufstellen und ausbilden, um mittelfristig eine verteidigungsbereite Streitmacht kommandieren zu können.“"
                            },
                            {
                                "example_id": "7dd1eac0-f182-4160-a2e4-72cd18d3a2b4",
                                "sense_id": "b19be0b6-6ba4-3e8f-8470-1f890fd3e6ad",
                                "text": "[Der Prozess gegen Adolf Eichmann sollte] „zu einer Art zweiter, symbolischer Gründung Israels als eines starken, verteidigungsbereiten Staates werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                        "entry_id": "4ffa7f2e-9165-3072-aac2-04c05022315c",
                        "glosses": [
                            "fähig und willens, sich selbst, die Brut, das Rudel oder das Revier zu verteidigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69758e8b-20ae-4d17-808a-430d364d6e26",
                                "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                                "text": "[Honigbiene:] „Ein ruhiger Summton und langsames Herumfliegen von Blüte zu Blüte signalisiert „gute Laune“ bei der Biene, ein hochfrequentes, „schrilles“ Summen sowie nervöses Zickzackfliegen zeigt eine misstrauische und verteidigungsbereite Biene.“"
                            },
                            {
                                "example_id": "00f540d0-0c4d-4b21-bbc4-806397e93a63",
                                "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                                "text": "„Die Inseln waren stets auch für Piraten Proviantquelle, sodass die Bauern einen wachsamen und verteidigungsbereiten Hund schätzten, um ihr Hab und Gut zu schützen.“"
                            },
                            {
                                "example_id": "00c6ae09-c199-40b4-9705-bd67c8848894",
                                "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                                "text": "[Kuvasz/Hütehund:] „Doch hinter der ruhigen Fassade wacht ein äußerst wehrhafter und verteidigungsbereiter Kämpfer.“"
                            },
                            {
                                "example_id": "84035b3c-6b16-4fe6-8b3f-93af81b2a406",
                                "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                                "text": "„Ängstliche Hunde reagieren im Allgemeinen schneller aggressiv, sind verteidigungsbereiter und beißen aus Angst schneller zu als sozial sichere Tiere.“"
                            },
                            {
                                "example_id": "d96cc642-8e9d-48cc-924a-df644e9404a0",
                                "sense_id": "80c2918a-cb63-3e6b-90fb-43cffe2a3dbe",
                                "text": "„Aber es gibt auch die Fälle, in denen Herrchen wahnsinnig stolz ist, dass Bello keine Memme ist und den allzeit verteidigungsbereiten Leibwächter heraushängen lässt. Auch das merkt der Hund.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
