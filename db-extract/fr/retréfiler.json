                "senses": [
                    {
                        "sense_id": "18f62542-4933-31a8-bd91-8d2b441ae868",
                        "entry_id": "c72294d4-4cf1-368a-a30b-5d699ee2d883",
                        "glosses": [
                            "Tréfiler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71324b2e-78f5-4a77-81a4-7ca6da97a993",
                                "sense_id": "18f62542-4933-31a8-bd91-8d2b441ae868",
                                "text": "Jusqu'en 1824, cette usine ne faisait que retréfiler des fils ébauchés à l'étranger."
                            },
                            {
                                "example_id": "7f23eba7-fbe8-4681-be0e-114ec4a86e98",
                                "sense_id": "18f62542-4933-31a8-bd91-8d2b441ae868",
                                "text": "A partir de ce moment, les affaires de la maison prirent une grande importance ; mais ce n'est que vers 1824, que Pierre Mouchel.au lieu de retréfiler simplement les fils achetés en Normandie, en Allemagne et en Suède, installa des fonderies et des laminoirs pour fabriquer de toutes pièces le laiton, dont il avait besoin."
                            }
                        ]
                    }
