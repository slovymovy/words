                "senses": [
                    {
                        "sense_id": "60a8f42e-0d9d-3fe5-ae76-0d00f71b913c",
                        "entry_id": "f0fa1323-7568-3ccd-a0ad-933793459c5e",
                        "glosses": [
                            "im Meer beheimatetes Tier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971ff208-f9b4-4b7a-87dc-7ae2a94fa6b3",
                                "sense_id": "60a8f42e-0d9d-3fe5-ae76-0d00f71b913c",
                                "text": "„Auf den Ozeanen der Erde reisen unzählige Meerestiere als blinde Passagiere von Schiffen mit.“"
                            },
                            {
                                "example_id": "7e10d09b-c933-4bbe-a37a-983475c2418c",
                                "sense_id": "60a8f42e-0d9d-3fe5-ae76-0d00f71b913c",
                                "text": "„Auf diese Weise schufen sie bei Flut überspülte Terrassen, die Lebensraum für Muscheln und andere Meerestiere boten.“"
                            },
                            {
                                "example_id": "18d07caa-114c-4903-94c5-706773968daf",
                                "sense_id": "60a8f42e-0d9d-3fe5-ae76-0d00f71b913c",
                                "text": "„Einige Schriftzeichen stellten offensichtlich Meerestiere dar, die der heutigen Welt nicht bekannt sind, deren verwesende Leiber ich aber auf der aus dem Meer erstandenen Oberfläche gesehen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
