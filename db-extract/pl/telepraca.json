                                        "entry_id": "aeb26410-5d97-3878-b02f-07eac508cb2d",
                                        "glosses": [
                                            "The practice of using telecommunications technology to do one's work at a location remote from one's office, such as one's home, an Internet café, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
