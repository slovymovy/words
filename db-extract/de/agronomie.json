                        "cross_references": [
                            {
                                "target_word": "agronomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4afd0848-ea9d-3834-be6d-f38a776d86ee",
                                        "entry_id": "a4dbddc3-b550-302a-b457-77c1f0fb9e1f",
                                        "glosses": [
                                            "The science of utilizing plants, animals and soils for food, fuel, feed, and fiber and more. To do this effectively and sustainably, agronomy encompasses work in the areas of plant genetics, plant physiology, meteorology, animal sciences and soil science."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f574de-dbb3-4383-b70e-7f9e18f8efa3",
                                                "sense_id": "4afd0848-ea9d-3834-be6d-f38a776d86ee",
                                                "text": "Near-synonym: husbandry"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "471f6cc0-588c-4d2d-ba63-a08cdc406d1a",
                        "source_entry_id": "131a2b68-1e13-3e70-ad39-b3512c0c4815",
                        "source_sense_id": "9a9507b3-d5fb-3d9e-8696-cbd44383dd64",
                        "source_sense_description": "wissenschaftliche Forschung über Ackerbau",
                        "target_lang_word": "agronomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agronomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9441728a-02df-3b8d-8559-1924c768056a",
                                        "entry_id": "4c319569-72e7-38c7-a7eb-c4255b86b146",
                                        "glosses": [
                                            "Science de l’agriculture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5360945a-e12c-4b4b-af89-ad71776099f7",
                                                "sense_id": "9441728a-02df-3b8d-8559-1924c768056a",
                                                "text": "Celui qui se dirige d'après les lois de l’agronomie, c'est l’agriculteur ; celui qui exécute matériellement les principes de l’agriculture, c'est le cultivateur."
                                            },
                                            {
                                                "example_id": "0b89047c-59ef-432c-802f-4fef7f51d698",
                                                "sense_id": "9441728a-02df-3b8d-8559-1924c768056a",
                                                "text": "Seulement, la vie de la plante, considérée relativement à la production utilisable, ne forme pas l'objet de la botanique, mais bien de l’agronomie."
                                            },
                                            {
                                                "example_id": "22d959d7-6095-49a2-a0a3-46b33656c6bf",
                                                "sense_id": "9441728a-02df-3b8d-8559-1924c768056a",
                                                "text": "L'héritière médiévale, malgré la fidélité aux sources antiques dont elle se réclame, malgré une connaissance minutieuse des agronomies orientale et byzantine contemporaines, s'avère plus expérimentale et libre de superstitions."
                                            },
                                            {
                                                "example_id": "5e5a61fa-23ab-47dd-a8dd-b6a0ae282778",
                                                "sense_id": "9441728a-02df-3b8d-8559-1924c768056a",
                                                "text": "A trente ans, Claudia, titulaire d'une double maîtrise d’herboristerie et d’agronomie, travaille comme consultante pour une entreprise d’agroalimentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
