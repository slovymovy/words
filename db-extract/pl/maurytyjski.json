                "translations": [
                    {
                        "translation_id": "2f28ba5f-5124-4d4b-953a-b0d99d0e941a",
                        "source_entry_id": "245f19f6-c706-3223-ab5b-6121a41c34a1",
                        "source_sense_id": "6f0c91a3-86b2-367c-b8de-b981d56c6d83",
                        "target_lang_word": "Mauritian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mauritian",
