                ],
                "senses": [
                    {
                        "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                        "entry_id": "61382894-bb24-303a-bef4-67b4f24b9338",
                        "glosses": [
                            "Herstellung (Produktion) von mehr Gütern als geplant/benötigt/sinnvoll/verwendbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3bd6da-9047-4ed5-bf44-2c523916d1fd",
                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                "text": "Die frühere Unterversorgung der Bevölkerung wurde durch eine hohe Überproduktion bei wichtigen Agrargütern abgelöst."
                            },
                            {
                                "example_id": "44797dbf-713c-4804-af10-024cd826965f",
                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                "text": "„Im Gegensatz dazu hilft ein Pull-System, ungeplante Überproduktionen zu verhindern, indem die Arbeit nur dann vorwärtsbewegt wird, wenn der nächste Arbeitsbereich bereit ist, sie zu empfangen.“"
                            },
                            {
                                "example_id": "f78797ee-a2b8-45b3-b2ac-502eb2d63e81",
                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                "text": "„Gute Ernten, bedingt durch ein Klimaoptimum, hatten in dieser Zeit eine Überproduktion von Nahrungsmitteln möglich gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11f911ca-7cf0-388e-80f3-f5ab38a138d8",
                        "entry_id": "61382894-bb24-303a-bef4-67b4f24b9338",
                        "glosses": [
                            "Herstellung einer größeren Menge eines Stoffes, den der Körper im normalen Umfang benötigt, der aber bei einem Übermaß schädlich wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1acdefee-c83f-4759-a1f9-8853b33eb4aa",
                                "sense_id": "11f911ca-7cf0-388e-80f3-f5ab38a138d8",
                                "text": "Überproduktion von Schilddrüsenhormonen kann zu Gewichtsverlust, Schwitzen und ständiger Nervosität führen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e372563-d73e-4645-be9c-76b3cae1c0ae",
                        "source_entry_id": "61382894-bb24-303a-bef4-67b4f24b9338",
                        "source_sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
