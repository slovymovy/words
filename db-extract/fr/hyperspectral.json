                        "entry_id": "b948543d-eb67-3eb3-8591-0c91a88cc9c7",
                        "glosses": [
                            "En dehors du spectre du visible pour l’être humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2847d86e-e1a8-47a7-92fc-36ec29d8b1c2",
                                "sense_id": "7267fe7e-81a8-375f-9530-0e31185aed95",
                                "text": "Ces ULM sont entre autres équipés d’une caméra hyperspectrale, un instrument encore expérimental à ce stade."
                            },
                            {
                                "example_id": "f61baf86-169a-4dbf-8f39-157e58982433",
                                "sense_id": "7267fe7e-81a8-375f-9530-0e31185aed95",
                                "text": "Durant leurs travaux, les ingénieurs d’Absolut ont mis au point une caméra hyperspectrale cryogénique dont le seuil de détection est d’une précision unique sur le marché et d’un niveau de résolution lui aussi inédit."
                            }
                        ]
