                                        "entry_id": "1af26b5c-93fe-35ad-90ec-e226c2c5e9cc",
                                        "glosses": [
                                            "Fort souvent."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a800d52-68e0-4da3-882b-4e53748311cb",
                                                "sense_id": "36fb4185-dd1c-3393-aaa5-843e3e57c9b9",
                                                "text": "Je l’ai vu mille fois."
                                            },
                                            {
                                                "example_id": "bed96eeb-bf00-4d30-a308-2b4d91ab1804",
                                                "sense_id": "36fb4185-dd1c-3393-aaa5-843e3e57c9b9",
                                                "text": "On lui a dit mille fois de s’arrêter."
                                            },
                                            {
                                                "example_id": "6db9deb4-0d48-4d46-ba8b-53b4a908e629",
                                                "sense_id": "36fb4185-dd1c-3393-aaa5-843e3e57c9b9",
                                                "text": "— Voler, oui. Cambrioler, soit ! Mais tuer, non, mille fois non !"
                                            },
                                            {
                                                "example_id": "9df619a6-40c0-48bb-a4a8-99007ec035e2",
                                                "sense_id": "36fb4185-dd1c-3393-aaa5-843e3e57c9b9",
                                                "text": "– Tu t’es mise en guerre contre un gaillard qui est mille fois plus fort et plus malin que toi, ma pauvre fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
