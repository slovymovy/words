                                                "example_id": "d5059102-9795-475d-b075-da65c429df3c",
                                                "sense_id": "b05556e1-3de3-3443-b6af-7dd829160d84",
                                                "text": "Lass dir doch nicht einreden, dass du zu jung dafür bist."
                                            },
