                    },
                    {
                        "translation_id": "4d0bdbcf-654e-46bd-b060-a8f4b74574c8",
                        "source_entry_id": "96aef620-2442-31d5-a6ac-b732d632765d",
                        "source_sense_id": "3e422451-a969-3551-bcd6-4c42d6e6d8f4",
                        "source_sense_description": "female poet",
                        "target_lang_word": "poétesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poétesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                                        "entry_id": "ff39791b-1338-3b3d-8fac-9ee0a069989c",
                                        "glosses": [
                                            "Femme qui fait des vers, qui se consacre à la poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26df10f8-6ead-4e64-889d-9100c1156d6e",
                                                "sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                                                "text": "Sappho est une illustre poétesse."
                                            },
                                            {
                                                "example_id": "bbedd22f-6275-4231-92e6-6564d5c15651",
                                                "sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                                                "text": "Allons donc ! quelle poétesse\nPourrait nous rimer du remord\nDans le ravin de la tristesse ?"
                                            },
                                            {
                                                "example_id": "9ab53bc1-63b3-4c8c-8282-fb8f0bfb394e",
                                                "sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                                                "text": "Il faudrait beaucoup se raidir pour ne pas tomber sous le charme de cette extraordinaire poétesse [Anna de Noailles] au cerveau bouillant et au sang froid."
                                            },
                                            {
                                                "example_id": "64fef64b-75bb-4e37-8734-f9d00807a416",
                                                "sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                                                "text": "L’un d’eux, qui porte comme titre le nom d’une poétesse de la fin du ixᵉ siècle à la vie sentimentale mouvementée, Izumi Shikibu, raconte d’un ton enjoué comment celle-ci a fait l’amour avec son propre fils, sans savoir, il est vrai, qui il était."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f551d2fc-461e-4d60-8efc-926937e2ed11",
                        "source_entry_id": "96aef620-2442-31d5-a6ac-b732d632765d",
                        "source_sense_id": "3e422451-a969-3551-bcd6-4c42d6e6d8f4",
                        "source_sense_description": "female poet",
                        "target_lang_word": "Dichterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dichterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                        "entry_id": "6790c659-4ce2-3213-83c5-2d5d43f9b24f",
                                        "glosses": [
                                            "weibliche Person, die sprachlich kunstvolle Werke verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c396530b-3604-44c7-b50e-91d1273dc89b",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die Dichterin war auf einen Schlag berühmt geworden.“"
                                            },
                                            {
                                                "example_id": "4e2ffe77-2917-4f92-9fd4-03fff8cfb51a",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die jüdische Dichterin war aus ihrem Heimatland gejagt worden und hielt nun das Zerbrechen der Welt in Versen fest.“"
                                            },
                                            {
                                                "example_id": "23fb6d14-a89c-413d-bf1f-4e0fb6375f72",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Er stellt Murdoch als eine Dichterin dar, die ein typisches Produkt aus anderen sei, aus Personen ihrer Umgebung in Oxford und in London.“"
                                            },
                                            {
                                                "example_id": "9c9db88c-ed39-40ab-a045-6de93f309bc4",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die Liebe ist eine große Dichterin, der Stoff geht ihr nie aus; wenn sie aber nie zum erstrebten Ziel gelangt, wird sie abgestanden wie der Teig beim Bäcker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04d55880-4641-4de2-95c7-b9646fa10d91",
