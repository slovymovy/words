                        "sense_id": "32f31019-d6d7-3386-9d90-4882daae66b1",
                        "entry_id": "b4e321ca-0577-3db8-af5d-8f9e00556fa0",
                        "glosses": [
                            "een grote verstembare keteltrommel zoals gebruikt in een orkest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f82187e-6f1a-4d92-a82c-7694e4b30ab3",
                                "sense_id": "32f31019-d6d7-3386-9d90-4882daae66b1",
                                "text": "De pauken zijn belangrijke instrumenten bij vele symfonische stukken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e96e853-0feb-446c-96d1-c820731c2ada",
                        "source_entry_id": "b4e321ca-0577-3db8-af5d-8f9e00556fa0",
                        "source_sense_id": "32f31019-d6d7-3386-9d90-4882daae66b1",
                        "source_sense_description": "een grote verstembare keteltrommel zoals gebruikt in een orkest",
                        "target_lang_word": "Pauke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pauke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2478e63-1624-35d6-988f-b1b5619cace9",
                                        "entry_id": "5a7881d7-439f-3337-bf26-e5907f087675",
                                        "glosses": [
                                            "ein Schlaginstrument mit einem metallenem Kessel, der mit natürlichem oder künstlichem Fell bespannt ist; die Tonhöhe kann durch verschieden starke Spannung des Fells verändert werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a7f4c2-141d-4d17-9834-0dcdaa2d9f25",
                                                "sense_id": "d2478e63-1624-35d6-988f-b1b5619cace9",
                                                "text": "„Vor einem Zirkus standen mit hängenden Köpfen drei halb schlafende Ponys, auf denen zwei dünnbeinige kleine Mädchen von Zeit zu Zeit einen verlockenden Tanz zum besten gaben, zu dem eine üppige Kassiererin Trompete, Pauke und Triangel gleichzeitig handhabte und dazu noch Eintrittskarten verkaufte.“"
                                            },
                                            {
                                                "example_id": "b61d5287-82e4-4c0e-8154-fb1d200162e1",
                                                "sense_id": "d2478e63-1624-35d6-988f-b1b5619cace9",
                                                "text": "„Er ließ aus der Halle die große Pauke hinausschaffen und auf den unteren Abschnitt des Wandelgangs die kupfernen Gongs und die Trommeln aus Kupfer aufstellen; dann setzte die Musik ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3f19d50-0fe6-47da-a77c-c7e9259a5fa8",
