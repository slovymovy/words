                "senses": [
                    {
                        "sense_id": "0af0ea26-2c1a-3545-86a7-bfdfadb35cd8",
                        "entry_id": "761660c8-9bef-396a-a001-10ac7829a792",
                        "glosses": [
                            "Historiker, der sich mit der Kirchengeschichte befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dfcc738-a33d-4965-8cc6-d5a6d7ffe04f",
                                "sense_id": "0af0ea26-2c1a-3545-86a7-bfdfadb35cd8",
                                "text": "„Die Anfänge Adolf von Harnacks als Kirchenhistoriker liegen in den 1870er Jahren. Nach verbreiteter Auffassung begann der ältere idealistische Historismus damals zu verblassen. Die großen historischen Erzählungen hätten der Quellenphilologie und der kleinteiligen Spezialstudie den Platz räumen müssen.“"
                            },
                            {
                                "example_id": "445a41dc-a6bf-48fa-a168-29598efcc89a",
                                "sense_id": "0af0ea26-2c1a-3545-86a7-bfdfadb35cd8",
                                "text": "„Dies bekräftigte etwa der nigerianische Kirchenhistoriker Ogbu Kalu auch und gerade für Hexerei, die er als Teil eines afrikanischen Weltbildes charakterisierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
