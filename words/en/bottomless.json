                },
                {
                    "sense_id": "9f9d7e1a-a0e0-3d0a-a9ea-7d62461fe102",
                    "sense_definition": "Offering unlimited refills or servings of food or drink for a fixed price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We booked a table for a <w>bottomless</w> brunch on Saturday morning.",
                            "target_lang_translations": {
