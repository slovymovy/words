                    {
                        "translation_id": "caf47c93-d893-46d4-bcdf-f35232491a1f",
                        "source_entry_id": "b2057b57-e4e0-3fa2-af63-212d06e1956b",
                        "source_sense_id": "df7500d8-a7b6-39b5-82f0-dc701ee68bac",
