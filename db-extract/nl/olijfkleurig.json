                                    {
                                        "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                        "entry_id": "bbf9a75b-5cbd-30ae-86b3-daddd40f2492",
                                        "glosses": [
                                            "eine ins Grüne spielenden (sich der Farbe Grün nähernden) Farbe habend; der Farbe Grün ähnlich; an Grün erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a08370-ced2-476a-91ae-595a5320f863",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Er wurde leicht grünlich im Gesicht."
                                            },
                                            {
                                                "example_id": "d02b9da7-dade-4dc3-af87-483a9de50a6f",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Lichtblau bezeichnet ein leicht grünliches Hellblau."
                                            },
                                            {
                                                "example_id": "af1ccd47-483f-4239-85a9-baab0e199f66",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Die Wand war grünlich gefärbelt."
                                            },
                                            {
                                                "example_id": "e437b380-b525-44e4-8404-511918f6d1ab",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "„Der ganze Kniff sei, sich nie etwas durchgehen zu lassen, sagte er zu Frau Schobel, seiner Zimmervermieterin, und bat um noch ein Glas der grünlichen Molke, vor der es ihn so ekelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
