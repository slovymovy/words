                                "sense_id": "21d39eec-0675-376f-8c02-2e5020e5c1f4",
                                "text": "De bal lag net op de doellijn, dus kan het niet raak zijn geweest.",
                                "translation": "“The ball lay exactly on the goal line, so it can’t have been a goal.”",
                                "english": "“The ball lay exactly on the goal line, so it can’t have been a goal.”"
                            }
