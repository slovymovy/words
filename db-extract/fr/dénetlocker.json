                "senses": [
                    {
                        "sense_id": "7667ee16-0299-3dc6-a6e3-63134f1f9012",
                        "entry_id": "8a97f6b9-de50-3ce1-a39b-274b3f459c39",
                        "glosses": [
                            "Débloquer un téléphone portable verrouillé par un opérateur contractuel de téléphonie mobile afin de permettre d’utiliser le téléphone sur n’importe quel réseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e68e5ae-5673-410f-8a13-e3b864838351",
                                "sense_id": "7667ee16-0299-3dc6-a6e3-63134f1f9012",
                                "text": "Pour dénetlocker votre mobile, vous aurez besoin de son nᵒ IMEI (International Mobile Equipment Identity) pour faire simple il s'agit de son nᵒ d'identification."
                            },
                            {
                                "example_id": "7aa55205-cd65-4f49-9b5a-b8f1c70167a1",
                                "sense_id": "7667ee16-0299-3dc6-a6e3-63134f1f9012",
                                "text": "En effet, si vous avez eu votre téléphone avec SFR et que vous ne leur avez jamais demandé de le dénetlocker, celui-ci reste bloqué sur le réseau SFR."
                            },
                            {
                                "example_id": "c3ad4b48-66e0-49c9-88b6-c0687004681a",
                                "sense_id": "7667ee16-0299-3dc6-a6e3-63134f1f9012",
                                "text": "3 ou 4 jours pour le dénetlocker (c'est Nokia qui possède ces codes)."
                            }
                        ]
                    }
                ],
