                    {
                        "sense_id": "ce995dc2-3151-3a6a-a4bc-7eb5aa4ce3eb",
                        "entry_id": "cc6f1632-3eb6-36c3-8953-e2fabe306aa8",
                        "glosses": [
                            "Mord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cfbf9a-5a57-4660-8286-1fb9e13eca5a",
                                "sense_id": "ce995dc2-3151-3a6a-a4bc-7eb5aa4ce3eb",
                                "text": "He investigates the slaying from the mayor.",
                                "translation": "Er untersucht den Mord vom Bürgermeister."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fc880e6-0b3e-4b08-b727-0ab663314548",
                        "source_entry_id": "cc6f1632-3eb6-36c3-8953-e2fabe306aa8",
                        "source_sense_id": "ce995dc2-3151-3a6a-a4bc-7eb5aa4ce3eb",
                        "source_sense_description": "Mord",
                        "target_lang_word": "Mord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1220c59-3793-3f5a-86c6-269b04d89801",
                                        "entry_id": "99c812a8-c649-3115-8373-6d52d9c8ebf4",
                                        "glosses": [
                                            "vorsätzliche Tötung einer Person unter qualifizierten Umständen; in Deutschland, wenn sie aus Mordlust, zur Befriedigung des Geschlechtstriebs, aus Habgier oder sonst aus niedrigen Beweggründen, heimtückisch oder grausam oder mit gemeingefährlichen Mitteln oder um eine andere Straftat zu ermöglichen oder zu verdecken, geschieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a0420c-9b58-48c0-9d5b-a48dfe24fe64",
                                                "sense_id": "b1220c59-3793-3f5a-86c6-269b04d89801",
                                                "text": "Während der Bundesgerichtshof Mord als selbständigen Tatbestand ansieht, hält die herrschende Meinung Mord für eine Qualifikation des Totschlags."
                                            },
                                            {
                                                "example_id": "e09fd3bb-f07c-4c0e-a9b8-e1473be72684",
                                                "sense_id": "b1220c59-3793-3f5a-86c6-269b04d89801",
                                                "text": "Sie wurde wegen Mordes an zwei Wachmännern angeklagt."
                                            },
                                            {
                                                "example_id": "06917cd5-9f3d-48f7-8d4e-4871d493eb4e",
                                                "sense_id": "b1220c59-3793-3f5a-86c6-269b04d89801",
                                                "text": "Er wurde des Mordes an einem Taxifahrer für schuldig befunden."
                                            },
                                            {
                                                "example_id": "776f6f1b-99f8-467c-90a6-8cb701197e55",
                                                "sense_id": "b1220c59-3793-3f5a-86c6-269b04d89801",
                                                "text": "„Da ein Mord an den Riddles nicht zu beweisen war, musste die Polizei Frank laufen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                        "entry_id": "99c812a8-c649-3115-8373-6d52d9c8ebf4",
                                        "glosses": [
                                            "allgemein Töten, Tötung eines Menschen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4e9d97-7466-4ef6-9318-940184b94447",
                                                "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                                "text": "„Da ein Mord an den Riddles nicht zu beweisen war, musste die Polizei Frank laufen lassen.“"
                                            },
                                            {
                                                "example_id": "37433ebe-de1d-4a36-80ea-0257ccd1cd53",
                                                "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                                "text": "Für die Familie ist es Mord, was da am letzten Samstag im April geschah, völlig unabhängig von der Meinung und Einschätzung eines Gerichts."
                                            },
                                            {
                                                "example_id": "056a6aa0-b54f-48d5-b9fb-5d0b5e3904fd",
                                                "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                                "text": "Sich selbst zu töten ist kein Mord."
                                            },
                                            {
                                                "example_id": "65819180-efbd-432a-bc8e-a4083b08bfb5",
                                                "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                                "text": "„Fragt man beispielsweise einen Bundesbürger, wie viele Morde seiner Meinung nach pro Jahr in Deutschland verübt werden und ob die Mordrate zu- oder abnehmend sei, so liegt die Antwort meist bei weit über tausend Opfern, Tendenz steigend.“"
                                            },
                                            {
                                                "example_id": "456c1b86-80aa-46a2-9fef-8c38159e34f7",
                                                "sense_id": "697d3fd2-3797-3e82-9bc3-7abfce71b379",
                                                "text": "„Von den notwendigen Morden erholt er sich bei Lustmorden, indem er z.B. Postkutschen überfällt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
