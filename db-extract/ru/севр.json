                "senses": [
                    {
                        "sense_id": "60f071f8-8c94-3517-bdc8-80ea648bffcf",
                        "entry_id": "44faf14f-97f5-3736-a1b8-14486ef1aa0c",
                        "glosses": [
                            "собир. художественные изделия крупнейшего во Франции фарфорового завода в городе Севре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3469c774-feff-43e6-bf88-bb8c73fbffd4",
                                "sense_id": "60f071f8-8c94-3517-bdc8-80ea648bffcf",
                                "text": "В столовой мебель была не так изящна, как у фон Буш, зато массивна, а за стеклами буфета находились такие чудесные севры с лилиями и без лилий, такие стеклянные вазы из Мурано, мозаиковые вещицы из Венеции, фарфоры из Китая и Японии, блюда времен арабского халифата в Гренаде, что их прямо отсюда можно было послать на выставку."
                            }
                        ]
                    }
                ],
