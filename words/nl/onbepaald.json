                                "target_lang_word": "undecided",
                                "target_lang_sense_clarification": "referring to a result that is still open"
                            },
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "referring to an expression or look"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89996bdf-6613-33cd-903e-50915e191edf",
                    "sense_definition": "Niet duidelijk om wie of wat het gaat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er klonk een <w>onbepaald</w> geluid in de gang.",
                            "target_lang_translations": {
                                "it": "Nel corridoio si è sentito un rumore <w>indefinito</w>.",
                                "ru": "В коридоре послышался <w>неопределенный</w> звук.",
                                "en": "An <w>indistinct</w> sound could be heard in the hallway."
                            }
                        },
                        {
                            "text": "De dader had een <w>onbepaalde</w> leeftijd.",
                            "target_lang_translations": {
                                "it": "Il colpevole aveva un'età <w>indeterminata</w>.",
                                "ru": "Преступник был <w>неопределенного</w> возраста.",
                                "en": "The perpetrator was of <w>indeterminate</w> age."
                            }
