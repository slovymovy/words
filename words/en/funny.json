                    "sense_definition": "Causing laughter or amusement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That movie was so <w>funny</w> that I could not stop laughing.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был таким <w>смешным</w>, что я не мог перестать смеяться.",
                                "nl": "Die film was zo <w>grappig</w> dat ik niet kon stoppen met lachen.",
                                "pl": "Tamten film był tak <w>śmieszny</w>, że nie mogłem przestać się śmiać.",
                                "de": "Dieser Film war so <w>lustig</w>, dass ich nicht aufhören konnte zu lachen.",
                                "fr": "Ce film était tellement <w>drôle</w> que je ne pouvais pas m'arrêter de rire.",
                                "it": "Quel film era così <w>divertente</w> che non riuscivo a smettere di ridere.",
                                "cs": "Ten film byl tak <w>legrační</w>, že jsem se nemohl přestat smát.",
                                "tr": "O film o kadar <w>komikti</w> ki gülmekten duramadım.",
                                "es": "Esa película era tan <w>divertida</w> que no podía parar de reír.",
                                "zh": "那部电影太<w>好笑</w>了，我笑得停不下来。"
                            }
                        },
                        {
                            "text": "He told a very <w>funny</w> joke at the party last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером на вечеринке он рассказал очень <w>смешную</w> шутку.",
                                "nl": "Hij vertelde gisteravond op het feest een heel <w>grappige</w> grap.",
                                "pl": "Wczoraj wieczorem na imprezie opowiedział bardzo <w>zabawny</w> żart.",
                                "de": "Er hat gestern Abend auf der Party einen sehr <w>witzigen</w> Witz erzählt.",
                                "fr": "Il a raconté une blague très <w>marrante</w> à la fête hier soir.",
                                "it": "Ieri sera alla festa ha raccontato una barzelletta molto <w>divertente</w>.",
                                "cs": "Včera večer na večírku řekl velmi <w>vtipný</w> vtip.",
                                "tr": "Dün gece partide çok <w>komik</w> bir fıkra anlattı.",
                                "es": "Anoche en la fiesta contó un chiste muy <w>gracioso</w>.",
                                "zh": "他昨晚在派对上讲了一个非常<w>有趣</w>的笑话。"
                            }
                        }
                    ],
