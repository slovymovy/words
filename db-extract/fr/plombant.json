                "senses": [
                    {
                        "sense_id": "888f99c4-92de-3241-b9b5-509fa62c8c49",
                        "entry_id": "2b3eb9fd-8bc4-3e87-bacd-61166943c016",
                        "glosses": [
                            "Qui plombe, généralement le moral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f0db5d-310b-4c87-8153-19a89163c0a8",
                                "sense_id": "888f99c4-92de-3241-b9b5-509fa62c8c49",
                                "text": "L’origine de sa légère — mais plombante — paralysie faciale se trouvait là, fruit amer d’une de ce borrélioses mal soignées qui lui causait également certains problèmes articulaires et raidissait sa démarche pour tout arranger."
                            },
                            {
                                "example_id": "b831e6f4-0132-44cb-a3ca-4cf152a292f1",
                                "sense_id": "888f99c4-92de-3241-b9b5-509fa62c8c49",
                                "text": "Sur ces interminables autoroutes espagnoles, […] le tronçon entre Albacete et Madrid était lui aussi parfaitement plombant."
                            }
                        ]
                    },
                    {
                        "sense_id": "80d42e4e-2f16-33f3-966b-37e955d03067",
                        "entry_id": "2b3eb9fd-8bc4-3e87-bacd-61166943c016",
                        "glosses": [
                            "Qui pèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ae42e7-806c-481e-98dd-06cc4aacef34",
                                "sense_id": "80d42e4e-2f16-33f3-966b-37e955d03067",
                                "text": "Les tissus d’ameublement avec des charges leur donnant un effet plombant (tenture)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f65d3e90-eb1b-3d45-a003-ee113ad96faf",
                        "entry_id": "2b3eb9fd-8bc4-3e87-bacd-61166943c016",
                        "glosses": [
                            "Qualifie les revêtements de sol souples suffisamment lourds pour ne pas avoir besoin d'être collé ou assujetti au sol par un quelconque moyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affce479-cde6-41ba-b4ee-235d9ba1acb6",
                                "sense_id": "f65d3e90-eb1b-3d45-a003-ee113ad96faf",
                                "text": "Pour les caves ou les garages, on pourra préconiser des dalles plombantes industrielles, particulièrement résistantes, et qui possèdent la particularité de pouvoir être réutilisées par pose et dépose dans le cadre de réfection de locaux."
                            }
                        ]
                    }
