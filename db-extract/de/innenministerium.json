                        "entry_id": "a566a877-d50f-332d-a2f6-cd01076e31ab",
                        "glosses": [
                            "Ministerium, das für innere Angelegenheiten eines Staates zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a5296e-6f12-49ea-a81a-71b7b1e36fa8",
                                "sense_id": "4ab2d8a9-13b0-3b7c-b7fa-8127d2f415d1",
                                "text": "„Das Innenministerium sah sich auch durch die sprunghaft steigenden Attacken auf deutsche Behördenrechner zum Handeln gezwungen.“"
                            },
                            {
                                "example_id": "43676e74-7072-4b49-8abc-35b4226804e4",
                                "sense_id": "4ab2d8a9-13b0-3b7c-b7fa-8127d2f415d1",
                                "text": "„[Ferdinand Käs] leitete bis 1963 als Oberstleutnant die Gendarmerieschule und war 1963-1979 im Innenministerium tätig (ging als Sektionschef in Pension).“"
                            }
                        ],
