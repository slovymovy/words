                "senses": [
                    {
                        "sense_id": "2da01396-9ea7-329a-94ad-d2ea54f93959",
                        "entry_id": "ca1b5c20-5fdc-3b8d-ae65-03a27ee49744",
                        "glosses": [
                            "bestimmte Art/Sorte von Hirse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d4e639-4480-42b5-ac3c-fc6073ac20d7",
                                "sense_id": "2da01396-9ea7-329a-94ad-d2ea54f93959",
                                "text": "„Am Fluss pflanzt man oftmals, um die Ernährung zu erweitern, Sorghum, eine Hirseart, an.“"
                            },
                            {
                                "example_id": "bfbc54f9-a69f-4b6d-9188-a150110b5705",
                                "sense_id": "2da01396-9ea7-329a-94ad-d2ea54f93959",
                                "text": "„Wer sich nicht jeden Morgen Brot leisten kann, isst als Alternative Mono, einen Brei aus einer Hirseart.“"
                            },
                            {
                                "example_id": "a0314b9b-bc45-4c7e-8108-ce63b549c2a1",
                                "sense_id": "2da01396-9ea7-329a-94ad-d2ea54f93959",
                                "text": "„Aus einer besonderen Hirseart wird Teffmehl gewonnen, das sich mit seinem nussig-milden Geschmack vielseitig einsetzen lässt.“"
                            },
                            {
                                "example_id": "ef32f3a5-c25c-406d-a2ce-8232f6cdfd02",
                                "sense_id": "2da01396-9ea7-329a-94ad-d2ea54f93959",
                                "text": "„Von dort bezog man die afrikanischen Hirsearten, die es der Induskultur erlaubten, in Hochlandgebiete vorzudringen, in denen sich kein Weizen anbauen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
