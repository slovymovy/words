                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een <w>razende</w> storm die veel bomen in het bos omver blies.",
                            "target_lang_translations": {
                                "en": "There was a <w>raging</w> storm that blew down many trees in the forest."
                            }
                        },
                        {
                            "text": "De auto reed met een <w>razende</w> snelheid over de lege snelweg.",
                            "target_lang_translations": {
                                "en": "The car drove at a <w>breakneck</w> speed over the empty highway."
                            }
                        }
                    ],
                    "common_phrases": [
                        "razende snelheid",
                        "razende storm"
                    ],
                    "target_lang_definitions": {
                        "en": "with enormous power, speed, or intensity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "raging",
                                "target_lang_sense_clarification": "violent and intense, like a storm"
                            },
                            {
                                "target_lang_word": "breakneck",
                                "target_lang_sense_clarification": "dangerously fast speed"
                            },
                            {
                                "target_lang_word": "frantic",
                                "target_lang_sense_clarification": "wild or distraught with fear or anxiety"
                            }
                        ]
                    }
                }
            ]
        },
        {
