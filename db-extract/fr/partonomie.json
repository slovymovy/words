                    {
                        "sense_id": "2fa905d2-e41a-37cc-b469-0f2cd9dc46a2",
                        "entry_id": "021180fe-8071-3a42-b1e2-2e1eef2cf555",
                        "glosses": [
                            "Synonyme de découpage, partition."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4cda31c9-e6f3-47a2-b1b9-c3c85f44d7dd",
                                "sense_id": "2fa905d2-e41a-37cc-b469-0f2cd9dc46a2",
                                "text": "Des termes utilisés pour la description des parties découpées, seuls trois sont propres au contexte de la partonomie de l'animal mort."
                            },
                            {
                                "example_id": "1026f7bb-e91b-4f92-9fb6-5e207eea3858",
                                "sense_id": "2fa905d2-e41a-37cc-b469-0f2cd9dc46a2",
                                "text": "Taxonomie et partonomie."
                            },
                            {
                                "example_id": "46ffb610-20c1-46b3-960c-24a4c731c94a",
                                "sense_id": "2fa905d2-e41a-37cc-b469-0f2cd9dc46a2",
                                "text": "En partonomie, on relie le concept de voiture avec le concepts de roue et de portière."
                            },
                            {
                                "example_id": "3ca21c85-bac2-4af0-a92c-fe5c438e4e43",
                                "sense_id": "2fa905d2-e41a-37cc-b469-0f2cd9dc46a2",
                                "text": "Il ne faut pas mélanger les deux relations, subsomption et partonomie."
                            }
                        ]
                    }
                ],
