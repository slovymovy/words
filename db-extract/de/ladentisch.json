                ],
                "senses": [
                    {
                        "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                        "entry_id": "6e800a1b-ed18-37ce-9cfe-dab0100719ff",
                        "glosses": [
                            "Verkaufstisch in einem Geschäft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b35e542-65ad-4357-9fd9-3ce451a29552",
                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                "text": "„Im allgemeinen sind Leuchtkörper für vorwiegend direktes Licht zweckmäßig, weil hauptsächlich der Ladentisch und der Hackklotz gut beleuchtet werden müssen.“"
                            },
                            {
                                "example_id": "b41204f2-ba44-4376-86de-5cda14e526bf",
                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                "text": "„Hinterm Tresen stand ein dicker Mann, die Fäuste auf den Ladentisch gestemmt.“"
                            },
                            {
                                "example_id": "7b02cf03-289f-40a5-9b69-ce637c00465d",
                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                "text": "„Wir schließen auf und stehen erwartungsvoll hinter dem Ladentisch.“"
                            },
                            {
                                "example_id": "d80e7bf6-7fa5-4c61-b6db-d9b582453956",
                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                "text": "„Der Ladentisch war zwei Meter in der Länge aus drei Brettern zusammengenagelt, die auf zwei Fässern auflagen.“"
                            },
                            {
                                "example_id": "7afce588-ffda-48e5-a5ff-18feab62a6ba",
                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                "text": "„Chigurh pflückte sein Wechselgeld vom Ladentisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
