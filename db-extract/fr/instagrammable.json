        "fr-extract.jsonl": [
            {
                "entry_id": "59cfd11b-f45e-36f6-9582-530fc038f285",
                "word": "instagrammable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ae2be746-b908-4d43-97e4-ba201a877b4d",
                        "entry_id": "59cfd11b-f45e-36f6-9582-530fc038f285",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "instagrammables"
                    },
                    {
                        "form_id": "cc5d80b1-5b20-4916-95b7-c3fc29c3248e",
                        "entry_id": "59cfd11b-f45e-36f6-9582-530fc038f285",
                        "tags": [],
                        "form": "instagramable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                        "entry_id": "59cfd11b-f45e-36f6-9582-530fc038f285",
                        "glosses": [
                            "Qui présente des qualités visuelles incitant à prendre ou communicables par une photographie et à la diffuser sur internet via l’application du service Instagram ou d'autres médias sociaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51bba57-b8e4-47e7-a117-63ab5d444ea1",
                                "sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                                "text": "Accessible depuis un funiculaire, il offre une vue panoramique à 800 mètres au-dessus des collines verdoyantes et d’où vous pourrez prendre des photos parfaitement instagrammables !"
                            },
                            {
                                "example_id": "ebcc828f-e8ba-4c16-81c2-6aabcee021bc",
                                "sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                                "text": "Il faut l’avouer, c’est hyper instagrammable une fois qu’on est debout dessus."
                            },
                            {
                                "example_id": "8c9e5a4f-8ed9-4c03-9c41-336b7474ce5e",
                                "sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                                "text": "Ce qui pose problème à beaucoup de puristes de l’art contemporain, c’est la volonté directe de certaines expos de se présenter en tant que lieu « instagrammable »."
                            },
                            {
                                "example_id": "ab43676b-07ad-4e52-9756-617d87f480ac",
                                "sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                                "text": "La génération Z et les Millennials veulent non seulement des boissons savoureuses et moins alcoolisées, mais aussi qui soient instagrammables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "922758d0-c2fb-4807-a9ce-7f024a63b8e7",
                        "source_entry_id": "59cfd11b-f45e-36f6-9582-530fc038f285",
                        "source_sense_id": "1cbdbbd9-db91-3f18-acbe-cc2242037ccd",
                        "target_lang_word": "Instagrammable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Instagrammable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                        "entry_id": "29897c67-b955-3eb3-af15-0182ceaaf74e",
                                        "glosses": [
                                            "Visually attractive or interesting such that it lends itself to being photographed and posted on social media (specifically on Instagram); photogenic."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85dab400-4489-4fa2-9536-878e79c5d8e6",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "A centerpiece such as a basket of fruits or a pumpkin vase of flowers would make the dining table look beautiful and Instagramable."
                                            },
                                            {
                                                "example_id": "956dc39e-8c43-4767-9e89-b6e123ab94ce",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "Creating instagrammable moments for business through design is paramount in order to stay relevant. [...] [Mark] Birnbaum uses the ‘instagrammable cake’ sold at Catch, as an example of how “items exist solely for the reason of social sharing”."
                                            },
                                            {
                                                "example_id": "fa887e93-9390-4213-8eaf-720077126d87",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "My adult life, and particularly my married life, was quite \"blessed\" for the first eleven years. It was very pretty, very Instagrammable."
                                            },
                                            {
                                                "example_id": "3406ca66-735f-4aaf-8d28-0cbbdab5546d",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "And then there are the chairs. Whimsical, colorful, diverse and tested for both comfort and durability, the wide array of unusual seating options at Changi's T4 are designed to be both inviting and Instagramable."
                                            },
                                            {
                                                "example_id": "b76aa1b0-8d3b-490f-97ac-c12b2a5c9975",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "Burgers are a great source of protein (ignore the grease), as are eggs (which must go some way to enhancing my eggs), plus I had a dollop of guacamole, which is basically unsullied avocado (healthy and Instagrammable)."
                                            },
                                            {
                                                "example_id": "22028293-3db3-4e52-b85e-161fd3db19af",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "Now, if you're the type of person who quietly agonises over what people might think of your carefully curated, Instagrammable bookshelf, don't worry!"
                                            },
                                            {
                                                "example_id": "11766e7f-f319-4cfd-9b04-87177993fb2d",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "Retailers are also taking a page out of this playbook by creating shopping experiences with Instagramable moments, including photo booths, branded mirrors and neon signs."
                                            },
                                            {
                                                "example_id": "b37086f3-4ce0-4f8b-ad2d-1168bc0ffda8",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "[Ben Quilty's] art is characterised not by a heavy morbidity but an ease and facility, a vitality that has seen figurative painting remain important in Australia in a period when it was dismissed as washed-up and conservative while conceptual and Instagrammable installation art had become de rigueur; [...]"
                                            },
                                            {
                                                "example_id": "17d6bfca-16af-4aa3-975a-bfaaed032c20",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "I'd hired a pair of social media assistants whose primary job was to identify Instagram-able outfits and locales, before the influence-aspiring hordes found their way to them and turned them into middle-America clichés."
                                            },
                                            {
                                                "example_id": "9f1ed305-8dec-47f8-990c-b95f3282767f",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "This isn't an accident; everything about this cafe is designed to be Instagram-able."
                                            },
                                            {
                                                "example_id": "4d1ca219-47f6-4b13-ba0f-41de83bc1506",
                                                "sense_id": "7212d225-0e59-34e1-aa72-a86d3c18fd3d",
                                                "text": "[Edward] Barnieh watched new cafes all around the world adopt aesthetics that were popular on Instagram. [...] The public was coming to a consensus about what kinds of designs were Instagrammable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
