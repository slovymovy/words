                    "semantic_group_id": "medische_bloedwaarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts zag een verhoogde <w>bezinking</w> in het bloedonderzoek.",
                            "target_lang_translations": {
