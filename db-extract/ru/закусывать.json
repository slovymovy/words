                        "glosses": [
                            "to bite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99cb989-0ab4-4c6f-95f9-f64d75158e12",
                                "sense_id": "bdca0b3d-6585-31f1-9c89-fab29488fa37",
                                "text": "заку́сывать гу́бы",
                                "translation": "to bite one's lip",
                                "english": "to bite one's lip"
                            },
                            {
                                "example_id": "9c7b11df-1434-4b4b-bc25-a5c1f4571365",
                                "sense_id": "bdca0b3d-6585-31f1-9c89-fab29488fa37",
                                "text": "заку́сывать язы́к",
                                "translation": "to keep one's mouth shut; hold one's tongue",
                                "english": "to keep one's mouth shut; hold one's tongue"
                            },
                            {
                                "example_id": "5e837b3d-12d3-4f07-b763-de7d04172356",
                                "sense_id": "bdca0b3d-6585-31f1-9c89-fab29488fa37",
                                "text": "заку́сывать удила́ (и)",
                                "translation": "to get/take the bit between one's teeth",
                                "english": "to get/take the bit between one's teeth"
                            }
                        ]
                    },
                    {
                        "sense_id": "3c427b7d-ba0f-3af8-982a-b9b0233b751b",
                        "entry_id": "7c25e5c5-17fe-397c-a7d8-4429156969c9",
                        "glosses": [
                            "to have a snack, to get a bite, to eat"
                        ],
                        "tags": [],
                        "examples": [
                            {
