                "translations": [
                    {
                        "translation_id": "0adc4183-a98d-4b80-8152-5b6ba46a9f17",
                        "source_entry_id": "8b66d86d-059b-3a7c-beef-0334a89c6afe",
                        "source_sense_id": "e62e81ab-4555-3e73-b329-96cfb0e99cc5",
                        "source_sense_description": "jemanden verprügeln, verdreschen",
                        "target_lang_word": "verprügeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verprügeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                        "entry_id": "e0510126-59a1-3bec-be89-52412e09b251",
                                        "glosses": [
                                            "auf jemanden wiederholt einschlagen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d2ed76-dfa3-4151-8809-5edb7a1748ad",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Der Mistkerl sollte mal ordentlich verprügelt werden."
                                            },
                                            {
                                                "example_id": "1b393873-7ffd-4246-8372-3286bbde09de",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Schläge, Tritte, Hitlergruß: Weil sie zwei Bulgaren und einen Rumänen auf einem Volksfest brutal verprügelten, hat ein Gericht in Sachsen drei Männer hart bestraft."
                                            },
                                            {
                                                "example_id": "80b077ff-117a-4d40-9124-0286309770f6",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Männer, die von ihren Frauen verprügelt werden, passen schlecht ins gesellschaftliche Rollenklischee."
                                            },
                                            {
                                                "example_id": "d58a2886-5a2e-4298-9562-698476db7712",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "„Er seinerseits hatte zugesehen, wie Frans verprügelt wurde. Der Vater merkte nie, wenn jemand hinter der Glastür stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b16bbfc-76ab-4170-8609-43b7fd889ae5",
                        "source_entry_id": "8b66d86d-059b-3a7c-beef-0334a89c6afe",
                        "source_sense_id": "e62e81ab-4555-3e73-b329-96cfb0e99cc5",
                        "source_sense_description": "jemanden verprügeln, verdreschen",
                        "target_lang_word": "verdreschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdreschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74978967-f202-3f0b-99c4-1393129ea562",
                                        "entry_id": "be577e37-dfee-344a-a15d-2c373dd36448",
                                        "glosses": [
                                            "jemanden oder ein Tier verprügeln, heftig schlagen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99baf25-c1ae-439a-9ea8-503d0a39c39f",
                                                "sense_id": "74978967-f202-3f0b-99c4-1393129ea562",
                                                "text": "Er hat ihn wie einen räudigen Hund verdroschen."
                                            },
                                            {
                                                "example_id": "cfe3041b-8abe-4c59-872f-d0a6b612de0d",
                                                "sense_id": "74978967-f202-3f0b-99c4-1393129ea562",
                                                "text": "Der eine, ein riesenstarker Junge vom Lande war durch die vereinigten Klassen-Herkulesse nicht von der Stelle zu bringen und musste auf seinem Platze verdroschen werden."
                                            },
                                            {
                                                "example_id": "656df84a-073e-4e56-a945-f58840d6540f",
                                                "sense_id": "74978967-f202-3f0b-99c4-1393129ea562",
                                                "text": "„Ich krieg schlechte Laune, wenn ich verlier“, zürnte er dann und verriet, dass er seine Schwester früher beim Monopoly spielen verdroschen hat, „ins Gesicht“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
