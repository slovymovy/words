                                "example_id": "b2c76c3a-db55-4818-9214-0c9ba6ee91a4",
                                "sense_id": "77b7058e-824e-3db3-ada3-c40942da1f2e",
                                "text": "Mąka stosowana jest jako główny składnik wielu produktów żywnościowych takich jak chleb, ciasto, makaron."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "716f18f2-f3dc-4c51-8432-d892c683e493",
                        "source_entry_id": "d43643b6-536f-3360-8115-4382ef5ac9c2",
                        "source_sense_id": "77b7058e-824e-3db3-ada3-c40942da1f2e",
                        "target_lang_word": "alimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09915600-62a1-30b8-91be-29f0c9ff82d9",
                                        "entry_id": "043e0a1b-f441-3946-8274-b55b5c588216",
                                        "glosses": [
                                            "Relatif à l’alimentation, aux aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b63898-b1fa-45c9-9b56-582891521f55",
                                                "sense_id": "09915600-62a1-30b8-91be-29f0c9ff82d9",
                                                "text": "Dès l’avènement de l’agriculture et de la sédentarisation des chasseurs-cueilleurs, il a été vital de trouver des solutions pour maintenir les stocks alimentaires."
                                            },
                                            {
                                                "example_id": "ea967b24-f23a-4caa-82f0-8196a6eef46b",
                                                "sense_id": "09915600-62a1-30b8-91be-29f0c9ff82d9",
                                                "text": "Si l’on prend comme exemple l’approvisionnement alimentaire, on entend par autosuffisance une complète indépendance à l’égard des importations pour répondre aux besoins alimentaires d’une collectivité ou d’une ville, un objectif difficilement atteignable même en vertu du scénario le plus optimiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8537e0c8-91f5-3068-9dea-4ae9c1c3ccde",
                                        "entry_id": "043e0a1b-f441-3946-8274-b55b5c588216",
                                        "glosses": [
                                            "Qui sert d’aliment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a581e78-d223-4e79-ba4a-b64213b32545",
                                                "sense_id": "8537e0c8-91f5-3068-9dea-4ae9c1c3ccde",
                                                "text": "Les substances alimentaires."
                                            },
                                            {
                                                "example_id": "b000f295-3694-4aeb-9ec2-6dee7a9554ef",
                                                "sense_id": "8537e0c8-91f5-3068-9dea-4ae9c1c3ccde",
                                                "text": "Plantes alimentaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ad5375-f389-37e9-b1b8-67fcfb513484",
                                        "entry_id": "043e0a1b-f441-3946-8274-b55b5c588216",
                                        "glosses": [
                                            "Non toxique quand avalé ou porté à la bouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f35cba-4051-4794-8850-3edea6833e7d",
                                                "sense_id": "41ad5375-f389-37e9-b1b8-67fcfb513484",
                                                "text": "Avec sa bonne bouille et ses oreilles toutes douces, en silicone alimentaire, Fabulapin a été conçu par le Français Erwan Leroux."
                                            },
                                            {
                                                "example_id": "225492c7-6dc3-4c9c-b04c-ece4c79ff0e4",
                                                "sense_id": "41ad5375-f389-37e9-b1b8-67fcfb513484",
                                                "text": "En fait, les récipients en plastique de qualité alimentaire ne devraient pas être passés au lave-vaisselle ou lavés à l'eau chaude plus d'une centaine de fois. En outre, l'utilisation du lave-vaisselle accélère la dégradation des contenants en plastique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b93e8eda-b1aa-3bda-8162-d64ece9249d9",
                                        "entry_id": "043e0a1b-f441-3946-8274-b55b5c588216",
                                        "glosses": [
                                            "Relatif à l’alimentation des machines en matières."
                                        ],
                                        "tags": [
                                            "Industrie",
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a17d37fe-b487-4563-9dc1-3dda518d3ca6",
                                                "sense_id": "b93e8eda-b1aa-3bda-8162-d64ece9249d9",
                                                "text": "Elles se déroulent suivant la vitesse circonférentielle des cylindres en bois dont la commande est prise sur le cylindre alimentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                        "entry_id": "043e0a1b-f441-3946-8274-b55b5c588216",
                                        "glosses": [
                                            "Qualifie un travail qu’on fait pour subsister et non par passion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af108c13-5f86-4395-b29b-8d46127d4f78",
                                                "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                                "text": "À la population agricole s’ajoutait ainsi une population industrielle, dont le nombre dépendait de la productivité du travail alimentaire, tailleurs de pierres, maçons, charpentiers, armuriers, bijoutiers etc. nourris et entretenus comme les esclaves cultivateurs par le propriétaire du domaine."
                                            },
                                            {
                                                "example_id": "f347bbcc-c724-47cc-beab-e6e158b21471",
                                                "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                                "text": "Après tout, Zola a commencé dans la tradition d’Eugène Sue et Les Mystères de Marseille voulaient peut-être être une réplique de ceux de Paris. On le sait : c’était là de la littérature alimentaire et Zola ne s’est jamais fait d’illusions à son propos."
                                            },
                                            {
                                                "example_id": "9c951ee8-939d-44ed-bc79-85cf1b516db6",
                                                "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                                "text": "Tout cela ne serait que littérature alimentaire si, par moments, l’élévation du sentiment, l’élégance de la plume n’apparaissaient, mais parmi bien des négligences, des inexactitudes, des défaillances de doctrine."
                                            },
                                            {
                                                "example_id": "e6bb5c77-706d-48a2-933c-c368cdd94971",
                                                "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                                "text": "Le secteur public a perdu alors son prestige auprès des Chinois qualifiés, à qui il n’offrait plus qu’un travail alimentaire, sans perspectives ou sans motivation."
                                            },
                                            {
                                                "example_id": "84f8e910-6ec3-470b-a5ed-a2384cbde5f4",
                                                "sense_id": "9c72034e-8a44-308d-977c-af16409309f5",
                                                "text": "[Robert Vaughn] avait fait ses classes en jouant au Teenage Caveman pour Roger Corman avant de connaître la gloire dans Les Sept Mercenaires et d'autres productions de prestige, puis de retomber dans le bis et le Z alimentaires […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e178af-c029-35da-8e55-ea15f7bb5332",
                                        "entry_id": "8d17c75d-26fb-3b2d-8996-c2efa7103c9a",
                                        "glosses": [
                                            "Organe d’une machine qui assure l’alimentation en matières."
                                        ],
                                        "tags": [
                                            "Industrie",
                                            "Par substantivation"
                                        ],
                                        "examples": [
