                ],
                "senses": [
                    {
                        "sense_id": "1ca98a57-8b6c-3119-9e82-92a3184d1057",
                        "entry_id": "eea18f7c-64c1-36db-b0f7-7432005e53bd",
                        "glosses": [
                            "Faisant preuve de pluralisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e07ebd-f236-42f3-8a51-16a31594061e",
                                "sense_id": "1ca98a57-8b6c-3119-9e82-92a3184d1057",
                                "text": "Le vide des institutions politiques demeura, parce que des structures empruntées à des régimes pluralistes, tel que le constitutionnalisme et le parlementarisme, étaient trop étrangères […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae4ca308-a436-3a5b-aaf6-e19a35e8eb51",
                        "entry_id": "eea18f7c-64c1-36db-b0f7-7432005e53bd",
                        "glosses": [
                            "Ouvert, diversifié, tolérant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6da13d23-017d-4ffe-b0d6-0eca3260e76d",
                                "sense_id": "ae4ca308-a436-3a5b-aaf6-e19a35e8eb51",
                                "text": "Les scouts pluralistes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ef89710-5cf3-4966-a089-757a7bc16051",
                        "source_entry_id": "eea18f7c-64c1-36db-b0f7-7432005e53bd",
                        "target_lang_word": "pluralistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluralistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf3c09b-4ce6-34a7-bd4d-03596a5f0ee0",
                                        "entry_id": "05cc5788-a165-3dd3-acb3-e67046eaf18e",
                                        "glosses": [
                                            "die philosophische Denkrichtung des Pluralismus betreffend, auf dem Pluralismus basierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26b36c8-235c-4eb1-80b3-ac10c9888ea8",
                                                "sense_id": "8bf3c09b-4ce6-34a7-bd4d-03596a5f0ee0",
                                                "text": "Eine zu wenig pluralistische Gesellschaft erstarrt in einer leerlaufenden Staatsmaschinerie, eine zu sehr pluralistische Gesellschaft endet in staatlicher Desintegration."
                                            },
                                            {
                                                "example_id": "66c1d505-77fb-4c0a-93a3-5f65edc23f5e",
                                                "sense_id": "8bf3c09b-4ce6-34a7-bd4d-03596a5f0ee0",
                                                "text": "Entsprechend finden traditionelle historische wie pluralistisch gegenwärtige philosophische Konzeptionen innertheologische Resonanz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c68737e6-d680-3cd5-a01c-2e47764ec808",
                                        "entry_id": "05cc5788-a165-3dd3-acb3-e67046eaf18e",
                                        "glosses": [
                                            "die Vielfalt betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61319eb2-df05-42ef-a4eb-93340df4ebc8",
                                                "sense_id": "c68737e6-d680-3cd5-a01c-2e47764ec808",
                                                "text": "Paradox daran ist, dass Amerika womöglich den Kampf um die arabische Demokratie gewinnen könnte, wenn auch eher zufällig, daraus jedoch keinen Nutzen ziehen kann, weil das sich herauskristallisierende Muster der islamischen pluralistischen Politik nicht dem weltlichen, liberalen Demokratieverständnis des Westens entspricht."
                                            },
                                            {
                                                "example_id": "4346117e-fbb9-44d7-9afc-c23a9caa6347",
                                                "sense_id": "c68737e6-d680-3cd5-a01c-2e47764ec808",
                                                "text": "Die Natürlichkeitsargumentation gerät in einer pluralistischen Welt, in der eben die Zielsetzungen des menschlichen Lebens nicht homogen sind, ins Wanken."
                                            },
                                            {
                                                "example_id": "4b9ba5c3-cacf-4b17-bb80-746f5d62b02e",
                                                "sense_id": "c68737e6-d680-3cd5-a01c-2e47764ec808",
                                                "text": "Eingebunden in den Grundriss der Stadt, konnte die Architektur pluralistisch und innovativ sein."
                                            },
                                            {
                                                "example_id": "daba4b8e-1907-4951-a323-63396fc11e35",
                                                "sense_id": "c68737e6-d680-3cd5-a01c-2e47764ec808",
                                                "text": "Ein pluralistischer Markt fordert auch einen pluralistischen Überbau."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04b3de8-139f-4e0b-adfa-5e1916c43305",
                        "source_entry_id": "eea18f7c-64c1-36db-b0f7-7432005e53bd",
