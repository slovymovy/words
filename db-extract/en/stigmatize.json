                    {
                        "translation_id": "f6af58d6-1d10-4c96-bd5c-143b93d14c23",
                        "source_entry_id": "4ce9aede-c08e-3652-8ae6-05f13208db3e",
                        "source_sense_id": "e21c11c0-419b-3ed3-bd53-2a2cae029faf",
