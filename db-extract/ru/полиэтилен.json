                "senses": [
                    {
                        "sense_id": "16d6c3e8-51c7-3e22-809b-f5ea89fd40e2",
                        "entry_id": "d58679d4-84a8-31bc-b046-99682de90df2",
                        "glosses": [
                            "хим. термопластичный полимерный материал, полимер этилена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d4816c-6133-4368-ab3a-d4c891b8e381",
                                "sense_id": "16d6c3e8-51c7-3e22-809b-f5ea89fd40e2",
                                "text": "Из полиэтилена делают различные трубы, в том числе и водопроводные."
                            }
                        ]
                    },
                    {
                        "sense_id": "50f95cf2-7c94-3a33-a5a3-741bd33477f1",
                        "entry_id": "d58679d4-84a8-31bc-b046-99682de90df2",
                        "glosses": [
                            "разг. полиэтиленовая плёнка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "224d8dcf-835a-417a-be8c-feb4df3681c2",
                                "sense_id": "50f95cf2-7c94-3a33-a5a3-741bd33477f1",
                                "text": "И здесь приходилось заворачивать вещи в полиэтилен, так как к концу перехода лодка была полна воды."
                            }
                        ]
                    }
