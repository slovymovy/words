    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                    "sense_definition": "Openlijk geuite instemming, goedkeuring of steun voor iemands mening of handelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe voorstel van de directeur kreeg veel <w>bijval</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The director's new proposal received a lot of <w>support</w> during the meeting."
                            }
                        },
                        {
                            "text": "De minister was opgelucht dat haar plannen op brede <w>bijval</w> konden rekenen.",
                            "target_lang_translations": {
                                "en": "The minister was relieved that her plans could count on broad <w>approval</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "instemming",
                        "steun",
                        "goedkeuring"
                    ],
                    "antonyms": [
                        "afkeuring",
                        "tegenstand"
                    ],
                    "common_phrases": [
                        "bijval krijgen",
                        "op bijval rekenen",
                        "veel bijval oogsten"
                    ],
                    "target_lang_definitions": {
                        "en": "Openly expressed agreement, approval, or support for someone's opinion or actions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approval",
                                "target_lang_sense_clarification": "favorable agreement or support"
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "agreement or backing for an idea or person"
                            },
                            {
                                "target_lang_word": "acclaim",
                                "target_lang_sense_clarification": "enthusiastic public praise or approval"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5c791fe-0b73-30a5-b61b-16413f19343e",
                    "sense_definition": "Hoorbare uiting van waardering door een publiek, zoals handgeklap of gejuich.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "applaus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de indrukwekkende voorstelling klonk er een luidruchtige <w>bijval</w> vanuit de zaal.",
                            "target_lang_translations": {
                                "en": "After the impressive performance, loud <w>applause</w> echoed from the auditorium."
                            }
                        },
                        {
                            "text": "Het optreden van de jonge pianist werd met enthousiaste <w>bijval</w> ontvangen.",
                            "target_lang_translations": {
                                "en": "The young pianist's performance was met with enthusiastic <w>acclaim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "applaus",
                        "ovatie",
                        "handgeklap"
                    ],
                    "antonyms": [
                        "boe-geroep"
                    ],
                    "common_phrases": [
                        "luide bijval"
                    ],
                    "target_lang_definitions": {
                        "en": "Audible expression of appreciation by an audience, such as clapping or cheering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "applause",
                                "target_lang_sense_clarification": "clapping and cheering by an audience"
                            },
                            {
                                "target_lang_word": "acclamation",
                                "target_lang_sense_clarification": "loud and enthusiastic approval or cheers"
                            },
                            {
                                "target_lang_word": "cheering",
                                "target_lang_sense_clarification": "shouts of praise and encouragement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88f288e2-c2ad-33aa-9e18-f9ba8056506b",
                    "sense_definition": "Eerste persoon enkelvoud van het tegenwoordige tijd van het werkwoord <w>bijvallen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk dat ik hem in deze discussie <w>bijval</w>.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>back</w> him <w>up</w> in this discussion."
                            }
                        },
                        {
                            "text": "Als niemand anders het doet, zorg ik dat ik haar tijdens het overleg <w>bijval</w>.",
                            "target_lang_translations": {
                                "en": "If no one else does, I will make sure I <w>support</w> her during the meeting."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'bijvallen' (to agree with, to back up, or to support someone)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "first-person singular: back someone up in an argument or discussion"
                            },
                            {
                                "target_lang_word": "back up",
                                "target_lang_sense_clarification": "first-person singular: support someone's statement or position"
                            },
                            {
                                "target_lang_word": "agree with",
                                "target_lang_sense_clarification": "first-person singular: concur with or endorse someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
