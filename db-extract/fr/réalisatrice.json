                    },
                    {
                        "form_id": "1ea4ec09-94c1-4937-889b-cbdfa2a4387d",
                        "entry_id": "8f31163d-405b-30fc-8550-873c69255e07",
                        "tags": [
                            "masculine"
                        ],
                        "form": "réalisateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                        "entry_id": "8f31163d-405b-30fc-8550-873c69255e07",
                        "glosses": [
                            "Celle qui est chargée de la réalisation d’un film."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b47c99-07c4-4e27-97dd-a3153626449f",
                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                "text": "Aujourd'hui, le flambeau est fièrement repris par de talentueuses réalisatrices d’un porno joyeux et féministe : Madison Young, Erika Lust, Lucie Blush… Mais au fond, un porno féministe, c’est quoi ?"
                            },
                            {
                                "example_id": "c7832880-52a1-4bc2-bbfd-ec6c7e50af1c",
                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                "text": "Lorsque la réalisatrice me demande où nous pouvons tourner, je réponds : « Partout, sauf en hauteur. »"
                            },
                            {
                                "example_id": "c0791a6b-256d-4f08-8d2a-08b03b61d4cf",
                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                "text": "Julia revient à ce qui l’a fait connaître, confie Noémie Lefort, réalisatrice et fan de l’actrice américaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "425066d0-785e-42a9-9c14-a1ab9426314a",
                        "source_entry_id": "8f31163d-405b-30fc-8550-873c69255e07",
                        "source_sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                        "target_lang_word": "Regisseurin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regisseurin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                        "entry_id": "ec9e305a-22c0-3022-b60a-5314a434c5ee",
                                        "glosses": [
                                            "weibliche Person, die die Regie führt, die (künstlerische) Leitung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc0582b-9f85-4174-879f-cf424f1d0b58",
                                                "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                                "text": "„Nach der Aufführung erzählte er der Regisseurin, was er an der Figur des Tempelherrn Besonderes herausgefunden hatte, denn er habe ja bis auf einen Monolog nichts wirklich Weltbewegendes zu sagen.“"
                                            },
                                            {
                                                "example_id": "60c5d2ee-c647-454a-bc40-56f34470d3cc",
                                                "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                                "text": "„Leni Riefenstahl war eine 1902 in Berlin geborene deutsche Tänzerin, Schauspielerin, Regisseurin und Fotografin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
