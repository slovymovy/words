                        "entry_id": "8eff0283-47dc-3724-ab9c-ef3b504b0226",
                        "glosses": [
                            "Dreamland, fantasy land."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6f32f6-31c7-4ed5-a6fd-ff58a0c11740",
                                "sense_id": "0fb431df-aa9a-316c-a154-932aedb9e2d3",
                                "text": "Glittering castles in Spain were shaping themselves out of the mists and rainbows of her lively fancy; adventures wonderful and enthralling were happening to her in cloudland—adventures that always turned out triumphantly and never involved her in scrapes like those of actual life."
                            },
                            {
                                "example_id": "09a0300e-c141-413b-9e91-3049c99ac9d4",
                                "sense_id": "0fb431df-aa9a-316c-a154-932aedb9e2d3",
                                "text": "Wide awake, all at once, he was at the same time plunged even deeper into a cloudland of symbols to which he had no key."
                            },
                            {
                                "example_id": "7257ac7c-de17-4bfb-aa08-c0524c799c50",
                                "sense_id": "0fb431df-aa9a-316c-a154-932aedb9e2d3",
                                "text": "Nothing can be more like a ride in cloudland than the drive from Pierrefitte to Luz and from Luz to Gavarnie."
                            }
                        ]
                    }
                ],
