                ],
                "translations": [
                    {
                        "translation_id": "454c0592-bc8b-48e2-a0df-a46669f187fa",
                        "source_entry_id": "cd04427f-b2ad-360f-aa03-ff8dcaf58d5b",
                        "source_sense_id": "63538ab0-1467-36bb-8d48-4a38bcddcd8f",
                        "target_lang_word": "sharia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "589d803f-d8e7-3721-8f9e-192256b6736b",
                                        "entry_id": "4720d592-dcca-355f-9919-a85ac93f2db9",
                                        "glosses": [
                                            "Alternative spelling of shari'a."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c038aac3-65ae-4ae3-979e-ec2fa4e77ebd",
                                                "sense_id": "589d803f-d8e7-3721-8f9e-192256b6736b",
                                                "text": "After all, Usamah had served the sadist Zangi and, if read in full, his account presents a picture of Islamic violence no less shocking to modern sensibilities: the collecting of Christian heads, the crucifying and bisections of their own soldiers and heretics, the severe punishments of Islamic sharia – and the story of how his father, in a rage, lopped off the arm of his page."
                                            },
                                            {
                                                "example_id": "d5dc27e9-376d-4356-b95e-f6c0c1ad91c9",
                                                "sense_id": "589d803f-d8e7-3721-8f9e-192256b6736b",
                                                "text": "Unlike in Somalia, Iraq and Afghanistan, in Yemen they are trying to implement sharia by winning over the hearts and minds of the people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0266224c-33cf-4831-bb20-b599967192b4",
                        "source_entry_id": "cd04427f-b2ad-360f-aa03-ff8dcaf58d5b",
                        "source_sense_id": "63538ab0-1467-36bb-8d48-4a38bcddcd8f",
                        "target_lang_word": "šaría",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8ea44749-4b00-42ae-a976-6ebc43dd87d4",
                        "source_entry_id": "cd04427f-b2ad-360f-aa03-ff8dcaf58d5b",
                        "source_sense_id": "63538ab0-1467-36bb-8d48-4a38bcddcd8f",
                        "target_lang_word": "Scharia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "651577f9-5900-3fb9-8464-85fd7120fe00",
                                        "entry_id": "0969b4db-01f0-3bda-a67d-37fd6ed6354b",
                                        "glosses": [
                                            "der Weg zur Wasserstelle, eine Art islamischer Katechismus"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eb3f5b4-504d-452d-a178-c146bb236527",
                                                "sense_id": "651577f9-5900-3fb9-8464-85fd7120fe00",
                                                "text": "Die Scharia ist für Muslime Leitschnur in allen Lebensbereichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65105438-99a2-36a8-b71b-de9729ba056f",
                                        "entry_id": "0969b4db-01f0-3bda-a67d-37fd6ed6354b",
                                        "glosses": [
                                            "koranische Bestimmungen und Fatwa (religiöse Gutachten, islamische Rechtsmeinung) der Mufti (islamischen Religionsgelehrten)"
                                        ],
                                        "tags": [
                                            "Islamische Rechtslehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "047f0e2d-217c-44a8-bbed-5554c3d8ea2f",
                                                "sense_id": "65105438-99a2-36a8-b71b-de9729ba056f",
                                                "text": "Die Scharia ist nur für Muslime anwendbar, so wie der christliche Katechismus nur für Christen."
                                            },
                                            {
                                                "example_id": "39357478-36d0-4a43-8545-7ca563f5e7c2",
                                                "sense_id": "65105438-99a2-36a8-b71b-de9729ba056f",
                                                "text": "Die Scharia strebt an, die Rechte und Pflichten der Muslime in allen Lebensbereichen zu regeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "26622f18-da5d-3aec-93e4-5b8498a767e9",
                                        "entry_id": "0969b4db-01f0-3bda-a67d-37fd6ed6354b",
                                        "glosses": [
                                            "im Sinne von geltendem Recht, zum Beispiel im Familienrecht"
                                        ],
                                        "tags": [
                                            "Islamische Gesetzgebung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f6a693-536d-4e6b-8382-1b306094cba2",
                                                "sense_id": "26622f18-da5d-3aec-93e4-5b8498a767e9",
                                                "text": "Die Scharia ist nur für Muslime anwendbar, so wie der christliche Katechismus nur für Christen."
                                            },
                                            {
                                                "example_id": "a16df4d4-7e6a-420c-ac18-e3f5117708d4",
                                                "sense_id": "26622f18-da5d-3aec-93e4-5b8498a767e9",
                                                "text": "„Daraufhin erließ eine weitere islamistische Gruppe eine Fatwa gegen das Buch mit der Begründung, es verstieße gegen die Gesetze der Scharia und bezweifle die Existenz Gottes.“"
                                            },
                                            {
                                                "example_id": "29fb0217-d653-47e0-b197-eae91a00b609",
                                                "sense_id": "26622f18-da5d-3aec-93e4-5b8498a767e9",
                                                "text": "„Vor allem die Einführung der Scharia, also des islamischen Rechtssystems, in einigen Staaten Afrikas - wie zum Beispiel im Sudan oder in Nordnigeria - hat die überdimensionierte Rolle des Mannes weiter gefestigt und die der Frau geschwächt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
