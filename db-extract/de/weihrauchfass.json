                "senses": [
                    {
                        "sense_id": "706ec195-add0-3412-91a9-22bdc2c8a2a8",
                        "entry_id": "34de6a53-a2c8-3475-ab56-49aa2084fcb1",
                        "glosses": [
                            "Gefäß an einer Kettenkonstruktion, das zur Verbrennung von Weihrauch verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf8e60c-5d2a-4c5e-92cd-c882b60f42a4",
                                "sense_id": "706ec195-add0-3412-91a9-22bdc2c8a2a8",
                                "text": "„Der Indianer hob die Schildkröte hoch und schwang sie wie ein Weihrauchfass vor sich her.“"
                            },
                            {
                                "example_id": "c6f2d188-fab7-4ea3-ba3c-151f53af89c6",
                                "sense_id": "706ec195-add0-3412-91a9-22bdc2c8a2a8",
                                "text": "„Höher und höher zieht die Prozession, und alle schwingen sie wohlriechende Weihrauchfässer und tragen brennende Kerzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfbe857c-2785-40bd-a7b1-102299baa6da",
                        "source_entry_id": "34de6a53-a2c8-3475-ab56-49aa2084fcb1",
