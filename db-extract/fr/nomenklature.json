            {
                "entry_id": "11709e69-9710-39ef-88b1-1091ea91a05b",
                "word": "nomenklature",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3bf7cfc0-3990-41e2-b127-9beb1fefd496",
                        "entry_id": "11709e69-9710-39ef-88b1-1091ea91a05b",
                        "tags": [
                            "plural"
                        ],
                        "form": "nomenklatures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87f987bd-096b-3ff0-bac8-2b8d6b353d26",
                        "entry_id": "11709e69-9710-39ef-88b1-1091ea91a05b",
                        "glosses": [
                            "Variante de nomenklatura, désignant l’ensemble des dignitaires du pouvoir."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe81c66-de65-456a-84f9-b6de16247297",
                                "sense_id": "87f987bd-096b-3ff0-bac8-2b8d6b353d26",
                                "text": "Membre influent de l’ancienne nomenklature, Malek a été un big brother particulièrement redouté au temps du parti unique."
                            },
                            {
                                "example_id": "4c8173bd-1386-4f7e-960a-17eeb009c84a",
                                "sense_id": "87f987bd-096b-3ff0-bac8-2b8d6b353d26",
                                "text": "Elle a vécu et puis est morte à l’écart des fastes de la nomenklature. A l’âge de 78 ans, l’ancienne militante de la Bataille d’Alger s’est éteinte hier à l’aube, à la clinique El Azhar d’Alger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35bf15e8-c9fc-4272-a1c3-1ccb86021028",
                        "source_entry_id": "11709e69-9710-39ef-88b1-1091ea91a05b",
                        "source_sense_id": "87f987bd-096b-3ff0-bac8-2b8d6b353d26",
                        "target_lang_word": "nomenklatura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomenklatura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94bbba38-9423-3379-98c7-0382c3dd1ff0",
                                        "entry_id": "731d26bf-fe6b-3ec7-aa55-ea48e552d801",
                                        "glosses": [
                                            "A list of bureaucratic posts in government and industry in the former Soviet Union and other communist countries, filled by those appointed by the Party."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "081f87d6-de65-301b-bde6-274f6fd834e7",
                                        "entry_id": "731d26bf-fe6b-3ec7-aa55-ea48e552d801",
                                        "glosses": [
                                            "The people on such lists; (by extension), any privileged class, a social or political elite."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e3d6f8-9f50-4ddd-807b-8ad30f9eb6aa",
                                                "sense_id": "081f87d6-de65-301b-bde6-274f6fd834e7",
                                                "text": "[Gorbachev] did not champion perestroika and glasnost alone; much of the nomenklatura had decided that the Soviet economic and social model was dysfunctional, corrupt and endemically inefficient and had to change."
                                            },
                                            {
                                                "example_id": "e9bf7345-46d2-42af-a418-73577d23fa09",
                                                "sense_id": "081f87d6-de65-301b-bde6-274f6fd834e7",
                                                "text": "Communism envisioned […] an Authority Ranking of political control (in theory, the dictatorship of the proletariat; in practice, a nomenklatura of commissars under a charismatic dictator)."
                                            },
                                            {
                                                "example_id": "7e678973-f0b0-4177-840b-8cd9a47bf4f4",
                                                "sense_id": "081f87d6-de65-301b-bde6-274f6fd834e7",
                                                "text": "During the long rule of Leonid Brezhnev (1964–1982), the nomenklatura had cemented their power in the system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0311b0d8-e094-401c-bec7-c284f59358b0",
                        "source_entry_id": "11709e69-9710-39ef-88b1-1091ea91a05b",
                        "source_sense_id": "87f987bd-096b-3ff0-bac8-2b8d6b353d26",
                        "target_lang_word": "номенклату́ра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "номенклату́ра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44f095fd-81db-3fb2-ba62-d8526841a74b",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "перечень названий, терминов, категорий, употребляемых в какой-либо отрасли науки, техники"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00ded20-4f81-4f62-aca2-3b1bb93e5e43",
                                                "sense_id": "44f095fd-81db-3fb2-ba62-d8526841a74b",
                                                "text": "Прежде чем перейти к анализу некоторых из этих синдромов, необходимо описать общепринятую номенклатуру кариотипа человека."
                                            },
                                            {
                                                "example_id": "27728c50-3bb5-4f61-ba3e-d9cc48ff41ab",
                                                "sense_id": "44f095fd-81db-3fb2-ba62-d8526841a74b",
                                                "text": "В нём даются рекомендации по проведению видов геологической деятельности и унификации представления результатов: номенклатура видов исследования и их описание: географические и водные названия, терминология, используемый стиль языка, длина слов и предложений, грамматика и синтаксис языка; представление графических материалов: диаграмм, графиков, карт, оформление отчётов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13bd0ea7-7563-38ad-a150-840b4474c72b",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "экон. перечень ассортиментных групп производственного или торгового предприятия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6fb5540-3da6-406a-930d-09002d7239de",
                                                "sense_id": "13bd0ea7-7563-38ad-a150-840b4474c72b",
                                                "text": "\"Мы активно ведём переговоры с Синарским трубным заводом, производящим непересекающуюся с нами номенклатуру."
                                            },
                                            {
                                                "example_id": "83cc9223-4572-46a7-a017-9bc121f9efc5",
                                                "sense_id": "13bd0ea7-7563-38ad-a150-840b4474c72b",
                                                "text": "— В номенклатуру изделий прессового цеха № 2 входят шайбы, прокладки, различные вкладыши и так далее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc9d842-24c3-3ffe-9d48-5cec4e452ee8",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "перечень должностей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c04f5f7-bfbc-450b-b6aa-37148d341ba6",
                                                "sense_id": "adc9d842-24c3-3ffe-9d48-5cec4e452ee8",
                                                "text": "Если прибавить к сделанной мною номенклатуре либеральных министров того самого фельдмаршала князя Барятинского, который не прочь был играть роль политического центра, но всё-таки с оттенками западного либерализма, то само собою разумеется, что перевес в среде правительственной партии либералов над консерваторами был несомненен."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792cbf7e-6d14-3de6-b2ba-f7eca2823800",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "круг должностных лиц согласно номенклатуре [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ba7806-5626-45f7-8c6d-1ca08a6f6f01",
                                                "sense_id": "792cbf7e-6d14-3de6-b2ba-f7eca2823800",
                                                "text": "«Он был упразднён немногочисленной верхушкой руководителей и высшей номенклатурой по причинам, связанным в первую очередь с собственностью и властью»."
                                            },
                                            {
                                                "example_id": "7df0c774-203b-4d6f-809f-be1f82487dcc",
                                                "sense_id": "792cbf7e-6d14-3de6-b2ba-f7eca2823800",
                                                "text": "В застойном 1982-м он «всплыл» уже как представитель советской номенклатуры: инструктор, заместитель, затем заворготделом исполкома Ленсовета."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd7af449-dab2-3b7f-a082-2bca93b47e59",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "ограниченный круг, подборка людей, предназначенный для занятия ограниченного набора должностей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c5e15e-0927-47e6-b9e2-06ba1b9de6a8",
                                                "sense_id": "fd7af449-dab2-3b7f-a082-2bca93b47e59",
                                                "text": "Так вдруг оказался в числе «работников номенклатуры»."
                                            },
                                            {
                                                "example_id": "530f5655-a6bf-48a5-a5f9-9ea76f0dd647",
                                                "sense_id": "fd7af449-dab2-3b7f-a082-2bca93b47e59",
                                                "text": "Ну, оступилась, сошла с Доски почёта, так что ж, навек она выпала из вашей номенклатуры?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5d73921-6a3c-388a-a442-a1a185608a81",
                                        "entry_id": "26ac9d9e-2d7f-36d8-9182-a5448475d6d4",
                                        "glosses": [
                                            "полит. номенклатура [5], выделившаяся в социальную группу с ярко выраженными корпоративными интересами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5351fd27-adcd-4add-a33e-f1704583b635",
                                                "sense_id": "d5d73921-6a3c-388a-a442-a1a185608a81",
                                                "text": "Номенклатура бессмертна до тех пор, пока она не будет обуздана новой, цивилизованной, по-настоящему рыночной экономикой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
