                        "form": "toas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b490e278-33fc-3c2d-af0b-19a2677591ff",
                        "entry_id": "a8d8f85f-6a22-3aff-bd06-209248aaa39f",
                        "glosses": [
                            "A brave warrior."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "527e71f5-d1cc-442d-962f-3c344d16a8d3",
                                "sense_id": "b490e278-33fc-3c2d-af0b-19a2677591ff",
                                "text": "The toa or brave who distinguished himself was thought very highly of."
                            },
                            {
                                "example_id": "5f10b214-aae8-414f-a6fb-7fbd6fe221cf",
                                "sense_id": "b490e278-33fc-3c2d-af0b-19a2677591ff",
                                "text": "Thus in Polynesia, the toa (warrior) could challenge the ariki (priest/chief)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c6882806-d6e6-3989-81c6-dde3176073f0",
                "word": "toa",
