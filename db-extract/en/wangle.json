                        "source_entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "source_sense_description": "obtain through manipulative of deceitful methods",
                        "target_lang_word": "carotter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carotter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96972e04-e7bc-3b77-beac-5747e8139e6a",
                                        "entry_id": "389d280c-0d26-32f1-9329-bec418442784",
                                        "glosses": [
                                            "Carotter quelque chose à quelqu’un : lui extorquer cette chose, en abusant de sa bonne foi."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b85234-42c0-421c-9444-5f9d25f8b6cf",
                                                "sense_id": "96972e04-e7bc-3b77-beac-5747e8139e6a",
                                                "text": "Je ramasse ce qu’on me donne, en rougissant, et j’entends le marchand de vin qui dit à sa femme :\n— Il voulait me carotter un canon, ce mufle-là !"
                                            },
                                            {
                                                "example_id": "a2447ed5-ea41-4741-bdfa-6cb38297294d",
                                                "sense_id": "96972e04-e7bc-3b77-beac-5747e8139e6a",
                                                "text": "Va donc jusqu’au village, et rapporte-moi un litre de lait. Tiens, voilà des sous. Et tâche de ne pas me carotter la monnaie ! Je connais les prix !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13bd9b1d-e807-3aa2-a2d0-49556d7c378e",
                                        "entry_id": "389d280c-0d26-32f1-9329-bec418442784",
                                        "glosses": [
                                            "Carotter quelqu’un : l’escroquer, l’abuser, le tromper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea92c737-b2d2-4967-bc11-86f1790cc173",
                                                "sense_id": "13bd9b1d-e807-3aa2-a2d0-49556d7c378e",
                                                "text": "— Quand on fait la sainte-nitouche, comme vous, on devrait au moins, après avoir carotté des personnes bienfaisantes, ne pas les appeler vieilles tourtes !"
                                            },
                                            {
                                                "example_id": "058896aa-c635-4135-ac41-33815dd3fdf8",
                                                "sense_id": "13bd9b1d-e807-3aa2-a2d0-49556d7c378e",
                                                "text": "Ce tambour-major était une brute très simple. Pas méchant au fond, facile à carotter, il se rehaussait devant les recrues par des propos d’une obscénité compliquée auprès desquels les plaisanteries de la chambrée semblaient ingénues comme l’eau des rochers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c4f4e7-1551-3e6a-aa33-3f7383e8b864",
                                        "entry_id": "389d280c-0d26-32f1-9329-bec418442784",
                                        "glosses": [
                                            "Faire un carottage, prélever un échantillon cylindrique (une carotte) de terrain, banquise, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "334f0e9e-0c89-3af1-bee9-7f40f06bb0c3",
                                        "entry_id": "389d280c-0d26-32f1-9329-bec418442784",
                                        "glosses": [
                                            "Jouer mesquinement, ne hasarder que peu d’argent à la fois."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2776b7d8-d9e7-4c03-b330-2c8754dfd7ff",
                                                "sense_id": "334f0e9e-0c89-3af1-bee9-7f40f06bb0c3",
                                                "text": "Ce colonel est habitué par votre Restauration […] à rester en demi-solde, il sera très-heureux de vivre avec Dumay en carottant au Havre, il donnera certainement ses trois cent mille francs à la petite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
