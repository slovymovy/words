                        "entry_id": "e9767142-90fa-3a26-b844-1beb67db776b",
                        "glosses": [
                            "A bombproof chamber, usually of masonry, in which cannon may be placed, to be fired through embrasures; or one capable of being used as a magazine, or for quartering troops."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9641b4b3-7601-351c-bbd5-f70a43707419",
                        "entry_id": "e9767142-90fa-3a26-b844-1beb67db776b",
                        "glosses": [
                            "A hollow molding, chiefly in cornices."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75bb69a4-36b6-4156-9167-ae2910fad315",
                        "source_entry_id": "e9767142-90fa-3a26-b844-1beb67db776b",
                        "source_sense_description": "bombproof chamber as part of fortification",
                        "target_lang_word": "kazemat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazemat",
