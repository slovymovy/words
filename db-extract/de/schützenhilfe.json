                ],
                "senses": [
                    {
                        "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                        "entry_id": "6c7cfad8-e0c5-3cc6-9d2a-df6e08740e69",
                        "glosses": [
                            "umgangssprachlich die Unterstützung bzw. das Handeln schützende und fördernde Verhalten von jemandem anderen bei einem eigenen Vorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6fe765c-b22d-4095-879c-70104dec7f3a",
                                "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                                "text": "Wir werden Ihnen Schützenhilfe gewähren."
                            },
                            {
                                "example_id": "2e5f9a65-0948-40b9-be81-089fb84fc53b",
                                "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                                "text": "Ich habe von ihm Schützenhilfe erhalten."
                            },
                            {
                                "example_id": "7b21aef4-58e2-4b30-a644-387e037b5547",
                                "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                                "text": "„Um doch noch das Viertelfinale zu erreichen, müssen die Deutschen gegen Weltmeister Russland gewinnen und auf Schützenhilfe der Konkurrenz hoffen.“"
                            },
                            {
                                "example_id": "97c2110e-1aa0-4a80-81be-31dc814c8ab2",
                                "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                                "text": "„Rasch eilten ihre Freunde herbei, um ihnen Schützenhilfe zu gewähren.“"
                            },
                            {
                                "example_id": "e26dd33f-cf49-4db9-a650-96b1f8bc14dd",
                                "sense_id": "25770589-426f-32e6-8523-afbd02dd092b",
                                "text": "„In diesem kritischen Moment hatte unser Freund Schützenhilfe von einer Seite erhalten, von der er keine erwartete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
