                        "source_sense_description": "Nautik: diejenige Pumpe, die die Bilge, also den untersten Teil des Schiffes, trocken hält",
                        "target_lang_word": "pompe de cale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompe de cale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bdd5595-26fa-3ce2-9934-be3b773afe27",
                                        "entry_id": "9f69cad4-2001-3424-aeb8-cd47d79a01f3",
                                        "glosses": [
                                            "Pompe destinée à évacuer l’eau présente dans la cale d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c2462b-b445-4c65-a596-6a175343fde4",
                                                "sense_id": "6bdd5595-26fa-3ce2-9934-be3b773afe27",
                                                "text": "Ces petits détails sont vicieux, ainsi que la position au-dessous du niveau de la mer de l’orifice du tuyau de décharge du condenseur et de celui de la pompe de cale."
                                            },
                                            {
                                                "example_id": "dba5a4b2-48de-4698-9aaf-efef6b15b0b9",
                                                "sense_id": "6bdd5595-26fa-3ce2-9934-be3b773afe27",
                                                "text": "Les bateaux à moteur et les voiliers de plaisance sont en général équipés de deux pompes de cale, une manuelle et une électrique."
                                            },
                                            {
                                                "example_id": "e10532b3-d7a5-4e59-9840-8a71e687010e",
                                                "sense_id": "6bdd5595-26fa-3ce2-9934-be3b773afe27",
                                                "text": "Du simple entretien à la maîtrise d’une petite voie d’eau, les pompes de cale sont des équipements indispensables à bord. Manuelles ou électriques, voire automatiques, différentes possibilités sont proposées."
                                            },
                                            {
                                                "example_id": "467d325b-e336-434e-92be-3ae3b84f364b",
                                                "sense_id": "6bdd5595-26fa-3ce2-9934-be3b773afe27",
                                                "text": "Dans le nuit du 24 au 25 août, le vieux gréement \"Le Jusqu’au Bout\" a subi une avarie sur sa pompe de cale menaçant de faire couler le bateau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
