                        "entry_id": "19671773-b1ee-3aae-b8a2-ddc5885ffc11",
                        "glosses": [
                            "verbreed en dan spits toelopend plat uiteinde aan de arm van een anker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d479b3c-188f-4b7d-a9d5-2a6ef466b858",
                                "sense_id": "2c501734-dd9b-321e-aa9e-c3526bedb3f8",
                                "text": "Daar 't anker vrij langs vreemde kusten den wem in afgronds boezem grift, (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae463237-08eb-4c77-97bf-5399f289164f",
                        "source_entry_id": "19671773-b1ee-3aae-b8a2-ddc5885ffc11",
                        "source_sense_id": "2c501734-dd9b-321e-aa9e-c3526bedb3f8",
                        "target_lang_word": "Flunke",
