                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1782b8f4-276a-309c-af7e-e909d8137962",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Que promueve las ideas del bando bolchevique₅."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fffc5e2-fb55-42f4-9b18-2687315d46af",
                                                "sense_id": "1782b8f4-276a-309c-af7e-e909d8137962",
                                                "text": "En más de una oportunidad la Federación criticó tanto a los comunistas, a quienes denominaba ‘bolcheviques’, como al periódico ‘El Eco de Chancay’ que era su portavoz oficioso."
                                            }
