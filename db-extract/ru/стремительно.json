        "ru-extract.jsonl": [
            {
                "entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                "word": "стремительно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "glosses": [
                            "наречие к стремительный; с большой скоростью, очень резко и быстро"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "0015aee3-ed39-4253-b635-2b7f60ee3798",
                                "sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                                "text": "Батарейцы спешно начали примыкать штыки к ружьям, готовясь отразить атаку стремительно приближавшихся немцев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4e47ae2-e8e7-46aa-8727-3434cd376638",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "like a shot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "like a shot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24108fde-cac4-3351-b668-338b26184709",
                                        "entry_id": "2cf95aaf-00a3-3109-8702-8fc94f30f582",
                                        "glosses": [
                                            "suddenly; without delay or hesitation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cebbe75c-aa7c-46ec-9714-1931dde51bb4",
                                                "sense_id": "24108fde-cac4-3351-b668-338b26184709",
                                                "text": "I went over the fence like a shot, and ran like one o'clock for the trap, cussing and swearing as I went."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "028c08a8-dbb8-4524-b31b-da76931895e0",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "like hell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "like hell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4fb7a38-89e2-3763-afeb-166afa82c932",
                                        "entry_id": "5e8a3679-2dbf-378a-a79c-c3134b56934c",
                                        "glosses": [
                                            "In a manner that uses all of the strength, speed, or effort that a person can summon."
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "intensifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6cf99c0-f2db-456c-abec-010654aa775c",
                                                "sense_id": "c4fb7a38-89e2-3763-afeb-166afa82c932",
                                                "text": "You'd better run like hell!"
                                            },
                                            {
                                                "example_id": "e05f505a-53d8-4891-920b-23b9222195b3",
                                                "sense_id": "c4fb7a38-89e2-3763-afeb-166afa82c932",
                                                "text": "He had an innate honesty and humility, a work ethic that elevated him above most others in England. He knew what he wanted and worked like hell to try to make it happen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c76fce-c91a-33cb-a1fb-783c278a23f7",
                                        "entry_id": "5e8a3679-2dbf-378a-a79c-c3134b56934c",
                                        "glosses": [
                                            "Used ironically to express the opposite of one's intentions"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f499ecf5-adba-4d8e-80fa-9b813105dc12",
                                                "sense_id": "35c76fce-c91a-33cb-a1fb-783c278a23f7",
                                                "text": "Me do the washing up? Like hell I will!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e24c8f8-f68e-30b7-aa87-70c679a7ece4",
                                        "entry_id": "5e8a3679-2dbf-378a-a79c-c3134b56934c",
                                        "glosses": [
                                            "Bad or badly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "526b2191-fa80-4b94-a881-2f40df179b12",
                                                "sense_id": "9e24c8f8-f68e-30b7-aa87-70c679a7ece4",
                                                "text": "You look like hell!"
                                            },
                                            {
                                                "example_id": "a5334f73-4257-4d18-9c93-c06ace8c4cae",
                                                "sense_id": "9e24c8f8-f68e-30b7-aa87-70c679a7ece4",
                                                "text": "It stank like hell down there!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b91f6f06-9d33-4509-b536-c2fa1221479c",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "like the wind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "like the wind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a15eff8-319a-30da-8593-f198636a3951",
                                        "entry_id": "96fa31da-132c-3946-afa4-67a4dc4a8062",
                                        "glosses": [
                                            "quickly, at a high speed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018885e5-afa0-4d74-bc07-4d0e446ff957",
                                                "sense_id": "3a15eff8-319a-30da-8593-f198636a3951",
                                                "text": "At any rate, in my experience, they could run like the wind, but longer and heavier trains slowly but surely became too much for them."
                                            },
                                            {
                                                "example_id": "8f1bac6a-dbea-433e-9bec-0f926bfbd69e",
                                                "sense_id": "3a15eff8-319a-30da-8593-f198636a3951",
                                                "text": "Although we took our eight bogies along to Whitstable at 60 m.p.h., and made a clean start from there, after Herne Bay the engine primed badly on Blacksole Bank and nearly stopped before we got over the top. Then we ran like the wind across the marshes with half-regulator, 30 per cent cut-off, and the engine blowing off."
                                            },
                                            {
                                                "example_id": "ac053dfc-b934-4709-b5c4-fac671f74972",
                                                "sense_id": "3a15eff8-319a-30da-8593-f198636a3951",
                                                "text": "How she would fly like the wind, up that road in front of the house, and away."
                                            },
                                            {
                                                "example_id": "31270d92-c40c-4495-8b8b-c385534e8657",
                                                "sense_id": "3a15eff8-319a-30da-8593-f198636a3951",
                                                "text": "Even if I don't run like the wind I have my own bag of tricks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b07015d-eb91-3ae1-b4fd-4c12cbd5056d",
                                        "entry_id": "96fa31da-132c-3946-afa4-67a4dc4a8062",
                                        "glosses": [
                                            "changeably, freely and at liberty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef311fb2-0090-3da7-a764-1d6679a31ab3",
                                        "entry_id": "96fa31da-132c-3946-afa4-67a4dc4a8062",
                                        "glosses": [
                                            "invisibly, mysteriously, unpredictably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf54d3a7-0048-40d4-85ce-e8ac6cbda0b0",
                                                "sense_id": "ef311fb2-0090-3da7-a764-1d6679a31ab3",
                                                "text": "The Spirit Of God is like the wind. Note well that his operation is unexpected. The wind bloweth where it listeth, so that thou knowest not what wind to expect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed794f70-d2ca-4384-8d8c-2fe4bdb62ab8",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "trick and fast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b323755-6896-485e-99ba-2242e8dd5ea2",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "like mad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "like mad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                        "entry_id": "dea37fae-6723-3c6e-adff-3d79fa992763",
                                        "glosses": [
                                            "Like a mad person; in a furious or deranged manner; to a great or excessive degree; with great enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da883a48-254e-4084-a38f-c777b4ffac11",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "We poked a stick into the hornets' nest and ran like mad."
                                            },
                                            {
                                                "example_id": "194a4b46-cb9f-4ddd-b911-4db665e3b8ca",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "They neuer linne to scrape our goodes / till all our wealth be gone. / Which if we chaunce to sée, / excuses then are had: / But so we sée not when ’tis done, / they will denie like mad / They neuer toke away / one iote but was their owne:"
                                            },
                                            {
                                                "example_id": "0cf8d4cb-7f43-4853-84fd-7cf6d2d1b02a",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "The Devils fell upon the Damn’d; and the Damn’d fell upon the Devils, without knowing One from t’other: and all running helter-skelter, to and again, like Mad; for in fine, it was no other then a general Revolt."
                                            },
                                            {
                                                "example_id": "2a3fc3bf-0bab-4460-8151-006a4ebe2587",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "There were divers Antick Figures, some with Caps and Bells, one dress’d like a Punch; several Harlequins, and other ludicrous Forms, that jump’d and ran about like mad; and seem’d as if they would have it thought, that all their Wit lay in their Heels."
                                            },
                                            {
                                                "example_id": "a428377a-4ae0-4f64-9746-cf261cef628c",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "When Bildad was a chief-mate, to have his drab-coloured eye intently looking at you, made you feel completely nervous, till you could clutch something—a hammer or a marling-spike, and go to work like mad, at something or other, never mind what."
                                            },
                                            {
                                                "example_id": "812122b1-f791-41a7-8037-7ef57b51864e",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "All the universities are sending in long petitions to restrict their production. Otherwise, they say, mankind will become extinct through lack of fertility. But the R. U. R. shareholders, of course, won't hear of it. All the governments, on the other hand, are clamoring for an increase in production, to raise the standards of their armies. And all the manufacturers in the world are ordering Robots like mad."
                                            },
                                            {
                                                "example_id": "0ace33b7-a78d-4a84-9a61-78b75e098b5c",
                                                "sense_id": "54ffc8db-4ac0-3ec7-ac92-af4facc26306",
                                                "text": "I’d laughed. He’d laughed. Mine lasted the longest. During it, I thought it was going to change into a cry. But it didn’t. My eyes blinked like mad but then it was okay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
