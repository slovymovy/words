                "senses": [
                    {
                        "sense_id": "3b7097c0-7b58-3c36-be8f-fce61837989d",
                        "entry_id": "9a5da11c-5081-3b6f-aac8-48153ee06802",
                        "glosses": [
                            "über dem Mund angebrachte Maske zur Versorgung eines Menschen mit Sauerstoff, Anästhetika oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d02dea-d42f-4211-ae92-615feb1b3119",
                                "sense_id": "3b7097c0-7b58-3c36-be8f-fce61837989d",
                                "text": "[Anja Blacha:] „2019 stand sie (ohne Atemmaske) als erste deutsche Bergsteigerin auf dem K2, dem mit 8611 Metern zweithöchsten Berg der Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04007988-2757-3793-b76a-dc00e61a7652",
                        "entry_id": "9a5da11c-5081-3b6f-aac8-48153ee06802",
                        "glosses": [
                            "vor dem Mund angebrachte Maske zum Schutz vor gesundheitsgefährdenden Stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d48dc05-f304-444d-a24c-7370407ed243",
                                "sense_id": "04007988-2757-3793-b76a-dc00e61a7652",
                                "text": "[Coronapandemie 2020:] „Mehrere Textilunternehmen haben ihre Produktion kurzfristig umgestellt. Statt Unterwäsche oder Poloshirts stellen sie jetzt Atemmasken her.“"
                            },
                            {
                                "example_id": "73f4889d-a85e-40d2-bac3-4bffaee38351",
                                "sense_id": "04007988-2757-3793-b76a-dc00e61a7652",
                                "text": "[Coronapandemie 2020:] „Sehr relevant ist es, das Gesundheitspersonal zu schützen. Ganz hohe Priorität hat die Verfügbarkeit von Schutzanzügen, von Atemmasken, da gibt es nach wie vor Versorgungsengpässe.“"
                            },
                            {
                                "example_id": "1283d83f-ba89-44ee-bcf6-bd187edacd42",
                                "sense_id": "04007988-2757-3793-b76a-dc00e61a7652",
                                "text": "[Coronapandemie 2020:] „Die deutsche Bundesregierung untersagte nun die Ausfuhr etwa von Atemmasken, Handschuhe und Schutzanzüge.“"
                            },
                            {
                                "example_id": "e9f46d78-1ccb-4aeb-adb8-1a11164fce30",
                                "sense_id": "04007988-2757-3793-b76a-dc00e61a7652",
                                "text": "„Mit seiner Atemmaske und der Grubenlampe sah er aus wie ein Dämon.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
