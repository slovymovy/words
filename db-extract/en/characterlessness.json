                        "source_sense_id": "9a4660ed-56b2-3803-80fb-2eaadbeba4ba",
                        "source_sense_description": "state or condition of being characterless; lack of character",
                        "target_lang_word": "Charakterlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charakterlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b19de8d-d02f-383e-b64e-e2e81ed3bd0a",
                                        "entry_id": "1563ef88-2927-3fab-93a7-df08d2217255",
                                        "glosses": [
                                            "abweisender, würdeloser Charakter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58a743e-a236-4020-851e-22536e9b26c2",
                                                "sense_id": "0b19de8d-d02f-383e-b64e-e2e81ed3bd0a",
                                                "text": "„Die Welt ist bekanntlich zu einem unwirtlichen Ort geworden, in dem Menschen für ihre Charakterlosigkeit nicht verachtet, sondern in höchste Staatsämter gewählt werden.“"
                                            },
                                            {
                                                "example_id": "abf9dc4d-22f5-4982-97cb-22ec0b7141a6",
                                                "sense_id": "0b19de8d-d02f-383e-b64e-e2e81ed3bd0a",
                                                "text": "„Wer Donald Trump schlagen möchte, muss diese Frage beantworten: Wie bekomme ich die Menschen dazu, am Wahltag ein Urteil über die Verfehlungen und die Charakterlosigkeit des Präsidenten zu fällen?“"
                                            },
                                            {
                                                "example_id": "0967e656-fe46-4eac-822a-2c16b0a5878e",
                                                "sense_id": "0b19de8d-d02f-383e-b64e-e2e81ed3bd0a",
                                                "text": "„‚Schmerzensgeld‘, hätte man früher gesagt, schließlich galt Frankfurt als kalt und trist, von Kriegs- und Nachkriegszerstörungen bis zur Charakterlosigkeit entstellt.“"
                                            },
                                            {
                                                "example_id": "d3710ce6-fe18-4d15-9e7f-4da9dde12112",
                                                "sense_id": "0b19de8d-d02f-383e-b64e-e2e81ed3bd0a",
                                                "text": "„Nichts leichter weiterhin, als de Sade einen Mann von schwankendem Charakter, wenn nicht gar von oft empörender Charakterlosigkeit zu nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29d92929-35e9-3387-b593-8059c922f0a1",
                                        "entry_id": "1563ef88-2927-3fab-93a7-df08d2217255",
                                        "glosses": [
                                            "würdelose Handlung oder Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d543a472-201b-4726-bba5-e372f8c0c384",
                                                "sense_id": "29d92929-35e9-3387-b593-8059c922f0a1",
                                                "text": "„Ich halte es für falsch, manifeste Charakterlosigkeiten von AfD und Die Linke allein deshalb nicht miteinander zu vergleichen, weil der Holocaust ein singuläres, unvergleichbares deutsches Verbrechen war.“"
                                            },
                                            {
                                                "example_id": "1b1bbe7c-6f88-4190-9f8f-e51806464012",
                                                "sense_id": "29d92929-35e9-3387-b593-8059c922f0a1",
                                                "text": "„Zu welchen weiteren Charakterlosigkeiten gegenüber seinem Mutterlande der maßlose Ehrgeiz diesen Mann noch treiben mag, wird die Zukunft lehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
