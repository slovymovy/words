            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c6a801da-c4dc-3db0-b0ab-712997f731ea",
                    "sense_definition": "W każdym dniu, każdego dnia, co dzień.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kazdego-dnia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Codziennie</w> rano piję świeżą kawę i czytam wiadomości.",
                            "target_lang_translations": {
                                "ru": "<w>Каждый день</w> утром я пью свежий кофе и читаю новости.",
                                "en": "I drink fresh coffee and read the news <w>every day</w> in the morning."
                            }
                        },
                        {
                            "text": "Mój brat biega <w>codziennie</w> wieczorem, aby utrzymać dobrą formę.",
                            "target_lang_translations": {
                                "ru": "Мой брат бегает <w>каждый день</w> по вечерам, чтобы поддерживать хорошую форму.",
                                "en": "My brother goes running <w>every day</w> in the evening to stay in good shape."
                            }
                        }
                    ],
                    "synonyms": [
                        "dziennie"
                    ],
                    "common_phrases": [
                        "codziennie rano",
                        "biegać codziennie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждый день, ежедневно.",
                        "en": "Every day, on a daily basis."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каждый день",
                                "target_lang_sense_clarification": "в значении регулярности"
                            },
                            {
                                "target_lang_word": "ежедневно",
                                "target_lang_sense_clarification": "более формальный синоним"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "every day",
                                "target_lang_sense_clarification": "each day"
                            },
                            {
                                "target_lang_word": "daily",
                                "target_lang_sense_clarification": "on a daily basis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51d0f3ed-cb49-31f9-a74c-fa7fe451179f",
                    "sense_definition": "Zwyczajnie, tak jak na co dzień, w sposób powszedni, a nie świąteczny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwyczajnie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na to spotkanie ubrał się zupełnie <w>codziennie</w>, bez zbędnej elegancji.",
                            "target_lang_translations": {
                                "ru": "На эту встречу он оделся совершенно <w>повседневно</w>, без лишней элегантности.",
                                "en": "He dressed completely <w>casually</w> for this meeting, without unnecessary elegance."
                            }
                        },
                        {
                            "text": "Mimo ważnej okazji, stół był nakryty bardzo <w>codziennie</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на важное событие, стол был накрыт очень <w>обыденно</w>.",
                                "en": "Despite the important occasion, the table was set in a very <w>ordinary</w> way."
                            }
                        }
                    ],
                    "antonyms": [
                        "odświętnie"
                    ],
                    "common_phrases": [
                        "ubrany codziennie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обыденно, повседневно, просто, не празднично.",
                        "en": "In an ordinary, casual, or everyday manner, rather than for a special occasion."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повседневно",
                                "target_lang_sense_clarification": "в плане стиля одежды или обстановки"
                            },
                            {
                                "target_lang_word": "обыденно",
                                "target_lang_sense_clarification": "просто, без изысков"
                            },
                            {
                                "target_lang_word": "по-будничному",
                                "target_lang_sense_clarification": "не празднично"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "casually",
                                "target_lang_sense_clarification": "in an everyday manner"
                            },
                            {
                                "target_lang_word": "ordinarily",
                                "target_lang_sense_clarification": "normally, not elegantly"
                            }
                        ]
                    }
                }
