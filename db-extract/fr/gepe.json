                                "target_senses": [
                                    {
                                        "sense_id": "52024b2d-077e-328a-b1cb-61c72a84a047",
                                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                                        "glosses": [
                                            "Segments of bacteria and archaea DNA containing short repetitions of base sequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10e64d7-b749-4144-a77c-105aa28fc5af",
                                                "sense_id": "52024b2d-077e-328a-b1cb-61c72a84a047",
                                                "text": "Crispr is a guide molecule made of RNA, that allows a specific site of interest on the DNA double helix to be targeted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31a8ddc5-d4cb-3175-a8a7-648d49c5775c",
                                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                                        "glosses": [
                                            "The CRISPR/Cas9 system, which functions to provide immunity to bacteria and archaea by finding a section of DNA and replacing it with an alternative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507e94b4-061f-45a2-ab47-948ae799b56c",
                                                "sense_id": "31a8ddc5-d4cb-3175-a8a7-648d49c5775c",
                                                "text": "For the first time, doctors in the U.S. have used the powerful gene-editing technique CRISPR to try to treat a patient with a genetic disorder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ebdd26-05ad-34ed-8dab-b694155fc5c5",
                                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                                        "glosses": [
                                            "Any technique or process or system for editing genomes by laboratory use of the CRISPR/Cas9 system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "CRISPR",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f04e5e-4fc5-3d1b-99a8-40b48d18847a",
                                        "entry_id": "431f9ac4-8fba-32af-a4ce-fbdac52e6a70",
                                        "glosses": [
                                            "To edit genomes by laboratory use of the CRISPR/Cas9 system."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a44c6-8a10-4f5a-9f0b-f2a74f2d83a5",
                                                "sense_id": "f4f04e5e-4fc5-3d1b-99a8-40b48d18847a",
                                                "text": "In this planned trial, doctors will remove cancer patients' T cells, “CRISPR” them, and then reinfuse them in the hope that they will recognize and attack the patients' cancers."
                                            },
                                            {
                                                "example_id": "e0fea805-35ec-4c7f-8fb7-50dbf8c8361d",
                                                "sense_id": "f4f04e5e-4fc5-3d1b-99a8-40b48d18847a",
                                                "text": "Having CRISPRed the cells we next wanted to identify the types of modification that have been generated."
                                            },
                                            {
                                                "example_id": "3483a750-847e-46ce-89be-df7461ea0d4d",
                                                "sense_id": "f4f04e5e-4fc5-3d1b-99a8-40b48d18847a",
                                                "text": "Two successful applications of the CRISPR-Cas9 system in an SCN- and cell-type-specific fashion [5] will all but certainly add to the common refrain of 'just CRISPR it' (grad students and postdocs, insert groan here)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
