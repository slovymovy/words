                        "glosses": [
                            "podłużne ciastko z parzonego ciasta, po przecięciu na dwie części napełniane bitą śmietaną lub kremem, zwykle polewane czekoladą"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "28c39df0-5ce6-4cbc-b766-6728d6c9b80f",
                                "sense_id": "a56aac3e-afe8-3060-91c7-216c58a512d1",
                                "text": "Byłem w cukierni, kupiłem dwie eklerki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
