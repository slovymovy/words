                                        "entry_id": "a18ec514-89f6-31c2-8867-351aebc0119d",
                                        "glosses": [
                                            "erster Abschnitt des Magens (genauer: erster Vormagen) bei Wiederkäuern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd79626-24ff-40cd-ad26-bd0bea203376",
                                                "sense_id": "9a52c701-b263-3e98-9bf3-0d4268573fbf",
                                                "text": "Den Hunden gibt man den Pansen zu fressen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a5b7c29-ba08-3a72-bb75-6189af60e2c7",
                                        "entry_id": "a18ec514-89f6-31c2-8867-351aebc0119d",
                                        "glosses": [
                                            "Verdauungsorgan, Magen auch bei Nicht-Wiederkäuern"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5addfc7e-4355-45bb-b4b1-8f2dd0450c85",
                                                "sense_id": "1a5b7c29-ba08-3a72-bb75-6189af60e2c7",
                                                "text": "Seine Augen sind rot, sein Bart ist fettig und schmutzig, sein Pansen aufgedunsen, an den Händen hat er Krallen; mit denen packt er die Seelen, reißt ihnen die Haut ab und zerstückelt sie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2b11aea-024e-43a2-9436-ba9062d07b0e",
                        "source_entry_id": "7d80b4e6-a8d1-3fa6-b19c-26fcf30df505",
