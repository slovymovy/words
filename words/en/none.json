{
    "word_family": [
        "no",
        "nobody",
        "nothing",
        "nowhere"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                    "sense_definition": "Not any amount, part, or member of a given number or group.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I looked for some coffee, but there was <w>none</w> left in the pot.",
                            "target_lang_translations": {
                                "ru": "Я искал кофе, но в кофейнике <w>ничего</w> не осталось.",
                                "zh": "我找了些咖啡，但壶里已经<w>没有</w>了。"
                            }
                        },
                        {
                            "text": "<w>None</w> of the students knew the answer to the difficult question.",
                            "target_lang_translations": {
                                "ru": "<w>Никто</w> из студентов не знал ответа на этот сложный вопрос.",
                                "zh": "<w>没有</w>学生知道这道难题的答案。"
                            }
                        }
                    ],
                    "antonyms": [
                        "some",
                        "all"
                    ],
                    "common_phrases": [
                        "none of",
                        "none at all"
                    ],
                    "target_lang_definitions": {
                        "ru": "Никакое количество, часть или представитель данной группы.",
                        "zh": "指在给定的数量或群体中，没有任何数量、部分或成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни один",
                                "target_lang_sense_clarification": "из группы"
                            },
                            {
                                "target_lang_word": "никто",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "ничего",
                                "target_lang_sense_clarification": "о вещах"
                            },
                            {
                                "target_lang_word": "нисколько",
                                "target_lang_sense_clarification": "о количестве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没有",
                                "target_lang_sense_clarification": "指数量或存在"
                            },
                            {
                                "target_lang_word": "无",
                                "target_lang_sense_clarification": "书面语，指数量"
                            },
                            {
                                "target_lang_word": "谁也不",
                                "target_lang_sense_clarification": "指人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b708d97-84da-304e-ae21-b56214f6eb92",
                    "sense_definition": "No person; no one.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I knocked on the door, but <w>none</w> answered.",
                            "target_lang_translations": {
                                "ru": "Я постучал в дверь, но <w>никто</w> не ответил.",
                                "zh": "我敲了敲门，但<w>无人</w>应答。"
                            }
                        },
                        {
                            "text": "<w>None</w> but the brave deserve the fair.",
                            "target_lang_translations": {
                                "ru": "<w>Никто</w>, кроме храбрых, не заслуживает красавиц.",
                                "zh": "<w>只有</w>勇者才配得上美人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "none other than"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один человек; никто.",
                        "zh": "没有人；无一人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никто",
                                "target_lang_sense_clarification": "местоимение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无人",
                                "target_lang_sense_clarification": "指人"
                            },
                            {
                                "target_lang_word": "没有谁",
                                "target_lang_sense_clarification": "指人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                    "sense_definition": "To no extent; in no way. Used to emphasize that a situation remains the same despite something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "adverb_extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell off his bike but was <w>none</w> the worse for it.",
                            "target_lang_translations": {
                                "ru": "Он упал с велосипеда, но ему от этого стало <w>ничуть</w> не хуже.",
                                "zh": "他从自行车上摔了下来，但<w>一点</w>事也没有。"
                            }
                        },
                        {
                            "text": "She explained it twice, but I am <w>none</w> the wiser.",
                            "target_lang_translations": {
                                "ru": "Она объяснила это дважды, но мне не стало <w>ничуть</w> понятнее.",
                                "zh": "她解释了两遍，但我还是<w>一点</w>也没听懂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "none the worse",
                        "none the wiser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни в какой мере; никоим образом. Используется для подчеркивания того, что ситуация остается неизменной.",
                        "zh": "一点也不；毫无。用于强调尽管发生了某事，情况依然如故。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничуть",
                                "target_lang_sense_clarification": "наречие"
                            },
                            {
                                "target_lang_word": "нисколько",
                                "target_lang_sense_clarification": "наречие степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一点也",
                                "target_lang_sense_clarification": "程度副词"
                            },
                            {
                                "target_lang_word": "毫无",
                                "target_lang_sense_clarification": "程度副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                    "sense_definition": "Not at all; not very.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adverb_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>none</w> too pleased with the delay.",
                            "target_lang_translations": {
                                "ru": "Менеджер был <w>совсем не</w> рад задержке.",
                                "zh": "经理对这次延误<w>并不</w>感到高兴。"
                            }
                        },
                        {
                            "text": "We arrived <w>none</w> too soon, as the rain started immediately after.",
                            "target_lang_translations": {
                                "ru": "Мы прибыли <w>вовсе не</w> слишком рано, так как сразу после этого начался дождь.",
                                "zh": "我们到得<w>并不</w>太早，因为紧接着就开始下雨了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "none too"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совсем не; вовсе не.",
                        "zh": "一点也不；不太。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совсем не",
                                "target_lang_sense_clarification": "отрицание качества"
                            },
                            {
                                "target_lang_word": "вовсе не",
                                "target_lang_sense_clarification": "усиленное отрицание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "并不",
                                "target_lang_sense_clarification": "程度否定"
                            },
                            {
                                "target_lang_word": "绝非",
                                "target_lang_sense_clarification": "强调否定"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                    "sense_definition": "A person who has no religious affiliation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sociology_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study focused on the growing number of <w>nones</w> in the population.",
                            "target_lang_translations": {
                                "ru": "Исследование было посвящено растущему числу <w>нерелигиозных людей</w> в населении.",
                                "zh": "这项研究关注的是人口中日益增长的<w>无宗教信仰者</w>。"
                            }
                        },
                        {
                            "text": "Many <w>nones</w> still consider themselves spiritual despite lacking a specific church.",
                            "target_lang_translations": {
                                "ru": "Многие <w>люди без вероисповедания</w> всё ещё считают себя духовными, несмотря на отсутствие конкретной церкви.",
                                "zh": "许多<w>无宗教信仰者</w>尽管没有特定的教会，但仍认为自己是有灵性的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sociology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не относящий себя ни к какой религии.",
                        "zh": "指没有宗教信仰的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерелигиозный человек",
                                "target_lang_sense_clarification": "социология"
                            },
                            {
                                "target_lang_word": "человек без вероисповедания",
                                "target_lang_sense_clarification": "формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无宗教信仰者",
                                "target_lang_sense_clarification": "社会学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd8e3820-3415-3e57-953f-1786b480ba7c",
                    "sense_definition": "The ninth hour after dawn, or the religious service appointed to this hour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liturgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks gathered in the chapel to chant the office of <w>none</w>.",
                            "target_lang_translations": {
                                "ru": "Монахи собрались в часовне, чтобы пропеть службу <w>ноны</w>.",
                                "zh": "修士们聚集在礼拜堂诵唱<w>第九时课</w>。"
                            }
                        },
                        {
                            "text": "Historically, <w>none</w> was observed in the midafternoon.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>нона</w> соблюдалась в середине дня.",
                                "zh": "历史上，<w>第九时课</w>是在午后进行的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "midafternoon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Christianity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девятый час от восхода солнца или церковная служба в этот час.",
                        "zh": "日出后的第九个小时，或指在此时段进行的宗教仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нона",
                                "target_lang_sense_clarification": "церковная служба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第九时课",
                                "target_lang_sense_clarification": "基督教礼仪"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                    "sense_definition": "Not any; no.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_determiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thou shalt have <w>none</w> other gods but me.",
                            "target_lang_translations": {
                                "ru": "Да не будет у тебя <w>никаких</w> других богов, кроме Меня.",
                                "zh": "除了我以外，你不可有<w>别的</w>神。"
                            }
                        },
                        {
                            "text": "He departed with <w>none</w> effect on the outcome.",
                            "target_lang_translations": {
                                "ru": "Он ушел, не оказав <w>никакого</w> влияния на результат.",
                                "zh": "他离开了，对结果<w>毫无</w>影响。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usually before a vowel or h"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Никакой; ни один (устаревшее).",
                        "zh": "没有任何；无（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никакой",
                                "target_lang_sense_clarification": "определитель"
                            },
                            {
                                "target_lang_word": "ни один",
                                "target_lang_sense_clarification": "определитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无",
                                "target_lang_sense_clarification": "古语限定词"
                            },
                            {
                                "target_lang_word": "没有任何",
                                "target_lang_sense_clarification": "限定词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}