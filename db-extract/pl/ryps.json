                "senses": [
                    {
                        "sense_id": "f03a39c4-d7e3-3d4c-8b14-eb3f8246e152",
                        "entry_id": "c47356f8-0481-3ac7-b338-35b080259204",
                        "glosses": [
                            "wielomateriałowa tkanina o splocie rypsowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10b18bb-63a5-4dce-ada9-9541c939254e",
                                "sense_id": "f03a39c4-d7e3-3d4c-8b14-eb3f8246e152",
                                "text": "Podszedłem do ojca, stanąłem za fotelem, opierając się dłońmi o niebieskawy, spłowiały ryps"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
