                                "sense_id": "61a80dea-1eae-37b4-9573-e54035c81dc0",
                                "text": "So young speed enthusiasts can get high performance equipment for their \"street draggers.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "76b58291-d668-3a09-8e30-91532b01839a",
                        "entry_id": "34a478ce-7db1-3269-bdca-1e54d4a73e22",
                        "glosses": [
