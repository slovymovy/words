                ],
                "senses": [
                    {
                        "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                        "entry_id": "242744fb-61b6-340b-bf17-533599112652",
                        "glosses": [
                            "weibliche Person, die Mitglied einer Gewerkschaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b7af84-2da4-4740-bcbd-2217d8565eba",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„‚Unser Ziel ist es, wieder an den Verhandlungstisch zurückzukehren‘, sagt die Gewerkschaftlerin.“"
                            },
                            {
                                "example_id": "1fdc9a32-56ba-43c3-9b19-6099e49e1953",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "Die Gewerkschaftlerinnen trafen sich zu einer Betriebsversammlung."
                            },
                            {
                                "example_id": "e64b1131-9522-4bea-a56b-44d615878b8e",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Als aufrüttelnd bezeichnete es wiederum Isolde Kunkel-Weber, daß sie heute erstmals die Gelegenheit habe, als Gewerkschaftlerin vor Kirchenmitarbeitern zu referieren.“"
                            },
                            {
                                "example_id": "041316df-8348-45a2-8db0-97ebcc331357",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Eine solche Politik würde zur Abwertung der angesprochenen Berufe führen, so die Gewerkschaftlerinnen.“"
                            },
                            {
                                "example_id": "1e50e020-8d02-48fb-8b01-ea9ac0b54419",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Seine Zweitkandidatin Silvia Wölfle, die 1996 in die SPD eintrat, ist seit längerem aktive Gewerkschaftlerin.“"
                            },
                            {
                                "example_id": "cf8449c4-3dcc-48aa-8e91-049ad5fc8d3a",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Eine unpolitische Gruppe von Arbeiterinnen verwandelt sich in ein schlagfertiges Trüppchen an Gewerkschaftlerinnen: Feine Mischung aus gutherziger Sixties-Pop-Leichtigkeit und nicht allzu schwerem Proletarier-Drama.“"
                            },
                            {
                                "example_id": "b81b921c-5e2f-4db6-82e3-5961ff131fd1",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„[‚]Zum Teil wird sogar behauptet, eine Arbeitszeitreduzierung sei schlichtweg nicht möglich‘, sagt die Gewerkschaftlerin Karin Schwendler.“"
                            },
                            {
                                "example_id": "2e416e45-a90c-46cb-a37d-ee90a56a3d74",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Die Gewerkschaftlerin stellte die Einhaltung des Grundgesetzes bei Einführung der Rente mit 67, Hartz IV und der Stützung maroder Banken mit 70 Milliarden Euro neben anderem in Frage.“"
                            },
                            {
                                "example_id": "55b295e7-e743-4188-bcc0-3e9e3829e298",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Die Gewerkschaftlerin weiß, dass das Thema Sozialhilfe für betroffene Senioren kein leichtes ist.“"
                            },
                            {
                                "example_id": "2d70ee4f-badc-4355-aa3e-8aca80ef7ca2",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„Eine Frau nahe der Lebensmitte, aufgerieben zwischen all den Rollen, die sie zu erfüllen hat: Als Gewerkschaftlerin in einer Fabrik, die von der Schließung bedroht ist.“"
                            },
                            {
                                "example_id": "e0d2d555-a708-4461-9168-17f52871f0a4",
                                "sense_id": "1e83042d-52c0-355b-8d82-75fd2ab84698",
                                "text": "„‚Das ist ein höchst bemerkenswerter Vorgang und muss Konsequenzen haben‘, so die Gewerkschaftlerin Schöttke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
