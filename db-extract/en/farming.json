                "senses": [
                    {
                        "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                        "entry_id": "1883ec18-24bc-3880-a7ac-db1385f873ac",
                        "glosses": [
                            "The business of cultivating land, raising stock, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d159c9d-0155-4533-b09d-65dfc1e711f2",
                                "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                                "text": "Gardening, then, is a sort of refined farming upon a limited scale."
                            },
                            {
                                "example_id": "f7b4645c-8f33-42d8-a2ae-3949ca04522a",
                                "sense_id": "0fb0f01b-5e71-3466-811d-e2122b2bafa4",
                                "text": "Farming was among the earliest of civilized man's occupations, [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                        "entry_id": "1883ec18-24bc-3880-a7ac-db1385f873ac",
                        "glosses": [
                            "A farming operation; a farm, or instance of farming on a piece of land."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "badb6e75-71b9-41b8-8fcf-4283c69b83a2",
                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                "text": "We discharge them also of all Farmings of Benefices, and Church Lands, or Goods, of which they were spoiled by those who Commanded under their General."
                            },
                            {
                                "example_id": "3e2f91c5-a1a6-4506-9a29-829acebd58b8",
                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                "text": "After Agricultural Foundation Law was enacted in 1961, the expansion of scale of farm business, the improvement of agricultural foundation, the spread of diversified farming with livestock, the mechanization and the rationalization of farming have accelerated viable farmings."
                            },
                            {
                                "example_id": "f07790d7-ede0-4cde-a574-5036b8b92585",
                                "sense_id": "ba7d31f1-6e2c-37d4-828a-f51c74dc6c76",
                                "text": "The problem has been enhanced more so because more agricultural farmings are spreading out leaving but slight margins for cattle farming and fears are expressed by farmers upon the possible cattle intrusion into the farmings ..."
                            }
                        ]
                    }
