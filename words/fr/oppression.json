    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19849baf-ad7b-3f61-a313-21de6f890123",
                    "sense_definition": "Action de maintenir un peuple, un groupe ou un individu sous une autorité violente et injuste ; état qui en résulte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple s'est révolté afin de lutter contre l'<w>oppression</w> exercée par ce gouvernement tyrannique."
                        },
                        {
                            "text": "Les associations dénoncent l'<w>oppression</w> constante que subissent les minorités dans cette région troublée."
                        }
                    ],
                    "synonyms": [
                        "tyrannie",
                        "asservissement",
                        "domination",
                        "joug"
                    ],
                    "antonyms": [
                        "libération",
                        "émancipation",
                        "liberté"
                    ],
                    "common_phrases": [
                        "lutter contre l'oppression",
                        "victime d'oppression"
                    ]
                },
                {
                    "sense_id": "e2f45c87-3813-3d22-ba24-44c1caf24fed",
                    "sense_definition": "Sensation pénible d'étouffement, de gêne respiratoire ou de serrement thoracique liée au stress ou à une maladie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de l'angoisse, il a ressenti une soudaine <w>oppression</w> thoracique qui l'empêchait de respirer normalement."
                        },
                        {
                            "text": "La chaleur étouffante de la pièce provoquait chez les invités une pénible sensation d'<w>oppression</w>."
                        }
                    ],
                    "synonyms": [
                        "étouffement",
                        "suffocation",
                        "angoisse"
                    ],
                    "antonyms": [
                        "soulagement"
                    ],
                    "common_phrases": [
                        "oppression thoracique",
                        "sensation d'oppression"
                    ]
                },
                {
                    "sense_id": "73dc61b1-3708-32f5-88cb-a4cf085b9350",
                    "sense_definition": "Dans certaines croyances religieuses, tourment ou emprise néfaste attribués à des forces démoniaques sur une personne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "domaine_spirituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a affirmé avoir délivré cette maison d'une <w>oppression</w> diabolique qui tourmentait les habitants."
                        },
                        {
                            "text": "Dans certains récits mystiques, l'<w>oppression</w> spirituelle pousse l'individu à douter profondément de sa foi."
                        }
                    ],
                    "synonyms": [
                        "possession",
                        "tourment"
                    ],
                    "antonyms": [
                        "délivrance"
                    ],
                    "common_phrases": [
                        "oppression diabolique"
                    ]
                }
            ]
        }
    ]
}