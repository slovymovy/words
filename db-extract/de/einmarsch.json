                        "form": "den Einmarsch"
                    },
                    {
                        "form_id": "165644c4-5d7b-4a60-8e1d-2f0b0b20a2ae",
                        "entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Einmärsche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                        "entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                        "glosses": [
                            "gemeinsames Einmarschieren mehrerer Personen in ein Gebäude oder Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a584a2-9de5-4b40-a541-95c20995ccd9",
                                "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                                "text": "Der Einmarsch der Gladiatoren in die Arena war ein beeindruckendes Ereignis."
                            },
                            {
                                "example_id": "9482cdba-7dae-45eb-be0f-60103c044607",
                                "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                                "text": "„Die Wettkämpfe beginnen mit dem Einmarsch der Nationen, der feierlichen Eröffnung durch das Staatsoberhaupt, dem Hissen der Olympiafahne, dem Entzünden der olympischen Flamme und dem Ablegen des olympischen Eides.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                        "entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                        "glosses": [
                            "gewaltsames Eindringen von militärischen Truppen in ein Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f86d78-6ee2-48b4-8326-56c10224f839",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "Der Einmarsch der Deutschen war ein Schreckenserlebnis für die Franzosen."
                            },
                            {
                                "example_id": "20128b15-55ed-4bec-b012-1a1e587ab34f",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "„‘Wir können uns‘, so [Arseni] Jazenjuk zu Moderatorin Pinar Atalay, ‘alle sehr gut an den sowjetischen Einmarsch in die Ukraine und nach Deutschland erinnern.‘“"
                            },
                            {
                                "example_id": "67052bad-cca8-43a2-9b38-c1f496d78dbf",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "„Ein jüdischer Einmarsch in dieses Gebiet würde England zum Intervenieren zwingen.“"
                            },
                            {
                                "example_id": "27b874e5-b07b-471f-8b19-58ab0927af1c",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "„In Karzin wußte man, daß der Einmarsch unmittelbar bevorstand.“"
                            },
                            {
                                "example_id": "1130cbdb-c826-45c0-b2e6-4f5b498326e2",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "„Man hörte, dass der Vorschlag gemacht worden sei, das Abzeichen der Einheitspartei des tschechischen Volkes, die Präsident Hácha sofort nach dem Einmarsch der Deutschen gegründet hatte, umzudrehen.“"
                            },
                            {
                                "example_id": "904c0e6b-650b-430c-95a9-f72fd18b64c0",
                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                "text": "„Dass diese Koalition zwischen Sharifs PML und den religiösen Parteien, allen voran die Jamaat-e-Islami, zerbrach, geht auf Sharifs persönliche Sympathie für Saddam Hussein während des irakischen Einmarschs in Kuwait zurück.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24da463e-b7c0-49d7-bbe1-9c194c9b98e1",
                        "source_entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                        "source_sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                        "source_sense_description": "gewaltsames Eindringen von militärischen Truppen in ein Gebiet",
                        "target_lang_word": "invasion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invasion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "A military action consisting of armed forces of one geopolitical entity entering territory controlled by another such entity, generally with the objective of conquering territory or altering the established government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ff51b7-b159-463a-89ed-345965a22b58",
                                                "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                                "text": "Since Michel's days, however, many barbarian invasions had subdivided the Three Gauls into a melange of warsome states and tribes, all, nevertheless, acquiring a vaguely similar grace, if not a petite grandeur."
                                            },
                                            {
                                                "example_id": "5789575d-4961-4130-9ae0-089a1e65f90a",
                                                "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                                "text": "Yeh actually works in marketing, and his weapon is a replica -- but he is spending the weekend attending an urban warfare workshop to prepare for what he sees as the very real threat of a Chinese invasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The entry without consent of an individual or group into an area where they are not wanted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4306a8f1-65a0-411d-b20e-86c88a71486e",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of mobile phones"
                                            },
                                            {
                                                "example_id": "439e66d0-a1e5-4eef-a410-c4458caefad0",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of bees"
                                            },
                                            {
                                                "example_id": "612d810e-3282-479e-97a5-130bb7903fd1",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of foreign tourists"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372f5947-4869-3285-a562-89ed4d941ab8",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The spread of cancer cells, bacteria and such to the organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28da780-f38a-4846-95ca-01bfbcfbae37",
                                                "sense_id": "372f5947-4869-3285-a562-89ed4d941ab8",
                                                "text": "The histological diagnosis of PC is currently restricted to lesions showing unequivocal extra-parathyroidal growth, as evidenced by perineural invasion, full thickness capsular invasion with growth into adjacent tissues, extratumoral vascular invasion, or metastasis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f592e4-41ae-3744-ae65-fdd3aac67b2a",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The breaching of the skin barrier."
                                        ],
                                        "tags": [
                                            "countable",
