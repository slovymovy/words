                        "examples": [
                            {
                                "example_id": "8030463a-4dca-4aad-ad82-2bd19ef9d211",
                                "sense_id": "6f63363d-7449-33b4-8122-dd91ba643732",
                                "text": "„Informationen zu den geltenden Bedingungen sowie den notwendigen Unterlagen und Nachweisen, die für den Möbeltransport bei Umzug in den Libanon nötig sind, finden Sie im nachfolgenden Merkblatt.“"
                            },
                            {
                                "example_id": "814f2ff3-a59b-47bc-a9fa-a71712fa4767",
                                "sense_id": "6f63363d-7449-33b4-8122-dd91ba643732",
                                "text": "„Zwei Tage nach seiner Flucht rollte der Möbeltransport des Meisters Pahlow mit ordentlichen Umzugspapieren durch Schkopau, ohne freilich in der neuen Werkswohnung anzukommen.“"
                            }
                        ],
