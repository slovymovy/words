                    {
                        "sense_id": "5e72b6e0-4ec1-3cf5-a1ec-9e3fe99a6a74",
                        "entry_id": "04acd2af-a09d-39b0-a3e2-ea273c9db54b",
                        "glosses": [
                            "Person, die freiwillig für eine bestimmte Zeit in einer Armee dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3191e2-79bb-401f-83e6-2507cc8635e0",
                                "sense_id": "5e72b6e0-4ec1-3cf5-a1ec-9e3fe99a6a74",
                                "text": "„Zwar wird kein Berufs- oder Zeitsoldat arbeitslos werden. Dennoch wirkt sich der Umbau der deutschen Streitkräfte im Zeichen der globalen Einsatzbereitschaft in den kleineren und strukturschwachen Städten und Kreisen drastisch aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f8e7e75-bf14-4ffa-97e0-8f952f5a52f0",
                        "source_entry_id": "04acd2af-a09d-39b0-a3e2-ea273c9db54b",
