                "translations": [
                    {
                        "translation_id": "501706b4-f076-4dc6-9123-ac441d90cbc8",
                        "source_entry_id": "ce312c98-9dc1-3266-b688-9e07101877bb",
                        "source_sense_id": "7942358e-0f1a-3e1f-b826-94f6a0b8a2a8",
                        "source_sense_description": "die Linie, an der die Kopfbehaarung beginnt",
                        "target_lang_word": "hairline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hairline",
