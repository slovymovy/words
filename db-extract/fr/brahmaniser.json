                "senses": [
                    {
                        "sense_id": "969491e1-f271-3eda-b7f5-19323dad7598",
                        "entry_id": "a96ba99b-de07-3855-95f4-a892819fd616",
                        "glosses": [
                            "Donner un caractère brahmanique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b9bac3e-f0cb-480a-8dd8-20a32ff5ef26",
                                "sense_id": "969491e1-f271-3eda-b7f5-19323dad7598",
                                "text": "Toutefois, certaines de ces réformes ont été fortement critiquées comme une tentative de « brahmaniser » le mariage et les codes civils (personal laws), au détriment des coutumes et des normes suivies par les femmes non brahmanes."
                            },
                            {
                                "example_id": "113bb76d-e75a-45d8-8be0-e16cc995934e",
                                "sense_id": "969491e1-f271-3eda-b7f5-19323dad7598",
                                "text": "Le discours qu’ils ont développé depuis le milieu des années 1980 signale une rupture radicale avec leurs tentatives antérieures pour « sanscritiser » les Tharu ou, pourrions-nous dire, les « brahmaniser »."
                            }
                        ]
                    }
