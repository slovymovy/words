                                        "examples": [
                                            {
                                                "example_id": "ce89837b-89b8-45d7-b199-b787329a4012",
                                                "sense_id": "8a6edc9e-5459-3e7f-8b60-82b69858d733",
                                                "text": "If you use the same seed you will get exactly the same pattern of numbers."
                                            },
                                            {
                                                "example_id": "4652737a-6fb2-457c-b9d9-81006e97d912",
                                                "sense_id": "8a6edc9e-5459-3e7f-8b60-82b69858d733",
                                                "text": "As suggested in [3], space can be saved by using a deterministic pseudo random number generator (PRNG) and storing only the seed of that PRNG."
                                            },
                                            {
                                                "example_id": "347d34a9-4a41-4382-890d-b4f2552b13ef",
                                                "sense_id": "8a6edc9e-5459-3e7f-8b60-82b69858d733",
                                                "text": "Seeds are Minecraft's way of generating terrain. Each biome you spawn in is determined by the seed. With a custom seed, you can have a desert biome right next to a mesa biome."
                                            }
                                        ]
                                    },
