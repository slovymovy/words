                ],
                "senses": [
                    {
                        "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                        "entry_id": "743f8b78-60c1-321b-801d-1777ce139adc",
                        "glosses": [
                            "Fläche für Fahrzeuge, Fahrräder und Personen (= dem Straßenverkehr), Schiffe (beispielsweise Kanäle, Häfen) und Flugzeuge (beispielsweise Flugplätze)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e767781-552a-4546-9af8-957e10003dba",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Nur ein Viertel ihrer Wege legen die Berliner mit dem Auto zurück – dafür gehen aber drei Viertel der Verkehrsfläche drauf.“"
                            },
                            {
                                "example_id": "adefe1e6-0b2b-42ae-8c38-55fbda7d9ec3",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "[Brühl/Baden:] „Die Gemarkung erstreckt sich über 1019 Hektar. Davon sind 30 Prozent Siedlungs- und Verkehrsfläche, 48 Prozent werden landwirtschaftlich genutzt, 10 Prozent sind Wasserflächen und 9 Prozent sind bewaldet.“"
                            },
                            {
                                "example_id": "f32656ee-3e1b-4e35-bc8f-3724772d7527",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Das Bundesamt für Bauwesen und Raumordnung und das Umweltbundesamt schätzen, dass etwa 50 % der Siedlungs- und Verkehrsfläche der Bundesrepublik Deutschland versiegelt sind.“"
                            },
                            {
                                "example_id": "cf641b10-92fc-425b-ac6b-3ed4fc2ea99b",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Insbesondere diese versiegelten Verkehrsflächen sind anfällig fürs Aufheizen.“"
                            },
                            {
                                "example_id": "e9b5469f-8042-421c-8545-571d0d72998a",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Die Städte Bludenz und Hohenems haben in Vorarlberg mit 33 Prozent den größten Anteil an versiegelten Verkehrsflächen. In der Landeshauptstadt Bregenz sind es 31 Prozent.“"
                            },
                            {
                                "example_id": "a1f51b12-4f74-4762-8e64-8594449861e7",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Laut VCÖ gibt es im Burgenland pro Person 295 Quadratmeter an versiegelter Verkehrsfläche.“"
                            },
                            {
                                "example_id": "8b9b3496-c9b5-4e13-90c3-3bf808c6fdbc",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "[…] „Braucht es wirklich einen weiteren Ausbau der Verkehrsflächen?“"
                            },
                            {
                                "example_id": "ec6da487-36e5-4ae4-a94a-2060f0ab6ee7",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„E-Bike-Fahrerinnen und -Fahrer mit Velos, die bis 45 Kilometer pro Stunde fahren, sollen sich zum Beispiel künftig freier auf der ganzen Verkehrsfläche bewegen können, nicht nur auf dem Velostreifen.“"
                            },
                            {
                                "example_id": "210eed6f-d5b1-4f1d-af09-5c3face90cb0",
                                "sense_id": "49354cc7-c119-3ce4-a5f7-63832d1e0e5a",
                                "text": "„Die Verkehrsfläche soll zur Grünfläche mit befestigten Fuß- und Radwegen umgewandelt werden, als eine Erweiterung des Maschparks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
