{
    "word_family": [
        "kruipen",
        "kruiper",
        "kruipend",
        "gekruip"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1414dfb8-971b-308f-9a6a-d31edf4fd95c",
                    "sense_definition": "Het langzaam en ongemerkt bezitnemen van iemand door een bepaald gevoel of een gedachte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een vreemd <w>gevoel</w> <w>bekroop</w> hem toen hij het verlaten huis binnenstapte.",
                            "target_lang_translations": {
                                "en": "A strange <w>feeling</w> <w>crept over</w> him when he stepped into the abandoned house."
                            }
                        },
                        {
                            "text": "De angst <w>bekruipt</w> me dat we de laatste trein naar huis zullen missen.",
                            "target_lang_translations": {
                                "en": "The fear <w>creeps over</w> me that we will miss the last train home."
                            }
                        }
                    ],
                    "synonyms": [
                        "overvallen",
                        "beklemmen",
                        "bevangen"
                    ],
                    "common_phrases": [
                        "gevoel bekruipt",
                        "angst bekruipt",
                        "twijfel bekruipt"
                    ],
                    "target_lang_definitions": {
                        "en": "The slow and unnoticed taking possession of someone by a certain feeling or thought."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creep over",
                                "target_lang_sense_clarification": "of a feeling or thought, to gradually affect someone"
                            },
                            {
                                "target_lang_word": "steal over",
                                "target_lang_sense_clarification": "of a feeling, to gradually and quietly come over someone"
                            },
                            {
                                "target_lang_word": "come over",
                                "target_lang_sense_clarification": "to suddenly or gradually affect someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80880b82-2b63-3ad4-95d5-b7861abb39db",
                    "sense_definition": "Heimelijk, sluipend of kruipend naderen om onopgemerkt dichtbij te komen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_kruipen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager probeerde het wild ongemerkt te <w>bekruipen</w> door de hoge struiken.",
                            "target_lang_translations": {
                                "en": "The hunter tried to <w>stalk</w> the game unnoticed through the high bushes."
                            }
                        },
                        {
                            "text": "De bloedzuigers <w>bekropen</w> hun nietsvermoedend slachtoffer in het moeras.",
                            "target_lang_translations": {
                                "en": "The leeches <w>crept up on</w> their unsuspecting victim in the swamp."
                            }
                        }
                    ],
                    "synonyms": [
                        "besluipen",
                        "naderen"
                    ],
                    "common_phrases": [
                        "slachtoffer bekruipen",
                        "stil bekruipen"
                    ],
                    "target_lang_definitions": {
                        "en": "To approach secretly, stealthily, or by crawling in order to get close unnoticed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stalk",
                                "target_lang_sense_clarification": "to pursue or approach stealthily"
                            },
                            {
                                "target_lang_word": "creep up on",
                                "target_lang_sense_clarification": "to approach someone quietly and slowly without being noticed"
                            },
                            {
                                "target_lang_word": "sneak up on",
                                "target_lang_sense_clarification": "to approach stealthily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}