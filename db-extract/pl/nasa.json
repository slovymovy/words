                    {
                        "translation_id": "9d893505-3aca-4ded-9721-f0855cdd13e8",
                        "source_entry_id": "704f1705-6d03-3f12-8b5c-0a7ee4bafc07",
                        "source_sense_id": "72b0eafc-19a0-322d-940c-0bfd1df563de",
