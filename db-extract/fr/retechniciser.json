                "senses": [
                    {
                        "sense_id": "29cfff45-5880-3892-9f55-58c02bf0c458",
                        "entry_id": "63b0db50-0c2f-3ddd-aad1-7f585c2e2434",
                        "glosses": [
                            "Techniciser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a52eee2-7c4b-4c3a-b053-c8a18aa02052",
                                "sense_id": "29cfff45-5880-3892-9f55-58c02bf0c458",
                                "text": "Cette double évolution pose bien évidemment tout un ensemble de questions essentielles quant à la dimension éthique de ces relations de travail ou encore quant à leur possible médiatisation par des procédés de gestion des ressources humaines plus ou moins « néotayloriens » permettant de retechniciser ou de rationaliser ces relations humaines."
                            },
                            {
                                "example_id": "fb47e8d2-06e8-4ebc-8d97-e270cea5600e",
                                "sense_id": "29cfff45-5880-3892-9f55-58c02bf0c458",
                                "text": "La nature est alors sublimée par la science, elle est même retechnicisée."
                            },
                            {
                                "example_id": "9795cc56-c905-4a79-b007-9042e4785028",
                                "sense_id": "29cfff45-5880-3892-9f55-58c02bf0c458",
                                "text": "(retechniciser et fonder des entréprises petites et moyennes)"
                            }
                        ]
                    }
