                "senses": [
                    {
                        "sense_id": "413ca30a-fd21-3bb1-8d97-9a65caa6dcb6",
                        "entry_id": "df22a0f7-1b65-3502-8eed-fb71673eee03",
                        "glosses": [
                            "„Handlung, bei der man wie in einem Striptease […] [das Innerste seiner Seele] entblößt“; Offenbarung persönlicher Gefühle"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "oftmals abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "90da0a31-7601-468c-aea7-bd6d606256d9",
                                "sense_id": "413ca30a-fd21-3bb1-8d97-9a65caa6dcb6",
                                "text": "„Deren Bewerbungen für ihren Seelenstriptease vor der Kamera mögen zum Großteil tatsächlich von der Tristesse einsamer Hofnächte und der Sehnsucht nach einer liebevollen Umarmung geschrieben sein.“"
                            },
                            {
                                "example_id": "c7ee6b44-b097-4daa-ac7b-af3168ee0d92",
                                "sense_id": "413ca30a-fd21-3bb1-8d97-9a65caa6dcb6",
                                "text": "„Ach ja, für die, die es immer noch nicht wissen nach all seinen öffentlichen Seelenstripteases: Kubicki entspannt am liebsten bei Kriegsfilmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
