{
    "word_family": [
        "disturb",
        "disturbance",
        "disturbed",
        "undisturbing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87798cd4-409d-36e7-94f5-d9e1aab44e7a",
                    "sense_definition": "Not moved, touched, altered, or interrupted by an outside force",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old ruins had remained <w>undisturbed</w> for hundreds of years.",
                            "target_lang_translations": {
                                "ru": "Древние руины оставались <w>нетронутыми</w> на протяжении сотен лет."
                            }
                        },
                        {
                            "text": "Please leave the crime scene completely <w>undisturbed</w> until investigators arrive.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте место преступления совершенно <w>нетронутым</w> до прибытия следователей."
                            }
                        }
                    ],
                    "synonyms": [
                        "untouched",
                        "uninterrupted"
                    ],
                    "antonyms": [
                        "disturbed"
                    ],
                    "common_phrases": [
                        "leave undisturbed",
                        "remain undisturbed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не потревоженный, нетронутый или не нарушенный внешним воздействием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетронутый",
                                "target_lang_sense_clarification": "к которому не прикасались, сохранившийся в исходном виде"
                            },
                            {
                                "target_lang_word": "непотревоженный",
                                "target_lang_sense_clarification": "оставленный в покое, не нарушенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f771c4-5d20-35da-bafb-7dd4bfac7e83",
                    "sense_definition": "Calm, tranquil, and free from emotional distress or worry",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoyed an <w>undisturbed</w> sleep after a long and exhausting week.",
                            "target_lang_translations": {
                                "ru": "Она наслаждалась <w>безмятежным</w> сном после долгой и изнурительной недели."
                            }
                        },
                        {
                            "text": "His mind was completely <w>undisturbed</w> by the rumors around him.",
                            "target_lang_translations": {
                                "ru": "Его разум оставался совершенно <w>невозмутимым</w>, несмотря на ходившие вокруг слухи."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "serene",
                        "placid",
                        "peaceful"
                    ],
                    "antonyms": [
                        "agitated",
                        "troubled"
                    ],
                    "common_phrases": [
                        "undisturbed sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спокойный, безмятежный и свободный от волнений или помех"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "мирный, без волнений или помех"
                            },
                            {
                                "target_lang_word": "безмятежный",
                                "target_lang_sense_clarification": "полный умиротворения и тишины"
                            },
                            {
                                "target_lang_word": "невозмутимый",
                                "target_lang_sense_clarification": "сохраняющий полное спокойствие, не поддающийся тревоге"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}