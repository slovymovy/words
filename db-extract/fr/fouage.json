                "entry_id": "b221ef4f-ec10-3859-a3b4-e148608bbc8f",
                "word": "fouage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04c9f54b-11ef-41ab-9b4d-ab3281f42bfe",
                        "entry_id": "b221ef4f-ec10-3859-a3b4-e148608bbc8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "fouages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "893e6ff6-85b0-337e-b40c-c30429224496",
                        "entry_id": "b221ef4f-ec10-3859-a3b4-e148608bbc8f",
                        "glosses": [
                            "Redevance due par chaque foyer dans le système féodal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18aaace-1de6-4da7-8d8e-27177ba042d2",
                                "sense_id": "893e6ff6-85b0-337e-b40c-c30429224496",
                                "text": "Revenu ruiné en Gascogne, il [le Prince Noir] réclame un fouage en janvier 1368. Les seigneurs gascons rechignent puis font appel au roi de France."
                            },
                            {
                                "example_id": "b67219d3-55d8-49bc-b7bd-1806cac4ecb0",
                                "sense_id": "893e6ff6-85b0-337e-b40c-c30429224496",
                                "text": "Les receveurs de circonscription n’avaient pas à se mêler de la « cueillette » des deniers du fouage."
                            },
                            {
                                "example_id": "133630e3-5925-48f8-b0e8-23a6b3ee2b0d",
                                "sense_id": "893e6ff6-85b0-337e-b40c-c30429224496",
                                "text": "Le fouage (census pro singulis focis exactus) était un cens, ou une espèce de taille, exigé par chaque feu sur les biens roturiers. Avec le fouage graduellement augmenté, se payaient les dettes de la province."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f08d2478-3ec4-4e3c-ba32-d922223a1eeb",
                        "source_entry_id": "b221ef4f-ec10-3859-a3b4-e148608bbc8f",
                        "source_sense_id": "893e6ff6-85b0-337e-b40c-c30429224496",
                        "target_lang_word": "hearth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hearth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "687ef741-b37a-35f9-b11e-8c0b73f02499",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "The place in a home where a fire is or was traditionally kept for home heating and for cooking, usually constituted by at least a hearthstone and often enclosed to varying degrees by any combination of reredos, fireplace, oven, smoke hood, or chimney."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ed4c953-f2c2-4c1c-8697-591819bb727d",
                                                "sense_id": "687ef741-b37a-35f9-b11e-8c0b73f02499",
                                                "text": "For by the hearth the children sit\n⁠Cold in that atmosphere of Death,\n⁠And scarce endure to draw the breath,\nOr like to noiseless phantoms flit: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a96577-b872-3afa-a75a-7db4efc9713a",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "A hearthstone, either as standalone or as the floor of an enclosed fireplace or oven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774a8900-6aba-4659-80cc-090ec78c5cc9",
                                                "sense_id": "f9a96577-b872-3afa-a75a-7db4efc9713a",
                                                "text": "cooking on an open hearth"
                                            },
                                            {
                                                "example_id": "cada58b2-3ab2-4bda-94fa-60aa5b0b2132",
                                                "sense_id": "f9a96577-b872-3afa-a75a-7db4efc9713a",
                                                "text": "When the flames at last began to flicker and subside, his lids fluttered, then drooped ; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs kneeling on the hearth and heaping kindling on the coals, and her pretty little Alsatian maid beside her, laying a log across the andirons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05f86bd9-58e1-3e4e-964c-97ac81f0e254",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "A fireplace: an open recess in a wall at the base of a chimney where a fire may be built."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2750e361-eee9-339b-8bd0-a3a6e7d576a9",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "The lowest part of a metallurgical furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9db301e9-b044-3ea5-b7c3-e80a2c47dd85",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "A brazier, chafing dish, or firebox."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2dc7eb1-9480-33b9-8933-3e067399cc8f",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "Home or family life."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51411b88-a7a8-4500-9bc0-7ebab6257740",
                                                "sense_id": "e2dc7eb1-9480-33b9-8933-3e067399cc8f",
                                                "text": "To put it simply, he seems to me to be starting out to harm the city, from its very hearth, by setting out to wrong you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b834c10-be80-3ca8-a0a4-e190e9e9dbea",
                                        "entry_id": "5c4add74-746b-39f8-8a71-fed11d843054",
                                        "glosses": [
                                            "A household or group in some forms of the modern pagan faith Heathenry."
                                        ],
                                        "tags": [
                                            "Germanic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13561930-b58c-4c33-bba6-9f8ee7837d24",
                                                "sense_id": "4b834c10-be80-3ca8-a0a4-e190e9e9dbea",
                                                "text": "Neopagan groups take many forms, from Wiccan covens to Druid groves, from Heathen hearths to magical lodges[…]"
                                            },
                                            {
                                                "example_id": "88bfae6a-f607-49e0-bf75-14b078c7708a",
                                                "sense_id": "4b834c10-be80-3ca8-a0a4-e190e9e9dbea",
                                                "text": "Asatru is practised all over Northern Europe and also in North America. Like Druidry, it is organized into bodies with sub-groups, the hearths."
                                            },
                                            {
                                                "example_id": "1f352de5-5c31-438e-b214-d65bf1eafc45",
                                                "sense_id": "4b834c10-be80-3ca8-a0a4-e190e9e9dbea",
                                                "text": "Smaller localized groups known as 'hearths' meet regularly, and are comparable, in size and function, with a Wiccan 'Coven' or Druidic 'Grove'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
