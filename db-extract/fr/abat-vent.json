        "fr-extract.jsonl": [
            {
                "entry_id": "e588c5d7-4483-31d1-adf6-84b50a1ad490",
                "word": "abat-vent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4f1c6dd6-185a-40c3-883e-5afe44cddbeb",
                        "entry_id": "e588c5d7-4483-31d1-adf6-84b50a1ad490",
                        "tags": [
                            "plural"
                        ],
                        "form": "abat-vents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "419a4e28-8b26-3e78-b94f-ac3dae761c15",
                        "entry_id": "e588c5d7-4483-31d1-adf6-84b50a1ad490",
                        "glosses": [
                            "Assemblage de petites lames inclinées et parallèles, qui garantit du vent, de la neige et de la pluie les ouvertures d’une maison, d’un atelier, d’un clocher, etc., sans empêcher la circulation de l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22288317-5f64-4025-b1bd-9cac715f93bf",
                                "sense_id": "419a4e28-8b26-3e78-b94f-ac3dae761c15",
                                "text": "Un abat-vent couvert de plomb, d’ardoise."
                            },
                            {
                                "example_id": "2eb77347-b16b-465f-9d5d-f832086671e9",
                                "sense_id": "419a4e28-8b26-3e78-b94f-ac3dae761c15",
                                "text": "Les fenêtres de ce séchoir, de ce magasin sont garnies d’abat-vent."
                            },
                            {
                                "example_id": "d84628bc-e625-4863-93e5-11e024f71965",
                                "sense_id": "419a4e28-8b26-3e78-b94f-ac3dae761c15",
                                "text": "Les persiennes sont des espèces d’abat-vents."
                            },
                            {
                                "example_id": "92631105-4e87-4c1f-83c9-c5025a44bc0a",
                                "sense_id": "419a4e28-8b26-3e78-b94f-ac3dae761c15",
                                "text": "Quelques jours se passèrent ; elle tenait ses abat-vent bien fermés, pour ne rien voir, et ne regardait plus du côté du cimetière."
                            }
                        ]
                    }
                ],
