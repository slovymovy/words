                "translations": [
                    {
                        "translation_id": "aad5be7c-d83c-4ff4-ae34-5ee64202bfc5",
                        "source_entry_id": "6935656a-f81a-3301-aa8c-37b2b6087b9c",
                        "source_sense_id": "7ab8e8c8-f9eb-3387-b920-2df435079239",
                        "source_sense_description": "Sofa, auf dem man auch liegen kann",
                        "target_lang_word": "chaise longue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaise longue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                        "entry_id": "8d0a26f8-f3ff-307a-b9e0-42e95fc40976",
                                        "glosses": [
                                            "Meuble entre siège et lit où l’on peut s'asseoir ou s'allonger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55398ca-5615-4634-9928-609de50f1904",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Les deux pièces n’en faisaient qu’une, ou du moins le boudoir n’était guère que le seuil de la chambre, une grande alcôve, garnie de chaises longues."
                                            },
                                            {
                                                "example_id": "c4b3c4dd-1dbe-461f-bafd-f290d4d69f9b",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Nous nous allongeons côte à côte dans des chaises longues qui mériteraient d’être repeintes."
                                            },
                                            {
                                                "example_id": "42619b70-58ac-4ae7-8aa5-924a36746eff",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Je me souviens d’avoir skié sans bonnet, que Bébé lisait une biographie de Truman Capote dans une chaise longue devant l’hôtel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ade44ab8-17ab-4a50-a677-2da7e72d3690",
                        "source_entry_id": "6935656a-f81a-3301-aa8c-37b2b6087b9c",
                        "source_sense_id": "7ab8e8c8-f9eb-3387-b920-2df435079239",
                        "source_sense_description": "Sofa, auf dem man auch liegen kann",
                        "target_lang_word": "méridienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méridienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d13161a0-183e-30e0-906d-ffb2ebfeb400",
                                        "entry_id": "228c5001-7f0b-35dc-b68c-3211cd405820",
                                        "glosses": [
                                            "Ligne d’intersection du plan méridien et du plan horizontal en un lieu donné."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2619640f-b374-49eb-8d0d-f325117383ba",
                                                "sense_id": "d13161a0-183e-30e0-906d-ffb2ebfeb400",
                                                "text": "Calculer une méridienne : se situer par observation au sextant du soleil à son zénith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                        "entry_id": "228c5001-7f0b-35dc-b68c-3211cd405820",
                                        "glosses": [
                                            "Sieste à laquelle les habitants des pays chauds se livrent ordinairement vers l’heure du midi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ed80ae-46bc-4a32-9486-3a7b9e8c5fec",
                                                "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                                "text": "Après une courte méridienne, il se fit donner de quoi se laver, et se frotta longtemps les deux joues en les gonflant à l’aide de la langue pour les mieux savonner."
                                            },
                                            {
                                                "example_id": "dfd0d0e6-0817-4dff-b805-373c6f6cc1a1",
                                                "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                                "text": "Fin du travail à 9 heures et intervalle, Sexte à 11 heures, Angélus et le dîner à 11 heures 1/2, Méridienne après le dîner, Fin de la méridienne à 1 heure 1/2."
                                            },
                                            {
                                                "example_id": "7b0177e1-5287-4810-bfc6-0b0fb56a00dd",
                                                "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                                "text": "Passé la Loire vers le Nord, très peu de sieste et jadis, durant l’été, tout le monde faisait sa méridienne."
                                            },
                                            {
                                                "example_id": "3d2dc05f-67fd-437b-a207-4eb98e40ec18",
                                                "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                                "text": "Maman, elle aussi, a remarqué l’inconnu à la méridienne."
                                            },
                                            {
                                                "example_id": "b6eddc16-dcae-4c69-a93f-c4713e481e11",
                                                "sense_id": "d739ff25-f53b-3e14-bc3e-f2ab4a0ca52d",
                                                "text": "Faire la méridienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c246b3-2710-37d1-93bc-b7e84caf27a5",
                                        "entry_id": "228c5001-7f0b-35dc-b68c-3211cd405820",
                                        "glosses": [
                                            "Lit de repos à deux chevets de hauteur inégale, sorte de grande bergère ou de canapé, nommé aussi récamier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a093b838-1cb6-4fab-9715-3de460b2a50b",
                                                "sense_id": "37c246b3-2710-37d1-93bc-b7e84caf27a5",
                                                "text": "Jeanne, de côté, jetait un œil sur la méridienne où une fois de plus, elle avait failli sombrer, qu’elle redoutait et surnommait avec l’humour des tristes « mon Masoch », puis sérieusement, totalement, elle se livrait à ses arpèges, en tissant le hamac idéal et s’y berçait jusqu’à tomber de fatigue."
                                            },
                                            {
                                                "example_id": "c1216a8c-d5b8-4e48-9705-e1a0a4468e60",
                                                "sense_id": "37c246b3-2710-37d1-93bc-b7e84caf27a5",
                                                "text": "Pendant des années je suis venu m’asseoir à côté d’elle [la grand-mère] sur la grande méridienne au tissu rouge capitonné et elle racontait."
                                            },
                                            {
                                                "example_id": "9537981b-b73d-4b91-88f7-d3f66f55615b",
                                                "sense_id": "37c246b3-2710-37d1-93bc-b7e84caf27a5",
                                                "text": "Absorbée par sa tâche, elle n’entend pas madame s’installer sur l'une des méridiennes, et manque de briser la petite porcelaine qu’elle caressait de son plumeau lorsque Victoire lui dit :\n« Bonjour, Céleste. »"
                                            },
                                            {
                                                "example_id": "9ddf1fe5-ae3c-45da-81a9-c6d4d2547735",
                                                "sense_id": "37c246b3-2710-37d1-93bc-b7e84caf27a5",
                                                "text": "Une méridienne de style Empire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72100ac0-df0f-39d1-a689-abee741b212b",
                                        "entry_id": "228c5001-7f0b-35dc-b68c-3211cd405820",
                                        "glosses": [
                                            "Cadran solaire vertical et tourné vers le sud, qui ne donne l’heure qu’autour du midi local."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c68fc97-51c7-418b-a1d2-7b37be56c41b",
                                                "sense_id": "72100ac0-df0f-39d1-a689-abee741b212b",
                                                "text": "La méridienne était utilisée pour régler les horloges et les montres portables sur l’heure du Soleil."
                                            }
                                        ]
                                    }
                                ]
                            },
