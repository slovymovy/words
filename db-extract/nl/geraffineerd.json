                "forms": [],
                "senses": [
                    {
                        "sense_id": "7842be57-f561-33c7-9c30-df477a46b9eb",
                        "entry_id": "334ba39a-fc4b-3324-82b7-5c4ff42ad542",
                        "glosses": [
                            "goed doordacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb4247d-7e36-4b7e-8dc0-7093e22b9246",
                                "sense_id": "7842be57-f561-33c7-9c30-df477a46b9eb",
                                "text": "De bankrover had een geraffineerd plan bedacht om de kluis van de bank open te breken."
                            },
                            {
                                "example_id": "312b9c85-3809-40ba-998e-f33ee2a3c058",
                                "sense_id": "7842be57-f561-33c7-9c30-df477a46b9eb",
                                "text": "Er ontvouwde zich een geraffineerd panorama bij de bocht. Aan het einde van de kade langs de gracht, die met eenvoudige meerpalen van blank hout was gearceerd, was de slanke boog van de Ponte del Gafaro getekend voor de oudroze gevel van een laag palazzo, die was voorzien van zeven hoge puntige ramen in een witmarmeren sponning en werd bekroond met de klokkentoren van een kerk daarachter."
                            }
                        ]
                    },
                    {
                        "sense_id": "af53c6a5-4d0f-3e6f-bcaa-f7f5a1ca2ab9",
                        "entry_id": "334ba39a-fc4b-3324-82b7-5c4ff42ad542",
                        "glosses": [
                            "bewerkt en gezuiverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
