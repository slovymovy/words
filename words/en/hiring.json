                    "sense_definition": "The act or process of employing someone for a job.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "employment_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager is responsible for the <w>hiring</w> and training of all new employees.",
                            "target_lang_translations": {
                                "ru": "Менеджер отвечает за <w>наем</w> и обучение всех новых сотрудников.",
