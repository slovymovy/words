                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5da5b68-6f66-4d14-8c5f-938a226c5271",
                                "sense_id": "8568e446-3a9b-3b14-8b67-ecf66d0d78cb",
                                "text": "„Von 1968 an war S. während des Interstiz, einer Praxisphase in der Ordensausbildung, Geographielehrer am Canisius-Kolleg und half bei der Jugendarbeit.“"
                            },
                            {
                                "example_id": "8446362b-018d-4ce8-bb51-e93e71b93d61",
                                "sense_id": "8568e446-3a9b-3b14-8b67-ecf66d0d78cb",
                                "text": "„Und plötzlich stand vor Pierres Augen ganz leibhaftig sein längst vergessener, freundlicher, alter Geographielehrer, der ihn in der Schweiz unterrichtet hatte.“"
                            }
                        ],
