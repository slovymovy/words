                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b55e10f-3328-40c0-9fed-9860cdf5f754",
                                "sense_id": "33601eed-2fda-390f-8a74-552a4419f8ac",
                                "text": "Założycielka koncepcjonistek była damą na dworze królowej Izabeli Portugalskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d57ef0a2-b276-45d3-9249-73439817344c",
                        "source_entry_id": "bf384927-eed2-32b5-abf7-e1fd59b9808d",
                        "source_sense_id": "33601eed-2fda-390f-8a74-552a4419f8ac",
                        "target_lang_word": "Isabel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isabel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08fb6de5-266a-3b2b-a924-02bc232d147c",
                                        "entry_id": "eea648a0-514d-351a-94fd-5ab8d225c8a1",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96de7dd7-b0a6-4d47-b4f4-ebe205a6350f",
                                                "sense_id": "08fb6de5-266a-3b2b-a924-02bc232d147c",
                                                "text": "Mariana. O my good lord! Sweet Isabel, take my part:\nLend me your knees, and all my life to come,\nI'll lend you all my life to do you service."
                                            },
                                            {
                                                "example_id": "c58298d0-9ccf-45b0-8324-b3e770bd6cd6",
                                                "sense_id": "08fb6de5-266a-3b2b-a924-02bc232d147c",
                                                "text": "There is a silvery bell-like music in the name, which is exceedingly attractive, and which has made it a favorite with the poets. - - - Mary Howitt, in her Flower comparisons, has the following melodious lines:\nNow for mad-cap Isabel: / What shall suit her, pr'y thee tell? / Isabel is brown and wild; /Will be evermore a child;"
                                            },
                                            {
                                                "example_id": "33a18577-8653-41ed-b2b6-0c7c46f03d4f",
                                                "sense_id": "08fb6de5-266a-3b2b-a924-02bc232d147c",
                                                "text": "I'm glad you spell your name like that. It's the best of all the ways to spell Isabel."
                                            },
                                            {
                                                "example_id": "6cc105c8-4deb-47af-adcf-72473af998ca",
                                                "sense_id": "08fb6de5-266a-3b2b-a924-02bc232d147c",
                                                "text": "How many poor girls, who would have been wild and raging and beautiful and free sex goddesses if only their parents had found it in their hearts to name them Isabel, instead had to stuff their poor psyches into the name Heather?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb6f13c-7bb9-33c1-b122-b361d83d6ad5",
                                        "entry_id": "eea648a0-514d-351a-94fd-5ab8d225c8a1",
                                        "glosses": [
                                            "A surname originating as a matronymic."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a343b57d-df09-326e-9dd2-78d28bb5446f",
                                        "entry_id": "eea648a0-514d-351a-94fd-5ab8d225c8a1",
