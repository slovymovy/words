            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                    "sense_definition": "Son perçant ou puissant émis par la voix d'un être humain sous l'effet d'une émotion vive ou pour appeler.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "son_voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soudain, un <w>cri</w> perçant a retenti dans la nuit noire."
                        },
                        {
                            "text": "Elle a poussé un grand <w>cri</w> de joie en apprenant la nouvelle."
                        }
                    ],
                    "synonyms": [
                        "hurlement"
                    ],
                    "antonyms": [
                        "chuchotement",
                        "murmure",
                        "silence"
                    ],
                    "common_phrases": [
                        "pousser un cri",
                        "cri de joie"
                    ]
                },
                {
                    "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                    "sense_definition": "Bruit ou appel vocal produit naturellement par un animal.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "son_voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la forêt, le <w>cri</w> du hibou a surpris les randonneurs."
                        },
                        {
                            "text": "Cet enfant adore imiter le <w>cri</w> des différents animaux de la ferme."
                        }
                    ],
                    "common_phrases": [
