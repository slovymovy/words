                                    {
                                        "sense_id": "c85b76e7-f7b2-3b0b-a82a-390b328a72f8",
                                        "entry_id": "0f09b047-cef2-3ab8-a355-bb04c3213dba",
                                        "glosses": [
                                            "Philosophie de Descartes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f68764-9ec5-4643-a8ba-76f7b3c39a9c",
                                                "sense_id": "c85b76e7-f7b2-3b0b-a82a-390b328a72f8",
                                                "text": "Ce principe de la philosophie cartésienne, je pense, donc je suis, est ce que les adversaires du cartésianisme ont attaqué avec le plus de persévérance ; et cela se conçoit, car ce principe admis, l’autorité de la conscience et de la raison s’ensuit nécessairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca73ed4d-039a-3642-971b-434b78d194c7",
                                        "entry_id": "0f09b047-cef2-3ab8-a355-bb04c3213dba",
                                        "glosses": [
                                            "Ensemble des philosophies qui se réclament des principes et des thèses de Descartes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4684a37f-4d49-44f9-aee8-1f8fd837cb9f",
                                                "sense_id": "ca73ed4d-039a-3642-971b-434b78d194c7",
                                                "text": "Leibniz, Malebranche et Spinoza sont les trois grandes figures du cartésianisme au XVIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "459493bd-c510-4e1e-afd4-94f3996ed902",
                                                "sense_id": "ca73ed4d-039a-3642-971b-434b78d194c7",
                                                "text": "Le cartésianisme est une philosophie révolutionnaire, mais bien indépendamment de la volonté de Descartes!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
