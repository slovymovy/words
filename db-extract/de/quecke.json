                    {
                        "sense_id": "bf0b84db-bbb5-3154-b472-391a73abdf48",
                        "entry_id": "74b318a9-9f68-390c-9ed7-2231883fbd0c",
                        "glosses": [
                            "Wildkraut aus der Familie der Süßgräser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e316f9-86c3-490d-a012-4a84986703ce",
                                "sense_id": "bf0b84db-bbb5-3154-b472-391a73abdf48",
                                "text": "Der Weg war von Quecken bewuchert."
                            },
                            {
                                "example_id": "b373fa30-6a05-48d7-9071-f9a40c090807",
                                "sense_id": "bf0b84db-bbb5-3154-b472-391a73abdf48",
                                "text": "„Die Quecke durchzieht den Boden mit meterlangen Ausläufern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65f42b02-81c5-4ffc-a1df-9bb43989d875",
                        "source_entry_id": "74b318a9-9f68-390c-9ed7-2231883fbd0c",
                        "source_sense_id": "bf0b84db-bbb5-3154-b472-391a73abdf48",
                        "source_sense_description": "Botanik: Wildkraut aus der Familie der Süßgräser",
                        "target_lang_word": "couch grass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couch grass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d69ae504-8912-37c6-be2f-33e74b5e1b16",
                                        "entry_id": "8b055022-550b-3321-bdaa-88ad84c7d0f0",
                                        "glosses": [
                                            "A grass of species Elymus repens, usually considered a weed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d8b5726-f86c-44df-a68d-9df3290c3501",
                                                "sense_id": "d69ae504-8912-37c6-be2f-33e74b5e1b16",
                                                "text": "The roots of plants, disengaged from the soil in the process of tilling and cleaning it, are also employed as a vegetable manure. Some of these, however, as the couch grass, being very vivacious, would readily spring again: and therefore it is necessary that their vegetative powers be destroyed, which may be done by mixing them with lime, and forming in this way a compost. Many farmers, however, to save time, or to prevent the risk of the plants springing again, burn them in little heaps upon the ground at the time of their being collected, and spread the ashes upon the surface. This may be sometimes convenient, but the effect is, that the principal nutritive part of the plant is dissipated, and nothing left but the carbonaceous, earthy, and other insoluble matter. —Low's Elements of Practical Agriculture."
                                            },
                                            {
                                                "example_id": "6c449324-c874-4a95-896f-3973a9feef34",
                                                "sense_id": "d69ae504-8912-37c6-be2f-33e74b5e1b16",
                                                "text": "But the trouble was pervasive and deep-rooted as couch-grass."
                                            },
                                            {
                                                "example_id": "fa2d24be-ee5f-4218-92c6-3ed5ced6eefa",
                                                "sense_id": "d69ae504-8912-37c6-be2f-33e74b5e1b16",
                                                "text": "The old couple who had lived there hadn't been able to do much and the garden was a wilderness of couch-grass and dandelion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
