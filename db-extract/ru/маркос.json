                "senses": [
                    {
                        "sense_id": "2230216b-5105-38c7-b0c0-b873644559c8",
                        "entry_id": "edec3f88-7827-3a68-a47d-9a365b9fb3ee",
                        "glosses": [
                            "испанское и португальское мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8d7d40-8e18-4e32-89f1-eba626d8f68a",
                                "sense_id": "2230216b-5105-38c7-b0c0-b873644559c8",
                                "text": "Маркос Букеридж, сотрудник ботанического сада в бразильском городе Сан-Пауло, сообщил, что при увеличении концентрации углекислого газа вдвое у растения вдвое же увеличивается скорость фотосинтеза."
                            }
                        ]
                    }
