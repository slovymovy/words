{
    "word_family": [
        "apply",
        "application",
        "applicable",
        "applicability",
        "applicator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96da2583-086c-32e9-a96d-7c1cf7443983",
                    "sense_definition": "A person who formally requests something, such as a job, admission to a school, or a grant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "candidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our job advertisement attracted seven <w>applicants</w> for the position.",
                            "target_lang_translations": {
                                "ru": "Наше объявление о вакансии привлекло семь <w>кандидатов</w> на эту должность.",
                                "tr": "İş ilanımız pozisyon için yedi <w>başvuran</w> çekti."
                            }
                        },
                        {
                            "text": "The successful <w>applicant</w> will start working with us next month.",
                            "target_lang_translations": {
                                "ru": "Успешный <w>соискатель</w> приступит к работе с нами в следующем месяце.",
                                "tr": "Başarılı <w>aday</w> önümüzdeki ay bizimle çalışmaya başlayacak."
                            }
                        }
                    ],
                    "synonyms": [
                        "applicate"
                    ],
                    "common_phrases": [
                        "successful applicant",
                        "job applicant",
                        "qualified applicant",
                        "prospective applicant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который официально запрашивает что-либо, например, работу, зачисление в учебное заведение или грант.",
                        "tr": "İş, okula kabul veya hibe gibi bir şeyi resmi olarak talep eden kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "на должность или позицию"
                            },
                            {
                                "target_lang_word": "соискатель",
                                "target_lang_sense_clarification": "претендент на работу или степень"
                            },
                            {
                                "target_lang_word": "заявитель",
                                "target_lang_sense_clarification": "лицо, подающее официальную заявку"
                            },
                            {
                                "target_lang_word": "абитуриент",
                                "target_lang_sense_clarification": "при поступлении в учебное заведение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başvuran",
                                "target_lang_sense_clarification": "bir yere başvuru yapan kişi"
                            },
                            {
                                "target_lang_word": "aday",
                                "target_lang_sense_clarification": "iş veya pozisyon için aday"
                            },
                            {
                                "target_lang_word": "başvuru sahibi",
                                "target_lang_sense_clarification": "resmi başvuru yapan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba72b6e-559b-37c9-9c7f-0b03a1a0defe",
                    "sense_definition": "A party who initiates legal proceedings against another party in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal party",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>applicant</w> filed a formal complaint against the corporation.",
                            "target_lang_translations": {
                                "ru": "<w>Заявитель</w> подал официальную жалобу на корпорацию.",
                                "tr": "<w>Başvuran</w>, şirkete karşı resmi bir şikayette bulundu."
                            }
                        },
                        {
                            "text": "The judge asked the <w>applicant</w> to provide more evidence for the case.",
                            "target_lang_translations": {
                                "ru": "Судья попросил <w>истца</w> предоставить больше доказательств по делу.",
                                "tr": "Hâkim, <w>davacıdan</w> dava için daha fazla kanıt sunmasını istedi."
                            }
                        }
                    ],
                    "antonyms": [
                        "respondent"
                    ],
                    "common_phrases": [
                        "legal applicant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторона, инициирующая судебное разбирательство против другой стороны в суде.",
                        "tr": "Mahkemede başka bir tarafa karşı yasal süreç başlatan taraf."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявитель",
                                "target_lang_sense_clarification": "лицо, подающее жалобу или иск"
                            },
                            {
                                "target_lang_word": "истец",
                                "target_lang_sense_clarification": "лицо, предъявляющее иск в суде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "davacı",
                                "target_lang_sense_clarification": "dava açan taraf"
                            },
                            {
                                "target_lang_word": "başvuran",
                                "target_lang_sense_clarification": "hukuki başvuruda bulunan kişi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "647a4dd8-9692-36f5-9783-55de0ab16b2a",
                    "sense_definition": "The third coordinate, often called the z-coordinate, in a three-dimensional Cartesian coordinate system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this 3D model, the <w>applicant</w> represents the height of the object.",
                            "target_lang_translations": {
                                "ru": "В этой 3D-модели <w>аппликата</w> представляет высоту объекта.",
                                "tr": "Bu 3D modelde <w>aplikat</w>, nesnenin yüksekliğini temsil eder."
                            }
                        },
                        {
                            "text": "You must calculate the <w>applicant</w> to find the exact point in space.",
                            "target_lang_translations": {
                                "ru": "Вы должны вычислить <w>аппликату</w>, чтобы найти точную точку в пространстве.",
                                "tr": "Uzaydaki tam noktayı bulmak için <w>aplikatı</w> hesaplamalısınız."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третья координата, часто называемая z-координатой, в трехмерной декартовой системе координат.",
                        "tr": "Üç boyutlu Kartezyen koordinat sisteminde genellikle z koordinatı olarak adlandırılan üçüncü koordinat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппликата",
                                "target_lang_sense_clarification": "математический термин для z-координаты"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aplikat",
                                "target_lang_sense_clarification": "z koordinatı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}