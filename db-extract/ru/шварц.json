                                                "example_id": "d7a44abf-c496-49b3-9ef5-60fa0571d34e",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Die Schwarz kommen heute von Langeooge."
                                            },
                                            {
                                                "example_id": "22222c21-8051-4afb-a0e3-7c27f9a41d1d",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Der Schwarz trägt nie die Schals, die die Schwarz ihm strickt."
