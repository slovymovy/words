                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb861493-9350-3ba7-aace-254dc92e042d",
                        "entry_id": "ec728266-cbc5-3d71-943f-9bb07ec35cdf",
                        "glosses": [
                            "A metropolis; the main city of a country or area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3324a5d7-7ec6-40f9-a5c9-cf81f32b9d0e",
                                "sense_id": "cb861493-9350-3ba7-aace-254dc92e042d",
                                "text": "The first Antifas functioned as platforms to organize against far-right groups like the National Democratic Party (NPD) in an autonomist movement still numbering in the tens of thousands of active members and capable of occupying entire city blocks in some West German metropoles."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f2fa36b-e681-3bbf-ba6d-d5613defca81",
                        "entry_id": "ec728266-cbc5-3d71-943f-9bb07ec35cdf",
                        "glosses": [
                            "The parent-state of a colony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f444d5e6-9d30-46f5-882d-3c32b921a19d",
                                "sense_id": "9f2fa36b-e681-3bbf-ba6d-d5613defca81",
                                "text": "Though the metropole remained confident in its Westminster ways, its newly independent colonies imposed constitutional constraints on the powers of parliament."
                            },
                            {
                                "example_id": "4a2bb72a-ff8e-49e6-bc4c-f932763a0f2f",
                                "sense_id": "9f2fa36b-e681-3bbf-ba6d-d5613defca81",
                                "text": "As Europe's population growth and commercial activity slowed down after 1620, its thirst for Spanish-American silver slackened: metropole and colony were drifting apart."
                            }
                        ]
                    },
                    {
                        "sense_id": "d640ec97-867b-3336-ac65-1ec5cf03e8af",
                        "entry_id": "ec728266-cbc5-3d71-943f-9bb07ec35cdf",
                        "glosses": [
                            "A bishop's see."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76bebe47-e4bc-4f2f-ac76-62a06d04f1a4",
                        "source_entry_id": "ec728266-cbc5-3d71-943f-9bb07ec35cdf",
                        "source_sense_description": "parent state",
                        "target_lang_word": "métropole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métropole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a1d507d-1bae-3420-bbf4-b5f7d6557dbf",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "Ville ayant fondé, au-delà des mers, une ou plusieurs autres colonies."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d3c5d4-b674-45b9-ae41-cfc827e19bca",
                                                "sense_id": "4a1d507d-1bae-3420-bbf4-b5f7d6557dbf",
                                                "text": "Phocée est la métropole qui fut à l’origine de la fondation de Marseille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a4449c-5b7b-33f1-a23c-bdf1c1b63058",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "Capitale administrative d’une province de l’Empire."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b4652b4-fffb-4a23-b5ae-1867bcb086fd",
                                                "sense_id": "c9a4449c-5b7b-33f1-a23c-bdf1c1b63058",
                                                "text": "Ils privèrent la ville [Antioche] du titre de métropole de la Syrie et de l’Orient et le donnèrent à Laodicée, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4668f6-cb37-328b-8ed8-cfaea1033e72",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "Capitale d’une province ecclésiastique, où se trouve le siège archiépiscopal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91039bfb-4ae8-4471-8111-be9d18f92366",
                                                "sense_id": "5d4668f6-cb37-328b-8ed8-cfaea1033e72",
                                                "text": "Bourges, Bordeaux et Toulouse sont des métropoles anciennes."
                                            },
                                            {
                                                "example_id": "dd5e95f7-ffa3-496f-b56c-5f69fc8f5e17",
                                                "sense_id": "5d4668f6-cb37-328b-8ed8-cfaea1033e72",
                                                "text": "Les métropoles civiles ont été les métropoles ecclésiastiques, excepté en Afrique, où l’évêque le plus ancien de chaque province en devenait le métropolitain, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce99ee8b-2259-388b-8730-f0e31360c28f",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "Partie de l’État où se situe la capitale, par opposition à ses colonies et territoires d’outre-mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d416be7a-1309-4748-9be6-66844c7b4e8f",
                                                "sense_id": "ce99ee8b-2259-388b-8730-f0e31360c28f",
                                                "text": "Les rapports d’une colonie avec la métropole, des territoires d’Outre-mer avec la métropole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "Principale ville d’une région, d’un État ou d’un pays. Ville haut placée dans la hiérarchie urbaine d’un État ou du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9216938-68e5-470c-b76a-4c4d7be9af97",
                                                "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                                "text": "La guerre civile est devenue bien difficile depuis la découverte des nouvelles armes à feu et depuis le percement des voies rectilignes dans les métropoles."
                                            },
                                            {
                                                "example_id": "77c41cf9-e527-4119-a179-ef413724eb36",
                                                "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                                "text": "Beaucoup de mes interlocuteurs me signalent encore […] la conception qu’on a du suffrage universel en ces contrées, où l’homme politique doit accepter d’être, dans la métropole, le protecteur, le soutien, le truchement de ses mandants."
                                            },
                                            {
                                                "example_id": "e02bea6e-6809-49e0-8b35-e10e21e8a17a",
                                                "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                                "text": "En France, Lyon, Marseille et Lille sont des métropoles d’équilibre."
                                            },
                                            {
                                                "example_id": "85351860-3cba-4eb0-a9e5-70245bda946f",
                                                "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                                "text": "L’espace urbain de Lemieux se divise essentiellement en deux villes, la Vieille Capitale, Québec, et la métropole, Montréal, qui représentent les deux polarités majeures de la culture québécoise."
                                            },
                                            {
                                                "example_id": "24e34379-3488-48d3-b17c-c50c46307368",
                                                "sense_id": "1cc2d0b7-c08b-389c-b6fe-8793b96978b7",
                                                "text": "bonjour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e9f0ec-fd92-3ee3-928d-52fa56d0305e",
                                        "entry_id": "0184eb36-4383-31eb-a560-49b127d264a6",
                                        "glosses": [
                                            "En France, depuis 2014, établissement public de coopération intercommunale (EPCI) à fiscalité propre, structure administrative regroupant plus de 400,000 habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7538a0-f347-4a8d-83e4-dbccf572917c",
                                                "sense_id": "d9e9f0ec-fd92-3ee3-928d-52fa56d0305e",
                                                "text": "La métropole, c’est une ingénieuse mais coûteuse trouvaille des socialistes pour asseoir leur pouvoir sur les plus grandes agglomérations urbaines de France. Alors que nous avons un millefeuille administratif unique au monde et déjà plantureux, leurs députés viennent de voter cette riche cerise sur le gâteau en plein été 2013, dans une de ces séances de nuit réservées aux seuls initiés."
                                            },
                                            {
                                                "example_id": "4bfb028d-8a17-4415-b8cc-2db6659eb9c4",
                                                "sense_id": "d9e9f0ec-fd92-3ee3-928d-52fa56d0305e",
                                                "text": "À Saint-Étienne, la métropole a par exemple investi plus de 70 millions d’euros, en partenariat avec la ville, pour l’accueil du tournoi, dont 65,1 millions uniquement pour la rénovation du stade Geoffroy-Guichard. Malgré les aides de l’État, de la Région, du Département et de la Ville, les travaux ont pesé significativement sur les finances de la métropole stéphanoise."
                                            }
                                        ]
                                    }
                                ]
                            },
