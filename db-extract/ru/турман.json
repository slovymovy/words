                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9f908a54-0a30-4bda-9d99-7890f44d98e8",
                        "source_entry_id": "2d964380-da8a-3319-80ef-1c8480a8be19",
                        "source_sense_id": "7042817f-4eaa-3d68-b922-4592fa557e6f",
                        "target_lang_word": "tumbler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c6e4da-554b-325a-a081-74c9d1ea4bce",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "One who tumbles; one who plays tricks by various motions of the body."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe0f4d41-198f-4d52-bac5-4711caea3d36",
                                                "sense_id": "19c6e4da-554b-325a-a081-74c9d1ea4bce",
                                                "text": "[…] the tricks of tumblers, funambuloes, baladines […]"
                                            },
                                            {
                                                "example_id": "123cb09a-39aa-4d22-9a89-2c8216ebb7c4",
                                                "sense_id": "19c6e4da-554b-325a-a081-74c9d1ea4bce",
                                                "text": "[…] and yokels looking up at the tinselled dancers and poor old rouged tumblers, while the light-fingered folk are operating upon their pockets behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145a459a-64fe-3a80-8cb2-d3c9c295d39e",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A movable obstruction in a lock, consisting of a lever, latch, wheel, slide, or the like, which must be adjusted to a particular position by a key or other means before the bolt can be thrown in locking or unlocking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e82a4f5-0fb6-3434-a2b2-0cc255e1acee",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A rotating device for smoothing and polishing rough objects, placed inside it, on relatively small parts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ed49508-291f-3925-89cb-17962c4e5385",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A piece attached to, or forming part of, the hammer of a gunlock, upon which the mainspring acts and in which are the notches for sear point to enter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11ba595a-b478-30bc-9921-e935952b81e9",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A drinking glass that has no stem, foot, or handle — so called because such glasses originally had a pointed or convex base and could not be set down without spilling. This compelled the drinker to finish their measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8f70dd2-bbb7-452d-994e-0610e0c9c003",
                                                "sense_id": "11ba595a-b478-30bc-9921-e935952b81e9",
                                                "text": "I poured out some whisky into a tumbler, and gave it to him."
                                            },
                                            {
                                                "example_id": "27b85d58-dd3d-4798-be80-51833c5dbf15",
                                                "sense_id": "11ba595a-b478-30bc-9921-e935952b81e9",
                                                "text": "\"You don't think it's too early?\" said the Captain.\n\"You and your liver must decide that between you,\" I replied.\n\"I'm practically a teetotaller,\" he said, as he poured himself out a good half-tumbler of Canadian Club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b004f2-e156-3685-a496-1d3d35c92095",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A variety of the domestic pigeon remarkable for its habit of tumbling, or turning somersaults, during its flight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8789e78-f178-3982-956b-ae34b42c8a53",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A beverage cup, typically made of stainless steel, that is broad at the top and narrow at the bottom commonly used in India."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11a7debb-a167-3c9e-aba6-8c3257aa51b5",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "Something that causes something else to tumble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "080cdb87-e7ee-3098-8171-9f3308f2cd8e",
                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A dog of a breed that tumbles when pursuing game, formerly used in hunting rabbits."
                                        ],
                                        "tags": [
