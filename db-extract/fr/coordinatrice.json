                    {
                        "form_id": "b84c5309-4dbd-4885-94a6-762106a0226f",
                        "entry_id": "bf79aea5-8453-3d82-b83c-ddbc5d90b6c9",
                        "tags": [],
                        "form": "coordonnatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c30f40c-c1d2-32ec-bcef-08fb77736409",
                        "entry_id": "bf79aea5-8453-3d82-b83c-ddbc5d90b6c9",
                        "glosses": [
                            "Celle qui coordonne, qui organise les rencontres entre différents intervenants et intervenantes, qui planifie les différentes tâches ou qui organise leur travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e357a36-f991-4566-b389-26f3582a3ae2",
                                "sense_id": "5c30f40c-c1d2-32ec-bcef-08fb77736409",
                                "text": "Peu après, lors d’une nouvelle réunion à laquelle participaient cette fois les adversaires du maire, un nouveau conflit éclata entre le représentant du peuple et la coordinatrice du projet, à propos des fonds et de leur utilisation."
                            },
                            {
                                "example_id": "f2cd67cd-c95a-46a5-8da4-73c28bf6ebb7",
                                "sense_id": "5c30f40c-c1d2-32ec-bcef-08fb77736409",
                                "text": "« Une grosse dizaine de projets territoriaux ont vu le jour depuis 2015 », souligne Alice Abbat, coordinatrice du Réseau consigne."
                            },
                            {
                                "example_id": "5827c4e8-f80f-471c-abf0-3f1c141115f1",
                                "sense_id": "5c30f40c-c1d2-32ec-bcef-08fb77736409",
                                "text": "L’idée, c’est de “raccrocher” les jeunes et de les rendre acteurs de ce changement de société afin de leur permettre de profiter des opportunités professionnelles qui en découlent, précise Marine Weller, coordinatrice de l’antenne parisienne de ce concept."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a6d5494-1538-4677-8a7d-d569eebd9998",
                        "source_entry_id": "bf79aea5-8453-3d82-b83c-ddbc5d90b6c9",
                        "source_sense_id": "5c30f40c-c1d2-32ec-bcef-08fb77736409",
                        "source_sense_description": "Celle qui coordonne.",
                        "target_lang_word": "Koordinatorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koordinatorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1788ccdb-328a-3385-a1cf-990b173adca1",
                                        "entry_id": "bc1e266c-3d17-32c8-aa38-cbd373e3450b",
                                        "glosses": [
                                            "weibliche Person, die organisiert und dabei verschiedene Ideen und Ansprüche sowie Rahmenbedingungen berücksichtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafdb868-d325-4cfd-b34b-87882d3201a5",
                                                "sense_id": "1788ccdb-328a-3385-a1cf-990b173adca1",
                                                "text": "Sie steht als Koordinatorin zwischen Veranstalter und Behörde und bestimmt letztlich das Ergebnis, das aus der Kombination dieser beiden Komponenten entsteht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
