                ],
                "senses": [
                    {
                        "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                        "entry_id": "8e3bf6d9-f1b4-3bb4-a01f-a89324d00436",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1277b6-831d-45bc-a660-87d33fdc6c45",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Frau Schmidts ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "844f2f21-0bf7-4a37-9cd7-96db6a263ef4",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Herr Schmidts wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bdf7c519-9af4-45fc-8f47-2f9d04b12c24",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Die Schmidts fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "411da056-001b-4012-aae4-469a5c35bf77",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Der Schmidts trägt nie die Pullover, die die Schmidts ihm strickt."
                            },
                            {
                                "example_id": "506803bf-c731-4df5-a5fd-da831ac521f2",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmidts kommt, geht der Herr Schmidts.“"
                            },
                            {
                                "example_id": "05176164-89c8-492c-82a4-5b86f8568330",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Schmidts kommt und geht."
                            },
                            {
                                "example_id": "bfb7226d-9e54-4ce6-931d-a784fcfecd1d",
                                "sense_id": "2cd4d827-4abd-38fc-9ca0-7f250908087c",
                                "text": "Schmidts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
