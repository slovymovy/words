                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sünderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                        "entry_id": "935e5952-6784-3082-af2c-b498e8e62c5c",
                                        "glosses": [
                                            "weibliche Person, die etwas Unerwünschtes/Verbotenes (eine Sünde) begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1a0f80-7bf6-416d-acdd-777782ef152d",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Erzählungen von namenlosen Sünderinnen und Ehebrecherinnen wurden schon früh mit ihrem Namen verknüpft, und auch heute noch kursieren Legenden, die besagen, Maria [Magdalena] habe ein intimes Verhältnis zu Jesus gehabt und nach seinem Tod ein Kind von ihm bekommen.“:"
                                            },
                                            {
                                                "example_id": "092504a1-37ed-4d1f-a584-8310c43f17cb",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Es war die Haltung, in der sie betete, in der sie als arme Sünderin Gott um Vergebung anflehte.“"
                                            },
                                            {
                                                "example_id": "7fbd83e6-c4c3-4499-80b3-31844d29c2ee",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Völlig verdattert, mit vor Schreck erdfarbenen Gesichtern standen die drei armen Sünderinnen und brachten keinen Mucks hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06a7bfb9-dc94-4ed5-8624-fa6d5b6dac64",
                        "source_entry_id": "95cbb510-e67d-3851-8ca3-03f1e658a0ef",
                        "source_sense_id": "0194870e-3b4c-31fc-8efc-bf23dc77eaf2",
                        "target_lang_word": "pécheresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pécheresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47ebe17c-2f88-31c6-a6e9-569133a62f26",
                                        "entry_id": "e2f099eb-49ef-32cc-9c57-7adda43144fd",
                                        "glosses": [
                                            "Celle qui commet des péchés, qui est sujet au péché, qui est enclin au péché, qui est dans l’habitude du péché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641f2982-5841-42ae-a827-cd34981a5109",
                                                "sense_id": "47ebe17c-2f88-31c6-a6e9-569133a62f26",
                                                "text": "Elle ne parle pas ce langage, bien sûr ! Oserait-elle troquer le doux roucoulement méridional contre cette brocaille sèche, ce brocard de pierrailles qu’on jurerait de l’allemand ? Ah ! pécheresse !"
                                            },
                                            {
                                                "example_id": "3fda4a5c-1675-4ae3-be9b-e4595c2c22e4",
                                                "sense_id": "47ebe17c-2f88-31c6-a6e9-569133a62f26",
                                                "text": "Pour cette pécheresse, Jésus a dit chez le pharisien : « Beaucoup de péchés lui sont remis , car elle a beaucoup aimé »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
