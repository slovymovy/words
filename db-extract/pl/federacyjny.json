                "translations": [
                    {
                        "translation_id": "8a4b272f-3945-40b2-a64c-b1480bc52ef6",
                        "source_entry_id": "cf9bdcd3-1b44-3565-9de3-b48992cfc888",
                        "source_sense_id": "d6a4929b-3d12-3fb0-9286-dc3c3db90c68",
