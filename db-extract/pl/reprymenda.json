                    {
                        "translation_id": "48854d2b-7230-4658-8015-c68e162bb202",
                        "source_entry_id": "32e90ec5-fcbf-3333-9dbe-b5020d76527f",
                        "source_sense_id": "663074f5-1db7-3e62-9075-c0efceb9628b",
                        "target_lang_word": "réprimande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réprimande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                        "entry_id": "fa19a6ea-fd44-3090-a5d2-2c1e5c730c32",
                                        "glosses": [
                                            "Blâme formulé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50e3235-2486-4a98-89c3-d94e32f9d760",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Il ne peut souffrir les réprimandes."
                                            },
                                            {
                                                "example_id": "37e187d0-3d5a-4249-acfd-8b5fa7baa6a0",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Douce, forte, sévère réprimande."
                                            },
                                            {
                                                "example_id": "4b84f0f7-5a9a-48f6-ab24-09fd236c77fb",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Faire des réprimandes."
                                            },
                                            {
                                                "example_id": "75de11a8-dbac-4829-9e9c-ffd36d7bd5e7",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Je ne ferai pas ce que vous me dites, j’en aurais, j’en recevrais des réprimandes."
                                            },
                                            {
                                                "example_id": "108542c4-37bd-4f1b-992d-97dcadb1f86a",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Je lui en ferai réprimande."
                                            },
                                            {
                                                "example_id": "f868f611-a13b-420b-bd30-9ae8b76b47c3",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Cela mérite réprimande."
                                            },
                                            {
                                                "example_id": "27a79926-8fec-4cd4-af7d-19640f6d705f",
                                                "sense_id": "3bc7e0ba-e8ba-3ce3-83a1-97135a92cf29",
                                                "text": "Cette fois, l’enfant attirera notre attention, non plus pour une réprimande, mais pour un encouragement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e7cd1d-97fd-3189-a0cb-4dc2fc3668ed",
                                        "entry_id": "fa19a6ea-fd44-3090-a5d2-2c1e5c730c32",
                                        "glosses": [
                                            "Peine disciplinaire qu’inflige un Conseil de l’ordre des avocats, une Chambre d’avoués, de notaires, un Conseil de discipline, etc."
                                        ],
