                ],
                "senses": [
                    {
                        "sense_id": "e7b78c3b-2110-3456-b869-c1396ed560e2",
                        "entry_id": "24f1d54c-c135-3e92-949a-a2093094b9e8",
                        "glosses": [
                            "Metallring, der durch die Nasenscheidewand des Hausrinds oder eines anderen Tieres eingesetzt wird, damit man es sicher führen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417e46bb-57c3-4366-8ab0-b2fc3151f1da",
                                "sense_id": "e7b78c3b-2110-3456-b869-c1396ed560e2",
                                "text": "„Die Fahne und das Wappen des Kantons Uri stellt einen schwarzen Kopf eines Auerochsen mit ausgestreckter roter Zunge und rotem Nasenring auf gelbem (heraldisch: goldenem) Grund dar.“"
                            },
                            {
                                "example_id": "c733e352-6fea-4cba-bbb1-1606fbc85801",
                                "sense_id": "e7b78c3b-2110-3456-b869-c1396ed560e2",
                                "text": "„Musiker, was konnte das für Walter Murath, dessen Familie an der Moorweide ganze Etagen bewohnte, anderes sein als eine Art Dompteur, der einen Bären mittels eines Nasenrings regiert, ein brotloser Equilibrist, ein Gaukler und fahrender Sänger?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "55ec49f0-7d94-3c30-895f-28ca7e0ec6c3",
                        "entry_id": "24f1d54c-c135-3e92-949a-a2093094b9e8",
                        "glosses": [
                            "an der Nase angebrachtes Piercing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7744d8-10d5-47c4-9989-3c088389e688",
                                "sense_id": "55ec49f0-7d94-3c30-895f-28ca7e0ec6c3",
                                "text": "Sie lässt sich am Wochenende einen Nasenring stechen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
