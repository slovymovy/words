                "senses": [
                    {
                        "sense_id": "39507139-6cc3-300f-9fb5-ced49c175ff6",
                        "entry_id": "198a9e8d-9fa7-374b-8a81-72be94db3f37",
                        "glosses": [
                            "воен. жарг., воен.-морск. капитан-лейтенант"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1286d26-1ab4-4126-925e-90e15ff4ac1b",
                                "sense_id": "39507139-6cc3-300f-9fb5-ced49c175ff6",
                                "text": "С первого взгляда на жену каплея, когда она только распахнула дверь, Гужов понял, что его личный состав, а конкретно капитан-лейтенант Чукин, склонен к фантазиям."
                            },
                            {
                                "example_id": "38d11226-c865-4d38-8492-4a64bca4336d",
                                "sense_id": "39507139-6cc3-300f-9fb5-ced49c175ff6",
                                "text": "Помню репетиции на основной сцене МХАТа рощинской пьесы «Валентин и Валентина», я там играл каплея Гусева."
                            }
                        ]
                    }
