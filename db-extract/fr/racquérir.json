                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f861d09-958f-401d-ba03-87a791d9610e",
                                "sense_id": "102371f4-cc38-3c00-a54a-5c57e13eebfc",
                                "text": "J'ai vu ce jeune amant , et crois que si tu veux Il sera bien aisé de racquérir ses vœux."
                            },
                            {
                                "example_id": "2aed55f0-3bb7-4023-8a28-723c48d3019c",
                                "sense_id": "102371f4-cc38-3c00-a54a-5c57e13eebfc",
                                "text": "Juste pour dire que je trouve très triste de ne plus avoir l'espoir de racquérir comme autrefois la flamme vacillante d'un beau TR réchauffant nos coeurs."
                            }
                        ]
                    }
