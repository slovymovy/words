        "fr-extract.jsonl": [
            {
                "entry_id": "2b665434-0f0d-35ae-b6c8-af79cfc928e8",
                "word": "à-propos",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "899bae44-0faf-3496-b61a-2cc817a2b092",
                        "entry_id": "2b665434-0f0d-35ae-b6c8-af79cfc928e8",
                        "glosses": [
                            "Caractère de ce qui est approprié, opportun, de ce qui arrive à point nommé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f5f718-2cb1-448b-916f-87b7fafe4c30",
                                "sense_id": "899bae44-0faf-3496-b61a-2cc817a2b092",
                                "text": "Votre observation manque d’à-propos."
                            },
                            {
                                "example_id": "ea63a12e-328c-47ea-81e6-0396a7e34315",
                                "sense_id": "899bae44-0faf-3496-b61a-2cc817a2b092",
                                "text": "Et moi aussi, je m’en souviendrai !… Quel heureux à-propos que cette confidence de Laurent !…"
                            },
                            {
                                "example_id": "9efc7258-d0cb-4382-9228-2bf76fcb411f",
                                "sense_id": "899bae44-0faf-3496-b61a-2cc817a2b092",
                                "text": "Comme on le pense bien, les compagnons de Blazius ne se firent pas prier et ils entrèrent dans la ferme fort charmés de l’aventure, qui, du reste, n’avait d’extraordinaire que l’à-propos de la rencontre."
                            },
                            {
                                "example_id": "84cf9ed3-1aea-4594-909b-0a44a2d719a0",
                                "sense_id": "899bae44-0faf-3496-b61a-2cc817a2b092",
                                "text": "– Putain, qu’est-ce que c’est que ce bordel ? rugit l’un des officiers présents avec un sens inné de l’à-propos."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                        "entry_id": "2b665434-0f0d-35ae-b6c8-af79cfc928e8",
                        "glosses": [
                            "Répartie ; esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253c0b10-019d-465e-a348-9c233d01c4e6",
                                "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                                "text": "Il importe donc, pour un radio-reporter, d'avoir des qualités de sang-froid, d’à-propos, de psychologie et même... surtout de diplomatie, afin de faire face à tous les orgueils et toutes les défaillances ; […]."
                            },
                            {
                                "example_id": "491657ec-4292-4254-914c-0446e06d4444",
                                "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                                "text": "D’habitude, je n’ai guère l’esprit d’à-propos, j’ai plutôt l’esprit de l’escalier."
                            },
                            {
                                "example_id": "3f67ed56-0b41-44ab-8fe5-f4516d0981ae",
                                "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                                "text": "Monsieur l’évêque suivait non seulement les exercices de la retraite, mais présidait partout, faisant lui-même la méditation le matin, parlant après chaque discours avec à-propos et onction."
                            },
                            {
                                "example_id": "fa81665c-1542-41da-bfd7-bd869a8ba37e",
                                "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                                "text": "Isabelle fermait sa fenêtre, et le Matamore, avec cet esprit d’à-propos qui le caractérise, faisait son entrée."
                            },
                            {
                                "example_id": "6193838d-77b9-42fe-a729-fa025767501c",
                                "sense_id": "bf1b2024-b616-36ec-8e80-75273fefa7f0",
                                "text": "Ces injurieurs pathologiques, - ou injuromanes - sont aisément reconnaissables, notamment par un détail qui ne saurait échapper à l'observateur averti : jamais il ne répliquent avec à-propos."
                            }
                        ]
                    },
                    {
                        "sense_id": "acb1ef4e-4ab7-3fae-802f-e72ea183f1d1",
                        "entry_id": "2b665434-0f0d-35ae-b6c8-af79cfc928e8",
                        "glosses": [
                            "Œuvre, généralement théâtrale, composée à l’occasion d’un événement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a167f24d-73d9-4c4f-ad04-5840169f7de2",
                                "sense_id": "acb1ef4e-4ab7-3fae-802f-e72ea183f1d1",
                                "text": "Un à-propos en vers."
                            }
                        ]
                    }
                ],
