        "fr-extract.jsonl": [
            {
                "entry_id": "9c3cad43-c0b8-3680-a8e6-42ab8859d792",
                "word": "constatation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c5996e44-cee9-4594-a417-8a86ec2c1850",
                        "entry_id": "9c3cad43-c0b8-3680-a8e6-42ab8859d792",
                        "tags": [
                            "plural"
                        ],
                        "form": "constatations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                        "entry_id": "9c3cad43-c0b8-3680-a8e6-42ab8859d792",
                        "glosses": [
                            "Action d'établir la réalité d'un fait, de constater l'état d'une chose, d'un lieu ; la relation qui en est faite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637c493b-66c9-44b6-a91a-ec424b477a48",
                                "sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                                "text": "Quoiqu’il en soit des propres constatations de l’expert, il résulte que même pour les adultes, et encore plus pour l’enfant, la dose annuelle de radioactivité est supérieure aux normes en vigueur dans le nucléaire pour les travailleurs habilités …."
                            },
                            {
                                "example_id": "d7b8b25c-ee0c-4069-b2c1-6985ce46e83d",
                                "sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                                "text": "Au bas mot, une bonne heure s’écoule comme ça, pendant laquelle Faroux et sa clique vont et viennent dans la maison, dégringolant l’escalier, le regrimpant, utilisant le téléphone, accueillant le médecin légiste qu’ils ont convoqué, un photographe du labo, aussi, etc., tout le saint-frusquin des constatations et perquisitions."
                            },
                            {
                                "example_id": "95926c71-7133-4821-9d92-6a12decc2b9a",
                                "sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                                "text": "Pour la constatation d’une infraction simple, il y a établissement d’un procès-verbal puis éventuellement paiement d’une amende."
                            },
                            {
                                "example_id": "54049cf7-7ca1-41f3-b6f0-ffbe9e00b022",
                                "sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                                "text": "Selon les constatations de la gendarmerie, le motocycliste doublait une file de véhicules quand il a percuté de plein fouet une voiture qui traversait la route."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77f87719-f62b-44bb-b80d-b91d2b289ef1",
                        "source_entry_id": "9c3cad43-c0b8-3680-a8e6-42ab8859d792",
                        "source_sense_id": "b31be0ad-7818-3629-a504-15759d22ef76",
                        "source_sense_description": "Action de constater ou résultat de cette action",
                        "target_lang_word": "Feststellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feststellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e5f69b-d0df-3610-a3c8-8c8a58ec9978",
                                        "entry_id": "f91dfa20-707f-31e7-ad33-a700079cc8d8",
                                        "glosses": [
                                            "Aussage, die einen Sachverhalt neutral beschreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6c748f-798a-4f03-8375-19e097407085",
                                                "sense_id": "84e5f69b-d0df-3610-a3c8-8c8a58ec9978",
                                                "text": "Warum regst du dich so auf? Das war nur eine Feststellung!"
                                            },
                                            {
                                                "example_id": "c4d36782-8a20-4a20-9033-047d7c68535f",
                                                "sense_id": "84e5f69b-d0df-3610-a3c8-8c8a58ec9978",
                                                "text": "„Diese Feststellung ist nur scheinbar überflüssig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54652580-e272-3568-bc7c-44ca9b5be4ba",
                                        "entry_id": "f91dfa20-707f-31e7-ad33-a700079cc8d8",
                                        "glosses": [
                                            "Beobachtung eines zuvor nicht erkannten Sachverhaltes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66746094-d0a4-4efa-acad-1c29b0103ee8",
                                                "sense_id": "54652580-e272-3568-bc7c-44ca9b5be4ba",
                                                "text": "Trotz der Feststellung, dass die Bestände stark überfischt sind, geht die Jagd auf den Blauflossen-Thunfisch unvermindert weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ce3978d5-f5e4-3478-82f2-a2ee04475c5f",
                                        "entry_id": "f91dfa20-707f-31e7-ad33-a700079cc8d8",
                                        "glosses": [
                                            "das Ermitteln eines Sachverhalts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20b80cb-fd51-41e5-86e7-a44e05634dfd",
                                                "sense_id": "ce3978d5-f5e4-3478-82f2-a2ee04475c5f",
                                                "text": "Die Feststellung des Täters brauchte nur einen halben Tag."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
