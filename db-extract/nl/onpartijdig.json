                                        "sense_id": "a5c090b6-9ddc-387d-9df6-23921769b5a9",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Not taking sides in a conflict such as war; nonaligned."
