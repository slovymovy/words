                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd6f562d-4347-36da-b023-a374a66d843c",
                                        "entry_id": "2404462e-1e12-38ca-bb6c-9d32c7186a60",
                                        "glosses": [
                                            "ohne besondere Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32eb9105-2daf-4afa-8598-a71459fc9bdc",
                                                "sense_id": "bd6f562d-4347-36da-b023-a374a66d843c",
                                                "text": "„Über den zugeschütteten Grundstücken und den durch die Trümmerwelt verwischten Straßenzügen ziehen sich nach einigen Tagen Trampelpfade, die auf legere Weise an frühere Wegverbindungen anknüpfen.“"
                                            }
                                        ],
