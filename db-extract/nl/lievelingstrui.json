                        "examples": [
                            {
                                "example_id": "c5bc90c4-3a33-471a-8336-23ea6637a2e1",
                                "sense_id": "2a9e6037-a6d3-307a-991f-ebdf8dff5199",
                                "text": "Op de Handwerkbeurs in Zwolle kunnen mensen vrijdag op de foto met hun lievelingstrui. In diverse steden vroeg de organisatie de afgelopen tijd mensen al naar hun lievelingstrui en zette hen daarmee op de kiek."
                            },
                            {
                                "example_id": "91babb64-a33b-4d72-be8d-091576133393",
                                "sense_id": "2a9e6037-a6d3-307a-991f-ebdf8dff5199",
                                "text": "Ik maak stukken waarvan ik vind dat ze er moeten zijn. Dan hoop ik dat het goed uitpakt, dat het misschien zelfs iemands lievelingstrui wordt."
                            }
                        ]
                    }
