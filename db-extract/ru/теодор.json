                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "516d307c-0352-36c2-9ee2-95c99d17971e",
                                        "entry_id": "e7be4f1f-8f74-373c-8f91-223d3fe45684",
                                        "glosses": [
                                            "A male given name from Latin and Ancient Greek; the name of a saint, pope, several emperors, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702f7c6a-c256-4498-906f-528dec2a0494",
                                                "sense_id": "516d307c-0352-36c2-9ee2-95c99d17971e",
                                                "text": "It is as well certainly not to call a parcel of idle and ragged young rogues by the titles of Augustus, Orlando, and Theodore: nor does it sound very fitting and heroical to hear a father cry out pompously to his little boy, as we did once, - \"You, Sir, there, - Maximilian,- come out of the gutter.\""
                                            },
                                            {
                                                "example_id": "e5610b7e-65a6-4257-9b2b-b273b0a589b6",
                                                "sense_id": "516d307c-0352-36c2-9ee2-95c99d17971e",
                                                "text": "'Perfect. What name are we going to give him?'\n'Theo.'\n'Oh.'\n'As in Theodore.'\n'Isn't that rather a...?' He stopped. Smiled at her again. 'Why Theodore?'\n'I like it. And it suits him. Maybe because it contains the sound 'adore'.'"
                                            }
                                        ]
                                    }
                                ]
                            },
