        "de-extract.jsonl": [
            {
                "entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
                "word": "letztlich",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                        "entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
                        "glosses": [
                            "letzten Endes, im Grunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727c17a3-45eb-48ef-b4bb-89ee0a4ad0ca",
                                "sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                                "text": "Aber letztlich geht man in eine Komödie, um sich über Stärken und Schwächen anderer Menschen zu amüsieren. Das hat \"Zucker\" erreicht."
                            },
                            {
                                "example_id": "34d1bbe1-f116-473e-b072-1e87dc6c9043",
                                "sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                                "text": "Der Landwirt glaubt, daß die Henstedter auch selbst eine Mitschuld an der Entwicklung haben: \"Alle wollen einen Tante-Emma-Laden vor der Haustür, aber letztlich geht dort keiner mehr einkaufen.\""
                            },
                            {
                                "example_id": "a8856f8c-71fd-4d7d-a84f-2401007e6925",
                                "sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                                "text": "„Hannibal, so lautet der häufig erhobene Vorwurf, hätte nach dem römischen Debakel den Krieg durch die Einnahme Roms beenden können. Dass er sich dazu nicht aufraffen konnte, so wird gefolgert, erweist ihn als einen zwar militärisch fähigen, aber letztlich mit politischer Blindheit geschlagenen Troupier.“"
                            },
                            {
                                "example_id": "3214c92a-f002-4698-b87a-b63fc5191494",
                                "sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                                "text": "„Letztlich kann der Rufname im Laufe eines Menschenlebens auch gewechselt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62fae7ed-c5ef-47ab-8cfc-197fadee9530",
                        "source_entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
                        "source_sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                        "source_sense_description": "letzten Endes, im Grunde",
                        "target_lang_word": "in the end",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the end",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38037a9a-a215-3a37-ab18-7f8ea37788cc",
                                        "entry_id": "72c9ca85-68e1-35c1-a31c-546e822d0b76",
                                        "glosses": [
                                            "Eventually, finally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bb6b03-e1bd-4311-91db-c28376159dad",
                                                "sense_id": "38037a9a-a215-3a37-ab18-7f8ea37788cc",
                                                "text": "We had a great day at the beach and in the end we had ice cream."
                                            },
                                            {
                                                "example_id": "f02c43c9-9604-4cf2-a7a9-cc63c0c392bb",
                                                "sense_id": "38037a9a-a215-3a37-ab18-7f8ea37788cc",
                                                "text": "Both sides will be disappointed not to have claimed their second win of the season, but in the end each had reasons to be grateful for the point."
                                            },
                                            {
                                                "example_id": "c87f86d5-56d2-4938-99f4-657e342f2ccd",
                                                "sense_id": "38037a9a-a215-3a37-ab18-7f8ea37788cc",
                                                "text": "Where the Czech upstart [Lukáš] Rosol, ranked 100 in the world, all but blew [Rafael] Nadal's head off with his blunderbuss in a fifth set of unrivalled intensity on Thursday night, [Julien] Benneteau, a more artful citizen, used a rapier to hurt his vaunted foe before falling just short of a kill. In the end, it was he who staggered from the scene of the fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7027536e-7f5a-32c0-951e-f0ed3c87549e",
                                        "entry_id": "72c9ca85-68e1-35c1-a31c-546e822d0b76",
                                        "glosses": [
                                            "After a thorough examination of the situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f164c5-2d51-4946-9957-d1c7acc8edca",
                                                "sense_id": "7027536e-7f5a-32c0-951e-f0ed3c87549e",
                                                "text": "In the end I think she'll be better off going to the same school as her friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "225509bb-d26d-4840-b291-76247babafd1",
                        "source_entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
                        "source_sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                        "source_sense_description": "letzten Endes, im Grunde",
                        "target_lang_word": "ultimately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultimately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb01f4c-e8ae-3ffe-b00e-4b721ad6e9b7",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Indicating the last item."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13bdaf22-9a5b-4730-bd53-8d42e7d1333e",
                                                "sense_id": "ccb01f4c-e8ae-3ffe-b00e-4b721ad6e9b7",
                                                "text": "Firstly,… Secondly,… Ultimately,…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154d52f1-6708-30dd-af6c-5c94952beabd",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Indicating the most important action."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe4ff92-a87e-4381-b549-9a5a69c158a6",
                                                "sense_id": "154d52f1-6708-30dd-af6c-5c94952beabd",
                                                "text": "Ultimately, he will have to make a decision before the end of the week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6656fa-654c-3863-ae9c-50366fdae48f",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "In the end; finally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d771f8-8960-4075-a983-bb7e9247c058",
                                                "sense_id": "0a6656fa-654c-3863-ae9c-50366fdae48f",
                                                "text": "That Wolves reached half-time on level terms had much to do with the ultimately luckless Hennessey, who was in action in the opening minute to tip away Samir Nasri's shot following a City corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Used to indicate the etymon at which a given etymological derivation terminates."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c619d4-73e1-4be6-8cd8-b8dc2bd983b5",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Cognate to Gottscheerish boßər, bàsser. Ultimately cognate to standard High German Wasser."
                                            },
                                            {
                                                "example_id": "0b600faa-80cb-4055-8040-3cac20cc02c8",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Shortened from maxiature, ultimately from Latin maximus (\"large\")."
                                            },
                                            {
                                                "example_id": "a27f57c4-3f7f-46af-b970-3959db86c9f4",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Ultimately from Latin equus (\"horse\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48e9d9bb-64be-44ff-a1b9-e3d1f5e29091",
                        "source_entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
                        "source_sense_id": "55caaca6-2800-3591-b051-4e44684061d6",
                        "source_sense_description": "letzten Endes, im Grunde",
                        "target_lang_word": "en fin de compte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en fin de compte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                        "entry_id": "19a0cfab-5294-331a-8df5-9eafca7c9ce9",
                                        "glosses": [
                                            "Tout bien considéré ; après tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7dac867-bd1a-40a7-b2f9-b51193abb78f",
                                                "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                                "text": "Il […] se résolut, en fin de compte, quand les fruits seraient mûrs, à profiter d’un jour où son ennemi serait en tournée quelque part, dans le finage, pour mettre à sac son potager et ses arbres, […]."
                                            },
                                            {
                                                "example_id": "62406de0-6900-4397-af9e-6403338dc52c",
                                                "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                                "text": "Voir que même fuité ça passait crème, ça valait pour autorisation. En fin de compte le rapport entre le risque que je prenais et l'effet réel pour la boîte, était assez minable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                        "entry_id": "19a0cfab-5294-331a-8df5-9eafca7c9ce9",
                                        "glosses": [
                                            "Finalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864c8c3d-003f-4102-9269-1eb9f25db5a8",
                                                "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                                "text": "L’espèce entière dépendait de ces méticulosités, en fin de compte."
                                            },
                                            {
                                                "example_id": "eefbdec4-2827-40bc-889c-fc0683486ee9",
                                                "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                                "text": "En fait, l'assurance va marcher, en fin de compte. Tout est couvert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec6e4ee7-e43f-4105-8a07-7b3d8ea859d4",
                        "source_entry_id": "68081a90-52e5-3a8d-9fb0-779b33d0fcc1",
