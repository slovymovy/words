                "senses": [
                    {
                        "sense_id": "b6b795b0-7e0e-3d16-bcfc-f8bba9707a17",
                        "entry_id": "c8b8a6ef-fa7b-33e3-81d6-cadf1279e16f",
                        "glosses": [
                            "Einwohner von Amerika mit lateinamerikanischen Wurzeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b5d8e7-d893-49f1-ba73-7093de70ca03",
                                "sense_id": "b6b795b0-7e0e-3d16-bcfc-f8bba9707a17",
                                "text": "„1996 wurde eine Grundschule in Los Angeles von ihren Latinos bestreikt, weil der zweisprachige Unterricht sie hindere, das zu lernen, was sie nötiger hätten: Englisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adfc834e-196c-40d5-8419-6b4b3a182abd",
                        "source_entry_id": "c8b8a6ef-fa7b-33e3-81d6-cadf1279e16f",
                        "source_sense_id": "b6b795b0-7e0e-3d16-bcfc-f8bba9707a17",
                        "source_sense_description": "Einwohner von Amerika mit lateinamerikanischen Wurzeln",
                        "target_lang_word": "Latino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e024ce6f-f7f5-3e3d-a53f-dc6a3acde22b",
                                        "entry_id": "fc3bb7d5-c706-37fb-8194-bbd9d3b23514",
                                        "glosses": [
                                            "Of Latin American descent, Hispanic."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f3410db-403c-4894-97ec-1edd174b4ccc",
                                                "sense_id": "e024ce6f-f7f5-3e3d-a53f-dc6a3acde22b",
                                                "text": "She called Ottinger a \"tool\" of the business community and Lopez a \"box checker,” apparently meaning that he was only nominally Latino and that he had acted in a way that was detrimental to the interests of Latinos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Latino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3300fbf-7589-342c-b889-a245f3f711d1",
                                        "entry_id": "e54952ea-4dc8-324d-8a75-3fb9ff27825e",
                                        "glosses": [
                                            "A person, especially and usually (interpreted as) a male, from Latin America, a Hispanic person. (Compare Latina.)"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfbee1cd-f29e-428c-80c4-2d52d20b3b83",
                                                "sense_id": "e3300fbf-7589-342c-b889-a245f3f711d1",
                                                "text": "Latinos have quickly become the largest ethnic minority in the United States."
                                            },
                                            {
                                                "example_id": "558a7628-91b2-4bf8-b021-91dd270eab70",
                                                "sense_id": "e3300fbf-7589-342c-b889-a245f3f711d1",
                                                "text": "Certainly, the activists in this study believe that Latinos face antibrown racism and consider racial justice for Latinos to be an increasingly important part of America's racial justice agenda."
                                            },
                                            {
                                                "example_id": "ba1dacda-da68-4031-81da-e16625b16924",
                                                "sense_id": "e3300fbf-7589-342c-b889-a245f3f711d1",
                                                "text": "She called Ottinger a \"tool\" of the business community and Lopez a \"box checker,” apparently meaning that he was only nominally Latino and that he had acted in a way that was detrimental to the interests of Latinos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
