                    {
                        "sense_id": "105e1b76-1184-3b15-be21-39a118d6f98d",
                        "entry_id": "24b042e4-7d95-3709-a9c9-c950aba1ebff",
                        "glosses": [
                            "een laboratoriumfaciliteit waarmee onderzoek gedaan kan worden naar de aerodynamische eigenschappen van een voorwerp; door lucht onder gecontroleerde omstandigheden langs deze voorwerpen te laten stromen kan men het effect van de lucht op het voorwerp, en omgekeerd van het voorwerp op de luchtstroom, bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f7c5cb-28cd-4a0d-afdf-065f7efc053b",
                                "sense_id": "105e1b76-1184-3b15-be21-39a118d6f98d",
                                "text": "Maandag was Boom alweer in Eindhoven, waar hij in een treintje met Primoz Roglic, Jos van Emden, Steven Kruijswijk, Timo Roosen en Koen Bouwman een windtunneltest afwerkte. Het zestal werkte aan de samenwerking in de ploegentijdrit en lijkt zodoende zeker van een plek in het Tour de France-team; de derde etappe van de Ronde van Frankrijk is een gezamenlijke race tegen de klok."
                            }
                        ]
                    },
                    {
                        "sense_id": "af6537c5-0052-3850-88ae-7843c3fd04d5",
                        "entry_id": "24b042e4-7d95-3709-a9c9-c950aba1ebff",
                        "glosses": [
                            "een tunnel met kunstmatige wind waarin met parachutespringen kan simuleren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d75c27d-b1aa-4909-88aa-7c800e54617e",
                                "sense_id": "af6537c5-0052-3850-88ae-7843c3fd04d5",
                                "text": "Wingsuiter Jarno Cordia heeft in totaal zes en een half uur in een windtunnel in Zweden gehangen en haalt een plek in The Guinness Book of Records."
                            }
                        ]
                    }
                ],
