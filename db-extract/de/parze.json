                "senses": [
                    {
                        "sense_id": "8aaeaec7-5fbe-38a9-9b60-4c4ec60e6cdc",
                        "entry_id": "be82349c-7734-3440-8a0b-bcc8cfef30c8",
                        "glosses": [
                            "eine der drei römischen Schicksalsgöttinnen „Nona, Decima / Decuma und Morta“"
                        ],
                        "tags": [
                            "römische"
                        ],
                        "examples": [
                            {
                                "example_id": "fc03195a-ee4f-41c6-874d-eb55c0b9e1f4",
                                "sense_id": "8aaeaec7-5fbe-38a9-9b60-4c4ec60e6cdc",
                                "text": "»Bedenke«, sprach er zu dem Bekümmerten, »daß die Götter es sind, welche uns die Geschicke senden, gute wie schlimme, und daß über allen die dunkle Parze waltet, welche dieselben blind auf die Erde hinabwirft: darum stürzt oft großes Unheil auf redliche Männer, und keiner gehet ganz sicher einher."
                            },
                            {
                                "example_id": "78e4bac1-891e-444e-a9d9-a8284f77360a",
                                "sense_id": "8aaeaec7-5fbe-38a9-9b60-4c4ec60e6cdc",
                                "text": "Wer die DNA bzw. die Chromosomen gern poetisch Lebensfäden nennen möchte, dem passen ihre Enden gut ins Bild: die Telomere, die bei jeder Zellteilung kürzer werden – als waltete die Parze Atropos ihres Amtes."
                            },
                            {
                                "example_id": "7ffe937e-74db-4349-9a22-ec02d976cd2e",
                                "sense_id": "8aaeaec7-5fbe-38a9-9b60-4c4ec60e6cdc",
                                "text": "Sie erinnert mit den abgetrennten Gliedern an die mit Knöchelchen wahrsagenden Hexen der Walpurgisnacht oder beschwört mit Nadeln und auf Gestellen aufgesteckten Garnknäuels Visionen einer am Schicksalsfaden spinnenden Parzen herauf."
                            },
                            {
                                "example_id": "22eca528-3aae-4d69-b7c3-bc3ec64bd252",
                                "sense_id": "8aaeaec7-5fbe-38a9-9b60-4c4ec60e6cdc",
                                "text": "Man legt diese Karten offen im Quadrat aus, wenn man wissen will, was einem die Parzen zugesponnen haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
