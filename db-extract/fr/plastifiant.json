                        "glosses": [
                            "Molécule ajoutée aux formulations de différents types de matériaux pour les rendre plus flexibles, plus résistants, plus résilients ou plus faciles à manipuler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e2ea5a-ac0a-475f-b384-3975b4168f74",
                                "sense_id": "de714c19-8e59-3ed0-86aa-c53a611fe2f2",
                                "text": "Le durcisseur est principalement du MDI, éventuellement dilué dans du plastifiant pour ajuster le rapport de mélange et contient généralement un promoteur d’adhésion, choisi parmi les silanes (1 à 2% en masse)."
                            }
                        ]
