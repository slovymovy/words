                        "examples": [
                            {
                                "example_id": "7716464f-aaa2-41ae-93ae-9c10975c7f52",
                                "sense_id": "dd63e8be-4ac5-339e-bfb8-4c5f86eaf65b",
                                "text": "— Calme-toi, Gérard. Tiens, prends un susucre…\n— C’est bien le moment de prendre des susucres!"
                            },
                            {
                                "example_id": "55b623f1-c033-4957-bfef-83d9cc8bbeb0",
                                "sense_id": "dd63e8be-4ac5-339e-bfb8-4c5f86eaf65b",
                                "text": "Susucre, patron, susucre."
                            },
                            {
                                "example_id": "574dc4a6-1c2d-45f8-be27-57e2dd1df41a",
                                "sense_id": "dd63e8be-4ac5-339e-bfb8-4c5f86eaf65b",
                                "text": "Oah! Un cheval… snif… courageuse bête… tiens! susucre… snif."
                            },
                            {
                                "example_id": "0907c7f9-2f7d-4a2b-9599-b44ad5508021",
                                "sense_id": "dd63e8be-4ac5-339e-bfb8-4c5f86eaf65b",
                                "text": "S’adressant à son chien, il disait : « Où c’est qu’il est ton susucre ?\"' »"
                            }
                        ]
                    }
                ],
