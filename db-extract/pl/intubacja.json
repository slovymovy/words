                                        "entry_id": "b4067a14-7684-3f53-a176-36f1f2491abb",
                                        "glosses": [
                                            "Action d’introduire un tube dans la trachée d’un patient pour lui permettre de respirer. → voir tubage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a206908-a0c9-427e-8816-2b034f9e46aa",
                                                "sense_id": "a0b13199-88ce-322e-ad4e-479e8d80b3ac",
                                                "text": "En France, les dispositifs supraglottiques peuvent être utilisés comme une alternative à l’intubation et surtout à la ventilation au masque facial parce qu’ils libèrent les mains de l’opérateur."
                                            },
                                            {
                                                "example_id": "3d6b654a-fd55-48c1-8dee-07020d886604",
                                                "sense_id": "a0b13199-88ce-322e-ad4e-479e8d80b3ac",
                                                "text": "Le guide sert de tuteur pour le passage d’une sonde d’intubation d’un diamètre 6 7 mm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
