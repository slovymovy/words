                "senses": [
                    {
                        "sense_id": "0382b3f2-8924-399f-bd0f-510249267fc1",
                        "entry_id": "0cfd30b7-2503-39a8-a711-be0d30ea3945",
                        "glosses": [
                            "aktor występujący w pantomimie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f58c75-807f-4ac2-98b6-eecd18773748",
                                "sense_id": "0382b3f2-8924-399f-bd0f-510249267fc1",
                                "text": "Na występy pantomimistów ludzie wcale nie walą drzwiami i oknami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7937ac56-31a1-41b6-a238-7d94a1ede305",
                        "source_entry_id": "0cfd30b7-2503-39a8-a711-be0d30ea3945",
                        "source_sense_id": "0382b3f2-8924-399f-bd0f-510249267fc1",
                        "target_lang_word": "pantomime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pantomime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "853e6367-5b8d-3557-b507-9012ea158ad3",
                                        "entry_id": "c7944ef2-830a-3002-bd5a-902d7223ffd8",
                                        "glosses": [
                                            "A Classical comic actor, especially one who works mainly through gesture and mime."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c22ebcee-760a-4a90-8b1f-53e4036679b2",
                                                "sense_id": "853e6367-5b8d-3557-b507-9012ea158ad3",
                                                "text": "[He] saw a pantomime perform so well that he could follow the performance from the action alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e226bad3-4c5e-3936-86e4-0f0b3cbbe3f5",
                                        "entry_id": "c7944ef2-830a-3002-bd5a-902d7223ffd8",
                                        "glosses": [
                                            "The drama in ancient Greece and Rome featuring such performers; or (later) any of various kinds of performance modelled on such work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a8f42a2-ec0b-3b07-acbb-3812e156bd58",
                                        "entry_id": "c7944ef2-830a-3002-bd5a-902d7223ffd8",
                                        "glosses": [
                                            "A traditional theatrical entertainment, originally based on the commedia dell'arte, but later aimed mostly at children and involving physical comedy, topical jokes, call and response, and fairy-tale plots."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc00f21-ad0c-405e-8603-6685628240c3",
                                                "sense_id": "6a8f42a2-ec0b-3b07-acbb-3812e156bd58",
                                                "text": "With the Stoke supporters jeering Ziv's every subsequent touch, the pantomime atmosphere created by the home crowd reached a crescendo when Ziv was shown a straight red shortly after the break in extraordinary circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa25ea46-e227-3369-87fc-0d7114605609",
                                        "entry_id": "c7944ef2-830a-3002-bd5a-902d7223ffd8",
                                        "glosses": [
                                            "The act of gesturing without speaking; a dumb-show, a mime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50d2b71-7a13-4cd4-95c3-e754a7ea132a",
                                                "sense_id": "aa25ea46-e227-3369-87fc-0d7114605609",
                                                "text": "#*: A staid, steadfast man, whose life for the most part was a telling pantomime of action, and not a tame chapter of sounds."
                                            },
                                            {
                                                "example_id": "721d43b6-882d-45be-bdd0-3483ff5ae338",
                                                "sense_id": "aa25ea46-e227-3369-87fc-0d7114605609",
                                                "text": "In pantomime, Chief Joyi would fling his spear and creep along the veld as he narrated the victories and defeats."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pantomime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72a763d6-1b4b-3c6c-9213-3590ecea6175",
                                        "entry_id": "af6b0c1b-eae0-3671-ae27-7033d0cd9745",
                                        "glosses": [
                                            "To make (a gesture) without speaking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95317ff0-ddf9-4927-b3f1-41149182fd79",
                                                "sense_id": "72a763d6-1b4b-3c6c-9213-3590ecea6175",
                                                "text": "I pantomimed steering a car; he understood, and tossed the keys to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70e58d02-9d03-3f9c-aae2-5e8ed14e1c53",
                                        "entry_id": "af6b0c1b-eae0-3671-ae27-7033d0cd9745",
                                        "glosses": [
                                            "To entertain others by silent gestures or actions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5c31dfc-f56f-42c9-ace1-1cc25e44282d",
                        "source_entry_id": "0cfd30b7-2503-39a8-a711-be0d30ea3945",
                        "source_sense_id": "0382b3f2-8924-399f-bd0f-510249267fc1",
                        "target_lang_word": "Pantomime",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantomime",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                        "entry_id": "07c6ae4f-151a-317d-aa0d-24d50d9759b4",
                                        "glosses": [
                                            "Gebärdenspiel, Schauspiel ohne Stimme, Szene nur mit Gebärden, Mienenspiel und Tanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040a819a-f226-479a-aeda-cbecc923963a",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "Um die Pantomime verstehen zu können, braucht man keiner Sprache mächtig zu sein."
                                            },
                                            {
                                                "example_id": "f2b7e295-33ed-46d9-ad48-fb88b2164753",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Petitjacques wiederholte seine Pantomime mit dem Klebestreifen.“"
                                            },
                                            {
                                                "example_id": "40197e66-f9de-4d7d-98bd-a3c12266b1c1",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Sie führten eine lustige Pantomime auf und zeigten Kalabreser Tänze.“"
                                            },
                                            {
                                                "example_id": "3c558389-098f-47e1-a72e-4abee06cbd18",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Ich machte aus dieser Beobachtung eine Pantomime, bei der ich nur mit Händen und Füßen arbeite, mein Gesicht unbewegt und schneeweiß immer in der Mitte bleibt, und es gelingt mir, mit meinen vier Extremitäten den Eindruck einer ungeheuren Quantität von überstürzter Bewegung zu erwecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pantomime",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                        "entry_id": "61c25865-a413-3922-8846-c5e5026fe729",
                                        "glosses": [
                                            "Darsteller des Gebärdenspiels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b438176e-0402-4ff3-a0c9-6e0eeedb0cf1",
                                                "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                                "text": "Der Pantomime überzeugte durch seine Kunst."
                                            },
                                            {
                                                "example_id": "897ceb68-7759-4b62-a5a5-94c33bfbdc8a",
                                                "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                                "text": "„In der Dämmerung drängt sich das ganze Volk zu den Opern, den Komödien, den Pantomimen und den Seiltänzern; alle Darsteller müssen entweder richtige Männer oder Kastraten sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
