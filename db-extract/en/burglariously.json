                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5c720315-4621-4854-8810-3df6551a13c8",
                                "sense_id": "344c7f9f-9c35-30c0-bc56-15f1eea9284a",
                                "text": "John Hornby was committed on Monday last to Newgate by Justice Ward, for Burglariously entering the House of a Watchmaker in Essex-street and feloniously stealing thence seven Watches; […]"
                            },
                            {
                                "example_id": "124be271-c15f-4020-bb6d-94a2dba94b9e",
                                "sense_id": "344c7f9f-9c35-30c0-bc56-15f1eea9284a",
                                "text": "Cheops erected the first Pyramid / And largest, thinking it was just the thing / To keep his memory whole, and mummy hid; / But somebody or other rummaging, / Burglariously broke his coffin's lid […]"
                            },
                            {
                                "example_id": "bf446a6f-59fa-4cfe-8f80-bd8681395fbd",
                                "sense_id": "344c7f9f-9c35-30c0-bc56-15f1eea9284a",
                                "text": "On Wednesday night two rascals burglariously entered the residence of a Mr. M'Knight, on Stanwix street, near the Point, by forcing open the back door."
                            },
                            {
                                "example_id": "01fa4217-e8fe-45e8-9620-1e556da2e354",
                                "sense_id": "344c7f9f-9c35-30c0-bc56-15f1eea9284a",
                                "text": "[…] then and there feloniously and burglariously did steal, take and carry away."
                            },
                            {
                                "example_id": "01161285-95d0-42d0-bd18-103c00f35764",
                                "sense_id": "344c7f9f-9c35-30c0-bc56-15f1eea9284a",
                                "text": "Under Rev. St. 1900, § 4528, permitting a charge both of burglary and larceny, when the larceny is committed at the time of the burglary in the building burglariously entered, to be joined in the same count of an information […]"
                            }
                        ]
                    }
