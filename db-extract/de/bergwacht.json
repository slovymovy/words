                "senses": [
                    {
                        "sense_id": "0dd58aa3-b2ee-3348-afac-5a9e32241869",
                        "entry_id": "73a9cc99-fddf-356f-995f-e1cc19e0ed7e",
                        "glosses": [
                            "Organisation, die zur Aufgabe hat, in Bergnot geratene Personen zu retten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036b2ed0-fd38-4bf3-bcfb-c4133dd2bbfa",
                                "sense_id": "0dd58aa3-b2ee-3348-afac-5a9e32241869",
                                "text": "„Seit 35 Jahren ist der gelernte Schreiner ehrenamtlich für die Bergwacht an den Hängen im Einsatz.“"
                            },
                            {
                                "example_id": "51934c9d-151a-4282-a7ed-ec76a43c5d1d",
                                "sense_id": "0dd58aa3-b2ee-3348-afac-5a9e32241869",
                                "text": "„Ein vermeintlich abgestürzter Gleitschirmflieger hat im Schwarzwald für einen Einsatz von Polizei und Bergwacht gesorgt.“"
                            },
                            {
                                "example_id": "4da2df15-6161-4f42-8932-0771eb722146",
                                "sense_id": "0dd58aa3-b2ee-3348-afac-5a9e32241869",
                                "text": "„Eine Bergwacht gab es nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
