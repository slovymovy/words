                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e3de83-9c5e-4e39-9602-2a0a35b5d24c",
                                "sense_id": "922fba3d-7157-3e01-8d4a-cb03f2fca8ab",
                                "text": "We all went aboard the ship."
                            },
                            {
                                "example_id": "807f2ccf-b1f3-4967-b7a3-d012a68bc716",
                                "sense_id": "922fba3d-7157-3e01-8d4a-cb03f2fca8ab",
                                "text": "Conditions were horrendous aboard most British naval vessels at the time. Scurvy and other diseases ran rampant, killing more seamen each year than all other causes combined, including combat."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d486087-0739-3678-a69a-6db26ad1f93d",
                        "entry_id": "03dd9811-3c98-326c-82f4-8eb6bc1d9f00",
