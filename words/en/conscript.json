{
    "word_family": [
        "conscription",
        "conscriptive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b7f36f4-d6e8-31c5-9c22-989ff22cd541",
                    "sense_definition": "To enroll someone compulsorily into military service",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_recruitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>conscript</w> young men during the national emergency.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>призвать</w> молодых людей во время чрезвычайного положения в стране."
                            }
                        },
                        {
                            "text": "Many families tried to send their sons abroad before the state could <w>conscript</w> them into the army.",
                            "target_lang_translations": {
                                "ru": "Многие семьи пытались отправить своих сыновей за границу, прежде чем государство успеет <w>мобилизовать</w> их в армию."
                            }
                        }
                    ],
                    "synonyms": [
                        "draft",
                        "induct"
                    ],
                    "common_phrases": [
                        "conscript into service",
                        "conscript young men"
                    ],
                    "target_lang_definitions": {
                        "ru": "Призывать кого-либо на обязательную военную службу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "в армию"
                            },
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "на военную службу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e08ecf7-aed8-3721-8f7a-f91be96c1d2a",
                    "sense_definition": "A person who has been compulsorily enrolled in the military",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>conscript</w> felt nervous as he arrived at the training camp for the first time.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>призывник</w> нервничал, когда впервые прибыл в тренировочный лагерь."
                            }
                        },
                        {
                            "text": "During the war, every <w>conscript</w> was required to serve at least two years on the front lines.",
                            "target_lang_translations": {
                                "ru": "Во время войны каждый <w>новобранец</w> был обязан отслужить как минимум два года на передовой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "military conscript",
                        "army conscript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, призванное на обязательную военную службу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывник",
                                "target_lang_sense_clarification": "лицо, подлежащее призыву"
                            },
                            {
                                "target_lang_word": "новобранец",
                                "target_lang_sense_clarification": "недавно призванный солдат"
                            },
                            {
                                "target_lang_word": "рекрут",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35b862bc-1f99-38c5-a9cc-afc583e4aa81",
                    "sense_definition": "A constructed script or writing system created for a constructed language",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist spent years developing a unique <w>conscript</w> for his fictional civilization.",
                            "target_lang_translations": {
                                "ru": "Лингвист потратил годы на разработку уникальной <w>письменности</w> для своей вымышленной цивилизации."
                            }
                        },
                        {
                            "text": "Many hobbyists share their latest <w>conscript</w> designs on online forums dedicated to invented languages.",
                            "target_lang_translations": {
                                "ru": "Многие любители делятся своими последними разработками <w>искусственных шрифтов</w> на онлайн-форумах, посвященных вымышленным языкам."
                            }
                        }
                    ],
                    "synonyms": [
                        "neography"
                    ],
                    "common_phrases": [
                        "invented conscript",
                        "alphabetic conscript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственная письменность, созданная для вымышленного языка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конскрипт",
                                "target_lang_sense_clarification": "искусственная письменность"
                            },
                            {
                                "target_lang_word": "неография",
                                "target_lang_sense_clarification": "система письма"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87c60f5f-162a-3037-be19-f3d3519545cd",
                    "sense_definition": "Relating to or being a person who has been drafted into service",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conscript</w> soldiers were often less experienced than the professional volunteers.",
                            "target_lang_translations": {
                                "ru": "<w>Призванные</w> солдаты часто были менее опытными, чем профессиональные добровольцы."
                            }
                        },
                        {
                            "text": "He led a small unit of <w>conscript</w> troops through the difficult mountain pass.",
                            "target_lang_translations": {
                                "ru": "Он вел небольшой отряд <w>мобилизованных</w> войск через трудный горный перевал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conscript army",
                        "conscript soldiers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к лицу, призванному на службу, или являющийся им"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывной",
                                "target_lang_sense_clarification": "о возрасте или составе"
                            },
                            {
                                "target_lang_word": "мобилизованный",
                                "target_lang_sense_clarification": "призванный по мобилизации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20fa9cf2-6676-3443-a5e4-359989d8b1e5",
                    "sense_definition": "Formally enrolled, written down, or registered in a list",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "registration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conscript</w> names were meticulously recorded in the ancient city archives.",
                            "target_lang_translations": {
                                "ru": "<w>Внесённые в списки</w> имена были тщательно записаны в архивах древнего города."
                            }
                        },
                        {
                            "text": "All <w>conscript</w> members of the guild were required to attend the annual meeting.",
                            "target_lang_translations": {
                                "ru": "Все <w>зачисленные</w> члены гильдии были обязаны присутствовать на ежегодном собрании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of being formally written or enrolled"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально зачисленный, записанный или зарегистрированный в списке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внесённый в списки",
                                "target_lang_sense_clarification": "официально зарегистрированный"
                            },
                            {
                                "target_lang_word": "зачисленный",
                                "target_lang_sense_clarification": "в состав организации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}