    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5257e87-1edf-36eb-80c9-7041162fc503",
                    "sense_definition": "czynić kogoś świadomym jakiegoś faktu lub sytuacji",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>uświadamiać</w> pracowników o nowych zasadach bezpieczeństwa w biurze.",
                            "target_lang_translations": {
                                "en": "I must <w>make</w> the employees <w>aware</w> of the new safety rules in the office."
                            }
                        },
                        {
                            "text": "Rodzice powinni <w>uświadamiać</w> dzieci o zagrożeniach płynących z internetu.",
                            "target_lang_translations": {
                                "en": "Parents should <w>make</w> children <w>aware</w> of the dangers coming from the internet."
                            }
                        }
                    ],
                    "synonyms": [
                        "uzmysławiać",
                        "uprzytamniać"
                    ],
                    "common_phrases": [
                        "uświadamiać o zagrożeniach",
                        "uświadamiać o faktach"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone aware of a fact or situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make aware",
                                "target_lang_sense_clarification": "to inform someone about a specific fact"
                            },
                            {
                                "target_lang_word": "bring to someone's attention",
                                "target_lang_sense_clarification": "to point out a situation or issue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adcefea3-c784-3fd6-8e32-c5e722ed0ae9",
                    "sense_definition": "wyrabiać w kimś świadomość i orientację w jakiejś dziedzinie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "edukacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szkoła ma za zadanie <w>uświadamiać</w> młodzież w kwestiach ekologii.",
                            "target_lang_translations": {
                                "en": "The school's task is to <w>raise awareness</w> among youth regarding ecology."
                            }
                        },
                        {
                            "text": "Kampanie społeczne starają się <w>uświadamiać</w> społeczeństwo w sprawach zdrowotnych.",
                            "target_lang_translations": {
                                "en": "Social campaigns try to <w>raise awareness</w> in society about health issues."
                            }
                        }
                    ],
                    "synonyms": [
                        "oświecać",
                        "edukować"
                    ],
                    "common_phrases": [
                        "uświadamiać społeczeństwo"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop awareness and understanding in someone regarding a specific field."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "raise awareness",
                                "target_lang_sense_clarification": "to educate the public or a group about a topic"
                            },
                            {
                                "target_lang_word": "educate",
                                "target_lang_sense_clarification": "to provide knowledge or instruction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a63868e-b6d2-3069-9707-e13c31bc8295",
                    "sense_definition": "zdawać sobie sprawę z czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zrozumienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Często <w>uświadamiam</w> sobie, że czas płynie zdecydowanie zbyt szybko.",
                            "target_lang_translations": {
                                "en": "I often <w>realize</w> that time is passing way too quickly."
                            }
                        },
                        {
                            "text": "Dopiero po latach <w>uświadamiamy</w> sobie, jak ważne były te chwile.",
                            "target_lang_translations": {
                                "en": "Only after years do we <w>realize</w> how important those moments were."
                            }
                        }
                    ],
                    "synonyms": [
                        "uzmysławiać sobie",
                        "uprzytamniać sobie",
                        "pojmować"
                    ],
                    "common_phrases": [
                        "uświadamiać sobie błąd",
                        "uświadamiać sobie prawdę"
                    ],
                    "target_lang_definitions": {
                        "en": "To realize or become aware of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "realize",
                                "target_lang_sense_clarification": "to become fully aware of a fact or situation"
                            },
                            {
                                "target_lang_word": "become aware",
                                "target_lang_sense_clarification": "to start to know or understand something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a6d016-86f1-3c1e-aa52-220370ffc061",
                    "sense_definition": "zdobywać orientację i wiedzę w jakiejś dziedzinie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "edukacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warto <w>uświadamiać</w> się w kwestiach prawnych przed podpisaniem umowy.",
                            "target_lang_translations": {
                                "en": "It is worth <w>getting informed</w> about legal matters before signing a contract."
                            }
                        },
                        {
                            "text": "Młodzi ludzie powinni <w>uświadamiać</w> się w zakresie finansów osobistych.",
                            "target_lang_translations": {
                                "en": "Young people should <w>educate themselves</w> in the field of personal finance."
                            }
                        }
                    ],
                    "synonyms": [
                        "oświecać się",
                        "edukować się"
                    ],
                    "target_lang_definitions": {
                        "en": "To gain orientation and knowledge in a specific field."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "educate oneself",
                                "target_lang_sense_clarification": "to gain knowledge through personal effort"
                            },
                            {
                                "target_lang_word": "get informed",
                                "target_lang_sense_clarification": "to acquire necessary information about a subject"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}