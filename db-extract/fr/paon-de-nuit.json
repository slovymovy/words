                        "examples": [
                            {
                                "example_id": "ca0fd3c3-c8a9-496d-b287-bd8dc2faa2af",
                                "sense_id": "7751521e-d8d5-3389-b14c-77d8a92ec24c",
                                "text": "Viens voir si ma chenille est endormie. Je crois bien qu’elle va devenir chrysalide, je lui ai mis une petite caisse de sable sec. Une chenille de paon-de-nuit, qu’un oiseau avait dû blesser au ventre, mais elle est guérie…"
                            },
                            {
                                "example_id": "464d447f-09d6-4090-a8fe-e31d82f02611",
                                "sense_id": "7751521e-d8d5-3389-b14c-77d8a92ec24c",
                                "text": "– Je suis bien ennuyée… je ne sais plus si c’est une famille de bulbes de crocus, que j’ai enterrés, ou bien une chrysalide de paon-de-nuit…"
                            }
                        ]
                    }
