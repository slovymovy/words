                                        "glosses": [
                                            "chemische Verbindung mit unter anderem zwei Sauerstoffatomen in jedem Molekül"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9300b1b9-145f-443f-b6e6-fd10019252ac",
                                                "sense_id": "64dae668-fb6a-3eb6-996b-89b89a3f5385",
                                                "text": "Der Chemielehrer besteht darauf, dass jeder Schüler mindestens fünf Dioxide kennen sollte."
