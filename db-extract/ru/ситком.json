                                "target_senses": [
                                    {
                                        "sense_id": "3ec9c996-c59c-3009-8f12-e8631491c026",
                                        "entry_id": "b0f03baf-67fb-301f-86d7-458e873d20a9",
                                        "glosses": [
                                            "An episodic comedy radio or television program with a plot or storyline based around a particular humorous situation with the same set of characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213cb0d7-ce25-4b3e-b4ae-a13c3401ca7e",
                                                "sense_id": "3ec9c996-c59c-3009-8f12-e8631491c026",
                                                "text": "[…] in a time of peril and opportunity, the old complacent, unbalanced fare of action-adventure and situation comedies is simply not good enough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a00bf0f0-52e5-4fe3-b162-4ea8e7ee3018",
                        "source_entry_id": "ea60962e-5b2e-3625-9c20-9e3f28bf40aa",
                        "source_sense_id": "5a511cba-c1f4-3521-aea5-76e4d5904152",
                        "target_lang_word": "Sitcom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sitcom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34f31406-f400-3c38-8ad1-619f1870c494",
                                        "entry_id": "7844bb98-73ca-3189-ade2-1e74019f9189",
                                        "glosses": [
                                            "Genre von Unterhaltungssendungen im Fernsehen, bei denen Gags, Pointen, Späße aus einer Spielsituation heraus entwickelt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4502cbd3-5b7f-496d-ab35-aca2c8d713bb",
                                                "sense_id": "34f31406-f400-3c38-8ad1-619f1870c494",
                                                "text": "„Die Comediennes schreiben, produzieren, inszenieren und spielen ihre Sketche oder Sitcoms selbst, sie sind Coverstars von Hochglanzmagazinen und Dauergäste in den großen Talkshows.“"
                                            },
                                            {
                                                "example_id": "d8d0710f-9212-4bd5-8398-ab254f43cc02",
                                                "sense_id": "34f31406-f400-3c38-8ad1-619f1870c494",
                                                "text": "„Ein Herz und eine Seele“ ist eine bekannte Sitcom im deutschen Fernsehen."
                                            },
                                            {
                                                "example_id": "e0991919-bec6-4997-9600-6ec6bf64b6a7",
                                                "sense_id": "34f31406-f400-3c38-8ad1-619f1870c494",
                                                "text": "„Nach der Jahrtausendwende setzten sich unter den vielen Serien einige zeitkritische polnische Sitcoms durch.“"
                                            },
                                            {
                                                "example_id": "c2f855f9-7221-4598-bf87-059c778a3dfa",
                                                "sense_id": "34f31406-f400-3c38-8ad1-619f1870c494",
                                                "text": "„Da kann ich mir gleich eine finnische Sitcom im Original angucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
