                                        "glosses": [
                                            "L’ensemble des opérations chimiques qui se font dans une plante, dans un animal, dans un sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf786f3a-b4be-4ad4-a7b4-9c0736a47eae",
                                                "sense_id": "863ce159-5c91-3a87-8649-88d513aaf7fe",
                                                "text": "L'obstacle peut être dû à […] une modification du chimisme ou du milieu microbiologique du sol provoqué par les plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c191724e-78c6-331a-a49d-30bfdfe50f42",
