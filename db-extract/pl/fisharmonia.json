                    {
                        "sense_id": "edc2c61d-95a2-3d07-ae83-d0b77f0f439f",
                        "entry_id": "8f9d1e62-2c6a-3bc3-9311-e5b41b972ee6",
                        "glosses": [
                            "instrument muzyczny z grupy instrumentów dętych klawiszowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c389342-2adc-4ef3-b9fd-f78f05bb7dd1",
                                "sense_id": "edc2c61d-95a2-3d07-ae83-d0b77f0f439f",
                                "text": "Potrafię grać na pianinie, to pewnie dałabym radę nauczyć się grać na fisharmonii."
                            },
                            {
                                "example_id": "87dd3695-4c71-495d-9043-fd44695f6142",
                                "sense_id": "edc2c61d-95a2-3d07-ae83-d0b77f0f439f",
                                "text": "Pułkownik Stark postawił lampę na fisharmonii, stojącej przy drzwiach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
