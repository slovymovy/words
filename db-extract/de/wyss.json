                ],
                "senses": [
                    {
                        "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                        "entry_id": "486291f8-4abe-3ed3-87ec-6f89b37495f4",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d76625-2510-480d-b25c-99aa8b36eda5",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Frau Wyss ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a9faf51e-460f-413f-9d4c-37bed61e5994",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Herr Wyss wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4f5d17b4-433b-4c8c-a83b-e7a2285a9d30",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Die Wyss kommen heute vom Bodensee."
                            },
                            {
                                "example_id": "2457ba60-3987-44e5-b3a3-2e68fa75a14f",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Der Wyss trägt nie die Schals, die die Wyss ihm strickt."
                            },
                            {
                                "example_id": "bd646598-3647-43c3-b9d9-595d06593bbf",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wyss kommt, geht der Herr Wyss.“"
                            },
                            {
                                "example_id": "dd6486bb-f970-415d-9524-b22eca9abb9a",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Wyss kommt und geht."
                            },
                            {
                                "example_id": "7151eb71-6dbc-4d8f-a63b-1d55037f45cb",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "Wyssens kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b4b78a88-ca24-4652-b91d-1b17be68c9f4",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "An verregneten Herbsttagen ist Familie Wyss liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "6fe2a5fd-8148-4037-9d7d-ec2a779c1ebd",
                                "sense_id": "516005e7-446e-365b-8917-426a1dac318e",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Wyss das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
