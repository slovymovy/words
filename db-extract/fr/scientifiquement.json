                                        "glosses": [
                                            "in un'ottica scientifica, secondo metodo e rigore scientifico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64220da1-e564-4a10-8a13-507b23d2b620",
                                                "sense_id": "973d2108-e5af-3aa8-82ee-32689c930e2a",
                                                "text": "La relazione che intercorre fra la variabile a e la variabile b è stata provata scientificamente"
                                            },
                                            {
                                                "example_id": "5fce6564-a311-4d86-b18d-2d63bdac7f6f",
                                                "sense_id": "973d2108-e5af-3aa8-82ee-32689c930e2a",
                                                "text": "è scientificamente dimostrato che solo con la diagnosi precoce il tumore del colon retto può essere realmente vinto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9c4962-2683-34f0-a730-57b328d723ef",
                                        "entry_id": "652614eb-f948-340e-b8d0-2ef9d54bf89d",
                                        "glosses": [
                                            "in modo scientifico, senza allusioni, parole o argomentazioni ridondanti; completamente fedele alla verità"
                                        ],
