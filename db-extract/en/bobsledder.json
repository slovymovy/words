                                "target_senses": [
                                    {
                                        "sense_id": "6bc2da25-5306-3f6c-9d23-a4a7f4f900e2",
                                        "entry_id": "efb74028-7595-364f-864f-ef5d0fcddb68",
                                        "glosses": [
                                            "beoefenaar van het bobsleeën"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da498aa7-228c-4800-b6c2-a394bc874e75",
                                                "sense_id": "6bc2da25-5306-3f6c-9d23-a4a7f4f900e2",
                                                "text": "De bestrafte atleten komen uit vier wintersporttakken: langlaufen, skeleton, bobsleeën en langebaanschaatsen. Tot de geschorsten behoren bobber Alexander Zoebkov, winnaar van twee gouden medailles en inmiddels voorzitter van de Russische bobsleebond, en langlaufer Alexander Legkov, goed voor goud en zilver in Sotsji."
                                            },
                                            {
                                                "example_id": "86fa6238-643b-4dec-b77c-c999107fe465",
                                                "sense_id": "6bc2da25-5306-3f6c-9d23-a4a7f4f900e2",
                                                "text": "Bobber De Bruin zevende in Altenberg: De Nederlander kwam met remmer Janko Franjic in twee runs tot een totaaltijd van 1.53,22. De winst ging naar de Duitser Francesco Friedrich in 1.52,19, voor de Canadees Justin Kripps (1.52,56) en de Let Oskars Kibermanis in 1.52,67."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d2e8a1-3873-3d22-9686-6854851c4a64",
                                        "entry_id": "efb74028-7595-364f-864f-ef5d0fcddb68",
                                        "glosses": [
                                            "dikzak, dikkerd"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "365b5edd-05bd-4cb8-aa70-631b5dadab61",
                        "source_entry_id": "5335ffd1-5344-33db-a7d1-39da0d83806b",
                        "source_sense_id": "d1ddad0d-8aba-3ea9-bf90-06396f3f6a44",
