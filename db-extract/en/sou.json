                        "entry_id": "13f57809-3016-3a98-b894-ce8ffbaf9e3a",
                        "glosses": [
                            "An old French copper coin equal to one twentieth of a livre or twelve deniers; one sou is to the livre as one shilling is to the pound."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e33e38a6-485f-49ad-935a-ed3ca30686f9",
                                "sense_id": "7ffbbbe0-3a3b-37f6-be6f-32d58fd401a0",
                                "text": "He is grey, flat-footed and withered, with long, brittle nails that set your nerves on edge while he scrapes up your two sous."
                            }
                        ]
                    },
                    {
                        "sense_id": "6145678b-742d-3340-8efe-753bed56c4fd",
