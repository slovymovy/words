                                "example_id": "4bc1816c-b517-4a9e-bff5-cb53efea3171",
                                "sense_id": "85211f33-ee95-3dd6-8790-9a7840fcf071",
                                "text": "Das Bibelstechen ist ein alter Silvesterbrauch in christlichen Familien."
                            },
                            {
                                "example_id": "078498af-66e9-4032-86eb-0c9d46f94b47",
                                "sense_id": "85211f33-ee95-3dd6-8790-9a7840fcf071",
                                "text": "„Auch dieses Jahr sollen die sieben traditionellen Silvesterbräuche zum Einsatz kommen.“"
                            },
                            {
                                "example_id": "a6905964-77b9-4164-9eea-6074393bd7d3",
                                "sense_id": "85211f33-ee95-3dd6-8790-9a7840fcf071",
                                "text": "„Noch vor wenigen Jahrzehnten war das Orakeln mittels flüssigen Bleis ein beliebter Silvesterbrauch, der in vielen Familien gepflegt wurde.“"
                            }
                        ],
