                "forms": [],
                "senses": [
                    {
                        "sense_id": "639f15b2-292e-3917-8e08-f74e56c5e3b0",
                        "entry_id": "c2a85f72-d80f-3412-9c33-34b6f1d90a15",
                        "glosses": [
                            "D'une façon gothique, c'est-à-dire complètement surannée ; à la vieille mode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa2d603-6f10-40d6-8b8e-f50cfb33746a",
                                "sense_id": "639f15b2-292e-3917-8e08-f74e56c5e3b0",
                                "text": "Au fond de la salle deux vieux portraits de famille gothiquement encadrés semblaient veiller à la garde du château."
                            },
                            {
                                "example_id": "acfc1a9c-4222-4037-b072-20ae0112d6c2",
                                "sense_id": "639f15b2-292e-3917-8e08-f74e56c5e3b0",
                                "text": "Ces illustres paperasses, dont l’écriture gothiquement indéchiffrable eût demandé des lunettes et la science d’un bénédictin, étaient enveloppées pieusement d’un morceau de taffetas cramoisi dont la couleur passée avait pris une teinte pisseuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "823146a4-c334-36d1-884e-5a3f021ec510",
                        "entry_id": "c2a85f72-d80f-3412-9c33-34b6f1d90a15",
                        "glosses": [
                            "Dans la manière de l'art gothique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0f1fe2-82bf-484c-9b09-91712ed6e0c9",
                                "sense_id": "823146a4-c334-36d1-884e-5a3f021ec510",
                                "text": "Grand, gros, cagneux, gothiquement sculpté,\nTel qu'il brillait naguère à Notre-Dame,\nChristophe arrive : un saint amour l'enflamme\nPour Jésus-Christ que son dos a porté."
                            }
                        ]
                    }
