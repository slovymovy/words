                                    {
                                        "sense_id": "6a71fb85-0065-367e-8142-fc3d67b09cef",
                                        "entry_id": "8d93518c-021d-3c08-9cce-a445a5977dff",
                                        "glosses": [
                                            "A person hired to transport film footage out of a region where transport options are limited."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fd14ffb-83da-413a-ad6e-12366125ce4d",
                                                "sense_id": "6a71fb85-0065-367e-8142-fc3d67b09cef",
                                                "text": "Kalb rushed to the airport and found a \"pigeon\" to take out the film: an American woman headed for London."
                                            },
                                            {
                                                "example_id": "a1107fe6-e11b-4d28-9ada-d54e61105917",
                                                "sense_id": "6a71fb85-0065-367e-8142-fc3d67b09cef",
                                                "text": "At this point, all the commercial airports in Pakistan were closed. The only way to get film out was over land. John promptly hired me to be what was then known in the business as a \"Pigeon,\" and installed me in a comfortable room in his hotel. […] I would then hand-carry his film out of the country, via Peshawar, the Khyber Pass, through the Kabul Gorge, and up to Kabul, Afghanistan, where I would meet a BBC courier and transfer the film bag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b8d1a4-2eb9-3b26-afa9-74aa97ab6d0e",
                                        "entry_id": "8d93518c-021d-3c08-9cce-a445a5977dff",
                                        "glosses": [
                                            "A weak or useless person."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
