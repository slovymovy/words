                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "details",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I agree with the general plan, but we need to discuss the <w>specifics</w>.",
                            "target_lang_translations": {
                                "ru": "Я согласен с общим планом, но нам нужно обсудить <w>детали</w>."
                            }
