                        "sense_id": "98b332f6-474b-38c5-be3b-01cf00959676",
                        "entry_id": "407ceb15-4f40-3907-81c7-18151825da52",
                        "glosses": [
                            "everybody, by everybody, to everybody"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a54cc1-be78-43a1-9677-fb793c355ce3",
                                "sense_id": "98b332f6-474b-38c5-be3b-01cf00959676",
                                "text": "1878, Eduard Mörike, Mörike’s gesammelte Schriften. Zweiter Band, G. J. Göschen’sche Verlagshandlung, page 348",
                                "translation": "Everyone had everybody greeted, embraced, congratulated, introduced the two guests from Vienna, and Mozart sat down at the grand piano.",
                                "english": "Everyone had everybody greeted, embraced, congratulated, introduced the two guests from Vienna, and Mozart sat down at the grand piano."
                            },
                            {
                                "example_id": "99c1ef10-7eaa-4e8b-a842-2cbc970319eb",
                                "sense_id": "98b332f6-474b-38c5-be3b-01cf00959676",
                                "text": "„Gute Nacht, Herr Oberst!“ – „Gute Nacht allerseits!“\n\"Good night, colonel!\" – \"Good night everybody!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9c332076-c474-366c-84cf-a1ebc4ae5e1d",
                        "entry_id": "407ceb15-4f40-3907-81c7-18151825da52",
                        "glosses": [
                            "on all sides, from all sides"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0b00d9-9d65-4b28-b9c8-586b2abdb46c",
                                "sense_id": "9c332076-c474-366c-84cf-a1ebc4ae5e1d",
                                "text": "Durch die umliegenden Berge allerseits geschützt und gegen Süden offen, ist die Lage für Feld- und Wiesenbau eine günstige […]",
                                "translation": "From all sides protected by the surrounding mountains and open towards the south, the location is a favorable one for crop and meadow cultivation.",
                                "english": "From all sides protected by the surrounding mountains and open towards the south, the location is a favorable one for crop and meadow cultivation."
                            }
                        ]
                    }
                ],
