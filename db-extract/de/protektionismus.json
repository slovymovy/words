                "senses": [
                    {
                        "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                        "entry_id": "c75e5a41-35d8-30ca-9abd-7bf64cf47fa5",
                        "glosses": [
                            "Abschirmung der Wirtschaft eines Staates vor der Konkurrenz aus dem Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b344a19-3206-461c-b286-c1b56eceea7f",
                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                "text": "Die europäischen Staaten werfen der US-amerikanischen Regierung Protektionismus vor."
                            },
                            {
                                "example_id": "3ab09cbd-9725-4603-b66b-b1de728c001e",
                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                "text": "Eine weitere Form des Protektionismus ist der so genannte Kulturprotektionismus."
                            },
                            {
                                "example_id": "76b1b1dd-87c8-4d98-b0dd-3bcc3f7c474c",
                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                "text": "„Gleichzeitig litt der Außenhandel weiterhin unter dem internationalen Protektionismus, der sich im Verlauf der Krise verstärkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28be598b-0130-4cff-bfde-322b56a52a50",
                        "source_entry_id": "c75e5a41-35d8-30ca-9abd-7bf64cf47fa5",
                        "source_sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                        "source_sense_description": "Abschirmung der Wirtschaft eines Staates vor der Konkurrenz aus dem Ausland",
                        "target_lang_word": "protectionism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protectionism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8030d7bb-18a1-36e9-9dac-29854521eab8",
                                        "entry_id": "1e499dba-e7f9-39f2-9bbf-04c188900712",
                                        "glosses": [
                                            "A system or policy of protecting the domestic producers of a product from foreign competition by imposing tariffs, quotas, duties or other barriers on importations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094053e4-4d00-4c88-94d3-d0b51837ac8a",
                                                "sense_id": "8030d7bb-18a1-36e9-9dac-29854521eab8",
                                                "text": "Take the New Right's full-throated embrace of protectionism and industrial policy. This romance with protectionism started in the 1990s with former GOP presidential candidate Pat Buchanan, gained enormous traction under former President Donald Trump, and is still going strong today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380b0318-a6af-3656-8a68-8571e4cf5d82",
                                        "entry_id": "1e499dba-e7f9-39f2-9bbf-04c188900712",
                                        "glosses": [
                                            "Linguistic purism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05ad25f7-dd5c-428b-9d60-15837a293ebd",
                        "source_entry_id": "c75e5a41-35d8-30ca-9abd-7bf64cf47fa5",
                        "source_sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
