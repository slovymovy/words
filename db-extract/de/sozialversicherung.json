                "senses": [
                    {
                        "sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                        "entry_id": "f2163528-e09c-3a22-a806-667bff65d714",
                        "glosses": [
                            "gesetzliches Versicherungssystem, durch das Risiken wie Arbeitsunfall, Krankheit, Mutterschaft, Pflegebedürftigkeit von allen Versicherten getragen werden"
                        ],
                        "tags": [
                            "Versicherung"
                        ],
                        "examples": [
                            {
                                "example_id": "5c05f8b5-109d-400e-a6d1-741bce883492",
                                "sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                                "text": "Die Beiträge zur Sozialversicherung sind erneut gestiegen."
                            },
                            {
                                "example_id": "e97015e4-b023-499f-8c9f-46b2f9d130b6",
                                "sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                                "text": "Eine Reform der Sozialversicherung wird in vielen Parteiprogrammen angestrebt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3978f643-8bfb-3e75-946a-9db88fa61812",
                        "entry_id": "f2163528-e09c-3a22-a806-667bff65d714",
                        "glosses": [
                            "finanzieller Beitrag zu ^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b77153-276b-4b08-91aa-2cd69bc38e32",
                                "sense_id": "3978f643-8bfb-3e75-946a-9db88fa61812",
                                "text": "Vom Bruttolohn wird Steuer und Sozialversicherung abgezogen, das Ergebnis ist der Nettolohn."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82416336-a833-4a15-883b-569130b02bb7",
                        "source_entry_id": "f2163528-e09c-3a22-a806-667bff65d714",
                        "source_sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                        "target_lang_word": "social insurance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "social insurance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "039822f3-0e7c-3c28-9b9a-9065575d027c",
                                        "entry_id": "1efbd25c-74e5-3e4f-9616-ecfc9c5abf7b",
                                        "glosses": [
                                            "Government-mandated provision for the unemployed, injured, or aged, typically funded by a combination of government spending, individual contributions, and employer contributions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eafbcaf-fd7b-4e0c-a254-6cfb84b6523b",
                                                "sense_id": "039822f3-0e7c-3c28-9b9a-9065575d027c",
                                                "text": "Panama unified all social insurances in the 1970s and began a process of integration with the public sector that was later halted."
                                            },
                                            {
                                                "example_id": "a0475479-1913-4ee0-9afb-8f55d3a6e191",
                                                "sense_id": "039822f3-0e7c-3c28-9b9a-9065575d027c",
                                                "text": "Historical, cultural and institutional attributes influenced Scandinavian political choices for social insurance institutions and welfare policies at the time of the Bismarckian 'conception' of national social insurance on a grand scale in the 1880s."
                                            },
                                            {
                                                "example_id": "c02bf31a-7c42-4a76-b973-d779935ea6c6",
                                                "sense_id": "039822f3-0e7c-3c28-9b9a-9065575d027c",
                                                "text": "By 1942, Beveridge had been an advocate of social insurance for more than thirty years."
                                            },
                                            {
                                                "example_id": "59239c1d-9398-47b7-82b4-a5bb12b9fd20",
                                                "sense_id": "039822f3-0e7c-3c28-9b9a-9065575d027c",
                                                "text": "The original Social Security Act (1935) and the current version of the Act, as amended, encompass several social welfare and social insurance programs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beb6ad10-0fe2-4b48-abf9-f2e5717d0028",
                        "source_entry_id": "f2163528-e09c-3a22-a806-667bff65d714",
                        "source_sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                        "target_lang_word": "sécurité sociale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sécurité sociale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a35dc929-1911-360f-8465-17b8e408251a",
                                        "entry_id": "57ce5d72-896d-355c-8af9-748e4cb25025",
                                        "glosses": [
                                            "Garantie de la satisfaction des droits économiques, sociaux et culturels indispensables à sa dignité et au libre développement de la personnalité d’un être humain, grâce à l'effort national et à la coopération internationale, compte tenu de l'organisation et des ressources de chaque pays."
                                        ],
                                        "tags": [
                                            "Droit international"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a817b7f-bb44-4a44-b01e-93475fb9dfc7",
                                                "sense_id": "a35dc929-1911-360f-8465-17b8e408251a",
                                                "text": "Toute personne, en tant que membre de la société, a droit à la sécurité sociale ; elle est fondée à obtenir la satisfaction des droits économiques, sociaux et culturels indispensables à sa dignité et au libre développement de sa personnalité, grâce à l'effort national et à la coopération internationale, compte tenu de l'organisation et des ressources de chaque pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                        "entry_id": "57ce5d72-896d-355c-8af9-748e4cb25025",
                                        "glosses": [
                                            "Système d’indemnisation par les administrations publiques des citoyens victimes des aléas de la vie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d897562-d592-41d6-a012-61e7411bc7a7",
                                                "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                                "text": "En prescrivant des antibiotiques sophistiqués ou à large spectre, il cherche à « écraser une mouche avec un marteau », enrichit les laboratoires et contribue au pillage de la Sécurité sociale."
                                            },
                                            {
                                                "example_id": "b8cf9e80-fab4-453d-a07a-3c4d53f883fc",
                                                "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                                "text": "Le plafond de la Sécurité sociale est le montant maximum en euros des rémunérations ou gains à prendre en compte pour le calcul de certaines cotisations (…). Chaque année, ce plafond est actualisé conformément aux règles prévues dans l’article D242-17 du Code de la Sécurité sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
