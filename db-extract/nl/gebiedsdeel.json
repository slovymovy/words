                ],
                "senses": [
                    {
                        "sense_id": "8c3fb1f9-6bc3-35f8-8682-d285cfd15468",
                        "entry_id": "9f19e493-84ee-398c-b392-0af3e4df9c7d",
                        "glosses": [
                            "een stuk land dat bij een bepaalde staat hoort, maar daar ver vanaf ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e82d0b-f727-485b-b562-451ffe50de4a",
                                "sense_id": "8c3fb1f9-6bc3-35f8-8682-d285cfd15468",
                                "text": "De ijsberg drijft van Antarctica richting Zuid-Georgië, een Brits overzees gebiedsdeel. Als de ijsberg strandt op dat eiland, dreigt een ecologische ramp: de pinguïns en zeeleeuwen zouden een veel langere route moeten afleggen om voedsel te vangen."
                            },
                            {
                                "example_id": "5af29bc6-5d6a-48fd-a224-cbeaaf2f0450",
                                "sense_id": "8c3fb1f9-6bc3-35f8-8682-d285cfd15468",
                                "text": "Het is voor het eerst dat Athora de Nederlandse markt op komt. Het bedrijf is in 2014 opgericht en gevestigd in het Britse overzeese gebiedsdeel Bermuda. Met miljarden euro's aan kapitaal richt het zich vooral op het opkopen en samenvoegen van bedrijven om in hoog tempo te groeien."
                            },
                            {
                                "example_id": "47b63684-61c1-463e-b0ab-21c7d98182e3",
                                "sense_id": "8c3fb1f9-6bc3-35f8-8682-d285cfd15468",
                                "text": "Gouverneur Ricardo Rosselló van Puerto Rico zegt dat hij op 2 augustus opstapt, na anderhalve week van massale protesten in het Amerikaanse gebiedsdeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e1edaf-dff9-4cee-a122-19f5be919485",
                        "source_entry_id": "9f19e493-84ee-398c-b392-0af3e4df9c7d",
                        "source_sense_id": "8c3fb1f9-6bc3-35f8-8682-d285cfd15468",
                        "source_sense_description": "een stuk land dat bij een bepaalde staat hoort, maar daar ver vanaf ligt",
                        "target_lang_word": "territory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "territory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b0a335-ee40-3350-b586-e79007fdfea0",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "A large extent or tract of land; for example a region, country or district."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baf676d8-5105-369d-a618-f9cda5929e59",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "One of three of Canada's federal entities, located in the country's Arctic, with fewer powers than a province and created by an act of Parliament rather than by the Constitution: Yukon, Northwest Territories, and Nunavut."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4b2d21b-d212-36a7-96a1-1109f3a1b6fb",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "One of three of Australia's federal entities, located in the country's north and southeast, with fewer powers than a state and created by an act of Parliament rather than by the Constitution: Northern Territory, Australian Capital Territory and Jervis Bay Territory."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af486f70-9c4a-3277-be62-794b1daa6c5b",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "A geographic area under control of a single governing entity such as state or municipality; an area whose borders are determined by the scope of political power rather than solely by natural features such as rivers and ridges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90d5088-0ede-44b1-92d2-35ac5e962539",
                                                "sense_id": "af486f70-9c4a-3277-be62-794b1daa6c5b",
                                                "text": "Lewis of France had his infancy attended by crafty and worldly men, who made extent of territory the most glorious instance of power, and mistook the acquisition of fame, for the spreading of honour."
                                            },
                                            {
                                                "example_id": "c4e274ec-27fe-41a7-8e48-a0d4bed398f5",
                                                "sense_id": "af486f70-9c4a-3277-be62-794b1daa6c5b",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4318434-b779-36b4-b957-846d0b16ab2d",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "An area that an animal of a particular species consistently defends against its conspecifics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5092fab4-442a-3f02-9964-381255eec3c7",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "The part of the playing field or board over which a player or team has control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfb36ae-24c5-424a-9dd3-eb5b002ea5c5",
                                                "sense_id": "5092fab4-442a-3f02-9964-381255eec3c7",
                                                "text": "Scotland had the territory and the momentum, forcing England into almost twice as many tackles and rattling them repeatedly at set-pieces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad905ca3-7f79-3807-80c9-2c0618b30bf9",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "A geographic area that a person or organization is responsible for in the course of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da8faea-fb6d-41e8-a9cc-b2dc6b7aed4b",
                                                "sense_id": "ad905ca3-7f79-3807-80c9-2c0618b30bf9",
                                                "text": "A well-designed sales territory allows a salesperson to make best use of his time with present and potential customers and minimize travel time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba7e699-2b22-34bd-b26c-8b7c90ddbf60",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "A location or logical space which someone owns or controls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76f2f05c-22d1-42b9-80d5-45ce32b712c7",
                                                "sense_id": "fba7e699-2b22-34bd-b26c-8b7c90ddbf60",
                                                "text": "The establishment of a personal territory almost invariably precedes the sharing of a territory with a mate. For those who are unable to make a break from the parental home, this stage is almost never reached."
                                            },
                                            {
                                                "example_id": "681d7451-0f4b-4308-a4b5-60f3ff9c0b91",
                                                "sense_id": "fba7e699-2b22-34bd-b26c-8b7c90ddbf60",
                                                "text": "In general, when a group member wanted an item that was located in someone else's personal territory, they would ask that person to pass them the item."
                                            },
                                            {
                                                "example_id": "4dbbc5d7-8229-4d2f-9e5e-9cf85873db04",
                                                "sense_id": "fba7e699-2b22-34bd-b26c-8b7c90ddbf60",
                                                "text": "Now that the days of handbag-carrying women have largely drawn to a close, houseworkers rarely have a clearly marked-out personal territory — although for some the dressing-table may be a non-transportable handbag equivalent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79077177-b39e-33ee-a005-97d73702920c",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "A market segment or scope of professional practice over which an organization or type of practitioner has exclusive rights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942c9606-4f40-44ea-95c5-f4f8ee14b63c",
                                                "sense_id": "79077177-b39e-33ee-a005-97d73702920c",
                                                "text": "The medical registration act eventually did form the foundation for medicine to be able to claim an ever increasing occupational territory and the domination of all other health disciplines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fda2adb5-44e9-3c3c-9b89-3aef81372212",
                                        "entry_id": "aab9e09a-de46-3475-bcc7-700d83e8562f",
                                        "glosses": [
                                            "An area of subject matter, knowledge, or experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a373107-15f5-4bd4-b168-e2801f8fdc4c",
                                                "sense_id": "fda2adb5-44e9-3c3c-9b89-3aef81372212",
                                                "text": "As a result, as the years have passed, my involvement with storytelling has expanded to the territory of compassionate action."
                                            },
                                            {
                                                "example_id": "96512b0e-984f-4483-8db4-d5506fd70109",
                                                "sense_id": "fda2adb5-44e9-3c3c-9b89-3aef81372212",
                                                "text": "12 July 2012, Sam Adams, AV Club Ice Age: Continental Drift\nThe matter of whether the world needs a fourth Ice Age movie pales beside the question of why there were three before it, but Continental Drift feels less like an extension of a theatrical franchise than an episode of a middling TV cartoon, lolling around on territory that’s already been settled."
                                            },
                                            {
                                                "example_id": "99edd4e1-9c9b-4604-81b3-1c15fe27c92a",
                                                "sense_id": "fda2adb5-44e9-3c3c-9b89-3aef81372212",
                                                "text": "I'd like to be friends, but on a new level. Can't you try to understand that? And here's a harder question\" Can we achieve it? This is uncharted territory for both of us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
