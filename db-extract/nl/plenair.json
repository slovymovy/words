                                "target_senses": [
                                    {
                                        "sense_id": "42eb9fd7-b2a6-3854-b057-f667e05dda7b",
                                        "entry_id": "b7eb89bd-c427-3f64-9cf3-1413a5287ff6",
                                        "glosses": [
                                            "Séance plénière ou session plénière : réunion comportant la totalité des membres d'une assemblée, d'un congrès, d'une association."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8726ea3d-3179-430d-a0b9-7b68b88bc6f4",
                                                "sense_id": "42eb9fd7-b2a6-3854-b057-f667e05dda7b",
                                                "text": "La plénière renvoyée à une date ultérieure, des échanges se tiendront aujourd'hui au Pullman Grand Hôtel."
                                            },
                                            {
                                                "example_id": "c1929df7-d4d0-43ba-beab-f93253f48668",
                                                "sense_id": "42eb9fd7-b2a6-3854-b057-f667e05dda7b",
                                                "text": "Ordre du jour de la plénière."
                                            },
                                            {
                                                "example_id": "05835c6c-3a3f-46b2-b00e-84554e89c92b",
                                                "sense_id": "42eb9fd7-b2a6-3854-b057-f667e05dda7b",
                                                "text": "La plénière est composée des 736 députés élus au suffrage universel, la plupart membres d'un groupe politique, les autres constituant les non-inscrits."
                                            },
                                            {
                                                "example_id": "a526ae42-f462-4ce8-bfef-cb0161c02d00",
                                                "sense_id": "42eb9fd7-b2a6-3854-b057-f667e05dda7b",
                                                "text": "Les réunions des commissions et les séances plénières sont publiques et retransmises sur l’internet."
                                            }
                                        ]
                                    }
                                ]
                            },
