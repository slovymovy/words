                        "expansion économique",
                        "expansion territoriale"
                    ]
                },
                {
                    "sense_id": "57c623e7-a7a6-314b-89eb-3e8b33bb77fc",
                    "sense_definition": "Action ou état d'un corps fluide ou gazeux qui augmente de volume en se dilatant.",
