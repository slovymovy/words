                                "target_senses": [
                                    {
                                        "sense_id": "abf94eca-178b-38a1-b22c-3e7a58330d07",
                                        "entry_id": "37d2ccb7-44eb-3f26-b0f5-52a426035939",
                                        "glosses": [
                                            "so, dass es nicht vollführt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d3d0bf-3f79-450b-b5c0-71db95f88168",
                                                "sense_id": "abf94eca-178b-38a1-b22c-3e7a58330d07",
                                                "text": "„Die Herren hatten am Vormittag diese Idee als undurchführbar bezeichnet, worauf Dupic erklärt hatte, die Besprechung auf den Abend verschieben zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
