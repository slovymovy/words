                            {
                                "example_id": "f22b977b-5368-462d-b082-d4da462ffdaa",
                                "sense_id": "07b8cce0-69bd-338b-a05b-4f4e8b45b04e",
                                "text": "Afkanten: Brei de eerste steek, brei de tweede steek en haal de eerste over de tweede heen zodat er maar één steek op de rechternaald staat. Brei de derde steek en haal de tweede hierover heen. Je hebt telkens maar één steek op de rechternaald over."
                            }
                        ]
