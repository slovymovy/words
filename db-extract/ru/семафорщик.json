                                                "example_id": "25bb1c11-42e2-43af-b08d-ec7464850d56",
                                                "sense_id": "834f70ba-c718-3794-8401-db17c1315be1",
                                                "text": "L’opérateur me connecta aussitôt."
                                            }
                                        ]
