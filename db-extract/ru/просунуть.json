                "senses": [
                    {
                        "sense_id": "a2cf057b-57cf-3969-95d8-e81c5e67a0c4",
                        "entry_id": "4e4eec90-784a-3c2f-8d64-cecfad1a68ea",
                        "glosses": [
                            "втолкнуть, впихнуть, протянуть сквозь что-либо или внутрь чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7c7657-74f3-40d6-87d6-de4f48e1c788",
                                "sense_id": "a2cf057b-57cf-3969-95d8-e81c5e67a0c4",
                                "text": "Стёпка просунул к нему голову в окошко."
                            },
                            {
                                "example_id": "a9ea674b-d858-4b76-82c1-6f2280e94b57",
                                "sense_id": "a2cf057b-57cf-3969-95d8-e81c5e67a0c4",
                                "text": "Вам записка есть, вот я её в фортку просуну."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d48b8da-d411-4986-8f57-1028ab8244a3",
                        "source_entry_id": "4e4eec90-784a-3c2f-8d64-cecfad1a68ea",
                        "source_sense_id": "a2cf057b-57cf-3969-95d8-e81c5e67a0c4",
                        "target_lang_word": "put through",
