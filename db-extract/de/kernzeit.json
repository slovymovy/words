                "senses": [
                    {
                        "sense_id": "629141dd-3952-3267-91e7-9480abb0e36d",
                        "entry_id": "6f4f99f9-529c-3429-a019-f13112548c3b",
                        "glosses": [
                            "Zeitraum, in der für Arbeitnehmer Anwesenheitspflicht am Arbeitsplatz gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f02a64-b746-4af7-8d71-c52a388379e7",
                                "sense_id": "629141dd-3952-3267-91e7-9480abb0e36d",
                                "text": "„Jeder Mitarbeiter ist während der Kernzeit anwesend, mit Ausnahme der Pausen.“"
                            },
                            {
                                "example_id": "03de1c1c-26e9-418a-83e5-8ad661ffa3b5",
                                "sense_id": "629141dd-3952-3267-91e7-9480abb0e36d",
                                "text": "„Die Kernzeit regelt damit auch den spätesten Arbeitsbeginn und das früheste Arbeitsende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfa53070-b69a-39c7-acf0-183d6fd2562a",
                        "entry_id": "6f4f99f9-529c-3429-a019-f13112548c3b",
                        "glosses": [
                            "bestimmte festgelegte Zeitspanne"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "400b8847-a216-4f68-8071-34daae1aed98",
                                "sense_id": "cfa53070-b69a-39c7-acf0-183d6fd2562a",
                                "text": "„Demnach sollen Autofahrer für das Parken ihrer Fahrzeuge von montags bis freitags in einer Kernzeit zwischen 8 Uhr und 19 Uhr zahlen.“"
                            },
                            {
                                "example_id": "c8dcb26b-d807-4668-8f56-9d45675aa5e1",
                                "sense_id": "cfa53070-b69a-39c7-acf0-183d6fd2562a",
                                "text": "„Die meisten Debatten, die außerhalb der Kernzeit des Parlaments stattfinden, sind auf 38 Minuten angelegt.“"
                            },
                            {
                                "example_id": "9232aec5-66e8-41b7-a7c5-f2efaef20e05",
                                "sense_id": "cfa53070-b69a-39c7-acf0-183d6fd2562a",
                                "text": "„Der Vorsitzende Richter Stefan Paetow sagte: ‚Der Flughafen darf planmäßig ausgebaut werden, aber mit weitgehenden Verbesserungen für den Lärmschutz und einem Nachtflugverbot in der Kernzeit von 0 bis 5 Uhr.‘“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
