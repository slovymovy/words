                        "entry_id": "ae1498a6-02ae-32f5-9218-c2afe407be5f",
                        "glosses": [
                            "Définit la capacité d’un individu à visualiser en 3D un objet représenté en 2D."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af72ec9c-bc06-4d0a-b806-583aa5e22581",
                                "sense_id": "b6cb0db4-e797-30b7-a392-622066a1d28c",
                                "text": "Le trouble visuo-attentionnel ou visuo-spatial peut être responsable d’une dysgraphie."
                            },
                            {
                                "example_id": "e32d4582-1306-4c2e-a5ea-6bc7a2a6d40c",
                                "sense_id": "b6cb0db4-e797-30b7-a392-622066a1d28c",
                                "text": "Une intelligence visuo-spatiale."
                            },
                            {
                                "example_id": "277206ee-9666-42dd-aad6-e60e273940ba",
                                "sense_id": "b6cb0db4-e797-30b7-a392-622066a1d28c",
                                "text": "Les capacités visuo-spatiales de nombreux internautes ont permis de connaître la configuration spatiale de certaines protéines, permettant entre autres de mieux comprendre comment agir efficacement contre le SIDA ou encore la maladie d’Alzheimer."
                            }
                        ]
                    }
