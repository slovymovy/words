            "senses": [
                {
                    "sense_id": "bd9d9773-8428-3411-9b34-ba42b7a2255e",
                    "sense_definition": "ein Bild, einen Film oder Licht mithilfe eines optischen Geräts auf eine Fläche werfen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lehrer <w>projizierte</w> die Folien der Präsentation direkt an die weiße Wand."
                        },
                        {
                            "text": "Mit einem modernen Beamer kann man Filme gestochen scharf auf eine Leinwand <w>projizieren</w>."
                        }
                    ],
                    "synonyms": [
                        "werfen"
                    ],
                    "common_phrases": [
                        "an die Wand projizieren",
                        "auf eine Leinwand projizieren"
                    ]
                },
                {
                    "sense_id": "f4f19aad-5ddf-3ffa-a712-b4322372bfc4",
                    "sense_definition": "eigene Gefühle, Vorstellungen oder Ängste unbewusst auf eine andere Person übertragen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Eltern <w>projizieren</w> ihre eigenen unerfüllten Träume unbewusst auf ihre Kinder."
                        },
                        {
                            "text": "Er bemerkte gar nicht, dass er seine persönliche Frustration auf seine Kollegen <w>projizierte</w>."
                        }
                    ],
                    "synonyms": [
                        "übertragen"
                    ],
                    "common_phrases": [
                        "auf andere projizieren",
                        "eigene Ängste projizieren"
                    ]
                },
                {
                    "sense_id": "75a3b263-5d76-358c-8c2f-1d20d4dad15f",
                    "sense_definition": "einen räumlichen Körper oder geometrische Punkte rechnerisch beziehungsweise zeichnerisch auf eine Fläche abbilden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der darstellenden Geometrie lernt man, wie man dreidimensionale Körper auf eine zweidimensionale Ebene <w>projiziert</w>."
                        },
                        {
                            "text": "Kartografen müssen die gekrümmte Erdoberfläche auf ein flaches Blatt Papier <w>projizieren</w>."
                        }
                    ],
                    "synonyms": [
                        "abbilden"
                    ],
                    "common_phrases": [
                        "auf eine Ebene projizieren"
                    ]
                }
            ]
        }
