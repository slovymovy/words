                "senses": [
                    {
                        "sense_id": "55630d58-51fe-3147-b088-238e62956861",
                        "entry_id": "63fa27ad-bbf0-36ab-a186-c21d73b3f2e9",
                        "glosses": [
                            "(automatische) Spracherkennung = automatische Erfassung sprachlicher Äußerungen einschließlich ihrer semantischen (bedeutungsmäßigen) und syntaktischen Strukturen durch einen Computer"
                        ],
                        "tags": [
                            "Computerlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "a4c38daa-7619-4ff0-828c-6058efa8553e",
                                "sense_id": "55630d58-51fe-3147-b088-238e62956861",
                                "text": "Der Begriff Spracherkennung ist weitgehend auf die Aufnahme sprachlicher Äußerungen durch Computer beschränkt, kann aber gelegentlich auch im Sinne von Sprachrezeption gemeint sein."
                            },
                            {
                                "example_id": "93ab40b5-8fc1-40a6-b1c7-406e61ab6992",
                                "sense_id": "55630d58-51fe-3147-b088-238e62956861",
                                "text": "Die automatische Spracherkennung ist Voraussetzung für die automatische Übersetzung."
                            },
                            {
                                "example_id": "1a390cbb-a6f3-41cb-9aa5-b28c6797badb",
                                "sense_id": "55630d58-51fe-3147-b088-238e62956861",
                                "text": "„Schon entwickeln sie eine spezielle Programmversion mit integrierter Spracherkennung für das hauseigene Handy-Betriebssystem »Android«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53c41b03-26c8-34c5-8466-94daa33690ab",
                        "entry_id": "63fa27ad-bbf0-36ab-a186-c21d73b3f2e9",
                        "glosses": [
                            "Wahrnehmung und Verstehen sprachlicher Äußerungen durch eine Person"
                        ],
                        "tags": [
                            "Psycholinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "887cc158-1791-428c-bbf7-184558b653b7",
                                "sense_id": "53c41b03-26c8-34c5-8466-94daa33690ab",
                                "text": "Die Spracherkennung durch eine Person erfordert eine Vielzahl unterschiedlicher Leistungen vom Hören/ Lesen bis zum Erkennen von Wörtern, Sätzen oder Texten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
