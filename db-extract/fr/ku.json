                                    {
                                        "sense_id": "6d2fd848-db28-32df-9c8f-7f5cd9723402",
                                        "entry_id": "8895b0a5-b7c3-3fa7-ad7c-63eca2bcc5e2",
                                        "glosses": [
                                            "The name of the Latin-script letter Q/q. Alternative form of cue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f22cac7-af82-4e44-ad2b-bed6401c3b03",
                                                "sense_id": "6d2fd848-db28-32df-9c8f-7f5cd9723402",
                                                "text": "The names of the letters, as now commonly spoken and written in English, are A, Bee, Cee, Dee, E, Eff, Gee, Aitch, I, Jay, Kay, Ell, Em, En, O, Pee, Kue, Ar, Ess, Tee, U, Vee, Double-u, Ex, Wy, Zee."
                                            },
                                            {
                                                "example_id": "f548dcc6-9448-4de6-8a92-cbb6aaf87199",
                                                "sense_id": "6d2fd848-db28-32df-9c8f-7f5cd9723402",
                                                "text": "And there is [a] proverbial warning to mind your pees and kues."
                                            },
                                            {
                                                "example_id": "b54c9528-004f-4206-90e3-74c4b195ed0c",
                                                "sense_id": "6d2fd848-db28-32df-9c8f-7f5cd9723402",
                                                "text": "SQL is pronounced either \"ess-kue-ell\" or \"see-kwell\" depending on your preference."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c667f1a-9baa-49b6-b703-9831500b9065",
                        "source_entry_id": "3d3c72a7-8fcc-34ab-a880-4e935dfd59fd",
                        "source_sense_id": "4371ff32-878f-3b0b-ae4d-2beab4cda542",
                        "target_lang_word": "kew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dcdf136-2ae3-3f47-9612-0ce38097adcd",
                                        "entry_id": "fa29e3e1-bad7-3d5a-81d3-58ad3bb9587f",
                                        "glosses": [
                                            "The name of the Latin-script letter Q/q."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab6b9ee7-9ae7-4aef-9e7e-50fda1d056a2",
                                                "sense_id": "4dcdf136-2ae3-3f47-9612-0ce38097adcd",
                                                "text": "The following telegram with explain this: \"Your suggestion approved stop the troops proceeding to ex those to wye and zed and the detachment at kew must be completed to ten days rations.\""
                                            },
                                            {
                                                "example_id": "fb047b51-af93-47be-a36d-9671a3c4c509",
                                                "sense_id": "4dcdf136-2ae3-3f47-9612-0ce38097adcd",
                                                "text": "the pardonable confusion for which some blame the cudgel and more blame the soot but unthanks to which the pees with their caps awry are quite as often as not taken for kews with their tails in their or are quite as often as not taken for pews with their tails in their mouths"
                                            },
                                            {
                                                "example_id": "e9242b14-91ac-41d6-b407-0e404e44a40a",
                                                "sense_id": "4dcdf136-2ae3-3f47-9612-0ce38097adcd",
                                                "text": "\"As usual I got me pees an' kews mixed up.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe764e2-c54b-3951-87b1-06c97010a09b",
                                        "entry_id": "b225182c-f0ab-3a12-9cc7-473d235e2134",
                                        "glosses": [
                                            "Clipping of thank you."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47549af-eef2-47bf-8a42-2b700ac4874d",
                                                "sense_id": "bfe764e2-c54b-3951-87b1-06c97010a09b",
                                                "text": "‘Kew,’ she said politely, and then took off, expertly negotiating the narrow aisles between the stalls."
                                            }
                                        ]
