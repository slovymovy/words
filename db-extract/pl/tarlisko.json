                                "target_senses": [
                                    {
                                        "sense_id": "6a2307a4-05f2-3ab2-afab-3031afd7474c",
                                        "entry_id": "898c7593-f139-313e-b484-4a981ace7ba5",
                                        "glosses": [
                                            "Alternative form of breeding-ground."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
