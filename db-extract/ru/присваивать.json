                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb1040c-89a6-4216-8da6-62c0488d8912",
                                                "sense_id": "17740072-450c-3d82-b8ad-4d241b53ed54",
                                                "text": "Ich habe mir die niederländische Sprache innerhalb eines Jahres angeeignet."
