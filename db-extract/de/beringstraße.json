                "senses": [
                    {
                        "sense_id": "931281d6-ab7d-3c2b-90ff-d0802c85e07b",
                        "entry_id": "2f18735b-3bc7-3968-89cc-9e5d6295d79d",
                        "glosses": [
                            "Meerenge zwischen Russland und dem US-Bundesstaat Alaska, die den Pazifik mit dem Arktischen Ozean verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a688ed6-06eb-47ad-9f83-701a61e82524",
                                "sense_id": "931281d6-ab7d-3c2b-90ff-d0802c85e07b",
                                "text": "„Zurzeit sind sie in der Beringstraße und versuchen dem fabrikmäßigen Massenmord an Killerwalen oder irgendwelchen anderen abgefahrenen Blauflossen-Sushifischen ein Ende zu machen.“"
                            },
                            {
                                "example_id": "12f28827-20c4-476e-b61f-3e18c3975f33",
                                "sense_id": "931281d6-ab7d-3c2b-90ff-d0802c85e07b",
                                "text": "„Vor etwa dreizehntausend Jahren, so die Meinung der meisten Wissenschaftler, überquerten einige in Nordostasien lebende Gruppen die Beringstraße und wanderten in Alaska ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
