                    {
                        "sense_id": "1cab0e96-0abc-3e27-9be9-cf423efd9aeb",
                        "entry_id": "7b3a260d-e2b4-3e19-a4ca-ae393fcc4a04",
                        "glosses": [
                            "jede Art von Blume, die an einer Mauer blüht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "112fe3a7-9d82-4012-9c9e-997f91297191",
                                "sense_id": "1cab0e96-0abc-3e27-9be9-cf423efd9aeb",
                                "text": "Ich habe heute schöne Fotos von einigen Mauerblümchen gemacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7267950e-9d59-37d1-bace-eed58c88f206",
                        "entry_id": "7b3a260d-e2b4-3e19-a4ca-ae393fcc4a04",
                        "glosses": [
                            "eine weibliche (selten auch männliche) Person, die ihre sexuellen oder anderweitig positiven Vorzüge nicht richtig zum Ausdruck bringt, beziehungsweise diese vermeintlich gar nicht besitzt, und deswegen auf das andere Geschlecht eher unauffällig wirkt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "35954308-2702-4d87-ac28-1758a9400341",
                                "sense_id": "7267950e-9d59-37d1-bace-eed58c88f206",
                                "text": "Ralf hat sich wirklich in dieses Mauerblümchen verliebt? Das kann ich kaum glauben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3aad5057-f615-48e7-b8ec-4a1b645c32ca",
                        "source_entry_id": "7b3a260d-e2b4-3e19-a4ca-ae393fcc4a04",
                        "source_sense_id": "1cab0e96-0abc-3e27-9be9-cf423efd9aeb",
                        "source_sense_description": "allgemein: jede Art von Blume, die an einer Mauer blüht",
                        "target_lang_word": "wallflower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wallflower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea82b2f-c072-34f2-9612-f45c3e71aa42",
                                        "entry_id": "a14d48ef-2262-39d4-9fa4-cb9375f82239",
                                        "glosses": [
                                            "Any of several short-lived herbs or shrubs of the Erysimum genus with bright yellow to red flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b9f633-3bdc-40cd-91a2-4c475114721a",
                                                "sense_id": "9ea82b2f-c072-34f2-9612-f45c3e71aa42",
                                                "text": "A polypetalous corolla is either cruciform, as in a wall-flower, rosaceous, papilionaceous, as in the pea kind, or incomplete, when some parts found in analogous flowers are wanting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0785e5c5-9466-3b28-ab47-ecf9ba27d128",
                                        "entry_id": "a14d48ef-2262-39d4-9fa4-cb9375f82239",
                                        "glosses": [
                                            "Gastrolobium grandiflorum, a poisonous bushy shrub, endemic to Australia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                        "entry_id": "a14d48ef-2262-39d4-9fa4-cb9375f82239",
                                        "glosses": [
                                            "A person who does not dance at a party, due to shyness or unpopularity; by extension, anyone who is left on the sidelines while an activity takes place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51712d7-a27b-46d0-94a4-0b0af3222623",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "Mrs. Galbraith shook all over with laughter as she replied, \"Hear that boy, asking me to dance ! I'm content to be a wallflower, now-a-days.\""
                                            },
                                            {
                                                "example_id": "74a68f33-076c-4f8a-8c34-5f391060686d",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "And now, by virtue of his office, he is entitled to a seat in the Grand Lodge. Is it any wonder he is a wall-flower there […]"
                                            },
                                            {
                                                "example_id": "62b68278-e5fb-4284-923a-2a63a1639cd5",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "It is a triumph, of course, to have plenty of partners, and not to be a wallflower for a single dance."
                                            },
                                            {
                                                "example_id": "3ef3dcc0-8e1b-418c-a004-3f8b487d59c7",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "Jack Breen was a wallflower; still at the same time I noticed he was cultivating an ornamental smile — a Jack of Trumps, you bet."
                                            },
                                            {
                                                "example_id": "14fc9af4-9e35-4897-bb07-5c683bef82aa",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "She was a wallflower in a sleepy little town itself a wallflower. She was a joke to the village wits and a byword to the village belles."
                                            },
                                            {
                                                "example_id": "c30dd393-5792-4fdf-a7f6-45606fb6fb03",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "\"Where--oh. Hidden in the corner. You two aren't already going all wallflower, are you?\" \"We are not wallflowers.\" \"To be fair, I can be. But then I get mad at myself for it and get all loud and snarky.\""
                                            },
                                            {
                                                "example_id": "7dec9410-dddf-4b13-8156-58f284d7329b",
                                                "sense_id": "7af6c29d-38a7-3417-98a0-63328b679367",
                                                "text": "Second City was a wallflower at the show business ball. It needed to be. Improvisers needed to fail, and fail safely; and in the Midwest, far from Broadway and Hollywood, they really could. Second-class stature was the secret ingredient, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edcf1e6-5adc-39e9-bc6d-4a0cd6c0d0f6",
                                        "entry_id": "a14d48ef-2262-39d4-9fa4-cb9375f82239",
                                        "glosses": [
                                            "Any person who is socially awkward, shy, or reserved."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85926b48-5320-4e44-bdae-c631e5794cc6",
                                                "sense_id": "2edcf1e6-5adc-39e9-bc6d-4a0cd6c0d0f6",
                                                "text": "I've always been a wallflower, even in my own home. But, I'm willing to learn to be a part of your world. I would like to. I have already told my parents that I want to go to soirées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wallflower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7798208-7ea9-3e9c-9278-67c81d141c0e",
                                        "entry_id": "b34c5ebc-322e-3e10-9331-635f29df910d",
                                        "glosses": [
                                            "To stand shyly apart from a dance, waiting to be asked to join in."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08070b18-a4ec-45fb-9b44-7d25947606a5",
                                                "sense_id": "e7798208-7ea9-3e9c-9278-67c81d141c0e",
                                                "text": "[…] the idea that a full tango experience is impossible without the presence of wallflowers and without the threat of wallflowering as the potential dancers enter the tango club."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
