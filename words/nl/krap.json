                                "target_lang_word": "шкварка",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gratton",
                                "target_lang_sense_clarification": "résidu de gras frit ou grillé"
