                        "glosses": [
                            "opadanie materiału mineralnego lub szczątków organicznych prowadzące do powstania osadów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d03c2b7-4e05-4f30-b32d-9035f64d6f5b",
                                "sense_id": "d657e5cd-5f38-3e63-9c2d-b0ad544b0573",
                                "text": "Wraz z wiekiem następuje sukcesywne wypłycanie i w pewnym momencie zaczyna przeważać sedentacja, która na obszarach torfowisk całkowicie eliminuje sedymentację."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
