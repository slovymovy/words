                        "glosses": [
                            "tweewielig wagentje met twee hoog geplaatste handvatten die verbonden zijn met een kort, plat laadvlak dat in stilstand op de grond rust en dan eenvoudig onder lading kan worden geschoven; hierna kan het geheel door de handvatten gemakkelijk worden gekanteld en weggereden"
                        ],
                        "tags": [],
                        "examples": [
                            {
