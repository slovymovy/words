{
    "word_family": [
        "lenience",
        "lenient",
        "leniently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "197ab780-5a35-3c6f-86c9-28c1526a61ef",
                    "sense_definition": "The quality of being merciful or tolerant, especially in the context of punishment or judgment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leniency_quality_or_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convicted felon asked for <w>leniency</w>, but the judge refused and gave the maximum sentence.",
                            "target_lang_translations": {
                                "ru": "Осуждённый преступник просил о <w>снисхождении</w>, но судья отказал и назначил максимальный срок."
                            }
                        },
                        {
                            "text": "The defense lawyer decided to appeal for <w>leniency</w> due to the defendant's youth.",
                            "target_lang_translations": {
                                "ru": "Адвокат решил просить о <w>снисхождении</w>, ссылаясь на молодость подсудимого."
                            }
                        }
                    ],
                    "synonyms": [
                        "clemency",
                        "lenience",
                        "mercy"
                    ],
                    "antonyms": [
                        "severity",
                        "harshness",
                        "strictness"
                    ],
                    "common_phrases": [
                        "ask for leniency",
                        "appeal for leniency",
                        "show leniency",
                        "plead for leniency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление мягкости, терпимости или милосердия, особенно при назначении наказания или вынесении приговора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снисхождение",
                                "target_lang_sense_clarification": "смягчение наказания, милосердие"
                            },
                            {
                                "target_lang_word": "снисходительность",
                                "target_lang_sense_clarification": "отсутствие строгости, мягкость отношения"
                            },
                            {
                                "target_lang_word": "мягкость",
                                "target_lang_sense_clarification": "нестрогость приговора или решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c021c9d6-fc1f-33cd-b9c6-5f834bcea28e",
                    "sense_definition": "A specific instance or act of being lenient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leniency_quality_or_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics warned that such occasional <w>leniencies</w> would weaken the enforcement of school rules.",
                            "target_lang_translations": {
                                "ru": "Критики предупреждали, что подобные единичные <w>послабления</w> ослабят соблюдение школьных правил."
                            }
                        },
                        {
                            "text": "His repeated <w>leniency</w> toward minor infractions eventually led to serious disciplinary problems.",
                            "target_lang_translations": {
                                "ru": "Его постоянные <w>поблажки</w> при мелких нарушениях в итоге привели к серьёзным проблемам с дисциплиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "indulgence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный случай или акт проявления мягкости и снисхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послабление",
                                "target_lang_sense_clarification": "отступление от строгих правил, уступка"
                            },
                            {
                                "target_lang_word": "поблажка",
                                "target_lang_sense_clarification": "прощение провинности, нестрогое отношение"
                            },
                            {
                                "target_lang_word": "снисхождение",
                                "target_lang_sense_clarification": "проявление мягкости в конкретном случае"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}