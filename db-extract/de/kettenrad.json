                "senses": [
                    {
                        "sense_id": "fef0e6ce-4cdc-3900-a8c7-e5ff7bcd8930",
                        "entry_id": "5a1fc494-9574-3818-ba6f-351fe580f4b8",
                        "glosses": [
                            "Zahnrad, in dessen Zähne eine Kette eingreift und läuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f032131c-87c5-4f6e-a82c-34c2eec2fade",
                                "sense_id": "fef0e6ce-4cdc-3900-a8c7-e5ff7bcd8930",
                                "text": "„Meine Einkaufsgenossenschaft hat dieses in großer Stückzahl auf der Messe geordert, und jetzt muß es zügig abverkauft werden. \"Klar, daß das Bike eine Kettenschaltung mit 21 Gängen hat und die Kette völlig ungeschützt, also für das Fahren in Straßenkleidung nicht nur ungeeignet ist, sondern gefährlich werden kann, wenn Rock oder Hose zwischen Kette und Kettenrad gelangen. Dabei gibt es Nabenschaltungen mit sieben völlig ausreichenden Gängen, wo die Vollverkapselung der Kette möglich wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
