                ],
                "senses": [
                    {
                        "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                        "entry_id": "fcf7fd1a-edd8-32cc-a37e-e0b581ead32f",
                        "glosses": [
                            "eine Wasserabweisevorrichtung bei Fenstern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98c3e2f-99c9-44ab-b3ab-7f0eb5390441",
                                "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                                "text": "„Für den Dampfdruckausgleich erfolgt die Glasfalzentlüftung bei Holzfensterflügeln i. d. R. über eine Nut im Eckstoß, welche im Bereich der Wetterschutzschiene endet.“"
                            },
                            {
                                "example_id": "f6e14c96-11b1-4c94-8ea1-3847741c21b0",
                                "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                                "text": "„Über die Wasserkammer der Wetterschutzschiene muß ein Druckausgleich möglich sein.“"
                            },
                            {
                                "example_id": "04694ef9-323f-4144-bb61-4cfa4bc8ab59",
                                "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                                "text": "„Zum Schutz des Blendrahmens ist die Wetterschutzschiene seitlich mit einer Endkappe oder durch elastischen Dichtstoff abzudichten […].“"
                            },
                            {
                                "example_id": "60ecfa31-b5d3-49c5-834f-64375f916427",
                                "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                                "text": "„Die Befestigung der Wetterschutzschiene kann entweder mit Schrauben oder mit Klemmverbindung (z. B. Tannenzapfen) erfolgen.“"
                            },
                            {
                                "example_id": "4dd9c704-b5f2-4ad7-9467-b140e1dbbdd6",
                                "sense_id": "ab23b1bc-4721-36ce-9eba-a7bdbf014ca5",
                                "text": "„Bei der Dichtheitsprüfung wird ein Ventilator mit dem Einbaurahmen in die Wetterschutzschiene eines Fensters eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
