        "fr-extract.jsonl": [
            {
                "entry_id": "702447ec-43ff-3ac5-9fa6-2b53ae131ed6",
                "word": "biogaz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e6ed30c-d502-382e-8f3c-e82f5d960ee2",
                        "entry_id": "702447ec-43ff-3ac5-9fa6-2b53ae131ed6",
                        "glosses": [
                            "Gaz produit par la fermentation de matières organiques animales (purin) ou végétales en l’absence d’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5195c657-d1d9-46a0-a299-7305a45099d8",
                                "sense_id": "3e6ed30c-d502-382e-8f3c-e82f5d960ee2",
                                "text": "Par un procédé de fermentation hors oxygène, les composés organiques (déjections humaines ou animales) produisent un dégagement composé essentiellement de méthane appelé biogaz."
                            },
                            {
                                "example_id": "0205eb3e-412a-4d00-b46d-1bdb351a15c5",
                                "sense_id": "3e6ed30c-d502-382e-8f3c-e82f5d960ee2",
                                "text": "Les besoins en énergie de Tériya Bugu sont couverts en partie par le solaire thermique et photovoltaïque ainsi que le biogaz mais la plus grande part de l’électricité est produite par des groupes électrogènes fonctionnant au gasoil. La consommation en carburant s’élève actuellement 65 000 L/an."
                            },
                            {
                                "example_id": "9c928497-94bd-4574-8f6d-f4a7da1996ac",
                                "sense_id": "3e6ed30c-d502-382e-8f3c-e82f5d960ee2",
                                "text": "Dans le cas où le liquide entreposé dégage des biogaz pouvant être récupérés, une géomembrane peut agir comme couverture flottante pour capter ces gaz et contrôler l’émanation des odeurs."
                            },
                            {
                                "example_id": "12e0e266-d0c8-4be1-87e2-5a554b4a5fac",
                                "sense_id": "3e6ed30c-d502-382e-8f3c-e82f5d960ee2",
                                "text": "...nous ne pouvons plus ignorer que le gaz biochimique - biogaz, gaz putride, gaz de défécation, gaz des marais - possède un pouvoir calorifique plus élevé que le gaz de ville..."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e14b72-0c55-375f-803a-2cfa7920378d",
                        "entry_id": "702447ec-43ff-3ac5-9fa6-2b53ae131ed6",
                        "glosses": [
                            "Mélange gazeux contenant essentiellement du méthane et du dioxyde de carbone, qui est produit par digestion anaérobie."
                        ],
                        "tags": [
                            "Raffinage"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f18723f-eb5b-4e3c-b507-909cf5a96840",
                        "source_entry_id": "702447ec-43ff-3ac5-9fa6-2b53ae131ed6",
                        "target_lang_word": "Biogas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biogas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                        "entry_id": "f5f21b29-553f-3764-956c-f38dec58034c",
                                        "glosses": [
                                            "Produkt der anaeroben Vergärung organischer Substrate; entstehendes Gas, das als alternative Energiequelle dienen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715b403a-0061-41a5-9740-5d9df42f6eb5",
                                                "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                                "text": "„Zum Jahresende 2012 haben 108 Biogasanlagen 413 Mio. m³ Biogas in das Gasnetz eingespeist.“"
                                            },
                                            {
                                                "example_id": "30eaa40f-7793-44cd-b0d5-7276a2402ddc",
                                                "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                                "text": "„Biogase aus der Vergärung oder Schwachgase aus thermischen Vergasungsprozessen sind als Rohgase keine Gase nach DVGW-G 260.“"
                                            },
                                            {
                                                "example_id": "4cb9abcf-2fb7-4e8e-90c6-fd0e8ea61ef8",
                                                "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                                "text": "„Als regenerative Energieträger finden neben flüssigen Treibstoffsubstituten (z.B. Rapsölmethylester) vermehrt auch sog. Biogase, d.h. Gase, die aus der Vergasung fester und feuchter Biomasse resultieren, Verwendung in der dezentralen Energieumwandlung mit Blockheizkraftwerken“."
                                            },
                                            {
                                                "example_id": "64c8695a-a086-4486-8db7-1a6ecbb0a10f",
                                                "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                                "text": "„Die Zusammensetzung der Klär-, Deponie- und Biogase variiert je nach Herkunft.“"
                                            },
                                            {
                                                "example_id": "38784281-f1cb-4c54-bb87-4d14dcaadd2b",
                                                "sense_id": "33ca8562-cb74-34cc-b1b8-bbcab6da47d4",
                                                "text": "„Hinzu kommen die bei der Verrottung oder durch bakterielle Umsetzungsprozesse organischer Substanzen entstehenden Biogase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
