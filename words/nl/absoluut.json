                        ],
                        "ru": [
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "полный и безусловный"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "исчерпывающий"
                            },
                            {
                                "target_lang_word": "совершенный",
