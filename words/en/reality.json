    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6e70ab3-9d7a-387c-9765-cbfeeed7099f",
                    "sense_definition": "The real world; actual existence as opposed to imagination or fiction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "existence_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pretends to be rich, but in <w>reality</w> he has very little money.",
                            "target_lang_translations": {
                                "ru": "Он притворяется богатым, но в <w>реальности</w> у него очень мало денег.",
                                "zh": "他假装很有钱，但<w>实际上</w>他几乎没什么钱。"
                            }
                        },
                        {
                            "text": "It is time to face <w>reality</w> and stop dreaming about things that cannot happen.",
                            "target_lang_translations": {
                                "ru": "Пора признать <w>реальность</w> и перестать мечтать о несбыточном.",
                                "zh": "是时候面对<w>现实</w>，停止幻想那些不可能发生的事情了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "actuality",
                        "truth",
                        "real life"
                    ],
                    "antonyms": [
                        "fantasy"
                    ],
                    "common_phrases": [
                        "in reality",
                        "face reality",
                        "back to reality",
                        "escape reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реальный мир; действительное существование в противовес воображению или вымыслу.",
                        "zh": "真实世界；与想象或虚构相对的实际存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "объективный мир"
                            },
                            {
                                "target_lang_word": "действительность",
                                "target_lang_sense_clarification": "то, что существует на самом деле"
                            },
                            {
                                "target_lang_word": "явь",
                                "target_lang_sense_clarification": "не сон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现实",
                                "target_lang_sense_clarification": "客观存在的真实世界"
                            },
                            {
                                "target_lang_word": "实际",
                                "target_lang_sense_clarification": "客观存在的事实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                    "sense_definition": "A real entity, event, or fact; something that actually exists or happens.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "existence_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her dream of becoming a doctor finally became a <w>reality</w> after years of study.",
                            "target_lang_translations": {
                                "ru": "Ее мечта стать врачом наконец стала <w>реальностью</w> после многих лет учебы.",
                                "zh": "经过多年的学习，她成为医生的梦想终于变成了<w>现实</w>。"
                            }
                        },
                        {
                            "text": "We must deal with the economic <w>realities</w> of running a small business.",
                            "target_lang_translations": {
                                "ru": "Мы должны считаться с экономическими <w>реалиями</w> ведения малого бизнеса.",
                                "zh": "我们必须应对经营小企业所面临的经济<w>现实</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "become a reality",
                        "harsh reality",
                        "political reality",
                        "make a reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реальное событие, явление или факт; то, что действительно существует или происходит.",
                        "zh": "真实的事物、事件或事实；实际存在或发生的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "факт, свершившееся событие"
                            },
                            {
                                "target_lang_word": "реалии",
                                "target_lang_sense_clarification": "условия жизни, обстоятельства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现实",
                                "target_lang_sense_clarification": "客观事实"
                            },
                            {
                                "target_lang_word": "实际情况",
                                "target_lang_sense_clarification": "具体发生的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db39c24-802c-38a6-a5ae-735cb3f6dcfb",
                    "sense_definition": "The state of being actual or real; realness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "existence_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reality</w> of the danger did not sink in until the storm actually hit.",
                            "target_lang_translations": {
                                "ru": "<w>Реальность</w> опасности не доходила до них, пока шторм действительно не ударил.",
                                "zh": "直到暴风雨真正来袭，他们才意识到危险的<w>现实</w>。"
                            }
                        },
                        {
                            "text": "He lost his grasp on <w>reality</w> after staying awake for three days.",
                            "target_lang_translations": {
                                "ru": "Он потерял связь с <w>реальностью</w>, проведя три дня без сна.",
                                "zh": "三天没睡觉后，他失去了对<w>现实</w>的感知。"
                            }
                        }
                    ],
                    "synonyms": [
                        "truth",
                        "actuality"
                    ],
                    "common_phrases": [
                        "reality check",
                        "sense of reality",
                        "grasp on reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние реальности; свойство быть настоящим, подлинность.",
                        "zh": "真实的状态；真实性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "свойство"
                            },
                            {
                                "target_lang_word": "действительность",
                                "target_lang_sense_clarification": "истинность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真实性",
                                "target_lang_sense_clarification": "事物为真的属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70fcddfa-9f35-3528-9bbd-6e311da10bc6",
                    "sense_definition": "Reality television; a genre of programming documenting unscripted real-life situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people today want to become famous by appearing on <w>reality</w> TV.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди сегодня хотят прославиться, попав на <w>реалити</w>-шоу.",
                                "zh": "如今许多年轻人想通过参加<w>真人秀</w>节目而出名。"
                            }
                        },
                        {
                            "text": "She prefers watching documentaries over the drama found in most <w>reality</w> shows.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает смотреть документальные фильмы, а не драмы, которые можно найти в большинстве <w>реалити</w>-шоу.",
                                "zh": "比起大多数<w>真人秀</w>里的戏剧冲突，她更喜欢看纪录片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reality show",
                        "reality TV",
                        "reality star",
                        "reality series"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реалити-шоу; жанр телепередач, документирующих невыдуманные жизненные ситуации.",
                        "zh": "真人秀；一种记录非剧本化真实生活情境的电视节目类型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реалити-шоу",
                                "target_lang_sense_clarification": "жанр"
                            },
                            {
                                "target_lang_word": "реалити",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真人秀",
                                "target_lang_sense_clarification": "电视节目类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2e1ab6-f962-35fd-845a-96894af705d3",
                    "sense_definition": "The entirety of all that is real; the universe and everything that exists.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers and scientists have debated the fundamental nature of <w>reality</w> for centuries.",
                            "target_lang_translations": {
                                "ru": "Философы и ученые веками спорили о фундаментальной природе <w>реальности</w>.",
                                "zh": "几个世纪以来，哲学家和科学家们一直在争论<w>现实</w>的本质。"
                            }
                        },
                        {
                            "text": "Virtual <w>reality</w> technology allows users to experience a simulated world.",
                            "target_lang_translations": {
                                "ru": "Технология виртуальной <w>реальности</w> позволяет пользователям погрузиться в симулированный мир.",
                                "zh": "虚拟<w>现实</w>技术让用户能够体验一个模拟的世界。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nature of reality",
                        "virtual reality",
                        "fabric of reality",
                        "ultimate reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность всего реального; вселенная и всё существующее.",
                        "zh": "所有真实事物的总和；宇宙及一切存在之物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "философское понятие"
                            },
                            {
                                "target_lang_word": "действительность",
                                "target_lang_sense_clarification": "объективная реальность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现实",
                                "target_lang_sense_clarification": "哲学意义上的客观存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e709b6-a00e-3783-af17-211426b43ad7",
                    "sense_definition": "An individual observer's own subjective perception of that which is real.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perception_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his <w>reality</w>, he is always the victim, regardless of the actual facts.",
                            "target_lang_translations": {
                                "ru": "В его <w>реальности</w> он всегда жертва, независимо от фактических обстоятельств.",
                                "zh": "在他的<w>现实</w>里，无论事实如何，他永远是受害者。"
                            }
                        },
                        {
                            "text": "Different cultures may construct a different social <w>reality</w> based on their traditions.",
                            "target_lang_translations": {
                                "ru": "Разные культуры могут конструировать различную социальную <w>реальность</w>, основанную на их традициях.",
                                "zh": "不同的文化可能会基于各自的传统构建出不同的社会<w>现实</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "my reality",
                        "your reality",
                        "own reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Субъективное восприятие того, что реально, отдельным наблюдателем.",
                        "zh": "观察者个人对真实事物的主观感知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "субъективный мир"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现实",
                                "target_lang_sense_clarification": "主观认知的世界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b56e8286-e9ed-39c5-96b5-6c93ceb88dc9",
                    "sense_definition": "Loyalty; devotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight pledged his <w>reality</w> to the king in a solemn ceremony.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поклялся в своей <w>верности</w> королю на торжественной церемонии.",
                                "zh": "骑士在庄严的仪式上向国王宣誓效<w>忠</w>。"
                            }
                        },
                        {
                            "text": "She proved her <w>reality</w> to the cause through years of dedicated service.",
                            "target_lang_translations": {
                                "ru": "Она доказала свою <w>преданность</w> делу годами самоотверженной службы.",
                                "zh": "她通过多年的奉献证明了自己对事业的<w>忠诚</w>。"
                            }
                        }
