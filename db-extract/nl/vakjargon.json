                                "target_word": "Berufsjargon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c27cbdb4-e197-3cab-9d2b-eb85354947e1",
                                        "entry_id": "b27a5f45-01d1-322c-b158-8ef6cee5b8ca",
                                        "glosses": [
                                            "Sondersprache, gängige Redeweise mit speziellem Wortschatz, die in Äußerungen über Themen aus dem Bereich eines Berufs benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d92417c3-e686-4ca7-b05e-d52fff564c82",
                                                "sense_id": "c27cbdb4-e197-3cab-9d2b-eb85354947e1",
                                                "text": "„Ausdrücke der Militär- und der Hofsprache waren für ihn wegen ihrer exklusiven Verständlichkeit ebenso unbrauchbar wie Berufsjargons und jede Art von Spezialistenvokabular.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
