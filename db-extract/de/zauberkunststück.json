                ],
                "senses": [
                    {
                        "sense_id": "ddcd3c36-ce1c-33d9-b008-dc3be95bfe88",
                        "entry_id": "c264ec47-ff69-33f4-8317-76c93933a8b0",
                        "glosses": [
                            "Kunststück eines Zauberers, das auf einer sinnlichen Täuschung der Zuschauer beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a692c21-e948-41d3-b212-5b711737dc03",
                                "sense_id": "ddcd3c36-ce1c-33d9-b008-dc3be95bfe88",
                                "text": "„Daher kam mir die leichtfertige Sicherheit, mit der mein Landsmann sich hier bewegte, auch fast unglaublich und wie ein Zauberkunststück vor.“"
                            },
                            {
                                "example_id": "cc0f13b9-89be-4c09-8e5f-4af958ce8a1d",
                                "sense_id": "ddcd3c36-ce1c-33d9-b008-dc3be95bfe88",
                                "text": "„Am ersten Taufsonntag des Frühlings 1963 handelte das Programm Mr. Wizards davon, wie man die Wissenschaft benutzen könne, um seine Freunde mit Zauberkunststücken zu verblüffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17f6554-4052-46ae-9f5f-542f80f8e750",
                        "source_entry_id": "c264ec47-ff69-33f4-8317-76c93933a8b0",
                        "source_sense_id": "ddcd3c36-ce1c-33d9-b008-dc3be95bfe88",
                        "source_sense_description": "Kunststück eines Zauberers, das auf einer sinnlichen Täuschung der Zuschauer beruht",
                        "target_lang_word": "conjuring trick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjuring trick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "508a74a9-a259-3146-8439-739bea23edee",
                                        "entry_id": "50204926-baca-3413-8604-8be950344926",
                                        "glosses": [
                                            "A type of magic trick in which something is made to appear or disappear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfa5043-aae6-4010-aba4-d0d5af60c294",
                                                "sense_id": "508a74a9-a259-3146-8439-739bea23edee",
                                                "text": "Instead, as literary scholar Kate Shanley has argued, American Indians are “a permanent ‘present absence’ in U.S. colonial imagination, an ‘absence’ that reinforces at every turn the conviction that Native peoples are indeed vanishing and that the conquest of Native lands is justified.” Literary imagination played a significant part in this conjuring trick, and scholars have identified the significance of works such as those by James Fenimore Cooper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88ff8ab6-48df-48f9-90fe-61c6e24ac806",
                        "source_entry_id": "c264ec47-ff69-33f4-8317-76c93933a8b0",
                        "source_sense_id": "ddcd3c36-ce1c-33d9-b008-dc3be95bfe88",
