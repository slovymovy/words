                        "glosses": [
                            "Qui protège du point de vue neurologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bcb28e5-82cb-4910-8e6a-7cfde4e20183",
                                "sense_id": "2ec299a3-da7b-35e8-8092-c2aef8651520",
                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                            },
                            {
                                "example_id": "ff558f85-add7-445c-8e8f-a976db134aea",
                                "sense_id": "2ec299a3-da7b-35e8-8092-c2aef8651520",
                                "text": "Des études sont réalisées visant non plus à introduire un gène mais un gène curatif de l'anomalie génétique associé à un facteur neuro-protecteur, voire deux substances neuro-protectrices telles que le PEDF et le FGF2."
                            },
                            {
                                "example_id": "969e34c4-d8c4-4d25-802c-fc532960db2f",
                                "sense_id": "2ec299a3-da7b-35e8-8092-c2aef8651520",
                                "text": "Pourtant, Gao (2011) pense que les flavonoïdes ont des effets neuro-protecteurs qui devraient prévenir la maladie de Parkinson."
                            }
                        ]
                    }
