                    {
                        "translation_id": "15e7df49-d0f3-4b6e-b53d-2e0cd9c8d12e",
                        "source_entry_id": "3d0778b7-84ce-32d3-85ea-7abe86ff0d96",
                        "source_sense_id": "dfc2d567-f3a7-30d2-8236-9748a9db3225",
