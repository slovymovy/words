            "senses": [
                {
                    "sense_id": "198df49f-dd63-37a2-b9f0-ab2e1a6ba968",
                    "sense_definition": "Een vrouwelijke leerkracht op een basisschool of in de kleuterklas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>juf</w> leest elke ochtend een spannend verhaal voor aan de klas.",
                            "target_lang_translations": {
                                "en": "The <w>teacher</w> reads an exciting story to the class every morning."
                            }
                        },
                        {
                            "text": "Mijn <w>juf</w> van de basisschool was altijd erg geduldig en vriendelijk.",
                            "target_lang_translations": {
                                "en": "My primary school <w>teacher</w> was always very patient and friendly."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderwijzeres",
                        "lerares",
                        "juffrouw"
                    ],
                    "antonyms": [
                        "meester"
                    ],
                    "common_phrases": [
                        "juf van de basisschool",
                        "lieve juf"
                    ],
                    "target_lang_definitions": {
                        "en": "A female teacher at a primary school or kindergarten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "teacher",
                                "target_lang_sense_clarification": "female, primary school"
                            },
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "used as a title or form of address for a female teacher"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2289fefa-ad2f-379a-8a84-c5a27b1c9edc",
                    "sense_definition": "Een informele manier om te verwijzen naar een jonge vrouw of een meisje.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk eens aan, dat kleine meisje is inmiddels een heel leuk <w>jufje</w> geworden.",
                            "target_lang_translations": {
                                "en": "Look at that, that little girl has become a very nice <w>young lady</w> by now."
                            }
                        },
                        {
                            "text": "De oude buurman noemt de jonge vrouw van hiernaast altijd een vlot <w>jufje</w>.",
                            "target_lang_translations": {
                                "en": "The old neighbor always calls the young woman next door a brisk <w>missy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "juffrouw"
                    ],
                    "common_phrases": [
                        "leuk jufje",
                        "vlot juffie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in de verkleinvorm zoals jufje of juffie."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal way to refer to a young woman or a girl."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "young lady",
                                "target_lang_sense_clarification": "informal reference to a girl or young woman"
                            },
                            {
                                "target_lang_word": "missy",
                                "target_lang_sense_clarification": "informal or diminutive reference to a girl"
                            }
                        ]
                    }
                }
            ]
        }
    ]
