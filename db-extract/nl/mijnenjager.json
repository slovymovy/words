                    {
                        "sense_id": "27f06cbf-ba45-3645-bae2-60d5672bf9e8",
                        "entry_id": "265a6bcf-d3df-3c02-a883-cadd18aedaf9",
                        "glosses": [
                            "schip dat als doel heeft mijnen in zee of ander water op te sporen en te vernietigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b60f91-5367-4c47-ae8a-ca65786612e7",
                                "sense_id": "27f06cbf-ba45-3645-bae2-60d5672bf9e8",
                                "text": "De strategische visie van minister Vandeput voorziet in totaal 9,2 miljard euro aan investeringen in Defensie tussen nu en 2030. Het gaat daarbij onder meer om de aankoop van nieuwe gevechtsvliegtuigen (de vervanger van de F-16’s) voor de luchtmacht, nieuwe fregatten en mijnenjagers voor de marine en nieuwe voertuigen voor de landmacht. Voor dat laatste luik is er nu een nieuwe stap gezet."
                            },
                            {
                                "example_id": "8101c382-62a1-42a2-86cd-6afe09fd55e8",
                                "sense_id": "27f06cbf-ba45-3645-bae2-60d5672bf9e8",
                                "text": "Premier Charles Michel vergezelde de staatssecretaris op een mijnenjager bij een bezoek aan het schip, dat bij hoogtij nog net boven het water uitsteekt. De bewindslieden werden bijgepraat over de bergingsscenario's."
                            }
                        ]
                    }
