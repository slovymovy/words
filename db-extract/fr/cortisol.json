                "senses": [
                    {
                        "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                        "entry_id": "b9c377b5-acd4-3a8d-bec4-a6d996b1c5f9",
                        "glosses": [
                            "Hormone du stress produite dans les glandes surrénales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ef0dc5-621f-4748-93da-838c7cb79613",
                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                "text": "Une insuffisance surrénalienne primaire partielle donne un tableau intermédiaire: l’élimination urinaire de cortisol est à la limite inférieure de l’intervalle normal ; de plus, le cortisol plasmatique répond à un test de stimulation court à l’ACTH."
                            },
                            {
                                "example_id": "719cbc7b-0664-40d6-b13d-8615ee816ca6",
                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                "text": "Le cortisol on l’appelle souvent l’hormone du stress, et c’est pas faux. Je suis sûr que les moines, par exemple, sécrètent très peu de cortisol."
                            },
                            {
                                "example_id": "217cd435-b11f-454c-abb2-65f3e99ace97",
                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                "text": "À la clé, une réduction de la fréquence cardiaque et de la tension artérielle, et une baisse significative de la production de cortisol et d’adrénaline, responsables du stress."
                            }
                        ]
                    }
                ],
